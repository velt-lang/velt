{
  "name": "velt",
  "displayName": "Velt",
  "description": "Velt language support: syntax highlighting, diagnostics, quick fixes, formatting, outline, go to definition, hover, completion, inlay hints, signature help and semantic highlighting (via `velt lsp`), and F5 debugging.",
  "version": "0.1.0",
  "publisher": "velt-lang",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Debuggers"
  ],
  "keywords": [
    "velt",
    "lsp"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:velt",
    "onDebugResolve:velt",
    "onDebugDynamicConfigurations:velt",
    "onDebugInitialConfigurations",
    "workspaceContains:package.vlt"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Velt runs the `velt` executable (which `velt.serverPath` may name) to analyze, build and debug the workspace."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "velt",
        "aliases": [
          "Velt",
          "velt"
        ],
        "extensions": [
          ".vlt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "velt",
        "scopeName": "source.velt",
        "path": "./syntaxes/velt.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "velt.restartServer",
        "title": "Restart Language Server",
        "category": "Velt"
      },
      {
        "command": "velt.runFile",
        "title": "Run File",
        "category": "Velt",
        "icon": "$(play)"
      },
      {
        "command": "velt.debugFile",
        "title": "Debug File",
        "category": "Velt",
        "icon": "$(debug-alt)"
      },
      {
        "command": "velt.generateLaunchJson",
        "title": "Generate launch.json",
        "category": "Velt"
      }
    ],
    "configuration": {
      "title": "Velt",
      "properties": {
        "velt.serverPath": {
          "type": "string",
          "default": "velt",
          "markdownDescription": "Path to the `velt` executable used to run `velt lsp` (a bare name is looked up on `PATH`; `~` and `${workspaceFolder}` are expanded)."
        },
        "velt.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the JSON-RPC traffic with the language server to the 'Velt Language Server' output channel."
        },
        "velt.debug.engine": {
          "type": "string",
          "enum": [
            "auto",
            "codelldb",
            "lldb-dap",
            "cpptools"
          ],
          "enumDescriptions": [
            "The first installed of CodeLLDB, lldb-dap and the C/C++ extension.",
            "CodeLLDB (vadimcn.vscode-lldb); it includes LLDB.",
            "LLDB DAP (llvm-vs-code-extensions.lldb-dap); needs lldb-dap from an LLVM install.",
            "C/C++ (ms-vscode.cpptools): LLDB on macOS, GDB on Linux, the Visual Studio debugger on Windows."
          ],
          "default": "auto",
          "markdownDescription": "The debugger extension the `velt` debug type starts."
        }
      }
    },
    "breakpoints": [
      {
        "language": "velt"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "mutable",
        "description": "A `let` binding (it may be reassigned)."
      }
    ],
    "configurationDefaults": {
      "[velt]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "menus": {
      "editor/title/run": [
        {
          "command": "velt.runFile",
          "when": "resourceLangId == velt",
          "group": "navigation@0"
        },
        {
          "command": "velt.debugFile",
          "when": "resourceLangId == velt",
          "group": "navigation@1"
        }
      ]
    },
    "debuggers": [
      {
        "type": "velt",
        "label": "Velt",
        "languages": [
          "velt"
        ],
        "variables": {
          "pickProcess": "velt.pickProcess"
        },
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "The program to debug (default: what `velt build` produces)."
              },
              "file": {
                "type": "string",
                "description": "Build and debug this file instead of the package (e.g. \"${file}\")."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Arguments passed to the program."
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}",
                "description": "Working directory of the build and the program."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {},
                "description": "Environment variables of the program."
              },
              "build": {
                "type": "boolean",
                "default": true,
                "description": "Build with `velt build` before debugging."
              },
              "buildArgs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Extra `velt build` options, e.g. [\"--backend\", \"llvm\"] (line information on Windows, which the default build lacks yet)."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Stop at the program's entry point."
              }
            }
          },
          "attach": {
            "required": [
              "pid"
            ],
            "properties": {
              "pid": {
                "type": [
                  "number",
                  "string"
                ],
                "default": "${command:pickProcess}",
                "description": "Process id to attach to."
              },
              "program": {
                "type": "string",
                "description": "The program's executable (needed by the C/C++ extension)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "velt",
            "request": "launch",
            "name": "Debug"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Velt: Debug package",
            "description": "Build the package and debug it",
            "body": {
              "type": "velt",
              "request": "launch",
              "name": "Debug package"
            }
          },
          {
            "label": "Velt: Debug current file",
            "description": "Build the open file and debug it",
            "body": {
              "type": "velt",
              "request": "launch",
              "name": "Debug current file",
              "file": "^\"\\${file}\""
            }
          },
          {
            "label": "Velt: Attach to process",
            "description": "Attach to a running Velt program (e.g. one started by `velt dev --exe`)",
            "body": {
              "type": "velt",
              "request": "attach",
              "name": "Attach to process",
              "pid": "^\"\\${command:pickProcess}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node --test out/test/debugConfig.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "~1.82.0",
    "typescript": "^5.4.0"
  }
}
