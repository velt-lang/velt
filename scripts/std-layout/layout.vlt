// The standard library's target layout (docs/internals/design/std-layout.md): data for
// `velt run scripts/std-layout -- plan|apply|verify|lint` and the precheck. Like `package.vlt`,
// it is plain data in Velt: string literals, arrays and object literals, typed by `StdLayout`.
//
// Paths are relative to `std/` (`docs` to `docs/std/`). File names inside a module are
// mechanical here (`<old name>.vlt`); phase 6 renames them after their primary type when it
// splits them.

import type { StdLayout } from "./types";

export const layout: StdLayout = {
  // Old folder → new folder. Covers every file under it, also files a branch adds after the
  // move (so it can replay the move). The longest matching folder wins; `files` wins over it.
  dirs: {
    "prelude": "prelude",
    "collections": "collections",
    "compress": "compress",
    // civil, format, parse: flattened into the module
    "datetime": "time",
    "encoding": "encoding",
    "fetch": "net/http/fetch",
    "fs": "fs",
    "json": "encoding/json",
    "jsx": "jsx",
    "number": "lang/number",
    "proxy": "lang/proxy",
    "record": "lang/record",
    "regex": "text/regex",
    "simd": "simd",
    "sort": "lang/sort",
    "streams": "io/streams",
    "sync": "sync",
    "test": "test",
    "typed_array": "lang/typed_array",
    "url": "net/url",
    "websocket": "net/websocket",
  },
  // Old file → new file.
  files: {
    // The root files: a module's API file becomes its index.vlt; files whose module is an
    // area move into it.
    "arena.vlt": "mem/arena.vlt",
    "bigint.vlt": "math/bigint.vlt",
    "channel.vlt": "sync/channel.vlt",
    "child_process.vlt": "process/child/index.vlt",
    "cli.vlt": "cli/index.vlt",
    "crypto.vlt": "crypto/index.vlt",
    "csv.vlt": "encoding/csv/index.vlt",
    "datetime.vlt": "time/datetime.vlt",
    "db.vlt": "db/index.vlt",
    "dns.vlt": "net/dns/index.vlt",
    "dom_exception.vlt": "lang/dom_exception/index.vlt",
    "encoding.vlt": "encoding/index.vlt",
    "fetch.vlt": "net/http/fetch/fetch.vlt",
    "fs.vlt": "fs/index.vlt",
    "fs_stream.vlt": "fs/stream.vlt",
    "hash.vlt": "hash/index.vlt",
    "html.vlt": "text/html.vlt",
    "import_meta.vlt": "lang/import_meta/index.vlt",
    "io.vlt": "io/index.vlt",
    "json.vlt": "encoding/json/index.vlt",
    "jsx.vlt": "jsx/index.vlt",
    "math.vlt": "math/index.vlt",
    "mem.vlt": "mem/index.vlt",
    "net.vlt": "net/index.vlt",
    "net_bytes.vlt": "net/bytes.vlt",
    "os.vlt": "os/index.vlt",
    "package.vlt": "package/index.vlt",
    "path.vlt": "path/index.vlt",
    "process.vlt": "process/index.vlt",
    "proxy.vlt": "lang/proxy/index.vlt",
    "random.vlt": "random/index.vlt",
    "regex.vlt": "text/regex/regexp.vlt",
    "simd.vlt": "simd/index.vlt",
    "stdin.vlt": "process/stdin.vlt",
    "streams.vlt": "io/streams/streams.vlt",
    "string_builder.vlt": "text/string_builder.vlt",
    "symbol.vlt": "lang/symbol/index.vlt",
    "sync.vlt": "sync/index.vlt",
    "sync/epoch.vlt": "sync/epoch/index.vlt",
    "task.vlt": "task/index.vlt",
    "test.vlt": "test/index.vlt",
    "this_fn.vlt": "lang/this_fn/index.vlt",
    "timers.vlt": "time/timers.vlt",
    "typed_array.vlt": "lang/typed_array/index.vlt",
    "udp.vlt": "net/udp/index.vlt",
    "url.vlt": "net/url/index.vlt",
    "uuid.vlt": "random/uuid/index.vlt",
    "websocket.vlt": "net/websocket/index.vlt",
    // `x.vlt` next to `x/` (layout rule 5).
    "jsx/attrs.vlt": "jsx/attrs/attrs.vlt",
    "compress/brotli.vlt": "compress/brotli/brotli_decoder.vlt",
    "compress/inflate.vlt": "compress/inflate/inflate_decoder.vlt",
    "compress/error.vlt": "compress/errors.vlt",
    // Load order in an explicit list (std/prelude/index.vlt), not in file names.
    "prelude/z_dynamic.vlt": "prelude/dynamic.vlt",
    "prelude/zzz_adapt.vlt": "prelude/adapt.vlt",
    "prelude/zzz_adapt_ctor.vlt": "prelude/adapt_ctor.vlt",
    "prelude/zzzz_any_methods.vlt": "prelude/any_methods.vlt",
    "prelude/zzzzz_any_ops.vlt": "prelude/any_ops.vlt",
  },
  // Not moved inside std: the hyper server (`http.vlt`, `http/stream.vlt`) is removed, and the
  // Velt HTTP server and the database drivers leave std for packages/ (later commits of the
  // same pull request).
  leaving: ["http.vlt", "http/", "postgres.vlt", "redis.vlt", "redis/", "sqlite.vlt", "sqlite/"],
  // Module folders whose index.vlt the move PR writes by hand (explicit re-exports by name),
  // for areas that had no single API file. Existing index files that grow re-exports:
  // io (streams), sync (channel), mem (arena), math (bigint), process (stdin), fs (stream).
  newIndex: ["collections", "compress", "net/http", "text", "time"],
  // Names that moved to another module, per old module: inside std an import takes them from
  // `std` (the defining file), elsewhere from `user` (the public module). An import of several
  // is split into one import per module.
  names: {
    "io": {
      "IoError": { std: "io/error", user: "io" },
      "IoResult": { std: "native/result", user: "native" },
      "IoStatus": { std: "native/result", user: "native" },
      "ioError": { std: "native/result", user: "native" },
      "unwrapIo": { std: "native/result", user: "native" },
      "checkIo": { std: "native/result", user: "native" },
    },
  },
  // Old public specifier → the module that now exports its names; `null`: the names are
  // globals and the import goes away. Outside std, a specifier missing here is an error.
  modules: {
    "velt:arena": "velt/mem",
    "velt:bigint": "velt/math",
    "velt:channel": "velt/sync",
    "velt:child_process": "velt/process/child",
    "velt:cli": "velt/cli",
    "velt:collections/btree_map": "velt/collections",
    "velt:collections/concurrent_map": "velt/collections",
    "velt:collections/deque": "velt/collections",
    "velt:collections/priority_queue": "velt/collections",
    "velt:collections/set": "velt/collections",
    "velt:collections/sorted_map": "velt/collections",
    "velt:compress/brotli": "velt/compress",
    "velt:compress/inflate": "velt/compress",
    "velt:crypto": "velt/crypto",
    "velt:csv": "velt/encoding/csv",
    "velt:datetime": "velt/time",
    "velt:db": "velt/db",
    "velt:dns": "velt/net/dns",
    "velt:dom_exception": null,
    "velt:encoding": "velt/encoding",
    "velt:encoding/binary_string": "velt/encoding",
    "velt:fetch": "velt/net/http",
    "velt:fs": "velt/fs",
    "velt:fs_stream": "velt/fs",
    "velt:hash": "velt/hash",
    "velt:html": "velt/text",
    "velt:io": "velt/io",
    "velt:json": "velt/encoding/json",
    "velt:jsx": "velt/jsx",
    "velt:jsx/jsx-runtime": "velt/jsx/jsx-runtime",
    "velt:math": "velt/math",
    "velt:mem": "velt/mem",
    "velt:net": "velt/net",
    "velt:os": "velt/os",
    "velt:package": "velt/package",
    "velt:path": "velt/path",
    "velt:process": "velt/process",
    "velt:proxy": null,
    "velt:random": "velt/random",
    "velt:regex": "velt/text",
    "velt:simd": "velt/simd",
    "velt:stdin": "velt/process",
    "velt:streams": "velt/io",
    "velt:string_builder": null,
    "velt:symbol": null,
    "velt:sync": "velt/sync",
    "velt:sync/epoch": "velt/sync/epoch",
    "velt:task": "velt/task",
    "velt:test": "velt/test",
    "velt:timers": "velt/time",
    "velt:typed_array": null,
    "velt:udp": "velt/net/udp",
    "velt:url": "velt/net/url",
    "velt:uuid": "velt/random/uuid",
    "velt:websocket": "velt/net/websocket",
  },
  // docs/std pages → their new place (several pages merge into their module's page).
  docs: {
    "arena.md": "mem.md",
    "bigint.md": "math.md",
    "channel.md": "sync.md",
    "child_process.md": "process/child.md",
    "csv.md": "encoding/csv.md",
    "datetime.md": "time.md",
    "dns.md": "net/dns.md",
    "fetch.md": "net/http.md",
    "fs_stream.md": "fs.md",
    "html.md": "text.md",
    "json.md": "encoding/json.md",
    "regex.md": "text.md",
    "stdin.md": "process.md",
    "streams.md": "io.md",
    "string_builder.md": "globals/string_builder.md",
    "symbol.md": "globals/symbol.md",
    "timers.md": "time.md",
    "typed_array.md": "globals/typed_array.md",
    "udp.md": "net/udp.md",
    "url.md": "net/url.md",
    "uuid.md": "random/uuid.md",
    "websocket.md": "net/websocket.md",
  },
  // Files allowed over 400 lines, with the PR that splits them. Filled by the enforcement PR
  // (phase 5) from `lint --list`; it only shrinks.
  oversize: {},
};
