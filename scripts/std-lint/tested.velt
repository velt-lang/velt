// scripts/std-lint: every public module has tests (docs/internals/design/std-layout.md §6). Its
// page is on the website (https://veltlang.com/docs/std/), which checks its own coverage.

import { execSync } from "velt/process/child";

/** `[index file below std/, message]` for each public module (`indexes`: the folders with an
 * index.velt; `files`: std's files) without tests: an end-to-end test (`tests/golden`,
 * `tests/std`) that imports it, or white-box tests in its folder. */
export function untestedModules(indexes: Set<string>, files: string[]): [string, string][] {
  const out: [string, string][] = [];
  const imported =
    execSync("git", [
      "grep",
      "-h",
      "-o",
      "-E",
      "\"velt/[a-z0-9_/-]+\"",
      "--",
      "tests/golden",
      "tests/std",
    ]).stdout;
  for (const dir of indexes) {
    const first = dir.split("/")[0];
    if (dir.length == 0 || first == "prelude" || first == "lang") {
      continue;
    }
    const file = `${dir}/index.velt`;
    const whiteBox = files.some((f) => f.startsWith(`${dir}/`) && f.endsWith(".test.velt"));
    if (!whiteBox && !imported.includes(`"velt/${dir}"`)) {
      out.push([
        file,
        `velt/${dir} has no tests: add an end-to-end test that imports it (tests/golden/std, tests/std) or white-box tests in std/${dir}/`,
      ]);
    }
  }
  return out;
}
