// scripts/std-lint: the shape of allow.vlt, the files std-lint lets break a rule until they are
// fixed (docs/internals/design/std-layout.md §6).

/**
 * Files allowed to break a rule, per rule; each list only shrinks. Paths are below `std/`, or the
 * repository's for a package's sources (`packages/<name>/src/…`).
 */
export interface Allow {
  /** Over the size limit. */
  oversize: string[];
  /** Exporting more than one class or struct. */
  multiClass: string[];
  /** An `index.vlt` with code of its own (beyond named re-exports and side-effect imports). */
  indexCode: string[];
  /** Outside every module, or directly in `std/` (what leaves std for packages/). */
  unowned: string[];
}
