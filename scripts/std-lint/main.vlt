// scripts/std-lint: checks the standard library's layout and quality rules
// (docs/internals/design/std-layout.md §2 and §6), with messages that say what to do.
//
//   velt run scripts/std-lint/main.vlt [--base <ref>] [--fix-headers] [--write-allow] [files…]
//
// With files (what `cargo xtask precheck` passes: the changed std files), only their problems
// are reported; without, all of std's, and allow-list entries that are fixed already. `--base`
// rejects allow-list entries the base revision did not have (the lists only shrink).
// `--fix-headers` rewrites the module part of each file's header line; `--write-allow` writes
// allow.vlt from today's violations (once, when a rule is introduced).

import { execSync } from "velt/process/child";
import { readFileSync, writeFileSync } from "velt/fs";
import { args, exit } from "velt/process";
import { allow } from "./allow";

const MAX_LINES = 400;

function git(argv: string[]): string {
  const r = execSync("git", argv);
  if (r.code != 0) {
    throw new Error(`git ${argv.join(" ")}: ${r.stderr}`);
  }
  return r.stdout;
}

function dirOf(file: string): string {
  const slash = file.lastIndexOf("/");
  return slash < 0 ? "" : file.slice(0, slash);
}

/** A rule broken by a file (below `std/`). */
class Problem {
  file: string;
  rule: string;
  message: string;

  constructor(file: string, rule: string, message: string) {
    this.file = file;
    this.rule = rule;
    this.message = message;
  }
}

/** std's files, and what the layout says about each. */
class Std {
  files: string[] = [];
  texts: Map<string, string> = new Map();
  indexes: Set<string> = new Set();

  constructor() {
    for (const path of git(["ls-files", "std"]).split("\n")) {
      if (path.endsWith(".vlt")) {
        const file = path.slice(4);
        this.files.push(file);
        this.texts.set(file, readFileSync(path));
        if (file == "index.vlt" || file.endsWith("/index.vlt")) {
          this.indexes.add(dirOf(file));
        }
      }
    }
  }

  text(file: string): string {
    return this.texts.get(file) ?? "";
  }

  /** The module that owns `file`: the nearest folder above it (or its own) with an index.vlt. */
  owner(file: string): string | null {
    let dir = dirOf(file);
    while (dir.length > 0) {
      if (this.indexes.has(dir)) {
        return dir;
      }
      dir = dirOf(dir);
    }
    return null;
  }

  isIndex(file: string): boolean {
    return file.endsWith("/index.vlt");
  }
}

function special(file: string): boolean {
  return file.startsWith("prelude/") || file.startsWith("lang/");
}

function allowed(list: string[], file: string): boolean {
  for (const entry of list) {
    if (entry.endsWith("/") ? file.startsWith(entry) : entry == file) {
      return true;
    }
  }
  return false;
}

/** The header line a file must start with (its module part); null when anything goes. */
function expectedHeader(std: Std, file: string): string | null {
  if (file.startsWith("prelude/global/")) {
    return "// Global";
  }
  if (file.startsWith("prelude/")) {
    return "// Prelude";
  }
  if (std.isIndex(file)) {
    return `// velt/${dirOf(file)}:`;
  }
  const owner = std.owner(file);
  if (owner !== null) {
    return `// velt/${owner} (internal):`;
  }
  return file.startsWith("lang/") ? `// velt/${dirOf(file)} (internal):` : null;
}

function generated(text: string): boolean {
  const head = text.split("\n").slice(0, 15).join("\n").toLowerCase();
  return head.includes("generated by scripts/");
}

function exportedClasses(text: string): i64 {
  let n = 0;
  for (const line of text.split("\n")) {
    if (
      line.startsWith("export class ") ||
      line.startsWith("export abstract class ") ||
      line.startsWith("export struct ")
    ) {
      n++;
    }
  }
  return n;
}

/** What an index.vlt holds beyond comments, named re-exports and side-effect imports. */
function indexCode(text: string): string | null {
  let inList = false;
  for (const raw of text.split("\n")) {
    const line = raw.trim();
    if (
      line.length == 0 || line.startsWith("//") || line.startsWith("/*") || line.startsWith("*")
    ) {
      continue;
    }
    if (inList) {
      if (line.startsWith("}")) {
        inList = false;
        if (!line.includes(" from \"")) {
          return line;
        }
      }
      continue;
    }
    if (line.startsWith("export {") || line.startsWith("export type {")) {
      if (!line.includes("}")) {
        inList = true;
      } else if (!line.includes(" from \"")) {
        return line;
      }
    } else if (!line.startsWith("import \"")) {
      return line;
    }
  }
  return null;
}

/** The names an index.vlt re-exports (after `as`). */
function reexported(text: string): string[] {
  const out: string[] = [];
  let list = "";
  let inList = false;
  for (const raw of text.split("\n")) {
    const line = raw.trim();
    if (line.startsWith("export {") || line.startsWith("export type {")) {
      inList = true;
      list = "";
    }
    if (inList) {
      list += " " + line;
      if (line.includes("}")) {
        inList = false;
        const open = list.indexOf("{");
        const close = list.indexOf("}");
        for (const name of list.slice(open + 1, close).split(",")) {
          const n = name.trim().replace("type ", "");
          if (n.length > 0) {
            const as = n.indexOf(" as ");
            out.push(as < 0 ? n : n.slice(as + 4).trim());
          }
        }
      }
    }
  }
  return out;
}

function lint(std: Std): Problem[] {
  const problems: Problem[] = [];
  const all = std.files.join("\n") + "\n";
  for (const file of std.files) {
    const text = std.text(file);
    const owned = special(file) || std.owner(file) !== null;
    if (!owned) {
      const where = file.includes("/") ? "in no module's folder" : "directly in std/";
      problems.push(
        new Problem(
          file,
          "unowned",
          `${where}: std files live in a module folder (a folder with an index.vlt); move it into its area (docs/internals/design/std-layout.md §3)`,
        ),
      );
    }
    const stem = file.slice(0, file.length - 4);
    if (!std.isIndex(file) && all.includes("\n" + stem + "/") || all.startsWith(stem + "/")) {
      problems.push(
        new Problem(
          file,
          "pair",
          `${stem}.vlt sits next to the folder ${stem}/: make it ${stem}/index.vlt (a module) or move it into the folder`,
        ),
      );
    }
    const lines = text.split("\n").length - 1;
    if (lines > MAX_LINES && !generated(text)) {
      problems.push(
        new Problem(
          file,
          "oversize",
          `${lines} lines (limit ${MAX_LINES}): split it by type, one exported class per file, helpers in files of their own`,
        ),
      );
    }
    const classes = exportedClasses(text);
    if (classes > 1) {
      problems.push(
        new Problem(
          file,
          "multiClass",
          `exports ${classes} classes: one exported class per file, named after it (\`Deque\` in deque.vlt)`,
        ),
      );
    }
    if (std.isIndex(file) && !special(file)) {
      if (text.includes("\nexport * from") || text.startsWith("export * from")) {
        problems.push(
          new Problem(
            file,
            "exportStar",
            "`export *`: re-export by name, so the module's API is reviewable in its index.vlt",
          ),
        );
      }
      const code = indexCode(text);
      if (code !== null) {
        problems.push(
          new Problem(
            file,
            "indexCode",
            `index.vlt is the module's API, only named re-exports: move \`${code.slice(0, 50)}\` and the rest into a file of the module and re-export it`,
          ),
        );
      }
    }
    const header = expectedHeader(std, file);
    if (owned && header !== null && !text.startsWith(header)) {
      problems.push(
        new Problem(
          file,
          "header",
          `the first line must start with \`${header}\` (run \`velt run scripts/std-lint/main.vlt --fix-headers\`)`,
        ),
      );
    }
  }
  // One import path per public name.
  const exporters: Map<string, string> = new Map();
  for (const dir of std.indexes) {
    const file = dir.length == 0 ? "index.vlt" : dir + "/index.vlt";
    if (special(file)) {
      continue;
    }
    for (const name of reexported(std.text(file))) {
      const other = exporters.get(name);
      if (other !== undefined && other != dir) {
        problems.push(
          new Problem(
            file,
            "duplicateExport",
            `\`${name}\` is exported by velt/${other} too: every public name has one import path`,
          ),
        );
      } else {
        exporters.set(name, dir);
      }
    }
  }
  return problems;
}

function allowList(rule: string): string[] | null {
  if (rule == "oversize") {
    return allow.oversize;
  }
  if (rule == "multiClass") {
    return allow.multiClass;
  }
  if (rule == "indexCode") {
    return allow.indexCode;
  }
  // What leaves std (unowned) may also sit next to its folder until it goes.
  if (rule == "unowned" || rule == "pair") {
    return allow.unowned;
  }
  return null;
}

/** Rewrites each header's module part (`// std/fs_stream: …` → `// velt/fs (internal): …`). */
function fixHeaders(std: Std): i64 {
  let fixed = 0;
  for (const file of std.files) {
    const header = expectedHeader(std, file);
    const text = std.text(file);
    if (header === null || text.startsWith(header) || !text.startsWith("// ")) {
      continue;
    }
    const first = text.slice(0, text.indexOf("\n"));
    let rest = first.slice(3);
    const token = rest.split(" ")[0];
    if (!token.startsWith("std/") && !token.startsWith("velt/") && !token.startsWith("velt:")) {
      continue;
    }
    rest = rest.slice(token.length).trim();
    for (const tag of ["(std-internal)", "(internal)"]) {
      if (rest.startsWith(tag)) {
        rest = rest.slice(tag.length).trim();
      }
    }
    if (token.endsWith(":")) {
      // `// std/fs: …`: the token carried the separator.
    } else if (rest.startsWith(":") || rest.startsWith("—") || rest.startsWith("-")) {
      rest = rest.slice(1).trim();
    }
    writeFileSync("std/" + file, `${header} ${rest}` + text.slice(first.length));
    fixed++;
  }
  return fixed;
}

function writeAllow(problems: Problem[]) {
  const lists = ["oversize", "multiClass", "indexCode", "unowned"];
  let out =
    "// scripts/std-lint: the files allowed to break a rule until they are fixed. The lists only\n";
  out +=
    "// shrink: `cargo xtask precheck` rejects an entry its base revision did not have, and std-lint\n";
  out += "// reports an entry that no longer breaks its rule.\n\n";
  out += "import type { Allow } from \"./types\";\n\nexport const allow: Allow = {\n";
  for (const rule of lists) {
    const files = problems.filter((p) => p.rule == rule).map((p) => p.file);
    out += `  ${rule}: [\n`;
    for (const f of files) {
      out += `    "${f}",\n`;
    }
    out += "  ],\n";
  }
  out += "};\n";
  writeFileSync("scripts/std-lint/allow.vlt", out);
}

function main() {
  const argv = args();
  let base: string | null = null;
  const only: Set<string> = new Set();
  let fix = false;
  let write = false;
  let i = 0;
  while (i < argv.length) {
    const a = argv[i];
    if (a == "--base" && i + 1 < argv.length) {
      base = argv[i + 1];
      i++;
    } else if (a == "--fix-headers") {
      fix = true;
    } else if (a == "--write-allow") {
      write = true;
    } else if (a.startsWith("std/") && a.endsWith(".vlt")) {
      only.add(a.slice(4));
    }
    i++;
  }
  let std = new Std();
  if (fix) {
    console.log(`std-lint: fixed ${fixHeaders(std)} headers`);
    std = new Std();
  }
  const problems = lint(std);
  if (write) {
    writeAllow(problems);
    console.log("std-lint: wrote scripts/std-lint/allow.vlt");
    return;
  }
  const report: string[] = [];
  for (const p of problems) {
    const list = allowList(p.rule);
    if (list !== null && allowed(list, p.file)) {
      continue;
    }
    if (only.size == 0 || only.has(p.file)) {
      report.push(`std/${p.file}: ${p.message}`);
    }
  }
  if (only.size == 0) {
    for (const rule of ["oversize", "multiClass", "indexCode", "unowned"]) {
      for (const entry of allowList(rule) ?? []) {
        const still = problems.some(
          (p) =>
            p.rule == rule && (entry.endsWith("/") ? p.file.startsWith(entry) : p.file == entry),
        );
        if (!still) {
          report.push(
            `scripts/std-lint/allow.vlt: \`${entry}\` no longer breaks \`${rule}\`: remove it from the list`,
          );
        }
      }
    }
  }
  if (base !== null) {
    const shown = execSync("git", ["show", `${base}:scripts/std-lint/allow.vlt`]);
    if (shown.code == 0) {
      for (const rule of ["oversize", "multiClass", "indexCode", "unowned"]) {
        for (const entry of allowList(rule) ?? []) {
          if (!shown.stdout.includes(`"${entry}"`)) {
            report.push(
              `scripts/std-lint/allow.vlt: \`${entry}\` is new in \`${rule}\`: the lists only shrink; fix the file instead`,
            );
          }
        }
      }
    }
  }
  for (const line of report) {
    console.log(line);
  }
  if (report.length > 0) {
    console.log(
      `std-lint: ${report.length} problems (rules: docs/internals/design/std-layout.md §2 and §6)`,
    );
    exit(1);
  }
}

main();
