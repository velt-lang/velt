# Toolchain image for scripts/linux-check.sh --distro alpine: Alpine (musl libc) with the C
# toolchain, clang 19 and rustup stable. musl is a "try it" target: see docs/tooling/platforms.md.
FROM alpine:3.21
RUN apk add --no-cache build-base clang19 lld git curl ca-certificates python3 bash procps openssl
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal \
      -c clippy,rustfmt --default-toolchain stable \
 && chmod -R a+w /opt/cargo /opt/rustup
WORKDIR /work
