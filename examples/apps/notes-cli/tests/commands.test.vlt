// The command layer: argv in, output lines out.
import { execute } from "@notes/commands";
import { removeSync } from "velt:fs";

const DB = "notes-commands-test.json";

function run(argv: string[]): string[] {
  return execute(argv, DB, 1767225600000);
}

function error(argv: string[]): string {
  try {
    run(argv);
  } catch (e) {
    return e.message.clone();
  }
  return "";
}

export function test_add_list_show() {
  assertEq(run(["add", "First", "-t", "a"]), ["added 1"]);
  assertEq(run(["add", "Second", "--body", "text", "--tag", "b"]), ["added 2"]);
  assertEq(run(["list"]), ["1  First  #a", "2  Second  #b"]);
  assertEq(run(["list", "--tag", "b"]), ["2  Second  #b"]);
  assertEq(run(["show", "2"]), ["2  Second  #b", "created 2026-01-01T00:00:00.000Z", "", "text"]);
  assertEq(run(["tags"]), ["a: 1", "b: 1"]);
  removeSync(DB);
}

export function test_color() {
  assertEq(run(["add", "Hi", "-t", "x"]), ["added 1"]);
  assertEq(run(["list", "-c"]), ["\x1b[33m1\x1b[0m  Hi  \x1b[36m#x\x1b[0m"]);
  removeSync(DB);
}

export function test_usage_errors() {
  assertEq(error(["frob"]), "unknown command 'frob' (try --help)");
  assertEq(error(["add"]), "'add' needs a title");
  assertEq(error(["show", "x"]), "'x' is not a note id");
  assertEq(error(["show", "5"]), "no note with id 5");
  assertEq(error(["--nope"]), "Unknown option '--nope'");
}

export function test_help() {
  assert(run([])[0].startsWith("Usage: notes [options] [command] [arg] [extra]"));
}
