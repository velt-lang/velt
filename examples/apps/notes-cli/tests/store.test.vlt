// NoteStore: ids, search, tags, removal and the JSON round trip.
import { NoteStore, NotFoundError } from "@notes/store";
import { existsSync, removeSync } from "velt:fs";

function sample(path: string): NoteStore {
  const s = new NoteStore(path);
  s.add("Buy milk", "oat, 2 liters", ["home", "shop"], 0);
  s.add("Write report", "ergonomics", ["work"], 1000);
  s.add("Call Anna", "", ["home"], 2000);
  return s;
}

export function test_ids_increase() {
  const s = sample("unused.json");
  assertEq(s.notes.map((n) => n.id), [1, 2, 3]);
  assertEq(s.nextId, 4);
}

export function test_search_is_case_insensitive_over_title_and_body() {
  const s = sample("unused.json");
  assertEq(s.search("MILK").length, 1);
  assertEq(s.search("ergo")[0].title, "Write report");
  assertEq(s.search("nothing").length, 0);
}

export function test_tags() {
  const s = sample("unused.json");
  assertEq(s.withTag("home").map((n) => n.id), [1, 3]);
  s.addTag(2, "urgent");
  s.addTag(2, "urgent");
  assertEq(s.get(2).tags, ["work", "urgent"]);
  const counts = s.tagCounts();
  assertEq(counts.get("home"), 2);
  assertEq(counts.keys(), ["home", "shop", "work", "urgent"]);
}

export function test_remove_and_missing_ids() {
  const s = sample("unused.json");
  s.remove(2);
  assertEq(s.notes.map((n) => n.id), [1, 3]);
  let message = "";
  try {
    s.get(2);
  } catch (e) {
    message = e.message.clone();
  }
  assertEq(message, "no note with id 2");
}

export function test_save_and_load_round_trip() {
  const path = "notes-store-test.json";
  sample(path.clone()).save();
  const loaded = NoteStore.load(path);
  removeSync(path);
  assertEq(loaded.notes.length, 3);
  assertEq(loaded.get(1).tags, ["home", "shop"]);
  assertEq(loaded.nextId, 4);
  assert(!existsSync(path));
}

export function test_missing_file_is_empty() {
  const s = NoteStore.load("does-not-exist.json");
  assertEq(s.notes.length, 0);
  assertEq(s.nextId, 1);
}
