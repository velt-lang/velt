// Room membership rules.
import { Room } from "../src/room";

// Sockets are only stored and handed back, never used: numbers stand in for them.
function socket(n: u64): u64 {
  return n;
}

export function test_join_and_names() {
  const r = new Room<u64>();
  assertEq(r.join(1, " ann ", socket(10u64)), null);
  assertEq(r.join(2, "bo", socket(20u64)), null);
  assertEq(r.names(), ["ann", "bo"]);
  assertEq(r.nameOf(1), "ann");
  assertEq(r.nameOf(3), null);
}

export function test_join_rules() {
  const r = new Room<u64>();
  r.join(1, "ann", socket(10u64));
  assertEq(r.join(2, "ann", socket(20u64)), "name ann is taken");
  assertEq(r.join(1, "other", socket(10u64)), "already joined");
  assertEq(r.join(3, "   ", socket(30u64)), "name must be 1-20 characters");
  assertEq(r.join(3, "x".repeat(21), socket(30u64)), "name must be 1-20 characters");
}

export function test_leave_and_sockets() {
  const r = new Room<u64>();
  r.join(1, "ann", socket(10u64));
  r.join(2, "bo", socket(20u64));
  r.join(3, "cy", socket(30u64));
  assertEq(r.sockets(2), [10u64, 30u64]);
  assertEq(r.leave(2), "bo");
  assertEq(r.leave(2), null);
  assertEq(r.sockets(), [10u64, 30u64]);
  assertEq(r.names(), ["ann", "cy"]);
}

// `admit` hands back the members who were there before the newcomer, taken with the join itself
// (#367: taken later, they included clients that joined after the newcomer).
export function test_admit_peers_are_the_earlier_members() {
  const r = new Room<u64>();
  const first = r.admit(1, "ann", socket(10u64));
  switch (first.type) {
    case "welcome":
      assertEq(first.users, ["ann"]);
      assertEq(first.peers.length, 0);
      break;
    case "refused":
      assert(false, first.reason);
      break;
  }
  const second = r.admit(2, " bo ", socket(20u64));
  switch (second.type) {
    case "welcome":
      assertEq(second.users, ["ann", "bo"]);
      assertEq(second.peers, [10u64]);
      break;
    case "refused":
      assert(false, second.reason);
      break;
  }
  const taken = r.admit(3, "bo", socket(30u64));
  switch (taken.type) {
    case "welcome":
      assert(false, "bo is taken");
      break;
    case "refused":
      assertEq(taken.reason, "name bo is taken");
      break;
  }
  assertEq(r.sockets(), [10u64, 20u64]);
}
