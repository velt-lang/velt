// The chat server: every WebSocket connection runs `session`, which joins the room and
// broadcasts what the client says to everyone connected.
import { serve, Server } from "velt:http";
import { WebSocket, WsMessage, isWebSocketRequest, upgradeWebSocket } from "velt:websocket";
import { Room } from "./room";
import { decodeClient, encode, ServerMessage } from "./protocol";

// Sends to one peer; a peer that has gone away is skipped (its own session cleans it up).
async function sendQuietly(ws: WebSocket, text: string) {
  try {
    await ws.send(text);
  } catch (e) {
    return;
  }
}

async function broadcast(sockets: WebSocket[], msg: ServerMessage) {
  const text = encode(msg);
  const sends: Promise<void>[] = [];
  for (const s of sockets) {
    sends.push(sendQuietly(s, text));
  }
  await Promise.all(sends);
}

async function reply(ws: WebSocket, msg: ServerMessage) {
  await sendQuietly(ws, encode(msg));
}

// The members to tell are taken when the newcomer is added, under the same lock. Taken after
// the welcome is sent, they could include a client that connected and joined in between: its
// own welcome already lists the newcomer, and it would also be told that the newcomer joined.
async function join(ws: WebSocket, id: i64, name: string, room: shared<Mutex<Room<WebSocket>>>) {
  const a = room.with((r) => r.admit(id, name, ws));
  switch (a.type) {
    case "refused":
      await reply(ws, { type: "error", message: a.reason });
      return;
    case "welcome": {
      const me = name.trim();
      await reply(ws, { type: "welcome", name: me.clone(), users: a.users });
      await broadcast(a.peers, { type: "joined", name: me });
      return;
    }
  }
}

async function say(ws: WebSocket, id: i64, text: string, room: shared<Mutex<Room<WebSocket>>>) {
  const from = room.with((r) => r.nameOf(id));
  if (from == null) {
    await reply(ws, { type: "error", message: "join first" });
    return;
  }
  await broadcast(room.with((r) => r.sockets()), { type: "message", from, text });
}

// The next message, or null when the client closed, left or the connection broke. (`receive`
// throws on an abrupt disconnect; uncaught in a spawned task, that would end the server.)
async function receive(ws: WebSocket): Promise<WsMessage | null> {
  try {
    return await ws.receive();
  } catch (e) {
    return null;
  }
}

// Handles one text message; false when the client leaves.
async function handle(
  ws: WebSocket,
  id: i64,
  text: string,
  room: shared<Mutex<Room<WebSocket>>>,
): Promise<bool> {
  try {
    const msg = decodeClient(text);
    switch (msg.type) {
      case "join":
        await join(ws, id, msg.name, room);
        return true;
      case "say":
        await say(ws, id, msg.text, room);
        return true;
      case "leave":
        return false;
    }
  } catch (e) {
    await reply(ws, { type: "error", message: e.message.clone() });
    return true;
  }
}

// One client connection, until it closes or leaves.
async function session(ws: WebSocket, id: i64, room: shared<Mutex<Room<WebSocket>>>) {
  let m = await receive(ws);
  while (m != null) {
    if (!m.isBinary && !(await handle(ws, id, m.text, room))) {
      break;
    }
    m = await receive(ws);
  }
  const name = room.with((r) => r.leave(id));
  if (name != null) {
    await broadcast(room.with((r) => r.sockets()), { type: "left", name });
  }
  try {
    await ws.close();
  } catch (e) {
    return;
  }
}

// Serves the chat on `port` (0 = any free port): WebSocket `/chat`, a hint on other paths.
export async function startChat(port: i64): Promise<Server> {
  const room = shared(new Mutex<Room<WebSocket>>(new Room<WebSocket>()));
  const ids = shared(0);
  return await serve({ port: port as number }, async (req) => {
    if (new URL(req.url).pathname === "/chat" && isWebSocketRequest(req)) {
      const up = upgradeWebSocket(req);
      spawn(session(up.socket, ids.add(1), room));
      return up.response;
    }
    return new Response("chat server: connect a WebSocket to /chat\n");
  });
}
