// Who is connected: client ids, names and sockets (`S`: the server's `WebSocket`, numbers in
// the tests). Plain synchronous state, kept behind a `Mutex` by the server. Methods return errors as values (`string | null`) instead of throwing
// because they run inside `Mutex.with` callbacks, which cannot throw (the lock is held).
type Member<S> = { name: string; socket: S };

const MAX_NAME: usize = 20;

export class Room<S> {
  private members: Map<i64, Member<S>> = new Map<i64, Member<S>>();

  // Adds client `id` as `name` (trimmed); returns why it can't, or null.
  join(id: i64, name: string, socket: S): string | null {
    const clean = name.trim();
    if (clean === "" || clean.length > MAX_NAME) {
      return `name must be 1-${MAX_NAME} characters`;
    }
    if (this.members.has(id)) {
      return "already joined";
    }
    for (const m of this.members.values()) {
      if (m.name === clean) {
        return `name ${clean} is taken`;
      }
    }
    this.members.set(id, { name: clean, socket });
    return null;
  }

  // Removes client `id`; its name if it had joined.
  leave(id: i64): string | null {
    const name = this.nameOf(id);
    this.members.delete(id);
    return name;
  }

  nameOf(id: i64): string | null {
    const m = this.members.get(id);
    // `.clone()`: moving the field out of the narrowed local is a use after free today
    // (tests/golden/bugs/lower_move_field_of_narrowed_nullable).
    return m == null ? null : m.name.clone();
  }

  // Names in join order.
  names(): string[] {
    const out: string[] = [];
    for (const m of this.members.values()) {
      out.push(m.name);
    }
    return out;
  }

  // Sockets of every member except `except` (-1: everyone).
  sockets(except: i64 = -1): S[] {
    const out: S[] = [];
    for (const [k, m] of this.members) {
      if (k !== except) {
        out.push(m.socket);
      }
    }
    return out;
  }
}
