// A scripted chat (golden: demo.out): three clients on a real server, each step waiting until
// every client has received what the server broadcast, so the transcript is deterministic.
import { WebSocket, connectWebSocket } from "velt:websocket";
import { startChat } from "./src/server";
import { nextLine, sendJoin, sendSay, sendLeave } from "./src/client";

// Prints the next `n` messages `who` receives.
async function expect(who: string, ws: WebSocket, n: i64) {
  for (let i = 0; i < n; i++) {
    const line = await nextLine(ws);
    console.log(`[${who}] ${line ?? "(connection closed)"}`);
  }
}

async function main() {
  const server = await startChat(0);
  const url = `ws://127.0.0.1:${server.port}/chat`;
  const hint = await fetch(`http://127.0.0.1:${server.port}/`);
  console.log(`GET / -> ${hint.status} ${(await hint.text()).trim()}`);

  const alice = await connectWebSocket(url);
  await sendJoin(alice, "alice");
  await expect("alice", alice, 1);

  const bob = await connectWebSocket(url);
  await sendJoin(bob, "  bob ");
  await expect("bob", bob, 1);
  await expect("alice", alice, 1);

  const carol = await connectWebSocket(url);
  await sendSay(carol, "am I in?");
  await expect("carol", carol, 1);
  await sendJoin(carol, "bob");
  await expect("carol", carol, 1);
  await carol.send("not json");
  await expect("carol", carol, 1);
  await sendJoin(carol, "carol");
  await expect("carol", carol, 1);
  await expect("alice", alice, 1);
  await expect("bob", bob, 1);

  await sendSay(alice, "hello everyone");
  await expect("alice", alice, 1);
  await expect("bob", bob, 1);
  await expect("carol", carol, 1);

  await sendLeave(bob);
  await expect("bob", bob, 1);
  await bob.close();
  await expect("alice", alice, 1);
  await expect("carol", carol, 1);

  // Carol disconnects without saying goodbye.
  await carol.close();
  await expect("alice", alice, 1);

  await sendLeave(alice);
  await expect("alice", alice, 1);
  await alice.close();
  server.close();
}
