// Process glue: arguments in, output to stdout, messages to stderr, the exit code out.
import { args } from "velt:process";
import { execute } from "./app";

async function main(): Promise<i32> {
  return await execute(
    args(),
    process.env.NO_COLOR != null,
    // A block body: `(s) => process.stdout.write(s)` returns a boolean, which Velt rejects
    // where `(s: string) => void` is expected (#694).
    (s) => {
      process.stdout.write(s);
    },
    (s) => console.error(s),
  );
}
