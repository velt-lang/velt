// .gitignore rules: glob lines compiled to regexes, matched against paths relative to the
// directory that holds the .gitignore. The last matching rule wins; `!` re-includes.
import { RegExp } from "velt:regex";

/// One rule. Plain data, so it can travel between walker tasks; each task compiles the regex
/// itself (see `RuleCache`). A rule holding its `RegExp` panics when sent down a channel (#690).
export type Rule = {
  base: string; // directory of the .gitignore, relative to the search root ("" for the root)
  negate: bool;
  dirOnly: bool;
  source: string; // the regex the path below `base` must match
};

/// Compiled rule regexes, one cache per task.
export class RuleCache {
  private compiled: Map<string, RegExp> = new Map<string, RegExp>();

  test(source: string, path: string): bool {
    const known = this.compiled.get(source);
    if (known != null) {
      return known.test(path);
    }
    try {
      const re = new RegExp(source);
      const hit = re.test(path);
      this.compiled.set(source, re);
      return hit;
    } catch (e) {
      return false; // parseIgnore only keeps sources that compile
    }
  }
}

/// A gitignore glob as a regex source (without anchors).
export function globToRegex(glob: string): string {
  let out = "";
  let i = 0;
  while (i < glob.length) {
    const c = glob[i];
    if (c === "*") {
      if (i + 1 < glob.length && glob[i + 1] === "*") {
        // `**/` matches zero or more directories, a trailing `**` everything.
        if (i + 2 < glob.length && glob[i + 2] === "/") {
          out += "(?:.*/)?";
          i += 3;
        } else {
          out += ".*";
          i += 2;
        }
        continue;
      }
      out += "[^/]*";
    } else if (c === "?") {
      out += "[^/]";
    } else if (c === "[") {
      const close = glob.indexOf("]", i + 1);
      if (close < 0) {
        out += "\\[";
      } else {
        let cls = glob.slice(i + 1, close);
        if (cls.startsWith("!")) {
          cls = `^${cls.slice(1)}`;
        }
        out += `[${cls}]`;
        i = close + 1;
        continue;
      }
    } else if (c === "\\" && i + 1 < glob.length) {
      out += RegExp.escape(glob[i + 1]);
      i += 2;
      continue;
    } else {
      out += RegExp.escape(c);
    }
    i++;
  }
  return out;
}

/// `line` without trailing spaces, except one escaped as `\ `, which globToRegex keeps.
function trimTrailingSpaces(line: string): string {
  let end = line.length;
  while (end > 0 && line[end - 1] === " " && !(end > 1 && line[end - 2] === "\\")) {
    end--;
  }
  return line.slice(0, end);
}

/// The rules of one .gitignore file whose directory is `base` (relative to the search root).
export function parseIgnore(base: string, text: string): Rule[] {
  const rules: Rule[] = [];
  for (const raw of text.split("\n")) {
    let line = raw.endsWith("\r") ? raw.slice(0, raw.length - 1) : raw;
    line = trimTrailingSpaces(line);
    if (line === "" || line.startsWith("#")) {
      continue;
    }
    let negate = false;
    if (line.startsWith("!")) {
      negate = true;
      line = line.slice(1);
    } else if (line.startsWith("\\")) {
      line = line.slice(1);
    }
    let dirOnly = false;
    if (line.endsWith("/")) {
      dirOnly = true;
      line = line.slice(0, line.length - 1);
    }
    // A slash at the start or in the middle anchors the pattern to `base`.
    const anchored = line.includes("/");
    if (line.startsWith("/")) {
      line = line.slice(1);
    }
    if (line === "") {
      continue;
    }
    const body = globToRegex(line);
    // A match on a directory also covers everything below it.
    const source = anchored ? `^${body}(?:/.*)?$` : `^(?:.*/)?${body}(?:/.*)?$`;
    try {
      new RegExp(source); // validate once here
      rules.push({ base, negate, dirOnly, source });
    } catch (e) {
      // A glob we can't express is skipped rather than failing the search.
    }
  }
  return rules;
}

/// Whether `rel` (relative to the search root) is ignored by `rules`.
export function isIgnored(rules: Rule[], cache: RuleCache, rel: string, isDir: bool): bool {
  let ignored = false;
  for (const r of rules) {
    if (r.dirOnly && !isDir) {
      continue;
    }
    let sub = rel;
    if (r.base !== "") {
      if (!rel.startsWith(`${r.base}/`)) {
        continue;
      }
      sub = rel.slice(r.base.length + 1);
    }
    if (cache.test(r.source, sub)) {
      ignored = !r.negate;
    }
  }
  return ignored;
}
