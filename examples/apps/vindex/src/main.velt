// vindex: a disk-based approximate nearest-neighbour index.
//
//   vindex gen <dir> [--n 1000000] [--dim 128] [--clusters 10000] [--queries 200]
//   vindex build <dir> [--nlist 1024] [--iters 8] [--fan 8]
//   vindex truth <dir> [--k 10]
//   vindex bench <dir> [--k 10] [--nprobe 1,4,16,64] [--rerank 100] [--rounds 3] [--io mmap|pread] [--prefetch] [--threads N]
import * as fs from "velt/fs";
import { args } from "velt/process";
import { workerCount } from "velt/task";
import { build } from "./build";
import { generate, groundTruth, loadAll } from "./gen";
import { closeIndex, openIndex, Searcher } from "./index";
import type { Index, SearchOptions } from "./index";
import { openVectors, ranges } from "./store";

function option(argv: string[], name: string, fallback: string): string {
  const at = argv.indexOf(`--${name}`);
  return at >= 0 && at + 1 < argv.length ? argv[at + 1] : fallback;
}

function int(argv: string[], name: string, fallback: i64): i64 {
  return parseInt(option(argv, name, `${fallback}`)) as i64;
}

function mib(bytes: i64): string {
  return `${((bytes as number) / 1048576).toFixed(0)} MiB`;
}

type Batch = { rows: i64[]; scanned: i64; micros: i64[] };

/// Queries `[start, end)` on one worker: `k` rows per query, and each query's time.
async function searchBatch(
  ix: Index,
  queries: shared<f32[]>,
  start: i64,
  end: i64,
  o: SearchOptions,
): Promise<Batch> {
  const s = new Searcher(ix);
  const rows: i64[] = [];
  const micros: i64[] = [];
  let scanned: i64 = 0;
  for (let q = start; q < end; q++) {
    const t = performance.now();
    const hits = s.search(queries, q, o);
    micros.push(Math.round((performance.now() - t) * 1000) as i64);
    scanned += s.scanned;
    for (let i: i64 = 0; i < o.k; i++) {
      rows.push(i < hits.length ? hits[i].key : -1);
    }
  }
  return { rows, scanned, micros };
}

function recall(found: i64[], truth: i64[], k: i64, nq: i64): number {
  let hit = 0;
  for (let q: i64 = 0; q < nq; q++) {
    for (let i: i64 = 0; i < k; i++) {
      const want = truth[q * k + i];
      for (let j: i64 = 0; j < k; j++) {
        if (found[q * k + j] == want) {
          hit++;
          break;
        }
      }
    }
  }
  return hit / ((nq * k) as number);
}

async function bench(dir: string, argv: string[]) {
  const k = int(argv, "k", 10);
  const rerank = int(argv, "rerank", 100);
  const rounds = int(argv, "rounds", 3);
  const threads = int(argv, "threads", workerCount());
  const truthPath = `${dir}/truth.json`;
  if (!fs.existsSync(truthPath)) {
    throw new Error(`run \`vindex truth ${dir}\` first`);
  }
  const truth = JSON.parse(fs.readFileSync(truthPath)) as i64[];
  const qf = openVectors(`${dir}/queries.f32`);
  fs.closeSync(qf.fd);
  const nq = qf.n;
  const queries = shared(loadAll(`${dir}/queries.f32`));
  const mapped = option(argv, "io", "mmap") != "pread";
  const prefetch = argv.includes("--prefetch");
  const ix = await openIndex(dir, mapped);
  console.log(
    `${ix.n} vectors x ${ix.dim} dims, ${ix.nlist} lists, ${nq} queries, k=${k}, rerank=${rerank}, ${threads} threads, ${mapped ? (prefetch ? "mmap+prefetch" : "mmap") : "pread"}`,
  );
  console.log("nprobe  recall@k  scanned/query  ms/query(1 thread)  p99 ms  QPS(all threads)");
  for (const np of option(argv, "nprobe", "1,4,16,64").split(",")) {
    const o: SearchOptions = { k, nprobe: parseInt(np) as i64, rerank, prefetch };
    let single = Infinity;
    let p99 = 0;
    let qps = 0;
    let rec = 0;
    let scanned: i64 = 0;
    for (let round: i64 = 0; round < rounds; round++) {
      let t = performance.now();
      const one = await searchBatch(ix, queries, 0, nq, o);
      const ms = (performance.now() - t) / (nq as number);
      if (ms < single) {
        single = ms;
        one.micros.sort((a, b) => a - b);
        p99 = (one.micros[Math.floor((one.micros.length - 1) * 0.99)] as number) / 1000;
      }
      rec = recall(one.rows, truth, k, nq);
      scanned = one.scanned / nq;
      t = performance.now();
      const tasks: Promise<Batch>[] = [];
      for (const r of ranges(nq, threads)) {
        tasks.push(spawn(searchBatch(ix, queries, r[0], r[1], o)));
      }
      await Promise.all(tasks);
      const rate = ((nq as number) * 1000) / (performance.now() - t);
      if (rate > qps) {
        qps = rate;
      }
    }
    console.log(
      `${np.padStart(6)}  ${rec.toFixed(4).padStart(8)}  ${`${scanned}`.padStart(13)}  ${single.toFixed(3).padStart(18)}  ${p99.toFixed(3).padStart(6)}  ${qps.toFixed(0).padStart(16)}`,
    );
  }
  closeIndex(ix);
}

async function main(): Promise<i32> {
  const argv = args();
  const cmd = argv.length > 0 ? argv[0] : "";
  const dir = argv.length > 1 ? argv[1] : "";
  if (dir == "") {
    console.error("usage: vindex gen|build|truth|bench <dir> [options]");
    return 2;
  }
  const t = performance.now();
  if (cmd == "gen") {
    const o = {
      n: int(argv, "n", 1000000),
      dim: int(argv, "dim", 128),
      clusters: int(argv, "clusters", 10000),
      queries: int(argv, "queries", 200),
      noise: parseFloat(option(argv, "noise", "0.75")) as f32,
      seed: int(argv, "seed", 1) as u64,
    };
    await generate(dir, o);
    console.log(
      `generated ${o.n} x ${o.dim} (${mib(o.n * o.dim * 4)}) in ${(performance.now() - t).toFixed(0)} ms`,
    );
  } else if (cmd == "build") {
    const r = await build(dir, {
      nlist: int(argv, "nlist", 1024),
      iters: int(argv, "iters", 8),
      samplePerList: int(argv, "sample", 64),
      seed: int(argv, "seed", 1) as u64,
      fan: int(argv, "fan", 8),
    });
    console.log(
      `built ${r.meta.nlist} lists over ${r.meta.n} vectors: train ${r.trainMs.toFixed(0)} ms, assign ${r.assignMs.toFixed(0)} ms, write ${r.writeMs.toFixed(0)} ms; lists.bin ${mib(r.meta.n * (r.meta.dim + 4))}, scale ${r.meta.scale.toFixed(1)}`,
    );
  } else if (cmd == "truth") {
    const truth = await groundTruth(dir, int(argv, "k", 10));
    fs.writeFileSync(`${dir}/truth.json`, JSON.stringify(truth));
    console.log(`exact neighbours in ${(performance.now() - t).toFixed(0)} ms`);
  } else if (cmd == "bench") {
    await bench(dir, argv);
  } else {
    console.error(`unknown command: ${cmd}`);
    return 2;
  }
  return 0;
}
