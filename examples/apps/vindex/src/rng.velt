// A small deterministic generator (xorshift64*), so that every worker can produce its own part
// of a data set from a seed.

export class Rng {
  s: u64;

  constructor(seed: u64) {
    // splitmix64 of the seed: nearby seeds give unrelated streams, and never state 0.
    let z: u64 = seed + 0x9e3779b97f4a7c15;
    z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9;
    z = (z ^ (z >> 27)) * 0x94d049bb133111eb;
    z = z ^ (z >> 31);
    this.s = z == 0 ? 1 : z;
  }

  next(): u64 {
    let x = this.s;
    x ^= x >> 12;
    x ^= x << 25;
    x ^= x >> 27;
    this.s = x;
    return x * 0x2545f4914f6cdd1d;
  }

  /// A float in [-1, 1).
  signed(): f32 {
    return ((this.next() >> 40) as f32) * (1.0 / 8388608.0) - 1;
  }

  /// An integer in [0, n).
  below(n: i64): i64 {
    return ((this.next() >> 11) % (n as u64)) as i64;
  }
}
