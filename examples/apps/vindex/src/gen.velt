// A synthetic data set: unit vectors around random cluster centres, written by every worker at
// once (each owns a row range and its own generator), plus queries from the same clusters and
// their exact nearest rows by a brute-force scan of the file.
import * as fs from "velt/fs";
import { workerCount } from "velt/task";
import { dotF32Bytes, normalize, putF32s } from "./kernels";
import { Rng } from "./rng";
import { createVectors, openVectors, ranges, readAt, rowPos, writeAt } from "./store";
import { TopK } from "./topk";

const CHUNK: i64 = 4096; // rows per read or write

function fillRow(row: f32[], centres: f32[], clusters: i64, dim: usize, noise: f32, rng: Rng) {
  const from = (rng.below(clusters) as usize) * dim;
  for (let i: usize = 0; i < dim; i++) {
    row[i] = centres[from + i] + noise * rng.signed();
  }
  normalize(row, 0, dim);
}

async function writeRows(
  fd: number,
  centres: shared<f32[]>,
  clusters: i64,
  dim: i64,
  noise: f32,
  seed: u64,
  start: i64,
  end: i64,
): Promise<i64> {
  const d = dim as usize;
  const rng = new Rng(seed + (start as u64));
  const row: f32[] = new Array<f32>(dim as number).fill(0);
  const buf: u8[] = Buffer.alloc((CHUNK * dim * 4) as usize);
  for (let at = start; at < end; at += CHUNK) {
    const rows = at + CHUNK < end ? CHUNK : end - at;
    for (let r: i64 = 0; r < rows; r++) {
      fillRow(row, centres, clusters, d, noise, rng);
      putF32s(row, 0, d, buf, (r as usize) * d * 4);
    }
    writeAt(fd, buf, rows * dim * 4, rowPos(dim, at));
  }
  return end - start;
}

function makeCentres(clusters: i64, dim: i64, seed: u64): f32[] {
  const rng = new Rng(seed);
  const centres: f32[] = [];
  for (let i: i64 = 0; i < clusters * dim; i++) {
    centres.push(rng.signed());
  }
  return centres;
}

export type GenOptions = { n: i64; dim: i64; clusters: i64; queries: i64; noise: f32; seed: u64 };

/// Writes `dir/vectors.f32` and `dir/queries.f32`.
export async function generate(dir: string, o: GenOptions) {
  fs.mkdirSync(dir, { recursive: true });
  const centres = shared(makeCentres(o.clusters, o.dim, o.seed));
  const out = createVectors(`${dir}/vectors.f32`, o.dim, o.n);
  const tasks: Promise<i64>[] = [];
  for (const r of ranges(o.n, workerCount())) {
    tasks.push(spawn(writeRows(out.fd, centres, o.clusters, o.dim, o.noise, o.seed, r[0], r[1])));
  }
  await Promise.all(tasks);
  fs.closeSync(out.fd);
  const q = createVectors(`${dir}/queries.f32`, o.dim, o.queries);
  await writeRows(q.fd, centres, o.clusters, o.dim, o.noise, o.seed ^ 0x5eed, 0, o.queries);
  fs.closeSync(q.fd);
}

/// Every row of a vector file, as one `f32[]` (for the queries, which are few).
export function loadAll(path: string): f32[] {
  const f = openVectors(path);
  const bytes: u8[] = Buffer.alloc((f.n * f.dim * 4) as usize);
  readAt(f.fd, bytes, f.n * f.dim * 4, rowPos(f.dim, 0));
  fs.closeSync(f.fd);
  const out: f32[] = new Array<f32>((f.n * f.dim) as number).fill(0);
  for (let i: usize = 0; i < out.length as usize; i++) {
    out[i] = f32.fromBits(
      (bytes[4 * i] as u32) |
        ((bytes[4 * i + 1] as u32) << 8) |
        ((bytes[4 * i + 2] as u32) << 16) |
        ((bytes[4 * i + 3] as u32) << 24),
    );
  }
  return out;
}

async function scanPart(
  fd: number,
  queries: shared<f32[]>,
  nq: i64,
  dim: i64,
  k: i64,
  start: i64,
  end: i64,
): Promise<i64[]> {
  const d = dim as usize;
  const tops: TopK[] = [];
  for (let q: i64 = 0; q < nq; q++) {
    tops.push(new TopK(k));
  }
  const buf: u8[] = Buffer.alloc((CHUNK * dim * 4) as usize);
  for (let at = start; at < end; at += CHUNK) {
    const rows = at + CHUNK < end ? CHUNK : end - at;
    readAt(fd, buf, rows * dim * 4, rowPos(dim, at));
    for (let q: i64 = 0; q < nq; q++) {
      const top = tops[q];
      for (let r: i64 = 0; r < rows; r++) {
        const s = dotF32Bytes(buf, (r as usize) * d * 4, queries, (q as usize) * d, d);
        if (s > top.floor()) {
          top.push(at + r, s);
        }
      }
    }
  }
  // (row, score bits) pairs, k per query, so the parts merge without another type crossing.
  const out: i64[] = [];
  for (const top of tops) {
    const hits = top.sorted();
    for (let i: i64 = 0; i < k; i++) {
      out.push(i < hits.length ? hits[i].key : -1);
      out.push(i < hits.length ? (hits[i].score.toBits() as i64) : 0);
    }
  }
  return out;
}

/// The exact `k` nearest rows of every query, `k` row numbers per query, best first.
export async function groundTruth(dir: string, k: i64): Promise<i64[]> {
  const f = openVectors(`${dir}/vectors.f32`);
  const qf = openVectors(`${dir}/queries.f32`);
  fs.closeSync(qf.fd);
  const queries = shared(loadAll(`${dir}/queries.f32`));
  const tasks: Promise<i64[]>[] = [];
  for (const r of ranges(f.n, workerCount())) {
    tasks.push(spawn(scanPart(f.fd, queries, qf.n, f.dim, k, r[0], r[1])));
  }
  const parts = await Promise.all(tasks);
  fs.closeSync(f.fd);
  const truth: i64[] = [];
  for (let q: i64 = 0; q < qf.n; q++) {
    const top = new TopK(k);
    for (const p of parts) {
      for (let i: i64 = 0; i < k; i++) {
        const row = p[(q * k + i) * 2];
        if (row >= 0) {
          top.push(row, f32.fromBits(p[(q * k + i) * 2 + 1] as u32));
        }
      }
    }
    for (const h of top.sorted()) {
      truth.push(h.key);
    }
  }
  return truth;
}
