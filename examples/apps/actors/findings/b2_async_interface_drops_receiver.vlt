// B2: an async method called through an interface value drops the receiver when the call
// ends (a use after free): the second call reads freed memory. Concrete class receivers and
// sync methods are fine. Expected: the label twice. Actual: the label, then an empty line.
interface Act {
  invoke(): Promise<string>;
}

class Live implements Act {
  label: string = "a label long enough to live on the heap";

  async invoke(): Promise<string> {
    return this.label;
  }
}

async function main() {
  const a: Act = new Live();
  console.log(await a.invoke());
  console.log(await a.invoke());
}
