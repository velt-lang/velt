// B8: a field initializer that calls a throwing function crashes the compiler:
// "ICE: error thrown outside a throwing function or try block" (velt_vir lower/mod.rs).
// Expected: a diagnostic (the initializer may throw `JsonError`), not a crash.
import { Value } from "velt:json";

class Slot {
  v: Value = JSON.parseValue("1");
}

function main() {
  console.log(new Slot().v.stringify());
}
