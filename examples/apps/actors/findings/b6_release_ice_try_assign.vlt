// B6: `velt build --release` fails with "internal compiler error: VIR verification failed after
// optimization: local _N may be used before it is assigned" for a variable assigned in `try`
// (whose `catch` always throws) and read after an `await`. `velt run` is fine (42, bad: ...).
class Bad extends Error {}

async function f(text: string): Promise<i64> throws Bad {
  let a: i64;
  try {
    a = JSON.parse<i64>(text);
  } catch (e) {
    throw new Bad(e.message);
  }
  await sleep(1);
  return a + 1;
}

async function main() {
  try {
    console.log(await f("41"));
    console.log(await f("x"));
  } catch (e) {
    console.log("bad:", e.message);
  }
}
