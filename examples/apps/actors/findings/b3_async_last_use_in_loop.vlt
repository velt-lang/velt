// B3: a shared object (refcount 2) passed to an async function as its last use in a loop body
// is moved without a reference being added, so every iteration gives one away and the object
// is freed while still in use. Expected: the name on all five lines. Actual: from the third
// line on it is empty. Using `b` once more after the call, or a sync callee, makes it correct.
class Box {
  name: string = "a string long enough to live on the heap";
}

async function use(b: Box): Promise<void> {}

async function main() {
  const b = new Box();
  const alias = b;
  for (let i = 0; i < 4; i++) {
    console.log(`${i}: '${b.name}'`);
    await use(b);
  }
  console.log(`alias: '${alias.name}'`);
}
