// B5: an async method called on a local copied out of an array element makes ownership
// inference oscillate. It stops at its visit cap (crates/velt_sema/src/ownership/infer.rs,
// `64 * fns + 10_000`; only a debug_assert reports it) and leaves unrelated functions with
// default "borrowed" parameter modes, so legal code elsewhere fails to compile:
//   error: cannot keep a copy of `f`, a borrowed function parameter      (on `this.f = f`)
// In a bigger program the errors land on uncalled std code (std/timers.vlt `setTimeout`,
// std/http/stream.vlt). Calling `boxes[0].get()` directly compiles.
class Box {
  async get(): Promise<i64> {
    return 1;
  }
}

class M {
  f: () => void;

  constructor(f: () => void) {
    this.f = f;
  }
}

async function main() {
  const boxes = [new Box()];
  const b = boxes[0];
  await b.get();
}
