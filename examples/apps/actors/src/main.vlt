// actors: a virtual-actor runtime in Velt, after @sigx/actors (see README.md).
//   actors serve [--port 5199] [--shards N]     the wire endpoint
//   actors bench [--duration 2000] [--shards N] in-process benchmarks
//   actors calls [--scenario warm|fan] [--c 64] [--n 100000] [--shards N]
//                                               a fixed number of calls, for CPU-time comparisons
import { args } from "velt:process";
import { availableParallelism } from "velt:os";
import {
  ActorStorage,
  ActorType,
  HostConfig,
  MemoryStorage,
  defaultHostOptions,
  startHost,
} from "./runtime";
import { actorTypes } from "./app";
import { serveActors } from "./wire";
import { fixedCalls, runBenchmarks } from "./bench";

struct AppConfig implements HostConfig {
  types(): Map<string, ActorType> {
    return actorTypes();
  }

  storage(): ActorStorage {
    return new MemoryStorage();
  }
}

function flag(argv: string[], name: string, fallback: string): string {
  const i = argv.indexOf(`--${name}`);
  if (i >= 0 && (i + 1) as usize < argv.length) {
    return argv[i + 1];
  }
  return fallback;
}

async function main() {
  const argv = args();
  const command = argv.length > 0 ? argv[0] : "serve";
  const opts = defaultHostOptions();
  opts.shards = parseInt(flag(argv, "shards", "0")) as i64;
  const host = startHost<AppConfig>(opts, availableParallelism(), {});
  if (command == "serve") {
    const port = parseInt(flag(argv, "port", "5199")) as i64;
    const server = await serveActors(host.router, port, flag(argv, "host", "127.0.0.1"));
    console.log(
      `actors: ${host.shards} shards, listening on http://127.0.0.1:${server.port}/_sigx/actor/`,
    );
    return;
  }
  if (command == "bench") {
    await runBenchmarks(host, parseFloat(flag(argv, "duration", "2000")), flag(argv, "only", ""));
    await host.stop();
    return;
  }
  if (command == "calls") {
    const c = parseInt(flag(argv, "c", "64")) as i64;
    const n = parseInt(flag(argv, "n", "100000")) as i64;
    await fixedCalls(host, flag(argv, "scenario", "warm"), c, n);
    await host.stop();
    return;
  }
  console.log(`unknown command ${command}: serve | bench | calls`);
}
