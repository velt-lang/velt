// The sigx actor wire endpoint: `POST {base}/{Type}/{method}` with `{"args":[key, ...args]}`,
// answered with `{"data":…}` or `{"error":{"status","message","data":{"kind"}}}` — the same
// requests and bodies as `handleActorRequest` in @sigx/actors/server, so one client and one
// load generator drive both.
import { serve, Request, Response, Server } from "velt:http";
import { Value } from "velt:json";
import { Router, Reply, errorReply } from "./runtime";

export const BASE = "/_sigx/actor/";

function respond(r: Reply): Response {
  const res = Response.text(r.body, r.status);
  res.setHeader("content-type", "application/json");
  return res;
}

function parseBody(text: string): Value | null {
  try {
    return JSON.parseValue(text);
  } catch (e) {
    return null;
  }
}

// Handles one wire request. `defaultTimeoutMs` (0 = none) stamps a deadline on the call, which
// `x-sigx-deadline-ms` overrides.
export async function handleActorRequest(
  router: Router,
  req: Request,
  defaultTimeoutMs: f64,
): Promise<Response> {
  const path = req.path;
  if (!path.startsWith(BASE)) {
    return respond(errorReply(404, "not-found", "not an actor route"));
  }
  if (req.method != "POST") {
    return respond(errorReply(405, "method-not-allowed", "use POST"));
  }
  const rest = path.slice(BASE.length as i64);
  const slash = rest.lastIndexOf("/");
  if (slash <= 0) {
    return respond(errorReply(404, "not-found", "expected {Type}/{method}"));
  }
  const type = rest.slice(0, slash);
  const method = rest.slice(slash + 1);
  const body = parseBody(req.body);
  const args = body?.get("args");
  if (args == null || !args.isArray()) {
    return respond(errorReply(400, "bad-request", "expected {\"args\":[key, ...]}"));
  }
  const key = args.at(0)?.asString();
  if (key == null || key == "") {
    return respond(errorReply(400, "bad-request", "the first argument must be the actor key"));
  }
  let budget = defaultTimeoutMs;
  const header = req.header("x-sigx-deadline-ms");
  if (header != null) {
    budget = parseFloat(header);
  }
  const deadline = budget > 0.0 ? performance.now() + budget : 0.0;
  return respond(await router.send(type, key, method, args, [], deadline));
}

export async function serveActors(router: Router, port: i64, host: string): Promise<Server> {
  return await serve({ port: port, host: host }, async (req: Request): Promise<Response> => {
    return await handleActorRequest(router, req, 30000.0);
  });
}
