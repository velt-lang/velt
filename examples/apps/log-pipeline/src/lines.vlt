// Splitting a stream of text chunks into lines. `FileReader.readLine()` makes one runtime round
// trip per line (~10 µs), which dominated the whole pipeline; reading 1 MiB chunks and splitting
// them here is ~45x faster. (A class with an `async next()` can't keep state: async methods take
// `this` by value, so the reading loop lives in `analyze` and this class stays synchronous.)

export class LineSplitter {
  // Complete lines of the current chunk, last line first (so `pop()` hands them out in order).
  private pending: string[] = [];
  // The unfinished last line of the chunks so far.
  private rest: string = "";

  // Adds the next chunk of text.
  feed(chunk: string) {
    const lines = `${this.rest}${chunk}`.split("\n");
    this.rest = lines.pop() ?? "";
    lines.reverse();
    this.pending = lines;
  }

  // Marks the end of the input: an unterminated last line becomes a line.
  finish() {
    if (this.rest != "") {
      this.pending.push(this.rest.clone());
    }
    this.rest = "";
  }

  // The next complete line (without "\n"), or null until more is fed.
  next(): string | null {
    return this.pending.pop();
  }
}
