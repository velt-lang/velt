// Unit tests of the sigx provider's SSR output (the format @sigx/server-renderer produces; the
// expected strings were taken from real sigx output).

import { component, renderToString } from "../src/lib";
import { renderDocument } from "../src/server";

const Counter = component<{ start: number }>((ctx) => {
  const count = ctx.signal(ctx.props.start);
  const double = ctx.computed(() => count.value * 2, 0);
  return () => (
    <p>
      Count: {count.value} doubled {double.value}
    </p>
  );
});

function Plain(props: { label: string }): JSX.Element {
  return <b>{props.label}</b>;
}

const Parent = component<{ n: number }>((ctx) => {
  return () => (
    <div>
      <Counter start={ctx.props.n} />
      <Counter start={ctx.props.n + 1} />
    </div>
  );
});

export async function test_component_markers_are_pre_order() {
  const html = await renderToString(
    <section>
      <Parent n={1} />
      <Plain label="x" />
    </section>,
  );
  assertEq(
    html,
    "<section><div><p>Count: <!--t-->1<!--t--> doubled <!--t-->2</p><!--$c:2-->" +
      "<p>Count: <!--t-->2<!--t--> doubled <!--t-->4</p><!--$c:3--></div><!--$c:1-->" +
      "<b>x</b></section>",
  );
}

export async function test_text_and_attributes_are_escaped() {
  const v = "a<b>&\"c'";
  assertEq(
    await renderToString(<p title={v}>{v}</p>),
    "<p title=\"a&lt;b&gt;&amp;&quot;c&#39;\">a&lt;b&gt;&amp;&quot;c&#39;</p>",
  );
}

export async function test_booleans_and_null_render_placeholders() {
  const n: string | null = null;
  assertEq(
    await renderToString(
      <p hidden={false} title={n}>
        {true}
        {false}
        {n}x
      </p>,
    ),
    "<p><!----><!----><!---->x</p>",
  );
  assertEq(await renderToString(<input disabled={true} />), "<input disabled>");
}

export async function test_text_separator_crosses_fragments() {
  const a = "a";
  assertEq(
    await renderToString(
      <p>
        {a}
        <>{"b"}</>c
      </p>,
    ),
    "<p>a<!--t-->b<!--t-->c</p>",
  );
}

export async function test_handlers_render_nothing() {
  assertEq(
    await renderToString(
      <button id="b" onClick={() => {}}>
        go
      </button>,
    ),
    "<button id=\"b\">go</button>",
  );
}

export async function test_sole_null_child_renders_nothing() {
  const n: string | null = null;
  assertEq(await renderToString(<p>{n}</p>), "<p></p>");
  assertEq(await renderToString(<p>{n}a</p>), "<p><!---->a</p>");
}

export async function test_render_document_fills_the_outlet() {
  assertEq(
    await renderDocument(
      "<body><div id=\"app\"><!--ssr-outlet--></div></body>",
      <Counter start={2} />,
    ),
    "<body><div id=\"app\"><p>Count: <!--t-->2<!--t--> doubled <!--t-->4</p><!--$c:1--></div>" +
      "<script>window.__SIGX_STREAMING_COMPLETE__=true;window.dispatchEvent(new Event('sigx:ready'));</script></body>",
  );
}
