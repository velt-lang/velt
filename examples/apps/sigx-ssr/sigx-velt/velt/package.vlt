import type { Package } from "velt:package";

// The Velt half of the npm package `@sigx/velt`: sigx's server renderer as a Velt JSX provider.
// An app depends on it by path (`node_modules/@sigx/velt/velt`) under the name `sigx`, so its
// shared components import `component` from "sigx" in both compilers: Vite resolves the npm
// package, Velt this one.
export const pkg: Package = {
  name: "sigx",
  version: "0.0.1",
  description: "sigx server rendering for Velt (the provider behind @sigx/velt)",
  jsx: { importSource: "./src" },
};
