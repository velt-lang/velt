// sigx/server: serving a sigx app from a Velt binary. The counterpart of
// @sigx/server-renderer's `createFetchHandler`, in sigx's composition order: static assets
// first, then the document render.
//
//   main(): const opts = options();     // --host, --port, --template, --static (see below)
//           await serveApp(opts, (url) => <App />, serverFns);
//
// In development the @sigx/velt Vite plugin starts the program with `--dev`: it then serves
// only documents (Vite serves the client modules and assets) and reads the template on each
// request, so edits to index.html show up without a restart.

import { serve, Server } from "velt:http";
import { readFile, readFileBytes, exists } from "velt:fs";
import { args, exit } from "velt:process";
import { decodeURIComponent } from "velt:url";
import { BodyStream } from "velt:fetch";
import { utf8Encode } from "velt:encoding";
import { IoError } from "velt:io";
import { AbortError } from "velt:task";
import { Element, Renderer } from "./node";

export struct Options {
  // Where to listen: 127.0.0.1 unless set (a container or a host's proxy needs 0.0.0.0).
  host: string;
  port: number;
  // The HTML shell with `<!--ssr-outlet-->` where the app goes (Vite's built index.html).
  template: string;
  // The client build to serve, or "" for none (dev).
  staticDir: string;
  dev: bool;
}

// Options from the command line, then the environment: `--host H` (`HOST`, default 127.0.0.1),
// `--port N` (`PORT`, default 3000), `--template FILE` (default dist/client/index.html),
// `--static DIR` (default dist/client), `--dev`. Paths are relative to the working directory.
export function options(): Options {
  const argv = args();
  let host = process.env.HOST ?? "127.0.0.1";
  let port = parseInt(process.env.PORT ?? "3000");
  let template = "dist/client/index.html";
  let staticDir = "dist/client";
  let dev = false;
  let i = 0;
  while (i < argv.length) {
    const a = argv[i];
    if (a == "--dev") {
      dev = true;
      staticDir = "";
    } else if (a == "--host" && i + 1 < argv.length) {
      host = argv[i + 1];
      i += 1;
    } else if (a == "--port" && i + 1 < argv.length) {
      port = parseInt(argv[i + 1]);
      i += 1;
    } else if (a == "--template" && i + 1 < argv.length) {
      template = argv[i + 1];
      i += 1;
    } else if (a == "--static" && i + 1 < argv.length) {
      staticDir = argv[i + 1];
      i += 1;
    } else {
      console.error(`unknown option ${a} (expected --host, --port, --template, --static, --dev)`);
      exit(2);
    }
    i += 1;
  }
  if (!Number.isInteger(port) || port < 0 || port > 65535) {
    console.error(`invalid port: ${port}`);
    exit(2);
  }
  return Options { host: host, port: port, template: template, staticDir: staticDir, dev: dev };
}

const OUTLET = "<!--ssr-outlet-->";

// What sigx's streaming writes (@sigx/server-renderer 1.0.1, byte for byte): the function its
// replacement scripts call, and the completion signal the client waits for.
const BOOTSTRAP =
  "\n<script>\nwindow.$SIGX_REPLACE = function(id, html) {\n    var placeholder = document.querySelector('[data-async-placeholder=\"' + id + '\"]');\n    if (placeholder) {\n        var template = document.createElement('template');\n        template.innerHTML = html;\n        placeholder.innerHTML = '';\n        while (template.content.firstChild) {\n            placeholder.appendChild(template.content.firstChild);\n        }\n        placeholder.dispatchEvent(new CustomEvent('sigx:async-ready', { bubbles: true, detail: { id: id } }));\n    }\n};\n</script>";
const COMPLETE =
  "<script>window.__SIGX_STREAMING_COMPLETE__=true;window.dispatchEvent(new Event('sigx:ready'));</script>";

function scriptOf(js: string): string {
  return js == "" ? "" : `<script>${js}</script>`;
}

// The template with the rendered app in place of `<!--ssr-outlet-->`, every data load awaited
// (sigx's blocking `renderDocument`).
export async function renderDocument(template: string, app: Element): Promise<string> {
  const r = new Renderer();
  await r.render(app);
  const at = template.indexOf(OUTLET);
  if (at < 0) {
    return template;
  }
  const after = template.slice(at + OUTLET.length);
  const end = after.lastIndexOf("</body>");
  const cut = end < 0 ? after.length : end;
  return template.slice(0, at) +
    r.take() +
    scriptOf(r.state.script()) +
    after.slice(0, cut) +
    COMPLETE +
    after.slice(cut);
}

// The document as sigx streams it (`renderDocumentToWebStream`): the shell with each loading
// component's pending state, then one script per component as its data arrives, then the
// completion signal and the end of the template.
async function* streamDocument(
  template: string,
  app: Element,
): AsyncGenerator<u8[], IoError | AbortError> {
  const r = new Renderer();
  r.streaming = true;
  await r.render(app);
  const at = template.indexOf(OUTLET);
  const before = at < 0 ? template : template.slice(0, at);
  const after = at < 0 ? "" : template.slice(at + OUTLET.length);
  const end = after.lastIndexOf("</body>");
  const cut = end < 0 ? after.length : end;
  yield utf8Encode(before + r.take() + scriptOf(r.state.script()) + after.slice(0, cut));
  if (r.pending.length > 0) {
    yield utf8Encode(BOOTSTRAP);
  }
  while (true) {
    const script = await r.next();
    if (script == "") {
      break;
    }
    yield utf8Encode(script);
  }
  yield utf8Encode(scriptOf(r.state.script()) + COMPLETE + after.slice(cut));
}

// --- Server functions ---
//
// The browser calls a server function through sigx's client (`@sigx/server/client`): `POST
// /_sigx/fn/<key>` with `{"args":[input]}`, answered by `{"data": result}` or
// `{"error": {"message", "status"}}`. The @sigx/velt Vite plugin generates the browser's stubs
// for the functions a `*.server.vlt` module exports; the server registers the same functions here.

export const SERVER_FN_BASE = "/_sigx/fn";

export class ServerFn {
  key: string;
  // The request body to the response's JSON, or a thrown error.
  call: (body: string) => Promise<string>;

  constructor(key: string, call: (body: string) => Promise<string>) {
    this.key = key;
    this.call = call;
  }
}

type Args<I> = { args: I[] };
type ErrorEnvelope = { error: { status: number } };

// The error envelope; `callServerFn` answers with its status.
function failure(status: number, message: string): string {
  return `{"error":{"message":${JSON.stringify(message)},"status":${status}}}`;
}

// A server function without input, under `key` (`<module>/<export>`, e.g. "api.server/getStats").
export function serverFn<O>(key: string, handler: () => Promise<O>): ServerFn {
  return new ServerFn(key, async (body: string): Promise<string> => {
    try {
      const result = await handler();
      return `{"data":${JSON.stringify(result)}}`;
    } catch (e) {
      console.error(`server function ${key} failed: ${e}`);
      return failure(500, "Internal error");
    }
  });
}

// A server function with one input.
export function serverFnWith<I, O>(key: string, handler: (input: I) => Promise<O>): ServerFn {
  return new ServerFn(key, async (body: string): Promise<string> => {
    let input: Args<I> | null = null;
    try {
      input = JSON.parse<Args<I>>(body);
    } catch (e) {
      return failure(400, "Malformed body: expected {\"args\": [input]}");
    }
    const req = input!;
    if (req.args.length != 1) {
      return failure(400, "server functions take a single input argument");
    }
    try {
      const result = await handler(req.args[0]);
      return `{"data":${JSON.stringify(result)}}`;
    } catch (e) {
      console.error(`server function ${key} failed: ${e}`);
      return failure(500, "Internal error");
    }
  });
}

function jsonResponse(status: number, body: string): Response {
  return new Response(body, { status: status, headers: { "content-type": "application/json" } });
}

function errorResponse(status: number, message: string): Response {
  return jsonResponse(
    status,
    `{"error":{"message":${JSON.stringify(message)},"status":${status}}}`,
  );
}

async function callServerFn(fns: ServerFn[], req: Request, pathname: string): Promise<Response> {
  if (req.method != "POST") {
    return errorResponse(405, "Method not allowed");
  }
  if (!(req.headers.get("content-type") ?? "").toLowerCase().startsWith("application/json")) {
    return errorResponse(415, "Unsupported media type");
  }
  // sigx's client percent-encodes each segment of the key.
  let key = "";
  try {
    key = decodeURIComponent(pathname.slice(SERVER_FN_BASE.length + 1));
  } catch (e) {
    return errorResponse(400, "Malformed server function path");
  }
  for (const fn of fns) {
    if (fn.key == key) {
      const call = fn.call;
      const out = await call(await req.text());
      if (out.startsWith(`{"error"`)) {
        return jsonResponse(JSON.parse<ErrorEnvelope>(out).error.status, out);
      }
      return jsonResponse(200, out);
    }
  }
  return errorResponse(404, `Unknown server function "${key}"`);
}

function contentType(path: string): string {
  const dot = path.lastIndexOf(".");
  const ext = dot < 0 ? "" : path.slice(dot + 1).toLowerCase();
  if (ext == "js" || ext == "mjs") {
    return "text/javascript; charset=utf-8";
  }
  if (ext == "css") {
    return "text/css; charset=utf-8";
  }
  if (ext == "html") {
    return "text/html; charset=utf-8";
  }
  if (ext == "json" || ext == "map") {
    return "application/json";
  }
  if (ext == "svg") {
    return "image/svg+xml";
  }
  if (ext == "png") {
    return "image/png";
  }
  if (ext == "jpg" || ext == "jpeg") {
    return "image/jpeg";
  }
  if (ext == "ico") {
    return "image/x-icon";
  }
  if (ext == "woff2") {
    return "font/woff2";
  }
  if (ext == "wasm") {
    return "application/wasm";
  }
  return "application/octet-stream";
}

// The file under `dir` that `pathname` names, or null: no `..`, no directories, and never the
// template (documents are rendered, not served raw).
async function staticFile(dir: string, pathname: string): Promise<Response | null> {
  if (dir == "" || pathname == "/" || pathname.includes("..") || pathname.endsWith("/")) {
    return null;
  }
  if (pathname == "/index.html") {
    return null;
  }
  const path = `${dir}${pathname}`;
  if (!(await exists(path))) {
    return null;
  }
  try {
    const body = await readFileBytes(path);
    // Vite's hashed output under /assets/ never changes; everything else revalidates.
    const cache =
      pathname.startsWith("/assets/") ? "public, max-age=31536000, immutable" : "no-cache";
    return new Response(body, {
      headers: { "content-type": contentType(path), "cache-control": cache },
    });
  } catch (e) {
    return null;
  }
}

// Serves the app in sigx's order: static files from `opts.staticDir`, server functions under
// /_sigx/fn, then every other request as a document rendered by `render(pathname)` into the
// template and streamed. Exits if the template has no `<!--ssr-outlet-->`.
export async function serveApp(
  opts: Options,
  render: (pathname: string) => Element,
  fns: ServerFn[] = [],
): Promise<Server> {
  const cached = await readFile(opts.template);
  if (!cached.includes(OUTLET)) {
    console.error(`${opts.template} has no ${OUTLET}: nowhere to render the app`);
    exit(1);
  }
  const server = await serve({ host: opts.host, port: opts.port }, async (
    req: Request,
  ): Promise<Response> => {
    const url = new URL(req.url);
    const file = await staticFile(opts.staticDir, url.pathname);
    if (file != null) {
      return file;
    }
    if (url.pathname.startsWith(`${SERVER_FN_BASE}/`)) {
      return await callServerFn(fns, req, url.pathname);
    }
    const template = opts.dev ? await readFile(opts.template) : cached;
    return new Response(BodyStream.from(streamDocument(template, render(url.pathname))), {
      headers: { "content-type": "text/html; charset=utf-8" },
    });
  });
  console.log(`sigx: listening on http://${opts.host}:${server.port}${opts.dev ? " (dev)" : ""}`);
  return server;
}
