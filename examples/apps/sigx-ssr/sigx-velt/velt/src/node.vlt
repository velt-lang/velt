// sigx/node: what every JSX expression evaluates to under the sigx provider, and the renderer
// that turns it into sigx-compatible SSR HTML.
//
// Elements are built eagerly where they can be: an intrinsic element or fragment whose children
// contain no component is one string by the time it is complete (`html`). A component is never
// called when its element is built: its node holds a `setup` thunk that the renderer runs
// parent-first, handing it the per-render `Renderer`. That is what gives sigx's pre-order
// component ids (`<!--$c:N-->`, the hydration anchors), and it is how per-render state (the id
// counter, the reactive runtime) reaches a component without module-level state, which Velt
// does not have.
//
// sigx's server renderer separates adjacent text nodes in one DOM parent with `<!--t-->` (the
// browser's parser would merge them, and hydration claims them one by one). Text adjacency is
// tracked inside a node while it is built and across nodes by the renderer: every chunk records
// whether it starts and ends with text.

import { Runtime } from "./reactivity";

// What an intrinsic attribute may hold: `true` renders the bare name, `false` and `null` omit
// the attribute, numbers render like `${n}`.
export type AttrValue = string | number | bool | null;

// Text a precompiled template folds into its strings.
export type Text = string | number | bool | null;

// What may appear as a child: text is escaped, numbers render like `${n}`, `true`, `false` and
// `null` render nothing, and an array renders its elements in order.
export type Child = Element | Element[] | string | number | bool | null;

export class Element {
  // Markup of this node; with `parts`, only what precedes them.
  html: string;
  // `html` starts / ends with a text node (drives the `<!--t-->` separators).
  textStart: bool = false;
  textEnd: bool = false;
  // What follows `html`, in document order, when the node contains a component.
  parts: Element[] | null = null;
  // Set on a component's node: the component, started by the renderer when it reaches it.
  setup: ((r: Renderer) => Instance) | null = null;
  // Set on a component used with a `client:*` directive: hydrated on its own (sigx islands).
  island: Island | null = null;

  constructor(html: string) {
    this.html = html;
  }

  // True when `html` is the whole node (no component inside).
  get isComplete(): bool {
    return this.parts == null && this.setup == null;
  }
}

// What sigx's islands need to hydrate a component on its own: when (`load`, `idle`,
// `visible`, `interaction`, `only`, `media`), its name (the island module's export) and its props.
export class Island {
  hydrate: string;
  media: string | null;
  component: string;
  props: string;

  constructor(hydrate: string, media: string | null, component: string, props: string) {
    this.hydrate = hydrate;
    this.media = media;
    this.component = component;
    this.props = props;
  }
}

// Where an island's code is in the client build: @sigx/vite's islands manifest
// (dist/client/.vite/sigx-islands-manifest.json, version 2).
export type IslandChunk = { chunkUrl: string; exportName: string };
export type IslandsManifest = { islands: Record<string, IslandChunk>; runtimePreload: string[] };

// A started component: its render function, and the data loads its setup registered
// (`useData`). With loads, the render function shows their pending state until they finish.
export interface Load {
  run(): Promise<void>;
}

export class Instance {
  view: () => Element;
  loads: Load[];

  constructor(view: () => Element, loads: Load[]) {
    this.view = view;
    this.loads = loads;
  }
}

// A component's node: `run` is called by the renderer, parent first.
export function componentNode(run: (r: Renderer) => Instance): Element {
  const node = new Element("");
  node.setup = run;
  return node;
}

// Builds one node from a sequence of markup, text and child elements, folding complete
// children into the current string and keeping incomplete ones as parts.
export class Builder {
  cur: string = "";
  curTextStart: bool = false;
  lastText: bool = false;
  started: bool = false;
  parts: Element[] = [];
  first: Element | null = null;

  // Markup (a tag or a comment): never text.
  markup(s: string) {
    if (!this.started) {
      this.started = true;
      this.curTextStart = false;
    }
    this.cur += s;
    this.lastText = false;
  }

  // Already escaped text; empty text emits nothing (as in sigx).
  text(s: string) {
    if (s == "") {
      return;
    }
    if (!this.started) {
      this.started = true;
      this.curTextStart = true;
    }
    if (this.lastText) {
      this.cur += "<!--t-->";
    }
    this.cur += s;
    this.lastText = true;
  }

  // A child element.
  element(el: Element) {
    if (el.isComplete) {
      if (el.html == "") {
        return;
      }
      if (!this.started) {
        this.started = true;
        this.curTextStart = el.textStart;
      }
      if (this.lastText && el.textStart) {
        this.cur += "<!--t-->";
      }
      this.cur += el.html;
      this.lastText = el.textEnd;
      return;
    }
    this.flush();
    this.parts.push(el);
    // What the incomplete child ends with is known only when it is rendered: the renderer
    // decides about separators between parts.
    this.lastText = false;
    this.started = false;
  }

  // Ends the current string run as a chunk.
  flush() {
    if (this.cur == "" && this.first != null) {
      return;
    }
    const chunk = new Element(this.cur);
    chunk.textStart = this.curTextStart;
    chunk.textEnd = this.lastText;
    if (this.first == null) {
      this.first = chunk;
    } else {
      this.parts.push(chunk);
    }
    this.cur = "";
    this.started = false;
    this.curTextStart = false;
  }

  finish(): Element {
    this.flush();
    const head = this.first;
    if (head == null) {
      return new Element("");
    }
    if (this.parts.length > 0) {
      head.parts = this.parts;
    }
    return head;
  }
}

// Data that resolved during the render, for `window.__SIGX_ASYNC__`: the client's `useData`
// restores it instead of fetching again. Entries are `"key":json`, removed once written.
export class State {
  entries: string[] = [];

  add(key: string, json: string) {
    this.entries.push(`${JSON.stringify(key)}:${json}`);
  }

  // The script that merges the unwritten entries into `window.__SIGX_ASYNC__` ("" for none).
  script(): string {
    if (this.entries.length == 0) {
      return "";
    }
    const body = `{${this.entries.join(",")}}`;
    this.entries = [];
    return `window.__SIGX_ASYNC__=Object.assign(Object.create(null),window.__SIGX_ASYNC__,${escapeForScript(body)});`;
  }
}

// JSON inside a <script>: `<`, `>`, U+2028 and U+2029 escaped (sigx's escapeJsonForScript).
export function escapeForScript(json: string): string {
  return json
    .replaceAll("<", "\\u003c")
    .replaceAll(">", "\\u003e")
    .replaceAll("\u2028", "\\u2028")
    .replaceAll("\u2029", "\\u2029");
}

// A component whose data is still loading: streamed after the shell (`$SIGX_REPLACE`).
class Pending {
  id: number;
  inst: Instance;

  constructor(id: number, inst: Instance) {
    this.id = id;
    this.inst = inst;
  }
}

async function runLoads(loads: Load[]): Promise<void> {
  const running: Promise<void>[] = [];
  for (const load of loads) {
    running.push(load.run());
  }
  await Promise.all(running);
}

// Per-render state: the output, the next component id, the reactive runtime components create
// their signals in, the data state, and (when streaming) the components still loading.
export class Renderer {
  // Output pieces, joined once at the end (measured the same as `+=` on one string, velt-lang/velt#379).
  out: string[] = [];
  nextId = 1;
  lastText: bool = false;
  rt: Runtime = new Runtime();
  state: State = new State();
  // Streaming: a component with loads renders its pending state in a placeholder, and its real
  // content follows the shell. Otherwise the render waits for the loads (renderToString).
  streaming: bool = false;
  pending: Pending[] = [];
  // Islands rendered so far, as `__SIGX_BOUNDARIES__` entries (`"id":{…}`), and the build's
  // islands manifest (production: each island's chunk).
  boundaries: string[] = [];
  manifest: IslandsManifest | null = null;
  // The chunks of the islands rendered, for `<link rel="modulepreload">`.
  preload: string[] = [];

  async render(el: Element): Promise<void> {
    const setup = el.setup;
    if (setup != null) {
      // Pre-order ids: the component's id is taken before its children render.
      const id = this.nextId;
      this.nextId += 1;
      const island = el.island;
      if (island != null) {
        const record = this.record(island);
        this.boundaries.push(`"${id}":${record}`);
        if (island.hydrate == "only") {
          // Rendered in the browser only: setup does not run here.
          this.out.push(
            `<div data-boundary="${id}" style="display:contents;"></div><!--$c:${id}-->`,
          );
          this.lastText = false;
          return;
        }
      }
      const inst = setup(this);
      if (inst.loads.length == 0) {
        await this.render(inst.view());
      } else if (this.streaming) {
        this.out.push(`<div data-async-placeholder="${id}" style="display:contents;">`);
        this.lastText = false;
        await this.render(inst.view());
        this.out.push("</div>");
        this.pending.push(new Pending(id, inst));
      } else {
        await runLoads(inst.loads);
        await this.render(inst.view());
      }
      this.out.push(`<!--$c:${id}-->`);
      this.lastText = false;
      return;
    }
    if (el.html != "") {
      if (this.lastText && el.textStart) {
        this.out.push("<!--t-->");
      }
      this.out.push(el.html);
      this.lastText = el.textEnd;
    }
    const parts = el.parts;
    if (parts != null) {
      for (const p of parts) {
        await this.render(p);
      }
    }
  }

  // An island's `__SIGX_BOUNDARIES__` record, fields in sigx's order.
  record(island: Island): string {
    const parts: string[] = [];
    if (island.hydrate == "only") {
      parts.push(`"flush":"skip","hydrate":"load"`);
    } else {
      parts.push(`"hydrate":${JSON.stringify(island.hydrate)}`);
    }
    const media = island.media;
    if (media != null) {
      parts.push(`"media":${JSON.stringify(media)}`);
    }
    const manifest = this.manifest;
    const chunk: IslandChunk | null = manifest == null ? null : manifest.islands[island.component];
    if (chunk != null) {
      if (!this.preload.includes(chunk.chunkUrl)) {
        this.preload.push(chunk.chunkUrl);
      }
      parts.push(
        `"chunk":{"url":${JSON.stringify(chunk.chunkUrl)},"export":${JSON.stringify(chunk.exportName)}}`,
      );
    }
    parts.push(`"component":${JSON.stringify(island.component)}`);
    parts.push(`"props":${island.props}`);
    return `{${parts.join(",")}}`;
  }

  // The script that adds the islands rendered so far to `window.__SIGX_BOUNDARIES__` ("" for none).
  boundaryScript(): string {
    if (this.boundaries.length == 0) {
      return "";
    }
    const table = `{${this.boundaries.join(",")}}`;
    this.boundaries = [];
    return `window.__SIGX_BOUNDARIES__=Object.assign(Object.create(null),window.__SIGX_BOUNDARIES__,${escapeForScript(table)});`;
  }

  // The output so far, emptied.
  take(): string {
    const html = this.out.join("");
    this.out = [];
    return html;
  }

  // The next streamed component once its data has loaded: the `<script>` that puts its content
  // in its placeholder (and its data in `__SIGX_ASYNC__`), or "" when none is left. Components it
  // contains that load data of their own are queued after it; their ids follow the shell's.
  async next(): Promise<string> {
    const p = this.pending.shift();
    if (p == null) {
      return "";
    }
    await runLoads(p.inst.loads);
    this.lastText = false;
    await this.render(p.inst.view());
    const html = escapeForScript(JSON.stringify(this.take()));
    return `<script>${this.state.script()}$SIGX_REPLACE(${p.id}, ${html});</script>`;
  }
}

// The HTML sigx's `renderToString` produces for `el`: components run parent-first, each
// followed by its `<!--$c:N-->` marker; data loads are waited for.
export async function renderToString(el: Element): Promise<string> {
  const r = new Renderer();
  await r.render(el);
  return r.out.join("");
}
