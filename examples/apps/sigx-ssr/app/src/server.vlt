// The native server: static files from the client build, server functions, every other page
// rendered by Velt.
// `vite` (dev) starts it with `--dev`; `vite build` compiles it to dist/server/app.

import { options, serveApp, serverFn, serverFnWith } from "sigx/server";
import { App } from "./shared/App";
import { getStats, greet } from "./api.server";

async function main() {
  await serveApp(options(), (path: string) => <App path={path} />, [
    serverFn("src/api.server/getStats", getStats),
    serverFnWith("src/api.server/greet", greet),
  ]);
}
