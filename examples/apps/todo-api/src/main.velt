// todo-api: a JSON REST API over a todo list persisted to a JSON file or a SQLite database,
// picked by the file name (see README.md).
//   PORT=8090 TODO_DB=todos.json velt run
//   PORT=8090 TODO_DB=todos.sqlite velt run
import { startServer } from "./server";

async function main() {
  const port = parseInt(process.env.PORT ?? "8090", 10) as i64;
  const server = await startServer(process.env.TODO_DB ?? "todos.json", port);
  console.log(`todo api on http://127.0.0.1:${server.port}`);
  await sleep(1000000000);
}
