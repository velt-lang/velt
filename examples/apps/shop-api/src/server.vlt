// The HTTP side: one Store behind a Mutex, every request routed while holding it. Readers
// can't share the store without the lock yet (#36), so store work runs one request at a time;
// HTTP parsing and writing run on every core. `route` turns errors into responses, so nothing
// has to be thrown out of `with` (#703).
import { serve, Server } from "velt:http";
import { route } from "./api";
import { Store } from "./store";

async function handle(req: Request, store: shared<Mutex<Store>>): Promise<Response> {
  const method = req.method;
  const url = new URL(req.url);
  const path = url.pathname;
  const query = url.search.slice(1);
  const body = method === "GET" ? "" : await req.text();
  const out = store.with((s) => route(s, method, path, query, body));
  return new Response(out.body, {
    status: out.status as number,
    headers: { "content-type": "application/json" },
  });
}

/// Serves `store` on `port` (0 = any free port).
export async function startServer(store: Store, port: i64): Promise<Server> {
  const shop = shared(new Mutex<Store>(store));
  return await serve({ port: port as number }, async (req) => await handle(req, shop));
}
