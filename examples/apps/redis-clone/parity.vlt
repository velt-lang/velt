/// Raw protocol cases, each on fresh connections: the bytes are sent in the given pieces (a
/// short pause between them), then everything each server writes until it closes is compared.
type RawCase = { name: string; pieces: string[] };

function rawCases(): RawCase[] {
  return [
    { name: "inline commands", pieces: ["PING\r\nSET  a   b\r\nGET a\nECHO hi\r\nQUIT\r\n"] },
    {
      name: "a command split across reads",
      pieces: ["*2\r\n$4\r\nEC", "HO\r\n$5\r\nhel", "lo\r\n", "*1\r\n$4\r\nQUIT\r\n"],
    },
    {
      name: "pipelined, split mid-header",
      pieces: ["*1\r\n$4\r\nPING\r\n*1\r", "\n$4\r\nPING\r\n*1\r\n$4\r\nQUIT\r\n"],
    },
    {
      name: "negative multibulk count",
      pieces: ["*-5\r\n*1\r\n$4\r\nPING\r\n*1\r\n$4\r\nQUIT\r\n"],
    },
    { name: "negative bulk length", pieces: ["*1\r\n$-5\r\n"] },
    { name: "overflowing multibulk count", pieces: ["*18446744073709551617\r\n"] },
    { name: "overflowing bulk length", pieces: ["*1\r\n$99999999999999999999\r\n"] },
    { name: "bulk without $", pieces: ["*1\r\n+PING\r\n"] },
    { name: "too big inline request", pieces: ["a".repeat(70000)] },
    { name: "too big mbulk count string", pieces: [`*${"1".repeat(70000)}`] },
    // Not compared: "too big bulk count string". Redis 8.8 doesn't answer a 70 kB bulk header
    // within the timeout (with or without a line ending); this server rejects it at 64 kB.
  ];
}

/// Everything `conn` sends until it closes (or "<timeout>" after 2 s).
async function readAll(conn: TcpStream): Promise<string> {
  let out = "";
  while (true) {
    const data = await conn.read();
    if (data.length === 0) {
      return out;
    }
    out += utf8DecodeLossy(data);
  }
}

async function timeout(ms: i64): Promise<string> {
  await sleep(ms);
  return "<timeout>";
}

async function rawExchange(addr: string, c: RawCase): Promise<string> {
  const conn = await connect(addr);
  for (const piece of c.pieces) {
    await conn.writeBytes(utf8Encode(piece));
    await sleep(20);
  }
  const reply = await Promise.race([readAll(conn), timeout(2000)]);
  conn.close();
  return reply;
}

async function main() {
  const argv = args();
  if (argv.length !== 2) {
    console.error("usage: velt run parity.vlt -- <this host:port> <redis host:port>");
    exit(2);
  }
  const ours = await connect(argv[0]);
  const theirs = await connect(argv[1]);
  const a = new ReplyReader(ours);
  const b = new ReplyReader(theirs);
  let failures = 0;
  let total = 0;
  for (const step of script()) {
    if (step.sleepMs > 0) {
      await sleep(step.sleepMs);
      continue;
    }
    total++;
    const req = utf8Encode(encode(step.argv));
    await ours.writeBytes(req);
    await theirs.writeBytes(req);
    let x = await a.next();
    let y = await b.next();
    if (step.unordered) {
      // `toSorted()`: `sort()` returns nothing in Velt, so it can't chain (#719).
      x = x.split("\r\n").toSorted().join("\r\n");
      y = y.split("\r\n").toSorted().join("\r\n");
    }
    if (x !== y) {
      failures++;
      console.log(`DIFF ${step.argv.join(" ").slice(0, 80)}`);
      console.log(`  ours:  ${JSON.stringify(x.slice(0, 200))}`);
      console.log(`  redis: ${JSON.stringify(y.slice(0, 200))}`);
    }
  }
  ours.close();
  theirs.close();
  for (const rc of rawCases()) {
    total++;
    const x = await rawExchange(argv[0], rc);
    const y = await rawExchange(argv[1], rc);
    if (x !== y) {
      failures++;
      console.log(`DIFF raw: ${rc.name}`);
      console.log(`  ours:  ${JSON.stringify(x.slice(0, 200))}`);
      console.log(`  redis: ${JSON.stringify(y.slice(0, 200))}`);
    }
  }
  console.log(`${total - failures}/${total} replies identical`);
  if (failures > 0) {
    exit(1);
  }
}
