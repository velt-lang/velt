// Sends the same commands to this server and to a real Redis and compares the raw RESP replies
// byte for byte. Replies whose order Redis leaves unspecified (KEYS, SMEMBERS, HGETALL of a
// large hash) are compared as sorted lines.
//
//   redis-server --port 6379 --save '' &
//   velt run parity.vlt -- 127.0.0.1:6380 127.0.0.1:6379
import { connect, TcpStream } from "velt:net";
import { utf8DecodeLossy, utf8Encode } from "velt:encoding";
import { args, exit } from "velt:process";

/// Reads one complete reply from `conn`, keeping any extra bytes for the next call.
class ReplyReader {
  private buf: u8[] = [];

  constructor(private conn: TcpStream) {}

  /// The end of the reply starting at `at` in buf, or -1 if it isn't complete yet.
  private end(at: i64): i64 {
    if (at >= this.buf.length) {
      return -1;
    }
    const eol = this.buf.indexOf(13, at);
    if (eol < 0 || eol + 1 >= this.buf.length) {
      return -1;
    }
    const kind = this.buf[at];
    const n = Number.parseInt(utf8DecodeLossy(this.buf.slice(at + 1, eol)), 10) as i64;
    if (kind === 36) {
      // $n: n bytes + CRLF, or $-1
      if (n < 0) {
        return eol + 2;
      }
      const stop = eol + 2 + n + 2;
      return stop <= this.buf.length ? stop : -1;
    }
    if (kind === 42) {
      let pos = eol + 2;
      for (let i: i64 = 0; i < n; i++) {
        pos = this.end(pos);
        if (pos < 0) {
          return -1;
        }
      }
      return pos;
    }
    return eol + 2;
  }

  async next(): Promise<string> {
    while (true) {
      const stop = this.end(0);
      if (stop >= 0) {
        const reply = utf8DecodeLossy(this.buf.slice(0, stop));
        this.buf = this.buf.slice(stop);
        return reply;
      }
      const data = await this.conn.read();
      if (data.length === 0) {
        return "<closed>";
      }
      const merged = Buffer.alloc(this.buf.length + data.length);
      merged.set(this.buf, 0);
      merged.set(data, this.buf.length as usize);
      this.buf = merged;
    }
  }
}

function encode(argv: string[]): string {
  let s = `*${argv.length}\r\n`;
  for (const a of argv) {
    s += `$${Buffer.byteLength(a)}\r\n${a}\r\n`;
  }
  return s;
}

type Step = { argv: string[]; unordered: bool; sleepMs: i64 };

function c(...argv: string[]): Step {
  return { argv, unordered: false, sleepMs: 0 };
}

function u(...argv: string[]): Step {
  return { argv, unordered: true, sleepMs: 0 };
}

function pause(ms: i64): Step {
  return { argv: [], unordered: false, sleepMs: ms };
}

