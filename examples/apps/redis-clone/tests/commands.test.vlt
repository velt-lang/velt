// Commands against a Db directly (no sockets), with a fixed clock.
import { utf8DecodeLossy, utf8Encode } from "velt:encoding";
import { execute, formatScore, globMatch, parseInt64, parseScore } from "../src/commands";
import { Db } from "../src/db";
import { Writer } from "../src/resp";

function run(db: Db, line: string): string {
  const w = new Writer();
  execute(db, line.split(" ").map((a) => utf8Encode(a)), w);
  return utf8DecodeLossy(w.take()).replaceAll("\r\n", "|");
}

function db(): Db {
  const d = new Db();
  d.now = 1000000;
  return d;
}

export function test_strict_integers() {
  assertEq(parseInt64(utf8Encode("-9223372036854775808")), -9223372036854775807 - 1);
  assertEq(parseInt64(utf8Encode("9223372036854775807")), 9223372036854775807);
  for (const bad of [
    "",
    "-",
    "+1",
    "01",
    " 1",
    "1.0",
    "9223372036854775808",
    "-9223372036854775809",
  ]) {
    let threw = false;
    try {
      parseInt64(utf8Encode(bad));
    } catch (e) {
      threw = true;
    }
    assert(threw);
  }
}

export function test_glob() {
  assert(globMatch("*", "anything"));
  assert(globMatch("h?llo", "hello"));
  assert(globMatch("h[ae]llo", "hallo"));
  assert(!globMatch("h[^e]llo", "hello"));
  assert(globMatch("h[a-c]x", "hbx"));
  assert(globMatch("a\\*b", "a*b"));
  assert(!globMatch("a\\*b", "axb"));
  assert(globMatch("*:*:end", "user:1:end"));
}

export function test_expiry_follows_the_clock() {
  const d = db();
  assertEq(run(d, "SET k v PX 100"), "+OK|");
  assertEq(run(d, "PTTL k"), ":100|");
  d.now += 99;
  assertEq(run(d, "GET k"), "$1|v|");
  d.now += 1;
  assertEq(run(d, "GET k"), "$-1|");
  assertEq(run(d, "EXISTS k"), ":0|");
}

export function test_sweep_removes_due_keys() {
  const d = db();
  run(d, "SET a 1 PX 10");
  run(d, "SET b 1 PX 1000");
  run(d, "SET c 1");
  d.now += 50;
  assertEq(d.sweep(20), 1);
  assertEq(run(d, "DBSIZE"), ":2|");
}

export function test_types_and_wrongtype() {
  const d = db();
  run(d, "RPUSH l a b");
  assertEq(run(d, "TYPE l"), "+list|");
  assertEq(run(d, "GET l"), "-WRONGTYPE Operation against a key holding the wrong kind of value|");
  assertEq(run(d, "SET l now-a-string"), "+OK|");
  assertEq(run(d, "TYPE l"), "+string|");
  assertEq(run(d, "LLEN l"), "-WRONGTYPE Operation against a key holding the wrong kind of value|");
}

export function test_emptied_containers_disappear() {
  const d = db();
  run(d, "SADD s x");
  run(d, "SREM s x");
  run(d, "HSET h f v");
  run(d, "HDEL h f");
  run(d, "RPUSH l x");
  run(d, "LPOP l");
  assertEq(run(d, "DBSIZE"), ":0|");
}

export function test_sorted_set_order_and_ties() {
  const d = db();
  run(d, "ZADD z 2 b 1 c 2 a");
  assertEq(run(d, "ZRANGE z 0 -1"), "*3|$1|c|$1|a|$1|b|");
  run(d, "ZADD z 0 b");
  assertEq(run(d, "ZPOPMIN z"), "*2|$1|b|$1|0|");
}

export function test_quit_closes() {
  const w = new Writer();
  assert(!execute(db(), [utf8Encode("QUIT")], w));
  assert(execute(db(), [utf8Encode("PING")], w));
}

export function test_scores_parse_like_strtod() {
  for (const ok of ["1", "-1.5", ".5", "5.", "+5", "-.5", "1e3", "0x10", "inf", "-Infinity", "0"]) {
    parseScore(utf8Encode(ok));
  }
  assertEq(parseScore(utf8Encode("0x10")), 16.0);
  for (const bad of ["", " 1", "1 ", "1e", "nan", "0b1", "0o7", "1_0", "1e400", "1e-400", "abc"]) {
    let threw = false;
    try {
      parseScore(utf8Encode(bad));
    } catch (e) {
      threw = true;
    }
    assert(threw);
  }
}

export function test_scores_format_like_redis() {
  const cases: [f64, string][] = [
    [1e17, "100000000000000000"],
    [1234567890123456789.0, "1234567890123456768"],
    [1e19, "1e+19"],
    [-1e19, "-1e+19"],
    [12345678901234567890.0, "12345678901234567000"],
    [1.5e300, "1.5e+300"],
    [0.000001, "0.000001"],
    [1.5e-6, "1.5e-6"],
    [1e-7, "1e-7"],
    [2.5e-5, "0.000025"],
    [123.456, "123.456"],
    [-0.0, "0"],
    [5e-324, "5e-324"],
    [1.7976931348623157e308, "1.7976931348623157e+308"],
  ];
  for (const [x, want] of cases) {
    assertEq(formatScore(x), want);
  }
}

export function test_expire_overflow_and_options() {
  const d = db();
  assertEq(run(d, "SET k v EX 9223372036854775807"), "-ERR invalid expire time in 'set' command|");
  // Overflowing a relative time wraps into the past in Redis: OK, and the key is gone at once.
  assertEq(run(d, "SET k v PX 9223372036854775807"), "+OK|");
  assertEq(run(d, "EXISTS k"), ":0|");
  assertEq(run(d, "SET k v"), "+OK|");
  assertEq(run(d, "EXPIRE k 9223372036854775807"), "-ERR invalid expire time in 'expire' command|");
  assertEq(run(d, "EXPIRE k 100 XX"), ":0|");
  assertEq(run(d, "EXPIRE k 100 NX"), ":1|");
  assertEq(run(d, "EXPIRE k 200 NX"), ":0|");
  assertEq(run(d, "EXPIRE k 50 GT"), ":0|");
  assertEq(run(d, "EXPIRE k 300 GT"), ":1|");
  assertEq(run(d, "EXPIRE k 10 LT"), ":1|");
  assertEq(run(d, "TTL k"), ":10|");
  assertEq(
    run(d, "EXPIRE k 10 NX XX"),
    "-ERR NX and XX, GT or LT options at the same time are not compatible|",
  );
  assertEq(
    run(d, "EXPIRE k 10 GT LT"),
    "-ERR GT and LT options at the same time are not compatible|",
  );
  assertEq(run(d, "EXPIRE k 10 FOO"), "-ERR Unsupported option FOO|");
}

export function test_sweep_reaches_keys_behind_long_ttls() {
  const d = db();
  for (let i = 0; i < 30; i++) {
    run(d, `SET long${i} v EX 1000`);
  }
  run(d, "SET short v PX 10");
  d.now += 50;
  // The first 20 keys with a TTL are all long-lived; the cursor gets to `short` next time.
  d.sweep(20);
  d.sweep(20);
  assertEq(run(d, "DBSIZE"), ":30|");
}

export function test_unknown_command_arguments_are_capped() {
  const d = db();
  const long = "x".repeat(200);
  assertEq(
    run(d, `NOPE ${long} b`),
    `-ERR unknown command 'NOPE', with args beginning with: '${"x".repeat(128)}' |`,
  );
}
