// The network side: one task per connection, and the keyspace in shards (src/shards.vlt). Each
// read is parsed into as many complete commands as it holds (clients pipeline); consecutive
// commands on one shard run as one batch under its lock, and the replies go back in one write.
import { listen, TcpListener, TcpStream } from "velt:net";
import { workerCount } from "velt:task";
import { utf8DecodeLossy } from "velt:encoding";
import { execute } from "./commands";
import { Db } from "./db";
import { protocolErrorReply, RespParser, Writer } from "./resp";
import { across, Merge, mergeOf, shardOf } from "./shards";

/// Runs `commands` on `db`, their replies into `out`; false when the client quit.
function runBatch(db: Db, commands: u8[][][], now: i64, out: Writer): bool {
  db.now = now;
  for (const args of commands) {
    if (!execute(db, args, out)) {
      return false;
    }
  }
  return true;
}

/// How command `args` spreads over `n` shards (`mergeOf`). Only names starting with one of
/// d e f i k m u can spread: the others (GET, SET, ...) need no name string.
function spreadOf(args: u8[][], n: i64): Merge {
  if (n === 1 || args.length === 0 || args[0].length === 0) {
    return "none";
  }
  const c = args[0][0] | 32;
  if (c !== 100 && c !== 101 && c !== 102 && c !== 105 && c !== 107 && c !== 109 && c !== 117) {
    return "none";
  }
  return mergeOf(utf8DecodeLossy(args[0]).toLowerCase(), args);
}

/// Answers `commands` (consumed) into `out`; false when the client quit.
function answer(shards: shared<Mutex<Db>>[], commands: u8[][][], out: Writer): bool {
  const n = shards.length as i64;
  const now = Date.now() as i64;
  // Taken from the end: each command moves out of the list into its batch.
  commands.reverse();
  while (commands.length > 0) {
    const first = commands.pop()!;
    const merge = spreadOf(first, n);
    if (merge !== "none") {
      out.bytes(across(shards, utf8DecodeLossy(first[0]).toLowerCase(), merge, first, now));
      continue;
    }
    const s = shardOf(first, n);
    const batch: u8[][][] = [first];
    while (commands.length > 0) {
      const next = commands[commands.length - 1];
      if (shardOf(next, n) !== s || spreadOf(next, n) !== "none") {
        break;
      }
      batch.push(commands.pop()!);
    }
    if (!shards[s].with((d) => runBatch(d, batch, now, out))) {
      return false;
    }
  }
  return true;
}

async function serveClient(conn: TcpStream, shards: shared<Mutex<Db>>[]): Promise<void> {
  const parser = new RespParser();
  // One reply buffer for the connection's lifetime.
  const out = new Writer();
  try {
    while (true) {
      let n: number | null = 0;
      try {
        n = parser.readFrom(conn);
      } catch (e) {
        break; // past the query-buffer limit: Redis closes such a client without a reply
      }
      if (n == null) {
        break;
      }
      if (n === 0) {
        await conn.readable();
        continue;
      }
      const commands: u8[][][] = [];
      let protocolError: u8[] | null = null;
      try {
        let args = parser.next();
        while (args != null) {
          commands.push(args);
          args = parser.next();
        }
      } catch (e) {
        protocolError = e.detail;
      }
      let open = true;
      if (commands.length > 0) {
        open = answer(shards, commands, out);
        await conn.writeBytes(out.buf, 0, out.length as number);
        out.clear();
      }
      if (protocolError != null) {
        await conn.writeBytes(protocolErrorReply(protocolError));
        open = false;
      }
      if (!open) {
        break;
      }
    }
  } catch (e) {
    // The client went away mid-write; nothing to answer.
  }
  conn.close();
}

/// Active expiry on one shard: every 100 ms, removes due keys among a sample of those with a
/// time to live, until `stopped` is set.
async function sweeper(db: shared<Mutex<Db>>, stopped: shared<i64>): Promise<void> {
  while (stopped.get() === 0) {
    await sleep(100);
    const now = Date.now() as i64;
    db.with((d) => {
      d.now = now;
      d.sweep(20);
    });
  }
}

/// Accepts connections on `listener` until it is closed; then stops the expiry sweepers.
export async function serve(listener: TcpListener, shards: shared<Mutex<Db>>[]): Promise<void> {
  const stopped = shared(0);
  for (const db of shards) {
    spawn(sweeper(db, stopped));
  }
  try {
    while (true) {
      const conn = await listener.accept();
      spawn(serveClient(conn, shards));
    }
  } catch (e) {
    // `listener.close()`: stop serving.
  }
  stopped.set(1);
}

/// The keyspace: one shard per worker thread.
export function keyspace(): shared<Mutex<Db>>[] {
  const shards: shared<Mutex<Db>>[] = [];
  const n = workerCount();
  for (let i = 0; i < n; i++) {
    shards.push(shared(new Mutex<Db>(new Db())));
  }
  return shards;
}

export async function start(addr: string): Promise<TcpListener> {
  return await listen(addr);
}
