// The commands: arguments in, a RESP reply out, with Redis's argument rules and error messages.
import { Set } from "velt:collections/set";
import { utf8DecodeLossy, utf8Encode } from "velt:encoding";
import { CommandError, Db, notInteger, Scored, ZSet } from "./db";
import { Deque } from "velt:collections/deque";
import { Writer } from "./resp";

const MAX: i64 = 9223372036854775807;
const MIN: i64 = -9223372036854775807 - 1;

function text(b: u8[]): string {
  return utf8DecodeLossy(b);
}

function syntax(): CommandError {
  return new CommandError("ERR syntax error");
}

/// A strict integer, as Redis's string2ll: optional '-', digits, no leading zeros or spaces.
export function parseInt64(b: u8[]): i64 {
  if (b.length === 0 || b.length > 20) {
    throw notInteger();
  }
  let i = 0;
  const negative = b[0] === 45;
  if (negative) {
    i = 1;
    if (b.length === 1) {
      throw notInteger();
    }
  }
  if (b[i] === 48 && b.length > i + 1) {
    throw notInteger();
  }
  let n: i64 = 0;
  for (; i < b.length; i++) {
    const c = b[i];
    if (c < 48 || c > 57) {
      throw notInteger();
    }
    const d = (c - 48) as i64;
    // Accumulate negatively, so MIN fits.
    if (n < (MIN + d) / 10) {
      throw notInteger();
    }
    n = n * 10 - d;
  }
  if (!negative) {
    if (n === MIN) {
      throw notInteger();
    }
    return -n;
  }
  return n;
}

function notFloat(): CommandError {
  return new CommandError("ERR value is not a valid float");
}

/// Whether `s[from..]` is a decimal float in strtod's syntax: digits with an optional point
/// (at least one digit), then an optional exponent (`e`, a sign, digits).
function isDecimal(s: string, from: i64): bool {
  let i = from;
  let digits: i64 = 0;
  while (i < s.length && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
    i++;
    digits++;
  }
  if (i < s.length && s[i] === ".") {
    i++;
    while (i < s.length && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
      i++;
      digits++;
    }
  }
  if (digits === 0) {
    return false;
  }
  if (i < s.length && (s[i] === "e" || s[i] === "E")) {
    i++;
    if (i < s.length && (s[i] === "+" || s[i] === "-")) {
      i++;
    }
    const start = i;
    while (i < s.length && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
      i++;
    }
    if (i === start) {
      return false;
    }
  }
  return i === s.length;
}

/// A score, as Redis's strtod-based parser reads it: decimal (`1`, `.5`, `5.`, `+1e3`), hex
/// integers (`0x10`), `inf` / `infinity` with a sign. No spaces, no `nan`, and a value that
/// overflows to infinity or underflows to zero is an error. Scanned by hand: ZADD is hot, and a
/// RegExp per call (they can't be module constants yet, #60) made it 6x slower.
export function parseScore(b: u8[]): f64 {
  const s = text(b);
  const signed = s.length > 0 && (s[0] === "+" || s[0] === "-");
  const negative = signed && s[0] === "-";
  const body = signed ? 1 : 0;
  const rest = s.slice(body).toLowerCase();
  if (rest === "inf" || rest === "infinity") {
    return negative ? -Infinity : Infinity;
  }
  if (rest.startsWith("0x")) {
    if (rest.length === 2) {
      throw notFloat();
    }
    let v = 0.0;
    for (let i = 2; i < rest.length; i++) {
      const d = Number.parseInt(rest[i], 16);
      if (d !== d) {
        throw notFloat();
      }
      v = v * 16.0 + d;
    }
    return negative ? -v : v;
  }
  if (!isDecimal(s, body)) {
    throw notFloat();
  }
  const v = Number(s);
  if (v === Infinity || v === -Infinity) {
    throw notFloat();
  }
  // Underflow: a mantissa with a non-zero digit that came out as zero.
  if (v === 0.0) {
    for (let i = body; i < s.length && s[i] !== "e" && s[i] !== "E"; i++) {
      if (s.charCodeAt(i) >= 49 && s.charCodeAt(i) <= 57) {
        throw notFloat();
      }
    }
  }
  return v;
}

/// A score as Redis writes it: an integer when it is whole and within +-2^62, else the shortest
/// digits that round-trip, laid out by fpconv_dtoa's rules (exponent form for large or small
/// magnitudes, with different cut-offs than JavaScript: 1e19 is "1e+19", 1.5e-6 "1.5e-6").
export function formatScore(x: f64): string {
  if (x === Infinity) {
    return "inf";
  }
  if (x === -Infinity) {
    return "-inf";
  }
  if (x === Math.trunc(x) && x >= -4611686018427387903.0 && x <= 4611686018427387903.0) {
    return `${x as i64}`;
  }
  const negative = x < 0.0;
  // `${v}` is JavaScript's shortest round-trip form; take its digits and decimal exponent K
  // (value = digits * 10^K). Velt has no toExponential() to ask for them directly.
  const plain = `${negative ? -x : x}`;
  let mantissa = plain;
  let k: i64 = 0;
  const e = plain.indexOf("e");
  if (e >= 0) {
    mantissa = plain.slice(0, e);
    k = Number.parseInt(plain.slice(e + 1), 10) as i64;
  }
  const dot = mantissa.indexOf(".");
  if (dot >= 0) {
    k -= (mantissa.length - dot - 1) as i64;
    mantissa = mantissa.slice(0, dot) + mantissa.slice(dot + 1);
  }
  let lead = 0;
  while (lead < mantissa.length - 1 && mantissa[lead] === "0") {
    lead++;
  }
  let digits = mantissa.slice(lead);
  while (digits.length > 1 && digits.endsWith("0")) {
    digits = digits.slice(0, digits.length - 1);
    k++;
  }
  const n = digits.length as i64;
  const exp = k + n - 1 < 0 ? -(k + n - 1) : k + n - 1;
  const sign = negative ? "-" : "";
  if (k >= 0 && exp < n + 7) {
    return `${sign}${digits}${"0".repeat(k as f64)}`;
  }
  if (k < 0 && (k > -7 || exp < 4)) {
    const offset = n + k; // digits before the point
    if (offset <= 0) {
      return `${sign}0.${"0".repeat(-offset as f64)}${digits}`;
    }
    return `${sign}${digits.slice(0, offset)}.${digits.slice(offset)}`;
  }
  const shown = digits.slice(0, negative ? 17 : 18);
  const body = shown.length > 1 ? `${shown[0]}.${shown.slice(1)}` : shown;
  return `${sign}${body}e${k + n - 1 < 0 ? "-" : "+"}${exp}`;
}

/// Redis's glob: `*`, `?`, `[abc]`, `[^a]`, `[a-z]` and `\x`.
export function globMatch(p: string, s: string, pi: i64 = 0, si: i64 = 0): bool {
  while (pi < p.length) {
    const c = p[pi];
    if (c === "*") {
      while (pi + 1 < p.length && p[pi + 1] === "*") {
        pi++;
      }
      if (pi + 1 === p.length) {
        return true;
      }
      for (let k = si; k <= s.length; k++) {
        if (globMatch(p, s, pi + 1, k)) {
          return true;
        }
      }
      return false;
    }
    if (si >= s.length) {
      return false;
    }
    if (c === "?") {
      pi++;
      si++;
      continue;
    }
    if (c === "[") {
      let j = pi + 1;
      const not = j < p.length && p[j] === "^";
      if (not) {
        j++;
      }
      let hit = false;
      while (j < p.length && p[j] !== "]") {
        if (p[j] === "\\" && j + 1 < p.length) {
          j++;
          hit = hit || p[j] === s[si];
        } else if (j + 2 < p.length && p[j + 1] === "-" && p[j + 2] !== "]") {
          hit = hit || (s[si] >= p[j] && s[si] <= p[j + 2]);
          j += 2;
        } else {
          hit = hit || p[j] === s[si];
        }
        j++;
      }
      if (hit === not) {
        return false;
      }
      pi = j + 1;
      si++;
      continue;
    }
    if (c === "\\" && pi + 1 < p.length) {
      pi++;
    }
    if (p[pi] !== s[si]) {
      return false;
    }
    pi++;
    si++;
  }
  return si === s.length;
}

/// Redis's index rules for LRANGE / ZRANGE: negative counts from the end, clamped.
function range(start: i64, stop: i64, length: i64): [i64, i64] {
  let a = start < 0 ? length + start : start;
  let b = stop < 0 ? length + stop : stop;
  if (a < 0) {
    a = 0;
  }
  if (b >= length) {
    b = length - 1;
  }
  return [a, b];
}

function arity(name: string, args: u8[][], n: i64) {
  // n > 0: exactly n arguments (with the name); n < 0: at least -n.
  if ((n > 0 && args.length !== n) || (n < 0 && args.length < -n)) {
    throw new CommandError(`ERR wrong number of arguments for '${name}' command`);
  }
}

/// SET/SETEX/PSETEX's expiry: `n` seconds (`seconds`) or ms, relative to now unless `absolute`,
/// as an absolute time in ms. Redis's rules: positive, seconds that fit in ms. A relative time
/// that overflows when now is added wraps into the past in Redis, so the command answers OK
/// and the key is gone at once; 0 (the epoch) does the same here.
function expireTime(db: Db, n: i64, seconds: bool, absolute: bool, command: string): i64 {
  if (n <= 0 || (seconds && n > MAX / 1000)) {
    throw new CommandError(`ERR invalid expire time in '${command}' command`);
  }
  const ms = seconds ? n * 1000 : n;
  if (absolute) {
    return ms;
  }
  return ms > MAX - db.now ? 0 : ms + db.now;
}

function set(db: Db, args: u8[][], out: Writer) {
  const key = text(args[1]);
  let expireAt: i64 = 0;
  let nx = false;
  let xx = false;
  let get = false;
  let keepTtl = false;
  let timed = false;
  for (let i = 3; i < args.length; i++) {
    const opt = text(args[i]).toUpperCase();
    if (opt === "NX" && !xx) {
      nx = true;
    } else if (opt === "XX" && !nx) {
      xx = true;
    } else if (opt === "GET") {
      get = true;
    } else if (opt === "KEEPTTL" && !timed) {
      keepTtl = true;
    } else if (
      (opt === "EX" || opt === "PX" || opt === "EXAT" || opt === "PXAT") &&
      !timed &&
      !keepTtl &&
      i + 1 < args.length
    ) {
      const n = parseInt64(args[++i]);
      timed = true;
      expireAt = expireTime(
        db,
        n,
        opt === "EX" || opt === "EXAT",
        opt === "EXAT" || opt === "PXAT",
        "set",
      );
    } else {
      throw syntax();
    }
  }
  const old = get ? db.getString(key) : null;
  const exists = db.kind(key) !== "none";
  if ((nx && exists) || (xx && !exists)) {
    if (get) {
      if (old == null) {
        out.nil();
      } else {
        out.bulk(old);
      }
    } else {
      out.nil();
    }
    return;
  }
  db.setString(key, args[2], keepTtl);
  if (timed) {
    db.expires.set(key, expireAt);
  }
  if (get) {
    if (old == null) {
      out.nil();
    } else {
      out.bulk(old);
    }
  } else {
    out.ok();
  }
}

function incrBy(db: Db, key: string, by: i64, out: Writer) {
  const cur = db.getString(key);
  const old = cur == null ? 0 : parseInt64(cur);
  if ((by > 0 && old > MAX - by) || (by < 0 && old < MIN - by)) {
    throw new CommandError("ERR increment or decrement would overflow");
  }
  const n = old + by;
  db.setString(key, utf8Encode(`${n}`), true);
  out.integer(n);
}

function list(db: Db, key: string, create: bool): Deque<u8[]> | null {
  if (!db.expect(key, "list")) {
    if (!create) {
      return null;
    }
    db.lists.set(key, new Deque<u8[]>());
  }
  return db.lists.get(key);
}

function hash(db: Db, key: string, create: bool): Map<string, u8[]> | null {
  if (!db.expect(key, "hash")) {
    if (!create) {
      return null;
    }
    db.hashes.set(key, new Map<string, u8[]>());
  }
  return db.hashes.get(key);
}

function setOf(db: Db, key: string, create: bool): Set<string> | null {
  if (!db.expect(key, "set")) {
    if (!create) {
      return null;
    }
    db.sets.set(key, new Set<string>());
  }
  return db.sets.get(key);
}

function zset(db: Db, key: string, create: bool): ZSet | null {
  if (!db.expect(key, "zset")) {
    if (!create) {
      return null;
    }
    db.zsets.set(key, new ZSet());
  }
  return db.zsets.get(key);
}

/// Drops an emptied container, as Redis does.
function dropIfEmpty(db: Db, key: string, size: i64) {
  if (size === 0) {
    db.remove(key);
  }
}

function pop(db: Db, args: u8[][], out: Writer, front: bool) {
  const key = text(args[1]);
  const count = args.length > 2 ? parseInt64(args[2]) : -1;
  if (args.length > 3 || (args.length > 2 && count < 0)) {
    throw args.length > 3
      ? syntax()
      : new CommandError("ERR value is out of range, must be positive");
  }
  const l = list(db, key, false);
  if (l == null) {
    if (count < 0) {
      out.nil();
    } else {
      out.nilArray();
    }
    return;
  }
  if (count < 0) {
    out.bulk((front ? l.popFront() : l.popBack())!);
  } else {
    const n = count < l.length ? count : l.length;
    out.array(n);
    for (let i: i64 = 0; i < n; i++) {
      out.bulk((front ? l.popFront() : l.popBack())!);
    }
  }
  dropIfEmpty(db, key, l.length);
}

function ttl(db: Db, key: string, ms: bool, out: Writer) {
  if (db.kind(key) === "none") {
    out.integer(-2);
    return;
  }
  const at = db.expires.get(key);
  if (at == null) {
    out.integer(-1);
    return;
  }
  const left = at - db.now;
  out.integer(ms ? left : (left + 500) / 1000);
}

/// EXPIRE / PEXPIRE key n [NX|XX|GT|LT], with Redis's option rules and overflow checks.
function expire(db: Db, name: string, args: u8[][], seconds: bool, out: Writer) {
  let nx = false;
  let xx = false;
  let gt = false;
  let lt = false;
  for (let i = 3; i < args.length; i++) {
    const opt = text(args[i]).toLowerCase();
    if (opt === "nx") {
      nx = true;
    } else if (opt === "xx") {
      xx = true;
    } else if (opt === "gt") {
      gt = true;
    } else if (opt === "lt") {
      lt = true;
    } else {
      throw new CommandError(`ERR Unsupported option ${text(args[i])}`);
    }
  }
  if (nx && (xx || gt || lt)) {
    throw new CommandError("ERR NX and XX, GT or LT options at the same time are not compatible");
  }
  if (gt && lt) {
    throw new CommandError("ERR GT and LT options at the same time are not compatible");
  }
  let when = parseInt64(args[2]);
  if (seconds) {
    if (when > MAX / 1000 || when < MIN / 1000) {
      throw new CommandError(`ERR invalid expire time in '${name}' command`);
    }
    when *= 1000;
  }
  if (when > MAX - db.now) {
    throw new CommandError(`ERR invalid expire time in '${name}' command`);
  }
  when += db.now;
  const key = text(args[1]);
  if (db.kind(key) === "none") {
    out.integer(0);
    return;
  }
  const current = db.expires.get(key); // null: no time to live (infinite)
  const refused =
    (nx && current != null) ||
    (xx && current == null) ||
    (gt && (current == null || when <= current)) ||
    (lt && current != null && when >= current);
  if (refused) {
    out.integer(0);
    return;
  }
  if (when <= db.now) {
    db.remove(key);
  } else {
    db.expires.set(key, when);
  }
  out.integer(1);
}

/// Runs one command against `db`, writing its reply. `false` when the client asked to QUIT.
export function execute(db: Db, args: u8[][], out: Writer): bool {
  if (args.length === 0) {
    return true;
  }
  const name = text(args[0]).toLowerCase();
  try {
    run(db, name, args, out);
  } catch (e) {
    out.error(e.message);
  }
  return name !== "quit";
}

function run(db: Db, name: string, args: u8[][], out: Writer) {
  switch (name) {
    case "ping":
      if (args.length > 2) {
        arity(name, args, 1);
      }
      if (args.length === 2) {
        out.bulk(args[1]);
      } else {
        out.simple("PONG");
      }
      return;
    case "echo":
      arity(name, args, 2);
      out.bulk(args[1]);
      return;
    case "quit":
    case "select":
    case "client":
      out.ok();
      return;
    case "command":
      out.array(0);
      return;
    case "config": {
      arity(name, args, -2);
      if (text(args[1]).toLowerCase() !== "get") {
        out.ok();
        return;
      }
      out.array(2 * (args.length - 2));
      for (let i = 2; i < args.length; i++) {
        const p = text(args[i]).toLowerCase();
        out.bulkString(p);
        out.bulkString(p === "save" ? "" : p === "appendonly" ? "no" : "");
      }
      return;
    }
    case "info":
      out.bulkString(
        `# Server\r\nredis_version:7.4.0\r\nredis_mode:standalone\r\nimplementation:velt\r\n\r\n# Keyspace\r\ndb0:keys=${db.size()},expires=${db.expires.size}\r\n`,
      );
      return;
    case "dbsize":
      arity(name, args, 1);
      out.integer(db.size());
      return;
    case "flushdb":
    case "flushall":
      db.flush();
      out.ok();
      return;
    case "get": {
      arity(name, args, 2);
      const v = db.getString(text(args[1]));
      if (v == null) {
        out.nil();
      } else {
        out.bulk(v);
      }
      return;
    }
    case "set":
      arity(name, args, -3);
      set(db, args, out);
      return;
    case "setnx": {
      arity(name, args, 3);
      const key = text(args[1]);
      if (db.kind(key) !== "none") {
        out.integer(0);
      } else {
        db.setString(key, args[2], false);
        out.integer(1);
      }
      return;
    }
    case "setex":
    case "psetex": {
      arity(name, args, 4);
      const at = expireTime(db, parseInt64(args[2]), name === "setex", false, name);
      const key = text(args[1]);
      db.setString(key, args[3], false);
      db.expires.set(key, at);
      out.ok();
      return;
    }
    case "getdel": {
      arity(name, args, 2);
      const key = text(args[1]);
      const v = db.getString(key);
      if (v == null) {
        out.nil();
      } else {
        out.bulk(v);
        db.remove(key);
      }
      return;
    }
    case "mget":
      arity(name, args, -2);
      out.array(args.length - 1);
      for (let i = 1; i < args.length; i++) {
        const key = text(args[i]);
        const v = db.kind(key) === "string" ? db.strings.get(key) : null;
        if (v == null) {
          out.nil();
        } else {
          out.bulk(v);
        }
      }
      return;
    case "mset":
      if (args.length < 3 || args.length % 2 === 0) {
        throw new CommandError("ERR wrong number of arguments for 'mset' command");
      }
      for (let i = 1; i < args.length; i += 2) {
        db.setString(text(args[i]), args[i + 1], false);
      }
      out.ok();
      return;
    case "append": {
      arity(name, args, 3);
      const key = text(args[1]);
      const cur = db.getString(key);
      if (cur == null) {
        db.setString(key, args[2], true);
        out.integer(args[2].length);
      } else {
        const joined = Buffer.alloc(cur.length + args[2].length);
        joined.set(cur, 0);
        joined.set(args[2], cur.length as usize);
        db.setString(key, joined, true);
        out.integer(joined.length);
      }
      return;
    }
    case "strlen": {
      arity(name, args, 2);
      const v = db.getString(text(args[1]));
      out.integer(v == null ? 0 : v.length);
      return;
    }
    case "incr":
      arity(name, args, 2);
      incrBy(db, text(args[1]), 1, out);
      return;
    case "decr":
      arity(name, args, 2);
      incrBy(db, text(args[1]), -1, out);
      return;
    case "incrby":
      arity(name, args, 3);
      incrBy(db, text(args[1]), parseInt64(args[2]), out);
      return;
    case "decrby": {
      arity(name, args, 3);
      const by = parseInt64(args[2]);
      if (by === MIN) {
        throw new CommandError("ERR decrement would overflow");
      }
      incrBy(db, text(args[1]), -by, out);
      return;
    }
    case "del":
    case "unlink": {
      arity(name, args, -2);
      let n: i64 = 0;
      for (let i = 1; i < args.length; i++) {
        const key = text(args[i]);
        if (db.kind(key) !== "none" && db.remove(key)) {
          n++;
        }
      }
      out.integer(n);
      return;
    }
    case "exists": {
      arity(name, args, -2);
      let n: i64 = 0;
      for (let i = 1; i < args.length; i++) {
        if (db.kind(text(args[i])) !== "none") {
          n++;
        }
      }
      out.integer(n);
      return;
    }
    case "type": {
      arity(name, args, 2);
      const k = db.kind(text(args[1]));
      out.simple(k);
      return;
    }
    case "keys": {
      arity(name, args, 2);
      const pattern = text(args[1]);
      const hits = db.keys().filter((k) => globMatch(pattern, k));
      out.array(hits.length);
      for (const k of hits) {
        out.bulkString(k);
      }
      return;
    }
    case "expire":
    case "pexpire":
      arity(name, args, -3);
      expire(db, name, args, name === "expire", out);
      return;
    case "ttl":
      arity(name, args, 2);
      ttl(db, text(args[1]), false, out);
      return;
    case "pttl":
      arity(name, args, 2);
      ttl(db, text(args[1]), true, out);
      return;
    case "persist": {
      arity(name, args, 2);
      const key = text(args[1]);
      out.integer(db.kind(key) !== "none" && db.expires.delete(key) ? 1 : 0);
      return;
    }
    case "lpush":
    case "rpush": {
      arity(name, args, -3);
      const l = list(db, text(args[1]), true)!;
      for (let i = 2; i < args.length; i++) {
        if (name === "lpush") {
          l.pushFront(args[i]);
        } else {
          l.pushBack(args[i]);
        }
      }
      out.integer(l.length);
      return;
    }
    case "lpop":
      arity(name, args, -2);
      pop(db, args, out, true);
      return;
    case "rpop":
      arity(name, args, -2);
      pop(db, args, out, false);
      return;
    case "llen": {
      arity(name, args, 2);
      const l = list(db, text(args[1]), false);
      out.integer(l == null ? 0 : l.length);
      return;
    }
    case "lindex": {
      arity(name, args, 3);
      const l = list(db, text(args[1]), false);
      const v = l == null ? null : l.at(parseInt64(args[2]));
      if (v == null) {
        out.nil();
      } else {
        out.bulk(v);
      }
      return;
    }
    case "lrange": {
      arity(name, args, 4);
      const start = parseInt64(args[2]);
      const stop = parseInt64(args[3]);
      const l = list(db, text(args[1]), false);
      if (l == null) {
        out.array(0);
        return;
      }
      const [a, b] = range(start, stop, l.length);
      if (a > b) {
        out.array(0);
        return;
      }
      out.array(b - a + 1);
      for (let i = a; i <= b; i++) {
        out.bulk(l.at(i)!);
      }
      return;
    }
    case "hset":
    case "hmset": {
      if (args.length < 4 || args.length % 2 === 1) {
        throw new CommandError(`ERR wrong number of arguments for '${name}' command`);
      }
      const h = hash(db, text(args[1]), true)!;
      let added: i64 = 0;
      for (let i = 2; i < args.length; i += 2) {
        const field = text(args[i]);
        if (!h.has(field)) {
          added++;
        }
        h.set(field, args[i + 1]);
      }
      if (name === "hmset") {
        out.ok();
      } else {
        out.integer(added);
      }
      return;
    }
    case "hget": {
      arity(name, args, 3);
      const h = hash(db, text(args[1]), false);
      const v = h == null ? null : h.get(text(args[2]));
      if (v == null) {
        out.nil();
      } else {
        out.bulk(v);
      }
      return;
    }
    case "hmget": {
      arity(name, args, -3);
      const h = hash(db, text(args[1]), false);
      out.array(args.length - 2);
      for (let i = 2; i < args.length; i++) {
        const v = h == null ? null : h.get(text(args[i]));
        if (v == null) {
          out.nil();
        } else {
          out.bulk(v);
        }
      }
      return;
    }
    case "hdel": {
      arity(name, args, -3);
      const key = text(args[1]);
      const h = hash(db, key, false);
      let n: i64 = 0;
      if (h != null) {
        for (let i = 2; i < args.length; i++) {
          if (h.delete(text(args[i]))) {
            n++;
          }
        }
        dropIfEmpty(db, key, h.size as i64);
      }
      out.integer(n);
      return;
    }
    case "hexists": {
      arity(name, args, 3);
      const h = hash(db, text(args[1]), false);
      out.integer(h != null && h.has(text(args[2])) ? 1 : 0);
      return;
    }
    case "hlen": {
      arity(name, args, 2);
      const h = hash(db, text(args[1]), false);
      out.integer(h == null ? 0 : h.size as i64);
      return;
    }
    case "hgetall":
    case "hkeys":
    case "hvals": {
      arity(name, args, 2);
      const h = hash(db, text(args[1]), false);
      if (h == null) {
        out.array(0);
        return;
      }
      out.array(name === "hgetall" ? (h.size as i64) * 2 : h.size as i64);
      for (const [field, v] of h) {
        if (name !== "hvals") {
          out.bulkString(field);
        }
        if (name !== "hkeys") {
          out.bulk(v);
        }
      }
      return;
    }
    case "hincrby": {
      arity(name, args, 4);
      const h = hash(db, text(args[1]), true)!;
      const field = text(args[2]);
      const by = parseInt64(args[3]);
      const cur = h.get(field);
      let old: i64 = 0;
      if (cur != null) {
        try {
          old = parseInt64(cur);
        } catch (e) {
          throw new CommandError("ERR hash value is not an integer");
        }
      }
      if ((by > 0 && old > MAX - by) || (by < 0 && old < MIN - by)) {
        throw new CommandError("ERR increment or decrement would overflow");
      }
      h.set(field, utf8Encode(`${old + by}`));
      out.integer(old + by);
      return;
    }
    case "sadd": {
      arity(name, args, -3);
      const s = setOf(db, text(args[1]), true)!;
      let n: i64 = 0;
      for (let i = 2; i < args.length; i++) {
        const m = text(args[i]);
        if (!s.has(m)) {
          s.add(m);
          n++;
        }
      }
      out.integer(n);
      return;
    }
    case "srem": {
      arity(name, args, -3);
      const key = text(args[1]);
      const s = setOf(db, key, false);
      let n: i64 = 0;
      if (s != null) {
        for (let i = 2; i < args.length; i++) {
          if (s.delete(text(args[i]))) {
            n++;
          }
        }
        dropIfEmpty(db, key, s.size as i64);
      }
      out.integer(n);
      return;
    }
    case "sismember": {
      arity(name, args, 3);
      const s = setOf(db, text(args[1]), false);
      out.integer(s != null && s.has(text(args[2])) ? 1 : 0);
      return;
    }
    case "scard": {
      arity(name, args, 2);
      const s = setOf(db, text(args[1]), false);
      out.integer(s == null ? 0 : s.size as i64);
      return;
    }
    case "smembers": {
      arity(name, args, 2);
      const s = setOf(db, text(args[1]), false);
      if (s == null) {
        out.array(0);
        return;
      }
      out.array(s.size as i64);
      for (const m of s) {
        out.bulkString(m);
      }
      return;
    }
    case "spop": {
      arity(name, args, -2);
      const key = text(args[1]);
      const s = setOf(db, key, false);
      const count = args.length > 2 ? parseInt64(args[2]) : -1;
      if (s == null) {
        if (count < 0) {
          out.nil();
        } else {
          out.array(0);
        }
        return;
      }
      const members = s.values();
      const n = count < 0 ? 1 : count < members.length ? count : members.length;
      if (count >= 0) {
        out.array(n);
      }
      for (let i: i64 = 0; i < n; i++) {
        const pick = members.splice(Math.floor(Math.random() * members.length) as i64, 1)[0];
        s.delete(pick);
        out.bulkString(pick);
      }
      dropIfEmpty(db, key, s.size as i64);
      return;
    }
    case "zadd": {
      if (args.length < 4 || args.length % 2 === 1) {
        throw args.length < 4
          ? new CommandError("ERR wrong number of arguments for 'zadd' command")
          : syntax();
      }
      const pairs: Scored[] = [];
      for (let i = 2; i < args.length; i += 2) {
        pairs.push({ score: parseScore(args[i]), member: text(args[i + 1]) });
      }
      const z = zset(db, text(args[1]), true)!;
      let n: i64 = 0;
      for (const p of pairs) {
        if (z.add(p.score, p.member)) {
          n++;
        }
      }
      out.integer(n);
      return;
    }
    case "zscore": {
      arity(name, args, 3);
      const z = zset(db, text(args[1]), false);
      const s = z == null ? null : z.scores.get(text(args[2]));
      if (s == null) {
        out.nil();
      } else {
        out.bulkString(formatScore(s));
      }
      return;
    }
    case "zcard": {
      arity(name, args, 2);
      const z = zset(db, text(args[1]), false);
      out.integer(z == null ? 0 : z.scores.size as i64);
      return;
    }
    case "zrem": {
      arity(name, args, -3);
      const key = text(args[1]);
      const z = zset(db, key, false);
      let n: i64 = 0;
      if (z != null) {
        for (let i = 2; i < args.length; i++) {
          if (z.remove(text(args[i]))) {
            n++;
          }
        }
        dropIfEmpty(db, key, z.scores.size as i64);
      }
      out.integer(n);
      return;
    }
    case "zrange": {
      arity(name, args, -4);
      const withScores = args.length === 5 && text(args[4]).toUpperCase() === "WITHSCORES";
      if (args.length > 5 || (args.length === 5 && !withScores)) {
        throw syntax();
      }
      const start = parseInt64(args[2]);
      const stop = parseInt64(args[3]);
      const z = zset(db, text(args[1]), false);
      if (z == null) {
        out.array(0);
        return;
      }
      const [a, b] = range(start, stop, z.order.length);
      if (a > b) {
        out.array(0);
        return;
      }
      out.array((b - a + 1) * (withScores ? 2 : 1));
      for (let i = a; i <= b; i++) {
        out.bulkString(z.order[i].member);
        if (withScores) {
          out.bulkString(formatScore(z.order[i].score));
        }
      }
      return;
    }
    case "zpopmin": {
      arity(name, args, -2);
      const key = text(args[1]);
      const count = args.length > 2 ? parseInt64(args[2]) : 1;
      const z = zset(db, key, false);
      if (z == null || count <= 0) {
        out.array(0);
        return;
      }
      const n = count < z.order.length ? count : z.order.length;
      out.array(n * 2);
      for (let i: i64 = 0; i < n; i++) {
        const first = z.order[0];
        out.bulkString(first.member);
        out.bulkString(formatScore(first.score));
        z.remove(first.member);
      }
      dropIfEmpty(db, key, z.scores.size as i64);
      return;
    }
  }
  // Redis's wording and limits: the name up to 128 characters, then quoted arguments while the
  // list is shorter than 128 characters, each cut to what is left of those 128.
  let shown = "";
  for (let i = 1; i < args.length && shown.length < 128; i++) {
    shown += `'${text(args[i]).slice(0, 128 - shown.length)}' `;
  }
  const command = text(args[0]).slice(0, 128);
  throw new CommandError(
    args.length > 1
      ? `ERR unknown command '${command}', with args beginning with: ${shown}`
      : `ERR unknown command '${command}'`,
  );
}
