// http-server (internal): `serve` on a JS host (`velt build --host <package>`: the variant the
// built-in condition `js` selects, which every host build has). A host package's entry queues
// each request the platform hands it, and the program takes them with std's velt/host/worker, as
// the native server accepts connections: `serve` starts that accept loop in the background and
// returns, so `main` may await anything before it calls `serve`, and the handler and its
// `Request` and `Response` are the same as natively. The request's body streams from the host as
// the handler reads it; a streamed response body is written to the host as it is produced.

import { IoError } from "velt/io";
import { HostRef } from "velt/host";
import * as worker from "velt/host/worker";
import { utf8Encode } from "velt/encoding";
import {
  BodyKind,
  Request,
  Response,
  responseParts,
  serverRequest,
  statusText,
} from "velt/net/http";
import { AbortController, AbortSignal, TaskScope, taskScope } from "velt/task";
import { QueuedRequest } from "./queued";
import { checkName, checkValue } from "../fields";
import { HttpServeOptions, MAX_BODY } from "../serve_options";
import { HttpServer } from "../server";
import { ServeInfo } from "../serve_info";

/**
 * Serves `handler` for the requests the JS host queues, in the background; `opts` names no
 * address here (the platform routes the requests), and of its limits only `maxBodySize` applies
 * (the others are the platform's). The handler returns a `Response`, or a promise of one, as
 * natively; one that throws, or whose promise rejects, gets a 500, and the error is printed to
 * stderr. Handlers run concurrently. `close()` stops taking requests at once; once the handlers
 * in flight finished, the program has nothing left to do and ends, and the host starts it again
 * for the next request.
 */
export async function serve<E, F>(
  opts: HttpServeOptions,
  handler: (req: Request, info: ServeInfo) => Response | Promise<Response, E> throws F,
): Promise<HttpServer, IoError> {
  const stop = new AbortController();
  const maxBody = (opts.maxBodySize ?? MAX_BODY) as i64;
  const done = spawn(acceptAll(handler, maxBody, stop.signal));
  return new HttpServer(0, (): void => {}, stop, done);
}

/**
 * Takes the host's requests until `stopped`, each answered on a task of its own in one task
 * scope, so this settles only once the last of them finished. Stopping wakes the loop: the
 * `accept` it drops gives its request back to the host's queue.
 */
async function acceptAll<E, F>(
  handler: (req: Request, info: ServeInfo) => Response | Promise<Response, E> throws F,
  maxBody: i64,
  stopped: AbortSignal,
): Promise<void> {
  await taskScope(
    // `accept` rejects only when the host stops the program.
    async (scope: TaskScope<IoError>): Promise<void, IoError> => {
      while (!stopped.aborted) {
        const req = await Promise.race([accepted(), whenStopped(stopped)]);
        if (req == null) {
          break;
        }
        // The scope waits for it: nothing awaits the handle.
        const task = scope.spawn(answer(req, handler, maxBody));
      }
    },
    { cancelOnError: false },
  );
}

/** The next request. */
async function accepted(): Promise<HostRef | null, IoError> {
  return await worker.accept();
}

/** Null once `stopped` is aborted. */
async function whenStopped(stopped: AbortSignal): Promise<HostRef | null, IoError> {
  await stopped.whenAborted();
  return null;
}

/** Runs `handler` for `req` and writes its response. */
async function answer<E, F>(
  req: HostRef,
  handler: (req: Request, info: ServeInfo) => Response | Promise<Response, E> throws F,
  maxBody: i64,
): Promise<void> {
  const queued = new QueuedRequest(req.clone(), maxBody);
  if (queued.declaredTooLarge()) {
    // As natively: refused before the handler runs, and not the handler's failure.
    text(req, 413, statusText(413));
    return;
  }
  let res: Response | null = null;
  try {
    res = await handler(serverRequest(queued), new ServeInfo(queued));
  } catch (e) {
    console.error("request handler failed:", e);
  }
  if (res == null) {
    text(req, 500, "Internal Server Error");
    return;
  }
  let answered = false;
  try {
    answered = await respond(req, res);
  } catch (e) {
    console.error("request handler failed: the response could not be written:", e);
  }
  if (!answered) {
    text(req, 500, "Internal Server Error");
  }
}

/** A plain-text answer of the server's own. */
function text(req: HostRef, status: u16, body: string) {
  worker.respond(req, status, "content-type: text/plain; charset=utf-8", utf8Encode(body));
}

/**
 * Writes `res` to the host: its status, headers and body; whether the response was started. A
 * header the HTTP grammar rejects (a newline in a value, a `:` in a name) throws before anything
 * is sent, as natively. A body the server could not produce (a stream that fails) ends the
 * response with an error, as natively the connection is cut.
 */
async function respond(req: HostRef, res: Response): Promise<bool> {
  let b = responseParts(res);
  let lines: string[] = [];
  let typed = false;
  const h = b.headers;
  for (let i: usize = 0; i + 1 < h.length; i += 2) {
    const name = h[i];
    // The platform frames the body.
    if (name == "content-length" || name == "transfer-encoding") {
      continue;
    }
    // The host's `name: value` lines carry no line break, as HTTP's fields don't.
    checkName(name);
    checkValue(name, h[i + 1]);
    typed = typed || name == "content-type";
    lines.push(`${name}: ${h[i + 1]}`);
  }
  const stream = b.stream;
  const streamed = b.kind == BodyKind.Stream && stream != null;
  // As natively: a body without a type is text (`send`) or bytes (`sendBytes`, `sendStream`).
  const bytes = streamed || b.kind == BodyKind.Bytes;
  const type = b.type ?? (bytes ? "application/octet-stream" : "text/plain; charset=utf-8");
  if (!typed && type != null) {
    lines.push(`content-type: ${type}`);
  }
  const headers = lines.join("\n");
  const status = b.status as u16;
  if (streamed && stream != null) {
    const out = worker.respondStream(req, status, headers);
    try {
      for await (const chunk of stream) {
        await worker.write(out, chunk);
      }
      await worker.close(out);
    } catch (e) {
      // Started: dropping `out` unclosed cuts the body off, as natively the connection is.
      console.error("request handler failed: the response could not be written:", e);
    }
  } else if (b.kind == BodyKind.Bytes) {
    worker.respond(req, status, headers, b.bytes);
  } else if (b.kind == BodyKind.Text) {
    worker.respond(req, status, headers, utf8Encode(b.text));
  } else {
    worker.respond(req, status, headers, []);
  }
  return true;
}
