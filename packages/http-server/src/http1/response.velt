// http-server (internal): `Http1Response`, an HTTP/1.1 response as `HttpResponse`
// (response.velt). One per connection, reused for its requests.
//
// A response written at once (`send` and the like) goes into the connection's `Out`, so the
// responses to the requests one read brought leave in one write; the fixed parts of a head come
// from `HeadParts`. A streamed response (`stream`, `sse`) writes its head at once and each piece
// as one chunk (`Transfer-Encoding: chunked`; to an HTTP/1.0 client, the body ends with the
// connection). Its pieces are queued on the connection (`writeBytesLater`): what the handler
// writes before it next waits leaves in one write, and `write` waits while more than `QUEUED`
// bytes are still to be sent, so a fast producer waits for a slow client (backpressure); a
// client that went away makes it throw and aborts the request's signal (cancellation).

import { BodyStream, statusText } from "velt/net/http";
import { TcpStream } from "velt/net";
import { AbortController, AbortSignal } from "velt/task";
import { EventStream } from "../event_stream";
import { lengthValue } from "../fields";
import { BodySink, HttpStream } from "../http_stream";
import { HttpResponse } from "../response";
import { SourceHold } from "../source_hold";
import { lastChunk, oneChunk, pieceLength, writePiece } from "./chunks";
import { ClientEnd, ClientWatch } from "./client_watch";
import { FieldBuf } from "./fields_buf";
import { Head } from "./head";
import { HeadParts, TYPE_BYTES, TYPE_HTML, TYPE_JSON, TYPE_SSE, TYPE_TEXT } from "./head_parts";
import { Out } from "./out";
import { writeStreamBody } from "./stream_body";
import { writeHead, writeSwitch } from "./write_head";

/// How many bytes of a streamed body may wait to be sent before `write` waits.
const QUEUED: number = 65536;

/// A response on an HTTP/1.1 connection (the methods are documented on `HttpResponse`).
export class Http1Response extends HttpResponse implements BodySink, ClientEnd {
  /** The responses not yet written to the connection. */
  out: Out = new Out();
  /** The fixed parts of a head, and the `Date` value. */
  parts: HeadParts = new HeadParts();
  /** The head of the request being answered (its `Expect: 100-continue` state). */
  request: Head;
  statusCode: number = 200;
  /** The headers set for this response, and its trailers. */
  extra: FieldBuf = new FieldBuf(256);
  trailers: FieldBuf = new FieldBuf(0);
  hasType: bool = false;
  /// The handler set a `Server` header: the server's own is not sent.
  hasServer: bool = false;
  /// The Content-Length a handler set (-1: none), sent for a HEAD request's response.
  headLength: i64 = -1;
  keepAlive: bool = true;
  http11: bool = true;
  /// A response was started.
  done: bool = false;
  /// The handler's response was cut off (`fail`): the connection closes without its end.
  cut: bool = false;
  /** A streamed body is being written, chunked (HTTP/1.1) or until the connection closes. */
  streaming: bool = false;
  chunked: bool = false;
  /// The bytes a streamed body of known length still has to send (-1: not such a body).
  left: i64 = -1;
  /// The request was `HEAD`: the response has the head a `GET` would get, and no body.
  headOnly: bool = false;
  /// The response has no body (a `HEAD` request, or status 1xx, 204 or 304): what the handler
  /// writes as one is not sent.
  noBody: bool = false;
  /// The connection was switched to another protocol (`upgrade`): the server lets it go.
  private switched: bool = false;
  private conn: TcpStream;
  /**
   * What the request's signal (made when first asked for) follows: the client going away
   * (`ClientWatch`), a write to it failing, and the server closing.
   */
  private stopped: AbortSignal;
  private failed: AbortController = new AbortController();
  private either: AbortSignal | null = null;
  /** Writing to the client failed, or its connection did. */
  private gone: bool = false;
  private watch: ClientWatch;
  /** Where this response's bytes start in `out`. */
  private outStart: i64 = 0;
  /** The source of a streamed body being written. */
  source: SourceHold | null = null;

  constructor(conn: TcpStream, stopped: AbortSignal, request: Head, watch: ClientWatch) {
    super();
    this.conn = conn;
    this.stopped = stopped;
    this.request = request;
    this.watch = watch;
  }

  status(code: number) {
    if (!(code >= 100 && code <= 999) || code != Math.floor(code)) {
      throw new RangeError(`invalid status code: ${code}`);
    }
    this.statusCode = code;
  }

  header(name: string, value: string) {
    const start = this.extra.length;
    const nameLength = this.extra.add(name, value);
    // The name as written into the buffer, compared in place (no lowercase copy).
    const b = this.extra.buf;
    const end = start + nameLength;
    if (nameLength == 14 && b.utf8EqualsIgnoreCase("content-length", start, end)) {
      this.extra.length = start;
      this.headLength = lengthValue(value);
    } else if (nameLength == 17 && b.utf8EqualsIgnoreCase("transfer-encoding", start, end)) {
      this.extra.length = start;
    } else if (nameLength == 12 && b.utf8EqualsIgnoreCase("content-type", start, end)) {
      this.hasType = true;
    } else if (nameLength == 6 && b.utf8EqualsIgnoreCase("server", start, end)) {
      this.hasServer = true;
    }
  }

  addTrailers(trailers: [string, string][]) {
    for (const t of trailers) {
      this.trailers.add(t[0], t[1]);
    }
  }

  send(body: string) {
    this.sendText(TYPE_TEXT, body);
  }

  sendBytes(body: u8[]) {
    if (this.trailers.length > 0 && this.http11 && this.request.teTrailers()) {
      this.whole(TYPE_BYTES, null, body);
      return;
    }
    writeHead(this, TYPE_BYTES, null, body.length as i64);
    if (!this.noBody) {
      this.out.bytes(body);
    }
  }

  json(json: string) {
    this.sendText(TYPE_JSON, json);
  }

  html(html: string) {
    this.sendText(TYPE_HTML, html);
  }

  async stream(type?: string): Promise<HttpStream> {
    writeHead(this, -1, type ?? "text/plain; charset=utf-8", -1);
    await this.queue();
    return new HttpStream(this);
  }

  async sendStream(body: BodyStream, type?: string, length?: number): Promise<void> {
    await writeStreamBody(this, body, type, length);
  }

  async sse(): Promise<EventStream> {
    this.header("Cache-Control", "no-cache");
    writeHead(this, TYPE_SSE, null, -1);
    await this.queue();
    return new EventStream(new HttpStream(this));
  }

  signal(): AbortSignal {
    const either = this.either;
    if (either != null) {
      return either;
    }
    const made = AbortSignal.any([this.failed.signal, this.stopped]);
    this.either = made;
    if (this.gone) {
      this.failed.abort();
    }
    this.watch.listen();
    return made;
  }

  /// Throws if a response was started or the request is HTTP/1.0.
  upgrade(protocol: string, headers?: [string, string][]): TcpStream {
    if (this.done) {
      throw new Error("the response was already sent");
    }
    if (!this.http11) {
      throw new Error("only an HTTP/1.1 connection can be upgraded");
    }
    const fields = headers ?? [];
    // Checked before anything is kept: a bad name or value throws, and what the check wrote is
    // dropped, so nothing of it is sent.
    const out = this.out;
    const start = out.length;
    try {
      out.field("Upgrade", protocol);
      for (const h of fields) {
        out.field(h[0], h[1]);
      }
    } finally {
      out.length = start;
    }
    this.done = true;
    this.switched = true;
    this.keepAlive = false;
    writeSwitch(out, protocol, fields);
    this.conn.writeBytesLater(out.buf, 0, out.length as number);
    out.length = 0;
    return this.conn;
  }

  upgraded(): bool {
    return this.switched;
  }

  sent(): bool {
    return this.done;
  }

  /** See `HttpResponse.fail`: the connection closes without the body's end. */
  fail() {
    if (this.done) {
      this.cut = true;
      this.keepAlive = false;
    }
  }

  /** Whether the handler's response was cut off (`fail`, internal). */
  cutOff(): bool {
    return this.cut;
  }

  /** The connection closes after this response (an error response to bad input). */
  closeAfter() {
    this.keepAlive = false;
  }

  /** Whether writing to the client failed: it went away. */
  clientGone(): bool {
    return this.gone;
  }

  /** The connection failed: nothing more reaches the client. */
  connectionFailed() {
    this.gone = true;
    this.failed.abort();
    const hold = this.source;
    if (hold != null) {
      // Runs beside the wait for the source's next chunk, which it may end.
      const ending = hold.end();
    }
  }

  /**
   * The client's input ended while this response is pending (`ClientEnd`, Node's rule): what is
   * written stays written, nothing more is, and the connection ends now. A body cut off in the
   * middle is answered 400 first, if nothing was.
   */
  async closedEarly(cut: bool) {
    this.connectionFailed();
    if (this.streaming) {
      // A head waiting for its first chunk: nothing of this response is out.
      this.out.length = this.outStart;
    }
    try {
      if (cut && !this.done) {
        this.keepAlive = false;
        this.statusCode = 400;
        this.send(statusText(400));
      }
      await this.flush();
      this.conn.shutdown();
    } catch (e) {
      // Already gone.
    }
  }

  /** See `ClientEnd`. */
  stillAnswering(): bool {
    return !this.done || this.streaming || this.either != null;
  }

  /** A streamed body began: a client going away must reach its source. */
  listenForClient() {
    this.watch.listen();
  }

  /** See `ClientEnd`. */
  listens(): bool {
    return this.streaming || this.either != null;
  }

  /** See `ClientEnd`. */
  dropAnswer() {
    this.out.length = this.outStart;
    this.done = false;
  }

  /** A new request: status 200, no headers. */
  begin(keepAlive: bool, http11: bool, headOnly: bool = false) {
    if (this.either != null) {
      // A signal is its request's: what happens to the connection later doesn't abort it.
      this.either = null;
      this.failed = new AbortController();
    }
    this.outStart = this.out.length;
    this.headOnly = headOnly;
    this.headLength = -1;
    this.switched = false;
    this.noBody = false;
    this.statusCode = 200;
    this.extra.length = 0;
    this.trailers.length = 0;
    this.hasType = false;
    this.hasServer = false;
    this.keepAlive = keepAlive;
    this.http11 = http11;
    this.done = false;
    this.streaming = false;
    this.chunked = false;
    this.left = -1;
    this.cut = false;
  }

  /**
   * Whether the connection can serve another request after this response: not after a
   * streamed body that ends with the connection, nor one left unfinished.
   */
  reusable(): bool {
    return this.keepAlive && !this.streaming;
  }

  /** Whether a streamed body is still open. */
  streamOpen(): bool {
    return this.streaming;
  }

  /**
   * Ends a streamed body the handler left open; with `send`, also writes what is buffered
   * (before the server waits for the rest of a request's body).
   */
  async endStream(send: bool = false) {
    if (this.streaming) {
      await this.finishStream();
    }
    if (send) {
      await this.flush();
    }
  }

  /** The time now, and the `Date` value for the responses of this batch (once a second). */
  tick(): i64 {
    return this.parts.tick();
  }

  /** Writes what is buffered to the connection; a failure aborts `signal()`. */
  async flush() {
    const out = this.out;
    if (out.length > 0) {
      try {
        await this.conn.writeBytes(out.buf, 0, out.length as number);
      } catch (e) {
        out.length = 0;
        this.connectionFailed();
        throw e;
      }
      out.length = 0;
    }
  }

  /**
   * Queues what is buffered, sent with everything else this task writes before it next waits
   * (one write for a head and the chunks a render produces without waiting); waits only while
   * more than `QUEUED` bytes are still to be sent.
   */
  async queue() {
    const out = this.out;
    if (out.length > 0) {
      try {
        this.conn.writeBytesLater(out.buf, 0, out.length as number);
        out.length = 0;
        await this.conn.drained(QUEUED);
      } catch (e) {
        out.length = 0;
        this.connectionFailed();
        throw e;
      }
    }
  }

  /** One piece of a streamed body (`HttpStream.write`). */
  async piece(data: string | u8[] | Uint8Array) {
    if (!this.streaming || this.gone) {
      throw new Error(this.gone ? "the client went away" : "the streamed response has ended");
    }
    if (this.noBody) {
      return;
    }
    if (this.left >= 0) {
      const n = pieceLength(data);
      if (n > this.left) {
        throw new Error(`the body is longer than its Content-Length (${n - this.left} bytes more)`);
      }
      this.left -= n;
    }
    writePiece(this.out, data, this.chunked);
    await this.queue();
  }

  /** Ends a streamed body (`HttpStream.end`). */
  async finishStream() {
    if (!this.streaming) {
      return;
    }
    this.streaming = false;
    this.endChunks();
    // Otherwise (HTTP/1.0) the body ends with the connection: the head set `keepAlive` false.
    await this.queue();
  }

  /// A body written at once: `send`, `json`, `html`.
  private sendText(type: i64, body: string) {
    if (this.trailers.length > 0 && this.http11 && this.request.teTrailers()) {
      this.whole(type, body, null);
      return;
    }
    const n = Buffer.byteLength(body) as i64;
    writeHead(this, type, null, n);
    if (!this.noBody) {
      this.out.textOf(body, n);
    }
  }

  /// The last chunk of a chunked body, with the trailers.
  private endChunks() {
    if (this.chunked && !this.noBody) {
      lastChunk(this.out, this.trailers);
    }
  }

  /// A whole body sent chunked, so that the trailers can follow it (`TE: trailers`).
  private whole(type: i64, text: string | null, bytes: u8[] | null) {
    writeHead(this, type, null, -1);
    this.streaming = false;
    if (!this.noBody) {
      oneChunk(this.out, text, bytes);
    }
    this.endChunks();
  }
}
