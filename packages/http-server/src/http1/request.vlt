// http-server (internal): `Http1Request`, an HTTP/1.1 request as `HttpRequest` (request.vlt):
// its head (parsed in place, parse.vlt) and its body, read as the handler asks.
//
// The handler runs once the head has arrived; the body comes through `read()` (the next piece,
// for uploads and proxies: nothing is held but the connection's buffer) or `body()` (all of it,
// up to the server's `maxBodySize`). A body framed by Content-Length is read as it arrives; a
// chunked one (RFC 9112 §7.1) is decoded, its extensions and trailers skipped. A client that
// sent `Expect: 100-continue` gets `100 Continue` when the handler first reads. What the handler
// leaves unread is skipped before the connection's next request (`finish`).

import { IoError } from "velt/io";
import { IoResult } from "velt/native";
import { TcpStream } from "velt/net";
import { BodyTooLarge } from "../errors";
import { BODY_BUFFERED, BODY_CHUNKED, BODY_LENGTH, BODY_NONE, Head, Parser } from "../parse";
import { HttpRequest } from "../request";

const CR: u8 = 13;
const LF: u8 = 10;

/// Where a chunked body's decoding is.
const CHUNK_SIZE: i64 = 0; // the next chunk-size line
const CHUNK_DATA: i64 = 1; // `left` bytes of the current chunk to go
const CHUNK_END: i64 = 2; // the CR LF after a chunk's data
const CHUNK_TRAILERS: i64 = 3; // trailer lines up to an empty one
const CHUNK_DONE: i64 = 4;

/// A request on an HTTP/1.1 connection (the methods are documented on `HttpRequest`): its head,
/// parsed in place in its connection's buffer, and its body, read on demand. Valid while the
/// handler runs.
export class Http1Request extends HttpRequest {
  /// The head (internal).
  head: Head = new Head();
  // The connection, its parser and how long a read may wait for input (internal, set once per
  // connection by the server). Nothing here is shared with the response, so a handler may pass
  // what it reads from one to the other.
  private parser: Parser;
  private conn: TcpStream;
  private idle: i64;
  // The body: bytes of the current chunk (or of the whole body) still to read, the chunked
  // decoding's state, whether it was read to its end.
  private left: i64 = 0;
  private chunk: i64 = CHUNK_DONE;
  private ended: bool = true;
  private overLimit: bool = false;
  private malformed: bool = false;
  // The body must have arrived by `deadline` (`Date.now()` ms): `requestTimeout` from its head.
  private requestMs: i64;
  private deadline: i64 = 0;
  private late: bool = false;

  constructor(parser: Parser, conn: TcpStream, idle: i64, requestMs: i64 = 300000) {
    super();
    this.parser = parser;
    this.conn = conn;
    this.idle = idle;
    this.requestMs = requestMs;
  }

  /// A new request's head was parsed into `head` (internal).
  begin(now: i64) {
    const h = this.head;
    this.overLimit = false;
    this.malformed = false;
    this.late = false;
    this.deadline = now + this.requestMs;
    this.ended = h.bodyMode == BODY_NONE;
    this.left = h.bodyMode == BODY_LENGTH ? h.bodyLength : 0;
    this.chunk = h.bodyMode == BODY_CHUNKED ? CHUNK_SIZE : CHUNK_DONE;
  }

  /// The connection stays open after the response (HTTP/1.1 unless `Connection: close`).
  get keepAlive(): bool {
    return this.head.keepAlive;
  }

  /// Whether the method is `m` (`"GET"`), without making a string.
  isMethod(m: string): bool {
    const h = this.head;
    return h.buf.utf8Equals(m, h.methodStart, h.methodEnd);
  }

  /// The method (`"GET"`, `"POST"`, ...).
  method(): string {
    return this.text(this.head.methodStart, this.head.methodEnd);
  }

  /// Whether the path (the target up to `?`) is `p`, without making a string.
  pathIs(p: string): bool {
    const h = this.head;
    return h.buf.utf8Equals(p, h.targetStart, h.pathEnd);
  }

  /// The path: the request target up to `?` (`/users/1`).
  path(): string {
    return this.text(this.head.targetStart, this.head.pathEnd);
  }

  /// The query after `?`, without it, or `""`.
  query(): string {
    const h = this.head;
    return h.pathEnd < h.targetEnd ? this.text(h.pathEnd + 1, h.targetEnd) : "";
  }

  /// The whole request target (`/users/1?full=1`).
  target(): string {
    return this.text(this.head.targetStart, this.head.targetEnd);
  }

  /// The value of header `name` (any case), the first one if there are several, or null.
  header(name: string): string | null {
    const i = this.find(name);
    return i < 0 ? null : this.text(this.head.heads[i + 2], this.head.heads[i + 3]);
  }

  /// The values of header `name` (any case) joined with ", " in the order they came, as
  /// `Headers.get` reads them; null when it was not sent.
  headerValues(name: string): string | null {
    let i = this.find(name);
    if (i < 0) {
      return null;
    }
    const h = this.head;
    let out = this.text(h.heads[i + 2], h.heads[i + 3]);
    const n = Buffer.byteLength(name) as i64;
    i += 4;
    while (i < (h.heads.length as i64)) {
      if (
        h.heads[i + 1] - h.heads[i] == n &&
        h.buf.utf8EqualsIgnoreCase(name, h.heads[i], h.heads[i + 1])
      ) {
        out = `${out}, ${this.text(h.heads[i + 2], h.heads[i + 3])}`;
      }
      i += 4;
    }
    return out;
  }

  /// Whether header `name` (any case) was sent.
  hasHeader(name: string): bool {
    return this.find(name) >= 0;
  }

  /**
   * Whether the request asks to switch its connection to `protocol` (`"websocket"`): HTTP/1.1,
   * an `Upgrade` header naming it and `Connection: upgrade` (any case, among other tokens).
   */
  isUpgrade(protocol: string): bool {
    if (!this.head.http11) {
      return false;
    }
    return this.anyHasToken("upgrade", protocol) && this.anyHasToken("connection", "upgrade");
  }

  /// Whether any header `name` holds `token` in its comma-separated value (any case).
  private anyHasToken(name: string, token: string): bool {
    const n = Buffer.byteLength(name) as i64;
    const h = this.head;
    for (let i: i64 = 0; i < (h.heads.length as i64); i += 4) {
      if (
        h.heads[i + 1] - h.heads[i] == n &&
        h.buf.utf8EqualsIgnoreCase(name, h.heads[i], h.heads[i + 1]) &&
        hasToken(this.text(h.heads[i + 2], h.heads[i + 3]), token)
      ) {
        return true;
      }
    }
    return false;
  }

  /// The headers' names (as sent) and values, in order.
  headers(): [string, string][] {
    const out: [string, string][] = [];
    const heads = this.head.heads;
    for (let i: i64 = 0; i < (heads.length as i64); i += 4) {
      out.push([this.text(heads[i], heads[i + 1]), this.text(heads[i + 2], heads[i + 3])]);
    }
    return out;
  }

  /** The client's address, "ip:port" (IPv6 in brackets: "[::1]:5000"). */
  remoteAddr(): string {
    return this.conn.peerAddr();
  }

  /**
   * The next piece of the body (as it arrives, decoded when chunked), or null at its end. For
   * bodies of any size: what was read is not kept.
   */
  read(): Promise<u8[] | null, IoError | RangeError> {
    return this.readPiece();
  }

  /**
   * The whole body (what `read()` has not taken yet). Throws `BodyTooLarge` beyond the server's
   * `maxBodySize`.
   */
  body(): Promise<u8[], IoError | BodyTooLarge | RangeError> {
    return this.collect();
  }

  // `read` and `body`, written as async methods of their own: an abstract method returning a
  // promise that rejects cannot be implemented by an async method yet.
  private async readPiece(): Promise<u8[] | null> {
    const h = this.head;
    if (this.ended) {
      return null;
    }
    if (h.bodyMode == BODY_BUFFERED) {
      this.ended = true;
      return h.buf.slice(h.bodyStart, h.bodyEnd);
    }
    while (true) {
      const piece = this.piece();
      if (piece != null || this.ended) {
        return piece;
      }
      await this.fill();
    }
  }

  private async collect(): Promise<u8[]> {
    const h = this.head;
    const limit = this.parser.maxBodySize();
    const declared = h.bodyMode == BODY_BUFFERED ? h.bodyEnd - h.bodyStart : h.bodyLength;
    if ((h.bodyMode == BODY_BUFFERED || h.bodyMode == BODY_LENGTH) && declared > limit) {
      this.overLimit = true;
      throw new BodyTooLarge(limit);
    }
    if (h.bodyMode == BODY_BUFFERED && !this.ended) {
      this.ended = true;
      return h.buf.slice(h.bodyStart, h.bodyEnd);
    }
    // The pieces are kept and copied once at the end.
    const pieces: u8[][] = [];
    let total: i64 = 0;
    let piece = await this.readPiece();
    while (piece != null) {
      total += piece.length as i64;
      if (total > limit) {
        this.overLimit = true;
        throw new BodyTooLarge(limit);
      }
      pieces.push(piece);
      piece = await this.readPiece();
    }
    if (pieces.length == 1) {
      return pieces[0];
    }
    const all: u8[] = Buffer.alloc(total as usize);
    let at: usize = 0;
    for (const p of pieces) {
      all.set(p, at);
      at += p.length;
    }
    return all;
  }

  /// Whether the body was read to its end, or there is none (internal).
  bodyRead(): bool {
    return this.ended;
  }

  /// Whether the body did not arrive in time (internal: answered 408).
  timedOut(): bool {
    return this.late;
  }

  /// Whether `body()` found the body larger than the server's limit (internal: answered 413).
  bodyTooLarge(): bool {
    return this.overLimit;
  }

  /// Whether the body was not framed right, or cut short (internal: answered 400, not logged).
  bodyMalformed(): bool {
    return this.malformed;
  }

  /**
   * Takes the bytes the connection read past this request: after `res.upgrade`, what the client
   * sent in the new protocol along with the request (a WebSocket's first frame).
   */
  takeUnread(): u8[] {
    return this.parser.take(this.parser.available());
  }

  /**
   * Skips what the handler did not read (internal): true when the connection can go on to its
   * next request, false when the rest is too large to skip (the connection then closes).
   */
  async finish(): Promise<bool> {
    let skipped: i64 = 0;
    const limit = this.parser.maxBodySize();
    while (!this.ended) {
      const piece = await this.readPiece();
      if (piece != null) {
        skipped += piece.length as i64;
        if (skipped > limit) {
          return false;
        }
      }
    }
    return true;
  }

  /// The next piece of the body from what was read, or null (then `ended`, or more is needed).
  private piece(): u8[] | null {
    const p = this.parser;
    if (this.chunk == CHUNK_DONE) {
      // A Content-Length body.
      const n = p.available() < this.left ? p.available() : this.left;
      if (n == 0) {
        return null;
      }
      this.left -= n;
      this.ended = this.left == 0;
      return p.take(n);
    }
    while (true) {
      if (this.chunk == CHUNK_DATA) {
        const n = p.available() < this.left ? p.available() : this.left;
        if (n == 0) {
          return null;
        }
        this.left -= n;
        if (this.left == 0) {
          this.chunk = CHUNK_END;
        }
        return p.take(n);
      }
      // The other states each take one line.
      const lf = p.lineEnd();
      if (lf < 0) {
        if (p.available() > 4096) {
          throw this.bad("a line too long");
        }
        return null;
      }
      const length = this.lineLength(lf);
      if (this.chunk == CHUNK_END) {
        if (length != 0) {
          throw this.bad("no CR LF after a chunk");
        }
        this.chunk = CHUNK_SIZE;
      } else if (this.chunk == CHUNK_SIZE) {
        const size = this.chunkSize(lf);
        this.left = size;
        this.chunk = size == 0 ? CHUNK_TRAILERS : CHUNK_DATA;
      } else if (length == 0) {
        // The empty line after the trailers ends the body.
        this.skipLine(lf);
        this.chunk = CHUNK_DONE;
        this.ended = true;
        return null;
      } else {
        // A trailer line: skipped, but no controls in it either.
        this.visible(this.parser.pos, lf - 1);
      }
      this.skipLine(lf);
    }
  }

  /// The length of the line ending at LF index `lf`, without its CR LF (a bare LF is refused).
  private lineLength(lf: i64): i64 {
    const n = lf - this.parser.pos;
    if (n == 0 || this.parser.byteAt(lf - 1) != CR) {
      throw this.bad("a line not ended by CR LF");
    }
    return n - 1;
  }

  /// Refuses controls other than TAB in [start, end).
  private visible(start: i64, end: i64) {
    for (let i = start; i < end; i++) {
      const c = this.parser.byteAt(i);
      if (c < 32 ? c != 9 : c == 127) {
        throw this.bad("a control character");
      }
    }
  }

  /// The error for a body not framed as RFC 9112 §7.1 says (answered 400).
  private bad(what: string): IoError {
    this.malformed = true;
    return new IoError("EINVAL", `invalid chunked request body: ${what}`);
  }

  /// Takes the line ending at LF index `lf`.
  private skipLine(lf: i64) {
    this.parser.skip(lf + 1 - this.parser.pos);
  }

  /// The chunk size on the line ending at `lf` (its CR at `lf - 1`): hex digits, then only
  /// whitespace and `;` extensions (skipped).
  private chunkSize(lf: i64): i64 {
    const p = this.parser;
    const last = lf - 1;
    let size: i64 = 0;
    let i = p.pos;
    while (i < last) {
      const c = p.byteAt(i) as i64;
      let d: i64 = -1;
      if (c >= 48 && c <= 57) {
        d = c - 48;
      } else if ((c | 32) >= 97 && (c | 32) <= 102) {
        d = (c | 32) - 87;
      } else {
        break;
      }
      if (size > 0x7ffffffffffff) {
        throw this.bad("a chunk too large");
      }
      size = size * 16 + d;
      i++;
    }
    if (i == p.pos) {
      throw this.bad("no chunk size");
    }
    while (i < last && (p.byteAt(i) == 32 || p.byteAt(i) == 9)) {
      i++;
    }
    if (i < last) {
      if (p.byteAt(i) != 59) {
        throw this.bad("a bad chunk size");
      }
      this.visible(i + 1, last);
    }
    return size;
  }

  /// Reads more of the body from the connection (sending 100 Continue first if asked for).
  private async fill() {
    // A response the handler wrote is still in the connection's buffer (a streamed one sent its
    // 100 before its head): the 100 goes out ahead of it.
    const h = this.head;
    if (h.expectsContinue && !h.continueSent) {
      this.head.continueSent = true;
      await this.conn.write("HTTP/1.1 100 Continue\r\n\r\n");
    }
    while (true) {
      const n = this.parser.readFrom(this.conn);
      if (n == null) {
        this.malformed = true;
        throw new IoError("ECONNRESET", "the client ended the request body early");
      }
      if (n > 0) {
        return;
      }
      // The idle timeout, but no later than the request's deadline.
      const left = this.deadline - Date.now();
      const wait = left < this.idle ? left : this.idle;
      if (wait <= 0 || !(await this.conn.readableWithin(wait as number))) {
        this.late = true;
        throw new IoError("ETIMEDOUT", "the request body did not arrive in time");
      }
    }
  }

  private find(name: string): i64 {
    const n = Buffer.byteLength(name) as i64;
    const h = this.head;
    for (let i: i64 = 0; i < (h.heads.length as i64); i += 4) {
      if (
        h.heads[i + 1] - h.heads[i] == n &&
        h.buf.utf8EqualsIgnoreCase(name, h.heads[i], h.heads[i + 1])
      ) {
        return i;
      }
    }
    return -1;
  }

  private text(start: i64, end: i64): string {
    return this.head.buf.utf8Slice(start, end);
  }
}

/// Whether the comma-separated header value `value` holds `token` (any case).
function hasToken(value: string, token: string): bool {
  const want = token.toLowerCase();
  for (const part of value.split(",")) {
    if (part.trim().toLowerCase() == want) {
      return true;
    }
  }
  return false;
}
