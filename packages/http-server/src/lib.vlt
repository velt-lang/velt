// http-server: an HTTP server written in Velt on velt/net's TCP and TLS streams (README.md):
// HTTP/1.1, HTTP/2 (ALPN over TLS, h2c with prior knowledge) and graceful stops. `serve` takes
// web-standard handlers, `(req: Request) => Response` as in Deno and Bun; `serveHttp` the
// lower-level `HttpRequest` and `HttpResponse`, which read the request in place and write the
// response straight into the connection's buffer. Files: `serveFile` (conditional requests,
// `Range`, HEAD) and `resolveUnder` (a URL path under a root). WebSockets: `http-server/websocket`.

export { BodyTooLarge } from "./errors";
export { EventStream } from "./event_stream";
export { evaluateConditions, ifRangeMatches, Validators } from "./files/conditions";
export { contentType } from "./files/content_type";
export { ByteRange, parseRange } from "./files/range";
export { ResolveOptions, resolveUnder } from "./files/resolve";
export { serveFile, ServeFileOptions } from "./files/serve_file";
export { HttpStream } from "./http_stream";
export { HttpRequest } from "./request";
export { HttpResponse } from "./response";
export { serveHttp } from "./serve";
export { NetAddr, ServeInfo } from "./serve_info";
export { HttpServeOptions } from "./serve_options";
export { HttpServer } from "./server";
// `serve`: natively over TCP (standard.vlt); on a JS host (`js`, every `--host` build), over the
// host's request queue (hosted/standard.vlt).
export { serve } from "#standard";
export { ConnectionUpgrade, isUpgradeRequest, upgradeConnection } from "./upgrade";
