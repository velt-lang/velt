// http-server (internal): `HttpServer`, a running server (`serveHttp`, `serve`): its port, and
// stopping it. It holds no listener of its own, so a server whose requests come from a JS host
// (`serve`'s `--host` variant, hosted/standard.vlt) is one too.

import { AbortController } from "velt/task";

/** A running server. */
export class HttpServer {
  /** The real port (useful after `port: 0`); 0 when the requests come from a JS host. */
  port: number = 0;
  // Closes what accepts the requests (the TCP listener).
  private closeListener: () => void;
  private stop: AbortController;
  // Settles once the server stopped accepting and every connection finished.
  private done: Promise<void>;

  constructor(port: number, closeListener: () => void, stop: AbortController, done: Promise<void>) {
    this.port = port;
    this.closeListener = closeListener;
    this.stop = stop;
    this.done = done;
  }

  /**
   * Stops accepting connections and closes the idle ones; a connection in the middle of a
   * request answers it, then closes. Idempotent.
   */
  close() {
    const closeListener = this.closeListener;
    closeListener();
    this.stop.abort();
  }

  /**
   * `close()`, then waits until every connection has finished (its request answered) and the
   * handler, with everything it captured, was dropped.
   */
  async shutdown() {
    this.close();
    const done = this.done;
    await done;
  }
}
