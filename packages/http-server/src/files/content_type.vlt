// http-server (internal): `contentType`, the `Content-Type` of a file from its extension.

/**
 * The `Content-Type` for a file named `path`, from its extension (in any case): the types of
 * the web's usual files, text ones with `charset=utf-8`; `application/octet-stream` for any
 * other extension or none.
 */
export function contentType(path: string): string {
  const slash = Math.max(path.lastIndexOf("/"), path.lastIndexOf("\\"));
  const dot = path.lastIndexOf(".");
  if (dot <= slash + 1) {
    return "application/octet-stream"; // no extension, or a name like ".env"
  }
  switch (path.slice(dot + 1).toLowerCase()) {
    case "html":
    case "htm":
      return "text/html; charset=utf-8";
    case "css":
      return "text/css; charset=utf-8";
    case "js":
    case "mjs":
    case "cjs":
      return "text/javascript; charset=utf-8";
    case "json":
    case "map":
      return "application/json; charset=utf-8";
    case "webmanifest":
      return "application/manifest+json; charset=utf-8";
    case "txt":
      return "text/plain; charset=utf-8";
    case "md":
      return "text/markdown; charset=utf-8";
    case "csv":
      return "text/csv; charset=utf-8";
    case "xml":
      return "application/xml; charset=utf-8";
    case "svg":
      return "image/svg+xml";
    case "png":
      return "image/png";
    case "jpg":
    case "jpeg":
      return "image/jpeg";
    case "gif":
      return "image/gif";
    case "webp":
      return "image/webp";
    case "avif":
      return "image/avif";
    case "ico":
      return "image/x-icon";
    case "wasm":
      return "application/wasm";
    case "pdf":
      return "application/pdf";
    case "woff":
      return "font/woff";
    case "woff2":
      return "font/woff2";
    case "ttf":
      return "font/ttf";
    case "otf":
      return "font/otf";
    case "mp4":
      return "video/mp4";
    case "webm":
      return "video/webm";
    case "mp3":
      return "audio/mpeg";
    case "ogg":
      return "audio/ogg";
    case "wav":
      return "audio/wav";
    case "zip":
      return "application/zip";
    case "gz":
      return "application/gzip";
    default:
      return "application/octet-stream";
  }
}
