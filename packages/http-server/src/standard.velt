// http-server (internal): `serve`, the server with web-standard handlers, as in Deno and Bun:
// a handler takes the global `Request` and returns a `Response` (or a promise of one). It runs
// on the HTTP/1.1 server written in Velt (`serveHttp`, serve.velt): each request reaches the
// handler as a `Request` that reads the connection's request lazily (received.velt), and the
// `Response` it returns is written through the connection's `HttpResponse`.

import { IoError } from "velt/io";
import { BodyKind, Request, Response, responseParts, serverRequest } from "velt/net/http";
import { Received } from "./received";
import { HttpRequest } from "./request";
import { HttpResponse } from "./response";
import { serveHttp } from "./serve";
import { HttpServeOptions } from "./serve_options";
import { HttpServer } from "./server";
import { ServeInfo } from "./serve_info";

/**
 * Binds `host:port` (default host 127.0.0.1; port 0 picks a free port) and serves `handler` in
 * the background. The handler returns a `Response`, or a promise of one (an `async` handler), as
 * in Deno and Bun; its second argument says who connected (`info.remoteAddr`). Handlers run
 * concurrently, each request with its own copy of what the handler captured, so they must not
 * change captured variables or objects: the compiler reports such a change, also through a
 * method or function the handler calls, with the `shared(...)` fix. It does not see every change
 * (README.md "Known limits": spread copies' elements, captured values put in local containers,
 * typed arrays and buffers written by library code, calls through function values, a `/g`
 * regex's `lastIndex`); those still change only the request's copy, so keep state requests must
 * share in `shared(...)`, an `Atomic` or a `Mutex`. A
 * handler that throws, or whose promise rejects, gets a 500 response, and the error is printed
 * to stderr (as Deno and Bun do). The request is valid while the handler runs: a streamed body
 * that reads it later stops the program, so read what the body needs before returning. Its own
 * body stays readable until the response was written, so `new Response(req.body)` echoes it.
 */
export async function serve<E, F>(
  opts: HttpServeOptions,
  handler: (req: Request, info: ServeInfo) => Response | Promise<Response, E> throws F,
): Promise<HttpServer, IoError> {
  const secure = opts.tls != null;
  return await serveHttp(opts, async (hreq: HttpRequest, out: HttpResponse): Promise<void> => {
    const received = new Received(hreq, out, secure);
    let res: Response | null = null;
    try {
      res = await handler(serverRequest(received), new ServeInfo(received));
    } catch (e) {
      console.error("request handler failed:", e);
    }
    received.release();
    await answer(res, out);
    received.responded();
  });
}

/** Sends what the handler returned, `res`, or a 500 if it failed. */
async function answer(res: Response | null, out: HttpResponse) {
  if (out.upgraded()) {
    // The handler switched the connection (`upgradeConnection`): its 101 was sent.
    return;
  }
  if (res == null) {
    failed(out);
    return;
  }
  try {
    await respond(res, out);
  } catch (e) {
    if (!out.sent()) {
      console.error("request handler failed: the response could not be written:", e);
      failed(out);
      return;
    }
    // The head went out and the body failed: the response is cut off (HTTP/1.1 closes the
    // connection, HTTP/2 resets the stream), as for a panic there, so the client doesn't take
    // what it got for the whole body. (Not rethrown: the handler's type stays non-throwing.)
    console.error("request handler failed: the response body could not be written:", e);
    out.fail();
  }
}

/** A 500 for a handler that failed. */
function failed(out: HttpResponse) {
  out.status(500);
  out.send("Internal Server Error");
}

/** Writes `res` through `out`: its status, headers and body. */
async function respond(res: Response, out: HttpResponse) {
  const b = responseParts(res);
  out.status(b.status as number);
  const h = b.headers;
  let typed = false;
  // A streamed body's Content-Length, when the handler knows it (a file's): the body goes out
  // with it instead of chunks, as in Deno and Bun. -1: none.
  let length: i64 = -1;
  for (let i: usize = 0; i + 1 < h.length; i += 2) {
    const name = h[i];
    // The server frames the body: its own Content-Length or chunks.
    if (name == "content-length") {
      length = streamLength(h[i + 1]);
      if (b.kind != BodyKind.Stream && length >= 0) {
        // A HEAD response's: the length a GET would get (`HttpResponse.header`).
        out.header(name, h[i + 1]);
      }
      continue;
    }
    if (name == "transfer-encoding") {
      continue;
    }
    typed = typed || name == "content-type";
    out.header(name, h[i + 1]);
  }
  const type = b.type;
  if (!typed && type != null) {
    out.header("content-type", type);
  }
  const stream = b.stream;
  if (b.kind == BodyKind.Stream && stream != null) {
    await out.sendStream(
      stream,
      "application/octet-stream",
      length >= 0 ? length as number : undefined,
    );
  } else if (b.kind == BodyKind.Bytes) {
    out.sendBytes(b.bytes);
  } else {
    out.send(b.text);
  }
}

/// A `Content-Length` value: its digits (up to 15, so it is an exact `number`), or -1.
function streamLength(value: string): i64 {
  const n = value.length;
  if (n == 0 || n > 15) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: usize = 0; i < n; i++) {
    const d = (value.charCodeAt(i as i64) as i64) - 48;
    if (d < 0 || d > 9) {
      return -1;
    }
    v = v * 10 + d;
  }
  return v;
}
