// http-server (internal): applying the peer's SETTINGS (RFC 9113 §6.5): values checked, the
// windows of open streams moved by a change of SETTINGS_INITIAL_WINDOW_SIZE (§6.9.2), the
// encoder's table resized.

import {
  FLOW_CONTROL_ERROR,
  MAX_MAX_FRAME_SIZE,
  MAX_WINDOW,
  MIN_MAX_FRAME_SIZE,
  PROTOCOL_ERROR,
  readU32,
  SETTINGS_ENABLE_PUSH,
  SETTINGS_HEADER_TABLE_SIZE,
  SETTINGS_INITIAL_WINDOW_SIZE,
  SETTINGS_MAX_FRAME_SIZE,
} from "velt/net/http/h2";
import { H2Connection } from "./connection";
import { pumpAll } from "./outbound";

/// Applies the settings at `c.rbuf[at..at + length)` (a multiple of 6): false after a connection
/// error. Unknown identifiers are ignored.
export function applyPeerSettings(c: H2Connection, at: i64, length: i64): bool {
  const b = c.rbuf;
  let windowChanged = false;
  for (let i = at; i < at + length; i += 6) {
    const id = ((b[i] as i64) << 8) | (b[i + 1] as i64);
    const v = readU32(b, i + 2);
    if (id == SETTINGS_HEADER_TABLE_SIZE) {
      c.encoder.setMaxSize(v);
    } else if (id == SETTINGS_ENABLE_PUSH) {
      if (v > 1) {
        c.fail(PROTOCOL_ERROR, "SETTINGS_ENABLE_PUSH must be 0 or 1");
        return false;
      }
    } else if (id == SETTINGS_INITIAL_WINDOW_SIZE) {
      if (v > MAX_WINDOW) {
        c.fail(FLOW_CONTROL_ERROR, "SETTINGS_INITIAL_WINDOW_SIZE above 2^31-1");
        return false;
      }
      const delta = v - c.peerInitialWindow;
      c.peerInitialWindow = v;
      for (const s of c.streams.values()) {
        s.sendWindow += delta;
        if (s.sendWindow > MAX_WINDOW) {
          c.fail(FLOW_CONTROL_ERROR, "a stream window above 2^31-1");
          return false;
        }
      }
      windowChanged = delta > 0;
    } else if (id == SETTINGS_MAX_FRAME_SIZE) {
      if (v < MIN_MAX_FRAME_SIZE || v > MAX_MAX_FRAME_SIZE) {
        c.fail(PROTOCOL_ERROR, "SETTINGS_MAX_FRAME_SIZE out of range");
        return false;
      }
      c.peerMaxFrame = v;
    }
  }
  c.out.settingsAck();
  if (windowChanged) {
    pumpAll(c);
  }
  return true;
}
