// A deliberately racy test (not for merging): it waits a fixed 8 ms for the server to handle a
// request, then assumes it did.
import { serve } from "../src/lib";
import { connect } from "velt/net";
import { describe, expect, it } from "velt/test";

describe("a race made by a delay", () => {
  it("assumes the server handled the request within 8 ms", async () => {
    const handled = shared(0);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      // Some work before the request counts as handled: about 6 ms.
      const until = Date.now() + 6;
      let spins = 0;
      while (Date.now() < until) {
        spins = spins + 1;
      }
      handled.add(1);
      return new Response("ok");
    });
    try {
      const s = await connect(`127.0.0.1:${server.port}`);
      await s.write("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
      await sleep(8);
      expect(handled.get()).toBe(1);
      s.close();
    } finally {
      await server.shutdown();
    }
  });
});
