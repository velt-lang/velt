// Taking a connection over from HTTP: velt/http's `upgradeConnection` for a protocol of one's
// own (velt/net/http's WebSocket handshake is websocket.test.vlt's).
import { isUpgradeRequest, serve, upgradeConnection } from "../src/lib";
import { connect, connectTls, TcpStream } from "velt/net";
import { afterAll, beforeAll, describe, expect, it } from "velt/test";
import "velt/test/http";
import { TEST_CA, TEST_CERT, TEST_KEY } from "./_tls";

// The custom protocol: every line comes back in upper case; "bye" ends it.
async function shout(conn: TcpStream) {
  // Written before the handler has returned the 101: goes out right after it.
  await conn.write("READY\n");
  let pending = "";
  while (true) {
    const text = await conn.readString();
    if (text == "") {
      break;
    }
    pending += text;
    let end = pending.indexOf("\n");
    while (end >= 0) {
      const line = pending.slice(0, end);
      pending = pending.slice(end + 1);
      if (line == "bye") {
        conn.shutdown();
        conn.close();
        return;
      }
      await conn.write(line.toUpperCase() + "\n");
      end = pending.indexOf("\n");
    }
  }
  conn.close();
}

// The handler: upgrades to "shout", after checking that the connection can be taken only once
// (the error code of the second take goes to `takes`).
function shoutHandler(takes: Shared<Mutex<string[]>>): (req: Request) => Promise<Response> {
  return async (req: Request): Promise<Response> => {
    if (!isUpgradeRequest(req, "shout")) {
      return new Response(`plain ${new URL(req.url).pathname}`);
    }
    const up = upgradeConnection(req, "Shout", { "x-version": "1" });
    let second = "unexpected";
    try {
      upgradeConnection(req, "shout");
    } catch (e) {
      second = e.code;
    }
    takes.with((t) => {
      t.push(second);
    });
    spawn(shout(up.stream));
    return up.response;
  };
}

// The request, then (once the 101 has arrived, as HTTP requires) the protocol's lines. Returns
// the status line, the other header lines (sorted, without `date`) and what came after the head.
async function talk(conn: TcpStream): Promise<string[]> {
  await conn.write("GET /up HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: shout\r\n\r\n");
  let reply = "";
  while (!reply.includes("\r\n\r\n")) {
    reply += await conn.readString();
  }
  await conn.write("one\ntwo\n");
  await conn.write("three\nbye\n");
  while (true) {
    const text = await conn.readString();
    if (text == "") {
      break;
    }
    reply += text;
  }
  conn.close();
  const head = reply.slice(0, reply.indexOf("\r\n\r\n")).toLowerCase().split("\r\n");
  return [
    head[0],
    head.filter((l) => !l.startsWith("date:")).slice(1).sort().join(" | "),
    reply.slice(reply.indexOf("\r\n\r\n") + 4),
  ];
}

describe("upgradeConnection", () => {
  // `upgradeConnection`: a `serve` handler takes over its connection as a std/net stream. (Was
  // the golden std/http_upgrade.)
  const takes = shared(new Mutex<string[]>([]));
  let port = 0;
  let stop = async () => {};
  beforeAll(async () => {
    const server = await serve({ port: 0 }, shoutHandler(takes.clone()));
    port = server.port;
    stop = async () => {
      await server.shutdown();
    };
  });
  afterAll(async () => {
    await stop();
  });

  it("a handler takes over its connection", async () => {
    const got = await talk(await connect(`127.0.0.1:${port}`));
    expect(got).toEqual([
      "http/1.1 101 switching protocols",
      "connection: upgrade | upgrade: shout | x-version: 1",
      "READY\nONE\nTWO\nTHREE\n",
    ]);
    // The connection can be taken only once.
    expect(takes.with((t) => t.slice())).toEqual(["EINVAL"]);
  });

  it("the same path without the upgrade is an ordinary request", async () => {
    const r = await fetch(`http://127.0.0.1:${port}/up`);
    expect(await r.text()).toBe("plain /up");
  });

  it("so is one for another protocol", async () => {
    const r = await fetch(`http://127.0.0.1:${port}/other`, {
      headers: { connection: "Upgrade", upgrade: "websocket" },
    });
    expect(r).toHaveStatus(200);
    expect(await r.text()).toBe("plain /other");
  });

  it("over TLS", async () => {
    const tlsTakes = shared(new Mutex<string[]>([]));
    const secure = await serve(
      { port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } },
      shoutHandler(tlsTakes.clone()),
    );
    try {
      const got = await talk(
        await connectTls(`localhost:${secure.port}`, { ca: TEST_CA, alpn: ["http/1.1"] }),
      );
      expect(got).toEqual([
        "http/1.1 101 switching protocols",
        "connection: upgrade | upgrade: shout | x-version: 1",
        "READY\nONE\nTWO\nTHREE\n",
      ]);
      expect(tlsTakes.with((t) => t.slice())).toEqual(["EINVAL"]);
    } finally {
      await secure.shutdown();
    }
  });

  it("a request that never reached a server has nothing to take", () => {
    let error = "none";
    try {
      upgradeConnection(new Request("http://localhost/"), "shout");
    } catch (e) {
      error = `${e.code} ${e.message}`;
    }
    expect(error).toBe("EINVAL not an upgrade request (or its connection was taken already)");
  });
});
