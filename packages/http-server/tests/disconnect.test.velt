// A client that goes away while its request is being answered, on `serve` over HTTP/1.1 (HTTP/2:
// h2/standard.test.velt): the response body's source stops (its `cancel` or `finally` runs, `pull`
// stops) and `req.signal` aborts. A client that only shut its sending side, or reads slowly, is
// not gone. Each test waits for what the server does; the timeouts only keep a broken version
// from hanging.
import { utf8Encode } from "velt/encoding";
import { BodyStream } from "velt/net/http";
import { connect, TcpStream } from "velt/net";
import { platform } from "velt/os";
import { timeout } from "velt/task";
import { describe, expect, it } from "velt/test";
import { serve } from "../src/lib";
import { arrivals, arrive, Gate, gate, hold, open, shut } from "./_gate";

const LIMIT: i64 = 10000;

/// An endless stream of `size`-byte chunks; `cancelled` hears the source's `cancel`.
function endless(size: i64, cancelled: Gate, pulls: Shared<i64>): ReadableStream<Uint8Array> {
  const chunk = new Uint8Array(size as number);
  return new ReadableStream<Uint8Array>({
    pull: (ctl) => {
      pulls.add(1);
      ctl.enqueue(chunk.slice());
    },
    cancel: (reason) => {
      arrive(cancelled);
    },
  });
}

/// An endless generator of 1 KiB chunks; `ended` hears its `finally`.
async function* rows(ended: Gate): AsyncGenerator<u8[], never> {
  try {
    while (true) {
      yield Buffer.alloc(1024);
    }
  } finally {
    arrive(ended);
  }
}

/// A body of `a`, then `b` once `g` lets it go on; `ended` hears a `finally`, `early` whether it
/// was left before its end.
async function* twoPieces(
  a: string,
  b: string,
  g: Gate,
  early: Shared<i64>,
): AsyncGenerator<u8[], never> {
  let finished = false;
  try {
    yield utf8Encode(a);
    await hold(g);
    yield utf8Encode(b);
    finished = true;
  } finally {
    if (!finished) {
      early.set(1);
    }
  }
}

/// Reads from `s` until `text` came, or the end of the stream: what was read.
async function readUntil(s: TcpStream, text: string): Promise<string> {
  let got = "";
  while (!got.includes(text)) {
    const piece = await s.readString();
    if (piece == "") {
      break;
    }
    got += piece;
  }
  return got;
}

async function readAll(s: TcpStream): Promise<string> {
  return await readUntil(s, "\u0001never\u0001");
}

const GET = "GET / HTTP/1.1\r\nHost: x\r\n\r\n";

describe("a client that goes away during a streamed response", () => {
  it("cancels a ReadableStream, and pull stops", async () => {
    const cancelled = gate();
    const pulls = shared<i64>(0);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(endless(1024, cancelled, pulls), {
        headers: { "content-type": "text/event-stream" },
      });
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await readUntil(c, "\r\n\r\n");
      c.close();
      await timeout(arrivals(cancelled), LIMIT);
      const seen = pulls.get();
      // Every handler has returned here: one pull may have been under way, no more.
      await timeout(server.shutdown(), LIMIT);
      expect(pulls.get() - seen <= 1).toBe(true);
    } finally {
      server.close();
      shut(cancelled);
    }
  });

  it("cancels an event stream when a fetch is aborted while reading", async () => {
    const cancelled = gate();
    const pulls = shared<i64>(0);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const made = pulls.clone();
      const told = cancelled;
      return new Response(
        new ReadableStream<Uint8Array>({
          pull: async (ctl) => {
            made.add(1);
            // timing: the event stream of #2499, a chunk now and then with nothing queued
            await sleep(5);
            ctl.enqueue(Uint8Array.fromBytes(utf8Encode("data: x")));
          },
          cancel: (reason) => {
            arrive(told);
          },
        }),
        { headers: { "content-type": "text/event-stream" } },
      );
    });
    try {
      const abort = new AbortController();
      const res = await fetch(`http://127.0.0.1:${server.port}/`, { signal: abort.signal });
      const reader = res.body!.getReader();
      await reader.read();
      // Aborted while a read waits: that wait is what closes the connection of a fetch.
      const waiting = reader.read();
      abort.abort();
      try {
        await waiting;
      } catch (e) {
        // The abort.
      }
      await timeout(arrivals(cancelled), LIMIT);
    } finally {
      await server.shutdown();
      shut(cancelled);
    }
  });

  it("runs an async generator's finally, through BodyStream.from", async () => {
    const ended = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(BodyStream.from(rows(ended)));
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await readUntil(c, "\r\n\r\n");
      c.close();
      await timeout(arrivals(ended), LIMIT);
    } finally {
      await server.shutdown();
      shut(ended);
    }
  });

  it("survives a cancel that throws, and serves the next request", async () => {
    const cancelled = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      if (new URL(req.url).pathname == "/next") {
        return new Response("next");
      }
      return new Response(
        new ReadableStream<Uint8Array>({
          pull: (ctl) => {
            ctl.enqueue(new Uint8Array(1024));
          },
          cancel: (reason) => {
            arrive(cancelled);
            throw new Error("the cancel failed");
          },
        }),
      );
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await readUntil(c, "\r\n\r\n");
      c.close();
      await timeout(arrivals(cancelled), LIMIT);
      expect(await (await fetch(`http://127.0.0.1:${server.port}/next`)).text()).toBe("next");
    } finally {
      await server.shutdown();
      shut(cancelled);
    }
  });

  it("aborts req.signal", async () => {
    const aborted = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      const watching = (async () => {
        await signal.whenAborted();
        arrive(aborted);
      })();
      return new Response(BodyStream.from(rows(gate())));
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await readUntil(c, "\r\n\r\n");
      c.close();
      await timeout(arrivals(aborted), LIMIT);
    } finally {
      server.close();
      shut(aborted);
    }
  });
});

describe("a client whose connection fails", () => {
  it("cancels a ReadableStream that has nothing to write, and aborts req.signal", async () => {
    // Closing with unread input resets the connection on Linux; other systems may send a plain
    // end of stream, which a response under way doesn't take for a client gone.
    if (platform() != "linux") {
      return;
    }
    const wrote = gate();
    const cancelled = gate();
    const aborted = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      const watching = (async () => {
        await signal.whenAborted();
        arrive(aborted);
      })();
      return new Response(
        new ReadableStream<Uint8Array>({
          start: (ctl) => {
            ctl.enqueue(new Uint8Array(1024));
            arrive(wrote);
          },
          cancel: (reason) => {
            arrive(cancelled);
          },
        }),
      );
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await timeout(arrivals(wrote), LIMIT);
      // The chunk reached the socket once the client can read its first byte; a look at it
      // would take it, so the client waits until it is readable and closes with it unread.
      await timeout(c.readable(), LIMIT);
      c.close();
      await timeout(arrivals(aborted), LIMIT);
      await timeout(arrivals(cancelled), LIMIT);
    } finally {
      await server.shutdown();
      shut(wrote);
      shut(cancelled);
      shut(aborted);
    }
  });
});

describe("a slow client", () => {
  it("holds the source back, and isn't cancelled for it", async () => {
    // timing: backpressure is pulls stopping, seen by their count not moving over a while.
    const cancelled = gate();
    const pulls = shared<i64>(0);
    const size: i64 = 65536;
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(endless(size, cancelled, pulls));
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      let last: i64 = -1;
      while (pulls.get() != last) {
        last = pulls.get();
        // timing: long enough for a pull to show, were pulls going on
        await sleep(300);
      }
      // Bounded by what the sockets hold: the source stopped, and it wasn't cancelled.
      expect(last < 2000).toBe(true);
      expect(cancelled.arrived.tryReceive()).toBe(null);
      // Reading makes it go on.
      await timeout(c.read(), LIMIT);
      let read: i64 = 0;
      while (pulls.get() == last) {
        read += (await timeout(c.read(), LIMIT)).length as i64;
      }
      expect(read > 0).toBe(true);
      expect(cancelled.arrived.tryReceive()).toBe(null);
      c.close();
      await timeout(arrivals(cancelled), LIMIT);
    } finally {
      await server.shutdown();
      shut(cancelled);
    }
  });
});

describe("a client that shuts only its sending side", () => {
  it("gets a whole streamed body", async () => {
    const g = gate();
    const early = shared<i64>(0);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(BodyStream.from(twoPieces("first", "second", g, early)));
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write("GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
      c.shutdown();
      await timeout(arrivals(g), LIMIT);
      await timeout(readUntil(c, "first"), LIMIT);
      open(g);
      const rest = await timeout(readAll(c), LIMIT);
      expect(rest.includes("second")).toBe(true);
      expect(rest.includes("0\r\n\r\n")).toBe(true);
      expect(early.get()).toBe(0);
      c.close();
    } finally {
      await server.shutdown();
      shut(g);
    }
  });

  it("gets a whole body on a request that doesn't say Connection: close", async () => {
    const g = gate();
    const early = shared<i64>(0);
    const aborted = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      if (new URL(req.url).pathname == "/other") {
        return new Response("other");
      }
      const signal = req.signal;
      const watching = (async () => {
        await signal.whenAborted();
        arrive(aborted);
      })();
      return new Response(BodyStream.from(twoPieces("first", "second", g, early)));
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await timeout(arrivals(g), LIMIT);
      await timeout(readUntil(c, "first"), LIMIT);
      c.shutdown();
      // The connection's end has reached the server by the time another request was answered.
      expect(await (await fetch(`http://127.0.0.1:${server.port}/other`)).text()).toBe("other");
      open(g);
      const rest = await timeout(readAll(c), LIMIT);
      expect(rest.includes("second")).toBe(true);
      expect(early.get()).toBe(0);
      expect(aborted.arrived.tryReceive()).toBe(null);
      c.close();
    } finally {
      await server.shutdown();
      shut(g);
      shut(aborted);
    }
  });

  it("with Connection: close, doesn't abort req.signal, and gets its answer", async () => {
    const g = gate();
    const aborted = shared<i64>(0);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      if (new URL(req.url).pathname == "/other") {
        return new Response("other");
      }
      const signal = req.signal;
      await hold(g);
      aborted.set(signal.aborted ? 1 : 0);
      return new Response("answer");
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write("GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
      await timeout(arrivals(g), LIMIT);
      c.shutdown();
      expect(await (await fetch(`http://127.0.0.1:${server.port}/other`)).text()).toBe("other");
      open(g);
      expect((await timeout(readAll(c), LIMIT)).includes("answer")).toBe(true);
      expect(aborted.get()).toBe(0);
      c.close();
    } finally {
      await server.shutdown();
      shut(g);
    }
  });

  it("answers pipelined requests, in order, without aborting req.signal", async () => {
    const g = gate();
    const aborted = shared<i64>(0);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const path = new URL(req.url).pathname;
      if (path == "/other" || path == "/second") {
        return new Response(path);
      }
      const signal = req.signal;
      await hold(g);
      aborted.set(signal.aborted ? 1 : 0);
      return new Response("/first");
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write("GET /first HTTP/1.1\r\nHost: x\r\n\r\n");
      await timeout(arrivals(g), LIMIT);
      // The second comes while the first's handler watches the connection.
      await c.write("GET /second HTTP/1.1\r\nHost: x\r\n\r\n");
      c.shutdown();
      expect(await (await fetch(`http://127.0.0.1:${server.port}/other`)).text()).toBe("/other");
      open(g);
      const all = await timeout(readAll(c), LIMIT);
      const first = all.indexOf("/first");
      expect(first >= 0).toBe(true);
      expect(all.indexOf("/second") > first).toBe(true);
      expect(aborted.get()).toBe(0);
      c.close();
    } finally {
      await server.shutdown();
      shut(g);
    }
  });
});

describe("a kept-alive connection", () => {
  it("leaves a finished body and its signal alone, and serves the next request", async () => {
    const early = shared<i64>(0);
    const aborted = gate();
    const g = gate();
    const next = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const path = new URL(req.url).pathname;
      if (path == "/second") {
        return new Response("second answer");
      }
      if (path == "/third") {
        const third = req.signal;
        arrive(next);
        await third.whenAborted();
        arrive(next);
        return new Response("nobody reads this");
      }
      const signal = req.signal;
      const watching = (async () => {
        await signal.whenAborted();
        arrive(aborted);
      })();
      return new Response(BodyStream.from(twoPieces("one", "two", g, early)));
    });
    open(g);
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write("GET /first HTTP/1.1\r\nHost: x\r\n\r\n");
      await timeout(readUntil(c, "0\r\n\r\n"), LIMIT);
      await c.write("GET /second HTTP/1.1\r\nHost: x\r\n\r\n");
      await timeout(readUntil(c, "second answer"), LIMIT);
      // A later request's client going away has nothing to do with the first one's signal.
      await c.write("GET /third HTTP/1.1\r\nHost: x\r\n\r\n");
      await timeout(arrivals(next), LIMIT);
      c.close();
      await timeout(arrivals(next), LIMIT);
      expect(aborted.arrived.tryReceive()).toBe(null);
      expect(early.get()).toBe(0);
    } finally {
      await server.shutdown();
      shut(aborted);
      shut(g);
      shut(next);
    }
  });
});

describe("a client that goes away before the response", () => {
  it("aborts req.signal for a handler still working", async () => {
    const started = gate();
    const aborted = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      arrive(started);
      await signal.whenAborted();
      arrive(aborted);
      return new Response("nobody reads this");
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await timeout(arrivals(started), LIMIT);
      c.close();
      await timeout(arrivals(aborted), LIMIT);
    } finally {
      await server.shutdown();
      shut(started);
      shut(aborted);
    }
  });

  it("aborts req.signal once the body was read", async () => {
    const started = gate();
    const aborted = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      arrive(started);
      const text = await req.text();
      arrive(started);
      await signal.whenAborted();
      arrive(aborted, text.length as i64);
      return new Response("nobody reads this");
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\n");
      // The body comes after the handler asked for the signal: the watch starts at its end.
      await timeout(arrivals(started), LIMIT);
      await c.write("hello");
      await timeout(arrivals(started), LIMIT);
      c.close();
      await timeout(arrivals(aborted), LIMIT);
    } finally {
      await server.shutdown();
      shut(started);
      shut(aborted);
    }
  });

  it("aborts req.signal when the body is cut off", async () => {
    const aborted = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      try {
        await req.text();
      } catch (e) {
        arrive(aborted, signal.aborted ? 1 : 0);
      }
      return new Response("nobody reads this");
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write("POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\n\r\nhe");
      c.close();
      expect(await timeout(aborted.arrived.receive(), LIMIT)).toBe(1);
    } finally {
      await server.shutdown();
      shut(aborted);
    }
  });

  it("lets a handler ignoring its signal finish, and writes go nowhere", async () => {
    const g = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      if (new URL(req.url).pathname == "/next") {
        return new Response("next");
      }
      const signal = req.signal;
      await hold(g);
      return new Response(BodyStream.from(twoPieces("late", "later", gate(), shared<i64>(0))));
    });
    try {
      const c = await connect(`127.0.0.1:${server.port}`);
      await c.write(GET);
      await timeout(arrivals(g), LIMIT);
      c.close();
      open(g);
      expect(await (await fetch(`http://127.0.0.1:${server.port}/next`)).text()).toBe("next");
    } finally {
      server.close();
      shut(g);
    }
  });
});

describe("shutting down with an open stream", () => {
  it("aborts req.signal, so a source that listens ends, and resolves", async () => {
    const started = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      const source = async function* (): AsyncGenerator<u8[], never> {
        yield utf8Encode("first");
        arrive(started);
        await signal.whenAborted();
      };
      return new Response(BodyStream.from(source()));
    });
    const c = await connect(`127.0.0.1:${server.port}`);
    try {
      await c.write(GET);
      await timeout(arrivals(started), LIMIT);
      await timeout(server.shutdown(), LIMIT);
      const all = await timeout(readAll(c), LIMIT);
      expect(all.includes("first")).toBe(true);
    } finally {
      c.close();
      shut(started);
    }
  });
});
