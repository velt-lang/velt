// A response `fetch` returned, passed on by a handler (#2077), over HTTP/1.1 and HTTP/2: a body
// that arrived decoded goes out without the coding's length, and the fields about the connection
// the response came over stay behind.
import { serve } from "../src/lib";
import { afterAll, beforeAll, describe, expect, it } from "velt/test";
import { TEST_CA, TEST_CERT, TEST_KEY } from "./_tls";

// "a" 1,000 times and "hello", gzipped (Node's `zlib`): the first is longer decoded than encoded,
// the second shorter.
function gzipped(name: string): u8[] {
  if (name == "/many") {
    const many: u8[] = [31, 139, 8, 0, 0, 0, 0, 0, 0, 10, 75, 76, 28, 5, 163, 96, 20, 12, 119, 0];
    many.push(0, 3, 218, 56, 154, 232, 3, 0, 0);
    return many;
  }
  const hello: u8[] = [31, 139, 8, 0, 0, 0, 0, 0, 0, 10, 203, 72, 205, 201, 201, 7, 0, 134, 166];
  hello.push(16, 54, 5, 0, 0, 0);
  return hello;
}

for (const protocol of ["HTTP/1.1", "HTTP/2"]) {
  describe(`a fetched response passed on over ${protocol}`, () => {
    let origin = "";
    let base = "";
    let close = () => {};
    const h2 = protocol == "HTTP/2";
    const get = async (path: string): Promise<Response> => {
      return await fetch(`${base}${path}`, h2 ? { ca: TEST_CA } : {});
    };
    beforeAll(async () => {
      const upstream = await serve({ port: 0 }, (req: Request): Response => {
        const path = new URL(req.url).pathname;
        if (path == "/plain" || path == "/plain/clone") {
          const r = new Response("abc");
          r.headers.set("connection", "X-Hop , x-other");
          r.headers.set("x-hop", "1");
          r.headers.set("x-other", "2");
          r.headers.set("keep-alive", "timeout=5");
          r.headers.set("proxy-connection", "keep-alive");
          r.headers.set("te", "trailers");
          r.headers.set("trailer", "x-t");
          r.headers.set("upgrade", "x-protocol");
          r.headers.set("x-origin", "yes");
          return r;
        }
        const r = new Response(gzipped(path.replace("/clone", "")));
        r.headers.set("content-encoding", "gzip");
        return r;
      });
      origin = `http://127.0.0.1:${upstream.port}`;
      const proxy = await serve(
        h2 ? { port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } } : { port: 0 },
        async (req: Request): Promise<Response> => {
          const path = new URL(req.url).pathname;
          if (path.startsWith("/wrapped/")) {
            const fetched = await fetch(`${origin}/many`);
            const headers = new Headers(fetched.headers);
            if (path == "/wrapped/no-coding" || path == "/wrapped/neither") {
              headers.delete("content-encoding");
            }
            if (path == "/wrapped/neither") {
              headers.delete("content-length");
            }
            return new Response(fetched.body, { headers });
          }
          const r = await fetch(`${origin}${path}`);
          if (!path.endsWith("/clone")) {
            return r;
          }
          const copy = r.clone();
          await r.text();
          return copy;
        },
      );
      base = h2 ? `https://localhost:${proxy.port}` : `http://127.0.0.1:${proxy.port}`;
      close = () => {
        proxy.close();
        upstream.close();
      };
    });
    afterAll(() => {
      close();
    });

    for (const suffix of ["", "/clone"]) {
      it(`sends a body longer decoded than encoded, whole${suffix}`, async () => {
        const r = await get(`/many${suffix}`);
        expect(r.status).toBe(200);
        expect(await r.text()).toBe("a".repeat(1000));
        expect(r.headers.get("content-encoding")).toBe(null);
        expect(r.headers.get("content-length")).toBe(null);
      });

      it(`sends a body shorter decoded than encoded, whole${suffix}`, async () => {
        const r = await get(`/hello${suffix}`);
        expect(await r.text()).toBe("hello");
        expect(r.headers.get("content-length")).toBe(null);
      });

      it(`leaves the fields about the connection it came over${suffix}`, async () => {
        const r = await get(`/plain${suffix}`);
        expect(await r.text()).toBe("abc");
        expect(r.headers.get("x-origin")).toBe("yes");
        expect(r.headers.get("keep-alive")).toBe(null);
        expect(r.headers.get("proxy-connection")).toBe(null);
        expect(r.headers.get("te")).toBe(null);
        expect(r.headers.get("trailer")).toBe(null);
        expect(r.headers.get("upgrade")).toBe(null);
        // Its own `connection`, and the fields it named, in any case and with spaces.
        expect((r.headers.get("connection") ?? "").toLowerCase().includes("x-hop")).toBe(false);
        expect(r.headers.get("x-hop")).toBe(null);
        expect(r.headers.get("x-other")).toBe(null);
        // One date, this server's: an HTTP-date has one "GMT".
        expect(r.headers.get("date")!.split("GMT").length).toBe(2);
      });
    }

    // What a client gets of `path`: "cut off" for a response that failed.
    const outcome = async (path: string): Promise<string> => {
      try {
        const r = await get(path);
        return `${r.status} ${await r.text()}`;
      } catch (e) {
        return "cut off";
      }
    };

    it("cuts a fetched body off in a new response that keeps the fetched fields", async () => {
      expect(await outcome("/wrapped/fetched")).toBe("cut off");
      // Without the coding the client doesn't decode: it is the length that cuts it off.
      expect(await outcome("/wrapped/no-coding")).toBe("cut off");
    });

    it("sends a fetched body whole in a new response without those fields", async () => {
      expect(await outcome("/wrapped/neither")).toBe(`200 ${"a".repeat(1000)}`);
    });

    it("keeps a body's length when it wasn't decoded", async () => {
      const r = await get("/plain");
      expect(r.headers.get("content-length")).toBe("3");
      expect(await r.text()).toBe("abc");
    });

    it("leaves the fetched response's own headers as they came", async () => {
      const r = await fetch(`${origin}/hello`);
      expect(r.headers.get("content-encoding")).toBe("gzip");
      expect(r.headers.get("content-length")).toBe("25");
      expect(await r.text()).toBe("hello");
    });
  });
}
