// A handler whose client hangs up while it waits runs to its end, so what it holds is given
// back: it used to be cancelled at its next `await`, which leaked a database pool's connection
// (with `max: 1`, every later request then hung). The handler here stands in for one holding a
// pooled connection across an `await`.
import { serve } from "../src/lib";
import { connect } from "velt/net";
import { timeout } from "velt/task";
import { describe, expect, it } from "velt/test";
import { arrivals, arrive, gate, shut } from "./_gate";

describe("a client that hangs up", () => {
  it("lets the handler it left finish", async () => {
    const started = gate();
    const finished = gate();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      if (new URL(req.url).pathname == "/slow") {
        arrive(started);
        // Its work, during which the client hangs up.
        // timing: the slow handler is what the hang-up leaves running
        await sleep(200);
        arrive(finished);
      }
      return new Response("ok");
    });
    const addr = `127.0.0.1:${server.port}`;
    try {
      const s = await connect(addr);
      await s.write("GET /slow HTTP/1.1\r\nHost: x\r\n\r\n");
      // Hang up once the handler runs.
      await timeout(arrivals(started), 5000);
      s.close();
      // The abandoned handler gets to its end (a cancelled one never would).
      await timeout(arrivals(finished), 5000);
      expect(await (await fetch(`http://${addr}/fast`)).text()).toBe("ok");
    } finally {
      await server.shutdown();
      shut(started);
      shut(finished);
    }
  });
});
