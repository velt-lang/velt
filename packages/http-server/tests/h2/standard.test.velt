// velt/net/http's web-standard `serve` over HTTP/2: the handler's `Request` reads the stream's
// method, URL and headers (a field sent several times joined with ", ", as `Headers.get` reads
// it), and the `Response` it returns becomes the stream's HEADERS and DATA.
import { serve } from "../../src/lib";
import { utf8Encode } from "velt/encoding";
import { BodyStream } from "velt/net/http";
import { channel } from "velt/sync";
import { timeout } from "velt/task";
import { describe, expect, it } from "velt/test";
import { Client, endOf } from "./_h2";

describe("serve over HTTP/2", () => {
  it("aborts the handler's req.signal when the client resets its stream", async () => {
    // #2074: the stream's reset reaches the web-standard `Request` as in Deno and Bun.
    const seen = channel<string>();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      await seen.send("started");
      await signal.whenAborted();
      await seen.send(`aborted ${signal.aborted}`);
      return new Response("late");
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/wait");
      await c.flush();
      expect(await timeout(seen.receive(), 5000)).toBe("started");
      // RST_STREAM (type 3) with CANCEL (8).
      c.frame(3, 0, 1, [0, 0, 0, 8]);
      await c.flush();
      expect(await timeout(seen.receive(), 5000)).toBe("aborted true");
    } finally {
      c.close();
      server.close();
    }
  });

  it("gives the handler the stream's request as a Request", async () => {
    const server = await serve({ port: 0 }, (req: Request): Response => {
      const h = req.headers;
      return new Response(`${req.method} ${req.url} ${h.get("x-two")} ${h.get("host")}`);
    });
    const c = await Client.open(server.port);
    try {
      c.headers(
        1,
        [
          ":method",
          "GET",
          ":scheme",
          "http",
          ":path",
          "/p?q=1",
          ":authority",
          "ex.com",
          "x-two",
          "a",
          "x-two",
          "b",
        ],
        true,
      );
      await c.flush();
      expect(await c.until(endOf(1))).toBe(
        "HEADERS 1 :status=200\nDATA 1 es 35:GET http://ex.com/p?q=1 a, b ex.com",
      );
    } finally {
      c.close();
      server.close();
    }
  });

  it("reads split cookie fields as one cookie header, iterated first or not", async () => {
    // RFC 9113 §8.2.3: joined with "; ", in `headers` iteration as in `get`.
    const server = await serve({ port: 0 }, (req: Request): Response => {
      const seen: string[] = [];
      for (const [name, value] of req.headers) {
        if (name == "cookie") {
          seen.push(value);
        }
      }
      return new Response(`${seen.join("|")} / ${req.headers.get("cookie")}`);
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/", ["cookie", "a=1", "x", "y", "cookie", "b=2"]);
      await c.flush();
      expect(await c.until(endOf(1))).toBe(
        "HEADERS 1 :status=200\nDATA 1 es 19:a=1; b=2 / a=1; b=2",
      );
    } finally {
      c.close();
      server.close();
    }
  });
});

describe("a client that resets a streamed Response over HTTP/2", () => {
  it("cancels the ReadableStream, and the connection's other streams go on", async () => {
    const seen = channel<string>();
    const pulled = channel<string>(1);
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      if (new URL(req.url).pathname == "/other") {
        return new Response("other");
      }
      return new Response(
        new ReadableStream<Uint8Array>({
          // One chunk, so that the window of the connection has room for the other stream.
          pull: (ctl) => {
            if (pulled.trySend("pulled")) {
              ctl.enqueue(new Uint8Array(1024));
            }
          },
          cancel: (reason) => {
            seen.trySend("cancelled");
          },
        }),
      );
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/stream");
      await c.flush();
      await timeout(pulled.receive(), 5000);
      // RST_STREAM (type 3) with CANCEL (8).
      c.frame(3, 0, 1, [0, 0, 0, 8]);
      await c.flush();
      expect(await timeout(seen.receive(), 5000)).toBe("cancelled");
      c.get(3, "/other");
      await c.flush();
      const frames = await c.until(endOf(3));
      expect(frames.includes("DATA 3 es 5:other")).toBe(true);
    } finally {
      c.close();
      await server.shutdown();
    }
  });

  it("cancels a ReadableStream with nothing to send", async () => {
    const seen = channel<string>();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(
        new ReadableStream<Uint8Array>({
          start: (ctl) => {
            seen.trySend("started");
          },
          cancel: (reason) => {
            seen.trySend("cancelled");
          },
        }),
      );
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/quiet");
      await c.flush();
      expect(await timeout(seen.receive(), 5000)).toBe("started");
      c.frame(3, 0, 1, [0, 0, 0, 8]);
      await c.flush();
      expect(await timeout(seen.receive(), 5000)).toBe("cancelled");
    } finally {
      c.close();
      await server.shutdown();
    }
  });

  it("cancels a body that starts after the stream was reset", async () => {
    const started = channel<string>();
    const seen = channel<string>();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      await started.send("started");
      await signal.whenAborted();
      return new Response(
        new ReadableStream<Uint8Array>({
          cancel: (reason) => {
            seen.trySend("cancelled");
          },
        }),
      );
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/quiet");
      await c.flush();
      expect(await timeout(started.receive(), 5000)).toBe("started");
      c.frame(3, 0, 1, [0, 0, 0, 8]);
      await c.flush();
      expect(await timeout(seen.receive(), 5000)).toBe("cancelled");
      c.close();
      await timeout(server.shutdown(), 5000);
    } finally {
      c.close();
      server.close();
    }
  });

  it("cancels a body with a length that starts after the connection ended", async () => {
    const started = channel<string>();
    const seen = channel<string>();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const signal = req.signal;
      await started.send("started");
      await signal.whenAborted();
      return new Response(
        new ReadableStream<Uint8Array>({
          cancel: (reason) => {
            seen.trySend("cancelled");
          },
        }),
        { headers: { "content-length": "5" } },
      );
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/quiet");
      await c.flush();
      expect(await timeout(started.receive(), 5000)).toBe("started");
      c.close();
      expect(await timeout(seen.receive(), 5000)).toBe("cancelled");
      await timeout(server.shutdown(), 5000);
    } finally {
      server.close();
    }
  });

  it("echoes the request's body as the response's", async () => {
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(req.body);
    });
    const c = await Client.open(server.port);
    try {
      c.headers(1, [":method", "POST", ":scheme", "http", ":path", "/", ":authority", "x"], false);
      c.frame(0, 1, 1, utf8Encode("hello"));
      await c.flush();
      expect((await timeout(c.until(endOf(1)), 5000)).includes("hello")).toBe(true);
      c.close();
      await timeout(server.shutdown(), 5000);
    } finally {
      c.close();
      server.close();
    }
  });

  it("ends an async generator when the connection closes", async () => {
    const seen = channel<string>();
    const started = channel<string>();
    async function* rows(): AsyncGenerator<u8[], never> {
      try {
        while (true) {
          started.trySend("started");
          yield utf8Encode("row");
        }
      } finally {
        seen.trySend("ended");
      }
    }
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      return new Response(BodyStream.from(rows()));
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/stream");
      await c.flush();
      await timeout(started.receive(), 5000);
      c.close();
      expect(await timeout(seen.receive(), 5000)).toBe("ended");
    } finally {
      await server.shutdown();
    }
  });
});

describe("a streamed Response with a Content-Length over HTTP/2", () => {
  // #2077: the head carries the handler's content-length; a body that ends short of it resets
  // the stream, so the client doesn't take the bytes so far for the whole body.
  async function* pieces(): AsyncGenerator<u8[]> {
    yield utf8Encode("one ");
    yield utf8Encode("two");
  }
  async function exchange(length: string): Promise<string> {
    const server = await serve({ port: 0 }, (req: Request): Response => {
      return new Response(BodyStream.from(pieces()), {
        headers: { "content-type": "text/plain", "content-length": length },
      });
    });
    const c = await Client.open(server.port);
    try {
      c.get(1, "/");
      await c.flush();
      let head = "";
      const frames = await c.until((f) => {
        if (f.type == 1) {
          head = c.fields(f).replace(/date: [^\n]*\n/, "").replaceAll("\n", " ");
        }
        return (f.type == 0 && (f.flags & 1) == 1) || f.type == 3;
      });
      return `${head} | ${frames.replaceAll("\n", " / ")}`;
    } finally {
      c.close();
      server.close();
    }
  }

  it("sends its length in the head", async () => {
    expect(await exchange("7")).toBe(
      ":status: 200 server: Velt content-length: 7 content-type: text/plain | " +
        "HEADERS 1 :status=200 / DATA 1 4:one  / DATA 1 3:two / DATA 1 es 0:",
    );
  });

  it("resets the stream when the body ends short of its length", async () => {
    const got = await exchange("10");
    expect(got.endsWith("RST 1 INTERNAL_ERROR")).toBe(true);
  });
});
