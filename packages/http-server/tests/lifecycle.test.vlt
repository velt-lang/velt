// A velt/http server's life: serving again after `close()`, a `serve` that fails, and what
// happens to the handler it was given.
import { HttpRequest, HttpResponse, serve, serveHttp } from "../src/lib";
import { connect, listen, TcpStream } from "velt/net";
import { timeout } from "velt/task";
import { describe, expect, it } from "velt/test";
import { delay } from "velt/time";
import { TEST_CERT } from "./_tls";

async function hello(req: Request): Promise<Response> {
  return new Response("hello");
}

// A port nothing listens on any more: one a server had until `close()`.
async function freedPort(): Promise<number> {
  const first = await serve({ port: 0 }, hello);
  const port = first.port;
  first.close();
  return port;
}

describe("serving after close", () => {
  // `close()` stops the accept loop asynchronously, yet serving or listening on the same port
  // right after works (#1020); and a fetch whose pooled keep-alive connection went to a server
  // that shut down is sent again on a new connection. (Was the golden std/http_serve_after_close.)
  it("serves again on the same port right after close()", async () => {
    const port = await freedPort();
    let served = 0;
    for (let i = 0; i < 20; i++) {
      const again = await serve({ port: port }, hello);
      if (again.port == port) {
        served++;
      }
      again.close();
    }
    expect(served).toBe(20);
  });

  it("listens on the port of a server closed just before", async () => {
    const port = await freedPort();
    let listened = 0;
    for (let i = 0; i < 20; i++) {
      const s = await serve({ port: port }, hello);
      s.close();
      const l = await listen(`127.0.0.1:${port}`);
      if (l.port == port) {
        listened++;
      }
      l.close();
    }
    expect(listened).toBe(20);
  });

  it("sends a fetch again when its pooled connection went to a server that shut down", async () => {
    const port = await freedPort();
    const a = await serve({ port: port }, hello);
    expect(await (await fetch(`http://127.0.0.1:${port}/`)).text()).toBe("hello");
    await a.shutdown();
    const b = await serve({ port: port }, hello);
    try {
      expect(await (await fetch(`http://127.0.0.1:${port}/`)).text()).toBe("hello");
    } finally {
      await b.shutdown();
    }
  });
});

// Counts its releases in `released`. (A handler runs on several threads at once, so a resource
// it captures needs a `clone()`: each request gets its own copy.)
class Store {
  name: string;
  released: shared<i64>;

  constructor(name: string, released: shared<i64>) {
    this.name = name;
    this.released = released;
  }

  clone(): Store {
    return new Store(`${this.name} copy`, this.released.clone());
  }

  [Symbol.dispose]() {
    this.released.add(1);
  }
}

describe("a serve that fails", () => {
  // A `serve` that fails (a TLS key that does not parse, an address already in use) drops the
  // handler closure it was given, so a captured resource's [Symbol.dispose]() runs, before the
  // failure reaches the caller. The TLS failure used to leak the closure environment. (Was the
  // golden std/http_serve_failure_releases_handler.)
  it(
    "with a TLS key that does not parse rejects with EINVAL and releases the handler",
    async () => {
      const released = shared<i64>(0);
      const tlsStore = new Store("tls", released.clone());
      let code = "";
      try {
        const bad = await serve(
          { port: 0, tls: { cert: TEST_CERT, key: "nope" } },
          async (req: Request): Promise<Response> => new Response(tlsStore.name),
        );
        bad.close();
      } catch (e) {
        code = e.code;
        expect(released.get()).toBe(1);
      }
      expect(code).toBe("EINVAL");
      expect(released.get()).toBe(1);
    },
  );

  it("on an address in use rejects with EADDRINUSE and releases the handler", async () => {
    const server = await serve(
      { port: 0 },
      async (req: Request): Promise<Response> => new Response("first"),
    );
    const released = shared<i64>(0);
    const busyStore = new Store("busy", released.clone());
    let code = "";
    try {
      const twice = await serve(
        { port: server.port },
        async (req: Request): Promise<Response> => new Response(busyStore.name),
      );
      twice.close();
    } catch (e) {
      code = e.code;
      expect(released.get()).toBe(1);
    } finally {
      await server.shutdown();
    }
    expect(code).toBe("EADDRINUSE");
    expect(released.get()).toBe(1);
  });
});

// What `c` sends until it closes, or until it has sent `until`.
async function readUntil(c: TcpStream, until: string | null = null): Promise<string> {
  let got = "";
  while (until == null || !got.includes(until)) {
    const more = await c.read();
    if (more.length == 0) {
      break;
    }
    got += more.utf8Slice(0, more.length);
  }
  return got;
}

// Counts the drops of the value itself, not of the copies each request gets (`clone()`).
class Owner {
  name: string = "kept";
  released: shared<i64>;
  original: bool = true;

  constructor(released: shared<i64>) {
    this.released = released;
  }

  clone(): Owner {
    const copy = new Owner(this.released.clone());
    copy.original = false;
    return copy;
  }

  [Symbol.dispose]() {
    if (this.original) {
      this.released.add(1);
    }
  }
}

describe("shutdown", () => {
  // `shutdown()` lets a request in flight finish, closes an idle keep-alive connection instead
  // of waiting for its client, and resolves once the handler, with what it captured, was
  // dropped. (Was the runtime test shutdown_waits_for_requests_then_releases_the_handler.)
  it(
    "waits for requests in flight, closes idle connections, then releases the handler",
    async () => {
      const released = shared<i64>(0);
      const started = shared<i64>(0);
      const finished = shared<i64>(0);
      const store = new Owner(released.clone());
      const server = await serveHttp({ port: 0 }, async (req: HttpRequest, res: HttpResponse) => {
        if (req.pathIs("/slow")) {
          started.set(1);
          await delay(300);
          finished.set(1);
        }
        res.send(store.name);
      });
      const port = server.port;
      // A keep-alive connection, idle after its answer: the client never closes it.
      const idle = await connect(`127.0.0.1:${port}`);
      await idle.write("GET /x HTTP/1.1\r\nHost: x\r\n\r\n");
      expect((await readUntil(idle, "kept")).startsWith("HTTP/1.1 200")).toBe(true);
      // A request in flight when shutdown starts.
      const busy = await connect(`127.0.0.1:${port}`);
      await busy.write("GET /slow HTTP/1.1\r\nHost: x\r\n\r\n");
      for (let i = 0; i < 1000 && started.get() == 0; i++) {
        await delay(5);
      }
      expect(started.get()).toBe(1);
      expect(released.get()).toBe(0);
      await timeout(server.shutdown(), 10000);
      expect(finished.get()).toBe(1);
      expect(released.get()).toBe(1);
      const answer = await timeout(readUntil(busy), 5000);
      expect(answer.startsWith("HTTP/1.1 200")).toBe(true);
      expect(answer.includes("kept")).toBe(true);
      // The idle connection was closed by the server.
      expect(await timeout(readUntil(idle), 5000)).toBe("");
      idle.close();
      busy.close();
    },
  );
});
