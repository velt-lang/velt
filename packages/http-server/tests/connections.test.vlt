// What a server does with its connections: TLS, time limits, and many connecting at once.
import { serve } from "../src/lib";
import { HttpRequest, HttpResponse, serveHttp } from "../src/lib";
import { IoError } from "velt/io";
import { connect, connectTls, TcpStream } from "velt/net";
import { platform } from "velt/os";
import { timeout } from "velt/task";
import { describe, expect, it } from "velt/test";
import { arrivals, gate, hold, open, shut } from "./_gate";
import { delay } from "velt/time";
import { TEST_CA, TEST_CERT, TEST_KEY } from "./_tls";

async function readAll(conn: TcpStream): Promise<string> {
  let out = "";
  while (true) {
    const text = await conn.readString();
    if (text == "") {
      return out;
    }
    out += text;
  }
}

describe("velt/net/http over TLS", () => {
  // velt/net/http over TLS (`tls` in the options): requests, a request body, pipelining and a
  // streamed response, as over plain TCP. (Was the golden std/http_server_tls.)
  it("answers pipelined requests, a body and a stream", async () => {
    const server = await serveHttp({ port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } }, async (
      req: HttpRequest,
      res: HttpResponse,
    ) => {
      if (req.pathIs("/echo")) {
        const body = await req.bodyText();
        res.send(`got ${body}`);
      } else if (req.pathIs("/stream")) {
        const s = await res.stream();
        await s.write("a");
        await s.write("b");
        await s.end();
      } else {
        res.send(`hello ${req.path()}`);
      }
    });
    try {
      const c = await connectTls(`localhost:${server.port}`, { ca: TEST_CA });
      await c.write(
        "GET /x HTTP/1.1\r\nHost: x\r\n\r\n" +
          "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\n\r\nping" +
          "GET /stream HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
      );
      const text = await readAll(c);
      c.close();
      expect(text.replace(/Date: [^\r]*\r\n/g, "").replaceAll("\r\n", "|")).toBe(
        "HTTP/1.1 200 OK|Server: Velt|Content-Type: text/plain; charset=utf-8|Content-Length: 8||hello /x" +
          "HTTP/1.1 200 OK|Server: Velt|Content-Type: text/plain; charset=utf-8|Content-Length: 8||got ping" +
          "HTTP/1.1 200 OK|Server: Velt|Content-Type: text/plain; charset=utf-8|Transfer-Encoding: chunked|Connection: close||1|a|1|b|0||",
      );
    } finally {
      server.close();
    }
  });
});

// Sends `raw`, reads until the server closes; the status lines of what came back.
async function exchange(port: number, raw: string): Promise<string> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.write(raw);
  const all = await readAll(c);
  c.close();
  return (all.match(/HTTP\/1\.1 \d\d\d [A-Za-z ]+/g) ?? []).join(" | ");
}

describe("velt/net/http's time limits", () => {
  // A head not complete by `headersTimeout` (counted from its first byte, however the rest
  // trickles in), or a body that does not arrive by `requestTimeout`, gets 408 and the connection
  // closes, while the idle timeout (longer here) would have waited. (Was the golden
  // std/http_server_timeouts.)
  async function withServer(run: (port: number) => Promise<void>) {
    const server = await serveHttp(
      { port: 0, idleTimeout: 30000, headersTimeout: 200, requestTimeout: 200 },
      async (req: HttpRequest, res: HttpResponse) => {
        const body = await req.bodyText();
        res.send(`got ${body.length}`);
      },
    );
    try {
      await run(server.port);
    } finally {
      server.close();
    }
  }

  it("a complete request is answered; then a head that never ends gets 408", async () => {
    await withServer(async (port: number) => {
      expect(
        await exchange(port, "GET / HTTP/1.1\r\nHost: x\r\n\r\nGET / HTTP/1.1\r\nHost: x\r\n"),
      ).toBe("HTTP/1.1 200 OK | HTTP/1.1 408 Request Timeout");
    });
  });

  it("a body of 10 bytes of which 2 arrive gets 408", async () => {
    await withServer(async (port: number) => {
      expect(
        await exchange(port, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\nab"),
      ).toBe("HTTP/1.1 408 Request Timeout");
    });
  });
});

async function ask(port: number, i: i64): Promise<bool> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.write(`GET /${i} HTTP/1.1\r\nhost: x\r\nconnection: close\r\n\r\n`);
  const reply = await readAll(c);
  c.close();
  return reply.endsWith(`hello ${i}`);
}

describe("a burst of connects", () => {
  // A burst of connects at once is queued, not refused (#1019): requests start together, each on
  // its own connection, and all are answered. 256 on Linux and Windows (Windows caps an explicit
  // backlog at 200); 100 on macOS, whose kernel caps every listen queue at kern.ipc.somaxconn
  // (128 by default) and resets a queued connection when it overflows. (Was the golden
  // std/http_connect_burst.)
  it("is queued, not refused: all are answered", async () => {
    const server = await serve(
      { port: 0 },
      async (req: Request): Promise<Response> => new Response(
        `hello ${new URL(req.url).pathname.slice(1)}`,
      ),
    );
    try {
      const n: i64 = platform() == "darwin" ? 100 : 256;
      const asks: Promise<bool, IoError>[] = [];
      for (let i = 0; i < n; i++) {
        asks.push(spawn(ask(server.port, i)));
      }
      let ok: i64 = 0;
      for (const r of await Promise.all(asks)) {
        if (r) {
          ok++;
        }
      }
      expect(ok).toBe(n);
    } finally {
      await server.shutdown();
    }
  });
});

describe("velt/net/http's idle timeout", () => {
  // A kept-alive connection closes after `idleTimeout` without a request, counted from the end
  // of the last one; one with a request in flight is not idle, however long that request takes.
  it("closes a connection idle for idleTimeout, and not one kept busy", async () => {
    const g = gate();
    const server = await serveHttp({ port: 0, idleTimeout: 300 }, async (
      req: HttpRequest,
      res: HttpResponse,
    ) => {
      if (req.pathIs("/held")) {
        await hold(g);
      }
      res.send("ok");
    });
    const c = await connect(`127.0.0.1:${server.port}`);
    try {
      // Busy: a request held for three times the timeout, however long that really takes; it
      // is answered on the same connection.
      await c.write("GET /held HTTP/1.1\r\nHost: x\r\n\r\n");
      await timeout(arrivals(g), 5000);
      // timing: the idle timeout is the subject; a request stays in flight past it.
      await delay(900);
      open(g);
      expect((await timeout(c.readString(), 5000)).startsWith("HTTP/1.1 200")).toBe(true);
      // And the next one too, sent at once. The connection is idle from the end of its
      // response, which comes after this moment however late this side runs: so it closes at
      // least idleTimeout after it (less the timer granularity, about 15 ms on Windows).
      const idleFrom = Date.now();
      await c.write("GET / HTTP/1.1\r\nHost: x\r\n\r\n");
      expect((await timeout(c.readString(), 5000)).startsWith("HTTP/1.1 200")).toBe(true);
      // Then idle: closed, and no sooner than the timeout.
      expect(await timeout(readAll(c), 10000)).toBe("");
      expect(Date.now() - idleFrom >= 280).toBe(true);
    } finally {
      c.close();
      server.close();
      shut(g);
    }
  });
});
