import type { Package } from "velt/package";

export const pkg: Package = {
  name: "http-server",
  version: "0.1.0",
  description: "An HTTP/1.1 and HTTP/2 server written in Velt, with web-standard handlers",
  // `serve` takes its requests from a JS host's queue on a `velt build --host` build whose host
  // package has the condition `workers` (host-cloudflare); natively, from its own TCP listener.
  imports: { "#standard": { workers: "./src/hosted/standard.vlt", default: "./src/standard.vlt" } },
};
