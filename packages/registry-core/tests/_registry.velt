// The registry over in-memory stores, and requests to it, for the registry tests.
import { utf8Decode, utf8Encode } from "velt/encoding";
import { expect } from "velt/test";
import {
  ArchiveEntry,
  contentChecksum,
  MemoryBlobStore,
  MemoryMetadataDb,
  MemoryNameReservations,
  PackageChange,
  packArchive,
  RecordingCachePurge,
  Registry,
  RegistryLimits,
  RegistryStores,
  TokenAuth,
  tokenHash,
} from "../src/lib";

/** A registry and its stores. */
export class TestRegistry {
  auth: TokenAuth = new TokenAuth();
  db: MemoryMetadataDb;
  blobs: MemoryBlobStore;
  purge: RecordingCachePurge;
  registry: Registry;

  constructor(
    limits: RegistryLimits = new RegistryLimits(),
    db: MemoryMetadataDb = new MemoryMetadataDb(),
    blobs: MemoryBlobStore = new MemoryBlobStore(),
    purge: RecordingCachePurge = new RecordingCachePurge(),
    reserved: MemoryNameReservations | null = null,
  ) {
    this.db = db;
    this.blobs = blobs;
    this.purge = purge;
    const stores: RegistryStores = {
      blobs: this.blobs,
      db: this.db,
      purge: this.purge,
      auth: this.auth,
    };
    // A struct never changes: one with the reservations is a new value.
    this.registry = new Registry(reserved == null ? stores : { ...stores, reserved }, limits);
  }

  /** Package `name`'s owners ([] when it was never published). */
  async owners(name: string): Promise<string[]> {
    return (await this.db.record(name))?.owners ?? [];
  }

  /** Makes `owners` package `name`'s owners, as an administrator does. */
  async setOwners(name: string, owners: string[]): Promise<void> {
    const record = await this.db.record(name);
    if (record == null) {
      throw new Error(`no package ${name}`);
    }
    const change = new PackageChange(name, record.revision, record.index);
    change.owners = owners;
    expect(await this.db.commit(change)).toBe(true);
  }

  /** Adds user `name`; returns the user's token. */
  user(name: string): string {
    const token = `token-of-${name}`;
    this.auth.setUser(name, tokenHash(token));
    return token;
  }

  /** `method` `path` (after `/api/v1/`) as the user with `token` ("" none), with `body`. */
  async call(
    method: string,
    path: string,
    token: string = "",
    body: u8[] | null = null,
  ): Promise<Answer> {
    const headers: [string, string][] = [];
    if (token.length > 0) {
      headers.push(["authorization", `Bearer ${token}`]);
    }
    return await this.send(method, `/api/v1/${path}`, headers, body);
  }

  /** Publishes the archive `body` as `name` `version` with checksum header `sum`. */
  async upload(
    name: string,
    version: string,
    body: u8[],
    sum: string,
    token: string = "",
  ): Promise<Answer> {
    const headers: [string, string][] = [];
    headers.push(["x-velt-checksum", sum]);
    if (token.length > 0) {
      headers.push(["authorization", `Bearer ${token}`]);
    }
    return await this.send("PUT", `/api/v1/${name}/${version}`, headers, body);
  }

  /** Publishes a package `name` `version` whose manifest has `fields` after them. */
  async publish(
    name: string,
    version: string,
    token: string = "",
    fields: string = "",
  ): Promise<Answer> {
    const files = packageFiles(name, version, fields);
    return await this.upload(name, version, packArchive(files), contentChecksum(files), token);
  }

  /** Sends a request for `path` (from `/`). */
  async send(
    method: string,
    path: string,
    headers: [string, string][],
    body: BodyInit | null,
  ): Promise<Answer> {
    const init: RequestInit = body != null ? { method, headers, body } : { method, headers };
    const res = await this.registry.handle(new Request(`http://registry.test${path}`, init));
    const bytes = (await res.bytes()).toBytes();
    return new Answer(res.status, res.headers.get("content-type") ?? "", bytes);
  }
}

/** A response, read. */
export class Answer {
  status: i64;
  type: string;
  bytes: u8[];

  constructor(status: i64, type: string, bytes: u8[]) {
    this.status = status;
    this.type = type;
    this.bytes = bytes;
  }

  get text(): string {
    return utf8Decode(this.bytes);
  }
}

/** The entry `path` with the text `text`. */
export function file(path: string, text: string): ArchiveEntry {
  return { path, bytes: utf8Encode(text) };
}

/** A package's files: `package.velt` (with `fields` after name and version) and `src/lib.velt`. */
export function packageFiles(name: string, version: string, fields: string = ""): ArchiveEntry[] {
  const extra = fields.length > 0 ? `, ${fields}` : "";
  return [
    file(
      "package.velt",
      `export const pkg: Package = { name: "${name}", version: "${version}"${extra} };\n`,
    ),
    file("src/lib.velt", `export const V: i64 = 1; // ${version}\n`),
  ];
}

/** An archive of `entries` written in the order given (`packArchive` checks the paths). */
export function rawArchive(entries: ArchiveEntry[]): u8[] {
  let out: u8[] = utf8Encode("VELTPKG1\n");
  for (const e of entries) {
    out = [...out, ...utf8Encode(`${e.path}\n${e.bytes.length}\n`), ...e.bytes];
  }
  return out;
}
