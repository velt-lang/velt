// The registry over stores that race, fail or lose data (src/server/registry.velt, commit.velt,
// publish.velt): a write commits only from the revision it read, and is tried again from a fresh
// read when another write committed first; the index file is written after, and again while a
// newer revision landed; a failing store answers 500; and what the cache in front is told to
// forget. An upload's body is read before anything is committed, and a cache that can't be purged
// fails no write.
import { describe, expect, it } from "velt/test";
import {
  contentChecksum,
  IndexEntry,
  indexKey,
  MemoryBlobStore,
  MemoryMetadataDb,
  PackageChange,
  PackageIndex,
  packArchive,
  RecordingCachePurge,
  RegistryLimits,
  StoreError,
  tokenHash,
} from "../src/lib";
import { Answer, packageFiles, TestRegistry } from "./_registry";

// A database that lists the packages it was asked to commit, and can let another write commit
// first: `race`, when set, runs once before the next commit of its package.
class RacingDb extends MemoryMetadataDb {
  commits: string[] = [];
  race: ((db: MemoryMetadataDb) => Promise<void>) | null = null;

  override async commit(change: PackageChange): Promise<bool> {
    this.commits.push(change.name);
    const race = this.race;
    if (race != null) {
      this.race = null;
      await race(this);
    }
    return await super.commit(change);
  }
}

// A database where every write loses its race.
class LosingDb extends MemoryMetadataDb {
  tries: i64 = 0;

  override async commit(change: PackageChange): Promise<bool> {
    this.tries++;
    return false;
  }
}

// A database whose commits fail.
class FailingDb extends MemoryMetadataDb {
  override async commit(change: PackageChange): Promise<bool> {
    throw new StoreError("the database is down");
  }
}

// A database that fails with an error no adapter worded for clients.
class BrokenDb extends MemoryMetadataDb {
  override async commit(change: PackageChange): Promise<bool> {
    throw new Error("open /srv/registry/db.sqlite: permission denied");
  }
}

// A blob store that has lost every file.
class EmptyBlobs extends MemoryBlobStore {
  override async get(key: string): Promise<u8[] | null> {
    return null;
  }
}

// A blob store whose next index write runs `meanwhile` first (another write landing while this
// one writes its file), or fails when `fail` is set. With `failAfter`, its next write that stores
// its file then fails all the same, as a write whose answer timed out.
class SlowIndexBlobs extends MemoryBlobStore {
  meanwhile: (() => Promise<void>) | null = null;
  fail: bool = false;
  failAfter: bool = false;

  override async putIfTag(
    key: string,
    bytes: u8[],
    revision: i64,
    tag: string | null,
  ): Promise<bool> {
    if (this.fail) {
      this.fail = false;
      throw new StoreError("the blob store is down");
    }
    const meanwhile = this.meanwhile;
    if (meanwhile != null) {
      this.meanwhile = null;
      await meanwhile();
    }
    const stored = await super.putIfTag(key, bytes, revision, tag);
    if (stored && this.failAfter) {
      this.failAfter = false;
      throw new StoreError("the blob store timed out");
    }
    return stored;
  }
}

// A blob store where another write always lands first.
class ContendedBlobs extends MemoryBlobStore {
  override async putIfTag(
    key: string,
    bytes: u8[],
    revision: i64,
    tag: string | null,
  ): Promise<bool> {
    return false;
  }
}

// A cache that can't be purged.
class FailingPurge extends RecordingCachePurge {
  override async purge(paths: string[]): Promise<void> {
    throw new StoreError("the cache is down");
  }
}

// What `db` has for package `name`, version by version: `version` and `y` when yanked.
async function versionsOf(db: MemoryMetadataDb, name: string): Promise<string[]> {
  const record = await db.record(name);
  return (record?.index.versions ?? []).map(
    (e: IndexEntry): string => `${e.version}${e.yanked ? "y" : ""}`,
  );
}

// Publishes `name` `version` into `db` through a registry of its own, as another write would: by
// `owner`, or on an open registry when `owner` is "".
async function commitVersion(
  db: MemoryMetadataDb,
  name: string,
  version: string,
  owner: string,
  blobs: MemoryBlobStore = new MemoryBlobStore(),
): Promise<void> {
  const r = new TestRegistry(new RegistryLimits(), db, blobs);
  const token = owner.length > 0 ? r.user(owner) : "";
  expect((await r.publish(name, version, token)).status).toBe(201);
}

// An upload of `lib` 1.0.0 whose body arrives only when `finish` is called.
class SlowUpload {
  private ctl: ReadableStreamDefaultController<Uint8Array> | null = null;
  answer: Promise<Answer>;

  constructor(r: TestRegistry, token: string = "") {
    const stream = new ReadableStream<Uint8Array>({
      start: (c: ReadableStreamDefaultController<Uint8Array>): void => {
        this.ctl = c;
      },
    });
    const headers: [string, string][] = [
      ["x-velt-checksum", contentChecksum(packageFiles("lib", "1.0.0"))],
    ];
    if (token.length > 0) {
      headers.push(["authorization", `Bearer ${token}`]);
    }
    this.answer = r.send("PUT", "/api/v1/lib/1.0.0", headers, stream);
  }

  finish(): void {
    this.ctl?.enqueue(Uint8Array.fromBytes(packArchive(packageFiles("lib", "1.0.0"))));
    this.ctl?.close();
  }
}

describe("commits", () => {
  // A package of alice's, a user who owns nothing, and a database that lists commits after that.
  async function published(
    limits: RegistryLimits = new RegistryLimits(),
  ): Promise<[TestRegistry, RacingDb]> {
    const db = new RacingDb();
    const r = new TestRegistry(limits, db);
    r.user("bob");
    await r.publish("my-lib", "1.0.0", r.user("alice"));
    db.commits = [];
    return [r, db];
  }

  it("aren't tried for a request that can't write", async () => {
    const [r, db] = await published();
    for (const [method, path] of [
      ["POST", "/a/b/my-lib"],
      ["DELETE", "/x/y/my-lib"],
      ["POST", "/api/v1/my-lib"],
      ["DELETE", "/api/v1/my-lib/1.0.0"],
      ["HEAD", "/api/v1/my-lib/1.0.0"],
      ["PUT", "/api/v1/my-lib/1.0.0/native/x"],
    ]) {
      await r.send(method, path, [], null);
    }
    // No token, a token of nobody's, and a user who owns nothing.
    for (const token of ["", "not-a-token", r.user("bob")]) {
      for (const [method, path] of [
        ["PUT", "my-lib/1.0.0/yank"],
        ["DELETE", "my-lib/1.0.0/yank"],
        ["PUT", "my-lib/owners/bob"],
        ["DELETE", "my-lib/owners/alice"],
      ]) {
        const answer = await r.call(method, path, token);
        expect(answer.status == 401 || answer.status == 403).toBe(true);
      }
    }
    // The other spelling of a published package's name isn't published.
    for (const token of [r.user("bob"), r.user("alice")]) {
      for (const [method, path] of [
        ["PUT", "my_lib/1.0.0/yank"],
        ["DELETE", "my_lib/1.0.0/yank"],
        ["PUT", "my_lib/owners/bob"],
        ["DELETE", "my_lib/owners/alice"],
      ]) {
        expect((await r.call(method, path, token)).status).toBe(404);
      }
      expect((await r.publish("my_lib", "1.0.0", token)).status).toBe(400);
    }
    expect(db.commits).toEqual([]);
  });

  it("aren't tried for an archive the registry refuses", async () => {
    const limits = new RegistryLimits();
    limits.nativePackages = false;
    const [r, db] = await published(limits);
    const alice = r.user("alice");
    const files = packageFiles("my-lib", "2.0.0");
    const bad = await r.upload("my-lib", "2.0.0", packArchive(files), "sha256:00", alice);
    expect(bad.status).toBe(400);
    const other = await r.upload(
      "my-lib",
      "3.0.0",
      packArchive(files),
      contentChecksum(files),
      alice,
    );
    expect(other.status).toBe(400);
    expect(other.text).toBe("the archive is `my-lib` 2.0.0, not `my-lib` 3.0.0");
    const native = packageFiles(
      "my-lib",
      "2.0.0",
      'native: { targets: ["x86_64-unknown-linux-gnu"] }',
    );
    const refused = await r.upload(
      "my-lib",
      "2.0.0",
      packArchive(native),
      contentChecksum(native),
      alice,
    );
    expect(refused.status).toBe(400);
    expect(db.commits).toEqual([]);
  });

  it("are tried again from a fresh read when another write committed first", async () => {
    const [r, db] = await published();
    const alice = r.user("alice");
    // A publish of 1.1.0 loses to one of 1.0.1, and a yank to one of 1.0.2: neither is lost.
    db.race = async (d: MemoryMetadataDb): Promise<void> => await commitVersion(
      d,
      "my-lib",
      "1.0.1",
      "alice",
    );
    expect((await r.publish("my-lib", "1.1.0", alice)).status).toBe(201);
    db.race = async (d: MemoryMetadataDb): Promise<void> => await commitVersion(
      d,
      "my-lib",
      "1.0.2",
      "alice",
    );
    expect((await r.call("PUT", "my-lib/1.0.0/yank", alice)).status).toBe(200);
    expect(await versionsOf(db, "my-lib")).toEqual(["1.0.0y", "1.0.1", "1.1.0", "1.0.2"]);
    expect((await db.record("my-lib"))?.revision).toBe(5);
    // The index file shows them all.
    const file = (await r.call("GET", "my-lib/index")).text;
    for (const v of [`"1.0.1"`, `"1.1.0"`, `"1.0.2"`]) {
      expect(file).toContain(v);
    }
  });

  it("check the caller again after losing a race", async () => {
    for (const [method, path] of [
      ["PUT", "my-lib/1.0.0/yank"],
      ["PUT", "my-lib/owners/bob"],
    ]) {
      const [r, db] = await published();
      r.user("carol");
      await r.setOwners("my-lib", ["alice", "carol"]);
      // Carol passes the first check; the write that beats hers takes her off the owners.
      db.race = async (d: MemoryMetadataDb): Promise<void> => await r.setOwners("my-lib", [
        "alice",
      ]);
      expect((await r.call(method, path, r.user("carol"))).status).toBe(403);
      expect(await r.owners("my-lib")).toEqual(["alice"]);
      expect(await versionsOf(db, "my-lib")).toEqual(["1.0.0"]);
    }
  });

  it("publish one name's spellings once", async () => {
    const db = new RacingDb();
    const r = new TestRegistry(new RegistryLimits(), db);
    // my_pkg passes the name check; my-pkg commits before it does.
    db.race = async (d: MemoryMetadataDb): Promise<void> => await commitVersion(
      d,
      "my-pkg",
      "1.0.0",
      "alice",
    );
    const answer = await r.publish("my_pkg", "1.0.0");
    expect(answer.status).toBe(400);
    expect(answer.text).toContain("the registry has `my-pkg`");
    expect(await db.packageNames()).toEqual(["my-pkg"]);
  });

  it("give up with 503 when the package keeps changing", async () => {
    const db = new LosingDb();
    const r = new TestRegistry(new RegistryLimits(), db);
    const answer = await r.publish("lib", "1.0.0");
    expect(answer.status).toBe(503);
    expect(answer.text).toBe("`lib` is changing too often right now; try again");
    expect(db.tries).toBe(32);
  });
});

describe("first publishes of a new name at the same time", () => {
  it("commit once in the database", async () => {
    const db = new MemoryMetadataDb();
    const a = new PackageChange("lib", 0, new PackageIndex("lib"));
    const b = new PackageChange("lib", 0, new PackageIndex("lib"));
    const won = await Promise.all([db.commit(a), db.commit(b)]);
    expect(won.filter((w: bool): bool => w).length).toBe(1);
  });

  it("all count when their versions differ", async () => {
    const r = new TestRegistry();
    const answers = await Promise.all([r.publish("lib", "1.0.0"), r.publish("lib", "1.1.0")]);
    expect(answers.map((a: Answer): i64 => a.status)).toEqual([201, 201]);
    expect(await versionsOf(r.db, "lib")).toEqual(["1.0.0", "1.1.0"]);
  });

  it("publish one version once, whichever bytes win", async () => {
    const r = new TestRegistry();
    const one = packageFiles("lib", "1.0.0", `description: "one"`);
    const two = packageFiles("lib", "1.0.0", `description: "two"`);
    const answers = await Promise.all([
      r.upload("lib", "1.0.0", packArchive(one), contentChecksum(one)),
      r.upload("lib", "1.0.0", packArchive(two), contentChecksum(two)),
    ]);
    const statuses = answers.map((a: Answer): i64 => a.status).sort();
    expect(statuses).toEqual([201, 409]);
    const won = answers[0].status == 201 ? one : two;
    const record = await r.db.record("lib");
    expect(record?.index.versions[0].checksum).toBe(contentChecksum(won));
  });
});

describe("the index file", () => {
  it("is written again when a newer revision landed while it was written", async () => {
    const blobs = new SlowIndexBlobs();
    const db = new MemoryMetadataDb();
    const r = new TestRegistry(new RegistryLimits(), db, blobs);
    // While lib 1.0.0's file is written, 1.1.0 commits and its file lands first.
    blobs.meanwhile = async (): Promise<void> => {
      await commitVersion(db, "lib", "1.1.0", "");
    };
    expect((await r.publish("lib", "1.0.0")).status).toBe(201);
    const file = (await r.call("GET", "lib/index")).text;
    expect(file).toContain(`"1.1.0"`);
    expect(file).toContain(`"1.0.0"`);
  });

  it("never goes back to an older revision", async () => {
    // A yank writes its file; before its write lands, a publish of 1.1.0 runs start to finish.
    const blobs = new SlowIndexBlobs();
    const db = new MemoryMetadataDb();
    const r = new TestRegistry(new RegistryLimits(), db, blobs);
    expect((await r.publish("lib", "1.0.0")).status).toBe(201);
    // The publish writes the same store; the yank's write, were it to land, would time out after.
    blobs.meanwhile = async (): Promise<void> => {
      await commitVersion(db, "lib", "1.1.0", "", blobs);
      blobs.failAfter = true;
    };
    expect((await r.call("PUT", "lib/1.0.0/yank")).status).toBe(200);
    const file = (await r.call("GET", "lib/index")).text;
    expect(file).toContain(`"1.1.0"`);
    expect(file).toContain(`"yanked": true`);
  });

  it("never goes back when the newer index has the same bytes as the one read", async () => {
    // A yank reads the file (not yanked). An unyank commits after it and writes those same bytes
    // again: the same hash, as an R2 etag would be. The yank's write, were it to land, would time
    // out after.
    const blobs = new SlowIndexBlobs();
    const db = new MemoryMetadataDb();
    const r = new TestRegistry(new RegistryLimits(), db, blobs);
    expect((await r.publish("lib", "1.0.0")).status).toBe(201);
    blobs.meanwhile = async (): Promise<void> => {
      const other = new TestRegistry(new RegistryLimits(), db, blobs);
      expect((await other.call("DELETE", "lib/1.0.0/yank")).status).toBe(200);
      blobs.failAfter = true;
    };
    expect((await r.call("PUT", "lib/1.0.0/yank")).status).toBe(200);
    const record = await db.record("lib");
    expect(record?.index.versions[0].yanked).toBe(false);
    expect((await r.call("GET", "lib/index")).text).not.toContain(`"yanked": true`);
  });

  it("fails the write when other writes keep landing on it", async () => {
    const r = new TestRegistry(new RegistryLimits(), new MemoryMetadataDb(), new ContendedBlobs());
    const answer = await r.publish("lib", "1.0.0");
    expect(`${answer.status} ${answer.text}`).toBe(
      "500 the index of `lib` couldn't be written; try again",
    );
  });

  it("is mended by trying a write again after it failed", async () => {
    const blobs = new SlowIndexBlobs();
    const r = new TestRegistry(new RegistryLimits(), new MemoryMetadataDb(), blobs);
    expect((await r.publish("lib", "1.0.0")).status).toBe(201);
    blobs.fail = true;
    const failed = await r.publish("lib", "1.1.0");
    expect(`${failed.status} ${failed.text}`).toBe("500 the blob store is down");
    expect((await r.call("GET", "lib/index")).text).not.toContain(`"1.1.0"`);
    // The version is published; trying again writes the file.
    expect((await r.publish("lib", "1.1.0")).status).toBe(409);
    expect((await r.call("GET", "lib/index")).text).toContain(`"1.1.0"`);
    expect(await blobs.get(indexKey("lib"))).not.toBeNull();
  });
});

describe("uploads", () => {
  it("commit only once the body has arrived", async () => {
    const db = new RacingDb();
    const r = new TestRegistry(new RegistryLimits(), db);
    const slow = new SlowUpload(r);
    // Another package's publish runs start to finish while lib's body is on its way.
    expect((await r.publish("other", "1.0.0")).status).toBe(201);
    expect(db.commits).toEqual(["other"]);
    slow.finish();
    expect((await slow.answer).status).toBe(201);
    expect(db.commits).toEqual(["other", "lib"]);
  });

  it("let a package's other writes through while a body is on its way", async () => {
    const r = new TestRegistry();
    await r.publish("lib", "0.9.0");
    const slow = new SlowUpload(r);
    await r.publish("other", "1.0.0");
    expect((await r.publish("lib", "0.9.1")).status).toBe(201);
    slow.finish();
    expect((await slow.answer).status).toBe(201);
  });

  it("store nothing for a publish refused for its version", async () => {
    const r = new TestRegistry();
    expect((await r.publish("lib", "1.0.0")).status).toBe(201);
    const stored = r.blobs.size;
    const other = packageFiles("lib", "1.0.0", `description: "other bytes"`);
    const again = await r.upload("lib", "1.0.0", packArchive(other), contentChecksum(other));
    expect(again.status).toBe(409);
    expect(r.blobs.size).toBe(stored);
  });

  it("stop a token taken away while the body arrived", async () => {
    const r = new TestRegistry();
    const alice = r.user("alice");
    const slow = new SlowUpload(r, alice);
    // Past the first check by now, as below.
    await r.publish("other", "1.0.0", alice);
    r.auth.setUser("alice", tokenHash("a-new-token"));
    slow.finish();
    expect((await slow.answer).status).toBe(401);
    expect(await r.db.record("lib")).toBeNull();
  });

  it("check the caller again once the body has arrived", async () => {
    const r = new TestRegistry();
    const alice = r.user("alice");
    const slow = new SlowUpload(r, alice);
    // Past the first check by now: this publish has run through more steps than that takes.
    await r.publish("other", "1.0.0", alice);
    // Bob publishes lib first, and owns it.
    expect((await r.publish("lib", "0.9.0", r.user("bob"))).status).toBe(201);
    slow.finish();
    const answer = await slow.answer;
    expect(answer.status).toBe(403);
    expect(await versionsOf(r.db, "lib")).toEqual(["0.9.0"]);
    expect(await r.owners("lib")).toEqual(["bob"]);
  });

  it("read no body for a caller who may not publish", async () => {
    const r = new TestRegistry();
    const alice = r.user("alice");
    r.user("bob");
    await r.publish("lib", "1.0.0", alice);
    // A body that fails when read: reading it would answer 500.
    const stream = new ReadableStream<Uint8Array>({
      pull: (c: ReadableStreamDefaultController<Uint8Array>): void => {
        c.error(new Error("the body was read"));
      },
    });
    const headers: [string, string][] = [["authorization", "Bearer token-of-bob"]];
    const answer = await r.send("PUT", "/api/v1/lib/1.0.1", headers, stream);
    expect(answer.status).toBe(403);
  });

  it("read no body for another spelling of a published name", async () => {
    const r = new TestRegistry();
    r.user("bob");
    await r.publish("my-lib", "1.0.0", r.user("alice"));
    const stream = new ReadableStream<Uint8Array>({
      pull: (c: ReadableStreamDefaultController<Uint8Array>): void => {
        c.error(new Error("the body was read"));
      },
    });
    const headers: [string, string][] = [["authorization", "Bearer token-of-bob"]];
    const answer = await r.send("PUT", "/api/v1/my_lib/1.0.0", headers, stream);
    expect(answer.status).toBe(400);
  });
});

describe("a cache that can't be purged", () => {
  function registry(): TestRegistry {
    return new TestRegistry(
      new RegistryLimits(),
      new MemoryMetadataDb(),
      new MemoryBlobStore(),
      new FailingPurge(),
    );
  }

  it("still answers 201 for a publish, and a retry 409", async () => {
    const r = registry();
    const first = await r.publish("lib", "1.0.0");
    expect(first.status).toBe(201);
    expect((await r.call("GET", "lib/index")).text).toContain(`"1.0.0"`);
    expect((await r.publish("lib", "1.0.0")).status).toBe(409);
  });

  it("still answers 200 for a yank and a change of owners", async () => {
    const r = registry();
    const alice = r.user("alice");
    r.user("bob");
    await r.publish("lib", "1.0.0", alice);
    expect((await r.call("PUT", "lib/1.0.0/yank", alice)).status).toBe(200);
    expect((await r.call("PUT", "lib/owners/bob", alice)).status).toBe(200);
    expect(await r.owners("lib")).toEqual(["alice", "bob"]);
  });
});

describe("stores", () => {
  it("commit a new package's owner with its first version, or neither", async () => {
    const r = new TestRegistry(new RegistryLimits(), new FailingDb());
    const alice = r.user("alice");
    const failed = await r.publish("lib", "1.0.0", alice);
    expect(failed.status).toBe(500);
    expect(failed.text).toBe("the database is down");
    expect(await r.db.record("lib")).toBeNull();
  });

  it("show only a StoreError's message", async () => {
    const r = new TestRegistry(new RegistryLimits(), new BrokenDb());
    const failed = await r.publish("lib", "1.0.0");
    expect(`${failed.status} ${failed.text}`).toBe("500 the registry failed");
  });

  it("answer 500 for an archive the blob store lost", async () => {
    const r = new TestRegistry(new RegistryLimits(), new MemoryMetadataDb(), new EmptyBlobs());
    expect((await r.publish("lib", "1.0.0")).status).toBe(201);
    const lost = await r.call("GET", "lib/1.0.0");
    expect(lost.status).toBe(500);
    expect(lost.text).toContain("missing from the registry's store");
  });
});

describe("caches and choices", () => {
  it("purge what a write changed, and nothing for a yank that changes nothing", async () => {
    const r = new TestRegistry();
    const alice = r.user("alice");
    r.user("bob");
    await r.publish("lib", "1.0.0", alice);
    expect(r.purge.purged).toEqual([
      "/api/v1/lib/index",
      "/index/lib.json",
      "/api/v1/lib/1.0.0",
      "/",
    ]);
    r.purge.purged = [];
    await r.call("PUT", "lib/1.0.0/yank", alice);
    await r.call("PUT", "lib/1.0.0/yank", alice);
    expect(r.purge.purged).toEqual(["/api/v1/lib/index", "/index/lib.json"]);
    r.purge.purged = [];
    await r.call("PUT", "lib/owners/bob", alice);
    expect(r.purge.purged).toEqual(["/api/v1/lib/owners"]);
  });

  it("show a stable version before a newer pre-release, and no package all yanked", async () => {
    const r = new TestRegistry();
    await r.publish("lib", "1.0.0");
    await r.publish("lib", "2.0.0-rc.1");
    expect((await r.call("GET", "search?q=lib")).text).toContain(`"version":"1.0.0"`);
    await r.call("PUT", "lib/1.0.0/yank");
    expect((await r.call("GET", "search?q=lib")).text).toContain(`"version":"2.0.0-rc.1"`);
    await r.call("PUT", "lib/2.0.0-rc.1/yank");
    expect((await r.call("GET", "search?q=lib")).text).toBe(`{"packages":[]}`);
  });

  it("refuse a body announced too large before anything else", async () => {
    const limits = new RegistryLimits();
    limits.maxArchiveBytes = 1000;
    const r = new TestRegistry(limits);
    r.user("alice");
    const headers: [string, string][] = [["content-length", "1001"]];
    const answer = await r.send("PUT", "/api/v1/lib/1.0.0", headers, null);
    expect(answer.status).toBe(413);
    expect(answer.text).toBe("the upload is larger than 1000 bytes");
  });
});
