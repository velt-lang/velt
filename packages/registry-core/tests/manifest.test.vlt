// `package.vlt` as vpm reads it (src/manifest). crates/veltc/tests/registry_core.rs compares the
// reader with vpm's over many more manifests.
import { describe, expect, it } from "velt/test";
import { Manifest, ManifestError, readManifest } from "../src/lib";

function refusal(src: string): string {
  try {
    readManifest(src);
    return "accepted";
  } catch (e) {
    return e instanceof ManifestError ? e.message : `not a ManifestError: ${e.message}`;
  }
}

const HEAD = `import type { Package } from "velt/package";\n\nexport const pkg: Package = `;

describe("readManifest", () => {
  it("reads a full manifest", () => {
    const m = readManifest(`${HEAD}{
  name: "hello",
  version: "0.1.0-rc.1",
  description: "Says hello", // a comment
  keywords: ["greeting", "demo"],
  dependencies: { json: "^1.2", util: { path: "../util" }, "@x/y": { path: "../y", version: "1" } },
  paths: { "@app/*": "src/*" },
  imports: { "#io": { js: "./src/io/js.vlt", default: "./src/io/native.vlt" } },
  native: { targets: ["x86_64-unknown-linux-gnu"] },
  tsCompat: ["src/models"],
  build: { cpu: "x86-64-v3" },
};\n`);
    expect(m.name).toBe("hello");
    expect(m.version).toBe("0.1.0-rc.1");
    expect(m.keywords).toEqual(["greeting", "demo"]);
    expect(m.dependencies.get("json")?.simple).toBe("^1.2");
    expect(m.dependencies.get("util")?.path).toBe("../util");
    expect(m.native?.path).toBe("native");
    expect(m.entry).toBe("src/main.vlt");
  });

  it("accepts the forms the Velt parser does", () => {
    expect(refusal(`export const pkg: Package = { 'name': "a", ["version"]: '1.0.0', }`)).toBe(
      "accepted",
    );
    expect(
      refusal(
        `import { type Package } from 'velt/package'\nexport const pkg: Package = {name:"a",version:"1.0.0"}`,
      ),
    ).toBe("accepted");
    expect(
      refusal(
        `/* x */ export /* y */ const pkg: Package = { name: "a\\x62", version: "1.0.\\u{30}" };`,
      ),
    ).toBe("accepted");
  });

  it("refuses what isn't data", () => {
    for (const body of [
      `{ name: "a", version: "1.0.0", ...x }`,
      `{ name: "a" + "b", version: "1.0.0" }`,
      `{ name: \`a\`, version: "1.0.0" }`,
      `{ name: "a", version: "1.0.0" } as const`,
      `{ name, version: "1.0.0" }`,
      `{ name: "a", version: "1.0.0", description: null }`,
      `({ name: "a", version: "1.0.0" })`,
      `{ name: "a", name: "b", version: "1.0.0" }`,
      `{ name: "a", version: "1.0.0", f() {} }`,
    ]) {
      expect(refusal(`${HEAD}${body};`)).not.toBe("accepted");
    }
  });

  it("refuses invalid fields", () => {
    expect(refusal(`${HEAD}{ name: "a" };`)).toContain("missing `version`");
    expect(refusal(`${HEAD}{ name: "A", version: "1.0.0" };`)).toContain("invalid package name");
    expect(refusal(`${HEAD}{ name: "a", version: "1.0" };`)).toContain("is not a semver version");
    expect(
      refusal(`${HEAD}{ name: "a", version: "1.0.0", dependencies: { b: ">>1" } };`),
    ).toContain("invalid version requirement");
    expect(refusal(`${HEAD}{ name: "a", version: "1.0.0", nme: "x" };`)).toContain(
      "unknown key `nme`",
    );
  });

  it("names the first earlier tsCompat folder a new one clashes with", () => {
    const ts = (dirs: string): string => refusal(
      `${HEAD}{ name: "a", version: "1.0.0", tsCompat: [${dirs}] };`,
    );
    expect(ts(`"a/b/c", "a/d", "a"`)).toBe(
      "`a` contains `a/b/c`, which `tsCompat` already lists; keep one of them",
    );
    expect(ts(`"a/d", "a/b/c", "A"`)).toBe(
      "`A` contains `a/d`, which `tsCompat` already lists; keep one of them",
    );
    expect(ts(`"x", "a", "A/b/c"`)).toBe("`A/b/c` is inside `a`, which `tsCompat` already lists");
    expect(ts(`"src/m", "src/M"`)).toBe(
      "`tsCompat` lists `src/M` and `src/m`, which differ only in case (the same folder on case-insensitive file systems); keep one of them",
    );
    expect(ts(`"a", "a"`)).toBe("`tsCompat` lists `a` twice");
    expect(ts(`"a/b", "a/bc", "ab"`)).toBe("accepted");
  });

  it("gives vpm's JSON", () => {
    const m: Manifest = readManifest(`${HEAD}{ name: "a", version: "1.0.0", jsx: {} };`);
    expect(m.toJson()).toBe(
      `{"name":"a","version":"1.0.0","entry":"src/main.vlt","dependencies":{},"paths":{},"jsx":{}}`,
    );
  });
});
