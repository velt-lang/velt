// registry-core: the package registry's rules in Velt (#1740, #1325): package and user names,
// semver versions and requirements, `package.vlt` as vpm reads it, and the package archive with
// its content checksum, as `velt` and vpm define them; and the registry's HTTP API (`Registry`,
// `/api/v1/…`) over a host's stores (`BlobStore`, `MetadataDb`, `PublishLock`, `CachePurge`,
// `AuthProvider`), with in-memory adapters.

export {
  checkDependencyName,
  checkName,
  checkUserName,
  isNativePrefixName,
  isValidDependencyName,
  isValidPackageName,
  isValidUserName,
  isWindowsDeviceName,
  normalizedName,
  splitScoped,
} from "./names";
export { SemverError } from "./semver/semver_error";
export { Version } from "./semver/version";
export { ArchiveError } from "./archive_error";
export {
  ArchiveEntry,
  checkPackagePaths,
  contentChecksum,
  isSafePath,
  LEGACY_MANIFEST_FILE,
  MANIFEST_FILE,
  packArchive,
  readArchive,
  SRC_DIR,
} from "./archive";
export { isValidRequirement } from "./semver/requirement";
export { Dependency } from "./manifest/dependency";
export { HostConfig } from "./manifest/host_config";
export { Manifest } from "./manifest/manifest";
export { NativeConfig } from "./manifest/native_config";
export { Variant } from "./manifest/variant";
export { ManifestError } from "./manifest/manifest_error";
export { readManifest } from "./manifest/decode";
export { readPackageArchive } from "./package_archive";
export { AuthProvider } from "./stores/auth_provider";
export { BlobStore } from "./stores/blob_store";
export { CachePurge } from "./stores/cache_purge";
export { HeldLock } from "./stores/held_lock";
export { MetadataDb } from "./stores/metadata_db";
export { PublishLock } from "./stores/publish_lock";
export { StoreError } from "./stores/store_error";
export { Caller } from "./server/caller";
export { IndexEntry } from "./server/index_entry";
export { PackageIndex } from "./server/package_index";
export { Registry } from "./server/registry";
export { RegistryLimits } from "./server/registry_limits";
export { RegistryStores } from "./server/registry_stores";
export { MemoryBlobStore } from "./memory/memory_blob_store";
export { MemoryMetadataDb } from "./memory/memory_metadata_db";
