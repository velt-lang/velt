// registry-core: a `PublishLock` for one process: a one-slot channel per key, whose token the
// holder takes and gives back.

import { channel, Channel } from "velt/sync";
import { HeldLock } from "../stores/held_lock";
import { PublishLock } from "../stores/publish_lock";

// The lock of one key while held: releasing gives its token back.
class HeldToken implements HeldLock {
  private slot: Channel<bool>;

  constructor(slot: Channel<bool>) {
    this.slot = slot;
  }

  async release(): Promise<void> {
    this.slot.trySend(true);
  }
}

/** Locks within one process (one server's tasks); a lock is never dropped once made. */
export class MemoryPublishLock implements PublishLock {
  private slots: Map<string, Channel<bool>> = new Map();

  async acquire(key: string): Promise<HeldLock> {
    let slot = this.slots.get(key);
    if (slot == null) {
      const made = channel<bool>(1);
      made.trySend(true);
      this.slots.set(key, made);
      slot = made;
    }
    await slot.receive();
    return new HeldToken(slot);
  }
}
