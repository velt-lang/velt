// registry-core (internal): a package archive's entries checked as a package (vpm's
// `archive::entries`): safe paths, and only `package.vlt`, `src/` and the directory of the native
// crate its manifest declares. A manifest that doesn't read has no native directory here; the
// manifest itself is checked where it is read.

import { utf8Decode } from "velt/encoding";
import { ArchiveEntry, checkPackagePaths, MANIFEST_FILE, readArchive } from "./archive";
import { readManifest } from "./manifest/decode";

/** The native crate's directory declared by the manifest text in `entries`, if any. */
function nativeDir(entries: ArchiveEntry[]): string | null {
  for (const e of entries) {
    if (e.path == MANIFEST_FILE) {
      try {
        return readManifest(utf8Decode(e.bytes)).native?.path ?? null;
      } catch (err) {
        return null;
      }
    }
  }
  return null;
}

/** The entries of the package archive `archive`; throws `ArchiveError` as vpm refuses one. */
export function readPackageArchive(archive: u8[]): ArchiveEntry[] {
  const entries = readArchive(archive, (p: string): bool => true);
  checkPackagePaths(entries, nativeDir(entries));
  return entries;
}
