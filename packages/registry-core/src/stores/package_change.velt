// registry-core: one write to a package, committed whole or not at all.

import { IndexEntry } from "../server/index_entry";
import { PackageIndex } from "../server/package_index";

/**
 * A change to package `name`, made from its record at revision `base` (0 for a name never
 * published). `changed` holds the index entries it adds or changes (by version), `owners` the new
 * owners, or null when they stay. `index` is the whole index afterwards, for what an adapter
 * keeps beside it (a search row).
 */
export class PackageChange {
  name: string;
  base: i64;
  index: PackageIndex;
  changed: IndexEntry[] = [];
  owners: string[] | null = null;

  constructor(name: string, base: i64, index: PackageIndex) {
    this.name = name;
    this.base = base;
    this.index = index;
  }
}
