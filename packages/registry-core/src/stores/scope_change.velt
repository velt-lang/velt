// registry-core: one write to a scope, committed whole or not at all.

/**
 * A change to scope `scope` (without `@`) made from its record at revision `base` (0 to claim
 * a scope nobody has): its owners afterwards.
 */
export class ScopeChange {
  scope: string;
  base: i64;
  owners: string[];

  constructor(scope: string, base: i64, owners: string[]) {
    this.scope = scope;
    this.base = base;
    this.owners = owners;
  }
}
