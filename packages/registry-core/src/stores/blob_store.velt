// registry-core: where the registry's static files are kept (#1325's `BlobStore`): a folder
// natively, R2 on Cloudflare. They are what clients read, served as they are by any static host:
// archives at `archiveKey`, addressed by their content checksum so they never change, and each
// package's index at `indexKey`, rewritten after each write (`static_files.velt`).

/** Static files by key (a relative path). */
export interface BlobStore {
  /**
   * Stores `bytes` under `key` unless a file is stored there already (an archive, whose bytes
   * are then the same, since the key holds their checksum). Resolves to whether it stored them.
   */
  putIfAbsent(key: string, bytes: u8[]): Promise<bool>;
  /** Stores `bytes` under `key`, replacing what was there. */
  put(key: string, bytes: u8[]): Promise<void>;
  /** The file stored under `key`, or null. */
  get(key: string): Promise<u8[] | null>;
}
