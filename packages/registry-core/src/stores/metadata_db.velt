// registry-core: what a registry knows about its packages (#1325's `MetadataDb`): each package's
// index (its published versions) and its owners. SQLite natively, D1 on Cloudflare. Users and
// their tokens are the `AuthProvider`'s.

import { PackageIndex } from "../server/package_index";

/**
 * The packages of a registry. The handler changes a package only while it holds that package's
 * `PublishLock`, so an adapter needs no transactions of its own; it must not hand out objects
 * the handler's changes would reach before `putIndex`/`putOwners` (return copies).
 */
export interface MetadataDb {
  /** The index of package `name`, or null when it was never published. */
  index(name: string): Promise<PackageIndex | null>;
  /** Replaces the index of package `name` (creating it on its first publish). */
  putIndex(name: string, index: PackageIndex): Promise<void>;
  /** Every published package's name, in any order. */
  packageNames(): Promise<string[]>;
  /**
   * The packages a search for `terms` (lowercased, each a word) may find, each with its index:
   * every package, or fewer when the adapter can rule some out. The handler ranks them.
   */
  searchCandidates(terms: string[]): Promise<PackageIndex[]>;
  /** The owners of package `name`, in the order they were added; empty when it has none. */
  owners(name: string): Promise<string[]>;
  /** Replaces the owners of package `name`. */
  putOwners(name: string, owners: string[]): Promise<void>;
}
