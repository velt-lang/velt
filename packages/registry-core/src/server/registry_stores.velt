// registry-core: the stores a `Registry` works on (#1325's interfaces).

import { AuthProvider } from "../stores/auth_provider";
import { BlobStore } from "../stores/blob_store";
import { CachePurge } from "../stores/cache_purge";
import { MetadataDb } from "../stores/metadata_db";
import { NameReservations } from "../stores/name_reservations";

/** A host's adapters: in memory (`registry-core`'s own), a folder and SQLite, R2 and D1, … */
export struct RegistryStores {
  blobs: BlobStore;
  db: MetadataDb;
  purge: CachePurge;
  auth: AuthProvider;
  /** The names kept back for an approved user (a public registry's); none when left out. */
  reserved?: NameReservations;
}
