// registry-core (internal): `GET /api/v1/<name>/owners`, and `PUT`/`DELETE
// /api/v1/<name>/owners/<user>` (crates/velt_registry/src/owners.rs). Only an owner changes
// the owners, only to users that exist, and the last owner stays.

import { checkUserName, isValidPackageName } from "../names";
import { PackageChange } from "../stores/package_change";
import { PackageRecord } from "../stores/package_record";
import { authorize, isPublished, ownerOf } from "./access";
import { text } from "./answer";
import { Caller } from "./caller";
import { commitChange } from "./commit";
import { Refusal } from "./refusal";
import { RegistryStores } from "./registry_stores";

/** `GET /api/v1/<name>/owners`: one owner per line. */
export async function listOwners(stores: RegistryStores, name: string): Promise<Response> {
  if (!isValidPackageName(name)) {
    return text(400, "invalid package name");
  }
  const record = await stores.db.record(name);
  if (record == null) {
    return text(404, `no package \`${name}\``);
  }
  return text(200, record.owners.map((o: string): string => `${o}\n`).join(""));
}

// The change adding (`add`) or removing `user` as an owner of package `name`, from its record;
// null when there is nothing to change.
async function ownersChange(
  stores: RegistryStores,
  record: PackageRecord | null,
  caller: Caller,
  name: string,
  user: string,
  add: bool,
): Promise<PackageChange | null> {
  if (record == null) {
    throw new Refusal(404, `no package \`${name}\``);
  }
  if (caller.isAnyone()) {
    throw new Refusal(400, "this registry has no users, so packages have no owners");
  }
  authorize(record, name, caller);
  const owners = [...record.owners];
  if (add) {
    if (!(await stores.auth.isUser(user))) {
      throw new Refusal(404, `no user \`${user}\``);
    }
    if (owners.includes(user)) {
      return null;
    }
    owners.push(user);
  } else {
    if (!owners.includes(user)) {
      throw new Refusal(404, `\`${user}\` is not an owner of \`${name}\``);
    }
    if (owners.length == 1) {
      throw new Refusal(
        409,
        `\`${user}\` is the last owner of \`${name}\`; add another owner first`,
      );
    }
    owners.splice(owners.indexOf(user), 1);
  }
  const change = new PackageChange(name, record.revision, record.index);
  change.owners = owners;
  return change;
}

/** `PUT` (`add`) or `DELETE /api/v1/<name>/owners/<user>`. */
export async function changeOwners(
  stores: RegistryStores,
  req: Request,
  name: string,
  user: string,
  add: bool,
): Promise<Response> {
  if (!isValidPackageName(name)) {
    return text(400, "invalid package name");
  }
  const bad = checkUserName(user);
  if (bad != null) {
    return text(400, bad);
  }
  const caller = await ownerOf(stores, req, name);
  if (!(await isPublished(stores, name))) {
    return text(404, `no package \`${name}\``);
  }
  let owners: string[] = [];
  await commitChange(stores, name, [`/api/v1/${name}/owners`], async (
    record: PackageRecord | null,
  ): Promise<PackageChange | null> => {
    const change = await ownersChange(stores, record, caller, name, user, add);
    owners = change?.owners ?? record?.owners ?? [];
    return change;
  });
  return text(200, `owners of \`${name}\`: ${owners.join(", ")}\n`);
}
