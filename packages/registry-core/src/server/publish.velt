// registry-core (internal): `PUT /api/v1/<name>/<version>`, publishing a package (the Rust
// server's `upload`, and vpm's `publish_to`). Everything is checked before anything is written:
// the caller and the package's owners, the archive and its checksum (`X-Velt-Checksum`), the
// publish policy (#2225), `package.velt` (read as data, never run) naming the package and
// version of the URL, the dependencies (registry packages only), and the name and version being
// free, and native code only where the host accepts it. Then the archive is stored by its
// checksum, the first publisher of a new package becomes its owner, and the version joins the
// index; versions are immutable. The body is read and the archive checked before the package's
// write is committed, so a stalled or large upload holds up nothing but itself. A write commits
// only if the package hasn't changed since it was read (`commitChange`), so none needs a lock.

import { EncodingError, utf8Decode } from "velt/encoding";
import { ArchiveEntry, contentChecksum, MANIFEST_FILE, packArchive } from "../archive";
import { ArchiveError } from "../archive_error";
import { Manifest } from "../manifest/manifest";
import { readManifest } from "../manifest/decode";
import { ManifestError } from "../manifest/manifest_error";
import { isValidPackageName, normalizedName } from "../names";
import { readPackageArchive } from "../package_archive";
import { Version } from "../semver/version";
import { PackageChange } from "../stores/package_change";
import { PackageRecord } from "../stores/package_record";
import { archiveKey } from "../stores/static_files";
import { authorize, isPublished, ownerOf, writer } from "./access";
import { text } from "./answer";
import { Caller } from "./caller";
import { commitChange, indexPaths, mendIndexFile } from "./commit";
import { IndexEntry } from "./index_entry";
import { PackageIndex } from "./package_index";
import { publishPathProblem } from "./publish_policy";
import { Refusal } from "./refusal";
import { RegistryLimits } from "./registry_limits";
import { RegistryStores } from "./registry_stores";
import { checkNotReserved } from "./reserved";
import { declaredLength, tooLarge, uploadBody } from "./upload_body";

// The archive's entries and checksum, after the checks of its format, checksum and the publish
// policy.
function checkedEntries(
  body: u8[],
  declared: string | null,
  limits: RegistryLimits,
): [ArchiveEntry[], string] {
  let entries: ArchiveEntry[] = [];
  try {
    entries = readPackageArchive(body, limits.maxEntries);
  } catch (e) {
    if (e instanceof ArchiveError) {
      throw new Refusal(400, e.message);
    }
    throw e;
  }
  const sum = contentChecksum(entries);
  if (declared != sum) {
    throw new Refusal(400, `checksum mismatch: the archive hashes to ${sum}`);
  }
  const problem = publishPathProblem(entries);
  if (problem != null) {
    throw new Refusal(400, problem);
  }
  return [entries, sum];
}

// The archive's manifest, read as vpm reads an uploaded one; messages name `package.velt`.
function manifestOf(entries: ArchiveEntry[]): Manifest {
  for (const e of entries) {
    if (e.path != MANIFEST_FILE) {
      continue;
    }
    try {
      return readManifest(utf8Decode(e.bytes));
    } catch (err) {
      if (err instanceof EncodingError) {
        throw new Refusal(400, `${MANIFEST_FILE}: the manifest is not valid UTF-8`);
      }
      if (err instanceof ManifestError) {
        throw new Refusal(400, `${MANIFEST_FILE}: ${err.message}`);
      }
      throw err;
    }
  }
  throw new Refusal(400, `the archive has no ${MANIFEST_FILE}`);
}

// The dependencies as the index records them (name → requirement): registry packages only.
function requirements(m: Manifest): Map<string, string> {
  const out: Map<string, string> = new Map();
  for (const [dep, spec] of m.dependencies) {
    if (spec.simple == "workspace") {
      // Publishing members, with `"workspace"` replaced by versions, is planned
      // (docs/internals/design/workspaces.md "Publishing").
      throw new Refusal(
        400,
        `cannot publish \`${m.name}\`: dependency \`${dep}\` is \`"workspace"\`; publishing members of a workspace is not supported yet`,
      );
    }
    const req = spec.simple ?? spec.version;
    if (req == null) {
      const source = spec.git != null ? "a `git` repository" : "a `path`";
      throw new Refusal(
        400,
        `cannot publish \`${m.name}\`: dependency \`${dep}\` has only ${source}; add a \`version\` requirement (a registry package is built from the registry alone)`,
      );
    }
    out.set(dep, req);
  }
  return out;
}

// A new package's name may not differ from a published one's only in `-` versus `_`: their
// native functions, init functions and library files would share names.
async function checkNameIsFree(stores: RegistryStores, name: string): Promise<void> {
  const other = await stores.db.spelling(normalizedName(name));
  if (other != null && other != name) {
    throw new Refusal(
      400,
      `cannot publish \`${name}\`: the registry has \`${other}\`, and names that differ only in \`-\` and \`_\` count as the same; choose another name`,
    );
  }
}

// The upload `body`'s entries, checksum and manifest, once the archive, the publish policy, the
// manifest and the host's limits accept it. Nothing here reads a store.
function checkedUpload(
  limits: RegistryLimits,
  req: Request,
  name: string,
  version: string,
  body: u8[],
): [ArchiveEntry[], string, Manifest] {
  const [entries, sum] = checkedEntries(body, req.headers.get("x-velt-checksum"), limits);
  const m = manifestOf(entries);
  if (m.name != name || Version.parse(m.version).toString() != version) {
    throw new Refusal(400, `the archive is \`${m.name}\` ${m.version}, not \`${name}\` ${version}`);
  }
  if (m.native != null && !limits.nativePackages) {
    throw new Refusal(
      400,
      `cannot publish \`${name}\`: this registry doesn't accept packages with native code (\`native\` in ${MANIFEST_FILE})`,
    );
  }
  return [entries, sum, m];
}

// The new version's index entry, from the manifest and the archive's checksum.
function newEntry(m: Manifest, sum: string): IndexEntry {
  const deps = requirements(m);
  const entry = new IndexEntry(Version.parse(m.version).toString(), sum);
  entry.description = m.description;
  entry.keywords = [...m.keywords];
  entry.dependencies = deps;
  return entry;
}

// The change publishing `entry` makes to package `name`, from its `record` (null when new): the
// caller checked again (the owners may have changed while the body arrived), the version free,
// and for a new package, its name free and its publisher its first owner.
async function publishChange(
  stores: RegistryStores,
  caller: Caller,
  name: string,
  entry: IndexEntry,
  record: PackageRecord | null,
): Promise<PackageChange> {
  authorize(record, name, caller);
  if (record == null) {
    await checkNameIsFree(stores, name);
    await checkNotReserved(stores, name, caller);
  }
  const index = record?.index.copy() ?? new PackageIndex(name);
  const version = Version.parse(entry.version);
  for (const e of index.versions) {
    if (Version.isValid(e.version) && Version.parse(e.version).compare(version) == 0) {
      if (e.checksum == entry.checksum) {
        // Most likely this publish tried again after its index file failed: write it now.
        await mendIndexFile(stores, name);
      }
      throw new Refusal(
        409,
        `\`${name}\` ${entry.version} is already published (bump \`version\` in package.velt)`,
      );
    }
  }
  index.versions.push(entry);
  const change = new PackageChange(name, record?.revision ?? 0, index);
  change.changed = [entry];
  const user = caller.user;
  if (record == null && user != null) {
    change.owners = [user];
  }
  return change;
}

/** Publishes package `name` `version` from the archive in `req`'s body. */
export async function publish(
  stores: RegistryStores,
  limits: RegistryLimits,
  req: Request,
  name: string,
  version: string,
): Promise<Response> {
  if (!isValidPackageName(name) || !Version.isValid(version)) {
    return text(400, "invalid package name or version");
  }
  // A body announced too large is refused before anything else, as the Rust server's HTTP
  // layer refuses it before its handler runs; one that only turns out too large, once read.
  if (declaredLength(req.headers.get("content-length")) > limits.maxArchiveBytes) {
    throw tooLarge(limits.maxArchiveBytes);
  }
  // Only a caller who may publish gets a body read: an owner, or for a new name, any user whose
  // name doesn't collide with a published one's and isn't reserved for someone else.
  const caller = await ownerOf(stores, req, name);
  if (!(await isPublished(stores, name))) {
    await checkNameIsFree(stores, name);
    await checkNotReserved(stores, name, caller);
  }
  const body = await uploadBody(req, limits.maxArchiveBytes);
  const [entries, sum, m] = checkedUpload(limits, req, name, version, body);
  const entry = newEntry(m, sum);
  // Checked against the package as it is before the archive is stored, so a publish refused
  // (a version that exists, an owner removed meanwhile) stores nothing.
  const now = await stores.db.record(name);
  await publishChange(stores, await writer(stores, req), name, entry.copy(), now);
  // Stored before the commit, by its checksum: only a publish that loses a race after this leaves
  // an archive nothing names, and one retried stores nothing new.
  await stores.blobs.putIfAbsent(archiveKey(sum), packArchive(entries));
  // Each try asks who the caller is again: a token taken away while the body arrived stops here.
  await commitChange(
    stores,
    name,
    [...indexPaths(name), `/api/v1/${name}/${entry.version}`, "/"],
    async (record: PackageRecord | null): Promise<PackageChange | null> => await publishChange(
      stores,
      await writer(stores, req),
      name,
      entry.copy(),
      record,
    ),
  );
  return text(201, `published \`${name}\` ${entry.version}\n`);
}
