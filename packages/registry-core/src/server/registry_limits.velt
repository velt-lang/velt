// registry-core: how large an upload a `Registry` accepts, and which packages.

/** The limits of an upload; the defaults are the Rust server's (`MAX_ARCHIVE`) and #2225's. */
export class RegistryLimits {
  /** The largest archive accepted, in bytes (64 MiB): a larger body answers 413. */
  maxArchiveBytes: i64 = 64 * 1024 * 1024;
  /** The largest README accepted (`PUT /api/v1/<name>/<version>/readme`), in bytes (512 KiB). */
  maxReadmeBytes: i64 = 512 * 1024;
  /** The most files an archive may hold. */
  maxEntries: i64 = 10000;
  /**
   * Whether a package with native code (`native` in its `package.velt`) may be published. A host
   * that serves no native libraries turns this off, so nothing is published that can't be built.
   */
  nativePackages: bool = true;
}
