// registry-core (internal): `PUT` and `DELETE /api/v1/<name>/<version>/yank` (crates/vpm's
// `yank_local`, behind the Rust server's checks). A yanked version stays downloadable, so
// lockfiles that pin it keep installing; only its index entry's `yanked` changes.

import { isValidPackageName } from "../names";
import { Version } from "../semver/version";
import { PackageChange } from "../stores/package_change";
import { PackageRecord } from "../stores/package_record";
import { authorize, isPublished, ownerOf } from "./access";
import { text } from "./answer";
import { Caller } from "./caller";
import { commitChange, indexPaths } from "./commit";
import { Refusal } from "./refusal";
import { RegistryStores } from "./registry_stores";

function notInRegistry(name: string): string {
  return `\`${name}\` is not in the registry`;
}

// The change setting `version`'s `yanked`, from package `name`'s record; null when it is set.
function yankChange(
  record: PackageRecord | null,
  caller: Caller,
  name: string,
  version: string,
  yanked: bool,
): PackageChange | null {
  if (record == null) {
    throw new Refusal(404, notInRegistry(name));
  }
  authorize(record, name, caller);
  const index = record.index.copy();
  const entry = index.entry(version);
  if (entry == null) {
    throw new Refusal(404, `\`${name}\` ${version} is not published`);
  }
  if (entry.yanked == yanked) {
    return null;
  }
  entry.yanked = yanked;
  const change = new PackageChange(name, record.revision, index);
  change.changed = [entry];
  return change;
}

/** Yanks (`yanked`) or unyanks package `name`'s `version`. */
export async function yank(
  stores: RegistryStores,
  req: Request,
  name: string,
  version: string,
  yanked: bool,
): Promise<Response> {
  if (!isValidPackageName(name) || !Version.isValid(version)) {
    return text(400, "invalid package name or version");
  }
  const caller = await ownerOf(stores, req, name);
  if (!(await isPublished(stores, name))) {
    return text(404, notInRegistry(name));
  }
  const normal = Version.parse(version).toString();
  await commitChange(
    stores,
    name,
    indexPaths(name),
    async (record: PackageRecord | null): Promise<PackageChange | null> => yankChange(
      record,
      caller,
      name,
      normal,
      yanked,
    ),
  );
  return text(200, `${yanked ? "yanked" : "unyanked"} \`${name}\` ${version}\n`);
}
