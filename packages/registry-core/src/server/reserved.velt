// registry-core (internal): reserved names. A new package whose name, or scope, a registry's
// `NameReservations` holds back is published only by the user approved for it.

import { normalizedName, splitScoped } from "../names";
import { Caller } from "./caller";
import { Refusal } from "./refusal";
import { RegistryStores } from "./registry_stores";

/**
 * The keys a reservation of package `name` may be under: its `normalizedName`, and for a scoped
 * name its scope (`@` and the scope's `normalizedName`).
 */
export function reservationKeys(name: string): string[] {
  const keys = [normalizedName(name)];
  const scoped = splitScoped(name);
  if (scoped != null) {
    keys.push(`@${normalizedName(scoped[0])}`);
  }
  return keys;
}

/**
 * Returns when `caller` may take the new name `name`: every reservation it falls under (its own,
 * and its scope's) is held by `caller`. Else throws the 403 saying how to ask.
 */
export async function checkNotReserved(
  stores: RegistryStores,
  name: string,
  caller: Caller,
): Promise<void> {
  const reserved = stores.reserved;
  if (reserved == null) {
    return;
  }
  const keys = reservationKeys(name);
  for (let i: i64 = 0; i < keys.length; i++) {
    const found = await reserved.reservation(keys[i]);
    if (found == null) {
      continue;
    }
    const holder = found.holder;
    if (holder != null && holder == caller.user) {
      continue;
    }
    // The first key is the name's own; a second is its scope's.
    const what = i == 0 ? `\`${name}\`` : `the scope \`${keys[i]}\``;
    throw new Refusal(
      403,
      `cannot publish \`${name}\`: ${what} is reserved (${found.reason}); to ask for it: ${reserved.howToRequest(name)}`,
    );
  }
}
