// registry-core (internal): `GET /api/v1/search?q=<text>` (crates/vpm/src/search.rs). The query
// is lowercased and split into terms on whitespace; a package matches when every term is in its
// name, one of its keywords or its description, each shown for the version `velt add` picks.
// Ranked by the best tier any term reaches, then by how many terms don't reach it, then by
// name. Packages whose versions are all yanked are left out.

import { utf8DecodeLossy, utf8Encode } from "velt/encoding";
import { json } from "./answer";
import { IndexEntry } from "./index_entry";
import { compareUtf8, jsonString } from "./json_text";
import { RegistryStores } from "./registry_stores";

/** The most packages one search answers. */
export const MAX_HITS = 50;

// One package found, with its rank (lower first).
struct Hit {
  name: string;
  entry: IndexEntry;
  tier: i64;
  others: i64;
}

/** The value of `q` in a query string (no `?`), percent-decoded, `+` a space; "" if absent. */
export function queryParam(query: string): string {
  let raw = "";
  for (const pair of query.split("&")) {
    if (pair.startsWith("q=")) {
      raw = pair.slice(2);
      break;
    }
  }
  const out: u8[] = [];
  const bytes = utf8Encode(raw);
  let i: i64 = 0;
  while (i < bytes.length) {
    const b = bytes[i];
    const escaped = b == 37 ? escapedByte(bytes, i + 1) : -1;
    if (escaped >= 0) {
      out.push(escaped as u8);
      i += 3;
    } else {
      out.push(b == 43 ? 32 : b);
      i += 1;
    }
  }
  return utf8DecodeLossy(out);
}

// The byte the two characters at `bytes[i]` write in hex, or -1 (Rust's `u8::from_str_radix`,
// which also takes `+` and one digit).
function escapedByte(bytes: u8[], i: i64): i64 {
  if (i + 1 >= bytes.length) {
    return -1;
  }
  const lo = hexValue(bytes, i + 1);
  if (bytes[i] == 43) {
    return lo;
  }
  const hi = hexValue(bytes, i);
  return hi < 0 || lo < 0 ? -1 : hi * 16 + lo;
}

// The value of the hex digit at `bytes[i]`, or -1 (also past the end).
function hexValue(bytes: u8[], i: i64): i64 {
  if (i >= bytes.length) {
    return -1;
  }
  const c = bytes[i] as i64;
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}

// How well one term matches (lower is better), or -1: 2 a keyword equals it, 3 the name
// contains it, 4 a keyword starts with it, 5 the description contains it.
function tier(name: string, e: IndexEntry, term: string): i64 {
  if (e.keywords.includes(term)) {
    return 2;
  }
  if (name.includes(term)) {
    return 3;
  }
  for (const k of e.keywords) {
    if (k.startsWith(term)) {
      return 4;
    }
  }
  if (e.description != null && e.description.toLowerCase().includes(term)) {
    return 5;
  }
  return -1;
}

// `name` ranked for `query` (its `terms`), or null when a term doesn't match.
function rank(name: string, e: IndexEntry, query: string, terms: string[]): Hit | null {
  const tiers: i64[] = [];
  for (const t of terms) {
    const found = tier(name, e, t);
    if (found < 0) {
      return null;
    }
    tiers.push(found);
  }
  let best: i64 = 3;
  if (name == query) {
    best = 0;
  } else if (query.length > 0 && name.startsWith(query)) {
    best = 1;
  } else if (tiers.length > 0) {
    best = tiers.reduce((a: i64, b: i64): i64 => (a < b ? a : b), 5);
  }
  const others = tiers.filter((t: i64): bool => t != best).length as i64;
  return { name, entry: e, tier: best, others };
}

function hitJson(h: Hit): string {
  let out = `{"name":${jsonString(h.name)},"version":${jsonString(h.entry.version)}`;
  if (h.entry.description != null) {
    out += `,"description":${jsonString(h.entry.description)}`;
  }
  if (h.entry.keywords.length > 0) {
    out += `,"keywords":[${h.entry.keywords.map(jsonString).join(",")}]`;
  }
  return `${out}}`;
}

/** Answers a search for the query string `query` (no `?`) with vpm's `to_json`. */
export async function search(stores: RegistryStores, query: string): Promise<Response> {
  const q = queryParam(query).trim().toLowerCase();
  const terms = q.split(/\s+/).filter((t: string): bool => t.length > 0);
  const hits: Hit[] = [];
  for (const index of await stores.db.searchCandidates(terms)) {
    const shown = index.newest();
    if (shown == null) {
      continue;
    }
    const hit = rank(index.name, shown, q, terms);
    if (hit != null) {
      hits.push(hit);
    }
  }
  hits.sort((a: Hit, b: Hit): i32 => {
    if (a.tier != b.tier) {
      return a.tier < b.tier ? -1 : 1;
    }
    if (a.others != b.others) {
      return a.others < b.others ? -1 : 1;
    }
    return compareUtf8(a.name, b.name);
  });
  const shown = hits.slice(0, MAX_HITS).map(hitJson);
  return json(`{"packages":[${shown.join(",")}]}`);
}
