// registry-core (internal): the names a registry accepts, as vpm checks them
// (crates/vpm/src/manifest/mod.rs): package names, scoped dependency names and registry user
// names. A package is a directory named after it and its native functions are named after it,
// so the rules keep names apart on every file system and in every export prefix.

/** Names no package may have: `velt` (and `std`, its former name) is the standard library's. */
export const RESERVED_NAMES: string[] = ["std", "velt"];

/**
 * First name components whose native export prefix would be Velt's own: `velt_rt_` (runtime
 * functions), `velt_sig_` (signature records) and `velt_native_` (init functions).
 */
export const NATIVE_PREFIX_NAMES: string[] = ["rt", "sig", "native"];

function isLower(c: string): bool {
  return c >= "a" && c <= "z";
}

function isDigit(c: string): bool {
  return c >= "0" && c <= "9";
}

function isSeparator(c: string): bool {
  return c == "-" || c == "_";
}

/**
 * Whether `name` is a device name on Windows (`con`, `prn`, `aux`, `nul`, `com0`-`com9`,
 * `lpt0`-`lpt9`, in any ASCII case).
 */
export function isWindowsDeviceName(name: string): bool {
  const lower = asciiLower(name);
  if (lower == "con" || lower == "prn" || lower == "aux" || lower == "nul") {
    return true;
  }
  return (
    lower.length == 4 &&
    (lower.startsWith("com") || lower.startsWith("lpt")) &&
    isDigit(lower.slice(3))
  );
}

/** `s` with ASCII letters lowercased and everything else as it is. */
function asciiLower(s: string): string {
  let out = "";
  for (const c of s) {
    out += c >= "A" && c <= "Z" ? c.toLowerCase() : c;
  }
  return out;
}

/** Whether `name` is one of [`NATIVE_PREFIX_NAMES`], or one followed by `-` or `_`. */
export function isNativePrefixName(name: string): bool {
  for (const r of NATIVE_PREFIX_NAMES) {
    if (name.startsWith(r)) {
      const rest = name.slice(r.length);
      if (rest.length == 0 || isSeparator(rest.slice(0, 1))) {
        return true;
      }
    }
  }
  return false;
}

/** `-` and `_` separate words, one at a time and never at the end. */
function separatorsOk(name: string): bool {
  let previous = false;
  let last = false;
  for (const c of name) {
    const sep = isSeparator(c);
    if (sep && previous) {
      return false;
    }
    previous = sep;
    last = sep;
  }
  return !last;
}

/** Whether every character after the first is a lowercase letter, a digit, `-` or `_`. */
function restOk(name: string): bool {
  let first = true;
  for (const c of name) {
    if (!first && !(isLower(c) || isDigit(c) || isSeparator(c))) {
      return false;
    }
    first = false;
  }
  return true;
}

/**
 * Whether `name` is a valid package name: lowercase letters and digits starting with a letter,
 * words joined by single `-` or `_` (never doubled, mixed or at the end), not reserved, not a
 * native prefix and not a Windows device name.
 */
export function isValidPackageName(name: string): bool {
  return (
    !RESERVED_NAMES.includes(name) &&
    !isWindowsDeviceName(name) &&
    !isNativePrefixName(name) &&
    separatorsOk(name) &&
    name.length > 0 &&
    isLower(name.slice(0, 1)) &&
    restOk(name)
  );
}

/** One part of a scoped name: like a package name's words, but it may start with a digit. */
function isValidScopePart(part: string): bool {
  return (
    !isWindowsDeviceName(part) &&
    separatorsOk(part) &&
    part.length > 0 &&
    (isLower(part.slice(0, 1)) || isDigit(part.slice(0, 1))) &&
    restOk(part)
  );
}

/** A scoped name's scope and name (`@sigx/reactivity` gives `["sigx", "reactivity"]`). */
export function splitScoped(name: string): [string, string] | null {
  if (!name.startsWith("@")) {
    return null;
  }
  const slash = name.indexOf("/");
  if (slash < 0) {
    return null;
  }
  return [name.slice(1, slash), name.slice(slash + 1)];
}

/** Whether `name` may name a package in `package.velt`: a package name or `@scope/name`. */
export function isValidDependencyName(name: string): bool {
  const scoped = splitScoped(name);
  if (scoped == null) {
    return isValidPackageName(name);
  }
  return isValidScopePart(scoped[0]) && isValidScopePart(scoped[1]);
}

/** Whether `name` is a valid registry user name: `[a-z][a-z0-9_-]*`, not a device name. */
export function isValidUserName(name: string): bool {
  return !isWindowsDeviceName(name) && name.length > 0 && isLower(name.slice(0, 1)) && restOk(name);
}

/** `name` with `-` turned into `_`: names that normalise the same share an export prefix. */
export function normalizedName(name: string): string {
  return name.replaceAll("-", "_");
}

function deviceName(name: string): string {
  return `the package name \`${name}\` is a device name on Windows (\`con\`, \`nul\`, \`com1\`, …)`;
}

function reserved(name: string): string {
  return `the package name \`${name}\` is reserved for the standard library`;
}

function nativePrefix(name: string): string {
  let first = name;
  for (const r of NATIVE_PREFIX_NAMES) {
    if (name.startsWith(r)) {
      first = r;
      break;
    }
  }
  return `the package name \`${name}\` is reserved: a package's native functions are named \`velt_<package>__…\`, and \`velt_${first}_…\` is Velt's own; rename the package (for example \`my-${name}\`)`;
}

function checkScopedName(name: string, what: string): string | null {
  if (isValidDependencyName(name)) {
    return null;
  }
  return `invalid scoped ${what} \`${name}\` (\`@scope/name\`, each part lowercase letters and digits with single \`-\` or \`_\` between words)`;
}

/** Why `name` can't be a package's `name`, or null when it can. */
export function checkName(name: string): string | null {
  if (name.startsWith("@")) {
    return checkScopedName(name, "package name");
  }
  if (RESERVED_NAMES.includes(name)) {
    return reserved(name);
  }
  if (isWindowsDeviceName(name)) {
    return deviceName(name);
  }
  if (isNativePrefixName(name)) {
    return nativePrefix(name);
  }
  if (isValidPackageName(name)) {
    return null;
  }
  return `invalid package name \`${name}\` (use lowercase letters and digits, starting with a letter, with single \`-\` or \`_\` between words: not doubled, mixed or at the end)`;
}

/** Why `name` can't be a dependency's name, or null when it can. */
export function checkDependencyName(name: string): string | null {
  if (name.startsWith("@")) {
    return checkScopedName(name, "dependency name");
  }
  if (RESERVED_NAMES.includes(name)) {
    return reserved(name);
  }
  if (isWindowsDeviceName(name)) {
    return deviceName(name);
  }
  if (isNativePrefixName(name)) {
    return nativePrefix(name);
  }
  if (isValidPackageName(name)) {
    return null;
  }
  return `invalid dependency name \`${name}\` (lowercase letters and digits, starting with a letter, with single \`-\` or \`_\` between words)`;
}

/** Why `name` can't be a registry user's name, or null when it can. */
export function checkUserName(name: string): string | null {
  if (isWindowsDeviceName(name)) {
    return `invalid user name \`${name}\`: it is a device name on Windows (\`con\`, \`nul\`, \`com1\`, …)`;
  }
  if (isValidUserName(name)) {
    return null;
  }
  return `invalid user name \`${name}\` (use lowercase letters, digits, \`-\` and \`_\`, starting with a letter)`;
}
