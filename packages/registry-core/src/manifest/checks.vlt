// registry-core (internal): the checks vpm applies to `package.vlt`'s fields
// (crates/vpm/src/manifest/mod.rs and the modules it calls). Each returns why a value is refused,
// or null; the messages are vpm's.

import { anyChar, componentsNormal, isControl, isWhitespace, trim } from "./chars";
import { Version } from "../semver/version";
import { isValidRequirement } from "../semver/requirement";

export const MAX_DESCRIPTION = 300;
export const MAX_KEYWORDS = 10;
export const MAX_KEYWORD = 32;

/** The targets a native library can be published for. */
export const NATIVE_TARGETS: string[] = [
  "x86_64-unknown-linux-gnu",
  "aarch64-unknown-linux-gnu",
  "x86_64-apple-darwin",
  "aarch64-apple-darwin",
  "x86_64-pc-windows-msvc",
  "aarch64-pc-windows-msvc",
];

/** The built-in conditions of conditional imports; `default` matches every build. */
export const CONDITIONS: string[] = [
  "native",
  "darwin",
  "linux",
  "win32",
  "wasm",
  "wasi",
  "js",
  "default",
];

/** Files a `--host` build writes itself (crates/vpm/src/host.rs `BUILD_FILES`, kept in step). */
const BUILD_FILES: string[] = [
  "program.wasm",
  "program.o",
  "program.entry.o",
  "program.wasm.build-stamp",
  "program.wasm.link-stamp",
  "velt_web.mjs",
  "velt_serve.mjs",
  "velt_modules.mjs",
  "hosts",
  ".velt-host",
];

function isLowerAscii(c: string): bool {
  return c.length == 1 && c >= "a" && c <= "z";
}

function isDigitAscii(c: string): bool {
  return c.length == 1 && c >= "0" && c <= "9";
}

function asciiLower(s: string): string {
  let out = "";
  for (const c of s) {
    out += c >= "A" && c <= "Z" && c.length == 1 ? c.toLowerCase() : c;
  }
  return out;
}

export function checkEntry(entry: string): string | null {
  const segments = entry.split("/");
  const inside =
    !entry.includes("\\") &&
    !entry.includes(":") &&
    segments.every((s: string): bool => s.length > 0 && s != "..") &&
    segments.some((s: string): bool => s != ".");
  return inside
    ? null
    : `entry \`${entry}\` must be a \`/\`-separated path to a file inside the package`;
}

export function checkRegistry(url: string): string | null {
  return url.startsWith("http://") || url.startsWith("https://")
    ? null
    : `registry \`${url}\` must be an http:// or https:// URL`;
}

/** Line and paragraph separators and format characters that reorder or hide text. */
function invisible(c: number): bool {
  return (
    c == 0xad ||
    c == 0x61c ||
    c == 0x180e ||
    (c >= 0x200b && c <= 0x200f) ||
    (c >= 0x2028 && c <= 0x202e) ||
    (c >= 0x2060 && c <= 0x2064) ||
    (c >= 0x2066 && c <= 0x206f) ||
    c == 0xfeff ||
    (c >= 0xfff9 && c <= 0xfffb)
  );
}

export function checkDescription(text: string): string | null {
  let chars = 0;
  let invisibleChar = -1;
  for (const c of text) {
    chars++;
    const cp = c.codePointAt(0) ?? 0;
    if (invisibleChar < 0 && invisible(cp)) {
      invisibleChar = cp;
    }
  }
  if (text.length == 0) {
    return "`description` is empty; remove the field instead";
  }
  if (chars > MAX_DESCRIPTION) {
    return `\`description\` has ${chars} characters; at most ${MAX_DESCRIPTION} are allowed (\`velt search\` shows the start of a long one)`;
  }
  if (anyChar(text, isControl)) {
    return "`description` must be one line (no line breaks, tabs or other control characters)";
  }
  if (invisibleChar >= 0) {
    const hex = invisibleChar.toString(16).toUpperCase().padStart(4, "0");
    return `\`description\` contains the invisible character U+${hex} (it can reorder or hide text where the description is shown)`;
  }
  if (trim(text) != text) {
    return "`description` starts or ends with whitespace";
  }
  return null;
}

export function checkKeyword(word: string): string | null {
  let ok = word.length <= MAX_KEYWORD && word.length > 0;
  let first = true;
  for (const c of word) {
    if (first) {
      ok = ok && (isLowerAscii(c) || isDigitAscii(c));
    } else {
      ok = ok && (isLowerAscii(c) || isDigitAscii(c) || c == "-");
    }
    first = false;
  }
  return ok
    ? null
    : `keyword \`${word}\` must be lowercase letters, digits and \`-\`, starting with a letter or digit (at most ${MAX_KEYWORD} characters)`;
}

export function checkVersion(version: string): string | null {
  try {
    Version.parse(version);
    return null;
  } catch (e) {
    return `version \`${version}\` is not a semver version: ${e.message}`;
  }
}

/** `velt`: a toolchain requirement (velt_toolchain's `Requirement`: a bare version means `~`). */
export function checkToolchain(requirement: string): string | null {
  const trimmed = trim(requirement);
  if (trimmed.length == 0) {
    return "velt the version requirement is empty (write one such as `\"0.1\"`, or leave the field out)";
  }
  const source = isDigitAscii(trimmed.slice(0, 1)) ? `~${trimmed}` : trimmed;
  return isValidRequirement(source) ? null : `velt \`${requirement}\` is not a version requirement`;
}

export function checkCpu(cpu: string): string | null {
  let ok = cpu.length > 0;
  for (const c of cpu) {
    ok = ok && (isLowerAscii(c) || isDigitAscii(c) || c == "-" || c == ".");
  }
  return ok
    ? null
    : `build.cpu \`${cpu}\` is not a CPU name (such as \`x86-64-v3\`, \`native\` or \`znver4\`)`;
}

export function checkImportSource(source: string): string | null {
  return source.length == 0 || source.endsWith("/") || source.includes("\\")
    ? `importSource \`${source}\` is not a module specifier`
    : null;
}

export function checkNativePath(path: string): string | null {
  let ok = path.length > 0 && !path.startsWith(".") && path != "src" && path != "target";
  for (const c of path) {
    ok = ok && c.length == 1 && (/[A-Za-z0-9_.-]/.test(c));
  }
  return ok
    ? null
    : `path \`${path}\` must be the name of a directory in the package root (not \`src\` or \`target\`)`;
}

export function checkNativeTarget(target: string): string | null {
  return NATIVE_TARGETS.includes(target)
    ? null
    : `target \`${target}\` is not supported (supported: ${NATIVE_TARGETS.join(", ")})`;
}

/** Whether `name` is an identifier a `define` can replace. */
export function isDefineName(name: string): bool {
  let first = true;
  let ok = name.length > 0;
  for (const c of name) {
    const letter = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") || c == "_" || c == "$";
    ok = ok && c.length == 1 && (letter || (!first && isDigitAscii(c)));
    first = false;
  }
  return ok;
}

/** A source file name: `.vlt`, `.ts` or `.tsx` after a stem, not a `.d.ts`. */
export function isSourceName(name: string): bool {
  if (name.endsWith(".d.ts")) {
    return false;
  }
  for (const ext of [".vlt", ".ts", ".tsx"]) {
    if (name.endsWith(ext)) {
      const stem = name.slice(0, name.length - ext.length);
      if (stem.length > 0 && !stem.endsWith("/")) {
        return true;
      }
    }
  }
  return false;
}

export function isBuildFile(name: string): bool {
  const lower = asciiLower(name);
  return BUILD_FILES.some((f: string): bool => f == lower);
}

/** A host's triple: not empty, no whitespace, at least two `-`-separated parts. */
export function checkHostTarget(target: string): string | null {
  return target.length == 0 || anyChar(target, isWhitespace) || target.split("-").length < 2
    ? `\`${target}\` is not a target triple (\`wasm32-unknown-unknown\`)`
    : null;
}

/** A host module's (or a host's entry's) file: `./src/….mjs` or `.js`. */
export function checkModuleFile(file: string, what: string): string | null {
  if (!file.startsWith("./")) {
    return `\`${file}\`: ${what} is a \`./\`-relative path (\`./src/m.mjs\`)`;
  }
  const rel = file.slice(2);
  if (rel.includes("\\") || !componentsNormal(rel, false) || !rel.startsWith("src/")) {
    return `\`${file}\`: ${what} is a \`/\`-separated path below \`./src/\` (a package's archive carries only \`src/\`)`;
  }
  if (!(rel.endsWith(".mjs") || rel.endsWith(".js"))) {
    return `\`${file}\`: ${what} is a JavaScript module, \`.mjs\` or \`.js\``;
  }
  return null;
}

export function checkHostEntry(entry: string): string | null {
  const bad = checkModuleFile(entry, "the entry");
  if (bad != null) {
    return bad;
  }
  const parts = entry.split("/");
  const name = parts[parts.length - 1];
  return isBuildFile(name)
    ? `\`${entry}\`: the build writes its own \`${name}\`; name the entry otherwise`
    : null;
}

/** A path with no empty segment, `\`, root or `..` (`Component::Normal` only). */
function normalPath(p: string): bool {
  return p.length > 0 &&
    !p.includes("\\") &&
    p.split("/").every((c: string): bool => c.length > 0) &&
    componentsNormal(p, false);
}

export function checkScaffold(path: string, file: string, entry: string): string | null {
  const first = path.split("/")[0];
  const entryParts = entry.split("/");
  const entryName = entryParts[entryParts.length - 1];
  if (!normalPath(path)) {
    return `\`${path}\`: a scaffolded file is a \`/\`-separated path inside the build's directory`;
  }
  if (isBuildFile(first) || asciiLower(first) == asciiLower(entryName)) {
    return `\`${path}\` is a file the build writes itself: scaffold another one`;
  }
  const inside =
    file.startsWith("./") && normalPath(file.slice(2)) && file.slice(2).startsWith("src/");
  return inside
    ? null
    : `\`${file}\`: a scaffolded file comes from the package, a \`./\`-relative path below \`./src/\` (a package's archive carries only \`src/\`)`;
}

export function checkHostModuleName(name: string): string | null {
  if (name.length == 0) {
    return "a host module needs a name";
  }
  if (anyChar(name, isControl)) {
    return "a host module name cannot hold control characters";
  }
  if (name == "__proto__") {
    return "`__proto__` cannot name a host module: choose another name";
  }
  if (name == "velt" || name.startsWith("velt:")) {
    return `\`${name}\` is the runtime glue's own host module: a package cannot provide it`;
  }
  return null;
}

/** A host's own condition: a lowercase letter, then lowercase letters, digits and `-`. */
export function conditionSpelling(c: string): bool {
  let first = true;
  let ok = c.length > 0;
  for (const ch of c) {
    ok = ok && (isLowerAscii(ch) || (!first && (isDigitAscii(ch) || ch == "-")));
    first = false;
  }
  return ok;
}

export function checkHostCondition(condition: string): string | null {
  if (CONDITIONS.includes(condition)) {
    return `\`${condition}\` is a built-in condition, which the target sets: name the host's own`;
  }
  return conditionSpelling(condition)
    ? null
    : `\`${condition}\`: a host's condition is a lowercase letter, then lowercase letters, digits and \`-\``;
}

/** A conditional import's name: `#` and `/`-separated words of ASCII letters, digits, `_`, `-`. */
export function checkImportKey(key: string): string | null {
  const name = key.startsWith("#") ? key.slice(1) : null;
  const ok =
    name != null &&
    name.length > 0 &&
    name.split("/").every((seg: string): bool => seg.length > 0 && /^[A-Za-z0-9_-]+$/.test(seg));
  if (ok) {
    return null;
  }
  return key.includes("*")
    ? `\`${key}\`: patterns (\`#name/*\`) are not supported: list each name (\`#io/file\`)`
    : `\`${key}\` is not a conditional import: write \`#\` and a name (\`#transport\`, \`#io/file\`)`;
}

export function checkCondition(condition: string): string | null {
  return CONDITIONS.includes(condition) || conditionSpelling(condition)
    ? null
    : `\`${condition}\` is not a condition: the built-in ones are ${CONDITIONS.join(", ")}, and a host package's is lowercase letters, digits and \`-\``;
}

export function checkImportTarget(target: string): string | null {
  if (!target.startsWith("./")) {
    return `\`${target}\`: a variant is a \`./\`-relative path (\`./src/x.vlt\`)`;
  }
  const rel = target.slice(2);
  if (rel.includes("\\") || !componentsNormal(rel, false)) {
    return `\`${target}\`: a variant must be a \`/\`-separated path inside the package`;
  }
  if (!rel.startsWith("src/")) {
    return `\`${target}\`: a variant is one of the package's modules, below \`./src/\``;
  }
  if (!isSourceName(rel)) {
    return `\`${target}\`: name the file with its extension (\`.vlt\`, \`.ts\` or \`.tsx\`)`;
  }
  return null;
}

/** `*` only once, at the end. */
function wildcardOk(s: string): bool {
  const stars = s.split("*").length - 1;
  return stars == (s.endsWith("*") ? 1 : 0);
}

export function checkAlias(pattern: string, target: string): string | null {
  if (pattern.length == 0 || pattern == "*") {
    return "the pattern needs a prefix such as `@app/*`";
  }
  if (pattern.startsWith("./") || pattern.startsWith("../") || pattern.startsWith("velt/")) {
    return "relative and `velt/` specifiers cannot be aliased";
  }
  if (!wildcardOk(pattern) || !wildcardOk(target)) {
    return "`*` may only appear once, at the end";
  }
  if (pattern.endsWith("*") != target.endsWith("*")) {
    return "the pattern and its target must both end in `*`, or neither";
  }
  let dir = target;
  while (dir.endsWith("*")) {
    dir = dir.slice(0, dir.length - 1);
  }
  if (!componentsNormal(dir, true) || target.includes("\\")) {
    return "the target must be a `/`-separated path inside the package";
  }
  return null;
}

export { isValidRequirement };
