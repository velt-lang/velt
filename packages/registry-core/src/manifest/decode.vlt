// registry-core (internal): `package.vlt`'s data decoded into a `Manifest`, every field checked
// where vpm checks it (crates/vpm/src/manifest/read.rs `manifest` and its sub-readers). Every
// problem is collected; `readManifest` throws them together.

import { Data, DataKind } from "./data";
import { Dependency } from "./dependency";
import { Manifest } from "./manifest";
import { Problems } from "./problems";
import { ManifestError } from "./manifest_error";
import { parseManifest } from "./parser";
import { decodeHost, decodeHostModules, decodeImports, decodeNative } from "./sections";
import {
  checkAlias,
  checkCpu,
  checkDescription,
  checkEntry,
  checkImportSource,
  checkKeyword,
  checkRegistry,
  checkToolchain,
  checkVersion,
  isDefineName,
  MAX_KEYWORDS,
} from "./checks";
import { checkDependency, checkTsCompat, isDefineLiteral } from "./fields";
import { checkDependencyName, checkName, splitScoped } from "../names";

/** Decodes one manifest's data, collecting problems. */
class Decoder {
  p: Problems = new Problems();

  /** The manifest of `value`, `pkg`'s data. */
  manifest(value: Data): Manifest {
    const m = new Manifest();
    if (!this.p.object(value, "the manifest")) {
      return m;
    }
    let name = false;
    let version = false;
    for (let i = 0; i < value.keys.length; i++) {
      const key = value.keys[i];
      const v = value.items[i];
      if (key == "name") {
        name = true;
        const s = this.p.string(v, "name");
        if (s != null) {
          this.p.check(checkName(s));
          m.name = s;
        }
      } else if (key == "version") {
        version = true;
        const s = this.p.string(v, "version");
        if (s != null) {
          this.p.check(checkVersion(s));
          m.version = s;
        }
      } else if (key == "velt") {
        const s = this.p.string(v, "velt");
        if (s != null) {
          this.p.check(checkToolchain(s));
          m.toolchain = s;
        }
      } else if (key == "description") {
        const s = this.p.string(v, "description");
        if (s != null) {
          this.p.check(checkDescription(s));
          m.description = s;
        }
      } else if (key == "keywords") {
        m.keywords = this.keywords(v);
      } else if (key == "entry") {
        const s = this.p.string(v, "entry");
        if (s != null) {
          this.p.check(checkEntry(s));
          m.entry = s;
        }
      } else if (key == "registry") {
        const s = this.p.string(v, "registry");
        if (s != null) {
          this.p.check(checkRegistry(s));
          m.registry = s;
        }
      } else if (key == "dependencies") {
        m.dependencies = this.dependencies(v);
      } else if (key == "paths") {
        m.paths = this.paths(v);
      } else if (key == "imports") {
        m.imports = decodeImports(this.p, v);
      } else if (key == "hostModules") {
        m.hostModules = decodeHostModules(this.p, v);
      } else if (key == "host") {
        m.host = decodeHost(this.p, v);
      } else if (key == "jsx") {
        this.jsx(v, m);
      } else if (key == "define") {
        m.define = this.define(v);
      } else if (key == "native") {
        m.native = decodeNative(this.p, v);
      } else if (key == "tsCompat") {
        m.tsCompat = this.tsCompat(v);
      } else if (key == "build") {
        this.build(v, m);
      } else {
        this.p.unknown(key);
      }
    }
    if (!name) {
      this.p.problems.push("the manifest is missing `name`");
    }
    if (!version) {
      this.p.problems.push("the manifest is missing `version`");
    }
    if (m.native != null && splitScoped(m.name) != null) {
      this.p.problems.push(
        "a package with a scoped name (`@scope/name`) cannot have `native` code yet",
      );
    }
    return m;
  }

  private keywords(v: Data): string[] {
    if (v.kind != DataKind.Array) {
      this.p.problems.push(`\`keywords\` must be an array, not ${v.describe()}`);
      return [];
    }
    if (v.items.length == 0) {
      this.p.problems.push("`keywords` is empty; remove the field instead");
    } else if (v.items.length > MAX_KEYWORDS) {
      this.p.problems.push(
        `\`keywords\` has ${v.items.length} entries; at most ${MAX_KEYWORDS} are allowed`,
      );
    }
    const words: string[] = [];
    for (const e of v.items) {
      if (e.kind != DataKind.Str) {
        this.p.problems.push(`\`keywords\` entries must be strings, not ${e.describe()}`);
        continue;
      }
      if (words.includes(e.str)) {
        this.p.problems.push(`duplicate keyword \`${e.str}\``);
        continue;
      }
      this.p.check(checkKeyword(e.str));
      words.push(e.str);
    }
    return words;
  }

  private dependencies(v: Data): Map<string, Dependency> {
    const out: Map<string, Dependency> = new Map();
    if (!this.p.object(v, "`dependencies`")) {
      return out;
    }
    for (let i = 0; i < v.keys.length; i++) {
      const name = v.keys[i];
      const value = v.items[i];
      this.p.check(checkDependencyName(name));
      const dep: Dependency = {
        simple: null,
        version: null,
        path: null,
        git: null,
        branch: null,
        tag: null,
        rev: null,
      };
      if (value.kind == DataKind.Str) {
        dep.simple = value.str;
      } else if (value.kind == DataKind.Object) {
        for (let k = 0; k < value.keys.length; k++) {
          const field = value.keys[k];
          if (!["version", "path", "git", "branch", "tag", "rev"].includes(field)) {
            this.p.unknown(field);
            continue;
          }
          const s = this.p.string(value.items[k], field);
          if (field == "version") {
            dep.version = s;
          } else if (field == "path") {
            dep.path = s;
          } else if (field == "git") {
            dep.git = s;
          } else if (field == "branch") {
            dep.branch = s;
          } else if (field == "tag") {
            dep.tag = s;
          } else {
            dep.rev = s;
          }
        }
      } else {
        this.p.problems.push(
          `dependency \`${name}\` must be a version requirement or an object, not ${value.describe()}`,
        );
        continue;
      }
      this.p.check(checkDependency(name, dep));
      out.set(name, dep);
    }
    return out;
  }

  private paths(v: Data): Map<string, string> {
    const out: Map<string, string> = new Map();
    if (!this.p.object(v, "`paths`")) {
      return out;
    }
    for (let i = 0; i < v.keys.length; i++) {
      const target = this.p.string(v.items[i], v.keys[i]);
      if (target == null) {
        continue;
      }
      const why = checkAlias(v.keys[i], target);
      if (why != null) {
        this.p.problems.push(`alias \`${v.keys[i]}\`: ${why}`);
      }
      out.set(v.keys[i], target);
    }
    return out;
  }

  private jsx(v: Data, m: Manifest): void {
    if (!this.p.object(v, "`jsx`")) {
      return;
    }
    m.jsx = true;
    for (let i = 0; i < v.keys.length; i++) {
      if (v.keys[i] != "importSource") {
        this.p.unknown(v.keys[i]);
        continue;
      }
      const s = this.p.string(v.items[i], "importSource");
      if (s != null) {
        this.p.check(checkImportSource(s));
        m.importSource = s;
      }
    }
  }

  private define(v: Data): Map<string, string> {
    const out: Map<string, string> = new Map();
    if (!this.p.object(v, "`define`")) {
      return out;
    }
    for (let i = 0; i < v.keys.length; i++) {
      const name = v.keys[i];
      if (!isDefineName(name)) {
        this.p.problems.push(`define \`${name}\`: the name must be an identifier`);
      }
      const text = this.p.string(v.items[i], name);
      if (text == null) {
        continue;
      }
      if (!isDefineLiteral(text)) {
        this.p.problems.push(`define \`${name}\`: \`${text}\` is not a literal`);
      }
      out.set(name, text);
    }
    return out;
  }

  private tsCompat(v: Data): string[] {
    if (v.kind != DataKind.Array) {
      this.p.problems.push(`\`tsCompat\` must be an array, not ${v.describe()}`);
      return [];
    }
    if (v.items.length == 0) {
      this.p.problems.push("`tsCompat` is empty; remove the field instead");
    }
    const dirs: string[] = [];
    for (const e of v.items) {
      if (e.kind != DataKind.Str) {
        this.p.problems.push(`\`tsCompat\` entries must be strings, not ${e.describe()}`);
        continue;
      }
      const why = checkTsCompat(e.str, dirs);
      if (why != null) {
        this.p.problems.push(why);
        continue;
      }
      dirs.push(e.str);
    }
    return dirs;
  }

  private build(v: Data, m: Manifest): void {
    if (!this.p.object(v, "`build`")) {
      return;
    }
    m.build = true;
    for (let i = 0; i < v.keys.length; i++) {
      if (v.keys[i] != "cpu") {
        this.p.unknown(v.keys[i]);
        continue;
      }
      const s = this.p.string(v.items[i], "cpu");
      if (s != null) {
        this.p.check(checkCpu(s));
        m.cpu = s;
      }
    }
  }
}

/**
 * The manifest `src` (a `package.vlt`'s text) declares; throws `ManifestError` with every problem
 * when vpm would refuse it.
 */
export function readManifest(src: string): Manifest {
  const decoder = new Decoder();
  const m = decoder.manifest(parseManifest(src));
  if (decoder.p.problems.length > 0) {
    throw new ManifestError(decoder.p.problems.join("\n"));
  }
  return m;
}
