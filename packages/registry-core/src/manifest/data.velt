// registry-core (internal): a data value of `package.velt` (vpm's `Value`): a string, a number, a
// boolean, an array, or an object whose keys keep the order they were written in.

/** What a data value is. */
export enum DataKind {
  Str,
  Num,
  Bool,
  Array,
  Object,
}

/** One data value. */
export class Data {
  readonly kind: DataKind;
  /** A string's value. */
  readonly str: string;
  /** A boolean's value. */
  readonly bool: bool;
  /** An array's elements, or an object's values. */
  readonly items: Data[];
  /** An object's keys, one per value in `items`. */
  readonly keys: string[];

  constructor(kind: DataKind, str: string, bool: bool, items: Data[], keys: string[]) {
    this.kind = kind;
    this.str = str;
    this.bool = bool;
    this.items = items;
    this.keys = keys;
  }

  /** What it is, as vpm's messages say: "a string", "an object", ... */
  describe(): string {
    if (this.kind == DataKind.Str) {
      return "a string";
    }
    if (this.kind == DataKind.Num) {
      return "a number";
    }
    if (this.kind == DataKind.Bool) {
      return "a boolean";
    }
    return this.kind == DataKind.Array ? "an array" : "an object";
  }
}
