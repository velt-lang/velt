// registry-core (internal): part of a package's manifest (./manifest.vlt).

/** One `dependencies` entry: a requirement (`simple`), or an object of its fields. */
export struct Dependency {
  simple: string | null;
  version: string | null;
  path: string | null;
  git: string | null;
  branch: string | null;
  tag: string | null;
  rev: string | null;
}
