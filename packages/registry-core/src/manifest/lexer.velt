// registry-core (internal): `package.velt`'s text as tokens (./token.velt), byte by byte over its
// UTF-8 as the Velt lexer scans it. `tokens` returns null for text the Velt lexer reports an
// error in (an unterminated string or comment, a bad escape or number), and an `Other` token for
// a character that can only start something outside the data subset.

import { utf8Decode } from "velt/encoding";
import { Token, TokenKind } from "./token";

function isIdentStart(b: u8): bool {
  return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 36;
}

function isIdentContinue(b: u8): bool {
  return isIdentStart(b) || (b >= 48 && b <= 57);
}

function isDigit(b: u8): bool {
  return b >= 48 && b <= 57;
}

function hexValue(b: u8): i32 {
  if (b >= 48 && b <= 57) {
    return (b - 48) as i32;
  }
  if (b >= 97 && b <= 102) {
    return (b - 87) as i32;
  }
  if (b >= 65 && b <= 70) {
    return (b - 55) as i32;
  }
  return -1;
}

/** The single-character punctuation the data subset uses. */
const PUNCT = "{}[](),:;=-";

/** Scans one source text. */
class Lexer {
  private src: u8[];
  private pos: i64 = 0;
  /** Set when the Velt lexer would report an error. */
  failed: bool = false;

  constructor(src: u8[]) {
    this.src = src;
    // A UTF-8 byte-order mark at the start is skipped.
    if (src.length >= 3 && src[0] == 0xef && src[1] == 0xbb && src[2] == 0xbf) {
      this.pos = 3;
    }
  }

  private at(k: i64): u8 {
    const i = this.pos + k;
    return i < (this.src.length as i64) ? this.src[i] : 0;
  }

  private atLineSeparator(): bool {
    return this.at(0) == 0xe2 && this.at(1) == 0x80 && (this.at(2) == 0xa8 || this.at(2) == 0xa9);
  }

  private text(from: i64, to: i64): string {
    return utf8Decode(this.src.slice(from, to));
  }

  /** Skips whitespace and comments; whether a line break was among them. */
  private trivia(): bool {
    let line = false;
    for (;;) {
      const b = this.at(0);
      if (this.pos >= (this.src.length as i64)) {
        return line;
      }
      if (b == 32 || b == 9 || b == 11 || b == 12) {
        this.pos++;
      } else if (b == 10 || b == 13) {
        line = true;
        this.pos++;
      } else if (this.atLineSeparator()) {
        line = true;
        this.pos += 3;
      } else if (b == 47 && this.at(1) == 47) {
        while (this.pos < (this.src.length as i64) && this.at(0) != 10 && !this.atLineSeparator()) {
          this.pos++;
        }
      } else if (b == 47 && this.at(1) == 42) {
        this.pos += 2;
        for (;;) {
          if (this.pos >= (this.src.length as i64)) {
            this.failed = true;
            return line;
          }
          if (this.at(0) == 42 && this.at(1) == 47) {
            this.pos += 2;
            break;
          }
          if (this.at(0) == 10 || this.at(0) == 13 || this.atLineSeparator()) {
            line = true;
          }
          this.pos++;
        }
      } else {
        return line;
      }
    }
  }

  /** The next token. */
  next(): Token {
    const line = this.trivia();
    if (this.pos >= (this.src.length as i64)) {
      return new Token(TokenKind.End, "", line);
    }
    const b = this.at(0);
    if (isIdentStart(b)) {
      const start = this.pos;
      while (isIdentContinue(this.at(0)) && this.pos < (this.src.length as i64)) {
        this.pos++;
      }
      return new Token(TokenKind.Word, this.text(start, this.pos), line);
    }
    if (b == 34 || b == 39) {
      return new Token(TokenKind.Str, this.string(b), line);
    }
    if (isDigit(b) || (b == 46 && isDigit(this.at(1)))) {
      const start = this.pos;
      const end = this.number();
      return new Token(TokenKind.Num, this.text(start, end), line, this.text(end, this.pos));
    }
    const c = String.fromCharCode(b as number);
    if (b < 128 && PUNCT.includes(c)) {
      this.pos++;
      return new Token(TokenKind.Punct, c, line);
    }
    // Anything else: an operator, `.`, a template, a regex, `#`, `@`, a non-ASCII character...
    this.pos++;
    return new Token(TokenKind.Other, c, line);
  }

  /** A string literal from its opening `quote`: its cooked value. */
  private string(quote: u8): string {
    this.pos++;
    let out = "";
    let run = this.pos;
    for (;;) {
      if (this.pos >= (this.src.length as i64) || this.at(0) == 10 || this.at(0) == 13) {
        this.failed = true;
        return out;
      }
      const c = this.at(0);
      if (c == quote) {
        out += this.text(run, this.pos);
        this.pos++;
        return out;
      }
      if (c == 92) {
        out += this.text(run, this.pos);
        out += this.escape();
        run = this.pos;
        continue;
      }
      this.pos++;
    }
  }

  /** The escape at a backslash, cooked as ECMAScript's strict mode does. */
  private escape(): string {
    this.pos++;
    const c = this.at(0);
    if (this.pos >= (this.src.length as i64)) {
      return "";
    }
    if (c == 110) {
      this.pos++;
      return "\n";
    }
    if (c == 114) {
      this.pos++;
      return "\r";
    }
    if (c == 116) {
      this.pos++;
      return "\t";
    }
    if (c == 98) {
      this.pos++;
      return "\u{8}";
    }
    if (c == 118) {
      this.pos++;
      return "\u{b}";
    }
    if (c == 102) {
      this.pos++;
      return "\u{c}";
    }
    if (c == 48 && !isDigit(this.at(1))) {
      this.pos++;
      return "\u{0}";
    }
    if (c == 120) {
      this.pos++;
      let value = 0;
      for (let i = 0; i < 2; i++) {
        const d = hexValue(this.at(0));
        if (d < 0) {
          this.failed = true;
          return "";
        }
        value = value * 16 + d;
        this.pos++;
      }
      return String.fromCodePoint(value);
    }
    if (c == 117) {
      return this.unicode();
    }
    if (isDigit(c)) {
      // Legacy octal escapes and `\8`, `\9`: errors in strict code.
      this.failed = true;
      this.pos++;
      return "";
    }
    if (c == 10) {
      this.pos++;
      return "";
    }
    if (c == 13) {
      this.pos += this.at(1) == 10 ? 2 : 1;
      return "";
    }
    if (this.atLineSeparator()) {
      this.pos += 3;
      return "";
    }
    // Any other character stands for itself: one whole UTF-8 sequence.
    const start = this.pos;
    this.pos++;
    while (this.pos < (this.src.length as i64) && (this.at(0) & 0xc0) == 0x80) {
      this.pos++;
    }
    return this.text(start, this.pos);
  }

  /** `\u{H..}` or `\uHHHH`, at the `u`; a surrogate pair written as two escapes is one character. */
  private unicode(): string {
    const value = this.unicodeValue();
    if (value < 0) {
      this.failed = true;
      return "";
    }
    if (value >= 0xd800 && value < 0xdc00) {
      const save = this.pos;
      if (this.at(0) == 92 && this.at(1) == 117) {
        this.pos++;
        const low = this.unicodeValue();
        if (low >= 0xdc00 && low <= 0xdfff) {
          return String.fromCodePoint(0x10000 + (value - 0xd800) * 1024 + (low - 0xdc00));
        }
      }
      this.pos = save;
    }
    if (value >= 0xd800 && value <= 0xdfff) {
      this.failed = true;
      return "";
    }
    return String.fromCodePoint(value);
  }

  /** The value of `\u…` with `pos` at the `u` (moved past it), or -1 when malformed. */
  private unicodeValue(): number {
    this.pos++;
    if (this.at(0) == 123) {
      this.pos++;
      const digits = this.pos;
      let value = 0;
      while (hexValue(this.at(0)) >= 0) {
        value = value * 16 + hexValue(this.at(0));
        if (value > 0x10ffff) {
          value = 0x110000;
        }
        this.pos++;
      }
      if (this.pos == digits || value > 0x10ffff || this.at(0) != 125) {
        return -1;
      }
      this.pos++;
      return value;
    }
    let value = 0;
    for (let i = 0; i < 4; i++) {
      const d = hexValue(this.at(0));
      if (d < 0) {
        return -1;
      }
      value = value * 16 + d;
      this.pos++;
    }
    return value;
  }

  /**
   * Moves past a number literal (`_` separators included) and the word glued to it (its type
   * suffix), returning where the number's digits end. The Velt lexer's errors (no digits after
   * `0x`, a digit beyond the base) set `failed`; which numbers a key may be is the parser's
   * (./number_key.velt).
   */
  private number(): i64 {
    const radix = this.at(0) == 48 ? this.radixOf(this.at(1)) : 10;
    if (radix != 10) {
      this.pos += 2;
      let digits = 0;
      for (;;) {
        const c = this.at(0);
        if (c == 95) {
          this.pos++;
          continue;
        }
        const d = hexValue(c);
        if (d < 0 || (!isDigit(c) && radix != 16)) {
          break;
        }
        if (d >= radix) {
          this.failed = true;
        }
        digits++;
        this.pos++;
      }
      if (digits == 0) {
        this.failed = true;
      }
    } else {
      this.digits();
      if (this.at(0) == 46 && isDigit(this.at(1))) {
        this.pos++;
        this.digits();
      }
      const exponentDigit =
        isDigit(this.at(1)) || ((this.at(1) == 43 || this.at(1) == 45) && isDigit(this.at(2)));
      if ((this.at(0) == 101 || this.at(0) == 69) && exponentDigit) {
        this.pos += 2;
        this.digits();
      }
    }
    const end = this.pos;
    // A word glued to the number is its type suffix (valid or not).
    if (isIdentStart(this.at(0))) {
      while (isIdentContinue(this.at(0)) && this.pos < (this.src.length as i64)) {
        this.pos++;
      }
    }
    return end;
  }

  private radixOf(b: u8): i32 {
    if (b == 120 || b == 88) {
      return 16;
    }
    if (b == 98 || b == 66) {
      return 2;
    }
    if (b == 111 || b == 79) {
      return 8;
    }
    return 10;
  }

  private digits(): void {
    while (this.pos < (this.src.length as i64) && (isDigit(this.at(0)) || this.at(0) == 95)) {
      this.pos++;
    }
  }
}

/** The tokens of `src` (UTF-8), ending with `End`; null when the Velt lexer reports an error. */
export function tokens(src: u8[]): Token[] | null {
  const lexer = new Lexer(src);
  const out: Token[] = [];
  for (;;) {
    const t = lexer.next();
    if (lexer.failed) {
      return null;
    }
    out.push(t);
    if (t.kind == TokenKind.End) {
      return out;
    }
  }
}
