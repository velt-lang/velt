// registry-core (internal): the words a symbol key's brackets may hold, as the Velt parser
// decides (crates/velt_syntax/src/lexer/token.rs, crates/velt_syntax/src/ast_names.rs).

/** The Velt lexer's keywords, which a module constant's name can't be. */
export const KEYWORDS: string[] = [
  "as",
  "async",
  "await",
  "break",
  "case",
  "catch",
  "class",
  "const",
  "constructor",
  "continue",
  "declare",
  "default",
  "do",
  "else",
  "enum",
  "export",
  "extends",
  "false",
  "finally",
  "for",
  "from",
  "function",
  "if",
  "implements",
  "import",
  "in",
  "instanceof",
  "interface",
  "let",
  "new",
  "null",
  "of",
  "readonly",
  "return",
  "shared",
  "static",
  "struct",
  "switch",
  "this",
  "throw",
  "true",
  "try",
  "type",
  "typeof",
  "void",
  "while",
  "yield",
];

/** The symbols `[Symbol.<name>]` may name: JavaScript's well-known ones and Velt's operators. */
export const WELL_KNOWN_SYMBOLS: string[] = [
  "asyncDispose",
  "asyncIterator",
  "dispose",
  "hasInstance",
  "isConcatSpreadable",
  "iterator",
  "match",
  "matchAll",
  "replace",
  "search",
  "species",
  "split",
  "toPrimitive",
  "toStringTag",
  "unscopables",
  "add",
  "sub",
  "mul",
  "div",
  "rem",
  "pow",
  "bitAnd",
  "bitOr",
  "bitXor",
  "shl",
  "shr",
  "ushr",
  "neg",
  "bitNot",
  "addAssign",
  "subAssign",
  "mulAssign",
  "divAssign",
  "remAssign",
  "powAssign",
  "bitAndAssign",
  "bitOrAssign",
  "bitXorAssign",
  "shlAssign",
  "shrAssign",
  "ushrAssign",
  "index",
  "setIndex",
];

/** The keywords reserved only in context, which may still name a binding. */
export const SOFT_KEYWORDS: string[] = [
  "as",
  "case",
  "constructor",
  "declare",
  "default",
  "from",
  "implements",
  "in",
  "of",
  "readonly",
  "shared",
  "static",
  "type",
];
