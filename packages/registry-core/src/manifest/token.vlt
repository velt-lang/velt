// registry-core (internal): the tokens of `package.vlt` that the manifest's data subset is made
// of, read as the Velt lexer (crates/velt_syntax/src/lexer) reads them: ASCII identifiers and
// whitespace, `//` and `/* */` comments, strings in either quote with ECMAScript's escapes, and
// numbers (which only a numeric key can use). Every other character becomes an `other` token,
// which no manifest may contain: the lexer would report it, or the parser would find a
// construct outside the data subset.

/** What a token is. */
export enum TokenKind {
  Word,
  Str,
  Num,
  Punct,
  Other,
  End,
}

/**
 * One token: its kind, its text (a string's cooked value, a number's digits), whether a line break
 * precedes it, and for a number the word glued to it (its type suffix, valid or not).
 */
export class Token {
  readonly kind: TokenKind;
  readonly text: string;
  readonly lineBefore: bool;
  readonly suffix: string;

  constructor(kind: TokenKind, text: string, lineBefore: bool, suffix: string = "") {
    this.kind = kind;
    this.text = text;
    this.lineBefore = lineBefore;
    this.suffix = suffix;
  }

  is(kind: TokenKind, text: string): bool {
    return this.kind == kind && this.text == text;
  }
}
