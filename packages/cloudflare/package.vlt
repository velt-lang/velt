import type { Package } from "velt/package";

export const pkg: Package = {
  name: "cloudflare",
  version: "0.1.0",
  description:
    "Cloudflare's bindings for Velt programs on Workers: R2, D1, KV, the cache and Durable Objects",
  // The JavaScript of the host module `cloudflare` (src/host.vlt declares its functions), which
  // `velt build --host host-cloudflare` copies into the Worker.
  hostModules: { cloudflare: "./src/cloudflare.mjs" },
};
