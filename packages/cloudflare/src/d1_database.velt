// cloudflare (internal): D1, Cloudflare's SQLite database, as the Workers API has it: a database
// makes statements (`prepare`, src/d1_prepared_statement.velt), runs several in one transaction
// (`batch`) and runs SQL without parameters (`exec`). Parameters and rows cross in frames
// (src/frame_writer.velt, src/d1_rows.velt).

import { d1Batch, d1Exec } from "./host";
import { FrameReader } from "./frame_reader";
import { FrameWriter } from "./frame_writer";
import { D1Rows } from "./d1_rows";
import { D1BatchResult } from "./d1_batch_result";
import { D1PreparedStatement } from "./d1_prepared_statement";

/** The outcome of `exec(sql)`: how many statements ran, and how long they took. */
export interface D1ExecResult {
  count: i64;
  duration: f64;
}

/** A D1 database: the binding `binding` of the Worker's env (`d1Database("DB")`). */
export class D1Database {
  readonly binding: string;

  constructor(binding: string) {
    this.binding = binding;
  }

  /** A statement of `sql`, without parameters yet (`bind`). Nothing is sent until it runs. */
  prepare(sql: string): D1PreparedStatement {
    return new D1PreparedStatement(this.binding, sql, []);
  }

  /**
   * Runs `statements` in one transaction (all of them or none): their results in order. Rows are
   * read per result, `results<T>()`, since each statement has its own.
   */
  async batch(statements: D1PreparedStatement[]): Promise<D1BatchResult[]> {
    const w = new FrameWriter();
    w.u32(statements.length as u32);
    for (const s of statements) {
      w.text(s.sql);
      w.params(s.params);
    }
    const frame = new FrameReader(await d1Batch(this.binding, w.bytes));
    const out: D1BatchResult[] = [];
    for (let n = frame.u32(); n > 0; n--) {
      // Each result has its length first.
      frame.u32();
      const rows = D1Rows.parse(frame);
      out.push(new D1BatchResult(rows));
    }
    return out;
  }

  /** Runs `sql`, one or more statements without parameters, and gives no rows (migrations). */
  async exec(sql: string): Promise<D1ExecResult> {
    return JSON.parse<D1ExecResult>(await d1Exec(this.binding, sql));
  }
}
