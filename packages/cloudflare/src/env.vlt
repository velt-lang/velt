// cloudflare (internal): the Worker's bindings by the names they have in its env (wrangler.toml's
// `binding = "…"`). Making a wrapper looks nothing up: each call finds the binding in the env of
// the request it runs in, and rejects with `IoError` "ENOENT" when the env has none of that kind.

import { D1Database } from "./d1";
import { DurableObjectNamespace } from "./durable";
import { KVNamespace } from "./kv";
import { R2Bucket } from "./r2";

/** The R2 bucket bound as `name` (`env.BUCKET` in JavaScript: `r2Bucket("BUCKET")`). */
export function r2Bucket(name: string): R2Bucket {
  return new R2Bucket(name);
}

/** The D1 database bound as `name`. */
export function d1Database(name: string): D1Database {
  return new D1Database(name);
}

/** The KV namespace bound as `name`. */
export function kvNamespace(name: string): KVNamespace {
  return new KVNamespace(name);
}

/** The Durable Object namespace bound as `name`. */
export function durableObjectNamespace(name: string): DurableObjectNamespace {
  return new DurableObjectNamespace(name);
}
