// cloudflare (internal): reads the frames the JavaScript side writes (src/frame_writer.velt has
// the format): D1's results. A frame cut short, or holding an unknown tag, throws `IoError`
// "EPROTO" instead of reading out of bounds.

import { IoError } from "velt/io";
import { BLOB, BOOL, FLOAT, INT, JSON_TEXT, NULL, TEXT } from "./frame_writer";

/** What a frame from the JavaScript side holds that cannot be: never from a sound host. */
function malformed(what: string): IoError {
  return new IoError("EPROTO", `cloudflare: a malformed frame from the host (${what})`);
}

/** Reads a frame the JavaScript side wrote; a frame cut short throws `IoError` "EPROTO". */
export class FrameReader {
  bytes: u8[];
  at: i64 = 0;

  constructor(bytes: u8[]) {
    this.bytes = bytes;
  }

  /** Throws unless `n` more bytes are there. */
  need(n: i64) throws IoError {
    if (n < 0 || this.at + n > (this.bytes.length as i64)) {
      throw malformed(`${n} bytes wanted at ${this.at} of ${this.bytes.length}`);
    }
  }

  u8(): u8 throws IoError {
    this.need(1);
    const v = this.bytes[this.at];
    this.at += 1;
    return v;
  }

  u32(): u32 throws IoError {
    this.need(4);
    let v: u32 = 0;
    for (let i: i64 = 3; i >= 0; i--) {
      v = (v << 8) | (this.bytes[this.at + i] as u32);
    }
    this.at += 4;
    return v;
  }

  u64(): u64 throws IoError {
    this.need(8);
    let v: u64 = 0;
    for (let i: i64 = 7; i >= 0; i--) {
      v = (v << 8) | (this.bytes[this.at + i] as u64);
    }
    this.at += 8;
    return v;
  }

  /** Skips a length and its bytes; gives where they start. */
  skipBlob(): i64 throws IoError {
    const n = this.u32() as i64;
    this.need(n);
    const start = this.at;
    this.at += n;
    return start;
  }

  /** A length and its bytes. */
  blob(): u8[] throws IoError {
    const start = this.skipBlob();
    return this.bytes.slice(start, this.at);
  }

  /** A length and its UTF-8. */
  text(): string throws IoError {
    const start = this.skipBlob();
    return this.bytes.utf8Slice(start, this.at);
  }

  /** Skips a tagged value; gives where its tag is. */
  skipValue(): i64 throws IoError {
    const start = this.at;
    const tag = this.u8();
    if (tag == INT || tag == FLOAT) {
      this.need(8);
      this.at += 8;
    } else if (tag == TEXT || tag == BLOB || tag == JSON_TEXT) {
      this.skipBlob();
    } else if (tag == BOOL) {
      this.u8();
    } else if (tag != NULL) {
      throw malformed(`the tag ${tag}`);
    }
    return start;
  }
}
