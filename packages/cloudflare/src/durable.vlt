// cloudflare (internal): Durable Object stubs, as the Workers API has them: a namespace's ids
// (`idFromName`, `idFromString`, `newUniqueId`), `get(id)`, and `stub.fetch(request)`. An id
// crosses as its hex string and a stub is its namespace and id, so neither holds a JavaScript
// object of the request that made it; the host looks the stub up again for each `fetch`.

import { IoError } from "velt/io";
import { Request, RequestInit, Response } from "velt/net/http";
import { durableFetch, durableId, lastFailure } from "./host";
import { receivedResponse, requestWire } from "./http";

/** The id of a Durable Object: 64 hex digits. */
export class DurableObjectId {
  #hex: string;
  /** The name it was made from (`idFromName`), else null. */
  readonly name: string | null;

  constructor(hex: string, name: string | null) {
    this.#hex = hex;
    this.name = name;
  }

  /** The id's hex string (`idFromString` gives it back). */
  toString(): string {
    return this.#hex;
  }

  /** Whether `other` is the same id. */
  equals(other: DurableObjectId): bool {
    return this.#hex == other.#hex;
  }
}

/** A Durable Object namespace: the binding `binding` of the Worker's env. */
export class DurableObjectNamespace {
  readonly binding: string;

  constructor(binding: string) {
    this.binding = binding;
  }

  /** The id of the object named `name` (the same name gives the same object, worldwide). */
  idFromName(name: string): DurableObjectId throws IoError {
    return new DurableObjectId(this.id(0, name), name);
  }

  /** The id whose hex string is `hex` (`id.toString()`); `IoError` when it is not one of this namespace's. */
  idFromString(hex: string): DurableObjectId throws IoError {
    return new DurableObjectId(this.id(1, hex), null);
  }

  /** The id of a new object. */
  newUniqueId(): DurableObjectId throws IoError {
    return new DurableObjectId(this.id(2, ""), null);
  }

  /** The stub that sends requests to the object `id`. */
  get(id: DurableObjectId): DurableObjectStub {
    return new DurableObjectStub(this.binding, id);
  }

  private id(how: u32, value: string): string throws IoError {
    const hex = durableId(this.binding, how, value);
    if (hex == "") {
      throw lastFailure();
    }
    return hex;
  }
}

/** Sends requests to one Durable Object. */
export class DurableObjectStub {
  readonly id: DurableObjectId;
  #namespace: string;

  constructor(namespace: string, id: DurableObjectId) {
    this.#namespace = namespace;
    this.id = id;
  }

  /**
   * Sends `input` (a URL, or a `Request`; `init` as `new Request(input, init)` takes it) to the
   * object's `fetch` handler and gives its response. Bodies cross whole.
   */
  async fetch(input: Request | string, init?: RequestInit): Promise<Response> {
    const request = init == undefined ? input : new Request(input, init);
    const req = await requestWire(request);
    const r = await durableFetch(
      this.#namespace,
      this.id.toString(),
      req.method,
      req.url,
      req.headers,
      req.body,
    );
    return receivedResponse(r);
  }
}
