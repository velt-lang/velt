// cloudflare (internal): the frames D1's parameters and rows cross in (src/cloudflare.mjs has
// their JavaScript side). One host call carries a whole statement's parameters, or a whole
// result, as bytes, instead of a call per value.
//
// Little-endian throughout. A string or blob is a `u32` length and its bytes (UTF-8 for text). A
// value is a tag byte and its payload: null (none), an integer (`i64`), a float (`f64`), text, a
// blob, a bool (one byte, 0 or 1), or JSON text (a value D1 gave that is none of these). A
// parameter frame is a `u32` count and the values; a statement list (`batch`) a `u32` count and
// per statement its SQL (a string) and its parameter frame.

import { IoError } from "velt/io";
import { utf8Encode } from "velt/encoding";

export const NULL: u8 = 0;
export const INT: u8 = 1;
export const FLOAT: u8 = 2;
export const TEXT: u8 = 3;
export const BLOB: u8 = 4;
export const BOOL: u8 = 5;
export const JSON_TEXT: u8 = 6;

/** A value a D1 statement binds: `?` in order (`?1`, `?2`, … by position). */
export type D1Value = string | number | bool | null | u8[];

/** Writes frames for the JavaScript side to read. */
export class FrameWriter {
  bytes: u8[] = [];

  u8(v: u8) {
    this.bytes.push(v);
  }

  u32(v: u32) {
    for (let i: u32 = 0; i < 4; i++) {
      this.bytes.push(((v >>> (i * 8)) & 255) as u8);
    }
  }

  u64(v: u64) {
    for (let i: u64 = 0; i < 8; i++) {
      this.bytes.push(((v >>> (i * 8)) & 255) as u8);
    }
  }

  /** A length and `b`. */
  blob(b: readonly u8[]) {
    this.u32(b.length as u32);
    for (const x of b) {
      this.bytes.push(x);
    }
  }

  /** A length and `s`'s UTF-8. */
  text(s: string) {
    this.blob(utf8Encode(s));
  }

  /** `v`, tagged. */
  value(v: D1Value) {
    if (v == null) {
      this.u8(NULL);
    } else if (typeof v == "string") {
      this.u8(TEXT);
      this.text(v);
    } else if (typeof v == "number") {
      this.u8(FLOAT);
      this.u64(v.toBits());
    } else if (typeof v == "boolean") {
      this.u8(BOOL);
      this.u8(v ? 1 : 0);
    } else {
      this.u8(BLOB);
      this.blob(v);
    }
  }

  /** A parameter frame of `values`. */
  params(values: D1Value[]) {
    this.u32(values.length as u32);
    for (const v of values) {
      this.value(v);
    }
  }
}

/** What a frame from the JavaScript side holds that cannot be: never from a sound host. */
function malformed(what: string): IoError {
  return new IoError("EPROTO", `cloudflare: a malformed frame from the host (${what})`);
}

/** Reads a frame the JavaScript side wrote; a frame cut short throws `IoError` "EPROTO". */
export class FrameReader {
  bytes: u8[];
  at: i64 = 0;

  constructor(bytes: u8[]) {
    this.bytes = bytes;
  }

  /** Throws unless `n` more bytes are there. */
  need(n: i64) throws IoError {
    if (n < 0 || this.at + n > (this.bytes.length as i64)) {
      throw malformed(`${n} bytes wanted at ${this.at} of ${this.bytes.length}`);
    }
  }

  u8(): u8 throws IoError {
    this.need(1);
    const v = this.bytes[this.at];
    this.at += 1;
    return v;
  }

  u32(): u32 throws IoError {
    this.need(4);
    let v: u32 = 0;
    for (let i: i64 = 3; i >= 0; i--) {
      v = (v << 8) | (this.bytes[this.at + i] as u32);
    }
    this.at += 4;
    return v;
  }

  u64(): u64 throws IoError {
    this.need(8);
    let v: u64 = 0;
    for (let i: i64 = 7; i >= 0; i--) {
      v = (v << 8) | (this.bytes[this.at + i] as u64);
    }
    this.at += 8;
    return v;
  }

  /** Skips a length and its bytes; gives where they start. */
  skipBlob(): i64 throws IoError {
    const n = this.u32() as i64;
    this.need(n);
    const start = this.at;
    this.at += n;
    return start;
  }

  /** A length and its bytes. */
  blob(): u8[] throws IoError {
    const start = this.skipBlob();
    return this.bytes.slice(start, this.at);
  }

  /** A length and its UTF-8. */
  text(): string throws IoError {
    const start = this.skipBlob();
    return this.bytes.utf8Slice(start, this.at);
  }

  /** Skips a tagged value; gives where its tag is. */
  skipValue(): i64 throws IoError {
    const start = this.at;
    const tag = this.u8();
    if (tag == INT || tag == FLOAT) {
      this.need(8);
      this.at += 8;
    } else if (tag == TEXT || tag == BLOB || tag == JSON_TEXT) {
      this.skipBlob();
    } else if (tag == BOOL) {
      this.u8();
    } else if (tag != NULL) {
      throw malformed(`the tag ${tag}`);
    }
    return start;
  }
}
