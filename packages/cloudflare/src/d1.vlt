// cloudflare (internal): D1, Cloudflare's SQLite database, as the Workers API has it: `prepare`,
// `bind`, `first`/`all`/`run`, `batch` and `exec`. Parameters and rows cross in frames
// (src/frame.vlt); rows become typed values as velt/db reads a `RowSource` (src/d1_rows.vlt,
// src/d1_decode.vlt): each column fills the field of its name (rename with `AS`).

import { d1Batch, d1Exec, d1Query } from "./host";
import { D1Value, FrameReader, FrameWriter } from "./frame";
import { D1Rows } from "./d1_rows";
import { decodeRow, decodeRows } from "./d1_decode";

/** What D1 reports about a statement it ran (Cloudflare's `D1Result.meta`). */
export struct D1Meta {
  /** Milliseconds the statement took. */
  duration: f64;
  /** Rows the statement changed. */
  changes: i64;
  /** The rowid of the last row inserted. */
  last_row_id: i64;
  changed_db: bool;
  /** The database's size afterwards, in bytes. */
  size_after: i64;
  rows_read: i64;
  rows_written: i64;
}

/** The outcome of `run()`: no rows. */
export struct D1Response {
  success: bool;
  meta: D1Meta;
}

/** The outcome of `all<T>()`: the rows as `T`s, and the meta. */
export struct D1Result<T> {
  results: T[];
  success: bool;
  meta: D1Meta;
}

/** The outcome of `exec(sql)`: how many statements ran, and how long they took. */
export struct D1ExecResult {
  count: i64;
  duration: f64;
}

/** A D1 database: the binding `binding` of the Worker's env (`d1Database("DB")`). */
export class D1Database {
  readonly binding: string;

  constructor(binding: string) {
    this.binding = binding;
  }

  /** A statement of `sql`, without parameters yet (`bind`). Nothing is sent until it runs. */
  prepare(sql: string): D1PreparedStatement {
    return new D1PreparedStatement(this.binding, sql, []);
  }

  /**
   * Runs `statements` in one transaction (all of them or none): their results in order. Rows are
   * read per result, `results<T>()`, since each statement has its own.
   */
  async batch(statements: D1PreparedStatement[]): Promise<D1BatchResult[]> {
    const w = new FrameWriter();
    w.u32(statements.length as u32);
    for (const s of statements) {
      w.text(s.sql);
      w.params(s.params);
    }
    const frame = new FrameReader(await d1Batch(this.binding, w.bytes));
    const out: D1BatchResult[] = [];
    for (let n = frame.u32(); n > 0; n--) {
      // Each result has its length first.
      frame.u32();
      const rows = D1Rows.parse(frame);
      out.push(new D1BatchResult(rows));
    }
    return out;
  }

  /** Runs `sql`, one or more statements without parameters, and gives no rows (migrations). */
  async exec(sql: string): Promise<D1ExecResult> {
    return JSON.parse<D1ExecResult>(await d1Exec(this.binding, sql));
  }
}

/** A statement of a D1 database, and the parameters bound to it. */
export class D1PreparedStatement {
  readonly database: string;
  readonly sql: string;
  readonly params: D1Value[];

  constructor(database: string, sql: string, params: D1Value[]) {
    this.database = database;
    this.sql = sql;
    this.params = params;
  }

  /** The statement with `values` bound to its `?` in order (a new statement, as in Workers). */
  bind(...values: D1Value[]): D1PreparedStatement {
    return new D1PreparedStatement(this.database, this.sql, values);
  }

  /** The first row as a `T`, or null when there is none (`RowError` when it does not fit). */
  async first<T>(): Promise<T | null> {
    const rows = await this.query(1);
    return decodeRow<T>(rows);
  }

  /** Every row as a `T`, with the meta (`RowError` when one does not fit). */
  async all<T>(): Promise<D1Result<T>> {
    const rows = await this.query(0);
    const meta = JSON.parse<D1Meta>(rows.meta);
    return { results: decodeRows<T>(rows), success: true, meta: meta };
  }

  /** Runs the statement for its effect: the meta (`changes`, `last_row_id`). */
  async run(): Promise<D1Response> {
    const rows = await this.query(2);
    return { success: true, meta: JSON.parse<D1Meta>(rows.meta) };
  }

  private async query(mode: u32): Promise<D1Rows> {
    const w = new FrameWriter();
    w.params(this.params);
    const frame = new FrameReader(await d1Query(this.database, this.sql, w.bytes, mode));
    return D1Rows.parse(frame);
  }
}

/** One statement's outcome in a `batch`: its meta, and its rows when asked for. */
export class D1BatchResult {
  readonly success: bool = true;
  readonly meta: D1Meta;
  #rows: D1Rows;

  constructor(rows: D1Rows) {
    this.meta = JSON.parse<D1Meta>(rows.meta);
    this.#rows = rows;
  }

  /** The statement's rows as `T`s (`RowError` when one does not fit). Read once. */
  results<T>(): T[] {
    return decodeRows<T>(this.#rows);
  }
}
