// cloudflare (internal): D1's rows (a `D1Rows`, velt/db's `RowSource`) into typed values, as
// velt/db reads every driver's rows: `readRows<T, D1Rows>` and `readRow<T, D1Rows>`, by column for
// a row type of plain fields and through the JSON text of the rows for any other, each column
// filling the field of its name with `JSON.parse<T>`'s conversions and messages; a row that does
// not fit throws velt/db's `RowError`. (They read the rows' JSON text themselves before the
// by-column reader linked in a `--host` build, velt-lang/velt#2121.)

import { readRow, readRows } from "velt/db";
import { D1Rows } from "./d1_rows";

/** Every remaining row of `rows` as a `T`; `RowError` for one that does not fit. */
export function decodeRows<T>(rows: D1Rows): T[] {
  return readRows<T, D1Rows>(rows);
}

/** The next row of `rows` as a `T`, or null when there is none; `RowError` as `decodeRows`. */
export function decodeRow<T>(rows: D1Rows): T | null {
  return readRow<T, D1Rows>(rows);
}
