// cloudflare (internal): a cache of the Workers Cache API (`caches.default`, `caches.open(name)`,
// src/cache_storage.velt): `match`, `put` and `delete` of std's `Request` and `Response`
// (src/http.velt crosses them). Cloudflare keys the cache by URL (GET requests only), honours
// `Cache-Control` and ignores `put` of a response it may not cache; a Worker on a `workers.dev`
// domain has no cache, so there `match` always gives null. Each data center has a cache of its
// own: `put` and `delete` reach the one running the Worker.

import { IoError } from "velt/io";
import { Request, Response } from "velt/net/http";
import { cacheDelete, cacheMatch, cachePut } from "./host";
import { receivedResponse, requestWire, responseWire } from "./http";

/** A cache of the zone: `caches.default`, or one of `caches.open(name)`. */
export class Cache {
  /** The name ("" for `caches.default`). */
  readonly name: string;

  constructor(name: string) {
    this.name = name;
  }

  /** The cached response for `request` (a URL is a GET of it), or null. */
  async match(request: Request | string): Promise<Response | null> {
    const req = await requestWire(request);
    const r = await cacheMatch(this.name, req.method, req.url, req.headers);
    return r == null ? null : receivedResponse(r);
  }

  /** Caches `response` for `request`, a GET (a URL is a GET of it). Reads `response`'s body. */
  async put(request: Request | string, response: Response): Promise<void> {
    const req = await requestWire(request);
    if (req.method != "GET") {
      throw new IoError(
        "EINVAL",
        `cloudflare: the cache keeps responses to GET, not ${req.method}`,
      );
    }
    const res = await responseWire(response);
    await cachePut(this.name, req.url, req.headers, res.status, res.headers, res.body);
  }

  /**
   * Removes the cached response for `request` from this data center's cache (the Cache API is
   * per data center: a purge everywhere is Cloudflare's purge API): whether there was one.
   */
  async delete(request: Request | string): Promise<bool> {
    const req = await requestWire(request);
    return await cacheDelete(this.name, req.method, req.url, req.headers);
  }
}
