// web (internal): the path of a request's URL.

/** The pathname of an absolute URL, without parsing the rest of it. */
export function pathOf(url: string): string {
  const scheme = url.indexOf("://");
  const start = url.indexOf("/", scheme < 0 ? 0 : scheme + 3);
  if (start < 0) {
    return "/";
  }
  let end = start;
  while (end < url.length) {
    const code = url.charCodeAt(end);
    if (code == 63 || code == 35) {
      break;
    }
    end++;
  }
  return url.slice(start, end);
}
