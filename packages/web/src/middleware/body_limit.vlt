// web (internal): `bodyLimit()`, the largest request body a part of an app takes.

import { Handler, Middleware } from "../types";

/**
 * Answers 413 for a request body over `maxBytes`. A `Content-Length` over it is refused at once,
 * without reading the body. A body without one, or with one that isn't a whole number of bytes, is
 * read until it passes the limit, so at most `maxBytes` is held, and its chunks are passed on as
 * they came, not copied. `serve`'s `maxBodySize` is the limit for a whole server; this one is for a
 * prefix that takes less. A GET or HEAD can't be given a body again, so its route gets none.
 */
export function bodyLimit(maxBytes: number): Middleware {
  return (next: Handler): Handler => async (req: Request): Promise<Response> => {
    const body = req.body;
    if (body == null) {
      return await next(req);
    }
    const declared = byteCount(req.headers.get("content-length"));
    if (declared >= 0) {
      return declared > maxBytes ? tooLarge() : await next(req);
    }
    const kept: Uint8Array[] = [];
    let total = 0;
    for await (const chunk of body) {
      total += chunk.length;
      if (total > maxBytes) {
        return tooLarge();
      }
      kept.push(chunk);
    }
    if (req.method == "GET" || req.method == "HEAD") {
      return await next(
        new Request(req.url, { method: req.method, headers: req.headers, signal: req.signal }),
      );
    }
    return await next(new Request(req, { body: ReadableStream.from(replay(kept)) }));
  };
}

// The number a `Content-Length` holds, or -1 when there is none or it isn't only digits.
function byteCount(header: string | null): number {
  if (header == null || header.length == 0 || header.length > 15) {
    return -1;
  }
  let n = 0;
  for (let i = 0; i < header.length; i++) {
    const c = header.charCodeAt(i);
    if (c < 48 || c > 57) {
      return -1;
    }
    n = n * 10 + (c - 48);
  }
  return n;
}

async function* replay(chunks: Uint8Array[]): AsyncGenerator<Uint8Array> {
  for (const chunk of chunks) {
    yield chunk;
  }
}

function tooLarge(): Response {
  return new Response("Payload Too Large", { status: 413 });
}
