// A request's cost must not grow with the number of routes: `velt run --release bench/scale.vlt 3`
// and `… 3000`, then compare the requests per second. A captured table would be copied per request.
import { serve } from "http-server";
import { App } from "../src/lib";

struct Vars {
  user: string;
}

async function main() {
  const routes = parseInt(process.argv[2] ?? "3");
  const requests = parseInt(process.argv[3] ?? "5000");
  const app = new App<Vars>(() => ({ user: "" }));
  for (let i = 0; i < routes; i++) {
    app.get(`/r${i}/:id`, async (c) => c.text("ok"));
  }
  const h = app.handler();
  const server = await serve({ port: 0 }, (req: Request) => h(req));
  const url = `http://127.0.0.1:${server.port}/r1/42`;
  const start = Date.now();
  for (let i = 0; i < requests; i++) {
    const res = await fetch(url);
    await res.text();
  }
  console.log(`${routes} routes: ${Math.round((requests * 1000) / (Date.now() - start))} req/s`);
  await server.shutdown();
}
