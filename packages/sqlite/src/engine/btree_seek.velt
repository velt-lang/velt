// sqlite/engine/btree_seek (internal): seeking a table b-tree to a rowid (the leaf it is on, or the first
// row after it). Each probe of the search reads its cell in place (rowids of one or two varint
// bytes without a call), with the cell checks the rest of the reader makes. Index seeks are in
// engine/btree_seek_index.

import { CorruptError, corrupt } from "./errors";
import { INTERIOR_TABLE, LEAF_TABLE, readU16, readU32 } from "./format";
import { readVarint } from "./varint";
import { Cursor, MAX_DEPTH } from "./cursor";

extend Cursor {
  /** On a table b-tree, moves to the first row with key >= `rowid`; false if there is none. */
  seekRowidGe(rowid: i64): bool {
    const lo = this.findLeaf(rowid);
    const leaf = this.db.header(this.pages[this.pages.length - 1]);
    const n = readU16(this.db.data, leaf + 3);
    if (lo < n) {
      this.cells.push(lo);
      return this.load();
    }
    if (n == 0) {
      this.cells.push(0);
      this.valid = false;
      return false;
    }
    // Past this leaf's last row: the next row is on a later leaf, if any.
    this.cells.push(n - 1);
    this.load();
    return this.next();
  }

  /**
   * Descends a table b-tree to the leaf where `rowid` is or would be, leaving the path to it
   * (the leaf's cell not yet pushed); returns the leaf's first cell whose key is >= rowid.
   */
  findLeaf(rowid: i64): usize {
    const data = this.db.data;
    this.pages.truncate(0);
    this.cells.truncate(0);
    let page = this.root;
    while (true) {
      if (this.pages.length >= MAX_DEPTH) {
        corrupt("b-tree too deep");
      }
      // The page's b-tree header (DbFile.header, in place).
      if (page == 0 || page > this.db.pageCount) {
        this.db.page(page);
      }
      const h = page == 1 ? 100 : ((page - 1) as usize) * this.db.pageSize;
      const base = h == 100 ? 0 : h;
      const t = data[h];
      const n = readU16(data, h + 3);
      const usable = this.db.usable;
      // The cell pointers must fit the page; each cell is checked as the search reads it.
      const cellsEnd = h + (t == LEAF_TABLE ? 8 : 12) + 2 * n;
      if (cellsEnd > base + usable) {
        corrupt(`cell count ${n} overflows its page`);
      }
      const leaf = t == LEAF_TABLE;
      if (!leaf && t != INTERIOR_TABLE) {
        throw new CorruptError(`page ${page} is not a table b-tree page`);
      }
      // The first cell whose key is >= rowid (on an interior page it holds the rowid in its
      // left subtree).
      // Cells read in place need 18 bytes after the page in the file (two varints of a cell
      // at its end); the file's last pages are read with checked varints instead.
      const safe = base + usable + 18 <= data.length;
      const lo = searchTable(data, h, base, cellsEnd, usable, leaf, n, rowid, safe);
      if (leaf) {
        this.pages.push(page);
        return lo;
      }
      this.pages.push(page);
      this.cells.push(lo);
      if (lo < n) {
        // The child pointer of cell `lo`, checked as cellOffset checks a cell.
        const ptr = h + 12 + 2 * lo;
        const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
        if (base + off < cellsEnd || off + 4 > usable) {
          corrupt(`cell offset ${off} out of range`);
        }
        page = readU32(data, base + off);
      } else {
        page = readU32(data, h + 8);
      }
    }
  }
}

/**
 * The first of a table page's `n` cells whose key is >= `rowid` (`n` when none): the page's
 * end keys first, then guesses by interpolation, since rowids are mostly dense (a lookup is
 * usually three or four probes); past two guesses, bisection. One probe site, read in place.
 */
function searchTable(
  data: u8[],
  h: usize,
  base: usize,
  cellsEnd: usize,
  usable: usize,
  leaf: bool,
  n: usize,
  rowid: i64,
  safe: bool,
): usize {
  if (n == 0) {
    return 0;
  }
  // Probes: the last cell, the first, then guesses; key(lo) < rowid <= key(hi) from the third.
  let lo: usize = 0;
  let hi = n - 1;
  let klo: i64 = 0;
  let khi: i64 = 0;
  let step = 0;
  let g = hi;
  const first = h + (leaf ? 8 : 12);
  while (true) {
    const ptr = first + 2 * g;
    const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
    if (base + off < cellsEnd || off + 4 > usable) {
      corrupt(`cell offset ${off} out of range`);
    }
    let at = base + off;
    if (!safe) {
      at += leaf ? readVarint(data, at).len : 4;
    } else if (leaf) {
      const from = at;
      while (data[at] >= 0x80 && at < from + 8) {
        at++;
      }
      at++;
    } else {
      at += 4;
    }
    let k: i64 = 0;
    if (!safe) {
      k = readVarint(data, at).value;
    } else if (data[at] < 0x80) {
      k = data[at] as i64;
    } else if (data[at + 1] < 0x80) {
      k = (((data[at] & 0x7f) as i64) << 7) | (data[at + 1] as i64);
    } else {
      k = readVarint(data, at).value;
    }
    if (step == 0) {
      // The last cell.
      if (k < rowid) {
        return n;
      }
      if (hi == 0) {
        return 0;
      }
      khi = k;
      g = 0;
    } else if (step == 1) {
      // The first cell.
      if (k >= rowid) {
        return 0;
      }
      klo = k;
    } else {
      if (k == rowid) {
        return g;
      }
      if (k < rowid) {
        lo = g;
        klo = k;
      } else {
        hi = g;
        khi = k;
      }
    }
    step++;
    if (step >= 2) {
      if (hi - lo <= 1) {
        return hi;
      }
      g = (lo + hi) >> 1;
      if (step < 4 && khi > klo) {
        const f = ((rowid as f64) - (klo as f64)) / ((khi as f64) - (klo as f64));
        const x = (lo as f64) + f * ((hi - lo) as f64);
        g =
          x <= (lo as f64) + 1.0
            ? lo + 1
            : x >= (hi as f64) - 1.0 ? hi - 1 : Math.round(x) as usize;
      }
    }
  }
}
