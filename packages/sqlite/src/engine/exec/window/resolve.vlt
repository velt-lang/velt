// sqlite/engine/exec/window/resolve (internal): the window of `OVER ...` resolved against the
// WINDOW clause's named windows and checked as SQLite checks it (`Resolved`).

import {
  BOUND_CURRENT,
  BOUND_FOLLOWING,
  BOUND_PRECEDING,
  BOUND_UNBOUNDED_FOLLOWING,
  BOUND_UNBOUNDED_PRECEDING,
  E_BINARY,
  E_CALL,
  E_COLUMN,
  E_EXISTS,
  E_IN_SELECT,
  E_LIKE,
  E_NULL,
  E_SUBQUERY,
  Expr,
  FRAME_DEFAULT,
  FRAME_RANGE,
  Window,
} from "../../sql/types";
import { prepareError } from "../errors";

/** A resolved window and the key two equal windows share. */
export struct Resolved {
  w: Window;
  key: string;
}

/** The window of `OVER ...`, with the named windows of the WINDOW clause resolved. */
export function resolveWindow(o: Window, named: Window[]): Resolved {
  let w = o;
  let key = o.text;
  if (o.base != "") {
    let b: Window | null = null;
    let at: usize = 0;
    for (let i: usize = 0; i < named.length; i++) {
      if (named[i].name.toUpperCase() == o.base.toUpperCase()) {
        b = named[i];
        at = i;
        break;
      }
    }
    if (b == null) {
      prepareError(`no such window: ${o.base}`);
    }
    // A named window may build on one defined before it.
    const rb = resolveWindow(b!, named.slice(0, at as i64));
    if (
      o.text == "" && o.partition.length == 0 && o.orderBy.length == 0 && o.frame == FRAME_DEFAULT
    ) {
      w = rb.w;
      key = rb.key;
    } else {
      const base = rb.w;
      if (o.partition.length > 0) {
        prepareError(`cannot override PARTITION clause of window: ${o.base}`);
      }
      if (o.orderBy.length > 0 && base.orderBy.length > 0) {
        prepareError(`cannot override ORDER BY clause of window: ${o.base}`);
      }
      if (base.frame != FRAME_DEFAULT) {
        prepareError(`cannot override frame specification of window: ${o.base}`);
      }
      const nw = new Window();
      nw.partition = base.partition;
      nw.orderBy = o.orderBy.length > 0 ? o.orderBy : base.orderBy;
      nw.frame = o.frame;
      nw.start = o.start;
      nw.startExpr = o.startExpr;
      nw.end = o.end;
      nw.endExpr = o.endExpr;
      nw.exclude = o.exclude;
      w = nw;
      key = rb.key + "|" + o.text;
    }
  }
  checkFrame(w);
  return Resolved { w: constantOffsets(w), key: key };
}

// `w` with a frame offset that is not a constant replaced by NULL, as SQLite's parser replaces
// it (sqlite3WindowOffsetExpr): such an offset fails as a frame error when the query runs, and
// its names, functions and subqueries are never resolved.
function constantOffsets(w: Window): Window {
  const s = w.startExpr != null && !isConstant(w.startExpr!);
  const e = w.endExpr != null && !isConstant(w.endExpr!);
  if (!s && !e) {
    return w;
  }
  const nw = new Window();
  nw.base = w.base;
  nw.name = w.name;
  nw.partition = w.partition;
  nw.orderBy = w.orderBy;
  nw.frame = w.frame;
  nw.start = w.start;
  nw.startExpr = s ? new Expr(E_NULL, w.startExpr!.at) : w.startExpr;
  nw.end = w.end;
  nw.endExpr = e ? new Expr(E_NULL, w.endExpr!.at) : w.endExpr;
  nw.exclude = w.exclude;
  nw.text = w.text;
  return nw;
}

// Whether `e` is constant as SQLite's parser sees it (sqlite3ExprIsConstant before names
// resolve): no column or name, no function call (LIKE, GLOB, `->` and `->>` are calls there),
// no subquery.
function isConstant(e: Expr): bool {
  const k = e.kind;
  if (k == E_COLUMN || k == E_CALL || k == E_LIKE || k == E_SUBQUERY || k == E_EXISTS) {
    return false;
  }
  if (k == E_IN_SELECT || (k == E_BINARY && (e.op == "->" || e.op == "->>"))) {
    return false;
  }
  for (const x of [e.a, e.b, e.c, e.filter]) {
    if (x != null && !isConstant(x!)) {
      return false;
    }
  }
  for (const a of e.args) {
    if (!isConstant(a)) {
      return false;
    }
  }
  return true;
}

// The frames SQLite rejects (sqlite3WindowAlloc).
function checkFrame(w: Window) {
  if (w.frame == FRAME_DEFAULT) {
    return;
  }
  const s = w.start;
  const e = w.end;
  if (
    s == BOUND_UNBOUNDED_FOLLOWING ||
    e == BOUND_UNBOUNDED_PRECEDING ||
    (s == BOUND_CURRENT && e == BOUND_PRECEDING) ||
    (s == BOUND_FOLLOWING && (e == BOUND_PRECEDING || e == BOUND_CURRENT))
  ) {
    prepareError("unsupported frame specification");
  }
  if (
    w.frame == FRAME_RANGE &&
    (s == BOUND_PRECEDING || s == BOUND_FOLLOWING || e == BOUND_PRECEDING || e == BOUND_FOLLOWING)
  ) {
    if (w.orderBy.length != 1) {
      prepareError("RANGE with offset PRECEDING/FOLLOWING requires one ORDER BY expression");
    }
    prepareError("unsupported: RANGE frames with an offset");
  }
}
