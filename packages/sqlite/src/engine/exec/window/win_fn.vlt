// sqlite/engine/exec/window/win_fn (internal): one window function call of a query (`WinFn`): its
// kind, where its values are in a collected row, and its frame; the built-in window functions'
// names and arities.

import { BOUND_CURRENT, BOUND_UNBOUNDED_PRECEDING, FRAME_DEFAULT } from "../../sql/types";
import { AggFn } from "../agg/agg_fn";
import { Ev } from "../types";

/** Window function kinds. */
export const W_ROW_NUMBER: u8 = 0;
export const W_RANK: u8 = 1;
export const W_DENSE_RANK: u8 = 2;
export const W_PERCENT_RANK: u8 = 3;
export const W_CUME_DIST: u8 = 4;
export const W_NTILE: u8 = 5;
export const W_LAG: u8 = 6;
export const W_LEAD: u8 = 7;
export const W_FIRST: u8 = 8;
export const W_LAST: u8 = 9;
export const W_NTH: u8 = 10;
export const W_AGG: u8 = 11;

/** The window kind of `name` (upper case), or -1 when it is no built-in window function. */
export function windowKind(name: string): i64 {
  const names = [
    "ROW_NUMBER",
    "RANK",
    "DENSE_RANK",
    "PERCENT_RANK",
    "CUME_DIST",
    "NTILE",
    "LAG",
    "LEAD",
    "FIRST_VALUE",
    "LAST_VALUE",
    "NTH_VALUE",
  ];
  return names.indexOf(name) as i64;
}

/** Arity of a window function kind: [least, most]. */
export function windowArity(kind: i64): i64[] {
  if (kind == W_NTILE as i64 || kind == W_FIRST as i64 || kind == W_LAST as i64) {
    return [1, 1];
  }
  if (kind == W_LAG as i64 || kind == W_LEAD as i64) {
    return [1, 3];
  }
  if (kind == W_NTH as i64) {
    return [2, 2];
  }
  return [0, 0];
}

/** One window function call: its kind, where its values are in a collected row, its frame. */
export class WinFn {
  kind: u8;
  /** W_AGG: the aggregate. */
  agg: AggFn | null = null;
  /** The window (an index into WinCtx.specs). */
  spec: usize = 0;
  /** Where its argument values start in a collected row, and how many. */
  argAt: usize = 0;
  nargs: usize = 0;
  /** Where its FILTER result is in a collected row (-1: none). */
  filterAt: i64 = -1;
  frame: u8 = FRAME_DEFAULT;
  start: u8 = BOUND_UNBOUNDED_PRECEDING;
  startN: Ev | null = null;
  end: u8 = BOUND_CURRENT;
  endN: Ev | null = null;
  exclude: string = "";
  /** The frame offsets, evaluated once per run. */
  startOff: i64 = 0;
  endOff: i64 = 0;

  constructor(kind: u8) {
    this.kind = kind;
  }
}
