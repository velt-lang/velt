// sqlite/engine/exec/window/fn_value (internal): a window function's value for one row of its
// partition, computed afresh: the ranking functions, lag and lead, first_value, last_value and
// nth_value, and an aggregate over a frame SQLite does not compute incrementally (EXCLUDE).

import { INTEGER, NULL, REAL } from "../../storage_class";
import { Acc, finish, stepValues } from "../agg/acc";
import { SqlRunError } from "../errors";
import { toI64 } from "../value/ops";
import { Val, intVal, nullVal, realVal } from "../value/val";
import {
  W_CUME_DIST,
  W_DENSE_RANK,
  W_FIRST,
  W_LAG,
  W_LAST,
  W_LEAD,
  W_NTH,
  W_NTILE,
  W_PERCENT_RANK,
  W_RANK,
  W_ROW_NUMBER,
  WinFn,
} from "./win_fn";
import { WinCtx } from "./win_ctx";
import { Frame, excluded, frameOf } from "./frame";

/**
 * Function `f`'s value for row `i` of the partition order[s..s+n] (in peer group group[i];
 * peer groups start at `gs` and end at `ge`).
 */
export function fnValue(
  w: WinCtx,
  f: WinFn,
  order: usize[],
  s: usize,
  n: usize,
  i: usize,
  group: usize[],
  gs: usize[],
  ge: usize[],
  ordered: bool,
): Val {
  const row = order[s + i];
  const g = group[i];
  if (f.kind == W_ROW_NUMBER) {
    return intVal((i + 1) as i64);
  }
  if (f.kind == W_RANK) {
    return intVal((gs[g] + 1) as i64);
  }
  if (f.kind == W_DENSE_RANK) {
    return intVal((g + 1) as i64);
  }
  if (f.kind == W_PERCENT_RANK) {
    return realVal(n <= 1 ? 0.0 : (gs[g] as f64) / ((n - 1) as f64));
  }
  if (f.kind == W_CUME_DIST) {
    return realVal(((ge[g] + 1) as f64) / (n as f64));
  }
  if (f.kind == W_NTILE) {
    return ntile(w, f, row, i, n);
  }
  if (f.kind == W_LAG || f.kind == W_LEAD) {
    let off: i64 = 1;
    if (f.nargs > 1) {
      const o = w.arg(row, f, 1);
      if (o.t == NULL) {
        return nullVal();
      }
      off = toI64(o);
    }
    const j = f.kind == W_LAG ? (i as i64) - off : (i as i64) + off;
    if (j < 0 || j >= (n as i64)) {
      return f.nargs > 2 ? w.arg(row, f, 2) : nullVal();
    }
    return w.arg(order[s + (j as usize)], f, 0);
  }
  // Functions over the frame.
  const fr = frameOf(f, i, n, g, gs, ge, ordered);
  if (f.kind == W_FIRST || f.kind == W_LAST || f.kind == W_NTH) {
    return valueIn(w, f, row, i, fr, order, s, group);
  }
  // An aggregate over the frame.
  const af = f.agg!;
  const acc = new Acc();
  for (let j = fr.lo; j <= fr.hi; j++) {
    if (excluded(f, i, j as usize, group)) {
      continue;
    }
    const r = order[s + (j as usize)];
    if (f.filterAt >= 0) {
      const fv = w.rows[r * w.stride() + (f.filterAt as usize)];
      if (fv.t != INTEGER || fv.i == 0) {
        continue;
      }
    }
    const v = f.nargs > 0 ? w.arg(r, f, 0) : nullVal();
    const sep = f.nargs > 1 ? w.arg(r, f, 1) : nullVal();
    stepValues(af, acc, v, sep, f.nargs > 1);
  }
  return finish(af, acc);
}

// ntile(N) of row `i` (at `row`) of a partition of `n` rows.
function ntile(w: WinCtx, f: WinFn, row: usize, i: usize, n: usize): Val {
  const tv = w.arg(row, f, 0);
  const t = toI64(tv);
  if (t <= 0 || tv.t != INTEGER) {
    throw new SqlRunError("argument of ntile must be a positive integer");
  }
  const buckets = t as usize;
  if (buckets >= n) {
    return intVal((i + 1) as i64);
  }
  const size = n / buckets;
  const big = n % buckets;
  // The first `big` buckets hold size + 1 rows.
  const cut = big * (size + 1);
  if (i < cut) {
    return intVal((i / (size + 1) + 1) as i64);
  }
  return intVal((big + (i - cut) / size + 1) as i64);
}

// first_value(), last_value() or nth_value() of row `i` (at `row`) over frame `fr`.
function valueIn(
  w: WinCtx,
  f: WinFn,
  row: usize,
  i: usize,
  fr: Frame,
  order: usize[],
  s: usize,
  group: usize[],
): Val {
  let want: i64 = 1;
  if (f.kind == W_NTH) {
    const nv = w.arg(row, f, 1);
    want = toI64(nv);
    if (want <= 0 || !(nv.t == INTEGER || (nv.t == REAL && (want as f64) == nv.r))) {
      throw new SqlRunError("second argument to nth_value must be a positive integer");
    }
  }
  // Without EXCLUDE the frame's rows are all there: the value is at a position in it.
  if (f.exclude == "") {
    const at = f.kind == W_LAST ? fr.hi : fr.lo + want - 1;
    if (fr.lo > fr.hi || at > fr.hi) {
      return nullVal();
    }
    return w.arg(order[s + (at as usize)], f, 0);
  }
  let seen: i64 = 0;
  let last: Val = nullVal();
  for (let j = fr.lo; j <= fr.hi; j++) {
    if (excluded(f, i, j as usize, group)) {
      continue;
    }
    const v = w.arg(order[s + (j as usize)], f, 0);
    seen++;
    if (f.kind != W_LAST && seen == want) {
      return v;
    }
    last = v;
  }
  return f.kind == W_LAST ? last : nullVal();
}
