// sqlite/engine/exec/loop/index_loop (internal): the loop of a FROM level read through an index: an
// index scan with a prefix equality and a range on the next column, and an index lookup per IN
// value.

import { NULL } from "../../storage_class";
import { KeyRec } from "../../key_rec";
import "../../btree_back";
import { Source } from "../source";
import { Out } from "../out";
import { Step } from "../types";
import { Params } from "../params";
import { Access } from "../plan/access";
import { addKeyField } from "../plan/rowid_key";
import { forCompare } from "../value/ops";
import { Val } from "../value/val";
import { inValues } from "./in_values";

export function indexScan(src: Source, acc: Access, out: Out, each: Step, p: Params): Step {
  if (acc.inList != null) {
    return indexIn(src, acc, out, each, p);
  }
  const ix = src.ix!;
  const index = acc.index!;
  const colls = index.colls;
  const desc = index.desc;
  const eq = acc.eq;
  const eqAff = acc.eqAff;
  const eqIs = acc.eqIs;
  const nEq: usize = eq.length;
  const lo = acc.lo;
  const hi = acc.hi;
  const loAff = acc.loAff;
  const hiAff = acc.hiAff;
  const loIncl = acc.loIncl;
  const hiIncl = acc.hiIncl;
  const reverse = acc.reverse;
  // Reused from run to run: the keys, built field by field (no record encoding).
  const prefix = new KeyRec([]);
  const loKey = new KeyRec([]);
  const hiKey = new KeyRec([]);
  return () => {
    prefix.clear();
    for (let i: usize = 0; i < nEq; i++) {
      const v = forCompare(eq[i](), eqAff[i]);
      if (v.t == NULL && !eqIs[i]) {
        return;
      }
      addKeyField(prefix, v);
    }
    let hasHi = false;
    if (hi != null) {
      const v = hi!();
      if (v.t == NULL) {
        return;
      }
      hiKey.clear();
      for (let i: usize = 0; i < nEq; i++) {
        addKeyField(hiKey, forCompare(eq[i](), eqAff[i]));
      }
      addKeyField(hiKey, forCompare(v, hiAff));
      hasHi = true;
    }
    let hasLo = false;
    if (lo != null) {
      const v = lo!();
      if (v.t == NULL) {
        return;
      }
      loKey.clear();
      for (let i: usize = 0; i < nEq; i++) {
        addKeyField(loKey, forCompare(eq[i](), eqAff[i]));
      }
      addKeyField(loKey, forCompare(v, loAff));
      hasLo = true;
    }
    if (reverse) {
      let ok = false;
      if (hasHi) {
        ok = ix.seekLastBefore(hiKey, nEq + 1, colls, desc, !hiIncl);
      } else if (nEq > 0) {
        ok = ix.seekLastBefore(prefix, nEq, colls, desc, false);
      } else {
        ok = ix.last();
      }
      while (ok && !out.stop) {
        if (nEq > 0 && ix.compareKeyRec(prefix, nEq, colls, desc) != 0) {
          break;
        }
        if (hasLo) {
          const r = ix.compareKeyRec(loKey, nEq + 1, colls, desc);
          if (r < 0 || (r == 0 && !loIncl)) {
            break;
          }
        }
        src.seeked = false;
        each();
        ok = ix.prev();
      }
      return;
    }
    let ok = false;
    if (hasLo) {
      ok = ix.seekKeyRec(loKey, nEq + 1, colls, desc);
    } else if (nEq > 0) {
      ok = ix.seekKeyRec(prefix, nEq, colls, desc);
    } else {
      ok = ix.first();
    }
    while (ok && !out.stop) {
      if (nEq > 0 && ix.compareKeyRec(prefix, nEq, colls, desc) != 0) {
        break;
      }
      if (hasHi) {
        const r = ix.compareKeyRec(hiKey, nEq + 1, colls, desc);
        if (r > 0 || (r == 0 && !hiIncl)) {
          break;
        }
      }
      src.seeked = false;
      each();
      ok = ix.next();
    }
  };
}

// An index lookup per value of `col IN (list)` (the column after the equalities).
function indexIn(src: Source, acc: Access, out: Out, each: Step, p: Params): Step {
  const ix = src.ix!;
  const index = acc.index!;
  const colls = index.colls;
  const desc = index.desc;
  const eq = acc.eq;
  const eqAff = acc.eqAff;
  const eqIs = acc.eqIs;
  const nEq: usize = eq.length;
  const list = acc.inList!;
  const inq = acc.inQuery;
  const inAff = acc.inAff;
  const inColl = acc.inColl;
  const key = new KeyRec([]);
  return () => {
    const fixed: Val[] = [];
    for (let i: usize = 0; i < nEq; i++) {
      const v = forCompare(eq[i](), eqAff[i]);
      if (v.t == NULL && !eqIs[i]) {
        return;
      }
      fixed.push(v);
    }
    for (const v of inValues(list, inq, p, inAff, inColl)) {
      if (out.stop) {
        break;
      }
      key.clear();
      for (const f of fixed) {
        addKeyField(key, f);
      }
      addKeyField(key, v);
      let ok = ix.seekKeyRec(key, nEq + 1, colls, desc);
      while (ok && !out.stop) {
        if (ix.compareKeyRec(key, nEq + 1, colls, desc) != 0) {
          break;
        }
        src.seeked = false;
        each();
        ok = ix.next();
      }
    }
  };
}
