// sqlite/engine/exec/func/date_time (internal): a time as SQLite's date.c holds it (`DateTime`): a
// julian day number in milliseconds and/or its year, month, day, hour, minute and seconds, each
// part computed from the other when needed.

/**
 * A time as date.c's DateTime: a julian day in milliseconds (`iJD`) and/or its year, month,
 * day, hour, minute and seconds, each part valid once computed, plus the modifiers' state.
 */
export class DateTime {
  iJD: i64 = 0;
  Y: i64 = 0;
  M: i64 = 0;
  D: i64 = 0;
  h: i64 = 0;
  m: i64 = 0;
  tz: i64 = 0;
  s: f64 = 0;
  validJD: bool = false;
  validYMD: bool = false;
  validHMS: bool = false;
  nFloor: i64 = 0;
  rawS: bool = false;
  isError: bool = false;
  useSubsec: bool = false;
}

const MAX_JD: i64 = 464269060799999;

/** Makes `p.iJD` valid from its date and time parts (date.c's computeJD). */
export function computeJD(p: DateTime) {
  if (p.validJD) {
    return;
  }
  let Y: i64 = 2000;
  let M: i64 = 1;
  let D: i64 = 1;
  if (p.validYMD) {
    Y = p.Y;
    M = p.M;
    D = p.D;
  }
  if (Y < -4713 || Y > 9999 || p.rawS) {
    p.isError = true;
    p.validJD = false;
    return;
  }
  if (M <= 2) {
    Y--;
    M += 12;
  }
  const A = (Y + 4800) / 100;
  const B = 38 - A + A / 4;
  const X1 = 36525 * (Y + 4716) / 100;
  const X2 = 306001 * (M + 1) / 10000;
  p.iJD = (((X1 + X2 + D + B) as f64 - 1524.5) * 86400000) as i64;
  p.validJD = true;
  if (p.validHMS) {
    const ms = (p.s * 1000.0 + 0.5) as i64;
    p.iJD += p.h * 3600000 + p.m * 60000 + ms;
    if (p.tz != 0) {
      p.iJD -= p.tz * 60000;
      p.validYMD = false;
      p.validHMS = false;
      p.tz = 0;
    }
  }
}

export function computeFloor(p: DateTime) {
  if (p.D <= 28) {
    p.nFloor = 0;
  } else if (((1 << (p.M as u64)) & 0x15aa) != 0) {
    p.nFloor = 0;
  } else if (p.M != 2) {
    p.nFloor = p.D == 31 ? 1 : 0;
  } else if (p.Y % 4 != 0 || (p.Y % 100 == 0 && p.Y % 400 != 0)) {
    p.nFloor = p.D - 28;
  } else {
    p.nFloor = p.D - 29;
  }
}

export function setNow(p: DateTime) {
  p.iJD = Date.now() as i64 + 210866760000000;
  p.validJD = true;
  clearYMDHMS(p);
}

export function setRawNumber(p: DateTime, r: f64) {
  p.s = r;
  p.rawS = true;
  if (r >= 0 && r < 5373484.5) {
    p.iJD = (r * 86400000 + 0.5) as i64;
    p.validJD = true;
  }
}

export function validJulianDay(j: i64): bool {
  return j >= 0 && j <= MAX_JD;
}

/** Makes the year, month and day of `p` valid from its julian day (date.c's computeYMD). */
export function computeYMD(p: DateTime) {
  if (p.validYMD) {
    return;
  }
  if (!p.validJD) {
    p.Y = 2000;
    p.M = 1;
    p.D = 1;
  } else if (!validJulianDay(p.iJD)) {
    p.isError = true;
    return;
  } else {
    const Z = (p.iJD + 43200000) / 86400000;
    const alpha = (((Z as f64) + 32044.75) / 36524.25) as i64 - 52;
    const A = Z + 1 + alpha - (alpha + 100) / 4 + 25;
    const B = A + 1524;
    const C = (((B as f64) - 122.1) / 365.25) as i64;
    const D = (36525 * (C & 32767)) / 100;
    const E = (((B - D) as f64) / 30.6001) as i64;
    const X1 = (30.6001 * (E as f64)) as i64;
    p.D = B - D - X1;
    p.M = E < 14 ? E - 1 : E - 13;
    p.Y = p.M > 2 ? C - 4716 : C - 4715;
  }
  p.validYMD = true;
}

/** Makes the hour, minute and seconds of `p` valid from its julian day (computeHMS). */
export function computeHMS(p: DateTime) {
  if (p.validHMS) {
    return;
  }
  computeJD(p);
  const dayMs = (p.iJD + 43200000) % 86400000;
  p.s = ((dayMs % 60000) as f64) / 1000;
  const dayMin = dayMs / 60000;
  p.m = dayMin % 60;
  p.h = dayMin / 60;
  p.rawS = false;
  p.validHMS = true;
}

export function clearYMDHMS(p: DateTime) {
  p.validYMD = false;
  p.validHMS = false;
  p.tz = 0;
}
