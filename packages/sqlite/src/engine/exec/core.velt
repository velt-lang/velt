// sqlite/engine/exec/core (internal): one SELECT core compiled into nested loops: the FROM items
// (tables, subqueries, CTEs) with their joins, WHERE terms placed at the innermost level they read,
// and the rows going to the output stage, through the groups of an aggregate query when it is one.

import { SelectCore } from "../sql/types";
import { SRC_ROWS } from "./source";
import { AggRestart, prepareError } from "./errors";
import { Ev, Pred, Step } from "./types";
import { Scope } from "./scope";
import { Query } from "./query";
import { AggCtx } from "./agg/agg_ctx";
import { ExprCompiler } from "./expr_compiler";
import { checkResultWidth, orderKeys, resultColumns, checkTerms } from "./result";
import { ownsAggregate } from "./agg/agg_owner";
import {
  accessInOrder,
  distinctOrdered,
  groupIndex,
  minMaxIndex,
  orderJoins,
} from "./plan/core_plan";
import { coveringIndex, coveringLike, covers } from "./plan/covering";
import { describe } from "./plan/plan_words";
import { Emitter, limitValue } from "./emitter";
import { ACC_INDEX, ACC_SCAN, Access, accessCost } from "./plan/access";
import { chooseAccess, attachIndex } from "./plan/plan";
import { levelLoop } from "./loop/loop";
import { intVal } from "./value/val";
import { FromPart, compileFrom } from "./from_part";
import { whereTerms } from "./core_terms";
import { Counter, countOnlyCore } from "./count_only";
import { WinCtx } from "./window/win_ctx";
import { coreHasWindow, lastWindowCalls } from "./window/calls";
import { GroupState, groupStepFor, outputGroups } from "./agg/group_state";
import { Tail } from "./tail";
import { pullOf } from "./loop/pull_of";
import { valuesCore } from "./values_core";

/** Compiles one core (with the SELECT's ORDER BY and LIMIT when it is the only core). */
export function compileCore(
  c: ExprCompiler,
  core: SelectCore,
  outer: Scope | null,
  tail: Tail,
): Query {
  // Again as an aggregate query when a subquery turns out to hold one of its aggregates.
  while (true) {
    const again = core.aggFromInner;
    const refs = c.refMark();
    const rows: usize = c.rowsSrc.length;
    try {
      if (core.values.length > 0) {
        return valuesCore(c, core, outer, tail, new Query());
      }
      const fp = compileFrom(c, core, outer);
      return compileCoreOnce(c, core, outer, tail, fp);
    } catch (e) {
      if (e instanceof AggRestart && e.core == core && !again) {
        // The FROM items compile again: what they counted the first time is taken back.
        c.rewind(refs, rows);
        continue;
      }
      throw e;
    }
  }
}

function compileCoreOnce(
  c: ExprCompiler,
  core: SelectCore,
  outer: Scope | null,
  tail: Tail,
  fp: FromPart,
): Query {
  const q = new Query();
  const sc = fp.sc;
  const left = fp.left;
  sc.aliases = core.columns;
  checkResultWidth(core.columns, sc);
  const terms = whereTerms(c, core, fp);
  // Inner joins run in the order of their cheapest access paths.
  if (sc.sources.length > 1 && !left.includes(true)) {
    sc.fromOrder = sc.sources.slice();
    orderJoins(c, terms, sc);
  }
  // How each level is read.
  const access: Access[] = [];
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const a = chooseAccess(c, terms, sc, lv, left[lv]);
    for (const t of a.uses) {
      t.used = true;
    }
    if (a.kind == ACC_INDEX) {
      attachIndex(sc.sources[lv], a.index!);
    }
    access.push(a);
  }
  // Aggregates and the output scope.
  // An aggregate query: GROUP BY, or an aggregate among the result columns (one in ORDER BY
  // or HAVING alone does not make it one, as in SQLite).
  let isAgg = core.groupBy.length > 0 || core.aggFromInner;
  for (const rc of core.columns) {
    if (ownsAggregate(c, rc.expr, sc)) {
      isAgg = true;
    }
  }
  if (core.having != null && !isAgg) {
    prepareError("HAVING clause on a non-aggregate query");
  }
  const agg = new AggCtx();
  const osc0 = isAgg ? sc.forOutput(agg) : sc;
  // Window functions: the rows are collected, and go out once the windows are computed.
  const hasWin = coreHasWindow(core.columns, tail.orderBy);
  const win = new WinCtx();
  const osc = hasWin ? osc0.forWindows(win, core.windows) : osc0;
  const em = new Emitter(q.out);
  em.distinct = core.distinct;
  sc.output = !isAgg;
  // With window functions SQLite makes it an aggregate query from a subquery's aggregate only
  // in the windows it computes last (window/calls's lastWindowCalls); elsewhere that is its
  // misuse error.
  sc.results = !isAgg && !hasWin;
  if (hasWin) {
    osc.lastWins = lastWindowCalls(core.columns, tail.orderBy, core.windows);
  }
  setWindowed([sc, osc0, osc], hasWin);
  try {
    resultColumns(c, core.columns, osc, q, em);
    sc.results = false;
    osc.lastWins = [];
    q.out.width = q.names.length;
    // ORDER BY: by the loops' order when the first level gives it, else a sort.
    checkTerms(tail.orderBy.length, "ORDER");
    if (tail.orderBy.length > 0) {
      orderKeys(c, tail.orderBy, osc, q, em);
    }
  } finally {
    sc.results = false;
    setWindowed([sc, osc0, osc], false);
  }
  let sortedTerms: usize = 0;
  if (tail.orderBy.length > 0 && !isAgg && !hasWin && sc.sources.length > 0) {
    sortedTerms = accessInOrder(c, em.sort, tail.orderBy, osc, access, left, q);
    if (sortedTerms == em.sort.length) {
      em.sorting = false;
    }
  }
  // The window computed first sorts the rows: as in SQLite, the loops give its order when they
  // can (its sort is stable, so the rows it ties keep the loops' order).
  let winOrder = false;
  if (hasWin && !isAgg && sc.sources.length > 0 && win.specs.length > 0) {
    const sp = win.specs[win.specs.length - 1];
    if (sp.sk.length > 0) {
      winOrder = accessInOrder(c, sp.sk, sp.terms, sc, access, left, q) > 0;
    }
  }
  // LIMIT and OFFSET name no column, not even an enclosing query's (SQLite resolves them in an
  // empty name context).
  const limitEv: Ev | null = tail.limit == null ? null : c.ev(tail.limit!, new Scope());
  const offsetEv: Ev | null = tail.offset == null ? null : c.ev(tail.offset!, new Scope());
  // Terms that read no level of this core run once, before the loops.
  const pre: Pred[] = [];
  for (const t of terms) {
    if (t.level < 0 && !t.used && !t.virtual) {
      pre.push(t.pred);
    }
  }
  let groupStep: Step | null = null;
  const groups = new GroupState();
  if (isAgg) {
    checkTerms(core.groupBy.length, "GROUP");
    groupStep = groupStepFor(c, core, sc, agg, groups, q);
  }
  const having: Pred | null = core.having == null ? null : c.pred(core.having!, osc0);
  // SQLite sorts by a window's PARTITION BY and ORDER BY together, as one ORDER BY.
  if (win.tooManyTerms) {
    prepareError("too many terms in ORDER BY clause");
  }
  // GROUP BY or DISTINCT without ORDER BY on one table: SQLite scans an index led by the first
  // grouping column, which decides which row of a group shows its bare columns. For DISTINCT
  // over a range it does so only when the index orders all the result columns (else the range
  // stays, and DISTINCT uses a temporary b-tree).
  if (
    tail.orderBy.length == 0 &&
    !(hasWin && !isAgg) &&
    sc.sources.length == 1 &&
    accessCost(access[0]) >= 50 &&
    (core.groupBy.length > 0 || core.distinct)
  ) {
    // Over a range scan too: the range's terms are still checked on each row.
    const ix = groupIndex(c, core, sc);
    // For DISTINCT over a range, only an index that orders every result column wins.
    const ranged = core.groupBy.length == 0 && accessCost(access[0]) < 900;
    if (ix != null && (!ranged || distinctOrdered(c, core, sc, ix!))) {
      const a = new Access();
      a.kind = ACC_INDEX;
      a.index = ix;
      access[0] = a;
      attachIndex(sc.sources[0], ix!);
    }
  }
  const minmax = isAgg && !hasWin && minMaxIndex(c, core, sc, agg, access, left);
  // A full scan reads a covering index instead when one holds every column used (as SQLite
  // does: index rows are smaller), unless the table's rowid order is the ORDER BY's.
  const keepOrder = (tail.orderBy.length > 0 && !em.sorting) || winOrder;
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    if (access[lv].kind == ACC_SCAN && !(lv == 0 && keepOrder)) {
      const ix = coveringIndex(sc.sources[lv]);
      if (ix != null) {
        access[lv].kind = ACC_INDEX;
        access[lv].index = ix;
        attachIndex(sc.sources[lv], ix!);
      }
    }
  }
  // An index the plan reads that lacks a column the query uses gives way to one that has every
  // column (and the same leading ones): SQLite prefers the covering index.
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const a = access[lv];
    if (a.kind == ACC_INDEX && !covers(sc.sources[lv], a.index!)) {
      const better = coveringLike(sc.sources[lv], a);
      if (better != null) {
        a.index = better;
        attachIndex(sc.sources[lv], better!);
      }
    }
  }
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const line = describe(sc.sources[lv], access[lv]);
    // min() or max() read at one end of the index: SQLite calls that a search.
    q.plan.push(lv == 0 && minmax && line.startsWith("SCAN ") ? "SEARCH " + line.slice(5) : line);
  }
  if (em.sorting) {
    const rest = em.sort.length - sortedTerms;
    q.plan.push(
      sortedTerms == 0
        ? "USE TEMP B-TREE FOR ORDER BY"
        : rest == 1
          ? "USE TEMP B-TREE FOR LAST TERM OF ORDER BY"
          : `USE TEMP B-TREE FOR LAST ${rest} TERMS OF ORDER BY`,
    );
  }
  const emitRow: Step = hasWin ? () => win.collect() : () => em.row();
  let rowFn: Step = groupStep != null ? groupStep! : emitRow;
  if (minmax) {
    // The first row with a value is the minimum (maximum): the loops stop there.
    const step = groupStep!;
    const stopAt = q.out;
    rowFn = () => {
      step();
      if (groups.single!.accs[0].has) {
        stopAt.stop = true;
      }
    };
  }
  // `SELECT count(*) FROM … [WHERE …]` alone: the loops only count.
  const countOnly = countOnlyCore(core, isAgg, hasWin, agg);
  const counter = new Counter();
  if (countOnly) {
    rowFn = () => {
      counter.n++;
    };
  }
  let inner = rowFn;
  for (let lv: usize = sc.sources.length; lv > 0; lv--) {
    inner = levelLoop(
      c,
      sc.sources[lv - 1],
      access[lv - 1],
      terms,
      lv - 1,
      left[lv - 1],
      q.out,
      inner,
    );
  }
  const loops = inner;
  q.correlated = sc.outer || osc0.outer || osc.outer;
  for (const src of sc.sources) {
    if (src.kind == SRC_ROWS && c.rowsQuery(src).correlated) {
      q.correlated = true;
    }
  }
  // Rows that go out in the loops' order can also be read one at a time (velt/db's decoders).
  if (!isAgg && !hasWin && !em.distinct && !em.sorting) {
    const pl = pullOf(c, sc, access, terms, left, pre, em, q, limitEv, offsetEv);
    q.pull = pl;
    // Read as a FROM item, its rows are made as the reader wants them (a co-routine).
    const lazyOut = q.out;
    q.lazyStart = () => pl.begin(-1);
    q.lazyMore = () => {
      const ok = pl.next();
      if (pl.err != null) {
        throw pl.err!;
      }
      if (!ok) {
        return false;
      }
      for (let i: usize = 0; i < lazyOut.width; i++) {
        lazyOut.vals.push(pl.rowVal(i));
      }
      if (pl.err != null) {
        throw pl.err!;
      }
      lazyOut.rows++;
      return true;
    };
  }
  const need = q.need;
  const out = q.out;
  if (countOnly) {
    q.body = () => {
      let limit = limitValue(limitEv, -1);
      const offset = limitValue(offsetEv, 0);
      if (need.n >= 0 && (limit < 0 || limit > need.n)) {
        limit = need.n;
      }
      if (limit == 0) {
        return;
      }
      counter.n = 0;
      let ok = true;
      for (const p of pre) {
        if (!p()) {
          ok = false;
          break;
        }
      }
      if (ok) {
        loops();
      }
      if (offset > 0) {
        return;
      }
      out.vals.push(intVal(counter.n));
      out.rows = 1;
    };
    return q;
  }
  q.body = () => {
    let limit = limitValue(limitEv, -1);
    const offset = limitValue(offsetEv, 0);
    if (need.n >= 0 && (limit < 0 || limit > need.n)) {
      limit = need.n;
    }
    em.begin(limit, offset);
    if (limit == 0) {
      return;
    }
    if (isAgg) {
      groups.reset(agg);
    }
    if (hasWin) {
      win.reset();
    }
    for (const p of pre) {
      if (!p()) {
        if (isAgg && core.groupBy.length == 0) {
          outputGroups(agg, groups, having, em.out, emitRow, core.groupBy.length > 0);
        }
        if (hasWin) {
          win.finish(() => em.row(), () => out.stop);
        }
        em.finish();
        return;
      }
    }
    loops();
    if (minmax) {
      out.stop = false;
    }
    if (isAgg) {
      outputGroups(agg, groups, having, em.out, emitRow, core.groupBy.length > 0);
    }
    if (hasWin) {
      win.finish(() => em.row(), () => out.stop);
    }
    em.finish();
  };
  return q;
}

// Marks (or unmarks) the scopes of a query with window functions while its result columns and
// ORDER BY compile (Scope.windowed).
function setWindowed(scopes: Scope[], on: bool) {
  for (const s of scopes) {
    s.windowed = on;
  }
}
