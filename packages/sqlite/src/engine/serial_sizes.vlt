// sqlite/engine/serial_sizes (internal): the table of body sizes of the one-byte serial types, which
// engine/btree_header adds up as it decodes a record header.

/**
 * Body bytes of the one-byte serial types (0 to 127); the reserved 10 and 11 count as more
 * than any payload, so the one check after the loop catches them too. 2^32 cannot wrap: a
 * header has at most 2^31 bytes, so the sum stays below 2^64.
 */
export const SIZES: usize[] = [
  0,
  1,
