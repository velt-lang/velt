// sqlite/engine/sql/statement (internal): one statement of SQLite's grammar: EXPLAIN, then the verb
// that starts it, parsed here (SELECT, BEGIN / COMMIT / ROLLBACK / SAVEPOINT / RELEASE) or in
// engine/sql/dml (INSERT, UPDATE, DELETE), engine/sql/ddl (CREATE, DROP, ALTER) and
// engine/sql/pragma.

import { Parser } from "./parser";
import { SqlError } from "./errors";
import { T_EOF, T_IDENT, T_OP, T_SEMI } from "./token";
import {
  S_BEGIN,
  S_COMMIT,
  S_EXPLAIN,
  S_RELEASE,
  S_ROLLBACK,
  S_SAVEPOINT,
  S_SELECT,
  Statement,
} from "./types";
import { insert, remove, update } from "./dml";
import { alter, create, drop } from "./ddl";
import { pragma } from "./pragma";

/** Parses the statements of `sql` (separated by `;`; empty ones are skipped). */
export function parseAll(sql: string): Statement[] {
  const p = new Parser(sql);
  const out: Statement[] = [];
  while (true) {
    while (p.peek().kind == T_SEMI) {
      p.advance();
    }
    if (p.peek().kind == T_EOF) {
      return out;
    }
    out.push(statement(p));
    if (p.peek().kind != T_SEMI && p.peek().kind != T_EOF) {
      p.fail();
    }
  }
}

/** Parses exactly one statement (a trailing `;` is allowed). */
export function parseOne(sql: string): Statement {
  const all = parseAll(sql);
  if (all.length != 1) {
    throw new SqlError(all.length == 0 ? "no statement" : "more than one statement", 0);
  }
  return all[0];
}

/** One statement at the parser's position: EXPLAIN [QUERY PLAN], once, then the statement. */
export function statement(p: Parser): Statement {
  const from = p.peek().start;
  let s: Statement;
  if (p.eatKw("EXPLAIN")) {
    s = new Statement(S_EXPLAIN);
    if (p.eatKw("QUERY")) {
      p.expectKw("PLAN");
      s.queryPlan = true;
    }
    // Only once: `EXPLAIN EXPLAIN …` is a syntax error in SQLite (no recursion here).
    s.inner = command(p);
  } else {
    s = command(p);
  }
  s.sql = p.text(from, p.peek().start).trimEnd();
  return s;
}

/** A statement without EXPLAIN. */
function command(p: Parser): Statement {
  if (p.isKw("SELECT") || p.isKw("VALUES") || (p.isKw("WITH") && withSelect(p))) {
    const s = new Statement(S_SELECT);
    s.select = p.select();
    return s;
  }
  if (p.isKw("WITH")) {
    // WITH … INSERT / UPDATE / DELETE: the CTEs go on the statement's select.
    throw new SqlError("WITH before INSERT, UPDATE or DELETE is not supported yet", p.peek().start);
  }
  if (p.isKw("INSERT") || p.isKw("REPLACE")) {
    return insert(p);
  }
  if (p.eatKw("UPDATE")) {
    return update(p);
  }
  if (p.eatKw("DELETE")) {
    return remove(p);
  }
  if (p.eatKw("CREATE")) {
    return create(p);
  }
  if (p.eatKw("DROP")) {
    return drop(p);
  }
  if (p.eatKw("ALTER")) {
    return alter(p);
  }
  if (p.eatKw("BEGIN")) {
    const s = new Statement(S_BEGIN);
    if (p.isKw("DEFERRED") || p.isKw("IMMEDIATE") || p.isKw("EXCLUSIVE")) {
      s.mode = p.advance().upper;
    }
    transaction(p, s);
    return s;
  }
  if (p.eatKw("COMMIT") || p.eatKw("END")) {
    const s = new Statement(S_COMMIT);
    transaction(p, s);
    return s;
  }
  if (p.eatKw("ROLLBACK")) {
    const s = new Statement(S_ROLLBACK);
    transaction(p, s);
    if (p.eatKw("TO")) {
      p.eatKw("SAVEPOINT");
      s.name = p.name();
    }
    return s;
  }
  if (p.eatKw("SAVEPOINT")) {
    const s = new Statement(S_SAVEPOINT);
    s.name = p.name();
    return s;
  }
  if (p.eatKw("RELEASE")) {
    const s = new Statement(S_RELEASE);
    p.eatKw("SAVEPOINT");
    s.name = p.name();
    return s;
  }
  if (p.eatKw("PRAGMA")) {
    return pragma(p);
  }
  p.fail();
}

/** `[TRANSACTION [name]]` after BEGIN, COMMIT, END or ROLLBACK (the name means nothing). */
function transaction(p: Parser, s: Statement) {
  if (p.eatKw("TRANSACTION") && p.isName()) {
    s.transaction = p.name();
  }
}

/** Whether WITH at the parser's position starts a SELECT (looks past the CTEs' parentheses). */
function withSelect(p: Parser): bool {
  let depth = 0;
  let k: usize = 0;
  while (true) {
    const t = p.peekAt(k);
    if (t.kind == T_EOF || t.kind == T_SEMI) {
      return true;
    }
    if (t.kind == T_OP && t.text == "(") {
      depth++;
    } else if (t.kind == T_OP && t.text == ")") {
      depth--;
    } else if (
      depth == 0 &&
      t.kind == T_IDENT &&
      (t.upper == "INSERT" || t.upper == "UPDATE" || t.upper == "DELETE" || t.upper == "REPLACE")
    ) {
      return false;
    } else if (depth == 0 && t.kind == T_IDENT && (t.upper == "SELECT" || t.upper == "VALUES")) {
      return true;
    }
    k++;
  }
}
