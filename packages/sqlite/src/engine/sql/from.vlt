// sqlite/engine/sql/from (internal): the FROM clause of SQLite's SELECT (parse.y's `seltablist`): its
// items (tables, subqueries, table-valued functions) and how each joins the ones before it.

import { K_JOIN } from "./keywords";
import { SqlError } from "./errors";
import { T_EOF, T_IDENT, T_OP, T_SEMI, Token } from "./token";
import { FromItem, J_CROSS, J_FULL, J_INNER, J_LEFT, J_RIGHT } from "./types";
import { Parser } from "./parser";

/** SQLite's limits: FROM items, and tables in one join. */
const MAX_FROM: usize = 200;
const MAX_JOIN: usize = 64;

/** sqlite3JoinType's flags. */
const JT_NATURAL: u8 = 1;
const JT_LEFT: u8 = 2;
const JT_OUTER: u8 = 4;
const JT_RIGHT: u8 = 8;
const JT_INNER: u8 = 16;
const JT_CROSS: u8 = 32;
const JT_ERROR: u8 = 64;

/** The flags of one word before JOIN (upper case, as written), or JT_ERROR. */
function joinWord(w: string): u8 {
  switch (w) {
    case "NATURAL":
      return JT_NATURAL;
    case "LEFT":
      return JT_LEFT | JT_OUTER;
    case "OUTER":
      return JT_OUTER;
    case "RIGHT":
      return JT_RIGHT | JT_OUTER;
    case "FULL":
      return JT_LEFT | JT_RIGHT | JT_OUTER;
    case "INNER":
      return JT_INNER;
    case "CROSS":
      return JT_INNER | JT_CROSS;
    default:
      return JT_ERROR;
  }
}

extend Parser {
  /** FROM's items, each with how it joins the ones before it. */
  fromItems(): FromItem[] {
    const out: FromItem[] = [this.fromItem(J_INNER, false, true)];
    const at = this.peek().start;
    while (true) {
      if (out.length > MAX_FROM) {
        throw new SqlError(`too many FROM clause terms, max: ${MAX_FROM}`, this.peek().start);
      }
      let join = J_INNER;
      let natural = false;
      if (this.eatOp(",") || this.eatKw("JOIN")) {
        // A comma or a plain JOIN: an inner join.
      } else if (this.peek().kind == T_IDENT && this.classAt(this.pos) == K_JOIN) {
        // A join word, then up to two more names, then JOIN (`joinop`), in any order
        // (sqlite3JoinType).
        const words: Token[] = [this.advance()];
        while (!this.isKw("JOIN") && words.length < 3) {
          if (!this.isName()) {
            this.fail();
          }
          words.push(this.advance());
        }
        this.expectKw("JOIN");
        const flags = this.joinType(words);
        natural = (flags & JT_NATURAL) != 0;
        if ((flags & JT_CROSS) != 0) {
          join = J_CROSS;
        } else if ((flags & (JT_LEFT | JT_RIGHT)) == (JT_LEFT | JT_RIGHT)) {
          join = J_FULL;
        } else if ((flags & JT_LEFT) != 0) {
          join = J_LEFT;
        } else if ((flags & JT_RIGHT) != 0) {
          join = J_RIGHT;
        }
      } else {
        if (out.length > MAX_JOIN) {
          throw new SqlError(`at most ${MAX_JOIN} tables in a join`, at);
        }
        return out;
      }
      out.push(this.fromItem(join, natural, false));
    }
  }

  /** The join flags of the words before JOIN, or SQLite's error for a combination it rejects. */
  joinType(words: Token[]): u8 {
    let flags: u8 = 0;
    for (const w of words) {
      const f = joinWord(this.raw(w).toUpperCase());
      flags |= f;
      if (f == JT_ERROR) {
        break;
      }
    }
    if (
      (flags & (JT_INNER | JT_OUTER)) == (JT_INNER | JT_OUTER) ||
      (flags & JT_ERROR) != 0 ||
      (flags & (JT_OUTER | JT_LEFT | JT_RIGHT)) == JT_OUTER
    ) {
      const text = words.map((w) => this.raw(w)).join(" ");
      throw new SqlError(`unknown join type: ${text}`, words[0].start);
    }
    return flags;
  }

  /** Whether the next token can follow a FROM item: the end, a join, or the next clause. */
  endsFromItem(): bool {
    const t = this.peek();
    if (t.kind == T_EOF || t.kind == T_SEMI) {
      return true;
    }
    if (t.kind == T_OP) {
      return t.text == ")" || t.text == ",";
    }
    if (t.kind != T_IDENT) {
      return false;
    }
    switch (t.upper) {
      case "JOIN":
      case "WHERE":
      case "GROUP":
      case "HAVING":
      case "ORDER":
      case "LIMIT":
      case "UNION":
      case "EXCEPT":
      case "INTERSECT":
      case "RETURNING":
        return true;
      default:
        return this.classAt(this.pos) == K_JOIN || this.isKeyword("WINDOW");
    }
  }

  /** One FROM item and its ON or USING (`first`: the leftmost item, which joins nothing). */
  fromItem(join: u8, natural: bool, first: bool): FromItem {
    const item = new FromItem();
    item.join = join;
    item.natural = natural;
    // INDEXED BY and NOT INDEXED follow a table's name only.
    let plain = false;
    if (this.eatOp("(")) {
      if (this.isKw("SELECT") || this.isKw("WITH") || this.isKw("VALUES")) {
        // A FROM subquery nests through the SELECT core and FROM items: two levels.
        this.enter();
        item.subquery = this.select();
        this.leave();
        this.expectOp(")");
      } else {
        throw new SqlError("parenthesized joins are not supported yet", this.peek().start);
      }
    } else {
      item.name = this.name();
      if (this.eatOp(".")) {
        item.schema = item.name;
        item.name = this.name();
      }
      if (this.eatOp("(")) {
        if (!this.isOp(")")) {
          item.args.push(this.expr());
          while (this.eatOp(",")) {
            item.args.push(this.expr());
          }
        }
        this.expectOp(")");
      } else {
        plain = true;
      }
    }
    if (this.eatKw("AS")) {
      item.alias = this.name();
    } else if (this.isAlias()) {
      item.alias = this.advance().text;
    }
    if (plain && this.eatKw("INDEXED")) {
      this.expectKw("BY");
      item.indexedBy = this.name();
    } else if (plain && this.eatKw("NOT")) {
      this.expectKw("INDEXED");
      item.notIndexed = true;
    }
    const at = this.peek().start;
    if (this.eatKw("ON")) {
      item.on = this.expr();
    } else if (this.eatKw("USING")) {
      this.expectOp("(");
      item.using.push(this.name());
      while (this.eatOp(",")) {
        item.using.push(this.name());
      }
      this.expectOp(")");
    } else {
      return item;
    }
    if (first) {
      // SQLite reports this when the item ends, so a token that cannot follow it is the error
      // (`INSERT … SELECT * FROM t ON CONFLICT DO …` fails near DO).
      if (!this.endsFromItem()) {
        this.fail();
      }
      const what = item.on != null ? "ON" : "USING";
      throw new SqlError(`a JOIN clause is required before ${what}`, at);
    }
    return item;
  }
}
