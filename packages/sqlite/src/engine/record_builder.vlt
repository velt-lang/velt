// sqlite/engine/record_builder (internal): building a record (https://sqlite.org/fileformat2.html#record_format)
// one value at a time, and writing varints.

import { utf8Encode } from "velt/encoding";

/** A record being built, one value at a time; `finish()` gives its bytes. */
export class RecordBuilder {
  types: i64[] = [];
  body: u8[] = [];

  addNull() {
    this.types.push(0);
  }

  addInt(v: i64) {
    if (v == 0 || v == 1) {
      this.types.push(8 + v);
      return;
    }
    // The smallest of 1, 2, 3, 4, 6 and 8 bytes that holds v.
    let n: usize = 8;
    let t: i64 = 6;
    if (v >= -128 && v <= 127) {
      n = 1;
      t = 1;
    } else if (v >= -32768 && v <= 32767) {
      n = 2;
      t = 2;
    } else if (v >= -8388608 && v <= 8388607) {
      n = 3;
      t = 3;
    } else if (v >= -2147483648 && v <= 2147483647) {
      n = 4;
      t = 4;
    } else if (v >= -140737488355328 && v <= 140737488355327) {
      n = 6;
      t = 5;
    }
    this.types.push(t);
    pushBe(this.body, v as u64, n);
  }

  addReal(v: f64) {
    this.types.push(7);
    pushBe(this.body, v.toBits(), 8);
  }

  addText(s: string) {
    const bytes = utf8Encode(s);
    this.types.push(13 + 2 * (bytes.length as i64));
    for (const b of bytes) {
      this.body.push(b);
    }
  }

  addBlob(bytes: u8[]) {
    this.types.push(12 + 2 * (bytes.length as i64));
    for (const b of bytes) {
      this.body.push(b);
    }
  }

  /** Empties the builder for the next record. */
  reset() {
    this.types.truncate(0);
    this.body.truncate(0);
  }

  /** The record's bytes: the header (its size, then the serial types) and the body. */
  finish(): u8[] {
    const head: u8[] = [];
    for (const t of this.types) {
      pushVarint(head, t as u64);
    }
    // The header size counts its own varint.
    let size: usize = (head.length as usize) + 1;
    while ((head.length as usize) + varintLen(size as u64) != size) {
      size = (head.length as usize) + varintLen(size as u64);
    }
    const out: u8[] = [];
    out.reserve(size + this.body.length);
    pushVarint(out, size as u64);
    for (const b of head) {
      out.push(b);
    }
    for (const b of this.body) {
      out.push(b);
    }
    return out;
  }
}

function pushBe(out: u8[], v: u64, n: usize) {
  for (let i: usize = n; i > 0; i--) {
    out.push(((v >> ((8 * (i - 1)) as u64)) & 0xff) as u8);
  }
}

/** The length of `v` as a varint. */
export function varintLen(v: u64): usize {
  if (v >= 0x0100000000000000) {
    return 9;
  }
  let n: usize = 1;
  let rest = v >> 7;
  while (rest != 0) {
    n++;
    rest = rest >> 7;
  }
  return n;
}

/** Appends `v` as a varint. */
export function pushVarint(out: u8[], v: u64) {
  const n = varintLen(v);
  if (n == 9) {
    // Eight bytes of 7 bits, then all 8 bits of the last.
    for (let i: usize = 0; i < 8; i++) {
      out.push((((v >> ((57 - 7 * i) as u64)) & 0x7f) | 0x80) as u8);
    }
    out.push((v & 0xff) as u8);
    return;
  }
  for (let i: usize = n; i > 1; i--) {
    out.push((((v >> ((7 * (i - 1)) as u64)) & 0x7f) | 0x80) as u8);
  }
  out.push((v & 0x7f) as u8);
}
