// sqlite/engine/key_rec (internal): a key record decoded once, to compare many records against (index
// seeks and range ends), in the order of engine/record.

import { corrupt } from "./errors";
import { fieldSize, readBe, serialSize } from "./format";
import { readVarint } from "./varint";
import { utf8Encode } from "velt/encoding";
import { BINARY } from "./collation";
import { compareBytes, compareIntReal, intAt, rank } from "./record_compare";

/** A key record decoded once, to compare many records against (index seeks and range ends). */
export class KeyRec {
  bytes: u8[];
  types: i64[] = [];
  offs: usize[] = [];
  ints: i64[] = [];
  reals: f64[] = [];
  /** The first field is an integer (seeks compare it without decoding the record). */
  firstInt: bool = false;

  constructor(bytes: u8[]) {
    this.bytes = bytes;
    if (bytes.length > 0) {
      this.decode();
    }
  }

  /** Empties the key, to build it field by field (`addInt`…) without encoding a record. */
  clear() {
    this.bytes.truncate(0);
    this.types.truncate(0);
    this.offs.truncate(0);
    this.ints.truncate(0);
    this.reals.truncate(0);
    this.firstInt = false;
  }

  push(t: i64, i: i64, r: f64) {
    if (this.types.length == 0) {
      this.firstInt = t >= 1 && t <= 9 && t != 7;
    }
    this.types.push(t);
    this.offs.push(this.bytes.length);
    this.ints.push(i);
    this.reals.push(r);
  }

  addNull() {
    this.push(0, 0, 0);
  }

  addInt(v: i64) {
    this.push(6, v, 0);
  }

  addReal(v: f64) {
    this.push(7, 0, v);
  }

  addText(s: string) {
    const b = utf8Encode(s);
    this.push(13 + 2 * (b.length as i64), 0, 0);
    for (const x of b) {
      this.bytes.push(x);
    }
  }

  addBlob(b: u8[]) {
    this.push(12 + 2 * (b.length as i64), 0, 0);
    for (const x of b) {
      this.bytes.push(x);
    }
  }

  /** Decodes `bytes` (a record) in place of the key held. */
  load(bytes: u8[]) {
    this.bytes = bytes;
    this.types.truncate(0);
    this.offs.truncate(0);
    this.ints.truncate(0);
    this.reals.truncate(0);
    this.decode();
  }

  decode() {
    const bytes = this.bytes;
    const h = readVarint(bytes, 0);
    let p = h.len;
    const end = h.value as usize;
    if (end > bytes.length || end < h.len) {
      corrupt("record header size");
    }
    let body = end;
    while (p < end) {
      const v = readVarint(bytes, p);
      p += v.len;
      const t = v.value;
      // Checks the type and that its value fits the record.
      fieldSize(t, bytes.length - body);
      this.types.push(t);
      this.offs.push(body);
      this.ints.push(t >= 1 && t <= 9 && t != 7 ? intAt(bytes, body, t) : 0);
      this.reals.push(t == 7 ? f64.fromBits(readBe(bytes, body, 8)) : 0);
      body += serialSize(t);
    }
    const t0 = this.types.length > 0 ? this.types[0] : 0;
    this.firstInt = t0 >= 1 && t0 <= 9 && t0 != 7;
  }
}

/**
 * Compares the record at `a` in `x` (`na` bytes) with a decoded key over the first `fields`
 * fields (or the shorter of the two), as `compareRecords` does.
 */
export function compareToKey(
  x: u8[],
  a: usize,
  na: usize,
  k: KeyRec,
  fields: usize,
  colls: u8[],
  desc: bool[],
): i64 {
  // An integer first field against an integer key, both in one-byte header form: in place.
  if (k.firstInt && x[a] < 0x80) {
    const t = x[a + 1] as i64;
    if (t >= 1 && t <= 9 && t != 7) {
      const at = a + (x[a] as usize);
      const v = t == 1 ? ((x[at] as i64) << 56) >> 56 : intAt(x, at, t);
      const w = k.ints[0];
      if (v != w) {
        const c: i64 = v < w ? -1 : 1;
        return desc.length > 0 && desc[0] ? -c : c;
      }
      if (fields == 1) {
        return 0;
      }
    }
  }
  let p = a;
  let hs: usize = 0;
  const b0 = x[p];
  if (b0 < 0x80) {
    hs = b0 as usize;
    p++;
  } else {
    const v = readVarint(x, p);
    hs = v.value as usize;
    p += v.len;
  }
  const end = a + hs;
  if (end > a + na) {
    corrupt("record header size");
  }
  let body = end;
  const n = fields < k.types.length ? fields : k.types.length;
  let i: usize = 0;
  while (i < n && p < end) {
    let t: i64 = 0;
    const c0 = x[p];
    if (c0 < 0x80) {
      t = c0 as i64;
      p++;
    } else {
      const v = readVarint(x, p);
      t = v.value;
      p += v.len;
    }
    const kt = k.types[i];
    let c: i64 = 0;
    const ra = rank(t);
    const rb = rank(kt);
    if (ra != rb) {
      c = ra < rb ? -1 : 1;
    } else if (ra == 1) {
      if (t == 7) {
        const fa = f64.fromBits(readBe(x, body, 8));
        if (kt == 7) {
          const fb = k.reals[i];
          c = fa < fb ? -1 : fa > fb ? 1 : 0;
        } else {
          c = -compareIntReal(k.ints[i], fa);
        }
      } else {
        const ia = intAt(x, body, t);
        if (kt == 7) {
          c = compareIntReal(ia, k.reals[i]);
        } else {
          const ib = k.ints[i];
          c = ia < ib ? -1 : ia > ib ? 1 : 0;
        }
      }
    } else if (ra >= 2) {
      const coll = ra == 2 && i < colls.length ? colls[i] : BINARY;
      c = compareBytes(
        x,
        body,
        fieldSize(t, a + na - body),
        k.bytes,
        k.offs[i],
        serialSize(kt),
        coll,
      );
    }
    if (c != 0) {
      return i < desc.length && desc[i] ? -c : c;
    }
    body += fieldSize(t, a + na - body);
    i++;
  }
  return 0;
}
