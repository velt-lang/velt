// The SQLite engine written in Velt (sqlite/engine, #1720) on a database C SQLite writes
// (through the driver): each query's rows, every value printed as SQLite's quote() prints it
// (blobs as the sqlite3 shell's x'…'). The expected rows are the sqlite3 shell's (`.mode quote`)
// for the same queries on the same data; rows of a query without ORDER BY are sorted on both
// sides, since their order is SQLite's choice.
import { open } from "../src/lib";
import { openDatabase, Database } from "../src/engine/index";
import { BLOB, REAL } from "../src/engine/storage_class";
import { Val } from "../src/engine/exec/value/val";
import { quote } from "../src/engine/exec/func/func_text";
import { hexEncode } from "velt/encoding";
import { tmpdir } from "velt/os";
import { uuidv4 } from "velt/random/uuid";
import { removeSync } from "velt/fs";

const SETUP = `
CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL, note,
  nick TEXT COLLATE NOCASE);
CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, title TEXT, body TEXT,
  created TEXT NOT NULL, stars NUMERIC);
CREATE INDEX posts_user ON posts (user_id);
CREATE INDEX posts_created ON posts (created DESC, id DESC);
CREATE TABLE tags (post_id INTEGER, tag TEXT, PRIMARY KEY (post_id, tag));
CREATE INDEX tags_tag ON tags (tag);
CREATE TABLE kv (k TEXT PRIMARY KEY, v);
CREATE VIEW popular AS SELECT post_id, count(*) AS n FROM tags GROUP BY post_id HAVING count(*) > 1;
INSERT INTO users VALUES
  (1, 'alice', 30, 4.5, NULL, 'Al'), (2, 'bob', 25, 3.0, 'hi', 'BOBBY'), (3, 'carol', 35, NULL, 7, 'cc'),
  (4, 'dave', 25, 2.25, x'00ff', 'Dave'), (5, 'eve', NULL, 5.0, 1.5, 'al'), (6, 'Frank', 41, -1.0, '12', NULL),
  (7, 'grace', 30, 1e10, '', 'GRACE'), (8, 'héloïse', 28, 0.1, 'ü', 'h');
INSERT INTO posts VALUES
  (1, 1, 'Hello', 'first post', '2024-01-01', 5), (2, 1, 'Again', 'second', '2024-01-03', '7'),
  (3, 2, 'Bob here', NULL, '2024-01-02', 2.5), (4, 3, 'x', 'carol''s', '2024-01-05', NULL),
  (5, 3, 'y', 'more', '2024-01-04', 0), (6, 3, 'z', '', '2024-01-04', -3), (7, 9, 'orphan', 'no user', '2024-01-06', 1),
  (8, 5, 'Eve', 'eve', '2024-01-07', '1e2'), (9, 7, 'Grace', 'g', '2024-01-02', 'abc'), (10, 2, 'Bob 2', 'b2', '2024-01-08', 4);
INSERT INTO tags VALUES (1, 'intro'), (1, 'misc'), (2, 'misc'), (3, 'intro'), (4, 'Misc'),
  (5, 'news'), (8, 'news'), (8, 'intro'), (9, 'misc'), (10, 'x');
INSERT INTO kv VALUES ('a', 1), ('b', '2'), ('c', 3.5), ('d', NULL), ('e', x'41'), ('f', 'text'),
  ('g', -9223372036854775808), ('h', 9223372036854775807), ('i', 1e300), ('j', 0.30000000000000004);
`;

/** A query and the rows it gives (or its error). */
struct Case {
  sql: string;
  rows: string[];
}

const Q_SCANS_LOOKUPS_RANGES_AND_INDEXES: Case[] = [
  // Scans, lookups, ranges and index access.
  Case {
    sql: "SELECT * FROM users",
    rows: [
      "1,'alice',30,4.5,NULL,'Al'",
      "2,'bob',25,3.0,'hi','BOBBY'",
      "3,'carol',35,NULL,7,'cc'",
      "4,'dave',25,2.25,x'00ff','Dave'",
      "5,'eve',NULL,5.0,1.5,'al'",
      "6,'Frank',41,-1.0,'12',NULL",
      "7,'grace',30,10000000000.0,'','GRACE'",
      "8,'héloïse',28,0.1,'ü','h'",
    ],
  },
  Case { sql: "SELECT id, name FROM users WHERE id = 3", rows: ["3,'carol'"] },
  Case { sql: "SELECT id FROM users WHERE id > 2 AND id <= 5", rows: ["3", "4", "5"] },
  Case { sql: "SELECT id FROM users WHERE id BETWEEN 2.5 AND 6", rows: ["3", "4", "5", "6"] },
  Case { sql: "SELECT id FROM users WHERE id < '4'", rows: ["1", "2", "3"] },
  Case {
    sql: "SELECT id, title FROM posts WHERE user_id = 3 ORDER BY id",
    rows: ["4,'x'", "5,'y'", "6,'z'"],
  },
  Case { sql: "SELECT id FROM posts WHERE user_id = '2' ORDER BY id", rows: ["3", "10"] },
  Case {
    sql: "SELECT id, created FROM posts ORDER BY created DESC, id DESC LIMIT 4",
    rows: ["10,'2024-01-08'", "8,'2024-01-07'", "7,'2024-01-06'", "4,'2024-01-05'"],
  },
  Case {
    sql: "SELECT id, created FROM posts ORDER BY created DESC, id DESC LIMIT 3 OFFSET 2",
    rows: ["7,'2024-01-06'", "4,'2024-01-05'", "6,'2024-01-04'"],
  },
  Case {
    sql: "SELECT id, created FROM posts WHERE created > '2024-01-03' ORDER BY created, id",
    rows: [
      "5,'2024-01-04'",
      "6,'2024-01-04'",
      "4,'2024-01-05'",
      "7,'2024-01-06'",
      "8,'2024-01-07'",
      "10,'2024-01-08'",
    ],
  },
  Case {
    sql: "SELECT post_id FROM tags WHERE tag = 'misc' ORDER BY post_id",
    rows: ["1", "2", "9"],
  },
  Case {
    sql: "SELECT k, v, typeof(v) FROM kv ORDER BY k",
    rows: [
      "'a',1,'integer'",
      "'b','2','text'",
      "'c',3.5,'real'",
      "'d',NULL,'null'",
      "'e',x'41','blob'",
      "'f','text','text'",
      "'g',-9223372036854775808,'integer'",
      "'h',9223372036854775807,'integer'",
      "'i',1.0e+300,'real'",
      "'j',0.30000000000000004,'real'",
    ],
  },
  Case {
    sql: "SELECT id, title FROM posts WHERE id IN (9, 2, 4, 2, NULL, '3')",
    rows: ["2,'Again'", "3,'Bob here'", "4,'x'", "9,'Grace'"],
  },
  Case {
    sql: "SELECT id FROM posts WHERE user_id IN (3, 7) ORDER BY id",
    rows: ["4", "5", "6", "9"],
  },
  Case {
    sql: "SELECT p.title, v.n FROM popular v JOIN posts p ON p.id = v.post_id ORDER BY 1",
    rows: ["'Eve',2", "'Hello',2"],
  },
  Case { sql: "SELECT rowid, oid, _rowid_ FROM users WHERE rowid < 3", rows: ["1,1,1", "2,2,2"] },
];

const Q_EXPRESSIONS_NULL_AND_AFFINITY: Case[] = [
  // Expressions, NULL and affinity rules.
  Case {
    sql: "SELECT 1 + 2, 7 / 2, 7.0 / 2, 7 % 3, -7 % 3, 7 % -3, 5 / 0, 5 % 0, 2.5 * 2",
    rows: ["3,3,3.5,1,-1,1,NULL,NULL,5.0"],
  },
  Case {
    sql:
      "SELECT 9223372036854775807 + 1, -9223372036854775808 - 1, 3037000500 * 3037000500, -(-9223372036854775808)",
    rows: [
      "9.2233720368547758e+18,-9.2233720368547758e+18,9.2233720370002493e+18,9.2233720368547758e+18",
    ],
  },
  Case {
    sql:
      "SELECT 1 / 3.0, 2.0 / 3, 0.1 + 0.2, 1e300 * 1e10, -1e300 * 1e10, 100.0, 1e15, 1e16, 123456789012345678.0",
    rows: [
      "0.33333333333333332,0.66666666666666663,0.30000000000000004,Inf,-Inf,100.0,1000000000000000.0,10000000000000000.0,1.2345678901234568e+17",
    ],
  },
  Case { sql: "SELECT 'abc' || 1 || 2.5 || NULL, 'x' || x'41'", rows: ["NULL,'xA'"] },
  Case {
    sql:
      "SELECT 1 = 1, 1 = '1', '1' = 1, 1 < 'a', x'00' > 'z', NULL = NULL, NULL IS NULL, 1 IS NOT NULL",
    rows: ["1,0,0,1,1,NULL,1,1"],
  },
  Case {
    sql: "SELECT 1 AND NULL, 0 AND NULL, 1 OR NULL, 0 OR NULL, NOT NULL, NOT 0, NOT 'a', NOT '1x'",
    rows: ["NULL,0,1,NULL,NULL,1,1,0"],
  },
  Case {
    sql: "SELECT id, name FROM users WHERE age = '25' ORDER BY id",
    rows: ["2,'bob'", "4,'dave'"],
  },
  Case { sql: "SELECT id FROM users WHERE note = 7", rows: ["3"] },
  Case { sql: "SELECT id FROM users WHERE note = '7'", rows: [] },
  Case {
    sql: "SELECT id, nick FROM users WHERE nick = 'al' ORDER BY id",
    rows: ["1,'Al'", "5,'al'"],
  },
  Case { sql: "SELECT id FROM users WHERE nick = 'AL' COLLATE BINARY", rows: [] },
  Case {
    sql: "SELECT id FROM users WHERE name > 'b' AND name < 'e' ORDER BY name",
    rows: ["2", "3", "4"],
  },
  Case {
    sql: "SELECT 5 & 3, 5 | 3, 1 << 62, 1 << 64, -8 >> 1, -8 >> 100, ~5, 1 << -1",
    rows: ["1,7,4611686018427387904,0,-4,-1,-6,0"],
  },
  Case {
    sql:
      "SELECT 3 BETWEEN 1 AND 5, 3 NOT BETWEEN 4 AND 5, NULL BETWEEN 1 AND 2, 'b' BETWEEN 'a' AND 'c'",
    rows: ["1,1,NULL,1"],
  },
  Case {
    sql:
      "SELECT 2 IN (1, 2), 3 IN (1, 2), NULL IN (1), 3 IN (1, NULL), 3 NOT IN (1, NULL), 1 IN (), 1 NOT IN ()",
    rows: ["1,0,NULL,NULL,NULL,0,1"],
  },
  Case {
    sql:
      "SELECT CASE 2 WHEN 1 THEN 'one' WHEN 2 THEN 'two' ELSE 'many' END, CASE WHEN NULL THEN 1 ELSE 0 END, CASE 1 WHEN NULL THEN 1 END",
    rows: ["'two',0,NULL"],
  },
  Case {
    sql:
      "SELECT CAST('12abc' AS INTEGER), CAST('1e3' AS INTEGER), CAST(' 12 ' AS INTEGER), CAST(3.9 AS INTEGER), CAST(-3.9 AS INT)",
    rows: ["12,1,12,3,-3"],
  },
  Case {
    sql:
      "SELECT CAST('1.5e3' AS REAL), CAST('abc' AS REAL), CAST(12 AS TEXT), CAST(1.5 AS TEXT), CAST('4.0' AS NUMERIC), CAST('x' AS NUMERIC)",
    rows: ["1500.0,0.0,'12','1.5',4,0"],
  },
  Case {
    sql:
      "SELECT CAST(x'616263' AS TEXT), CAST('abc' AS BLOB), CAST(NULL AS TEXT), typeof(CAST(1 AS BLOB))",
    rows: ["'abc',x'616263',NULL,'blob'"],
  },
];

const Q_FUNCTIONS: Case[] = [
  // Functions.
  Case {
    sql:
      "SELECT length('héllo'), length(x'0102'), length(123), length(NULL), octet_length('héllo')",
    rows: ["5,2,3,NULL,6"],
  },
  Case {
    sql:
      "SELECT lower('ÀBC'), upper('héllo'), typeof(1), typeof(1.0), typeof('x'), typeof(x''), typeof(NULL)",
    rows: ["'Àbc','HéLLO','integer','real','text','blob','null'"],
  },
  Case {
    sql:
      "SELECT substr('hello', 2), substr('hello', 2, 3), substr('hello', -3), substr('hello', -3, 2), substr('hello', 0, 2), substr('hello', 10), substr(x'010203', 2, 1)",
    rows: ["'ello','ell','llo','ll','h','',x'02'"],
  },
  Case {
    sql:
      "SELECT substr('héllo', 2, 2), substr('hello', 3, -2), substr('hello', NULL), substr('hello', 2, NULL)",
    rows: ["'él','he',NULL,NULL"],
  },
  Case {
    sql:
      "SELECT instr('hello', 'l'), instr('hello', 'z'), instr('héllo', 'l'), instr(x'0102', x'02'), instr('a', '')",
    rows: ["3,0,3,2,1"],
  },
  Case {
    sql:
      "SELECT replace('hello', 'l', 'L'), replace('aaa', 'a', 'bb'), replace('x', '', 'y'), replace(NULL, 'a', 'b')",
    rows: ["'heLLo','bbbbbb','x',NULL"],
  },
  Case {
    sql:
      "SELECT trim('  x  '), ltrim('  x  '), rtrim('  x  '), trim('xxaxx', 'x'), ltrim('abcba', 'ab'), trim(NULL)",
    rows: ["'x','x  ','  x','a','cba',NULL"],
  },
  Case {
    sql:
      "SELECT abs(-5), abs(5.5), abs(-0.0), abs('x'), abs(NULL), sign(-3), sign(0.0), sign('2'), sign('x')",
    rows: ["5,5.5,0.0,0.0,NULL,-1,0,1,NULL"],
  },
  Case {
    sql:
      "SELECT round(2.5), round(-2.5), round(1.2345, 2), round(1.005, 2), round(123.456, -1), round(NULL), round(1e20, 2)",
    rows: ["3.0,-3.0,1.23,1.0,123.0,NULL,1.0e+20"],
  },
  Case {
    sql:
      "SELECT hex('abc'), hex(x'00ff'), hex(12), hex(NULL), quote('it''s'), quote(1.5), quote(x'0a'), quote(NULL)",
    rows: ["'616263','00FF','3132','','''it''''s''','1.5','X''0A''','NULL'"],
  },
  Case {
    sql:
      "SELECT coalesce(NULL, NULL, 3), ifnull(NULL, 'x'), nullif(1, 1), nullif(1, 2), iif(1, 'y', 'n'), iif(0, 'y', 'n')",
    rows: ["3,'x',NULL,1,'y','n'"],
  },
  Case {
    sql: "SELECT min(3, 1, 2), max(3, 1, 2), max(1, NULL), min('b', 'a'), max(1, 'a', x'00')",
    rows: ["1,3,NULL,'a',x'00'"],
  },
  Case {
    sql:
      "SELECT 'abc' LIKE 'A%', 'abc' LIKE 'b%', 'a_c' LIKE 'a\\_c' ESCAPE '\\', 'abc' NOT LIKE '%z%', NULL LIKE 'a'",
    rows: ["1,0,1,1,NULL"],
  },
  Case {
    sql:
      "SELECT 'abc' GLOB 'a*', 'abc' GLOB 'A*', 'a1' GLOB 'a[0-9]', 'ab' GLOB 'a[^b]', 'a?' GLOB 'a?'",
    rows: ["1,0,1,0,1"],
  },
  Case {
    sql:
      "SELECT date('2024-02-29 13:45:12.345'), time('2024-02-29 13:45:12.345', 'subsec'), datetime(1700000000, 'unixepoch'), julianday('2000-01-01'), unixepoch('2024-03-31 23:59:59+02:00')",
    rows: ["'2024-02-29','13:45:12.345','2023-11-14 22:13:20',2451544.5,1711922399"],
  },
  Case {
    sql:
      "SELECT date('2024-01-31', '+1 month'), date('2024-01-31', '+1 month', 'floor'), date('2024-03-15', 'start of month', '-1 day'), date('2024-03-15', 'weekday 0'), datetime('2024-03-15', '+90 minutes')",
    rows: ["'2024-03-02','2024-02-29','2024-02-29','2024-03-17','2024-03-15 01:30:00'"],
  },
  Case {
    sql:
      "SELECT strftime('%Y-%m-%d %H:%M:%S %j %w %W %V %G', '2024-12-30 08:05:09'), strftime('%s', '1970-01-02'), date('bad'), date(NULL), time('12:30')",
    rows: ["'2024-12-30 08:05:09 365 1 53 01 2025','86400',NULL,NULL,'12:30:00'"],
  },
  Case {
    sql:
      "SELECT printf('%d|%5.2f|%-4s|%q|%Q|%x|%,d|%e|%g|%c', 42, 3.14159, 'ab', 'it''s', NULL, 255, 1234567, 12345.678, 0.0001, 'xyz'), format('%s=%d', 'n', 7)",
    rows: ["'42| 3.14|ab  |it''''s|NULL|ff|1,234,567|1.234568e+04|0.0001|x','n=7'"],
  },
  Case {
    sql:
      "SELECT char(72, 105), unicode('é'), unicode(''), zeroblob(3), concat('a', NULL, 1), concat_ws('-', 'a', NULL, 'b')",
    rows: ["'Hi',233,NULL,x'000000','a1','a-b'"],
  },
];

const Q_JOINS: Case[] = [
  // Joins.
  Case {
    sql: "SELECT u.name, p.title FROM users u JOIN posts p ON p.user_id = u.id ORDER BY p.id",
    rows: [
      "'alice','Hello'",
      "'alice','Again'",
      "'bob','Bob here'",
      "'carol','x'",
      "'carol','y'",
      "'carol','z'",
      "'eve','Eve'",
      "'grace','Grace'",
      "'bob','Bob 2'",
    ],
  },
  Case {
    sql:
      "SELECT u.name, p.title FROM users u, posts p WHERE p.user_id = u.id AND u.age > 28 ORDER BY u.id, p.id",
    rows: [
      "'alice','Hello'",
      "'alice','Again'",
      "'carol','x'",
      "'carol','y'",
      "'carol','z'",
      "'grace','Grace'",
    ],
  },
  Case {
    sql:
      "SELECT u.name, p.id FROM users u LEFT JOIN posts p ON p.user_id = u.id ORDER BY u.id, p.id",
    rows: [
      "'alice',1",
      "'alice',2",
      "'bob',3",
      "'bob',10",
      "'carol',4",
      "'carol',5",
      "'carol',6",
      "'dave',NULL",
      "'eve',8",
      "'Frank',NULL",
      "'grace',9",
      "'héloïse',NULL",
    ],
  },
  Case {
    sql:
      "SELECT u.name, p.id FROM users u LEFT JOIN posts p ON p.user_id = u.id WHERE p.id IS NULL ORDER BY u.id",
    rows: ["'dave',NULL", "'Frank',NULL", "'héloïse',NULL"],
  },
  Case {
    sql: "SELECT p.id, u.name FROM posts p LEFT JOIN users u ON u.id = p.user_id ORDER BY p.id",
    rows: [
      "1,'alice'",
      "2,'alice'",
      "3,'bob'",
      "4,'carol'",
      "5,'carol'",
      "6,'carol'",
      "7,NULL",
      "8,'eve'",
      "9,'grace'",
      "10,'bob'",
    ],
  },
  Case {
    sql:
      "SELECT p.title, t.tag FROM posts p JOIN tags t ON t.post_id = p.id WHERE t.tag = 'intro' ORDER BY p.id",
    rows: ["'Hello','intro'", "'Bob here','intro'", "'Eve','intro'"],
  },
  Case {
    sql:
      "SELECT a.id, b.id FROM users a JOIN users b ON a.age = b.age AND a.id < b.id ORDER BY 1, 2",
    rows: ["1,7", "2,4"],
  },
  Case {
    sql:
      "SELECT * FROM tags JOIN posts ON posts.id = tags.post_id WHERE tags.tag = 'news' ORDER BY posts.id",
    rows: ["5,'news',5,3,'y','more','2024-01-04',0", "8,'news',8,5,'Eve','eve','2024-01-07',100"],
  },
  Case {
    sql:
      "SELECT id, name FROM users JOIN (SELECT user_id AS id, count(*) AS n FROM posts GROUP BY user_id) USING (id) ORDER BY id",
    rows: ["1,'alice'", "2,'bob'", "3,'carol'", "5,'eve'", "7,'grace'"],
  },
];

const Q_AGGREGATES: Case[] = [
  // Aggregates.
  Case {
    sql:
      "SELECT count(*), count(age), sum(age), total(age), avg(age), min(age), max(age) FROM users",
    rows: ["8,7,214,214.0,30.571428571428573,25,41"],
  },
  Case {
    sql: "SELECT count(*), sum(age), avg(age), min(age) FROM users WHERE id > 100",
    rows: ["0,NULL,NULL,NULL"],
  },
  Case {
    sql: "SELECT age, count(*) FROM users GROUP BY age",
    rows: ["25,2", "28,1", "30,2", "35,1", "41,1", "NULL,1"],
  },
  Case {
    sql: "SELECT age, count(*) AS n FROM users GROUP BY age HAVING n > 1 ORDER BY n DESC, age",
    rows: ["25,2", "30,2"],
  },
  Case {
    sql:
      "SELECT user_id, count(*), max(created), min(title) FROM posts GROUP BY user_id ORDER BY user_id",
    rows: [
      "1,2,'2024-01-03','Again'",
      "2,2,'2024-01-08','Bob 2'",
      "3,3,'2024-01-05','x'",
      "5,1,'2024-01-07','Eve'",
      "7,1,'2024-01-02','Grace'",
      "9,1,'2024-01-06','orphan'",
    ],
  },
  Case {
    sql: "SELECT count(DISTINCT age), count(DISTINCT nick), sum(DISTINCT age) FROM users",
    rows: ["5,6,159"],
  },
  Case {
    sql: "SELECT group_concat(name), group_concat(name, '; ') FROM users WHERE id < 5",
    rows: ["'alice,bob,carol,dave','alice; bob; carol; dave'"],
  },
  Case {
    sql: "SELECT sum(v), total(v), avg(v), count(v), min(v), max(v) FROM kv WHERE k < 'g'",
    rows: ["6.5,6.5,1.3,5,1,x'41'"],
  },
  Case {
    sql: "SELECT sum(stars), avg(stars), max(stars), min(stars) FROM posts",
    rows: ["116.5,12.944444444444445,'abc',-3"],
  },
  Case {
    sql: "SELECT nick, count(*) FROM users GROUP BY nick ORDER BY 1",
    rows: ["NULL,1", "'Al',2", "'BOBBY',1", "'cc',1", "'Dave',1", "'GRACE',1", "'h',1"],
  },
  Case { sql: "SELECT name, max(score) FROM users", rows: ["'grace',10000000000.0"] },
  Case { sql: "SELECT name, min(age) FROM users WHERE age IS NOT NULL", rows: ["'bob',25"] },
  Case {
    sql: "SELECT count(*) FILTER (WHERE age > 28), sum(age) FILTER (WHERE id % 2 = 0) FROM users",
    rows: ["4,119"],
  },
  Case { sql: "SELECT sum(9223372036854775807), 1", rows: ["9223372036854775807,1"] },
];

