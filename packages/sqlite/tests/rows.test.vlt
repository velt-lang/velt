// Rows into typed objects: what each column fills and how a row that does not fit fails are
// the same whether the package reads the rows by column (plain fields) or through the JSON
// decoder.
import { open, Database } from "../src/lib";

struct Row {
  id: i64;
  name: string;
  score: f64;
  ok: bool;
  data: u8[];
  note: string | null;
}

class Small {
  n: u8 = 0;
  label: string = "";
}

struct Strict {
  id: i64;
  name: string;
}

function show(r: Row): string {
  return `${r.id} ${r.name} ${r.score} ${r.ok} [${r.data.join(",")}] ${r.note}`;
}

function setup(): Database {
  const db = open(":memory:");
  db.exec(`
    CREATE TABLE t (id INTEGER, name TEXT, score REAL, ok BOOLEAN, data BLOB, note TEXT);
    INSERT INTO t VALUES (1, 'ada', 2.5, 1, x'0102', NULL), (2, 'bob', 3, 0, x'', 'hi');
  `);
  return db;
}

export function test_columns_fill_fields() {
  const db = setup();
  const shown: string[] = [];
  for (const r of db.prepare("SELECT * FROM t ORDER BY id").all<Row>()) {
    shown.push(show(r));
  }
  assertEq(shown, ["1 ada 2.5 true [1,2] null", "2 bob 3 false [] hi"]);
  db.close();
}

export function test_extra_missing_and_repeated_columns() {
  const db = setup();
  // An extra column is ignored; a missing `T | null` column leaves it null; a repeated column:
  // the later value wins.
  const extra = db
    .prepare("SELECT id, 'x' AS name, 1 AS score, ok, data, 7 AS other, 'first' AS name FROM t")
    .get<Row>();
  assert(extra != null, "a row is read");
  if (extra != null) {
    assertEq(extra.id, 1);
    assertEq(extra.name, "first");
    assertEq(extra.score, 1.0);
    assertEq(extra.ok, true);
    assertEq(extra.data, [1u8, 2u8]);
    assertEq(extra.note, null);
  }
  db.close();
}

export function test_class_row_and_integer_range() {
  const db = setup();
  // A class as the row type, and an integer in range of its field.
  const s = db.prepare("SELECT 200 AS n, 'small' AS label").get<Small>();
  assertEq(s?.n, 200u8);
  assertEq(s?.label, "small");

  const failing = [
    "SELECT 300 AS n, 'big' AS label",
    "SELECT -1 AS n, 'neg' AS label",
    "SELECT 1.5 AS n, 'frac' AS label",
  ];
  const messages: string[] = [];
  for (const sql of failing) {
    try {
      db.prepare(sql).get<Small>();
      messages.push("no error");
    } catch (e) {
      messages.push(e.message.clone());
    }
  }
  assertEq(messages, [
    "row does not match the requested type: expected u8 at $.n",
    "row does not match the requested type: expected u8 at $.n",
    "row does not match the requested type: expected u8 at $.n",
  ]);
  db.close();
}

export function test_rows_that_do_not_fit() {
  const db = setup();
  const strict = [
    "SELECT NULL AS id, 'n' AS name",
    "SELECT 1 AS id",
    "SELECT 'one' AS id, 'n' AS name",
    "SELECT 1 AS id, 2 AS name",
  ];
  const messages: string[] = [];
  for (const sql of strict) {
    try {
      db.prepare(sql).all<Strict>();
      messages.push("no error");
    } catch (e) {
      messages.push(e.message.clone());
    }
  }
  assertEq(messages, [
    "row does not match the requested type: expected i64 at $[0].id",
    'row does not match the requested type: expected field "name" at $[0]',
    "row does not match the requested type: expected i64 at $[0].id",
    "row does not match the requested type: expected string at $[0].name",
  ]);
  db.close();
}
