// The schema the Velt SQLite engine reads (src/engine/schema/, #1720), a test of the package,
// against C SQLite's own account of the same file (pragma table_info, index_list, index_xinfo):
// columns, the rowid alias, automatic indexes numbered as SQLite numbers them (constraints in
// source order, a repeated key making no second index), collations, directions, WITHOUT ROWID
// tables, keywords as names, and an index over a collation the engine does not know.
import { open, Database } from "../src/lib";
import { DbFile } from "../src/engine/db_file";
import { Cursor } from "../src/engine/cursor";
import { Index } from "../src/engine/schema/table_index";
import { Table } from "../src/engine/schema/table";
import { loadSchema } from "../src/engine/schema/load";
import { BINARY, NOCASE } from "../src/engine/collation";
import { tmpdir } from "velt/os";
import { uuidv4 } from "velt/random/uuid";
import { readFileBytesSync, removeSync } from "velt/fs";

const TABLES: string[] = [
  "CREATE TABLE t1 (a, b, c, UNIQUE (c), PRIMARY KEY (a, b))",
  "CREATE TABLE t2 (a UNIQUE PRIMARY KEY, b)",
  "CREATE TABLE t3 (a PRIMARY KEY, b UNIQUE) WITHOUT ROWID",
  "CREATE TABLE t4 (a INTEGER PRIMARY KEY UNIQUE, b UNIQUE)",
  "CREATE TABLE t5 (a UNIQUE, b, UNIQUE (a), UNIQUE (b, a), UNIQUE (a COLLATE NOCASE), UNIQUE (a COLLATE BINARY))",
  "CREATE TABLE t6 (a INTEGER PRIMARY KEY DESC, b UNIQUE)",
  "CREATE TABLE t7 (a INTEGER, b UNIQUE, PRIMARY KEY (a DESC))",
  "CREATE TABLE t8 (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE UNIQUE, r TEXT COLLATE RTRIM, n INT NOT NULL DEFAULT 0, f FLOATING POINT, d DECIMAL(10, 2), blob, v VARCHAR(9))",
  "CREATE INDEX t8_r ON t8 (r, n DESC)",
  "CREATE INDEX t8_x ON t8 (name COLLATE BINARY, lower(name), id) WHERE n > 0",
  "CREATE TABLE t9 (a TEXT, b INTEGER, c, PRIMARY KEY (b, a), UNIQUE (c)) WITHOUT ROWID",
  "CREATE INDEX t9_a ON t9 (a DESC)",
  "CREATE TABLE t10 (a INT PRIMARY KEY, b TEXT UNIQUE COLLATE RTRIM)",
  // Keywords SQLite takes as names (`end`, `offset`, join words), MATCH FULL, a table CHECK
  // with ON CONFLICT, constraints without commas and quoted types: the table loads, as in C SQLite.
  "CREATE TABLE kw (end INTEGER PRIMARY KEY, offset TEXT NOT NULL DEFAULT 'o', left UNIQUE, right 'big' int, by DEFAULT end, with REFERENCES t4 (a) MATCH FULL ON DELETE CASCADE, match [x] y, CHECK (offset <> '') ON CONFLICT ABORT UNIQUE (by, with))",
  "CREATE INDEX kw_left ON kw (left DESC, offset)",
  // The statements a review found dropped without a word: each is in the schema now, usable
  // or (the virtual table) unsupported with why.
  "CREATE TABLE r1 (id INTEGER PRIMARY KEY)",
  "CREATE TABLE p1 (a INTEGER PRIMARY KEY, b REFERENCES r1 (id) MATCH FULL)",
  "CREATE TABLE p2 (a, b, CHECK (a > 0) ON CONFLICT FAIL)",
  "CREATE TABLE p3 (a, b, UNIQUE (a) UNIQUE (b))",
  `CREATE TABLE p4 (a "INTEGER", b 'TEXT')`,
  "CREATE TABLE p5b (end INT, left TEXT, offset REAL)",
  "CREATE VIRTUAL TABLE vt USING fts5 (x)",
  "CREATE VIEW pv AS SELECT a FROM p2",
  // Generated columns: a VIRTUAL one is not in the record, so the fields after it move up; a
  // WITHOUT ROWID table's record holds its key first.
  "CREATE TABLE p6 (a INT, b AS (a * 2), c INT GENERATED ALWAYS AS (a + 1) STORED, d TEXT)",
  "CREATE TABLE w6 (x TEXT, v AS (length(k)), k TEXT PRIMARY KEY, s AS (k || x) STORED) WITHOUT ROWID",
  // STRICT: ANY has no affinity there ('1' stays text), NUMERIC elsewhere.
  "CREATE TABLE s1 (a ANY, b INT) STRICT",
  "CREATE TABLE s2 (a ANY, b INT)",
  "CREATE TABLE odd (a TEXT COLLATE NOCASE, b)",
  "CREATE INDEX odd_a ON odd (a)",
];

struct Info {
  name: string;
  type: string;
  notnull: i64;
  dflt_value: string | null;
  pk: i64;
  hidden: i64;
}

struct IndexRow {
  name: string;
  unique: i64;
  origin: string;
  partial: i64;
}

struct XInfo {
  cid: i64;
  desc: i64;
  coll: string;
  key: i64;
}

struct Text {
  v: string;
}

struct Kind {
  k: string;
}

struct Rowid {
  same: i64;
}

function collName(c: u8): string {
  return c == BINARY ? "BINARY" : c == NOCASE ? "NOCASE" : "RTRIM";
}

/** The rowid alias as C SQLite has it: the one INTEGER key column whose value is the rowid. */
function cRowid(db: Database, t: string, cols: Info[]): string {
  for (const c of cols) {
    if (c.pk == 1 && c.type.toUpperCase() == "INTEGER") {
      db.exec("SAVEPOINT probe");
      db.exec(`INSERT INTO ${t} (${c.name}) VALUES (77)`);
      const r: Rowid[] = db
        .prepare(`SELECT rowid = ${c.name} AS same FROM ${t} WHERE ${c.name} = 77`)
        .all();
      db.exec("ROLLBACK TO probe; RELEASE probe");
      return r.length == 1 && r[0].same == 1 ? c.name : "none";
    }
  }
  return "none";
}

function describeIndex(ix: Index, t: Table): string {
  const cols: string[] = [];
  for (let i: usize = 0; i < ix.columns.length; i++) {
    const p = ix.columns[i];
    // The rowid alias is the rowid in an index; C SQLite names it by its column.
    const alias = t.rowidColumn >= 0 ? t.columns[t.rowidColumn as usize].name : "rowid";
    const name = p == -1 ? alias : p == -2 ? "expr" : t.columns[p as usize].name;
    cols.push(`${name}${ix.desc[i] ? " desc" : ""} ${collName(ix.colls[i])}`);
  }
  return `${ix.name}${ix.unique ? " unique" : ""}${ix.partial ? " partial" : ""}: ${cols.join(", ")}`;
}

/** C SQLite's view of an index, in the same words. */
function describeC(db: Database, r: IndexRow, cols: Info[]): string {
  const xs: XInfo[] = db
    .prepare(`SELECT cid, desc, coll, key FROM pragma_index_xinfo('${r.name}') ORDER BY seqno`)
    .all();
  const parts: string[] = [];
  for (const x of xs) {
    if (x.key == 0) {
      continue;
    }
    const name = x.cid == -1 ? "rowid" : x.cid == -2 ? "expr" : cols[x.cid as usize].name;
    parts.push(`${name}${x.desc == 1 ? " desc" : ""} ${x.coll.toUpperCase()}`);
  }
  return `${r.name}${r.unique == 1 ? " unique" : ""}${r.partial == 1 ? " partial" : ""}: ${parts.join(", ")}`;
}

/** A database file holding TABLES and a few rows, written by C SQLite; its path. */
function makeDb(): string {
  const path = `${tmpdir()}/velt-sqlite-schema-${uuidv4()}.db`;
  const db = open(path);
  for (const sql of TABLES) {
    db.exec(sql);
  }
  db.exec(`
    INSERT INTO p6 (a, d) VALUES (5, 'five'), (-1, 'minus one');
    INSERT INTO w6 (x, k) VALUES ('x1', 'key one'), ('x2', 'k2');
    INSERT INTO s1 VALUES ('1', 2); INSERT INTO s2 VALUES ('1', 2);
  `);
  // An index over a collation C SQLite knows when it is made, renamed in the stored schema to
  // one neither engine has: its order cannot be trusted for seeks.
  db.exec(`
    PRAGMA writable_schema = ON;
    UPDATE sqlite_schema SET sql = replace(sql, 'NOCASE', 'FRENCH') WHERE name = 'odd';
    PRAGMA writable_schema = OFF;
  `);
  db.close();
  return path;
}

export function test_views() {
  const path = makeDb();
  const schema = loadSchema(new DbFile(readFileBytesSync(path)));
  const lines: string[] = [];
  for (const v of schema.views) {
    lines.push(`${v.name} (view): ${v.select.cores.length} SELECT core`);
  }
  assertEq(lines, ["pv (view): 1 SELECT core"]);
  removeSync(path);
}

// Each table's columns, affinities, rowid alias and indexes, against C SQLite's pragmas.
export function test_tables_columns_and_indexes() {
  const path = makeDb();
  const c = open(path);
  const schema = loadSchema(new DbFile(readFileBytesSync(path)));
  const lines: string[] = [];
  let differ = 0;
  for (const t of schema.tables) {
    if (t.name == "sqlite_schema") {
      continue;
    }
    if (t.unsupported != "") {
      // Kept, with why it cannot be used; using it throws that.
      let thrown = "";
      try {
        schema.table(t.name);
      } catch (e) {
        thrown = e.message;
      }
      lines.push(`${t.name} (${t.kind}): unsupported: ${thrown}`);
      for (const ix of t.indexes) {
        lines.push(`  ${ix.name}: unsupported: ${ix.unsupported}`);
      }
      continue;
    }
    const cols: Info[] = c
      .prepare(
        `SELECT name, type, "notnull", dflt_value, pk, hidden FROM pragma_table_xinfo('${t.name}') ORDER BY cid`,
      )
      .all();
    const mine = t.columns
      .map(
        (
          col,
        ) => `${col.name} ${col.type}${col.notNull ? " not null" : ""}${col.hasDefault ? " default" : ""}${col.generated ? (col.stored ? " stored" : " virtual") : ""}`,
      )
      .join(", ");
    const affs = t.columns.map((col) => String(col.affinity)).join("");
    const theirs = cols
      .map(
        (
          col,
        ) => `${col.name} ${col.type}${col.notnull == 1 ? " not null" : ""}${col.dflt_value != null ? " default" : ""}${col.hidden == 3 ? " stored" : col.hidden == 2 ? " virtual" : ""}`,
      )
      .join(", ");
    const rowid = t.rowidColumn >= 0 ? t.columns[t.rowidColumn as usize].name : "none";
    const cRow = t.withoutRowid || t.name == "odd" ? "none" : cRowid(c, t.name, cols);
    lines.push(
      `${t.name}${t.withoutRowid ? " without rowid" : ""}: ${mine}; affinities ${affs}; rowid ${rowid}`,
    );
    if (rowid != cRow || mine != theirs) {
      differ++;
      lines.push(`  C: ${theirs}; rowid ${cRow}`);
    }
    const rows: IndexRow[] = c
      .prepare(
        `SELECT name, "unique", origin, partial FROM pragma_index_list('${t.name}') ORDER BY name`,
      )
      .all();
    for (const r of rows) {
      let found: Index | null = null;
      for (const ix of t.indexes) {
        if (ix.name == r.name) {
          found = ix;
        }
      }
      if (found == null) {
        // A WITHOUT ROWID table's primary key index is the table: no row in sqlite_schema.
        const note = t.withoutRowid && r.origin == "pk" ? "the table itself" : "MISSING";
        lines.push(`  ${r.name} (${r.origin}): ${note}`);
        if (note == "MISSING") {
          differ++;
        }
        continue;
      }
      const got = describeIndex(found!, t);
      const want = describeC(c, r, cols);
      lines.push(`  ${got}${found!.seekable ? "" : " (not seekable)"}`);
      if (got != want && t.name != "odd") {
        differ++;
        lines.push(`  C: ${want}`);
      }
    }
    if (t.indexes.length > rows.length) {
      differ++;
      lines.push(`  ${t.indexes.length} indexes, C has ${rows.length}`);
    }
  }
  assertEq(lines, [
    "t1: a , b , c ; affinities 000; rowid none",
    "  sqlite_autoindex_t1_1 unique: c BINARY",
    "  sqlite_autoindex_t1_2 unique: a BINARY, b BINARY",
    "t2: a , b ; affinities 00; rowid none",
    "  sqlite_autoindex_t2_1 unique: a BINARY",
    "t3 without rowid: a  not null, b ; affinities 00; rowid none",
    "  sqlite_autoindex_t3_1 (pk): the table itself",
    "  sqlite_autoindex_t3_2 unique: b BINARY",
    "t4: a INTEGER, b ; affinities 30; rowid a",
    "  sqlite_autoindex_t4_1 unique: a BINARY",
    "  sqlite_autoindex_t4_2 unique: b BINARY",
    "t5: a , b ; affinities 00; rowid none",
    "  sqlite_autoindex_t5_1 unique: a BINARY",
    "  sqlite_autoindex_t5_2 unique: b BINARY, a BINARY",
    "  sqlite_autoindex_t5_3 unique: a NOCASE",
    "t6: a INTEGER, b ; affinities 30; rowid none",
    "  sqlite_autoindex_t6_1 unique: a desc BINARY",
    "  sqlite_autoindex_t6_2 unique: b BINARY",
    "t7: a INTEGER, b ; affinities 30; rowid a",
    "  sqlite_autoindex_t7_1 unique: b BINARY",
    "t8: id INTEGER, name TEXT, r TEXT, n INT not null default, f FLOATING POINT, d DECIMAL(10, 2), blob , v VARCHAR(9); affinities 31133201; rowid id",
    "  sqlite_autoindex_t8_1 unique: name NOCASE",
    "  t8_r: r RTRIM, n desc BINARY",
    "  t8_x partial: name BINARY, expr BINARY, id BINARY",
    "t9 without rowid: a TEXT not null, b INTEGER not null, c ; affinities 130; rowid none",
    "  sqlite_autoindex_t9_1 (pk): the table itself",
    "  sqlite_autoindex_t9_2 unique: c BINARY",
    "  t9_a: a desc BINARY",
    "t10: a INT, b TEXT; affinities 31; rowid none",
    "  sqlite_autoindex_t10_1 unique: a BINARY",
    "  sqlite_autoindex_t10_2 unique: b RTRIM",
    "kw: end INTEGER, offset TEXT not null default, left , right big, by  default, with , match x] ; affinities 3102002; rowid end",
    "  kw_left: left desc BINARY, offset BINARY",
    "  sqlite_autoindex_kw_1 unique: left BINARY",
    "  sqlite_autoindex_kw_2 unique: by BINARY, with BINARY",
    "r1: id INTEGER; affinities 3; rowid id",
    "p1: a INTEGER, b ; affinities 30; rowid a",
    "p2: a , b ; affinities 00; rowid none",
    "p3: a , b ; affinities 00; rowid none",
    "  sqlite_autoindex_p3_1 unique: a BINARY",
    "  sqlite_autoindex_p3_2 unique: b BINARY",
    "p4: a INTEGER, b TEXT; affinities 31; rowid none",
    "p5b: end INT, left TEXT, offset REAL; affinities 314; rowid none",
    "vt (virtual table): unsupported: vt: CREATE VIRTUAL is not supported yet",
    "vt_data: id INTEGER, block BLOB; affinities 30; rowid id",
    "vt_idx without rowid: segid  not null, term  not null, pgno ; affinities 000; rowid none",
    "  sqlite_autoindex_vt_idx_1 (pk): the table itself",
    "vt_content: id INTEGER, c0 ; affinities 30; rowid id",
    "vt_docsize: id INTEGER, sz BLOB; affinities 30; rowid id",
    "vt_config without rowid: k  not null, v ; affinities 00; rowid none",
    "  sqlite_autoindex_vt_config_1 (pk): the table itself",
    "p6: a INT, b  virtual, c INT stored, d TEXT; affinities 3031; rowid none",
    "w6 without rowid: x TEXT, v  virtual, k TEXT not null, s  stored; affinities 1010; rowid none",
    "  sqlite_autoindex_w6_1 (pk): the table itself",
    "s1: a ANY, b INT; affinities 03; rowid none",
    "s2: a ANY, b INT; affinities 23; rowid none",
    "odd: a TEXT, b ; affinities 10; rowid none",
    "  odd_a: a BINARY (not seekable)",
  ]);
  // 0 differ from C SQLite.
  assertEq(differ, 0);
  c.close();
  removeSync(path);
}

// Each row of p6 and w6 read field by field (the engine's record), against C SQLite's columns.
export function test_generated_columns_in_the_record() {
  const path = makeDb();
  const c = open(path);
  const schema = loadSchema(new DbFile(readFileBytesSync(path)));
  const lines: string[] = [];
  const file = new DbFile(readFileBytesSync(path));
  for (const name of ["p6", "w6"]) {
    const t = schema.table(name)!;
    const want: Text[] = c
      .prepare(
        "SELECT " +
          t.columns.map((col) => "CAST(" + col.name + " AS TEXT)").join(" || '|' || ") +
          ` AS v FROM ${name}`,
      )
      .all();
    const rows: string[] = [];
    const cur = new Cursor(file, t.root);
    let more = cur.first();
    while (more) {
      rows.push(
        t.columns
          .map((col) => (col.field < 0 ? "(computed)" : cur.text(col.field as usize)))
          .join("|"),
      );
      more = cur.next();
    }
    const fieldsOf = t.columns.map((col) => `${col.name}:${col.field}`).join(" ");
    for (let i: usize = 0; i < rows.length; i++) {
      lines.push(`${name} [${fieldsOf}] row ${i}: ${rows[i]} (C: ${want[i].v})`);
    }
  }
  assertEq(lines, [
    "p6 [a:0 b:-1 c:1 d:2] row 0: 5|(computed)|6|five (C: 5|10|6|five)",
    "p6 [a:0 b:-1 c:1 d:2] row 1: -1|(computed)|0|minus one (C: -1|-2|0|minus one)",
    "w6 [x:1 v:-1 k:0 s:2] row 0: x2|(computed)|k2|k2x2 (C: x2|2|k2|k2x2)",
    "w6 [x:1 v:-1 k:0 s:2] row 1: x1|(computed)|key one|key onex1 (C: x1|7|key one|key onex1)",
  ]);
  c.close();
  removeSync(path);
}

// STRICT: the affinity of ANY, and what C SQLite stored for '1' under it.
export function test_strict_any_affinity() {
  const path = makeDb();
  const c = open(path);
  const schema = loadSchema(new DbFile(readFileBytesSync(path)));
  const lines: string[] = [];
  for (const name of ["s1", "s2"]) {
    const t = schema.table(name)!;
    const k: Kind[] = c.prepare(`SELECT typeof(a) AS k FROM ${name}`).all();
    lines.push(
      `${name}${t.strict ? " strict" : ""}: a ANY affinity ${t.columns[0].affinity}, C stores '1' as ${k[0].k}`,
    );
  }
  assertEq(lines, [
    "s1 strict: a ANY affinity 0, C stores '1' as text",
    "s2: a ANY affinity 2, C stores '1' as integer",
  ]);
  c.close();
  removeSync(path);
}

// Every sqlite_schema row is kept.
export function test_every_schema_row_is_kept() {
  const path = makeDb();
  const schema = loadSchema(new DbFile(readFileBytesSync(path)));
  assertEq(
    `${schema.rows.length} sqlite_schema rows: ${schema.rows.map((r) => r.type[0]).join("")}`,
    "54 sqlite_schema rows: tiitititiitiiitiititiiitiitiitiiittttiittttttttvttttti",
  );
  removeSync(path);
}
