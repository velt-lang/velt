export function test_expressions_and_selects() {
  assertEq(parsed("SELECT 1 + 2 * 3 - 4 / 5 % 6"), "{SELECT (- (+ 1 (* 2 3)) (% (/ 4 5) 6))}");
  assertEq(
    parsed(
      "SELECT a || b || c, -x, - -1, ~5, +y, -9223372036854775808, 9223372036854775808, 0x7fffffffffffffff, 0xffffffffffffffff, 1e3, .5, 1.5e-3, 99999999999999999999",
    ),
    "{SELECT (|| (|| a b) c), (- x), 1, (~ 5), (+ y), -9223372036854775808, int!9223372036854775808, 9223372036854775807, -1, 1000r, 0.5r, 0.0015r, 100000000000000000000r}",
  );
  assertEq(
    parsed("SELECT * FROM t WHERE a = 1 AND b != 2 OR NOT c <> 3 AND d == 4"),
    "{SELECT * FROM j0:t WHERE (OR (AND (= a 1) (!= b 2)) (AND (NOT (!= c 3)) (= d 4)))}",
  );
  assertEq(
    parsed(
      "SELECT a FROM t WHERE x IS NULL AND y IS NOT NULL AND z ISNULL AND w NOTNULL AND v NOT NULL AND u IS NOT DISTINCT FROM 1",
    ),
    "{SELECT a FROM j0:t WHERE (AND (AND (AND (AND (AND (IS x NULL) (IS NOT y NULL)) (ISNULL z)) (NOTNULL w)) (NOTNULL v)) (IS u 1))}",
  );
  assertEq(
    parsed(
      "SELECT a BETWEEN 1 AND 2 AND b NOT BETWEEN c AND d, e IN (1, 2, 3), f NOT IN (SELECT g FROM h), i IN t2, j IN ()",
    ),
    "{SELECT (AND (BETWEEN a 1 2) (NOT BETWEEN b c d)), (IN e [1 2 3]), (NOT IN f {SELECT g FROM j0:h}), (IN i {SELECT * FROM j0:t2}), (IN j [])}",
  );
  assertEq(
    parsed(
      "SELECT name LIKE 'a%' ESCAPE '\\', name NOT GLOB '*x*', CASE WHEN a THEN 1 WHEN b THEN 2 ELSE 3 END, CASE x WHEN 1 THEN 'one' END",
    ),
    "{SELECT (LIKE name 'a%' '\\'), (NOT GLOB name '*x*' _), (CASE _ [a 1 b 2] ELSE 3), (CASE x [1 'one'] ELSE _)}",
  );
  assertEq(
    parsed(
      "SELECT CAST(x AS INTEGER), CAST(y AS VARCHAR(10)), CAST(z AS DOUBLE PRECISION), count(*), count(DISTINCT a), sum(b) FILTER (WHERE b > 0), max(a, b, c)",
    ),
    "{SELECT (CAST x AS INTEGER), (CAST y AS VARCHAR(10)), (CAST z AS DOUBLE PRECISION), COUNT(*), COUNT(DISTINCT a), SUM(b) FILTER (> b 0), MAX(a b c)}",
  );
  assertEq(
    parsed(
      "SELECT p.id, p.body, u.username AS author, (SELECT count(*) FROM likes l WHERE l.post_id = p.id) AS like_count FROM posts p JOIN users u ON u.id = p.user_id ORDER BY p.created_at DESC, p.id DESC LIMIT 20",
    ),
    "{SELECT p.id, p.body, u.username AS author, {SELECT COUNT(*) FROM j0:likes l WHERE (= l.post_id p.id)} AS like_count FROM j0:posts p, j0:users u ON (= u.id p.user_id) ORDER p.created_at DESC, p.id DESC LIMIT 20}",
  );
  assertEq(
    parsed(
      "SELECT a, b c, d 'e', \"f g\", [h i], `j` FROM t1 AS x LEFT OUTER JOIN t2 y USING (k, l) NATURAL JOIN t3 CROSS JOIN t4, t5 INDEXED BY i5 WHERE EXISTS (SELECT 1) AND NOT EXISTS (SELECT 2)",
    ),
    "{SELECT a, b AS c, d AS e, f g, h i, j FROM j0:t1 x, j1:t2 y USING k,l, j0n:t3, j4:t4, j0:t5 INDEXED i5 WHERE (AND (EXISTS {SELECT 1}) (NOT (EXISTS {SELECT 2})))}",
  );
  assertEq(
    parsed(
      "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 10) SELECT i FROM n",
    ),
    "{WITH RECURSIVE n(i) AS {SELECT 1 op2 SELECT (+ i 1) FROM j0:n WHERE (< i 10)} SELECT i FROM j0:n}",
  );
  assertEq(
    parsed(
      "SELECT a FROM t UNION SELECT b FROM u INTERSECT SELECT c FROM v EXCEPT SELECT d FROM w ORDER BY 1 NULLS LAST LIMIT 5, 10",
    ),
    "{SELECT a FROM j0:t op1 SELECT b FROM j0:u op3 SELECT c FROM j0:v op4 SELECT d FROM j0:w ORDER 1 N2 LIMIT 10 OFFSET 5}",
  );
  assertEq(parsed("VALUES (1, 'a'), (2, 'b')"), "{VALUES [1 'a'] [2 'b']}");
  assertEq(
    parsed("SELECT ?, ?, ?5, ?, :name, @name, $x, :name, ?2"),
    "{SELECT ?#1, ?#2, ?5#5, ?#6, :name#7, @name#8, $x#9, :name#7, ?2#2}",
  );
  assertEq(
    parsed(
      "SELECT a COLLATE NOCASE = b, (1, 2) = (3, 4), x -> '$.a', x ->> '$.b', a & b | c << 2 >> 1, a < b = c > d",
    ),
    "{SELECT (= (COLLATE a NOCASE) b), (= (ROW 1 2) (ROW 3 4)), (-> x '$.a'), (->> x '$.b'), (>> (<< (| (& a b) c) 2) 1), (= (< a b) (> c d))}",
  );
  assertEq(
    parsed("SELECT DISTINCT a FROM t GROUP BY a, b HAVING count(*) > 1 LIMIT 10 OFFSET 5"),
    "{SELECT DISTINCT a FROM j0:t GROUP a b HAVING (> COUNT(*) 1) LIMIT 10 OFFSET 5}",
  );
  assertEq(
    parsed("SELECT * FROM (SELECT 1 AS x) s, json_each('[1]') j, generate_series(1, 9)"),
    "{SELECT * FROM j0:{SELECT 1 AS x} s, j0:json_each('[1]') j, j0:generate_series(1 9)}",
  );
  assertEq(
    parsed(
      "SELECT 'it''s', \"say \"\"hi\"\"\", x'00FF', TRUE, FALSE, true(), CURRENT_TIMESTAMP -- comment\n /* block */",
    ),
    "{SELECT 'it's', say \"hi\", x'00FF', TRUE, FALSE, TRUE(), CURRENT_TIMESTAMP()}",
  );
}

export function test_syntax_errors() {
  assertEq(parsed("SELECT 1 +"), "error at 10: incomplete input");
  assertEq(parsed("SELECT a FROM WHERE"), "error at 14: near \"WHERE\": syntax error");
  assertEq(parsed("SELECT 'abc"), "error at 7: unrecognized token: \"'abc\"");
  assertEq(parsed("SELECT 12abc"), "error at 7: unrecognized token: \"12abc\"");
  assertEq(parsed("SELECT x'0'"), "error at 7: unrecognized token: \"x'0'\"");
  assertEq(parsed("SELECT a FROM t ORDER BY"), "error at 24: incomplete input");
  assertEq(parsed("SELECT ?0"), "error at 7: variable number must be between ?1 and ?32766");
  assertEq(parsed("SELECT f(x) OVER ()"), "{SELECT F(x)}");
}

export function test_operators_and_numeric_literals() {
  assertEq(
    parsed("SELECT 1 = NOT 0, 1 = NOT 0 AND 0, 0 = NOT 0 = 0, 1 + NOT 0, NOT EXISTS (SELECT 1)"),
    "{SELECT (= 1 (NOT 0)), (AND (= 1 (NOT 0)) 0), (= 0 (NOT (= 0 0))), (+ 1 (NOT 0)), (NOT (EXISTS {SELECT 1}))}",
  );
  assertEq(
    parsed("SELECT like(1, 2), glob('a', 'a'), match(1, 2), regexp(1, 2), a LIKE b"),
    "{SELECT LIKE(1 2), GLOB('a' 'a'), MATCH(1 2), REGEXP(1 2), (LIKE a b _)}",
  );
  assertEq(
    parsed("SELECT 0x00000000000000001, 0x000000000000000000000000000ff, 0x00000000000000000"),
    "{SELECT 1, 255, 0}",
  );
  assertEq(
    parsed("SELECT - -9223372036854775808, -(-9223372036854775808), - - 5"),
    "{SELECT (- -9223372036854775808), (- -9223372036854775808), 5}",
  );
  assertEq(
    parsed("SELECT 123456789012345678, 999999999999999999, -123456789012345678"),
    "{SELECT 123456789012345678, 999999999999999999, -123456789012345678}",
  );
  assertEq(parsed("ſelect 1"), "error at 0: near \"ſelect\": syntax error");
  assertEq(
    parsed("SELECT 2 BETWEEN 1 = 1 AND 3, 5 BETWEEN 1 AND 3 = 0"),
    "{SELECT (BETWEEN 2 (= 1 1) 3), (= (BETWEEN 5 1 3) 0)}",
  );
  assertEq(
    parsed("SELECT 1_000, 1_000.5, 0x1_0, 1e1_0, 1.5_0, 0xf_f"),
    "{SELECT 1000, 1000.5r, 16, 10000000000r, 1.5r, 255}",
  );
  assertEq(parsed("SELECT 1__0"), "error at 7: unrecognized token: \"1__0\"");
  assertEq(parsed("SELECT 1_"), "error at 7: unrecognized token: \"1_\"");
  assertEq(parsed("SELECT 1._5"), "error at 7: unrecognized token: \"1._5\"");
  assertEq(
    parsed("SELECT a COLLATE x COLLATE y = b COLLATE z"),
    "{SELECT (= (COLLATE a Y) (COLLATE b Z))}",
  );
}

export function test_an_unclosed_comment_at_the_end() {
  // `/*` at the very end is `/` then `*` (tokenize.c); any longer unclosed comment runs to the end.
  assertEq(parsed("SELECT 1/*"), "error at 9: near \"*\": syntax error");
  assertEq(parsed("SELECT 1/**"), "{SELECT 1}");
}

export function test_in_a_table_or_table_valued_function() {
  // IN [schema.]table and IN a table-valued function.
  assertEq(
    parsed(
      "SELECT 1 IN main.t, 2 NOT IN json_each('[1]'), 3 IN main.json_each('[1]', 2), 4 IN t(), 5 IN 't', 6 IN left",
    ),
    "{SELECT (IN 1 {SELECT * FROM j0:main.t}), (NOT IN 2 {SELECT * FROM j0:json_each('[1]')}), (IN 3 {SELECT * FROM j0:main.json_each('[1]' 2)}), (IN 4 {SELECT * FROM j0:t}), (IN 5 {SELECT * FROM j0:t}), (IN 6 {SELECT * FROM j0:left})}",
  );
}

export function test_type_names() {
  // Type names: words or strings, then (n) or (n, m) of signed numbers only.
  assertEq(
    parsed(
      "SELECT CAST(x AS 'int'), CAST(x AS INT 'x' y), CAST(x AS INT(+1)), CAST(x AS NUMERIC(-1, 2.5)), CAST(x AS generated), CAST(x AS \"int\")",
    ),
    "{SELECT (CAST x AS int), (CAST x AS INT 'x' y), (CAST x AS INT(+1)), (CAST x AS NUMERIC(-1, 2.5)), (CAST x AS generated), (CAST x AS int)}",
  );
  assertEq(parsed("SELECT CAST(x AS INT(foo))"), "error at 21: near \"foo\": syntax error");
  assertEq(parsed("SELECT CAST(x AS INT(1_0))"), "error at 21: near \"1_0\": syntax error");
  assertEq(parsed("SELECT CAST(x AS INT(1, 2, 3))"), "error at 25: near \",\": syntax error");
  assertEq(parsed("SELECT CAST(x AS INT((1)))"), "error at 21: near \"(\": syntax error");
  assertEq(parsed("SELECT CAST(x AS left)"), "error at 17: near \"left\": syntax error");
}

export function test_table_star_stands_alone() {
  // `t.*` is a result column on its own: no alias, no operand, no argument.
  assertEq(
    parsed("SELECT t.*, 't'.*, left.*, 't'.a FROM t AS left"),
    "{SELECT t.*, t.*, left.*, t.a FROM j0:t left}",
  );
  assertEq(parsed("SELECT t.* AS x FROM t"), "error at 11: near \"AS\": syntax error");
  assertEq(parsed("SELECT t.* + 1 FROM t"), "error at 11: near \"+\": syntax error");
  assertEq(parsed("SELECT count(t.*) FROM t"), "error at 15: near \"*\": syntax error");
}

export function test_join_types_and_constraints() {
  // A string alias; ON and USING after a comma join; join words in any order (sqlite3JoinType).
  assertEq(
    parsed(
      "SELECT * FROM t 'x', u, v ON 1, w USING (a) LEFT NATURAL JOIN y OUTER LEFT JOIN z INNER CROSS JOIN q LEFT RIGHT JOIN r NATURAL FULL OUTER JOIN s",
    ),
    "{SELECT * FROM j0:t x, j0:u, j0:v ON 1, j0:w USING a, j1n:y, j1:z, j4:q, j3:r, j3n:s}",
  );
  assertEq(
    parsed("SELECT * FROM t LEFT INNER JOIN u"),
    "error at 16: unknown join type: LEFT INNER",
  );
  assertEq(parsed("SELECT * FROM t OUTER JOIN u"), "error at 16: unknown join type: OUTER");
  assertEq(parsed("SELECT * FROM t LEFT foo JOIN u"), "error at 16: unknown join type: LEFT foo");
  assertEq(
    parsed("SELECT * FROM t left \"outer\" JOIN u"),
    "error at 16: unknown join type: left \"outer\"",
  );
  assertEq(
    parsed("SELECT * FROM t LEFT OUTER NATURAL INNER JOIN u"),
    "error at 35: near \"INNER\": syntax error",
  );
  assertEq(parsed("SELECT * FROM t ON 1"), "error at 16: a JOIN clause is required before ON");
  assertEq(
    parsed("SELECT * FROM t USING (a)"),
    "error at 16: a JOIN clause is required before USING",
  );
  assertEq(
    parsed("SELECT * FROM t ON 1 WHERE 1"),
    "error at 16: a JOIN clause is required before ON",
  );
  assertEq(parsed("SELECT * FROM t ON a DO"), "error at 21: near \"DO\": syntax error");
}

export function test_collation_names() {
  // A collation is a name or a string, not a join word.
  assertEq(
    parsed("SELECT 1 COLLATE 'x', 1 COLLATE end"),
    "{SELECT (COLLATE 1 X), (COLLATE 1 END)}",
  );
  assertEq(parsed("SELECT 1 COLLATE left"), "error at 17: near \"left\": syntax error");
  assertEq(
    parsed("SELECT * FROM t NOT INDEXED, json_each('[1]') NOT INDEXED"),
    "error at 46: near \"NOT\": syntax error",
  );
}

export function test_values_rows() {
  // VALUES rows have one length; ORDER BY and LIMIT follow a SELECT core, not VALUES.
  assertEq(
    parsed("VALUES (1, 2), (3)"),
    "error at 15: all VALUES must have the same number of terms",
  );
  assertEq(
    parsed("SELECT 1 UNION VALUES (1), (2, 3)"),
    "error at 27: all VALUES must have the same number of terms",
  );
  assertEq(parsed("VALUES (1) ORDER BY 1"), "error at 11: near \"ORDER\": syntax error");
  assertEq(
    parsed("SELECT 1 UNION VALUES (1) LIMIT 1"),
    "error at 26: near \"LIMIT\": syntax error",
  );
  assertEq(parsed("VALUES (1) UNION SELECT 1 ORDER BY 1"), "{VALUES [1] op1 SELECT 1 ORDER 1}");
}

export function test_escape_binds_like_a_comparison() {
  // ESCAPE's operand binds like `<` (parse.y's %right ESCAPE above the comparisons): the
  // escape is `c < d`, and `=` ends it.
  assertEq(
    parsed("SELECT a LIKE b ESCAPE c < d, a LIKE b ESCAPE c = d, a NOT GLOB b ESCAPE c & d"),
    "{SELECT (LIKE a b (< c d)), (= (LIKE a b c) d), (NOT GLOB a b (& c d))}",
  );
}

export function test_not_and_raise() {
  // NOT after an operand must start NOT IN / LIKE / BETWEEN / NULL; RAISE only in a trigger.
  assertEq(parsed("SELECT 1 NOT x"), "error at 13: near \"x\": syntax error");
  assertEq(parsed("SELECT 1 NOT"), "error at 12: incomplete input");
  assertEq(
    parsed("SELECT raise(ABORT, 'x')"),
    "error at 7: RAISE() may only be used within a trigger-program",
  );
  assertEq(parsed("SELECT raise(1)"), "error at 13: near \"1\": syntax error");
}

export function test_keywords_as_names_in_context() {
  // Keywords that are names here (SQLite's %fallback ID, join words, FILTER/OVER/WINDOW by
  // context): columns, tables, aliases, calls.
  assertEq(
    parsed(
      "SELECT end, offset, left, by, with, glob(1, 2), like, indexed, x FROM cast, raise, left AS right, t end",
    ),
    "{SELECT end, offset, left, by, with, GLOB(1 2), like, indexed, x FROM j0:cast, j0:raise, j0:left right, j0:t end}",
  );
  assertEq(
    parsed("SELECT count(*) filter, count(*) over, 1 window, count(*) FILTER (WHERE 1) FROM t"),
    "{SELECT COUNT(*) AS filter, COUNT(*) AS over, 1 AS window, COUNT(*) FILTER 1 FROM j0:t}",
  );
  assertEq(parsed("SELECT 1 LIMIT offset OFFSET 1"), "{SELECT 1 LIMIT offset OFFSET 1}");
  assertEq(parsed("SELECT \"count\"(*), [abs](1)"), "{SELECT COUNT(*), ABS(1)}");
}

// The text of each result column and window is cut out of the SQL with the parser's running
// index, so a SELECT of many walks the text about once: cutting each from the start made
// `prepare` quadratic (2,000 columns took ten times as long as now).
export function test_result_column_text_is_linear() {
  const cols: string[] = [];
  const wins: string[] = [];
  for (let i: i64 = 0; i < 1000; i++) {
    cols.push(`x + ${i} AS c${i}`);
    wins.push(`w${i} AS (ORDER BY x + ${i})`);
  }
  const p = assertWalksOnce(`SELECT ${cols.join(", ")} FROM t`);
  assertEq(p.cores[0].columns.length, 1000);
  assertEq(p.cores[0].columns[999].span, "x + 999");
  const w = assertWalksOnce(`SELECT 1 FROM t WINDOW ${wins.join(", ")}`);
  assertEq(w.cores[0].windows.length, 1000);
  assertEq(w.cores[0].windows[999].text, "ORDER BY x + 999");
}

/**
 * Parses `sql`, a SELECT: the parser's own index walked the text (cutting each piece from the
 * start goes around it) and walked it about once.
 */
function assertWalksOnce(sql: string): Select {
  const p = new Parser(sql);
  const s = p.select();
  const bytes = utf8Length(sql) as usize;
  assert(p.index.walked >= bytes / 2, `walked ${p.index.walked} bytes of ${bytes}`);
  assert(p.index.walked <= 2 * bytes, `walked ${p.index.walked} bytes of ${bytes}`);
  return s;
}
