    "on ------------",
    "or ------------",
    "order ------------",
    "others ++++++++++++",
    "outer ++++-+-++++-",
    "over ++++++++++++",
    "partition ++++++++++++",
    "plan ++++++++++++",
    "pragma ++++++++++++",
    "preceding ++++++++++++",
    "primary ------------",
    "query ++++++++++++",
    "raise -++++++--+-+",
    "range ++++++++++++",
