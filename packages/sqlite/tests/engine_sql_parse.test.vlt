// The SQL parser of the Velt SQLite engine (src/engine/sql, #1720), a test of the package:
// expressions with SQLite's precedence, SELECT with joins, CTEs, compound cores, parameters, and
// SQLite's error messages.
import { Parser } from "../src/engine/sql/parser";
import { utf8Length } from "velt/encoding";
import {
  Expr,
  FromItem,
  OrderTerm,
  Select,
  E_NULL,
  E_INT,
  E_REAL,
  E_STRING,
  E_BLOB,
  E_PARAM,
  E_COLUMN,
  E_UNARY,
  E_BINARY,
  E_CALL,
  E_CASE,
  E_CAST,
  E_IN_LIST,
  E_IN_SELECT,
  E_BETWEEN,
  E_LIKE,
  E_IS,
  E_ISNULL,
  E_EXISTS,
  E_SUBQUERY,
  E_COLLATE,
  E_STAR,
  E_ROW,
  E_TRUE,
  E_FALSE,
} from "../src/engine/sql/types";
import { SqlError } from "../src/engine/sql/errors";

function list(xs: Expr[]): string {
  return xs.map((x) => show(x)).join(" ");
}

function show(e: Expr | null): string {
  if (e == null) {
    return "_";
  }
  const k = e.kind;
  if (k == E_NULL) {
    return "NULL";
  }
  if (k == E_TRUE) {
    return "TRUE";
  }
  if (k == E_FALSE) {
    return "FALSE";
  }
  if (k == E_INT) {
    return e.text != "" ? `int!${e.text}` : `${e.ival}`;
  }
  if (k == E_REAL) {
    return `${e.rval}r`;
  }
  if (k == E_STRING) {
    return `'${e.text}'`;
  }
  if (k == E_BLOB) {
    return `x'${e.text}'`;
  }
  if (k == E_PARAM) {
    return `${e.text}#${e.ival}`;
  }
  if (k == E_COLUMN) {
    return e.table != "" ? `${e.table}.${e.name}` : e.name;
  }
  if (k == E_STAR) {
    return e.table != "" ? `${e.table}.*` : "*";
  }
  if (k == E_UNARY) {
    return `(${e.op} ${show(e.a)})`;
  }
  if (k == E_BINARY) {
    return `(${e.op} ${show(e.a)} ${show(e.b)})`;
  }
  if (k == E_CALL) {
    return `${e.name}(${e.distinct ? "DISTINCT " : ""}${e.star ? "*" : list(e.args)})${e.filter != null ? " FILTER " + show(e.filter) : ""}`;
  }
  if (k == E_CASE) {
    return `(CASE ${show(e.a)} [${list(e.args)}] ELSE ${show(e.b)})`;
  }
  if (k == E_CAST) {
    return `(CAST ${show(e.a)} AS ${e.name})`;
  }
  if (k == E_IN_LIST) {
    return `(${e.not ? "NOT " : ""}IN ${show(e.a)} [${list(e.args)}])`;
  }
  if (k == E_IN_SELECT) {
    return `(${e.not ? "NOT " : ""}IN ${show(e.a)} ${sel(e.select!)})`;
  }
  if (k == E_BETWEEN) {
    return `(${e.not ? "NOT " : ""}BETWEEN ${show(e.a)} ${show(e.b)} ${show(e.c)})`;
  }
  if (k == E_LIKE) {
    return `(${e.not ? "NOT " : ""}${e.op} ${show(e.a)} ${show(e.b)} ${show(e.c)})`;
  }
  if (k == E_IS) {
    return `(IS${e.not ? " NOT" : ""} ${show(e.a)} ${show(e.b)})`;
  }
  if (k == E_ISNULL) {
    return `(${e.not ? "NOTNULL" : "ISNULL"} ${show(e.a)})`;
  }
  if (k == E_EXISTS) {
    return `(${e.not ? "NOT " : ""}EXISTS ${sel(e.select!)})`;
  }
  if (k == E_SUBQUERY) {
    return sel(e.select!);
  }
  if (k == E_COLLATE) {
    return `(COLLATE ${show(e.a)} ${e.name})`;
  }
  if (k == E_ROW) {
    return `(ROW ${list(e.args)})`;
  }
  return "?";
}

function order(o: OrderTerm): string {
  return show(o.expr) + (o.desc ? " DESC" : "") + (o.nulls != 0 ? " N" + String(o.nulls) : "");
}

function fromItem(f: FromItem): string {
  let out = "j" + String(f.join) + (f.natural ? "n" : "") + ":";
  out += f.subquery != null ? sel(f.subquery!) : (f.schema != "" ? f.schema + "." : "") + f.name;
  if (f.args.length > 0) {
    out += "(" + list(f.args) + ")";
  }
  if (f.alias != "") {
    out += " " + f.alias;
  }
  if (f.on != null) {
    out += " ON " + show(f.on);
  }
  if (f.using.length > 0) {
    out += " USING " + f.using.join(",");
  }
  if (f.indexedBy != "") {
    out += " INDEXED " + f.indexedBy;
  }
  if (f.notIndexed) {
    out += " NOT INDEXED";
  }
  return out;
}

function sel(s: Select): string {
  let out = "{";
  if (s.with.length > 0) {
    out += `WITH${s.recursive ? " RECURSIVE" : ""} ${s.with.map((c) => c.name + "(" + c.columns.join(",") + ") AS " + sel(c.select)).join(", ")} `;
  }
  for (const c of s.cores) {
    if (c.op != 0) {
      out += ` op${c.op} `;
    }
    if (c.values.length > 0) {
      out += `VALUES ${c.values.map((r) => "[" + list(r) + "]").join(" ")}`;
      continue;
    }
    out += `SELECT${c.distinct ? " DISTINCT" : ""} ${c.columns.map((r) => show(r.expr) + (r.alias != "" ? " AS " + r.alias : "")).join(", ")}`;
    if (c.from.length > 0) {
      out += " FROM " + c.from.map((f) => fromItem(f)).join(", ");
    }
    if (c.where != null) {
      out += ` WHERE ${show(c.where)}`;
    }
    if (c.groupBy.length > 0) {
      out += ` GROUP ${list(c.groupBy)}`;
    }
    if (c.having != null) {
      out += ` HAVING ${show(c.having)}`;
    }
  }
  if (s.orderBy.length > 0) {
    out += ` ORDER ${s.orderBy.map((o) => order(o)).join(", ")}`;
  }
  if (s.limit != null) {
    out += ` LIMIT ${show(s.limit)}`;
  }
  if (s.offset != null) {
    out += ` OFFSET ${show(s.offset)}`;
  }
  return out + "}";
}

/** `sql` parsed as one SELECT and shown as a tree, or SQLite's error for it. */
function parsed(sql: string): string {
  try {
    const p = new Parser(sql);
    const s = p.select();
    if (p.peek().kind != 0) {
      p.fail();
    }
    return sel(s);
  } catch (e) {
    if (e instanceof SqlError) {
      return `error at ${e.at}: ${e.message}`;
    }
    throw e;
  }
}

/** A deep input's outcome: its height and cores, or the error; the input shortened. */
function depth(sql: string): string {
  const head = sql.length > 24 ? sql.slice(0, 24) + "…" : sql;
  try {
    const s = new Parser(sql).select();
    return `${head} (${sql.length} bytes): height ${s.height}, ${s.cores.length} cores`;
  } catch (e) {
    if (e instanceof SqlError) {
      return `${head} (${sql.length} bytes): error at ${e.at}: ${e.message}`;
    }
    throw e;
  }
}

/** Every SQLite keyword (and some words that are not keywords), lower case. */
const KEYWORDS: string[] = (
  "abort action add after all alter always analyze and as asc attach autoincrement before " +
  "begin between by cascade case cast check collate column commit conflict constraint create " +
  "cross current current_date current_time current_timestamp database default deferrable " +
  "deferred delete desc detach distinct do drop each else end escape except exclude exclusive " +
  "exists explain fail filter first following for foreign from full generated glob group " +
  "groups having if ignore immediate in index indexed initially inner insert instead " +
  "intersect into is isnull join key last left like limit match materialized natural no not " +
  "nothing notnull null nulls of offset on or order others outer over partition plan pragma " +
  "preceding primary query raise range recursive references regexp reindex release rename " +
  "replace restrict returning right rollback row rows savepoint select set table temp " +
  "temporary then ties to transaction trigger unbounded union unique update using vacuum " +
  "values view virtual when where window with without rowid strict true false"
).split(" ");

/**
 * Where each keyword is tried: a column, a qualified column, a table, a table alias with AS and
 * bare, a column alias with AS and bare, an operand, a call, a CTE, an ORDER BY term, a type.
 */
const FORMS: string[] = [
  "SELECT % FROM t",
  "SELECT t.% FROM t",
  "SELECT * FROM %",
  "SELECT * FROM t AS %",
  "SELECT * FROM t %",
  "SELECT 1 AS %",
  "SELECT 1 %",
  "SELECT 1 + %",
  "SELECT %(1)",
  "WITH % AS (SELECT 1) SELECT 1",
  "SELECT 1 FROM t ORDER BY %",
  "SELECT CAST(1 AS %)",
];

/** Whether `sql` parses as one SELECT. */
function accepts(sql: string): bool {
  try {
    const p = new Parser(sql);
    p.select();
    return p.peek().kind == 0;
  } catch (e) {
    if (e instanceof SqlError) {
      return false;
    }
    throw e;
  }
}

// Expression trees up to SQLite's height limit (1000), and past it: chains of binary
// operators, prefix operators, nesting; parentheses and COLLATE add no level. The parser's
// own recursion is bounded too ("Recursion limit"), so deep input is an error, never a stack
// overflow. Compound SELECTs and FROM lists have SQLite's limits. Trees this deep are not
// printed: only the height.
export function test_expression_height_and_select_limits() {
  const sqls: string[] = [
    "SELECT 1" + "+1".repeat(999),
    "SELECT 1" + "+1".repeat(1000),
    "SELECT 1" + "+1".repeat(5000),
    "SELECT 1" + " AND 1".repeat(999),
    "SELECT 1" + " OR 1".repeat(1000),
    "SELECT 'a'" + " || 'a'".repeat(1000),
    "SELECT 1" + " BETWEEN 1 AND 1".repeat(1000),
    "SELECT a" + " ISNULL".repeat(999) + " FROM t",
    "SELECT a" + " ISNULL".repeat(1000) + " FROM t",
    "SELECT 1" + " COLLATE x".repeat(5000),
    "SELECT " + "NOT ".repeat(999) + "1",
    "SELECT " + "NOT ".repeat(1000) + "1",
    "SELECT " + "- ".repeat(999) + "1",
    "SELECT " + "- ".repeat(1000) + "1",
    "SELECT " + "CAST(".repeat(999) + "1" + " AS INT)".repeat(999),
    "SELECT " + "1+(".repeat(999) + "1" + ")".repeat(999),
    "SELECT " + "(".repeat(1000) + "1" + ")".repeat(1000),
    "SELECT " + "(".repeat(5000) + "1" + ")".repeat(5000),
    "SELECT " + "f(".repeat(500) + "1" + ")".repeat(500),
    "SELECT " + "f(".repeat(3000) + "1" + ")".repeat(3000),
    "SELECT " + "(SELECT ".repeat(500) + "1" + ")".repeat(500),
    "SELECT " + "(SELECT ".repeat(3000) + "1" + ")".repeat(3000),
    "SELECT " + "(".repeat(5000),
    "SELECT 1" + " UNION SELECT 1".repeat(499),
    "SELECT 1" + " UNION SELECT 1".repeat(500),
    "SELECT 1 FROM t" + " JOIN t".repeat(63),
    "SELECT 1 FROM t" + " JOIN t".repeat(64),
    "SELECT 1 FROM t" + ", t".repeat(200),
  ];
  assertEq(sqls.map((s) => depth(s)), [
    "SELECT 1+1+1+1+1+1+1+1+1… (2006 bytes): height 1000, 1 cores",
    "SELECT 1+1+1+1+1+1+1+1+1… (2008 bytes): error at 2006: Expression tree is too large (maximum depth 1000)",
    "SELECT 1+1+1+1+1+1+1+1+1… (10008 bytes): error at 2006: Expression tree is too large (maximum depth 1000)",
    "SELECT 1 AND 1 AND 1 AND… (6002 bytes): height 1000, 1 cores",
    "SELECT 1 OR 1 OR 1 OR 1 … (5008 bytes): error at 5004: Expression tree is too large (maximum depth 1000)",
    "SELECT 'a' || 'a' || 'a'… (7010 bytes): error at 7004: Expression tree is too large (maximum depth 1000)",
    "SELECT 1 BETWEEN 1 AND 1… (16008 bytes): error at 15993: Expression tree is too large (maximum depth 1000)",
    "SELECT a ISNULL ISNULL I… (7008 bytes): height 1000, 1 cores",
    "SELECT a ISNULL ISNULL I… (7015 bytes): error at 7002: Expression tree is too large (maximum depth 1000)",
    "SELECT 1 COLLATE x COLLA… (50008 bytes): height 1, 1 cores",
    "SELECT NOT NOT NOT NOT N… (4004 bytes): height 1000, 1 cores",
    "SELECT NOT NOT NOT NOT N… (4008 bytes): error at 7: Expression tree is too large (maximum depth 1000)",
    "SELECT - - - - - - - - -… (2006 bytes): height 1000, 1 cores",
    "SELECT - - - - - - - - -… (2008 bytes): error at 2007: Expression tree is too large (maximum depth 1000)",
    "SELECT CAST(CAST(CAST(CA… (12995 bytes): error at 1257: Recursion limit",
    "SELECT 1+(1+(1+(1+(1+(1+… (4004 bytes): error at 756: Recursion limit",
    "SELECT (((((((((((((((((… (2008 bytes): error at 506: Recursion limit",
    "SELECT (((((((((((((((((… (10008 bytes): error at 506: Recursion limit",
    "SELECT f(f(f(f(f(f(f(f(f… (1508 bytes): error at 506: Recursion limit",
    "SELECT f(f(f(f(f(f(f(f(f… (9008 bytes): error at 506: Recursion limit",
    "SELECT (SELECT (SELECT (… (4508 bytes): error at 2000: Recursion limit",
    "SELECT (SELECT (SELECT (… (27008 bytes): error at 2000: Recursion limit",
    "SELECT (((((((((((((((((… (5007 bytes): error at 506: Recursion limit",
    "SELECT 1 UNION SELECT 1 … (7493 bytes): height 1, 500 cores",
    "SELECT 1 UNION SELECT 1 … (7508 bytes): error at 7500: too many terms in compound SELECT",
    "SELECT 1 FROM t JOIN t J… (456 bytes): height 1, 1 cores",
    "SELECT 1 FROM t JOIN t J… (463 bytes): error at 16: at most 64 tables in a join",
    "SELECT 1 FROM t, t, t, t… (615 bytes): error at 615: too many FROM clause terms, max: 200",
  ]);
}

export function test_every_nesting_production_is_bounded() {
  const sqls: string[] = [];
  // A chain of BETWEEN low bounds nests (`a BETWEEN b BETWEEN c AND d AND e` is valid): it is
  // bounded like any nesting, never a stack overflow.
  sqls.push("SELECT 1" + " BETWEEN 1".repeat(10000) + " AND 1".repeat(10000));
  sqls.push("SELECT 1" + " NOT BETWEEN 1".repeat(10000) + " AND 1".repeat(10000));
  // Every production that nests, 10,000 deep: bounded, never a stack overflow (a level of
  // each costs the stack it measures, src/engine/sql/token_cursor's MAX_DEPTH).
  sqls.push("WITH a AS (".repeat(10000) + "SELECT 1" + ") SELECT 1".repeat(10000));
  sqls.push("SELECT * FROM " + "(SELECT * FROM ".repeat(10000) + "t" + ")".repeat(10000));
  sqls.push("SELECT " + "CASE WHEN ".repeat(10000) + "1" + " THEN 1 END".repeat(10000));
  sqls.push("SELECT " + "EXISTS (SELECT ".repeat(10000) + "1" + ")".repeat(10000));
  sqls.push("SELECT " + "1 IN (".repeat(10000) + "1" + ")".repeat(10000));
  sqls.push("SELECT " + "1 IN f(".repeat(10000) + "1" + ")".repeat(10000));
  sqls.push("SELECT " + "f(1) FILTER (WHERE ".repeat(10000) + "1" + ")".repeat(10000));
  sqls.push("SELECT 1 LIMIT " + "(SELECT 1 LIMIT ".repeat(10000) + "1" + ")".repeat(10000));
  sqls.push("SELECT " + "(VALUES (".repeat(10000) + "1" + "))".repeat(10000));
  sqls.push("SELECT " + "CAST(".repeat(10000) + "1" + " AS INT)".repeat(10000));
  assertEq(sqls.map((s) => depth(s)), [
    "SELECT 1 BETWEEN 1 BETWE… (160008 bytes): error at 2499: Recursion limit",
    "SELECT 1 NOT BETWEEN 1 N… (200008 bytes): error at 3495: Recursion limit",
    "WITH a AS (WITH a AS (WI… (210008 bytes): error at 2750: Recursion limit",
    "SELECT * FROM (SELECT * … (160015 bytes): error at 3750: Recursion limit",
    "SELECT CASE WHEN CASE WH… (210008 bytes): error at 4997: Recursion limit",
    "SELECT EXISTS (SELECT EX… (160008 bytes): error at 3750: Recursion limit",
    "SELECT 1 IN (1 IN (1 IN … (70008 bytes): error at 1503: Recursion limit",
    "SELECT 1 IN f(1 IN f(1 I… (80008 bytes): error at 1171: Recursion limit",
    "SELECT f(1) FILTER (WHER… (200008 bytes): error at 4739: Recursion limit",
    "SELECT 1 LIMIT (SELECT 1… (170016 bytes): error at 4000: Recursion limit",
    "SELECT (VALUES ((VALUES … (110008 bytes): error at 2249: Recursion limit",
    "SELECT CAST(CAST(CAST(CA… (130008 bytes): error at 1257: Recursion limit",
  ]);
}

export function test_parameter_limit() {
  const sqls: string[] = [];
  // SQLite's 32766 parameters: `?`, `?NNN` and names alike.
  sqls.push("SELECT ?32766, ?");
  sqls.push("SELECT " + "?, ".repeat(32766) + "?");
  const names: string[] = [];
  for (let i = 0; i < 32767; i++) {
    names.push(`:p${i}`);
  }
  sqls.push("SELECT " + names.slice(0, 32766).join(", ") + ", :p0, ?1");
  sqls.push("SELECT " + names.join(", "));
  assertEq(sqls.map((s) => depth(s)), [
    "SELECT ?32766, ? (16 bytes): error at 15: too many SQL variables",
    "SELECT ?, ?, ?, ?, ?, ?,… (98306 bytes): error at 98305: too many SQL variables",
    "SELECT :p0, :p1, :p2, :p… (283798 bytes): height 1, 1 cores",
    "SELECT :p0, :p1, :p2, :p… (283798 bytes): error at 283791: too many SQL variables",
  ]);
}

export function test_a_collate_run_is_one_node() {
  // A run of COLLATE is one node, however long: the tree can be walked.
  assertEq(
    sel(new Parser("SELECT 1" + " COLLATE x".repeat(5000) + " COLLATE y").select()),
    "{SELECT (COLLATE 1 Y)}",
  );
}

// The keyword sweep: + where the keyword is accepted, - where it is a syntax error, in the
// order of FORMS; the expected marks are /usr/bin/sqlite3 3.54's.
export function test_keyword_sweep() {
  const marks: string[] = KEYWORDS.map(
    (kw) => `${kw} ${FORMS.map((f) => (accepts(f.replaceAll("%", kw)) ? "+" : "-")).join("")}`,
  );
  assertEq(marks, [
    "abort ++++++++++++",
    "action ++++++++++++",
    "add ------------",
    "after ++++++++++++",
    "all --------+---",
    "alter ------------",
    "always ++++++++++++",
    "analyze ++++++++++++",
    "and ------------",
    "as ------------",
    "asc ++++++++++++",
    "attach ++++++++++++",
    "autoincrement ------------",
    "before ++++++++++++",
    "begin ++++++++++++",
    "between ------------",
    "by ++++++++++++",
    "cascade ++++++++++++",
    "case ------------",
    "cast -++++++--+-+",
    "check ------------",
    "collate ------------",
    "column ++++++++++++",
    "commit ------------",
    "conflict ++++++++++++",
    "constraint ------------",
    "create ------------",
    "cross ++++-+-++++-",
    "current ++++++++++++",
    "current_date ++++++++-+++",
    "current_time ++++++++-+++",
    "current_timestamp ++++++++-+++",
    "database ++++++++++++",
    "default ------------",
    "deferrable ------------",
    "deferred ++++++++++++",
    "delete ------------",
    "desc ++++++++++++",
    "detach ++++++++++++",
    "distinct --------+---",
    "do ++++++++++++",
    "drop ------------",
    "each ++++++++++++",
    "else ------------",
    "end ++++++++++++",
    "escape ------------",
    "except ------------",
    "exclude ++++++++++++",
    "exclusive ++++++++++++",
    "exists ------------",
    "explain ++++++++++++",
    "fail ++++++++++++",
    "filter ++++++++++++",
    "first ++++++++++++",
    "following ++++++++++++",
    "for ++++++++++++",
    "foreign ------------",
    "from ------------",
    "full ++++-+-++++-",
    "generated ++++++++++++",
    "glob ++++++-+++++",
    "group ------------",
    "groups ++++++++++++",
    "having ------------",
    "if ++++++++++++",
    "ignore ++++++++++++",
    "immediate ++++++++++++",
    "in ------------",
    "index ------------",
    "indexed ++++-+-++++-",
    "initially ++++++++++++",
    "inner ++++-+-++++-",
    "insert ------------",
    "instead ++++++++++++",
    "intersect ------------",
    "into ------------",
    "is ------------",
    "isnull ------+-----",
    "join ------------",
    "key ++++++++++++",
    "last ++++++++++++",
    "left ++++-+-++++-",
    "like ++++++-+++++",
    "limit ------------",
