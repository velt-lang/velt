// Window functions in the SQLite engine written in Velt (sqlite/engine, #1720) on a database C
// SQLite writes (through the driver): ranking and value functions, aggregates over frames (ROWS,
// GROUPS, RANGE, EXCLUDE, FILTER), named windows and their errors; each value printed as SQLite's
// quote() prints it. The expected rows are the sqlite3 shell's (`.mode quote`) for the same
// queries on the same data; rows of a query without ORDER BY are sorted on both sides.
import { open } from "../src/lib";
import { openDatabase, Database } from "../src/engine/index";
import { BLOB, REAL } from "../src/engine/storage_class";
import { Val } from "../src/engine/exec/value/val";
import { quote } from "../src/engine/exec/func/func_text";
import { hexEncode } from "velt/encoding";
import { tmpdir } from "velt/os";
import { uuidv4 } from "velt/random/uuid";
import { removeSync } from "velt/fs";

const SETUP = `
CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL, note,
  nick TEXT COLLATE NOCASE);
CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, title TEXT, body TEXT,
  created TEXT NOT NULL, stars NUMERIC);
CREATE INDEX posts_user ON posts (user_id);
CREATE INDEX posts_created ON posts (created DESC, id DESC);
CREATE TABLE tags (post_id INTEGER, tag TEXT, PRIMARY KEY (post_id, tag));
CREATE INDEX tags_tag ON tags (tag);
CREATE TABLE kv (k TEXT PRIMARY KEY, v);
CREATE VIEW popular AS SELECT post_id, count(*) AS n FROM tags GROUP BY post_id HAVING count(*) > 1;
INSERT INTO users VALUES
  (1, 'alice', 30, 4.5, NULL, 'Al'), (2, 'bob', 25, 3.0, 'hi', 'BOBBY'), (3, 'carol', 35, NULL, 7, 'cc'),
  (4, 'dave', 25, 2.25, x'00ff', 'Dave'), (5, 'eve', NULL, 5.0, 1.5, 'al'), (6, 'Frank', 41, -1.0, '12', NULL),
  (7, 'grace', 30, 1e10, '', 'GRACE'), (8, 'héloïse', 28, 0.1, 'ü', 'h');
INSERT INTO posts VALUES
  (1, 1, 'Hello', 'first post', '2024-01-01', 5), (2, 1, 'Again', 'second', '2024-01-03', '7'),
  (3, 2, 'Bob here', NULL, '2024-01-02', 2.5), (4, 3, 'x', 'carol''s', '2024-01-05', NULL),
  (5, 3, 'y', 'more', '2024-01-04', 0), (6, 3, 'z', '', '2024-01-04', -3), (7, 9, 'orphan', 'no user', '2024-01-06', 1),
  (8, 5, 'Eve', 'eve', '2024-01-07', '1e2'), (9, 7, 'Grace', 'g', '2024-01-02', 'abc'), (10, 2, 'Bob 2', 'b2', '2024-01-08', 4);
INSERT INTO tags VALUES (1, 'intro'), (1, 'misc'), (2, 'misc'), (3, 'intro'), (4, 'Misc'),
  (5, 'news'), (8, 'news'), (8, 'intro'), (9, 'misc'), (10, 'x');
INSERT INTO kv VALUES ('a', 1), ('b', '2'), ('c', 3.5), ('d', NULL), ('e', x'41'), ('f', 'text'),
  ('g', -9223372036854775808), ('h', 9223372036854775807), ('i', 1e300), ('j', 0.30000000000000004);
`;

/** A query, the parameters bound (if any) and the rows it gives (or its error). */
struct Case {
  sql: string;
  params: string[];
  rows: string[];
}

const W_WINDOW_FUNCTIONS: Case[] = [
  // Window functions: ranking, values, aggregates over frames, named windows.
  Case {
    sql:
      "SELECT id, age, row_number() OVER (ORDER BY age, id), rank() OVER w, dense_rank() OVER w FROM users WINDOW w AS (ORDER BY age) ORDER BY id",
    params: [],
    rows: [
      "1,30,5,5,4",
      "2,25,2,2,2",
      "3,35,7,7,5",
      "4,25,3,2,2",
      "5,NULL,1,1,1",
      "6,41,8,8,6",
      "7,30,6,5,4",
      "8,28,4,4,3",
    ],
  },
  Case {
    sql:
      "SELECT id, user_id, row_number() OVER (PARTITION BY user_id ORDER BY created DESC) AS n FROM posts ORDER BY user_id, n",
    params: [],
    rows: [
      "2,1,1",
      "1,1,2",
      "10,2,1",
      "3,2,2",
      "4,3,1",
      "5,3,2",
      "6,3,3",
      "8,5,1",
      "9,7,1",
      "7,9,1",
    ],
  },
  Case {
    sql:
      "SELECT id, percent_rank() OVER (ORDER BY created), cume_dist() OVER (ORDER BY created), ntile(3) OVER (ORDER BY id) FROM posts ORDER BY id",
    params: [],
    rows: [
      "1,0.0,0.1,1",
      "2,0.33333333333333332,0.4,1",
      "3,0.1111111111111111,0.3,1",
      "4,0.66666666666666663,0.7,1",
      "5,0.44444444444444442,0.6,2",
      "6,0.44444444444444442,0.6,2",
      "7,0.77777777777777779,0.8,2",
      "8,0.88888888888888884,0.9,3",
      "9,0.1111111111111111,0.3,3",
      "10,1.0,1.0,3",
    ],
  },
  Case {
    sql:
      "SELECT id, lag(title) OVER (ORDER BY id), lead(title, 2, '-') OVER (ORDER BY id) FROM posts ORDER BY id",
    params: [],
    rows: [
      "1,NULL,'Bob here'",
      "2,'Hello','x'",
      "3,'Again','y'",
      "4,'Bob here','z'",
      "5,'x','orphan'",
      "6,'y','Eve'",
      "7,'z','Grace'",
      "8,'orphan','Bob 2'",
      "9,'Eve','-'",
      "10,'Grace','-'",
    ],
  },
  Case {
    sql:
      "SELECT id, first_value(id) OVER w, last_value(id) OVER w, nth_value(id, 2) OVER w FROM posts WINDOW w AS (PARTITION BY user_id ORDER BY id) ORDER BY id",
    params: [],
    rows: [
      "1,1,1,NULL",
      "2,1,2,2",
      "3,3,3,NULL",
      "4,4,4,NULL",
      "5,4,5,5",
      "6,4,6,5",
      "7,7,7,NULL",
      "8,8,8,NULL",
      "9,9,9,NULL",
      "10,3,10,10",
    ],
  },
  Case {
    sql:
      "SELECT id, sum(stars) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), avg(stars) OVER (ORDER BY id ROWS 2 PRECEDING) FROM posts ORDER BY id",
    params: [],
    rows: [
      "1,12,5.0",
      "2,14.5,6.0",
      "3,9.5,4.833333333333333",
      "4,2.5,4.75",
      "5,-3.0,1.25",
      "6,-2.0,-1.5",
      "7,98.0,-0.66666666666666663",
      "8,101.0,32.666666666666664",
      "9,104.0,33.666666666666664",
      "10,4.0,34.666666666666664",
    ],
  },
  Case {
    sql:
      "SELECT id, count(*) OVER (ORDER BY created GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW EXCLUDE TIES), group_concat(id, '+') OVER (ORDER BY created RANGE BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) FROM posts ORDER BY id",
    params: [],
    rows: [
      "1,1,'1+3+9+2+5+6+4+7+8+10'",
      "2,3,'2+5+6+4+7+8+10'",
      "3,2,'3+9+2+5+6+4+7+8+10'",
