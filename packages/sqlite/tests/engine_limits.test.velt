// The SQLite engine written in Velt (sqlite/engine, #1720) at SQLite's limits on nesting:
// FROM subqueries nested 200 deep (the parser's nesting bound, #1774, stops them before SQLite's
// 416, "Recursion limit"), views nest 999 deep
// and not 1000 ("VIEWs and/or subqueries nested too deep"), a statement references a table at
// most 65534 times (CTEs expanded; once in a query compiled again), an endless recursive CTE
// ends at an outer LIMIT, and a result has at most 2,000 columns (`*` counted as the columns it
// stands for, a VALUES row too), ORDER BY terms (a compound's too, a window's PARTITION BY and
// ORDER BY together) and GROUP BY terms.
// The expected values are the sqlite3 shell's for the same statements.
import { open } from "../src/lib";
import { openDatabase, Database } from "../src/engine/index";
import { Val } from "../src/engine/exec/value/val";
import { quote } from "../src/engine/exec/func/func_text";
import { tmpdir } from "velt/os";
import { uuidv4 } from "velt/random/uuid";
import { removeSync } from "velt/fs";

/** The values `sql` gives, quoted and joined by spaces, or "error: " and its message. */
function show(db: Database, sql: string): string {
  try {
    const st = db.prepare(sql);
    const vals: Val[] = st.values();
    const parts: string[] = [];
    for (const v of vals) {
      parts.push(quote(v));
    }
    return parts.join(" ");
  } catch (e) {
    return `error: ${e.message}`;
  }
}

function nestedFrom(n: i64): string {
  let q = "SELECT 1 AS x";
  for (let i: i64 = 0; i < n; i++) {
    q = `SELECT x + 1 AS x FROM (${q}) WHERE x > 0`;
  }
  return q;
}

function cteChain(n: i64): string {
  let q = "WITH c0(x) AS (SELECT id FROM t)";
  for (let i: i64 = 1; i <= n; i++) {
    q += `, c${i}(x) AS (SELECT a.x FROM c${i - 1} a JOIN c${i - 1} b ON a.x = b.x)`;
  }
  return q + ` SELECT count(*) FROM c${n}`;
}

/** A database file made by C SQLite from `ddl` and opened in the engine, and its path. */
function create(ddl: string): string {
  const path = `${tmpdir()}/velt-engine-limits-${uuidv4()}.db`;
  const c = open(path);
  c.exec(ddl);
  c.close();
  return path;
}

const TABLE_T = "CREATE TABLE t (id INTEGER PRIMARY KEY); INSERT INTO t VALUES (1), (2);";

export function test_nesting_of_subqueries_and_views() {
  let ddl = "CREATE VIEW v0 AS SELECT 1 AS x;";
  for (let i = 1; i < 1000; i++) {
    ddl += `CREATE VIEW v${i} AS SELECT x FROM v${i - 1};`;
  }
  const path = create(ddl);
  const db = openDatabase(path);
  assertEq(show(db, nestedFrom(200)), "201");
  assertEq(show(db, "SELECT x FROM v998"), "1");
  assertEq(show(db, "SELECT x FROM v999"), "error: VIEWs and/or subqueries nested too deep");
  removeSync(path);
}

export function test_references_to_a_table() {
  const path = create(TABLE_T);
  const db = openDatabase(path);
  // 4096 FROM terms once flattened.
  assertEq(
    show(db, cteChain(12).replace(" JOIN ", ", ").replace(" ON a.x = b.x", "")),
    "error: too many FROM clause terms, max: 200",
  );
  // 65536 references.
  assertEq(show(db, cteChain(16)), 'error: too many references to "t": max 65535');
  // A query that compiles again as an aggregate query counts its FROM's references once:
  // 32768 references.
  assertEq(
    show(
      db,
      cteChain(15)
        .replaceAll("SELECT a.x", "SELECT DISTINCT a.x")
        .replace(" SELECT count(*) FROM c15", " SELECT (SELECT count(c15.x) FROM t) FROM c15"),
    ),
    "2",
  );
  removeSync(path);
}

export function test_endless_recursion_under_limit() {
  const path = create(TABLE_T);
  const db = openDatabase(path);
  assertEq(
    show(
      db,
      "WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT n FROM r LIMIT 3",
    ),
    "1 2 3",
  );
  removeSync(path);
}

// SQLITE_MAX_COLUMN: 2,000 result columns, ORDER BY terms and GROUP BY terms.
export function test_at_most_2000_columns_and_terms() {
  // Tables of 1,000, 1,000 and 1,001 columns, for `*` at the result's 2,000 columns.
  const cols = (n: i64) => Array.from({ length: n }, (_, i) => `c${i + 1}`).join(", ");
  let ddl = TABLE_T;
  ddl += `CREATE TABLE w1 (${cols(1000)}); CREATE TABLE w2 (${cols(1000)});`;
  ddl += `CREATE TABLE w3 (${cols(1001)});`;
  const path = create(ddl);
  const db = openDatabase(path);
  const ones = (n: i64) => Array.from({ length: n }, () => "1").join(", ");
  const ids = (n: i64) => Array.from({ length: n }, () => "id").join(", ");
  assertEq(show(db, `SELECT count(*) FROM (SELECT ${ones(2000)})`), "1");
  assertEq(
    show(db, `SELECT count(*) FROM (SELECT ${ones(2001)})`),
    "error: too many columns in result set",
  );
  assertEq(show(db, `SELECT id FROM t ORDER BY ${ids(2000)}`), "1 2");
  assertEq(
    show(db, `SELECT id FROM t ORDER BY ${ids(2001)}`),
    "error: too many terms in ORDER BY clause",
  );
  assertEq(show(db, `SELECT id FROM t GROUP BY ${ids(2000)}`), "1 2");
  assertEq(
    show(db, `SELECT id FROM t GROUP BY ${ids(2001)}`),
    "error: too many terms in GROUP BY clause",
  );
  const compound = (n: i64) => `SELECT id FROM t UNION SELECT 3 ORDER BY ${ones(n)}`;
  assertEq(show(db, compound(2000)), "1 2 3");
  assertEq(show(db, compound(2001)), "error: too many terms in ORDER BY clause");
  // A VALUES row.
  assertEq(show(db, `SELECT count(*) FROM (VALUES (${ones(2000)}))`), "1");
  assertEq(
    show(db, `SELECT count(*) FROM (VALUES (${ones(2001)}))`),
    "error: too many columns in result set",
  );
  // `*` over 1000 + 1000 and 1000 + 1001 columns.
  assertEq(show(db, "SELECT count(*) FROM (SELECT * FROM w1, w2)"), "0");
  assertEq(
    show(db, "SELECT count(*) FROM (SELECT * FROM w1, w3)"),
    "error: too many columns in result set",
  );
  // A window's PARTITION BY and ORDER BY count together, as one ORDER BY, where it is used;
  // the error comes after the names resolve.
  const many = "error: too many terms in ORDER BY clause";
  const win = (over: string) => `SELECT count(*) OVER (${over}) FROM t`;
  assertEq(show(db, win(`ORDER BY ${ids(2000)}`)), "1 2");
  assertEq(show(db, win(`ORDER BY ${ids(2001)}`)), many);
  assertEq(show(db, win(`PARTITION BY ${ids(2000)}`)), "1 1");
  assertEq(show(db, win(`PARTITION BY ${ids(2001)}`)), many);
  assertEq(show(db, win(`PARTITION BY ${ids(1000)} ORDER BY ${ids(1000)}`)), "1 1");
  assertEq(show(db, win(`PARTITION BY ${ids(1000)} ORDER BY ${ids(1001)}`)), many);
  const named = (n: i64) => `SELECT count(*) OVER w FROM t WINDOW w AS (ORDER BY ${ids(n)})`;
  assertEq(show(db, named(2000)), "1 2");
  assertEq(show(db, named(2001)), many);
  assertEq(show(db, `SELECT 1 FROM t WINDOW w AS (ORDER BY ${ids(2001)})`), "1 1");
  const over2001 = `count(*) OVER (ORDER BY ${ids(2001)})`;
  assertEq(show(db, `SELECT id FROM t ORDER BY ${over2001}`), many);
  assertEq(show(db, `SELECT ${over2001}, nosuch FROM t`), "error: no such column: nosuch");
  removeSync(path);
}
