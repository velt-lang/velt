// The query engine's operators on values (src/engine/exec/ops, src/engine/exec/value) against
// C SQLite (the driver): arithmetic, comparison, bitwise operators, unary minus, CAST and LIKE /
// GLOB, on every pair of a set of operands of each storage class, edge values included (the ends
// of i64, -0.0, text with a numeric prefix, blobs). Each result is compared with what C SQLite
// computes for the same SQL expression; the tests assert that no case differs.
import { open, Database } from "../src/lib";
import { NULL, INTEGER, REAL, TEXT } from "../src/engine/storage_class";
import { A_BLOB, A_INTEGER, A_NUMERIC, A_REAL, A_TEXT } from "../src/engine/affinity";
import { BINARY } from "../src/engine/collation";
import { Val, blobVal, intVal, nullVal, realVal, textVal } from "../src/engine/exec/value/val";
import { checkLength, concatOp, toText } from "../src/engine/exec/value/value_text";
import {
  BIT_AND,
  BIT_OR,
  BIT_SHL,
  BIT_SHR,
  OP_ADD,
  OP_DIV,
  OP_EQ,
  OP_GE,
  OP_GT,
  OP_LE,
  OP_LT,
  OP_MUL,
  OP_NE,
  OP_REM,
  OP_SUB,
  arithOp,
  bitOp,
  castTo,
  compareOp,
  negate,
} from "../src/engine/exec/value/ops";
import { compileLike } from "../src/engine/exec/value/like";
import { hexEncode } from "velt/encoding";

struct Operand {
  sql: string;
  v: Val;
}

struct Described {
  d: string;
}

// A value as the C side describes it: its type and its text (a blob's hex).
const DESCRIBE =
  "typeof(e) || ':' || CASE typeof(e) WHEN 'blob' THEN hex(e) WHEN 'null' THEN '' ELSE CAST(e AS TEXT) END AS d";

function describe(v: Val): string {
  const ty =
    v.t == NULL
      ? "null"
      : v.t == INTEGER ? "integer" : v.t == REAL ? "real" : v.t == TEXT ? "text" : "blob";
  if (v.t == NULL) {
    return `${ty}:`;
  }
  return v.t == TEXT || v.t == INTEGER || v.t == REAL
    ? `${ty}:${toText(v)}`
    : `${ty}:${hexEncode(v.b).toUpperCase()}`;
}

function cValue(db: Database, expr: string): string {
  const rows: Described[] = db.prepare(`SELECT ${DESCRIBE} FROM (SELECT ${expr} AS e)`).all();
  return rows[0].d;
}

// `s LIKE p [ESCAPE e]` in the engine and in C SQLite, described as the value or the error; a long
// operand is shown by its length.
function likeBoth(db: Database, s: Operand, p: Operand, e: Operand | null): string {
  const short = (o: Operand) => (o.sql.length > 40 ? `<${o.sql.length} chars of SQL>` : o.sql);
  let sql = `${s.sql} LIKE ${p.sql}`;
  let shown = `${short(s)} LIKE ${short(p)}`;
  if (e != null) {
    sql = `${sql} ESCAPE ${e!.sql}`;
    shown = `${shown} ESCAPE ${e!.sql}`;
  }
  let mine = "";
  try {
    const ev = e != null ? e!.v : null;
    mine = describe(
      compileLike(() => s.v, () => p.v, ev != null ? () => ev! : null, false, false)(),
    );
  } catch (err) {
    mine = `error "${err.message}"`;
  }
  let theirs = "";
  try {
    theirs = cValue(db, sql);
  } catch (err) {
    theirs = `error "${err.message}"`;
  }
  return `${shown}: velt ${mine}, C ${theirs}`;
}

const OPERANDS: Operand[] = [
  Operand { sql: "NULL", v: nullVal() },
  Operand { sql: "0", v: intVal(0) },
  Operand { sql: "1", v: intVal(1) },
  Operand { sql: "-1", v: intVal(-1) },
  Operand { sql: "7", v: intVal(7) },
  Operand { sql: "-3", v: intVal(-3) },
  Operand { sql: "64", v: intVal(64) },
  Operand { sql: "9223372036854775807", v: intVal(9223372036854775807) },
  Operand { sql: "(-9223372036854775807 - 1)", v: intVal(-9223372036854775807 - 1) },
  Operand { sql: "2.5", v: realVal(2.5) },
  Operand { sql: "-0.0", v: realVal(-0.0) },
  Operand { sql: "1e308", v: realVal(1e308) },
  Operand { sql: "-7.75", v: realVal(-7.75) },
  Operand { sql: "'12abc'", v: textVal("12abc") },
  Operand { sql: "' 7 '", v: textVal(" 7 ") },
  Operand { sql: "'-0'", v: textVal("-0") },
  Operand { sql: "'0.0'", v: textVal("0.0") },
  Operand { sql: "'3.0e2'", v: textVal("3.0e2") },
  Operand { sql: "'abc'", v: textVal("abc") },
  Operand { sql: "'ABC'", v: textVal("ABC") },
  Operand { sql: "x'3132'", v: blobVal([49, 50]) },
  Operand { sql: "x''", v: blobVal([]) },
];

struct Op {
  sql: string;
  code: u8;
}

const ARITH: Op[] = [
  Op { sql: "+", code: OP_ADD },
  Op { sql: "-", code: OP_SUB },
  Op { sql: "*", code: OP_MUL },
  Op { sql: "/", code: OP_DIV },
  Op { sql: "%", code: OP_REM },
];

export function test_binary_operators_match_c_sqlite() {
  const db = open(":memory:");
  const cmp: Op[] = [
    Op { sql: "=", code: OP_EQ },
    Op { sql: "<>", code: OP_NE },
    Op { sql: "<", code: OP_LT },
    Op { sql: "<=", code: OP_LE },
    Op { sql: ">", code: OP_GT },
    Op { sql: ">=", code: OP_GE },
  ];
  const bits: Op[] = [
    Op { sql: "&", code: BIT_AND },
    Op { sql: "|", code: BIT_OR },
    Op { sql: "<<", code: BIT_SHL },
    Op { sql: ">>", code: BIT_SHR },
  ];
  let cases = 0;
  const differ: string[] = [];
  const check = (expr: string, got: Val) => {
    cases++;
    const want = cValue(db, expr);
    const mine = describe(got);
    if (want != mine) {
      differ.push(`${expr}: velt ${mine}, C ${want}`);
    }
  };
  for (const a of OPERANDS) {
    for (const b of OPERANDS) {
      for (const op of ARITH) {
        check(`${a.sql} ${op.sql} ${b.sql}`, arithOp(op.code, a.v, b.v));
      }
      for (const op of cmp) {
        check(`${a.sql} ${op.sql} ${b.sql}`, compareOp(op.code, a.v, b.v, A_BLOB, BINARY));
      }
      for (const op of bits) {
        check(`${a.sql} ${op.sql} ${b.sql}`, bitOp(op.code, a.v, b.v));
      }
    }
  }
  assertEq(cases, 7260);
  assertEq(differ, []);
}

export function test_minus_and_cast_match_c_sqlite() {
  const db = open(":memory:");
  let cases = 0;
  const differ: string[] = [];
  const check = (expr: string, got: Val) => {
    cases++;
    const want = cValue(db, expr);
    const mine = describe(got);
    if (want != mine) {
      differ.push(`${expr}: velt ${mine}, C ${want}`);
    }
  };
  const affinities: u8[] = [A_INTEGER, A_REAL, A_TEXT, A_BLOB, A_NUMERIC];
  const names = ["INTEGER", "REAL", "TEXT", "BLOB", "NUMERIC"];
  for (const a of OPERANDS) {
    check(`-(${a.sql})`, negate(a.v));
    for (let i: usize = 0; i < affinities.length; i++) {
      check(`CAST(${a.sql} AS ${names[i]})`, castTo(a.v, affinities[i]));
    }
  }
  assertEq(cases, 132);
  assertEq(differ, []);
}

export function test_like_and_glob_match_c_sqlite() {
  const db = open(":memory:");
  let cases = 0;
  const differ: string[] = [];
  const check = (expr: string, got: Val) => {
    cases++;
    const want = cValue(db, expr);
    const mine = describe(got);
    if (want != mine) {
      differ.push(`${expr}: velt ${mine}, C ${want}`);
    }
  };
  const texts = ["abc", "ABC", "aBc", "a_c", "a%c", "", "é", "É", "x[y]z", "a\\c"];
  const patterns = [
    "abc",
    "a_c",
    "A%",
    "%c",
    "%",
    "_",
    "[a-c]*",
    "a?c",
    "*[]]*",
    "é",
    "É",
    "a\\%c",
  ];
  for (const t of texts) {
    for (const p of patterns) {
      const tv = textVal(t);
      const pv = textVal(p);
      const lit = (s: string) => `'${s.replaceAll("'", "''")}'`;
      check(`${lit(t)} LIKE ${lit(p)}`, compileLike(() => tv, () => pv, null, false, false)());
      check(`${lit(t)} GLOB ${lit(p)}`, compileLike(() => tv, () => pv, null, true, false)());
      const esc = textVal("\\");
      check(
        `${lit(t)} NOT LIKE ${lit(p)} ESCAPE '\\'`,
        compileLike(() => tv, () => pv, () => esc, false, true)(),
      );
    }
  }
  // An ESCAPE that is `%` or `_` turns that wildcard off.
  for (const [t, p, e] of [
    ["abc", "%", "%"],
    ["%", "%", "%"],
    ["a%", "a%%", "%"],
    ["ab", "a_", "_"],
    ["a_", "a__", "_"],
    ["abc", "%_", "_"],
  ]) {
    const tv = textVal(t);
    const pv = textVal(p);
    const ev = textVal(e);
    check(
      `'${t}' LIKE '${p}' ESCAPE '${e}'`,
      compileLike(() => tv, () => pv, () => ev, false, false)(),
    );
  }
  assertEq(cases, 366);
  assertEq(differ, []);
}

export function test_like_pattern_length_limit() {
  const db = open(":memory:");
  // A pattern of SQLite's longest length (50,000 bytes) whose every `%` must try many places: no
  // recursion per `%`, so no stack overflow. One byte more is SQLite's error.
  const many = textVal("a".repeat(25000));
  const longest = "%a".repeat(25000);
  const near = textVal(longest);
  const nearSql = `'${"a".repeat(25000)}' LIKE '${longest}'`;
  const nearGot = describe(compileLike(() => many, () => near, null, false, false)());
  assertEq(nearGot, "integer:1");
  assertEq(cValue(db, nearSql), "integer:1");
  const over = textVal(longest + "a");
  let mine = "no error";
  try {
    compileLike(() => many, () => over, null, true, false)();
  } catch (e) {
    mine = e.message.clone();
  }
  let theirs = "no error";
  try {
    cValue(db, `'${"a".repeat(25000)}' GLOB '${longest}a'`);
  } catch (e) {
    theirs = e.message.clone();
  }
  assertEq(mine, "LIKE or GLOB pattern too complex");
  assertEq(theirs, "LIKE or GLOB pattern too complex");
}

export function test_like_checks_in_sqlite_order() {
  const db = open(":memory:");
  // SQLite checks in likeFunc's order: the pattern's bytes (those after a NUL too) even when the
  // string is NULL, then the ESCAPE (a NULL one gives NULL), and only then NULL operands.
  const tooLong = "a".repeat(50001);
  const afterNul = "a\u0000" + "b".repeat(50000);
  const sqlNul = `'a' || char(0) || '${"b".repeat(50000)}'`;
  const one = Operand { sql: "1", v: intVal(1) };
  const twelve = Operand { sql: "12", v: intVal(12) };
  const nothing = Operand { sql: "NULL", v: nullVal() };
  assertEq(
    likeBoth(db, nothing, Operand { sql: `'${tooLong}'`, v: textVal(tooLong) }, null),
    `NULL LIKE <50003 chars of SQL>: velt error "LIKE or GLOB pattern too complex", C error "LIKE or GLOB pattern too complex"`,
  );
  const ab = Operand { sql: "'ab'", v: textVal("ab") };
  assertEq(
    likeBoth(
      db,
      Operand { sql: "'a'", v: textVal("a") },
      Operand { sql: `'${tooLong}'`, v: textVal(tooLong) },
      ab,
    ),
    `'a' LIKE <50003 chars of SQL> ESCAPE 'ab': velt error "LIKE or GLOB pattern too complex", C error "LIKE or GLOB pattern too complex"`,
  );
  assertEq(
    likeBoth(
      db,
      Operand { sql: "'a'", v: textVal("a") },
      Operand { sql: sqlNul, v: textVal(afterNul) },
      null,
    ),
    `'a' LIKE <50020 chars of SQL>: velt error "LIKE or GLOB pattern too complex", C error "LIKE or GLOB pattern too complex"`,
  );
  assertEq(
    likeBoth(db, nothing, one, twelve),
    `NULL LIKE 1 ESCAPE 12: velt error "ESCAPE expression must be a single character", C error "ESCAPE expression must be a single character"`,
  );
  assertEq(
    likeBoth(db, one, nothing, twelve),
    `1 LIKE NULL ESCAPE 12: velt error "ESCAPE expression must be a single character", C error "ESCAPE expression must be a single character"`,
  );
  // A NULL ESCAPE gives NULL, and the ESCAPE's length is counted up to its first NUL.
  const a = Operand { sql: "'a'", v: textVal("a") };
  const x = Operand { sql: "'x'", v: textVal("x") };
  assertEq(likeBoth(db, a, a, nothing), `'a' LIKE 'a' ESCAPE NULL: velt null:, C null:`);
  assertEq(
    likeBoth(db, x, x, Operand { sql: "'a' || char(0) || 'b'", v: textVal("a\u0000b") }),
    `'x' LIKE 'x' ESCAPE 'a' || char(0) || 'b': velt integer:1, C integer:1`,
  );
  assertEq(
    likeBoth(db, a, a, Operand { sql: "char(0)", v: textVal("\u0000") }),
    `'a' LIKE 'a' ESCAPE char(0): velt error "ESCAPE expression must be a single character", C error "ESCAPE expression must be a single character"`,
  );
}

export function test_length_limit_and_concat() {
  // SQLite's length limit (SQLITE_MAX_LENGTH, 1,000,000,000 bytes), checked before a value is
  // built; `||` checks it on the two texts' lengths.
  const results: string[] = [];
  for (const n of [1000000000, 1000000001]) {
    let r = "ok";
    try {
      checkLength(n as u64);
    } catch (e) {
      r = e.message.clone();
    }
    results.push(`a value of ${n} bytes: ${r}`);
  }
  assertEq(results, [
    "a value of 1000000000 bytes: ok",
    "a value of 1000000001 bytes: string or blob too big",
  ]);
  assertEq(describe(concatOp(textVal("ab"), intVal(12))), "text:ab12");
  assertEq(describe(concatOp(nullVal(), textVal("x"))), "null:");
}

export function test_results_spelled_out() {
  assertEq(describe(arithOp(OP_MUL, realVal(0.5), textVal("-0"))), "real:0.0");
  assertEq(describe(arithOp(OP_ADD, textVal("-0"), intVal(0))), "integer:0");
  assertEq(
    describe(arithOp(OP_ADD, intVal(9223372036854775807), intVal(1))),
    "real:9.2233720368547758e+18",
  );
  assertEq(describe(arithOp(OP_REM, realVal(7.5), intVal(-1))), "real:0.0");
  assertEq(
    describe(arithOp(OP_DIV, intVal(-9223372036854775807 - 1), intVal(-1))),
    "real:9.2233720368547758e+18",
  );
}
