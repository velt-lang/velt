// The statement parser of the Velt SQLite engine (src/engine/sql/statement, dml, ddl, pragma, table
// and column_def, #1720), a test of the package: CREATE TABLE with every column and table constraint, CREATE INDEX/VIEW,
// INSERT with UPSERT and RETURNING, UPDATE … FROM, DELETE, transactions, PRAGMA, DROP, ALTER TABLE,
// EXPLAIN. Accepted and rejected as /usr/bin/sqlite3 3.54 does, with its error messages.
import { parseAll, parseOne } from "../src/engine/sql/statement";
import { SqlError } from "../src/engine/sql/errors";

/** Every SQLite keyword (and some words that are not keywords), lower case. */
const KEYWORDS: string[] = (
  "abort action add after all alter always analyze and as asc attach autoincrement before " +
  "begin between by cascade case cast check collate column commit conflict constraint create " +
  "cross current current_date current_time current_timestamp database default deferrable " +
  "deferred delete desc detach distinct do drop each else end escape except exclude exclusive " +
  "exists explain fail filter first following for foreign from full generated glob group " +
  "groups having if ignore immediate in index indexed initially inner insert instead " +
  "intersect into is isnull join key last left like limit match materialized natural no not " +
  "nothing notnull null nulls of offset on or order others outer over partition plan pragma " +
  "preceding primary query raise range recursive references regexp reindex release rename " +
  "replace restrict returning right rollback row rows savepoint select set table temp " +
  "temporary then ties to transaction trigger unbounded union unique update using vacuum " +
  "values view virtual when where window with without rowid strict true false"
).split(" ");

/**
 * Where each keyword is tried: a column, a table, a type and a type's second word, a DEFAULT,
 * a collation, a MATCH name, an INSERT column, an UPDATE column, a DELETE alias, an index, a
 * pragma and its value, a savepoint, a dropped table.
 */
const FORMS: string[] = [
  "CREATE TABLE n(%)",
  "CREATE TABLE %(a)",
  "CREATE TABLE n(a %)",
  "CREATE TABLE n(a int %)",
  "CREATE TABLE n(a DEFAULT %)",
  "CREATE TABLE n(a COLLATE %)",
  "CREATE TABLE n(a REFERENCES p MATCH %)",
  "INSERT INTO t(%) VALUES (1)",
  "UPDATE t SET % = 1",
  "DELETE FROM t AS %",
  "CREATE INDEX % ON t(a)",
  "PRAGMA %",
  "PRAGMA x = %",
  "SAVEPOINT %",
  "DROP TABLE %",
];

/** Whether `sql` parses. */
function accepts(sql: string): bool {
  try {
    parseAll(sql);
    return true;
  } catch (e) {
    if (e instanceof SqlError) {
      return false;
    }
    throw e;
  }
}

/** Each statement of `sql` described field by field, or SQLite's error for it. */
function described(sql: string): string[] {
  try {
    const all = parseAll(sql);
    const parts: string[] = [];
    for (const s of all) {
      let d = `k${s.kind} ${s.schema != "" ? s.schema + "." : ""}${s.name}`;
      if (s.columnDefs.length > 0) {
        d +=
          " cols[" +
          s.columnDefs
            .map(
              (
                c,
              ) => `${c.name}:${c.type}${c.primaryKey ? " pk" : ""}${c.desc ? " desc" : ""}${c.autoincrement ? " auto" : ""}${c.notNull ? " nn" : ""}${c.unique ? " uq" : ""}${c.collate != "" ? " " + c.collate : ""}${c.dflt != null ? " dflt" + String(c.dflt!.kind) + (c.dflt!.text != "" ? "'" + c.dflt!.text : "") : ""}${c.check.length > 0 ? " check" : ""}${c.generated != null ? (c.stored ? " stored" : " virtual") : ""}`,
            )
            .join(", ") +
          "]";
      }
      if (s.primaryKey.length > 0) {
        d += ` pk(${s.primaryKey.map((c) => c.expr.name + (c.desc ? " desc" : "")).join(",")})`;
      }
      if (s.uniques.length > 0) {
        d += ` uniques ${s.uniques.length}`;
      }
      if (s.withoutRowid) {
        d += " without-rowid";
      }
      if (s.strict) {
        d += " strict";
      }
      if (s.indexed.length > 0) {
        d += ` on ${s.table} (${s.indexed.map((c) => String(c.expr.kind) + (c.collate != "" ? " " + c.collate : "") + (c.desc ? " desc" : "")).join(",")})${s.unique ? " unique" : ""}${s.where != null ? " partial" : ""}`;
      }
      if (s.columns.length > 0) {
        d += ` columns(${s.columns.join(",")})`;
      }
      if (s.rows.length > 0) {
        d += ` rows ${s.rows.length}`;
      }
      if (s.select != null) {
        d += " select";
      }
      if (s.defaultValues) {
        d += " default-values";
      }
      if (s.orConflict != "") {
        d += ` or ${s.orConflict}`;
      }
      if (s.upserts.length > 0) {
        d += ` upserts ${s.upserts.map((u) => u.doNothing ? "nothing" : "set " + u.setColumns.map((c) => c.join("+")).join(",")).join("; ")}`;
      }
      if (s.setColumns.length > 0) {
        d += ` set ${s.setColumns.map((c) => c.join("+")).join(",")}`;
      }
      if (s.from.length > 0) {
        d += ` from ${s.from.length}`;
      }
      if (s.where != null && s.indexed.length == 0) {
        d += " where";
      }
      if (s.returning.length > 0) {
        d += ` returning ${s.returning.length}`;
      }
      if (s.mode != "") {
        d += ` ${s.mode}`;
      }
      if (s.transaction != "") {
        d += ` transaction ${s.transaction}`;
      }
      if (s.indexedBy != "") {
        d += ` indexed-by ${s.indexedBy}`;
      }
      if (s.notIndexed) {
        d += " not-indexed";
      }
      if (s.alias != "") {
        d += ` alias ${s.alias}`;
      }
      if (s.checks.length > 0) {
        d += ` checks ${s.checks.length}`;
      }
      if (s.what != "") {
        d += ` ${s.what}${s.ifExists ? " if-exists" : ""}`;
      }
      if (s.ifNotExists) {
        d += " if-not-exists";
      }
      if (s.temp) {
        d += " temp";
      }
      if (s.value != null) {
        d += ` = ${s.value!.kind}:${s.value!.name}${s.value!.ival}${s.value!.text}`;
      }
      if (s.action != "") {
        d += ` ${s.action} ${s.newName}`;
      }
      if (s.inner != null) {
        d += ` explain${s.queryPlan ? " plan" : ""} k${s.inner!.kind}`;
      }
      d += ` | ${s.sql}`;
      parts.push(d);
    }
    return parts;
  } catch (e) {
    if (e instanceof SqlError) {
      return [`error at ${e.at}: ${e.message}`];
    }
    throw e;
  }
}

/** parseOne's statement kind, or its error. */
function one(sql: string): string {
  try {
    return `k${parseOne(sql).kind}`;
  } catch (e) {
    if (e instanceof SqlError) {
      return e.message.clone();
    }
    throw e;
  }
}

// The keyword sweep: + where the keyword is accepted, - where it is an error, in the order of
// FORMS; the expected marks are /usr/bin/sqlite3 3.54's.
export function test_keyword_sweep() {
  const marks: string[] = KEYWORDS.map(
    (kw) => `${kw} ${FORMS.map((f) => (accepts(f.replaceAll("%", kw)) ? "+" : "-")).join("")}`,
  );
  assertEq(marks, [
    "abort +++++++++++++++",
    "action +++++++++++++++",
    "add ---------------",
    "after +++++++++++++++",
    "all ---------------",
    "alter ---------------",
    "always +++++++++++++++",
    "analyze +++++++++++++++",
    "and ---------------",
    "as ---------------",
    "asc +++++++++++++++",
    "attach +++++++++++++++",
    "autoincrement ---------------",
    "before +++++++++++++++",
    "begin +++++++++++++++",
    "between ---------------",
    "by +++++++++++++++",
    "cascade +++++++++++++++",
    "case ---------------",
    "cast +++++++++++++++",
    "check ---------------",
    "collate ---------------",
    "column +++++++++++++++",
    "commit ---------------",
    "conflict +++++++++++++++",
    "constraint ---------------",
    "create ---------------",
    "cross ++----+++++++++",
    "current +++++++++++++++",
    "current_date +++++++++++++++",
    "current_time +++++++++++++++",
    "current_timestamp +++++++++++++++",
    "database +++++++++++++++",
    "default ------------+--",
    "deferrable --++-----------",
    "deferred +++++++++++++++",
    "delete ------------+--",
    "desc +++++++++++++++",
    "detach +++++++++++++++",
    "distinct ---------------",
    "do +++++++++++++++",
    "drop ---------------",
    "each +++++++++++++++",
    "else ---------------",
    "end +++++++++++++++",
    "escape ---------------",
    "except ---------------",
    "exclude +++++++++++++++",
    "exclusive +++++++++++++++",
    "exists ---------------",
    "explain +++++++++++++++",
    "fail +++++++++++++++",
    "filter +++++++++++++++",
    "first +++++++++++++++",
    "following +++++++++++++++",
    "for +++++++++++++++",
    "foreign ---------------",
    "from ---------------",
    "full ++----+++++++++",
    "generated +++++++++++++++",
    "glob +++++++++++++++",
    "group ---------------",
    "groups +++++++++++++++",
    "having ---------------",
    "if +-++++++++-+++-",
    "ignore +++++++++++++++",
    "immediate +++++++++++++++",
    "in ---------------",
    "index ---------------",
    "indexed ++--+-+++++++++",
    "initially +++++++++++++++",
    "inner ++----+++++++++",
    "insert ---------------",
    "instead +++++++++++++++",
    "intersect ---------------",
    "into ---------------",
    "is ---------------",
    "isnull ---------------",
    "join ---------------",
    "key +++++++++++++++",
    "last +++++++++++++++",
    "left ++----+++++++++",
    "like +++++++++++++++",
    "limit ---------------",
    "match +++++++++++++++",
    "materialized +++++++++++++++",
    "natural ++----+++++++++",
    "no +++++++++++++++",
    "not ---------------",
    "nothing ---------------",
    "notnull ---------------",
    "null --+++----------",
    "nulls +++++++++++++++",
    "of +++++++++++++++",
    "offset +++++++++++++++",
    "on ------------+--",
    "or ---------------",
    "order ---------------",
    "others +++++++++++++++",
    "outer ++----+++++++++",
    "over +++++++++++++++",
    "partition +++++++++++++++",
    "plan +++++++++++++++",
    "pragma +++++++++++++++",
    "preceding +++++++++++++++",
    "primary ---------------",
    "query +++++++++++++++",
    "raise +++++++++++++++",
    "range +++++++++++++++",
    "recursive +++++++++++++++",
    "references ---------------",
    "regexp +++++++++++++++",
    "reindex +++++++++++++++",
    "release +++++++++++++++",
    "rename +++++++++++++++",
    "replace +++++++++++++++",
    "restrict +++++++++++++++",
    "returning ---------------",
    "right ++----+++++++++",
    "rollback +++++++++++++++",
    "row +++++++++++++++",
    "rows +++++++++++++++",
    "savepoint +++++++++++++++",
    "select ---------------",
    "set ---------------",
    "table ---------------",
    "temp +++++++++++++++",
    "temporary +++++++++++++++",
    "then ---------------",
    "ties +++++++++++++++",
    "to ---------------",
    "transaction ---------------",
    "trigger +++++++++++++++",
    "unbounded +++++++++++++++",
    "union ---------------",
    "unique --++-----------",
    "update ---------------",
    "using ---------------",
    "vacuum +++++++++++++++",
    "values ---------------",
    "view +++++++++++++++",
    "virtual +++++++++++++++",
    "when ---------------",
    "where ---------------",
    "window +++++++++++++++",
    "with +++++++++++++++",
    "without +++++++++++++++",
    "rowid +++++++++++++++",
    "strict +++++++++++++++",
    "true +++++++++++++++",
    "false +++++++++++++++",
  ]);
}

// parseOne takes exactly one statement.
export function test_parse_one_takes_one_statement() {
  assertEq(one(""), "no statement");
  assertEq(one(" ; ;"), "no statement");
  assertEq(one("SELECT 1; SELECT 2"), "more than one statement");
  assertEq(one("SELECT 1;"), "k0");
}

export function test_every_statement_kind() {
  assertEq(
    described(
      "CREATE TABLE t (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE COLLATE NOCASE, score REAL DEFAULT -1.5, data BLOB, n INT CHECK (n > 0) DEFAULT (abs(-3)), g AS (n * 2) STORED, FOREIGN KEY (n) REFERENCES u(id) ON DELETE CASCADE, UNIQUE (name, n) ON CONFLICT REPLACE) WITHOUT ROWID, STRICT",
    ),
    [
      "k4 t cols[id:INTEGER pk auto, name:TEXT nn uq NOCASE, score:REAL dflt2, data:BLOB, n:INT dflt9 check, g: stored] uniques 1 without-rowid strict | CREATE TABLE t (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL UNIQUE COLLATE NOCASE, score REAL DEFAULT -1.5, data BLOB, n INT CHECK (n > 0) DEFAULT (abs(-3)), g AS (n * 2) STORED, FOREIGN KEY (n) REFERENCES u(id) ON DELETE CASCADE, UNIQUE (name, n) ON CONFLICT REPLACE) WITHOUT ROWID, STRICT",
    ],
  );
  assertEq(
    described(
      "CREATE TABLE IF NOT EXISTS main.\"my table\" ([a b] VARCHAR(10), `c` DOUBLE PRECISION, d, PRIMARY KEY (a DESC, c))",
    ),
    [
      "k4 main.my table cols[a b:VARCHAR(10), c:DOUBLE PRECISION, d:] pk(a desc,c) if-not-exists | CREATE TABLE IF NOT EXISTS main.\"my table\" ([a b] VARCHAR(10), `c` DOUBLE PRECISION, d, PRIMARY KEY (a DESC, c))",
    ],
  );
  assertEq(
    described(
      "CREATE UNIQUE INDEX IF NOT EXISTS ix ON t (lower(name) COLLATE NOCASE DESC, n) WHERE n > 0",
    ),
    [
      "k5 ix on t (9 NOCASE desc,6) unique partial if-not-exists | CREATE UNIQUE INDEX IF NOT EXISTS ix ON t (lower(name) COLLATE NOCASE DESC, n) WHERE n > 0",
    ],
  );
  assertEq(described("CREATE TEMP VIEW v (a, b) AS SELECT 1, 2"), [
    "k14 v columns(a,b) select temp | CREATE TEMP VIEW v (a, b) AS SELECT 1, 2",
  ]);
  assertEq(described("CREATE TABLE copy AS SELECT * FROM t"), [
    "k4 copy select | CREATE TABLE copy AS SELECT * FROM t",
  ]);
  assertEq(
    described(
      "INSERT INTO t (a, b) VALUES (1, 'x'), (?, :y) ON CONFLICT (a) DO UPDATE SET b = excluded.b, (c, d) = (1, 2) WHERE a > 0 ON CONFLICT DO NOTHING RETURNING *, a AS z",
    ),
    [
      "k1 t columns(a,b) rows 2 upserts set b,c+d; nothing returning 2 | INSERT INTO t (a, b) VALUES (1, 'x'), (?, :y) ON CONFLICT (a) DO UPDATE SET b = excluded.b, (c, d) = (1, 2) WHERE a > 0 ON CONFLICT DO NOTHING RETURNING *, a AS z",
    ],
  );
  assertEq(described("INSERT OR IGNORE INTO t SELECT * FROM u"), [
    "k1 t select or IGNORE | INSERT OR IGNORE INTO t SELECT * FROM u",
  ]);
  assertEq(described("REPLACE INTO t DEFAULT VALUES"), [
    "k1 t default-values or REPLACE | REPLACE INTO t DEFAULT VALUES",
  ]);
  assertEq(described("INSERT INTO t VALUES (1) UNION SELECT 2"), [
    "k1 t select | INSERT INTO t VALUES (1) UNION SELECT 2",
  ]);
  assertEq(
    described("UPDATE OR REPLACE t AS x SET a = a + 1 FROM u WHERE x.id = u.id RETURNING a"),
    [
      "k2 t or REPLACE set a from 1 where returning 1 alias x | UPDATE OR REPLACE t AS x SET a = a + 1 FROM u WHERE x.id = u.id RETURNING a",
    ],
  );
  assertEq(described("DELETE FROM t WHERE id IN (SELECT id FROM u) RETURNING id"), [
    "k3 t where returning 1 | DELETE FROM t WHERE id IN (SELECT id FROM u) RETURNING id",
  ]);
  assertEq(
    described(
      "BEGIN IMMEDIATE TRANSACTION; SAVEPOINT s1; RELEASE SAVEPOINT s1; ROLLBACK TO s1; COMMIT; END",
    ),
    [
      "k7  IMMEDIATE | BEGIN IMMEDIATE TRANSACTION",
      "k11 s1 | SAVEPOINT s1",
      "k12 s1 | RELEASE SAVEPOINT s1",
      "k9 s1 | ROLLBACK TO s1",
      "k8  | COMMIT",
      "k8  | END",
    ],
  );
  assertEq(
    described(
      "PRAGMA journal_mode = WAL; PRAGMA main.page_size(4096); PRAGMA table_info('t'); PRAGMA cache_size = -2000",
    ),
    [
      "k10 journal_mode = 6:WAL0 | PRAGMA journal_mode = WAL",
      "k10 main.page_size = 1:4096 | PRAGMA main.page_size(4096)",
      "k10 table_info = 3:0t | PRAGMA table_info('t')",
      "k10 cache_size = 1:-2000 | PRAGMA cache_size = -2000",
    ],
  );
  assertEq(
    described(
      "DROP TABLE IF EXISTS t; DROP INDEX ix; ALTER TABLE t RENAME TO u; ALTER TABLE u ADD COLUMN z INTEGER DEFAULT 0 NOT NULL; ALTER TABLE u RENAME COLUMN z TO w; ALTER TABLE u DROP COLUMN w",
    ),
    [
      "k6 t TABLE if-exists | DROP TABLE IF EXISTS t",
      "k6 ix INDEX | DROP INDEX ix",
      "k13 t RENAME u | ALTER TABLE t RENAME TO u",
      "k13 u ADD COLUMN  | ALTER TABLE u ADD COLUMN z INTEGER DEFAULT 0 NOT NULL",
      "k13 u columns(z) RENAME COLUMN w | ALTER TABLE u RENAME COLUMN z TO w",
      "k13 u columns(w) DROP COLUMN  | ALTER TABLE u DROP COLUMN w",
    ],
  );
  assertEq(described("EXPLAIN QUERY PLAN SELECT 1"), [
    "k15  explain plan k0 | EXPLAIN QUERY PLAN SELECT 1",
  ]);
  assertEq(described("WITH x AS (SELECT 1) SELECT * FROM x"), [
    "k0  select | WITH x AS (SELECT 1) SELECT * FROM x",
  ]);
  assertEq(described(";;  SELECT 1;;"), ["k0  select | SELECT 1"]);
}

export function test_errors_and_pragma_values() {
  assertEq(described("CREATE TABLE t (a"), ["error at 17: incomplete input"]);
  assertEq(described("DROP SCHEMA x"), ["error at 5: near \"SCHEMA\": syntax error"]);
  assertEq(described("SELECT 1 SELECT 2"), ["error at 9: near \"SELECT\": syntax error"]);
  assertEq(
    described(
      "PRAGMA foreign_keys = ON; PRAGMA journal_mode = DELETE; PRAGMA synchronous = FULL; PRAGMA x = DEFAULT; PRAGMA x = TRUE; PRAGMA x = -5",
    ),
    [
      "k10 foreign_keys = 6:ON0 | PRAGMA foreign_keys = ON",
      "k10 journal_mode = 6:DELETE0 | PRAGMA journal_mode = DELETE",
      "k10 synchronous = 6:FULL0 | PRAGMA synchronous = FULL",
      "k10 x = 6:DEFAULT0 | PRAGMA x = DEFAULT",
      "k10 x = 6:TRUE0 | PRAGMA x = TRUE",
      "k10 x = 1:-5 | PRAGMA x = -5",
    ],
  );
  assertEq(described("PRAGMA x = NULL"), ["error at 11: near \"NULL\": syntax error"]);
  assertEq(described("PRAGMA x = SELECT"), ["error at 11: near \"SELECT\": syntax error"]);
  assertEq(described("INSERT OR BOGUS INTO t VALUES (1)"), [
    "error at 10: near \"BOGUS\": syntax error",
  ]);
  assertEq(described("UPDATE t AS SET a = 1"), ["error at 12: near \"SET\": syntax error"]);
  assertEq(described("UPDATE t AS x SET a = 1"), ["k2 t set a alias x | UPDATE t AS x SET a = 1"]);
  assertEq(described("DROP"), ["error at 4: incomplete input"]);
  assertEq(described("DROP TABLE"), ["error at 10: incomplete input"]);
  assertEq(described("WITH x AS (SELECT ')') SELECT * FROM x"), [
    "k0  select | WITH x AS (SELECT ')') SELECT * FROM x",
  ]);
  assertEq(described("INSERT INTO t VALUES ('(') UNION SELECT 2"), [
    "k1 t select | INSERT INTO t VALUES ('(') UNION SELECT 2",
  ]);
  assertEq(described("CREATE TABLE t (a UNIQUE ON CONFLICT BOGUS)"), [
    "error at 37: near \"BOGUS\": syntax error",
  ]);
}

export function test_explain_once() {
  // EXPLAIN once: SQLite rejects EXPLAIN EXPLAIN (and a long run of them is no recursion).
  assertEq(described("EXPLAIN EXPLAIN SELECT 1"), ["error at 8: near \"EXPLAIN\": syntax error"]);
  assertEq(described("EXPLAIN QUERY PLAN EXPLAIN SELECT 1"), [
    "error at 19: near \"EXPLAIN\": syntax error",
  ]);
  assertEq(described("EXPLAIN " + "EXPLAIN ".repeat(10000) + "SELECT 1"), [
    "error at 8: near \"EXPLAIN\": syntax error",
  ]);
}

export function test_create_table_forms_of_real_schemas() {
  // CREATE TABLE forms of real schemas: MATCH with a join word, a table CHECK with ON CONFLICT,
  // table constraints without commas, CONSTRAINT name alone, string type names, types kept as
  // written, GENERATED ALWAYS out of the type, keywords as names, DEFERRABLE on a column.
  assertEq(
    described(
      "CREATE TABLE r(start, end, offset INT, left 'text', \"right\" 'big' int, b REFERENCES p(a) MATCH FULL ON INSERT CASCADE NOT DEFERRABLE INITIALLY DEFERRED, CHECK (a > 0) ON CONFLICT ABORT PRIMARY KEY (start) UNIQUE (end) CONSTRAINT x FOREIGN KEY (b) REFERENCES p CONSTRAINT y)",
    ),
    [
      "k4 r cols[start:, end:, offset:INT, left:text, right:big, b:] pk(start) uniques 1 checks 1 | CREATE TABLE r(start, end, offset INT, left 'text', \"right\" 'big' int, b REFERENCES p(a) MATCH FULL ON INSERT CASCADE NOT DEFERRABLE INITIALLY DEFERRED, CHECK (a > 0) ON CONFLICT ABORT PRIMARY KEY (start) UNIQUE (end) CONSTRAINT x FOREIGN KEY (b) REFERENCES p CONSTRAINT y)",
    ],
  );
  assertEq(
    described(
      "CREATE TABLE g(a  big   int ( 1 , -2 ), b INT GENERATED ALWAYS AS (a + 1) STORED, c GENERATED ALWAYS AS (1), d INT NOT NULL GENERATED ALWAYS AS (2) VIRTUAL, e DEFERRABLE, f CONSTRAINT z)",
    ),
    [
      "k4 g cols[a:big   int ( 1 , -2 ), b:INT stored, c: virtual, d:INT nn virtual, e:, f:] | CREATE TABLE g(a  big   int ( 1 , -2 ), b INT GENERATED ALWAYS AS (a + 1) STORED, c GENERATED ALWAYS AS (1), d INT NOT NULL GENERATED ALWAYS AS (2) VIRTUAL, e DEFERRABLE, f CONSTRAINT z)",
    ],
  );
  assertEq(
    described(
      "CREATE TABLE d(a DEFAULT -1, b DEFAULT +1.5, c DEFAULT 'x', d DEFAULT x'00', e DEFAULT NULL, f DEFAULT CURRENT_TIME, g DEFAULT (1 + 1), h DEFAULT -'x', i DEFAULT end, j DEFAULT true, k DEFAULT indexed, l DEFAULT \"q\")",
    ),
    [
      "k4 d cols[a: dflt1, b: dflt2, c: dflt3'x, d: dflt4'00, e: dflt0, f: dflt9, g: dflt8, h: dflt7, i: dflt3'end, j: dflt23'true, k: dflt3'indexed, l: dflt3'q] | CREATE TABLE d(a DEFAULT -1, b DEFAULT +1.5, c DEFAULT 'x', d DEFAULT x'00', e DEFAULT NULL, f DEFAULT CURRENT_TIME, g DEFAULT (1 + 1), h DEFAULT -'x', i DEFAULT end, j DEFAULT true, k DEFAULT indexed, l DEFAULT \"q\")",
    ],
  );
  assertEq(described("CREATE TABLE p(a, PRIMARY KEY(a AUTOINCREMENT)) STRICT, WITHOUT ROWID"), [
    "k4 p cols[a: auto] pk(a) without-rowid strict | CREATE TABLE p(a, PRIMARY KEY(a AUTOINCREMENT)) STRICT, WITHOUT ROWID",
  ]);
}

export function test_types_are_dequoted() {
  // Types are dequoted as SQLite does it (the PRAGMA table_info types of sqlite3).
  assertEq(
    described(
      "CREATE TABLE q(a 'big' int, b 'x''y', c \"q\" z, d [x] y, e 'text', f [int], g \"a\"\"b\", h 'ab' 'cd')",
    ),
    [
      "k4 q cols[a:big, b:x'y, c:q, d:x] , e:text, f:int, g:a\"b, h:ab] | CREATE TABLE q(a 'big' int, b 'x''y', c \"q\" z, d [x] y, e 'text', f [int], g \"a\"\"b\", h 'ab' 'cd')",
    ],
  );
}

export function test_create_statements_sqlite_rejects() {
  // What SQLite rejects: a column after a table constraint, foreign key actions, DEFAULT and
  // table options outside the grammar, TEMP INDEX, column lists with COLLATE or ASC.
  assertEq(described("CREATE TABLE p(a, PRIMARY KEY(a), b)"), [
    "error at 34: near \"b\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(PRIMARY KEY(a))"), [
    "error at 15: near \"PRIMARY\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a REFERENCES q ON BOGUS CASCADE)"), [
    "error at 33: near \"BOGUS\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a REFERENCES q ON DELETE BOGUS)"), [
    "error at 40: near \"BOGUS\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a REFERENCES q ON DELETE SET BOGUS)"), [
    "error at 44: near \"BOGUS\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a DEFERRABLE INITIALLY bogus)"), [
    "error at 38: near \"bogus\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a DEFAULT ~1)"), ["error at 25: near \"~\": syntax error"]);
  assertEq(described("CREATE TABLE p(a DEFAULT f(1))"), ["error at 26: near \"(\": syntax error"]);
  assertEq(described("CREATE TABLE p(a DEFAULT x.y)"), ["error at 26: near \".\": syntax error"]);
  assertEq(described("CREATE TABLE p(a DEFAULT - - 1)"), ["error at 27: near \"-\": syntax error"]);
  assertEq(described("CREATE TABLE p(a DEFAULT -x)"), ["error at 26: near \"x\": syntax error"]);
  assertEq(described("CREATE TABLE p(a DEFAULT ?)"), ["error at 25: near \"?\": syntax error"]);
  assertEq(described("CREATE TABLE p(a DEFAULT left)"), [
    "error at 25: near \"left\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a DEFAULT 1 + 1)"), ["error at 27: near \"+\": syntax error"]);
  assertEq(described("CREATE TABLE p(a COLLATE left)"), [
    "error at 25: near \"left\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a) STRICT WITHOUT ROWID"), [
    "error at 25: near \"WITHOUT\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a) STRICT,"), ["error at 25: incomplete input"]);
  assertEq(described("CREATE TABLE p(a) WITHOUT ROWID WITHOUT ROWID"), [
    "error at 32: near \"WITHOUT\": syntax error",
  ]);
  assertEq(described("CREATE TABLE p(a) BOGUS"), ["error at 18: unknown table option: BOGUS"]);
  assertEq(described("CREATE TABLE p(a) WITHOUT left"), [
    "error at 26: unknown table option: left",
  ]);
  assertEq(described("CREATE TABLE p(a) \"strict\""), [
    "error at 18: unknown table option: \"strict\"",
  ]);
  assertEq(described("CREATE TABLE p(a AS (1) bogus)"), [
    "error at 24: error in generated column \"a\"",
  ]);
  assertEq(described("CREATE TABLE p(a, CHECK(a),)"), ["error at 27: near \")\": syntax error"]);
  assertEq(described("CREATE TABLE p(a, FOREIGN KEY (a COLLATE x) REFERENCES q)"), [
    "error at 31: syntax error after column name \"a\"",
  ]);
  assertEq(described("CREATE VIEW v(a DESC) AS SELECT 1"), [
    "error at 14: syntax error after column name \"a\"",
  ]);
  assertEq(described("CREATE INDEX i ON t(a NULLS FIRST)"), [
    "error at 22: unsupported use of NULLS FIRST",
  ]);
  assertEq(described("CREATE TEMP INDEX i ON t(a)"), ["error at 12: near \"INDEX\": syntax error"]);
  assertEq(described("CREATE TEMP UNIQUE INDEX i ON t(a)"), [
    "error at 12: near \"UNIQUE\": syntax error",
  ]);
}

export function test_insert_as_sqlite() {
  // INSERT as SQLite: VALUES rows of one length, no ORDER BY or LIMIT after VALUES, no upsert
  // after DEFAULT VALUES, only the last ON CONFLICT without a target, and ON after a FROM item
  // is a join constraint (SQLite's documented ambiguity; `WHERE true` resolves it).
  assertEq(described("INSERT INTO t VALUES (1, 2), (3)"), [
    "error at 29: all VALUES must have the same number of terms",
  ]);
  assertEq(described("INSERT INTO t VALUES (1) ORDER BY 1"), [
    "error at 25: near \"ORDER\": syntax error",
  ]);
  assertEq(described("INSERT INTO t VALUES (1) LIMIT 1"), [
    "error at 25: near \"LIMIT\": syntax error",
  ]);
  assertEq(described("INSERT INTO t DEFAULT VALUES ON CONFLICT DO NOTHING"), [
    "error at 29: near \"ON\": syntax error",
  ]);
  assertEq(described("INSERT INTO t DEFAULT VALUES RETURNING *"), [
    "k1 t default-values returning 1 | INSERT INTO t DEFAULT VALUES RETURNING *",
  ]);
  assertEq(described("INSERT INTO t VALUES (1) ON CONFLICT DO NOTHING ON CONFLICT DO NOTHING"), [
    "error at 48: near \"ON\": syntax error",
  ]);
  assertEq(
    described(
      "INSERT INTO t VALUES (1) ON CONFLICT DO UPDATE SET a = 1 ON CONFLICT (a) DO NOTHING",
    ),
    ["error at 57: near \"ON\": syntax error"],
  );
  assertEq(
    described("INSERT INTO t VALUES (1) ON CONFLICT (a) DO NOTHING ON CONFLICT DO NOTHING"),
    [
      "k1 t rows 1 upserts nothing; nothing | INSERT INTO t VALUES (1) ON CONFLICT (a) DO NOTHING ON CONFLICT DO NOTHING",
    ],
  );
  assertEq(described("INSERT INTO t SELECT * FROM u ON CONFLICT DO NOTHING"), [
    "error at 42: near \"DO\": syntax error",
  ]);
  assertEq(described("INSERT INTO t SELECT * FROM u WHERE true ON CONFLICT DO NOTHING"), [
    "k1 t select upserts nothing | INSERT INTO t SELECT * FROM u WHERE true ON CONFLICT DO NOTHING",
  ]);
  assertEq(described("INSERT INTO t SELECT 1 ON CONFLICT DO NOTHING"), [
    "k1 t select upserts nothing | INSERT INTO t SELECT 1 ON CONFLICT DO NOTHING",
  ]);
}

export function test_update_and_delete() {
  // UPDATE and DELETE: an alias needs AS; INDEXED BY and NOT INDEXED; RETURNING takes no t.*.
  assertEq(described("UPDATE t x SET a = 1"), ["error at 9: near \"x\": syntax error"]);
  assertEq(
    described(
      "UPDATE t AS x INDEXED BY i SET a = 1; UPDATE t NOT INDEXED SET a = 1; DELETE FROM t INDEXED BY i; DELETE FROM t AS x NOT INDEXED WHERE 1",
    ),
    [
      "k2 t set a indexed-by i alias x | UPDATE t AS x INDEXED BY i SET a = 1",
      "k2 t set a not-indexed | UPDATE t NOT INDEXED SET a = 1",
      "k3 t indexed-by i | DELETE FROM t INDEXED BY i",
      "k3 t where not-indexed alias x | DELETE FROM t AS x NOT INDEXED WHERE 1",
    ],
  );
  assertEq(described("DELETE FROM t x"), ["error at 14: near \"x\": syntax error"]);
  assertEq(described("UPDATE t SET (a, b) = (1, 2), c = 3 FROM u WHERE 1 RETURNING a 'x', *"), [
    "k2 t set a+b,c from 1 where returning 2 | UPDATE t SET (a, b) = (1, 2), c = 3 FROM u WHERE 1 RETURNING a 'x', *",
  ]);
  assertEq(described("DELETE FROM t RETURNING t.*"), [
    "error at 24: RETURNING may not use \"TABLE.*\" wildcards",
  ]);
}

export function test_transaction_names() {
  // Transactions take a name after TRANSACTION.
  assertEq(
    described(
      "BEGIN TRANSACTION a; COMMIT TRANSACTION b; BEGIN DEFERRED TRANSACTION c; END TRANSACTION d; ROLLBACK TRANSACTION e TO SAVEPOINT s",
    ),
    [
      "k7  transaction a | BEGIN TRANSACTION a",
      "k8  transaction b | COMMIT TRANSACTION b",
      "k7  DEFERRED transaction c | BEGIN DEFERRED TRANSACTION c",
      "k8  transaction d | END TRANSACTION d",
      "k9 s transaction e | ROLLBACK TRANSACTION e TO SAVEPOINT s",
    ],
  );
}

export function test_pragma_values() {
  // PRAGMA values: a signed number, a name or string, ON, DELETE or DEFAULT; nothing else.
  assertEq(
    described(
      "PRAGMA a = -2000; PRAGMA b = +2000; PRAGMA c = -2.5; PRAGMA d = 'x'; PRAGMA e = left; PRAGMA f(\"g\")",
    ),
    [
      "k10 a = 1:-2000 | PRAGMA a = -2000",
      "k10 b = 1:2000 | PRAGMA b = +2000",
      "k10 c = 2:0 | PRAGMA c = -2.5",
      "k10 d = 3:0x | PRAGMA d = 'x'",
      "k10 e = 6:LEFT0 | PRAGMA e = left",
      "k10 f = 6:G0 | PRAGMA f(\"g\")",
    ],
  );
  assertEq(described("PRAGMA cache_size = ~2000"), ["error at 20: near \"~\": syntax error"]);
  assertEq(described("PRAGMA cache_size = (2000)"), ["error at 20: near \"(\": syntax error"]);
  assertEq(described("PRAGMA cache_size = x'00'"), ["error at 20: near \"x'00'\": syntax error"]);
  assertEq(described("PRAGMA cache_size = ?"), ["error at 20: near \"?\": syntax error"]);
  assertEq(described("PRAGMA x = - 'a'"), ["error at 13: near \"'a'\": syntax error"]);
  assertEq(described("PRAGMA x = 1_0"), ["error at 11: near \"1_0\": syntax error"]);
}
