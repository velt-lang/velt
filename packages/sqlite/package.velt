import type { Package } from "velt/package";

export const pkg: Package = {
  name: "sqlite",
  version: "0.2.0",
  description: "Embedded SQLite through declare c, and a SQLite engine written in Velt",
  native: {
    c: {
      // memcpy, which copies a text cell into the row's scratch (src/compiled.velt).
      c: { headers: ["<string.h>"] },
      // The real SQLite engine, through `declare c` (src/sqlite3.velt), compiled with the package
      // by the pinned zig. native/ holds sqlite3.c and sqlite3.h unchanged from SQLite 3.53.2,
      // the SQLite rusqlite bundled: https://sqlite.org/2026/sqlite-amalgamation-3530200.zip,
      // SHA3-256 81142986038e18f96c4a54e1a72562ae17e502a916f2a7701eff43388cbf1a40, whose sqlite3.c
      // has the SHA3-256 https://sqlite.org/releaselog/3_53_2.html gives:
      // 44fd61b9f93b4155105cb2d80c957ae6c64a8b5bd6ed51a4992f0dbd438e4e11.
      sqlite3: {
        sources: ["native/sqlite3.c"],
        headers: ["native/sqlite3.h"],
        // The options rusqlite's `bundled` build used (libsqlite3-sys 0.38's build.rs, with the
        // crate's `column_decltype` feature), so the driver keeps what it had.
        defines: {
          SQLITE_CORE: "1",
          SQLITE_DEFAULT_FOREIGN_KEYS: "1",
          SQLITE_ENABLE_API_ARMOR: "1",
          SQLITE_ENABLE_COLUMN_METADATA: "1",
          SQLITE_ENABLE_DBSTAT_VTAB: "1",
          SQLITE_ENABLE_FTS3: "1",
          SQLITE_ENABLE_FTS3_PARENTHESIS: "1",
          SQLITE_ENABLE_FTS5: "1",
          SQLITE_ENABLE_JSON1: "1",
          SQLITE_ENABLE_LOAD_EXTENSION: "1",
          SQLITE_ENABLE_MEMORY_MANAGEMENT: "1",
          SQLITE_ENABLE_RTREE: "1",
          SQLITE_ENABLE_STAT4: "1",
          SQLITE_SOUNDEX: "1",
          // Serialized by default; the driver opens each connection with SQLITE_OPEN_NOMUTEX and
          // keeps one thread in it at a time itself (src/connection.velt).
          SQLITE_THREADSAFE: "1",
          SQLITE_USE_URI: "1",
          HAVE_USLEEP: "1",
          HAVE_ISNAN: "1",
          HAVE_LOCALTIME_R: "1",
          // MinGW's <time.h> declares localtime_r only with this.
          _POSIX_THREAD_SAFE_FUNCTIONS: "1",
        },
      },
    },
    targets: [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
    ],
  },
};
