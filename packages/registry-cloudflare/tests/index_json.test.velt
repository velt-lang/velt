// A package's index as the D1 database holds it. The stores themselves need Cloudflare's bindings,
// so crates/veltc/tests/registry_worker.rs tests them under workerd.

import { describe, expect, it } from "velt/test";
import { IndexEntry, PackageIndex } from "registry-core";
import { indexFromJson } from "../src/index_json";

describe("indexFromJson", () => {
  it("gives back an index with every field of an entry", () => {
    const index = new PackageIndex("lib");
    const full = new IndexEntry("1.0.0", "sha256:aa");
    full.description = `said "hi" på svenska\n`;
    full.keywords = ["one", "two"];
    full.dependencies.set("dep", "^1.2");
    full.dependencies.set("@scope/other", ">=2, <3");
    full.nativeAbi = 7;
    full.native.set("aarch64-apple-darwin", "sha256:bb");
    full.yanked = true;
    index.versions.push(full);
    index.versions.push(new IndexEntry("1.1.0-rc.1", "sha256:cc"));

    const read = indexFromJson("lib", index.toJson());
    expect(read.name).toBe("lib");
    expect(read.toJson()).toBe(index.toJson());
    expect(read.versions[0].nativeAbi).toBe(7);
    expect(read.versions[0].yanked).toBe(true);
    expect(read.versions[0].native.get("aarch64-apple-darwin")).toBe("sha256:bb");
    expect(read.versions[1].description).toBe(null);
    expect(read.versions[1].yanked).toBe(false);
  });

  it("gives back an index with no versions", () => {
    expect(indexFromJson("lib", new PackageIndex("lib").toJson()).versions.length).toBe(0);
  });
});
