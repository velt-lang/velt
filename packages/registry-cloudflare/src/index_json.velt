// registry-cloudflare (internal): a package's index from the JSON `PackageIndex.toJson` writes.

import { IndexEntry, PackageIndex } from "registry-core";

// One version as `index.json` holds it; fields left out when they have no value.
class EntryJson {
  version: string = "";
  checksum: string = "";
  description?: string;
  keywords?: string[];
  dependencies?: Record<string, string>;
  native_abi?: i64;
  native?: Record<string, string>;
  yanked?: bool;
}

class IndexJson {
  versions: EntryJson[] = [];
}

function toMap(record: Record<string, string> | undefined): Map<string, string> {
  const out = new Map<string, string>();
  if (record != undefined) {
    for (const key of Object.keys(record)) {
      out.set(key, record[key] ?? "");
    }
  }
  return out;
}

/** The index of package `name` from `index.json`'s text. */
export function indexFromJson(name: string, text: string): PackageIndex {
  const index = new PackageIndex(name);
  for (const v of JSON.parse<IndexJson>(text).versions) {
    const e = new IndexEntry(v.version, v.checksum);
    e.description = v.description ?? null;
    e.keywords = v.keywords ?? [];
    e.dependencies = toMap(v.dependencies);
    e.nativeAbi = v.native_abi ?? null;
    e.native = toMap(v.native);
    e.yanked = v.yanked ?? false;
    index.versions.push(e);
  }
  return index;
}
