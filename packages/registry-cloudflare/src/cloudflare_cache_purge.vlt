// registry-cloudflare: Cloudflare's cache forgets what a write changed.

import { CachePurge } from "registry-core";
import { purgePaths } from "./purge";
import { storeFailure } from "./stored";

/** Purges through Cloudflare's API; does nothing unless the Worker is given a zone (README). */
export class CloudflareCachePurge implements CachePurge {
  async purge(paths: string[]): Promise<void> {
    try {
      await purgePaths(JSON.stringify(paths));
    } catch (e) {
      throw storeFailure("the cache purge", e);
    }
  }
}
