// registry-cloudflare (internal): the pages of signing in, plain HTML that nothing caches.

/** `text` with HTML's special characters escaped, for an element's content or a quoted value. */
export function escapeHtml(text: string): string {
  let out = "";
  for (const c of text) {
    if (c == "&") {
      out += "&amp;";
    } else if (c == "<") {
      out += "&lt;";
    } else if (c == ">") {
      out += "&gt;";
    } else if (c == '"') {
      out += "&quot;";
    } else if (c == "'") {
      out += "&#39;";
    } else {
      out += c;
    }
  }
  return out;
}

/**
 * A page with `title` and `body` (HTML, its text already escaped), answering `status`. Never
 * cached, as a sign-in page may hold a token, and `cookie`, when given, is set with it.
 */
export function page(
  status: i64,
  title: string,
  body: string,
  cookie: string | null = null,
): Response {
  const html =
    `<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n` +
    `<meta name="viewport" content="width=device-width, initial-scale=1">\n` +
    `<title>${escapeHtml(title)}</title>\n</head>\n<body>\n<h1>${escapeHtml(title)}</h1>\n` +
    `${body}\n</body>\n</html>\n`;
  const headers = new Headers();
  headers.set("content-type", "text/html; charset=utf-8");
  headers.set("cache-control", "no-store");
  headers.set("referrer-policy", "no-referrer");
  headers.set("content-security-policy", "default-src 'none'; frame-ancestors 'none'");
  if (cookie != null) {
    headers.set("set-cookie", cookie);
  }
  return new Response(html, { status: status as f64, headers });
}

/** A page saying sign-in failed, `why` (plain text), with a link to try again. */
export function failed(status: i64, why: string, cookie: string | null = null): Response {
  return page(
    status,
    "Signing in failed",
    `<p>${escapeHtml(why)}</p>\n<p><a href="/login">Try again</a></p>`,
    cookie,
  );
}
