// registry-cloudflare: registry-core's `MetadataDb` in the D1 database: a row per package (its
// revision), per version, per owner, and a search row per package (src/migrations). A commit is
// one batch, which D1 runs as a transaction: every statement in it applies only while the
// package is still at the revision the write read, and the last one raises the revision. So a
// write that lost a race changes nothing, and the handler tries it again.

import { D1Database, D1PreparedStatement, d1Database } from "cloudflare";
import {
  IndexEntry,
  MetadataDb,
  normalizedName,
  PackageChange,
  PackageIndex,
  PackageRecord,
  SearchEntry,
} from "registry-core";
import { entryFromJson } from "./index_json";
import { storeFailure } from "./stored";

struct RevisionRow {
  revision: i64;
}

struct EntryRow {
  entry_json: string;
}

struct NameRow {
  name: string;
}

struct UserRow {
  user: string;
}

struct SearchRow {
  package: string;
  entry_json: string;
}

/** The registry's packages in the D1 database bound as `binding`. */
export class D1MetadataDb implements MetadataDb {
  private db: D1Database;

  constructor(binding: string) {
    this.db = d1Database(binding);
  }

  async record(name: string): Promise<PackageRecord | null> {
    try {
      // One round trip: a batch reads all three in one transaction, so they agree.
      const [revision, versions, owners] = await this.db.batch([
        this.db.prepare("SELECT revision FROM packages WHERE name = ?").bind(name),
        this.db
          .prepare("SELECT entry_json FROM versions WHERE package = ? ORDER BY position")
          .bind(name),
        this.db.prepare("SELECT user FROM owners WHERE package = ? ORDER BY position").bind(name),
      ]);
      const rows = revision.results<RevisionRow>();
      if (rows.length == 0) {
        return null;
      }
      const index = new PackageIndex(name);
      for (const row of versions.results<EntryRow>()) {
        index.versions.push(entryFromJson(row.entry_json));
      }
      const users = owners.results<UserRow>().map((r: UserRow): string => r.user);
      return new PackageRecord(index, users, rows[0].revision);
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }

  async revision(name: string): Promise<i64> {
    try {
      const row = await this.db
        .prepare("SELECT revision FROM packages WHERE name = ?")
        .bind(name)
        .first<RevisionRow>();
      return row?.revision ?? 0;
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }

  async commit(change: PackageChange): Promise<bool> {
    const name = change.name;
    // Whether the package is still as the write read it: at its revision, or for a new name, no
    // package (of this name or another spelling of it).
    const isNew = change.base == 0;
    const guard =
      isNew
        ? "NOT EXISTS (SELECT 1 FROM packages WHERE normalized = ?)"
        : "(SELECT revision FROM packages WHERE name = ?) = ?";
    const guardOf = (
      statement: D1PreparedStatement,
      ...values: (string | f64)[],
    ): D1PreparedStatement =>
      isNew
        ? statement.bind(...values, normalizedName(name))
        : statement.bind(...values, name, change.base as f64);
    const statements: D1PreparedStatement[] = [];
    for (const e of change.changed) {
      const position = change.index.versions.findIndex(
        (v: IndexEntry): bool => v.version == e.version,
      );
      statements.push(
        guardOf(
          this.db.prepare(
            `INSERT INTO versions (package, version, position, entry_json) SELECT ?, ?, ?, ? WHERE ${guard} ` +
              "ON CONFLICT (package, version) DO UPDATE SET entry_json = excluded.entry_json",
          ),
          name,
          e.version,
          position as f64,
          e.toJson(0),
        ),
      );
    }
    const owners = change.owners;
    if (owners != null) {
      statements.push(
        guardOf(this.db.prepare(`DELETE FROM owners WHERE package = ? AND ${guard}`), name),
      );
      for (let i: i64 = 0; i < owners.length; i++) {
        statements.push(
          guardOf(
            this.db.prepare(
              `INSERT INTO owners (package, position, user) SELECT ?, ?, ? WHERE ${guard}`,
            ),
            name,
            i as f64,
            owners[i],
          ),
        );
      }
    }
    const shown = change.index.newest();
    statements.push(
      shown == null
        ? guardOf(this.db.prepare(`DELETE FROM search WHERE package = ? AND ${guard}`), name)
        : guardOf(
          this.db.prepare(
            `INSERT INTO search (package, entry_json) SELECT ?, ? WHERE ${guard} ` +
              "ON CONFLICT (package) DO UPDATE SET entry_json = excluded.entry_json",
          ),
          name,
          shown.toJson(0),
        ),
    );
    // Last, so the guards above saw the revision as it was: one row changed means the write won.
    // D1 runs a batch as one transaction, and a database one transaction at a time, so the guards
    // and this statement see the same state: when the guards held, nothing can have taken the name
    // or the revision before this statement, and it changes its row; when they didn't, every
    // statement above changed nothing either, and so does this one.
    statements.push(
      isNew
        ? this.db
          .prepare(
            "INSERT INTO packages (name, normalized, revision) VALUES (?, ?, 1) ON CONFLICT DO NOTHING",
          )
          .bind(name, normalizedName(name))
        : this.db
          .prepare("UPDATE packages SET revision = ? WHERE name = ? AND revision = ?")
          .bind((change.base + 1) as f64, name, change.base as f64),
    );
    try {
      const results = await this.db.batch(statements);
      return results[results.length - 1].meta.changes == 1;
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }

  async spelling(normalized: string): Promise<string | null> {
    try {
      const row = await this.db
        .prepare("SELECT name FROM packages WHERE normalized = ?")
        .bind(normalized)
        .first<NameRow>();
      return row?.name ?? null;
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }

  async packageNames(): Promise<string[]> {
    try {
      const rows = await this.db.prepare("SELECT name FROM packages").all<NameRow>();
      return rows.results.map((r: NameRow): string => r.name);
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }

  /** Every package's search row: the handler ranks them, and full-text search can narrow this. */
  async searchCandidates(terms: string[]): Promise<SearchEntry[]> {
    try {
      const rows = await this.db.prepare("SELECT package, entry_json FROM search").all<SearchRow>();
      return rows.results.map(
        (r: SearchRow): SearchEntry => new SearchEntry(r.package, entryFromJson(r.entry_json)),
      );
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }
}
