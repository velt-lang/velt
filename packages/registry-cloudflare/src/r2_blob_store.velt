// registry-cloudflare: the registry's static files in an R2 bucket, with the HTTP headers a public
// bucket serves them with: archives cached for good (their key is their checksum), each index
// briefly (it changes, and a write purges it). An index's revision is in its custom metadata, and
// it is replaced only over the object read: its etag and its upload time (`StoredFile.tag`).

import { R2Bucket, R2Conditional, R2HTTPMetadata, r2Bucket } from "cloudflare";
import { BlobStore, StoredFile } from "registry-core";
import { storeFailure } from "./stored";

/** The custom metadata holding the revision a file was written from. */
const REVISION = "revision";

/** How long a cache may keep a package's index, in seconds. */
const INDEX_MAX_AGE = 60;

// The headers file `key` is served with.
function headersOf(key: string): R2HTTPMetadata {
  if (key.startsWith("index/")) {
    return { contentType: "application/json", cacheControl: `public, max-age=${INDEX_MAX_AGE}` };
  }
  return {
    contentType: "application/octet-stream",
    cacheControl: "public, max-age=31536000, immutable",
  };
}

/** Static files in the R2 bucket bound as `binding`, under their keys as they are. */
export class R2BlobStore implements BlobStore {
  private bucket: R2Bucket;

  constructor(binding: string) {
    this.bucket = r2Bucket(binding);
  }

  async putIfAbsent(key: string, bytes: u8[]): Promise<bool> {
    try {
      // Null when a file is there already.
      const put = await this.bucket.put(key, bytes, {
        onlyIf: { etagDoesNotMatch: "*" },
        httpMetadata: headersOf(key),
      });
      return put != null;
    } catch (e) {
      throw storeFailure("the blob store", e);
    }
  }

  async head(key: string): Promise<StoredFile | null> {
    try {
      const object = await this.bucket.head(key);
      if (object == null) {
        return null;
      }
      const revision = parseInt(object.customMetadata[REVISION] ?? "0");
      const tag = `${object.etag} ${object.uploaded.getTime()}`;
      return new StoredFile(tag, Number.isNaN(revision) ? 0 : revision as i64);
    } catch (e) {
      throw storeFailure("the blob store", e);
    }
  }

  async putIfTag(key: string, bytes: u8[], revision: i64, tag: string | null): Promise<bool> {
    try {
      // Null when the object there isn't the one read, or, for no tag, when there is one. An etag
      // is the MD5 of the bytes, so the same index written again (a yank, then an unyank) has the
      // same etag: the upload time tells the object read from that newer one.
      let onlyIf: R2Conditional = { etagDoesNotMatch: "*" };
      if (tag != null) {
        const space = tag.lastIndexOf(" ");
        const uploaded = parseFloat(tag.slice(space + 1));
        onlyIf = { etagMatches: tag.slice(0, space), uploadedBefore: new Date(uploaded + 1) };
      }
      const put = await this.bucket.put(key, bytes, {
        onlyIf,
        httpMetadata: headersOf(key),
        customMetadata: { [REVISION]: `${revision}` },
      });
      return put != null;
    } catch (e) {
      throw storeFailure("the blob store", e);
    }
  }

  async get(key: string): Promise<u8[] | null> {
    try {
      const object = await this.bucket.get(key);
      return object == null ? null : await object.bytes();
    } catch (e) {
      throw storeFailure("the blob store", e);
    }
  }
}
