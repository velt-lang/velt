// registry-cloudflare: the names the public registry keeps back, in the D1 database's
// `reserved_names` (src/migrations). An administrator approves someone for one by setting its
// `holder` (README "Reserved names").

import { D1Database, d1Database } from "cloudflare";
import { NameReservations, Reservation } from "registry-core";
import { storeFailure } from "./stored";

/** Where a reserved name is asked for: a new issue, its title and form filled in. */
const REQUEST_URL = "https://github.com/velt-lang/velt/issues/new";

struct ReservationRow {
  key: string;
  reason: string;
  holder: string | null;
}

/** Reserved names and scopes in the D1 database bound as `binding`. */
export class D1NameReservations implements NameReservations {
  private db: D1Database;

  constructor(binding: string) {
    this.db = d1Database(binding);
  }

  async reservation(key: string): Promise<Reservation | null> {
    try {
      const row = await this.db
        .prepare("SELECT key, reason, holder FROM reserved_names WHERE key = ?")
        .bind(key)
        .first<ReservationRow>();
      return row == null ? null : new Reservation(row.key, row.reason, row.holder);
    } catch (e) {
      throw storeFailure("the database", e);
    }
  }

  howToRequest(name: string): string {
    const title = encodeURIComponent(`Registry: request the reserved name ${name}`);
    const body = encodeURIComponent(
      `Name: ${name}\nMy registry user name (sign in once at the registry first):\nWhy it's mine (a link to the project, and my part in it):\n`,
    );
    return `${REQUEST_URL}?title=${title}&body=${body}`;
  }
}
