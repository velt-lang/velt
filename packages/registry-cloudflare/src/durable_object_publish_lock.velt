// registry-cloudflare: one Durable Object per package (the class `RegistryLock`, src/worker.mjs)
// serializes the writes to it.

import { DurableObjectNamespace, durableObjectNamespace } from "cloudflare";
import { HeldLock, PublishLock, StoreError } from "registry-core";
import { HeldDurableLock } from "./held_durable_lock";
import { storeFailure } from "./stored";

// Long enough that a holder that died has lost the lock (its lease is a minute).
const GIVE_UP_MS: i64 = 90_000;
const FIRST_WAIT_MS: i64 = 20;
const LONGEST_WAIT_MS: i64 = 1_000;

/** Locks in the Durable Object namespace bound as `binding`. */
export class DurableObjectPublishLock implements PublishLock {
  private locks: DurableObjectNamespace;

  constructor(binding: string) {
    this.locks = durableObjectNamespace(binding);
  }

  /** Asks its object until it holds the lock, and throws `StoreError` after a minute and a half. */
  async acquire(key: string): Promise<HeldLock> {
    try {
      const stub = this.locks.get(this.locks.idFromName(key));
      const start = Date.now();
      let wait = FIRST_WAIT_MS;
      while (Date.now() - start < GIVE_UP_MS) {
        const res = await stub.fetch("https://lock/acquire", { method: "POST" });
        if (res.ok) {
          return new HeldDurableLock(stub, await res.text());
        }
        if (res.status != 409) {
          throw new StoreError(`it answered ${res.status}`);
        }
        await sleep(wait);
        wait = wait * 2 < LONGEST_WAIT_MS ? wait * 2 : LONGEST_WAIT_MS;
      }
    } catch (e) {
      throw storeFailure("taking the lock", e);
    }
    throw new StoreError("the package is busy: try again");
  }
}
