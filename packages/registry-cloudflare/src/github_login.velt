// registry-cloudflare: signing in with GitHub (#1740). `GET /login` sends the browser to GitHub
// with a random `state`, also kept in a cookie; `GET /login/callback` checks the two match, has
// src/github.mjs turn GitHub's code into the account's id and login, and shows a new token once,
// to paste into `velt login`. A user is bound to their GitHub account's id at the first sign-in
// and named after its login in lowercase; the name stays when the account is renamed.

import { D1Database, d1Database } from "cloudflare";
import { checkUserName, tokenHash } from "registry-core";
import { authorizeUrl, githubAccount, randomHex } from "./github";
import { escapeHtml, failed, page } from "./login_page";

/** The cookie holding a sign-in's `state` until GitHub sends the browser back. */
const STATE_COOKIE = "__Host-velt_login_state";
/** How long a sign-in may take, in seconds. */
const STATE_SECONDS = 600;
/** The bytes of randomness in a `state` and in a token. */
const STATE_BYTES = 16;
const TOKEN_BYTES = 32;

struct GitHubAccount {
  id: i64;
  login: string;
}

struct NameRow {
  name: string;
}

// The value of cookie `name` in a `Cookie` header, or null.
function cookieValue(header: string | null, name: string): string | null {
  if (header == null) {
    return null;
  }
  for (const part of header.split(";")) {
    const pair = part.trim();
    if (pair.startsWith(`${name}=`)) {
      return pair.slice(name.length + 1);
    }
  }
  return null;
}

// Whether `a` and `b` are the same text. Texts of one length take as long whatever their first
// difference; a length that differs answers at once, as a state's length (32) is no secret.
function sameText(a: string, b: string): bool {
  if (a.length != b.length) {
    return false;
  }
  let diff = 0;
  for (let i = 0; i < a.length; i++) {
    diff |= a.charCodeAt(i) ^ b.charCodeAt(i);
  }
  return diff == 0;
}

// The `Set-Cookie` value keeping `state` for a sign-in, or ending it (`state` empty).
function stateCookie(state: string): string {
  const age = state.length == 0 ? 0 : STATE_SECONDS;
  return `${STATE_COOKIE}=${state}; Path=/; Max-Age=${age}; HttpOnly; Secure; SameSite=Lax`;
}

/** Signs users in with GitHub, keeping users and tokens in the D1 database bound as `binding`. */
export class GitHubLogin {
  private db: D1Database;

  constructor(binding: string) {
    this.db = d1Database(binding);
  }

  /** Whether `req` is one of signing in's (`GET /login` or `GET /login/callback`). */
  handles(req: Request): bool {
    const path = new URL(req.url).pathname;
    return req.method == "GET" && (path == "/login" || path == "/login/callback");
  }

  /** Answers one of signing in's requests. */
  async handle(req: Request): Promise<Response> {
    const url = new URL(req.url);
    return url.pathname == "/login" ? await this.start() : await this.callback(req, url);
  }

  // Sends the browser to GitHub.
  private async start(): Promise<Response> {
    const state = randomHex(STATE_BYTES);
    let to = "";
    try {
      to = await authorizeUrl(state);
    } catch (e) {
      console.error(`signing in failed: ${e.message}`);
      return failed(500, "Signing in with GitHub isn't set up on this registry.");
    }
    const headers = new Headers();
    headers.set("location", to);
    headers.set("set-cookie", stateCookie(state));
    headers.set("cache-control", "no-store");
    return new Response(null, { status: 302, headers });
  }

  // Back from GitHub: checks the state, then signs the account in.
  private async callback(req: Request, url: URL): Promise<Response> {
    const end = stateCookie("");
    const q = url.searchParams;
    // The state first: only a sign-in that started here is answered about, so no other site can
    // put its words on this page (GitHub sends the state with its errors too).
    const expected = cookieValue(req.headers.get("cookie"), STATE_COOKIE);
    const state = q.get("state");
    if (expected == null || expected.length == 0 || state == null || !sameText(state, expected)) {
      return failed(
        400,
        "This sign-in didn't start here, or took longer than 10 minutes. Start again.",
        end,
      );
    }
    const error = q.get("error");
    if (error != null) {
      // Not GitHub's text, which the URL carries: a fixed message.
      const why =
        error == "access_denied"
          ? "You cancelled signing in on GitHub."
          : "GitHub didn't sign you in.";
      return failed(400, why, end);
    }
    const code = q.get("code");
    if (code == null || code.length == 0) {
      return failed(400, "GitHub sent no code. Start again.", end);
    }
    let account: GitHubAccount = { id: 0, login: "" };
    try {
      account = JSON.parse<GitHubAccount>(await githubAccount(code));
    } catch (e) {
      console.error(`signing in failed: ${e.message}`);
      return failed(502, "GitHub didn't confirm the sign-in. Start again.", end);
    }
    try {
      return await this.signIn(account, url.origin, end);
    } catch (e) {
      console.error(`signing in failed: ${e.message}`);
      return failed(500, "The registry couldn't sign you in. Try again later.", end);
    }
  }

  // The user bound to `account`, binding a new one first: null, with `refusal` set, when its
  // login can't be a user's name here.
  private async userOf(account: GitHubAccount): Promise<[string | null, string]> {
    const bound = await this.boundUser(account.id);
    if (bound != null) {
      return [bound, ""];
    }
    const name = account.login.toLowerCase();
    const problem = checkUserName(name);
    if (problem != null) {
      return [null, `The GitHub login \`${account.login}\` can't be a user name here: ${problem}.`];
    }
    // Two first sign-ins of one account at once bind it once; a name held by another account
    // stays theirs.
    await this.db
      .prepare("INSERT INTO users (name, github_id) VALUES (?, ?) ON CONFLICT DO NOTHING")
      .bind(name, account.id as f64)
      .run();
    const now = await this.boundUser(account.id);
    if (now == null) {
      return [null, `The user name \`${name}\` belongs to someone else on this registry.`];
    }
    return [now, ""];
  }

  // The name of the user bound to GitHub account `id`, or null.
  private async boundUser(id: i64): Promise<string | null> {
    const row = await this.db
      .prepare("SELECT name FROM users WHERE github_id = ?")
      .bind(id as f64)
      .first<NameRow>();
    return row == null ? null : row.name;
  }

  // Signs `account` in: a new token for its user, shown once.
  private async signIn(account: GitHubAccount, origin: string, end: string): Promise<Response> {
    const [user, refusal] = await this.userOf(account);
    if (user == null) {
      return failed(403, refusal, end);
    }
    const token = `velt_${randomHex(TOKEN_BYTES)}`;
    await this.db
      .prepare("INSERT INTO tokens (token_hash, user, created) VALUES (?, ?, ?)")
      .bind(tokenHash(token), user, Date.now())
      .run();
    const body =
      `<p>You're signed in as <strong>${escapeHtml(user)}</strong>. Your new token, shown only ` +
      `this once:</p>\n<pre id="token">${token}</pre>\n<p>Run <code>velt login ` +
      `${escapeHtml(origin)}</code> and paste it. Your earlier tokens still work.</p>`;
    return page(200, "Signed in", body, end);
  }
}
