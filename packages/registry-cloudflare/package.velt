import type { Package } from "velt/package";

export const pkg: Package = {
  name: "registry-cloudflare",
  version: "0.1.0",
  description:
    "The Velt package registry on Cloudflare Workers: registry-core over R2 and D1, with GitHub sign-in",
  dependencies: {
    cloudflare: { path: "../cloudflare" },
    "http-server": { path: "../http-server" },
    "registry-core": { path: "../registry-core" },
  },
  // The JavaScript of the host modules: the cache purge (src/purge.velt declares its function),
  // and signing in with GitHub (src/github.velt).
  hostModules: {
    "registry-cloudflare": "./src/purge.mjs",
    "registry-cloudflare-github": "./src/github.mjs",
  },
  // Its own host, not host-cloudflare, for the files a deployment needs: wrangler.toml with the
  // registry's bindings, and the database's schema.
  host: {
    target: "wasm32-unknown-unknown",
    condition: "workers",
    entry: "./src/worker.mjs",
    scaffold: {
      "wrangler.toml": "./src/wrangler.toml",
      "migrations/0001_init.sql": "./src/migrations/0001_init.sql",
      "migrations/0002_reserved_names.sql": "./src/migrations/0002_reserved_names.sql",
    },
  },
};
