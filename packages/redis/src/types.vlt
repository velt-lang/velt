// redis (internal): the plain data types of the API: options and a sorted-set member.

/** `connect` options. */
export struct RedisConnectOptions {
  /** Extra trusted CA certificates (PEM) for `rediss://`, e.g. a private or test CA. */
  ca?: string;
}

/**
 * `set` options: expiry in seconds (`ex`) or milliseconds (`px`); set only if the key does not
 * exist (`nx`) or only if it does (`xx`).
 */
export struct SetOptions {
  ex?: number;
  px?: number;
  nx?: bool;
  xx?: bool;
}

/** A sorted-set member with its score. */
export struct ZMember {
  member: string;
  score: f64;
}
