// redis (internal): `RedisError`, the package's error.

import { Failure } from "./failure";

/**
 * A failed Redis operation. `code` is the server's error code for error replies ("ERR",
 * "WRONGTYPE", "NOAUTH", "WRONGPASS", "EXECABORT", …) or a Node-style I/O code for connection
 * failures ("ECONNREFUSED", "ECONNRESET", "ETIMEDOUT", "EINVAL" for a bad URL or argument).
 */
export class RedisError extends Error {
  code: string;

  constructor(code: string, message: string) {
    super(message);
    this.code = code;
  }
}

/** The error for a closed client or subscriber. */
export function closedHandle(): RedisError {
  return new RedisError("EBADF", "handle is closed");
}

/** `f` as an error to throw. */
export function errorOf(f: Failure): RedisError {
  return new RedisError(f.code, f.message);
}
