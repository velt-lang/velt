// redis (internal): `RedisSubscriber`, a connection in subscribed mode, and `subscribe` /
// `psubscribe`, which open one.
//
// A subscriber owns its own connection in subscribed mode. Messages are pulled with `next()` or
// `for await (const m of sub)` (the runtime stores no callbacks). `close()` (from any task)
// makes pending and later `next()` calls return null, which ends a `for await` loop.

import { IoStatus } from "velt/native";
import {
  velt_redis__sub_change,
  velt_redis__sub_close,
  velt_redis__sub_next,
  velt_redis__subscribe,
} from "./native";
import { RedisError, redisError } from "./errors";
import { RedisMessage } from "./message";
import { RedisClient } from "./client";
import { RedisConnectOptions } from "./types";

function check(s: IoStatus) {
  if (s.code != 0) {
    throw redisError(s.code, s.message);
  }
}

/** A subscribed connection (a Copy handle like `RedisClient`; release it with `close()`). */
export struct RedisSubscriber implements AsyncIterable<RedisMessage, RedisError> {
  private handle: u64;

  /**
   * The package's own: subscribes on a new connection to `url` (or to where client handle
   * `client` is connected, when non-zero).
   */
  static async open(
    client: u64,
    url: string,
    ca: string,
    names: string[],
    patterns: bool,
  ): Promise<RedisSubscriber> {
    const r = await velt_redis__subscribe(client, url, ca, names, patterns);
    if (r.code != 0) {
      throw redisError(r.code, r.message);
    }
    return RedisSubscriber { handle: r.value };
  }

  /**
   * The next message; null once `close()` was called. Throws `RedisError` ("ECONNRESET") if
   * the server closes the connection.
   */
  async next(): Promise<RedisMessage | null> {
    const r = await velt_redis__sub_next(this.handle);
    if (r.code != 0) {
      throw redisError(r.code, r.message);
    }
    const m = r.value;
    if (m.kind == 0) {
      return null;
    }
    return new RedisMessage(m.channel, m.message, m.kind == 2 ? m.pattern : null);
  }

  /**
   * `for await (const m of sub)`: the messages until `close()` is called. Leaving the loop
   * early keeps the subscription (call `close()` to end it).
   */
  async *[Symbol.asyncIterator](): AsyncIterator<RedisMessage, RedisError> {
    while (true) {
      const m = await this.next();
      if (m == null) {
        return;
      }
      yield m;
    }
  }

  /** Also listens to `channels`; resolves once the server confirmed them. */
  async subscribe(channels: string[]): Promise<void> {
    check(await velt_redis__sub_change(this.handle, channels, false, true));
  }

  /** Stops listening to `channels` (an empty list does nothing; use `close()` to stop entirely). */
  async unsubscribe(channels: string[]): Promise<void> {
    check(await velt_redis__sub_change(this.handle, channels, false, false));
  }

  /** Also listens to channels matching the glob `patterns`. */
  async psubscribe(patterns: string[]): Promise<void> {
    check(await velt_redis__sub_change(this.handle, patterns, true, true));
  }

  /** Stops listening to `patterns`. */
  async punsubscribe(patterns: string[]): Promise<void> {
    check(await velt_redis__sub_change(this.handle, patterns, true, false));
  }

  /**
   * Ends the subscription: `next()` returns null, the connection closes, and the handle is
   * released. Closing again does nothing.
   */
  close() {
    velt_redis__sub_close(this.handle);
  }
}

/**
 * Subscribes to `channels` on a new connection to `target` (a URL, or the server a client is
 * connected to); resolves once the server confirmed the subscriptions.
 */
export async function subscribe(
  target: string | RedisClient,
  channels: string[],
  opts: RedisConnectOptions = {},
): Promise<RedisSubscriber> {
  if (typeof target === "string") {
    return await RedisSubscriber.open(0, target, opts.ca ?? "", channels, false);
  }
  return await target.newSubscriber(channels);
}

/** Like `subscribe`, for channels matching glob `patterns` (`news.*`). */
export async function psubscribe(
  target: string | RedisClient,
  patterns: string[],
  opts: RedisConnectOptions = {},
): Promise<RedisSubscriber> {
  if (typeof target === "string") {
    return await RedisSubscriber.open(0, target, opts.ca ?? "", patterns, true);
  }
  return await target.newSubscriber(patterns, true);
}
