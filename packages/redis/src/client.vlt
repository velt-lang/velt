// redis (internal): `RedisClient`, a multiplexed connection, and `connect`, which opens one.
//
// `RedisClient` is a Copy handle like velt/net's `TcpStream` (async methods take `this` by copy,
// so it can be used from many tasks at once), released by `close()`. Commands that take several
// keys or values take a `string[]`: `del(["a", "b"])`.

import { IoResult } from "velt/native";
import {
  velt_redis__close,
  velt_redis__command,
  velt_redis__connect,
  velt_redis__duplicate,
  RawReply,
} from "./native";
import { checkReply, redisError } from "./errors";
import {
  parseScore,
  RedisReply,
  replyInt,
  replyMap,
  replyNullableStrings,
  replyStrings,
  replyText,
  replyTree,
  scoreArg,
} from "./reply";
import { RedisPipeline } from "./pipeline";
import { RedisSubscriber } from "./subscriber";
import { RedisConnectOptions, SetOptions, ZMember } from "./types";
import { setArgs, withPairs } from "./args";

function unwrapHandle(r: IoResult<u64>): u64 {
  if (r.code != 0) {
    throw redisError(r.code, r.message);
  }
  return r.value;
}

async function run(handle: u64, args: string[]): Promise<RawReply> {
  return checkReply(await velt_redis__command(handle, args));
}

/** A connection (a Copy handle; see the module header). */
export struct RedisClient {
  private handle: u64;

  /** Connects to `url`: what `connect(url, opts)` does. */
  static async connect(url: string, opts: RedisConnectOptions = {}): Promise<RedisClient> {
    return RedisClient { handle: unwrapHandle(await velt_redis__connect(url, opts.ca ?? "")) };
  }

  /** Runs any command (`args[0]` is its name) and returns the decoded reply. */
  async call(args: string[]): Promise<RedisReply> {
    return replyTree(await run(this.handle, args));
  }

  /** "PONG". */
  async ping(): Promise<string> {
    return replyText(await run(this.handle, ["PING"])) ?? "";
  }

  // --- Strings and keys ---

  /** The value of `key`, or null if it does not exist. */
  async get(key: string): Promise<string | null> {
    return replyText(await run(this.handle, ["GET", key]));
  }

  /** Sets `key`; false if `nx` / `xx` prevented it. */
  async set(key: string, value: string, opts: SetOptions = {}): Promise<bool> {
    return replyText(await run(this.handle, setArgs(key, value, opts))) != null;
  }

  /** Deletes keys; the number that existed. */
  async del(keys: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["DEL", ...keys]));
  }

  /** How many of `keys` exist (a key listed twice counts twice). */
  async exists(keys: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["EXISTS", ...keys]));
  }

  /** Sets a time to live in seconds; false if the key does not exist. */
  async expire(key: string, seconds: i64): Promise<bool> {
    return replyInt(await run(this.handle, ["EXPIRE", key, `${seconds}`])) == 1;
  }

  /** Sets a time to live in milliseconds; false if the key does not exist. */
  async pexpire(key: string, ms: i64): Promise<bool> {
    return replyInt(await run(this.handle, ["PEXPIRE", key, `${ms}`])) == 1;
  }

  /** Seconds to live; -1 without expiry, -2 if the key does not exist. */
  async ttl(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["TTL", key]));
  }

  /** Milliseconds to live; -1 without expiry, -2 if the key does not exist. */
  async pttl(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["PTTL", key]));
  }

  /** Removes the expiry; false if there was none or the key does not exist. */
  async persist(key: string): Promise<bool> {
    return replyInt(await run(this.handle, ["PERSIST", key])) == 1;
  }

  async incr(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["INCR", key]));
  }

  async incrBy(key: string, n: i64): Promise<i64> {
    return replyInt(await run(this.handle, ["INCRBY", key, `${n}`]));
  }

  async decr(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["DECR", key]));
  }

  async decrBy(key: string, n: i64): Promise<i64> {
    return replyInt(await run(this.handle, ["DECRBY", key, `${n}`]));
  }

  /** The values of `keys` (null for missing ones). */
  async mget(keys: string[]): Promise<(string | null)[]> {
    return replyNullableStrings(await run(this.handle, ["MGET", ...keys]));
  }

  /** Sets every key of `entries`. */
  async mset(entries: Map<string, string>): Promise<void> {
    await run(this.handle, withPairs(["MSET"], entries));
  }

  /** Keys matching a glob pattern (KEYS: fine for tests and small databases). */
  async keys(pattern: string): Promise<string[]> {
    return replyStrings(await run(this.handle, ["KEYS", pattern]));
  }

  // --- Hashes ---

  async hget(key: string, field: string): Promise<string | null> {
    return replyText(await run(this.handle, ["HGET", key, field]));
  }

  /** Sets one field; 1 if it is new, 0 if it was updated. */
  async hset(key: string, field: string, value: string): Promise<i64> {
    return replyInt(await run(this.handle, ["HSET", key, field, value]));
  }

  /** Sets every field of `fields`; the number of new fields. */
  async hmset(key: string, fields: Map<string, string>): Promise<i64> {
    return replyInt(await run(this.handle, withPairs(["HSET", key], fields)));
  }

  /** Every field and value (an empty map if the key does not exist). */
  async hgetall(key: string): Promise<Map<string, string>> {
    return replyMap(await run(this.handle, ["HGETALL", key]));
  }

  /** Deletes fields; the number removed. */
  async hdel(key: string, fields: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["HDEL", key, ...fields]));
  }

  async hincrBy(key: string, field: string, n: i64): Promise<i64> {
    return replyInt(await run(this.handle, ["HINCRBY", key, field, `${n}`]));
  }

  async hlen(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["HLEN", key]));
  }

  // --- Lists ---

  /** Prepends `values` (the last one ends up first); the new length. */
  async lpush(key: string, values: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["LPUSH", key, ...values]));
  }

  /** Appends `values`; the new length. */
  async rpush(key: string, values: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["RPUSH", key, ...values]));
  }

  async lpop(key: string): Promise<string | null> {
    return replyText(await run(this.handle, ["LPOP", key]));
  }

  async rpop(key: string): Promise<string | null> {
    return replyText(await run(this.handle, ["RPOP", key]));
  }

  /** Elements `start..=stop` (negative indexes count from the end: `lrange(k, 0, -1)` is all). */
  async lrange(key: string, start: i64, stop: i64): Promise<string[]> {
    return replyStrings(await run(this.handle, ["LRANGE", key, `${start}`, `${stop}`]));
  }

  async llen(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["LLEN", key]));
  }

  // --- Sets ---

  /** Adds members; the number that were new. */
  async sadd(key: string, members: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["SADD", key, ...members]));
  }

  /** Removes members; the number that were there. */
  async srem(key: string, members: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["SREM", key, ...members]));
  }

  /** Every member (unordered). */
  async smembers(key: string): Promise<string[]> {
    return replyStrings(await run(this.handle, ["SMEMBERS", key]));
  }

  async sismember(key: string, member: string): Promise<bool> {
    return replyInt(await run(this.handle, ["SISMEMBER", key, member])) == 1;
  }

  async scard(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["SCARD", key]));
  }

  // --- Sorted sets ---

  /** Adds members or updates their scores; the number of new members. */
  async zadd(key: string, members: ZMember[]): Promise<i64> {
    const args = ["ZADD", key];
    for (const m of members) {
      args.push(scoreArg(m.score));
      args.push(m.member);
    }
    return replyInt(await run(this.handle, args));
  }

  /** Members by rank `start..=stop`, lowest score first (negative ranks count from the end). */
  async zrange(key: string, start: i64, stop: i64): Promise<string[]> {
    return replyStrings(await run(this.handle, ["ZRANGE", key, `${start}`, `${stop}`]));
  }

  /** Like `zrange`, with the scores. */
  async zrangeWithScores(key: string, start: i64, stop: i64): Promise<ZMember[]> {
    const xs = replyStrings(
      await run(this.handle, ["ZRANGE", key, `${start}`, `${stop}`, "WITHSCORES"]),
    );
    const out: ZMember[] = [];
    out.reserve((xs.length as usize) / 2);
    for (let i: usize = 0; i + 1 < xs.length; i += 2) {
      out.push(ZMember { member: xs[i], score: parseScore(xs[i + 1]) });
    }
    return out;
  }

  /** The member's score, or null if it is not in the set. */
  async zscore(key: string, member: string): Promise<f64 | null> {
    const s = replyText(await run(this.handle, ["ZSCORE", key, member]));
    if (s == null) {
      return null;
    }
    return parseScore(s);
  }

  /** Removes members; the number that were there. */
  async zrem(key: string, members: string[]): Promise<i64> {
    return replyInt(await run(this.handle, ["ZREM", key, ...members]));
  }

  /** Adds `increment` to the member's score (adding the member if needed); the new score. */
  async zincrby(key: string, increment: f64, member: string): Promise<f64> {
    const s = replyText(await run(this.handle, ["ZINCRBY", key, scoreArg(increment), member]));
    return parseScore(s ?? "");
  }

  async zcard(key: string): Promise<i64> {
    return replyInt(await run(this.handle, ["ZCARD", key]));
  }

  // --- Pub/sub, pipelines, connections ---

  /** Publishes a message; the number of subscribers that received it. */
  async publish(channel: string, message: string): Promise<i64> {
    return replyInt(await run(this.handle, ["PUBLISH", channel, message]));
  }

  /** A pipeline: queue commands, then `await p.exec()` sends them in one round trip. */
  pipeline(): RedisPipeline {
    return new RedisPipeline(this.handle, false);
  }

  /** A transaction: like `pipeline()`, run atomically in `MULTI`/`EXEC`. */
  multi(): RedisPipeline {
    return new RedisPipeline(this.handle, true);
  }

  /**
   * A subscriber on a new connection to this client's server: to `names` as channels, or as glob
   * patterns with `patterns` (what `subscribe(client, …)` and `psubscribe(client, …)` do).
   */
  async newSubscriber(names: string[], patterns: bool = false): Promise<RedisSubscriber> {
    return await RedisSubscriber.open(this.handle, "", "", names, patterns);
  }

  /** A new, separate connection to the same server (for blocking commands). */
  async duplicate(): Promise<RedisClient> {
    return RedisClient { handle: unwrapHandle(await velt_redis__duplicate(this.handle)) };
  }

  /**
   * Releases the handle; the connection closes once no command is in flight. Closing again does
   * nothing.
   */
  close() {
    velt_redis__close(this.handle);
  }
}

/** Connects to `redis://[[user]:password@]host[:port][/db]` or `rediss://…` (TLS). */
export async function connect(url: string, opts: RedisConnectOptions = {}): Promise<RedisClient> {
  return await RedisClient.connect(url, opts);
}
