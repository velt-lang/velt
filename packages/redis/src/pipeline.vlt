// redis (internal): `RedisPipeline`, commands queued locally and sent together by `exec()`.
//
// Queued commands are one flat `string[]` plus the argument count of each command: `exec()` encodes
// the whole batch in one pass and it is written at once.

import { Client } from "./line";
import { isClosed, send } from "./multiplex";
import { BATCH, TRANSACTION } from "./slot";
import { encodeCommand } from "./resp";
import { RedisReply, replyItems, scoreArg } from "./reply";
import { closedHandle, RedisError } from "./errors";

/**
 * Commands to send in one round trip: `client.pipeline()` (independent commands) or
 * `client.multi()` (a `MULTI`/`EXEC` transaction). Queue commands, then `await p.exec()`.
 */
export class RedisPipeline {
  #handle: Client;
  #atomic: bool;
  #args: string[] = [];
  #counts: u64[] = [];

  /** Use `client.pipeline()` / `client.multi()`. */
  constructor(handle: Client, atomic: bool) {
    this.#handle = handle;
    this.#atomic = atomic;
  }

  /** Number of queued commands. */
  get length(): usize {
    return this.#counts.length;
  }

  /** Queues any command (`args[0]` is its name). */
  call(args: string[]) {
    for (const a of args) {
      this.#args.push(a);
    }
    this.#counts.push(args.length as u64);
  }

  private add(name: string, args: string[]) {
    this.#args.push(name);
    for (const a of args) {
      this.#args.push(a);
    }
    this.#counts.push((args.length + 1) as u64);
  }

  get(key: string) {
    this.add("GET", [key]);
  }

  set(key: string, value: string) {
    this.add("SET", [key, value]);
  }

  del(keys: string[]) {
    this.add("DEL", keys);
  }

  incr(key: string) {
    this.add("INCR", [key]);
  }

  incrBy(key: string, n: i64) {
    this.add("INCRBY", [key, `${n}`]);
  }

  expire(key: string, seconds: i64) {
    this.add("EXPIRE", [key, `${seconds}`]);
  }

  hget(key: string, field: string) {
    this.add("HGET", [key, field]);
  }

  hset(key: string, field: string, value: string) {
    this.add("HSET", [key, field, value]);
  }

  lpush(key: string, values: string[]) {
    this.add("LPUSH", [key, ...values]);
  }

  rpush(key: string, values: string[]) {
    this.add("RPUSH", [key, ...values]);
  }

  sadd(key: string, members: string[]) {
    this.add("SADD", [key, ...members]);
  }

  zadd(key: string, score: f64, member: string) {
    this.add("ZADD", [key, scoreArg(score), member]);
  }

  publish(channel: string, message: string) {
    this.add("PUBLISH", [channel, message]);
  }

  /**
   * Sends every queued command and returns one reply per command, in order. A command the
   * server rejects gives an "error" reply (`isError()`), not a throw; connection failures
   * throw. For `multi()`, a transaction the server aborts (EXECABORT) throws `RedisError`.
   */
  async exec(): Promise<RedisReply[]> {
    const out = new StringBuilder();
    if (this.#atomic) {
      encodeCommand(out, ["MULTI"], 0, 1);
    }
    let at: usize = 0;
    for (const n of this.#counts) {
      if (n == 0) {
        throw new RedisError("EINVAL", "malformed Redis pipeline");
      }
      encodeCommand(out, this.#args, at, at + (n as usize));
      at += n as usize;
    }
    const commands = this.#counts.length as i64;
    if (this.#atomic) {
      encodeCommand(out, ["EXEC"], 0, 1);
      return replyItems(await send(this.#handle, out.toString(), commands + 2, TRANSACTION));
    }
    if (commands == 0) {
      // Nothing to send, but a closed client still says so.
      if (isClosed(this.#handle)) {
        throw closedHandle();
      }
      return [];
    }
    return replyItems(await send(this.#handle, out.toString(), commands, BATCH));
  }
}
