// The Redis client against a real server ($VELT_TEST_REDIS_URL; every test returns at once
// without it): hashes, lists, sets and sorted sets.
import { connect, ZMember } from "../src/lib";
import { redisUrl, freshPrefix, cleanup } from "./support/redis";

export async function test_hashes() {
  const url = redisUrl();
  if (url == null) {
    return;
  }
  const p = freshPrefix();
  const c = await connect(url);
  const h = `${p}user`;
  assertEq(await c.hset(h, "name", "Ada"), 1);
  assertEq(await c.hset(h, "name", "Ada L."), 0);
  const fields = new Map<string, string>();
  fields.set("lang", "en");
  fields.set("visits", "1");
  assertEq(await c.hmset(h, fields), 2);
  assertEq(await c.hget(h, "name"), "Ada L.");
  assertEq(await c.hget(h, "missing"), null);
  assertEq(await c.hincrBy(h, "visits", 4), 5);
  const all = await c.hgetall(h);
  const names = all.keys();
  names.sort();
  const lines: string[] = [];
  for (const k of names) {
    lines.push(`${k} = ${all.get(k) ?? ""}`);
  }
  assertEq(lines, ["lang = en", "name = Ada L.", "visits = 5"]);
  assertEq(await c.hlen(h), 3);
  assertEq(await c.hdel(h, ["lang", "nope"]), 1);
  assertEq((await c.hgetall(`${p}none`)).size, 0);
  assertEq(await cleanup(c, p), 1);
  c.close();
}

export async function test_lists() {
  const url = redisUrl();
  if (url == null) {
    return;
  }
  const p = freshPrefix();
  const c = await connect(url);
  const l = `${p}list`;
  assertEq(await c.rpush(l, ["b", "c"]), 2);
  assertEq(await c.lpush(l, ["a", "z"]), 4);
  assertEq(await c.lrange(l, 0, -1), ["z", "a", "b", "c"]);
  assertEq(await c.lrange(l, 1, 2), ["a", "b"]);
  assertEq(await c.lpop(l), "z");
  assertEq(await c.rpop(l), "c");
  assertEq(await c.llen(l), 2);
  assertEq(await c.lpop(`${p}none`), null);
  assertEq(await cleanup(c, p), 1);
  c.close();
}

export async function test_sets() {
  const url = redisUrl();
  if (url == null) {
    return;
  }
  const p = freshPrefix();
  const c = await connect(url);
  const s = `${p}set`;
  assertEq(await c.sadd(s, ["x", "y", "z", "x"]), 3);
  const members = await c.smembers(s);
  members.sort();
  assertEq(members, ["x", "y", "z"]);
  assertEq(await c.scard(s), 3);
  assertEq(await c.sismember(s, "y"), true);
  assertEq(await c.sismember(s, "w"), false);
  assertEq(await c.srem(s, ["y", "w"]), 1);
  assertEq(await c.scard(s), 2);
  assertEq(await cleanup(c, p), 1);
  c.close();
}

export async function test_sorted_sets() {
  const url = redisUrl();
  if (url == null) {
    return;
  }
  const p = freshPrefix();
  const c = await connect(url);
  const z = `${p}scores`;
  const added = await c.zadd(z, [
    ZMember { member: "carol", score: 3.5 },
    ZMember { member: "alice", score: 1 },
    ZMember { member: "bob", score: 2 },
  ]);
  assertEq(added, 3);
  assertEq(await c.zadd(z, [ZMember { member: "bob", score: 2.25 }]), 0);
  assertEq(await c.zrange(z, 0, -1), ["alice", "bob", "carol"]);
  const scored: string[] = [];
  for (const m of await c.zrangeWithScores(z, 0, 1)) {
    scored.push(`${m.member}: ${m.score}`);
  }
  assertEq(scored, ["alice: 1", "bob: 2.25"]);
  assertEq(await c.zscore(z, "bob"), 2.25);
  assertEq(await c.zscore(z, "nobody"), null);
  assertEq(await c.zincrby(z, 10, "alice"), 11);
  assertEq(await c.zincrby(z, -0.5, "dave"), -0.5);
  assertEq(await c.zrange(z, 0, -1), ["dave", "bob", "carol", "alice"]);
  assertEq(await c.zrem(z, ["dave", "nobody"]), 1);
  assertEq(await c.zcard(z), 3);
  await c.zadd(z, [ZMember { member: "top", score: 1.0 / 0.0 }]);
  assertEq(`${await c.zscore(z, "top")}`, "Infinity");
  assertEq(await c.zrange(z, -1, -1), ["top"]);
  assertEq(await cleanup(c, p), 1);
  c.close();
}
