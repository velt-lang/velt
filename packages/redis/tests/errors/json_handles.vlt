// The driver's handles have no JSON form: decoding would forge a native handle, and encoding
// would hand one out.
import { RedisClient, RedisPipeline, RedisSubscriber } from "../../src/lib";

function main() {
  const c = JSON.parse<RedisClient>('{"handle":1}');
  const s = JSON.parse<RedisSubscriber>('{"handle":1}');
  const p = JSON.parse<RedisPipeline>('{"handle":1}');
}

// Encoding: the handles are private fields of types that bind the native library.
function encode(c: RedisClient, s: RedisSubscriber, p: RedisPipeline) {
  console.log(JSON.stringify(c));
  console.log(JSON.stringify(s));
  console.log(JSON.stringify(p));
}
