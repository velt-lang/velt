// What the client does around the commands, against fake servers, so no Redis is needed:
// transactions, closed handles, replies in many reads, a reply nobody asked for, and subscribers'
// routing. Ported from the Rust crate's unit tests, plus what the crate's tests left to Redis.
import { connect, psubscribe, RedisError, subscribe } from "../src/lib";
import { transaction } from "../src/reader";
import { listen, TcpStream } from "velt/net";

// A server on a free port for one connection: it reads once, sends `chunks` one by one and stays
// open until the peer leaves. Its port.
async function replies(chunks: string[]): Promise<number> {
  const l = await listen("127.0.0.1:0");
  spawn(async () => {
    const s = await l.accept();
    l.close();
    await answer(s, chunks);
  });
  return l.port;
}

async function answer(s: TcpStream, chunks: string[]) {
  await s.readString();
  for (const c of chunks) {
    await s.write(c);
  }
  while ((await s.readString()).length > 0) {}
  s.close();
}

async function codeOf(p: Promise<string, RedisError>): Promise<string> {
  try {
    return await p;
  } catch (e) {
    return e.code;
  }
}

export function test_a_transaction_is_exec_s_array() {
  const ok = transaction({ tags: [5, 3], nums: [1, 3], strs: ["", ""] }, null);
  assert(ok.failure == null, "it committed");
  assertEq(ok.reply.nums[1], 3);
}

export function test_an_aborted_transaction_names_the_rejected_command() {
  const f =
    transaction(
      { tags: [2], nums: [0], strs: ["EXECABORT Transaction discarded"] },
      "ERR unknown command 'NOPE'",
    ).failure;
  if (f == null) {
    panic("it failed");
  }
  assertEq(f.code, "EXECABORT");
  assert(f.message.includes("NOPE"), f.message);
  const watched = transaction({ tags: [0], nums: [0], strs: [""] }, null).failure;
  if (watched == null) {
    panic("a watched key changed");
  }
  assertEq(watched.code, "EXECABORT");
}

export async function test_a_closed_client_fails_with_ebadf_through_every_copy() {
  const c = await connect(`redis://127.0.0.1:${await replies(["+PONG\r\n"])}`);
  const copy = c;
  assertEq(await c.ping(), "PONG");
  c.close();
  c.close();
  assertEq(await codeOf(copy.ping()), "EBADF");
  let duplicate = "no error";
  try {
    await copy.duplicate();
  } catch (e) {
    duplicate = e.code.clone();
  }
  assertEq(duplicate, "EBADF");
  let pipeline = "no error";
  try {
    await copy.pipeline().exec();
  } catch (e) {
    pipeline = e.code.clone();
  }
  assertEq(pipeline, "EBADF");
}

// Closing waits for the reply in flight.
export async function test_close_lets_a_command_in_flight_finish() {
  const l = await listen("127.0.0.1:0");
  const release = spawn(async () => {
    const s = await l.accept();
    await s.readString();
    await sleep(50); // timing: the reply must arrive after `close()`
    await s.write("+LATE\r\n");
    while ((await s.readString()).length > 0) {}
    s.close();
    l.close();
  });
  const c = await connect(`redis://127.0.0.1:${l.port}`);
  const pending = c.ping();
  c.close();
  assertEq(await pending, "LATE");
  await release;
}

// A reply larger than the read buffer, delivered in pieces, and a pipeline split across reads.
export async function test_large_replies_arrive_in_many_reads() {
  const big = "x".repeat(300000);
  const wire = `$${big.length}\r\n${big}\r\n`;
  const c = await connect(
    `redis://127.0.0.1:${await replies([wire.slice(0, 7), wire.slice(7, 70000), wire.slice(70000)])}`,
  );
  assertEq(await c.get("k"), big);
  c.close();
  const d = await connect(
    `redis://127.0.0.1:${await replies([":1\r\n:", "2\r\n$1", "\r\na\r\n"])}`,
  );
  const p = d.pipeline();
  p.incr("a");
  p.incr("a");
  p.get("b");
  const r = await p.exec();
  assertEq(`${r[0].int} ${r[1].int} ${r[2].text}`, "1 2 a");
  d.close();
}

export async function test_an_empty_pipeline_sends_nothing() {
  const c = await connect(`redis://127.0.0.1:${await replies([])}`);
  assertEq((await c.pipeline().exec()).length, 0);
  c.close();
}

// JSON never writes a `#` field, so a pipeline shows nothing of its connection or its commands.
export async function test_a_pipeline_s_json_shows_nothing() {
  const c = await connect(`redis://secret@127.0.0.1:${await replies(["+OK\r\n"])}`);
  const p = c.pipeline();
  p.get("a");
  assertEq(JSON.stringify(p), "{}");
  c.close();
}

// A reply nobody asked for, or one that isn't RESP, ends the connection; the command in flight
// fails, and the error says it was the protocol.
export async function test_a_broken_reply_fails_the_command() {
  const c = await connect(`redis://127.0.0.1:${await replies(["?nope\r\n"])}`);
  assertEq(await codeOf(c.ping()), "EILSEQ");
  c.close();
}

// A subscriber routes pushes: confirmations to `subscribe`, messages to `next`, an error reply
// to whoever waits.
export async function test_a_subscriber_routes_pushes() {
  const pushes = [
    "*3\r\n$9\r\nsubscribe\r\n$1\r\na\r\n:1\r\n",
    "*3\r\n$7\r\nmessage\r\n$1\r\na\r\n$2\r\nhi\r\n",
    "*3\r\n$7\r\nUNKNOWN\r\n$1\r\na\r\n:1\r\n",
    "*4\r\n$8\r\npmessage\r\n$2\r\na*\r\n$2\r\nab\r\n$2\r\nyo\r\n",
  ];
  const s = await subscribe(`redis://127.0.0.1:${await replies(pushes)}`, ["a"]);
  const m = await s.next();
  if (m == null) {
    panic("a message");
  }
  assertEq(`${m.channel} ${m.message} ${m.pattern}`, "a hi null");
  const p = await s.next();
  if (p == null) {
    panic("a pattern message");
  }
  assertEq(`${p.channel} ${p.message} ${p.pattern}`, "ab yo a*");
  s.close();
  s.close();
  assert((await s.next()) == null, "closed");
  let again = "no error";
  try {
    await s.subscribe(["b"]);
  } catch (e) {
    again = e.code.clone();
  }
  assertEq(again, "EBADF");
}

export async function test_a_rejected_subscribe_fails_with_the_server_s_error() {
  let code = "no error";
  try {
    await psubscribe(`redis://127.0.0.1:${await replies(["-NOPERM no\r\n"])}`, ["a*"]);
  } catch (e) {
    code = e.code.clone();
  }
  assertEq(code, "NOPERM");
}

// `close()` ends a `next()` that is waiting.
export async function test_close_wakes_a_waiting_next() {
  const s = await subscribe(
    `redis://127.0.0.1:${await replies(["*3\r\n$9\r\nsubscribe\r\n$1\r\na\r\n:1\r\n"])}`,
    ["a"],
  );
  const waiting = spawn(async () => await s.next());
  await sleep(10); // timing: gives the task time to start waiting; passes either way
  s.close();
  assert((await waiting) == null, "woken by close");
}

// A server that goes away fails a waiting `next()`, then every later one.
export async function test_a_lost_subscriber_connection_fails_next() {
  const l = await listen("127.0.0.1:0");
  spawn(async () => {
    const s = await l.accept();
    await s.readString();
    await s.write("*3\r\n$9\r\nsubscribe\r\n$1\r\na\r\n:1\r\n");
    s.close();
    l.close();
  });
  const s = await subscribe(`redis://127.0.0.1:${l.port}`, ["a"]);
  for (let i = 0; i < 2; i++) {
    let code = "no error";
    try {
      await s.next();
    } catch (e) {
      code = e.code.clone();
    }
    assertEq(code, "ECONNRESET");
  }
  s.close();
}
