// A task that goes away while it holds or waits for something (a request whose client disconnected:
// the runtime drops its task, and every value it held). The line must go on, and a pool must get back
// what it lent. Each helper here ends the way a dropped task does: its local value is dropped.
import { Waiting, finish, park, readWhole, simple, takeTurn } from "../src/connection";
import { Lent } from "../src/lent";
import { timeout } from "velt/task";
import { parseConfig } from "../src/config";
import { Conn } from "../src/line";
import { Sent } from "../src/sent";
import { borrow } from "../src/pool";
import { Opening } from "../src/opening";
import { WaitingForPool } from "../src/waiting_for_pool";
import { PoolHandle, PoolState, release, TAKE_OPEN, TAKE_WAIT } from "../src/pool_state";
import { openConnection } from "../src/startup";
import { Channel } from "velt/sync";
import { Grant } from "../src/grant";
import { Input } from "../src/input";
import { complete, fakeUrl, join, ready, serve } from "./support/fake";

function done(tag: string): u8[] {
  return join([complete(tag), ready()]);
}

// Holds the `Input`, reading nothing, and goes away.
async function holdAndGo(conn: Conn, s: Sent) {
  const input: Input = await takeTurn(conn, s);
  assert(!input.parked, "it's held");
}

function waitAndGo(turn: Channel<Input>) {
  const waiting = new Waiting(turn, false);
  assert(!waiting.released, "it's waiting");
}

async function connected(script: u8[][]): Promise<Conn> {
  return await openConnection(parseConfig(fakeUrl(await serve(script))));
}

// What the reading end's holder was owed is read, and the next request gets its own.
export async function test_a_reader_that_goes_away_leaves_the_line_in_step() {
  const conn = await connected([join([done("UPDATE 1"), done("UPDATE 2")])]);
  const s = conn.with((l) => l.sendSimple(1, "a"));
  await holdAndGo(conn, s);
  assertEq(await simple(conn, 1, "b"), 2);
  conn.with((l) => l.shutDownWhenIdle());
}

// Bytes of the reply it had already read aren't lost either.
export async function test_a_reader_that_goes_away_mid_reply_keeps_what_it_read() {
  const whole = done("UPDATE 1");
  const conn = await connected([whole.slice(0, 7), whole.slice(7).concat(done("UPDATE 2"))]);
  const s = conn.with((l) => l.sendSimple(1, "a"));
  await holdPartly(conn, s);
  assertEq(await simple(conn, 1, "b"), 2);
  conn.with((l) => l.shutDownWhenIdle());
}

async function holdPartly(conn: Conn, s: Sent) {
  const input: Input = await takeTurn(conn, s);
  await input.fill();
  assert(input.buffer.end > 0, "something arrived");
}

// One waiting behind others goes away: its reply is read, and the one behind it gets its own.
export async function test_a_waiter_that_goes_away_leaves_the_line_in_step() {
  const conn = await connected([join([done("UPDATE 1"), done("UPDATE 2"), done("UPDATE 3")])]);
  const a = conn.with((l) => l.sendSimple(1, "a"));
  const b = conn.with((l) => l.sendSimple(1, "b"));
  const c = conn.with((l) => l.sendSimple(1, "c"));
  waitAndGo(b.turn);
  const first = await takeTurn(conn, a);
  await readWhole(conn, first);
  assertEq(first.affected(), 1);
  finish(conn, first);
  const last = await takeTurn(conn, c);
  await readWhole(conn, last);
  assertEq(last.affected(), 3);
  finish(conn, last);
  conn.with((l) => l.shutDownWhenIdle());
}

function poolOf(url: string): PoolHandle {
  return shared(new Mutex<PoolState>(new PoolState(parseConfig(url), 1)));
}

async function idleBecomes(pool: PoolHandle, n: i64) {
  for (let i: i64 = 0; i < 500 && pool.with((p) => p.idleCount) != n; i++) {
    // timing: the task that reads what was owed runs by itself
    await sleep(10);
  }
  assertEq(pool.with((p) => p.idleCount), n);
}

// A statement borrowed a connection and its task went away: it goes back once the reply is read.
export async function test_a_borrowed_connection_comes_back() {
  const pool = poolOf(fakeUrl(await serve([done("UPDATE 1")])));
  const conn = await borrow(pool);
  const s = conn.with((l) => l.sendSimple(0, "a"));
  await holdAndGo(conn, s);
  await idleBecomes(pool, 1);
  pool.with((p) => p.end());
}

// A task in the pool's line goes away before it's handed anything.
export async function test_a_pool_waiter_that_goes_away_gets_nothing() {
  const pool = poolOf(fakeUrl(await serve([])));
  const conn = await borrow(pool);
  const t = pool.with((p) => p.take());
  assertEq(t.status, TAKE_WAIT);
  giveUpWaiting(pool, t.wait);
  release(pool, conn);
  assertEq(pool.with((p) => p.idleCount), 1);
  pool.with((p) => p.end());
}

// A task in the pool's line goes away just after it's handed a connection.
export async function test_a_pool_waiter_gone_after_its_grant_gives_it_back() {
  const pool = poolOf(fakeUrl(await serve([])));
  const conn = await borrow(pool);
  const t = pool.with((p) => p.take());
  assertEq(t.status, TAKE_WAIT);
  release(pool, conn);
  assertEq(pool.with((p) => p.idleCount), 0);
  giveUpWaiting(pool, t.wait);
  assertEq(pool.with((p) => p.idleCount), 1);
  pool.with((p) => p.end());
}

function giveUpWaiting(pool: PoolHandle, ch: Channel<Grant> | null) {
  if (ch != null) {
    const waiting = new WaitingForPool(pool, ch);
    assert(!waiting.released, "it's waiting");
  }
}

function giveUpOpening(pool: PoolHandle) {
  const opening = new Opening(pool);
  assert(!opening.released, "it's opening");
}

// Leave to open a connection comes back when the task connecting goes away.
export async function test_a_task_gone_while_connecting_gives_its_leave_back() {
  const pool = poolOf("postgres://u@127.0.0.1:1/d");
  assertEq(pool.with((p) => p.take()).status, TAKE_OPEN);
  giveUpOpening(pool);
  assertEq(pool.with((p) => p.take()).status, TAKE_OPEN);
  pool.with((p) => p.end());
}

// The first in line waits at home while the one before it is about to send the `Input` there, parked
// as an idle line leaves it; then it goes away. The `Input` it is sent is dropped unparked, so it
// reads what that request was owed, and the next one gets its own.
export async function test_a_first_in_line_gone_before_its_turn_came_leaves_the_line_in_step() {
  const conn = await connected([join([done("UPDATE 1"), done("UPDATE 2")])]);
  const home = conn.with((l) => l.homeChannel);
  const input = home.tryReceive();
  assert(input != null, "the line is idle");
  const s = conn.with((l) => l.sendSimple(1, "a"));
  assert(s.first, "first in line");
  waitAtHomeAndGo(home);
  if (input != null) {
    park(home, input);
  }
  // timing: a hang guard; the reply owed to "a" is read by the dropped `Input`
  assertEq(await timeout(simple(conn, 1, "b"), 10000), 2);
  conn.with((l) => l.shutDownWhenIdle());
}

function waitAtHomeAndGo(home: Channel<Input>) {
  const waiting = new Waiting(home, true);
  assert(!waiting.released, "it's waiting");
}

// A task inside `pool.transaction` goes away: the connection is closed, never reused (it may be in
// a transaction, holding locks), and the pool may open another.
export async function test_a_transaction_whose_task_went_away_closes_its_connection() {
  const pool = poolOf(fakeUrl(await serve([])));
  const conn = await borrow(pool);
  leaveMidTransaction(pool, conn);
  assert(conn.with((l) => l.isLost), "closed");
  assertEq(pool.with((p) => p.idleCount), 0);
  assertEq(pool.with((p) => p.take()).status, TAKE_OPEN);
  pool.with((p) => p.end());
}

function leaveMidTransaction(pool: PoolHandle, conn: Conn) {
  const lent = new Lent(pool, conn, conn.with((l) => l.lease()));
  assert(!lent.released, "it's lent");
}

// A connection that comes back to a pool ended a moment before is closed, not left neither idle nor
// closed.
export async function test_a_connection_back_after_the_pool_ended_is_closed() {
  const pool = poolOf(fakeUrl(await serve([])));
  const conn = await borrow(pool);
  pool.with((p) => p.end());
  assert(pool.with((p) => p.arrived(conn)) == null, "nobody waits");
  assert(conn.with((l) => l.isLost), "closed");
}
