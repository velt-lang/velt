// Parameters on their own, no server: `Bind` as `writeParams` and JSON text make it. Ported from the
// Rust crate's unit tests.
import { hexEncode } from "velt/encoding";
import { writeParams } from "velt/db";
import { Encoder } from "../src/encoder";
import { Out } from "../src/frontend";
import { JsonParams } from "../src/json_params";
import { knownType, PgType } from "../src/pg_type";
import { Prepared } from "../src/prepared";
import { StatementCache } from "../src/statement_cache";

const INT2: i64 = 21;
const INT4: i64 = 23;
const INT8: i64 = 20;
const TEXT: i64 = 25;
const BOOL: i64 = 16;
const BYTEA: i64 = 17;
const FLOAT8: i64 = 701;
const NUMERIC: i64 = 1700;
const UUID: i64 = 2950;
const JSONB: i64 = 3802;
const INT4_ARRAY: i64 = 1007;

function types(oids: i64[]): PgType[] {
  return oids.map((o) => knownType(o) ?? { name: "?", param: 0, chain: [0] });
}

function encoderFor(sql: string, oids: i64[], names: string[] | null): Encoder {
  const cache = new StatementCache();
  const named = names != null;
  cache.insert(sql, shared(new Prepared("s1", names ?? [], named, types(oids), [], [])));
  const none = shared(new Prepared("", [], false, [], [], []));
  const e = new Encoder(new Out(64), cache, none);
  e.start(sql);
  return e;
}

// The values part of what `P` makes of `Bind`: per parameter its format code and bytes as hex.
function bound<P>(oids: i64[], params: P, names: string[] | null = null): string {
  const e = encoderFor("q", oids, names);
  assert(writeParams<P, Encoder>(e, params), "they go value by value");
  if (!e.endSet()) {
    const p = e.problem;
    return p == null ? "a miss" : p.message;
  }
  return show(e, oids.length as i64);
}

// As `bound`, from JSON text.
function boundJson(oids: i64[], text: string, names: string[] | null = null): string {
  const e = encoderFor("q", oids, names);
  const wrong = new JsonParams(text).bindTo(e);
  if (wrong != null) {
    return wrong;
  }
  if (!e.endSet()) {
    const p = e.problem;
    return p == null ? "a miss" : p.message;
  }
  return show(e, oids.length as i64);
}

function show(e: Encoder, n: i64): string {
  const b = e.out.bytes;
  const len = e.out.len;
  // 'B', length, portal "", "s1\0".
  assertEq(b[0], 66);
  let p: i64 = 5 + 1 + 3;
  assertEq((b[p] as i64) * 256 + (b[p + 1] as i64), n);
  p += 2;
  const formats = p;
  p += 2 * n;
  assertEq((b[p] as i64) * 256 + (b[p + 1] as i64), n);
  p += 2;
  const parts: string[] = [];
  for (let i: i64 = 0; i < n; i++) {
    const f = b[formats + 2 * i + 1];
    const l =
      ((b[p] as i64) << 24) |
      ((b[p + 1] as i64) << 16) |
      ((b[p + 2] as i64) << 8) |
      (b[p + 3] as i64);
    p += 4;
    if (l == 0xffffffff) {
      parts.push("null");
    } else {
      parts.push(`${f == 1 ? "b" : "t"}:${hexEncode(b.slice(p, p + l))}`);
      p += l;
    }
  }
  // One result format: binary, and the length says where the message ends.
  assertEq(p + 4, len);
  assertEq(b[p + 3], 1);
  return parts.join(" ");
}

export function test_values_convert_for_parameter_types() {
  assertEq(bound([INT2], [7]), "b:0007");
  assertEq(bound([INT8], [-1]), "b:ffffffffffffffff");
  assertEq(bound([FLOAT8], [2]), "b:4000000000000000");
  assertEq(bound([NUMERIC], [0.1]), "t:302e31");
  assertEq(bound([TEXT], [5]), "b:35");
  assertEq(bound([BOOL], [true]), "b:01");
  assertEq(bound([INT4_ARRAY], ["{1,2}"]), "t:7b312c327d");
  assertEq(bound([JSONB], ["{}"]), "b:017b7d");
  const blob: u8[] = [1, 2];
  assertEq(bound([BYTEA], { b: blob }, ["b"]), "b:0102");
  const none: (string | null)[] = [null];
  assertEq(bound([UUID], none), "null");
  assertEq(bound([UUID], ["a"]), "t:61");
}

export function test_a_float_binds_as_its_json_would_read_back() {
  // Integral, it's an integer; NaN and the infinities are null.
  assertEq(bound([INT4], [3.0]), "b:00000003");
  assertEq(bound([INT4], [NaN]), "null");
  assertEq(bound([INT4], [Infinity]), "null");
  assertEq(bound([INT4], [0.5]), "parameter $1: cannot bind a float to a parameter of type int4");
}

export function test_bad_values_are_rejected_clearly() {
  assertEq(bound([INT2], [70000]), "parameter $1: 70000 is out of range for int2");
  assertEq(bound([INT4], [2147483648]), "parameter $1: 2147483648 is out of range for int4");
  assertEq(bound([INT4], [true]), "parameter $1: cannot bind a bool to a parameter of type int4");
  assertEq(bound([UUID], [1]), "parameter $1: cannot bind an integer to a parameter of type uuid");
  const blob: u8[] = [1];
  assertEq(
    bound([INT4], { b: blob }, ["b"]),
    "parameter $1: cannot bind a u8[] to a parameter of type int4",
  );
}

export function test_binding_matches_names_and_counts() {
  const names = ["a", "b"];
  // Out of order, with a member the SQL doesn't name.
  assertEq(bound([INT4, TEXT], { b: "x", a: 1, extra: true }, names), "b:00000001 b:78");
  assertEq(bound([INT4, TEXT], { a: 1, b: "x" }, names), "b:00000001 b:78");
  assertEq(bound([INT4, TEXT], { a: 1 }, names), `missing parameter "b" (placeholder $2)`);
  assertEq(bound([INT4, TEXT], [1]), "the statement takes 2 parameter(s) but 1 were given");
  assertEq(bound([INT4], [1, 2, 3]), "the statement takes 1 parameter(s) but 3 were given");
  const empty: i64[] = [];
  assertEq(bound([], empty), "");
  assertEq(bound([INT4], empty), "the statement takes 1 parameter(s) but 0 were given");
}

export function test_a_text_format_value_out_of_order_keeps_its_format() {
  assertEq(bound([UUID, INT4], { y: 1, x: "u" }, ["x", "y"]), "t:75 b:00000001");
}

export function test_json_text_binds_the_same() {
  assertEq(boundJson([INT4, TEXT], `[1,"x"]`), "b:00000001 b:78");
  assertEq(boundJson([INT4, TEXT], `{"b":"x\\n","a":1}`, ["a", "b"]), "b:00000001 b:780a");
  assertEq(boundJson([BYTEA], `[[0,255]]`), "b:00ff");
  assertEq(boundJson([INT8], `9007199254740993`), "b:0020000000000001");
  assertEq(boundJson([FLOAT8], `1.5`), "b:3ff8000000000000");
  assertEq(boundJson([TEXT], `null`), "null");
  assertEq(boundJson([BOOL], `[true]`), "b:01");
  assertEq(
    boundJson([BYTEA], `[[1,256]]`),
    "parameter 1: arrays bind as blobs and must hold only integers 0-255 (a u8[])",
  );
  assertEq(
    boundJson([TEXT], `[{"a":1}]`),
    "parameter 1: nested objects cannot be bound as parameters",
  );
}

export function test_a_statement_not_prepared_writes_nothing() {
  const e = encoderFor("other", [INT4], null);
  e.start("not this one");
  assert(writeParams<i64[], Encoder>(e, [1]), "the values went");
  assert(!e.endSet(), "nothing to send");
  assert(e.missed, "a miss");
  assertEq(e.out.len, 0);
}
