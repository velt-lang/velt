// A pool never runs a statement twice: when the session ends after the server may have run it (an
// admin ends a long job after its COMMIT, a reply is lost on the network after the commit), the call
// fails with that error and the row is there once. Needs VELT_TEST_PG_URL (tests/support/pg.velt).
import { connect, createPool, PgError, Pool } from "../src/lib";
import { connect as tcpConnect, listen, TcpListener, TcpStream } from "velt/net";
import { uuidv4 } from "velt/random/uuid";
import { pgUrl } from "./support/pg";

class Count {
  n: i64;

  constructor(n: i64) {
    this.n = n;
  }
}

// A fresh table `t (v int)`; its name.
async function freshTable(url: string): Promise<string> {
  const t = `velt_once_${uuidv4().replaceAll("-", "")}`;
  const admin = await connect(url);
  await admin.batch(`CREATE TABLE ${t} (v int)`);
  admin.close();
  return t;
}

async function rowsAndDrop(url: string, t: string): Promise<i64> {
  const c = await connect(url);
  const r: Count | null = await c.selectOne(`SELECT count(*)::int8 AS n FROM ${t}`);
  await c.batch(`DROP TABLE ${t}`);
  c.close();
  return r?.n ?? -1;
}

// "ok", or the failure's code.
async function outcome(p: Promise<void, PgError>): Promise<string> {
  try {
    await p;
    return "ok";
  } catch (e) {
    return e.code.clone();
  }
}

async function batchOn(pool: Pool, sql: string): Promise<void> throws PgError {
  await pool.batch(sql);
}

async function runOn(pool: Pool, sql: string): Promise<void> throws PgError {
  await pool.run(sql);
}

async function rowsNow(admin: Pool, t: string): Promise<i64> {
  const r: Count | null = await admin.selectOne(`SELECT count(*)::int8 AS n FROM ${t}`);
  return r?.n ?? -1;
}

// Starts `job` (which inserts a row into `t`, commits, and sleeps), waits for its commit, and ends
// its session from another: the job's code, and the rows in `t`.
async function killedAfterCommit(
  url: string,
  t: string,
  job: (pool: Pool) => Promise<void, PgError>,
): Promise<string> {
  const pool = createPool({ url: url, max: 1 });
  const admin = createPool({ url: url, max: 1 });
  const running = spawn(outcome(job(pool)));
  for (let i = 0; i < 1000 && (await rowsNow(admin, t)) == 0; i++) {
    // timing: polls for the job's COMMIT
    await sleep(10);
  }
  await admin.run(
    `SELECT pg_terminate_backend(pid)::int4 FROM pg_stat_activity WHERE state = 'active' AND query LIKE '%${t}%' AND query NOT LIKE '%pg_stat_activity%'`,
  );
  const code = await running;
  admin.end();
  pool.end();
  return `${code} rows=${await rowsAndDrop(url, t)}`;
}

// A DO block on the simple protocol commits, then its session is ended while it runs: the server
// sends nothing before its FATAL, and the block isn't run again.
export async function test_a_do_block_ended_after_its_commit_is_not_run_again() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const t = await freshTable(url);
  const sql = `DO $$ BEGIN INSERT INTO ${t} VALUES (1); COMMIT; PERFORM pg_sleep(30); END $$`;
  const got = await killedAfterCommit(url, t, (pool: Pool) => batchOn(pool, sql));
  assertEq(got, "57P01 rows=1");
}

// The same through a procedure on the extended protocol.
export async function test_a_procedure_ended_after_its_commit_is_not_run_again() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const t = await freshTable(url);
  const admin = await connect(url);
  await admin.batch(
    `CREATE PROCEDURE ${t}_job() LANGUAGE plpgsql AS $$ BEGIN INSERT INTO ${t} VALUES (1); COMMIT; PERFORM pg_sleep(30); END $$`,
  );
  const got = await killedAfterCommit(url, t, (pool: Pool) => runOn(pool, `CALL ${t}_job()`));
  await admin.batch(`DROP PROCEDURE ${t}_job()`);
  admin.close();
  assertEq(got, "57P01 rows=1");
}

// A proxy in front of the server. Its first connection forwards the start-up both ways, then the
// requests up to the first that runs a statement (`Query`, or a group with `Execute`), drops the
// server's reply to it, and cuts the client off: a reply lost after the server ran the statement.
// Later connections are forwarded as they are.
async function pipe(from: TcpStream, to: TcpStream) {
  try {
    while (true) {
      const b = await from.read();
      if (b.length == 0) {
        break;
      }
      await to.writeBytes(b);
    }
  } catch (e) {}
  to.close();
}

// Whether `b`, whole messages, holds an `Execute`.
function hasExecute(b: u8[]): bool {
  let p: i64 = 0;
  const n = b.length as i64;
  while (p + 5 <= n) {
    if (b[p] == 69) {
      return true;
    }
    const len =
      ((b[p + 1] as i64) << 24) |
      ((b[p + 2] as i64) << 16) |
      ((b[p + 3] as i64) << 8) |
      (b[p + 4] as i64);
    p += len + 1;
  }
  return false;
}

class Cut {
  cut: bool = false;
}

async function serverToClient(server: TcpStream, client: TcpStream, cut: shared<Mutex<Cut>>) {
  try {
    while (true) {
      const b = await server.read();
      if (b.length == 0 || cut.with((x) => x.cut)) {
        break;
      }
      await client.writeBytes(b);
    }
  } catch (e) {}
}

// How many statements the cut connection let through to the server.
class Through {
  n: i64 = 0;
}

async function cutAfterRequest(
  client: TcpStream,
  server: TcpStream,
  through: shared<Mutex<Through>>,
) {
  const cut = shared(new Mutex<Cut>(new Cut()));
  try {
    await server.writeBytes(await client.read());
    spawn(serverToClient(server, client, cut));
    while (true) {
      const q = await client.read();
      if (q.length == 0) {
        break;
      }
      if (q[0] == 81 || hasExecute(q)) {
        cut.with((x) => {
          x.cut = true;
        });
        await server.writeBytes(q);
        through.with((x) => {
          x.n++;
        });
        break;
      }
      await server.writeBytes(q);
    }
    // timing: the server runs and commits the statement before the client is cut off
    await sleep(300);
  } catch (e) {}
  client.abort();
  client.close();
  server.abort();
  server.close();
}

// The proxy's port, in front of `target` ("host:port").
// The proxy, listening; closing it ends its accept loop.
async function proxy(target: string, through: shared<Mutex<Through>>): Promise<TcpListener> {
  const l = await listen("127.0.0.1:0");
  spawn(async () => {
    let first = true;
    try {
      while (true) {
        const c = await l.accept();
        const s = await tcpConnect(target);
        if (first) {
          first = false;
          spawn(cutAfterRequest(c, s, through));
        } else {
          spawn(pipe(c, s));
          spawn(pipe(s, c));
        }
      }
    } catch (e) {
      // Closed.
    }
  });
  return l;
}

// `url` (postgres://user:password@host:port/db) through `port` in plain text, and its `host:port`.
function viaProxy(url: string, port: number): string[] {
  const at = url.indexOf("@");
  const slash = url.indexOf("/", at);
  const q = url.indexOf("?");
  const db = q < 0 ? url.slice(slash) : url.slice(slash, q);
  return [`${url.slice(0, at)}@127.0.0.1:${port}${db}?sslmode=disable`, url.slice(at + 1, slash)];
}

// An autocommit INSERT the server runs and commits, whose reply never arrives: the call fails, and
// the row is there once.
async function lostReply(how: string) {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const t = await freshTable(url);
  const through = shared(new Mutex<Through>(new Through()));
  const target = viaProxy(url, 0)[1];
  const l = await proxy(target.includes(":") ? target : `${target}:5432`, through);
  const pool = createPool({ url: viaProxy(url, l.port)[0], max: 1 });
  let code = "ok";
  try {
    if (how == "run") {
      await pool.run(`INSERT INTO ${t} VALUES (1)`);
    } else if (how == "batch") {
      await pool.batch(`INSERT INTO ${t} VALUES (1)`);
    } else {
      await pool.execute(`INSERT INTO ${t} VALUES ($1::int)`, [1]);
    }
  } catch (e) {
    code = e.code.clone();
  }
  pool.end();
  l.close();
  assertEq(`${how}: ${code} rows=${await rowsAndDrop(url, t)}`, `${how}: ECONNRESET rows=1`);
  assertEq(through.with((x) => x.n), 1);
}

export async function test_a_run_whose_reply_was_lost_is_not_run_again() {
  await lostReply("run");
}

export async function test_a_batch_whose_reply_was_lost_is_not_run_again() {
  await lostReply("batch");
}

export async function test_an_execute_whose_reply_was_lost_is_not_run_again() {
  await lostReply("execute");
}
