// An HTTP handler holding a pooled connection finishes even when its client hangs up, so the
// connection goes back to the pool (it used to be cancelled at its next `await`, leaking the
// connection: with `max: 1` every later request then hung). Needs VELT_TEST_PG_URL
// (tests/support/pg.vlt).
import { createPool } from "../src/lib";
import { serve } from "velt/net/http";
import { connect } from "velt/net";
import { pgUrl } from "./support/pg";

class Row {
  n: i64;

  constructor(n: i64) {
    this.n = n;
  }
}

export async function test_handler_finishes_when_its_client_hangs_up() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    try {
      const c = await pool.connect();
      if (new URL(req.url).pathname == "/slow") {
        await sleep(200);
      }
      const row: Row | null = await c.selectOne("SELECT 1::int8 AS n");
      c.close();
      return new Response(`n=${row?.n ?? 0}`);
    } catch (e) {
      return new Response("error", { status: 500 });
    }
  });
  const addr = `127.0.0.1:${server.port}`;
  assertEq(await (await fetch(`http://${addr}/fast`)).text(), "n=1");

  // A client that sends a request and hangs up while the handler holds the connection.
  const s = await connect(addr);
  await s.write("GET /slow HTTP/1.1\r\nHost: x\r\n\r\n");
  await sleep(50);
  s.close();

  // Served once the abandoned handler finished and returned the connection.
  assertEq(await (await fetch(`http://${addr}/fast`)).text(), "n=1");
  assertEq(pool.idleCount, 1);
  await server.shutdown();
  pool.end();
}
