// postgres pool: concurrent queries from spawned tasks on at most `max` connections,
// dedicated clients with pool.connect(), pool.transaction(fn), and end(). Tables live in a
// schema named with a fresh UUID (connections of a pool share no temp tables), dropped at the
// end. Needs VELT_TEST_PG_URL (tests/support/pg.velt).
import { connect, createPool, Client, PgError, Pool } from "../src/lib";
import { uuidv4 } from "velt/random/uuid";
import { timeout, TimeoutError } from "velt/task";
import { pgUrl } from "./support/pg";

class Count {
  n: i64;

  constructor(n: i64) {
    this.n = n;
  }
}

class Value {
  v: i64;

  constructor(v: i64) {
    this.v = v;
  }
}

class Backend {
  pid: i64;

  constructor(pid: i64) {
    this.pid = pid;
  }
}

// Inserts `per` rows for worker `w`, one statement at a time; returns the backends it used.
async function worker(pool: Pool, table: string, w: i64, per: i64): Promise<i64[]> {
  const pids: i64[] = [];
  for (let i = 0; i < per; i++) {
    const b: Backend | null = await pool.queryOne(
      `INSERT INTO ${table} (w, i) VALUES ($1, $2) RETURNING pg_backend_pid() AS pid`,
      [w, i],
    );
    const pid = b?.pid ?? 0;
    if (!pids.includes(pid)) {
      pids.push(pid);
    }
  }
  return pids;
}

// One query on a shared client.
async function square(db: Client, n: i64): Promise<i64> {
  const r: Count | null = await db.queryOne("SELECT $1::int8 * $1::int8 AS n", [n]);
  return r?.n ?? -1;
}

// A fresh schema with an empty table `hits (w int, i int)`; the schema's name.
async function hitsSchema(pool: Pool): Promise<string> {
  const schema = `velt_test_${uuidv4().replaceAll("-", "")}`;
  await pool.batch(`CREATE SCHEMA ${schema}; CREATE TABLE ${schema}.hits (w int, i int)`);
  return schema;
}

async function rows(pool: Pool, table: string): Promise<i64> {
  const total: Count | null = await pool.selectOne(`SELECT count(*) AS n FROM ${table}`);
  return total?.n ?? -1;
}

export async function test_spawned_tasks_share_max_connections() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 4 });
  const schema = await hitsSchema(pool);
  const table = `${schema}.hits`;

  // 16 tasks share 4 connections.
  const tasks: Promise<i64[], PgError>[] = [];
  for (let w = 0; w < 16; w++) {
    tasks.push(spawn(worker(pool, table, w, 25)));
  }
  const used: i64[] = [];
  for (const pids of await Promise.all(tasks)) {
    for (const pid of pids) {
      if (!used.includes(pid)) {
        used.push(pid);
      }
    }
  }
  assertEq(await rows(pool, table), 400);
  assert(used.length <= 4, `at most 4 connections, used ${used.length}`);
  assert(pool.idleCount <= 4, "at most 4 idle connections");

  await pool.batch(`DROP SCHEMA ${schema} CASCADE`);
  pool.end();
}

export async function test_dedicated_client_keeps_its_session() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 4 });
  // A dedicated client keeps its session (a temp table) until close() returns it.
  const c = await pool.connect();
  await c.batch("CREATE TEMP TABLE mine (x int)");
  await c.run("INSERT INTO mine VALUES (1), (2)");
  const mine: Count | null = await c.selectOne("SELECT count(*) AS n FROM mine");
  assertEq(mine?.n, 2);
  c.close();
  pool.end();
}

export async function test_pool_transaction_is_all_or_nothing() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 4 });
  const schema = await hitsSchema(pool);
  const table = `${schema}.hits`;
  // 25 rows for each of 16 workers, as the tasks above insert them.
  await pool.run(
    `INSERT INTO ${table} (w, i) SELECT w, i FROM generate_series(0, 15) w, generate_series(0, 24) i`,
  );

  // pool.transaction: all-or-nothing on one connection.
  const kept = await pool.transaction(async (tx) => {
    await tx.execute(`INSERT INTO ${table} (w, i) VALUES ($1, $2)`, [99, 0]);
    return await tx.execute(`DELETE FROM ${table} WHERE w = $1`, [0]);
  });
  const inside: string[] = [];
  let rolledBack = "";
  try {
    await pool.transaction(async (tx) => {
      await tx.execute(`DELETE FROM ${table}`, {});
      try {
        await tx.run("SELECT 1 / 0");
      } catch (e) {
        inside.push(e.code.clone());
      }
      return 0;
    });
  } catch (e) {
    rolledBack = e.code.clone();
  }
  assertEq(inside, ["22012"]);
  assertEq(rolledBack, "22012");
  assertEq(kept, 25);
  assertEq(await rows(pool, table), 376);

  await pool.batch(`DROP SCHEMA ${schema} CASCADE`);
  pool.end();
}

export async function test_shared_client_pipelines_spawned_queries() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  // One client shared by spawned tasks pipelines their queries on its connection.
  const shared = await connect(url);
  const squares: Promise<i64, PgError>[] = [];
  for (let n = 1; n <= 8; n++) {
    squares.push(spawn(square(shared, n)));
  }
  assertEq(await Promise.all(squares), [1, 4, 9, 16, 25, 36, 49, 64]);
  shared.close();
}

export async function test_ended_pool_fails() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 4 });
  await pool.run("SELECT 1");
  pool.end();
  let code = "";
  try {
    await pool.run("SELECT 1");
  } catch (e) {
    code = e.code.clone();
  }
  assertEq(code, "ECLOSED");
}

// One task's turns on a busy pool: how many queries got their own value back.
async function turns(pool: Pool, t: i64, n: i64): Promise<i64> throws PgError {
  let right: i64 = 0;
  for (let k: i64 = 0; k < n; k++) {
    const want = t * 1000 + k;
    const r: Value | null = await pool.queryOne("SELECT $1::int8 AS v", [want]);
    if (r != null && r.v == want) {
      right++;
    }
  }
  return right;
}

// Many tasks wait for one connection, again and again (each wait's channel serves the next waits);
// every one gets its turn, and those still waiting when the pool ends hear so.
export async function test_waiters_for_one_connection_each_get_their_turns() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const tasks: Promise<i64, PgError>[] = [];
  for (let t: i64 = 0; t < 20; t++) {
    tasks.push(spawn(turns(pool, t, 25)));
  }
  let right: i64 = 0;
  for (const n of await timeout(Promise.all(tasks), 60000)) {
    right += n;
  }
  assertEq(right, 500);

  // Waiters when the pool ends: they fail, none hangs.
  const limited: Promise<i64, PgError | TimeoutError>[] = [];
  for (let t: i64 = 0; t < 8; t++) {
    limited.push(spawn(timeout(spawn(turns(pool, t, 25)), 20000)));
  }
  await pool.run("SELECT 1");
  pool.end();
  let closed: i64 = 0;
  let stuck: i64 = 0;
  for (const p of limited) {
    try {
      await p;
    } catch (e) {
      if (e instanceof PgError && e.code == "ECLOSED") {
        closed++;
      } else if (e instanceof TimeoutError) {
        stuck++;
      }
    }
  }
  assert(closed > 0, "the pool's end reached its waiters");
  assertEq(stuck, 0);
}

async function backendOf(pool: Pool): Promise<i64> throws PgError {
  const b: Backend | null = await pool.selectOne("SELECT pg_backend_pid()::int8 AS pid");
  return b?.pid ?? -1;
}

// A session ended by the server (`pg_terminate_backend`, a restart, a fail-over) while its
// connection waited idle, however briefly: the pool finds the server's FATAL "57P01" on the socket
// before it lends the connection, and opens another. (One ended after that check fails its
// statement, which the server may have run.)
export async function test_a_connection_whose_session_ended_while_idle_is_not_used() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const admin = await connect(url);
  const pool = createPool({ url: url, max: 1 });
  for (let round = 0; round < 3; round++) {
    const pid = await backendOf(pool);
    await admin.execute("SELECT pg_terminate_backend($1::int4)", [pid]);
    // The server's FATAL is sent before the backend leaves pg_stat_activity: once it has left, the
    // FATAL is on the idle connection's socket.
    let left = false;
    for (let i = 0; i < 1000 && !left; i++) {
      const c: Count | null = await admin.queryOne(
        "SELECT count(*)::int8 AS n FROM pg_stat_activity WHERE pid = $1::int4",
        [pid],
      );
      left = c?.n == 0;
      if (!left) {
        // timing: polls for the backend's exit
        await sleep(5);
      }
    }
    assert(left, `round ${round}: backend ${pid} still there`);
    const next = await backendOf(pool);
    assert(next > 0 && next != pid, `round ${round}: ${next} after ${pid}`);
  }
  admin.close();
  pool.end();
}

// A statement that ends its own session ran: it fails, and isn't run again.
export async function test_a_statement_that_ends_its_session_is_not_run_again() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const pid = await backendOf(pool);
  let code = "ok";
  try {
    await pool.run("SELECT pg_terminate_backend(pg_backend_pid())");
  } catch (e) {
    code = e.code.clone();
  }
  assertEq(code, "57P01");
  const next = await backendOf(pool);
  assert(next > 0 && next != pid, `${next} after ${pid}`);
  pool.end();
}
