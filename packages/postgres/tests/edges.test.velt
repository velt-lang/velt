// What the driver does around statements, against a real server. Needs VELT_TEST_PG_URL
// (tests/support/pg.velt).
import { Client, connect, createPool, PgError } from "../src/lib";
import { timeout } from "velt/task";
import { pgUrl } from "./support/pg";

class Pid {
  pid: i64;

  constructor(pid: i64) {
    this.pid = pid;
  }
}

class Count {
  n: i64;

  constructor(n: i64) {
    this.n = n;
  }
}

// Program code that runs while the parameters are made may use the connection.
class Touchy {
  db: Client;
  n: i64;

  constructor(db: Client, n: i64) {
    this.db = db;
    this.n = n;
  }

  toJSON(): i64 {
    // Takes the connection's lock: this would wait for itself if the driver held it now.
    return this.db.inTransaction ? -1 : this.n;
  }
}

export async function test_tojson_may_use_the_connection() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await connect(url);
  const params: Touchy[] = [new Touchy(db, 41)];
  const r: Count | null = await db.queryOne("SELECT $1::int8 + 1 AS n", params);
  assertEq(r?.n, 42);
  db.close();
}

async function backend(c: Client): Promise<i64> {
  const p: Pid | null = await c.selectOne("SELECT pg_backend_pid()::int8 AS pid");
  return p?.pid ?? -1;
}

// A connection the server ended while idle isn't handed out, once it has been idle a moment.
export async function test_a_pool_drops_a_connection_the_server_ended() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const c = await pool.connect();
  const pid = await backend(c);
  c.close();
  const killer = await connect(url);
  await killer.execute("SELECT pg_terminate_backend($1::int4)", [pid]);
  killer.close();
  // timing: longer than the pool's wait before it looks at an idle socket
  await sleep(300);
  const after: Count | null = await pool.selectOne("SELECT 1::int8 AS n");
  assertEq(after?.n, 1);
  pool.end();
}

export async function test_a_client_whose_session_was_ended_says_so() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const c = await connect(url);
  const pid = await backend(c);
  const killer = await connect(url);
  await killer.execute("SELECT pg_terminate_backend($1::int4)", [pid]);
  killer.close();
  // timing: the server's message and close have arrived
  await sleep(100);
  let first = "";
  try {
    await c.run("SELECT 1");
  } catch (e) {
    first = e.code.clone();
  }
  assert(first == "57P01" || first == "ECONNRESET", first);
  let second = "";
  try {
    await c.run("SELECT 1");
  } catch (e) {
    second = e.code.clone();
  }
  assertEq(second, "ECONNRESET");
  c.close();
}

// A query given up on: the pool gets its connection back when the statement ends, in step.
export async function test_a_timed_out_pool_query_gives_its_connection_back() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  let what = "";
  try {
    const r: Count | null = await timeout(
      pool.selectOne("SELECT 7::int8 AS n FROM pg_sleep(0.4)"),
      50,
    );
    what = `${r?.n}`;
  } catch (e) {
    what = "timed out";
  }
  assertEq(what, "timed out");
  const r: Count | null = await timeout(pool.selectOne("SELECT 8::int8 AS n"), 5000);
  assertEq(r?.n, 8);
  pool.end();
}

// A task that stops waiting for a pool's connection leaves nothing behind.
export async function test_a_waiter_given_up_on_does_not_lose_the_connection() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const held = await pool.connect();
  let what = "";
  try {
    await timeout(pool.run("SELECT 1"), 50);
    what = "ran";
  } catch (e) {
    what = "timed out";
  }
  assertEq(what, "timed out");
  held.close();
  const r: Count | null = await timeout(pool.selectOne("SELECT 9::int8 AS n"), 5000);
  assertEq(r?.n, 9);
  pool.end();
}

// A connection in a transaction isn't reused.
export async function test_a_pooled_client_closed_in_a_transaction_is_dropped() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const c = await pool.connect();
  const first = await backend(c);
  await c.begin();
  c.close();
  assertEq(pool.idleCount, 0);
  const d = await pool.connect();
  assert((await backend(d)) != first, "a new connection");
  assertEq(d.inTransaction, false);
  d.close();
  assertEq(pool.idleCount, 1);
  pool.end();
}

// A closed client's copies, and one from a pool whose connection went on to another client.
export async function test_a_closed_pooled_client_fails_on_the_same_connection() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const pool = createPool({ url: url, max: 1 });
  const a = await pool.connect();
  a.close();
  const b = await pool.connect();
  let code = "";
  try {
    await a.run("SELECT 1");
  } catch (e) {
    code = e.code.clone();
  }
  assertEq(code, "ECLOSED");
  assertEq(await b.run("SELECT 1"), 1);
  b.close();
  pool.end();
}

// More statements than a connection keeps: the oldest go, and they still run.
export async function test_statements_past_the_cache_are_evicted_and_closed() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await connect(url);
  for (let i: i64 = 0; i < 300; i++) {
    const r: Count | null = await db.selectOne(`SELECT ${i}::int8 AS n`);
    assertEq(r?.n, i);
  }
  const left: Count | null = await db.selectOne(
    "SELECT count(*)::int8 AS n FROM pg_prepared_statements",
  );
  assert((left?.n ?? 999) <= 257, `at most the cache on the server, found ${left?.n}`);
  db.close();
}

// A plan that went stale is forgotten: the next run prepares it again.
export async function test_a_stale_plan_is_prepared_again() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await connect(url);
  await db.batch("CREATE TEMP TABLE stale (a int8); INSERT INTO stale VALUES (1)");
  const sql = "SELECT * FROM stale";
  assertEq(await db.run(sql), 1);
  await db.batch("ALTER TABLE stale ALTER COLUMN a TYPE text");
  let code = "";
  try {
    await db.run(sql);
  } catch (e) {
    code = e.code.clone();
  }
  assertEq(code, "0A000");
  assertEq(await db.run(sql), 1);
  db.close();
}

export async function test_a_script_with_copy_from_stdin_fails_and_the_connection_goes_on() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await connect(url);
  await db.batch("CREATE TEMP TABLE c (a int)");
  let code = "";
  try {
    await db.batch("COPY c FROM STDIN");
  } catch (e) {
    code = e.code.clone();
  }
  assertEq(code, "57014");
  assertEq(await db.run("SELECT 1"), 1);
  db.close();
}

export async function test_large_replies_arrive_whole() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await connect(url);
  class Big {
    s: string;
    constructor(s: string) {
      this.s = s;
    }
  }
  const rows: Big[] = await db.select(
    "SELECT repeat('x', 5000000) AS s FROM generate_series(1, 3)",
  );
  assertEq(rows.length, 3);
  assertEq(rows[2].s.length, 5000000);
  db.close();
}
