// postgres basics: connect, batch, query/queryOne/execute with positional and named
// parameters, the no-parameter forms, and close. Needs VELT_TEST_PG_URL (tests/support/pg.vlt).
import { Client, connect } from "../src/lib";
import { pgUrl } from "./support/pg";

class User {
  id: i64;
  name: string;
  email: string;
  age: i64 | null;

  constructor(id: i64, name: string, email: string, age: i64 | null) {
    this.id = id;
    this.name = name;
    this.email = email;
    this.age = age;
  }
}

class Count {
  n: i64;

  constructor(n: i64) {
    this.n = n;
  }
}

// A connection with a TEMP table of users: Ann (age 31) only, or also Bob (42) and Cy (no age).
async function usersDb(url: string, all: bool): Promise<Client> {
  const db = await connect(url);
  await db.batch(`
    CREATE TEMP TABLE users (
      id BIGSERIAL PRIMARY KEY,
      name TEXT NOT NULL,
      email TEXT NOT NULL UNIQUE,
      age INT
    );
    INSERT INTO users (name, email, age) VALUES ('Ann', 'ann@example.com', 31);
  `);
  if (all) {
    await db.execute("INSERT INTO users (name, email, age) VALUES ($1, $2, $3), ($4, $5, NULL)", [
      "Bob",
      "bob@example.com",
      "42",
      "Cy",
      "cy@example.com",
    ]);
  }
  return db;
}

export async function test_positional_and_named_parameters() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await usersDb(url, false);
  // Positional and named parameters.
  // Array elements share one type; a string also binds to non-text types (the server
  // parses it), so mixed values can go positionally as strings.
  const added = await db.execute(
    "INSERT INTO users (name, email, age) VALUES ($1, $2, $3), ($4, $5, NULL)",
    ["Bob", "bob@example.com", "42", "Cy", "cy@example.com"],
  );
  assertEq(added, 2);
  const bob: User | null = await db.queryOne(
    "SELECT id, name, email, age FROM users WHERE email = :email",
    { email: "bob@example.com" },
  );
  assertEq(bob?.name, "Bob");
  assertEq(bob?.age, 42);
  const older: User[] = await db.query(
    "SELECT * FROM users WHERE age > $min OR name = $name ORDER BY id",
    { min: 30, name: "Cy" },
  );
  assertEq(older.map((u) => `${u.id}:${u.name}:${u.age ?? -1}`), [
    "1:Ann:31",
    "2:Bob:42",
    "3:Cy:-1",
  ]);

  // A name used twice binds once; `::` casts are not placeholders.
  const same: Count | null = await db.queryOne(
    "SELECT count(*)::int AS n FROM users WHERE name = :n OR email = :n || '@x'",
    { n: "Ann" },
  );
  assertEq(same?.n, 1);
  db.close();
}

export async function test_statements_without_parameters() {
  const url = pgUrl();
  if (url == null) {
    return;
  }
  const db = await usersDb(url, true);
  // No parameters.
  const all: User[] = await db.select("SELECT * FROM users ORDER BY id");
  assertEq(all.length, 3);
  assertEq(all[2].email, "cy@example.com");
  const none: User | null = await db.selectOne("SELECT * FROM users WHERE id < 0");
  assert(none == null, "no row");
  assertEq(await db.run("UPDATE users SET age = coalesce(age, 0) + 1"), 3);
  const n: Count | null = await db.queryOne("SELECT count(*) AS n FROM users WHERE age > $1", [40]);
  assertEq(n?.n, 1);

  // RETURNING works through query.
  const ids: Count[] = await db.query("DELETE FROM users WHERE age < $1 RETURNING id AS n", [10]);
  assertEq(ids.map((c) => c.n), [3]);
  db.close();
}
