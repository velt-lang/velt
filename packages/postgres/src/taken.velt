// postgres (internal): `Taken`, what `PoolState.take` found (pool_state.velt).

import { Channel } from "velt/sync";
import { Grant } from "./grant";
import { Conn } from "./line";

/** What `take` found. */
export struct Taken {
  status: u8;
  conn: Conn | null;
  /** How long it was idle, in milliseconds. */
  idleMs: f64;
  wait: Channel<Grant> | null;
}
