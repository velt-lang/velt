// postgres (internal): `Pool`, connections opened on demand and reused, and `createPool`.
//
// `Pool` is a Copy handle: pass and capture it freely (concurrent queries run on separate
// connections) and release it once with `end()`.

import { Client } from "./client";
import { parseConfig } from "./config";
import { errorOf, PgError } from "./errors";
import { closed } from "./failure";
import { stillAlive } from "./connection";
import { Conn } from "./line";
import {
  batchAll,
  batchCounts,
  batchFirst,
  executeOne,
  queryAll,
  queryFirst,
  runBare,
  selectAll,
  selectFirst,
} from "./ops";
import { PoolOptions } from "./pool_options";
import {
  connectionGone,
  PoolHandle,
  PoolState,
  poolClosed,
  release,
  TAKE_ENDED,
  TAKE_IDLE,
  TAKE_OPEN,
} from "./pool_state";
import { simple } from "./connection";
import { openConnection } from "./startup";
import { Lent } from "./lent";
import { Opening } from "./opening";
import { WaitingForPool } from "./waiting_for_pool";

// An idle connection this old has its socket looked at before use: the server may have gone. A
// younger one's would cost a system call per query, under load, for nothing.
const CHECK_AFTER_MS: f64 = 100.0;

// Opens a connection under the leave `take` or a waiter's grant gave.
async function open(pool: PoolHandle): Promise<Conn> throws PgError {
  const opening = new Opening(pool);
  const config = pool.with((p) => p.config);
  const conn = await openConnection(config);
  opening.released = true;
  const owner = pool;
  conn.with((l) => {
    l.pool = owner;
  });
  return conn;
}

/** A connection for this task, waiting for one when all `max` are busy. */
export async function borrow(pool: PoolHandle): Promise<Conn> throws PgError {
  while (true) {
    const t = pool.with((p) => p.take());
    if (t.status == TAKE_IDLE) {
      const conn = t.conn;
      if (conn != null) {
        if (t.idleMs < CHECK_AFTER_MS || stillAlive(conn)) {
          return conn;
        }
        connectionGone(pool);
      }
      continue;
    }
    if (t.status == TAKE_OPEN) {
      return await open(pool);
    }
    if (t.status == TAKE_ENDED) {
      throw poolClosed();
    }
    const ch = t.wait;
    if (ch != null) {
      const waiting = new WaitingForPool(pool, ch);
      const g = await ch.receive();
      waiting.released = true;
      ch.close();
      if (g == null) {
        throw poolClosed();
      }
      const conn = g.conn;
      if (conn != null) {
        return conn;
      }
      return await open(pool);
    }
  }
}

/**
 * Up to `max` connections, opened on demand and reused. `query` & co. borrow a connection
 * for one statement; `connect()` and `transaction` keep one for longer.
 */
export struct Pool {
  private handle: PoolHandle;

  /** A pool for `opts.url`: what `createPool(opts)` does. */
  static create(opts: PoolOptions): Pool {
    const max = opts.max ?? 10;
    const state = new PoolState(parseConfig(opts.url), max == 0 ? 10 : max);
    return Pool { handle: shared(new Mutex<PoolState>(state)) };
  }

  async query<T, P>(sql: string, params: P): Promise<T[]> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out: T[] = await queryAll<T, P>(conn, 0, sql, params);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async queryOne<T, P>(sql: string, params: P): Promise<T | null> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out: T | null = await queryFirst<T, P>(conn, 0, sql, params);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async execute<P>(sql: string, params: P): Promise<i64> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const n = await executeOne<P>(conn, 0, sql, params);
      release(pool, conn);
      return n;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async select<T>(sql: string): Promise<T[]> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out: T[] = await selectAll<T>(conn, 0, sql);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async selectOne<T>(sql: string): Promise<T | null> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out: T | null = await selectFirst<T>(conn, 0, sql);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async run(sql: string): Promise<i64> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const n = await runBare(conn, 0, sql);
      release(pool, conn);
      return n;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async batch(sql: string): Promise<void> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      await simple(conn, 0, sql);
      release(pool, conn);
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  /** The batch forms run on one of the pool's connections. */
  async batchQuery<T, P>(sql: string, paramSets: P[]): Promise<T[][]> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out: T[][] = await batchAll<T, P>(conn, 0, sql, paramSets);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async batchQueryOne<T, P>(sql: string, paramSets: P[]): Promise<(T | null)[]> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out: (T | null)[] = await batchFirst<T, P>(conn, 0, sql, paramSets);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  async batchExecute<P>(sql: string, paramSets: P[]): Promise<i64[]> {
    const pool = this.handle;
    const conn = await borrow(pool);
    try {
      const out = await batchCounts<P>(conn, 0, sql, paramSets);
      release(pool, conn);
      return out;
    } catch (e) {
      release(pool, conn);
      throw e;
    }
  }

  /** A dedicated connection until its `close()`, which returns it to the pool. */
  async connect(): Promise<Client> {
    const conn = await borrow(this.handle);
    return Client.of(conn, conn.with((l) => l.lease()));
  }

  /**
   * `Client.transaction` on a dedicated connection, returned to the pool afterwards. If the task
   * goes away inside it, the connection is closed (the server rolls back) and not returned.
   */
  async transaction<T, E>(fn: (tx: Client) => Promise<T, E>): Promise<T> throws PgError | E {
    const pool = this.handle;
    const conn = await borrow(pool);
    const generation = conn.with((l) => l.lease());
    const lent = new Lent(pool, conn, generation);
    const client = Client.of(conn, generation);
    try {
      const result = await client.transaction(fn);
      lent.released = true;
      client.close();
      return result;
    } catch (e) {
      lent.released = true;
      client.close();
      throw e;
    }
  }

  /** Connections waiting idle in the pool. */
  get idleCount(): i64 {
    return this.handle.with((p) => p.idleCount);
  }

  /**
   * Closes the pool: idle connections now, busy ones when their operation (or dedicated
   * client) finishes; later operations throw "ECLOSED".
   */
  end() {
    this.handle.with((p) => p.end());
  }
}

/** A pool for `opts.url` (connections open on first use; a bad connection string throws now). */
export function createPool(opts: PoolOptions): Pool {
  return Pool.create(opts);
}

export { PoolOptions } from "./pool_options";
