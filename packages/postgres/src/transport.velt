// postgres (internal): `PgStream`, the byte stream under a connection.
//
// It is velt/net's `TcpStream`: a plain socket, one with direct TLS (`connectTls`), or the driver's
// end of the relay that carries TLS without a certificate check (tls_relay.velt). What the driver
// calls on it: `tryRead`, `readable`, `readableWithin`, `tryWrite`, `writeBytes`, `writeBytesLater`,
// `drained`, `abort` and `close`. An alias rather than an interface, so a connection's reads and
// writes stay direct calls.

import { TcpStream } from "velt/net";

/** The byte stream under a connection. */
export type PgStream = TcpStream;
