  6,
  10,
  15,
  21,
  6,
  10,
  15,
  21,
];

// floor(2^32 * abs(sin(i + 1))).
const SINES: u32[] = [
  0xd76aa478,
  0xe8c7b756,
  0x242070db,
  0xc1bdceee,
  0xf57c0faf,
  0x4787c62a,
  0xa8304613,
  0xfd469501,
  0x698098d8,
  0x8b44f7af,
  0xffff5bb1,
  0x895cd7be,
  0x6b901122,
  0xfd987193,
  0xa679438e,
  0x49b40821,
  0xf61e2562,
  0xc040b340,
  0x265e5a51,
  0xe9b6c7aa,
  0xd62f105d,
  0x02441453,
  0xd8a1e681,
  0xe7d3fbc8,
  0x21e1cde6,
  0xc33707d6,
  0xf4d50d87,
  0x455a14ed,
  0xa9e3e905,
  0xfcefa3f8,
  0x676f02d9,
  0x8d2a4c8a,
  0xfffa3942,
  0x8771f681,
  0x6d9d6122,
  0xfde5380c,
  0xa4beea44,
  0x4bdecfa9,
  0xf6bb4b60,
  0xbebfbc70,
  0x289b7ec6,
  0xeaa127fa,
  0xd4ef3085,
  0x04881d05,
  0xd9d4d039,
  0xe6db99e5,
  0x1fa27cf8,
  0xc4ac5665,
  0xf4292244,
  0x432aff97,
  0xab9423a7,
  0xfc93a039,
  0x655b59c3,
  0x8f0ccc92,
  0xffeff47d,
  0x85845dd1,
  0x6fa87e4f,
  0xfe2ce6e0,
  0xa3014314,
  0x4e0811a1,
  0xf7537e82,
  0xbd3af235,
  0x2ad7d2bb,
  0xeb86d391,
];

/** The MD5 digest of `data`, as lowercase hex. */
export function md5Hex(data: u8[]): string {
  const n = data.length as i64;
  // Padding: 0x80, zeros up to 56 bytes modulo 64, then the length in bits, little-endian.
  const total = ((n + 8) / 64 + 1) * 64;
  const m: u8[] = Buffer.alloc(total as usize);
  copyBytes(data, m, 0, 0, n);
  m[n] = 0x80;
  const bits = n * 8;
  for (let i: i64 = 0; i < 8; i++) {
    m[total - 8 + i] = (bits >> (8 * i)) as u8;
  }
  let a0: u32 = 0x67452301;
  let b0: u32 = 0xefcdab89;
  let c0: u32 = 0x98badcfe;
  let d0: u32 = 0x10325476;
  const words: u32[] = [];
  for (let i: i64 = 0; i < 16; i++) {
    words.push(0);
  }
  for (let at: i64 = 0; at < total; at += 64) {
    for (let i: i64 = 0; i < 16; i++) {
      const p = at + i * 4;
      words[i] =
        (m[p] as u32) |
        ((m[p + 1] as u32) << 8) |
        ((m[p + 2] as u32) << 16) |
        ((m[p + 3] as u32) << 24);
    }
    let a = a0;
    let b = b0;
    let c = c0;
    let d = d0;
    for (let i: i64 = 0; i < 64; i++) {
      let f: u32;
      let g: i64;
      if (i < 16) {
        f = (b & c) | (~b & d);
        g = i;
      } else if (i < 32) {
        f = (d & b) | (~d & c);
        g = (5 * i + 1) % 16;
      } else if (i < 48) {
        f = b ^ c ^ d;
        g = (3 * i + 5) % 16;
      } else {
        f = c ^ (b | ~d);
        g = (7 * i) % 16;
      }
      const rotated = a + f + SINES[i] + words[g];
      const s = SHIFTS[i];
      const next = b + ((rotated << s) | (rotated >>> (32 - s)));
      a = d;
      d = c;
      c = b;
      b = next;
    }
    a0 += a;
    b0 += b;
    c0 += c;
    d0 += d;
  }
  const out = new StringBuilder();
  for (const w of [a0, b0, c0, d0]) {
    for (let i: u32 = 0; i < 4; i++) {
      out.append((((w >>> (8 * i)) & 255) as i64).toString(16).padStart(2, "0"));
    }
  }
  return out.toString();
}
