// postgres (internal): MD5 (RFC 1321), which servers configured with `md5` authentication still ask
// for: the password exchange's hash, nothing else. velt/crypto leaves it out on purpose (it is
// broken), so it is here, for this one use.

import { copyBytes } from "./frontend";

const SHIFTS: u32[] = [
  7,
  12,
  17,
  22,
  7,
  12,
  17,
  22,
  7,
  12,
  17,
  22,
