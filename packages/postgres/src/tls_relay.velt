// postgres (internal): TLS without a certificate check, for `prefer` and `require`: velt/net's
// `startTls` over the plain socket that `SSLRequest` was answered `S` on.
//
// A connection's reads and writes happen in whichever task holds its `Input` or its lock, through
// `TcpStream`'s `tryRead`, `readable`, `writeBytesLater`, `drained` and `abort`. A `TlsStream` has
// none of those, and it belongs to one task. So one task of its own holds it and relays: what the
// server sends, decrypted, goes into one end of a `streamPair`, and what the driver writes into the
// other end goes out encrypted. The driver gets that other end, a `TcpStream` like a plain socket,
// and nothing else changes. A task dropped while it reads leaves nothing half done in the TLS
// state, which only the relay touches.

import { startTls, streamPair, TcpStream, TlsStream } from "velt/net";
import { timeout } from "velt/task";

// How much one relay step moves at most (a TLS record's payload).
const CHUNK: number = 16384;

/**
 * The handshake over `plain`, bounded by `ms`, then the driver's end of the relay. A failure closes
 * `plain` and throws what the handshake threw (a `TimeoutError` for `ms`).
 */
export async function uncheckedTls(
  plain: TcpStream,
  name: string,
  alpn: string,
  ms: i64,
): Promise<TcpStream> {
  let tls: TlsStream;
  try {
    tls = await timeout(
      startTls(plain, { serverName: serverNameOf(name), verify: false, alpn: [alpn] }),
      ms,
    );
  } catch (e) {
    // A handshake that lost to the deadline is waiting on `plain`: this ends it.
    plain.abort();
    plain.close();
    throw e;
  }
  const pair = streamPair();
  const mine = pair[0];
  const theirs = pair[1];
  spawn(relay(tls, plain, theirs));
  return mine;
}

// SNI takes a name, not an address.
function serverNameOf(host: string): string {
  if (host.includes(":")) {
    return "";
  }
  for (let i: i64 = 0; i < (host.length as i64); i++) {
    const c = host.charCodeAt(i) as i64;
    if (c != 46 && (c < 48 || c > 57)) {
      return host;
    }
  }
  return "";
}

// Both directions, until either ends; then everything is closed.
async function relay(tls: TlsStream, plain: TcpStream, side: TcpStream) {
  await Promise.all([fromServer(tls, plain, side), toServer(tls, plain, side)]);
  tls.close();
  side.close();
}

// Decrypted bytes from the server go to the driver. At the end of the stream the driver reads its
// end; on an error, the driver's next read or write fails.
async function fromServer(tls: TlsStream, plain: TcpStream, side: TcpStream) {
  const buf = new Uint8Array(CHUNK);
  try {
    while (true) {
      const n = await tls.readInto(buf);
      if (n == null) {
        break;
      }
      await side.writeBytes(buf, 0, n);
    }
    side.shutdown();
  } catch (e) {
    side.abort();
  }
  // The other direction may be waiting for the driver; it has nothing more to send to.
  plain.abort();
}

// What the driver writes goes to the server, encrypted. When the driver closes its end (it sent
// `Terminate`, or gave up on the connection), the socket closes.
async function toServer(tls: TlsStream, plain: TcpStream, side: TcpStream) {
  const buf = new Uint8Array(CHUNK);
  try {
    while (true) {
      const n = await side.readInto(buf);
      if (n == null) {
        break;
      }
      await tls.writeBytes(buf, 0, n);
    }
    await tls.shutdown();
  } catch (e) {
    // The socket failed, or the server's side ended and aborted it.
  }
  plain.abort();
  side.abort();
}
