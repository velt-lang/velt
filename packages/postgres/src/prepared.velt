// postgres (internal): `Prepared`, a statement the server has prepared, read in place by whichever
// task runs it, and `StatementCache`, a connection's statements by SQL text.

import { C_OTHER, CHAIN, decodable, PgType } from "./pg_type";

/** The statements kept prepared per connection. */
export const CAPACITY: usize = 256;

/** A prepared statement, immutable once made. */
export class Prepared {
  /** Its name on the server. */
  name: string;
  /** Placeholder names in `$n` order when the SQL used named parameters. */
  names: string[];
  /** Whether it was prepared for named parameters. */
  named: bool;
  paramCodecs: u8[];
  paramNames: string[];
  columnNames: string[];
  /** Per column, `CHAIN` codecs: how its values decode, then its elements' (pg_type.velt). */
  chains: u8[];
  /** The `ENOTSUP` message of the first column that can't be decoded, or "". */
  undecodable: string;

  constructor(
    name: string,
    names: string[],
    named: bool,
    params: PgType[],
    columns: string[],
    types: PgType[],
  ) {
    this.name = name;
    this.names = names;
    this.named = named;
    this.paramCodecs = params.map((p) => p.param);
    this.paramNames = params.map((p) => p.name);
    this.columnNames = columns;
    const chains: u8[] = [];
    let wrong = "";
    for (let c: usize = 0; c < types.length; c++) {
      const chain = types[c].chain;
      if (wrong.length == 0 && !decodable(chain)) {
        wrong = unsupported(columns[c], `type ${types[c].name}`);
      }
      for (let k: i64 = 0; k < CHAIN; k++) {
        chains.push(k < (chain.length as i64) ? chain[k] : C_OTHER);
      }
    }
    this.chains = chains;
    this.undecodable = wrong;
  }
}

/** The `ENOTSUP` message for a column holding `what`. */
export function unsupported(column: string, what: string): string {
  return `column "${column}" has ${what}, which the postgres package cannot decode; cast it, e.g. "${column}"::text`;
}

// A cached statement and when it was last used.
class Entry {
  statement: shared<Prepared>;
  used: i64;

  constructor(statement: shared<Prepared>, used: i64) {
    this.statement = statement;
    this.used = used;
  }
}

/** A connection's statements by SQL text, the least recently used evicted past `CAPACITY`. */
export class StatementCache {
  // The same text binds differently for an object and for an array, so each has its own map.
  private positional: Map<string, Entry> = new Map<string, Entry>();
  private named: Map<string, Entry> = new Map<string, Entry>();
  private clock: i64 = 0;
  private serial: i64 = 0;
  /** Names of statements dropped here, for the next request to close on the server. */
  closing: string[] = [];

  /** The statement for `sql`, marked recently used. */
  get(sql: string, named: bool): shared<Prepared> | null {
    const e = named ? this.named.get(sql) : this.positional.get(sql);
    if (e == null) {
      return null;
    }
    this.clock++;
    e.used = this.clock;
    return e.statement;
  }

  /** A name for a new statement. */
  nextName(): string {
    this.serial++;
    return `s${this.serial}`;
  }

  /** Caches `statement` for `sql`, evicting the least recently used when full. */
  insert(sql: string, statement: shared<Prepared>) {
    const named = statement.named;
    const map = named ? this.named : this.positional;
    const had = map.get(sql);
    if (had != null) {
      // Two tasks prepared the same text at once: the first one's statement isn't needed.
      this.closing.push(had.statement.name);
    } else if (this.positional.size + this.named.size >= CAPACITY) {
      this.evict();
    }
    this.clock++;
    map.set(sql, new Entry(statement, this.clock));
  }

  /** Forgets `sql` (its plan went stale on the server). */
  remove(sql: string, named: bool) {
    const map = named ? this.named : this.positional;
    const had = map.get(sql);
    if (had != null) {
      this.closing.push(had.statement.name);
      map.delete(sql);
    }
  }

  private evict() {
    let oldest: i64 = 9223372036854775807;
    let key: string | null = null;
    let fromNamed = false;
    for (const [sql, e] of this.positional) {
      if (e.used < oldest) {
        oldest = e.used;
        key = sql;
        fromNamed = false;
      }
    }
    for (const [sql, e] of this.named) {
      if (e.used < oldest) {
        oldest = e.used;
        key = sql;
        fromNamed = true;
      }
    }
    if (key != null) {
      this.remove(key, fromNamed);
    }
  }
}
