// A borrow through a counted object (`h.bytes`, `h` shared with `g`) is stabilized for a callee
// that may replace it (`callAt` runs `f`, which does), and not for a quiet one (`readAt`;
// velt_vir lower/quiet.rs).
class Holder {
  bytes: u8[];
  constructor(b: u8[]) {
    this.bytes = b;
  }
}

function readAt(b: u8[], i: usize): u8 {
  return b[i];
}

function callAt(b: u8[], f: () => void, i: usize): u8 {
  f();
  return b[i];
}

function viaQuiet(h: Holder): u8 {
  return readAt(h.bytes, 0);
}

function viaCallback(h: Holder, f: () => void): u8 {
  return callAt(h.bytes, f, 0);
}

function main() {
  const h = new Holder(Buffer.alloc(8));
  const g = h;
  h.bytes[0] = 3;
  console.log(viaQuiet(h));
  console.log(viaCallback(h, () => {
    g.bytes = Buffer.alloc(8);
  }));
  console.log(h.bytes[0]);
}
