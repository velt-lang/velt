// A fresh value beside a part of a local: `new R(1)` and `{ id: 1 }` cannot hold `t`'s map, so
// the map stays a plain borrow and Map keeps its in-place slot array.
class R { id: number; constructor(id: number) { this.id = id; } }
class T {
  routes: Map<string, R> = new Map();
  os: Map<string, { id: number }> = new Map();
  add(k: string) { this.routes.set(k, new R(1)); }
}
function fill(t: T) { t.os.set("k", { id: 1 }); }
const t = new T();
t.add("a");
fill(t);
console.log(t.routes.size, t.os.size);
