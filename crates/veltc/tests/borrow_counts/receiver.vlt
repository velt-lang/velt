// `u[i] = … u[i] …` on a `const` typed array: the receiver needs no temporary, which would
// count a reference per element (sema accessor_rmw.rs `receiver_once`).
function main() {
  const u = new Uint8Array(64);
  let s = 0;
  for (let i = 0; i < u.length; i++) {
    u[i] = (u[i] + i) & 255;
    s += u[i];
  }
  console.log(s);
}
