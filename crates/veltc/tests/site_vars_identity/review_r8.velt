class E1 extends Error {
  a: number = 1;
}

async function g1(n: number): Promise<string> {
  if (n == 0) {
    throw new E1("one");
  }
  return "g1";
}

type F = (n: number) => Promise<string>;
const wrap: F = (n) => new Promise((resolve, reject) => {
  g1(n).then(resolve, reject);
});

function pick(n: number): Promise<string> {
  return g1(n);
}

const p: Promise<string> = pick(1);
console.log(await p);
try {
  console.log(await wrap(0));
} catch (e) {
  if (e instanceof E1) {
    console.log("E1 " + e.a);
  } else {
    console.log("? " + e.message);
  }
}
