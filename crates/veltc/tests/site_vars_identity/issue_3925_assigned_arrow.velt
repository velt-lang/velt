// A variable holding an async arrow that calls two function values, assigned a `const`
// holding another such arrow: the two promise types reject with unions of two error-set
// variables each, which the solved sets (all empty) make one type, so the check with variables
// takes as many rounds as the one without (#3925).
async function run(a: () => void, b: () => void, c: () => void, d: () => void) {
  let f = async () => {
    a();
    b();
  };
  const g = async () => {
    c();
    d();
  };
  await f();
  f = g;
  await f();
}

await run(
  () => console.log("a"),
  () => console.log("b"),
  () => console.log("c"),
  () => console.log("d"),
);
