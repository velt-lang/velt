class HttpError extends Error {
  status: number;
  constructor(s: number, m: string) {
    super(m);
    this.status = s;
  }
}

class Other extends Error {}

type Handler = (path: string) => Promise<string>;

const routes: Handler[] = [];

function get(h: Handler): void {
  routes.push(h);
}

get(async (path) => {
  if (path == "") {
    throw new HttpError(400, "empty");
  }
  return "ok " + path;
});
get(async (path) => {
  if (path == "x") {
    throw new Other("other");
  }
  return "ok2 " + path;
});

async function main(): Promise<void> {
  for (const p of ["", "x", "y"]) {
    for (const r of routes) {
      const v = await r(p).catch((e) => {
        if (e instanceof HttpError) {
          return `http ${e.status}`;
        }
        if (e instanceof Other) {
          return `other ${e.message}`;
        }
        return "else";
      });
      console.log(v);
    }
  }
}

await main();
