class E1 extends Error {}

type Take = (n: number, b: Promise<string>, g: () => Promise<void>) => Promise<void>;

const take: Take = async (n, b, g) => {
  console.log(await b);
  try {
    await g();
  } catch (e) {
    console.log("g " + (e instanceof E1 ? "E1" : "other"));
  }
};

async function good(): Promise<string> {
  return "ok";
}

function wantsPlain(p: Promise<string, never>): void {}

async function main(): Promise<void> {
  const rest: [number, Promise<string>] = [1, good()];
  await take(...rest, async () => {
    throw new E1("x");
  });
}

await main();
