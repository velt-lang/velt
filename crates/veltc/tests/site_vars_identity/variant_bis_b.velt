// Async handlers and middleware stored as function types whose `Promise<T>` result is written
// without an error type (#2590): a rejection reaches the `catch` of a middleware through the
// chain of `next` calls, through handlers kept in an array, a `Map`, a field and an object
// literal, and through promises made by `new Promise` and `reject`.

class HttpError extends Error {
  status: number;
  constructor(status: number, message: string) {
    super(message);
    this.status = status;
  }
}

type Next = () => Promise<string>;
type Middleware = (path: string, next: Next) => Promise<string>;
type Handler = (path: string) => Promise<string>;

const middleware: Middleware[] = [];
const routes = new Map<string, Handler>();

class Router {
  fallback: Handler;
  constructor(fallback: Handler) {
    this.fallback = fallback;
  }
}

interface Route {
  path: string;
  run: Handler;
}

function use(m: Middleware): void {
  middleware.push(m);
}

function later(ok: boolean, value: string): Promise<string> {
  return new Promise((resolve, reject) => {
    if (ok) {
      resolve(value);
    } else {
      reject(new HttpError(503, "unavailable"));
    }
  });
}

use(async (path, next) => {
  const r = await next();
  return "[" + r + "]";
});
use(async (path, next) => {
  if (path == "/deny") {
    throw new HttpError(403, "denied");
  }
  return await next();
});

routes.set("/a", async (path) => "ok " + path);
routes.set("/empty", async (path) => {
  throw new HttpError(400, "empty");
});
routes.set("/later", (path) => later(path == "/later", "later " + path));
routes.set("/down", (path) => later(false, path));
const router = new Router(async (path) => {
  throw new HttpError(404, "no route for " + path);
});
const extra: Route[] = [{ path: "/obj", run: async (path) => "object " + path }];

function find(path: string): Handler {
  for (const r of extra) {
    if (r.path == path) {
      return r.run;
    }
  }
  return routes.get(path) ?? router.fallback;
}

async function dispatch(i: number, path: string): Promise<string> {
  if (i == middleware.length) {
    return await find(path)(path);
  }
  return await middleware[i](path, () => dispatch(i + 1, path));
}

for (const p of ["/a", "/empty", "/deny", "/later", "/down", "/obj", "/missing"]) {
  console.log(await dispatch(0, p));
}

// Without the middleware, the rejection reaches the caller's `catch`.
try {
  console.log(await find("/a")("/a"));
  console.log(await find("/empty")("/empty"));
} catch (e) {
  if (e instanceof HttpError) {
    console.log(`caught ${e.status} ${e.message}`);
  }
}
