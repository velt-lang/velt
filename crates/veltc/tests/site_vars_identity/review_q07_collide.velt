class E1 extends Error {
  n: number = 4;
}

type G = () => number;
type H = () => number throws E1;
const g: G = () => {
  throw new E1("x");
};
const h: H = () => {
  throw new E1("y");
};
const u: G | string = Math.random() > 2 ? "s" : g;
const w: H | string = Math.random() > 2 ? "t" : h;
if (typeof u != "string") {
  try {
    console.log(u());
  } catch (e) {
    console.log("u " + e);
  }
}
if (typeof w != "string") {
  try {
    console.log(w());
  } catch (e) {
    console.log("w " + e);
  }
}
const arr: (G | string)[] = [u, "a"];
const arr2: (H | string)[] = [w, "b"];
console.log(arr.length + arr2.length);
