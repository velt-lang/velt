class E1 extends Error {
  n: number = 4;
}

type P = () => Promise<number>;

interface Box {
  p?: P;
  name: string;
}

const f: P = async () => {
  throw new E1("x");
};
const g: P = async () => 5;
const pair: [P, P] = [f, g];
const boxes: Box[] = [{ p: f, name: "f" }, { name: "none" }, { p: g, name: "g" }];
const u: P | string = Math.random() > 2 ? "s" : f;
for (const b of boxes) {
  const p = b.p;
  if (p != undefined) {
    try {
      console.log(b.name + " " + await p());
    } catch (e) {
      console.log(b.name + " caught " + (e instanceof E1 ? e.n : -1));
    }
  }
}
try {
  console.log(await pair[1]());
  await pair[0]();
} catch (e) {
  console.log("pair " + e);
}
if (typeof u != "string") {
  try {
    await u();
  } catch (e) {
    console.log("u " + e);
  }
}
