class HttpError extends Error {
  status: number;
  constructor(status: number, message: string) {
    super(message);
    this.status = status;
  }
}

class Late extends Error {}

type Handler = (path: string) => Promise<string>;

const routes: Handler[] = [];

function get(h: Handler): void {
  routes.push(h);
}

get(async (path) => {
  if (path == "") {
    throw new HttpError(400, "empty");
  }
  return "ok " + path;
});

async function run(i: number, path: string): Promise<string> {
  try {
    return await routes[i](path);
  } catch (e) {
    if (e instanceof Late) {
      return "late: " + e.message;
    }
    if (e instanceof HttpError) {
      return `http ${e.status}`;
    }
    return "other";
  }
}

console.log(await run(0, "/a"));
console.log(await run(0, ""));
get(async (path) => {
  throw new Late("after " + path);
});
console.log(await run(1, "/b"));
