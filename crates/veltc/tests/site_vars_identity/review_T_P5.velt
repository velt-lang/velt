class HttpError extends Error {
  status: number;
  constructor(status: number, message: string) {
    super(message);
    this.status = status;
  }
}

function later(ok: boolean): Promise<string> {
  return new Promise((resolve, reject) => {
    if (ok) {
      resolve("fine");
    } else {
      reject(new HttpError(503, "later"));
    }
  });
}

type Handler = (path: string) => Promise<string>;
const h: Handler = async (path) => {
  if (path == "") {
    throw new HttpError(400, "empty");
  }
  return path;
};
await later(false).then((v) => console.log(v), (e) => console.log(`then ${e}`));
await h("").catch((e) => {
  console.log(`catch cb ${e}`);
  return "x";
});
