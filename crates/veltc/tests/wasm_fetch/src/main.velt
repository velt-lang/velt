// `fetch` against drive.mjs's server, natively (the Velt HTTP client) and on a JS host (the
// host's `fetch`, std/net/http/fetch/client/transport/js.velt): both print the same. Waits are on
// the server's answers (`/arrived`, `/closed`, `/release`), never on time.
import { base } from "#base";
import { IoError } from "velt/io";
import { AbortError, TimeoutError } from "velt/task";

struct Echo {
  method: string;
  one: string;
  type: string;
  length: i64;
  body: string;
}

struct Data {
  name: string;
  n: i64[];
}

const B = base();

/** A response whose body is never read, kept until the program ends: it keeps nothing running. */
let kept: Response | null = null;

/** What a failed `fetch` threw: an `IoError`'s code, or the abort error as it prints. */
function failure(e: unknown): string {
  if (e instanceof IoError) {
    return `IoError ${e.code}`;
  }
  if (e instanceof TimeoutError) {
    return `TimeoutError: ${e.message}`;
  }
  if (e instanceof AbortError) {
    return `AbortError: ${e.message}`;
  }
  return "something else";
}

const utf8 = new TextDecoder();

async function texts() {
  const res = await fetch(`${B}/text`);
  console.log("text:", res.status, res.statusText, res.ok, res.headers.get("content-type"));
  console.log("  url:", res.url == `${B}/text`, "redirected:", res.redirected);
  console.log("  body:", await res.text());
  const data = await (await fetch(`${B}/json`)).json<Data>();
  console.log("json:", data.name, data.n);
  const missing = await fetch(`${B}/missing`);
  console.log("404:", missing.status, missing.statusText, missing.ok, await missing.text());
  const big = await fetch(`${B}/big`);
  const all = await big.bytes();
  let sum: i64 = 0;
  for (const b of all) {
    sum += b as i64;
  }
  console.log("big:", all.length, sum);
}

async function redirects() {
  const followed = await fetch(`${B}/redirect`);
  console.log("follow:", followed.status, followed.redirected, followed.url == `${B}/text`);
  console.log("  body:", await followed.text());
  const manual = await fetch(`${B}/redirect`, { redirect: "manual" });
  console.log("manual:", manual.status, manual.redirected, manual.headers.get("location"));
  try {
    await fetch(`${B}/redirect`, { redirect: "error" });
    console.log("error: resolved");
  } catch (e) {
    console.log("error:", failure(e));
  }
}

async function bodiesAndHeaders() {
  const text = await fetch(`${B}/echo`, {
    method: "POST",
    headers: { "X-One": "first" },
    body: "héllo, wörld",
  });
  console.log("post text:", text.headers.get("x-two"), text.headers.getSetCookie().join(" | "));
  const t = await text.json<Echo>();
  console.log("  ", t.method, t.one, t.type, t.length, t.body);
  const raw: u8[] = [0, 1, 2, 127, 128, 255];
  const bytes = await fetch(`${B}/echo`, {
    method: "PUT",
    headers: { "content-type": "application/octet-stream" },
    body: raw,
  });
  const b = await bytes.json<Echo>();
  console.log("put bytes:", b.method, b.type, b.length, b.body);
  const word = await fetch(`${B}/word`, { headers: { "x-word": "héllo" } });
  console.log("utf-8 headers:", await word.text(), word.headers.get("x-reply"));
  try {
    await fetch(`${B}/echo`, { headers: { "x-bad": "a\u0001b" } });
    console.log("bad header: sent");
  } catch (e) {
    console.log("bad header:", failure(e));
  }
}

/** The body streams: the first piece arrives while the server holds the rest back. */
async function streaming() {
  const res = await fetch(`${B}/stream`);
  const body = res.body;
  if (body == null) {
    return;
  }
  let first = "";
  let released = false;
  let rest: i64 = 0;
  let pieces: i64 = 0;
  for await (const chunk of body) {
    if (!released) {
      first += utf8.decode(chunk);
      if (first.length >= 6) {
        console.log("stream: before the rest was sent:", first);
        // The server sends the rest only now.
        await (await fetch(`${B}/release`)).text();
        released = true;
      }
    } else {
      rest += chunk.length as i64;
      pieces += 1;
    }
  }
  console.log("  then", rest, "bytes in more than one piece:", pieces > 1);
}

async function aborts() {
  // Aborted while the server holds the response back.
  const controller = new AbortController();
  const pending = fetch(`${B}/hang?id=head`, { signal: controller.signal });
  await (await fetch(`${B}/arrived?id=head`)).text();
  controller.abort("stopped by the program");
  try {
    await pending;
    console.log("abort before response: resolved");
  } catch (e) {
    console.log("abort before response:", failure(e));
  }
  console.log("  server:", await (await fetch(`${B}/closed?id=head`)).text());

  // Aborted between two pieces of the body.
  const mid = new AbortController();
  const res = await fetch(`${B}/slow?id=body`, { signal: mid.signal });
  const body = res.body;
  if (body != null) {
    try {
      for await (const chunk of body) {
        console.log("abort mid-body: got", utf8.decode(chunk));
        mid.abort("enough");
      }
      console.log("abort mid-body: ended");
    } catch (e) {
      console.log("abort mid-body:", failure(e));
    }
  }
  console.log("  server:", await (await fetch(`${B}/closed?id=body`)).text());

  // Aborted while `text()` waits for the rest of the body.
  const whole = new AbortController();
  const partial = await fetch(`${B}/slow?id=text`, { signal: whole.signal });
  const reading = partial.text();
  whole.abort("no more");
  try {
    console.log("abort in text():", await reading);
  } catch (e) {
    console.log("abort in text():", failure(e));
  }
  console.log("  server:", await (await fetch(`${B}/closed?id=text`)).text());

  // A timeout while the body is read.
  const slowly = await fetch(`${B}/slow?id=body-timeout`, { signal: AbortSignal.timeout(100) });
  try {
    console.log("timeout in bytes():", (await slowly.bytes()).length);
  } catch (e) {
    console.log("timeout in bytes():", failure(e));
  }

  const start = Date.now();
  try {
    await fetch(`${B}/hang?id=timeout`, { signal: AbortSignal.timeout(100) });
    console.log("timeout: resolved");
  } catch (e) {
    console.log("timeout:", failure(e), "after at least 100 ms:", Date.now() - start >= 100);
  }
  console.log("  server:", await (await fetch(`${B}/closed?id=timeout`)).text());
}

async function broken() {
  try {
    console.log("bad gzip:", await (await fetch(`${B}/badgzip`)).text());
  } catch (e) {
    console.log("bad gzip:", failure(e));
  }
  const cut = await fetch(`${B}/reset`);
  try {
    console.log("reset:", await cut.text());
  } catch (e) {
    console.log("reset:", failure(e));
  }
}

async function refused() {
  const port = await (await fetch(`${B}/refused-port`)).text();
  try {
    await fetch(`http://127.0.0.1:${port}/`);
    console.log("refused: resolved");
  } catch (e) {
    console.log("refused:", failure(e));
  }
  try {
    await fetch("ftp://127.0.0.1/file");
  } catch (e) {
    console.log("ftp:", failure(e));
  }
}

/** The program ends with a response it never read, whose signal never aborts, still held. */
async function unread() {
  const never = new AbortController();
  const res = await fetch(`${B}/slow?id=kept`, { signal: never.signal });
  console.log("unread:", res.status);
  kept = res;
}

async function main() {
  await texts();
  await redirects();
  await bodiesAndHeaders();
  await streaming();
  await aborts();
  await refused();
  await broken();
  await unread();
}
