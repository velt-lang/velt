import type { Package } from "velt/package";

// The program of wasm_goldens.rs `fetch_on_js_hosts`: one source, run natively and on a JS host.
// `#base` is the URL of drive.mjs's server: a host function on JS hosts, an environment
// variable natively.
export const pkg: Package = {
  name: "wasm-fetch",
  version: "0.1.0",
  imports: { "#base": { js: "./src/_base/js.vlt", default: "./src/_base/native.vlt" } },
};
