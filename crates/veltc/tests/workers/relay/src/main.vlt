// `fetch-start` fetches and waits at a gate; meanwhile `fetch-read` reads that response's body,
// which the glue must read in `fetch-start`'s context (drive.mjs reports a read elsewhere).

import { HostRef } from "velt/host";
import { utf8Encode } from "velt/encoding";
import { waitFor } from "probe";
import { accept, respond, url } from "velt/host/worker";

/** The response `fetch-start` fetched, which `fetch-read` reads. */
const held: Response[] = [];

function text(req: HostRef, s: string): void {
  respond(req, 200, "content-type: text/plain", utf8Encode(s));
}

async function handle(req: HostRef): Promise<void> {
  const path = url(req).split("/").pop() ?? "";
  if (path == "fetch-start") {
    held.push(await fetch("https://upstream.test/data"));
    await waitFor("fetch");
    text(req, "fetched");
  } else {
    const res = held.pop();
    text(req, res == undefined ? "nothing held" : await res.text());
  }
}

async function main() {
  for (;;) {
    spawn(handle(await accept()));
  }
}
