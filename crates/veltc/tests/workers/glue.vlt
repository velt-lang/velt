// `velt:` functions the Worker glue doesn't have, or has with other types: `velt build --host
// workers` fails naming each (crates/veltc/tests/workers.rs).

declare host("velt:worker") function nosuch(): u32;
declare host("velt:worker") function method(req: u32): string;
declare host("velt:other") function other(): void;

function main() {
  console.log(nosuch(), method(1));
  other();
}
