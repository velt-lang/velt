// Host functions with every type that crosses, run under node by host.mjs
// (crates/veltc/tests/wasm_goldens.rs `host_functions_under_node`).

import { HostRef } from "velt/host";

declare host("test") function add(a: i32, b: u8, big: i64): f64;
declare host("test") function flag(b: bool): bool;
declare host("test") function greet(name: string): string;
declare host("test") function fill(buf: u8[], value: u8): u32;
declare host("test") function sum(bytes: readonly u8[]): u32;
declare host("test") function reversed(bytes: readonly u8[]): u8[];
declare host("test") function makeBox(label: string): HostRef;
declare host("test") function find(label: string): HostRef | null;
declare host("test") function label(box: HostRef): string;
declare host("test") function same(a: HostRef, b: HostRef | null): bool;
declare host("test") function live(): i32;
declare host("test") function small(): u8;
declare host("test") function tiny(): i8;
declare host("test") function wide(): i64;
declare host("test") function wideU(): u64;
declare host("test") function word(): u32;
declare host("test") function echo(bytes: u8[]): u8[];
declare host("test") function echoTail(bytes: u8[]): u8[];

function main() {
  console.log(small(), tiny(), wide(), wideU(), word());
  console.log(add(2, 255, 10000000000));
  console.log(flag(true), flag(false));
  console.log(greet("wörld"));
  const buf: u8[] = [0, 0, 0, 0];
  console.log(fill(buf, 7), buf.join(","));
  console.log(fill(buf.subarray(1, 3), 9), buf.join(","));
  const data: u8[] = [1, 2, 3];
  console.log(sum(data), sum(new Uint8Array([4, 5])), data.join(","));
  console.log(reversed(data).join(","), data.join(","));
  const box = makeBox("a");
  console.log(label(box), live());
  const copy = box.clone();
  console.log(same(box, copy), same(box, null), live());
  {
    using b = makeBox("b");
    console.log(label(b), live());
  }
  console.log(live());
  console.log(find("missing") == null);
  const found = find("a");
  if (found != null) {
    console.log(label(found), live());
  }
  box[Symbol.dispose]();
  console.log(live());
  // A result that is a view of the program's own memory, which the result's buffer may move.
  const big = new Uint8Array(40 * 1024 * 1024);
  big[1] = 5;
  const copy2 = echo(big);
  console.log(copy2.length, copy2[1], echoTail(data).join(","));
}
