// One AEAD, so the tag comparison has one caller, as in a program that uses only this one.
import { ChaCha20Poly1305 } from "velt/crypto";

const nonce: u8[] = Buffer.alloc(12);
const aead = new ChaCha20Poly1305(Buffer.alloc(32));
const sealed = aead.seal(nonce, Buffer.alloc(100), []);
console.log(aead.openInPlace(nonce, [], sealed, 0, sealed.length));
