// Promises, microtasks and timers without host functions: the output under a JS host (the turns
// it drives) is the native build's (crates/veltc/tests/wasm_goldens.rs
// `async_host_functions_under_node`). Nothing here depends on how fast the machine is: the shorter
// timer is created first, so a stall of the process anywhere leaves it due first; what must happen
// before something else is awaited; a spawned task runs on its own (natively, in parallel), so
// nothing is printed beside it.

async function step(name: string, ms: i64): Promise<string> {
  console.log(`${name} start`);
  await sleep(ms);
  console.log(`${name} after sleep(${ms})`);
  await Promise.resolve();
  console.log(`${name} after a resolved promise`);
  return name;
}

async function main() {
  queueMicrotask(() => console.log("microtask 1"));
  Promise.resolve(1).then((v) => console.log(`then ${v}`));
  const b = step("b", 0);
  const a = step("a", 30);
  queueMicrotask(() => console.log("microtask 2"));
  console.log("main sync end");
  console.log(await Promise.all([a, b]));
  setTimeout(() => console.log("timeout 1"), 0);
  await new Promise<void>((resolve) => {
    setTimeout(async () => {
      console.log("timeout 2");
      resolve();
    }, 0);
  });
  await yieldNow();
  console.log("yielded");
  console.log(await spawn(step("task", 1)));
  console.log("main end");
}
