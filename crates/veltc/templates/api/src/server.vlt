// The HTTP side: one store shared by every request, `route` behind std/http.
import { serve, Server } from "velt:http";
import { ItemStore } from "./store";
import { route } from "./api";

/// Serves the API on `port` (0 = any free port; read the chosen one from `server.port`).
export async function startServer(port: i64): Promise<Server> {
  const store = shared(new Mutex<ItemStore>(new ItemStore()));
  return await serve({ port }, async (req) => {
    const path = new URL(req.url).pathname;
    const method = req.method;
    const body = await req.text();
    const out = store.with((s) => route(s, method, path, body));
    if (out.status === 204) {
      return new Response(null, { status: 204 });
    }
    return new Response(out.body.clone(), {
      status: out.status,
      headers: { "content-type": "application/json" },
    });
  });
}
