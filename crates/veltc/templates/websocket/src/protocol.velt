// The wire protocol: one JSON object per WebSocket text message.
//   client -> server: { "type": "join", "name" } | { "type": "say", "text" } | { "type": "leave" }
//   server -> client: { "type": "joined", "name" } | { "type": "message", "from", "text" }
//                   | { "type": "left", "name" } | { "type": "error", "message" }

/// What a client sends.
export type ClientMessage =
  | { type: "join"; name: string }
  | { type: "say"; text: string }
  | { type: "leave" };

/// What the server sends.
export type ServerMessage =
  | { type: "joined"; name: string }
  | { type: "message"; from: string; text: string }
  | { type: "left"; name: string }
  | { type: "error"; message: string };

/// A message that is not valid JSON or not part of the protocol.
export class ProtocolError extends Error {}

// `JSON.parse` picks the member by its `type`; any error becomes a `ProtocolError`.

/// A client message (throws `ProtocolError`).
export function decodeClient(text: string): ClientMessage {
  try {
    return JSON.parse<ClientMessage>(text);
  } catch (e) {
    throw new ProtocolError(e.message.clone());
  }
}

/// A server message (throws `ProtocolError`).
export function decodeServer(text: string): ServerMessage {
  try {
    return JSON.parse<ServerMessage>(text);
  } catch (e) {
    throw new ProtocolError(e.message.clone());
  }
}

/// How a client shows a server message.
export function describe(msg: ServerMessage): string {
  switch (msg.type) {
    case "joined":
      return `* ${msg.name} joined`;
    case "message":
      return `<${msg.from}> ${msg.text}`;
    case "left":
      return `* ${msg.name} left`;
    case "error":
      return `! ${msg.message}`;
  }
}
