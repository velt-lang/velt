// Process glue: arguments in, lines out, exit code 2 on a usage error.
import { args, exit } from "velt:process";
import { execute } from "./commands";

function main() {
  try {
    for (const line of execute(args())) {
      console.log(line);
    }
  } catch (e) {
    console.error(`{{name}}: ${e.message}`);
    exit(2);
  }
}
