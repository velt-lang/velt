// Operator methods (`a + b` calls `[Symbol.add]`) are Velt-only.

export class Vec {
  constructor(public x: number) {}

  [Symbol.add](other: Vec): Vec {
    //~^ operator
    return new Vec(this.x + other.x);
  }

  add(other: Vec): Vec {
    return new Vec(this.x + other.x);
  }
}

export interface Summable<T> {
  [Symbol.add](other: T): T;
  //~^ operator
}


// An index with several keys calls an operator indexer.
export function corner(m: Grid): number {
  return m[0, 1];
  //~^ operator
}

export class Grid {
  [Symbol.index](i: number, j: number): number {
    //~^ operator
    return i + j;
  }
}
