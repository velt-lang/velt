// With integer types on both sides the fix keeps Velt's result in both languages.

export function pages(items: i64, perPage: i64): i64 { //~ velt-number-type velt-number-type velt-number-type
  return Math.trunc(items / perPage); //~ int-division
}

export function shrink(n: i64): i64 { //~ velt-number-type velt-number-type
  let m = n;
  m = Math.trunc(m / 2); //~ int-division
  return m;
}
