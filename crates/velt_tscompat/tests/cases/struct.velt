// `struct` declarations are Velt-only. No use of the struct's name follows: `tsc` can't see the type
// the reported declaration makes, so each use would be a `tsc` error the lint doesn't report.

export struct Point {
  //~^ struct
  x: number;
  y: number;
}

export type Size = { w: number; h: number };

export function unit(): Size {
  return { w: 1, h: 1 };
}
