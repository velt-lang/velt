// `struct` declarations are Velt-only; an object literal builds a struct (#641).

export struct Point {
  //~^ struct
  x: number;
  y: number;
}

export function origin(): Point {
  return { x: 0, y: 0 };
}

export type Size = { w: number; h: number };

export function unit(): Size {
  return { w: 1, h: 1 };
}
