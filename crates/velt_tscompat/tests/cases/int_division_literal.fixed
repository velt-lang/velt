// Integer literal types divide as numbers, as in JavaScript (#2686): no finding, and the
// quotient is a `number` wherever it goes.

export function half(xs: (1 | 3)[]): number {
  return xs[0] / 2;
}

export function third(xs: (1 | 3)[]): string {
  const q = xs[0] / 3;
  return `${q}`;
}

export function shown(xs: (1 | 3)[]): string {
  return `${xs[0] / 2}`;
}
