// `as` to an integer type converts in Velt; TypeScript's `as` never changes a value.

export function whole(x: number): number {
  const n = x as i64; //~ int-cast
  const m = x as i32; //~ int-cast
  return (n as number) + (m as number);
}

export function same(x: number): number {
  return x as number;
}
