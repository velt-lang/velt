// Defaults are linted like any other expression: of parameters, arrow parameters and
// destructuring patterns.

export type Pt = { x: number | null; y: number };

export function scaled(p: Pt, by: number = 2.0f64): number { //~ number-suffix
  const { y = 0.0f64 } = p; //~ number-suffix
  const { x = 1.0 } = p; //~ null-default
  return (x + y) * by;
}

export function shifted(x: number): number {
  const shift = (v: number, by: number = 0.5f64): number => v + by; //~ number-suffix
  return shift(x);
}
