--- a/crates/veltc/tests/gated_functions.rs
+++ b/crates/veltc/tests/gated_functions.rs
@@ -597,3 +597,162 @@ fn aes_gated_functions_are_the_bare_instructions() {
         }
     }
 }
+
+/// Functions gated on the carry-less targets and on the AES targets, called both ways.
+const COVERS_PROBE: &str = r#"
+import { u8x16, u64x2 } from "velt/simd";
+
+function clmulX86(): i64 {
+  targetFeature("clmul-x86");
+  return 1;
+}
+
+function clmulArm(): i64 {
+  targetFeature("clmul-arm");
+  return 2;
+}
+
+function aesX86(): i64 {
+  targetFeature("aes-x86");
+  return 3;
+}
+
+function aesArm(): i64 {
+  targetFeature("aes-arm");
+  return 4;
+}
+
+// AES code may call the carry-less functions: the AES target has the instruction too.
+function fromAesX86(): i64 {
+  targetFeature("aes-x86");
+  return clmulX86();
+}
+
+function fromAesArm(): i64 {
+  targetFeature("aes-arm");
+  return clmulArm();
+}
+
+export function probe(): i64 {
+  let n: i64 = 0;
+  if (u8x16.hasAesX86()) {
+    n += clmulX86() + fromAesX86() + aesX86();
+  }
+  if (u8x16.hasAesArm()) {
+    n += clmulArm() + fromAesArm() + aesArm();
+  }
+  REVERSE
+  return n;
+}
+"#;
+
+#[test]
+fn the_aes_targets_cover_the_carry_less_ones_and_not_the_reverse() {
+    // A function gated on `clmul-x86` (`clmul-arm`) is called behind the AES check and from a
+    // function gated on the AES target of its architecture.
+    let dir = test_dir::TestDir::new();
+    let good = COVERS_PROBE.replace("REVERSE", "");
+    for release in [false, true] {
+        let args: &[&str] = if release {
+            &["run", "--release"]
+        } else {
+            &["run"]
+        };
+        let out = velt(&dir, &good, MAIN_PROBE, args);
+        let stderr = String::from_utf8_lossy(&out.stderr);
+        assert!(out.status.success(), "{stderr}");
+    }
+    // The carry-less check, or a function gated on the carry-less target, does not cover AES.
+    for (arch, reverse) in [
+        (
+            "x86",
+            "if (u64x2.hasClmulX86()) {\n    n += aesX86();\n  }",
+        ),
+        (
+            "arm",
+            "if (u64x2.hasClmulArm()) {\n    n += aesArm();\n  }",
+        ),
+    ] {
+        let message = format!(
+            "`aes{}` runs only where the CPU has `aes-{arch}`, so it must be called behind that check",
+            if arch == "x86" { "X86" } else { "Arm" }
+        );
+        check_fails(
+            &COVERS_PROBE.replace("REVERSE", reverse),
+            MAIN_PROBE,
+            &[&message],
+        );
+    }
+    let from_clmul = "\nfunction fromClmulX86(): i64 {\n  targetFeature(\"clmul-x86\");\n  return aesX86();\n}\n\nfunction fromClmulArm(): i64 {\n  targetFeature(\"clmul-arm\");\n  return aesArm();\n}\n";
+    check_fails(
+        &format!("{}{from_clmul}", COVERS_PROBE.replace("REVERSE", "")),
+        MAIN_PROBE,
+        &[
+            "`aesX86` runs only where the CPU has `aes-x86`, so it must be called behind that check",
+            "`aesArm` runs only where the CPU has `aes-arm`, so it must be called behind that check",
+        ],
+    );
+}
+
+/// What the CPU has, as `u8x16.hasAesX86()` / `hasAesArm()` define it (std/simd/aes.vlt): AES-NI
+/// with PCLMULQDQ, SSSE3 and SSE4.1, or FEAT_PMULL (which implies FEAT_AES).
+fn cpu_has_aes() -> (bool, bool) {
+    #[cfg(target_arch = "x86_64")]
+    {
+        let x86 = std::arch::is_x86_feature_detected!("aes")
+            && std::arch::is_x86_feature_detected!("pclmulqdq")
+            && std::arch::is_x86_feature_detected!("ssse3")
+            && std::arch::is_x86_feature_detected!("sse4.1");
+        (x86, false)
+    }
+    #[cfg(target_arch = "aarch64")]
+    {
+        (false, std::arch::is_aarch64_feature_detected!("pmull"))
+    }
+    #[cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))]
+    {
+        (false, false)
+    }
+}
+
+#[test]
+fn the_aes_checks_follow_the_cpu_and_velt_simd_disable() {
+    // A release build (debug builds report no extension): the checks answer what the CPU has,
+    // and false with `VELT_SIMD_DISABLE=aes` or `clmul`.
+    let dir = test_dir::TestDir::new();
+    let main = "import { u8x16 } from \"velt/simd\";\n\nfunction main() {\n  console.log(u8x16.hasAes(), u8x16.hasAesX86(), u8x16.hasAesArm());\n}\n";
+    let exe = dir
+        .path()
+        .join(format!("aes_checks{}", std::env::consts::EXE_SUFFIX));
+    let out = velt(
+        &dir,
+        "export const unused = 0;\n",
+        main,
+        &["build", "--release", "-o", exe.to_str().unwrap()],
+    );
+    assert!(
+        out.status.success(),
+        "{}",
+        String::from_utf8_lossy(&out.stderr)
+    );
+    let (x86, arm) = cpu_has_aes();
+    for (disable, want) in [
+        (None, (x86 || arm, x86, arm)),
+        (Some("aes"), (false, false, false)),
+        (Some("clmul"), (false, false, false)),
+        (Some("sha,aes"), (false, false, false)),
+    ] {
+        let mut cmd = no_window::command(&exe);
+        match disable {
+            Some(v) => cmd.env("VELT_SIMD_DISABLE", v),
+            None => cmd.env_remove("VELT_SIMD_DISABLE"),
+        };
+        let run = cmd.output().unwrap();
+        assert!(run.status.success(), "{disable:?}");
+        assert_eq!(
+            String::from_utf8_lossy(&run.stdout).trim(),
+            format!("{} {} {}", want.0, want.1, want.2),
+            "VELT_SIMD_DISABLE={disable:?}"
+        );
+    }
+}
