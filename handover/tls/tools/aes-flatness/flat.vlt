// Instructions for 2,000 rounds of one AES method (OP, 0 to 8) on the byte BYTE in every lane.
import { u8x16 } from "velt/simd";

function main() {
  const op = Number.parseInt(process.env.OP ?? "0", 10);
  const b = Number.parseInt(process.env.BYTE ?? "0", 16) as u8;
  let x = u8x16.splat(b);
  const k = u8x16.splat(b);
  for (let i = 0; i < 2000; i++) {
    if (op == 0) {
      x = x.aesenc(k);
    } else if (op == 1) {
      x = x.aesenclast(k);
    } else if (op == 2) {
      x = x.aesdec(k);
    } else if (op == 3) {
      x = x.aesdeclast(k);
    } else if (op == 4) {
      x = x.aesimc();
    } else if (op == 5) {
      x = x.aeskeygenassist(1);
    } else if (op == 6) {
      x = x.aese(k);
    } else if (op == 7) {
      x = x.aesd(k);
    } else {
      x = x.aesmc();
    }
  }
  console.log((x.lane(0) as u32) | 0x100);
}
