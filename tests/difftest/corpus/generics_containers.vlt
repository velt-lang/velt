// A generic stack class and generic helper functions over Comparable.
class Stack<T> {
  items: T[] = [];
  push(x: T) {
    this.items.push(x);
  }
  size(): number {
    return this.items.length;
  }
}

// Returns an index: assigning an element (`best = x`) would move it out of the array when T
// isn't Copy, and generic bodies are checked as if it never is.
function largest<T extends Comparable<T>>(xs: T[]): number {
  let best = 0;
  for (let i: number = 1; i < xs.length; i++) {
    if (xs[i] > xs[best as usize]) {
      best = i as number;
    }
  }
  return best;
}

function main() {
  const s = new Stack<string>();
  s.push("a");
  s.push("b");
  const n = new Stack<number>();
  for (let i = 0; i < 5; i++) {
    n.push(i * i);
  }
  console.log(s.size(), n.size(), n.items, s.items);
  console.log(largest([3, 9, 2]), largest([1.5, -2.0]), largest(["pear", "fig", "zoo"]));
}
