// Caesar cipher and ROT13 over ASCII letters.
function shift(s: string, k: number): string {
  let out = "";
  for (let i = 0; i < (s.length as number); i++) {
    const c = s.charCodeAt(i);
    if (c >= 65 && c <= 90) {
      out += String.fromCharCode(((c - 65 + k) % 26 + 26) % 26 + 65);
    } else if (c >= 97 && c <= 122) {
      out += String.fromCharCode(((c - 97 + k) % 26 + 26) % 26 + 97);
    } else {
      out += s.slice(i, i + 1);
    }
  }
  return out;
}

function main() {
  const msg = "The Quick Brown Fox Jumps Over The Lazy Dog!";
  const enc = shift(msg, 3);
  console.log(enc);
  console.log(shift(enc, -3));
  console.log(shift(shift(msg, 13), 13) == msg, shift("abc xyz", 13));
}
