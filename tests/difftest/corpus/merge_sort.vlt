// Merge sort (recursive, new arrays) on ints and strings via a generic merge.
function mergeSort(xs: i64[]): i64[] {
  if (xs.length <= 1) {
    return xs.slice(0);
  }
  const mid = (xs.length - (xs.length % 2)) / 2;
  const a = mergeSort(xs.slice(0, mid as i64));
  const b = mergeSort(xs.slice(mid as i64));
  const out: i64[] = [];
  let i: usize = 0;
  let j: usize = 0;
  while (i < a.length && j < b.length) {
    if (a[i] <= b[j]) {
      out.push(a[i]);
      i++;
    } else {
      out.push(b[j]);
      j++;
    }
  }
  while (i < a.length) {
    out.push(a[i]);
    i++;
  }
  while (j < b.length) {
    out.push(b[j]);
    j++;
  }
  return out;
}

function main() {
  const data = [38, 27, 43, 3, 9, 82, 10, -5, 27, 0, 100, -99];
  console.log(JSON.stringify(mergeSort(data)));
  console.log(JSON.stringify(mergeSort([])), JSON.stringify(mergeSort([1])), JSON.stringify(data));
}
