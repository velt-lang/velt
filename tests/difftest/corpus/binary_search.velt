// Binary search (iterative and recursive) over a sorted array.
function search(xs: number[], target: number): number {
  let lo = 0;
  let hi = xs.length as number - 1;
  while (lo <= hi) {
    const mid = lo + ((hi - lo) >> 1);
    const v = xs[mid as usize];
    if (v == target) {
      return mid;
    }
    if (v < target) {
      lo = mid + 1;
    } else {
      hi = mid - 1;
    }
  }
  return -1;
}

function searchRec(xs: number[], target: number, lo: number, hi: number): number {
  if (lo > hi) {
    return -1;
  }
  const mid = lo + ((hi - lo) >> 1);
  const v = xs[mid as usize];
  if (v == target) {
    return mid;
  }
  return v < target ? searchRec(xs, target, mid + 1, hi) : searchRec(xs, target, lo, mid - 1);
}

function main() {
  const xs: number[] = [];
  for (let i = 0; i < 50; i++) {
    xs.push(i * 3 - 20);
  }
  for (const t of [-20, -19, 0, 1, 34, 127, 200]) {
    console.log(t, search(xs, t), searchRec(xs, t, 0, xs.length as number - 1));
  }
}
