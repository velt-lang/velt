// Getters and setters with validation, a static constant, private state.
class Temperature {
  static readonly ABSOLUTE_ZERO: f64 = -273.15;
  private celsius: f64 = 0.0;
  get c(): f64 {
    return this.celsius;
  }
  set c(v: f64) {
    this.celsius = v < Temperature.ABSOLUTE_ZERO ? Temperature.ABSOLUTE_ZERO : v;
  }
  get f(): f64 {
    return (this.celsius * 9.0) / 5.0 + 32.0;
  }
  set f(v: f64) {
    this.c = ((v - 32.0) * 5.0) / 9.0;
  }
}

function main() {
  const t = new Temperature();
  t.c = 25.0;
  console.log(`${t.c} ${t.f}`);
  t.f = 212.0;
  console.log(`${t.c} ${t.f}`);
  t.c = -500.0;
  console.log(`${t.c} ${t.f}`);
  t.c += 10.0;
  console.log(`${t.c}`);
}
