// do/while loops: digit reversal, digital root, base conversion.
function reverseDigits(n: number): number {
  let r = 0;
  do {
    r = r * 10 + (n % 10);
    n = (n - (n % 10)) / 10;
  } while (n > 0);
  return r;
}

function digitalRoot(n: number): number {
  while (n >= 10) {
    let s = 0;
    do {
      s += n % 10;
      n = (n - (n % 10)) / 10;
    } while (n > 0);
    n = s;
  }
  return n;
}

function toBase(n: number, b: number): string {
  const digits = "0123456789abcdefghijklmnopqrstuvwxyz";
  let out = "";
  do {
    const d = n % b;
    out = digits.slice(d, d + 1) + out;
    n = (n - d) / b;
  } while (n > 0);
  return out;
}

function main() {
  for (const n of [0, 7, 120, 12345, 9876543210]) {
    console.log(n, reverseDigits(n), digitalRoot(n), toBase(n, 2), toBase(n, 16), toBase(n, 36));
  }
}
