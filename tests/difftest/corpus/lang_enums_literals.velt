// TS enums (string and numeric, auto-increment), literal types (string, number, bool) in
// parameters, fields and unions, exhaustive switches over them, and literal values widening to
// their base types.
enum Color {
  Red = "RED",
  Green = "GREEN",
  Blue = "BLUE",
}

enum Level {
  Low,
  Mid = 10,
  High,
  Max = 100,
}

type Dir = "up" | "down" | "left" | "right";
type Die = 1 | 2 | 3 | 4 | 5 | 6;

class Light {
  color: Color;
  on: bool;
  constructor(color: Color) {
    this.color = color;
    this.on = false;
  }
  next(): Color {
    switch (this.color) {
      case Color.Red:
        return Color.Green;
      case Color.Green:
        return Color.Blue;
      case Color.Blue:
        return Color.Red;
    }
  }
}

function move(x: i64, y: i64, d: Dir): string {
  switch (d) {
    case "up":
      return `${x},${y - 1}`;
    case "down":
      return `${x},${y + 1}`;
    case "left":
      return `${x - 1},${y}`;
    case "right":
      return `${x + 1},${y}`;
  }
}

function opposite(d: Dir): Dir {
  if (d == "up") {
    return "down";
  }
  if (d == "down") {
    return "up";
  }
  return d == "left" ? "right" : "left";
}

function score(d: Die): i64 {
  switch (d) {
    case 1:
      return 100;
    case 5:
      return 50;
    default:
      return 0;
  }
}

function levelName(l: Level): string {
  switch (l) {
    case Level.Low:
      return "low";
    case Level.Mid:
    case Level.High:
      return "mid-high";
    default:
      return "max";
  }
}

function main() {
  const light = new Light(Color.Red);
  const seen: Color[] = [];
  for (let i = 0; i < 5; i++) {
    seen.push(light.color);
    light.color = light.next();
  }
  console.log(
    seen.map((c) => `${c}`).join(" > "),
    `${light.color}`,
    JSON.stringify({ c: light.color, on: light.on }),
  );
  console.log(Color.Green == Color.Green, Color.Red != Color.Blue, `${Color.Blue}`.toLowerCase());
  const s: string = Color.Red;
  console.log(s.length, s);
  const levels: Level[] = [Level.Low, Level.Mid, Level.High, Level.Max];
  for (const l of levels) {
    console.log(l, levelName(l), (l as i64) * 2);
  }
  const dirs: Dir[] = ["up", "right", "down", "left"];
  let pos = "0,0";
  for (const d of dirs) {
    pos = move(1, 1, d);
    console.log(d, pos, opposite(d), opposite(opposite(d)) == d);
  }
  const rolls: Die[] = [1, 3, 5, 6, 1];
  let total = 0;
  for (const r of rolls) {
    total += score(r);
  }
  console.log(total, JSON.stringify(rolls));
  const flag: true = true;
  const both: bool = flag && total > 100;
  console.log(flag, both);
}
