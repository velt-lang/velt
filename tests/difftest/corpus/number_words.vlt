// Spelling out numbers in English words. (Word tables come from functions: a module-level
// `const` array is not a constant expression in Velt.)
function ones(i: i64): string {
  const words = "zero one two three four five six seven eight nine ten eleven twelve thirteen fourteen fifteen sixteen seventeen eighteen nineteen".split(
    " ",
  );
  return `${words[i as usize]}`;
}

function tens(i: i64): string {
  const words = ",,twenty,thirty,forty,fifty,sixty,seventy,eighty,ninety".split(",");
  return `${words[i as usize]}`;
}

function words(n: i64): string {
  if (n < 20) {
    return ones(n);
  }
  if (n < 100) {
    const rest = n % 10;
    return rest == 0 ? tens((n - (n % 10)) / 10) : `${tens((n - (n % 10)) / 10)}-${ones(rest)}`;
  }
  if (n < 1000) {
    const rest = n % 100;
    return rest == 0
      ? `${words((n - (n % 100)) / 100)} hundred`
      : `${words((n - (n % 100)) / 100)} hundred and ${words(rest)}`;
  }
  const rest = n % 1000;
  return rest == 0
    ? `${words((n - (n % 1000)) / 1000)} thousand`
    : `${words((n - (n % 1000)) / 1000)} thousand ${words(rest)}`;
}

function main() {
  for (const n of [0, 7, 13, 20, 42, 99, 100, 101, 342, 1000, 1999, 21021, 999999]) {
    console.log(n, words(n));
  }
}
