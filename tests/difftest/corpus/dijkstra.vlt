// Dijkstra's shortest paths on a small weighted graph (adjacency lists, linear-scan queue).
class Edge {
  to: i64;
  w: i64;
  constructor(to: i64, w: i64) {
    this.to = to;
    this.w = w;
  }
}

function main() {
  const n = 6;
  const adj: Edge[][] = [];
  for (let i = 0; i < n; i++) {
    adj.push([]);
  }
  const edges = [
    [0, 1, 7],
    [0, 2, 9],
    [0, 5, 14],
    [1, 2, 10],
    [1, 3, 15],
    [2, 3, 11],
    [2, 5, 2],
    [3, 4, 6],
    [4, 5, 9],
  ];
  for (const e of edges) {
    adj[e[0] as usize].push(new Edge(e[1], e[2]));
    adj[e[1] as usize].push(new Edge(e[0], e[2]));
  }
  const dist: i64[] = [];
  const done: bool[] = [];
  const prev: i64[] = [];
  for (let i = 0; i < n; i++) {
    dist.push(1000000);
    done.push(false);
    prev.push(-1);
  }
  dist[0] = 0;
  for (let round = 0; round < n; round++) {
    let u = -1;
    for (let i = 0; i < n; i++) {
      if (!done[i as usize] && (u < 0 || dist[i as usize] < dist[u as usize])) {
        u = i;
      }
    }
    done[u as usize] = true;
    for (const e of adj[u as usize]) {
      const nd = dist[u as usize] + e.w;
      if (nd < dist[e.to as usize]) {
        dist[e.to as usize] = nd;
        prev[e.to as usize] = u;
      }
    }
  }
  console.log(JSON.stringify(dist));
  let path = "4";
  let cur = 4;
  while (prev[cur as usize] >= 0) {
    cur = prev[cur as usize];
    path = `${cur}->${path}`;
  }
  console.log(path);
}
