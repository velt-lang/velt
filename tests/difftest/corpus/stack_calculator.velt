// Reverse Polish notation evaluator with error handling.
class CalcError extends Error {
  constructor(message: string) {
    super(message);
  }
}

function rpn(expr: string): f64 {
  const stack: f64[] = [];
  for (const tok of expr.split(" ")) {
    if (tok == "+" || tok == "-" || tok == "*" || tok == "/") {
      const b = stack.pop();
      const a = stack.pop();
      if (a == null || b == null) {
        throw new CalcError(`stack underflow at ${tok}`);
      }
      if (tok == "+") {
        stack.push(a + b);
      } else if (tok == "-") {
        stack.push(a - b);
      } else if (tok == "*") {
        stack.push(a * b);
      } else {
        stack.push(a / b);
      }
    } else {
      const v = parseFloat(tok);
      if (v != v) {
        throw new CalcError(`bad token ${tok}`);
      }
      stack.push(v);
    }
  }
  if (stack.length != 1) {
    throw new CalcError(`${stack.length} values left`);
  }
  return stack[0];
}

function main() {
  for (const e of [
    "3 4 +",
    "5 1 2 + 4 * + 3 -",
    "2 3 4 * +",
    "1 +",
    "1 2",
    "4 x *",
    "1 3 /",
    "0 0 /",
  ]) {
    try {
      console.log(`${e} => ${rpn(e)}`);
    } catch (err) {
      console.log(`${e} => error: ${err.message}`);
    }
  }
}
