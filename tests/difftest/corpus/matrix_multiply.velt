// Matrix multiplication and transpose on nested number arrays.
function multiply(a: number[][], b: number[][]): number[][] {
  const out: number[][] = [];
  for (let i: number = 0; i < a.length; i++) {
    const row: number[] = [];
    for (let j: number = 0; j < b[0].length; j++) {
      let sum = 0;
      for (let k: number = 0; k < b.length; k++) {
        sum += a[i][k] * b[k][j];
      }
      row.push(sum);
    }
    out.push(row);
  }
  return out;
}

function transpose(m: number[][]): number[][] {
  const out: number[][] = [];
  for (let j: number = 0; j < m[0].length; j++) {
    out.push(m.map((row) => row[j]));
  }
  return out;
}

function main() {
  const a = [
    [1, 2, 3],
    [4, 5, 6],
  ];
  const b = [
    [7, 8],
    [9, 10],
    [11, 12],
  ];
  const c = multiply(a, b);
  console.log(c);
  console.log(transpose(a));
  console.log(multiply(c, transpose(c)));
}
