// Function composition and pipelines of closures stored in arrays.
function compose(f: (x: number) => number, g: (x: number) => number): (x: number) => number {
  return (x: number): number => g(f(x));
}

function pipeline(fs: ((x: number) => number)[], x: number): number {
  let v = x;
  for (const f of fs) {
    v = f(v);
  }
  return v;
}

function main() {
  // Each closure value is used once: passing one to `compose` (which stores it) moves it in Velt.
  const h = compose(
    compose((x: number): number => x + 1, (x: number): number => x * 2),
    (x: number): number => x * x,
  );
  console.log(h(1), h(5));
  const sq = (x: number): number => x * x;
  const steps: ((x: number) => number)[] = [
    (x: number): number => x * 2,
    (x: number): number => x + 1,
    (x: number): number => x * x,
    (x: number): number => x + 1,
  ];
  console.log(pipeline(steps, 3), pipeline([], 7));
  const evens = [1, 2, 3, 4, 5, 6].filter((x) => x % 2 == 0).map(sq);
  console.log(evens);
}
