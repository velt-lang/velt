// Sieve of Eratosthenes: primes below 100, their count and sum.
function sieve(n: i64): i64[] {
  const marks: bool[] = [];
  for (let i = 0; i < n; i++) {
    marks.push(true);
  }
  const primes: i64[] = [];
  for (let i = 2; i < n; i++) {
    if (marks[i as usize]) {
      primes.push(i);
      for (let j = i * i; j < n; j += i) {
        marks[j as usize] = false;
      }
    }
  }
  return primes;
}

function main() {
  const ps = sieve(100);
  console.log(ps.length, ps.reduce((a, b) => a + b, 0));
  console.log(ps.slice(0, 6), ps.slice(-3));
  console.log(ps.map((p) => `${p}`).join(" "));
}
