// Float accumulation order, rounding helpers and special values.
function main() {
  let a = 0.0;
  for (let i = 0; i < 10; i++) {
    a += 0.1;
  }
  let b = 0.0;
  for (let i = 0; i < 1000; i++) {
    b += 1.0 / 3.0;
  }
  console.log(`${a} ${b} ${a == 1.0} ${Math.abs(a - 1.0) < 1e-9}`);
  const xs: f64[] = [1e308, 1e308, -1e308];
  console.log(`${xs[0] + xs[1] + xs[2]} ${xs[0] + (xs[1] + xs[2])}`);
  console.log(
    `${Math.floor(-0.5)} ${Math.ceil(-0.5)} ${Math.round(-0.5)} ${Math.round(2.5)} ${Math.round(-2.5)} ${Math.trunc(-0.9)}`,
  );
  console.log(`${0.1 * 3.0} ${0.3 / 0.1} ${2.0 ** 0.5} ${Math.sqrt(2.0)} ${(-8.0) ** (1.0 / 3.0)}`);
  console.log(`${5e-324 / 2.0} ${1.7976931348623157e308 * 1.0000001} ${-1.0 / 0.0} ${0.0 * -1.0}`);
}
