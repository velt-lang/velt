// A fixed-size ring buffer with overwrite, iteration order and statistics.
class Ring {
  data: i64[] = [];
  start: i64 = 0;
  count: i64 = 0;
  cap: i64;
  constructor(cap: i64) {
    this.cap = cap;
    for (let i = 0; i < cap; i++) {
      this.data.push(0);
    }
  }
  push(v: i64) {
    const idx = (this.start + this.count) % this.cap;
    this.data[idx as usize] = v;
    if (this.count < this.cap) {
      this.count++;
    } else {
      this.start = (this.start + 1) % this.cap;
    }
  }
  items(): i64[] {
    const out: i64[] = [];
    for (let i = 0; i < this.count; i++) {
      out.push(this.data[((this.start + i) % this.cap) as usize]);
    }
    return out;
  }
}

function main() {
  const r = new Ring(4);
  for (let v = 1; v <= 10; v++) {
    r.push(v * v);
    if (v % 3 == 0) {
      console.log(v, JSON.stringify(r.items()));
    }
  }
  const xs = r.items();
  console.log(xs.reduce((a, b) => a + b, 0), r.start, r.count);
}
