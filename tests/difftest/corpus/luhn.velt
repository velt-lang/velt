// Luhn checksum validation of card-like numbers.
function luhn(s: string): bool {
  let sum = 0;
  let double = false;
  for (let i = s.length as i64 - 1; i >= 0; i--) {
    const c = s.charCodeAt(i);
    if (c < 48 || c > 57) {
      continue;
    }
    let d = c - 48;
    if (double) {
      d *= 2;
      if (d > 9) {
        d -= 9;
      }
    }
    sum += d;
    double = !double;
  }
  return sum % 10 == 0;
}

function main() {
  for (const s of ["4539 3195 0343 6467", "8273 1232 7352 0569", "79927398713", "0", ""]) {
    console.log(`"${s}" ${luhn(s)}`);
  }
}
