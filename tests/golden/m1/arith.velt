function main(): void {
  const a = 7;
  const b = 3;
  console.log(a + b, a - b, a * b, a / b, a % b);
  console.log(-a / b, -a % b);
  console.log(2 + 3 * 4 - (10 - 4) / 2);
  const x: f64 = 1.5;
  const y = 2.25;
  console.log(x + y, x * y, y / x);
  console.log(10.0, 0.1 + 0.2, 1e21, 5 as f64 / 2.0);
  console.log(a > b, a == b, a != b, !(a <= b) && true || false);
  const small: i32 = 100000;
  console.log(small * 3, (small as i64) * 100000);
  const u: u8 = 250;
  console.log(u + 5, 300 as u8);
  console.log(7 & 3, 7 | 8, 7 ^ 2, 1 << 10, -16 >> 2, ~0);
}
