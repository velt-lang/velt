// Tasks started with `spawn` keep the program alive after `main` returns, until they are done.

async function background(name: string, ms: i64): Promise<void> {
  await sleep(ms);
  console.log(`${name} done`);
}

async function main() {
  spawn(background("first", 30));
  spawn(background("second", 60));
  console.log("main returns");
}
