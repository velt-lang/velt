async function delayed(ms: i64, v: i64): Promise<i64> {
  await sleep(ms);
  return v;
}

async function sumAll(xs: i64[]): Promise<i64> {
  let total = 0;
  for (const x of xs) {
    total += await delayed(1, x);
  }
  return total;
}

// Three 200 ms sleeps awaited together; 1.
async function threeSleeps(): Promise<i64> {
  await Promise.all([sleep(200), sleep(200), sleep(200)]);
  return 1;
}

async function main() {
  const a = await delayed(10, 1);
  console.log("a", a);

  // Both calls start at once and run concurrently (a literal array is joined in place).
  const [x, y] = await Promise.all([delayed(30, 2), delayed(10, 3)]);
  console.log(x, y);

  // Concurrent: the three sleeps end together, before a 450 ms timer created after them (timers
  // of one task fire by deadline, however late the task runs); one after the other they would
  // end at 600 ms. Sleeps never end early.
  const start = performance.now();
  const first = await Promise.race([threeSleeps(), delayed(450, 0)]);
  console.log(performance.now() - start >= 199.0, first == 1);

  const h = spawn(delayed(5, 42));
  console.log(await h);
  console.log(await sumAll([1, 2, 3, 4]));
}
