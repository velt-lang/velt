// check: no leaks
// A promise may have several consumers, as in TypeScript: `then` and a later `await` both get
// the value (#212).

async function value(n: number): Promise<number> {
  return n;
}

async function main() {
  const p = value(1);
  p.then((v) => console.log("then", v));
  p.then((v) => console.log("then again", v));
  console.log("await", await p);
}
