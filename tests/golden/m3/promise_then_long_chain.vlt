// A long chain of callbacks, each promise awaiting the one before it, runs in constant stack
// space and linear time, as in Node: `p = p.then(f)` 100,000 times, then the same through
// `catch` and `finally`.

class Failed extends Error {}

async function fail(message: string): Promise<number, Failed> {
  throw new Failed(message);
}

async function main() {
  const n = 100000;
  let p: Promise<number> = Promise.resolve(0);
  for (let i = 0; i < n; i++) {
    p = p.then((a) => a + i);
  }
  console.log(await p);

  let q: Promise<number, Failed> = fail("first");
  for (let i = 0; i < n; i++) {
    q = q.finally(() => {}).catch((e) => i);
  }
  console.log(await q);

  let r: Promise<number> = Promise.resolve(1);
  for (let i = 0; i < n; i++) {
    r = r.then((a) => Promise.resolve(a + 1));
  }
  console.log(await r);
}
