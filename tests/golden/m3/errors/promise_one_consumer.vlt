// A promise has one consumer: `then` takes it, so it can't also be awaited (TypeScript lets
// several consumers share one promise). The error says so and shows how to chain instead.

async function value(n: number): Promise<number> {
  return n;
}

async function main() {
  const p = value(1);
  p.then((v) => console.log(v));
  console.log(await p);
}
