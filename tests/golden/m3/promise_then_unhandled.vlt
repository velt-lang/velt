// A rejection that passes through `then` and nobody handles is uncaught, as in Node: the process
// exits with code 1 after the code that was running.

class Failed extends Error {}

async function fail(message: string): Promise<number, Failed> {
  throw new Failed(message);
}

async function main() {
  fail("nobody handles this").then((v) => console.log(`value ${v}`));
  console.log("main returns");
}
