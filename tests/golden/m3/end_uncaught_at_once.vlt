// An error escaping `main` is reported at once and ends the program: it does not wait for the
// promises still running (the race's loser), as in Node.

// The loser sleeps 5 s, so only a runtime that waits for it prints its line, however loaded.
async function slow(): Promise<string> {
  await sleep(5000);
  console.log("the loser finished");
  return "slow";
}

async function fails(): Promise<string> {
  await Promise.resolve(0);
  throw new Error("bad");
}

async function main() {
  console.log(await Promise.race([slow(), fails()]));
}
