// `Array.from({ length: n }, () => v)`: a callback that takes neither the element (always
// `undefined`) nor the index. Same output as Node.
function main() {
  const n = 3;
  const zeros: number[] = Array.from({ length: n }, () => 0);
  console.log(zeros);
  const rows = Array.from({ length: 2 }, () => [] as string[]);
  rows[0].push("a");
  console.log(rows);
  console.log(Array.from({ length: 3 }, (_, i) => i * 2));
}
