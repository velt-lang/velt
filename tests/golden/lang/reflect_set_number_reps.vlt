// Reflect.set and a write through a Proxy, on fields of each number representation (#1632).
class O { x: number = 1; y: i64 = 2; z: f64 = 3; w: u8 = 4; }
const o = new O();
console.log(Reflect.set(o, "x", 5), Reflect.set(o, "y", 6), Reflect.set(o, "z", 7.5), Reflect.set(o, "w", 8));
console.log(o.x, o.y, o.z, o.w);
const p = new Proxy(o, {});
p.x = 9;
p.y = 10;
p.z = 11.5;
p.w = 12;
console.log(o.x, o.y, o.z, o.w);
