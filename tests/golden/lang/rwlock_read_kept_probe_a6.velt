// check: no leaks
// An RwLock read probe (#1559): prints what Node prints.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Holder {
  rows: number[][] = [];
}
function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const out: number[][][] = [];
  a.read((x) => {
    let keep: number[][] = [];
    b.read((y) => {
      const c: number[][] = [[y.items.length]];
      out.push(c);
      keep = c;
    });
    out.pop();
    keep.push([3]);
    console.log(JSON.stringify(keep));
  });
  console.log(JSON.stringify(out));
}
