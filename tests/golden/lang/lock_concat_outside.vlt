// check: no leaks
// `concat` makes a new array and changes neither of its arrays, so a `with` or `read` callback
// can join the locked value's array with an array from outside it (`c.items.concat(out)`), and
// the outside array stays usable afterwards (#1523). Helpers that push into an array of their
// own and return it are the same: only a store into a parameter, or into a part of one, keeps
// what is stored.
class Box {
  items: number[][] = [[1, 2], [3]];
}

function joined(a: number[][], b: number[][]): number[][] {
  const r: number[][] = [];
  for (const x of a) {
    r.push(x);
  }
  for (const x of b) {
    r.push(x);
  }
  return r;
}

function main() {
  const mx = shared(new Mutex<Box>(new Box()));
  const rw = new RwLock(new Box());
  const out: number[][] = [[9]];
  let fromMutex: number[][] = [];
  let fromRead: number[][] = [];
  let helper: number[][] = [];
  mx.with((c) => {
    fromMutex = c.items.concat(out);
  });
  rw.read((c) => {
    fromRead = c.items.concat(out);
    helper = joined(c.items, out);
  });
  out.push([8]);
  mx.with((c) => {
    c.items = [];
  });
  rw.write((c) => {
    c.items = [];
  });
  console.log(out, fromMutex, fromRead, helper);
}
