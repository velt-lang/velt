// A struct argument is a copy (#641): a closure that assigns the caller's variable while the
// callee runs does not change what the callee reads. Sizes above 16 bytes, 16 bytes and 5
// bytes (WebAssembly passes all of them by pointer).

struct Big {
  a: number;
  b: number;
  c: number;
  d: number;
}

struct P {
  x: number;
  y: number;
}

struct Five {
  a: u8;
  b: u8;
  c: u8;
  d: u8;
  e: u8;
}

function setv(n: number): Big {
  return { a: n, b: n, c: n, d: n };
}

function r1(v: Big, f: () => void): number {
  f();
  return v.a;
}

function r2(f: () => void, v: Big): number {
  f();
  return v.a;
}

function r3(v: Big, k: number): number {
  return v.a + k;
}

function r4(v: Big, w: Big, f: () => void): number {
  f();
  return v.a + w.a * 10;
}

function rp(v: P, f: () => void): number {
  f();
  return v.x + v.y;
}

function r5(v: Five, f: () => void): number {
  f();
  return v.a + v.e;
}

// A param that a later argument assigns, and one a closure assigns: the callee still reads
// the value the param had when the call began.
function laterArg(v: Big): number {
  return r3(v, (v = setv(2)).a);
}

function closureArg(v: Big): number {
  return r1(v, () => {
    v = setv(9);
  });
}

function reassign(v: Big): number {
  v = setv(9);
  return v.a;
}

function main() {
  let l: Big = setv(1);
  console.log(
    r1(l, () => {
      l = setv(9);
    }),
  );
  l = setv(1);
  console.log(
    r2(
      () => {
        l = setv(9);
      },
      l,
    ),
  );
  l = setv(1);
  console.log(
    r3(
      l,
      (() => {
        l = setv(9);
        return 1;
      })(),
    ),
  );
  l = setv(1);
  console.log(
    r4(l, l, () => {
      l = setv(9);
    }),
  );
  let y: Big = setv(1);
  function g(): number {
    y = setv(9);
    return 1;
  }
  console.log(r3(y, g()));
  let w: Big = setv(1);
  const k = () => {
    w = setv(9);
    return 1;
  };
  console.log(r3(w, k()));
  let p: P = { x: 1, y: 2 };
  console.log(
    rp(p, () => {
      p = { x: 9, y: 9 };
    }),
  );
  let five: Five = { a: 1, b: 0, c: 0, d: 0, e: 5 };
  console.log(
    r5(five, () => {
      five = { a: 9, b: 9, c: 9, d: 9, e: 9 };
    }),
  );
  const m = setv(1);
  console.log(reassign(m), m.a);
  console.log(laterArg(setv(1)), closureArg(setv(1)));
}
