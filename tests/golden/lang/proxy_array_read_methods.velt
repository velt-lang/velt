// The array methods that read a proxy of an array (and `reverse` and `sort`, which write it):
// Node's generic algorithms run with the proxy as `this`, so every read of `length` or of an
// element, `in` test, write and delete goes through the traps, in the order logged.
// check: no leaks
function logging(log: string[]): ProxyHandler<any> {
  return {
    get(t: any, k: string | symbol, r: any): any {
      log.push(`get ${String(k)}`);
      return Reflect.get(t, k, r);
    },
    set(t: any, k: string | symbol, v: any, r: any): boolean {
      log.push(`set ${String(k)}=${v}`);
      return Reflect.set(t, k, v, r);
    },
    has(t: any, k: string | symbol): boolean {
      log.push(`has ${String(k)}`);
      return Reflect.has(t, k);
    },
    deleteProperty(t: any, k: string | symbol): boolean {
      log.push(`delete ${String(k)}`);
      return Reflect.deleteProperty(t, k);
    },
  };
}

function run(name: string, start: number[], f: (p: any) => any): void {
  const arr: number[] = start.slice();
  const log: string[] = [];
  const p: any = new Proxy(arr, logging(log));
  const r = f(p);
  const shown = r === undefined ? "undefined" : JSON.stringify(r);
  console.log(`${name}: ${shown} -> ${JSON.stringify(arr)}`);
  console.log(`  ${log.join(", ")}`);
}

run("map", [1, 2, 3], (p) => p.map((x: number) => x * 2));
run("map index", [5, 6], (p) => p.map((x: number, i: number) => i));
run("filter", [1, 2, 3, 4], (p) => p.filter((x: number) => x % 2 === 0));
run("forEach", [1, 2], (p) => {
  const seen: number[] = [];
  p.forEach((x: number, i: number) => {
    seen.push(x * 10 + i);
  });
  return seen;
});
run("includes", [1, 2, 3], (p) => p.includes(2));
run("includes absent", [1, 2], (p) => p.includes(5));
run("includes empty", [], (p) => p.includes(1));
run("includes from", [1, 2, 3], (p) => p.includes(1, 1));
run("indexOf", [4, 5, 6], (p) => p.indexOf(5));
run("indexOf absent", [4, 5], (p) => p.indexOf(9));
run("indexOf from", [4, 5, 4], (p) => p.indexOf(4, -1));
run("join", [1, 2, 3], (p) => p.join("-"));
run("join default", [1, 2], (p) => p.join());
run("slice", [1, 2, 3, 4], (p) => p.slice(1, 3));
run("slice negative", [1, 2, 3], (p) => p.slice(-2));
run("slice all", [1, 2], (p) => p.slice());
run("find", [1, 2, 3], (p) => p.find((x: number) => x > 1));
run("find none", [1, 2], (p) => p.find((x: number) => x > 5));
run("some", [1, 2, 3], (p) => p.some((x: number) => x === 2));
run("some none", [1, 2], (p) => p.some((x: number) => x > 5));
run("every", [1, 2, 3], (p) => p.every((x: number) => x > 0));
run("every stops", [1, 2, 3], (p) => p.every((x: number) => x < 2));
run("reverse", [1, 2, 3], (p) => p.reverse() === p);
run("reverse even", [1, 2, 3, 4], (p) => p.reverse() === p);
run("sort", [3, 1, 2], (p) => p.sort() === p);
run("sort compare", [1, 3, 2], (p) => p.sort((a: number, b: number) => b - a) === p);
run("sort strings", [10, 9, 1], (p) => p.sort() === p);
