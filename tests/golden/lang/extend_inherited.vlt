// An `extend` block's instance methods apply to subclasses of the class it extends, nearest
// base first, and `super.m()` finds them too.
class Shape {
  name(): string {
    return "shape";
  }
}

class Square extends Shape {
  override name(): string {
    return "square";
  }

  both(): string {
    return `${this.describe()} / ${super.describe()}`;
  }
}

class Tiny extends Square {}

// A static of the subclass doesn't hide an inherited `extend` instance method.
class Named extends Shape {
  static describe(): string {
    return "static";
  }
}

extend Shape {
  describe(): string {
    return `a ${this.name()}`;
  }
}

function main() {
  console.log(new Square().describe(), new Tiny().describe());
  console.log(new Square().both());
  console.log(new Named().describe(), Named.describe());
}
