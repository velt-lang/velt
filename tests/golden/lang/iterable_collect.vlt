// check: no leaks
import { Set } from "velt:collections/set";

// Collecting an iterable (#424): `Array.from(iterable)`, `Array.from(iterable, (v, i) => ...)`
// (the callback runs as each value arrives; a throw closes the iterator), `new Set(iterable)`
// and `new Map(iterable of [key, value])`. Arrays, strings and maps work as before.
class TooLong extends Error {}

function* letters(): Generator<string> {
  try {
    console.log("  start");
    yield "a";
    yield "bb";
    yield "a";
    yield "ccc";
  } finally {
    console.log("  letters closed");
  }
}

function* pairs(): Generator<[string, i64]> {
  yield ["x", 1];
  yield ["y", 2];
  yield ["x", 3];
}

class Countdown implements Iterator<i64> {
  constructor(private n: i64) {}

  next(): IteratorResult<i64> {
    if (this.n == 0) {
      return { done: true };
    }
    this.n--;
    return { value: this.n, done: false };
  }
}

class Countdowns implements Iterable<i64> {
  constructor(private n: i64) {}

  [Symbol.iterator](): Iterator<i64> {
    return new Countdown(this.n);
  }
}

function main() {
  console.log(Array.from(letters()));
  console.log(
    Array.from(letters(), (s, i) => {
      console.log(`  map ${s}`);
      return `${i}:${s}`;
    }),
  );
  console.log(Array.from(new Countdowns(3), (n) => n * 10));
  console.log(Array.from([1, 2, 3], (n, i) => n + i), Array.from("hey"));
  const m = new Map<string, i64>([["k", 1]]);
  console.log(Array.from(m));
  try {
    Array.from(letters(), (s) => {
      if (s.length > 1) {
        throw new TooLong(`too long: ${s}`);
      }
      return s;
    });
  } catch (e) {
    console.log("caught", e.message);
  }
  const s = new Set(letters());
  console.log(s.size, s.has("a"), s.has("ccc"), s.has("d"));
  const counts = new Set(new Countdowns(4));
  console.log(counts.size, counts.has(0), counts.has(4));
  const byKey = new Map(pairs());
  console.log(byKey.size, byKey.get("x"), byKey);
}
