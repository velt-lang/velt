// An async arrow where the expected function type returns a union with one promise member
// (`View | Promise<View>`): as in TS it returns that promise. `r instanceof Promise` tests for
// the promise member and narrows both branches.

import { delay } from "velt:timers";

type View = () => string;
type Setup = (n: i64) => View | Promise<View>;

// A sync or async setup, as a UI framework's `component(setup)` accepts.
function component(setup: Setup): (n: i64) => Promise<string> {
  return async (n: i64): Promise<string> => {
    const r = setup(n);
    const view = r instanceof Promise ? await r : r;
    return view();
  };
}

// The same with an `if`, and `Promise<T> | null`.
async function settle(r: View | Promise<View>): Promise<string> {
  if (r instanceof Promise) {
    const v = await r;
    return `awaited ${v()}`;
  }
  return `ready ${r()}`;
}

function maybe(make: (ok: boolean) => Promise<string> | null, ok: boolean): Promise<string> | null {
  return make(ok);
}

async function main() {
  const sync = component((n) => () => `sync ${n}`);
  const slow = component(async (n) => {
    await delay(10);
    return () => `slow ${n}`;
  });
  const annotated = component(async (n): Promise<View> => () => `annotated ${n}`);
  console.log(await sync(1), await slow(2), await annotated(3));

  console.log(await settle(() => "now"));
  console.log(await settle((async (): Promise<View> => () => "later")()));

  const p = maybe(async (ok) => (ok ? "yes" : "no"), true);
  console.log(p instanceof Promise ? await p : "none");
}
