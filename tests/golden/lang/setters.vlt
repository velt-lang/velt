// Setters: `set name(v)` runs on `x.name = v`; getter/setter pairs share a name; compound
// assignment and `++` go through both; interfaces, overrides and `extend` blocks.

interface Sized {
  get size(): i64;
  set size(v: i64);
}

class Buffer implements Sized {
  private data: i64[] = [];
  private label: string = "";
  writes: i64 = 0;

  get size(): i64 {
    return this.data.length as i64;
  }

  set size(v: i64) {
    this.writes++;
    while (this.data.length as i64 > v) {
      this.data.pop();
    }
    while ((this.data.length as i64) < v) {
      this.data.push(0);
    }
  }

  get name(): string {
    return this.label == "" ? "(unnamed)" : this.label;
  }

  set name(v: string) {
    this.label = v;
  }

  reset() {
    this.size = 0;
    this.name = "";
  }
}

class Clamped {
  value: i64 = 0;

  get level(): i64 {
    return this.value;
  }

  set level(v: i64) {
    this.value = v < 0 ? 0 : v;
  }
}

class Capped extends Clamped {
  override set level(v: i64) {
    this.value = v > 10 ? 10 : v < 0 ? 0 : v;
  }
}

struct Temp {
  celsius: f64;
}

extend Temp {
  get fahrenheit(): f64 {
    return this.celsius * 9.0 / 5.0 + 32.0;
  }

  set fahrenheit(f: f64) {
    this.celsius = (f - 32.0) * 5.0 / 9.0;
  }
}

function grow<T extends Sized>(x: T, by: i64) {
  x.size += by;
}

function setAll(xs: Clamped[], v: i64) {
  for (let i: usize = 0; i < xs.length; i++) {
    xs[i].level = v;
  }
}

function main() {
  const b = new Buffer();
  b.size = 3;
  console.log(b.size, b.name, b.writes);
  b.size += 2;
  b.size--;
  b.name = "log";
  b.name += "-1";
  console.log(b.size, b.name, b.writes);
  grow(b, 10);
  console.log(b.size);
  b.reset();
  console.log(b.size, b.name, b.writes);

  const levels: Clamped[] = [new Clamped(), new Capped()];
  setAll(levels, 42);
  console.log(levels[0].level, levels[1].level);
  levels[1].level = -5;
  console.log(levels[1].level);

  let t = Temp { celsius: 100.0 };
  console.log(t.fahrenheit);
  t.fahrenheit = 32.0;
  console.log(t.celsius);
  t.fahrenheit += 18.0;
  console.log(t.celsius);
}
