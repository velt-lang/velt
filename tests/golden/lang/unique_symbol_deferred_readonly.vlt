// A union with a member made from a type parameter: the member's slot is decided per instance, so
// a symbol that is not `K` stops at the test (#923). Here `Readonly<T>`. Node gives a TypeError on `undefined`;
// a thrown TypeError with another message is the accepted difference.
const K = Symbol("k");

function c<T>(x: any): T {
  return x as T;
}

function h<T>(x: Readonly<T> | typeof K, read: (p: Readonly<T>) => string): string {
  if (x !== K) {
    return read(x).toUpperCase();
  }
  return "k";
}

type Q = { n: string };
const read = (p: Readonly<Q>) => p.n;
console.log(h<Q>({ n: "a" }, read), h<Q>(K, read));
console.log(h<Q>(c<Readonly<Q> | typeof K>(Symbol("z")), read));
