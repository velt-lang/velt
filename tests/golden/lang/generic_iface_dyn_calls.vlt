// Generic interface methods called on interface values (#943): the method's table slot holds
// one entry per instantiation the program calls, for every implementation (generic classes and
// methods using deferred types included).
interface Box {
  wrap<T>(x: T): T[];
  name(): string;
}

class A implements Box {
  tag = "a";
  wrap<T>(x: T): T[] {
    return [x];
  }
  name(): string {
    return this.tag;
  }
}

class B<P> implements Box {
  constructor(public p: P) {}
  wrap<T>(x: T): T[] {
    return [x, x];
  }
  name(): string {
    return "b " + String(this.p);
  }
}

interface Mapper<K> {
  pair<V>(k: K, v: V): [K, V];
}

class M implements Mapper<string> {
  pair<V>(k: string, v: V): [string, V] {
    return [k + "!", v];
  }
}

type Tagged<T> = T extends string ? { s: T } : { v: T };

interface Tagger {
  tag<T>(x: T): Tagged<T>;
}

class T1 implements Tagger {
  tag<T>(x: T): Tagged<T> {
    return (typeof x === "string" ? { s: x } : { v: x }) as unknown as Tagged<T>;
  }
}

function useBox(b: Box): void {
  console.log(b.name(), b.wrap(1), b.wrap("s"), b.wrap([true]));
}

function gen<U>(b: Box, u: U): U[] {
  return b.wrap(u);
}

// An interface value at other type arguments, while another interface's generic method of the
// same name is called through interface values.
interface Holder<A> {
  wrap<T>(x: T): T[];
  get(): A;
}

class HC implements Holder<number> {
  wrap<T>(x: T): T[] {
    return [x];
  }
  get(): number {
    return 4;
  }
}

// A generic implementation made only where a generic function is instantiated, whose method
// needs a deferred type over its own type parameter and its class's.
interface Shower {
  show<T>(x: T): string;
}

class TB<P> implements Shower {
  p: P;
  constructor(p: P) {
    this.p = p;
  }
  show<T>(x: T): string {
    const w: Tagged<[T, P]>[] = [];
    return JSON.stringify(w) + String(x) + JSON.stringify(this.p);
  }
}

function mk<X>(x: X): Shower {
  return new TB<X[][]>([[x]]);
}

function twice<Y>(y: Y): Shower {
  return mk<Y[]>([y]);
}

function main(): void {
  const bs: Box[] = [new A(), new B(7)];
  for (const b of bs) useBox(b);
  console.log(gen(bs[1], { x: 1 }), gen(bs[0], 2.5));
  const m: Mapper<string> = new M();
  console.log(m.pair("k", 3), m.pair("j", null));
  const t: Tagger = new T1();
  console.log(t.tag(3), t.tag("s"));
  const h: Holder<unknown> = new HC();
  console.log(h.get());
  const sh = mk(1);
  console.log(sh.show(2), sh.show("s"), twice(true).show(3));
}
