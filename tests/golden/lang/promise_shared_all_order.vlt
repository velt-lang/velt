// check: no leaks
// Awaiters of shared promises inside one inline `Promise.all`, with `then` callbacks: each
// resumes in Node's order, interleaved with the other awaiters, callbacks and settles (#212).
async function tick(n: number): Promise<void> {
  for (let i = 0; i < n; i++) {
    await Promise.resolve();
  }
}

async function make(tag: string, n: number): Promise<string> {
  await tick(n);
  console.log(`settle ${tag}`);
  return tag;
}

async function w(name: string, p: Promise<string>, pre: number, post: number): Promise<string> {
  await tick(pre);
  console.log(`${name} waits`);
  const v = await p;
  console.log(`${name} got ${v}`);
  await tick(post);
  console.log(`${name} done`);
  return name;
}

async function main() {
  const p0 = make("p0", 0);
  p0.then((v) => console.log(`then p0 ${v}`));
  const p1 = make("p1", 4);
  p1.then((v) => console.log(`then p1 ${v}`));
  const p2 = make("p2", 1);
  const r = await Promise.all([
    w("a", p0, 3, 1),
    w("b", p0, 2, 0),
    w("c", p0, 1, 0),
    w("d", p2, 0, 0),
    w("e", p0, 1, 2),
    w("f", p1, 1, 2),
  ]);
  console.log(r.join(","));
}
