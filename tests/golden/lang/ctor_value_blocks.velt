// Classes as values kept in blocks: a class declared in a closure, a switch case, an if
// block or a loop body, and one read at signature types over type parameters in a generic
// method, an async function, a generator and a recursive function: one object per run of
// the declaring block (or per call), as Node gives here.
class Box<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
}

const f = (): boolean => {
  class X {
    a = 1;
  }
  const a: new () => X = X;
  const b: new () => X = X;
  return a === b;
};
console.log(f());

function sw(k: number): boolean {
  switch (k) {
    case 1: {
      class Y {
        b = 2;
      }
      const a: new () => Y = Y;
      const b: new () => Y = Y;
      return a === b;
    }
    default:
      if (k > 5) {
        class Z {}
        const z1: new () => Z = Z;
        const z2: new () => Z = Z;
        return z1 === z2;
      }
      return false;
  }
}

console.log(sw(1), sw(7), sw(2));

class Holder<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
  kinds(): boolean {
    const a: new (v: T) => Box<T> = Box;
    const b: new (v: T) => Box<T> = Box;
    return a === b && new a(this.v).v === this.v;
  }
}

console.log(new Holder(3).kinds(), new Holder("x").kinds());

async function pa<T>(x: T): Promise<boolean> {
  const k1: new (v: T) => Box<T> = Box;
  await Promise.resolve(0);
  const k2: new (v: T) => Box<T> = Box;
  return k1 === k2 && new k2(x).v === x;
}

pa(5).then((r) => console.log("pa", r));

function* gen<T>(x: T): Generator<boolean> {
  const k1: new (v: T) => Box<T> = Box;
  yield true;
  const k2: new (v: T) => Box<T> = Box;
  yield k1 === k2;
}

console.log([...gen(1)].join());

function rec<T>(x: T, n: number): boolean {
  const k: new (v: T) => Box<T> = Box;
  if (n === 0) {
    return new k(x).v === x;
  }
  const k2: new (v: T) => Box<T> = Box;
  return k === k2 && rec(x, n - 1);
}

console.log(rec(1, 3));

function loop(): number {
  let same = 0;
  for (const i of [1, 2, 3]) {
    class W {
      i = 0;
    }
    const a: new () => W = W;
    if (i === 2) {
      continue;
    }
    const b: new () => W = W;
    if (a === b) {
      same++;
    }
  }
  return same;
}

console.log(loop());
