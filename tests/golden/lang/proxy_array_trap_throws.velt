// check: no leaks
// A trap that throws while an array method runs on a proxy of an array, in a program that
// passes no throwing callback: the error reaches the caller's `catch`, as in Node (#3897).
const log: string[] = [];

class Guarded {
  raw: number[] = [1, 2, 3];
  p: any;
  constructor(trap: string, key: string) {
    const fail = (k: string | symbol): void => {
      if (String(k) === key) {
        throw new TypeError(`${trap} ${String(k)}`);
      }
    };
    const raw = this.raw;
    if (trap === "set") {
      this.p = new Proxy(raw as any, {
        set(t, k, v, r) {
          fail(k);
          return Reflect.set(t, k, v, r);
        },
      });
    } else if (trap === "deleteProperty") {
      this.p = new Proxy(raw as any, {
        deleteProperty(t, k) {
          fail(k);
          return Reflect.deleteProperty(t, k);
        },
      });
    } else if (trap === "get") {
      this.p = new Proxy(raw as any, {
        get(t, k, r) {
          fail(k);
          return Reflect.get(t, k, r);
        },
      });
    } else {
      this.p = new Proxy(raw as any, {
        has(t, k) {
          fail(k);
          return Reflect.has(t, k);
        },
      });
    }
  }
}

function attempt(label: string, run: () => any): void {
  try {
    const r = run();
    log.push(`${label}: ok ${r}`);
  } catch (e) {
    log.push(`${label}: caught ${e}`);
  }
}

// A trap that throws while an array method runs; the same proxy works after it.
const s = new Guarded("set", "3");
attempt("push set", () => s.p.push(4));
attempt("push again", () => s.p.push());
log.push(`raw ${s.raw.join()}`);

const d = new Guarded("deleteProperty", "2");
attempt("pop delete", () => d.p.pop());
attempt("pop again", () => d.p.length);
log.push(`raw ${d.raw.join()}`);

const g = new Guarded("get", "0");
attempt("shift get", () => g.p.shift());
attempt("join after", () => g.p.slice(1).join("-"));

const h = new Guarded("has", "1");
attempt("splice has", () => h.p.splice(0, 1));
attempt("includes after", () => h.p.includes(3));
log.push(`raw ${h.raw.join()}`);

// The methods left by an error left no state behind: the raw arrays and the proxies work.
attempt("raw arrays", () => {
  s.raw.push(4);
  d.raw.unshift(0);
  g.raw.reverse();
  h.raw.splice(1, 1);
  return [s.raw.join(), d.raw.join(), g.raw.join(), h.raw.join()].join(" | ");
});
attempt("proxies again", () =>
  [s.p.length, d.p.indexOf(0), g.p.slice(1).join(), h.p.length, Reflect.has(d.p, "3")].join(" "),
);

// A proxy of a proxy: the inner trap's error leaves the outer method.
const inner = new Guarded("set", "3");
const outer: any = new Proxy(inner.p, {});
attempt("nested", () => outer.push(9));
attempt("nested again", () => outer.length);


// Rethrown from a `catch`, and from an async caller.
try {
  try {
    new Guarded("deleteProperty", "2").p.pop();
  } catch (e) {
    log.push(`rethrowing ${e}`);
    throw e;
  }
} catch (e) {
  log.push(`rethrown ${e instanceof TypeError} ${e}`);
}
async function later(): Promise<string> {
  await Promise.resolve(0);
  try {
    new Guarded("set", "3").p.push(4);
    return "no";
  } catch (e) {
    return "async " + `${e}`;
  }
}

for (const line of log) {
  console.log(line);
}
console.log(await later());
