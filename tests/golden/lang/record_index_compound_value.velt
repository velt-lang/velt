// An open record's read on the right of a compound assignment, and a local copied from one,
// follow Node (#930): a missing number is `NaN`. An ordering with a missing string still runs
// its other side, then gives `false`.
const big: Record<string, number> = { a: 2 };
const nums: Record<string, number> = {};
const strs: Record<string, string> = { b: "b" };
function k(s: string): string {
  return s;
}
const key = k("zz");
let t = 10;
t -= big["a"];
console.log(t);
t += big[key];
console.log(t);
const v = nums["zz"];
let w = v;
w += 1;
console.log(w);
let x = big[k("a")];
x *= 3;
console.log(x);
let calls = 0;
function side(): string {
  calls++;
  return "c";
}
console.log(strs[key] < side(), strs[k("b")] < side(), calls);
