// `spawn(p);` of a stored promise: nobody can await the task, so its rejection is reported as
// uncaught (exit 1), like a spawned call. `main` waits for a promise nothing ever settles (its
// resolvers stay alive), so only that report can end the program.
class Failed extends Error {}

async function bad(name: string): Promise<string> throws Failed {
  await sleep(1);
  throw new Failed(`${name} failed`);
}

async function main() {
  const p = bad("stored");
  spawn(p);
  const forever = Promise.withResolvers<void>();
  await forever.promise;
  console.log("unreachable");
}
