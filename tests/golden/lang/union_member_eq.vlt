// `===` and `!==` between a union and one of its members compare like JavaScript (#741):
// no coercion, so a string never equals a number.
function pick(s: boolean): string | number {
  return s ? "3" : 3;
}

class P { x = 1; }

function mixed(v: string | number | null, n: number, w: number | P, p: P): void {
  console.log(v === n, n !== v, w === n, w === p, p === w);
}

function main() {
  const a: string | number = 3;
  const b: number = 3;
  console.log(a === b, b === a, a !== b, b !== a);
  const s: string | number = "3";
  console.log(s === b, b === s, s !== b);
  const t: string = "3";
  console.log(s === t, t === s, a === t);
  console.log(pick(true) === 3, pick(false) === b, pick(true) === t);
  const n: string | number = NaN;
  const m: number = NaN;
  console.log(n === m, n !== m);
  const z: string | number = -0;
  console.log(z === 0);
  const u: string | number | boolean = true;
  console.log(u === b, u === t, u === true);
  const p = new P();
  mixed(2, 2, 2, p);
  mixed(null, 2, p, p);
  mixed("2", 2, new P(), p);
  const xs: (string | number)[] = [1, "1", 2];
  console.log(xs.filter((x) => x === a).length, xs.indexOf(a));
}
