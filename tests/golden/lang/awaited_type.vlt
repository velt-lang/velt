// `Awaited<T>`: what `await` gives for a `T`, member by member, also over a type parameter.
type A1 = Awaited<Promise<number>>;
type A2 = Awaited<Promise<Promise<string>>>;
type A3 = Awaited<boolean>;
type A4 = Awaited<Promise<number> | string | null>;
// A union inside a promise is unwrapped member by member too.
type N1 = Awaited<Promise<Promise<number> | string>>;
type PN = Awaited<Promise<number | Promise<boolean>> | null>;
type A5 = Awaited<string | Promise<number | null> | undefined>;

async function get<R>(f: () => R | Promise<R>): Promise<Awaited<R>> {
  return (await f()) as Awaited<R>;
}

interface State<T> {
  value: T;
}

function all<T>(p: Promise<T>): Promise<Awaited<T>[]> {
  return p.then((v) => [v as Awaited<T>]);
}

function wrap<R>(v: Awaited<R>): State<Awaited<R>> {
  return { value: v };
}

async function main() {
  const a: A1 = 1;
  const b: A2 = "two";
  const c: A3 = true;
  const d: A4 = null;
  const e: A4 = 4;
  console.log(a, b, c, d, e);
  console.log(await get(() => 5));
  console.log(await get(async () => "six"));
  console.log(wrap<Promise<number>>(7).value);
  const f1: A5 = null;
  const f2: A5 = undefined;
  const f3: A5 = "s";
  const x: Awaited<any> = 8;
  console.log(f1, f2, f3, x);
  const n1: N1 = 3;
  const n2: N1 = "s";
  const pn: PN = true;
  const pz: PN = null;
  console.log(n1, n2, pn, pz);
  console.log(await all(Promise.resolve("q")));
}

main();
