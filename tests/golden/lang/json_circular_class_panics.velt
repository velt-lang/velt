// JSON.stringify of a class instance that contains itself fails as an object does
// (json_circular_panics) instead of writing until the stack runs out (#3724): a class's own
// fields, its base class's and its subclasses' are followed when a cycle is looked for.

class N {
  name: string;
  next: N | null = null;
  constructor(name: string) {
    this.name = name;
  }
}

function main() {
  const a = new N("a");
  const b = new N("b");
  a.next = b;
  console.log(JSON.stringify(a));
  b.next = a;
  console.log(JSON.stringify(a));
}
