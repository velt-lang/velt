// A cyclic object graph going to another task is copied as a cycle (#351); before, the copy
// recursed until the stack overflowed. Class objects, a self-reference, recursive object types,
// a cycle reached from a value that is handed over, through a base-class field holding a
// subclass, through a spawned function value and captured by an async closure.

class N {
  v: number;
  next: N | null = null;
  constructor(v: number) {
    this.v = v;
  }
}

interface Link {
  name: string;
  next?: Link;
}

class Holder {
  head: N;
  constructor(head: N) {
    this.head = head;
  }
}

class Base {
  loops(): boolean {
    return false;
  }
}

class Derived extends Base {
  n: N;
  constructor(n: N) {
    super();
    this.n = n;
  }
  override loops(): boolean {
    return this.n.next?.next === this.n;
  }
}

class Shelf {
  b: Base;
  constructor(b: Base) {
    this.b = b;
  }
}

async function viaBase(s: Shelf): Promise<boolean> {
  return s.b.loops();
}

async function loops(a: N): Promise<boolean> {
  return a.next?.next === a;
}

async function walk(a: N): Promise<void> {
  console.log(a.v, a.next?.v, a.next?.next === a);
  if (a.next !== null) {
    a.next.v = 20;
  }
}

async function selfLoop(c: N): Promise<boolean> {
  return c.next === c;
}

async function links(l: Link): Promise<string> {
  return `${l.name} ${l.next?.name} ${l.next?.next?.name}`;
}

async function held(h: Holder): Promise<number> {
  return h.head.next?.next?.v ?? -1;
}

async function main() {
  const a = new N(1);
  const b = new N(2);
  a.next = b;
  b.next = a;
  await spawn(walk(a));
  console.log(a.next?.v, a.next?.next === a);

  const c = new N(3);
  c.next = c;
  console.log(await spawn(selfLoop(c)), c.next === c);

  let l: Link = { name: "x" };
  l.next = { name: "y", next: l };
  console.log(await spawn(links(l)));

  const d = new N(4);
  const e = new N(5);
  d.next = e;
  e.next = d;
  console.log(await spawn(held(new Holder(d))));

  const s = new Shelf(new Derived(a));
  console.log(await spawn(viaBase(s)), s.b.loops());

  const f = loops;
  console.log(await spawn(f(a)));

  const g = async (): Promise<boolean> => a.next?.next === a;
  console.log(await spawn(g()), await g());
}
