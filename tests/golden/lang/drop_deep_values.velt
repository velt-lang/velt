// check: no leaks
// Long chains through struct values in arrays, interface values, a class hierarchy and
// recursive object types (the usual TypeScript linked list) drop without overflowing the stack
// (#543), at the end of a scope and on reassignment.

struct Item {
  id: i64;
  rest: Item[];
}

interface ListNode {
  value: number;
  next?: ListNode;
}

interface Cons {
  head: number;
  tail: Cons | null;
}

interface Shape {
  area(): number;
}

class Square implements Shape {
  side: number;
  inner: Shape | null = null;

  constructor(side: number) {
    this.side = side;
  }

  area(): number {
    return this.side * this.side;
  }
}

class Base {
  next: Base | null = null;

  id(): number {
    return 0;
  }
}

class Derived extends Base {
  k: number;

  constructor(k: number) {
    super();
    this.k = k;
  }

  override id(): number {
    return this.k;
  }
}

function items(n: i64): Item {
  let head: Item = { id: 0, rest: [] };
  for (let i: i64 = 1; i < n; i++) {
    head = { id: i, rest: [head] };
  }
  return head;
}

function listNodes(n: number): ListNode {
  let head: ListNode = { value: 0 };
  for (let i = 1; i < n; i++) {
    head = { value: i, next: head };
  }
  return head;
}

function conses(n: number): Cons {
  let list: Cons = { head: 0, tail: null };
  for (let i = 1; i < n; i++) {
    list = { head: i, tail: list };
  }
  return list;
}

function squares(n: number): Shape {
  let head: Shape = new Square(0);
  for (let i = 1; i < n; i++) {
    const s = new Square(i);
    s.inner = head;
    head = s;
  }
  return head;
}

function hierarchy(n: number): Base {
  let head: Base = new Base();
  for (let i = 1; i < n; i++) {
    const d = new Derived(i);
    d.next = head;
    head = d;
  }
  return head;
}

function scopeEnd() {
  const a = items(1000000);
  const s = squares(1000000);
  const h = hierarchy(1000000);
  const l = listNodes(1000000);
  const c = conses(1000000);
  console.log("scope", a.id, a.rest[0].id, s.area(), h.id());
  console.log("objects", l.value, l.next!.value, c.head, c.tail!.head);
}

function main() {
  scopeEnd();
  console.log("scope dropped");
  let a = items(1000000);
  a = { id: -1, rest: [] };
  let s = squares(1000000);
  s = new Square(-1);
  let h = hierarchy(1000000);
  h = new Derived(-1);
  console.log("reassigned", a.id, s.area(), h.id());
  let l = listNodes(1000000);
  l = { value: -1 };
  let c = conses(1000000);
  c = conses(1);
  console.log("objects reassigned", l.value, c.head);
}
