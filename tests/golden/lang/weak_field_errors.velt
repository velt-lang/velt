// What a `weak` field (docs/internals/design/cycles.md "`weak T`") may not do yet, or at all:
// a test does not narrow it (the target may be gone between two reads); it does not cross to
// another task or get cloned, nor is it destructured, until #3119's later steps.

class Node {
  name: string;
  parent: weak Node | null = null;
  // `?` adds `undefined`: not lowered yet.
  owner?: weak Node | null;
  constructor(name: string) {
    this.name = name;
  }
}

class Holder {
  node: Node;
  constructor(node: Node) {
    this.node = node;
  }
}

async function run(n: Node): Promise<string> {
  return n.name;
}

async function runHeld(h: Holder): Promise<string> {
  return h.node.name;
}

async function main() {
  const root = new Node("root");
  const kid = new Node("kid");
  kid.parent = root;
  if (kid.parent !== null) {
    console.log(kid.parent.name);
  }
  console.log(await spawn(run(kid)));
  console.log(await spawn(runHeld(new Holder(root))));
  const copy = kid.clone();
  const { parent } = kid;
  console.log(copy.name, parent);
}
