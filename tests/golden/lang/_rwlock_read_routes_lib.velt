// A module whose functions build fresh plain results from a store, read by
// rwlock_read_fresh_results.velt inside `read` callbacks.
export class Item {
  name: string = "";
  price: number = 0;
  tags: string[] = [];
  constructor(name: string, price: number) {
    this.name = name;
    this.price = price;
    this.tags = [name];
  }
}

export class Store {
  items: Item[] = [];
}

export interface ApiResponse {
  status: number;
  body: string;
}

export function route(s: Store, path: string): ApiResponse | null {
  if (path == "/items") {
    return { status: 200, body: s.items.map((i) => i.name).join(",") };
  }
  return null;
}

export function prices(s: Store): number[] {
  const out: number[] = [];
  for (const i of s.items) {
    out.push(i.price);
  }
  return out;
}

export function pairs(s: Store): [string, number][] {
  return s.items.map((i): [string, number] => [i.name, i.price]);
}
