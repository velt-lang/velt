// An object `static readonly` field changed through a function is kept in the module state
// (#1383; a struct with a mutating method before #641): each call changes the one value the
// field holds, as Node changes its one object.

type Pt = { x: i64 };

function bump(p: Pt) {
  p.x += 1;
}

class Shapes {
  static readonly ORIGIN: Pt = { x: 0 };
}

const START: Pt = { x: 10 };

function main() {
  bump(Shapes.ORIGIN);
  bump(Shapes.ORIGIN);
  bump(START);
  console.log(Shapes.ORIGIN.x, START.x);
}
