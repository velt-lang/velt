extend<T extends A1 & B1> T implements A0 {
  a0(): string {
    return `a0(${this.a1()})`.length > 0 ? "a0" : "";
  }
}

extend<T extends A1 & B1> T implements B0 {
  b0(): string {
    return "b0";
  }
}

