class C implements A32, B32 {
  a32(): string {
    return "a32";
  }
  b32(): string {
    return "b32";
  }
}

function f<T extends A0>(x: T): string {
  return x.a0();
}

function g<T extends B0>(x: T): string {
  return x.b0();
}

function main(): void {
  const c = new C();
  console.log(f(c), g(c), (c as A0).a0());
  const a: any = c;
  console.log((a as B0).b0());
}
