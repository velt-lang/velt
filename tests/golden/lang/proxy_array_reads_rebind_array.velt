// The key parameter rebound by a destructuring assignment.
const p: any = new Proxy([3, 1, 2] as any, {
  get(t: any, prop: any, r: any) {
    if (prop === "order") {
      [prop] = ["sort"];
    }
    return Reflect.get(t, prop, r);
  },
});
const s = p.order((a: any, b: any) => a - b);
console.log(s[0], s[1], s[2], p[0]);
