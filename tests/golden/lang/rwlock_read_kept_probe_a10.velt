// check: no leaks
// An RwLock read probe (#1559): prints what Node prints.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Holder {
  rows: number[][] = [];
}
function main() {
  const a = new RwLock(new Box());
  const out: number[][][] = [];
  a.read((x) => {
    for (let i = 0; i < 5; i++) {
      const c: number[][] = [[i]];
      out.push(c);
      out.push(c);
      c.push([i * 10]);
      if (i % 2 == 0) {
        out.pop();
      }
    }
  });
  out[0].push([99]);
  console.log(JSON.stringify(out), out[0] === out[1]);
}
