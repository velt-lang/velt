// Two `Promise.all`s over arrays whose inputs resolve in the other order: their reactions run in
// the order the inputs resolved (#1362's `all` case, #2944).
async function main() {
  const a = Promise.withResolvers<number>();
  const b = Promise.withResolvers<number>();
  const as: Promise<number>[] = [a.promise];
  const bs: Promise<number>[] = [b.promise];
  const ta = Promise.all(as).then(() => console.log("all a"));
  const tb = Promise.all(bs).then(() => console.log("all b"));
  b.resolve(1);
  a.resolve(2);
  await ta;
  await tb;
  console.log("end");
}
