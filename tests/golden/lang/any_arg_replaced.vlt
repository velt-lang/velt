// An `any` argument read from a field, whose method replaces that field while the callee runs.
// check: no leaks
class Holder {
  x: any = null;
}

class S {
  name: string;
  h: Holder;
  constructor(name: string, h: Holder) {
    this.name = name;
    this.h = h;
  }
  kill(): string {
    this.h.x = null;
    return this.name;
  }
  swap(): string {
    this.h.x = new S("next", this.h);
    return this.name;
  }
}

class Show {
  tag: string = "m";
  show(p: any): void {
    console.log(this.tag, p.kill());
  }
}

function show(p: any): void {
  console.log(p.kill());
}

function outer(p: any): void {
  inner(p);
}

function inner(p: any): void {
  console.log(p.swap(), p.name);
}

function pair(p: any, q: any): void {
  console.log(p.kill(), q);
}

function main(): void {
  const h = new Holder();
  h.x = new S("first", h);
  show(h.x);
  console.log(h.x);
  h.x = new S("second", h);
  outer(h.x);
  console.log(h.x.name);
  h.x = new S("third", h);
  new Show().show(h.x);
  h.x = new S("fourth", h);
  pair(h.x, h.x);
  const hs: Holder[] = [h];
  hs[0].x = new S("fifth", h);
  show(hs[0].x);
}
