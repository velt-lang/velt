// A promise made under a `with` lock would run after the lock is released (#398). Here the
// callback is generic in its result and comes from a function, so the compiler cannot see it
// returns a promise: the program stops before taking the lock.
class Outer {
  n: i64 = 0;
}

function reader(): (o: Outer) => Promise<i64> {
  return async (o: Outer): Promise<i64> => {
    await yieldNow();
    return o.n;
  };
}

function locked<R>(m: shared<Mutex<Outer>>, f: (v: Outer) => R): R {
  return m.with(f);
}

async function main() {
  const m = shared(new Mutex<Outer>(new Outer()));
  console.log(locked(m, (v) => v.n + 1));
  const p = locked(m, reader());
  console.log(await p);
}
