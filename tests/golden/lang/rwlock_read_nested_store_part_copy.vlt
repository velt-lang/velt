// check: no leaks
// An array a `read` nested in another stores into a container of the code outside every read,
// into which the outer callback then stores a part of the lock's value, is stored as a copy, as
// in a single `read` (docs/reference/async.md): the caller's copy keeps what the array held
// when it was stored, and the parts stay the lock's (#1523). (Node shares the array; a class
// object in its place stops the program, rwlock_read_nested_store_part_stops.)
class Rows {
  items: number[][] = [[1, 2], [3]];
}

function main() {
  const c = new RwLock(new Rows());
  const d = new RwLock(new Rows());
  const rows: number[][][] = [];
  c.read((x) => {
    const l: number[][][] = [[[1]]];
    d.read((y) => {
      rows.push(l[0]);
    });
    l[0].push(x.items[0]);
    console.log(rows[0] === l[0], l[0].length);
  });
  rows[0].push([9]);
  c.write((q) => {
    q.items[0].push(5);
    q.items = [];
  });
  console.log(JSON.stringify(rows));
}
