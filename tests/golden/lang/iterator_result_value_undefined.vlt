// TypeScript's finished iterator result `{ value: undefined, done: true }` (issue #930): accepted,
// without the `value` (a finished result in Velt has none).
class Doubler implements Iterator<number> {
  i = 0;
  xs: number[];
  constructor(xs: number[]) {
    this.xs = xs;
  }
  next(): IteratorResult<number> {
    if (this.i >= this.xs.length) {
      return { value: undefined, done: true };
    }
    return { value: this.xs[this.i++] * 2, done: false };
  }
}
function nextOf(it: Iterator<number>): IteratorResult<number> {
  const r = it.next();
  if (r.done) {
    return { done: true, value: undefined };
  }
  return r;
}
type Pair = { value: number | undefined; done: boolean };
function main() {
  const d = new Doubler([1, 2, 3]);
  for (let r = nextOf(d); !r.done; r = nextOf(d)) {
    console.log(r.value);
  }
  const p: Pair = { value: undefined, done: true };
  console.log(p);
}
