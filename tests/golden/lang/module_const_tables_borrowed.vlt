// check: heap blocks at most 2
// A table passed to a function that only reads its parameter, generic or nested, or to a
// method of the array or `velt/simd` load, reads its stored data: nothing is allocated per use
// (#1334). The two blocks are the string of `join` and the copy of `slice`.
import { u32x4 } from "velt/simd";

const TABLE: u32[] = [10, 20, 30, 40, 50, 60, 70, 80];
const FLAGS: bool[] = [true, false, true];

function sum(xs: u32[]): u32 {
  let s: u32 = 0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

function count<T>(xs: T[]): number {
  return xs.length;
}

function via(xs: u32[]): u32 {
  return sum(xs) + 1;
}

function main() {
  let total: u64 = 0;
  for (let i = 0; i < 1000; i++) {
    total += sum(TABLE) as u64;
    total += via(TABLE) as u64;
    total += count(TABLE) as u64;
    total += TABLE.indexOf(40) as u64;
    total += TABLE.includes(70) ? 1 : 0;
    total += u32x4.load(TABLE, 4).lane(1) as u64;
    total += FLAGS.includes(false) ? 1 : 0;
  }
  console.log(total, TABLE.join("-"), TABLE.slice(2, 4).length);
}
