// A field changed by a function that comes out of a `Map`.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

function mk(): F {
  const b = new C();
  return (x: i64): i64 => {
    b.n += 1;
    return b.n;
  };
}

async function main() {
  const m = new Map<string, F>();
  m.set("a", mk());
  const f = shared(m.get("a")!);
  console.log(f(1));
}
