// check: no leaks
// The update of a `for` loop runs where its condition still holds for what the body does not
// assign: `for (c = head; c; c = c.next)` reads `c.next` of a non-null `c`, as in TypeScript,
// for a local and for a module-level `let`. Module state in loops, `switch`, `finally` and
// generators narrows as in TypeScript too.
class N {
  v: number;
  next: N | null;
  constructor(v: number, next: N | null) {
    this.v = v;
    this.next = next;
  }
}

function sum(head: N | null): number {
  let s = 0;
  let c: N | null;
  for (c = head; c; c = c.next) {
    s += c.v;
  }
  for (let d = head; d !== null; d = d.next) {
    if (d.v === 2) {
      continue;
    }
    s += d.v * 100;
  }
  return s;
}

console.log(sum(new N(1, new N(2, null))));
let head: N | null = new N(1, new N(2, new N(3, null)));
let cur: N | null = null;

function walk(): number {
  let s = 0;
  cur = head;
  while (cur) {
    s += cur.v;
    cur = cur.next;
  }
  for (cur = head; cur; cur = cur.next) {
    s += cur.v * 10;
  }
  return s;
}

console.log(walk());

function sw(): string {
  switch (cur === null ? "none" : "some") {
    case "none":
      return "n";
    default:
      return "s";
  }
}

console.log(sw());

function tf(): string {
  cur = head;
  try {
    if (!cur) {
      return "no";
    }
    return String(cur.v);
  } finally {
    cur = null;
  }
}

console.log(tf(), cur);

function* gen(): Generator<number> {
  cur = head;
  while (cur) {
    yield cur.v;
    cur = cur.next;
  }
}

for (const v of gen()) {
  console.log("g", v);
}

function clearHead(): void {
  head = null;
}

function ternary(): number {
  clearHead();
  return head ? head.v : -1;
}

console.log(ternary());
