// check: no leaks
// String and template escapes cook as in JavaScript (#1265): a backslash before a character
// that is not an escape is dropped (`"\d"` is `"d"`), `\b \v \f` are control characters, a
// backslash before a line break continues the line, and a surrogate pair written as two `\u`
// escapes is one character. Expected output: Node's.
function codes(s: string): string {
  const out: string[] = [];
  for (let i = 0; i < s.length; i++) {
    out.push(`${s.charCodeAt(i)}`);
  }
  return out.join(" ");
}

function main() {
  const unknown = "a\d\q\ \é";
  console.log(unknown, unknown.length);
  console.log("b(\d)", "b(\d)".length, "b(\\d)", "b(\\d)".length);
  console.log(codes("\b\v\f\0"));
  console.log("\x41\u0042\u{43}\u{1F600}", "\uD83D\uDE00".length, "\uD83D\uDE00" == "😀");
  console.log("one \
two");
  console.log("it's", "say \"hi\"", 'a\"b', "a\'b", "back\\slash", "\$\`");
  const t = `\d${1}\q\
z \` \$ \${x}`;
  console.log(t, t.length);
  console.log(`\x41\u{42}\0|\b|`.length);
  // A pair is one character whichever form each half is written in.
  const pairs = ["\u{D83D}\u{DE00}", "\uD83D\u{DE00}", "\u{D83D}\uDE00", `\u{d83d}\u{de00}`];
  for (const p of pairs) {
    console.log(p, p.length, p == "😀");
  }
}
