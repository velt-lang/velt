// `"k" in v` on a union with a function member (#2655, sigx's useData): a function has
// `length`, `name` and `Function.prototype`'s members, and no others, so `"__sigx" in fn` is
// false; a callable interface answers from its declared members.
interface DataRef { (...args: []): unknown; __sigxKey: string }
type Key = string | (() => string | null) | DataRef;
function classify(k: Key): string {
    if (typeof k === "function" && ("__sigx" in k || "__sigxKey" in k)) return "stamped";
    if (typeof k === "function") return "getter " + ("length" in k) + " " + ("call" in k) + " " + ("toString" in k);
    return "static";
}
const ref: DataRef = Object.assign(() => 1, { __sigxKey: "a/b" });
console.log(classify("x"), classify(() => null), classify(ref));
const f = (x: number): number => x + 1;
console.log("name" in f, "bind" in f, "apply" in f, "missing" in f);
