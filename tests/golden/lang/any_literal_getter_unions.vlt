// check: no leaks
// Getters whose results are unions, nullable or optional, written by `JSON.stringify` through
// `any` (#1538): each result as the member it holds, `undefined` left out. The JSON writer of such a
// literal compiles also where `JSON.stringify` never runs.
let st = 1;
const lit = {
  tag: "t",
  get u(): string | number {
    return st;
  },
  get mixed(): number | boolean[] {
    return st > 1 ? [true, false] : st;
  },
  get opt(): number | undefined {
    return st > 1 ? st : undefined;
  },
  get obj(): { a: number } | string {
    return st > 1 ? "s" : { a: st };
  },
};
const A: any = lit;
console.log(A.u, A.tag);
console.log(JSON.stringify(A));
st = 2;
console.log(JSON.stringify(A));
console.log(A);
if (st > 100) {
  console.log(JSON.stringify(A as any));
}
console.log("done");
