// Types imported by function_properties_generic.vlt, in the shape of sigx's component types: a
// callable alias whose call signature's parameter needs the type arguments, a setup function
// over a context whose props are a mapped type, and the alias that strips markers.
export type Strip<T> = { [K in keyof T as K extends "__brand" ? never : K]: T[K] };

export type PropsAccessor<P> = { readonly [K in keyof P]: P[K] };

export interface Ctx<P extends Record<string, any> = {}> {
  props: PropsAccessor<P>;
  name: string;
}

export type Setup<P extends Record<string, any> = {}> = (ctx: Ctx<P>) => string;

export type Factory<T extends Record<string, any>> = ((props: Partial<T> & { key?: string }) => string) & {
  __setup: Setup<Strip<T>>;
  __name?: string;
  __kind: string;
};
