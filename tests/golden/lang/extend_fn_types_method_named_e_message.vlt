// The error type an `extend` target's function type gets (#1878) is named apart from the type
// parameters of the block's methods: in a method `bad<E>`, a message about `this` shows it as
// `E1`. TypeScript has no `extend`, so there is no Node comparison.

extend<R> () => R {
  bad<E>(x: E): number {
    return this;
  }
}

const f = () => 1;
console.log(f.bad(2));
