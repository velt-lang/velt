// requires: unix
// `lastOsError()` reads the errno slot of the thread, as C's `errno`: after an `await`, other
// tasks' system calls may have replaced it. Read it before the `await` (here `a` keeps it in a
// local) to keep it. `close(-1)` sets EBADF (9); `unlink` of a missing file sets ENOENT (2).
import { lastOsError } from "velt:os";

declare system function close(fd: i32): i32;
declare system function unlink(path: readonly u8[]): i32;

async function a(): Promise<i32[]> {
  close(-1);
  const before = lastOsError();
  await Promise.resolve(0);
  return [before, lastOsError()];
}

async function b(): Promise<i32> {
  const p: u8[] = [110, 111, 112, 101, 0];
  unlink(p);
  return lastOsError();
}

async function main() {
  const pa = a();
  const pb = b();
  const [before, after] = await pa;
  console.log(`before the await: ${before}`);
  console.log(`after the await: ${after} (b's unlink ran in between)`);
  console.log(`b: ${await pb}`);
}
