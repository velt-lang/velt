// check: no leaks
// A nested `read` stores into the caller's array what `concat` makes of copies of both locks'
// arrays, the receiver itself a copy (`slice()`), also chained and kept in variables (#1523).
class Box {
  items: number[][][] = [[[1]]];
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const out: number[][][] = [[[0]]];
  a.read((x) => {
    b.read((y) => {
      out.push(y.items[0].slice().concat(x.items[0].slice()));
      const keep = y.items[0].concat(x.items[0]);
      const r = keep.concat(x.items[0].slice());
      out.push(r);
      y.items[0].concat(x.items[0].slice());
      out.push(y.items[0].concat(x.items[0].slice()).concat(out[0]));
    });
  });
  out[1].push([2]);
  a.write((q) => {
    q.items[0].push([3]);
  });
  console.log(JSON.stringify(out));
}
