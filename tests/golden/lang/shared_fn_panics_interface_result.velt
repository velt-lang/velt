// A field changed by a function an interface method returns.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

interface Fi {
  make(): F;
}

class Fa implements Fi {
  make(): F {
    const b = new C();
    return (x: i64): i64 => {
      b.n += 1;
      return b.n;
    };
  }
}

async function main() {
  const m: Fi = new Fa();
  const f = shared(m.make());
  console.log(f(1));
}
