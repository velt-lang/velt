// check: no leaks
// Writing into a part of a field read through an interface (a tuple element, a nested tuple,
// a field of an object inside a tuple) changes the field the object holds, as in JS, whether
// the interface value is an object literal or a class instance, and every other reference to
// the object sees it. Compound writes, `++` and assignments used as values too, with the
// receiver evaluated once.
interface T {
  t: [number, string];
  get(): string;
}

function setT(x: T): void {
  x.t[0] = 5;
}

class C implements T {
  t: [number, string] = [2, "b"];
  get(): string {
    return "c" + this.t[0];
  }
}

interface P {
  x: number;
  y: number;
}

interface H {
  ps: P[];
  n: [[number, number], string];
  q: [P, number];
  label(): string;
}

function upd(h: H): void {
  h.ps[0].x = 7;
  h.n[0][1] = 9;
  h.q[0].y = 4;
  h.q[1] *= 3;
}

class HC implements H {
  ps: P[] = [{ x: 0, y: 0 }];
  n: [[number, number], string] = [[0, 0], "hc"];
  q: [P, number] = [{ x: 1, y: 1 }, 1];
  label(): string {
    return this.n[1] + this.n[0][1] + this.q[1];
  }
}

// Through a generic bounded by the interface.
function bump<X extends T>(x: X): void {
  x.t[0] = x.t[0] * 2;
  x.t[1] += "+";
}

function deep(n: number): number {
  const xs = [n, n + 1];
  return n <= 0 ? 0 : xs[1] + deep(n - 1) - n;
}

function fill(x: T, n: number): void {
  for (let i = 0; i < n; i++) {
    x.t[1] = "s".repeat(i + 1);
  }
}

function run(): void {
  const a: T = {
    t: [1, "a"],
    get(): string {
      return "g";
    },
  };
  setT(a);
  console.log(a.t[0], a.t[1]);
  const c: T = new C();
  setT(c);
  console.log(c.t[0], c.get());

  // Other holders of the same object see the write.
  const holder: T[] = [a, c];
  holder[0].t[1] = "z";
  holder[1].t[0] += 10;
  holder[1].t[0]++;
  console.log(a.t[1], c.t[0], holder[0].t[1], holder[1].get());

  // Nested tuples, a tuple of objects, arrays of objects.
  const h: H = {
    ps: [{ x: 1, y: 2 }],
    n: [[1, 2], "q"],
    q: [{ x: 0, y: 0 }, 2],
    label(): string {
      return "lit";
    },
  };
  upd(h);
  const alias = h;
  console.log(h.ps[0].x, h.n[0][1], h.q[0].y, h.q[1], alias.n[0][1], alias.label());
  const hc: H = new HC();
  upd(hc);
  console.log(hc.label(), hc.q[0].y);

  // The value of the assignment, and the receiver evaluated once.
  let calls = 0;
  const pick = (): T => {
    calls++;
    return holder[1];
  };
  const v = (a.t[0] = 42);
  const w = a.t[0]++;
  const u = ++a.t[0];
  const s = (a.t[1] += "!");
  console.log(v, w, u, a.t[0], s, a.t[1]);
  pick().t[0] = 11;
  pick().t[0] += 1;
  console.log(calls, c.t[0]);

  const cc = new C();
  bump(cc);
  bump(cc);
  console.log(cc.t[0], cc.t[1]);

  // Deep recursion between the writes and the reads (stack reuse), strings rebuilt.
  fill(a, 5);
  console.log(deep(2000), a.t[1], holder[0].t[1]);
}

// The right-hand side drops every other reference to the receiver: the write still lands in
// the object the target named, which stays alive until the write is done.
function dropped(): void {
  const holder: T[] = [
    new C(),
    {
      t: [1, "x".repeat(4)],
      get(): string {
        return "lit";
      },
    },
  ];
  const keep = holder[0];
  const f = (): string => {
    holder.pop();
    holder.pop();
    holder.push(new C());
    return "y".repeat(5);
  };
  holder[0].t[1] = f();
  console.log(keep.get(), holder.length, holder[0].get());
  const one = holder[0];
  const g = (): number => {
    holder.length = 0;
    return 7;
  };
  one.t[0] += g();
  console.log(one.get(), holder.length);
}

// The right-hand side runs before the field is read: a change it makes to the same field is
// kept (JS writes into the array the object holds when the element is assigned). A compound
// assignment reads the old element first.
function order(): void {
  const y: T = {
    t: [1, "a"],
    get(): string {
      return "y";
    },
  };
  y.t[0] = (() => {
    y.t[1] = "rhs";
    return 2;
  })();
  console.log(y.t[0], y.t[1]);
  y.t[1] += (() => {
    y.t[1] = "lost";
    y.t[0] = 3;
    return "!";
  })();
  console.log(y.t[0], y.t[1]);
  const n: N = {
    m: [null, 1],
    tag(): string {
      return "n";
    },
  };
  n.m[0] ??= (() => {
    n.m[1] = 2;
    return 5;
  })();
  n.m[0] ??= (() => {
    n.m[1] = 99;
    return 6;
  })();
  console.log(n.m[0], n.m[1]);
  const c: T = new C();
  const v =
    (
      c.t[0] = (() => {
        c.t[1] = "v";
        return 8;
      })()
    );
  console.log(v, c.get(), c.t[1]);
}

interface N {
  m: [number | null, number];
  tag(): string;
}

// Receivers that are not a plain path: evaluated once, in order, and the write lands.
function receivers(): void {
  const lit = (n: number, s: string): T => ({
    t: [n, s],
    get(): string {
      return s;
    },
  });
  const xs: T[] = [lit(1, "a"), lit(2, "b")];
  let i = 0;
  xs[i++].t[0] = 50;
  console.log(xs[0].t[0], i);
  xs[i--].t[0]++;
  console.log(xs[1].t[0], i);
  const c = xs.length > 1;
  (c ? xs[0] : xs[1]).t[0] = 60;
  xs[0]["t"][0] += 11;
  xs[0]["t"][1] = "k";
  console.log(xs[0].t[0], xs[0].t[1]);
  const fs = [(): T => xs[1]];
  fs[0]().t[0] = 81;
  console.log(xs[1].t[0]);
  xs.find((q) => q.t[1] === "b")!.t[0] = 90;
  const r = (xs.find((q) => q.t[1] === "k")!.t[1] = "found");
  console.log(xs[1].t[0], xs[0].t[1], r);
  // The right-hand side drops every other reference to the receiver.
  xs.find((q) => q.t[0] === 90)!.t[1] = (() => {
    xs.length = 0;
    return "gone".repeat(2);
  })();
  console.log(xs.length);
}

// Another task changes the field while the right-hand side waits: both writes are kept.
async function val(n: number): Promise<number> {
  await Promise.resolve(0);
  return n;
}

async function raced(): Promise<void> {
  const x: T = {
    t: [1, "a"],
    get(): string {
      return "x";
    },
  };
  const p = (async () => {
    x.t[0] = await val(100);
  })();
  x.t[1] = "other";
  await p;
  console.log(x.t[0], x.t[1]);
  const q = (async () => {
    x.t[1] += await val(7);
  })();
  x.t[0] = 1;
  await q;
  console.log(x.t[0], x.t[1]);
}

run();
dropped();
order();
receivers();
await raced();
