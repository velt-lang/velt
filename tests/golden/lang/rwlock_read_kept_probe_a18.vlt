// check: no leaks
// An RwLock read probe (#1559): prints what Node prints.
class Box {
  items: number[][] = [[1, 2], [3]];
}
function main() {
  const a = new RwLock(new Box());
  const out: number[][][] = [];
  a.read((x) => {
    for (let i = 0; i < 50; i++) {
      const c: number[][] = [[i]];
      out.push(c);
      c.push([i + 100]);
      if (i < 49) {
        out.pop();
      }
    }
  });
  out[0][0].push(7);
  const r = out[0].pop()!;
  a.write((q) => { q.items.push(r); });
  a.read((x) => { console.log(x.items.length); });
  console.log(JSON.stringify(out));
}
