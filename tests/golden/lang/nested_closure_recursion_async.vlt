// check: no leaks
// #1142: async nested functions using the enclosing function's locals that call each other.
async function crawl(root: number): Promise<number> {
  const seen: number[] = [];
  let visits = 0;
  async function visit(n: number): Promise<void> {
    visits++;
    seen.push(n);
    await sleep(1);
    if (n < root) {
      await visit(n * 2);
      await other(n * 2 + 1);
    }
  }
  async function other(n: number): Promise<number> {
    if (n < root) await visit(n + 10);
    return n;
  }
  await visit(1);
  console.log(seen.join(","));
  return visits;
}

// Escaping async members, and an error rejected deep in the recursion.
function fetcher(limit: number) {
  const log: string[] = [];
  async function get(n: number): Promise<string> {
    log.push("get" + n);
    await sleep(1);
    if (n > limit) throw new Error("over " + n);
    return n <= 1 ? log.join(" ") : await retry(n - 1);
  }
  async function retry(n: number): Promise<string> {
    log.push("retry" + n);
    return await get(n);
  }
  return { get };
}

async function main() {
  console.log(await crawl(8));
  const { get } = fetcher(5);
  console.log(await get(3));
  try {
    await get(9);
  } catch (e) {
    console.log("rejected", (e as Error).message);
  }
}
