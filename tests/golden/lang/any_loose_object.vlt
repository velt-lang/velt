// `==` between an object and a boolean, number or string in `any`s: JavaScript converts the
// object with `ToPrimitive` (`[] == 0` is `true`), which is not there yet (#924), so it stops
// with a `TypeError` instead of answering `false`. Objects against `null` and other objects
// are compared as usual.
function main(): void {
  const a: any = [];
  const o: any = { x: 1 };
  console.log(a == null, o == undefined, a == a, a === o, a != o);
  const z: any = 0;
  console.log(a === z);
  console.log(a == z);
}
