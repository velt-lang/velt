// console.log of floats in a program that prints no integer type, through the float writer
// (velt/lang/hooks/number_write), which holds no integer printing: a whole number below 2^53
// other than `-0` by its own whole-number writer, `1`, not `1.0`, anything else by the runtime's
// printer (#2197). Where the optimizer knows a number whole (the `let i = 0` loops' in a release
// build) it calls the whole-number writer directly; the others take it through the float
// writer's test. That sema checks the writers and no integer hook is velt_sema's `live_hooks`
// test.
function main() {
  let x: f64 = 0.25;
  for (let k = 0; k < 4; k++) {
    console.log(x);
    x = x * 2.0;
  }
  console.log(-0.0, 1e21, NaN, -x);
  for (let i = 0; i < 3; i++) {
    console.log(i);
  }
  for (let i = -3; i < 0; i++) {
    console.log(i, i * 0);
  }
  let n = 9007199254740991;
  console.log(n, -n, n + 1, -n - 1, 123456789012, -10000000);
  let v = 1;
  for (let k = 0; k < 16; k++) {
    console.log(v - 1, v, -v, v * 9 + (v - 1), 0.5 + v);
    v = v * 10;
  }
  console.log(0.0, x * 0, Infinity, -Infinity, 1e-7, 2 ** 53 - 2);
}
