// A type parameter bounded by `string | number[]` passed where the first overload takes
// `E | string | number[]` (#379): converted to its bound and widened to that union, so the first
// overload takes it, as tsc picks it. The union's enum member, which has no run-time test, is not
// tested. Node (with `--experimental-transform-types`, for the enum) prints the same.
enum E {
  A,
  B,
}

function o(x: E | string | number[]): string;
function o(x: string | number[] | boolean): number;
function o(x: E | string | number[] | boolean): string | number {
  return typeof x === "boolean" ? 1 : "s";
}

function f<K extends string | number[]>(k: K): number | string {
  return o(k);
}

function main(): void {
  console.log(f("q"), f([1, 2]));
}
