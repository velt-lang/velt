// Array methods called on a proxy of an array: Node's generic algorithms run with the proxy as
// `this`, so every read, write, `in` and delete goes through the traps, in the order logged.
function logging(log: string[]): ProxyHandler<any> {
  return {
    get(t: any, k: string | symbol, r: any): any {
      log.push(`get ${String(k)}`);
      return Reflect.get(t, k, r);
    },
    set(t: any, k: string | symbol, v: any, r: any): boolean {
      log.push(`set ${String(k)}=${v}`);
      return Reflect.set(t, k, v, r);
    },
    has(t: any, k: string | symbol): boolean {
      log.push(`has ${String(k)}`);
      return Reflect.has(t, k);
    },
    deleteProperty(t: any, k: string | symbol): boolean {
      log.push(`delete ${String(k)}`);
      return Reflect.deleteProperty(t, k);
    },
  };
}

function run(name: string, start: number[], f: (p: any) => any): void {
  const arr: number[] = start.slice();
  const log: string[] = [];
  const p: any = new Proxy(arr, logging(log));
  const r = f(p);
  const shown = r === undefined ? "undefined" : JSON.stringify(r);
  console.log(`${name}: ${shown} -> ${JSON.stringify(arr)}`);
  console.log(`  ${log.join(", ")}`);
}

run("push", [1, 2], (p) => p.push(3));
run("push many", [1], (p) => p.push(2, 3, 4));
run("push none", [1], (p) => p.push());
run("pop", [1, 2, 3], (p) => p.pop());
run("pop empty", [], (p) => p.pop());
run("shift", [1, 2, 3], (p) => p.shift());
run("shift empty", [], (p) => p.shift());
run("unshift", [1, 2], (p) => p.unshift(8, 9));
run("unshift none", [1, 2], (p) => p.unshift());
run("splice remove", [1, 2, 3, 4], (p) => p.splice(1, 2));
run("splice insert", [1, 2, 3], (p) => p.splice(1, 0, 7, 8));
run("splice replace", [1, 2, 3, 4], (p) => p.splice(1, 1, 9));
run("splice grow", [1, 2, 3], (p) => p.splice(1, 1, 5, 6, 7));
run("splice negative", [1, 2, 3, 4], (p) => p.splice(-2));
run("splice start only", [1, 2, 3], (p) => p.splice(1));
run("splice no args", [1, 2], (p) => p.splice());
run("splice past end", [1, 2], (p) => p.splice(5, 1, 3));
// A handler without traps calls the method on the target.
const q: any = new Proxy([1, 2], {});
console.log(`${q.push(3)} ${q.pop()} ${q.length}`);
// check: no leaks
