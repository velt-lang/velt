// A `let` changed by a function that comes out of a `Map`.
type F = (x: i64) => i64;

function mk(): F {
  let n: i64 = 0;
  return (x: i64): i64 => {
    n += 1;
    return n;
  };
}

async function main() {
  const m = new Map<string, F>();
  m.set("a", mk());
  const f = shared(m.get("a")!);
  console.log(f(1));
}
