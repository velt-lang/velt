// check: no leaks
// A class converts to an intersection whose object part's field it provides through a
// `get`/`set` accessor pair (own, overridden or inherited, of a generic class too): reads
// and writes through the intersection run the accessors.
interface Base { refresh(): number }
class Counted implements Base {
  private _n = 0;
  get n(): number { return this._n; }
  set n(v: number) { this._n = v * 2; }
  refresh() { return this._n; }
}
class Tripled extends Counted {
  private _m = 0;
  override get n(): number { return this._m + 1; }
  override set n(v: number) { this._m = v * 3; }
}
class Named extends Counted {
  get label(): string { return "c" + this.refresh(); }
}
interface Get<T> { get(): T }
class Cell<T> implements Get<T> {
  private v: T;
  constructor(v: T) { this.v = v; }
  get(): T { return this.v; }
  get value(): T { return this.v; }
  set value(v: T) { this.v = v; }
}
const k = new Counted();
const jn: Base & { n: number } = k;
jn.n = 5;
console.log(k.n, jn.n, jn.refresh());
const t: Base & { n: number } = new Tripled();
t.n = 2;
console.log(t.n, t.refresh());
const nm = new Named();
const r: Base & { readonly label: string; n: number } = nm;
r.n = 4;
console.log(r.label, r.n, nm.n);
const c = new Cell("a");
const g: Get<string> & { value: string } = c;
g.value = "b";
console.log(g.get(), c.value, g.value);
