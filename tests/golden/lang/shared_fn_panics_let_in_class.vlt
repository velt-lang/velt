// The compiler can't follow a function an interface method returns, so `shared(...)` panics.
type F = (x: i64) => i64;

class H {
  f: F;
  constructor(f: F) {
    this.f = f;
  }
}

interface Fi {
  make(): F;
}

class Fa implements Fi {
  make(): F {
    let n: i64 = 0;
    return (x: i64): i64 => {
      n += 1;
      return n;
    };
  }
}

async function main() {
  const m: Fi = new Fa();
  const h = new H(m.make());
  const f = shared((x: i64): i64 => h.f(x));
  console.log(f(1));
}
