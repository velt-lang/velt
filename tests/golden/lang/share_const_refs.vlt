// check: no leaks
// Semantics stage 2: `const left = node.left` refers to the same object as the field; when the
// block replaces the field, `left` keeps the old object (formerly an error golden,
// lang/errors/const_borrow_changed).
class T {
  left: T | null = null;
  right: T | null = null;
  v: i64 = 1;

  reset() {
    this.left = null;
  }
}

function f(node: T): i64 {
  const left = node.left;
  node.right = new T();
  node.left = null;
  return left === null ? 0 : left.v;
}

function g(node: T): i64 {
  const left = node.left;
  node.reset();
  return left === null ? 0 : left.v;
}

function h(rows: T[][]): usize {
  const row = rows[0];
  rows.push([]);
  return row.length as usize;
}

function k(node: T) {
  const left = node.left;
  if (left !== null) {
    left.v = 2;
  }
}

function main() {
  const t = new T();
  t.left = new T();
  k(t);
  console.log(t.left?.v);
  console.log(f(t));
  console.log(t.left === null, g(t));
  console.log(h([[t]]));
}
