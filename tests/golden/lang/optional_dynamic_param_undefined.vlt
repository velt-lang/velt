// check: no leaks
// An optional parameter of a dynamic type (`any`, `unknown`) that a call leaves out holds
// `undefined`, as in JavaScript: `=== undefined`, `typeof`, `??` and printing all see it
// (#1178).
function opt(o?: any): string {
  return o === undefined ? "none" : typeof o;
}
function optUnknown(o?: unknown): string {
  return o === undefined ? "none" : typeof o;
}
console.log(opt(), optUnknown(), opt(1), optUnknown("s"), opt(null), optUnknown(null));

function show(o?: any): void {
  console.log(o, typeof o, o ?? "fallback", o == null, o === null, o === undefined);
}
show();
show(undefined);
show(null);
show(0);

function showUnknown(o?: unknown): void {
  console.log(o, typeof o, o ?? "fallback", o == null, o === null, o === undefined);
}
showUnknown();
showUnknown(false);

// After a required parameter, and before another optional one.
function mixed(a: number, o?: any, u?: unknown): void {
  console.log(a, o, u, typeof o, typeof u, o === undefined, u === undefined);
}
mixed(1);
mixed(2, undefined, "x");
mixed(3, "o");

// `T | undefined` parameters.
function orUndefined(o?: number | undefined): void {
  console.log(o, typeof o, o === undefined);
}
orUndefined();
orUndefined(undefined);
orUndefined(4);
const arrowOrUndefined = (s?: string | undefined): string => s ?? "arrow default";
console.log(arrowOrUndefined(), arrowOrUndefined("s"));

// A default applies to a passed `undefined` too, also one an `any` holds.
function anyDefault(o: any = 5): void {
  console.log(o, typeof o);
}
anyDefault();
anyDefault(undefined);
anyDefault(null);
anyDefault("given");
const held: any = undefined;
anyDefault(held);
anyDefault([1, 2]);
function passOn(o?: any): void {
  anyDefault(o);
}
passOn();
passOn(0);

// Arrows, methods and static methods.
const arrow = (o?: any): string => (o === undefined ? "arrow none" : `arrow ${typeof o}`);
console.log(arrow(), arrow([1]));
class K {
  method(o?: unknown): string {
    return o === undefined ? "method none" : `method ${typeof o}`;
  }
  static make(o?: any): string {
    return `${o}`;
  }
}
console.log(new K().method(), new K().method(1), K.make(), K.make(2));

// Through an interface.
interface Opt {
  take(o?: any): string;
}
class Impl implements Opt {
  take(o?: any): string {
    return o === undefined ? "impl none" : `impl ${o}`;
  }
}
const viaIface: Opt = new Impl();
console.log(viaIface.take(), viaIface.take(7));

// Stored and passed on.
function keep(o?: any): any[] {
  return [o, typeof o];
}
console.log(keep());
console.log(JSON.stringify({ v: opt() }), String(keep()[0]));
