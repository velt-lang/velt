// A closure literal a function passes on and calls inside a `read` runs by read mode's rules even
// when the code that made it is plain (sync `main`): its write to the store stops the program.
class Item {
  v: i64 = 0;
  constructor(v: i64) {
    this.v = v;
  }
}
class St {
  items: Item[] = [];
}
function setup(): shared<RwLock<St>> {
  const rw = shared(new RwLock<St>(new St()));
  rw.write((s) => {
    const it0 = new Item(1);
    s.items.push(it0);
    s.items.push(it0);
  });
  return rw;
}
function g(rw: shared<RwLock<St>>, cb: (it: Item) => i64): i64 {
  return rw.read((s) => cb(s.items[0]));
}
function main() {
  const rw = setup();
  const n = g(rw, (it) => {
    it.v = 9;
    return it.v;
  });
  console.log(n, rw.read((s) => s.items[0].v));
}
