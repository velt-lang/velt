  -19001,
];

function show<T>(name: string, t: T[]): string {
  let all = "";
  for (const x of t) {
    all += `${x},`;
  }
  return `${name} ${t.length} ${t[0]} ${t[7]} ${t[t.length - 1]} [${all}]`;
}

function main() {
  console.log(show("U8S", U8S));
  console.log(show("U16S", U16S));
  console.log(show("U32S", U32S));
  console.log(show("U64S", U64S));
  console.log(show("I8S", I8S));
  console.log(show("I16S", I16S));
  console.log(show("I32S", I32S));
  console.log(show("I64S", I64S));
  console.log(show("F32S", F32S));
  console.log(show("F64S", F64S));
  console.log(show("NEG", NEG));
  // A local literal: the same elements, built where it is read.
  const local: u64[] = [
    0,
    1,
    0x102030405060708,
    0x7fffffffffffffff,
    0x8000000000000000,
    0xfffefdfcfbfaf9f8,
    0xffffffffffffffff,
    0x1122334455667700,
    0x1122334455667701,
    0x1122334455667702,
    0x1122334455667703,
    0x1122334455667704,
    0x1122334455667705,
    0x1122334455667706,
    0x1122334455667707,
    0x1122334455667708,
    0x1122334455667709,
    0x112233445566770a,
    0x112233445566770b,
    0x112233445566770c,
  ];
  console.log(show("local u64", local));
  const localF: f32[] = [
    0,
    1,
    1.5,
    0.25,
    -0,
    65504,
    0.1,
    3.4028234663852886e38,
    0.5,
    1.5,
    2.5,
    3.5,
    4.5,
    5.5,
    6.5,
    7.5,
    8.5,
    9.5,
    10.5,
    11.5,
  ];
  console.log(show("local f32", localF));
  let sum = 0;
  U8S.forEach((x) => {
    sum += x;
  });
  console.log(`sum ${sum} ${I16S[3]} ${U16S.indexOf(0x8000)}`);
}
