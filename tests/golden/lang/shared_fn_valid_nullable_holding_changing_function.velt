// Valid: A nullable function in `shared(...)`, which changes what it captured: it isn't a `shared` function value, whose calls run on a copy.
type F = (x: i64) => i64;
async function main() {
  let hits: i64 = 0;
  const g: F = (x: i64): i64 => { hits += 1; return hits; };
  const o: F | null = Date.now() > 0 ? g : null;
  const s = shared(o);
  console.log(g(1), hits, s == null);
}
