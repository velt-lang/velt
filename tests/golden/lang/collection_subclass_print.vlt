// A subclass of `Map` or `Set` prints as Node prints it: its entries under its own name, tagged
// with the base, and `String()` gives the base's tag.
class Counts extends Map<string, number> {
  bump(k: string): void {
    this.set(k, (this.get(k) ?? 0) + 1);
  }
}
class Tags extends Set<string> {}
class Named<V> extends Map<string, V> {}
class Deeper extends Counts {}
const c = new Counts();
c.bump("a");
c.bump("a");
c.bump("b");
const t = new Tags();
t.add("x");
const n = new Named<boolean>();
const d = new Deeper();
d.bump("z");
console.log(c, String(c));
console.log(t, `${t}`);
console.log(n, d, [c]);
console.log({ inner: { deep: { more: c } } });
