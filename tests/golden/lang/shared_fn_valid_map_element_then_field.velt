// Valid: a closure of the same function type as one in `shared(...)` isn't refused for that.
type F = (x: i64) => i64;
class C { n: i64 = 0; }
async function main() {
  const reg = new Map<string, F>();
  reg.set("pure", (x: i64): i64 => x);
  const s = shared(reg.get("pure")!);
  const c = new C();
  const local = new Map<string, F>();
  local.set("count", (x: i64): i64 => { c.n += 1; return c.n; });
  console.log(local.get("count")!(1), local.get("count")!(1), c.n);
  console.log(s == null);
}
