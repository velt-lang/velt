// Functions whose type says they may throw, called through `any` (#1938): a call that doesn't
// throw returns its value, as a call of the function's own type does.

// sigx's `slots.default`: a function stored on an `any` object, whose callee may throw.
function inner(list: any[], p?: any): any[] {
  if (list.length > 5) {
    throw new Error("too many");
  }
  return list.map((x) => (typeof x === "function" ? x(p) : x));
}

const store: any = Object.create(null);
const kids: any[] = ["a", () => "b"];
store.default = (scopedProps?: any) => inner(kids, scopedProps);
console.log(store.default());
console.log(store.default({ n: 1 }));

// A named function, an arrow and a field of an object literal, called through `any`.
function check(n: number): number {
  if (n < 0) {
    throw new RangeError(`${n} is negative`);
  }
  return n * 2;
}

const f: any = check;
console.log(f(21));
const o: any = {
  ratio: (x: number) => {
    if (x === 0) {
      throw new Error("zero");
    }
    return 10 / x;
  },
};
console.log(o.ratio(4));

// A class method that may throw, called through `any`.
class Counter {
  n = 1;
  add(k: number): number {
    if (k < 0) {
      throw new Error("negative step");
    }
    this.n += k;
    return this.n;
  }
}

const c: any = new Counter();
console.log(c.add(2), c.add(3));

// Nested calls through `any`, and a function passed through `any` and called there.
const leaf: any = (n: number) => {
  if (n === 3) {
    throw new TypeError("three");
  }
  return n * 10;
};
const mid: any = (n: number) => leaf(n) + 1;
const top: any = (n: number) => mid(n) + 1;
console.log(top(1), top(2));
const apply: any = (g: any, v: any) => g(v);
console.log(apply(o.ratio, 5), apply(f, 4), apply(leaf, 7));

// A function that may throw, called many times through `any`.
let sum = 0;
for (let i = 0; i < 1000; i++) {
  sum += f(i);
}
console.log(sum);
