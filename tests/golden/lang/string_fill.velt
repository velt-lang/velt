// `repeat`, `padStart` and `padEnd` (std/lang/string/fill.velt, #2198): lengths in UTF-16 code
// units, a fill cut between the halves of a pair, and seams where two halves meet and join.
// The expected output is Node's (this file runs there unchanged, with `main()` called). Lone
// surrogates come from `String.fromCharCode`.

const HI = String.fromCharCode(0xd83d);
const LO = String.fromCharCode(0xde00);

/** The UTF-16 code units of `s`, in hex. */
function hex(s: string): string {
  let out = "";
  for (let i = 0; i < s.length; i++) {
    out += s.charCodeAt(i).toString(16) + ".";
  }
  return out;
}

function one(s: string) {
  console.log(s.length, hex(s));
}

function main() {
  one("ab".repeat(0));
  one("ab".repeat(1));
  one("ab".repeat(7));
  one("-".repeat(50));
  one("é😀".repeat(5));
  one(("" + LO + "" + HI + "").repeat(3));
  one(("" + LO + "x" + HI + "").repeat(4));
  one("x".padStart(5, "ab"));
  one("x".padEnd(5, "ab"));
  one("x".padEnd(4));
  one("x".padStart(30, "."));
  one("x".padStart(60, "."));
  one("abc".padStart(2, "."));
  one("abc".padStart(6, ""));
  one("".padStart(5, "😀"));
  one("".padEnd(5, "😀"));
  one(("" + LO + "").padStart(4, "a" + HI + ""));
  one(("" + LO + "").padStart(3, "😀"));
  one("é".padEnd(6, "日本"));
  one("x".padStart(-3, "."));
}
