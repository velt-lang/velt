// A program whose only cycle runs through one route (map): sema finds a live type that can
// hold itself, so printing tracks it and writes <ref *1> and [Circular *1] as Node does.
class Bag { items: Map<string, Bag> = new Map<string, Bag>(); }
function main() { const g = new Bag(); g.items.set("self", g); console.log(g); }
main();
