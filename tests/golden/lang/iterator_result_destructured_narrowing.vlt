// A destructured iterator result narrows (issue #1114): after a test of `done`, `value` is the
// iterator's value type, as in TypeScript.
async function* gen(): AsyncGenerator<string> {
  yield "a";
  yield "b";
}

function* nums(): Generator<number> {
  yield 1;
  yield 2;
}

function first(it: Iterator<number>): number {
  const { value, done } = it.next();
  if (done) {
    return -1;
  }
  return value * 10;
}

async function main() {
  const it = gen();
  for (;;) {
    const { value, done } = await it.next();
    if (done) {
      break;
    }
    const s: string = value;
    console.log(s.toUpperCase());
  }
  const ns = nums();
  while (true) {
    const { done, value } = ns.next();
    if (!done) {
      console.log(value + 1);
    } else {
      break;
    }
  }
  const more = nums();
  const { value: v, done: d } = more.next();
  if (d === false) {
    console.log(v * 2);
  }
  const empty: number[] = [];
  console.log(first(nums()), first(empty[Symbol.iterator]()));
}
