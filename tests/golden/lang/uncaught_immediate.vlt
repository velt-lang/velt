// An error a `setImmediate` callback throws ends the process at the throw, as in Node: a
// microtask it queued before the throw and later callbacks don't run (#1154). The timeout is long
// so it is not due before the immediates even on a loaded machine: Node, too, runs a timeout
// first that is due by the time the event loop starts (#1478).
setImmediate(() => {
  console.log("imm");
  queueMicrotask(() => console.log("after"));
  throw new Error("imm failed");
});
setImmediate(() => console.log("imm2"));
setTimeout(() => console.log("t"), 1000);
