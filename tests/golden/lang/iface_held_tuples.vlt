// A write into a tuple behind `!` or `as` changes the tuple the program holds: in a field read
// through an interface (through the getter, the write and the setter, as `h.t[0] = 5`), in a
// bounded generic, in a union member, and in the object a conditional or a call gives.
interface H {
  opt: [number, string] | null;
  u: [number, string] | number;
  m(): number;
}

class C implements H {
  opt: [number, string] | null = [1, "o"];
  u: [number, string] | number = [1, "u"];
  m(): number {
    return 1;
  }
}

function run(h: H): void {
  h.opt![0] = 3;
  (h.opt as [number, string])[1] = "z";
  (h.u as [number, string])[0] += 4;
  console.log(h.opt, h.u);
  h.opt![0]++;
  const a = (h.opt![0] += 1);
  h.opt![1] += (() => "!")();
  console.log(a, h.opt);
}

function gen<T extends H>(h: T): void {
  h.opt![0] = 9;
  (h.u as [number, string])[1] = "g";
  console.log(h.opt, h.u);
}

const c = new C();
run(c);
gen(c);
console.log(c.opt, c.u);

// A union member of a parameter or of an element's field.
function member(u: [number, string] | number): void {
  (u as [number, string])[0] += 1;
  (u as [number, string])[1] = (() => "q")();
  console.log(u);
}

member([1, "a"]);
type R = { u: [number, string] | number };
const rs: R[] = [{ u: [1, "x"] }];
let ri = 0;
(rs[ri].u as [number, string])[0] = (() => {
  ri = 7;
  return 9;
})();
console.log(JSON.stringify(rs), ri);

// The object a conditional, a call or `find(…)!` gives is shared: the write lands in it.
type P = { t: [number, string] | null };
const p1: P = { t: [1, "p1"] };
const p2: P = { t: [2, "p2"] };
const ps: P[] = [p1, p2];
let flag = true;
(flag ? p1 : p2).t![0] = 50;
ps.find((p) => p.t![0] === 2)!.t![1] = "found";
console.log(p1.t, p2.t);
flag = false;
(flag ? p1 : p2).t![0] += 5;
const w = ((flag ? p1 : p2).t![1] = "w");
(ps.find((p) => p.t![0] === 50)!.t as [number, string])[0]++;
console.log(w, p1.t, p2.t, ps[0].t, ps[1].t);
const pick = (): P => p2;
pick().t![0] = 77;
let i = 0;
ps[i++].t![0] += 1;
console.log(p1.t, p2.t, i);

// Nested tuples behind `!`, and a class's own fields.
const nested: [[number, number] | null, number] | null = [[1, 2], 3];
nested![0]![1] = 20;
console.log(nested);

class Holder {
  t: [number, string] | null = [1, "h"];
  rows: ([number, string] | null)[] = [[1, "r"]];
  bump(): void {
    let j = 0;
    this.t![0] = (() => {
      j++;
      return 4;
    })();
    this.rows[j - 1]![1] += (() => {
      j = 5;
      return "!";
    })();
    console.log(this.t, this.rows, j);
  }
}

new Holder().bump();
const grid: ([number, number] | null)[][] = [
  [
    [0, 0],
    [0, 0],
  ],
  [
    [0, 0],
    [0, 0],
  ],
];
let k = 0;
grid[k][k++]![1] = 3;
console.log(JSON.stringify(grid), k);
