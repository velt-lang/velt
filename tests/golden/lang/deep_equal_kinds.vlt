// `deepEqual` and `toEqual` on each kind of type their code is generated for (std/lang/equal):
// numbers (SameValueZero against `Object.is`), strings, literal and enum types, arrays, tuples,
// options, optional fields, object values and structs, unions (two number members by their
// numbers), `Map`, `Record`, `Set`, `Date`, `shared` cells, class instances (by identity in
// `deepEqual`, by the fields of their own class in `toEqual`), and function values.
import { expect } from "velt/test";

function toEq<T>(a: T, b: T): bool {
  try {
    expect(a).toEqual(b);
    return true;
  } catch (e) {
    return false;
  }
}

function both<T>(name: string, a: T, b: T) {
  console.log(name, deepEqual(a, b), toEq(a, b));
}

enum Color {
  Red,
  Green,
}

type Opt = { a: number; b?: string; c: string | null };
type Num = f64 | u8 | i64;
type Tree = { v: number; kids: Tree[] };

struct Pair {
  x: i32;
  y: string;
}

class Animal {
  constructor(public name: string) {}
}

class Dog extends Animal {
  constructor(name: string, public bark: number) {
    super(name);
  }
}

class Cat extends Animal {
  constructor(name: string) {
    super(name);
  }
}

function numbers() {
  both("nan", NaN, NaN);
  both("zero", 0, -0);
  both("ints", 3 as i32, 3 as i32);
  both("strings", "a", "a");
  both("enum", Color.Red, Color.Green);
  const z: Num = 0 as u8;
  const nz: Num = -0.0 as f64;
  const big: Num = 9007199254740993 as i64;
  const near: Num = 9007199254740992.0 as f64;
  both("union zero", z, nz);
  both("union one", 1 as u8 as Num, 1.0 as f64 as Num);
  both("union big", big, near);
  both("union kinds", 1 as u8 as Num, 2 as i64 as Num);
}

function shapes() {
  both("arrays", [1, 2, 3], [1, 2, 3]);
  both("array lengths", [1, 2], [1, 2, 3]);
  both("nested", [[1], [2, 3]], [[1], [2, 4]]);
  const t1: [number, string] = [1, "a"];
  const t2: [number, string] = [1, "b"];
  both("tuples", t1, t2);
  const o1: Opt = { a: 1, c: null };
  const o2: Opt = { a: 1, c: null };
  const o3: Opt = { a: 1, b: "x", c: null };
  const o4: Opt = { a: 1, c: "y" };
  both("optional same", o1, o2);
  both("optional present", o1, o3);
  both("nullable", o1, o4);
  const p1: Pair = { x: 1, y: "a" };
  const p2: Pair = { x: 1, y: "a" };
  both("structs", p1, p2);
  const n1: number | null = null;
  const n2: number | null = 2;
  both("options", n1, n2);
  both("options null", n1, null);
  const t: Tree = { v: 1, kids: [{ v: 2, kids: [] }] };
  const u: Tree = { v: 1, kids: [{ v: 2, kids: [] }] };
  both("trees", t, u);
}

function collections() {
  const m1 = new Map<string, number>([
    ["a", 1],
    ["b", 2],
  ]);
  const m2 = new Map<string, number>([
    ["b", 2],
    ["a", 1],
  ]);
  const m3 = new Map<string, number>([
    ["a", 1],
    ["b", 3],
  ]);
  both("maps in any order", m1, m2);
  both("maps", m1, m3);
  const r1: Record<string, number> = { a: 1, b: 2 };
  const r2: Record<string, number> = { b: 2, a: 1 };
  both("records", r1, r2);
  const s1 = new Set<number>([1, 2]);
  const s2 = new Set<number>([2, 1]);
  const s3 = new Set<number>([1, 3]);
  both("sets", s1, s2);
  both("other sets", s1, s3);
  both("dates", new Date(5), new Date(5));
  both("other dates", new Date(5), new Date(6));
  const c1: shared<number[]> = shared([1, 2]);
  const c2: shared<number[]> = shared([1, 2]);
  both("shared", c1, c2);
}

function classes() {
  const d = new Dog("rex", 1);
  both("same dog", d, d);
  both("dogs", new Dog("rex", 1), new Dog("rex", 1));
  both("other dogs", new Dog("rex", 1), new Dog("rex", 2));
  const a1: Animal = new Dog("rex", 1);
  const a2: Animal = new Dog("rex", 1);
  const a3: Animal = new Cat("rex");
  const a4: Animal = new Animal("rex");
  both("dogs as animals", a1, a2);
  both("dog and cat", a1, a3);
  both("dog and animal", a1, a4);
  both("animals", new Animal("a"), new Animal("a"));
  const f = (x: number): number => x + 1;
  const g = (x: number): number => x + 1;
  both("same function", f, f);
  both("functions", f, g);
}

numbers();
shapes();
collections();
classes();
