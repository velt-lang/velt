// check: no leaks
// Interface values convert to interfaces whose members they have, in both directions, as the
// same object (#350); `A & B` and `B & A` are one type. A class converts to an intersection of
// interfaces it implements itself or through a base class, generic classes too, and fields
// written through the intersection reach the object.
interface P { f(): number }
interface Q { f(): number }
interface A { a(): number }
interface B { b(): number }
interface Get<T> { get(): T }
interface Put<T> { put(v: T): void }
interface Base { refresh(): number }
function sumBA(v: B & A): number {
  return v.a() + v.b();
}
class PA implements A {
  a() { return 1; }
}
class C extends PA implements B {
  b() { return 2; }
}
class Box<T> implements Get<T>, Put<T> {
  v: T;
  constructor(v: T) { this.v = v; }
  get() { return this.v; }
  put(v: T) { this.v = v; }
}
class Counted implements Base {
  errors = 1;
  refresh() { return this.errors; }
}
function roundTrip<T>(b: Box<T>, v: T): T {
  const gp: Get<T> & Put<T> = b;
  gp.put(v);
  const g: Get<T> = gp;
  return g.get();
}
const p: P = { f: () => 1 };
const q: Q = p;
const p2: P = q;
console.log(q.f(), p2.f(), p2 === p, q === p);
const ab: A & B = { a: () => 1, b: () => 2 };
console.log(sumBA(ab));
const ba: B & A = ab;
const back: A & B = ba;
console.log(ba === ab, back === ab);
const c = new C();
const cab: A & B = c;
const ca: A = cab;
console.log(cab.a(), cab.b(), cab === c, ca.a(), ca === c);
const box = new Box<number>(1);
const gp: Get<number> & Put<number> = box;
gp.put(5);
const g: Get<number> = gp;
console.log(gp.get(), box.v, gp === box, g.get(), g === box);
console.log(roundTrip(new Box<string>("a"), "b"));
const k = new Counted();
const j: Base & { errors: number } = k;
j.errors = 9;
const jb: Base = j;
console.log(k.errors, j.refresh(), j === k, jb.refresh(), jb === k);
