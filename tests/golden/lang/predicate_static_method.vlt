// A type predicate declared by a static method (`static is(v: unknown): v is P`) narrows the
// argument of `P.is(x)` in a condition, as a function's does. Node prints the same.
class P {
  x = 1;
  static is(v: unknown): v is P {
    return v instanceof P;
  }
}
class Q extends P {
  y = 2;
}
const t = (v: unknown): number => (P.is(v) ? v.x : 0);
const both = (v: unknown): string => (P.is(v) && v instanceof Q ? `${v.x}${v.y}` : "-");
console.log(t(new P()), t(new Q()), t("p"), both(new Q()), both(new P()));
