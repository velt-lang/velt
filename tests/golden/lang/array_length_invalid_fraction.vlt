// A fractional length is not a valid array length.
// Node throws `RangeError: Invalid array length`; Velt panics with the same text, and the
// array is unchanged (array_length_invalid_*.vlt: a fraction, a `number` variable, `NaN`).
function main() {
  const xs = [1, 2, 3];
  console.log(xs);
  xs.length = 1.5;
  console.log(xs);
}
