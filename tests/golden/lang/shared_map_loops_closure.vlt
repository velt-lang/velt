// check: no leaks
// A map loop over a `shared` held in a variable that a closure assigns (captured by reference,
// so the variable is no cell) keeps the box it started with alive while a call to the closure
// gives the variable another one: over the map, its `values()` and `keys()`, and a map in a map.
class Item {
  v: number;
  name: string;
  constructor(v: number) {
    this.v = v;
    this.name = `item${v}`;
  }
}

class Store {
  m: Map<string, Item> = new Map<string, Item>();
  mm: Map<string, Map<string, Item>> = new Map<string, Map<string, Item>>();
}

function mk(n: number): Store {
  const s = new Store();
  for (let i = 0; i < n; i++) {
    s.m.set(`k${i}`, new Item(i));
    const inner = new Map<string, Item>();
    inner.set(`j${i}`, new Item(i * 2));
    s.mm.set(`k${i}`, inner);
  }
  return s;
}

function churn(): number {
  let t = 0;
  for (let i = 0; i < 50; i++) {
    t += mk(20).m.size;
  }
  return t;
}

function values(): string {
  let s = shared(mk(50));
  const f = () => {
    s = shared(mk(1));
    churn();
  };
  let t = 0;
  for (const v of s.m.values()) {
    t += v.v + v.name.length;
    if (v.v == 3) {
      f();
    }
  }
  return `${t} ${s.m.size}`;
}

function entries(): string {
  let s = shared(mk(50));
  const f = () => {
    s = shared(mk(1));
    churn();
  };
  let t = 0;
  for (const [k, v] of s.m) {
    t += v.v + k.length;
    if (v.v == 3) {
      f();
    }
  }
  return `${t}`;
}

function keys(): string {
  let s = shared(mk(50));
  const f = () => {
    s = shared(mk(1));
    churn();
  };
  let t = 0;
  for (const k of s.m.keys()) {
    t += k.length;
    if (k == "k3") {
      f();
    }
  }
  return `${t} ${s.m.size}`;
}

function nested(): string {
  let s = shared(mk(50));
  const f = () => {
    s = shared(mk(1));
    churn();
  };
  let t = 0;
  for (const [k, v] of s.mm) {
    for (const [k2, w] of v) {
      t += w.v + k2.length;
    }
    if (k == "k3") {
      f();
    }
  }
  return `${t}`;
}

function main() {
  console.log(values(), entries(), keys(), nested());
}
