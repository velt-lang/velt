// `Reflect.set` on a proxy runs its `set` trap and gives the trap's answer, `false` included
// (where a write `p.k = v` throws), with the proxy as the receiver by default.
const log: string[] = [];
const target = { a: 1, b: "x" };
const p: any = new Proxy(target, {
  set(t, k, v, r) {
    log.push("set " + String(k) + " receiver is proxy: " + (r === p));
    return Reflect.set(t, k, v, r);
  },
});
console.log(Reflect.set(p, "a", 2), target.a);
console.log(Reflect.set(p, "b", "y", p), target.b);

const forward = new Proxy({ a: 1 }, {});
console.log(Reflect.set(forward, "a", 3), forward.a);

const refuse = new Proxy(
  { a: 1 },
  {
    set() {
      return false;
    },
  },
);
console.log(Reflect.set(refuse, "a", 9), refuse.a);

const typed: { a: number } = new Proxy(
  { a: 1 },
  {
    set(t, k, v) {
      log.push("typed set " + String(k));
      return k === "a" ? Reflect.set(t, k, v) : false;
    },
  },
);
console.log(Reflect.set(typed, "a", 4), typed.a);
console.log(log.join("\n"));
