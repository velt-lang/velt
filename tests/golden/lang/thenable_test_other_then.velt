// A thenable test through `any` on a union whose other member has a `then` of its own (a class
// that declares one) stays an error (#379). tsc accepts it: the refusal is Velt's limitation,
// recorded here. The test's other refusals are in thenable_test_unknown.velt.
class Later {
  then(f: () => void) {
    f();
  }
}

function describe(r: Promise<number> | Later): string {
  return typeof (r as any).then === "function" ? "thenable" : "value";
}

console.log(describe(new Later()));
