// A thenable test through `any` on a union whose other member has a `then` of its own (a class
// that declares one, #379). The union with a promise is held as `any` (#924), but reading the
// class's method `then` through `any` stops with a `TypeError`. tsc accepts it and Node prints
// `thenable`: the error is Velt's limitation, recorded here. The test's other refusals are in
// thenable_test_unknown.velt.
class Later {
  then(f: () => void) {
    f();
  }
}

function describe(r: Promise<number> | Later): string {
  return typeof (r as any).then === "function" ? "thenable" : "value";
}

console.log(describe(new Later()));
