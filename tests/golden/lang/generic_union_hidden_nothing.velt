// check: no leaks
// A union of a type parameter and other members, at a type argument that allows `null` or
// `undefined` the union does not list itself (#1268).
function mixed<T>(x: T | string | undefined): string {
  if (x === undefined) {
    return "undefined";
  }
  return String(x);
}
function both<T>(x: T | string): string {
  return `${x}`;
}
function back<T>(x: T, s: boolean): T | string | undefined {
  return s ? "s" : x;
}
console.log(mixed<number | null>(null), mixed<number | null>(3), mixed<number | null>(undefined), mixed<number | null>("s"));
console.log(both<number | null>(null), both<number | undefined>(undefined), both<boolean | null>(true));
const n: number | string | null | undefined = back<number | null>(null, false);
console.log(n, back<number | null>(null, true), back<number | null>(2, false));
const vs: (number | null | string | undefined)[] = [null, undefined, 1, "x"];
console.log(vs.map((v) => mixed<number | null>(v)).join(","));

const r = back<number | null>(null, false);
console.log(r == null, r === null, r === undefined, r ?? "d", r);
const q = back<number | null>(4, false);
console.log(q == null, q === null, q ?? "d");

class Box<T> {
  v: T | string | undefined;
  constructor(v: T | string | undefined) {
    this.v = v;
  }
}
const b = new Box<number | null>(null);
console.log(b.v == null, b.v === null, b.v ?? "d", JSON.stringify({ v: b.v }), b);
b.v = 5;
console.log(b.v == null, b.v ?? "d");
b.v = null;
const x = b.v;
if (x !== null && x !== undefined) {
  console.log("value", x);
} else {
  console.log("nothing", x);
}
b.v = undefined;
console.log(b.v, b);
const names = new Box<string[] | null>(null);
names.v = ["a"];
console.log(names.v == null, names.v);
