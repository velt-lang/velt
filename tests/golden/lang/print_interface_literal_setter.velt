// An object literal filling an interface field with `get v()` and `set v(x)`: printed through
// the interface, the property is `[Getter/Setter]`, as Node prints it (#2739).
interface Settable {
  v: number;
  describe(): string;
}

const gs: Settable = {
  get v() {
    return 1;
  },
  set v(x: number) {},
  describe() {
    return "y";
  },
};
console.log(gs);
