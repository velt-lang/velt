// `typeof mod === "function"` on a union of field-only interfaces and object types (#2655,
// sigx's island registry): TypeScript allows the test, since such a value may be a function
// there; every Velt value of those types is an object, so the test is false.
interface Factory { __setup: () => string; __name?: string }
function unwrap(mod: Factory | { default: Factory; [key: string]: any }): Factory | undefined {
    if (mod && typeof mod === "function" && "__setup" in mod) return mod as Factory;
    if (mod && typeof mod === "object" && "default" in mod) return mod.default;
    return undefined;
}
const plain: Factory = { __setup: () => "setup", __name: "Plain" };
console.log(unwrap({ default: plain })?.__name, typeof plain === "function", typeof plain);
