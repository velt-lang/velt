// A program whose only cycle runs through one route (interface): sema finds a live type that can
// hold itself, so printing tracks it and writes <ref *1> and [Circular *1] as Node does.
interface Shape { name(): string; }
class Ring implements Shape { next: Shape | null = null; name(): string { return "ring"; } }
function main() { const r = new Ring(); r.next = r; console.log(r); }
main();
