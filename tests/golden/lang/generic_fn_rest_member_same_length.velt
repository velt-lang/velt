// A reduced form whose union members share a length: the arguments fit one of them. Expected output
// from `node`; `tsc --strict` accepts it.
type M = <N extends "a" | "b">(n: N, ...r: N extends "a" ? [number] : [string]) => number;
const m: M = (n, ...r) => r.length;
const u = (Math.random() > 2 ? "a" : "b") as "a" | "b";
console.log(m(u, "s"), m(u, 1), m(u, true as any));
