// check: no leaks
// The `defineProperty` trap (#823): `Reflect.defineProperty` of a proxy runs it with the key
// and the attributes as written; `false` is the answer, a trap the handler leaves out forwards
// to the target, and an attribute left out of a new property of a plain value is `false`.
function main(): void {
  const log: string[] = [];
  const raw: Record<string, number> = { a: 1 };
  const target: any = raw;
  const p: any = new Proxy(target, {
    defineProperty(t, k, d) {
      log.push(`define ${String(k)} ${JSON.stringify(d)}`);
      if (k === "frozen") return false;
      return Reflect.defineProperty(t, k, d);
    },
  });
  console.log(Reflect.defineProperty(p, "a", { value: 5 }));
  console.log(Reflect.defineProperty(p, "b", { value: 6, writable: true, enumerable: true, configurable: true }));
  console.log(Reflect.defineProperty(p, "frozen", { value: 7 }));
  console.log(raw, log.join("\n"));

  // Forwarded: no trap.
  const q: any = new Proxy(target, {});
  console.log(Reflect.defineProperty(q, "c", { value: 8, writable: true, enumerable: true, configurable: true }));
  console.log(Reflect.defineProperty(q, "a", { value: 9 }), raw);

  // An array's `length` may be written but not made enumerable.
  const arr: any = [1, 2, 3];
  console.log(Reflect.defineProperty(arr, "length", { enumerable: true }));
  console.log(Reflect.getOwnPropertyDescriptor(arr, "length"));
}
