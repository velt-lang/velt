// Computed object-literal keys that are any expression (`{ [o.tag]: v }`): the object has
// string keys, so it is a `Record<string, V>`, as TypeScript's type has a string index signature.
function f(cond: boolean, o: { tag: string }): Record<string, number> {
  return cond ? { [o.tag]: 1 } : {};
}

function pair(k: string, v: string): Record<string, string> {
  const other = k + "2";
  return { [k]: v, [other]: v + v };
}

console.log(JSON.stringify(f(true, { tag: "x" })));
console.log(JSON.stringify(f(false, { tag: "x" })));
console.log(JSON.stringify(pair("a", "b")));
const parts = ["p", "q"];
const k = "b";
const r = { a: 1, [parts[0] + "!"]: 2, ["lit"]: 3, [`${k}${k}`]: 4, [7]: 5, a2: 6 };
console.log(JSON.stringify(r));
console.log(Object.keys(r).length);
const m: Record<string, string> = { [parts[1]]: "v", z: "w" };
console.log(m);
