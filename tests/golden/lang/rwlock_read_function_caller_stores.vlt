// check: no leaks
// A function that a `read` callback calls, given the containers of the code outside every
// read, runs reads of its own that store into them and take out of them: a `Set`, a `Map` and
// an array, one and two reads deep, then a later read (or plain code) that removes what they
// stored.
class Box {
  items: number[][] = [[1, 2], [3]];
}

function stash(b: RwLock<Box>, s: Set<number[][]>, m: Map<number, number[][]>, out: number[][][]) {
  b.read((y) => {
    s.add(y.items.slice());
    m.set(out.length, y.items.map((e) => e));
    out.push(y.items.slice());
  });
}

function stash2(b: RwLock<Box>, c: RwLock<Box>, out: number[][][], s: Set<number[][]>) {
  b.read((y) => {
    c.read((z) => {
      out.push(z.items.slice());
      s.add(y.items.map((e) => e));
    });
  });
}

function take(c: RwLock<Box>, out: number[][][]): number {
  let n = 0;
  c.read((v) => {
    while (out.length > 0) {
      out.pop();
      n++;
    }
  });
  return n;
}

function drop2(b: RwLock<Box>, c: RwLock<Box>, out: number[][][], s: Set<number[][]>) {
  b.read((y) => {
    c.read((z) => {
      out.pop();
      for (const t of s) {
        s.delete(t);
      }
    });
  });
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const c = new RwLock(new Box());
  const s = new Set<number[][]>();
  const m = new Map<number, number[][]>();
  const out: number[][][] = [];
  a.read((x) => {
    stash(b, s, m, out);
    stash(b, s, m, out);
  });
  console.log(s.size, m.size, out.length, JSON.stringify(out[0]));
  c.read((v) => {
    for (const t of s) {
      s.delete(t);
      console.log("set", JSON.stringify(t));
    }
    m.delete(0);
  });
  console.log(s.size, m.size);
  out[0].push([9]);
  a.read((x) => {
    console.log("took", take(c, out));
  });
  console.log(out.length);

  a.read((x) => {
    stash2(b, c, out, s);
  });
  stash2(b, c, out, s);
  out[0].push([1]);
  a.read((x) => {
    drop2(b, c, out, s);
  });
  console.log(out.length, s.size, JSON.stringify(out));
  drop2(b, c, out, s);
  console.log(out.length, s.size);
  m.clear();
  b.write((q) => {
    q.items[0].push(5);
  });
  b.read((y) => {
    console.log(JSON.stringify(y.items));
  });
}
