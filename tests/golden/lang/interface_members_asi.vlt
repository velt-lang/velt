// Interface and object type members end at a line break, as in TypeScript.
interface I {
  a: number;
  readonly b: string; // a comment
  k: (x: number) => number;
  o?: string;
}

interface J {
  [k: string]: number;
}

interface G<T> {
  get(): T;
  set(v: T): void;
  describe(): string;
}

type O = { a: number; b: string };

class Box implements G<number> {
  v = 0;
  w: string = "w";
  get(): number {
    return this.v;
  }
  set(v: number): void {
    this.v = v;
  }
  describe(): string {
    return "Box";
  }
}

const v: I = { a: 1, b: "x", k: (x) => x * 2, o: "p" };
console.log(v.a, v.b, v.k(4));
const j: J = { q: 1 };
console.log(j);
const o: O = { a: 1, b: "y" };
console.log(o);
const bx = new Box();
bx.set(5);
console.log(bx.get(), bx.w, bx.describe());
