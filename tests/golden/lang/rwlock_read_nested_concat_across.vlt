// check: no leaks
// A `read` nested in another joins the inner lock's array with the outer one's
// (`y.items.concat(x.items)`) and stores the result, or what is made of it, outside both reads:
// the copy of the outer lock's array given to `concat` is the inner reader's own, freed after
// the call, and a store crossing both locks copies what it stores once (#1523). The same for
// a value made of both locks' objects, and for reads inside a `Mutex`'s `with`.
class Box {
  items: number[][] = [[1, 2], [3], [4, 5]];
}

class Bag {
  list: number[][][] = [];
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const out: number[][][] = [];
  a.read((x) => {
    b.read((y) => {
      const c = y.items.concat(x.items);
      out.push(c);
      out.push(c.map((e) => e));
      out.push(x.items.concat(y.items).slice(1, 3));
    });
  });
  a.read((x) => {
    b.read((y) => {
      const unused = y.items.concat(x.items);
      out.push([x.items[0], y.items[1]]);
      console.log(unused.length);
    });
  });
  const m = new Mutex(new Bag());
  m.with((g) => {
    a.read((x) => {
      g.list.push(x.items.slice());
      out.push(x.items.map((e) => e));
      b.read((y) => {
        g.list.push(y.items.concat(x.items));
        out.push(y.items.slice());
      });
    });
  });
  a.write((q) => {
    q.items = [];
  });
  b.write((q) => {
    q.items = [];
  });
  out[0].push([6]);
  m.with((g) => {
    g.list[1].push([7]);
    console.log(JSON.stringify(g.list));
  });
  console.log(JSON.stringify(out));
}
