// @jsxImportSource ./_jsx_attrs

// The page of `jsx_intrinsic_attributes`. `_jsx_attrs_page_generic.vlt` and
// `_jsx_attrs_page_precompile.vlt`
// are the same source under the generic and the precompiling runtime.

function Counter(props: { start: number; label: string }): JSX.Element {
  return (
    <p>
      {props.label} {props.start}
    </p>
  );
}

export function page(n: number): JSX.Element {
  const media = "(min-width: 768px)";
  return (
    <main>
      <h1>Static</h1>
      <Counter client:load start={1} label="load" />
      <Counter label="visible" client:visible start={n} />
      <Counter client:media={media} client:idle start={3} label="media" />
      <Counter start={4} label="plain" />
    </main>
  );
}
