// A call that moves an object and lends a part of it: an array holding the owner (#2531). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; name: string = heap("n"); }
let hold: A2 | null = null;
let ah: A2[] | null = null;
function take(q: A2[], v: string) { ah = q; ah = null; junk(); return v + "!"; }
function t() { const b = [new A2()]; console.log(take(b, b[0].name)); }
t();
