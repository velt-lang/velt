// Interface assertions Velt doesn't check (#379), each a compile error: to a union of extensions
// (there is no run-time test of a value for one of several interfaces yet), to an extension with
// `undefined`, from a value that may be `undefined` (which Node passes on), and to an extension at
// other type arguments (no object is both).
interface Shape {
  area(): number;
}

interface Named extends Shape {
  name(): string;
}

interface Sided extends Shape {
  sides: number;
}


interface Source<T> {
  get(): T;
}

interface Labeled<T> extends Source<T> {
  label(): string;
}

const s: Shape = { area: () => 1, name: () => "n" } as Named;
const u = s as (Named | Sided);
const m = s as (Named | undefined);

function f(x: Shape | undefined): Named {
  return x as Named;
}

function g(x: Source<number>): Labeled<string> {
  return x as Labeled<string>;
}

function h(x: Source<number>): Labeled<any> {
  return x as Labeled<any>;
}

console.log(u, m);
