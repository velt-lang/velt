// Interface assertions Velt doesn't check (#379), each a compile error: from a value that may be
// `undefined` (which Node passes on) to an extension without `undefined`, and to an extension at
// other type arguments (no object is both). A union of extensions, or one with `undefined`, is
// checked at run time (#3073, `iface_downcast_union`).
interface Shape {
  area(): number;
}

interface Named extends Shape {
  name(): string;
}

interface Sided extends Shape {
  sides: number;
}


interface Source<T> {
  get(): T;
}

interface Labeled<T> extends Source<T> {
  label(): string;
}

const s: Shape = { area: () => 1, name: () => "n" } as Named;

function f(x: Shape | undefined): Named {
  return x as Named;
}

function g(x: Source<number>): Labeled<string> {
  return x as Labeled<string>;
}

function h(x: Source<number>): Labeled<any> {
  return x as Labeled<any>;
}

console.log(s.area());
