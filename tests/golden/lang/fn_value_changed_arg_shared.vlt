// A param a function value or a closure modifies is `Borrow` (calls through a value may pass
// one object twice), so the exclusivity rule does not see what such a call changes. When the
// argument for it may change under the callee, it is the object it was when it was evaluated,
// as in JavaScript: a later argument that calls a function value replacing the field passed
// first, or a part of an object passed with that object to a callee that replaces the part.

type N = { name: string; log: number[] };

function pushF(xs: number[], n: number): void {
  for (let i = 0; i < 40; i++) xs.push(n + i);
}

function swapF(b: N): number {
  b.log = [7];
  return 1000;
}

function growF(b: N): number {
  for (let i = 0; i < 40; i++) b.log.push(i);
  return 5000;
}

function workF(xs: number[], b: N): void {
  b.log = [9];
  for (let i = 0; i < 40; i++) xs.push(i);
}

const pushes: ((xs: number[], n: number) => void)[] = [pushF];
const swaps: ((b: N) => number)[] = [swapF, growF];
const works: ((xs: number[], b: N) => void)[] = [workF];

function show(label: string, p: N): void {
  console.log(label, p.log.length, p.log[0], p.log[p.log.length - 1]);
}

function factory() {
  const push = (xs: number[], n: number): void => {
    for (let i = 0; i < 40; i++) xs.push(n + i);
  };
  const swap = (b: N): number => {
    b.log = [7];
    return 1000;
  };
  const work = (xs: number[], b: N): void => {
    b.log = [9];
    for (let i = 0; i < 40; i++) xs.push(i);
  };
  const read = (xs: number[], b: N): number => {
    b.log = [5];
    let s = 0;
    for (let i = 0; i < xs.length; i++) s += xs[i];
    return s;
  };
  const one = (a: N): void => {
    push(a.log, swap(a));
  };
  const pass = (a: N, b: N): void => {
    push(a.log, swap(b));
  };
  const part = (a: N, b: N): void => {
    work(a.log, b);
  };
  const partRead = (a: N, b: N): number => read(a.log, b);
  return { one, pass, part, partRead };
}

function main() {
  // A later argument calls a function value that replaces the field passed first.
  const p: N = { name: "p", log: [1, 2, 3] };
  pushes[0](p.log, swaps[0](p));
  show("values", p);
  // ... or one that grows it: the callee then fills the grown array.
  const q: N = { name: "q", log: [1, 2, 3] };
  pushes[0](q.log, swaps[1](q));
  show("grown", q);

  // The same through closures, called by the names they are bound to and through captures.
  const k = factory();
  const r: N = { name: "r", log: [1, 2, 3] };
  k.one(r);
  show("one", r);
  const s: N = { name: "s", log: [1, 2, 3] };
  k.pass(s, s);
  show("pass same", s);
  const t: N = { name: "t", log: [1, 2, 3] };
  const other: N = { name: "o", log: [4] };
  k.pass(t, other);
  show("pass other", t);
  show("other", other);

  // A part and the whole: the callee replaces the part while it fills the array it was given.
  const u: N = { name: "u", log: [1, 2, 3] };
  works[0](u.log, u);
  show("part value", u);
  const v: N = { name: "v", log: [1, 2, 3] };
  k.part(v, v);
  show("part closure", v);
  const w: N = { name: "w", log: [1, 2, 3] };
  console.log("part read", k.partRead(w, w), w.log.join(","));
  const kept = w.log;
  k.part(w, w);
  show("part again", w);
  console.log("kept", kept.length, kept[0]);
}

main();
