// A param a function value or a closure modifies is `Borrow` (calls through a value may pass
// one object twice), so the exclusivity rule does not see what such a call changes. When the
// argument for it may change under the callee, it is the object it was when it was evaluated,
// as in JavaScript: here a later argument that calls a function value replacing the field
// passed first.

type N = { name: string; log: number[] };

function pushF(xs: number[], n: number): void {
  for (let i = 0; i < 40; i++) {
    xs.push(n + i);
  }
}

function swapF(b: N): number {
  b.log = [7];
  return 1000;
}

function growF(b: N): number {
  for (let i = 0; i < 40; i++) {
    b.log.push(i);
  }
  return 5000;
}

const pushes: ((xs: number[], n: number) => void)[] = [pushF];
const swaps: ((b: N) => number)[] = [swapF, growF];

function show(label: string, p: N): void {
  console.log(label, p.log.length, p.log[0], p.log[p.log.length - 1]);
}

function factory() {
  const push = (xs: number[], n: number): void => {
    for (let i = 0; i < 40; i++) {
      xs.push(n + i);
    }
  };
  const swap = (b: N): number => {
    b.log = [7];
    return 1000;
  };
  const one = (a: N): void => {
    push(a.log, swap(a));
  };
  const pass = (a: N, b: N): void => {
    push(a.log, swap(b));
  };
  return { one, pass };
}

function main() {
  // A later argument calls a function value that replaces the field passed first.
  const p: N = { name: "p", log: [1, 2, 3] };
  pushes[0](p.log, swaps[0](p));
  show("values", p);
  // ... or one that grows it: the callee then fills the grown array.
  const q: N = { name: "q", log: [1, 2, 3] };
  pushes[0](q.log, swaps[1](q));
  show("grown", q);

  // The same through closures, called by the names they are bound to and through captures.
  const k = factory();
  const r: N = { name: "r", log: [1, 2, 3] };
  k.one(r);
  show("one", r);
  const s: N = { name: "s", log: [1, 2, 3] };
  k.pass(s, s);
  show("pass same", s);
  const t: N = { name: "t", log: [1, 2, 3] };
  const other: N = { name: "o", log: [4] };
  k.pass(t, other);
  show("pass other", t);
  show("other", other);
}

main();
