// A union with falsy literal members (`"" | "a"`, `0 | 1`) tested for truthiness, as in TypeScript
// (#3370): `s || x`, `s ? s : x` and `s && x` take the members a truthy / falsy `s` can be (also
// with two truthy members, a field, a chain, `||=` and `if (!s)` / `else`), and an unannotated
// integer beside them is a `number` (`(s || 5) / 2` is 2.5, `n || 7` with `n: 0 | 1` 3.5).
interface Named {
  name: string;
}

function f(s: "" | "a") {
  const v = s || 5;
  if (typeof v === "number") console.log(v / 2);
}
function g(x: string | number): string {
  return `${x}`;
}
function h(s: "" | "a"): string {
  return g(s || 5);
}
function k(s: "" | "a"): string | number {
  let v = s || 5;
  v = 2.5;
  return v;
}
function t1(s: "" | "a") {
  const v = s ? s : 5;
  if (typeof v === "number") console.log(v / 2);
}
function t2(n: 0 | 1) {
  const v = n || 7;
  console.log(v / 2);
}

function two(s: "" | "a" | "b"): "a" | "b" | "c" {
  return s ? s : "c";
}
function twoOr(s: "" | "a" | "b"): "a" | "b" | "c" {
  return s || "c";
}
function nums(n: 0 | 1 | 2): 1 | 2 | 3 {
  return n || 3;
}
function nul(s: "" | "a" | "b" | null): "a" | "b" | "c" {
  return s || "c";
}
function and1(s: "" | "a"): "" | "c" {
  return s && "c";
}
function and2(n: 0 | 5): 0 | "c" {
  return n && "c";
}
function prop(o: { s: "" | "a" }): "a" | "c" {
  return o.s || "c";
}
function propT(o: { s: "" | "a" }): "a" | "c" {
  return o.s ? o.s : "c";
}
function falsy(s: "" | "a"): string {
  if (!s) {
    const t: "" = s;
    return `empty${t}`;
  }
  return s;
}
function elseSide(s: "" | "a"): string {
  if (s) {
    return s;
  } else {
    const t: "" = s;
    return `else${t}`;
  }
}
function chain(s: "" | "a", t: "" | "b"): "a" | "b" | "c" {
  return s || t || "c";
}
function orAssign(s: "" | "a"): "a" | "c" {
  let x: "" | "a" | "c" = s;
  x ||= "c";
  return x;
}
function nested(i: number, d: Named | undefined): Named | "none" {
  return i == 0 ? "none" : d ?? "none";
}

// `||` with a non-literal right side against a union, `n || d` with `d: number`, and `&&=`.
function orObj(s: "" | "a", d: Named): "a" | Named {
  return s || d;
}
function orObjConst(s: "" | "a", d: Named): string {
  const r: "a" | Named = s || d;
  return typeof r === "string" ? r : r.name;
}
function orArr(s: "" | "a"): "a" | number[] {
  return s || [1];
}
function orNum(n: 0 | 1, d: number): number {
  return n || d;
}
function andAssign(s: "" | "a"): "" | "c" {
  let x: "" | "a" | "c" = s;
  x &&= "c";
  return x;
}

function main() {
  f("");
  console.log(h(""), k("a"));
  t1("");
  t2(0);
  console.log(two(""), two("b"), twoOr(""), twoOr("a"), nums(0), nums(2), nul(null), nul("b"));
  console.log(`[${and1("")}]`, and1("a"), and2(0), and2(5), prop({ s: "" }), propT({ s: "a" }));
  console.log(falsy(""), falsy("a"), elseSide(""), elseSide("a"));
  console.log(chain("", ""), chain("", "b"), chain("a", ""), orAssign(""), orAssign("a"));
  const n = nested(1, undefined);
  console.log(typeof n === "string" ? n : n.name, nested(0, { name: "d" }));
  const d: Named = { name: "d" };
  const o = orObj("", d);
  console.log(typeof o === "string" ? o : o.name, orObj("a", d), orObjConst("", d), orObjConst("a", d));
  const a = orArr("");
  console.log(typeof a === "string" ? a : a.join(","), orArr("a"));
  console.log(orNum(0, 2.5), orNum(1, 2.5), `[${andAssign("")}]`, andAssign("a"));
}
