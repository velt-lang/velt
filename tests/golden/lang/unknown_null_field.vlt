// `null` in an object literal converted to `unknown` or `any`: a field of type `null`.
// check: no leaks
function show(u: unknown): void {
  console.log(u, JSON.stringify(u));
}
function main(): void {
  const u: unknown = { a: null, b: undefined, c: 1 };
  console.log(u);
  const xs: unknown[] = [null, { x: null }];
  console.log(xs);
  show({ v: null, w: "w" });
  const a: any = { p: null };
  console.log(a.p === null, a.p, typeof a.p);
}
