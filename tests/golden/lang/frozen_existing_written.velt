// A write to a frozen object seen as a type whose fields can be written throws Node's
// `TypeError`, uncaught here: the object carries a frozen mark (#2623, before #2554 refused it),
// here a value frozen where it is, written directly.
interface Config { name: string; port: number; }
const config: Config = { name: "app", port: 80 };
Object.freeze(config);
config.port = 81;
console.log(config.port);
