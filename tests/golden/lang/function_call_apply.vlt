// `f.call(thisArg, ...args)` and `f.apply(thisArg, list)` of a `Function` (#926): sigx's
// collection instrumentation calls `forEach` callbacks this way. `f` and `thisArg` are evaluated
// once, before the arguments; a `thisArg` left out is `undefined`.
// check: no leaks
function each(cb: Function, thisArg: unknown, items: string[]): void {
  for (let i = 0; i < items.length; i++) {
    cb.call(thisArg, items[i], i);
  }
}

function f(x?: number): string {
  return "f" + x;
}

function getU(): undefined {
  return undefined;
}

function tn(n: number): number {
  console.log("eval " + n);
  return n;
}

function pick(h: Function): Function {
  console.log("eval f");
  return h;
}

function main(): void {
  const seen: string[] = [];
  each((v: string, i: number) => seen.push(`${i}:${v}`), undefined, ["a", "b"]);
  console.log(seen);
  const add: Function = (a: number, b: number) => a + b;
  console.log(add.call(null, 2, 3), add.apply(undefined, [4, 5]));
  const none: Function = () => "none";
  console.log(none.call(undefined), none.apply(null));
  const h: Function = f;
  console.log(h.call(), h.call(void 0, 3), h.call(getU(), 4));
  console.log(h.apply(), h.apply(void 0, [5]), h.apply(getU(), [6]));
  console.log(h.call(null, tn(7)), pick(h).call(getU(), tn(8)));
  const v: any = getU();
  console.log(v, typeof v);
}
