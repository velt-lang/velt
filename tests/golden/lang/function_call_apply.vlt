// `f.call(thisArg, ...args)` and `f.apply(thisArg, list)` of a `Function` (#926): sigx's
// collection instrumentation calls `forEach` callbacks this way.
// check: no leaks
function each(cb: Function, thisArg: unknown, items: string[]): void {
  for (let i = 0; i < items.length; i++) {
    cb.call(thisArg, items[i], i);
  }
}
function main(): void {
  const seen: string[] = [];
  each((v: string, i: number) => seen.push(`${i}:${v}`), undefined, ["a", "b"]);
  console.log(seen);
  const add: Function = (a: number, b: number) => a + b;
  console.log(add.call(null, 2, 3), add.apply(undefined, [4, 5]));
  const none: Function = () => "none";
  console.log(none.call(undefined), none.apply(null));
}
