// Appending template text in place onto a string that shares its heap buffer with another
// variable (`s = `${s}…``, appended straight onto `s`). Grown in a loop, the buffer has room
// left, and the runtime's push copies a shared buffer before writing: each variable keeps its
// own text. (An inline append of template literals was tried for #1677 and reverted; only
// `JSON.stringify`'s glue appends inline, onto a builder nothing else shares.)
function grown(): string {
  let s = "";
  for (let i = 0; i < 40; i++) {
    s += "x";
  }
  return s;
}

function main() {
  let s = grown();
  let t = s;
  const n = 1;
  s = `${s}-${n}+`;
  t = `${t}=${n + 1}!`;
  console.log(s.slice(38), t.slice(38));
  let u = grown();
  const kept = u;
  u = `${u}[${n}]`;
  console.log(kept.length, u.slice(38), kept.slice(38));
}
