// A program whose only cycle runs through one route (generic_holder): sema finds a live type that can
// hold itself, so printing tracks it and writes <ref *1> and [Circular *1] as Node does.
class Holder<T> { value: T | null = null; }
class Boxed { box: Holder<Boxed> = new Holder<Boxed>(); }
function main() { const b = new Boxed(); b.box.value = b; console.log(b); }
main();
