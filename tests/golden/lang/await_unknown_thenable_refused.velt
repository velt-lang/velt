// `await` of an `any` holding an object with a `then` method (a thenable): JavaScript adopts
// it, and Velt doesn't yet (#3412), so it stops with a TypeError rather than giving the object
// itself. An object with no `then` is the value, as in Node.
async function main(): Promise<void> {
  const o: any = { n: 1 };
  console.log(await o);
  const t: any = { then: (r: (v: number) => void) => r(7) };
  console.log("not reached", await t);
}
main();
