// Where an `f16`/`bf16` is stored or read other than as a local (#2049): a module constant
// table, a `ThreadLocal`, an `Atomic` (its bits: load, store, exchange), an `any` (compared and
// called by value), a `switch` (compared as `==` does, in `f32`), and JSON (a number). The
// expected output is Node's, with each value a `Math.f16round`ed number.
const WS: f16[] = [0.1 as f16, 2 as f16, 1.5, -0];
// Constant tables fold to static data: casts, negated literals, constants, an integer above
// 2^53 into a bf16 (rounded from the integer), and storage floats widened into an `f32` table.
const H: f16 = 1.5;
const BIG: i64 = 4503599627370497;
const HS: f16[] = [(-2.5) as f16, H, 65519 as f16, 1e9 as f16, -0.0];
const BS: bf16[] = [BIG as bf16, (0.1 as f16) as bf16, 3 as bf16];
const FS: f32[] = [H as f32, (0.1 as f16) as f32];
const T = new ThreadLocal<f16>(1.5);
const A = new Atomic<bf16>(-2.5);

function kind(w: f16): string {
  switch (w) {
    case 0:
      return "zero";
    case 0.1:
      return "an f32 0.1";
    case 0.5:
      return "half";
    default:
      return "other";
  }
}

function main() {
  console.log(WS, WS[0] * 10, T.get(), A.load());
  console.log(HS, Object.is(HS[4], -0), BS, FS);
  T.set(-0.25);
  console.log(T.get());
  const at = new Atomic<f16>(1.5);
  at.store(2.5);
  console.log(at.load(), at.exchange(3), at.load(), at.compareExchange(3, 4), at.load());
  const a: any = 0 as f16;
  const b: any = -0 as f16;
  const n: any = (0 / 0) as f16;
  const t: any = 0.1 as f16;
  console.log(a === b, n === n, n !== n, t.toFixed(2), [a, n].indexOf(b), [a, n].includes(n));
  console.log(kind(-0), kind(0.1), kind(0.5), kind(2));
  console.log(JSON.stringify({ w: 1.5 as f16, b: 0.1 as bf16, xs: WS }));
}
