// Static methods of primitive types (issue #1679): `extend T { static … }` blocks of a number
// type, `bool` or `string` are called through the type's name.
extend f64 {
  static half(x: f64): f64 {
    return x / 2;
  }
  static parseOr(s: string, fallback: f64): f64 {
    const n = Number(s);
    return Number.isNaN(n) ? fallback : n;
  }
}

extend u64 {
  static fromParts(hi: u64, lo: u64): u64 {
    return (hi << 32) | lo;
  }
  // An instance method beside the statics.
  high(): u64 {
    return this >> 32;
  }
}

extend string {
  static repeatJoin(s: string, n: i64, sep: string): string {
    const parts: string[] = [];
    for (let i = 0; i < n; i++) parts.push(s);
    return parts.join(sep);
  }
}

extend bool {
  static parse(s: string): bool {
    return s == "true";
  }
}

console.log(f64.half(3));
console.log(f64.parseOr("2.5", 0), f64.parseOr("x", -1));
const w = u64.fromParts(1, 2);
console.log(w, w.high());
console.log(string.repeatJoin("ab", 3, "-"));
console.log(bool.parse("true"), bool.parse("no"));
