// check: no leaks
// A write through `any` at an array's length appends, as in Node: an index write
// (`a[a.length] = v`), `Reflect.set` with the index as a string (what a proxy's `set` trap
// forwards), and a proxy whose trap forwards the writes. `length` writes shorten the array.
const xs: any = [1, 2, 3];
xs[3] = 4;
xs[xs.length] = 5;
console.log(xs, xs.length);
console.log(Reflect.set(xs, "5", 6), xs);
const names: any = ["a"];
names[1] = "b";
console.log(names, names.length);
names.length = 0;
console.log(names, Reflect.set(xs, "length", 2), xs);

const log: string[] = [];
const target: any = [10, 20];
const p: any = new Proxy(target, {
  set(t: any, k: string | symbol, v: any, r: any): boolean {
    log.push(`set ${String(k)}=${v}`);
    return Reflect.set(t, k, v, r);
  },
});
p[2] = 30;
p[p.length] = 40;
p.length = 3;
console.log(log.join(", "), target, target.length);
