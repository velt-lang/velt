// Converting an `any` holding an object to an interface with optional fields it lacks (#1675).
interface H {
  name: string;
}

const d: H = { name: "d" } as any;
console.log(d.name);

interface G {
  name: string;
  tag?: string;
  count?: number;
}

const e: G = { name: "e" } as any;
console.log(e.name, e.tag, e.count);
const f: G = { name: "f", count: 3 } as any;
console.log(f.name, f.tag, f.count);

interface Handler {
  name: string;
  test?: (v: unknown) => boolean;
  priority?: number;
}

const handlers: Handler[] = [{ name: "a", priority: 2 } as any, { name: "b" } as any];
for (const h of handlers) {
  console.log(h.name, h.priority ?? 0, h.test === undefined);
}

// A literal-typed field, from `unknown`.
interface L {
  kind: "a";
  n: number;
}
const u: unknown = { kind: "a", n: 1 };
const l = u as L;
console.log(l.kind, l.n);

// A function with properties converted to a callable interface.
interface Factory {
  (p: number): number;
  __setup: (n: number) => number;
  __name?: string;
}
function make(): Factory {
  const f: any = function (p: number) {
    return p + 1;
  };
  f.__setup = (n: number) => n * 2;
  f.__name = "F";
  return f as Factory;
}
const F = make();
console.log(F(1), F.__setup(21), F.__name);
