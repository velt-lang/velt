// A write through `any` to an object that has gone through a conversion, in a program with proxies:
// the conversion keeps the one object, and the write shows, as in Node.
const made = new Proxy({}, {});
const p: any = { a: 1, b: 2 };
const c: { a: number; b: number } = p;
const q: { a: number } = c;
function chain() { const x = q; return x; }
p.a = 5;
console.log(chain().a, c.a);
