// An optional object passed where `object | undefined` is expected (sigx's use-data.ts):
// `object` holds `undefined` itself, so the value is passed as it is.
interface Opts {
  server?: boolean;
  key?: string;
}

function warn(name: string, options: object | undefined): void {
  if (!options) {
    console.log(name, "none");
    return;
  }
  console.log(name, Object.keys(options).join(","));
}

function read(options?: Opts): void {
  warn("read", options);
}

function find(options: Opts | null): void {
  warn("find", options ?? undefined);
}

read();
read({ server: true, key: "k" });
find(null);
find({ key: "x" });
