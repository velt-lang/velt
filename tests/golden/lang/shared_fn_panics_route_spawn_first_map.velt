// A function stored in a `Map`, that reaches `spawn` first.
type F = (x: i64) => i64;

function mk(): F {
  let n: i64 = 0;
  return (x: i64): i64 => {
    n += 1;
    return n;
  };
}

async function work(f: shared<F>): Promise<i64> {
  return f(1);
}

async function run(f: shared<F>): Promise<i64> {
  return await spawn(work(f.clone()));
}

async function main() {
  const m = new Map<string, F>();
  m.set("a", mk());
  console.log(await run(shared(m.get("a")!)));
}
