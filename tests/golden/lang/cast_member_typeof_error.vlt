// `typeof (u as M).f` where a member's property needs a lookup at run time (`at` of a string
// is a method): the read checks the assertion, which stops with its `TypeError` (Node:
// `function`), instead of answering from `M`'s field type.
type V = { type: string; at: number };
type C = V | string;

function a(c: C): string {
  return typeof (c as V).at;
}

console.log(a({ type: "t", at: 1 }));
console.log(a("s"));
