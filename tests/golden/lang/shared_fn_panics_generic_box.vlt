// A field changed by a function that comes out of a generic class.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

function mk(): F {
  const b = new C();
  return (x: i64): i64 => {
    b.n += 1;
    return b.n;
  };
}

class Bx<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
  take(): T {
    return this.v;
  }
}

async function main() {
  const h = new Bx<F>(mk());
  const f = shared(h.take());
  console.log(f(1));
}
