// A non-null assertion on an assignment target (`w[i]! -= n`, `x! = v`, `b.n! = 5`) assigns to
// the target, as TypeScript emits it; and an arrow may return a parenthesized function
// type (`(): (() => void) => …`). Both from sigx terminal (tableLayout.ts, runtime-terminal).

function shrink(widths: number[], give: number[]): number[] {
  for (let i = 0; i < widths.length; i++) {
    widths[i]! -= give[i]!;
  }
  widths[0]! += 10;
  widths[1]! += 1;
  widths[2]! -= 1;
  (widths[0]!) *= 2;
  return widths;
}

interface Box {
  n?: number;
}

const mount = (label: string, count?: number): (() => void) => {
  return () => {
    console.log(`${label} ${count ?? 0}`);
  };
};

const scale = (k: number): ((x: number) => number) => (x: number) => x * k;

function main() {
  console.log(shrink([5, 6, 7], [1, 2, 3]).join(","));
  let x: number | null = null;
  x! = 4;
  console.log(x);
  const b: Box = { n: 1 };
  b.n! = 5;
  console.log(b.n);
  mount("tick", 3)();
  mount("idle")();
  console.log(scale(3)(4));
}
