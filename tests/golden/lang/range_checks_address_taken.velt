// A local a closure captures has its address taken: its comparison with the length proves
// nothing about the index after it is reassigned, so the range check stays, and the release
// build panics exactly as the debug build does.
function f(xs: u64[], b: u64): u64 {
  if (xs.length < 8 || b > (xs.length as u64) - 8) {
    return 999;
  }
  let i: u64 = b;
  const g = (): u64 => i;
  if (i < (xs.length as u64)) {
    i = b * 1000 + 3000000000;
    return xs[i] + g();
  }
  return 7;
}

function main() {
  const xs: u64[] = [1, 2, 3, 4, 5, 6, 7, 8];
  console.log(f(xs, 0));
}
