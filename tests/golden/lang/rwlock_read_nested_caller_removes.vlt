// check: no leaks
// A `read` callback nested in another takes elements out of containers of the code around both
// reads, or replaces them: `pop`, `shift`, a slot assignment, `splice` with and without new
// elements, `length = 0`, `Map.delete`, `Set.delete`. That code holds those elements, as in
// JavaScript, so each one removed is freed once, also two and three reads deep, and what the
// outer reader keeps in its own variables stays its own.
class Box {
  items: number[][] = [[1, 2], [3]];
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const c = new RwLock(new Box());
  const out: number[][][] = [[[1]], [[2]], [[3]], [[4]], [[5]], [[6]], [[7]], [[8]]];
  const m = new Map<string, number[][]>();
  const s = new Set<number[][]>();
  const kept = [[10], [11]];
  m.set("a", [[1]]);
  m.set("b", [[2]]);
  s.add(kept);
  s.add([[3]]);
  a.read((x) => {
    const mine: number[][][] = [x.items.slice()];
    b.read((y) => {
      console.log("pop", out.pop());
      console.log("shift", out.shift());
      out[0] = [[9]];
      out[1] = y.items.slice();
      console.log("splice", out.splice(2, 1));
      console.log("splice in", out.splice(2, 1, y.items.map((e) => e), [[12]]));
      console.log("delete", m.delete("a"), s.delete(kept));
      m.set("b", y.items.filter((e) => e.length > 1));
      mine.push(y.items.slice());
      console.log("mine", mine.pop(), mine.length);
      c.read((z) => {
        console.log("deep", out.pop(), out.shift());
        out[0] = z.items.slice();
      });
    });
    console.log("outer", mine);
  });
  console.log(out.length, out, m.size, m.get("b"), s.size);
  a.read((x) => {
    b.read((y) => {
      out.length = 0;
      m.clear();
      s.clear();
    });
  });
  console.log(out.length, m.size, s.size, kept);
}
