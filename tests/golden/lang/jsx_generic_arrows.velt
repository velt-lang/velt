// Generic arrow functions in TSX spelling (`<T,>`): a module-level constant with typed
// parameters and a return type is a generic function.

const identity = <T,>(x: T): T => x;

export const firstOr = <T,>(xs: T[], fallback: T): T => {
  if (xs.length === 0) {
    return fallback;
  }
  return xs[0].clone();
};

const pair = <A, B>(a: A, b: B): [A, B] => [a, b];

const later = async <T,>(x: T): Promise<T> => x;

async function main() {
  console.log(identity(42), identity("text"));
  console.log(firstOr([3, 4], 0), firstOr([], "none"));
  const p = pair("a", 1);
  console.log(p[0], p[1]);
  console.log(await later(true));
}
