// `then`, `catch` and `finally` through a cast to `any` and through an optional call (#924 step
// 2), as in Node: a typed promise cast inline, a value of a type parameter cast in a generic
// function, a cast of a value that can't be a promise, and `v.then?.(f)` on a promise, on an
// object without a `then` and on one with its own, its arguments evaluated only when called.
async function later(n: number): Promise<number> {
  return n;
}

async function fails(m: string): Promise<number> {
  throw new Error(m);
}

async function viaGeneric<T>(x: T): Promise<any> {
  return await (x as any).then((v: any) => v + 1);
}

async function main(): Promise<void> {
  const typed = later(5);
  console.log("cast then", await (typed as any).then((v: any) => v + 1));
  console.log("cast catch", await (fails("c1") as any).catch((e: any) => e.message));
  let ran = false;
  const fin = await (typed as any).finally(() => {
    ran = true;
  });
  console.log("cast finally", fin, ran);
  console.log("cast read", typeof (typed as any).then);
  console.log("generic", await viaGeneric(later(1)));
  console.log("no promise", typeof (5 as any).then, typeof ("s" as any).then);

  const p: any = later(2);
  console.log("optional call", await p.then?.((v: any) => v + 1));
  console.log("optional catch", await p.catch?.((e: any) => "no"));
  const plain: any = { n: 1 };
  console.log("optional missing", plain.then?.((v: any) => v));
  const own: any = { then: (f: any) => "own " + f(3) };
  console.log("optional own", own.then?.((v: any) => v * 2));

  // A missing member skips the arguments; a present one evaluates them once.
  const seen: string[] = [];
  const mark = (s: string): any => {
    seen.push(s);
    return (v: any) => v;
  };
  console.log("skipped", plain.then?.(mark("missing")), seen.length);
  console.log("evaluated", await p.then?.(mark("present")), seen.join(","));

  // Optional calls on receivers that aren't variables, and on an optional member read.
  const inc = (v: any) => v + 1;
  const u: unknown = later(3);
  const getP = (): any => p;
  const none: any = null;
  console.log("cast optional", await (typed as any).then?.(inc));
  console.log("unknown cast optional", await (u as any).then?.(inc));
  console.log("optional read", await p?.then?.(inc), none?.then?.(inc));
  console.log("call result", await getP().then?.(inc));
  console.log("index", await [p][0].then?.(inc));
  console.log("member", await ({ q: p } as any).q.then?.(inc));
  console.log("call result catch", await getP().catch?.((e: any) => "no"));
  const box: any = { p };
  console.log("chain", await box?.p.then?.(inc), none?.p.then?.(inc), none?.p.then?.(mark("x")));
  console.log("chain skipped", seen.join(","));
  console.log("optional read own", own?.then?.((v: any) => v * 2));

  // A chain that goes on after the optional call: skipped with it when the member is missing.
  const tens = (v: any) => v * 10;
  console.log("continued", await p.then?.(inc).then(tens));
  console.log("catch continued", await getP().catch?.((e: any) => 0).then(inc));
  console.log("missing continued", plain.then?.(inc).then(inc), plain.then?.(mark("y")).then(inc));
  console.log("twice", await p.then?.(inc).then?.(inc).then(tens));
  console.log("inner link continued", await box?.p.then?.(inc).then(tens), none?.p.then?.(inc).then(inc));
  console.log("continued skipped", seen.join(","));
  const ticks: string[] = [];
  const typed2 = later(0);
  const held2: any = later(0);
  const a1 = typed2.then(() => ticks.push("typed 1")).then(() => ticks.push("typed 2"));
  const b1 = held2.then?.(() => ticks.push("any 1")).then(() => ticks.push("any 2"));
  await a1;
  await b1;
  console.log(ticks.join(", "));
}
main();
