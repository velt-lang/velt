// A generic union alias that names itself behind an array (sigx's `SlotContent<TFill>`):
// each instantiation is a union of its own, and a member may be a type argument, a
// function type, or an alias that allows `null`. Unused recursive union aliases check too.
type Elem = string | number | boolean | null;
type SlotContent<TFill> = Elem | undefined | TFill | (readonly SlotContent<TFill>[]);

type Fill = (n: number) => string;

function count(c: SlotContent<Fill>): number {
  if (c === undefined || c === null) {
    return 0;
  }
  if (Array.isArray(c)) {
    let n = 0;
    for (const x of c) {
      n += count(x);
    }
    return n;
  }
  if (typeof c === "function") {
    return c(2).length;
  }
  return 1;
}

const kids: SlotContent<Fill> = ["a", 1, [true, (n: number) => "x".repeat(n)], undefined, null];
console.log(count(kids));
console.log(count("solo"));
console.log(count(undefined));

// Another instantiation is another union.
function depth(c: SlotContent<boolean>): number {
  if (Array.isArray(c)) {
    let d = 0;
    for (const x of c) {
      d = Math.max(d, depth(x));
    }
    return d + 1;
  }
  return 0;
}

console.log(depth([[true, [false]], "x"]));

// A non-generic one whose `null` comes from a member alias, with a function member.
type Tree = Elem | (() => string) | Tree[];

function show(t: Tree): string {
  if (Array.isArray(t)) {
    return "[" + t.map(show).join(",") + "]";
  }
  if (typeof t === "function") {
    return t();
  }
  return String(t);
}

console.log(show([1, null, [() => "f", "s"]]));

// A function member that throws.
function bad(): string {
  throw new Error("no");
}

try {
  console.log(show([bad]));
} catch (e) {
  console.log("caught", (e as Error).message);
}

// Behind an index signature, and with two type parameters.
type J<T> = T | null | { [k: string]: J<T> };
const j: J<number> = { a: 1, b: { c: 2, d: null } };
console.log(JSON.stringify(j));
type Pair<A, B> = A | B | Pair<A, B>[];
const p: Pair<number, boolean> = [1, [true, 2]];
console.log(p);

// An instantiation at another one, through aliases of the alias, and with a default type
// argument the self-reference relies on.
type C<T> = string | T | C<T>[];
type S<T> = C<T>;
const cc: C<C<boolean>> = [true, ["x", [false]]];
console.log(JSON.stringify(cc));
const ss: S<S<number>> = ["a", 1, [2, ["b"]]];
console.log(JSON.stringify(ss));
type D<T = number> = string | T | D[];
const dd: D = [1, ["a"]];
console.log(JSON.stringify(dd));

// A type argument that allows `null`.
type MaybeFill = ((n: number) => string) | null;

function fills(c: C<MaybeFill>): string {
  if (c === null) {
    return "null";
  }
  if (Array.isArray(c)) {
    return "[" + c.map(fills).join(",") + "]";
  }
  if (typeof c === "function") {
    return c(1);
  }
  return c;
}

console.log(fills(["a", null, [(n: number) => "x" + n]]));

// Checked though nothing uses them.
type Unused = string | Unused[];
type UnusedOf<T> = T | UnusedOf<T>[];
console.log("done");
