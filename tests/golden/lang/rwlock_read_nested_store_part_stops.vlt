// A class object a `read` nested in another stores into a container of the code outside every
// read, into which the callbacks also store a part of the lock's value, stops the program at
// the nested store while they still reference it (as before nested stores kept objects the
// readers' own): stored as a copy, it would miss their later changes (#1523; Node shares it).
class Node2 {
  v: number[] = [];
  kids: Node2[] = [];
}

class Box {
  items: Node2[] = [new Node2()];
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const top: Node2[] = [];
  a.read((x) => {
    const n = new Node2();
    console.log("before");
    b.read((y) => {
      top.push(n);
    });
    console.log("after");
    n.v.push(1);
    n.kids.push(x.items[0]);
  });
  console.log(top.length);
}
