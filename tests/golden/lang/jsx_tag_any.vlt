// A tag of type `any`, taken as in TypeScript with props of type `any`, and a constant whose own
// initializer names it as a tag, inside a closure.
import { show } from "./_jsx_react/show";

function mk<P>(render: (p: P) => any): any {
  return (p: P): any => render(p);
}
const A = mk<{ a: string }>((p) => <box a={p.a} />);
console.log(show(<A a="1" />));
