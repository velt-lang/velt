// check: no leaks
// `o.f instanceof C` on a field that may be `null` or `undefined` (of an object type, or not
// `readonly`) narrows it to `C` when true, as `o.f != null` does (#1218).
class A {
  a = 1;
}

type R = {
  readonly v: string | number | null | undefined;
  readonly o: A | null | undefined;
  p?: A;
};

function t(r: R): string {
  if (r.p instanceof A) {
    console.log("p", r.p.a);
  }
  if (typeof r.v === "string") {
    return r.v.toUpperCase();
  }
  if (r.o instanceof A) {
    return "A" + r.o.a;
  }
  return "-";
}

console.log(
  t({ v: "x", o: null }),
  t({ v: 1, o: new A(), p: new A() }),
  t({ v: undefined, o: undefined }),
);
