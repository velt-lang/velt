// `import.meta` has Node's keys in Node's order: `dirname`, `filename`, `main` (true in the
// program's root module) and `resolve` (a specifier resolved against the module's URL, without
// looking the file up), and `url`. Output compared with Node.
import { libMeta } from "./_import_meta_keys_lib";

console.log(Object.keys(import.meta).join(","));
console.log(import.meta.main, libMeta(), typeof import.meta.resolve);
const base = import.meta.url.slice(0, import.meta.url.lastIndexOf("/") + 1);
console.log(import.meta.resolve("./a b.ts") === base + "a%20b.ts");
console.log(import.meta.resolve("../m/./n.ts") === base.replace(/lang\/$/, "m/n.ts"));
console.log(import.meta.resolve("node:fs"), import.meta.resolve("/abs/x.js"));
try {
  import.meta.resolve("no-such-package");
} catch (e) {
  console.log((e as Error).message.startsWith("Cannot find package 'no-such-package'"));
}
const meta = import.meta;
console.log(meta.resolve("./q") === import.meta.resolve("./q"), meta.main);
