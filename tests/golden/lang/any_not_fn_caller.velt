// Calling an `any` that holds no function where no `catch` of the same function encloses the
// call throws Node's `TypeError` out of that function (#1422, #3955): the caller's `catch`
// takes it, also through a function in between, a method called through an interface and a
// callback of an array method. Before, the program stopped with the message (exit 101), where
// Node's `catch` runs. A function whose error type is written keeps stopping
// (any_not_fn_fixed_throws.velt).
// Node twin: any_not_fn_caller.mjs.
function callMissing(x: any): number {
  return x.missing() as number;
}

function twice(x: any): number {
  return callMissing(x) * 2;
}

interface Shape {
  area(): number;
}

class Good implements Shape {
  side: any = 3;
  area(): number {
    return o.square(this.side);
  }
}

class Bad implements Shape {
  area(): number {
    return o.a();
  }
}

function total(shapes: Shape[]): number {
  let t = 0;
  for (const s of shapes) {
    t += s.area();
  }
  return t;
}

const o: any = { a: 1, square: (x: number): number => x * x };
console.log("before");
try {
  callMissing(o);
} catch (e) {
  console.log("caught", (e as Error).message);
}
try {
  console.log(twice(o));
} catch (e) {
  console.log("caught twice", (e as Error).name, (e as Error).message);
}
console.log(total([new Good()]));
try {
  total([new Good(), new Bad()]);
} catch (e) {
  console.log("caught area", (e as Error).message);
}
try {
  [1, 2].forEach((x: number) => o.a(x));
} catch (e) {
  console.log("caught forEach", (e as Error).message);
}
console.log("after");
