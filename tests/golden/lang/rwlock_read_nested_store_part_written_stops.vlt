// An array a `read` nested in another stores into a container of the code outside every read,
// into which the outer callback then stores a part of the lock's value: the nested store makes
// it the caller's, as the same object, and that later store through the outer callback's
// variable stops the program instead of changing only a copy (#1523, #1541; Node shares the
// array, and the part with it). A class object in its place stops at the nested store,
// rwlock_read_nested_store_part_stops.
class Rows {
  items: number[][] = [[1, 2], [3]];
}

function main() {
  const c = new RwLock(new Rows());
  const d = new RwLock(new Rows());
  const rows: number[][][] = [];
  c.read((x) => {
    const l: number[][][] = [[[1]]];
    d.read((y) => {
      rows.push(l[0]);
    });
    console.log("stored", rows[0] === l[0]);
    l[0].push(x.items[0]);
    console.log(rows[0] === l[0], l[0].length);
  });
  console.log(JSON.stringify(rows));
}
