// A modifier followed by a line break, as TypeScript and Node read it: `async`, `readonly` and
// the other TypeScript modifiers are then the member's name, while `static`, `get` and `set`
// still apply to the name on the next line. Output compared with Node.

class A {
  async = 2;
  readonly = "r";
  static three() {
    return 3;
  }
  get value() {
    return 10;
  }
  foo() {
    return 1;
  }
}

function main() {
  const a = new A();
  console.log(a.async, a.readonly, A.three(), a.value, a.foo());
}
