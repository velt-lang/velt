// Generic recursion whose type arguments grow once and then stay (`f<A, B>` calling
// `f<Box<B>, number>`, finitely many instantiations, also through two functions): a conversion
// through `any` in it reaches each instantiation's interface (#1909), as in Node.
interface Box<T> {
  value: T;
  show(): string;
}

function f<A, B>(o: unknown, n: number): string {
  const b = o as Box<A>;
  if (n <= 0) {
    return b.show();
  }
  return b.show() + f<Box<B>, number>(o, n - 1);
}

console.log(f<number, number>({ value: 1, show: () => "x" } as unknown, 2));

function g<A, B>(o: unknown, n: number): string {
  const b = o as Box<A>;
  if (n <= 0) {
    return b.show();
  }
  return b.show() + h<Box<B>>(o, n - 1);
}

function h<U>(o: unknown, n: number): string {
  return "g" + g<U, string>(o, n);
}

console.log(g<number, number>({ value: 1, show: () => "y" } as unknown, 2));
