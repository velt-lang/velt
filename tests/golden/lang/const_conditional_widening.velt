// The literals a `const` keeps from a conditional (`"x" | "y"`) widen where TypeScript widens
// them: a `let`, an object literal's property, an inferred function result and an array
// element are `string`s, and so is a type argument inferred from them; another `const` keeps
// them (#2686).
function id<T>(x: T): T {
  return x;
}
function box<T>(x: T): { v: T } {
  return { v: x };
}
function main() {
  const c = Math.random() > 2;
  const a1 = c ? "x" : "y";
  const t1: "x" | "y" = a1;
  let w = a1;
  w = "other";
  const obj = { m: a1 };
  obj.m = "other2";
  const sh = { a1 };
  sh.a1 = "other5";
  const arr = [a1];
  arr.push("other3");
  const ret = () => a1;
  let rv = ret();
  rv = "other4";
  function ret2() {
    return a1;
  }
  let rv2 = ret2();
  rv2 = "other6";
  const b = a1;
  const tb: "x" | "y" = b;
  let wb = b;
  wb = "other7";
  const [e] = [c ? "x" : "y"];
  let ee = e;
  ee = "zz";
  const tt = c ? `t` : "y";
  const t2: "t" | "y" = tt;
  const sub = c ? `t${w}` : "y";
  let ws = sub;
  ws = "free";
  const nest = c ? "p" : `q`;
  const capture = () => {
    let inner = nest;
    inner = "inner";
    return inner;
  };
  const m = new Map([[a1, 1]]);
  let gid = id(a1);
  gid = "generic";
  const bx = box(a1);
  bx.v = "boxed";
  console.log(t1, w, obj.m, sh.a1, arr.join(","), rv, rv2, tb, wb, ee, t2, ws, capture(), m.size);
  console.log(gid, bx.v);
}
main();
