// A call that moves an object and lends a part of it: an object type (#2531). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; name: string = heap("n"); }
let hold: A2 | null = null;
type P = { n: string; c: number };
let ph: P | null = null;
function take(q: P, v: string) { ph = q; ph = null; junk(); return v + "!"; }
function t() { const a: P = { n: heap("p"), c: 1 }; console.log(take(a, a.n)); }
t();
