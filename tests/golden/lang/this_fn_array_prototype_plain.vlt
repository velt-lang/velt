// `Array.prototype` methods read through `any` in a program without proxies (#942): wrapped in a
// function expression taking `this` that calls `original.apply(this, arguments)`, called with
// `call`, `apply` and `bind`, they run on the array they are given, as in Node.
let calls = 0;
const wrapped: Record<string, Function> = {};
["push", "pop", "splice", "sort"].forEach((method) => {
  const original = (Array.prototype as any)[method];
  wrapped[method] = function (this: any) {
    calls++;
    return original.apply(this, arguments);
  };
});

function main() {
  const arr: any[] = [3, 1];
  const push: any = wrapped["push"];
  console.log(push.call(arr, 2, 5), arr);
  console.log(push.apply(arr, [4]), arr);
  console.log(wrapped["pop"].call(arr), arr);
  console.log(wrapped["splice"].apply(arr, [0, 1, "a"]), arr);
  const nums: any[] = [10, 9, 1, 100];
  console.log(wrapped["sort"].call(nums, (a: number, b: number) => a - b), calls);
  // The methods themselves.
  const AP: any = Array.prototype;
  console.log(AP.slice.call([1, 2, 3], 1), AP.join.apply(["a", "b"], ["-"]));
  console.log(AP.map.call([1, 2], (x: number) => x * 2), AP.indexOf.call(["x", "y"], "y"));
  const boundJoin = AP.join.bind(["p", "q"]);
  console.log(boundJoin("+"), typeof AP.push, AP.notAMethod);
}
