// check: no leaks
// A generator's default applies at the call, also through a function value (issue #1197).
let calls = 0;

function fallback(): string {
  calls++;
  return "f";
}

function* gen(x: any = "g", y: unknown = fallback()): Generator<string> {
  yield `${x}`;
  yield `${y}`;
}

class Box {
  *items(x: any = "m"): Generator<string> {
    yield `${x}`;
  }
  static *all(x: any = "s"): Generator<string> {
    yield `${x}`;
  }
}

const kept: ((x: any) => Generator<string>)[] = [];

function* pair(x: any = "g", y: number = 1): Generator<any> {
  yield x;
  yield y;
}

function* plain(x: number): Generator<number> {
  yield x;
}

function pick<T>(t: T): (x: any, y: unknown) => Generator<string> {
  return gen;
}

function run(f: (x: any, y: unknown) => Generator<string>): string[] {
  return [...f(undefined, undefined)];
}

function main(): void {
  console.log(gen().next().value, gen(undefined).next().value);
  const gv = gen;
  console.log(gv(undefined, 1).next().value);
  // The default is evaluated when the generator is created, before its body runs.
  const before = calls;
  const it = gv("a", undefined);
  console.log(calls - before);
  console.log(it.next().value, it.next().value);
  console.log(run(gen).join(","));
  console.log(gv(null, null).next().value);
  const b = new Box();
  const m = b.items;
  console.log(m(undefined).next().value);
  const s = Box.all;
  console.log(s(undefined).next().value);
  const ge = function* (x: any = "e"): Generator<string> {
    yield `${x}`;
  };
  console.log(ge(undefined).next().value);
  kept.push(gen);
  console.log(kept[0](undefined).next().value);
  // Such a generator is one function value, as in JS: every read of it is the same value.
  const pv = pair;
  const p1 = plain;
  console.log(pv === pair, pair === pair, p1 === plain);
  const fs = new Set<(x: any, y: number) => Generator<any>>();
  fs.add(pair);
  fs.add(pair);
  console.log(fs.size, [...pv(undefined, 2)].join(","));
  const sv = Box.all;
  console.log(sv === Box.all, gv === gen);
  const picked = pick(1);
  console.log(picked === gen, picked(undefined, 2).next().value);
}
