// String comparisons against one-character literals, in both operand orders, with empty,
// longer and non-ASCII strings, compared with Node. Empty strings the runtime makes (slices,
// trim, join, split, JSON) may have no data pointer at all.
function rank(c: string): string {
  const parts: string[] = [];
  parts.push(c >= "0" ? "ge0" : "lt0");
  parts.push(c <= "9" ? "le9" : "gt9");
  parts.push(c < "a" ? "lta" : "gea");
  parts.push(c > "z" ? "gtz" : "lez");
  parts.push("m" < c ? "m<" : "m>=");
  parts.push("m" >= c ? "m>=" : "m<");
  parts.push(c == "m" ? "eqm" : "nem");
  return parts.join(" ");
}

function main() {
  for (const c of [
    "",
    "0",
    "5",
    "9",
    ":",
    "a",
    "m",
    "ma",
    "m\u0000",
    "z",
    "{",
    "é",
    "😀",
    "~",
    "/",
    "00",
    "9z",
  ]) {
    console.log(JSON.stringify(c), rank(c));
  }
  const none: string[] = [];
  const empties = [
    "abc".slice(3),
    "   ".trim(),
    none.join(""),
    "abc".substring(1, 1),
    "abc".charAt(10),
    "a,".split(",")[1],
    JSON.parse<string>('""'),
  ];
  for (const e of empties) {
    console.log(rank(e), e < "a", "a" < e, e >= "0", "0" >= e);
  }
  const words = ["b", "a", "", "ab", "é", "B", "aa", "😀", "z"];
  words.sort();
  console.log(words.join(","));
}
