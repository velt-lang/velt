// A literal operand that moves a string field out of a local whose moved parts are zeroed in
// place (a field of it is moved in a branch, a loop or a `try`) is read in place and shared,
// as a later operand still reads the local. The literal owns that share: nothing releases it
// again once the literal holds it (#3728; fixed by #3399). Each shape below released the
// field's buffer once too often, so the local's string was freed while still in use.

// A record literal whose later operand moves a field in a branch.
type Item = { id: string; dir: string; role?: string; tags?: string[] };
type Cmd = { dir: string; tags: string[]; system: string };

function queue(cmds: Cmd[], s: Item, start: bool): void {
  const tags = s.tags ?? [];
  cmds.push({ dir: s.dir, tags, system: start ? s.role ?? "" : "" });
}

// An array literal of a parameter's fields in an async function that later moves another field
// inside a `try`.
type Say = { key: string; text: string; resume: string };
type Note = { key: string; n: i64 };

async function note(x: Note): Promise<void> {
  if (x.n > 100) {
    throw new Error(x.key);
  }
}

async function sayArgs(c: Say): Promise<string[]> {
  const args: string[] = [];
  for (const a of ["-p", c.text, "--to", c.resume]) {
    args.push(a);
  }
  try {
    await note({ key: c.key, n: args.length });
  } catch (e) {
    // not reached
  }
  return args;
}

// A record literal of the fields of a loop's element, in a loop.
type Release = { tagName: string; name: string; publishedAt: string; isDraft: bool; isLatest: bool };
type ReleaseInfo = { tag: string; name: string; publishedAt: string; latest: bool };

function parseReleases(json: string): ReleaseInfo[] {
  const out: ReleaseInfo[] = [];
  for (const r of JSON.parse<Release[]>(json)) {
    if (!r.isDraft && r.tagName.startsWith("v")) {
      out.push({ tag: r.tagName, name: r.name, publishedAt: r.publishedAt, latest: r.isLatest });
    }
  }
  return out;
}

// Allocations of the same size between the uses, so a freed buffer is taken again.
function churn(n: i64): i64 {
  const filler: string[] = [];
  for (let i: i64 = 0; i < n; i++) {
    filler.push(`${"y".repeat(60)}${i}`);
  }
  return filler.length;
}

const items: Item[] = [{ id: "s1", dir: `/home/someone/${"x".repeat(40)}`, role: `lead ${"r".repeat(40)}` }];
for (let i = 0; i < 3; i++) {
  let cmds: Cmd[] = [];
  const s = items.find((x) => x.id === "s1");
  if (s != null) {
    queue(cmds, s, i === 1);
  }
  console.log(cmds[0].dir.length, cmds[0].system.length);
  cmds = [];
  churn(40);
  console.log(items[0].dir.length, items[0].dir.slice(0, 14));
}

const says: Say[] = [];
for (let i = 0; i < 3; i++) {
  says.push(JSON.parse<Say>(`{"key":"a key long enough to live on the heap ${i}","text":"a message long enough to live on the heap, with some more words ${i}","resume":"id_01ABCDEFGHIJKLMNOPQRSTUVWXYZ"}`));
}
for (let i = 0; i < 3; i++) {
  const args = await sayArgs(says[i]);
  console.log(args.length, args[1].length, args[3]);
}
churn(40);
for (const c of says) {
  console.log(c.text.length, c.text.slice(0, 9), c.key.length);
}

const long = "z".repeat(40);
const json = `[{"tagName":"v1-${long}","name":"n-${long}","publishedAt":"p-${long}","isDraft":false,"isLatest":true},{"tagName":"draft","name":"d","publishedAt":"p","isDraft":true,"isLatest":false}]`;
for (let i = 0; i < 3; i++) {
  const rs = parseReleases(json);
  churn(40);
  console.log(rs.length, rs[0].tag.length, rs[0].name.slice(0, 4), rs[0].publishedAt.slice(0, 4), rs[0].latest);
}
