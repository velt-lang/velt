// check: no leaks
// A cast of an existing array to another element type (#1485) keeps the one array, as in
// Node: `result as JSXChildren` (an array of `JSXElement` as the union's `JSXChild[]` member)
// and `items as VNode[]` (to a narrower element type) are views of the array.
type VNode = { type: string; children: JSXChild[] };
type JSXElement = VNode | string | number | boolean | null;
type JSXChild = VNode | string | number | boolean | null | undefined | JSXChild[];
type JSXChildren = JSXChild;

function normalizeChildren(children: JSXChildren): string[] {
  if (children == null || children === false || children === true) {
    return [];
  }
  if (typeof children === "string" || typeof children === "number") {
    return [String(children)];
  }
  if (Array.isArray(children)) {
    return children.map((c) =>
      typeof c === "object" && c !== null && !Array.isArray(c) ? (c as VNode).type : String(c)
    );
  }
  return ["node"];
}

async function later(xs: JSXChild[]): Promise<number> {
  await Promise.resolve(0);
  return xs.length;
}

async function run() {
  const result: JSXElement[] = [{ type: "div", children: [] }, "text", 3, null];
  const v = result as JSXChildren;
  console.log(normalizeChildren(v));

  const items: JSXElement[] = [{ type: "a", children: [] }, { type: "b", children: [] }];
  const nodes = items as VNode[];
  console.log(nodes.length, nodes[1].type, nodes.map((n) => n.type).join("+"));
  nodes[0].type = "A";
  console.log((items[0] as VNode).type);

  const back: any = nodes;
  const orig: any = items;
  console.log(back === orig, Array.isArray(back));
  console.log(JSON.stringify(nodes), String(result as JSXElement[]));

  const w = result as JSXChild[];
  console.log(w.indexOf("text"), w.includes(3), w.slice(1, 3), [...w].length);
  const [first, second] = w;
  console.log(typeof first, second);
  items.push("late");
  console.log(w.length, (items as JSXChild[]).length);

  // A view in an object, and across an `await`.
  const holder = { kids: w };
  console.log(holder.kids.length);
  console.log(await later(w));
  result.push(true);
  console.log(await later(holder.kids));
}

run();
