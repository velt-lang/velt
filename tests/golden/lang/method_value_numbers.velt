// A method value converts its arguments as a named function does (#746): number literals in
// an unannotated array are JS numbers, so `[1, 2].forEach(p.log)` passes them to
// `log(x: number)` without annotations, in the unbound and the `bind` form.
class P {
  count: number = 0;
  log(x: number): void {
    console.log("log", x * 1.5);
  }
  add(x: number): void {
    this.count += x;
  }
  half(x: number): number {
    return x / 2;
  }
}

function main() {
  const p = new P();
  [1, 2].forEach(p.log);
  [3, 4].forEach(p.add.bind(p));
  const xs = [5, 6];
  xs.forEach(p.log);
  xs.forEach(p.add.bind(p));
  console.log(p.count);
  console.log([1, 3].map(p.half).join(","));
  let q = new P();
  [7, 8].forEach(q.add.bind(q));
  console.log(q.count);
}
