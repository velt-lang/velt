// Classes as values: a constructor that doesn't take the signature's parameters, a class
// without a construct signature type to be a value of, an instance type the class doesn't
// convert to, and a comparison of two class values. tsc --strict reports lines 13, 15 and 16
// too (TS2322); it accepts `const C = A` (Velt needs the type) and the comparison (not
// supported yet).
class A {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}
type Ctor = new (n: number) => A;
const bad: new (s: string) => A = A;
const C = A;
const n: number = bad;
const wrongRet: new (n: number) => string = A;
const ks: Ctor[] = [A];
const k: Ctor = A;
console.log(ks[0] === k);
