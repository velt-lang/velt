// check: no leaks
// A function value in `shared(...)` is called directly, from many tasks at once, without a lock;
// each call has its own copy of what the function captured. A table of them is read in place.
type F = (n: i64) => Promise<i64>;

class Box {
  label: string = "b";
  rows: string[] = ["x", "yy", "zzz"];
}

function make(k: i64): shared<F> {
  const box = new Box();
  return shared(async (n: i64): Promise<i64> => {
    let sum = n + k;
    for (const r of box.rows) {
      sum += r.length;
    }
    return sum + box.label.length;
  });
}

async function worker(table: shared<shared<F>[]>, rounds: i64): Promise<i64> {
  let total: i64 = 0;
  for (let i: i64 = 0; i < rounds; i++) {
    const f = table[(i % 3) as number];
    total += await f(i);
  }
  return total;
}

async function main() {
  const fs: shared<F>[] = [make(1), make(2), make(3)];
  const table = shared(fs);
  const one = table[0];
  console.log(await one(10));
  const tasks: Promise<i64>[] = [];
  for (let t = 0; t < 8; t++) {
    tasks.push(spawn(worker(table.clone(), 20000)));
  }
  let all: i64 = 0;
  for (const t of tasks) {
    all += await t;
  }
  console.log(all);
  const plain = shared((a: string, b: string): string => a + b);
  console.log(plain("sync ", "too"));
}
