// A promise whose `resolve` and `reject` are all dropped without settling never settles, like
// in JS: it can lose a `Promise.race`, and awaiting it waits until nothing else can happen,
// when the program ends with exit code 0, as Node does.
async function fast(): Promise<i64> {
  await sleep(5);
  return 1;
}

async function main() {
  const never = new Promise<i64>((resolve) => {});
  console.log("race:", await Promise.race([never, fast()]));
  console.log(await new Promise<i64>((resolve) => {}));
}
