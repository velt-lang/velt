// `JSON.stringify` of a class value writes the object's dynamic class, as Node does: a
// subclass's `private` fields too, and never its ES private fields (`#x`).
class Shape {
  name: string;

  constructor(name: string) {
    this.name = name;
  }
}

class Circle extends Shape {
  radius: f64 = 1.5;
}

class Secret extends Shape {
  private key: string = "written";
}

class Hidden extends Shape {
  #key: string = "never written";
}

function main() {
  const shapes: Shape[] = [
    new Shape("plain"),
    new Circle("round"),
    new Secret("secret"),
    new Hidden("hidden"),
  ];
  for (const s of shapes) {
    console.log(JSON.stringify(s));
  }
}
