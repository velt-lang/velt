// A conversion that became a view shows the object to everything that looks at it but a spread.
const made = new Proxy({}, {});
type W = { a: number; b: string };
type N = { a: number };
const w: W = { a: 1, b: "x" };
const v: N = w;
v.a = 2;
console.log(v, JSON.stringify(v), Object.keys(v));
for (const k in v) { console.log(k); }
