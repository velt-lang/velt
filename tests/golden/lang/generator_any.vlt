// check: no leaks
// A generator yielding `any` (issue #1197): the values it yields, and `undefined` once done.
function* gen(x: any): Generator<any> {
  yield x;
  yield 2;
  yield "s";
}
function main(): void {
  const g = gen(1);
  console.log(g.next().value);
  console.log(g.next().value);
  const r = g.next();
  console.log(r.value, r.done);
  const e = g.next();
  console.log(e.done, e.value, typeof e.value);
  console.log(g.next().value === undefined);
  for (const v of gen(null)) console.log(v);
  console.log([...gen({ a: 1 })]);
  const it: Iterator<any> = gen([1, 2]);
  console.log(it.next().value, it.next().value);
}
