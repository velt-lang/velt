// check: no leaks
// `Object.is` with an `any` or `unknown` operand (#924): SameValue, which is `===` except that `NaN` is
// itself and `0` is not `-0`.
class Point {
  x: number = 1;
}

function same(a: any, b: any): boolean {
  return Object.is(a, b);
}

function main(): void {
  const p = new Point();
  const q = new Point();
  console.log(same(1, 1), same(NaN, NaN), same(0, -0), same(-0, -0), same(1, "1"));
  console.log(same("a", "a"), same(true, true), same(null, null), same(null, undefined));
  console.log(same(p, p), same(p, q), Object.is(p as any, p), Object.is(2, 2 as any));
  const r: Record<string, any> = { k: NaN };
  console.log(Object.is(r["k"], NaN), Object.is(r["k"], 0));
  const u: unknown = -0;
  console.log(Object.is(u, -0), Object.is(u, 0), Object.is(u, u));
  const nu: any = undefined;
  const nk: unknown = undefined;
  const nn: any = null;
  console.log(Object.is(nu, undefined), Object.is(undefined, nu), Object.is(nk, undefined));
  console.log(Object.is(undefined as any, undefined), Object.is(nn, null), Object.is(null, nn));
  console.log(Object.is(nn, undefined), Object.is(nu, null), Object.is(p as any, null));
}
