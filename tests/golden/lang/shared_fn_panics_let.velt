// The compiler can't follow a function an interface method returns, so `shared(...)` panics.
type F = (x: i64) => i64;

interface Fi {
  make(): F;
}

class Fa implements Fi {
  make(): F {
    let n: i64 = 0;
    return (x: i64): i64 => {
      n += 1;
      return n;
    };
  }
}

async function main() {
  const m: Fi = new Fa();
  const f = shared(m.make());
  console.log(f(1));
}
