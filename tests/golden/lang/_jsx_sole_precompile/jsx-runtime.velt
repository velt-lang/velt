// The precompiling runtime of `_jsx_sole_provider`: `jsxEscape` renders `true`, `false` and
// `null` as the placeholder they are among siblings, and `jsxSoleEmpty` tells the compiler what
// they render as when they are an element's only child.

import { AttrValue, Element, Template, Text, attr, textOf } from "../_jsx_sep_provider/render";

export * from "../_jsx_sole_provider/jsx-runtime";
export { Text } from "../_jsx_sep_provider/render";

export const jsxTextSeparator = "<!--t-->";
export const jsxSoleEmpty = "";

export function jsxTemplate(strings: string[], slots: Element[]): Element {
  const el = new Element();
  el.parts.push(new Template(strings, slots));
  return el;
}

export function jsxTemplateString(html: string): Element {
  return jsxTemplate([html], []);
}

export function jsxEscape(value: Text): string {
  return textOf(value);
}

export function jsxAttr(name: string, value: AttrValue): string {
  return attr(name, value);
}
