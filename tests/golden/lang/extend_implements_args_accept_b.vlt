// Blocks with interface arguments whose bounds lead to each other: `C` gets `G<string>` from
// the unbounded block, hence `Q`, hence the bounded `G<i64>` block fits and wins. So `C` is a
// `G<i64>`, not a `G<string>`, whatever is looked up first. (after `Q`; `_a` alone.)

interface G<A> {
  g(): string;
}

interface Q {
  q(): string;
}

extend<T extends Q> T implements G<i64> {
  g(): string {
    return "G<i64>";
  }
}

extend<T> T implements G<string> {
  g(): string {
    return "G<string>";
  }
}

extend<T extends G<string>> T implements Q {
  q(): string {
    return "Q";
  }
}

class C {}

function needGs<T extends G<string>>(x: T): string {
  return x.g();
}

function needGi<T extends G<i64>>(x: T): string {
  return x.g();
}

function needQ<T extends Q>(x: T): string {
  return x.q();
}

function main() {
  console.log(needQ(new C()));
  console.log(needGi(new C()));
}
