// check: no leaks
// TypeScript's `Function` (issue #926): any function. Calling one is a dynamic call, as on an
// `any` that holds a function: its arguments are boxed and its result is an `any`.
const handlers: Record<string, Function> = {};
handlers["double"] = (n: number): number => n * 2;
handlers["greet"] = (s: string): string => "hi " + s;
console.log(handlers["double"](21), handlers["greet"]("bob"));

let maybe: Function | null = null;
console.log(maybe === null);
maybe = (): string => "called";
if (maybe !== null) {
  console.log(maybe());
}

function call(f: Function, x: unknown): unknown {
  return f(x);
}

console.log(call((v: number) => v + 1, 41));

const registry = new Map<Function, string>();
const fa = (): void => {};
registry.set(fa, "a");
console.log(registry.get(fa), registry.has(() => {}), registry.size);

type Tag = string | Function;

function render(type: Tag, props: number): unknown {
  if (typeof type === "string") {
    return "<" + type + ">";
  }
  return (type as Function)(props);
}

console.log(render("div", 1), render((n: number) => n * 10, 4));

const o: object = fa;
console.log(typeof o);

class Plug {
  constructor(public setup: Function) {}
}

const pl = new Plug((name: string): string => name.toUpperCase());
console.log(pl.setup("velt"));
