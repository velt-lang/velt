// A module-level `let` initialized with an array of constants is a slot like any other: code
// may replace the array or change it, and every read sees that.
let arr = [1, 2, 3];
const table = [4, 5];

function main() {
  console.log(arr.length, arr[0], table.length);
  arr = [9];
  arr.push(4);
  console.log(arr.length, arr[0], arr[1]);
  for (const x of arr) {
    console.log(x);
  }
}
