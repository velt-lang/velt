// `let x;` without a type or initializer takes its type from its first assignment, also inside
// `try` (#695). Expected output: Node's.
function parse(s: string): number {
  let st;
  try {
    st = Number.parseInt(s, 10);
  } catch (e) {
    return -1;
  }
  return st;
}

function label(b: boolean): string {
  let r;
  if (b) {
    r = "yes";
  } else {
    r = "no";
  }
  return r;
}

function main() {
  console.log(parse("42"));
  console.log(label(true), label(false));
  let names;
  names = ["a", "b"];
  names.push("c");
  console.log(names.join(","), names.length);
  let later;
  const f = () => 1;
  later = f() + 1;
  console.log(later);
}
