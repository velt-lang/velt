export interface J {
  v: number;
  a: { b: number };
}

export const K: J | null = { v: 1, a: { b: 1 } };
export const N: J = { v: 1, a: { b: 1 } };

export function readK(): number {
  return K!.v;
}

export class C {
  static readonly K: J | null = { v: 1, a: { b: 1 } };
  static readonly N: J = { v: 1, a: { b: 1 } };
}
