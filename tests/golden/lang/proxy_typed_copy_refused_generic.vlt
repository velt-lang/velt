// A generic function builds the object, so no literal of `Box` is in the program, and a write
// through the narrower `V` could tell a copy from the original: in a program that creates
// proxies, the conversion keeps only a proxy's identity, and a plain value throws (#823).
type Box = { v: number; w: number };
type V = { v: number };

function mk<T>(x: T): { v: T; w: T } {
  return { v: x, w: x };
}

const p = new Proxy({ x: 1 }, {});
console.log(p.x);
const b: Box = mk(1);
const v: V = b;
v.v = 9;
console.log(b.v);
