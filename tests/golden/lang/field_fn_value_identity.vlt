// A field or constant initialized with a named function value holds that same function
// (`===` to it, as in Node), and a module `let` is read once, when the field is initialized.
const fine = () => 1;
let cur = () => 10;
const boom = () => {
  throw new Error("boom");
};

class K {
  f: () => number = fine;
  c: () => number = cur;
  h: () => void = boom;
}

class J {
  f: () => number;
  constructor() {
    this.f = fine;
  }
}

const k = new K();
console.log("field", k.f === fine, new J().f === fine, new K().f === new K().f, k.c === cur);
const top: () => number = fine;
console.log("top", top === fine);
cur = () => 20;
console.log("after reassign", k.c(), new K().c());
try {
  k.h();
} catch (e) {
  console.log("h", (e as Error).message);
}
