// check: no leaks
// An RwLock read probe (#1559): prints what Node prints.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Holder {
  rows: number[][] = [];
}
function main() {
  const a = new RwLock(new Box());
  const hs: Holder[] = [];
  a.read((x) => {
    const h = new Holder();
    hs.push(h);
    h.rows.push([9]);
    hs.push(h);
    h.rows.push([10]);
  });
  console.log(JSON.stringify(hs), hs[0] === hs[1]);
}
