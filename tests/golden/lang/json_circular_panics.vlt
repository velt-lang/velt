// JSON.stringify of an object that contains itself fails as in JavaScript ("Converting
// circular structure to JSON") instead of writing forever (#376).

interface Node {
  value: number;
  next?: Node;
}

function main() {
  let n: Node = { value: 1 };
  n.next = { value: 2, next: n };
  console.log(n.next?.next?.value ?? 0);
  console.log(JSON.stringify(n));
}
