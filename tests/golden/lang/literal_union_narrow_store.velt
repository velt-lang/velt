// A literal union narrowed by `===` / `!==` stored where the members left are expected, and
// returned next to a string from a function without a return type (its result is `string`).
type Lit = "a" | "b" | "c";
function f(x: Lit): string { if (x === "a") return "A"; const y: "b" | "c" = x; return y; }
console.log(f("a"), f("b"), f("c"));
function g(x: Lit) { if (x !== "a") { const z: "b" | "c" = x; return z; } return "A"; }
console.log(g("c"));
function h(z: "b" | "c", c: boolean) { if (c) return z; return "A"; }
console.log(h("c", true), h("b", false));
function k(z: "b" | "c", c: boolean) { if (c) return 1; return z; }
console.log(k("c", true), k("b", false));
function m(z: "b" | "c", c: boolean) { if (c) return "A"; return z; }
console.log(m("c", true), m("b", false));
