// The frame's own object, with the field written through what else holds it (#2527). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; }
const KK = (q: A2) => { q.c = new I2(); q.c.s = heap("zzzzzzzz"); q.xs = []; junk(); };
class N { name: string = heap("n"); }
class Ctx { n: N | null = null; }
const k = (c: Ctx, v: string) => { const m = c.n; if (m !== null) { m.name = heap("zzzzzzzz"); } junk(); return v; };
function t() { const o = new N(); const ctx = new Ctx(); ctx.n = o; console.log(k(ctx, o.name)); }
t();
