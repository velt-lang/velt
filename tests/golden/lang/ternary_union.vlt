// `c ? a : b` with branches of different types is their union, as `||` (#866).
class A {
  a = 1;
}

class B {
  b = "x";
}

function sign(n: number): number | string {
  return n > 0 ? n : "neg";
}

const qty: number = 0;
console.log(qty ? qty : "none");
const q2: number = 5;
const r = q2 ? q2 : "none";
console.log(r, typeof r);
const flag: boolean = true;
console.log(flag ? "yes" : 1, !flag ? "yes" : 1);
const c: boolean = q2 > 9;
console.log(c ? new A() : new B(), c ? [1] : "arr");
console.log(sign(1), sign(-1));
console.log([1, 2].map((n) => (n > 1 ? "big" : n)));
