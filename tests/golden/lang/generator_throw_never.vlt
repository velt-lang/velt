// check: no leaks
// `it.throw(e)` with an `e` that cannot exist (the `catch` of a `try` that throws nothing) adds
// nothing to what the caller throws: `drive()` is still a `Promise<number>`.
function* g(): Generator<number, void, unknown> {
  yield 1;
}

async function drive(): Promise<number> {
  const it = g();
  let r = it.next();
  while (!r.done) {
    try {
      const v = await Promise.resolve(1);
      r = it.next(v);
    } catch (e) {
      r = it.throw(e);
    }
  }
  return 7;
}

async function main(): Promise<void> {
  const x: Promise<number> = drive();
  console.log(await x);
}
