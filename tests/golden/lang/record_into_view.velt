// A `Record<string, unknown>` where an interface with named members and an `any` index signature
// is expected (#379, sigx's `jsx(component, props)` with props revived as a record): TypeScript
// assigns one to the other, and the value is the same record seen with the named members
// (`crate::index_signatures`), its `unknown` values as `any` ones. Node prints the same.
interface Props {
  children?: string;
  [key: string]: any;
}

function render(props: Props | null): string {
  return props === null ? "none" : Object.keys(props).join(",");
}

function label(props: Props): string {
  return `${props.children ?? "-"} ${props["a"]}`;
}

function main(): void {
  const raw: Record<string, unknown> = { a: 1, b: "x" };
  console.log(render(raw), render(null));
  const kids: Record<string, unknown> = { a: 2, children: "kid" };
  console.log(label(kids));
  raw["c"] = true;
  console.log(render(raw));
}
