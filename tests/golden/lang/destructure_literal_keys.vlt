// Literal computed keys in destructuring patterns, on a `Record` and on a typed object, and the
// index a key held in a constant is read with (a pattern takes literal keys only:
// errors/destructure_computed_path). Output compared with Node.

const KEY = "a";

interface T {
  a: number;
  "b c": string;
}

function main() {
  const o: Record<string, number> = { a: 1, "1.5": 2 };
  const typed: T = { a: 3, "b c": "x" };
  const { ["a"]: a, [1.5]: f } = o;
  const { ["a"]: ta, ["b c"]: bc } = typed;
  console.log(a, f, ta, bc);
  console.log(o[KEY], typed[KEY]);
}
