// A field changed by a copy of an array's function.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

function mk(): F {
  const b = new C();
  return (x: i64): i64 => {
    b.n += 1;
    return b.n;
  };
}

async function main() {
  const fs = [mk()];
  const f = shared(fs[0].clone());
  console.log(f(1));
}
