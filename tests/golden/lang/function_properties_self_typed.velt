// check: no leaks
// Expected output from `node`.
// A function with properties from a generic function, the type a generic alias whose call
// signature takes a deferred parameter type; a constant reads itself in a closure of its own
// initializer; two helpers with one body are one type while deferred.
type Plain<T> = { [K in keyof T as K extends `__${string}` ? never : K]: T[K] };
type Same<T> = { [K in keyof T as K extends `__${string}` ? never : K]: T[K] };
type Setup<P> = (ctx: { props: P }) => () => string;
type Factory<C extends Record<string, any>, R = void> = ((props: Plain<C>) => string) & {
    __setup: Setup<Same<C>>;
    __name?: string;
    __ref?: R;
};
function component<C extends Record<string, any> = {}, R = void>(
    setup: (ctx: { props: Plain<C> }) => () => string,
    name?: string,
): Factory<C, R> {
    const factory = function (props: any) {
        return "<" + (factory.__name ?? "anon") + ">" + JSON.stringify(props);
    } as unknown as Factory<C, R>;
    factory.__setup = setup as unknown as Setup<Same<C>>;
    factory.__name = name;
    return factory;
}
const Leaf = component<{ text: string; __brand: number }>((ctx) => () => ctx.props.text, "Leaf");
// Reads itself in a closure: typed by its written type argument and `component`'s result.
function render<P>(c: { (props: P): string; __name?: string }, props: P): string {
    return c.__name + ":" + c(props);
}
const Level = component<{ depth: number; __level: number }>((ctx) => {
    const { depth } = ctx.props;
    return (): string =>
        depth <= 1 ? "leaf" : "(" + render(Level, { depth: depth - 1 }) + ")";
}, "Level");
console.log(Leaf({ text: "a" }), Leaf.__name, Leaf.__setup({ props: { text: "b" } })());
console.log(Level.__setup({ props: { depth: 3 } })(), Level({ depth: 1 }), typeof Level);
function outer() {
    const Local = component<{ n: number }, string>((ctx) => (): string => {
        return ctx.props.n > 0 ? Local.__setup({ props: { n: ctx.props.n - 1 } })() + "x" : "";
    });
    return Local.__setup({ props: { n: 2 } })();
}
console.log(outer());
