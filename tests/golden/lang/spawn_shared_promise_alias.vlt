// A promise shared through another variable (`const q = p`) and passed to a spawned call
// is used on another task: the runtime stops the program instead of using the result from two
// threads (#212).
class Obj {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}
async function make(n: number): Promise<Obj> {
  await Promise.resolve();
  return new Obj(n);
}
async function use(p: Promise<Obj>): Promise<number> {
  const o = await p;
  return o.n;
}
async function main() {
  const p = make(1);
  const q = p;
  const t = spawn(use(q));
  console.log(await t);
  console.log((await p).n);
}
