// More ways a `Promise<T>` written without an error type gets its rejections, and closures that
// throw values that are no `Error` (sigx: runtime-core lazy.tsx `throw error` with
// `error: Error | null`).

class AErr extends Error {}

class BErr extends Error {}

class Failed extends Error {}

// The result of an async function or method is no site: a `Map` of `Promise<number>` taking
// `fa`'s rejection does not change what `fb` or `Svc.get` may throw.
async function fa(): Promise<number> {
  throw new AErr("a");
}

async function fb(): Promise<number> {
  throw new BErr("b");
}

class Svc {
  async get(): Promise<number> {
    throw new BErr("svc");
  }
}

const byName = new Map<string, Promise<number>>();

// `new Promise` and `Promise.withResolvers` without a written error type reject with what
// `reject` is called with.
function after(ok: boolean): Promise<string> {
  return new Promise((resolve, reject) => {
    if (ok) {
      resolve("fine");
    } else {
      reject(new Failed("not fine"));
    }
  });
}

function typed(ok: boolean): Promise<string> {
  return new Promise<string>((res, rj) => {
    if (ok) {
      res("typed ok");
    } else {
      rj(new Failed("typed"));
    }
  });
}

function deferred(ok: boolean): Promise<string> {
  const d = Promise.withResolvers<string>();
  if (ok) {
    d.resolve("deferred ok");
  } else {
    d.reject(new Failed("deferred"));
  }
  return d.promise;
}

// A synchronous override returning a rejecting promise.
class LoadError extends Error {}

async function fetchName(n: string): Promise<string> {
  if (n.startsWith("bad")) {
    throw new LoadError("no " + n);
  }
  return n;
}

class Base {
  load(n: string): Promise<string> {
    return Promise.resolve(n);
  }
}

class Sub extends Base {
  override load(n: string): Promise<string> {
    return fetchName(n);
  }
}

// Closures throwing `Error | null` and strings.
function make(mode: number): () => string {
  let error: Error | null = null;
  if (mode === 1) {
    error = new Error("boom");
  }
  return () => {
    if (mode === 0) {
      return "ok";
    }
    throw error;
  };
}

const thrower: (s: string) => number = (s) => {
  if (s === "x") {
    throw "str " + s;
  }
  return s.length;
};

async function main() {
  byName.set("a", fa());
  try {
    await fb();
  } catch (e) {
    console.log("fb:", (e as Error).message);
  }
  try {
    await new Svc().get();
  } catch (e) {
    console.log("svc:", (e as Error).message);
  }
  try {
    await byName.get("a");
  } catch (e) {
    console.log("map:", (e as Error).message);
  }

  const nw: Promise<string> = new Promise((res, rj) => rj(new Failed("x")));
  try {
    await nw;
  } catch (e) {
    console.log("nw:", (e as Error).message);
  }
  for (const ok of [true, false]) {
    for (const f of [after, typed, deferred]) {
      try {
        console.log(await f(ok));
      } catch (e) {
        console.log("rejected:", (e as Error).message);
      }
    }
  }

  const b: Base = new Sub();
  console.log(await b.load("ok"));
  try {
    await b.load("bad");
  } catch (e) {
    console.log("override:", (e as Error).message);
  }
  console.log(await new Base().load("base"));

  const fns: (() => string)[] = [make(0), make(1), make(2)];
  for (const f of fns) {
    try {
      console.log(f());
    } catch (e) {
      console.log("caught", e === null ? "null" : (e as Error).message);
    }
  }
  try {
    thrower("x");
  } catch (e) {
    console.log("caught", e);
  }
  console.log(thrower("abc"));
}

main();
