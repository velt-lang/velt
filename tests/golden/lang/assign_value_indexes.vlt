// An assignment used as a value gives the element it wrote, also when the right-hand side or
// another index changes a variable index meanwhile.
const arr: number[] = [1, 2];
let k = 0;
const v = (arr[k] = (() => { k = 1; return 5; })());
const ts: [number, string][] = [[1, "a"], [2, "b"]];
const s = (ts[k][1] += (() => { k = 0; return "!"; })());
type O = { t: [number, string] };
const os: O[] = [{ t: [1, "a"] }, { t: [2, "b"] }];
const w = (os[k].t[0] = (() => { k = 1; return 9; })());
console.log(v, s, w, k);
console.log(JSON.stringify(arr), JSON.stringify(ts), JSON.stringify(os));

const ws: ([number, string] | null)[] = [[1, "a"], null];
k = 0;
const wv = (ws[k]![0] = (() => { k = 1; return 5; })());
console.log(wv, JSON.stringify(ws), k);

// Variable and effectful indexes mixed.
const g: ([number, number] | null)[][][] = [[[[1, 2]], [[3, 4]]], [[[5, 6]], [[7, 8]]]];
let j = 0;
const gv = (g[j++][j][--j]![0] += 10);
console.log(gv, j, JSON.stringify(g));
const grid: ([number, number] | null)[][] = [[[0, 0], [0, 0]], [[0, 0], [0, 0]]];
let r = 0;
const a = (grid[r][r++]![1] = 3);
const b = (grid[r][--r]![0] += 4);
console.log(a, b, r, JSON.stringify(grid));
const xs: number[][] = [[1, 2], [3, 4]];
let x = 0;
const e = (xs[x][x++] = 9);
const f = (xs[x][--x] += 100);
console.log(e, f, JSON.stringify(xs));
const rec: Record<string, number> = { a: 1, b: 2 };
let key = "a";
const rv = (rec[key] = (() => { key = "b"; return 5; })());
console.log(rv, key, JSON.stringify(rec));

// A tuple inside a tuple held behind `!`, with an element as the root.
const nested: ([[number, number] | null, number] | null)[] = [[[1, 2], 0], [[3, 4], 1]];
nested[0]![0]![0]++;
nested[0]![0]![1] = 9;
console.log(JSON.stringify(nested));
let i = 0;
nested[i++]![0]![1] = (() => { i = 0; return 7; })();
const n1 = (nested[i]![0]![0] += (() => { i = 1; return 10; })());
const n2 = nested[i--]![0]![1]++;
const n3 = ++nested[i + 1]![0]![0];
const n4 = ((nested[1] as [[number, number] | null, number])[0]![1] *= 2);
console.log(n1, n2, n3, n4, i, JSON.stringify(nested));

// A field of an interface behind `!` or `as`, on a receiver bound once.
interface I { t: [number, string] | null; m(): void }
class K implements I { t: [number, string] | null = [1, "k"]; m(): void {} }
const kk = new K();
const is: I[] = [kk];
let q = 0;
is[q++].t![0]++;
is[--q].t![1] += "x";
(is[q] as I).t![0] += 5;
is.find(() => true)!.t![0] *= 2;
const iv = (is[q++].t![1] += "y");
const iw = (is[--q].t![0]++);
console.log(kk.t, iv, iw, q);
interface H { opt: [number, string] | null; u: [number, string] | number }
const hs: H[] = [{ opt: [1, "a"], u: [2, "b"] }, { opt: [3, "c"], u: 4 }];
let n = 0;
hs[n++].opt![0] = 5;
(hs[--n].u as [number, string])[1] += "q";
const h1 = (hs[n].opt![1] += (() => { n = 1; return "z"; })());
const h2 = (hs[n++].opt![0]++);
const h3 = ((hs[n - 2].u as [number, string])[0] = 8);
console.log(h1, h2, h3, n, JSON.stringify(hs));
