// User functions and methods whose names look like the compiler's top-level `await` mark are
// ordinary calls, at the top level, around awaits and in async code.
function sync__topLevelAwaitAt(s: string): void {
  console.log("fn", s);
}

function __topLevelAwaitAt(s: string): void {
  console.log("same name", s);
}

class Log {
  static x__topLevelAwaitAt(s: string): void {
    console.log("static", s);
  }
  m__topLevelAwaitAt(s: string): void {
    console.log("method", s);
  }
}

async function inner(): Promise<number> {
  sync__topLevelAwaitAt("in async");
  await new Promise<void>((r) => setTimeout(() => r(), 1));
  new Log().m__topLevelAwaitAt("after await in async");
  return 1;
}

sync__topLevelAwaitAt("inside a function");
Log.x__topLevelAwaitAt("method");
__topLevelAwaitAt("top");
const n = await inner();
new Log().m__topLevelAwaitAt("after await " + n);
await Promise.resolve(0);
sync__topLevelAwaitAt("end");
