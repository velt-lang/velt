// A subclass with its own `clone()` held as its base class.
type F = (x: i64) => i64;

class B {
  n: i64 = 0;
}

class K extends B {
  clone(): K {
    this.n += 1;
    return new K();
  }
  [Symbol.dispose]() {}
}

async function main() {
  const k: B = new K();
  const f = shared((x: i64): i64 => k.n);
  console.log(f(1));
}
