// check: no leaks
// Optional chaining on `any` (#924): a `null` or `undefined` link makes the whole chain
// `undefined` without evaluating the rest, as in Node.
class C {
  n: number = 1;
  inner: C | null = null;
  m(): number {
    return 5;
  }
}
function arg(): number {
  console.log("arg evaluated");
  return 1;
}
function main(): void {
  const u: any = undefined;
  const nul: any = null;
  const c: any = new C();
  console.log(u?.n);
  console.log(u?.m());
  console.log(nul?.[0]);
  console.log(nul?.a.b);
  console.log(c.nope?.());
  console.log(u?.f(arg()));
  console.log(c?.n);
  console.log(c?.m());
  console.log(c?.inner);
  console.log(c?.inner?.n);
  const xs: any = [10, 20];
  console.log(xs?.[1]);
  console.log(xs?.length);
  const s: any = "text";
  console.log(s?.length);
}
