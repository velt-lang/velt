// `return()` on a generator from inside its own body (through a reference it holds to itself)
// stops the program, like `next()` there: JS throws a `TypeError` ("Generator is already
// running").
class Holder {
  g: Generator<i64> | null = null;
}

function* gen(s: Holder): Generator<i64> {
  try {
    yield 1;
    s.g?.return();
    console.log("not reached");
    yield 2;
  } finally {
    console.log("not reached either");
  }
}

function main() {
  const s = new Holder();
  s.g = gen(s);
  console.log(s.g?.next());
  console.log(s.g?.next());
}
