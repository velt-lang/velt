// check: no leaks
// `key in obj` evaluates the key before the object, as in JavaScript (#823).
function key(): string {
  console.log("key");
  return "a";
}
function obj(): any {
  console.log("obj");
  return { a: 1 };
}
function main(): void {
  console.log(key() in obj());
  const p = new Proxy({ b: 2 }, {
    has(t, k) {
      console.log("has", k);
      return Reflect.has(t, k);
    },
  });
  const order: string[] = [];
  const k2 = (): string => {
    order.push("key");
    return "b";
  };
  const o2 = (): any => {
    order.push("obj");
    return p;
  };
  console.log(k2() in o2(), order.join(","));
}
