// check: no leaks
// A `read` callback nested in another stores an array it made into a container of the code
// around both reads (a `Set`, a `Map`, an array). That code holds the array from then on, as
// in JavaScript, so a later `read` that takes it out again frees it once and nothing touches it
// after (#1523). Also three reads deep.
class Box {
  items: number[][] = [[1, 2], [3]];
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const c = new RwLock(new Box());
  const s = new Set<number[][]>();
  const m = new Map<string, number[][]>();
  const out: number[][][] = [];
  a.read((x) => {
    b.read((y) => {
      s.add(y.items.slice());
      s.add(y.items.map((e) => e));
      m.set("k", y.items.filter((e) => e.length > 1));
      out.push(y.items.slice());
      out.unshift(y.items.map((e) => e));
      c.read((z) => {
        s.add(z.items.slice());
      });
    });
  });
  c.read((v) => {
    for (const t of s) {
      s.delete(t);
      console.log("set", t);
    }
    for (const [k, t] of m) {
      m.delete(k);
      console.log("map", k, t);
    }
    while (out.length > 0) {
      const t = out.pop();
      console.log("array", t);
    }
  });
  console.log(s.size, m.size, out.length);
}
