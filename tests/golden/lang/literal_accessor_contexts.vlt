// check: no leaks
// Getters and setters in object literals with no interface expected (#941), typed as
// TypeScript types them: a literal passed where a type parameter is inferred, stored as an
// `any`, or returned as a fields-only object type (sigx's `toSignal`, a view of the literal in
// a program with typed proxies, as this one is). Each read runs the getter, each write the
// setter; printing and JSON show the literal as Node does.

const brand = new WeakSet<object>();
function mark<T extends object>(handle: T): T {
  brand.add(handle);
  return handle;
}

type PropertySignal<T> = { value: T };

function toSignal<T extends object, K extends keyof T>(source: T, key: K): PropertySignal<T[K]> {
  return mark({
    get value() {
      return source[key];
    },
    set value(v: T[K]) {
      if (!Reflect.set(source, key, v)) {
        throw new Error("read-only " + String(key));
      }
    },
  });
}

const state = { count: 1, name: "a" };
const count = toSignal(state, "count");
const name = toSignal(state, "name");
console.log(count.value, name.value);
count.value = 5;
name.value += "b";
console.log(state.count, state.name, count.value, name.value);
state.count = 9;
console.log(count.value);

// A type parameter inferred from the literal: its own type, with the accessor.
function id<T>(x: T): T {
  return x;
}
let reads = 0;
const counter = id({
  step: 2,
  get next(): number {
    reads += this.step;
    return reads;
  },
});
console.log(counter.next, counter.next, reads);

// Stored as an `any`: reads and writes through it run the accessors.
let stored = 1;
const box: any = {
  get v(): number {
    return stored * 10;
  },
  set v(n: number) {
    stored = n;
  },
};
box.v = 4;
console.log(box.v, stored);

// Printed and written as JSON as Node shows them.
const lit = {
  n: 2,
  get double(): number {
    return this.n * 2;
  },
  set only(v: number) {},
};
lit.n = 10;
console.log(lit.double);
console.log(lit);
console.log(JSON.stringify(lit));

// A proxy makes this a program whose object types may hold views.
const p = new Proxy({ x: 1 }, {});
console.log(p.x);
