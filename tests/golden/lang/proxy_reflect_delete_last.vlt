// `Reflect.deleteProperty(a, i)` of an array's last element outside an array method on a proxy
// (#823): Node leaves a hole and keeps the length, which Velt's arrays cannot have yet.
const a: number[] = [1, 2, 3];
console.log(Reflect.deleteProperty(a, "7"), Reflect.deleteProperty(a, "length"), a.length);
Reflect.deleteProperty(a, "2");
console.log("not reached", a);
