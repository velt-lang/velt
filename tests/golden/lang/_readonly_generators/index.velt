// Generated functions that set a readonly field (_readonly_generators/gen.velt): generated code
// may set one only of the value it is building (a `const` it made from an object literal).

/** Sets `value.id` (a parameter's readonly field): an error in the generated code. */
export declare generated("./gen") function setParam<T>(value: T): T;

/** Sets the readonly field of a local copied from the parameter: an error too. */
export declare generated("./gen") function setCopy<T>(value: T): T;

/** Sets the readonly field of the value it builds: allowed. */
export declare generated("./gen") function setBuilt<T>(value: T): T;
