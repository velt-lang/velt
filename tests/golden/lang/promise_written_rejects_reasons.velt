// Rejection reasons of promises stored as function types with a `Promise<T>` result (#2590),
// used as values: a `.catch` callback's and a `.then` rejection callback's parameter, a
// `Promise.allSettled` result's `reason`, and a reason narrowed by `instanceof`.

class HttpError extends Error {
  status: number;
  constructor(status: number, message: string) {
    super(message);
    this.status = status;
  }
}

type Handler = (path: string) => Promise<string>;

const routes: Handler[] = [];

function get(h: Handler): void {
  routes.push(h);
}

get(async (p) => {
  if (p == "") {
    throw new HttpError(400, "e");
  }
  return "a" + p;
});

function later(ok: boolean): Promise<string> {
  return new Promise((resolve, reject) => {
    if (ok) {
      resolve("fine");
    } else {
      reject(new HttpError(503, "later"));
    }
  });
}

console.log(await routes[0]("").catch((e) => e.message));
console.log(await later(false).then((v) => v, (e) => "rejected: " + e.message));
const rs = await Promise.allSettled([routes[0]("")]);
for (const r of rs) {
  if (r.status == "rejected") {
    console.log("reason " + r.reason.message);
  }
}
console.log(
  await routes[0]("").catch((e) => {
    if (e instanceof HttpError) {
      return `s ${e.status}`;
    }
    return "x";
  }),
);
