// check: no leaks
// Passing a local, at its last use, to a parameter of a wider union type moves it, like a local
// declared with the union type. It used to be copied, so a value holding a promise panicked with
// "a promise cannot be copied" (#83). Found through std/jsx: compiled JSX passes `{items}` to
// `jsxEscape(value: Child)`.
class Task {
  pending: Promise<i64>[] = [];
}

type Slot = Task | string;

function keep(slot: Slot, into: Slot[]) {
  into.push(slot);
}

async function one(): Promise<i64> {
  return 1;
}

async function main() {
  const kept: Slot[] = [];
  const declared: Slot = new Task();
  keep(declared, kept);
  const t = new Task();
  t.pending.push(one());
  keep(t, kept);
  console.log(kept.length);
}
