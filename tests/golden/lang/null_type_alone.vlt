// check: no leaks
// `null` alone as a type (#1205): the member of a discriminated union whose field is always
// `null`, as in TypeScript.
type State =
  | { readonly st: "idle"; readonly value: null; readonly error: null }
  | { readonly st: "ready"; readonly value: number; readonly error: null }
  | { readonly st: "failed"; readonly value: null; readonly error: Error };

function show(s: State): string {
  switch (s.st) {
    case "idle":
      return `idle ${s.value}`;
    case "ready":
      return `ready ${s.value + 1}`;
    case "failed":
      return `failed ${s.error.message} ${s.value === null}`;
  }
}

function always(): null {
  return null;
}

function nothing(): undefined {
  return undefined;
}

// `??` on a value that is always `null` (or always `undefined`) gives the right side.
function defaults(s: State): string {
  const n: null = null;
  const u: undefined = undefined;
  const v = s.st === "idle" ? s.value ?? 3 : 0;
  return `${v} ${n ?? 4} ${always() ?? 5} ${u ?? 6} ${nothing() ?? 7}`;
}

function main() {
  const states: State[] = [
    { st: "idle", value: null, error: null },
    { st: "ready", value: 41, error: null },
    { st: "failed", value: null, error: new Error("boom") },
  ];
  for (const s of states) console.log(show(s));
  const n: null = always();
  const u: string | null = n;
  console.log(n, u, JSON.stringify(states[0]), typeof n, n === null, n ?? "fallback");
  console.log(states[1]);
  console.log(defaults(states[0]));
}
