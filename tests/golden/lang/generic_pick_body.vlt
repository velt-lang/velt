// The standard `pick` body and its relatives: `{} as Pick<T, K>` (or `Partial<T>`) filled through
// `r[k] = o[k]` and returned as that type (#350, #395; decision 5 of
// docs/internals/design/deferred-types.md). Keys of an optional field read as `F | undefined`.
function pick<T, K extends keyof T>(o: T, ks: K[]): Pick<T, K> {
  const r = {} as Pick<T, K>;
  for (const k of ks) {
    r[k] = o[k];
  }
  return r;
}

function only<T>(src: T, keys: (keyof T)[]): Partial<T> {
  const out = {} as Partial<T>;
  for (const k of keys) {
    out[k] = src[k];
  }
  return out;
}

function omit<T, K extends keyof T>(o: T, drop: string[], all: (keyof T)[]): Omit<T, K> {
  const r = {} as Omit<T, K>;
  for (const k of all) {
    if (!drop.includes(k as string)) {
      (r as any)[k] = o[k];
    }
  }
  return r;
}

type User = { id: number; name: string; nick?: string };
const u: User = { id: 1, name: "a", nick: "n" };
console.log(pick(u, ["id", "name"]), pick(u, ["name"]));
console.log(only(u, ["name"]), only(u, ["id", "nick"]));
console.log(omit<User, "nick">(u, ["nick"], ["id", "name", "nick"]));
const v: User = { id: 2, name: "b" };
console.log(pick(v, ["id", "nick"]), only(v, ["nick"]));
