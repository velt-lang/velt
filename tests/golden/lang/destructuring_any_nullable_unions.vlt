// check: no leaks
// Elements of a nullable union type read through an `any` (and destructured from it) are
// the member or nothing they hold. Expected output: Node's.
class A { a = 1; }
class B { b = "b"; }
function run(): void {
  const v: any = [1, "s", null];
  console.log(v[0], v[1], v[2]);
  const [x, y, z] = v;
  console.log(x, y, z);
  const u: (string | number | undefined)[] = ["a", 2, undefined];
  const w: any = u;
  console.log(w[0], w[1], w[2], w[3]);
  const ab: (A | B | null)[] = [new A(), new B(), null];
  const ar: any = ab;
  const [e, f, g] = ar;
  console.log(e, f, g);
}
function main(): void {
  run();
}
