// An assertion function that returns for a value that is not of its type (expected output from
// `node`, which then throws a TypeError calling the missing method): the call checks the value
// at run time and throws a TypeError.
class Animal {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
}
class Dog extends Animal {
  bark(): string {
    return this.name + " woof";
  }
}
function assertDog(a: Animal): asserts a is Dog {}
const pets: Animal[] = [new Dog("rex"), new Animal("tom")];
for (const p of pets) {
  assertDog(p);
  console.log(p.bark());
}
