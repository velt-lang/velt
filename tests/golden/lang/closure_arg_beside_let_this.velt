// A `let` of `this`, and a part beside its owner (#2527). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; }
const KK = (q: A2) => { q.c = new I2(); q.c.s = heap("zzzzzzzz"); q.xs = []; junk(); };
const KT = (q: T) => { q.c = new I2(); q.c.s = heap("zzzzzzzz"); junk(); };
class T { c: I2 = new I2(); run(v: string) { let r: T = this; KT(r); junk(); return v + "!"; } }
function t() { const a = new T(); console.log(a.run(a.c.s)); }
t();
