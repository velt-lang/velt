// A module constant written through `!`, `as`, `??`, `?:` or `&&` is the one object Node
// changes, as one written directly (`K.v = 1`) is: the write shows at every later use (#1406).

interface J {
  v: number;
  a: { b: number };
}

export const K: J | null = { v: 1, a: { b: 1 } };
export const N: J = { v: 1, a: { b: 1 } };
export const U: { o: J | null } = { o: { v: 1, a: { b: 1 } } };
export const A: J = { v: 1, a: { b: 1 } };
export const B: J | null = { v: 1, a: { b: 1 } };
let D: J = { v: 0, a: { b: 0 } };

K!.v = 4;
console.log(K!.v);
K!.v++;
console.log(K!.v);
(K as J).v += 1;
console.log(K!.v);
U.o!.v = 6;
console.log(U.o!.v);
(U.o ?? D).v = 2;
console.log(U.o!.v, D.v);
(K as unknown as J).v = 3;
console.log(K!.v);
(K as any).v = 7;
console.log(K!.v);
(N as unknown as J).a.b = 3;
console.log(N.a.b);
(N as any).v = 3;
console.log(N.v);
(true ? K! : D).v = 8;
console.log(K!.v, D.v);
(D.v > 0 ? D : A).v = 5;
console.log(A.v, D.v);
if (B?.a) {
  B!.a.b = 3;
}
console.log(B!.a.b);
B?.a && (B!.a.b = 4);
console.log(B!.a.b);
K!.a.b *= 5;
console.log(K!.a.b, K?.a.b);
