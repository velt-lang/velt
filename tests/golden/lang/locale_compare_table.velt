  "\u0380\u0381\u0382\u0383\u038B\u038D\u03A2\u2065\u20C1\u20C2\u20C3\u20C4\u20C5\u20C6" +
  "\u20C7\u20C8\u20C9\u20CA\u20CB\u20CC\u20CD\u20CE\u20CF";

function sign(order: i64): string {
  return order < 0 ? "<" : order > 0 ? ">" : "=";
}

function main() {
  const chars = ORDER.split("");
  let line = "";
  for (let i = 0; i + 1 < chars.length; i++) {
    const x = chars[i];
    const y = chars[i + 1];
    line += sign(x.localeCompare(y));
    line += sign((x + "b").localeCompare(y + "a"));
    line += sign((x + "\u00E1").localeCompare(y + "a"));
    if (line.length == 72) {
      console.log(line);
      line = "";
    }
  }
  console.log(line);
}
