// An interval cleared by its own callback is not queued again: a later timer with its delay
// starts a list of its own, as in Node, instead of joining the interval's (`Y` runs before `X`,
// due 20 ms later).
function busy(ms: number) {
  const s = Date.now();
  while (Date.now() - s < ms) {}
}

function main() {
  const ivs: Timer[] = [];
  const iv = setInterval(() => {
    console.log("interval once");
    clearInterval(ivs[0]);
  }, 100);
  ivs.push(iv);
  setTimeout(() => {
    console.log("B 120");
    setTimeout(() => console.log("Y 130"), 130);
    busy(50);
    setTimeout(() => console.log("X 100"), 100);
    busy(200);
  }, 120);
  console.log("main end");
}
