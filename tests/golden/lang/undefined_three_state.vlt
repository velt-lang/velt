// check: no leaks
// `T | null | undefined` (issue #930, phase 1b): three states, kept apart by `===`, `typeof`,
// printing and JSON; `== null`, `??`, `?.`, `!` and truthiness test both nothings; narrowing by
// each test; conversions from `T | null` and `T | undefined`; `undefined` alone as a type;
// `let x: T | undefined;` starting as `undefined`. Output identical to Node 22.
class Box {
  v: number;
  constructor(v: number) {
    this.v = v;
  }
}

function show(x: string | null | undefined): string {
  if (x === undefined) {
    return "undef";
  }
  if (x === null) {
    return "null";
  }
  return "str:" + x;
}

function len(x: string | null | undefined): number {
  return x?.length ?? -1;
}

function kind(x: Box | null | undefined): string {
  if (x == null) {
    return typeof x;
  }
  return "box " + x.v;
}

function basics(): void {
  const a: string | null | undefined = undefined;
  const b: string | null | undefined = null;
  const c: string | null | undefined = "hi";
  console.log(a, b, c);
  console.log(typeof a, typeof b, typeof c);
  console.log(a === undefined, a === null, a == null, b === undefined, b === null, b == null);
  console.log(c === undefined, c === null, c == null, c != null);
  console.log(show(a), show(b), show(c));
  console.log(len(a), len(b), len(c));
  console.log(`${a} ${b} ${c}`);
  console.log([a, b, c]);
  console.log({ a, b, c });
  console.log(JSON.stringify({ a, b, c }));
  console.log(JSON.stringify([a, b, c]));
  console.log(a ?? "d1", b ?? "d2", c ?? "d3");
  console.log(!a, !b, !c);
  const n1: number | null = null;
  const u1: number | undefined = undefined;
  const v1: number | undefined = 5;
  const xs: (number | null | undefined)[] = [n1, u1, v1, 7];
  console.log(xs);
  for (const x of xs) {
    console.log(x, typeof x, x === null, x === undefined);
  }
  console.log(kind(undefined), kind(null), kind(new Box(3)));
  const boxes: (Box | null | undefined)[] = [new Box(1), null, undefined];
  console.log(boxes);
  console.log(boxes.map((x) => (x ? x.v : String(x))));
  let late: string | undefined;
  console.log(late, typeof late);
  late = "set";
  console.log(late);
  let late2: number | null | undefined;
  console.log(late2);
  late2 = null;
  console.log(late2);
  const u = undefined;
  console.log(u, typeof u);
  console.log(undefined);
  const mixed = [1, undefined, 3];
  console.log(mixed);
}

interface Node2 {
  name: string;
  next: Node2 | undefined;
  label: string | null;
}

class Holder {
  value: string | null | undefined = undefined;
  set(v: string | null | undefined): void {
    this.value = v;
  }
}

function describe(x: number | null | undefined): string {
  if (x === null) {
    return "null";
  }
  if (x === undefined) {
    return "undefined";
  }
  return "n=" + (x + 1);
}

function fromNull(x: string | null): string | null | undefined {
  return x;
}

function fromUndef(x: string | undefined): string | null | undefined {
  return x;
}

function pick<T>(a: T | undefined, b: T): T {
  return a === undefined ? b : a;
}

function firstLabel(n: Node2 | undefined): string | null | undefined {
  return n?.label;
}

function conversions(): void {
  console.log(describe(null), describe(undefined), describe(41));
  console.log(fromNull(null), fromNull("a"), fromUndef(undefined), fromUndef("b"));
  const h = new Holder();
  console.log(h.value, typeof h.value);
  h.set(null);
  console.log(h.value, typeof h.value);
  h.set("x");
  console.log(h.value);
  console.log(h);
  const n: Node2 = { name: "a", next: undefined, label: null };
  const m: Node2 = { name: "b", next: n, label: "L" };
  console.log(firstLabel(undefined), firstLabel(n), firstLabel(m));
  console.log(m.next?.label, m.next?.next?.label);
  const s: string | null = null;
  console.log(pick<string | null>(undefined, "dflt"), pick<string | null>(s, "dflt"));
  const xs: (string | null | undefined)[] = ["a", null, undefined];
  const ys = xs.map((x) => x ?? "?");
  console.log(ys, xs.length);
  const strs = xs.filter((x) => x != null);
  console.log(strs);
  let v: string | null | undefined = "start";
  for (let i = 0; i < 3; i++) {
    v = i === 0 ? null : i === 1 ? undefined : "s" + i;
    console.log(i, v, v === null, v === undefined, v && v.length);
  }
  const t: string | null | undefined = "abc";
  if (t !== undefined) {
    console.log(t === null ? "nul" : t.length);
  }
  const w: string | null | undefined = undefined;
  console.log(w || "or", w ?? "nn", String(w), `${w}`);
  const z: number | null = null;
  console.log(JSON.stringify({ w, t, z }));
  const objs: { k: string | null | undefined }[] = [{ k: "1" }, { k: null }, { k: undefined }];
  console.log(objs, JSON.stringify(objs));
}

interface Opts {
  a?: number | undefined;
  b?: string | null | undefined;
}

function f(x?: number | undefined, y?: string | null | undefined): string {
  return `${x} ${y} ${typeof x} ${typeof y}`;
}

function anyOf(v: string | null | undefined): unknown {
  return v;
}

function optionals(): void {
  const o: Opts = {};
  const p: Opts = { a: 1, b: null };
  console.log(o.a, o.b, p.a, p.b);
  console.log(f(), f(1), f(undefined, null), f(2, "s"));
  const xs: (string | null | undefined)[] = ["a", null, undefined];
  for (const x of xs) {
    const d = anyOf(x);
    console.log(d, typeof d, d === undefined, d === null);
  }
}

type F = "inline" | "end";

interface B {
  flush: F | null;
}

function flushes(b: B | undefined, c: F | null | undefined, d: F | null): string {
  return `${b?.flush === "inline"} ${c === "inline"} ${d === "inline"} ${c === "end"}`;
}

function flushName(x: F | null | undefined): string {
  switch (x) {
    case null:
      return "null";
    case undefined:
      return "undefined";
    case "inline":
      return "in";
    default:
      return "other";
  }
}

function literals(): void {
  console.log(flushes(undefined, undefined, null));
  console.log(flushes({ flush: "inline" }, "inline", "inline"));
  console.log(flushes({ flush: null }, null, "end"));
  console.log(flushName(null), flushName(undefined), flushName("inline"), flushName("end"));
}

function main(): void {
  basics();
  conversions();
  optionals();
  literals();
}
