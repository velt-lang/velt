// A value of a declared literal union is not widening: a `let` taken from a method call or an
// IIFE that gives it back keeps the union, so another string is an error, as in TypeScript
// (#2686).
class B {
  id<T>(x: T): T {
    return x;
  }
}
function f(m: "x" | "y") {
  let w1 = new B().id(m);
  w1 = "o";
  let w2 = (() => m)();
  w2 = "o";
  return w1 + w2;
}
function main() {
  console.log(f("x"));
}
main();
