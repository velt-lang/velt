// Closures written before the `const` they use, which they read when they run (#1142; sigx's
// effect / computed / watch / renderer shapes).
type Job = () => void;

function makeEffect(fn: () => void, scheduler?: (job: Job) => void): {
  run: () => void;
  stop: () => void;
} {
  let stopped = false;
  let running = false;
  const effectFn = (): void => {
    if (stopped) {
      return;
    }
    if (running) {
      return;
    }
    if (scheduler) {
      scheduler(runJob);
      return;
    }
    runJob();
  };
  const runJob = (): void => {
    if (stopped) {
      return;
    }
    running = true;
    fn();
    running = false;
  };
  effectFn();
  return {
    run: effectFn,
    stop: () => {
      stopped = true;
    },
  };
}

interface Box {
  read(): number;
}

function computedBox(getter: () => number, seen: string[]): Box {
  let cached: number | undefined = undefined;
  const readValue = (): number => {
    seen.push("read " + (computedObj === undefined ? "none" : "box"));
    if (cached === undefined) {
      cached = getter();
    }
    return cached;
  };
  const computedObj: Box = {
    read(): number {
      return readValue();
    },
  };
  return computedObj;
}

function watchOnce(log: string[]): void {
  let disposed = false;
  const run = (cb: () => void): void => cb();
  run(() => {
    log.push("callback");
    queueMicrotask(() => stop());
  });
  const stop = () => {
    if (disposed) {
      return;
    }
    disposed = true;
    log.push("stopped");
  };
}

interface MountContext {
  el: string;
}

function mount(dev: boolean, hooks: ((c: MountContext) => void)[]): () => void {
  let reload: () => void = () => {};
  if (dev) {
    reload = () => {
      for (let i = 0; i < hooks.length; i++) {
        hooks[i](mountCtx);
      }
    };
  }
  const mountCtx = { el: "root" } as MountContext;
  for (const h of hooks) {
    h(mountCtx);
  }
  return reload;
}

const log: string[] = [];
let count = 0;
const e = makeEffect(() => {
  count++;
  log.push("effect " + count);
});
e.run();
const queued: Job[] = [];
const s = makeEffect(() => log.push("scheduled"), (job) => queued.push(job));
s.run();
log.push("queued " + queued.length);
queued[0]();
e.stop();
e.run();
const seen: string[] = [];
const b = computedBox(() => 42, seen);
console.log(b.read(), b.read(), seen.join(","));
watchOnce(log);
const reload = mount(true, [(c) => log.push("hook " + c.el)]);
reload();
queueMicrotask(() => {
  console.log(log.join("\n"));
});

// The later local is the one every closure of its block names, also a closure in a branch, an
// arrow beside one whose parameter has the name, and one hiding a module function or constant.
function helperName(): string {
  return "module";
}

const topv = "topv";

function shadowing(c: boolean): void {
  const out: (() => string)[] = [];
  if (c) {
    const helperName = (): string => "inner";
    out.push(() => helperName());
  } else {
    out.push(() => helperName());
  }
  out.push(() => helperName() + " " + topv);
  const helperName = (): string => "later";
  const topv = "local topv";
  for (const f of out) {
    console.log(f());
  }
}

shadowing(true);
shadowing(false);

function params(): void {
  const apply = (f: (s: string) => string, g: () => string) => f("p") + g();
  const call = () => apply((stop) => stop + "!", () => stop);
  const stop = "S";
  console.log(call());
}

params();

// A `let`, and declarations using each other (the later one first).
const outerY = "outer";

function lets(): void {
  const f = () => outerY + " " + n;
  let n = 1;
  const outerY = "inner";
  console.log(f());
  n = 2;
  console.log(f());
}

lets();

function mutual(): void {
  const f = (): number => a() + b();
  const b = () => a() + 1;
  const a = () => 1;
  console.log(f());
}

mutual();

// Nothing between the closure and the declaration runs code: no ready check is needed.
function inertBetween(): number {
  const f = (): number => g() + 1;
  const g = (): number => 41;
  let s = 0;
  for (let i = 0; i < 3; i++) {
    s += f();
  }
  return s;
}

console.log(inertBetween());

function methodBefore(): number {
  const o = {
    m() {
      return k3();
    },
  };
  const k3 = () => 3;
  return o.m();
}

console.log(methodBefore());
