// check: no leaks
// `new Map(entries)` and `new Set(values)`, as in TypeScript: the key and value types come from
// the entries (a `[K, V]` tuple literal per entry) or the type arguments; a repeated key keeps
// its first position and takes the last value; the map takes ownership of the entries.
import { Set } from "velt:collections/set";

class Actor {
  name: string;

  constructor(name: string) {
    this.name = name;
  }
}

function pairs(): [string, Actor][] {
  return [
    ["a", new Actor("alice")],
    ["b", new Actor("bob")],
  ];
}

async function main() {
  const m = new Map([
    ["x", 1],
    ["y", 2],
    ["x", 3],
  ]);
  console.log(m.size, m.get("x"), m.get("y"));
  for (const [k, v] of m) {
    console.log(k, v);
  }

  const typed = new Map<i32, string>([
    [1, "one"],
    [2, "two"],
  ]);
  console.log(typed.get(2));

  const actors = new Map(pairs());
  console.log(actors.get("b")?.name, actors.size);

  const nested = new Map([
    ["evens", [2, 4]],
    ["odds", [1, 3, 5]],
  ]);
  const odds = nested.get("odds");
  console.log(odds?.length);

  const empty = new Map<string, i64>();
  console.log(empty.size);

  const s = new Set(["a", "b", "a", "c"]);
  console.log(s.size, s.has("a"), s.values());
  const ids = new Set<u8>([3, 1, 3]);
  console.log(ids.values());
  const fromArray = new Set(["z"].concat(["y"]));
  console.log(fromArray.size, new Set<string>().size);
}
