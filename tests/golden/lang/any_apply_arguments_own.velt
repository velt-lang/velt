// A callee's `arguments` is its own, not the list `apply` was given.
const xs: any[] = [1, 2];
const self = { tag: "x" };
const write: any = function (this: any) {
  arguments[0] = 7;
  return xs[0];
};
console.log(write.apply(self, xs), xs[0]);
const grow: any = function (this: any) {
  xs.push(3);
  return `${arguments.length}:${xs.length}`;
};
console.log(grow.apply(self, xs), xs.length);
const named: any = function (this: any, a: any, b: any) {
  xs[0] = 5;
  return `${this.tag} ${a} ${b}`;
};
console.log(named.apply(self, xs));
