// A string literal union (a `const`'s `c ? "x" : "y"`, its `as const` form, a parameter's
// `"pq" | "rs"`) is a string to `for...of`, indexing (also `m?.[0]`) and spreading, and to a
// generic `T extends string` that concatenates it (#2686).
const c = Math.random() > 2;
const a1 = c ? "x" : "y";
const a2 = c ? ("xy" as const) : ("zw" as const);
for (const ch of a1) console.log(ch);
console.log(a1[0], [...a1].length);
for (const ch of a2) console.log(ch);
console.log(a2[1], [...a2].join("-"));
function f(m: "pq" | "rs") {
  for (const ch of m) console.log(ch);
  return m[0] + [...m].length;
}
console.log(f("rs"));
function g<T extends string>(x: T) {
  return x + "!";
}
const s: string = g(a1);
console.log(s, g(a2), f("pq"));
function h(m: "x" | "y") {
  return g(m);
}
console.log(h("y"));
function first(m?: "pq" | "rs") {
  return m?.[0];
}
console.log(first("rs"), first());
