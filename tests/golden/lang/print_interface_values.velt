// A value of an interface type prints as the object it holds, alone, nullable, in a union, in an
// array or in an object, and `String(x)` and a template literal write it as Node does.
interface Shape {
  kind: string;
  area(): number;
}

class Square implements Shape {
  kind = "square";
  side: number;
  constructor(side: number) {
    this.side = side;
  }
  area(): number {
    return this.side * this.side;
  }
}

const square: Shape = new Square(3);
const literal: Shape = { kind: "literal", area: () => 1 };
const maybe: Shape | null = Math.random() > 2 ? null : literal;
const none: Shape | null = null;
const either: Shape | string = Math.random() > 2 ? "text" : square;
const shapes: Shape[] = [square, literal];

console.log(square, literal);
console.log("maybe:", maybe, "none:", none);
console.log(either, String(either), `${either}`);
console.log(shapes, { first: square });
console.log(String(square), `${literal}`, `${shapes}`);
console.warn("on stderr:", square);

// An object literal filling an interface field with a getter prints it `[Getter]`, as Node does.
interface Sized {
  readonly size: number;
  describe(): string;
}

const withGetter: Sized = {
  get size() {
    return 4;
  },
  describe() {
    return "x";
  },
};
const maybeSized: Sized | null = withGetter;
console.log(withGetter, [withGetter], maybeSized, { w: withGetter });
console.log(withGetter.size, String(withGetter));

// A function value stored in an interface field is no getter: Node prints `[Function: value]`.
interface Box<T> {
  value: T;
  get(): T;
}

const box: Box<() => number> = {
  value: () => 1,
  get() {
    return this.value;
  },
};
const boxAsAny: any = box;
console.log(box, [box]);
console.log(boxAsAny, box.get()());
