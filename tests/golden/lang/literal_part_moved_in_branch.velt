// check: no leaks
// An object literal whose fields are in the type's order shares a string field of an owned
// param (`dir: s.dir`) while a later operand moves another field of it inside a branch
// (`start ? s.role ?? "" : ""`). The share is the literal's: the statement must not drop it
// again after the push, or the array's record holds the param's buffer without a reference of
// its own, and dropping the record frees the string the param's owner still holds (#3728, the
// same release #3399 fixed for a closure operand).

type Item = { id: string; dir: string; role?: string; tags?: string[] };
type Cmd = { dir: string; tags: string[]; system: string };

function queue(cmds: Cmd[], s: Item, start: boolean): void {
  // Moving a part of `s` makes `s` the function's own.
  const tags = s.tags ?? [];
  cmds.push({ dir: s.dir, tags, system: start ? s.role ?? "" : "" });
}

const items: Item[] = [
  { id: "s1", dir: "/home/someone/" + "x".repeat(20) },
  {
    id: "s2",
    dir: "/home/someone/" + "y".repeat(20),
    role: "coordinator " + "z".repeat(20),
    tags: ["a"],
  },
];
let cmds: Cmd[] = [];
for (let i = 0; i < 3; i++) {
  for (const id of ["s1", "s2"]) {
    const s = items.find((x) => x.id === id);
    if (s != null) {
      queue(cmds, s, i === 1);
    }
  }
  for (const c of cmds) {
    console.log(i, c.dir, c.tags.length, c.system);
  }
  // Dropping the commands must leave the items' strings alive.
  cmds = [];
  console.log(i, items[0].dir, items[1].dir, items[1].role ?? "");
}
