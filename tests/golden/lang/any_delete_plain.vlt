// `delete` and `Reflect.deleteProperty` through `any` of a value that is not a proxy (#823):
// a record's entry is removed, an optional field made absent, a key the value does not have
// as its own is `true` and an array's `length` is `false`.
const rec: Record<string, number> = { a: 1, b: 2 };
console.log(Reflect.deleteProperty(rec, "a"), rec, Reflect.deleteProperty(rec, "zz"));
const ra: any = rec;
delete ra["b"];
console.log(rec, Object.keys(rec));

interface Opt {
  name: string;
  tag?: string;
  note?: string | null;
}

const o: Opt = { name: "n", tag: "t", note: null };
const oa: any = o;
console.log(delete oa.tag, delete oa.note, delete oa.missing);
console.log(o, "note" in oa, JSON.stringify(o));
oa.tag = "back";
console.log(o);

class C {
  v = 1;
  m(): number {
    return this.v;
  }
}

const c: any = new C();
console.log(Reflect.deleteProperty(c, "m"), Reflect.deleteProperty(c, "zz"), c.m());
const arr: any = [1, 2];
console.log(Reflect.deleteProperty(arr, "length"));
const p = new Proxy(rec, {
  deleteProperty(t, k) {
    console.log("trap", String(k));
    return Reflect.deleteProperty(t, k);
  },
});
rec.c = 3;
const pa: any = p;
delete pa.c;
console.log(rec);
