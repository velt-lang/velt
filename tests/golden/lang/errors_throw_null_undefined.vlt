// Thrown `null` and `undefined` are caught as thrown, also from one function that throws both
// (its error type is then `unknown`).
function f(k: number): void {
  const a: Error | undefined = undefined;
  const b: string | null = null;
  if (k === 0) {
    throw a;
  }
  if (k === 1) {
    throw b;
  }
}

for (const k of [0, 1]) {
  try {
    f(k);
  } catch (e) {
    console.log(k, e);
  }
}

function g(k: number): void {
  const n: null = null;
  if (k === 0) {
    throw n;
  }
  if (k === 1) {
    throw undefined;
  }
}

for (const k of [0, 1, 2]) {
  try {
    g(k);
    console.log(k, "ok");
  } catch (e) {
    console.log(k, "caught", e);
  }
}
