// Built-in array methods called on an array held in an `any` (#924): callbacks get each element,
// its index and the array; mutating methods change the array itself.
const xs: any = [3, 1, 2];
console.log(xs.push(4, 5), xs);
console.log(xs.pop(), xs.shift(), xs);
console.log(xs.unshift(9, 8), xs);
console.log(xs.map((x: number) => x * 2), xs.filter((x: number) => x > 2), xs.includes(9), xs.includes(7), xs.indexOf(1), xs.indexOf(7));
console.log(xs.slice(1, 3), xs.slice(-2), xs.join("-"), xs.join(), xs.at(-1), xs.lastIndexOf(9));
console.log(xs.find((x: number) => x < 5), xs.findIndex((x: number) => x === 1), xs.some((x: number) => x > 8), xs.every((x: number) => x > 0));
console.log(xs.reduce((a: number, x: number) => a + x, 0), xs.reduce((a: number, x: number) => a + x), xs.concat([1, 2], 3));
let seen = 0;
xs.forEach((x: number, i: number) => {
  seen += x * i;
});
console.log(seen, xs.reverse(), xs.toString());
console.log(xs.splice(1, 2), xs, xs.splice(1, 0, 7, 7), xs);
const words: any = ["b", "a", "c"];
console.log(words.map((w: string) => w.toUpperCase()), words.includes("a"), words.indexOf("c"));
const objs: any = [{ id: 1 }, { id: 2 }];
console.log(objs.map((o: any) => o.id), objs.filter((o: any) => o.id > 1), objs.find((o: any) => o.id === 2));
const nested: any = { list: [1, 2, 3], name: "  sigx " };
console.log(nested.list.map((x: any) => x + 1), nested.name.trim().toUpperCase(), nested.list.length);
nested.list.push(4);
console.log(nested.list);
// An empty array literal converted to an `any` takes elements of every type.
const grow: any = [];
grow.push(1);
grow.push("two", 3);
console.log(grow, grow.length, grow.pop(), grow.find((x: any) => x === "two"), grow.reduce((a: any, x: any) => a + x, ""));
// `sort` through `any`: by `ToString` (10 before 9), `undefined` last; a comparator's result is `ToNumber`ed.
const nums: any = [10, 9, 1, 100];
console.log(nums.sort(), nums);
console.log(nums.sort((a: number, b: number) => a - b));
console.log(nums.sort((a: number, b: number) => (b > a ? "1" : "-1") as any));
const mixed: any = ["b", undefined, "a", 3];
console.log(mixed.sort());
const empty: any = [];
const flags: any = [true, false];
console.log(empty.sort(), flags.sort());
const und: any = [undefined, 3, undefined, 1];
console.log(und.sort((a: any, b: any) => b - a));
const u2: any = [2, undefined, 1];
let calls = 0;
u2.sort((a: any, b: any) => {
  calls++;
  return a - b;
});
console.log(u2, calls);
