// check: no leaks
// A `read` callback stores arrays it made from the value's elements into the caller's array
// through methods that take them as a rest parameter or by reference (`unshift`, `splice`,
// `fill`), as well as through `push` and a `Map`'s `set` of an array literal. Each stored
// array is the caller's, freed once, and a later `write` leaves it as it was (#1523).
class Box {
  items: number[][] = [[1, 2], [3]];
}

class Pair {
  v: number[][];
  constructor(v: number[][]) {
    this.v = v;
  }
}

function main() {
  const rw = new RwLock(new Box());
  const holder: number[][][] = [];
  const keep: number[][] = [[7]];
  const pairs: Pair[] = [];
  const byName = new Map<string, number[][][]>();
  rw.read((x) => {
    holder.unshift(x.items.map((e) => e));
    holder.unshift(x.items.slice(), keep);
    holder.unshift(...[x.items.slice()]);
    holder.splice(0, 0, x.items.filter((e) => e.length > 0));
    holder.splice(1, 0, x.items.slice(), x.items.filter((e) => e.length > 1));
    holder.splice(0, 0, ...[x.items.slice(), x.items.slice()]);
    holder.push(...[x.items.slice()]);
    pairs.unshift(new Pair(x.items.map((e) => e)));
    byName.set("k", [x.items.slice(), keep]);
  });
  console.log(holder.length, holder);
  rw.read((x) => {
    holder.fill(x.items.slice(), 0, 2);
  });
  rw.read((x) => {
    holder.fill(x.items.map((e) => e));
  });
  rw.write((x) => {
    x.items = [];
  });
  holder[0].push([4]);
  console.log(holder, pairs[0].v, byName.get("k"));
}
