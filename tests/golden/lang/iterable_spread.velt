// check: no leaks
// Spreading an iterable (#424): `[...gen()]`, `[a, ...it, b]` and spread arguments of a rest
// parameter take every value of any iterable, in order, with the same `for...of` loop a
// statement would use: a direct generator call keeps its state in the frame, other iterables
// go through `[Symbol.iterator]()` / `next()`, and an error thrown while spreading closes the
// iterator. Arrays keep their own spread.
class StopError extends Error {}

function* count(from: i64, to: i64): Generator<i64> {
  try {
    for (let i = from; i < to; i++) {
      console.log(`  yield ${i}`);
      yield i;
    }
  } finally {
    console.log(`  closed ${from}..${to}`);
  }
}

function* words(): Generator<string> {
  yield "red";
  yield "green";
  yield "blue";
}

function* failing(n: i64): Generator<i64, StopError> {
  for (let i = 0; i < n; i++) {
    yield i;
  }
  throw new StopError(`stopped after ${n}`);
}

class Countdown implements Iterator<i64> {
  constructor(private n: i64) {}

  next(): IteratorResult<i64> {
    if (this.n == 0) {
      return { done: true };
    }
    this.n--;
    return { value: this.n, done: false };
  }
}

class Countdowns implements Iterable<i64> {
  constructor(private n: i64) {}

  [Symbol.iterator](): Iterator<i64> {
    return new Countdown(this.n);
  }
}

class Shelf {
  constructor(private books: string[]) {}

  *[Symbol.iterator](): Generator<string> {
    for (const b of this.books) {
      yield b.toUpperCase();
    }
  }
}

function sum(...xs: i64[]): i64 {
  let total = 0;
  for (const x of xs) {
    total += x;
  }
  return total;
}

function joined(sep: string, ...parts: string[]): string {
  return parts.join(sep);
}

function spreadValue(it: Iterable<i64>): i64[] {
  return [-1, ...it, -1];
}

async function tick(): Promise<void> {}

async function later(): Promise<string[]> {
  await tick();
  const ws = [...words()];
  await tick();
  return ws;
}

function* again(): Generator<string> {
  const ws = [...words(), "again"];
  yield* ws;
}

async function main() {
  console.log("whole:");
  console.log([...count(0, 3)]);
  console.log("around:");
  console.log([10, ...count(1, 3), 20]);
  const xs = [7, 8];
  console.log("mixed:", [...xs, ...count(5, 6), ...xs]);
  console.log("strings:", [...words()]);
  console.log("iterable class:", [...new Countdowns(3)]);
  console.log("generator method:", [...new Shelf(["a", "b"])]);
  console.log("iterable value:", spreadValue(new Countdowns(2)));
  const g = words();
  g.next();
  console.log("generator value:", [...g], [...g]);
  console.log("rest parameter:", sum(...count(1, 4)), sum(100, ...new Countdowns(3)));
  console.log("rest after:", joined("-", ...words()));
  console.log("Math.max:", Math.max(...[1.5, 4.5, 2.5]));
  try {
    console.log([...failing(2)]);
  } catch (e) {
    console.log("caught:", e.message);
  }
  console.log("async:", await later());
  console.log("in a generator:", [...again()]);
}
