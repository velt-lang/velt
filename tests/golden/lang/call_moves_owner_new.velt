// A call that moves an object and lends a part of it: a constructor (#2531). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; name: string = heap("n"); }
let hold: A2 | null = null;
class W { v: string; constructor(q: A2, v: string) { hold = q; hold = null; junk(); this.v = v + "!"; } }
function t() { const a = new A2(); console.log(new W(a, a.name).v); }
t();
