// A library whose functions a source generator writes per type (_generators/gen.vlt;
// docs/internals/design/source-generators.md).

/** A one-line description of type `T`: its kind and its fields. */
export declare generated("./gen") function describe<T>(): string;

/** `value` as text, written per type: fields in order, strings quoted. */
export declare generated("./gen") function show<T>(value: T): string;

/** Which member of the union `value` holds, and its value. */
export declare generated("./gen") function armOf<T>(value: T): string;

/** What a body that keeps its parameter (as an `any`) makes of `value`. */
export declare generated("./gen") function hold<T>(value: T): string;

/** The field names of `T`, each with a `!`, written with a closure. */
export declare generated("./gen") function marked<T>(): string;

/** A generated function whose generator writes code that does not compile. */
export declare generated("./gen") function broken<T>(value: T): string;

/** A generated function whose generator throws. */
export declare generated("./gen") function crash<T>(): string;

/** The fields of `value`, private ones too, as `name=value` pairs. */
export declare generated("./gen") function peek<T>(value: T): string;

/** A copy of `value` built without its constructor. */
export declare generated("./gen") function rebuild<T>(value: T): T;

/** A generated function whose code builds a type it was not given. */
export declare generated("./gen") function forge<T>(): i32;

/** A class no request reaches. */
class Hidden {
  code: i32;
  private constructor(code: i32) {
    this.code = code;
  }
}

/** A generated function whose generator reads the clock. */
export declare generated("./impure") function stamped<T>(): string;
