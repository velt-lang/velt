// The compiler can't follow a function an interface method returns, so `shared(...)` panics.
type F = (x: i64) => i64;

interface Fi {
  make(): F;
}

class L {
  m: Mutex<i64[]> = new Mutex<i64[]>([]);
}

class Fa implements Fi {
  make(): F {
    const l = new L();
    return (x: i64): i64 => l.m.with((v) => {
      v.push(1);
      return v.length as i64;
    });
  }
}

async function main() {
  const m: Fi = new Fa();
  const f = shared(m.make());
  console.log(f(1));
}
