// check: no leaks
// A truthy optional chain that goes on after its `?.` narrows the object of the `?.`:
// `if (c?.m.has(k)) c.m.get(k)`, `if (o?.f())`.
type Ctx = { provides: Map<string, number> };

let active: Ctx | null = null;

function lookup(k: string, c: Ctx | undefined): number {
  if (c?.provides.has(k)) {
    return c.provides.get(k) ?? -1;
  }
  return 0;
}

function viaActive(k: string): number | undefined {
  const a = active;
  if (a?.provides.has(k)) {
    return a.provides.get(k);
  }
  return undefined;
}

class Node1 {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
  ok(): boolean {
    return this.name.length > 0;
  }
}

function nameOf(n: Node1 | null): string {
  if (n?.ok()) {
    return n.name;
  }
  return "-";
}

const m = new Map<string, number>([["a", 1]]);
console.log(lookup("a", { provides: m }), lookup("b", { provides: m }), lookup("a", undefined));
active = { provides: m };
console.log(
  viaActive("a"),
  viaActive("z"),
  nameOf(new Node1("x")),
  nameOf(new Node1("")),
  nameOf(null),
);
