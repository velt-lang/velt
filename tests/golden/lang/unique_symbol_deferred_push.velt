// A union with a member made from a type parameter: the member's slot is decided per instance, so
// a symbol that is not `K` stops at the test (#923). Here the field is written to. Node gives a TypeError on `undefined`;
// a thrown TypeError with another message is the accepted difference.
const K = Symbol("k");

function c<T>(x: any): T {
  return x as T;
}

function h<T>(x: (T & { n: number[] }) | typeof K): number {
  if (x !== K) {
    x.n.push(1);
    return x.n.length;
  }
  return -1;
}

type Q = { q: number };
console.log(h<Q>(K));
console.log(h<Q>(c<(Q & { n: number[] }) | typeof K>(Symbol("z"))));
