// A top-level statement or declaration that uses a class, an enum or a top-level variable
// declared after it, directly: the declaration is not evaluated yet when it runs (Node throws
// a `ReferenceError`; TypeScript reports "used before its declaration"), so it is an error
// (#1438). Each line fails in Node on its own.
console.log(new Box().v);
const doubled = BASE * 2;

class A {
  static readonly b: number = B.v;
}

class Sub extends Base {}

for (let i = 0; i < 1; i++) {
  console.log(Mode.On);
}

class Box {
  v: number = 1;
}

const BASE = 4;

class B {
  static readonly v: number = 1;
}

class Base {
  v: number = 1;
}

enum Mode {
  On = 1,
}
