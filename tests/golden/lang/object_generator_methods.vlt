// Generator methods in object literals (`*name()`, `async *name()`) are properties holding
// generator functions, as in Node; leaving a loop over one early closes it. Expected output from
// node.
const bag = {
  label: "bag",
  *items(n: number): Generator<number> {
    try {
      for (let i = 0; i < n; i++) {
        yield i * 2;
      }
    } finally {
      console.log("closed");
    }
  },
  async *ticks(): AsyncGenerator<string> {
    yield "a";
    yield "b";
  },
};

async function main() {
  console.log([...bag.items(3)], bag.label);
  for (const v of bag.items(10)) {
    if (v > 2) {
      break;
    }
    console.log(v);
  }
  for await (const t of bag.ticks()) {
    console.log(t);
  }
  console.log("items" in bag, "ticks" in bag, "next" in bag);
}
