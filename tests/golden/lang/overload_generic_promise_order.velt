// A promise converted by an interface adapter (#379; `validate(): Promise<Res<S>>` read through
// `Options<unknown>`) settles when the method's own promise does, as in Node, where it is that
// promise (#3277). It shows when `Promise.all` gets two promises that have both rejected already
// and the converted one comes first: both reject with the first in array order (`before`).
interface Ctx {
  id: string;
}

type Res<O> = { value: O };

interface Schema<O> {
  validate(value: unknown): Promise<Res<O>>;
}

interface Options<S> {
  input: Schema<S>;
  handler(rq: Ctx, input: S): string;
}

function run<S>(options: Options<S>): Promise<string>;
async function run(options: Options<unknown>): Promise<string> {
  const kept = options.input.validate("kept");
  let out = "";
  try {
    await kept;
  } catch (e) {
    out += "first " + String(e);
  }
  try {
    await Promise.all([kept, options.input.validate("after")]);
  } catch (e) {
    out += " / kept first: " + String(e);
  }
  try {
    await Promise.all([options.input.validate("before"), kept]);
  } catch (e) {
    out += " / converted first: " + String(e);
  }
  return out;
}

const count: Schema<number> = {
  async validate(value: unknown): Promise<Res<number>> {
    if (typeof value === "number") {
      return { value: value + 1 };
    }
    throw new Error(String(value));
  },
};

async function main(): Promise<void> {
  console.log(await run({ input: count, handler: (rq: Ctx, n: number): string => rq.id + n }));
}
main();
