// A documented difference from Node (#379): a promise converted by an interface adapter
// (`validate(): Promise<Res<S>>` read through `Options<unknown>`) settles one step after the
// method's own promise, because the conversion runs when that promise settles. It shows when
// `Promise.all` gets two promises that have both rejected already and the converted one comes
// first: Node rejects with the first in array order (`before`), Velt with the one that had
// settled when `Promise.all` looked (`kept`). With the kept promise first, both agree.
interface Ctx {
  id: string;
}

type Res<O> = { value: O };

interface Schema<O> {
  validate(value: unknown): Promise<Res<O>>;
}

interface Options<S> {
  input: Schema<S>;
  handler(rq: Ctx, input: S): string;
}

function run<S>(options: Options<S>): Promise<string>;
async function run(options: Options<unknown>): Promise<string> {
  const kept = options.input.validate("kept");
  let out = "";
  try {
    await kept;
  } catch (e) {
    out += "first " + String(e);
  }
  try {
    await Promise.all([kept, options.input.validate("after")]);
  } catch (e) {
    out += " / kept first: " + String(e);
  }
  try {
    await Promise.all([options.input.validate("before"), kept]);
  } catch (e) {
    out += " / converted first: " + String(e);
  }
  return out;
}

const count: Schema<number> = {
  async validate(value: unknown): Promise<Res<number>> {
    if (typeof value === "number") {
      return { value: value + 1 };
    }
    throw new Error(String(value));
  },
};

async function main(): Promise<void> {
  console.log(await run({ input: count, handler: (rq: Ctx, n: number): string => rq.id + n }));
}
main();
