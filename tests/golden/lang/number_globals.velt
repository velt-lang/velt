// `NaN`, `Infinity`, `isNaN`, `isFinite`, `Math.hypot` with up to four values, and `Math.umulh`.
// Expected output is Node's (umulh: `(a * b) >> 64n` on BigInts).
function main() {
  console.log(NaN, Infinity, -Infinity, isNaN(NaN), isNaN(1.0), isFinite(Infinity), isFinite(2.5));
  console.log(Math.hypot(), Math.hypot(-3.0), Math.hypot(3.0, 4.0), Math.hypot(1.0, 2.0, 2.0));
  console.log(
    Math.hypot(1.0, 1.0, 1.0, 1.0),
    Math.hypot(1e200, 1e200, 1e200),
    Math.hypot(NaN, Infinity),
  );
  console.log(
    Math.umulh(18446744073709551615, 18446744073709551615),
    Math.umulh(4294967296, 4294967296),
  );
  // Operands the compiler can't fold, so the multiply itself runs (inline on both backends).
  let a: u64 = 11400714819323198485;
  let acc: u64 = 0;
  for (let i: u64 = 0; i < 5; i++) {
    a = a * 6364136223846793005 + 1442695040888963407;
    acc = acc ^ Math.umulh(a, a + i);
  }
  console.log(acc);
}
