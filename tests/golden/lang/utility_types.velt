// Partial, Required, Readonly, Pick and Omit build object types from a concrete object type
// (docs/internals/design/shared-models.md, step 3). The results are ordinary object types.
// Declaration order doesn't matter, and Omit accepts a key that isn't a field (a warning), as
// TypeScript does, so a generic alias can omit a field some of its arguments don't have.

interface Base {
  readonly id: number;
}

interface User extends Base {
  name: string;
  email?: string;
}

class Account {
  owner: string = "ann";
  private secret: string = "s";
  balance: number = 10;
}

type Patch = Partial<User>;
type Summary = Pick<User, "id" | "name">;
type Draft = Omit<User, "id">;
type Complete = Required<User>;
type Point = Readonly<{ x: number; y: number }>;
type AccountView = Readonly<Account>;
type Key = "name";
type NameOnly = Pick<User, Key>;

// Field types that apply an operator to types declared further down.
interface Form {
  draft: Partial<Later>;
  head: Pick<Derived, "a" | "b">;
}

type WithoutChildren<P> = Omit<P, "children">;
type Props = { label: string; children: string[] };
type ItemProps = WithoutChildren<Props>;
type BareProps = WithoutChildren<{ label: string; size: number }>;

interface Later {
  a: number;
}

class Derived extends Root {
  b: string = "b";
}

class Root {
  a: number = 1;
}

function apply(u: User, p: Patch): User {
  return { id: u.id, name: p.name ?? u.name, email: p.email ?? u.email };
}

function main() {
  const u: User = { id: 1, name: "ann" };
  console.log(apply(u, { email: "a@x" }).email ?? "-", apply(u, {}).name);

  // `Pick<User, "id" | "name">` is the object type `{ readonly id: number; name: string }`.
  const s: Summary = { id: 2, name: "bo" };
  const plain: { readonly id: number; name: string } = s;
  const n: NameOnly = { name: "cy" };
  console.log(plain.name, n.name);

  const d: Draft = { name: "dee", email: "d@x" };
  const c: Complete = { id: 3, name: "eve", email: "e@x" };
  console.log(JSON.stringify(d), c.email.length);

  const p: Point = { x: 1, y: 2 };
  const view: AccountView = { owner: "fay", balance: 5 };
  console.log(p.x + p.y, view.owner, view.balance);

  const fromJson = JSON.parse<Patch>("{\"name\":\"gus\"}");
  console.log(fromJson.name ?? "-", fromJson.email ?? "-");

  const form: Form = { draft: {}, head: { a: 4, b: "h" } };
  const item: ItemProps = { label: "item" };
  const bare: BareProps = { label: "bare", size: 2 };
  console.log(form.draft.a ?? 0, form.head.b, item.label, bare.size);
}
