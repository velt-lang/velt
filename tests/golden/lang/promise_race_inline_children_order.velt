// `Promise.race` over async calls made in the array and stored ones: the winner and the order of
// their steps are Node's (#1356, #2099).
async function tick(n: number): Promise<void> {
  for (let i = 0; i < n; i++) {
    await Promise.resolve();
  }
}

async function make(i: number, n: number): Promise<number> {
  await tick(n);
  console.log("settle", i);
  return i;
}

async function job(name: string, n: number): Promise<string> {
  let s = `${name}:`;
  for (let i = 0; i < n; i++) {
    s += i;
    await null;
  }
  return s;
}

async function main() {
  const late = make(7, 3);
  console.log("race", await Promise.race([make(8, 1), late]));
  const a = make(9, 1);
  const b = make(100, 1);
  console.log("race", await Promise.race([a, b]));
  const r = make(9, 1);
  console.log("race", await Promise.race([r, make(100, 0)]));
  console.log(await Promise.race([job("x", 3), job("y", 1)]));
  await tick(5);
}
