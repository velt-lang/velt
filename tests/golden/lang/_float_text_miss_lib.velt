// The other half of float_text_miss.velt: conversions of `number` values that nothing here marks
// as floats (no float literal, `/`, `**`, `Math`, `as f64` or `f64` declaration): only their types
// say that they may hold one.

/** `v=` and `x`'s text. */
export function show(x: number): string {
  return `v=${x}`;
}

/** `x`'s text alone. */
export function alone(x: number): string {
  return String(x);
}

/** A number in a field. */
export class Box {
  v: number;

  constructor(v: number) {
    this.v = v;
  }

  text(): string {
    return `box ${this.v}`;
  }
}
