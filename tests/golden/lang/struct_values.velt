// check: no leaks
// A struct is an immutable value (#641): a copy is another value, `==` compares the content
// (numbers by their bits: a `NaN` equals itself, `-0` is not `0`; strings by text; arrays and
// class objects inside by identity), `Map` and `Set` keys agree, and a new value replaces one
// (`{ ...p, x: 5 }`) in a variable, an array element or a class field.
struct Vec2 {
  x: number;
  y: number;

  add(o: Vec2): Vec2 {
    return { x: this.x + o.x, y: this.y + o.y };
  }

  static readonly ZERO: Vec2 = { x: 0, y: 0 };
}

struct Named {
  name: string;
  at: Vec2;
  tags: string[];
}

class Holder {
  pos: Vec2 = { x: 1, y: 1 };
}

function moved(p: Vec2): Vec2 {
  p = { ...p, x: p.x + 10 };
  return p;
}

function main() {
  let a: Vec2 = { x: 1, y: 2 };
  const b = a;
  a = { ...a, x: 5 };
  console.log(a.x, b.x, a == b, b == { x: 1, y: 2 }, a != b);

  // Passing copies: the callee's new value is its own.
  const c = moved(b);
  console.log(b.x, c.x);

  // Numbers compare by their bits.
  const n1: Vec2 = { x: NaN, y: 0 };
  const n2: Vec2 = { x: NaN, y: 0 };
  const z: Vec2 = { x: 0, y: -0 };
  console.log(n1 == n2, z == Vec2.ZERO, z == { x: 0, y: -0 });

  // Arrays of structs: an element is replaced, never changed in place.
  const ps: Vec2[] = [a, b, Vec2.ZERO];
  ps[1] = ps[1].add({ x: 1, y: 1 });
  console.log(ps[1].x, ps[1].y, b.x, ps.includes({ x: 5, y: 2 }), ps.indexOf(Vec2.ZERO));

  // Strings by text, arrays inside by identity.
  const tags = ["t"];
  const long = "a name longer than twenty-three bytes";
  const m: Named = { name: long, at: a, tags };
  const m2: Named = { name: "a name longer than " + "twenty-three bytes", at: { x: 5, y: 2 }, tags };
  const m3: Named = { ...m2, tags: ["t"] };
  console.log(m == m2, m == m3);

  // A class field holding a struct.
  const h = new Holder();
  const before = h.pos;
  h.pos = before.add(before);
  console.log(before.x, h.pos.x);

  // Keys by content.
  const seen = new Set<Vec2>();
  seen.add(a);
  seen.add({ x: 5, y: 2 });
  seen.add(n1);
  seen.add(n2);
  seen.add(Vec2.ZERO);
  seen.add(z);
  console.log(seen.size, seen.has({ x: NaN, y: 0 }));

  // A closure sees the variable, as in JS: its new value.
  let p: Vec2 = { x: 1, y: 1 };
  const f = () => p.x;
  p = { ...p, x: 9 };
  console.log(f(), p.x);
}
