// check: no leaks
// Functions with wider parameter types (#1454) as callbacks of Map, Set, sort and findIndex, an
// interface-typed parameter taking class instances, a bound method, and stored in an array, an
// object field and a function's result. Expected output: Node's.
interface Shape {
  area(): number;
}

class Sq implements Shape {
  side: number;
  constructor(side: number) {
    this.side = side;
  }
  area(): number {
    return this.side * this.side;
  }
}

[new Sq(2), new Sq(3)].forEach((s: Shape) => console.log("shape", s.area()));
const m = new Map<string, number>([
  ["a", 1],
  ["b", 2],
]);
m.forEach((v: any, k: unknown) => console.log("map", k, v));

class C {
  tag = "c";
  m(v: unknown): void {
    console.log("method", v);
  }
}

const c = new C();
[1, 2].forEach(c.m.bind(c));
const s = new Set<string>(["x"]);
s.forEach((v: any) => console.log("set", v));
const sorted = [3, 1, 2].sort((a: any, b: any) => (a as number) - (b as number));
console.log(sorted);
console.log([1, 2].findIndex((v: unknown) => v === 2));
const p = new Promise<number>((resolve) => resolve(4));
p.then((v: object | number) => console.log("obj|num", v));
const fns: Array<(x: number) => void> = [(v: any) => console.log("arr fn", v)];
fns[0](5);

function ret(): (x: number) => string {
  return (v: any) => `ret ${v}`;
}

console.log(ret()(6));
const obj: { cb: (x: number) => void } = { cb: (v: any) => console.log("obj field", v) };
obj.cb(7);
