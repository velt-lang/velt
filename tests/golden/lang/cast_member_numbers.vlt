// A number field that a member of the union lacks, read through `(u as M).f` as an operand of
// a relational or arithmetic operator (not `+`), is `NaN` there, which gives Node's answer for
// its `undefined`: every comparison is false and the arithmetic is `NaN`.
type V = { type: string; props: number };
type C = V | string | C[];

function f(c: C): boolean {
  return (c as V).props > 0;
}

function g(c: C): string {
  const parts: string[] = [];
  parts.push(String((c as V).props < 5), String((c as V).props <= 5), String((c as V).props >= 0));
  parts.push(String(0 > (c as V).props), String((c as V).props - 1), String((c as V).props * 2));
  parts.push(String(((c as V).props / 2) % 3));
  return parts.join(" ");
}

console.log(f({ type: "x", props: 1 }), f("s"), f([]));
console.log(g({ type: "x", props: 4 }));
console.log(g("s"));
console.log(g([["a"]]));
