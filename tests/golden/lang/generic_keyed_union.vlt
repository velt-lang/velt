// `x[k]` in a generic body at an instantiation whose key type names several fields of different
// types (#350): tsc accepts it, and Node reads whichever field the key holds; Velt's `T[K]` is the
// union of the field types there.
function get<T extends object, K extends keyof T>(source: T, key: K): T[K] {
  return source[key];
}

const st = { count: 0, name: "a" };
const k: "count" | "name" = st.count > 0 ? "count" : "name";
console.log(get(st, k), get(st, "count"));
