// A closure or function value given a container and its part: the part keeps what was read when
// the argument was evaluated, whatever the callee does through the container (#2480). Output
// checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxx").length; }
type N = { x: number };
class I { s: string; constructor(s: string) { this.s = s; } }
class R {
  s: string = heap("old");
  o: string | null = heap("old");
  u: string | number = heap("old");
  a: any = heap("old");
  ob: N = { x: 1 };
  t: [number, string] = [1, heap("old")];
  n: number | null = 1;
  i: I = new I(heap("old"));
  run(k: (q: R, v: string) => string): string { return k(this, this.s); }
}
function string_() {
  const r = new R();
  const f = (q: R, v: string) => { q.s = heap("new"); junk(); return v; };
  console.log("string", f(r, r.s), r.s);
}
function optional() {
  const r = new R();
  const f = (q: R, v: string | null) => { q.o = null; junk(); return v; };
  console.log("optional", f(r, r.o), r.o);
}
function union() {
  const r = new R();
  const f = (q: R, v: string | number) => { q.u = 9; junk(); return v; };
  console.log("union", f(r, r.u), r.u);
}
function any_() {
  const r = new R();
  const f = (q: R, v: any) => { q.a = 9; junk(); return String(v); };
  console.log("any", f(r, r.a), r.a);
}
function object_() {
  const r = new R();
  const f = (q: R, v: N) => { q.ob = { x: 9 }; junk(); v.x = 77; return v.x; };
  console.log("object", f(r, r.ob), r.ob.x);
}
function tuple() {
  const r = new R();
  const f = (q: R, v: [number, string]) => { q.t = [9, heap("new")]; junk(); return v[0] + v[1]; };
  console.log("tuple", f(r, r.t), r.t[0]);
}
function copyAggregate() {
  const r = new R();
  const f = (q: R, v: number | null) => { q.n = null; return v; };
  console.log("number or null", f(r, r.n), r.n);
}
function classField() {
  const r = new R();
  const f = (q: R, v: I) => { q.i = new I(heap("new")); junk(); return v.s; };
  console.log("class field", f(r, r.i), r.i.s);
}
function throughClass() {
  const r = new R();
  const f = (q: R, v: string) => { q.i = new I(heap("new")); junk(); return v; };
  console.log("through a class", f(r, r.i.s), r.i.s);
}
function arrayPop() {
  const xs = [heap("old")];
  const f = (q: string[], v: string) => { q.pop(); junk(); return v; };
  console.log("array pop", f(xs, xs[0]), xs.length);
}
function arrayStore() {
  const xs = [heap("old")];
  const f = (q: string[], v: string) => { q[0] = heap("new"); junk(); return v; };
  console.log("array store", f(xs, xs[0]), xs[0]);
}
function tupleStore() {
  const t: [string, string] = [heap("old"), heap("other")];
  const f = (q: [string, string], v: string) => { q[0] = heap("new"); junk(); return v; };
  console.log("tuple store", f(t, t[0]), t[0]);
}
function objectType() {
  const o = { s: heap("old") };
  const f = (q: { s: string }, v: string) => { q.s = heap("new"); junk(); return v; };
  console.log("object type", f(o, o.s), o.s);
}
function forwarded() {
  const r = new R();
  const k = (q: R, v: string) => { q.s = heap("new"); junk(); return v; };
  const app = (g: (q: R, v: string) => string, q: R) => g(q, q.s);
  console.log("forwarded", app(k, r), r.s);
  const r2 = new R();
  console.log("from a method", r2.run(k), r2.s);
}
function held() {
  const r = new R();
  const h = { f: (q: R, v: string) => { q.s = heap("new"); junk(); return v; } };
  console.log("in a field", h.f(r, r.s), r.s);
  const r2 = new R();
  function named(q: R, v: string) { q.s = heap("new"); junk(); return v; }
  const asValue = named;
  console.log("named as a value", asValue(r2, r2.s), r2.s);
  const r3 = new R();
  let seen = 0;
  function nested(q: R, v: string) { seen++; q.s = heap("new"); junk(); return v; }
  console.log("nested with a capture", nested(r3, r3.s), r3.s, seen);
}
function converted() {
  const r = new R();
  const f = (q: R, v: string | null) => { q.s = heap("new"); junk(); return v; };
  console.log("to optional", f(r, r.s), r.s);
  const r2 = new R();
  const g = (q: R, v: any) => { q.s = heap("new"); junk(); return String(v); };
  console.log("to any", g(r2, r2.s), r2.s);
}
function twoParts() {
  const r = new R();
  const f = (q: R, v: string, w: string | null) => { q.s = heap("new"); q.o = null; junk(); return v + String(w); };
  console.log("two parts", f(r, r.s, r.o), r.s, r.o);
}
function asyncAndGenerator() {
  const r = new R();
  const g = function* (q: R, v: string) { q.s = heap("new"); yield v; yield q.s; };
  console.log("generator", [...g(r, r.s)].join());
}
async function asyncClosure() {
  const r = new R();
  const f = async (q: R, v: string) => { q.s = heap("new"); await new Promise<void>((d) => setTimeout(() => d(), 0)); return v; };
  console.log("async", await f(r, r.s), r.s);
}
string_(); optional(); union(); any_(); object_(); tuple(); copyAggregate(); classField();
throughClass(); arrayPop(); arrayStore(); tupleStore(); objectType(); forwarded(); held();
converted(); twoParts(); asyncAndGenerator();
asyncClosure().then(() => console.log("done"));
