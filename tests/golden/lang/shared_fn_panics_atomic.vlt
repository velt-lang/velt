// The compiler can't follow a function an interface method returns, so `shared(...)` panics.
type F = (x: i64) => i64;

class H {
  f: F;
  constructor(f: F) {
    this.f = f;
  }
}

interface I {
  call(x: i64): i64;
}

class W implements I {
  f: F;
  constructor(f: F) {
    this.f = f;
  }
  call(x: i64): i64 {
    return this.f(x);
  }
}

interface Fi {
  make(): F;
}

class Fa implements Fi {
  make(): F {
    const a = new Atomic<i64>(0);
    return (x: i64): i64 => {
      a.store(a.load() + 1);
      return a.load();
    };
  }
}

async function main() {
  const m: Fi = new Fa();
  const f = shared(m.make());
  console.log(f(1));
}
