// Named members next to an index signature whose values are `any` or `unknown` (sigx's
// `JSXProps`, `InternalSlotsObject` and `DevtoolsEventBase`), as in TypeScript: the type is a
// `Record<string, any>` (or `unknown`), so every key, named or not, can be read, written,
// deleted, spread and listed. A function held by a key is called as `r.key()`.
interface JSXProps {
  children?: string;
  [key: string]: any;
}

interface EventBase {
  readonly type: string;
  readonly [key: string]: unknown;
}

interface Slots {
  default?: (p?: any) => any[];
  _version: { v: number };
  [key: string]: any;
}

function props(p: JSXProps | null): void {
  const copy = { ...p };
  const { children, ...rest } = p || {};
  console.log(copy.children, children, rest, rest.key, "children" in copy);
}

const seen: EventBase[] = [];

function emit(event: EventBase): void {
  seen.push(event);
}

props({ children: "x", key: 1 });
props(null);
emit({ type: "a:b", id: 1 });
emit({ type: "c:d", id: 2, extra: "x" });
console.log(seen.length, seen.map((e) => e.type), seen[1]["extra"]);

const s: Slots = { _version: { v: 1 } };
s.header = () => ["h"];
console.log(Object.keys(s), s._version.v, typeof s.default, s.header());
for (const k in s) {
  console.log("key", k);
}
console.log(JSON.stringify({ ...s, n: 1 }));
s.default = () => [1, 2];
console.log(s.default().length);
delete s.header;
console.log(Object.keys(s));

// A required named member keeps its declared type (checked at run time, since an index
// write may store another type); an optional one reads as the values' type.
interface Labeled {
  label: string;
  n: number;
  [key: string]: any;
}
const l: Labeled = { label: "ab", n: 2 };
console.log(l.label.toUpperCase(), l.n * 2);
l.extra = true;
console.log(Object.keys(l), { ...l }, "label" in l);
const t: string = ({ type: "t" } as EventBase).type;
console.log(t.length);

// The view is an object: `typeof`, generics, `Map` values, rest patterns and spreads keep it.
function describe(p: Labeled | string): string {
  if (typeof p === "object") {
    return "obj " + p.label;
  }
  return "str " + p;
}

function same<T>(x: T): T {
  return x;
}

const g: Labeled = same<Labeled>({ label: "y", n: 1, extra: [1] });
const byKey = new Map<string, Labeled>();
byKey.set("k", { label: "m", n: 3 });
const { label, ...others } = g;
const moved: Labeled = { ...g, label: "z" };
moved.label = "w";
console.log(describe(l), describe("s"), g.label, g.extra, byKey.get("k")?.label);
console.log(label, others, moved.label, moved);

// As a union member, the view asserts to its record (sigx's `mod as Record<string, any>`).
type Load = () => string;
interface Module {
  default: Load;
  [key: string]: any;
}

function pick(m: Load | Module): string {
  if (typeof m === "function") {
    return m();
  }
  const r = m as Record<string, any>;
  return Object.keys(r).join(",") + ":" + m.default();
}

console.log(pick(() => "f"), pick({ default: () => "d", x: 1 }));

// A required member keeps its type in compound assignments and in `r["name"]` too.
interface Counted {
  label: string;
  n: number;
  [key: string]: any;
}

function bump(r: Counted, by: number): number {
  r.n += by;
  return r.n;
}

const cnt: Counted = { label: "a", n: 1 };
cnt.label += "b";
cnt.n++;
++cnt.n;
cnt.n *= 5;
cnt["label"] += "c";
console.log(cnt.label, cnt["label"].toUpperCase(), cnt.n, cnt["n"] + 1, bump(cnt, 3));
const ev: EventBase = { type: "click", x: 1 };
console.log(ev["type"].length, ev.type.toUpperCase());

// A literal or a write gives a required member a value of its declared type: `[]` is a
// `number[]`, a callback's parameters get their types, a nested literal gets its object type,
// `new Map()` its type arguments.
interface Items {
  items: number[];
  [key: string]: any;
}

interface Cfg {
  cfg: { a: number[] };
  [key: string]: any;
}

interface On {
  on: (n: number) => number;
  [key: string]: any;
}

interface WithMap {
  m: Map<string, number>;
  [key: string]: any;
}

interface Rows {
  rows: { id: number; tags: string[] }[];
  [key: string]: any;
}

interface Handler {
  on: (e: { x: number }) => string;
  [key: string]: any;
}

const it1: Items = { items: [] };
it1.items.push(1);
console.log(it1.items);
const it2: Items = { items: [5] };
it2.items = [];
it2.items.push(2);
it2["items"] = [];
it2["items"].push(3);
console.log(it2.items);
const key: "items" = "items";
it2[key] = [];
it2[key].push(4);
console.log(it2.items);

const cf: Cfg = { cfg: { a: [] } };
console.log(cf.cfg.a.length);
cf.cfg = { a: [] };
cf.cfg.a.push(4);
console.log(cf.cfg);

const on: On = { on: (n) => n + 1 };
console.log(on.on(1));
on.on = (n) => n * 10;
console.log(on.on(2));

const wm: WithMap = { m: new Map() };
wm.m.set("a", 1);
console.log(wm.m.get("a"), wm.m.size);
wm.m = new Map();
console.log(wm.m.size);

const shared: number[] = [];
const it3: Items = { items: shared, extra: [] };
it3.items.push(7);
console.log(it3.items, shared, it3.extra);
const it4: Items = { items: [] };
it4.items ||= [];
it4.items ??= [];
const it5: Items = { ...it4, items: [] };
it5.items.push(9);
it5.items[0] += 10;
console.log(it4.items.length, it5.items);

const rows: Rows = { rows: [{ id: 1, tags: [] }] };
rows.rows[0].tags.push("t");
rows.rows.push({ id: 2, tags: [] });
console.log(rows.rows);
const h1: Handler = { on: ({ x }) => "x" + x, other: (y: number) => y };
const h2: Handler = {
  on(e) {
    return "m" + e.x;
  },
};
console.log(h1.on({ x: 1 }), h1.other(2), h2.on({ x: 3 }));

async function filled(): Promise<Items> {
  const r: Items = { items: [] };
  r.items.push(await Promise.resolve(8));
  return r;
}

filled().then((r) => console.log(r.items));

// The member's type reaches a literal wherever the view is expected.
interface Tagged {
  tags: string[];
  readonly [key: string]: unknown;
}

class Holder {
  p: Items = { items: [] };
  add(): number[] {
    this.p.items.push(5);
    this.p.items = [...this.p.items, 6];
    return this.p.items;
  }
}

function makeItems(): Items {
  return { items: [] };
}

function useItems(p: Items): number {
  p.items.push(4);
  return p.items.length;
}

const nested: { p: Items } = { p: { items: [] } };
nested.p.items.push(1);
const list: Items[] = [{ items: [] }];
list[0].items.push(2);
const made = makeItems();
made.items.push(3);
console.log(nested.p.items, list[0].items, made.items, useItems({ items: [] }));
const tg: Tagged = { tags: [] };
tg.tags.push("a");
const either: Items = list.length > 5 ? { items: [1] } : { items: [] };
either.items.push(0);
console.log(tg.tags, tg, new Holder().add(), either.items);
