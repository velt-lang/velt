// Named members next to an index signature whose values are `any` or `unknown` (sigx's
// `JSXProps`, `InternalSlotsObject` and `DevtoolsEventBase`), as in TypeScript: the type is a
// `Record<string, any>` (or `unknown`), so every key, named or not, can be read, written,
// deleted, spread and listed. A function held by a key is called as `r.key()`.
interface JSXProps {
  children?: string;
  [key: string]: any;
}

interface EventBase {
  readonly type: string;
  readonly [key: string]: unknown;
}

interface Slots {
  default?: (p?: any) => any[];
  _version: { v: number };
  [key: string]: any;
}

function props(p: JSXProps | null): void {
  const copy = { ...p };
  const { children, ...rest } = p || {};
  console.log(copy.children, children, rest, rest.key, "children" in copy);
}

const seen: EventBase[] = [];

function emit(event: EventBase): void {
  seen.push(event);
}

props({ children: "x", key: 1 });
props(null);
emit({ type: "a:b", id: 1 });
emit({ type: "c:d", id: 2, extra: "x" });
console.log(seen.length, seen.map((e) => e.type), seen[1]["extra"]);

const s: Slots = { _version: { v: 1 } };
s.header = () => ["h"];
console.log(Object.keys(s), s._version.v, typeof s.default, s.header());
for (const k in s) {
  console.log("key", k);
}
console.log(JSON.stringify({ ...s, n: 1 }));
s.default = () => [1, 2];
console.log(s.default().length);
delete s.header;
console.log(Object.keys(s));

// A required named member keeps its declared type (checked at run time, since an index
// write may store another type); an optional one reads as the values' type.
interface Labeled {
  label: string;
  n: number;
  [key: string]: any;
}
const l: Labeled = { label: "ab", n: 2 };
console.log(l.label.toUpperCase(), l.n * 2);
l.extra = true;
console.log(Object.keys(l), { ...l }, "label" in l);
const t: string = ({ type: "t" } as EventBase).type;
console.log(t.length);

// The view is an object: `typeof`, generics, `Map` values, rest patterns and spreads keep it.
function describe(p: Labeled | string): string {
  if (typeof p === "object") {
    return "obj " + p.label;
  }
  return "str " + p;
}

function same<T>(x: T): T {
  return x;
}

const g: Labeled = same<Labeled>({ label: "y", n: 1, extra: [1] });
const byKey = new Map<string, Labeled>();
byKey.set("k", { label: "m", n: 3 });
const { label, ...others } = g;
const moved: Labeled = { ...g, label: "z" };
moved.label = "w";
console.log(describe(l), describe("s"), g.label, g.extra, byKey.get("k")?.label);
console.log(label, others, moved.label, moved);

// As a union member, the view asserts to its record (sigx's `mod as Record<string, any>`).
type Load = () => string;
interface Module {
  default: Load;
  [key: string]: any;
}

function pick(m: Load | Module): string {
  if (typeof m === "function") {
    return m();
  }
  const r = m as Record<string, any>;
  return Object.keys(r).join(",") + ":" + m.default();
}

console.log(pick(() => "f"), pick({ default: () => "d", x: 1 }));

// A required member keeps its type in compound assignments and in `r["name"]` too.
interface Counted {
  label: string;
  n: number;
  [key: string]: any;
}

function bump(r: Counted, by: number): number {
  r.n += by;
  return r.n;
}

const cnt: Counted = { label: "a", n: 1 };
cnt.label += "b";
cnt.n++;
++cnt.n;
cnt.n *= 5;
cnt["label"] += "c";
console.log(cnt.label, cnt["label"].toUpperCase(), cnt.n, cnt["n"] + 1, bump(cnt, 3));
const ev: EventBase = { type: "click", x: 1 };
console.log(ev["type"].length, ev.type.toUpperCase());
