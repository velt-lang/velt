// check: no leaks
// A narrowed module variable, field path or `r[k]` that a call cleared reads as it is wherever
// its payload is not needed, as in JavaScript (#1280): a log, a template, a test, `?.`, `??`,
// `===`, an untyped copy (`let c = x`, which keeps the narrowing and checks it where needed).
// Receivers, callees, operands, untyped elements and typed positions read the payload.
class Box {
  n: number = 1;
  next: Box | null = null;
  m(v: number): number {
    return this.n + v;
  }
}

let x: Box | null = new Box();

function clearX(): number {
  x = null;
  return 0;
}

function vars(): void {
  if (x) {
    clearX();
    console.log("log", x, `${x}`, x === null, x?.n, x ?? "none");
    if (x) {
      console.log("never");
    }
    let c = x;
    const d = x;
    console.log("copies", c, d, c?.n);
    c = new Box();
    console.log(c.n);
  }
  x = new Box();
  if (x) {
    console.log(x.m(clearX()), x);
  }
}

vars();

class O {
  f: Box | null = new Box();
}

const o = new O();

function clearF(): void {
  o.f = null;
}

let state: { next: Box | null } = { next: new Box() };

function reset(): number {
  state.next = null;
  return 0;
}

function fields(): void {
  if (o.f) {
    clearF();
    console.log("log", o.f, `${o.f}`, o.f?.n, o.f ?? "none");
  }
  if (state.next) {
    reset();
    console.log(state.next);
    console.log(state.next?.n);
    const c = state.next;
    console.log("copy", c);
  }
  state.next = new Box();
  if (state.next) {
    console.log(state.next.m(reset()));
    console.log(state.next);
  }
  const local = new O();
  if (local.f) {
    const alias = local;
    alias.f = null;
    console.log("alias", local.f);
  }
}

fields();

let r: Record<string, number[]> = {};

function zap(k: string): void {
  delete r[k];
}

function renew(): void {
  r = {};
}

function keyed(k: string): void {
  const key = k;
  if (!r[key]) {
    r[key] = [];
  }
  r[key].push(1);
  const r2 = r;
  delete r2[key];
  console.log("log", r[key]);
  r[key] = [2];
  zap(key);
  console.log("after", r[key]);
  console.log(r[key] ?? "none");
  r[key] = [3];
  renew();
  console.log("renewed", r[key], r[key]?.length);
}

keyed("a");

let n: number | null = 3;
let xs: number[] | null = [1, 2];

function sum(...v: number[]): number {
  return v.reduce((a, b) => a + b, 0);
}

function operands(): void {
  if (n !== null) {
    console.log(n + 1, n * 2, n > 2, -n);
  }
  if (n !== null && n > 2) {
    console.log("big");
  }
  if (xs) {
    console.log(sum(...xs), [...xs, 3].length);
  }
}

operands();

// Expected types that take the value as it is, string `+`, and `typeof`-narrowed fields.
function pn(v: Box | null | undefined): string {
  return String(v);
}

function ps(v: Box | string | null): string {
  return String(v);
}

function wide(): Box | null | undefined {
  if (x) {
    clearX();
    return x;
  }
  return undefined;
}

let sv: string | null = "a";
let acc = "";

function clearS(): void {
  sv = null;
}

let st: { v: string | number; w: string | null } = { v: "s", w: "w" };

function toNum(): void {
  st.v = 5;
  st.w = null;
}

function pv(q: string | number): string {
  return String(q);
}

function wider(): void {
  x = new Box();
  if (x) {
    clearX();
    console.log(pn(x), ps(x), JSON.stringify(x));
    let y: Box | null | undefined = undefined;
    y = x;
    const list: (Box | null | undefined)[] = [];
    list.push(x);
    const m = new Map<string, Box | null | undefined>();
    m.set("k", x);
    console.log(y, list, m.get("k"));
  }
  console.log(wide());
  if (sv) {
    clearS();
    acc += sv;
    console.log(acc, sv + "x", "a" + sv);
  }
  if (typeof st.v === "string" && st.w) {
    toNum();
    const c = st.v;
    console.log(st.v, `${st.v}`, c, pv(st.v), st.v === "a", st.w + "x");
  }
}

wider();

// A nullable supertype takes the value as it is; concatenations with a string convert it; copies
// of `typeof`-narrowed fields keep the member; copies of copies; a clear across `await`.
class Base2 {
  n = 1;
}

class Sub2 extends Base2 {
  m = 2;
}

let sub: Sub2 | null = new Sub2();
let s2: string | null = "s";
const st2: { v: string | number; a: number[] | string; w: string | null } = {
  v: "a",
  a: [1],
  w: "w",
};

function clear2(): void {
  sub = null;
  s2 = null;
  st2.v = 5;
  st2.w = null;
}

function pb(v: Base2 | null): string {
  return v === null ? "null" : "base";
}

function members(): void {
  if (typeof st2.v === "string" && typeof st2.a !== "string") {
    const c = st2.v;
    const arr = st2.a;
    const xs = arr;
    const up = (): string => c.toUpperCase();
    xs.push(2);
    console.log(c.length, up(), arr.length, st2.a);
  }
}

members();

async function tick(): Promise<void> {}

async function later(): Promise<void> {
  if (sub && s2 && typeof st2.v === "string" && st2.w) {
    const c = sub;
    const d = c;
    const e = st2.v;
    await tick();
    clear2();
    console.log(pb(sub), c.m, d.m, e, typeof st2.v);
    let acc = "";
    acc += st2.v;
    acc += s2;
    acc = acc + st2.w + s2;
    console.log(acc, "L:" + s2 + "/" + st2.v, `${s2}${st2.w}`);
    const f = st2.v;
    const g = f;
    console.log(f, g, typeof g);
  }
}

later().then(() => console.log("done"));

// Untyped arrays and objects of cleared values: the first element does not type the others.
let s3: string | null = "s";
const st3: { v: string | number; w: string | null } = { v: "a", w: "w" };

function clear3(): void {
  s3 = null;
  st3.v = 5;
  st3.w = null;
}

function mixed(): void {
  if (s3 && typeof st3.v === "string" && st3.w) {
    clear3();
    console.log([st3.v], [st3.v, s3], [s3, st3.v], [s3, st3.w, st3.v]);
    console.log({ a: st3.v, b: s3 }, { v: st3.v });
  }
}

mixed();

// A generic call infers its type argument from a cleared module variable as it is.
let gx: Box | null = new Box();

function clearG(): void {
  gx = null;
}

function same<T>(v: T): T {
  return v;
}

function generic(): void {
  if (gx) {
    clearG();
    console.log(same(gx), JSON.stringify(gx));
  }
}

generic();

// A union of subclasses where a nullable base class is expected takes the value as it is, at
// the top level too; a branch of a ternary that is a string `+` operand or a `+=` value is
// converted as it is.
class Base4 {
  n = 1;
}

class S41 extends Base4 {
  a = 1;
}

class S42 extends Base4 {
  b = 2;
}

let ux: S41 | S42 | null = new S41();
const ust: { f: S41 | S42 | null } = { f: new S42() };
let ur: Record<string, S41 | S42> = { k: new S41() };

function clr4(): void {
  ux = null;
  ust.f = null;
  delete ur["k"];
}

function pb4(v: Base4 | null): string {
  return v === null ? "null" : "base";
}

function pbu4(v: Base4 | undefined): string {
  return String(v);
}

function pbn4(v: Base4 | null | undefined): string {
  return String(v);
}

function subclasses(): void {
  if (ux && ust.f) {
    clr4();
    console.log(pb4(ux), pb4(ust.f), pbn4(ux), pbn4(ust.f));
  }
  ux = new S42();
  ur["k"] = new S42();
  const k = "k";
  if (ur[k]) {
    clr4();
    console.log(pbu4(ur[k]), pbn4(ur[k]));
  }
  ux = new S42();
  if (ux) {
    const c = ux;
    clr4();
    console.log(pb4(c), c.n);
  }
}

subclasses();
ux = new S41();
ust.f = new S41();
ur["k"] = new S41();
if (ux) {
  clr4();
  console.log("top", pb4(ux));
}
ust.f = new S41();
if (ust.f) {
  clr4();
  console.log("top", pb4(ust.f));
}
ur["k"] = new S41();
const kk = "k";
if (ur[kk]) {
  clr4();
  console.log("top", pbu4(ur[kk]));
}
let ts: string | null = "s";
const tst: { w: string | null } = { w: "w" };

function clrT(): void {
  ts = null;
  tst.w = null;
}

function ternaries(c: boolean): void {
  if (ts && tst.w) {
    clrT();
    let acc = "";
    acc += c ? ts : "z";
    acc += c ? (c ? tst.w : "q") : "z";
    console.log(acc, "a" + (c ? ts : "z"), "c" + (c ? tst.w : "z"), (c ? ts : "z") + "!");
    console.log("d" + (ts || "y"), (ts ?? "n") + "e", `${c ? ts : "z"}`);
  }
}

ternaries(true);
ts = "s";
tst.w = "w";
ternaries(false);

// Untyped arrays hold narrowed values as they are (`[x]` is a `(Box | null)[]`), so a cleared
// value is `null` there, as in JavaScript; generic calls infer from the value as it is.
class Box8 {
  n = 1;
}

let x8: Box8 | null = new Box8();

function clr8(): void {
  x8 = null;
}

function apply8<T, R>(v: T, f: (t: T) => R): R {
  return f(v);
}

function wrap8<T>(v: T): T[] {
  return [v];
}

function run8(): void {
  if (x8) {
    clr8();
    console.log(wrap8(x8), apply8(x8, (b) => String(b)), [x8].length);
  }
}

run8();
let s38: string | null = "s";
const st38: { v: string | number; w: string | null } = { v: "a", w: "w" };

function clear38(): void {
  s38 = null;
  st38.v = 5;
  st38.w = null;
}

function mixed8(): void {
  if (s38 && typeof st38.v === "string" && st38.w) {
    clear38();
    console.log([1, st38.v]);
    console.log([true, st38.w]);
    console.log([1, s38]);
  }
}

mixed8();

class Box9 {
  n = 1;
  next: Box9 | null = null;
}

let x9: Box9 | null = new Box9();
const st9: { v: string | number; b: Box9 | null } = { v: "a", b: new Box9() };

async function tick9(): Promise<void> {}

function clr9(): void {
  x9 = null;
  st9.v = 3;
  st9.b = null;
}

async function run9(): Promise<void> {
  if (x9 && typeof st9.v === "string" && st9.b) {
    const c = st9.v;
    await tick9();
    clr9();
    console.log(x9, st9.v, st9.b, c, `${c}`, x9 ?? "n", st9.b?.n);
    const arr = [c, st9.v];
    console.log(arr);
  }
}

run9().then(() => console.log("done"));
