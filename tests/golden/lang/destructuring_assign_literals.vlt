// check: no leaks
// An array pattern over an array literal (also `as const`) types the literal as a tuple, as
// TypeScript does, in declarations and destructuring assignments; the whole literal is
// evaluated before it is taken apart. Expected output: Node's.
const log: string[] = [];

function f(n: number): number {
  log.push("f" + n);
  return n;
}

function pair(): [number, string] {
  return [2, "t"];
}

function main(): void {
  let x = 0;
  let s = "";
  [x, s] = [1, "s"];
  console.log(x, s);
  [x, s] = [x + 1, s + "!"];
  console.log(x, s);
  [x, s] = pair();
  console.log(x, s);
  let o = { a: 1 };
  let xs = [1];
  [o, xs] = [{ a: 2 }, [3, 4]];
  console.log(o, xs);
  let u: number | undefined = 1;
  let t = "";
  [u, t] = [undefined, "k"];
  console.log(u, t);
  const c = [2, "y"] as const;
  const [p, q] = c;
  let b = 0;
  let w = "";
  [b, w] = c;
  [x, s] = [3, "z"] as const;
  console.log(p, q, b, w, x, s);
  const [m = f(1), n] = [undefined, f(2)];
  [x = f(3), s] = [undefined, "w" + f(4)];
  console.log(m, n, x, s, log.join());
  let [[i, j], k] = [[1, "j"], true];
  i++;
  console.log(i, j, k);
  const shared = { a: 5 };
  let y1 = { a: 0 };
  let y2 = { a: 0 };
  [y1, y2] = [shared, shared];
  y1.a = 6;
  console.log(y2.a, y1 === y2);
  [x] = [7, f(5)];
  console.log(x, log.join());
  [x, s] = [s.length, String(x)];
  console.log(x, s);
}
