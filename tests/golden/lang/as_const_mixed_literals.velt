// check: no leaks
// A mixed `[…] as const` keeps every read-only array use (length, a variable index, read
// methods, iteration, spread, a `readonly (A | B)[]`), and an array pattern taking it apart
// gives each binding its element's type. Expected output: Node's.
function run(): void {
  const c = [2, "y"] as const;
  console.log(c.length, c[0], c[1]);
  for (let i = 0; i < c.length; i++) console.log(c[i]);
  console.log(c.map((x) => String(x)), c.indexOf("y"), c.includes(2), c.join("-"), c.slice(1));
  for (const x of c) console.log(x);
  const more = [...c, 3];
  console.log(more);
  const ro: readonly (number | string)[] = c;
  console.log(ro.length);
  const [p, q] = c;
  let b = 0, t = "";
  [b, t] = c;
  console.log(p, q, b, t);
}
function main(): void {
  run();
}
