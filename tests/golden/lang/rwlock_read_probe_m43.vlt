// check: no leaks
// An RwLock read probe (#1559): prints what Node prints.
class Box {
  items: number[][] = [[1, 2], [3]];
}
function main() {
  const a = new RwLock(new Box());
  const out: number[][] = [];
  a.read((x) => {
    const c = structuredClone(x.items[0]);
    out.push(c);
    c.push(8);
  });
  console.log(JSON.stringify(out));
}
