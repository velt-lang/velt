// Compound assignment and `++`/`--` through an `f16`/`bf16` accessor (#2190): the getter's
// value read as a `number`, the operation in f64, rounded once into the setter's argument, as
// for a `Float16Array` element. As a value, the expression gives the unrounded number (postfix:
// the old one). Each line is checked against Node (`Float16Array`; bf16 against a
// round-to-nearest-even of the f64 result).

class H {
  #v: f16 = 0;
  sets = 0;
  get x(): f16 {
    return this.#v;
  }
  set x(v: f16) {
    this.sets++;
    this.#v = v;
  }
}

class B {
  #v: bf16 = 0;
  get x(): bf16 {
    return this.#v;
  }
  set x(v: bf16) {
    this.#v = v;
  }
}

// A getter of another type than the setter: the setter's type decides what is rounded.
class R {
  #v: f16 = 0;
  get x(): number {
    return this.#v;
  }
  set x(v: f16) {
    this.#v = v;
  }
}

class N {
  #raw: number = 0;
  get x(): f16 {
    return this.#raw as f16;
  }
  set x(v: number) {
    this.#raw = v;
  }
  get raw(): number {
    return this.#raw;
  }
}

type Cents = number & { readonly __unit: "cents" };

let calls = 0;

function hOf(h: H): H {
  calls++;
  return h;
}

function main() {
  const h = new H();
  h.x = 2048;
  h.x += 1.0001;
  console.log("2048 += 1.0001:", h.x);
  h.x = 1;
  h.x /= 3;
  console.log("1 /= 3:", h.x);
  h.x = 0.1;
  h.x *= 0.1;
  console.log("0.1 *= 0.1:", h.x);
  h.x = 65504;
  h.x += 16;
  console.log("65504 += 16:", h.x);
  h.x = 7.5;
  h.x |= 0;
  console.log("7.5 |= 0:", h.x);
  h.x = 5;
  h.x <<= 3;
  console.log("5 <<= 3:", h.x);
  h.x = 3;
  h.x **= 2.5;
  console.log("3 **= 2.5:", h.x);
  h.x = 2048;
  h.x++;
  console.log("2048++:", h.x);
  h.x = 0.1;
  h.x--;
  console.log("0.1--:", h.x);
  h.x = 1;
  console.log("value of (x += 0.1):", (h.x += 0.1), h.x);
  h.x = 2048;
  console.log("value of x++:", h.x++, h.x);
  h.x = 2048;
  console.log("value of ++x:", ++h.x, h.x);
  h.x = 1;
  const n: i32 = 3;
  h.x += n;
  console.log("1 += 3 (i32):", h.x);
  const g = new H();
  calls = 0;
  hOf(g).x += 1;
  hOf(g).x++;
  console.log("receiver once:", calls, g.x, g.sets);

  const b = new B();
  b.x = 1;
  b.x += 0.00390625;
  console.log("bf16 1 += 2^-8:", b.x);
  b.x = 1;
  b.x += 0.005859375;
  console.log("bf16 1 += 1.5 * 2^-8:", b.x);
  b.x = 256;
  b.x++;
  console.log("bf16 256++:", b.x);
  b.x = 1;
  console.log("bf16 value of (x /= 3):", (b.x /= 3), b.x);

  const r = new R();
  r.x = 1;
  r.x += 0.1;
  console.log("number getter, f16 setter += 0.1:", r.x);
  r.x++;
  console.log("number getter, f16 setter ++:", r.x);
  const nn = new N();
  nn.x = 1;
  nn.x += 0.1;
  console.log("f16 getter, number setter += 0.1:", nn.raw);
  const c = 5 as Cents;
  h.x = 1;
  h.x += c;
  console.log("branded number on the right:", h.x);
}
