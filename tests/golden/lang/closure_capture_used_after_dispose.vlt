// check: no leaks
// A closure capturing a variable that the function uses afterwards shares only that variable:
// its other captures still move into the closure and are released when the closure is (#262).
class Store {
  name: string;

  constructor(name: string) {
    this.name = name;
  }

  [Symbol.dispose]() {
    console.log(`${this.name} disposed`);
  }
}

class Counter {
  n: i64 = 0;
}

function keep(f: () => void): () => void {
  return f;
}

// `counter` is used after the closure is gone, `store` is not.
function usedAfterwards() {
  const store = new Store("local store");
  const counter = new Counter();
  {
    const f = keep(() => {
      counter.n += 1;
      console.log(`${store.name} seen`);
    });
    f();
    f();
    console.log("dropping the closure");
  }
  console.log(`closure gone, counter ${counter.n}`);
}

// A capture of a borrowed parameter cannot move: it is shared, the local store still moves.
function borrowedParam(counter: Counter) {
  const store = new Store("param store");
  {
    const f = keep(() => {
      counter.n += 10;
      console.log(`${store.name} seen`);
    });
    f();
    console.log("dropping the closure");
  }
  console.log(`closure gone, counter ${counter.n}`);
}

// Two closures, one nested in the other's block, share `counter`; each owns its own store.
function twoClosures() {
  const counter = new Counter();
  const a = new Store("store a");
  const b = new Store("store b");
  {
    const f = keep(() => {
      counter.n += 1;
      console.log(`${a.name} seen`);
    });
    {
      const g = keep(() => {
        counter.n += 2;
        console.log(`${b.name} seen`);
      });
      g();
      console.log("dropping g");
    }
    f();
    console.log("dropping f");
  }
  console.log(`both gone, counter ${counter.n}`);
}

// An escaping closure creating an inner escaping closure: the inner one captures one of the
// outer closure's own captures (which cannot move out of the outer closure: shared) and a store
// local to the outer closure (moved: disposed when the inner closure is).
function nestedClosures() {
  const counter = new Counter();
  const outer = keep(() => {
    const store = new Store("outer's store");
    {
      const inner = keep(() => {
        counter.n += 1;
        console.log(`${store.name} seen`);
      });
      inner();
      console.log("dropping inner");
    }
    console.log(`inner gone, counter ${counter.n}`);
  });
  outer();
  outer();
  console.log("dropping outer");
}

// One closure per iteration: each iteration's store goes with its closure.
function inLoop() {
  const counter = new Counter();
  for (let i = 0; i < 2; i++) {
    const store = new Store(`loop store ${i}`);
    const f = keep(() => {
      counter.n += 1;
      console.log(`${store.name} seen`);
    });
    f();
    console.log(`end of iteration ${i}, counter ${counter.n}`);
  }
}

function makeReporter(counter: Counter): () => void {
  const store = new Store("returned store");
  return () => {
    counter.n += 1;
    console.log(`${store.name} seen`);
  };
}

// A returned closure owns its store; the caller's counter is shared with it.
function returned() {
  const counter = new Counter();
  {
    const f = makeReporter(counter);
    f();
    console.log("dropping the returned closure");
  }
  console.log(`returned closure gone, counter ${counter.n}`);
}

class Handlers {
  list: (() => void)[] = [];
}

// Closures stored in an array field are released with the object holding them.
function inField() {
  const counter = new Counter();
  {
    const h = new Handlers();
    const a = new Store("field store a");
    const b = new Store("field store b");
    h.list.push(() => {
      counter.n += 1;
      console.log(`${a.name} seen`);
    });
    h.list.push(() => {
      counter.n += 2;
      console.log(`${b.name} seen`);
    });
    for (const f of h.list) {
      f();
    }
    console.log("dropping the handlers");
  }
  console.log(`handlers gone, counter ${counter.n}`);
}

function main() {
  usedAfterwards();
  const counter = new Counter();
  borrowedParam(counter);
  twoClosures();
  nestedClosures();
  inLoop();
  returned();
  inField();
  console.log("done");
}
