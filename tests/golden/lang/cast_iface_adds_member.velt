// An interface value asserted to an interface extending it with an optional field its object
// lacks (#379): tsc allows it, and Node adds the property when it is written. Velt gives the
// object types converted to `Ctx` room for `__name`, absent until written.
interface Ctx {
  el: string;
  update(): void;
}

interface InternalCtx extends Ctx {
  __name?: string;
}

const c = { el: "x", update: () => {} } as unknown as Ctx;
(c as InternalCtx).__name = "dbg";
console.log(c.el, (c as InternalCtx).__name);
