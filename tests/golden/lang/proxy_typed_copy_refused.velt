// A conversion the program could tell from a copy (a later write), in a program that creates
// proxies, keeps the one object, here from `JSON.parse`, as in Node.
type Sig = { a: number; b: number };
type A = { a: number };
const p = new Proxy({ x: 1 }, {});
console.log(p.x);
const s = JSON.parse('{"a":1,"b":2}') as Sig;
const v: A = s;
v.a = 5;
console.log(s.a);
