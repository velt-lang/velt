// check: no leaks
// Construct signatures written in several places: values pass between two written
// `new (n: number) => A` types (also in a `Promise`, an array and with `throws`), and so do
// readonly object types holding a function type, keeping the object; `typeof` of a class value
// and of a function with properties held as `unknown` is "function"; an optional parameter of
// a signature (or of a function type) may be left out, also for a constructor parameter with a
// default; generic classes, overloads, callbacks and `Object.freeze`. Node prints the same
// (without the `throws` clause).
class A {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}
class Box<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
}
class O {
  a: number | undefined;
  constructor(a?: number) {
    this.a = a;
  }
}
class P {
  a: number;
  constructor(a: number = 7) {
    this.a = a;
  }
}
interface Runner {
  (): number;
  stop: number;
}
type Ctor = new (n: number) => A;

const a: new (n: number) => A = A;
const b: new (n: number) => A = a;
const c: new (n: number) => A throws Error = a;
const xs: (new (n: number) => A)[] = [a];
console.log(new b(2).n, new c(3).n, a === b, xs[0] === A);
async function run(): Promise<void> {
  const p: Promise<new (n: number) => A> = Promise.resolve(a);
  const C = await p;
  const X = xs[0];
  console.log(new C(3).n, new X(4).n, C === X);
}

// Readonly object types with a function type written twice: one object.
const ox: { readonly f: (n: number) => A; readonly g: string } = { f: (n: number) => new A(n), g: "a" };
const oy: { readonly f: (n: number) => A; readonly g: string } = ox;
console.log(oy.f(2).n, ox === oy);

// `typeof` held as `unknown`.
const k: new () => O = O;
const u: unknown = k;
const r = Object.assign(() => 1, { stop: 2 }) as Runner;
const ur: unknown = r;
console.log(typeof u, typeof (k as unknown), typeof k, typeof ur, typeof r);

// Optional parameters.
const CO: new (a?: number) => O = O;
const CP: new (a?: number) => P = P;
console.log(new CO().a, new CP().a, new CP(3).a, new CO(4).a);
function g(f: (a?: number) => string): string {
  return f() + f(1);
}
console.log(g((a?: number) => `${a}`));

// Generic classes.
const bn: new (v: number) => Box<number> = Box;
const bs: new (v: string) => Box<string> = Box;
console.log(new bn(1).v, new bs("x").v, bn.name, bs.name);
function boxer<T>(): new (v: T) => Box<T> {
  return Box;
}
const b2 = boxer<number>();
console.log(new b2(5).v);

// Overloads, callbacks, `Object.freeze`.
function reg(c: Ctor): string;
function reg(c: string): string;
function reg(c: Ctor | string): string {
  return typeof c === "string" ? c : c.name;
}
console.log(reg(A), reg("s"));
const list: Ctor[] = [];
list.push(A);
[1, 2].forEach(() => list.push(A));
console.log(list.length, list.every((c) => c === A));
const frozen = Object.freeze({ k: A as Ctor });
console.log(frozen.k === A);
const many = [1, 2, 3].map((n): Ctor => A);
console.log(many.every((c) => c === A), many.length);
run();
