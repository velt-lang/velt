// A module constant taken over by reference (#1383) is the one object Node evaluates once, kept in
// the module state: through a namespace import (`m.CONFIG`), `K!`, a part of it (`K.inner`, also
// returned), a function value that modifies it, or compared by a part (`K.inner === x`), or the
// target of `Object.assign`. A module `let` or a constant already in the module state taken over
// through a namespace import refers to it too.
import * as m from "./_module_const_by_reference_lib";

type Inner = { v: number };

const K = { inner: { v: 1 } as Inner, n: 0 };
const OBJ = { n: 1 };
const TARGET = { n: 0, m: 0 };
const BOUND = { n: 0, m: 0 };
const PARTS = { inner: { v: 1 } as Inner };

function part(): Inner {
  return K.inner;
}

function isPart(x: Inner): boolean {
  return x === PARTS.inner;
}

function main() {
  const c = m.CONFIG;
  c.retries = 5;
  c.tags.push("b");
  const k = K!;
  k.n = 3;
  const a = K.inner;
  a.v = 7;
  const p = part();
  p.v += 1;
  const fs = [(o: { n: number }) => {
    o.n = 9;
  }];
  fs[0](OBJ);
  console.log(m.CONFIG.retries, m.CONFIG.tags, K.n, K.inner.v, OBJ.n);
  console.log(PARTS.inner === PARTS.inner, isPart(PARTS.inner), isPart({ v: 1 }));
  const counter = m.COUNTER;
  counter.n = 5;
  const made = m.MADE;
  made.n = 6;
  console.log(m.COUNTER.n, m.MADE.n);
  Object.assign(TARGET, { n: 1 });
  const bound = Object.assign(BOUND, { m: 2 });
  bound.n = 3;
  console.log(TARGET.n, BOUND.n, BOUND.m, bound === BOUND);
}
