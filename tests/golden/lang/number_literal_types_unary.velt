// check: no leaks
// Unary `-`, `+` and `~` on an integer literal type or a union of them (#3784): the operand is
// the `number` it is in TypeScript, so `-n` of 0 is `-0`, `-n / 2` divides numbers and `~n` is
// JavaScript's 32-bit not. A float literal type (`0.5 | 1.5`) and a sized integer one
// (`3i32 | -4i32`) take the operators as their base type. The Node twin prints the same.

type Bit = 0 | 1;
type Sign = -1 | 0 | 1;

function half(x: number): number {
  return x / 2;
}

function kind(x: string | number): string {
  return typeof x;
}

function negate(n: Bit): number {
  return -n;
}

class Flag {
  bit: Bit = 1;
  flip(): number {
    return ~this.bit;
  }
}

function run() {
  const bits: Bit[] = [0, 1];
  for (const n of bits) {
    console.log(-n, +n, Object.is(-n, -0), -n / 2);
    console.log(~n, ~n / 2);
    const neg: number = -n;
    const pos: number = +n;
    const not: number = ~n;
    console.log("typed", neg + 0.5, pos + 0.5, not + 0.5);
    console.log("nested", -(-n), ~~n, -~n, ~-n, +-n, -(+n) / 4);
    console.log("call", half(-n), half(+n), half(~n), kind(-n), negate(n));
    console.log("text", `${-n} ${+n} ${~n}`, typeof -n, typeof +n, typeof ~n);
    console.log("mixed", -n + n, -n * 3, 2 ** -n, 1 / -n, ~n & 6, ~n >>> 28);
    if (n === 0) {
      console.log("narrowed", Object.is(-n, -0), ~n);
    } else {
      console.log("narrowed", -n, ~n);
    }
  }
  const signs: Sign[] = [-1, 0, 1];
  for (const s of signs) {
    console.log("sign", -s, +s, ~s, Object.is(-s, -0), -s / 2);
  }
  const five: 5 = 5;
  console.log("single", -five, +five, ~five, -five / 2, half(-five));
  const flag = new Flag();
  console.log("field", -flag.bit, +flag.bit, ~flag.bit, flag.flip(), -flag.bit / 2);
  const maybe: Bit | null = bits[1];
  if (maybe !== null) {
    console.log("option", -maybe, ~maybe, +maybe / 2);
  }
}

function floats(h: 0.5 | 1.5, w: 2.5) {
  console.log("float", -h, +h, ~h, -h * 2, typeof -h);
  console.log("float single", -w, +w / 2, ~w);
}

function sized(i: 3i32 | -4i32, b: 1u8 | 2u8) {
  console.log("sized", -i, +i, ~i, +b);
}

run();
floats(0.5, 2.5);
floats(1.5, 2.5);
sized(3i32, 1u8);
sized(-4i32, 2u8);
