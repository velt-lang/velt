// check: no leaks
// `splice` on the caller's array in a `read` callback, when the program also keeps a `T[]` in a
// `Map` (its `T[]` result is then a counted object): the elements it removes are the caller's
// and are freed once, with and without new elements, also from a nested `read`.
class Box {
  items: number[][] = [[1, 2], [3]];
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const groups = new Map<string, number[][][]>();
  groups.set("z", [[[0]]]);
  const out: number[][][] = [[[1]], [[2]], [[3]], [[4]], [[5]], [[6]], [[7]]];
  a.read((x) => {
    console.log("splice", out.splice(1, 2));
    console.log("splice in", out.splice(0, 1, x.items.slice()));
    const all = out.splice(3);
    console.log("rest", all.length, all);
    b.read((y) => {
      console.log("nested", out.splice(0, 1));
      console.log("nested in", out.splice(1, 1, y.items.map((e) => e), [[8]]));
    });
  });
  console.log(out.length, out, groups.size);
  a.read((x) => {
    const g = groups.get("z")!;
    console.log("group", g.length);
    out.splice(0, out.length);
  });
  console.log(out.length);
}
