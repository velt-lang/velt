// Timers due together, however late the task gets to run, resume in timer order, whoever polls
// them: `Promise.all` polls its promises in array order, and the shorter timer comes second in the
// array. The shorter one is created first, so a stall of the process cannot change which is due
// first. And a root that yields waits for the task's next poll, however it was resumed, while a
// root that only started a promise that yields does not.
function busy(ms: f64) {
  const end = performance.now() + ms;
  while (performance.now() < end) {}
}

function timeout(ms: i64): Promise<void> {
  return new Promise<void>((resolve) => {
    setTimeout(async () => resolve(), ms);
  });
}

async function step(name: string, ms: i64): Promise<string> {
  await sleep(ms);
  console.log(`${name} after sleep(${ms})`);
  return name;
}

// Polled by its task with its own waker: nothing awaits it directly.
async function inner(done: () => void) {
  await sleep(0);
  const d = step("d", 0);
  const c = step("c", 30);
  busy(60);
  console.log(await Promise.all([c, d]));
  done();
}

async function other() {
  await yieldNow();
  console.log("other after yieldNow");
}

async function started() {
  console.log("started");
  await yieldNow();
  console.log("started after yieldNow");
}

async function later(ms: i64) {
  await sleep(ms);
  console.log("later");
}

async function ticker(n: i64) {
  for (let i = 0; i < n; i++) {
    await Promise.resolve();
    console.log(`ticker ${i}`);
  }
}

async function yields() {
  await yieldNow();
  console.log("yields 1");
  await yieldNow();
  console.log("yields 2");
}

async function withMicrotask(): Promise<string> {
  await sleep(0);
  queueMicrotask(() => console.log("microtask of the first"));
  console.log("first");
  await Promise.resolve();
  console.log("first, one step on");
  await Promise.resolve();
  console.log("first, two steps on");
  return "first";
}

async function withYield(): Promise<string> {
  await sleep(0);
  console.log("first");
  await yieldNow();
  console.log("first after yieldNow");
  return "first";
}

async function waits(p: Promise<string>, name: string): Promise<string> {
  const v = await p;
  console.log(name);
  return v;
}

// Started, so its timer is in the queue from here on. It prints nothing: `main` says when it ended,
// so a stall of the process cannot change the order.
async function laterTimer(ms: i64) {
  await sleep(ms);
}

async function main() {
  console.log("Promise.all in main");
  const b = step("b", 0);
  const a = step("a", 30);
  busy(60);
  console.log(await Promise.all([a, b]));

  console.log("Promise.all in a promise");
  await new Promise<void>((resolve) => {
    const running = inner(() => resolve());
  });

  console.log("three, with another waiter between them");
  const g = step("g", 0);
  const h = step("h", 1);
  const f = step("f", 2);
  const e = step("e", 30);
  busy(60);
  console.log(await Promise.all([e, f, g]));
  await h;

  console.log("Promise.race");
  const j = step("j", 0);
  const i = step("i", 30);
  busy(60);
  console.log(await Promise.race([i, j]));
  await sleep(1);

  console.log("yieldNow after a timer");
  await timeout(1);
  const o = other();
  await yieldNow();
  console.log("main after yieldNow");
  await o;

  console.log("a promise settled beside a started one that yields");
  let open: () => void = () => {};
  const opened = new Promise<void>((r) => {
    open = r;
  });
  const s1 = started();
  open();
  await opened;
  console.log("main after settled");
  await s1;

  console.log("a timer resumes the root beside a started one that yields");
  const l = later(150);
  const t = sleep(0);
  busy(200);
  await t;
  const s2 = started();
  await l;
  console.log("main after later");
  await s2;

  console.log("a resolved promise beside a started one that yields");
  const y = yields();
  await yieldNow();
  await Promise.resolve();
  await yieldNow();
  const k = ticker(2);
  await Promise.resolve();
  console.log("main after a resolved promise");
  await k;
  await y;

  console.log("timers in timer order, a microtask after the first");
  const m1 = withMicrotask();
  const m2 = step("second", 30);
  const m3 = step("third", 60);
  busy(90);
  console.log(await Promise.all([m1, m2, m3]));

  console.log("timers in timer order, the first yields");
  const y1 = withYield();
  const y2 = step("second", 30);
  busy(60);
  console.log(await Promise.all([y1, y2]));

  console.log("a timer does not pass what a microtask job made ready");
  let openGate: () => void = () => {};
  const gate = new Promise<void>((r) => {
    openGate = r;
  });
  const e0 = (async (): Promise<string> => {
    await gate;
    console.log("e0");
    await Promise.resolve();
    console.log("e0, one step on");
    return "e0";
  })();
  const e1 = waits(e0, "waits for e0");
  const e2 = (async (): Promise<string> => {
    await sleep(0);
    console.log("e2");
    openGate();
    return "e2";
  })();
  const e3 = step("e3", 1);
  busy(5);
  console.log(await Promise.all([e2, e3, e1]));

  // Firing stops at a held timer and arms nothing; only the end of the poll can arm the later one,
  // and without that an inline join (this one, and the one in a promise below) never ends. A stored
  // join's leaves have different wakers, so nothing is held there: those two only have to finish.
  console.log("an inline join over due timers, then only a later timer");
  const l0 = laterTimer(40);
  await Promise.all([sleep(0), sleep(0)]);
  console.log("joined");
  await l0;
  console.log("later");

  console.log("a join over due timers, then only a later timer");
  const l1 = laterTimer(40);
  const j1 = Promise.all([sleep(0), sleep(1)]);
  busy(5);
  await j1;
  console.log("joined");
  await l1;
  console.log("later");

  console.log("the same, reversed");
  const l2 = laterTimer(40);
  const j2 = Promise.all([sleep(1), sleep(0)]);
  busy(5);
  await j2;
  console.log("joined");
  await l2;
  console.log("later");

  console.log("the same, the join in a promise");
  const l3 = laterTimer(40);
  const j3 = (async () => {
    await Promise.all([sleep(0), sleep(1)]);
    console.log("joined in a promise");
  })();
  busy(5);
  await j3;
  await l3;
  console.log("later");

  // Polled in turn after the due ones, with nothing unseen: it still waits for its deadline.
  console.log("a timer not due yet, polled after the due ones");
  const before = performance.now();
  await Promise.all([sleep(0), sleep(0), sleep(100)]);
  console.log(performance.now() - before >= 90);
}
