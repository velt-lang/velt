// check: no leaks
// An integer literal type, or a union of them, is a `number` where one is expected (#3747), as
// in TypeScript and Node: a value of type `5` or `0 | 1` (an `i64` underneath) converts to
// `number` alone, in a union holding `number` and in a `number | null`, through `||`, `??` and
// `?:`, as an argument, a return value, an array element and in a compound assignment.

type Bit = 0 | 1;
type Named = { name: string };

function half(x: number): number {
  return x / 2;
}

function kind(x: string | number): string {
  return typeof x;
}

function describe(x: Named | number | null): string {
  if (x === null) {
    return "null";
  }
  return typeof x === "number" ? `number ${x}` : `named ${x.name}`;
}

function asNumber(n: Bit): number {
  return n;
}

function pick(n: 0 | 1 | 2, d: number): number {
  const a: number = n || d;
  const b: number = n ? n : d;
  return a * 10 + b;
}

function fallback(n: 0 | 1 | null, d: number): number {
  return n ?? d;
}

function run() {
  const bits: Bit[] = [0, 1, 1];
  for (const n of bits) {
    let x: number = n;
    x += 0.5;
    console.log("assign", x, "arg", half(n), "return", asNumber(n));
    console.log("union arg", kind(n), "wide", describe(n));
    const xs: number[] = [n, n + 1];
    console.log("array", xs.length, xs[0] / 4);
  }
  for (const n of [0, 1, 2] as (0 | 1 | 2)[]) {
    console.log("pick", n, pick(n, 7));
  }
  console.log("fallback", fallback(null, 3.5), fallback(1, 3.5), fallback(0, 3.5));
  const five: 5 = 5;
  console.log("single", Number.isSafeInteger(five), half(five));
  const named: Named | Bit = { name: "n" };
  console.log("named", describe(named));
}

// Compound assignment to a `number` place: a local and a class field.
class Acc {
  total = 0.5;
}

function compound(): void {
  const bits: Bit[] = [0, 1, 1];
  let x = 0.25;
  const acc = new Acc();
  for (const n of bits) {
    x += n;
    x -= n / 2;
    x *= n + 1;
    acc.total += n;
  }
  const five: 5 = 5;
  let y = 1;
  y += five;
  console.log("compound", x, acc.total, y);
}

run();
compound();
