// requires: unix
// `xs.subarray(begin, end)` of a `u8[]` passed as a C function's buffer names the array `xs`
// holds when the argument is evaluated, before its positions and the later arguments (JS order),
// whatever the rest of the program does with the array: one that gives the variable another
// array leaves the call at the first one, which the call keeps alive. Its data pointer is read
// at the call, after every argument, so one that grows that array (which moves its bytes) cannot
// leave the call reading or writing freed memory. A whole `u8[]` names its array the same way.
import { CVarArgs } from "velt/ffi";

declare c("c") function open(path: readonly u8[], oflag: i32, ...args: CVarArgs): i32;
declare c("c") function pread(fd: i32, buf: u8[], nbyte: usize, offset: i64): isize;
declare c("c") function write(fd: i32, buf: readonly u8[], nbyte: usize): isize;

let g: u8[] = Buffer.alloc(1);

function filled(n: usize, v: u8): u8[] {
  const xs: u8[] = Buffer.alloc(n);
  for (let i = 0; i < n; i++) {
    xs[i] = v;
  }
  return xs;
}

function replace(n: i64): i64 {
  g = filled(1, 66);
  return n;
}

function replaceEmpty(n: i64): i64 {
  g = Buffer.alloc(1);
  return n;
}

function grow(): i64 {
  for (let i = 0; i < 100000; i++) {
    g.push(7);
  }
  return 0;
}

async function later(): Promise<i64> {
  g = filled(1, 66);
  return 0;
}

function newline() {
  const nl: u8[] = [10];
  // SAFETY: one byte, the array's.
  unsafe {
    write(1, nl, 1);
  }
}

async function main() {
  // The read side: the bytes written are those of the array `g` held before the end position
  // replaced it (raw writes come first, as `console.log` may buffer its output). Each length is
  // that of the bytes the first array has there.
  g = filled(8, 65);
  // SAFETY: the length is that of the bytes the array the argument names has
  // in the range; the descriptors are open (1) or /dev/zero's.
  const w = unsafe { write(1, g.subarray(0, replace(8)), 8) };
  newline();
  g = filled(8, 67);
  // SAFETY: as above.
  const w2 = unsafe { write(1, g.subarray(0, replaceEmpty(8)), 8) };
  newline();
  g = filled(4, 69);
  // SAFETY: as above.
  const w4 = unsafe { write(1, g.subarray(replace(-2)), 2) };
  newline();

  const name: u8[] = [47, 100, 101, 118, 47, 122, 101, 114, 111, 0]; // /dev/zero
  // SAFETY: as above.
  const fd = unsafe { open(name, 0) };
  console.log("write", w, w2, w4, g.length);
  // A later argument replaces the module variable: the call writes the first array.
  g = filled(4096, 1);
  // SAFETY: as above.
  console.log("replace", unsafe { pread(fd, g.subarray(0, 4096), 4096, replace(0)) }, g.length);
  g = filled(4096, 1);
  // SAFETY: as above.
  console.log("await", unsafe { pread(fd, g.subarray(0, 4096), 4096, await later()) }, g.length);
  g = filled(4096, 1);
  // SAFETY: as above.
  console.log("whole", unsafe { pread(fd, g, 4096, replace(0)) }, g.length);
  // A later argument grows the array: the call writes the grown array's bytes.
  g = filled(16, 9);
  // SAFETY: as above.
  const n = unsafe { pread(fd, g.subarray(0, 16), 16, grow()) };
  console.log("grow", n, g[0], g[15], g[16], g.length);
  // A position replaces or grows it.
  g = filled(4096, 1);
  // SAFETY: as above.
  const r = unsafe { pread(fd, g.subarray(replace(0), 4096), 4096, 0) };
  console.log("position replace", r, g.length);
  g = filled(16, 9);
  // SAFETY: as above.
  const p = unsafe { pread(fd, g.subarray(grow(), 16), 16, 0) };
  console.log("position grow", p, g[0], g[16], g.length);
  // A closure reassigning a local.
  let xs: u8[] = filled(64, 1);
  const swapLocal = (): i64 => {
    xs = filled(1, 66);
    return 0;
  };
  // SAFETY: as above.
  console.log("closure", unsafe { pread(fd, xs.subarray(0, 64), 64, swapLocal()) }, xs.length);
}
