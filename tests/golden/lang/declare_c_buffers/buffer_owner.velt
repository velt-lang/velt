// requires: unix
// A C function's buffer stays alive and in place for the whole call: a later argument that
// replaces the module variable holding it cannot leave the call writing freed memory, and a
// module constant's bytes are written in place, not into a copy.
import { CVarArgs } from "velt/ffi";

declare c("c") function open(path: readonly u8[], oflag: i32, ...args: CVarArgs): i32;
declare c("c") function pread(fd: i32, buf: u8[], nbyte: usize, offset: i64): isize;

let g: u8[] = Buffer.alloc(4096);

function swap(): i64 {
  g = Buffer.alloc(1);
  return 0;
}

const BUF: u8[] = [1, 2, 3, 4];

function main() {
  const name: u8[] = [47, 100, 101, 118, 47, 122, 101, 114, 111, 0]; // /dev/zero
  // SAFETY: a NUL-terminated path; the length is that of the array the
  // argument names (the first `g`, 4096 bytes), or of the range.
  const fd = unsafe { open(name, 0) };
  // SAFETY: as above.
  const n = unsafe { pread(fd, g, 4096, swap()) };
  console.log(n, g.length);
  // SAFETY: as above.
  console.log(unsafe { pread(fd, BUF.subarray(1, 3), 2, 0) }, BUF.join(","));
  // SAFETY: as above.
  console.log(unsafe { pread(fd, BUF, 4, 0) }, BUF.join(","));
}
