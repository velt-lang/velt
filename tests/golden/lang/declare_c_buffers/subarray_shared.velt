// requires: unix
// `subarray_owner` in a program that also shares the array (`const keep = g`), with a module
// variable never assigned before the calls: each call still names the array the variable held
// when its argument was evaluated (JS order), not the one a later argument stored.
import { CVarArgs } from "velt/ffi";

declare c("c") function open(path: readonly u8[], oflag: i32, ...args: CVarArgs): i32;
declare c("c") function pread(fd: i32, buf: u8[], nbyte: usize, offset: i64): isize;
declare c("c") function write(fd: i32, buf: readonly u8[], nbyte: usize): isize;

const ZERO: u8[] = [47, 100, 101, 118, 47, 122, 101, 114, 111, 0]; // /dev/zero
let g: u8[] = filled(8, 97);

function filled(n: usize, v: u8): u8[] {
  const xs: u8[] = Buffer.alloc(n);
  for (let i = 0; i < n; i++) {
    xs[i] = v;
  }
  return xs;
}

function swap(): i64 {
  g = filled(1, 122);
  return 8;
}

function main() {
  const nl: u8[] = [10];
  // SAFETY: the length is that of the bytes the array the argument names has
  // in the range; the descriptors are open (1) or /dev/zero's.
  const fd = unsafe { open(ZERO, 0) };
  // SAFETY: as above.
  const a = unsafe { write(1, g.subarray(0, swap()), 8) };
  // SAFETY: as above.
  unsafe {
    write(1, nl, 1);
  }
  g = filled(8, 65);
  // SAFETY: as above.
  const b = unsafe { write(1, g.subarray(0, swap()), 8) };
  // SAFETY: as above.
  unsafe {
    write(1, nl, 1);
  }
  console.log("A", a, "B", b);
  g = Buffer.alloc(8);
  // SAFETY: as above.
  console.log("C", unsafe { pread(fd, g.subarray(0, 8), 8, swap()) }, g.length);
  const keep = g;
  // SAFETY: as above.
  console.log("D", unsafe { pread(fd, keep.subarray(0, 8), 1, swap()) }, keep.length);
}
