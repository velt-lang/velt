// requires: unix
// A view a program forges by overriding `[RECORD_SIZE]()` or with a constructor of its own cannot
// make a C function read or write outside the buffer: lowering checks the byte range against the
// buffer's own length without the wrapping addition a huge offset or length would exploit, so the
// call stops the program instead of corrupting memory. `ArrayBufferView` (a global type) is the
// class of every view.
import { CVarArgs } from "velt/ffi";

declare c("c") function open(path: readonly u8[], oflag: i32, ...args: CVarArgs): i32;
declare c("c") function pread(fd: i32, buf: u8[], nbyte: usize, offset: i64): isize;

class Evil extends ArrayBufferView {
  constructor(b: ArrayBuffer) {
    // A byte offset that wraps past the end of a 64-bit address.
    const off: usize = 0 - (16 as usize);
    super(b, off, 18);
  }
}

function main() {
  const name: u8[] = [47, 100, 101, 118, 47, 122, 101, 114, 111, 0]; // /dev/zero
  // SAFETY: a NUL-terminated path.
  const fd = unsafe { open(name, 0) };
  const victim: u8[] = Buffer.alloc(64);
  victim.fill(9);
  const e = new Evil(new ArrayBuffer(4));
  // SAFETY: none: the view lies about its bytes, and the call must stop before C runs.
  console.log(unsafe { pread(fd, e, 18, 0) });
}
