// An `as` assertion of a union as one of its members is checked (#893): the value must be that
// member, where Node goes on with the other one (and here would print `undefined`).
interface Ctx {
  name: string;
}

interface Options {
  label: string;
}

function nameOf(o: Ctx | Options): string {
  return (o as Ctx).name;
}

function main() {
  console.log(nameOf({ name: "ok" }));
  console.log(nameOf({ label: "options" }));
}
