// An `as` assertion of a union as one of its members, used as a value, is checked (#893): the
// value must be that member, where Node goes on with the other one (and here would print
// `undefined`). A field read of the assertion itself, `(o as Ctx).name`, reads as in Node
// instead (cast_member_read.vlt).
interface Ctx {
  name: string;
}

interface Options {
  label: string;
}

function nameOf(o: Ctx | Options): string {
  const c = o as Ctx;
  return c.name;
}

function main() {
  console.log(nameOf({ name: "ok" }));
  console.log(nameOf({ label: "options" }));
}
