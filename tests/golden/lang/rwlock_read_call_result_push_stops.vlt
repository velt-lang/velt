// A reader pushing into a plain array of a store object reached through a call (`Map.get`)
// changes what other readers read: it stops the program, as an index or field write does.
class Item {
  v: i64 = 0;
  nums: i64[] = [0];
  kids: Item[] = [];
  constructor(v: i64) {
    this.v = v;
  }
}

class St {
  items: Item[] = [new Item(1), new Item(2)];
  m: Map<string, Item> = new Map<string, Item>();
}

function main() {
  const st = new St();
  st.m.set("a", st.items[1]);
  const rw = shared(new RwLock<St>(st));
  const n = rw.read((s) => {
    s.m.get("a")!.nums.push(1);
    return s.items[1].nums.length;
  });
  console.log(n);
}
