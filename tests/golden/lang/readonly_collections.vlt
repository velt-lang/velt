// TypeScript's `ReadonlySet<T>` and `ReadonlyMap<K, V>`: a `Set` or `Map` read through a
// variable, parameter or return type that may not change it.
const handled: ReadonlySet<string> = new Set(["server"]);
const none: ReadonlySet<string> = new Set();
console.log(handled.has("server"), handled.has("x"), none.size, [...handled]);

function unknownKeys(opts: string[], core: ReadonlySet<string>): string[] {
  const out: string[] = [];
  for (const k of opts) {
    if (!core.has(k)) {
      out.push(k);
    }
  }
  core.forEach((v) => out.push("core:" + v));
  return out;
}

console.log(unknownKeys(["server", "lazy"], handled));

interface Ctx {
  boundaries(): ReadonlyMap<number, string>;
}

function makeCtx(): Ctx {
  const boundaries = new Map<number, string>();
  boundaries.set(2, "b");
  boundaries.set(1, "a");
  return {
    boundaries(): ReadonlyMap<number, string> {
      return boundaries;
    },
  };
}

const b = makeCtx().boundaries();
console.log(b.size, b.get(1), b.has(3), [...b.keys()], [...b.values()]);
for (const [id, rec] of b) {
  console.log(id, rec);
}
const copy = new Map(b);
copy.set(3, "c");
console.log(copy.size, b.size, b);
const maybe: ReadonlySet<number> | null = Math.random() > 2 ? null : new Set([1, 2]);
console.log(maybe?.has(2), maybe);
