// Several declarators in one declaration, a later initializer holding a block with its own
// declarations (expected output from `node`).
function run() {
  const b = 100;
  {
    const a = 1;
    const b = 2;
    const c = () => {
      const p = 10;
      const q = 20;
      return p + q;
    };
    console.log(a, b, c());
  }
  console.log(b);
}

run();
let x = 1;
let f = (n: number) => {
  let y = n;
  let z = n * 2;
  return y + z;
};
let w = f(x);
console.log(x, w);
