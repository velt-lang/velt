function prefix23(h0: i64, a: i64, b: u64, c: i32): i64 {
  let h = h0;
  h = hash(h, `abcdefghijklmnopqrstuvw${a}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${a}z`);
  h = hash(h, `éabcdefghijklmnopqrstu${a}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${b}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${b}z`);
  h = hash(h, `éabcdefghijklmnopqrstu${b}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${c}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${c}z`);
  h = hash(h, `éabcdefghijklmnopqrstu${c}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${c}${c}`);
  h = hash(h, `abcdefghijklmnopqrstuvw${c}-${a}`);
