// Integers in templates after literal prefixes of 0 to 23 bytes, ASCII and with a non-ASCII
// letter (#1982): short templates build an inline string, and an integer of up to 8 bytes is
// stored into it as one word, at the byte where its text ends. Every width and sign of i64, u64
// and i32, alone, before a suffix and after another number. Each prefix length prints its number
// and a hash of the strings it built. The expected output was printed by the runtime's formatter
// (itoa, before #1982), against which the Velt one must agree byte for byte.

function hash(h: i64, s: string): i64 {
  let x = (h * 31 + s.length) % 1000000007;
  for (let i = 0; i < s.length; i++) {
    x = (x * 131 + s.charCodeAt(i)) % 1000000007;
  }
  return x;
}

function prefix0(h0: i64, a: i64, b: u64, c: i32): i64 {
  let h = h0;
  h = hash(h, `${a}`);
  h = hash(h, `${a}z`);
  h = hash(h, `${b}`);
  h = hash(h, `${b}z`);
  h = hash(h, `${c}`);
  h = hash(h, `${c}z`);
  h = hash(h, `${c}${c}`);
  h = hash(h, `${c}-${a}`);
  h = hash(h, `${a}${c}${b}`);
  return h;
}

function prefix1(h0: i64, a: i64, b: u64, c: i32): i64 {
  let h = h0;
  h = hash(h, `a${a}`);
  h = hash(h, `a${a}z`);
  h = hash(h, `${a}`);
  h = hash(h, `a${b}`);
  h = hash(h, `a${b}z`);
  h = hash(h, `${b}`);
  h = hash(h, `a${c}`);
  h = hash(h, `a${c}z`);
  h = hash(h, `${c}`);
  h = hash(h, `a${c}${c}`);
  h = hash(h, `a${c}-${a}`);
  h = hash(h, `a${a}${c}${b}`);
  return h;
}

