}

function main() {
  const as: i64[] = [0, 7, -7, 42, -42, 999, -999, 1000, 9999, -9999, 10000, -10000, 99999, 123456, -123456, 999999, 1000000, 9999999, -9999999, 10000000, -10000000, 12345678, -12345678, 99999999, -99999999, 100000000, -100000000, 1234567890123, -1234567890123, 9223372036854775807, -9223372036854775807 - 1];
  const bs: u64[] = [0, 5, 9999, 10000, 99999999, 100000000, 18446744073709551615];
  const cs: i32[] = [0, -1, 2147483647, -2147483647 - 1, 65535, -65536];
  let h0: i64 = 0;
  let h1: i64 = 0;
  let h2: i64 = 0;
  let h3: i64 = 0;
  let h4: i64 = 0;
  let h5: i64 = 0;
  let h6: i64 = 0;
  let h7: i64 = 0;
  let h8: i64 = 0;
  let h9: i64 = 0;
  let h10: i64 = 0;
  let h11: i64 = 0;
  let h12: i64 = 0;
  let h13: i64 = 0;
  let h14: i64 = 0;
  let h15: i64 = 0;
  let h16: i64 = 0;
  let h17: i64 = 0;
  let h18: i64 = 0;
  let h19: i64 = 0;
  let h20: i64 = 0;
  let h21: i64 = 0;
  let h22: i64 = 0;
  let h23: i64 = 0;
  for (let i = 0; i < as.length; i++) {
    const a = as[i];
    const b = bs[i % bs.length];
    const c = cs[i % cs.length];
    h0 = prefix0(h0, a, b, c);
    h1 = prefix1(h1, a, b, c);
    h2 = prefix2(h2, a, b, c);
    h3 = prefix3(h3, a, b, c);
    h4 = prefix4(h4, a, b, c);
    h5 = prefix5(h5, a, b, c);
