// check: no leaks
// `Promise.all`, `allSettled`, `any` and `race` over a holder of a shared promise, kept as a
// value and passed to a spawned call (#212): the combinator runs on this task, which holds
// the holder, and the other task gets a copy of its result. Node prints the same.
class Obj {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}
async function count(n: number): Promise<number> {
  await sleep(5);
  return n;
}
async function make(n: number): Promise<Obj> {
  await sleep(5);
  return new Obj(n);
}
// The other input of `any` and `race`: it settles well after the shared promise.
async function later(n: number): Promise<number> {
  await sleep(100);
  return n;
}
async function makeLater(n: number): Promise<Obj> {
  await sleep(100);
  return new Obj(n);
}
async function sum(a: Promise<number[]>): Promise<number> {
  const xs = await a;
  return xs[0] + xs[1];
}
async function sumObjs(a: Promise<Obj[]>): Promise<number> {
  const xs = await a;
  return xs[0].n + xs[1].n;
}
async function settled(a: Promise<PromiseSettledResult<number, never>[]>): Promise<number> {
  let s = 0;
  for (const x of await a) {
    if (x.status == "fulfilled") {
      s += x.value;
    }
  }
  return s;
}
async function first(a: Promise<number, AggregateError>): Promise<number> {
  return await a;
}
async function winner(a: Promise<Obj>): Promise<number> {
  return (await a).n;
}
async function main() {
  const p = count(2);
  const q = p;
  const all = Promise.all([q, count(3)]);
  const t1 = spawn(sum(all));
  console.log("all", await p, await t1);

  const o = make(4);
  const o2 = o;
  const objs = Promise.all([o2, make(6)]);
  const t2 = spawn(sumObjs(objs));
  console.log("all objects", (await o).n, await t2);

  const s = count(7);
  const s2 = s;
  const st = Promise.allSettled([s2, count(1)]);
  const t3 = spawn(settled(st));
  console.log("allSettled", await s, await t3);

  const a = count(8);
  const a2 = a;
  const any = Promise.any([a2, later(9)]);
  const t4 = spawn(first(any));
  console.log("any", await a, await t4);

  const r = make(10);
  const r2 = r;
  const race = Promise.race([r2, makeLater(11)]);
  const t5 = spawn(winner(race));
  console.log("race", (await r).n, await t5);
}
