// The function calls one in a captured array, which changes a field.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

function mk(): F {
  const b = new C();
  return (x: i64): i64 => {
    b.n += 1;
    return b.n;
  };
}

async function main() {
  const fs = [mk()];
  const f = shared((x: i64): i64 => fs[0](x));
  console.log(f(1));
}
