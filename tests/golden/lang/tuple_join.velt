// `t.join(sep)` and `t.toString()` on a tuple write it as `Array.prototype.join` writes an array
// (issue #1462): each element as `String(x)` writes it, `null` as empty text, the tuple
// evaluated before the separator.
const t: [number, string] = [1, "a"];
console.log(t.join(), t.join(" - "), t.toString(), String(t), "" + t);
const u: [string | null, number[], boolean] = [null, [1, 2], true];
console.log(u.join("|"), u.toString());
const e: [] = [];
console.log(`<${e.join(";")}>`);
let order = "";
function tup(): [number, number] { order += "t"; return [1, 2]; }
function sep(): string { order += "s"; return "+"; }
console.log(tup().join(sep()), order);
function sepOf(k: number): string | undefined {
  return k > 0 ? "-" : undefined;
}
console.log(t.join(sepOf(1)), t.join(sepOf(0)), [1, 2].join(sepOf(0)));
