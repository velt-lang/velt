// A compound assignment to a local of a union type narrowed to one member (#1456): `x += "!"`
// after `typeof x === "string"` on a `number | string` is `x = x + "!"`, read as the member and
// stored back into the union, as TypeScript checks it.
// check: no leaks
function f(x: number | string): string {
  if (typeof x === "string") {
    x += "!";
    x += 1;
    return x;
  }
  x += 2;
  x *= 3;
  return `n${x}`;
}

function g<T>(x: T | string): string {
  if (typeof x === "string") {
    x += "?";
    return x;
  }
  return "-";
}

function h(x: string | boolean): string | boolean {
  if (typeof x === "string") {
    x += "#";
  }
  return x;
}

let total: number | string = 0;
for (let i = 0; i < 3; i++) {
  if (typeof total === "number") {
    total += i;
  }
}
console.log(f("a"), f(1), g<number>("b"), g<number>(3), h("s"), h(true), total);
