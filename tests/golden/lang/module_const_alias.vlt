// An object constant initialized by a call and taken over (bound to a name, stored in a
// field) is the one object Node evaluates once (#1383): module state, so a change through any
// name shows in the constant.

type Point = { x: number; y: number };

function point(x: number, y: number): Point {
  return { x: x, y: y };
}

const UNIT = point(1, 2);

class Holder {
  p: Point;

  constructor(p: Point) {
    this.p = p;
  }
}

function main() {
  const a = UNIT;
  a.x = 5;
  const h = new Holder(UNIT);
  h.p.x = 9;
  console.log(UNIT.x, a.x, h.p.x);
}
