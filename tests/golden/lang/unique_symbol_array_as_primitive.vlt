// The same with a primitive for the union's other member (#923). Node gives a TypeError that
// `x.toUpperCase` is not a function; a thrown TypeError with another message is the accepted
// difference.
const K = Symbol("k");

type S = string | typeof K;

function use(x: S): string {
  return x === K ? "k" : x.toUpperCase();
}

const l: (string | symbol)[] = [K, "a", Symbol("z")];
const s = l as S[];
console.log(use(s[0]), use(s[1]));
console.log(use(s[2]));
