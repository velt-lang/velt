// A `[Symbol.dispose]()` that throws while a drop runs it: a drop has nowhere to throw to, so
// the error is uncaught (`Uncaught Error: …`, exit 1), as Node's is when nothing catches it, here
// in the middle of draining the queue of drops past the depth limit (#543): the chain is disposed
// from its head on, and node 300 is past the limit. Before, the hook was called as if it could
// not throw, and the build failed (an internal error).

class Node {
  id: number;
  kids: Node[] = [];

  constructor(id: number) {
    this.id = id;
  }

  [Symbol.dispose]() {
    if (this.id % 100 == 0) {
      console.log(`disposing ${this.id}`);
    }
    if (this.id == 300) {
      throw new Error(`node ${this.id} failed`);
    }
  }
}

function chain(n: number): Node {
  let head = new Node(n - 1);
  for (let i = n - 2; i >= 0; i--) {
    const b = new Node(i);
    b.kids.push(head);
    head = b;
  }
  return head;
}

function main() {
  {
    const c = chain(1000);
    console.log(`made ${c.id}`);
  }
  console.log("not reached");
}
