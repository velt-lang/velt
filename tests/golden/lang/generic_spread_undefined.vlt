// check: no leaks
// A spread in a generic body of an optional field over a required one (#350): as for a
// concrete spread, the field may hold a present `undefined` (`n: number | undefined`), an
// absent one keeps the earlier value, and a present value overrides it.
type U = { n: number; s: string; o?: number };
function merge<T extends object>(x: T, patch: Partial<T>) {
  return { ...x, ...patch };
}
function update<T extends object>(x: T, patch: Partial<T>): T {
  return { ...x, ...patch };
}
const u: U = { n: 1, s: "a" };
const m = merge(u, { n: undefined });
console.log(JSON.stringify(m), m.n, "n" in m);
const m2 = merge(u, { s: "b" });
console.log(JSON.stringify(m2), m2.n, Object.keys(m2).join(","));
const m3 = merge(u, { n: 4, o: 2 });
console.log(JSON.stringify(m3), m3.n === 4);
const r = update(u, { s: "z", o: 3 });
console.log(JSON.stringify(r), r === u);
const concrete: Partial<U> = { n: undefined };
console.log(JSON.stringify({ ...u, ...concrete }));
