// check: no leaks
// A generic function used as a function value (#224) at a promise type: the value's thunk takes
// another reference to the argument, which for a promise is another holder of it (#212). Inside
// a generic function the argument type still depends on a type parameter.

function keep<T>(x: T): T[] {
  return [x];
}

class Box<T> {
  constructor(public v: T) {}
}

function boxIt<T>(b: Box<T>): Box<T>[] {
  return [b];
}

function outer<U>(u: Box<U>): i64 {
  const g: (b: Box<U>) => Box<U>[] = boxIt;
  return g(u).length as i64;
}

async function val(): Promise<i64> {
  return 5;
}

async function main() {
  const g: (p: Promise<i64>) => Promise<i64>[] = keep;
  const p = val();
  console.log(g(p).length);
  console.log(outer(new Box(val())));
}
