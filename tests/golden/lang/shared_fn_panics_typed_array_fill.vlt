// A typed array's `fill` changes it through its buffer, in a function the compiler can't follow.
type F = (x: i64) => i64;

interface Fi {
  make(): F;
}

class Fa implements Fi {
  make(): F {
    const u = new Uint8Array(1);
    return (x: i64): i64 => {
      u.fill(u[0] + 1);
      return u[0] as i64;
    };
  }
}

async function main() {
  const m: Fi = new Fa();
  const f = shared(m.make());
  console.log(f(1));
}
