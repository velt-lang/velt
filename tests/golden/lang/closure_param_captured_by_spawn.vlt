// Regression (use after free): a function-typed parameter captured by a spawned closure is
// inferred as owned, so the closure literal passed to `later` captures by value and stays alive
// until the task runs. `main` awaits the task, so its line prints first whatever the timing.
function later(cb: () => string): Promise<void> {
  return spawn(
    (async (): Promise<void> => {
      await sleep(10);
      console.log(cb());
    })(),
  );
}

function arm(): Promise<void> {
  const msg = `captured ${40 + 2}`;
  return later(() => msg.clone());
}

async function main() {
  const task = arm();
  const junk: string[] = [];
  for (let i = 0; i < 100; i++) {
    junk.push(`overwrite the freed closure environment ${i}`);
  }
  await task;
  console.log(junk.length);
}
