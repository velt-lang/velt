// check: no leaks
// A `read` callback nested in another stores an array it made into a variable of the outer
// callback (directly, two reads deep, or through a function the outer callback calls). The
// outer reader made that variable's value, so it can change what was stored, return it and
// drop it, and a later `write` of the locks leaves it as it was (#1523).
class Box {
  items: number[][] = [[1, 2], [3]];
}

function fill(b: RwLock<Box>, out: number[][][]) {
  b.read((y) => {
    out.push(y.items.slice());
  });
}

function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const c = new RwLock(new Box());
  const res = a.read((x) => {
    const mine: number[][][] = [];
    b.read((y) => {
      mine.push(y.items.slice());
      c.read((z) => {
        mine.push(z.items.map((e) => e));
      });
    });
    mine[0].push([5]);
    mine[1].push([6]);
    return mine;
  });
  const viaFn = a.read((x) => {
    const mine: number[][][] = [];
    fill(b, mine);
    mine[0].push([7]);
    return mine;
  });
  const top: number[][][] = [];
  fill(b, top);
  b.write((q) => {
    q.items = [];
  });
  c.write((q) => {
    q.items.push([8]);
  });
  console.log(res, viaFn, top);
}
