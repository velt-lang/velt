function sign(order: i64): string {
  return order < 0 ? "<" : order > 0 ? ">" : "=";
}

function main() {
  for (const p of SUPPLEMENTARY) {
    console.log(JSON.stringify(p[0]), JSON.stringify(p[1]), sign(p[0].localeCompare(p[1])));
  }
  for (const p of MARKED) {
    console.log(JSON.stringify(p[0]), JSON.stringify(p[1]), sign(p[0].localeCompare(p[1])));
  }
  for (const n of EDGES) {
    const x = String.fromCodePoint(n);
    let line = "";
    for (const p of PROBES) {
      line += sign(x.localeCompare(p));
    }
    line += sign((x + "b").localeCompare(x + "a"));
    line += sign(("a" + x + "b").localeCompare("a" + x + "a"));
    console.log(`U+${n.toString(16)} ${line}`);
  }
  let line = "";
  for (const x of CLASS_EDGES) {
    line += sign(x.localeCompare("0"));
    if (line.length == 72) {
      console.log(line);
      line = "";
    }
  }
  console.log(line);
}
