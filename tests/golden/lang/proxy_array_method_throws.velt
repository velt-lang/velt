// check: no leaks
// An error thrown while an array method runs on a proxy of an array reaches the caller's
// `catch`, as in Node (#3897): a `set`, `deleteProperty`, `get` or `has` trap in `push`, `pop`,
// `shift` and `splice`; a callback of `forEach`, `map`, `filter`, `find`, `some` and a `sort`
// comparator; a proxy of a proxy. Each is followed by a method on the same proxy that works.
const log: string[] = [];

class Guarded {
  raw: number[] = [1, 2, 3];
  p: any;
  constructor(trap: string, key: string) {
    const fail = (k: string | symbol): void => {
      if (String(k) === key) {
        throw new TypeError(`${trap} ${String(k)}`);
      }
    };
    const raw = this.raw;
    if (trap === "set") {
      this.p = new Proxy(raw as any, {
        set(t, k, v, r) {
          fail(k);
          return Reflect.set(t, k, v, r);
        },
      });
    } else if (trap === "deleteProperty") {
      this.p = new Proxy(raw as any, {
        deleteProperty(t, k) {
          fail(k);
          return Reflect.deleteProperty(t, k);
        },
      });
    } else if (trap === "get") {
      this.p = new Proxy(raw as any, {
        get(t, k, r) {
          fail(k);
          return Reflect.get(t, k, r);
        },
      });
    } else {
      this.p = new Proxy(raw as any, {
        has(t, k) {
          fail(k);
          return Reflect.has(t, k);
        },
      });
    }
  }
}

function attempt(label: string, run: () => any): void {
  try {
    const r = run();
    log.push(`${label}: ok ${r}`);
  } catch (e) {
    log.push(`${label}: caught ${e}`);
  }
}

// A trap that throws while an array method runs; the same proxy works after it.
const s = new Guarded("set", "3");
attempt("push set", () => s.p.push(4));
attempt("push again", () => s.p.push());
log.push(`raw ${s.raw.join()}`);

const d = new Guarded("deleteProperty", "2");
attempt("pop delete", () => d.p.pop());
attempt("pop again", () => d.p.length);
log.push(`raw ${d.raw.join()}`);

const g = new Guarded("get", "0");
attempt("shift get", () => g.p.shift());
attempt("join after", () => g.p.slice(1).join("-"));

const h = new Guarded("has", "1");
attempt("splice has", () => h.p.splice(0, 1));
attempt("includes after", () => h.p.includes(3));
log.push(`raw ${h.raw.join()}`);

// The methods left by an error left no state behind: the raw arrays and the proxies work.
attempt("raw arrays", () => {
  s.raw.push(4);
  d.raw.unshift(0);
  g.raw.reverse();
  h.raw.splice(1, 1);
  return [s.raw.join(), d.raw.join(), g.raw.join(), h.raw.join()].join(" | ");
});
attempt("proxies again", () =>
  [s.p.length, d.p.indexOf(0), g.p.slice(1).join(), h.p.length, Reflect.has(d.p, "3")].join(" "),
);

// A callback that throws: forEach, map, filter, find, some, sort.
const q: any = new Proxy([1, 2, 3] as any, {});
function bad(x: any): number {
  if (x === 2) {
    throw new RangeError("cb " + x);
  }
  return x * 10;
}
attempt("forEach", () => q.forEach((x: any) => bad(x)));
attempt("map", () => q.map((x: any) => bad(x)).join());
attempt("filter", () => q.filter((x: any) => bad(x) > 0).length);
attempt("find", () => q.find((x: any) => bad(x) > 100));
attempt("some", () => q.some((x: any) => bad(x) > 100));
attempt("map after", () => q.map((x: any) => x + 1).join());
const order: any = new Proxy([3, 1, 2] as any, {});
attempt("sort", () =>
  order.sort((a: any, b: any) => {
    if (a === 2 || b === 2) {
      throw new Error("cmp");
    }
    return a - b;
  }),
);
attempt("sort after", () => order.sort((a: any, b: any) => a - b).join());

const bigRaw: number[] = [];
for (let i = 0; i < 40; i++) {
  bigRaw.push(40 - i);
}
const big: any = new Proxy(bigRaw as any, {});
attempt("sort big", () =>
  big.sort((a: any, b: any) => {
    if (a === 3 || b === 3) {
      throw new Error("late");
    }
    return a - b;
  }),
);
attempt("sort big after", () => big.sort((a: any, b: any) => a - b).slice(0, 3).join());

// A value that isn't an `Error` keeps its type.
attempt("string", () =>
  q.forEach((x: any) => {
    if (x === 3) {
      throw "plain " + x;
    }
  }),
);

// A proxy of a proxy: the inner trap's error leaves the outer method.
const inner = new Guarded("set", "3");
const outer: any = new Proxy(inner.p, {});
attempt("nested", () => outer.push(9));
attempt("nested again", () => outer.length);

// Thrown inside a `catch`, rethrown, with `finally`.
try {
  try {
    new Guarded("set", "3").p.push(4);
  } catch (e) {
    log.push(`inner ${e}`);
    throw new Error("from catch");
  }
} catch (e) {
  log.push(`outer ${e}`);
}
try {
  try {
    q.forEach((x: any) => bad(x));
  } catch (e) {
    log.push(`rethrowing ${e}`);
    throw e;
  } finally {
    log.push("finally");
  }
} catch (e) {
  log.push(`rethrown ${e instanceof RangeError} ${e}`);
}

// From an async caller, and an error nothing catches in a function: the caller's catch.
async function later(): Promise<string> {
  await Promise.resolve(0);
  try {
    q.map((x: any) => bad(x));
    return "no";
  } catch (e) {
    return "async " + `${e}`;
  }
}
function leaks(): any {
  return new Guarded("set", "3").p.push(4);
}
attempt("through a function", () => leaks());

for (const line of log) {
  console.log(line);
}
console.log(await later());
