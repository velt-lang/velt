// `String(v)` and templates of a value whose type is a type parameter instantiated at `any`,
// `unknown` or `object` write the value held as JavaScript's `String(v)` does, not as
// `console.log` prints it (issue #1462).
function show<T>(v: T): string {
  return String(v);
}
function tpl<T>(v: T): string {
  return `<${v}>`;
}

console.log(show<any>({ a: 1 }), show<any>([1, [2, 3]]), show<any>(null), show<any>(undefined));
console.log(tpl<any>({ a: 1 }), tpl<any>([1, 2]), tpl<any>("s"), tpl<any>(1.5), tpl<any>(true));
console.log(show<unknown>({ b: 2 }), tpl<unknown>([3]), show<object>({ c: 3 }));

// Other instantiations keep their own text.
console.log(show<number>(2), tpl<string>("x"), show<boolean>(false), tpl<number[]>([4, 5]));

class Gen<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
  toString(): string {
    return "G(" + String(this.v) + ")";
  }
}
console.log(String(new Gen<any>(new Gen<any>("s"))));
console.log(`${new Gen<any>({ x: 1 })}`, `${new Gen<number>(7)}`);

// An instance of a class with its own `toString()` held by the `any`.
class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
  toString(): string {
    return `(${this.x}, ${this.y})`;
  }
}
const p: any = new Point(1, 2);
console.log(show<any>(p), tpl<any>(p), show<any>([p, p]));

// The value is evaluated once.
let calls = 0;
function next(): any {
  calls++;
  return { n: calls };
}
console.log(tpl<any>(next()), calls);

// Appends (`+=`) of a type parameter's text, and a field's text twice in one template.
function add<T>(acc: string, v: T): string {
  let s = acc;
  s += `[${v}]`;
  s += v;
  return s;
}
class Box<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
  text(): string {
    return `${this.v}|${this.v}`;
  }
}
console.log(add<any>("x", { k: 1 }), add<number>("y", 2), add<any>("z", [1, [2]]));
console.log(new Box<any>({ q: 1 }).text(), new Box<unknown>(null).text(), new Box<string>("s").text());
