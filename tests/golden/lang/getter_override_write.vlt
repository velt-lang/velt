// Writing through a base class a property a subclass overrides with only a getter (#350):
// the subclass's getter-only accessor replaces the base's `get`/`set` pair, so the write
// throws Node's `TypeError` (through the subclass itself it is a type error,
// `errors/getter_override_assign.vlt`).
class P2 {
  private _n = 3;
  get n(): number {
    return this._n;
  }
  set n(v: number) {
    this._n = v + 100;
  }
}

class S2 extends P2 {
  override get n(): number {
    return 42;
  }
}

const q: P2 = new P2();
q.n = 1;
console.log(q.n);
const p: P2 = new S2();
console.log(p.n);
p.n = 1;
console.log("not reached", p.n);
