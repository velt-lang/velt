// An interface value cast to an object type whose fields are all optional and new to it (#379):
// tsc allows `rq as { _input?: unknown }`, and Node adds the property when it is written. Velt
// asserts the interface with both's members, widening the objects converted to `ServerCtx`.
interface ServerCtx {
  url: string;
  status(code: number): void;
}

function handle(rq: ServerCtx, input: unknown): unknown {
  (rq as { _input?: unknown })._input = input;
  return (rq as { _input?: unknown })._input;
}

let code = 0;
const rq: ServerCtx = {
  url: "/a",
  status: (c: number) => {
    code = c;
  },
};
console.log((rq as { _input?: unknown })._input);
console.log(handle(rq, "validated"));
rq.status(201);
console.log(code, rq.url, JSON.stringify((rq as { _input?: unknown })._input));
