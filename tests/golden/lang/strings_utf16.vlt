// JavaScript string semantics (#377 phase 2b): lengths and positions count UTF-16 code units,
// a supplementary character is two of them, and slicing between the two halves of a pair keeps
// the half as a lone surrogate. Expected output checked against node 22 (lone surrogates print
// as U+FFFD at the top level of `console.log`, escaped inside arrays).
const hi = String.fromCharCode(0xd83d);
const lo = String.fromCharCode(0xde00);
const emoji = "😀";

// length
console.log("héllo".length, emoji.length, "日本語".length, "a😀b".length, `${emoji}${emoji}`.length);
const label = "Zoë";
console.log(label.length > 3, label.length);

// charCodeAt, charAt, at
const s = "a€😀z";
console.log(s.charCodeAt(0), s.charCodeAt(1), s.charCodeAt(2), s.charCodeAt(3), s.charCodeAt(4));
console.log([s.charAt(1), s.charAt(2), s.charAt(3)], s.at(-1), s.at(-2) == lo);

// slice and substring at every position of a pair
console.log(emoji.slice(0, 1) == hi, emoji.slice(1) == lo, emoji.slice(0, 2) == emoji);
console.log([emoji.slice(0, 1), "x😀y".slice(2), "😀😀".slice(1, 3)]);
console.log("héllo wörld".slice(1, 4), "héllo".substring(4, 1), "日本語".slice(-2));
console.log(hi + lo == emoji, (hi + lo).length, `${emoji.slice(0, 1)}${emoji.slice(1)}` == emoji);

// indexOf, lastIndexOf, includes, startsWith, endsWith
const t = "naïve café 😀 naïve";
console.log(
  t.indexOf("ï"),
  t.indexOf("😀"),
  t.indexOf("naïve", 1),
  t.lastIndexOf("ï"),
  t.lastIndexOf("é", 5),
);
console.log(emoji.indexOf(lo), emoji.lastIndexOf(hi), emoji.indexOf("", 1), emoji.includes(lo));
console.log(emoji.startsWith(hi), emoji.endsWith(lo), emoji.startsWith(lo), t.endsWith("ïve"));

// split, replace, replaceAll
console.log("a😀b".split(""), "日本,語".split(","), "a😀b".split(lo));
console.log(emoji.replace(lo, "X"), emoji.replaceAll("", "-"), "a😀b".replaceAll("😀", "_"));
console.log([emoji.replace(lo, "X")]);

// padStart, padEnd: lengths in code units; a fill cut between halves keeps the high one
console.log(
  "x".padStart(4, "😀"),
  "é".padEnd(3, "-") + "|",
  ["a".padEnd(4, "😀")],
  "日本".padStart(5, "語"),
);

// ordering: code units, so U+FF5E sorts after a supplementary character
const words = ["b", "😀", "～", "a", "é", "z", "日"];
words.sort();
console.log(words.join(" "), "～" < "😀", "😀" < "～", "é" > "z");

// String.fromCharCode of a surrogate is a lone surrogate
console.log(hi.length, [hi], hi + lo, [String.fromCharCode(0xdfff)]);

// for...of and spread iterate code points
const chars: string[] = [];
for (const c of "a😀é") {
  chars.push(c);
}
console.log(chars, [..."h€😀!"].length);

// JSON: lone surrogate escapes are kept, an escaped pair joins
const lone = JSON.parse<string>('"a\\ud800b"');
console.log(
  lone.length,
  [lone],
  JSON.stringify(lone),
  JSON.parse<string>('"\\ud83d\\ude00"') == emoji,
);

// toUpperCase keeps lone surrogates; trim does not count positions
console.log(["é😀".toUpperCase()], (" " + hi + " ").trim().length);
