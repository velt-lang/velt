// The params of a closure may be one object (a call through a function value can pass the
// same object twice). A renderer's nested functions are closures that call each other, and
// `mount(vnode, container)` passes both of its params on to `mountComponent`, which modifies
// the vnode and keeps both. `mountComponent` was checked with its params as one object, so
// the call is what it was checked for, as in JavaScript, where they may be one object.

type SetupFn = (inst: Inst) => VNode;
type VNode = { type: any; dom: any; kids: VNode[] };
type Inst = { vnode: VNode; el: any };
type Opts<N, E> = { insert: (n: N, c: E, b: N | null) => void; comment: (t: string) => N };

function createRenderer<HostNode = any, HostElement = any>(opts: Opts<HostNode, HostElement>) {
  const { insert: hostInsert, comment: hostComment } = opts;
  const instances: Inst[] = [];
  function mount(
    vnode: VNode,
    container: HostElement,
    before: HostNode | null = null,
    parentNS: boolean = false,
  ): void {
    if (typeof vnode.type === "object") {
      mountComponent(vnode, container, before, vnode.type.__setup as SetupFn, parentNS);
      return;
    }
    const el = hostComment(String(vnode.type));
    vnode.dom = el;
    hostInsert(el, container, before);
    for (const k of vnode.kids) {
      mount(k, container, null, parentNS);
    }
  }
  function mountComponent(
    vnode: VNode,
    container: HostElement,
    before: HostNode | null,
    setup: SetupFn,
    parentNS: boolean = false,
  ): void {
    const anchor = hostComment("c");
    vnode.dom = anchor;
    hostInsert(anchor, container, before);
    const inst: Inst = { vnode, el: container };
    instances.push(inst);
    const sub = setup(inst);
    mount(sub, container, anchor, parentNS);
  }
  const render = (v: VNode, c: HostElement): void => {
    mount(v, c);
  };
  return { render, instances };
}

function vn(type: any, kids: VNode[]): VNode {
  return { type, dom: null, kids };
}

function main() {
  const out: string[] = [];
  const r = createRenderer<string, string[]>({
    insert: (n, c, b) => {
      c.push(n + (b === null ? "" : "<" + b));
      out.push(n);
    },
    comment: (t) => "#" + t,
  });
  const comp = { __setup: (inst: Inst): VNode => vn("span" + inst.vnode.kids.length, []) };
  const root: string[] = [];
  const v = vn("div", [vn(comp, []), vn("p", [])]);
  r.render(v, root);
  console.log(root.join(","));
  console.log(out.join(","), r.instances.length, v.dom, v.kids[0].dom);

  // The same object as vnode and container: an object renderer whose host element is a VNode.
  const log: string[] = [];
  const s = createRenderer<string, VNode>({
    insert: (n, c, b) => {
      c.kids.push(vn(n, []));
      log.push(n + " in " + c.type + (b === null ? "" : " before " + b));
    },
    comment: (t) => "#" + t,
  });
  const w = vn(comp, []);
  s.render(w, w);
  console.log(log.join("; "));
  console.log(w.dom, w.kids.length, s.instances[0].el === w, s.instances[0].vnode === w);
}

main();
