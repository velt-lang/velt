// A function with a rest parameter cast to a function type (or callable object type) whose
// calls pass the rest parameter nothing (#2787): refused. TypeScript keeps the function, so a
// later call through a type with more parameters passes the arguments on in Node (`k(5)` gives
// 1 there); Velt's function of the cast type would be called without them. Declaring the call
// with a rest parameter (`{ (...args: unknown[]): T }`) converts as Node runs it.
interface Injectable<T> {
  (): T;
}

function count(...args: unknown[]): number {
  return args.length;
}

const h = ((...args: unknown[]) => args.length) as () => number;
const k: (n: number) => number = h;
const i = ((...args: unknown[]) => args.length) as Injectable<number>;
const j = count as () => number;
const one = ((a: number, ...rest: number[]) => a + rest.length) as (a: number) => number;
// Refused by the operand's type, whatever the expression: a field and a call's result.
const holder = { f: (...xs: number[]) => xs.length };
const field = holder.f as () => number;
function make(): (...a: number[]) => number {
  return (...a: number[]) => a.length;
}
const made = make() as () => number;
console.log(h(), k(5), i(), j(), one(1), field(), made());
