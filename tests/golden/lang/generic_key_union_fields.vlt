// A write through a key union into a field whose own type is a union: the value's member
// becomes the field's (`"b"` of `f64 | "a" | "b"` into `"a" | "b"`).
type Lit = { kind: "a" | "b"; n: number };

function setF<T, K extends keyof T>(o: T, k: K, v: T[K]): void {
  o[k] = v;
}

const l: Lit = { kind: "a", n: 1 };
const lk: (keyof Lit)[] = ["kind", "n"];
setF(l, lk[0], "b");
console.log(l);
type Mix = { a: string | boolean; b: number };
const mx: Mix = { a: "s", b: 2 };
const mk: (keyof Mix)[] = ["a", "b"];
setF(mx, mk[0], true);
setF(mx, mk[1], 5);
console.log(mx);
