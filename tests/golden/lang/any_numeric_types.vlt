// A number in an `any` converts to every numeric type: there is one JavaScript number, so an
// `i64` reads back as a `number`, a `number` as an `i64`, and a generic `P = i64` boxed into an
// `any` comes out as an `i64` too.

function asInt<P>(p: P): i64 {
  const a: any = p;
  if (typeof a == "number") {
    return a as i64;
  }
  return -1;
}

function asNumber(n: i64): number {
  const a: any = n;
  return a as number;
}

function main() {
  const n: i64 = 5;
  console.log(asInt(n), asInt(7), asInt(2.75), asInt("x"));
  console.log(asNumber(-12) / 8);
  const b: any = 300 as u32;
  console.log(b as u8, b as f32, b as i64);
  const big: any = 9007199254740993 as i64;
  console.log(big as i64);
  // A `number` converts as `as` converts it: truncating and saturating, `NaN` to 0.
  const nums: any[] = [300, -1, 3.9, NaN, Infinity, -Infinity, 1e300];
  for (const x of nums) {
    console.log(x as u8, x as i32, x as u64, x as i64);
  }
  // An integer wraps, and a 64-bit one is exact past 2^53.
  const neg: any = -1 as i32;
  console.log(neg as u8, neg as u64);
  const huge: any = 9007199254740993 as i64;
  console.log(huge as u64, huge as i32);
  const top: any = 18446744073709551615u64;
  console.log(top as i64, top as u8);
  const s: any = "text";
  console.log(typeof s);
}
