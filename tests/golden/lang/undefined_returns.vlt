// `T | void` is `T | undefined`, and a function whose result may be `undefined` returns it on a
// bare `return;` and at its end, declared or inferred (issue #930), as in TypeScript.
type Handler = (code: number) => boolean | void;

function run(h: Handler, code: number): string {
  const r = h(code);
  if (r === true) {
    return "handled";
  }
  return `not handled (${r})`;
}

function find(xs: number[], v: number): number | undefined {
  for (const x of xs) {
    if (x === v) {
      return x;
    }
  }
}

function firstEven(xs: number[]): number | undefined {
  for (const x of xs) {
    if (x % 2 == 0) {
      return x;
    }
    if (x < 0) {
      return;
    }
  }
}

function mainA() {
  console.log(run((c) => c > 1, 2));
  console.log(run((c) => c > 1, 0));
  console.log(run(() => {}, 0));
  console.log(
    run(
      (c) => {
        if (c > 5) {
          return true;
        }
      },
      9,
    ),
  );
  console.log(
    run(
      (c) => {
        if (c > 5) {
          return true;
        }
      },
      1,
    ),
  );
  console.log(find([1, 2], 2), find([1, 2], 3));
  console.log(firstEven([1, 3, 4]), firstEven([1, -1, 4]), firstEven([]));
}

function findAny(xs: number[], x: number) {
  for (const y of xs) {
    if (y == x) {
      return y;
    }
  }
  return;
}

function pick(c: boolean) {
  if (c) {
    return "yes";
  }
}

const label = (n: number) => {
  if (n > 0) {
    return "pos";
  }
};

function nothing(c: boolean) {
  if (c) {
    return;
  }
  console.log("side");
}

function main() {
  mainA();
  console.log(findAny([1, 2], 2), findAny([1, 2], 5));
  console.log(pick(true), pick(false));
  console.log(label(1), label(-1));
  nothing(false);
  const r: string | undefined = pick(false);
  console.log(r === undefined);
}
