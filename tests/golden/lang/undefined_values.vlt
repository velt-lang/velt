// `undefined` as its own value (issue #930, phase 1): `T | undefined` types, `void e`, `typeof`,
// comparisons, truthiness, `??`, `?.`, printing, template strings and JSON, as in Node.
function find(xs: number[], v: number): number | undefined {
  for (const x of xs) {
    if (x === v) {
      return x;
    }
  }
  return undefined;
}

function pick(c: boolean) {
  if (c) {
    return "yes";
  }
  return undefined;
}

type O = { name: string; age: number | undefined };

class Box {
  v: string | undefined = undefined;
}

type U = string | number | undefined;
type P = { a?: string | undefined; b: number };

function show(u: U): string {
  if (u === undefined) {
    return "none";
  }
  return typeof u;
}

function label(n: number): string | undefined {
  return n > 0 ? "pos" : undefined;
}

function first(xs: string[]): string | undefined {
  return xs.length > 0 ? xs[0] : undefined;
}

type Shape = { kind: string; r: number | undefined };

function nothing(): string | undefined {
  return undefined;
}

// `===` with the nothing a type lacks is constant; `==` matches either nothing.
function strict(a: number | undefined) {
  console.log(a === null, a !== null, a == null, a != null);
  if (a !== null) {
    console.log("not null", a);
  } else {
    console.log("never");
  }
}

// A default of `undefined` itself is the same whether it applies to a passed `undefined`.
function patch(ns: boolean | undefined = undefined): string {
  return `${ns}`;
}

function firstOf([x = 1]: [number | undefined]): number {
  return x;
}

type Field = { b: number | null; c: number | undefined; d?: number };

function main(): void {
  const a: string | undefined = undefined;
  const b: string | undefined = "hi";
  console.log(a, b);
  console.log([a, b]);
  console.log(typeof a, typeof b);
  console.log(a === undefined, b === undefined, a == null, b != null, a == undefined);
  console.log(!a, !b);
  console.log(a ?? "d", b ?? "d");
  console.log(`${a}|${b}`);
  console.log(String(a));
  console.log(find([1, 2], 3), find([1, 2], 2));
  console.log(pick(true), pick(false));
  const o: O = { name: "x", age: undefined };
  console.log(o);
  console.log(JSON.stringify(o));
  console.log(JSON.stringify([a, b]));
  console.log(JSON.stringify({ a, b }));
  const w: number | undefined = void console.log("side");
  console.log(w);
  void console.log("stmt");
  let x: number | undefined = undefined;
  if (typeof x === "undefined") {
    console.log("undef");
  }
  x = 5;
  if (x !== undefined) {
    console.log(x + 1);
  }
  console.log(new Box());
  const nn: string | null = null;
  console.log(nn == undefined, typeof nn);
  const n: number | undefined = Math.random() > 2 ? 1 : undefined;
  console.log(n);
  switch (typeof n) {
    case "undefined":
      console.log("sw undefined");
      break;
    case "number":
      console.log("sw number");
      break;
  }
  switch (n) {
    case undefined:
      console.log("case undefined");
      break;
    default:
      console.log("case value");
  }
  console.log(show(undefined), show("s"), show(1));
  const xs: U[] = ["a", undefined, 2];
  console.log(xs);
  console.log(JSON.stringify(xs));
  const p: P = { b: 1 };
  const q: P = { a: undefined, b: 2 };
  const r: P = { a: "x", b: 3 };
  console.log(p, q, r);
  console.log(JSON.stringify([p, q, r]));
  let s: string | undefined = nothing();
  console.log(s?.length);
  console.log(s ?? "fallback");
  console.log(label(1), label(-1));
  console.log(first([]), first(["a"]));
  const v = label(-1);
  if (v) {
    console.log("truthy");
  } else {
    console.log("falsy", v);
  }
  const sh: Shape = { kind: "c", r: undefined };
  console.log(sh.r === undefined, JSON.stringify(sh), `${sh.r}`);
  const t: [number, string | undefined] = [1, undefined];
  console.log(t, JSON.stringify(t));
  let u: number | undefined = 3;
  u = undefined;
  u ??= 7;
  console.log(u);
  strict(undefined);
  strict(2);
  console.log(patch(), patch(undefined), patch(true));
  const same = u as number | undefined;
  console.log(same);
  // Destructuring defaults apply where the value is `undefined` (an element of the array or
  // tuple, an `undefined` or absent field), not to a `null`.
  const arr: (number | undefined)[] = [undefined, 2];
  const [d0 = 10, d1 = 20, d2 = 30] = arr;
  console.log(d0, d1, d2);
  const tup: [number | undefined, string] = [undefined, "s"];
  const [t0 = 5, t1] = tup;
  console.log(t0, t1, firstOf([undefined]), firstOf([3]));
  const fld: Field = { b: null, c: undefined };
  const { b: fb = 6, c: fc = 7, d: fd = 8 } = fld;
  console.log(fb, fc, fd);
}
