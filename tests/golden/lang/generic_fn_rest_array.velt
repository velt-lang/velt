// Arrays spread into a rest parameter whose form is an array. Expected output from `node`;
// `tsc --strict` accepts it.
type M = <N extends "nums" | "strs">(n: N, ...x: N extends "nums" ? number[] : string[]) => number;
const m: M = (n, ...x) => { console.log(n, x); return x.length; };
const ns = [1, 2];
console.log(m("nums", ...ns), m("nums", 0, ...ns, 9), m("strs", "a"), m("nums"));
