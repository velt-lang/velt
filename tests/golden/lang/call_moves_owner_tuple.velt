// A call that moves an object and lends a part of it: a tuple (#2531). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; name: string = heap("n"); }
let hold: A2 | null = null;
let ph: [string, number] | null = null;
function take(q: [string, number], v: string) { ph = q; ph = null; junk(); return v + "!"; }
function t() { const a: [string, number] = [heap("p"), 1]; console.log(take(a, a[0])); }
t();
