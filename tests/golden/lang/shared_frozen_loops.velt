// check: no leaks
// check: heap blocks at most 1700
// Functions reading a `shared<Store>` through its frozen instances (#708) loop over its `Map`s
// and `Set`s and pass array callbacks without copying what they read: 100 rounds over 200
// counted items cost no more blocks than building the store does. (A callback's result that
// keeps an element, `filter` or `find`, still gets a copy of it.)
class Item {
  v: number;
  tags: string[];
  constructor(v: number) {
    this.v = v;
    this.tags = [`t${v}`];
  }
}

class Store {
  m: Map<string, Item> = new Map<string, Item>();
  set_: Set<string> = new Set<string>();
  items: Item[] = [];
}

function mk(n: number): Store {
  const s = new Store();
  for (let i = 0; i < n; i++) {
    s.m.set(`k${i}`, new Item(i));
    s.set_.add(`k${i}`);
    s.items.push(new Item(i));
  }
  return s;
}

function loops(st: Store): number {
  let t = 0;
  for (const [k, v] of st.m) {
    t += v.v + k.length;
  }
  for (const v of st.m.values()) {
    t += v.tags[0].length;
  }
  for (const k of st.m.keys()) {
    t += k.length;
  }
  for (const k of st.set_) {
    t += k.length;
  }
  return t;
}

function callbacks(st: Store): number {
  let t = 0;
  if (st.items.some((x) => x.v < 0)) {
    t += 1000000;
  }
  t += st.items.map((x) => x.v).length;
  t += st.items.reduce((acc, x) => acc + x.v, 0);
  st.items.forEach((x) => {
    t += x.tags.length;
  });
  t += st.items.findIndex((x) => x.v == 7);
  return t;
}

async function main() {
  const s = shared(mk(200));
  let a = 0;
  let b = 0;
  for (let r = 0; r < 100; r++) {
    a += loops(s);
    b += callbacks(s);
  }
  console.log(a, b);
}
