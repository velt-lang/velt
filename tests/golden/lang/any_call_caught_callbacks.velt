// A function called through `any` in a callback of a typed method (`forEach`, `map`, a `Map`'s
// `forEach`, a timer) or in an interface method: its error leaves the callback and the method
// to the caller's `catch`, as in JavaScript (#1938, #2353).
interface Runner {
  run(n: number): number;
}

class Calls implements Runner {
  f: any;
  constructor(f: any) {
    this.f = f;
  }
  run(n: number): number {
    return this.f(n);
  }
}

function main() {
  const f: any = (x: any) => {
    if (x === 2) {
      throw new RangeError("x " + x);
    }
    return x * 10;
  };
  [1, 3].forEach((n: number) => console.log("each", f(n)));
  setTimeout(() => console.log("timer", f(1)), 0);
  const r: Runner = new Calls(f);
  console.log("runner", r.run(1));
  try {
    r.run(2);
  } catch (e) {
    console.log("runner caught", `${e}`);
  }
  const m = new Map<string, number>([["a", 1]]);
  m.forEach((v: number, k: string) => console.log("map", k, f(v)));
  const s = [3, 1].map((n: number) => f(n));
  console.log(s);
  try {
    [1, 2, 3].forEach((n: number) => console.log("visit", f(n)));
  } catch (e) {
    console.log("forEach caught", `${e}`);
  }
  try {
    console.log([3, 2].map((n: number) => f(n)));
  } catch (e) {
    console.log("map caught", `${e}`);
  }
  try {
    m.set("b", 2);
    m.forEach((v: number, k: string) => console.log("map", k, f(v)));
  } catch (e) {
    console.log("Map.forEach caught", `${e}`);
  }
  console.log("after", [1, 3].map((n: number) => f(n)));
}
