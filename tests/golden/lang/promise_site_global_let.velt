// A module `let` typed by an alias of a function type with a `Promise<T>` result: its closure's
// `reject`, kept and called later, rejects into the alias body's site.

class HttpError extends Error {
  status: number;
  constructor(s: number, m: string) {
    super(m);
    this.status = s;
  }
}

let saved: ((e: HttpError) => void) | null = null;

type Make = () => Promise<string>;

let make: Make = () => new Promise((resolve, reject) => {
  saved = reject;
});

async function main(): Promise<void> {
  const p = make();
  saved!(new HttpError(501, "saved"));
  try {
    console.log(await p);
  } catch (e) {
    if (e instanceof HttpError) {
      console.log(`http ${e.status}`);
    } else {
      console.log("other");
    }
  }
}

await main();
