// Valid: a closure of the same function type as one in `shared(...)` isn't refused for that.
type F = () => void;
class Store { cb: F; constructor(cb: F) { this.cb = cb; } }
async function main() {
  const st = shared(new Store(() => {}));
  let n: i64 = 0;
  const hs: F[] = [];
  hs.push(() => { n += 1; });
  hs[0](); hs[0]();
  console.log(n, st == null);
}
