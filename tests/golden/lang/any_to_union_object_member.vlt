// check: no leaks
// An `any` converted to a union with one interface or object type member (sigx's `JSXElement`,
// returned from `(type as Function)(props)`): the primitive members are tested first, and a
// value that is none of them converts to the interface, checked at run time as `x as VNode`
// is. The union's one array member is told apart with `Array.isArray` (`JSXChild`).
// Expected output: Node's.
interface VNode {
  type: string;
  n: number;
}

type JSXElement = VNode | string | number | boolean | null;
type JSXChild = VNode | string | number | boolean | null | undefined | JSXChild[];

function make(k: number): any {
  if (k === 0) return 5;
  if (k === 1) return "s";
  if (k === 2) return null;
  if (k === 3) return true;
  const v: VNode = { type: "div", n: k };
  return v;
}

function element(k: number): JSXElement {
  return make(k);
}

function nonNull(k: number): VNode | string | number | boolean {
  return make(k);
}

function show(e: JSXElement): string {
  if (e === null) return "null";
  if (typeof e === "object") return `<${e.type} ${e.n}>`;
  return `${typeof e} ${e}`;
}

function flat(c: JSXChild, out: string[]): void {
  if (Array.isArray(c)) {
    for (const x of c) flat(x, out);
    return;
  }
  if (c === undefined) {
    out.push("u");
    return;
  }
  out.push(show(c));
}

function child(a: any): JSXChild {
  return a;
}

function main() {
  for (let k = 0; k < 5; k++) console.log(show(element(k)));
  console.log(show(nonNull(4)), show(nonNull(1)));
  const children: any = make(4);
  const items: JSXElement[] = Array.isArray(children) ? children : children != null ? [children] : [];
  console.log(items.length, show(items[0]));
  const fallback: any = (): any => make(1);
  const fb: JSXElement = typeof fallback === "function" ? fallback() : fallback;
  console.log(show(fb));
  const v: VNode = { type: "p", n: 9 };
  const kids: JSXChild[] = ["a", [v, null], undefined, 2];
  const boxed: any = kids;
  const out: string[] = [];
  flat(child(boxed), out);
  flat(child("x"), out);
  flat(child(make(4)), out);
  console.log(out.join(" | "));
}
