// Generic arrow functions without a return type take it from their body, as in TypeScript and
// as functions do: the expression body's type, the union of the `return`s, `void` without one,
// `Promise<T>` when `async` (#85, #75). Module-level and local ones alike.
// check: no leaks

const id = <T>(x: T) => x;

const pair = <A, B>(a: A, b: B) => ({ first: a, second: b });

const firstOr = <T>(items: T[], fallback: T) => {
  if (items.length === 0) {
    return fallback;
  }
  return items[0];
};

const pick = <T>(flag: boolean, x: T) => {
  if (flag) {
    return x;
  }
  return null;
};

const show = <T>(x: T) => {
  console.log(`show ${x}`);
};

// A self-use outside the `return` expressions needs no return type.
const depth = <T>(xs: T[], n: number) => {
  let total = 1;
  if (n > 0) {
    total += depth(xs, n - 1);
  }
  return total;
};

const later = async <T>(x: T) => {
  await Promise.resolve(0);
  return x;
};

function local(names: string[]): string {
  const wrap = <T>(v: T) => [v, v];
  const count = <T>(xs: T[]) => {
    let n = 0;
    for (const _ of xs) {
      n += 1;
    }
    return n;
  };
  const w = wrap("a");
  return `${w.join("")} ${count(names)} ${count(wrap(1))}`;
}

async function main() {
  const n: number = id(41) + 1;
  const s: string = id("velt");
  console.log(n, s);
  const p = pair("x", 2);
  console.log(p.first, p.second + 1);
  console.log(firstOr([], 7), firstOr(["a"], "b"));
  const maybe = pick(false, "q");
  console.log(maybe === null ? "none" : maybe);
  console.log(pick(true, 3));
  show(5);
  console.log(depth([1], 3));
  const v: string = await later("done");
  console.log(v);
  console.log(local(["p", "q", "r"]));
}
