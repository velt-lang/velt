// check: no leaks
// Loops over rows of a view type (#1485) whose copy goes on in the original loop when a row is a
// view, with locals reached through their address: the string buffer of a `+` chain, a `let` a
// closure captures and changes, an array or object literal, a destructuring, an inner `for...of`,
// a template literal, a spread, `try` / `catch`, a generator and an `await`. The original sees
// what the copy left in them.
interface Cell {
  n: number;
  tag: string;
}

function view(): string[] {
  const src: (string | number)[] = ["v0", "v1", "v2"];
  const raw: any = src;
  return raw as string[];
}

function concat(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    out += "(" + rows[k].length + ")";
  }
  return out;
}

function concatAssign(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    out = out + "{" + k + "," + rows[k].length + "}";
  }
  return out;
}

function grow(rows: string[][], tail: string): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    let acc = "a" + k;
    const add = (x: string): void => {
      acc += x;
    };
    add("<");
    const n = rows[k].length;
    add(String(n) + tail);
    add(">");
    out += acc.length + ":" + acc.slice(0, 4) + ";";
  }
  return out;
}

function tags(rows: string[][]): string {
  let out = "";
  for (const row of rows) {
    const tag = "[" + row.length + "]";
    out += tag;
  }
  return out;
}

function counter(rows: string[][]): string {
  let cnt = 0;
  const next = (): number => ++cnt;
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    const n = rows[k].length;
    out += "#" + next() + "=" + n + " ";
  }
  return out + "#" + cnt;
}

function counterInside(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    let cnt = k * 10;
    const bump = (): number => ++cnt;
    bump();
    const n = rows[k].length;
    bump();
    out += cnt + "/" + n + " ";
  }
  return out;
}

function show(c: Cell): string {
  return c.tag + c.n;
}

function literals(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    const pair = [k, rows[k].length];
    const cell: Cell = { n: rows[k].length, tag: "c" + k };
    const [a, b] = [rows[k].length, k];
    out += pair[0] + pair[1] + "," + show(cell) + "," + a + b + `,${rows[k].length}-${k};`;
  }
  return out;
}

function inner(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    let s = "";
    for (const x of rows[k]) {
      s += x + ".";
    }
    const parts = [...rows[k]];
    out += s + "|" + parts.join("+") + " ";
  }
  return out;
}

function stored(rows: string[][]): string {
  const fns: (() => string)[] = [];
  for (let k = 0; k < rows.length; k++) {
    let label = "r" + k;
    fns.push(() => label);
    label += ":" + rows[k].length;
  }
  return fns.map((f) => f()).join(" ");
}

function nested(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    for (let i = 0; i < rows[k].length; i++) {
      out += "<" + rows[k][i] + ":" + i + ">";
    }
    out += "|";
  }
  return out;
}

function whileLoop(rows: string[][]): string {
  let out = "";
  let k = 0;
  while (k < rows.length) {
    const r = rows[k];
    out = `${out}${r.length}` + "-" + r[0];
    k++;
  }
  return out;
}

async function asyncLoop(rows: string[][]): Promise<string> {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    const a = "x" + rows[k].length;
    await Promise.resolve();
    out += a + rows[k][0] + ";";
  }
  return out;
}

function* gen(rows: string[][]): Generator<string> {
  for (let k = 0; k < rows.length; k++) {
    const s = "g" + rows[k].length;
    yield s + rows[k][rows[k].length - 1];
  }
}

function tryLoop(rows: string[][]): string {
  let out = "";
  for (let k = 0; k < rows.length; k++) {
    try {
      if (rows[k].length === 3) {
        throw new Error("e" + k + rows[k][2]);
      }
      out += "ok" + rows[k].length;
    } catch (e) {
      out += "caught " + (e as Error).message;
    }
    out += ",";
  }
  return out;
}

interface P {
  a: number;
  b: string;
}

function spreads(rows: string[][]): string {
  let out = "";
  let a = 1;
  let b = 2;
  for (const row of rows) {
    const base: P = { a: row.length, b: "q" };
    const o: P = { ...base, b: base.b + row[0] };
    [a, b] = [b, a + row.length];
    out += o.a + o.b + a + "," + b + " ";
  }
  return out;
}

function closures(rows: string[][]): string {
  let total = "";
  for (let k = 0; k < rows.length; k++) {
    let s = "";
    rows[k].forEach((x, i) => {
      s += x + i;
    });
    const parts = rows[k].map((x) => x + "!");
    total += s + "/" + parts.join("") + " ";
  }
  return total;
}

const tail = "x".repeat(3000);
for (let round = 0; round < 3; round++) {
  const rows: string[][] = [["a", "bb"], view(), ["ccc"]];
  console.log(concat(rows));
  console.log(concatAssign(rows));
  console.log(grow(rows, tail));
  console.log(tags(rows));
  console.log(counter(rows));
  console.log(counterInside(rows));
  console.log(literals(rows));
  console.log(inner(rows));
  console.log(stored(rows));
}
const first: string[][] = [view(), ["p"], view()];
console.log(concat(first), tags(first), counter(first), grow(first, "yy"));
const mixed: string[][] = [["a", "bb"], view(), ["ccc"]];
console.log(nested(mixed));
console.log(whileLoop(mixed));
console.log([...gen(mixed)].join(" "));
console.log(tryLoop(mixed));
console.log(spreads(mixed));
console.log(closures(mixed));
asyncLoop(mixed).then((s) => console.log(s));
