// Generated code may not set a readonly field of a value given to it, nor of a local that holds
// one: only of the value it builds (generated_readonly_built.vlt).
import { setCopy, setParam } from "./_readonly_generators";

type R = { readonly id: i64 };

function main() {
  const r: R = { id: 1 };
  console.log(setParam<R>(r).id, setCopy<R>(r).id);
}
