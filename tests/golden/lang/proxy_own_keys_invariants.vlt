// Node's checks on what an `ownKeys` trap answers: each key a string or a symbol, at most once.
function keysOf(answer: any): void {
  const p = new Proxy(
    {},
    {
      ownKeys() {
        return answer;
      },
    },
  );
  console.log(Reflect.ownKeys(p));
}

function main(): void {
  keysOf(["a", "b"]);
  keysOf(["a", "a"]);
  console.log("not reached");
}
