// check: no leaks
// Semantics stage 2: `Map` (and `Set`) keys of struct and object-literal type compare by
// identity, as `==` compares them (#1257): an equal but distinct key is another key, and a key
// passed on (shared) is the same one. Tuple keys compare part by part, as `==` compares tuples.
struct P {
  x: i64;
  y: i64;
}

function main() {
  const byPoint = new Map<P, string>();
  const p = P { x: 1, y: 2 };
  byPoint.set(p, "a");
  byPoint.set(P { x: 1, y: 2 }, "b");
  console.log(byPoint.get(p), byPoint.has(P { x: 1, y: 2 }), byPoint.size);
  const byObject = new Map<{ name: string }, i64>();
  const ann = { name: "ann" };
  byObject.set(ann, 1);
  console.log(byObject.get(ann), byObject.delete({ name: "ann" }), byObject.size);
  console.log(byObject.delete(ann), byObject.size);
  const byPair = new Map<[i64, string], bool>();
  byPair.set([1, "x"], true);
  console.log(byPair.has([1, "x"]), byPair.has([1, "y"]));
}
