// check: no leaks
// A spawned closure keeps a function parameter of a closure: the function passed to the
// closure owns its environment, which the task gets a copy of.
function start(use: (cb: (x: i64) => void) => void) {
  const tag = "t".repeat(3);
  let n = 1;
  use((x) => console.log(tag, x, n));
  n = 2;
}

async function main() {
  const tasks: Promise<void>[] = [];
  start((cb) => {
    tasks.push(
      spawn(async () => {
        cb(1);
      }),
    );
  });
  await Promise.all(tasks);
}
