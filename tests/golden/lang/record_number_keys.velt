// `Record<number, V>` and `Record<string | number, V>`: JavaScript makes a number key its
// string, so the record holds string keys (array indices first, ascending) and `r[n]` reads
// and writes `r[String(n)]`.
const table: Record<number, string> = {};
const ids = [30, 2, 10];
for (const id of ids) table[id] = "rec" + id;
table[1.5] = "half";
console.log(table, Object.keys(table), JSON.stringify(table));
console.log(table[2], table[10], table[99], 10 in table, 7 in table);
delete table[2];
console.log(Object.entries(table));
for (const k in table) console.log(typeof k, k);

const patch: Record<number, { id: number }> = {};
const record = { id: 4 };
patch[record.id] = record;
console.log(patch, patch[4]?.id);

function assignment(name: string, values: Record<string | number, unknown>): string {
  return `${name}=${JSON.stringify(values)}`;
}
console.log(assignment("a", { b: 1, 0: "zero" }));
const mixed: Record<string | number, number> = { x: 1 };
mixed[3] = 3;
mixed["y"] = 2;
const n = -0;
mixed[n] = 0;
console.log(mixed, mixed[3], mixed["3"]);

// A `number` index signature is the same record.
interface ById {
  [id: number]: string;
}
const byId: ById = {};
byId[2] = "b";
byId[0] = "a";
const scores: { [k: number]: number } = { 1: 5, 0.5: 1 };
console.log(byId, byId[0], scores[1], scores[0.5], Object.values(scores));

// Keys as `String` spells the number; `??=` and reads keyed by an expression.
const counts: Record<number, number> = {};
for (const k of [5, -1, 0, 1.5, 1e21, -0, 4294967294, 4294967295, 10]) {
  counts[k] = (counts[k] ?? 0) + 1;
}
counts[5] ??= 100;
counts[6] ??= 60;
console.log(Object.keys(counts), counts[0], counts[5], counts[6]);
const groups: Record<number, string[]> = {};
for (const i of [3, 1, 2]) {
  (groups[i % 2] ??= []).push("v" + i);
}
console.log(groups);
const special: Record<string | number, boolean> = {};
special[NaN] = true;
special["NaN"] = false;
special[Infinity] = true;
console.log(special);
