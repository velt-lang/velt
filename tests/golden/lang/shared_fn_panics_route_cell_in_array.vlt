// A cell in an array the function captured: each call's copy would still share it.
type F = (x: i64) => i64;

// `n` is assigned outside the closure too, so it lives in a cell the function holds.
function mk(): F {
  let n: i64 = 0;
  const g = (x: i64): i64 => {
    n += 1;
    return n;
  };
  n = 0;
  return g;
}

async function main() {
  const fs = [mk()];
  const f = shared((x: i64): i64 => fs[0](x));
  console.log(f(1));
}
