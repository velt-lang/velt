// check: no leaks
// Compound assignments adapt integer types like the binary operators do (#421): a length or size
// (a JS number held as a `usize`) added to a local or field declared from an integer literal.

class Counter {
  count = 0;

  add(s: string) {
    this.count += s.length;
  }
}

async function tick(): Promise<void> {}

async function lengths(xs: string[]): Promise<number> {
  let total = 0;
  for (const x of xs) {
    await tick();
    total += x.length;
  }
  return total;
}

async function main() {
  let total = 0;
  for (const p of ["a", "bc"]) {
    total += p.length;
  }
  console.log(total);

  let sum = 0;
  for (const p of ["a", "bc"]) {
    sum = sum + p.length;
  }
  console.log(sum);

  let t = 100;
  t -= [1, 2, 3].length;
  t *= "ab".length;
  t %= "abcdefg".length;
  console.log(t);

  const m = new Map<string, number>();
  m.set("x", 1);
  m.set("y", 2);
  let bits = 1;
  bits += m.size;
  bits <<= m.size;
  bits |= "a".length;
  bits **= "ab".length;
  console.log(bits);

  const c = new Counter();
  c.add("hello");
  c.add("hi");
  console.log(c.count);

  const counts = [0, 0];
  counts[1] += "abc".length;
  console.log(counts[1]);

  let f = 0.5;
  f += "abc".length;
  console.log(f);

  let k: i64 = 5;
  k -= "abc".length;
  console.log(k);

  const small: i32 = 7;
  let n = 1;
  n += small;
  console.log(n);

  console.log(await lengths(["ab", "cde"]));
}
