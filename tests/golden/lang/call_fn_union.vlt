// Calling a value whose type is a union of function types with the same parameters: the call
// runs whichever function the value holds, and its result is the union of their results. A
// `void` member makes it `T | null` (awaiting it then gives `void`).

import { delay } from "velt:timers";

type Handler = (() => void) | (() => Promise<void>);
type Format = ((n: number) => string) | ((n: number) => number);

async function run(name: string, h: Handler) {
  console.log(`${name}: start`);
  await h();
  const r = h();
  console.log(`${name}: ${r instanceof Promise ? "returned a promise" : "returned nothing"}`);
  if (r instanceof Promise) {
    await r;
  }
}

function show(f: Format, n: number): string {
  const v = f(n);
  return typeof v === "string" ? `text ${v}` : `number ${v}`;
}

async function main() {
  let count = 0;
  await run("sync", () => {
    count++;
  });
  await run("async", async () => {
    await delay(1);
    count += 10;
  });
  console.log(`count ${count}`);
  console.log(show((n) => `#${n}`, 3), show((n) => n * 2, 3));
}
