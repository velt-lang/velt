// check: no leaks
// Computed keys in object patterns naming module constants, module variables (read when the
// pattern runs), symbols and an outer function's local, on records, objects, interfaces and
// classes. Expected output: Node's.
const K2 = "a";
let KL = "b";
const SYM = Symbol("s");

interface I {
  a: number;
  b: string;
  [SYM]: number;
}

class C {
  a = 5;
  b = "cb";
}

function run(): void {
  const r: Record<string, number> = { a: 1, b: 2 };
  const { [K2]: v = 0 } = r;
  const { [KL]: w = 0 } = r;
  console.log(v, w);
  const o = { a: 3, b: "x" };
  const { [K2]: oa } = o;
  const i: I = { a: 4, b: "ib", [SYM]: 9 };
  const { [K2]: ia, [SYM]: is } = i;
  const { [K2]: ca } = new C();
  console.log(oa, ia, is, ca);
  const k = "b";
  function inner(): number {
    const { [k]: x = -1 } = r;
    return x;
  }
  console.log(inner());
  // A nested function that captures nothing but the key.
  console.log(onlyKey());
  let p = 0;
  ({ [K2]: p } = o);
  console.log(p);
  // A module `let` is read when the pattern runs, not where it is declared.
  KL = "a";
  const { [KL]: w2 = 0 } = r;
  const lit = { [KL]: 6 };
  console.log(w2, lit);
}

const R2: Record<string, number> = { a: 1, b: 2 };

function onlyKey(): number {
  const KK = "b";
  function inner(): number {
    const { [KK]: x = 0 } = R2;
    return x;
  }
  function param({ [KK]: y = 0 }: Record<string, number>): number {
    return y;
  }
  function assign(): number {
    let z = 0;
    ({ [KK]: z = 9 } = R2);
    return z;
  }
  return inner() * 100 + param(R2) * 10 + assign();
}

function main(): void {
  run();
}
