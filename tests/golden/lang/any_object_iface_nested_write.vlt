// A field holding an object a plain assignment keeps as the interface field's type is that
// object (#1886): a write into a part of it through the interface changes the literal's, as in
// Node. One of another layout two levels deep converts as that assignment does: read as a
// copy, written whole.
interface Deep {
  w: number;
}

interface Inner {
  v: number;
}

interface Outer {
  v: number;
  deep: Deep;
}

interface Ctx {
  x: number;
  inner: Inner;
  run(): void;
}

interface Ctx2 {
  outer: Outer;
  run(): void;
}

const init = { x: 1, inner: { v: 1 }, run: () => console.log("run") };
const c = init as unknown as Ctx;
c.inner.v = 2;
c.run();
console.log(init.inner.v, c.inner.v);
c.inner = { v: 3 };
console.log(init.inner.v);

const two = { outer: { v: 1, deep: { w: 1 } }, run: () => {} };
const d = two as unknown as Ctx2;
console.log(d.outer.v, d.outer.deep.w);
two.outer.deep.w = 4;
console.log(d.outer.deep.w);
d.outer = { v: 5, deep: { w: 6 } };
console.log(two.outer.v, two.outer.deep.w);
