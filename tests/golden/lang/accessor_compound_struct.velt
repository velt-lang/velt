// Accessors of a class updated through an element read with side effects (a struct before
// #641, whose fields are now readonly): the element is updated in place, its index evaluated
// once.
class P {
  x: i64;

  constructor(x: i64) {
    this.x = x;
  }

  get double(): i64 {
    return this.x * 2;
  }
  set double(v: i64) {
    this.x = v / 2;
  }
}

function idx(i: i64): i64 {
  console.log("idx");
  return i;
}

function main() {
  const ps = [new P(1), new P(5)];
  ps[idx(1)].double += 2;
  ps[0].double++;
  let p = new P(3);
  p.double += 4;
  console.log(ps[0].x, ps[1].x, p.x);
}
