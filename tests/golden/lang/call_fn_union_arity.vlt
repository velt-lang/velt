// Calling a union of function types that take different numbers of parameters: the call
// passes the longest member's arguments, and a shorter member ignores the extra ones. Every
// argument is evaluated, in order, as in JavaScript.

type F = ((a: number) => string) | (() => string);

function call(f: F): string {
  return f(1);
}

type G = ((a: string, b: number) => void) | ((a: string) => void) | (() => void);

function next(label: string): number {
  console.log(`evaluated ${label}`);
  return label.length;
}

function name(label: string): string {
  console.log(`evaluated ${label}`);
  return label;
}

function run(g: G) {
  g(name("a"), next("b"));
}

type N = ((a: number, b: number) => void) | ((a: number) => void);
type S = ((a: string, b: string) => void) | ((a: string) => void);

// A variable passed before an argument that assigns it passes its old value.
function assigning(n: N, s: S) {
  let a = 1;
  n(a, (a = 2));
  let w = "x";
  s(w, (w = "y"));
}

function main() {
  console.log(call((a: number) => `a${a}`), call(() => "none"));
  run((a: string, b: number) => console.log(`two: ${a} ${b}`));
  run((a: string) => console.log(`one: ${a}`));
  run(() => console.log("none"));
  const label = "x";
  const h: G = (a: string) => console.log(a.length);
  h(label, 2);
  assigning(
    (a: number, b: number) => console.log("two", a, b),
    (a: string, b: string) => console.log("two", a, b),
  );
  assigning(
    (a: number) => console.log("one", a),
    (a: string) => console.log("one", a),
  );
}
