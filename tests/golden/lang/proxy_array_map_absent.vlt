// `map` of a proxy of an array whose `has` trap hides an element (#823): Node keeps a hole in
// the new array, which Velt's arrays cannot have yet (`filter` skips it, in Node too).
const p: any = new Proxy([1, 2, 3] as any, {
  has(t: any, k: string | symbol): boolean {
    return k !== "1" && Reflect.has(t, k);
  },
});
const f: any = p.filter(() => true);
console.log(JSON.stringify(f), f.length);
const m: any = p.map((x: any) => x);
console.log("not reached", JSON.stringify(m));
