// With proxies in the program, the conversion in a generic constructor is a view.
const made = new Proxy({}, {});
type W = { a: number; b: number };
type N = { a: number };
class Box<T> { v: T; constructor(x: any) { this.v = x; } get(): T { return this.v; } }
function main() {
  const p: any = Object.create(null);
  p.a = 1; p.b = 2;
  const q: N = new Box<W>(p).get();
  p.a = 5;
  console.log(q.a, p.a);
}
main();
