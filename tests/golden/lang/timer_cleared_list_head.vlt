// check: no leaks
// Clearing the first timer of a delay list leaves the list's expiry where it was, as in Node:
// the loop wakes then, finds the list's next timer not due, and gives the list a new place. A
// timer of another list due in between runs on time, before it (`C` before `B`), whether the
// cleared timer was a timeout or an interval. Each `B` is due 100 ms after its list's expiry,
// so a loop that wakes up to 100 ms late still prints the same.
function busy(ms: number) {
  const s = Date.now();
  while (Date.now() - s < ms) {}
}

function intervalVariant() {
  const a = setInterval(() => console.log("never interval A"), 200);
  setTimeout(() => console.log("interval: C 210"), 210);
  busy(100);
  setTimeout(() => console.log("interval: B 200 (due 300)"), 200);
  clearInterval(a);
}

function main() {
  const a = setTimeout(() => console.log("never A"), 200);
  setTimeout(() => console.log("timeout: C 210"), 210);
  busy(100);
  setTimeout(() => {
    console.log("timeout: B 200 (due 300)");
    intervalVariant();
  }, 200);
  clearTimeout(a);
  console.log("main end");
}
