// Namespaces of types: qualified names, members naming each other without the namespace,
// nested and dotted namespaces, `declare namespace`, blocks of one namespace merging, a
// namespace merged with an interface, and namespaces imported by name and re-exported.
import type { Define, Shape } from "./_namespaces_reexport.vlt";
import * as lib from "./_namespaces_lib.vlt";

namespace Geo {
  export interface Point {
    x: number;
    y: number;
  }

  // Not exported: visible inside `Geo` only.
  type Pair = [Point, Point];
  export type Segment = { ends: Pair; length: number };

  export namespace Grid {
    export type Cell = { at: Point; label: string };
  }
}

namespace Geo {
  export type Path = Point[];
}

declare namespace Units {
  type Meters = number;
}

namespace App {
  export namespace Config {
    export namespace Keys {
      export type Name = "debug" | "verbose";
    }
  }
}

interface Settings {
  name: App.Config.Keys.Name;
}

namespace Settings {
  export type Defaults = { name: App.Config.Keys.Name; level: number };
}

function length(a: Geo.Point, b: Geo.Point): Units.Meters {
  return Math.hypot(b.x - a.x, b.y - a.y);
}

const a: Geo.Point = { x: 0, y: 0 };
const b: Geo.Point = { x: 3, y: 4 };
const seg: Geo.Segment = { ends: [a, b], length: length(a, b) };
const cell: Geo.Grid.Cell = { at: b, label: "B" };
const path: Geo.Path = [a, b, a];
const s: Settings = { name: "debug" };
const d: Settings.Defaults = { name: "verbose", level: 2 };
console.log(seg.length, seg.ends[1].y, cell.label, path.length, s.name, d.name, d.level);

const p: Define.Prop<"size", number> = { name: "size", value: 3 };
const pair: lib.Define.Pair<string> = [
  { name: "first", value: "a" },
  { name: "second", value: "b" },
];
const shape: Shape = { kind: "square" };
const circle: Shape.Circle = { kind: "circle", r: 2 };
console.log(p.name, p.value, pair[1].value, shape.kind, circle.kind, circle.r);
