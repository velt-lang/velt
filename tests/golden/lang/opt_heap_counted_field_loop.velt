// An object with a counted pointer field, built and dropped in a loop, leaves the heap in a
// release build: its field is dropped through a copy, not through the object's address
// (crates/veltc/tests/opt_heap_vir.rs checks the VIR). The loop's length comes from the
// arguments so that nothing folds it away.
class Res {
  id: number;
  constructor(id: number) {
    this.id = id;
  }
}

class Holder {
  res: Res | null;
  k: number;
  constructor(res: Res | null, k: number) {
    this.res = res;
    this.k = k;
  }
}

function sum(n: number, shared: Res): number {
  let s = 0;
  for (let i = 0; i < n; i++) {
    const h = new Holder(shared, i);
    const r = h.res;
    s += h.k + (r == null ? 0 : r.id);
  }
  return s;
}

function main() {
  const n = process.argv.length * 10;
  console.log(sum(n, new Res(1)) == (n * (n - 1)) / 2 + n);
}
