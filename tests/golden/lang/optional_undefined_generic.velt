// check: no leaks
// `x === null` and `x == null` on an option of a type parameter (`x?: T`, `x: T | undefined`)
// are tested for the type it is instantiated with: at `T = string | null` the value may be
// `null` too (#930 phase 2). Expected output from Node 22.

function g<T>(x?: T): string {
  if (x === null) return "null";
  if (x == null) return "nullish";
  return "val";
}

function h<T>(x: T | undefined): string {
  if (x === null) return "null";
  if (x === undefined) return "undef";
  return x != null ? "val" : "?";
}

function notNull<T>(x?: T): boolean {
  return x !== null;
}

function main() {
  console.log(g<string | null>(null), g<string>(), g<number>(1), g<string | null>("s"));
  console.log(h<string | null>(null), h<string>(undefined), h<number>(2), h<string | null>(undefined));
  console.log(notNull<number | null>(null), notNull<number>(), notNull<number | null>(3));
}
