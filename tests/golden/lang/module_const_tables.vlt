// A module constant that is an array of number or boolean literals is a table: stored once as
// read-only data and read where it is used (index, length, iteration, passing to a function
// that only reads). Copies of it (`slice`, `clone`, spread) are ordinary arrays.
const K: u32[] = [0x428a2f98, 0x71374491, 4294967295];
const SMALL: u8[] = [1, 2, 255];
const NEG: i16[] = [-1, -32768, 32767];
const F: f64[] = [0.5, -1.25, 3];
const N: number[] = [1, 2.5, -3];
const SINGLE: f32[] = [0.1, 16777217];
const FLAGS: bool[] = [true, false, true];
const ONE: i64 = 7;
const WITH: i64[] = [ONE, -5, 300 as i64, -9223372036854775808];
const CAST: u8[] = [300 as u8, 65 as u8, 3.9 as u8];
const EMPTY: u8[] = [];
const BIG: u64[] = [18446744073709551615, 1];
const WIDE: i64 = 16777217;
const ROUNDED: f64[] = [WIDE as f32 as f64, 33554435 as u32 as f32 as f64, true as u8 as f64];

function sum(xs: u32[]): u64 {
  let s: u64 = 0;
  for (const x of xs) {
    s += x as u64;
  }
  return s;
}

function at(i: usize): u32 {
  return K[i];
}

// What receives a table as a value gets an array of its own: writing to that one, in ways the
// compiler does not follow (through a function value), leaves the table as it was.
function scribble(write: (xs: u32[]) => void) {
  write(K);
}

function main() {
  console.log(K.length, K[0], K[2], at(1), sum(K));
  console.log(SMALL, NEG, F, N, SINGLE, FLAGS, WITH, CAST, EMPTY, BIG);
  let total = 0.0;
  for (const x of N) {
    total += x;
  }
  console.log(total, EMPTY.length, FLAGS[1], WITH[0] + WITH[1]);
  const copy = K.slice();
  copy.push(1);
  copy[0] = 2;
  console.log(copy, K);
  const own = SMALL.clone();
  own.reverse();
  console.log(own, SMALL, SMALL.includes(255), SMALL.indexOf(2), K.map((x) => x >> 28));
  console.log(NEG.join("/"), [...SMALL, 9], SMALL.concat(CAST));
  console.log(ROUNDED);
  const write = (xs: u32[]) => {
    xs[0] = 9;
    xs.push(10);
    xs.reverse();
    console.log(xs);
  };
  write(K);
  scribble(write);
  console.log(K, sum(K));
}
