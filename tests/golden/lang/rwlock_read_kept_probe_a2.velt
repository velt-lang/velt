// check: no leaks
// An RwLock read probe (#1559): prints what Node prints.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Holder {
  rows: number[][] = [];
}
function main() {
  const a = new RwLock(new Box());
  let out: number[][][] = [];
  a.read((x) => {
    const c: number[][] = [[1]];
    out.push(c);
    out = [];
    c.push([2]);
    out.push(c);
    console.log(JSON.stringify(c));
  });
  console.log(JSON.stringify(out));
}
