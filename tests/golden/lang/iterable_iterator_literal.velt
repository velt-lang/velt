// An object literal implementing `IterableIterator<T>` with `next()` next to a
// `[Symbol.iterator]()` that returns `this` (#1136), as wrapping iterators do: the literal is the
// iterator, so a loop over it continues where `next()` left off.
function wrap(inner: IterableIterator<number>, scale: number): IterableIterator<number> {
  return {
    next() {
      const { value, done } = inner.next();
      if (done) {
        return { value: undefined, done: true };
      }
      return { value: value * scale, done: false };
    },
    [Symbol.iterator]() {
      return this;
    }
  };
}
function pairs(inner: IterableIterator<[string, number]>): IterableIterator<[string, number]> {
  let count = 0;
  return {
    next() {
      const { value, done } = inner.next();
      if (done) {
        return { value: undefined, done: true };
      }
      const [k, v] = value;
      count++;
      return { value: [k.toUpperCase(), v + count] as [string, number], done: false };
    },
    [Symbol.iterator]() {
      return this;
    },
  };
}
function* nums(xs: number[]): Generator<number> {
  for (const x of xs) yield x;
}
function* entries(m: Map<string, number>): Generator<[string, number]> {
  for (const e of m) yield e;
}
for (const v of wrap(nums([1, 2, 3]), 10)) console.log(v);
const it = wrap(nums([4, 5, 6]), 2);
console.log(it.next().value);
for (const v of it) console.log("rest", v);
const m = new Map<string, number>([["a", 1], ["b", 2]]);
for (const [k, v] of pairs(entries(m))) console.log(k, v);
const p = pairs(entries(m));
console.log(p[Symbol.iterator]() === p, [...p].length);

// Generator iterator methods next to other members of an interface extending `Iterable<T>`
// or `AsyncIterable<T>`.
interface Bag extends Iterable<number> {
  size(): number;
}
function bag(xs: number[]): Bag {
  return {
    size() {
      return xs.length;
    },
    *[Symbol.iterator]() {
      for (const x of xs) yield x * 2;
    },
  };
}
const b = bag([1, 2, 3]);
console.log(b.size(), [...b].join(","));
interface Feed extends AsyncIterable<string> {
  name: string;
}
const feed: Feed = {
  name: "feed",
  async *[Symbol.asyncIterator]() {
    yield "a";
    yield "b";
  },
};
async function run() {
  for await (const s of feed) console.log(feed.name, s);
}
run();
