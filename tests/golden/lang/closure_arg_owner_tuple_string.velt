// A string read once out of an element that the loop shares, and used after the element is gone (#2527). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; }
const KK = (q: A2) => { q.c = new I2(); q.c.s = heap("zzzzzzzz"); q.xs = []; junk(); };
const w = (q: [string, number][]) => { q[0] = [heap("zzzzzzzz"), 2]; junk(); };
function t() {
  const ps: [string, number][] = [[heap("a"), 1]];
  for (const [s, n] of ps) { w(ps); junk(); console.log(s, n); }
}
t();
