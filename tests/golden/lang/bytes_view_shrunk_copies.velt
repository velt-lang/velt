// Copies and views of a `u8[]`'s view whose array became shorter than the view: `slice`,
// `subarray`, `with`, `toReversed` and `toSorted` take the elements that are left (`length`),
// as JS takes a typed array's `length`. Velt-only: a Node `Buffer` cannot shrink.
function main() {
  const b: u8[] = Buffer.alloc(48);
  for (let i = 0; i < 48; i++) b[i] = (47 - i) as u8;
  const v = b.subarray(8, 40);
  const w = new Uint32Array(v.buffer, 16, 4);
  console.log(v.length, w.length);

  // 12 of `v`'s 32 bytes are left, and 4 of `w`'s 16 (one element).
  b.length = 20;
  console.log(v.length, w.length);
  console.log(v.slice(0, 4).join(), v.slice().length, v.slice(-2).join());
  console.log(v.subarray(2).length, v.subarray(0, 4).join(), v.subarray(10, 100).join());
  console.log(v.with(0, 99).join(), b[8]);
  console.log(v.toReversed().join());
  console.log(v.toSorted().join());
  console.log(w.slice().join(), w.subarray(1).length, w.with(0, 1).join(), w.with(-1, 2).join());

  // Nothing is left of either.
  b.length = 4;
  console.log(v.length, v.slice(0, 4).length, v.subarray(0, 4).length, w.slice().length, w.subarray(1).length);
  console.log(v.toReversed().length, w.toSorted().length);
  try {
    w.with(0, 1);
  } catch (e) {
    console.log(e.message);
  }
}
