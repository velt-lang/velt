// check: no leaks
// An async method owns its `this`, so a local's last use as the receiver of a virtual call
// moves it into the call. The vtable entry borrows the receiver and its thunk takes another
// reference for the future (#194), so the moved reference must be dropped after the call; it
// used to leak the object.
class Machine {
  name: string = "a machine name long enough to live on the heap";
  runs: i64 = 0;

  async run(): Promise<i64> {
    this.runs += 1;
    return this.runs;
  }
}

class Press extends Machine {
  override async run(): Promise<i64> {
    return (await super.run()) * 10;
  }
}

async function go(m: Machine): Promise<i64> {
  return await m.run(); // the parameter's last use
}

async function main() {
  const m: Machine = new Press();
  console.log(await m.run()); // the local's last use
  const p = new Press();
  console.log(await p.run(), await p.run()); // a concrete receiver, still a virtual call
  console.log(await go(new Press()), await go(new Machine()));
  const kept = new Press();
  console.log(await go(kept), kept.runs);
}
