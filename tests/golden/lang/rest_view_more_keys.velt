// A rest of a view whose object has keys its type lacks stops, as a spread does: Node copies them.
const made = new Proxy({}, {});
function viewed<T>(x: T) { return x as { a?: number; b?: string } | null; }
const v = viewed({ a: 1, b: "s", c: 2 });
console.log(v?.b);
if (v) {
  const { a, ...r } = v;
  console.log(a, r);
}
console.log("after");
