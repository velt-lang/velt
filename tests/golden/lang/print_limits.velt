// console.log stops where node's util.inspect stops (#497): containers nested deeper than two
// levels print as `[Object]`, `[Array]`, `[Name]`, `[Map]`, `[Promise]` (empty ones in full),
// and an array or Map shows its first 100 entries, then `... n more items`. A reference back
// to an object being printed is still `[Circular *N]` past the limit; an object cut off there
// gets no `<ref *N>`. Output identical to node's.

class Point {
  x: number;
  y: number;
  constructor(x: number, y: number) {
    this.x = x;
    this.y = y;
  }
}

class Empty {}

class Animal {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
}

class Dog extends Animal {
  friend: Animal | null = null;
  constructor(name: string) {
    super(name);
  }
}

class Node {
  name: string;
  child: Node | null = null;
  constructor(name: string) {
    this.name = name;
  }
}

class Square {
  side: number;
  inner: { p: Point };
  constructor(side: number) {
    this.side = side;
    this.inner = { p: new Point(side, side) };
  }
  area(): number {
    return this.side * this.side;
  }
}

function range(n: number): number[] {
  const out: number[] = [];
  for (let i = 0; i < n; i++) {
    out.push(i);
  }
  return out;
}

async function settled(): Promise<number> {
  return 7;
}

async function main() {
  // Depth 3 and 4.
  console.log({ a: { b: { c: { d: 1 } } } });
  console.log({ a: { b: { c: { d: { e: 1 } } } } });
  console.log([[[[1, 2]]]]);
  console.log([[[[]]]]);
  const none: number[] = [];
  console.log({ l1: { l2: { empty: {}, list: none, full: [1], e: new Empty() } } });
  console.log({ l1: { l2: { p: new Point(1, 2), m: new Map<string, number>([["k", 1]]) } } });
  console.log({ l1: { l2: { m: new Map<string, number>() } } });
  console.log([{ points: [new Point(1, 2), new Point(3, 4)] }]);
  console.log([[{ p: new Point(5, 6) }]]);
  const t: [number, [string, [boolean, [number]]]] = [1, ["a", [true, [2]]]];
  console.log(t);

  // Long arrays and maps.
  console.log(range(100));
  console.log(range(101));
  console.log(range(1000));
  console.log({ list: range(150) });
  const words: string[] = [];
  for (let i = 0; i < 103; i++) {
    words.push("w" + "x".repeat(i % 7));
  }
  console.log(words);
  const m = new Map<number, number>();
  for (let i = 0; i < 150; i++) {
    m.set(i, i * 2);
  }
  console.log(m);
  const m101 = new Map<number, string>();
  for (let i = 0; i < 101; i++) {
    m101.set(i, "v");
  }
  m101.delete(3);
  m101.set(500, "late");
  console.log(m101);
  const grid: number[][] = [];
  for (let i = 0; i < 102; i++) {
    grid.push([i, i + 1]);
  }
  console.log(grid);
  const objects: Point[] = [];
  for (let i = 0; i < 101; i++) {
    objects.push(new Point(i, i * 2));
  }
  console.log([objects]);

  // Classes, subclasses through a base type, interface values.
  const rex = new Dog("rex");
  const spot = new Dog("spot");
  rex.friend = spot;
  spot.friend = new Dog("fido");
  const pets: Animal[] = [rex];
  console.log({ pets });
  const pet: Animal = spot;
  console.log({ a: { b: { pet } } });
  console.log([[new Square(2)]]);

  // Cycles: a reference back past the limit is still circular; an object cut off there is
  // not numbered.
  const n = new Node("n");
  n.child = new Node("c1");
  n.child.child = new Node("c2");
  n.child.child.child = n;
  console.log(n);
  const deep = new Node("deep");
  deep.child = new Node("d1");
  deep.child.child = new Node("d2");
  deep.child.child.child = new Node("d3");
  deep.child.child.child.child = deep;
  console.log(deep);
  // A long chain prints its first levels (it used to overflow the stack).
  const chain = new Node("l0");
  let last = chain;
  for (let i = 1; i < 2500; i++) {
    const next = new Node(`l${i}`);
    last.child = next;
    last = next;
  }
  console.log(chain);
  const self = new Node("self");
  self.child = self;
  const nested: Node[][][] = [[[self]]];
  console.log(nested);
  const mixed: (Node | Node[])[][] = [[self, [self]]];
  console.log(mixed);

  // Promises count as a level.
  console.log({ a: { b: { p: settled() } } });
  console.log([settled()]);
  console.log([[settled()]]);
}
