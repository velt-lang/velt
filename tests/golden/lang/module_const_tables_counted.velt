// check: heap blocks at most 8
// A table passed to a function that only reads its parameter reads its stored data also where
// the program shares arrays of its type, which makes them counted boxes: nothing is allocated
// per use (#3015). The blocks are the shared array (its box and buffer, grown once), the two
// holders and the string of `join`.
import { u32x4 } from "velt/simd";

const TABLE: u32[] = [10, 20, 30, 40, 50, 60, 70, 80];

function sum(xs: u32[]): u32 {
  let s: u32 = 0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

function count<T>(xs: T[]): number {
  return xs.length;
}

function via(xs: u32[]): u32 {
  return sum(xs) + 1;
}

class Holder {
  xs: u32[];
  constructor(xs: u32[]) {
    this.xs = xs;
  }
}

function main() {
  // Two objects holding one array: `u32[]` values are counted boxes in this program.
  const a: u32[] = [1, 2];
  const h1 = new Holder(a);
  const h2 = new Holder(a);
  h1.xs.push(3);
  let total: u64 = h2.xs.length as u64;
  for (let i = 0; i < 1000; i++) {
    total += sum(TABLE) as u64;
    total += via(TABLE) as u64;
    total += count(TABLE) as u64;
    total += TABLE.indexOf(40) as u64;
    total += TABLE.includes(70) ? 1 : 0;
    total += u32x4.load(TABLE, 4).lane(1) as u64;
  }
  console.log(total, TABLE.join("-"));
}
