/** @jsxImportSource ./_jsx_hono */
// A runtime shaped like Hono's and Preact's: its exports beside `jsx` and `jsxs` change nothing.
import { Fragment, type Node } from "./_jsx_hono/jsx-runtime";

function show(v: any): string {
  if (v === null || v === undefined || typeof v !== "object") return String(v);
  if (Array.isArray(v)) return "[" + v.map((x: any) => show(x)).join(",") + "]";
  const n = v as Node;
  const keys = Object.keys(n.props).map((k: string) => k + "=" + show(n.props[k])).join(" ");
  const tag = n.tag === Fragment ? "Fragment" : typeof n.tag === "function" ? "fn" : String(n.tag);
  return n.via + "(" + tag + " {" + keys + "} " + String(n.key) + ")";
}

function Card(p: { title: string; children?: any }): any {
  return <div title={p.title}>{p.children}</div>;
}

console.log(show(<div id="a" />));
console.log(show(<anything goes="here" n={1} data-x="y">text</anything>));
console.log(show(<ul>{1}{2}</ul>));
console.log(show(<>one</>));
console.log(show(<>{1}{2}</>));
console.log(show(<div key="k" />));
const card = <Card title="t">{1}{2}</Card>;
console.log(show(card));
console.log(show((card.tag as any)(card.props)));
const f = <>made</>;
console.log(show((f.tag as any)(f.props)));
