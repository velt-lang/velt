// Floats that reach `${x}` and `String(x)` in a module the float-printer trigger skips
// (_float_text_miss_lib.vlt): a parameter and a field. They are printed by the runtime's printer
// there (crates/veltc/tests/number_format_vir.rs checks that path) and must still print what Node
// prints; whole numbers take std's integer printing.

import { alone, Box, show } from "./_float_text_miss_lib";

function main() {
  const third = 1 / 3;
  const values = [1.5, third, 42, -7, 0.1 + 0.2, -0.0, 1e21, 5e-324, 123456789.125, -1e-7];
  for (const x of values) {
    console.log(show(x), alone(x), new Box(x).text());
  }
}
