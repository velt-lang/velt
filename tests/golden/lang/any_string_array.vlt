// `String(x)`, template literals and string `+` of an `any`, `unknown` or `object`: an array as
// JavaScript's `Array.prototype.toString` writes it (#1435), an object as its `toString()` or
// `Object.prototype.toString` (`[object Object]`), never as `console.log` prints it.
class T {
  toString(): string {
    return "T!";
  }
}
class Sub extends T {}
class N {
  x = 1;
}
function main(): void {
  const a: any = [1, 2];
  console.log(String(a), "" + String([3, 4]));
  const u: unknown = [5];
  console.log(String(u), `${a}`, "x" + a, a + "y");
  const n: any = [[1, 2], [3, [4, 5]], [], null, undefined, "s", true];
  console.log(String(n));
  const z: any = -0;
  console.log(String(z), `${z}`, [z].length);
  const m: any = [-0, 1.5, NaN];
  console.log(`${m}`);
  const o: object = ["o", 1];
  console.log(String(o));
  const vals: any[] = [{ a: 1 }, new T(), new Sub(), new N(), new Error("boom"), new Map<string, number>()];
  for (const v of vals) console.log(String(v), `${v}`, "<" + v + ">");
  const ts: any[] = [new T(), new N(), { b: 2 }];
  const ta: any = ts;
  console.log(String(ta));
  const r: any = { k: 1 } as Record<string, number>;
  console.log(`${r}`);
}
