// A write to a frozen object seen as a type whose fields can be written throws Node's
// `TypeError`, uncaught here: the object carries a frozen mark (#2623, before #2554 refused it),
// here directly.
interface Desc { kind: string; anon: boolean; }
const d: Desc = Object.freeze({ kind: "fn", anon: true });
d.anon = false;
console.log(d.anon);
