// A rest parameter typed by a type parameter (`...args: A`, `A extends unknown[]`) in a
// callback's type, inferred from a callback that lists its parameters one by one, as TypeScript
// does: `(rq: Ctx, a: number, b: number) => …` gives `A = [number, number]`. Also parameters of
// different types, and none at the rest position (`A = []`). tsc accepts it, and Node prints
// the same.
interface Ctx {
  id: string;
}

function resultOf<A extends unknown[], R>(f: (rq: Ctx, ...args: A) => R, fallback: R): R {
  console.log(typeof f);
  return fallback;
}

function named(rq: Ctx, a: boolean): string {
  return rq.id + (a ? "T" : "F");
}

function main(): void {
  const sum: number = resultOf((rq: Ctx, a: number, b: number): number => a + b, 3);
  const tag: string = resultOf((rq: Ctx, name: string, n: number): string => rq.id + name + n, "x3");
  const none: string = resultOf((rq: Ctx): string => rq.id, "rq");
  // The first parameter typed by the context, as TypeScript code usually writes it.
  const ctx: number = resultOf((rq, a: number, b: number): number => a + b + rq.id.length, 5);
  console.log(sum, tag, none, ctx);
  // Parameters without types at the rest position (`A = [unknown]`), a function value and a
  // declared function.
  const loose: number = resultOf((rq, a) => 1, 0);
  const typed: number = resultOf((rq: Ctx, a, b) => 1, 0);
  const h = (rq: Ctx, a: number, s: string): string => rq.id + a + s;
  const fromValue: string = resultOf(h, "a1s");
  const fromDecl: string = resultOf(named, "bT");
  console.log(loose, typed, fromValue, fromDecl);
}
