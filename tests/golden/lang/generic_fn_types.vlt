// check: no leaks
// Constants of generic function types (#943): each is a generic function, which each call
// instantiates. The type is written at the constant, named by an alias (generic or not, local
// or imported) or by an interface with a generic call signature; the value is an arrow (typed
// by the function type where it writes no types, possibly with fewer parameters) or a name
// asserted to the type. Expected output from `node`.
import { twice, type Keyed, type Wrap } from "./_generic_fn_types_lib";

type Id = <T>(x: T) => T;

const id: Id = (x) => x;

type Pair<K> = <V>(k: K, v: V) => [K, V];

const pair: Pair<string> = (k, v) => [k, v];

interface Mapper {
  <A, B>(xs: A[], f: (a: A) => B): B[];
}

const map: Mapper = (xs, f) => xs.map((x) => f(x));

const first: <T>(xs: T[], fallback?: T) => T | undefined = (xs, fallback) =>
  xs.length > 0 ? xs[0] : fallback;
const count: <T>(label: string, ...items: T[]) => string = (
  label,
  ...items,
) => `${label}:${items.length}`;
const ignore: <T>(x: T, y: number) => number = (x) => 7;
const later: <T>(x: T) => Promise<T> = async (x) => x;

interface Named {
  name: string;
}

const bounded: <T extends Named>(x: T) => string = (x) => x.name.toUpperCase();

const thrice: Wrap = (v) => [v, v, v];
const entry: Keyed<number> = (key, value) => ({ key, value });

// A name asserted to a generic function type: `Symbol` is the function, the token type a
// branded `symbol` that carries its value type.
type InjectionToken<T> = symbol & { readonly __tokenType?: T };

const createToken = Symbol as unknown as <T>(description: string) => InjectionToken<T>;

function local(n: number): string {
  const wrap: <T>(v: T) => T[] = (v) => [v, v];
  return wrap(n).join(",") + " " + wrap("a").length;
}

async function main() {
  console.log(id(3), id("s"), id<boolean>(true));
  console.log(pair("a", 1), pair("b", [true]));
  console.log(map([1, 2, 3], (n) => n * 2), map(["a", "bc"], (s) => s.length));
  console.log(first([5, 6]), first<number>([], 9), first<string>([]));
  console.log(count("n", 1, 2, 3), count<string>("s"));
  console.log(ignore("q", 1), bounded({ name: "ada", age: 36 }));
  console.log(await later(42));
  console.log(twice("x"), thrice(1).length, entry(1, "one"));
  const tok = createToken<number>("svc");
  const other = createToken<string>("svc");
  console.log(typeof tok, tok.description, String(tok), (tok as symbol) === (other as symbol));
  const provided = new Map<symbol, unknown>();
  provided.set(tok, 8080);
  console.log(provided.get(tok), provided.has(other));
  console.log(local(4));
}
