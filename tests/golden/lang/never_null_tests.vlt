// check: no leaks
// `== null`, `!= null`, `=== undefined` and `??` on a value whose type has neither (a
// defensive check, which TypeScript accepts) are not errors (#1203). The value is still
// evaluated, the test is constant and the default never runs, except for an element read of an
// array, a string or a typed array: past the end JavaScript reads `undefined`, so the test
// checks the index.
interface VNode {
  type: string;
}

function isEmpty(vnode: VNode): boolean {
  return vnode == null;
}

function present(vnode: VNode): boolean {
  return vnode != null && vnode !== undefined;
}

function strict(n: number): boolean {
  return n === null || n === undefined;
}

let calls = 0;
function make(n: number): string[] {
  calls++;
  const r: string[] = [];
  for (let i = 0; i < n; i++) {
    r.push("s" + i);
  }
  return r;
}

function first(xs: VNode[]): VNode {
  return xs[0] ?? { type: "comment" };
}

function at(xs: string[], i: number): string {
  return xs[i] ?? "none";
}

function hole(xs: string[], i: number): boolean {
  return xs[i] == null;
}

function label(s: string): string {
  return s ?? "unnamed";
}

function main() {
  console.log(isEmpty({ type: "div" }), present({ type: "div" }), strict(3));
  console.log(first([]).type, first([{ type: "a" }]).type);
  console.log(at(["a", "b"], 1), at(["a", "b"], 2), at(["a"], -1));
  console.log(make(0)[0] ?? "empty", make(2)[1] ?? "x", make(3)[calls] ?? "y", calls);
  console.log(hole(["a"], 0), hole(["a"], 1), make(1)[0] != null, calls);
  console.log(label("n"), make(1) == null, calls);
  const str = "ab";
  console.log(str[5] ?? "S", str[1] ?? "S", str[5] == null, str[5] === undefined, str[1] != null);
  const u = new Uint8Array(2);
  u[1] = 9;
  console.log(u[5] ?? 7, u[1] ?? 7, u[5] == null, u[0] != null);
}
