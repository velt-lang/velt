// A converted promise (`Promise<number>` used as `Promise<unknown>`) left behind by a
// `Promise.all` that already rejected: the combinator handles every element, so its rejection
// is not reported as an uncaught error (#3272). The kept promise has already rejected and been
// caught when `Promise.all` takes it, so the join rejects while the other element is still
// running: one that throws at once, one that has suspended at an `await` (it throws when the
// gate opens, after the `catch`), a plain call converted in the literal, and the converted one
// first. Node prints the same and exits 0.
async function check(value: unknown, gate: Promise<void> | null): Promise<number> {
  if (gate !== null) {
    await gate;
  }
  if (typeof value === "number") {
    return value + 1;
  }
  throw new Error("not a number: " + String(value));
}

function converted(value: unknown, gate: Promise<void> | null): Promise<unknown> {
  return check(value, gate);
}

async function main(): Promise<void> {
  let release: () => void = () => {};
  const gate = new Promise<void>((resolve) => {
    release = resolve;
  });
  const kept = converted("kept", null);
  try {
    await kept;
  } catch (e) {
    console.log("first:", String(e));
  }
  try {
    await Promise.all([kept, converted("later", null)]);
  } catch (e) {
    console.log("at once:", String(e));
  }
  try {
    await Promise.all([kept, converted("suspended", gate)]);
  } catch (e) {
    console.log("suspended:", String(e));
  }
  try {
    await Promise.all([kept, check("in the literal", gate)]);
  } catch (e) {
    console.log("in the literal:", String(e));
  }
  try {
    await Promise.all([converted("converted first", gate), kept]);
  } catch (e) {
    console.log("converted first:", String(e));
  }
  try {
    await Promise.all([converted("one", null), converted("two", null)]);
  } catch (e) {
    console.log("both:", String(e));
  }
  console.log(await Promise.all([converted(1, null), converted(2, null)]));
  release();
  await Promise.resolve();
  console.log("end");
}
main();
