// What `JSON.stringify` cannot write is a compile error at the call that writes it, reported by
// the generator of its writer (velt/encoding/json/generate/check.velt), also through a generic
// function: an atomic `shared` integer, a `shared` lock (read only under its lock). (A `Map` of
// any keys is written as `{}`, as in Node: json_stringify_map.)
function send<T>(v: T): string {
  return JSON.stringify(v);
}

function main() {
  console.log(send(shared(1 as i64)));
  const l = shared(new Mutex<number[]>([1]));
  console.log(JSON.stringify(l));
}
