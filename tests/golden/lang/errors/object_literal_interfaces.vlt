// Object literals implementing interfaces with methods: what they may not do yet, and the
// members they must give.
interface Counter {
  next(): number;
  readonly count: number;
}

interface Mapper {
  map<R>(f: (x: number) => R): R;
}

function main(): void {
  // A missing method.
  const a: Counter = { count: 1 };

  // A member the interface doesn't have.
  const b: Counter = { next: () => 1, count: 2, extra: true };

  // A getter of the wrong type.
  const c: Counter = {
    next: () => 1,
    get count() {
      return "many";
    },
  };
}
