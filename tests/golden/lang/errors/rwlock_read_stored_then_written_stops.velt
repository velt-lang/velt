// An object a `read` callback made, stored into the caller's array, then given the caller's
// object through the callback's own variable: from the store on the callback no longer counts it
// as its own, so that is an error (put the caller's objects in before the store).
class Item {
  v: i64 = 0;
  constructor(v: i64) {
    this.v = v;
  }
}
class Bag {
  items: Item[] = [];
}
class St {
  items: Item[] = [new Item(1)];
  bag: Bag = new Bag();
}

function main() {
  const rw = shared(new RwLock<St>(new St()));
  const out: Item[] = [new Item(5)];
  const bags: Bag[] = [];
  rw.read((s) => {
    const b = new Bag();
    b.items.push(out[0]);
    bags.push(b);
    console.log("stored", bags.length);
    b.items.push(out[0]);
    return 0;
  });
  console.log("not reached", bags[0].items.length);
}
