// A generic initializer a subclass inherits (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
var held: any = null;
class Box<T> { v: T = held; get(): T { return this.v; } }
class S extends Box<W> {}
function mk(): any { const p: any = Object.create(null); p.a = 1; p.b = 2; return p; }
function main() {
  const p: any = mk();
  held = p;
  const q: N = new S().get();
  p.a = 5;
  console.log(q.a, p.a);
}
main();
