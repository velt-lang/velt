// A type parameter bounded by a union whose array is read-only, in an overload whose
// implementation takes a mutable array through a generic alias's default (`Wide` is `Wide<(number
// | string)[]>`, #379, `union_bound_value`): the implementation writes a `string` into what may be
// a `number[]`. Velt refuses the conversion; tsc accepts it and Node prints `3 3`.
type Wide<X = (number | string)[]> = X;

function use(key: string): number;
function use<K extends (string | readonly (number | string)[])>(key: () => K | null): number;
function use(key: string | (() => string | Wide | null)): number {
  if (typeof key === "string") {
    return key.length;
  }
  const k = key();
  if (k === null || typeof k === "string") {
    return 0;
  }
  k.push("x");
  return k.length;
}

function main(): void {
  const a: number[] = [1, 2];
  console.log(use(() => a), a.length);
}
