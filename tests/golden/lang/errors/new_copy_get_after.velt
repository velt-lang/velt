// The same, read back with a method after the `new` (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
class Box<T> { v: T; constructor(x: any) { this.v = x; } get(): T { return this.v; } }
function main() {
  const p: any = Object.create(null);
  p.a = 1; p.b = 2;
  const b = new Box<W>(p);
  const c = b.get();
  const q: N = c;
  p.a = 5;
  console.log(q.a, p.a);
}
main();
