// `typeof` in types: what Velt cannot represent yet is an error, never an approximation (a
// generic or async function's type, a class's own type, `keyof` of a class or of a string-keyed
// record), and what TypeScript rejects is an error too: a type used as a value (TS2693), an
// unknown name (TS2304), `ReturnType` of a non-function (TS2344) and a missing field (TS2339).
// A signature that needs its own type is an error (TS2502), directly, through other functions
// or through a body that calls the function (TS7023); `typeof f` of a function with a rest,
// optional or default parameter is not supported yet.
function id<T>(x: T): T {
  return x;
}

async function load(): Promise<number> {
  return 1;
}

class Point {
  x: number = 0;
}

type Shape = { kind: string };

type A = typeof id;
type B = typeof load;
type C = typeof Point;
type D = typeof Shape;
type E = typeof missing;
type G = keyof Point;
// `keyof { [k: string]: number }` is `string | number` (lang/type_queries_keys).
type I = ReturnType<number>;

function me(z: ReturnType<typeof me>) {
  return z;
}
function ping(x: ReturnType<typeof pong>) {
  return x;
}
function pong(y: ReturnType<typeof ping>) {
  return y;
}
function n1(x: Parameters<typeof n2>) {
  return 1;
}
function n2(y: ReturnType<typeof n3>) {
  return 2;
}
function n3(w: ReturnType<typeof n1>) {
  return w;
}
function selfRet(): ReturnType<typeof selfRet> {
  return 1;
}
function viaBody(x: ReturnType<typeof caller>) {
  return x + 1;
}
function caller() {
  return viaBody(1);
}

function restf(...xs: number[]) {
  return xs.length;
}
function opt(a: number, b?: number) {
  return a;
}
function dflt(a: number, b: number = 2) {
  return a + b;
}
type J = Parameters<typeof restf>;
type K = Parameters<typeof opt>;
type L = typeof dflt;

function main() {
  const p = new Point();
  const y: typeof p.y = 1;
  console.log(y);
}
