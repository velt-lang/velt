// A local declared from a literal that takes part in arithmetic stays a number when the other
// uses want an integer type narrower than 64 bits, which would wrap (#525, review of #685):
// the use as `u8` is an error whose note says why and gives the fix.
function takeU8(b: u8): u8 {
  return b;
}

function main() {
  let n = 200;
  takeU8(n);
  console.log(n + n);
}
