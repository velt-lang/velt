// `JSON.stringify` takes an array replacer, `null`, or a replacer function of the prelude's
// `JsonReplacer` type (`(key: string, value: JsonValue) => JsonValue | undefined`; this one
// takes a number), and a number or string `space`.
const o = { a: 1 };
console.log(JSON.stringify(o, (k: string, v: number) => v));
console.log(JSON.stringify(o, null, true));
console.log(JSON.stringify(o, null, 2, 3));
