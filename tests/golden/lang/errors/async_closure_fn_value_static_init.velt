// A named function used as a value only in a static field's initializer is called through that
// field with a sink (#2893): it is matched with the calls through function values like any other,
// so the job is refused.
import { channel } from "velt/sync";
type Job = () => Promise<void>;
type Sink = (j: Job) => void;
const ch = channel<Job>(4);
class Hooks {
  static sink: Sink = (j: Job) => {
    void ch.send(j);
  };
}
function relay(f: Sink, j: Job): void {
  f(j);
}
class K {
  static r: (f: Sink, j: Job) => void = relay;
}
async function main() {
  let n = 0;
  const job: Job = async () => {
    n++;
  };
  relay((j: Job): void => {
    void j();
  }, async () => {
    console.log("safe");
  });
  K.r(Hooks.sink, job);
  await sleep(10);
  console.log(`n ${n}`);
}
