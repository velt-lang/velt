// #2862 review round 7 (t04). `f` starts as a local runner; a closure that captures it assigns the
// static sink to it. The call `f(job)` then sends `job`. Unsound.
import { channel } from "velt/sync";
type Job = () => Promise<void>;
type Sink = (j: Job) => void;
const ch = channel<Job>(4);
class Hooks {
  static sink: Sink = (j: Job) => {
    void ch.send(j);
  };
}
async function main() {
  let n = 0;
  const job: Job = async () => {
    n++;
  };
  let f: Sink = (j: Job): void => {
    void j();
  };
  const use = (g: Sink): void => {
    f = g;
  };
  use(Hooks.sink);
  f(job);
  await sleep(10);
  console.log(`n ${n}`);
}
