// Ways a right-hand side can run a function value that replaces `o.inner` (#876): stored,
// returned, bound, passed through generic and higher-order functions, awaited, called by a
// setter, a getter, a constructor or an override. Each assignment is an error (JavaScript writes
// into the old object and prints 100 for each).
type Inner = { v: number };
type Outer = { inner: Inner };

// 01
function t01() {
  const o: Outer = { inner: { v: 0 } };
  const bump = (): number => {
    o.inner = { v: 100 };
    return 13;
  };
  const fs: Array<() => number> = [bump];
  const h = { cb: bump };
  o.inner.v = h.cb();
  console.log(o.inner.v);
}

// 02
function mk_02(o: Outer): () => number {
  return () => {
    o.inner = { v: 100 };
    return 13;
  };
}

function t02() {
  const o: Outer = { inner: { v: 0 } };
  const bump = (): number => {
    o.inner = { v: 100 };
    return 13;
  };
  const fs: Array<() => number> = [bump];
  o.inner.v = mk_02(o)();
  console.log(o.inner.v);
}

// 03
class K_03 {
  o: Outer;
  constructor(o: Outer) {
    this.o = o;
  }
  step(): number {
