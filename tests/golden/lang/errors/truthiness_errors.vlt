// Numbers, strings and enums (also nullable ones) are not conditions: JS's falsy `0` / `""`
// would hide bugs. Each error says which comparison to write instead.
enum Color {
  Red,
  Green,
}

function main() {
  const count = 3;
  const name = "ann";
  const maybe: i64 | null = 0;
  const color = Color.Red;
  if (count) {
    console.log("count");
  }
  while (name) {}
  const a = maybe ? 1 : 2;
  const b = !name;
  const port = count || 8080;
  const ok = count > 0 && name;
  if (color) {
    console.log(a, b, port, ok);
  }
}
