// `Object.keys` of an `any` in a program that converts an array to `any` (issues #924, #926):
// the keys of a value that is not a class instance are not supported yet, so the call is an
// error rather than a wrong result.
class Point {
  x = 1;
}

function main(): void {
  const a: any = new Point();
  const list: any = [1, 2];
  console.log(Object.keys(a), list);
}
