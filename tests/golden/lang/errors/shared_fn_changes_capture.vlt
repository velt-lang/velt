// A function in `shared(...)` runs on a copy of what it captured for each call, on any thread, so
// a change to a capture would be lost. It is refused, sync or async, however the function gets
// there, and through a closure it calls. A lock's value is one thread's at a time, and stays allowed.
type F = (x: i64) => i64;

class C {
  n: i64 = 0;
}

class O {
  n: i64 = 0;
  step(x: i64): i64 {
    this.n += 1;
    return this.n;
  }
}

function aLet(): F {
  let n: i64 = 0;
  return (x: i64): i64 => {
    n += 1;
    return n;
  };
}

function aField(): F {
  const b = new C();
  return (x: i64): i64 => {
    b.n += 1;
    return b.n;
  };
}

async function main() {
  const a: i64[] = [];
  const push = shared((x: i64): i64 => {
    a.push(x);
    return a.length as i64;
  });
  const b = new C();
  const field = shared((x: i64): i64 => {
    b.n += 1;
    return b.n;
  });
  let n: i64 = 0;
  const variable = shared((x: i64): i64 => {
    n += 1;
    return n;
  });
  const made = shared(aLet());
  const madeField = shared(aField());
  let m: i64 = 0;
  const inner = (): i64 => {
    m += 1;
    return m;
  };
  const through = shared((x: i64): i64 => inner());
  let k: i64 = 0;
  const innerAsync = (): i64 => {
    k += 1;
    return k;
  };
  const throughAsync = shared(async (x: i64): Promise<i64> => innerAsync());
  const o = new O();
  const method = shared((x: i64): i64 => o.step(x));
  console.log(push(1), field(1), variable(1), made(1), madeField(1), through(1), method(1));
  console.log(await throughAsync(1));
}
