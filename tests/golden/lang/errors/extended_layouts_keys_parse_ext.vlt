// Objects parsed from text as the extension may have any of its fields (#1383).
interface VNode {
  type: string;
  dom: string | null;
}

interface IV extends VNode {
  _ns?: boolean;
}

function show(v: VNode): string {
  return Object.keys(v).join(",") + " " + ("_ns" in v) + " " + JSON.stringify({ ...v });
}

const iv = JSON.parse("{\"type\":\"a\",\"dom\":null,\"_ns\":true}") as IV;
console.log(show(iv));
