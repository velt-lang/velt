// TypeScript forms around the builtin iterables that Velt rejects: a `TReturn` in
// `IteratorResult<T, TReturn>` or `IterableIterator<T, TReturn>` (a finished result carries no
// value), an array of the wrong element type, and a value that is not iterable. (An
// `IterableIterator<T>` value where its parent `Iterator<T>` is expected converts: the same
// object, `lang/iface_intersections`.)
function* numbers(): IterableIterator<number, string> {
  yield 1;
}

function sum(xs: Iterable<number>): number {
  let s = 0.0;
  for (const x of xs) {
    s += x;
  }
  return s;
}

const r: IteratorResult<number, string> = { done: true };
const words = ["a", "b"];
console.log(sum(words));
console.log(sum(5));
