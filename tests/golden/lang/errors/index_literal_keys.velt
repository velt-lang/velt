// Assigning through a key that may name fields of different types is an error, and so is
// indexing an object with a computed `string` key; a `string` cast to a union of string
// literals is a checked conversion (#1410), so `d[s as K]` reads the field it names.
class Doc {
  title = "t";
  count = 0;
}

function main() {
  const d = new Doc();
  const k = "count" as "title" | "count";
  d[k] = 5;
  const s: string = "title";
  console.log(d[s as "title" | "count"]);
}

function title(): string {
  return "title";
}

// A key computed by a call must have a string literal type naming fields.
function other() {
  const d = new Doc();
  console.log(d[title()]);
}
