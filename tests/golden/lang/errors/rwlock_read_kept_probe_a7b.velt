// An RwLock read probe (#1559): a compile error, where a silent copy would differ from Node.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Holder {
  rows: number[][] = [];
}
function main() {
  const a = new RwLock(new Box());
  const hs: Holder[] = [];
  const r = a.read((x) => {
    const h = new Holder();
    hs.push(h);
    return h;
  });
  r.rows.push([3]);
  console.log(JSON.stringify(hs), r === hs[0]);
}
