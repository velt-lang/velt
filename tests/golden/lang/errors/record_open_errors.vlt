// Open records (`Record<string, V>`): a key may be missing, so its value is `V | null`.
function bump<K>(r: Record<K, i64>, k: K) {
  r[k] += 1;
}

function main() {
  const counts: Record<string, i64> = {};
  counts["a"] += 1;
  counts["a"]++;
  ++counts.b;
  counts["a"] -= 2;
  const k = "c";
  counts[k] *= 3;
  counts[k] **= 2;
  const names: Record<string, string> = {};
  names["x"] += "!";
  for (const key of counts) {
    console.log(key);
  }
  console.log(Object.values({}));
  // Used as a value: the same messages as the statements above.
  const kf = (): string => "a";
  const v = (names[kf()] += "2");
  const w = (counts[k] += 1);
  console.log(v, w);
}
