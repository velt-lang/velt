// A class with its own `clone()` in a field, from a function the compiler can't follow.
type F = (x: i64) => i64;

class K {
  n: i64 = 0;
  get(): i64 {
    return this.n;
  }
  clone(): K {
    this.n += 1;
    return new K();
  }
  [Symbol.dispose]() {}
}

class H {
  k: K = new K();
}

function mk(): F {
  const h = new H();
  return (x: i64): i64 => h.k.n;
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
