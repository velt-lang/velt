// An alias's own type parameter as an intersection part is reported where the alias is used,
// and a `Record` part says what a record is (#1225).
type Tagged<T> = T & { tag: string };
class Point {
  x = 1;
}
const p: Tagged<Point> | null = null;
function sig<V>(r: Record<string, V>): void {
  const s: (Record<string, V> & { $set: () => void }) | null = null;
}
console.log(p);
