// Error types that inference cannot settle: implementations called through one interface entry
// whose error types depend on type parameters need a `throws` clause. (A closure whose error
// type is needed while the recursive function it calls is still being checked, `walk`, needs
// none: the program is checked again with the error type the recursion found.)
class TooDeep extends Error {}

function walk(n: i64): i64 {
  const next = () => walk(n + 1);
  if (n > 3) {
    throw new TooDeep("too deep");
  }
  return next();
}

interface Source<T> {
  read(v: T): T;
}

class Rejecting<T> implements Source<T> {
  read(v: T): T {
    throw v.clone();
  }
}

function main() {
  console.log(walk(0));
  const s: Source<i64> = new Rejecting<i64>();
  try {
    console.log(s.read(1));
  } catch (e) {
    console.log(e);
  }
}
