// The same, in a generic function the constructor calls (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
function g<T>(x: any): T { return x; }
class Box<T> { v: T; constructor(x: any) { this.v = g<T>(x); } get(): T { return this.v; } }
function main() {
  const p: any = Object.create(null);
  p.a = 1; p.b = 2;
  const q: N = new Box<W>(p).get();
  p.a = 5;
  console.log(q.a, p.a);
}
main();
