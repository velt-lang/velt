// Keys, `in` and spreads of a base whose objects an extension writes a field on (#1383): Node
// would show the written field, which the base type does not list, so each is an error.
type VNode = { type: string; children: VNode[] };
interface InternalVNode extends VNode {
  _ns?: boolean;
}
function mount(v: VNode): void {
  (v as InternalVNode)._ns = true;
  console.log(Object.keys(v).join(","));
  console.log("_ns" in v);
  const c = { ...v };
  console.log(c.type);
  for (const key in v) {
    console.log(key);
  }
}
mount({ type: "a", children: [] });
