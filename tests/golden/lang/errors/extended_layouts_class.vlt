// A class implementing an object type extended with optional fields (#1383): the hint builds
// the object from the base type's own fields, also when the program casts to the extension.
interface VNode {
  type: string;
  dom: string | null;
}
interface IV extends VNode {
  _ns?: boolean;
}
class K implements VNode {
  type = "k";
  dom: string | null = null;
}
function mount(v: VNode): void {
  (v as IV)._ns = true;
}
const k = new K();
const v: VNode = k;
mount(v);
