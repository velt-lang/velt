// Tuples are values: a write into an element of a tuple that a call or a conditional gives
// would change a copy, where JavaScript changes the array the expression gives. Each is an
// error rather than a lost write: statements, compound and `++` forms, and assignments used as
// values.
const ms = new Map<string, [number, number]>([["a", [1, 2]]]);
ms.get("a")![1] = 20;
const ts: [number, number][] = [[1, 2]];
ts.find((t) => t[0] === 1)![1] = 30;
const v = (ts.find((t) => t[0] === 1)![0] = 40);
const pick = (): [number, number] => ts[0];
pick()[0] += 1;
pick()[1]++;
const w = (pick()[1] -= 2);
const c = ts.length > 0;
(c ? ts[0] : ts[0])[1] = 3;
const nested: [[number, number], string][] = [[[1, 2], "a"]];
const first = (): [[number, number], string] => nested[0];
first()[0][1] = 7;
// Writes into an object held by such a tuple, or into a tuple stored in a variable, an array or
// a field, are fine.
const held: [{ x: number }, number] = [{ x: 1 }, 2];
const pickHeld = (): [{ x: number }, number] => held;
pickHeld()[0].x = 5;
ts[0][1] = 9;
nested[0][0][0] = 4;
console.log(v, w, held[0].x, ts[0], nested[0]);
