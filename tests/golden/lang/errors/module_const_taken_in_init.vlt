// A module constant evaluated at each use can't be taken over through `??` or `!` in a module
// initializer or a function, as `const v = K` can't: TypeScript would alias it, so a change
// through the copy would show in the constant (#1406, #1398).

interface P {
  x: number;
}

export const q: P | undefined = { x: 0 } as (P | undefined);
let d: P = { x: -1 };
let p = q ?? d;
p.x = 1;
export let r = q!;
r.x = 2;
export const s = q || d;

function f(): void {
  const z = q ?? d;
  z.x = 5;
  const w = q!;
  w.x = 6;
}

f();
console.log(q!.x, p.x, r.x, s.x);

// Through a `!` or `as` around `??`, and a part taken over through `!`, `??`, an optional
// chain, a destructuring or a spread, or directly (`N.a`): TypeScript shares each one.
interface J {
  v: number;
  a: { b: number };
}

export const K: J | null = { v: 1, a: { b: 1 } };
export const N: J = { v: 1, a: { b: 1 } };
let D: J = { v: 0, a: { b: 0 } };
const t1 = (K ?? D)!;
t1.v = 3;
const t2 = (K ?? D) as J;
t2.v = 3;
const t3 = K!.a;
t3.b = 3;
const t4 = (K ?? D).a;
t4.b = 3;
const t5 = K?.a ?? D.a;
t5.b = 3;
const { a } = K!;
a.b = 3;
const { a: a2 } = K ?? D;
a2.b = 3;
let t6 = N.a;
t6.b = 3;
const [n1] = [N.a];
n1.b = 3;
const sp = { ...K! };
sp.a.b = 3;
const sp2: J = { ...N, v: 2 };
sp2.a.b = 3;

function g(): number {
  const t = K!.a;
  t.b = 3;
  const { a: u } = N;
  u.b = 3;
  return t.b + u.b;
}

console.log(K!.v, K!.a.b, N.a.b, g());

// Taken over by a call that keeps its argument: a `Map` or `Set`, a constructor or a method
// storing it in a field, a weak key.
class Box {
  a: { b: number };
  constructor(a: { b: number }) {
    this.a = a;
  }
  put(a: { b: number }): void {
    this.a = a;
  }
}

const m = new Map<string, { b: number }>();
m.set("x", N.a);
m.set("y", K!.a);
m.set("z", (K ?? D).a);
new Map<string, J>().set("x", K!);
new Set<{ b: number }>().add(N.a);
const b1 = new Box(N.a);
const b2 = new Box(K!.a);
b2.put(N.a);
// A weak key (set, or looked up): a new object at each use would never be found again.
const wm = new WeakMap<{ b: number }, number>();
wm.set(K!.a, 1);
m.get("x")!.b = 3;
console.log(N.a.b, K!.a.b, b1.a.b, wm.has(K!.a));
