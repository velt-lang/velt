type Shape =
  | { kind: "circle"; r: f64 }
  | { kind: "rect"; w: f64; h: f64 }
  | { kind: "tri"; b: f64; h: f64 };

function wrongCase(s: Shape): i64 {
  switch (s.kind) {
    case "square":
      return 1;
    default:
      return 0;
  }
}

function wrongType(n: i64): i64 {
  switch (n) {
    case "one":
      return 1;
  }
  return 0;
}

function continueSwitch(n: i64) {
  for (let i = 0; i < 3; i++) {
    sw: switch (n) {
      case 1:
        continue sw;
    }
  }
}

// A case value of another type is reported once (#337).
function wrongValueType(s: string, n: i64): i64 {
  switch (s) {
    case n:
      return 1;
  }
  return 0;
}

function main() {}

// A fact undone before a `break` and restored after it does not hold after the `switch`.
type AB = { kind: "a" } | { kind: "b" };

function breakMidBody(s: AB, c: bool, init: f64 | null): f64 {
  let x: f64 | null = init;
  if (x === null) {
    return 0.0;
  }
  switch (s.kind) {
    case "a":
      x = null;
      if (c) {
        break;
      }
      x = 5.0;
      break;
  }
  return x + 1.0;
}

function labelledBreak(s: AB, c: bool, init: f64 | null): f64 {
  let x: f64 | null = init;
  if (x === null) {
    return 0.0;
  }
  out: switch (s.kind) {
    case "a": {
      x = null;
      {
        if (c) {
          break out;
        }
      }
      x = 5.0;
      break;
    }
  }
  return x + 1.0;
}
