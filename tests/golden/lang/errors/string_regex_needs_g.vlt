// `matchAll` and `replaceAll` with a regex literal without the `g` flag (JS: TypeError).
import { RegExp } from "velt:regex";

function main() {
  console.log("a1b2".matchAll(/\d/).length);
  console.log("aa".replaceAll(/a/i, "b"));
  console.log("a1".replace(/(\d)/, (m, d: string, off: number, s: string, extra: string) => m));
}
