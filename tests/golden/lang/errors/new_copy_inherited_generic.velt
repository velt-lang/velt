// An inherited constructor of a generic subclass (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
class Box<T> { v: T; constructor(x: any) { this.v = x; } get(): T { return this.v; } }
class S<U> extends Box<U> {}
function main() {
  const p: any = Object.create(null);
  p.a = 1; p.b = 2;
  const q: N = new S<W>(p).get();
  p.a = 5;
  console.log(q.a, p.a);
}
main();
