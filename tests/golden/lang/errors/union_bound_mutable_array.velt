// A type parameter bounded by a union with a mutable array member (#379, `union_bound_value`):
// an instantiation may be an array of a narrower element type (`number[]` for `(number |
// string)[]`), and the implementation writes a `string` through it, which the narrower array
// can't hold. Velt refuses the conversion; tsc accepts it and Node prints `3 3`. A bound whose
// arrays are read-only converts (`overload_union_bound_key`).
function use(key: string): number;
function use<K extends (string | (number | string)[])>(key: () => K | null): number;
function use(key: string | (() => string | (number | string)[] | null)): number {
  if (typeof key === "string") {
    return key.length;
  }
  const k = key();
  if (k === null || typeof k === "string") {
    return 0;
  }
  k.push("x");
  return k.length;
}

function main(): void {
  const a: number[] = [1, 2];
  console.log(use(() => a), a.length);
}
