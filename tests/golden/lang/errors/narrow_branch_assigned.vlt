// A branch that reassigns a variable ends without the narrowing its condition gave it, also when
// the other branch leaves (`if (p == null) return 0; else p = null;`): reading `p` after the `if`
// is an error, as in tsc (#1226). Before, the condition's facts were applied after the branch.
class A {
  a = 1;
}

class B {
  b = 2;
}

function f1(x: string | null): number {
  let p = x;
  if (p == null) { return 0; } else { p = null; }
  return p.length;
}

function f2(x: string | null | undefined): number {
  let p = x;
  if (p == null) { return 0; } else { p = undefined; }
  return p.length;
}

function f3(x: string | null): number {
  let p = x;
  if (p != null) { p = null; } else { return 0; }
  return p.length;
}

function f4(x: string | null, c: boolean): number {
  let p = x;
  if (p == null) { return 0; } else if (c) { p = null; }
  return p.length;
}

function f5(xs: (string | null)[]): number {
  let n = 0;
  for (const x of xs) {
    let p = x;
    if (p == null) { continue; } else { p = null; }
    n += p.length;
  }
  return n;
}

function f6(xs: (string | null)[]): number {
  let n = 0;
  let i = 0;
  while (i < xs.length) {
    let p = xs[i];
    i++;
    if (p == null) { break; } else { p = null; }
    n += p.length;
  }
  return n;
}

function f7(x: string | null, c: boolean): number {
  let p = x;
  if (p == null || c) { return 0; } else { p = null; }
  return p.length;
}

function f8(x: string | null, c: boolean): number {
  let p = x;
  if (p != null && c) { p = null; } else { return 0; }
  return p.length;
}

function f9(x: string | null): number {
  let p = x;
  switch (p) {
    case null: return 0;
    default: p = null;
  }
  return p.length;
}

function f10(x: string | null | undefined, c: boolean): number {
  let p = x;
  if (p === undefined) { return 0; } else if (p === null) { return 1; } else { if (c) { p = null; } }
  return p.length;
}

function f11(x: A | B): number {
  let p = x;
  if (p instanceof A) { return 0; } else { p = new A(); }
  return p.b;
}

function f12(x: string | number): number {
  let p = x;
  if (typeof p === "number") { return 0; } else { p = 5; }
  return p.length;
}

function f13(x: string | null): number {
  let p = x;
  if (p == null) { return 0; } else { try { p = null; } catch (e) { } }
  return p.length;
}

function f14(x: string | null, c: boolean): number {
  let p = x;
  if (p == null) { return 0; } else { c ? (p = null) : 0; }
  return p.length;
}

class O {
  p: string | null = "a";
  q: string | null | undefined = "b";
}

function f15(o: O): number {
  if (o.p == null) { return 0; } else { o.p = null; }
  return o.p.length;
}

function f16(x: string | null | undefined): number {
  let p = x;
  if (p === undefined) { return 0; } else { p = undefined; }
  if (p === null) { return 1; }
  return p.length;
}

function f17(o: O): number {
  if (o.q === undefined || o.q === null) { return 0; } else { o.q = undefined; }
  return o.q.length;
}

function f18(x: string | null, k: number, c: boolean): number {
  let p = x;
  if (p == null) { return 0; }
  sw: switch (k) {
    default:
      p = null;
      while (c) { break sw; }
      p = "abc";
  }
  return p.length;
}

function main() {
  console.log(f1("ab"));
  console.log(f2("ab"));
  console.log(f3("ab"));
  console.log(f4("ab", true));
  console.log(f5(["ab"]));
  console.log(f6(["ab"]));
  console.log(f7("ab", false));
  console.log(f8("ab", true));
  console.log(f9("ab"));
  console.log(f10("ab", true));
  console.log(f11(new B()));
  console.log(f12("ab"));
  console.log(f13("ab"));
  console.log(f14("ab", true));
  console.log(f15(new O()), f16("x"), f17(new O()));
  console.log(f18("x", 1, true));
}
