// `typeof` in types: what Velt cannot represent yet is an error, never an approximation (a
// generic or async function's type, a class's own type, `keyof` of a class or of a string-keyed
// record), and what TypeScript rejects is an error too: a type used as a value (TS2693), an
// unknown name (TS2304), `ReturnType` of a non-function (TS2344) and a missing field (TS2339).
function id<T>(x: T): T {
  return x;
}

async function load(): Promise<number> {
  return 1;
}

class Point {
  x: number = 0;
}

type Shape = { kind: string };

type A = typeof id;
type B = typeof load;
type C = typeof Point;
type D = typeof Shape;
type E = typeof missing;
type G = keyof Point;
type H = keyof { [k: string]: number };
type I = ReturnType<number>;

function main() {
  const p = new Point();
  const y: typeof p.y = 1;
  console.log(y);
}
