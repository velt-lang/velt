// Abstract classes (issue #1568): `new` of an abstract class, a concrete subclass that leaves
// abstract members unimplemented, and `super` calls of an abstract method are errors
// (TypeScript's TS2511, TS2515 and TS2513).
abstract class Shape {
  abstract area(): number;
  abstract get name(): string;
  describe(): string {
    return `${this.name}: ${this.area()}`;
  }
}

class Square extends Shape {
  get name(): string {
    return "square";
  }
}

class Bare extends Shape {}

abstract class Half extends Shape {
  area(): number {
    return 1;
  }
}

class Done extends Half {
  get name(): string {
    return "done";
  }
}

class NoName extends Half {}

class Calls extends Shape {
  area(): number {
    return super.area();
  }
  get name(): string {
    return "calls";
  }
}

class Wrong extends Shape {
  area(): string {
    return "";
  }
  get name(): string {
    return "wrong";
  }
}

class Plain {
  tag(): string {
    return "plain";
  }
}

abstract class Fancy extends Plain {
  abstract override tag(): string;
}

class Tin extends Fancy {}

// Abstract properties: the constructor of their class can't use them (TS2715), and a subclass
// implements each with a field of its type or accessors (TS2515, TS2416).
abstract class Item {
  abstract readonly title: string;
  abstract count: number;
  constructor() {
    console.log(this.title);
    this.count = 1;
    // Not in a closure: it runs later.
    const later = () => this.title;
  }
}

class NoCount extends Item {
  readonly title = "n";
}

class WrongCount extends Item {
  readonly title = "w";
  count: string = "x";
}

class GetterOnly extends Item {
  readonly title = "g";
  get count(): number {
    return 1;
  }
}

// Abstract construct signatures: no `new` through one (TS2511), and an abstract class is not a
// plain construct signature (TS2345).
function make(c: abstract new () => Shape): Shape {
  return new c();
}

function plain(c: new () => Shape): string {
  return c.name;
}

function main() {
  plain(Shape);
  const s = new Shape();
  const p = new Half();
  console.log(new Done().describe());
}
