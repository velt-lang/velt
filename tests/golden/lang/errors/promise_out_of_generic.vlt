// Copies of promises that generic code makes without an explicit read: a closure sharing what
// it captured, a generic function used as a value, a method reached through an interface value,
// and binding a promise field of a class instance by reference or by destructuring (TypeScript
// allows these; shared promises are #212).
async function work(n: i64): Promise<string> {
  return `done ${n}`;
}

function peek<T>(x: T): bool {
  return true;
}

function hold<T>(x: T): T {
  const g = () => peek(x);
  g();
  return x;
}

function first<T>(xs: T[]): T | null {
  return xs.at(0);
}

interface Getter<T> {
  get(): T;
}

class Box<T> implements Getter<T> {
  v: T;
  constructor(v: T) {
    this.v = v;
  }
  get(): T {
    return this.v;
  }
}

class Job {
  run: Promise<string>;
  constructor(run: Promise<string>) {
    this.run = run;
  }
}

async function main() {
  const held = hold(work(1));
  const arr: Promise<string>[] = [work(2)];
  const pick: (xs: Promise<string>[]) => Promise<string> | null = first;
  const picked = pick(arr);
  const g: Getter<Promise<string>> = new Box(work(3));
  const j = new Job(work(4));
  const r = j.run;
  const { run } = j;
  console.log(arr.length);
}
