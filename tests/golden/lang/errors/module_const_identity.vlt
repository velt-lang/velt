// A `static readonly` object field is evaluated at each use, and is not kept in the module
// state like a module constant (#1383): comparing it by identity would always be false, so it
// is an error.

type Point = { x: number; y: number };

class Geo {
  static readonly ORIGIN: Point = { x: 0, y: 0 };
}

function main() {
  console.log(Geo.ORIGIN !== Geo.ORIGIN);
}
