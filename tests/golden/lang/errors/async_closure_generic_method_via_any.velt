// An object whose generic method is called after the object went through `any` and back (#2860,
// #2952): the call through `Reader` is recorded with the job's type, so the job that modifies what
// it captured is refused. (A call straight through `any` is a TypeError at run time, #924, and
// reaches no method.)
type Job = () => Promise<void>;
function keepAndSpawn<T>(x: T): void {
  const box: T[] = [x];
  const v = box[0];
  spawn(async () => {
    console.log(typeof v);
  });
}
interface Reader {
  read<T>(x: T): void;
}
interface Engine {
  run: <T>(x: T) => void;
}
async function main() {
  let f = 0;
  const o: Reader = {
    read<T>(x: T): void {
      keepAndSpawn<T>(x);
    },
  };
  o.read<number>(1);
  const anyO: any = o;
  const job2: Job = async () => {
    f++;
  };
  const back = anyO as Reader;
  back.read<Job>(job2);
}
