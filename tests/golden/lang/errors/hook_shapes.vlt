// A toString() or toJSON() that String(x), template literals or JSON.stringify cannot call as
// JS does is an error, never silently left out.
class NeedsRadix {
  toString(radix: number): string {
    return `${radix}`;
  }
}
class NumberKey {
  toJSON(key: number): string {
    return `${key}`;
  }
}
class ExtraParam {
  toJSON(key: string, extra: number): string {
    return `${key}${extra}`;
  }
}
class AsyncText {
  async toString(): Promise<string> {
    return "d";
  }
}
class NoText {
  toString(): void {}
}
class OwnGeneric {
  toString<U>(): string {
    return "f";
  }
}
console.log("never runs");
