// A `Mutex` held by value, from a function the compiler can't follow: each call would lock its own.
type F = (x: i64) => i64;

function mk(): F {
  const m = new Mutex<i64[]>([]);
  return (x: i64): i64 => m.with((v) => {
    v.push(1);
    return v.length as i64;
  });
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
