// Callbacks the handler never gets to, of a type it calls, are errors too (#873): what one
// object of a class holds may be reached through what it shares, which the check does not
// follow, so it errs on the side of rejecting (docs/std/http.md). Each assigns a variable that
// only `main` (or `start`) uses: another `Input` than the handler's, another `Emitter`.
import { serve } from "velt:http";

class Input {
  onChange: (v: string) => void = (v) => {};
}

class Emitter {
  listeners: ((name: string) => void)[] = [];
  on(f: (name: string) => void) {
    this.listeners.push(f);
  }
  emit(name: string) {
    for (const l of this.listeners) {
      l(name);
    }
  }
}

class App {
  async start(): Promise<string> {
    let started = 0;
    const boot = new Emitter();
    boot.on((name: string) => {
      started++;
    });
    boot.emit("boot");
    const requests = new Emitter();
    const server = await serve({ port: 0 }, async (req) => {
      requests.emit("request");
      return new Response("app");
    });
    await server.shutdown();
    return `${started}`;
  }
}

async function main() {
  const i = new Input();
  let ready = false;
  const startup = new Emitter();
  startup.on((name: string) => {
    ready = true;
  });
  startup.emit("startup");
  const requests = new Emitter();
  const a = await serve({ port: 0 }, async (req) => {
    requests.emit("request");
    i.onChange("x");
    return new Response("ok");
  });
  let local = 0;
  const other = new Input();
  other.onChange = (v: string) => {
    local += v.length;
  };
  other.onChange("abc");
  await a.shutdown();
  console.log(local, ready, await new App().start());
}
