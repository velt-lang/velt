// The second copy comes first in the source, so its source type is known to be a spread of the
// first copy only after that copy is seen: the fixed point's second round finds it (#2956). Node
// prints `{ a: 1, b: 2, c: 1, k: 1 }`; the copies would print `{ a: 1, c: 1, k: 1 }`.
type A = { a: number };
type AB = A & { b: number };
type AC = { a: number; c?: number };

function later(y: { a: number; c: number }) {
  const z: AC = y;
  const w = { ...z, k: 1 };
  console.log(w);
}

function earlier(ab: AB) {
  const x: A = ab;
  later({ ...x, c: 1 });
}

function main() {
  earlier({ a: 1, b: 2 });
}
