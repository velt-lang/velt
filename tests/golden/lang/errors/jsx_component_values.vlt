// @jsxImportSource ../_jsx_test_provider

// Component values are checked against the runtime's component type; a generic component's type
// arguments must be inferable from its props. (Props holding a promise are passed by reference,
// not copied, so they are no error: #74.)

function Empty<T>(props: { label: string }): JSX.Element {
  return <p>{props.label}</p>;
}

function main() {
  const Text = (props: { s: string }): string => props.s;
  const a = <Text s="x" />;
  const c = <Empty label="x" />;
}
