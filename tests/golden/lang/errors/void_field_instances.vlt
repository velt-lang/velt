// A field of an object type instantiated as `void` (sigx's `__ref: TRef` at `TRef = void`) is
// reported at the field, also when an intersection merged the object type (#1262). TypeScript
// accepts such a field; Velt fields must be values.
type Factory<R> = { name: string } & { ref: R };

function component<R = void>(name: string): Factory<R> {
  return { name, ref: null as any };
}

function make<R>(): { v: number; ref: R } {
  throw new Error("unused");
}

const card = component("card");
console.log(card.name);
console.log(make<void>().v);
