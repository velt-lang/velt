// What a generic function value can't be yet (#943): held as `any`, made of a function of fixed
// types through `unknown`, an arrow with another number of type parameters, and a generic
// method using `this` in an object literal implementing an interface.
type Id = <T>(x: T) => T;
type Two = <A, B>(a: A, b: B) => A;

interface Boxer {
  tag: string;
  box<T>(x: T): T[];
}

function main(): void {
  const f: Id = (x) => x;
  const a: any = f;
  const plus = (x: number) => x + 1;
  const bad = plus as unknown as Id;
  const t: Two = <A,>(a: A, b: A): A => a;
  const b: Boxer = {
    tag: "b",
    box(x) {
      console.log(this.tag);
      return [x];
    },
  };
  console.log(a, bad(1), t(1, 2), b.box(1));
}
