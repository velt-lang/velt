// A parameter an arrow assigns is renamed while checking (`param_copies`); a diagnostic about it
// names it as written.
const h = (x) => {
  x = 1;
  return x;
};
console.log(h(2));

// Text that spells the renamed form of a parameter the rewrite didn't rename is shown as
// written, also in a program where an arrow's parameter was renamed.
const v: "<param q>" = "z";
console.log(v);
