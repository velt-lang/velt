// An error at an instantiation reached through another generic function (#350) is reported where
// the failing form is, with each call on the way (`patchA(o)` in `outer`, then `outer([1])`) and
// the type arguments of both.
function patchA<T>(o: T): number {
  const p: Partial<T> | null = null;
  return p === null ? 1 : 0;
}
function outer<U>(o: U): number {
  return patchA(o);
}
console.log(outer([1]));
