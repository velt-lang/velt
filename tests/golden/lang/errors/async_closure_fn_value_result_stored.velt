// A function value read from a Map returns the job, passed straight to a generic function that
// keeps it in an array and spawns it (#2893): a stored result of a call through a function value is
// what the closures that call may reach return, so the job is refused.
type Job = () => Promise<void>;
function keepAndSpawn<T>(x: T): void {
  const box: T[] = [x];
  const v = box[0];
  spawn(async () => {
    console.log(typeof v);
  });
}
async function main() {
  let n = 0;
  const job: Job = async () => {
    n++;
  };
  const m: Map<string, () => Job> = new Map();
  m.set("a", (): Job => job);
  const h = m.get("a");
  if (h != null) {
    keepAndSpawn<Job>(h());
  }
  await sleep(10);
  console.log(`n ${n}`);
}
