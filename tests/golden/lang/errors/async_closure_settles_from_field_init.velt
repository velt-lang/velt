// A closure that may settle a promise, made by a generic function only a field initializer
// calls: what it is called with crosses.
import { channel } from "velt/sync";

async function* gen(): AsyncGenerator<string> {
  yield "a";
}

class Job {
  constructor(public run: () => Promise<void>) {}
}

function relay<T>(settle: (x: unknown) => void): (x: T) => void {
  return (x: T) => {
    settle(x);
  };
}

function sender(): (x: unknown) => void {
  return (x: unknown) => {
    void ch.send(x);
  };
}

const ch = channel<unknown>(1);

class Holder {
  f: (x: Job) => void = relay<Job>(sender());
}

const chunks = gen();
const h = new Holder();
h.f(
  new Job(async () => {
    console.log((await chunks.next()).value);
  }),
);
for await (const j of ch) {
  await (j as Job).run();
  break;
}
