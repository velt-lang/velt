// #1525 probe s2: an object a `read` callback made, holding the caller's array, stored into the caller's
// array while the callback still changes it: the store would keep a copy, where JavaScript shares
// the object (and the caller's array inside). An error.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Holder {
  rows: number[][] = [];
}
function main() {
  const a = new RwLock(new Box());
  const mine: number[][][] = [[[1]], [[2]]];
  const hs: Holder[] = [];
  a.read((x) => {
    const h = new Holder();
    h.rows.push(mine[0][0]);
    hs.push(h);
    h.rows.push([9]);
  });
  mine[0][0].push(5);
  console.log(JSON.stringify(hs[0].rows[0]));
}
