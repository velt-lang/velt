// A subclass with a constructor and an initializer of its own (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
var held: any = null;
class Box<T> { v: T; constructor() { this.v = held; } get(): T { return this.v; } }
class S<U> extends Box<U> { w: U = held; constructor() { super(); } }
function mk(): any { const p: any = Object.create(null); p.a = 1; p.b = 2; return p; }
function main() {
  const p: any = mk();
  held = p;
  const q: N = new S<W>().w;
  p.a = 5;
  console.log(q.a, p.a);
}
main();
