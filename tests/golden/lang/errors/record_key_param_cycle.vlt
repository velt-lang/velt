// A generic method that calls itself through a type parameter with a growing type argument has
// infinitely many instantiations: reported, and the record-key check (which would check
// `Record<U[], …>`, `Record<U[][], …>`, … without end) does not run.
interface Sh {
  area<U>(u: U, n: number): number;
}

function go2<S extends Sh, V>(s: S, v: V, n: number): number {
  return s.area<V>(v, n);
}

class Sq implements Sh {
  area<U>(u: U, n: number): number {
    let o: Record<U, number> | null = null;
    return n == 0 ? 0 : go2<Sq, U[]>(this, [u], n - 1);
  }
}

console.log(go2(new Sq(), "a", 3));
