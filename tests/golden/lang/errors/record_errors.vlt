// Record<K, V> misuse (docs/internals/design/record.md).
type Limit = "cpu" | "mem";

enum Color {
  Red = "red",
}

function key(): string {
  return "k";
}

function main() {
  const l: Record<Limit, i64> = { cpu: 2 };
  const m: Record<Limit, i64> = { cpu: 2, mem: 1, disk: 3 };
  console.log(l.disk);
  delete l.cpu;
  const r: Record<string, i64> = {};
  l[pick()] += 1;
  const n: Record<i64, string> = {};
  const c: Record<Color, i64> = {};
  const e = new Record<Limit, i64>();
  const x = 5;
  delete x;
  console.log(m, n, c, e);
}

function pick(): Limit {
  return "cpu";
}
