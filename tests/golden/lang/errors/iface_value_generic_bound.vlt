// An interface value does not satisfy a bound whose interface has a generic method: those are
// called on the concrete type and have no slot in the value's table.
interface Mapper { apply<U>(f: (n: number) => U): U; }
class A implements Mapper { apply<U>(f: (n: number) => U): U { return f(1); } }
function run<T extends Mapper>(m: T): string { return String(m.apply((n) => n * 10)); }
const m: Mapper = new A();
console.log(run(m));
