// An implementation of an interface method declared `: this` returns `this`, as TypeScript
// requires (TS2416): a call through a type parameter bounded by the interface gives the
// receiver itself, typed as the parameter. A result of another type is reported once, with
// the note.
interface Fluent {
  step(n: number): this;
}

class Counter implements Fluent {
  n = 0;
  step(n: number): Counter {
    this.n += n;
    return this;
  }
}

class Num implements Fluent {
  step(n: number): number {
    return n;
  }
}

class Base {
  step(n: number): Base {
    return this;
  }
}

class Inherits extends Base implements Fluent {}

function main() {
  console.log(new Counter().step(1).n);
}
