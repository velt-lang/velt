// What a C pointer (`Ptr<T>`, #3094) can't be: text, a `typeof`, an operand of arithmetic or an
// ordering, a dynamic value or JSON, directly or through a type parameter; a pointer to another
// C type; `Out<T>` of a value C must not write (a non-null pointer, a class reference).
import { Out, Ptr } from "velt/ffi";

declare c type FILE;
declare c type DIR;

class Holder {
  n = 0;
}

declare c("c") function setNull(p: Out<Ptr<FILE>>): void;
declare c("c") function setObject(p: Out<Holder>): void;

function toAny<T>(x: T): any {
  return x;
}

function text<T>(x: T): string {
  return `${x}`;
}

export function show(): void {
  // SAFETY: never read through.
  const p = unsafe { Ptr.at<FILE>(8) };
  // SAFETY: as above.
  const d = unsafe { Ptr.at<DIR>(16) };
  console.log(`${p}`, String(p), "at " + p, typeof p);
  console.log(p < p, p === d);
  const a: any = p;
  const u: unknown = p;
  const o: object = p;
  console.log(a, u, o, JSON.stringify(p));
  console.log(toAny(p), text(p));
}
