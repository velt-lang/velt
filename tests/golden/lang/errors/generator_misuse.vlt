// Misused generators: the result type, `return` with a value, `yield` outside a generator or in
// a `finally` block, a throwing `finally`, `break`/`continue` out of a `finally`, `await`, and
// `new Generator`.
function* noRet() {
  yield 1;
}

function* badRet(): i64[] {
  yield 1;
}

function* returnsValue(): Generator<i64> {
  yield 1;
  return 5;
}

function notGen(): void {
  yield 1;
}

function* wrongType(): Generator<string> {
  yield 1;
}

function* bare(): Generator<i64> {
  yield;
}

function* awaits(): Generator<i64> {
  await sleep(1);
  yield 1;
}

function* inFinally(): Generator<i64> {
  try {
    yield 1;
  } finally {
    yield 2;
  }
}

class Boom extends Error {}

function mayThrow(): void throws Boom {
  throw new Boom("x");
}

function* throwingFinally(): Generator<i64> {
  try {
    yield 1;
  } finally {
    mayThrow();
  }
}

function* arrowYield(): Generator<i64> {
  const f = (): void => {
    yield 1;
  };
  f();
}

// Closing the generator runs its `finally` blocks, which must then finish: no `break` or
// `continue` out of them (a loop inside the `finally` block is fine).
function* breakInFinally(): Generator<i64> {
  while (true) {
    try {
      yield 1;
    } finally {
      break;
    }
  }
}

function* continueInFinally(): Generator<i64> {
  outer: for (let i = 0; i < 3; i++) {
    try {
      yield i;
    } finally {
      for (let j = 0; j < 2; j++) {
        if (j == 1) {
          break;
        }
        continue outer;
      }
    }
  }
}

function main(): void {
  const g = new Generator<i64, never>();
}
