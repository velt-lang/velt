function swap(a: i64[], b: i64[]) {
  const t = a[0];
  a[0] = b[0];
  b[0] = t;
}

function append(to: i64[], from: i64[]) {
  for (const x of from) {
    to.push(x);
  }
}

class Grid {
  rows: i64[][] = [[1], [2]];
  extra: i64[] = [];

  addRow(row: i64[]) {
    this.rows.push(row.clone());
  }

  selfAppend() {
    append(this.extra, this.rows[0]);
    this.addRow(this.rows[1]);
  }
}

function main() {
  const xs: i64[] = [1, 2];
  const ys: i64[] = [3];
  swap(xs, ys);
  append(xs, ys);
  swap(xs, xs);
  append(xs, xs);
  const g = new Grid();
  append(g.rows[0], g.rows[1]);
  for (const row of g.rows) {
    append(g.extra, row);
    append(g.rows[0], row);
  }
  g.selfAppend();
}
