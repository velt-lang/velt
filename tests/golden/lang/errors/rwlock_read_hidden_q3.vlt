// An RwLock read probe (#1559): a compile error, where a silent copy would differ from Node.
// Union member on the lock side, narrowed with instanceof, returned
class A { xs: number[] = [1]; }
class B { ys: string[] = ["b"]; }
class Store { v: A | B = new A(); }
function main() {
  const lk = new RwLock(new Store());
  const r = lk.read((s) => {
    const v = s.v;
    if (v instanceof A) return v.xs;
    return [0];
  });
  r.push(9);
  lk.read((s) => { const v = s.v; if (v instanceof A) console.log(JSON.stringify(v.xs)); });
}
