// A function that reaches `shared(...)` through a return value, holding a class with its own
// `clone()`, which calls from several threads would run on one object at once.
type F = (x: i64) => i64;

class K {
  n: i64 = 0;
  clone(): K {
    this.n += 1;
    return new K();
  }
  [Symbol.dispose]() {}
}

function mk(): F {
  const k = new K();
  return (x: i64): i64 => k.n;
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
