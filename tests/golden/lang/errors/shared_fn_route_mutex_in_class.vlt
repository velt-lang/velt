// A `Mutex` in a field of a captured object, through a function the compiler can't follow.
type F = (x: i64) => i64;

class H {
  m: Mutex<i64[]> = new Mutex<i64[]>([]);
}

function mk(): F {
  const h = new H();
  return (x: i64): i64 => h.m.with((v) => {
    v.push(1);
    return v.length as i64;
  });
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
