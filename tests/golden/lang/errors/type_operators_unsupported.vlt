// Not supported yet: an interface with an index signature and methods or `extends`, and two
// index signatures in one type.
interface WithMethods {
  [key: string]: number;
  size(): number;
}

interface Base {
  id: string;
}

interface Extended extends Base {
  [key: string]: string;
}

type Two = { [k: string]: string; [i: number]: string };

function main() {}
