// A stored (escaping) closure captures its variables by value, so assigning a captured variable
// afterwards would not reach the closure's copy; JS closures see the variable itself, so this is
// an error instead of a silent difference. Regression (difftest): `f(1)` printed 2, Node 6.
function main() {
  let k = 1;
  const f = (x: i64): i64 => x + k;
  k = 5;
  console.log(f(1), k);
  let s = "a";
  const g = () => s;
  s += "b";
  let n = 0;
  const h = () => n;
  [1, 2].forEach((x) => {
    n += x;
  });
  let w = 0;
  const fs: (() => i64)[] = [];
  while (w < 3) {
    fs.push(() => w);
    w++;
  }
  console.log(g(), h(), fs.length);
}
