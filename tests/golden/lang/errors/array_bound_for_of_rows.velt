// A type parameter bounded by an array of arrays of a union, read by `for...of` (#1212,
// `array_bound_value`): each element is an array the loop's variable writes through, and an
// instantiation's rows may be `number[]`, which a `string` would break. Velt refuses it; tsc
// accepts it and Node prints `2`.
function addX<T extends (number | string)[][]>(xs: T): void {
  for (const row of xs) {
    row.push("x");
  }
}

function main(): void {
  const a: number[][] = [[1]];
  addX(a);
  console.log(a[0].length);
}
