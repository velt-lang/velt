// A `for...of` loop over a place points into the array until it ends: the body must not modify
// the array (or what owns it). Changing elements in place is fine, and moving the array out
// shares it (lang/share_for_of_moved.vlt).
class Box {
  items: string[][] = [];

  reset() {
    this.items = [];
  }

  each() {
    for (const t of this.items) {
      this.reset();
      console.log(t.length);
    }
  }
}

function main() {
  const xs = [["a"], ["b"]];
  for (const x of xs) {
    xs.push([`${x[0]}!`]);
  }
  for (const x of xs) {
    console.log(x.length);
    xs[0].push("also fine");
  }
  let ys = [["c"]];
  for (const y of ys) {
    ys = [];
  }
  const b = new Box();
  for (const t of b.items) {
    b.items.pop();
  }
  b.each();
}
