// The callbacks stored in `Input.onChange` and `Widget.set` have the same shape, so either
// holder may carry each of them to the server's threads: the note names the one whose name
// sorts first, `Input`, whatever order the types are declared and numbered in. The same program
// with an unrelated class declared between the two is http_handler_callback_holder_order_padded.vlt.
import { serve } from "http-server";

class Widget {
  set: (v: string) => void throws RangeError = (v) => {};
}

class Input {
  onChange: (v: string) => void = (v) => {};
}

async function main() {
  let last = "";
  const i = new Input();
  i.onChange = (v: string) => {
    last = v;
  };
  let state = "";
  const w = new Widget();
  w.set = (v: string) => {
    state = v;
  };
  const a = await serve({ port: 0 }, async (req) => {
    i.onChange("x");
    w.set("y");
    return new Response("ok");
  });
  await a.shutdown();
}
