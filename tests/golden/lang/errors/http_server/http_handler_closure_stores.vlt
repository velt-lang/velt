// A closure's stores through what it captured count where the closure is made (#854): one the
// constructor calls right away, and one it keeps in a field for the handler to call. Each puts
// the captured list in the new object's `out`, so `c.out.push` is an error.
import { serve } from "http-server";

class App {
  name: string = "app";
  plugins: string[] = ["a"];
}

class ClosureNow {
  app: App;
  out: string[] = [];
  constructor(a: App) {
    this.app = a;
    const self: any = this;
    const f = (): void => {
      self.out = a.plugins;
    };
    f();
  }
}

class ClosureKept {
  app: App;
  out: string[] = [];
  hook: () => void = (): void => {};
  constructor(a: App) {
    this.app = a;
    const self: any = this;
    this.hook = (): void => {
      self.out = a.plugins;
    };
  }
}

async function main() {
  const a = new App();
  const s1 = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const c = new ClosureNow(a);
    c.out.push("x");
    return new Response("1");
  });
  const b = new App();
  const s2 = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const c = new ClosureKept(b);
    c.hook();
    c.out.push("x");
    return new Response("2");
  });
  await s1.shutdown();
  await s2.shutdown();
}
