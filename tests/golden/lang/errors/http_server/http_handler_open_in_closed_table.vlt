// A function of `any` parameters stored in a table of closed parameters (#854): the conversion
// makes a new value of the table's type, which a call through the table runs.
import { serve } from "http-server";

class App {
  plugins: string[] = [];
}
function g(o: any, v: any): void {
  v.push("x");
}
const t: ((o: number, v: string[]) => void)[] = [];
t.push(g);

async function main() {
  const a = new App();
  const s = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    t[0](1, a.plugins);
    return new Response("ok");
  });
  await s.shutdown();
}
