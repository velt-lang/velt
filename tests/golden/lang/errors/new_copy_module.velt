// A `new` at the top of a module (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
class Box<T> { v: T; constructor(x: any) { this.v = x; } get(): T { return this.v; } }
const p: any = Object.create(null);
p.a = 1; p.b = 2;
const b = new Box<W>(p);
const q: N = b.get();
p.a = 5;
console.log(q.a, p.a);
