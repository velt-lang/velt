// `object` as a `WeakMap` key, a `WeakSet` member or a `WeakRef` target (issue #926): TypeScript
// accepts these; Velt does not support them yet (each type an `object` holds would have to be
// weak-capable).
function register(target: object): void {
  const ws = new WeakSet<object>();
  const wm = new WeakMap<object, number>();
  const ref = new WeakRef(target);
  console.log(ws.has(target), wm.has(target), ref.deref() === target);
}
register([1]);
