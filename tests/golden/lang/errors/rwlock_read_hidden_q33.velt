// An RwLock read probe (#1559): a compile error, where a silent copy would differ from Node.
// Single read: a part hidden behind a union put into a made object, which is then stored outside
class Node2 { v: number[] = []; kids: Node2[] = []; }
class Other { s: string = ""; }
class Box { u: Node2 | Other = new Node2(); }
function main() {
  const a = new RwLock(new Box());
  const top: Node2[] = [];
  a.read((x) => {
    const n = new Node2();
    const u = x.u;
    if (u instanceof Node2) n.kids.push(u);
    top.push(n);
  });
  a.write((x) => { const u = x.u; if (u instanceof Node2) u.v.push(5); x.u = new Other(); });
  console.log(top.length, top[0].kids.length, JSON.stringify(top[0].kids[0].v));
}
