// An RwLock read probe (#1559): the caller object put, through another variable, into an object the callback already stored: a compile error.
class Box {
  items: number[][] = [[1, 2], [3]];
}
class Row {
  v: number[] = [];
  get grow(): number {
    this.v.push(9);
    return this.v.length;
  }
}
function put(c: number[][], r: number[]) {
  c.push(r);
}
function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  let mine: number[][] = [[7]];
  const out: number[][][] = [];
  a.read((x) => {
    const c: number[][] = [[1]];
    const d = c;
    out.push(c);
    d.push(mine[0]);
  });
  mine = [[0]];
  console.log(JSON.stringify(out));
}
