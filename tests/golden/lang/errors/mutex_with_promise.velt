// A promise that changes the value a `with` callback is given would run after the lock is
// released, without it (#398): returned, stored or dropped, made here or by a function the
// callback calls. So would one returned by a function value whose body is not visible (also
// through a generic helper, reported where its result type is known), and a
// function value whose body is not visible may not be given both sides of the lock. A call
// that stores a part of the value outside and also changes the value cannot pass a copy.
class Inner {
  n: i64 = 0;
}

class Outer {
  n: i64 = 0;
  inner: Inner = new Inner();

  async bumpSelf(): Promise<i64> {
    await yieldNow();
    this.n += 1;
    return this.n;
  }

  addTo(xs: Inner[]) {
    this.n += 1;
    xs.push(this.inner);
  }
}

async function bump(o: Outer): Promise<i64> {
  await yieldNow();
  o.n += 1;
  return o.n;
}

function fire(o: Outer) {
  const p = bump(o);
}

class Hooks {
  put: (o: Outer, xs: Inner[]) => void = (o: Outer, xs: Inner[]) => {};
}

function first<T>(m: shared<Mutex<Outer>>, fs: ((o: Outer) => T)[]): T {
  return m.with(fs[0]);
}

function apply(m: shared<Mutex<Outer>>, g: (o: Outer) => void) {
  m.with((v) => {
    g(v);
  });
}

async function main() {
  const m = shared(new Mutex<Outer>(new Outer()));
  const a = await m.with((v) => bump(v));
  const b = await m.with((v) => v.bumpSelf());
  const ps: Promise<i64>[] = [];
  m.with((v) => {
    ps.push(bump(v));
  });
  m.with((v) => {
    const p = bump(v);
  });
  m.with((v) => {
    const g = () => bump(v);
    const p = g();
  });
  m.with((v) => fire(v));
  const fs: ((o: Outer) => Promise<i64>)[] = [bump];
  const c = await m.with(fs[0]);
  const out: Inner[] = [];
  m.with((v) => v.addTo(out));
  apply(m, (o: Outer) => {
    const p = bump(o);
  });
  const d = first(m, [(o: Outer) => o.n]);
  const e = await first(m, [bump]);
  const hooks = new Hooks();
  m.with((v) => hooks.put(v, out));
  console.log(a, b, c, d, e);
}
