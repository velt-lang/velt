// An array a `read` nested in another stores into a container of the code outside every read,
// into which the outer callback then stores a part of the lock's value: an error at the store,
// since JavaScript would share that part with the caller (#1523, #1541).
class Rows {
  items: number[][] = [[1, 2], [3]];
}

function main() {
  const c = new RwLock(new Rows());
  const d = new RwLock(new Rows());
  const rows: number[][][] = [];
  c.read((x) => {
    const l: number[][][] = [[[1]]];
    d.read((y) => {
      rows.push(l[0]);
    });
    console.log("stored", rows[0] === l[0]);
    l[0].push(x.items[0]);
    console.log(rows[0] === l[0], l[0].length);
  });
  console.log(JSON.stringify(rows));
}
