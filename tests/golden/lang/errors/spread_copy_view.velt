// A spread of a conversion that became a view: Node copies all of the object's fields, and a value
// of this fixed shape has no place for the others.
const made = new Proxy({}, {});
type W = { a: number; b: string };
type N = { a: number };
const w: W = { a: 1, b: "x" };
const v: N = w;
v.a = 2;
console.log({ ...v });
