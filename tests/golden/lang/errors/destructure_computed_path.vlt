// A destructuring pattern's computed key must be a string or number literal or a name: a path
// or another expression (`[t.tag]`, `[K.A]`, `["a" + "b"]`) names a property only known while the
// program runs, so read it with an index instead (`const v = o[t.tag]`).

const K = { A: "a" } as const;

function main() {
  const t = { tag: "a" };
  const o: Record<string, number> = { a: 1, ab: 2 };
  const { [t.tag]: v } = o;
  const { [K.A]: w } = o;
  const { ["a" + "b"]: x } = o;
  console.log(v, w, x);
}
