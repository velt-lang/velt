// A destructuring pattern's computed key must be a string or number literal: what `[t.tag]`,
// `[K.A]`, `[KEY]` or `[k]` names is not resolved in a pattern, so it is reported rather than read
// as a field named `[KEY]`. Read the property with an index instead (`const v = o[KEY]`).

const K = { A: "a" } as const;
const KEY = "a";
const NK = 1.5;

interface T {
  a: number;
}

function main() {
  const t = { tag: "a" };
  const o: Record<string, number> = { a: 1 };
  const typed: T = { a: 1 };
  const { [t.tag]: v } = o;
  const { [K.A]: w } = o;
  const { [KEY]: x } = o;
  const { [KEY]: y } = typed;
  const k = "b";
  const { [k]: z, [NK]: n } = o;
  console.log(v, w, x, y, z, n);
}
