// @jsxImportSource ../_jsx_directives

// Directives on an async component (`jsxComponentDirectives` takes a synchronous one), the same
// directive twice, and a directive that is not declared (a prop like any other name).

async function Slow(props: { n: i64 }): Promise<JSX.Element> {
  return <p>{props.n}</p>;
}

function Card(props: { n: i64 }): JSX.Element {
  return <p>{props.n}</p>;
}

function main() {
  const a = <Slow client:load n={1} />;
  const b = <Card client:load client:load n={1} />;
  const c = <Card server:only n={1} />;
}
