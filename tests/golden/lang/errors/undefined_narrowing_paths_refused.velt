// What tsc refuses next to the accepted forms: the parameter whose default may be `undefined`
// used as a `T` (TS2322), the member after a failed `typeof a?.b` test (TS2722), the field
// after a failed `Array.isArray` (TS18048), and the two below.
function current(): number | undefined { return undefined; }
function f(x: number | undefined = current()): number {
    const y: number = x;
    return y;
}
interface T { headers?: () => string }
function g(c: T | undefined): string {
    if (typeof c?.headers !== "function") return c.headers();
    return "";
}
function h(o: { a?: number[] }): number {
    return Array.isArray(o.a) ? 0 : o.a.length;
}
// `typeof a?.b === "undefined"` does not tell that `a` has a value (TS2322).
interface U { b?: string }
function k(a: U | undefined): string {
    if (typeof a?.b === "undefined") {
        const x: U = a;
        return x.b ?? "";
    }
    return "";
}
// A result expected as `R | undefined` infers from `R`, and a `Box<number>` is not a
// `Box<string>` (TS2322).
interface Box<T> { v: T }
function mk2<T>(v: T): Box<T> { return { v }; }
let e: Box<string> | undefined = mk2(1);
console.log(f(), g(undefined), h({}), k(undefined), e);
