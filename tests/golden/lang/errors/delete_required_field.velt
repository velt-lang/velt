// `delete` of a required field (or a method) is TypeScript's TS2790, and of a `readonly` field
// TS2704. A class's optional field is an own property from construction, which Velt has no way
// to remove (TypeScript accepts that `delete`).
type R = { c: number; d?: number; readonly e?: number };

class K {
  v?: number;
  w: number = 1;
  m(): void {}
}

const r: R = { c: 1 };
delete r.c;
const k = new K();
delete k.v;
delete k.w;
delete k.m;
delete r.e;
delete r.d;
