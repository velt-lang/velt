// Intersections Velt rejects, each with its fix: parts with no value in common, classes,
// arrays and function types as parts, a class as a type parameter part's argument, a member of
// the type parameter part of an intersection in generic code (#350), and extra or missing fields
// in a literal.
type Conflict = { k: string } & { k: number };
type Kinds = { kind: "a"; x: number } & { kind: "b" };

class Point {
  x = 0;
}
type Located = Point & { label: string };
type Listed = string[] & { label: string };
type Overloads = ((x: string) => void) & ((x: number) => void);

type Tagged<T> = T & { tag: string };

function label<T>(v: Tagged<T>): string {
  return v.name;
}

type A = { a: number };
type AB = A & { b: number };

function main() {
  const missing: AB = { a: 1 };
  const extra: AB = { a: 1, b: 2, c: 3 };
  const point: Tagged<Point> = new Point();
}

// An alias can refer to itself through `&` only when its parts' fields have distinct names.
type Base = { kids: number };
type Tree = Base & { kids: Tree[] };
