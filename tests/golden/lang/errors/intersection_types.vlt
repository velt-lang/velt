// Intersections Velt rejects, each with its fix: parts with no value in common, classes,
// arrays, function types and type parameters as parts, and extra or missing fields in a literal.
type Conflict = { k: string } & { k: number };
type Kinds = { kind: "a"; x: number } & { kind: "b" };

class Point {
  x = 0;
}
type Located = Point & { label: string };
type Listed = string[] & { label: string };
type Overloads = ((x: string) => void) & ((x: number) => void);

function merge<T, U>(t: T, u: U): T & U {
  return merge(t, u);
}

type A = { a: number };
type AB = A & { b: number };

function main() {
  const missing: AB = { a: 1 };
  const extra: AB = { a: 1, b: 2, c: 3 };
}

// TypeScript merges interface declarations; Velt asks for one, or an intersection.
interface Shape {
  w: number;
}
interface Shape {
  h: number;
}

// An alias can't refer to itself through `&` either.
type Tree = { kids: Tree[] } & { value: number };
