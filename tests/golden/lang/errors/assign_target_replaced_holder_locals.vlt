// A variable holding the object: a right-hand side that assigns it itself, or a closure that
// captures it, may replace it (#876). Each assignment is an error (JavaScript writes into the
// old object and prints 100).
type Inner = { v: number };
type Outer = { inner: Inner };
function keep(o: Outer): number { return 13; }
function t01(): void {
  let o: Outer = { inner: { v: 0 } };
  o.inner.v = keep(o = { inner: { v: 100 } });
  console.log(o.inner.v);
}
function t02(): void {
  let o: Outer = { inner: { v: 0 } };
  const reset = (): number => { o = { inner: { v: 100 } }; return 13; };
  o.inner.v = reset();
  console.log(o.inner.v);
}
function t03(): void {
  const outers: Outer[] = [{ inner: { v: 0 } }];
  for (let o of outers) {
    const reset = (): number => { o = { inner: { v: 100 } }; return 13; };
    o.inner.v = reset();
    console.log(o.inner.v);
  }
}
function t04(): void {
  let o: Outer = { inner: { v: 0 } };
  o.inner.v = [1].map((k) => { o = { inner: { v: 100 } }; return 13; })[0];
  console.log(o.inner.v);
}
function main(): void {}
