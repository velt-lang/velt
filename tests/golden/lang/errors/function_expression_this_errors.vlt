// `this` in a generator function expression (TypeScript's TS2683, as for other function
// expressions), and in a function expression that is an object-literal property (TypeScript
// types `this` as the literal there; not supported yet).
class K {
  x = 5;
  m(): number[] {
    const g = function* (): Generator<number> {
      yield this.x;
    };
    return [...g()];
  }
}
