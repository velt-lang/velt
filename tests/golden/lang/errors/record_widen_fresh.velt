// An existing record (a variable) where a record of another value type is expected converts by
// copying its entries (`record_widen_copy`), which a later write to the record shows: an error
// (#1185). A record of `any` or `unknown` values takes it as a view of the one record
// (`record_view_any`, #379).
function keys(r: Record<string, string | number>): number {
  return Object.keys(r).length;
}
const names: Record<string, string> = { a: "x" };
console.log(keys(names));
names["b"] = "y";
