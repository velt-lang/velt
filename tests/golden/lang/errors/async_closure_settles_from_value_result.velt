// A closure that may settle a promise, returned by a generic function the program calls only
// through a function value: its callers are not followed, so what it is called with crosses.
async function* gen(): AsyncGenerator<string> {
  yield "a";
}

class Job {
  constructor(public run: () => Promise<void>) {}
}

function relay<T>(settle: (x: unknown) => void): (x: T) => void {
  return (x: T) => {
    settle(x);
  };
}

const chunks = gen();
const { promise, resolve } = Promise.withResolvers<unknown>();
const r: (settle: (x: unknown) => void) => (x: Job) => void = relay;
const f = r(resolve);
f(
  new Job(async () => {
    console.log((await chunks.next()).value);
  }),
);
await ((await promise) as Job).run();
