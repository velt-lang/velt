// Statements may come before `super(...)`, but not ones that use `this` or `super.x`: the
// object is not constructed yet (TypeScript's rule; #330).
class B {
  n: i64;
  constructor(n: i64) {
    this.n = n;
  }
  get(): i64 {
    return this.n;
  }
}
class FieldBefore extends B {
  m: i64 = 1;
  constructor() {
    this.m = 2;
    super(1);
  }
}
class MethodBefore extends B {
  constructor() {
    const k = this.get();
    super(k);
  }
}
class SuperBefore extends B {
  constructor() {
    const k = super.get();
    super(k);
  }
}
class InArgs extends B {
  constructor() {
    super(this.n);
  }
}
class InClosure extends B {
  constructor() {
    const f = (): i64 => this.n;
    super(1);
    console.log(f());
  }
}
class InBranch extends B {
  constructor(f: bool) {
    if (f) {
      console.log(this);
    }
    super(1);
  }
}
class ReturnBefore extends B {
  constructor(f: bool) {
    if (f) {
      return;
    }
    super(1);
  }
}
class Fine extends B {
  constructor(k: i64) {
    const doubled = k * 2;
    super(doubled);
    console.log(this.n, super.get());
  }
}
function main() {}
