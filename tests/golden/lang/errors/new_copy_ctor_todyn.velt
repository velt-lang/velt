// A generic constructor that makes its parameter an `any` shows the copy (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
var held: any = null;
class Box<T> { constructor(x: T) { held = x; } }
function main() {
  const w: W = { a: 1, b: 2 };
  const q: N = w;
  new Box<N>(q);
  (held as any).a = 5;
  console.log(w.a, q.a);
}
main();
