// A generic arrow function is the value of a `const` with typed parameters; without a return
// type it infers one, which a self-use in its return expressions prevents. A local one is a
// generic function nested in its function: it captures nothing, and a use as a value needs a
// function type to instantiate it at.

const untypedParam = <T,>(x) => x;
const selfReturning = <T,>(x: T) => selfReturning(x);

function apply(f: (x: i64) => i64): i64 {
  return f(1);
}

function main() {
  const k = 3;
  const id = <T,>(x: T): T => x;
  const asValue = id;
  console.log(apply(<T,>(x: T): T => x));
  const capturing = <T,>(x: T): i64 => k;
}

class Holder {
  n: i64 = 1;
  get(): i64 {
    const withThis = <T,>(x: T): i64 => this.n;
    return withThis(0);
  }
}
