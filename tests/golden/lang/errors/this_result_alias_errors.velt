// A `const` that TypeScript types as the class rather than `this` is not `this`: one with a
// written type other than `this`, or through `as` to one, for `this` and for a `this`-returning
// call on it; nor is `this` returned through `as` to the class, or a call on such a cast; nor a
// binding declared with a default (TypeScript's TS2322, #3772).
class A {
  n = 0;
  step(): this {
    return this;
  }
  annotated(): this {
    const r: A = this;
    return r;
  }
  cast(): this {
    const r = this as A;
    return r;
  }
  annotatedCall(): this {
    const r: A = this.step();
    return r;
  }
  castCall(): this {
    const r = this.step() as A;
    return r;
  }
  returnCast(): this {
    return this as A;
  }
  // A `this`-returning call on `this` cast to the class gives the class too.
  castReceiver(): this {
    return (this as A).step();
  }
  castReceiverKept(): this {
    const r = (this as A).step();
    return r;
  }
  castAlias(): this {
    const r = this;
    return (r as A).step();
  }
  // A binding with a default is typed with the default's type too (`this | A`), even where the
  // element is there and the default never applies.
  defaulted(o: A): this {
    const [r = o] = [this];
    return r;
  }
  defaultedCall(o: A): this {
    const [r = o] = [this.step()];
    return r;
  }
  defaultedSecond(o: A): this {
    const [, r = o] = [o, this];
    return r;
  }
  defaultedNested(o: A): this {
    const [[r = o]] = [[this]];
    return r;
  }
  defaultedField(o: A): this {
    const [{ r = o }] = [{ r: this }];
    return r;
  }
  defaultedFirst(o: A): this {
    const [q = o, r] = [this, this];
    return q;
  }
}

function main() {
  console.log(new A().step().n);
}
