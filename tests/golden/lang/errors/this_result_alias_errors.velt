// A `const` that TypeScript types as the class rather than `this` is not `this`: one with a
// written type other than `this`, or through `as` to one, for `this` and for a `this`-returning
// call on it; nor is `this` returned through `as` to the class (TypeScript's TS2322, #3772).
class A {
  n = 0;
  step(): this {
    return this;
  }
  annotated(): this {
    const r: A = this;
    return r;
  }
  cast(): this {
    const r = this as A;
    return r;
  }
  annotatedCall(): this {
    const r: A = this.step();
    return r;
  }
  castCall(): this {
    const r = this.step() as A;
    return r;
  }
  returnCast(): this {
    return this as A;
  }
}

function main() {
  console.log(new A().step().n);
}
