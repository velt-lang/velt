// `this` in a function expression without a `this` parameter (TypeScript's TS2683), and a
// `this` parameter on an arrow (TS2730). Not supported yet: `this` in a function with a `this`
// parameter, and a function expression's own name inside its body.
const g = function () {
  return this;
};
const h = function (this: { n: number }) {
  return this.n;
};
const fact = function fact(n: number): number {
  return n <= 1 ? 1 : n * fact(n - 1);
};
const k = (this: number) => 1;
