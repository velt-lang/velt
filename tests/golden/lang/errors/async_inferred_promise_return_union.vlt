// An async function without a result type returning a promise on one path and a number on
// another (#1166): its result is `number`, as in TypeScript, never `number | Promise<number>`;
// the returned promise is reported like with a written result type (#1148).
async function v(n: number): Promise<number> {
  await Promise.resolve(0);
  return n;
}

async function inferred(x: number) {
  if (x > 0) {
    return v(x);
  }
  return 0;
}

async function main() {
  console.log(await inferred(5), await inferred(-1));
}
