// `"k" in o` must be answered correctly or rejected, never a silent `false`: a key known only at
// run time on an object with fixed fields, a built-in value, and a key a narrower object type
// left out of its copy (`const p: P = full`) are errors. A primitive right operand (TS2322,
// TS18047 for a nullable one) and a left operand that is not a string, number or symbol (TS2322,
// also on a record) are errors at the positions tsc reports, once each. A key whose type is a
// union of string literals or `string | number` is a key known only at run time, not a TS2322,
// and so is an enum-typed key (a string enum or a numeric one).
type P = { x: number };

enum Color {
  Red = "red",
  Blue = "blue",
}

enum Num {
  One = 1,
  Two,
}

function hasY(p: P): boolean {
  return "y" in p;
}

function main() {
  const o = { a: 1 };
  const k: string = "a";
  console.log(k in o);
  console.log("a" in 5);
  console.log(true in o);
  const full = { x: 1, y: 2 };
  console.log(hasY(full));
  console.log("length" in [1, 2]);
  const n: { a: number } | null = null;
  console.log("a" in n);
  const r: Record<string, number> = { a: 1 };
  console.log("a" in o in r);
  console.log(true in r);
  let lit: "a" | "b" = "a";
  console.log(lit in o);
  lit = "b";
  const mixed: string | number = 1;
  console.log(mixed in o);
  const color: Color = Color.Red;
  console.log(color in o);
  const num: Num = Num.Two;
  console.log(num in o);
}
