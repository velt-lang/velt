// A variable that a closure assigns is not narrowed, also not inside the closure: it could run
// again (here in `forEach`) with the value it assigned, which the check does not allow (#435).
function f(u: string | null): usize {
  let n: usize = 0;
  if (u != null) {
    [1, 2].forEach((x) => {
      n += u.length;
      u = null;
    });
  }
  return n;
}

function main() {
  console.log(f("ab"));
}
