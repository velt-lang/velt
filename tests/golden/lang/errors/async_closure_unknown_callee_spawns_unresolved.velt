// A generic class's method, reached through an interface, that spawns its parameter of a type
// parameter, in a class a subclass extends: the subclass may give the type parameter's type in its
// `extends`, which no `new` of the class shows, so the parameter stands for any function type, and
// a closure passed to an unknown callee crosses and must not change what it captured (#2726,
// #2740, #2741).

type Job = () => Promise<void>;

interface Runner<T> {
  run(g: T): void;
}

class Spawner<T extends Job> implements Runner<T> {
  run(g: T): void {
    spawn(g());
  }
}

class JobSpawner extends Spawner<Job> {}

async function main() {
  let n = 0;
  const r: Runner<Job> = new JobSpawner();
  r.run(async (): Promise<void> => {
    n += 1;
  });
}
