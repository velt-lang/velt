// A generic class's method, reached through an interface, that spawns its parameter of a type
// parameter: no call gives that type parameter's type, so the parameter stands for any function
// type, and a closure passed to an unknown callee crosses and must not change what it captured
// (#2726, #2740).

type Job = () => Promise<void>;

interface Runner<T> {
  run(g: T): void;
}

class Spawner<T extends Job> implements Runner<T> {
  run(g: T): void {
    spawn(g());
  }
}

async function main() {
  let n = 0;
  const r: Runner<Job> = new Spawner<Job>();
  r.run(async (): Promise<void> => {
    n += 1;
  });
}
