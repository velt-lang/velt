// A user module in a directory named `std` is not the standard library: it may not declare a
// compiler intrinsic (built on its own here, it is the root module), as it may not import std's
// `@intrinsic`.
import { intrinsic } from "velt/lang/intrinsics";

@intrinsic
declare function arrayWithCapacity<T>(capacity: usize): T[];

export function grow(n: i64): i64[] {
  return arrayWithCapacity<i64>(n as usize);
}

function main() {
  console.log(grow(1).length);
}
