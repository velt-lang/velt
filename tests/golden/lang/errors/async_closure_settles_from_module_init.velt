// A closure that may settle a promise, made by a generic function only a module-level
// initializer calls (`_settle_module_init_lib.velt`): what it is called with crosses.
import { Job, ch, f } from "./_settle_module_init_lib.velt";

async function* gen(): AsyncGenerator<string> {
  yield "a";
}

const chunks = gen();
f(
  new Job(async () => {
    console.log((await chunks.next()).value);
  }),
);
for await (const j of ch) {
  await (j as Job).run();
  break;
}
