// A module constant evaluated at each use can't be written through `!`, `as`, `??` or `?:`
// either, as it can't be written directly (`K.v = 1`): the write would change a copy that the
// next use doesn't see, where Node changes the one object (#1406).

interface J {
  v: number;
  a: { b: number };
}

export const K: J | null = { v: 1, a: { b: 1 } };
export const N: J = { v: 1, a: { b: 1 } };
export const U: { o: J | null } = { o: { v: 1, a: { b: 1 } } };
let D: J = { v: 0, a: { b: 0 } };

K!.v = 4;
K!.v++;
(K as J).v += 1;
U.o!.v = 6;
(U.o ?? D).v = 2;
(K as unknown as J).v = 3;
(K as any).v = 3;
(N as unknown as J).a.b = 3;
(N as any).v = 3;
(true ? K! : D).v = 3;
(D.v > 0 ? D : N).v = 3;
if (K?.a) {
  K!.a.b = 3;
}
K?.a && (K!.a.b = 3);
console.log(K!.v, U.o!.v, N.v);
