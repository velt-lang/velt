// A proxy trap that throws a value other than an `Error` (#1174): Node lets the operation throw
// it; Velt infers a trap's error type and keeps only `Error` classes, so it says what to throw
// instead.
const p: any = new Proxy({ a: 1 }, {
  get(t, k, r) {
    if (k === "bad") {
      throw "a string";
    }
    return Reflect.get(t, k, r);
  },
});
try {
  console.log(p.bad);
} catch (e) {
  console.log("caught", e);
}
