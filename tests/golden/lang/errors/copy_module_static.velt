// A static field's initializer, read in a function (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
function mk(): any { const p: any = Object.create(null); p.a = 1; p.b = 2; return p; }
const p: any = mk();
class S { static w: W = p; }
function main() {
  const q: N = S.w;
  p.a = 5;
  console.log(q.a, p.a);
}
main();
