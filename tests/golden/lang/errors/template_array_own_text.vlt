// An array whose elements JS writes with their own method that lowering has no hook for (a
// struct's `toString()`, a `RegExp`) cannot be written by a template literal,
// `join` or `toString()`: the error says what JS writes and gives the `.map(...).join(",")`
// that writes it. A class's `toString()` is called (template_array_tostring.vlt), and an
// error's is `Error`'s (std/error_text_values.vlt).
struct S {
  x: number;
  toString(): string {
    return "S!";
  }
}

function main() {
  const ss: S[] = [{ x: 1 }];
  console.log(`${ss}`);
  console.log(ss.join(","));
  console.log([/a/g].join());
  const t: [number, S | null] = [1, null];
  console.log(`${t}`);
}
