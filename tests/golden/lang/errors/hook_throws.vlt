// toString() and toJSON() cannot throw: the glue that calls them has nowhere to send the error.
class Loud {
  toString(): string {
    throw new Error("no");
  }
}
class Picky {
  toJSON(): number {
    if (Math.random() > 2) {
      throw new Error("no");
    }
    return 1;
  }
}
console.log(`${new Loud()}`, JSON.stringify(new Picky()));
