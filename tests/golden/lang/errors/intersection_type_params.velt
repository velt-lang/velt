// Intersections with a type parameter part (#350) whose type arguments make no value: each is
// reported at the argument that fixes them: parts whose shared field has two types have none
// (TypeScript: `never`, TS2322). A class is a part: `C & { id: string }` is `C` (it has `id`).
class C {
  x = 1;
  id = "a";
}

function stamp<T>(x: T & { id: string }): T & { id: string } {
  return x;
}

function main() {
  const c = stamp<C>(new C());
  const n = stamp<{ id: number }>({ id: 1 });
  const m = stamp({ a: 1, id: 2 });
  console.log(c, n, m);
}
