// `Map` and `Record` reads copy the stored value, so they are errors when the value is a
// promise or a value type holding one (TypeScript allows them; shared promises are #212). A class
// instance holding a promise is shared, not copied, so reading it works
// (lang/promises_in_collections).
async function work(n: i64): Promise<string> {
  return `done ${n}`;
}

struct Task {
  run: Promise<string>;
}

async function main() {
  const m = new Map<string, Promise<string>>();
  m.set("a", work(1));
  const p = m.get("a");
  const all = m.values();
  const pairs = m.entries();
  for (const [k, v] of m) {
    console.log(k);
  }
  const tasks = new Map<string, Task>();
  tasks.set("t", Task { run: work(2) });
  const t = tasks.get("t");
  const r: Record<string, Promise<string>> = {};
  r["x"] = work(3);
  const x = r["x"];
  const vals = Object.values(r);
  const results = new Map<string, string>();
  results.set("ok", await work(4));
  console.log(results.get("ok"), m.has("a"), m.size);
}
