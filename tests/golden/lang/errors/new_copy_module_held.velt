// A `new` in a module constant's initializer, read in a function (Node prints 5 5).
type W = { a: number; b: number };
type N = { a: number };
function mk(): any { const p: any = Object.create(null); p.a = 1; p.b = 2; return p; }
class Box<T> { v: T; constructor(x: any) { this.v = x; } }
const p: any = mk();
const b = new Box<W>(p);
function main() {
  const q: N = b.v;
  p.a = 5;
  console.log(q.a, p.a);
}
main();
