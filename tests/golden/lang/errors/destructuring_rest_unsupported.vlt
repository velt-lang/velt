// `...rest` that is not supported (of an `any`, next to a computed key) and a computed key
// that is an expression in an assignment target: one error each, nothing at their uses.
function k(s: string): string {
  return s;
}

function main(): void {
  const o: Record<string, number> = { a: 1 };
  let p = 0;
  ({ [k("a")]: p } = o);
  const anyv: any = [1, 2, 3];
  const [first, ...others] = anyv;
  const K = "a";
  const { [K]: x, ...rest } = o;
  console.log(p, first, others, x, rest, others.length, rest.a);
}
