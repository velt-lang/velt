// An arrow used as a function type with a rest parameter (#943), in the forms that are errors:
// a named parameter for a rest argument whose type cannot be `undefined` (a missing argument
// would be), a rest parameter after more fixed parameters than the type has (TypeScript
// accepts both), and a rest parameter whose type is no array type (TypeScript's TS2370).
type Log = (prefix: string, ...xs: number[]) => string;
type Bad = (...xs: number) => void;

function main() {
  const a: Log = (p, x) => p + x;
  const b: Log = (p, q, ...xs) => p;
  const c: Log = (p) => p;
  console.log(c("x"));
}
