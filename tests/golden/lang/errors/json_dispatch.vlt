// A generic method that parses its type parameter as JSON, reached only by dynamic dispatch
// (through an interface, or an interface's default method), is checked where its class is
// instantiated.
interface I {
  m(s: string): string;
}
class G<T> implements I {
  m(s: string): string {
    return JSON.stringify(JSON.parse<T>(s));
  }
}
function use(i: I): string {
  return i.m("{}");
}

interface D<T> {
  d(s: string): string {
    return JSON.stringify(JSON.parse<T>(s));
  }
}
class H implements D<Map<i64, i64>> {}
function useDefault(x: D<Map<i64, i64>>): string {
  return x.d("{}");
}

function main() {
  console.log(use(new G<Map<i64, i64>>()));
  console.log(useDefault(new H()));
  console.log(use(new G<Map<string, i64>>()));
}
