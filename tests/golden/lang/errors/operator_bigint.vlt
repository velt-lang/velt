// A number operand of a BigInt operator is an error, in both directions, as in JavaScript and
// TypeScript; the note names the fix (#2096). Shift counts are `i64`s.
import { BigInt } from "velt/math";

const b = new BigInt(7);
const k: i64 = 2;
const x = b + 3;
const y = 3 * b;
const z = 10 - b;
const v = b - k;
let w = new BigInt(1);
w += 3;
w %= k;
const s = b << 3;
