// Changing a part of an interface field (`x.o.v += 1`) that a class provides with a `get`
// accessor is not supported yet (#350): Node changes the object the getter returns in place and
// never calls a setter, while Velt reads a copy and would have to write it back through
// `set o(v)`. The error is at each such class, also one only read through the interface
// elsewhere (`G` through `R`) or through an intersection, with the write as a label.
interface I {
  o: { v: number };
  m(): number;
}
class Pair implements I {
  sets = 0;
  _o: { v: number } = { v: 1 };
  m(): number { return 0; }
  get o(): { v: number } { return this._o; }
  set o(x: { v: number }) { this.sets++; this._o = { v: x.v * 10 }; }
}
function bump(x: I): void {
  x.o.v += 1;
}
// Through an intersection too: the error names the interface part declaring the field.
class KPair extends Pair {
  k = 1;
}
function bumpX(x: { k: number } & I): void {
  x.o.v += 2;
}

interface R {
  readonly t: [number, string];
  m(): number;
}
class G implements R {
  _t: [number, string] = [1, "a"];
  m(): number { return 0; }
  get t(): [number, string] { return this._t; }
}
class P implements R {
  t: [number, string] = [3, "c"];
  m(): number { return 0; }
}
function rd(x: R): void {
  console.log(x.t[0]);
}
function wr(x: R): void {
  x.t[0]++;
}

function main() {
  const p = new Pair();
  bump(p);
  bumpX(new KPair());
  console.log(p._o.v, p.sets);
  rd(new G());
  wr(new P());
}
