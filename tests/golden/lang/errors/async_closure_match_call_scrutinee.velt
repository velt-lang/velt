// A `Job | null` returned through another function as `unknown` (#2893): the conversion matches on
// a call's result, whose bindings take what it holds, so the job is refused.
type Job = () => Promise<void>;
function keepAndSpawn<T>(x: T): void {
  const box: T[] = [x];
  const v = box[0];
  spawn(async () => {
    console.log(typeof v);
  });
}
function pick(j: Job | null): Job | null {
  return j;
}
function wrap(j: Job | null): unknown {
  return pick(j);
}
async function main() {
  let n = 0;
  const job: Job = async () => {
    n++;
  };
  keepAndSpawn<unknown>(wrap(job));
  await sleep(10);
  console.log(`n ${n}`);
}
