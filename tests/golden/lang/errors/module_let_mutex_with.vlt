// A `with` callback cannot reach module state: `with` blocks the thread while it waits, and a
// task holds the module lock for its whole step, so two tasks could wait for each other.
let count = 0;
const names = new Map<string, number>();
function bump(): number {
  count++;
  return count;
}
function viaBump(): number {
  return bump();
}
function main() {
  const m = new Mutex<number>(0);
  m.with((v) => {
    v = v + count;
  });
  m.with((v) => {
    v = viaBump();
  });
  m.with((v) => {
    v = names.size;
  });
  const f = (): number => 1;
  m.with((v) => {
    v = f();
  });
  m.with((v) => {
    v = v + 1;
  });
}
