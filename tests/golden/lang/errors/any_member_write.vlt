// A compound assignment or an update of a member of an `any` comes with a later part of #924
// (it needs the operators of `any`); a member of an `unknown` needs narrowing first (TS18046 in
// `tsc --strict`).
class P {
  x: number = 1;
}
function main(): void {
  const a: any = new P();
  a.x = 2;
  a.x += 1;
  a.x++;
  const u: unknown = new P();
  console.log(u.x);
  u.x = 3;
}
