// A function type written without `throws` whose error types are inferred from what is stored
// into it (#1154) is shown as written in an unrelated type error.
class Failed extends Error {}

function attempt(f: () => void) {
  try {
    f();
  } catch (e) {
    console.log((e as Error).message);
  }
}

attempt(() => {
  throw new Failed("x");
});

const callbacks: Array<() => void> = [];
const n: number = callbacks;
console.log(n);

// An error union reads in one order (by name), whatever order its classes were made in.
class Zed extends Error {}
class Alpha extends Error {}
function pick(x: number): void throws Zed | Alpha {
  if (x > 0) {
    throw new Zed("z");
  }
  throw new Alpha("a");
}
const s: string = pick;
console.log(s);
