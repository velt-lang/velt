// 29 (a11: spawn of an async call through an interface method (receiver only) copies with clone())
class R_29 {
  f: () => number;
  constructor(f: () => number) { this.f = f; }
  clone(): R_29 { console.log("clone"); this.f(); return new R_29(this.f); }
  [Symbol.dispose](): void {}
}
interface Job_29 { go(): Promise<number>; }
class W_29 implements Job_29 { r: R_29; constructor(r: R_29) { this.r = r; } async go(): Promise<number> { return 1; } }
function take_29(p: Promise<number>): number { return 13; }
function t29(): void {
  const o: Outer = { inner: { v: 0 } };
  const bump = (): number => { o.inner = { v: 100 }; return 13; };
  const j: Job_29 = new W_29(new R_29(bump));
  o.inner.v = take_29(spawn(j.go()));
  console.log(o.inner.v);
}
