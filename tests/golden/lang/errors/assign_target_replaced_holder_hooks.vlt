  [Symbol.dispose](): void {}
}
class S_27 { async use(r: R_27): Promise<number> { return 1; } }
class T_27 extends S_27 { override async use(r: R_27): Promise<number> { return 2; } }
function take_27(p: Promise<number>): number { return 13; }
function t27(): void {
  const o: Outer = { inner: { v: 0 } };
  const bump = (): number => { o.inner = { v: 100 }; return 13; };
  const r = new R_27(bump);
