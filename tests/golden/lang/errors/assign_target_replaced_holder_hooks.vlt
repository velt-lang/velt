// Class hooks that glue calls without a call in the program (#876): toString() from String(x),
// join and templates, toJSON() from JSON.stringify, __inspect() from console.log, and
// [Symbol.dispose]() from drop glue, reached directly, through containers, generic code, a base
// class and a using declaration, and a resource class's own clone(), which spawn runs to copy
// the arguments and receiver of an async call through a function value, a vtable or an
// interface. Each hook calls a function value that replaces o.inner, so each assignment is an
// error (JavaScript writes into the old object and prints 100).
type Inner = { v: number };
type Outer = { inner: Inner };
// 01 (q08)
class T_01 { f: () => number; constructor(f: () => number) { this.f = f; } toString(): string { this.f(); return "abcdefghijklm"; } }
function t01(): void {
  const o: Outer = { inner: { v: 0 } };
  const bump = (): number => { o.inner = { v: 100 }; return 13; };
  const t = new T_01(bump);
  o.inner.v = [t].join().length;
  console.log(o.inner.v);
}
