// 26 (a2: spawn of an async call through a function value copies with clone())
class R_26 {
  f: () => number;
  constructor(f: () => number) { this.f = f; }
  clone(): R_26 { console.log("clone"); this.f(); return new R_26(this.f); }
  [Symbol.dispose](): void {}
}
async function use_26(r: R_26): Promise<number> { return 1; }
function take_26(p: Promise<number>): number { return 13; }
function t26(): void {
  const o: Outer = { inner: { v: 0 } };
  const bump = (): number => { o.inner = { v: 100 }; return 13; };
  const r = new R_26(bump);
  const af = use_26;
  o.inner.v = take_26(spawn(af(r)));
  console.log(o.inner.v, o.inner === o.inner);
}
// 27 (a3: spawn of an async call through a virtual method copies with clone())
class R_27 {
  f: () => number;
