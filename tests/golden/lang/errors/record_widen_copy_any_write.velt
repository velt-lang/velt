// A record where a record of a wider value type is expected is a copy, which a write through
// `any` to the copy shows: the record never gets the key (Node prints a,b: one record).
const keep: Record<string, string | boolean | undefined>[] = [];
function hold(r: Record<string, string | boolean | undefined>): void {
  keep.push(r);
}
const attrs: Record<string, string | undefined> = { a: "1" };
hold(attrs);
const h: any = keep[0];
h.b = "2";
console.log(Object.keys(attrs).join(","));
