// A nested read storing a concat of both locks' parts into the caller's arrays and the outer reader's (#1525 probe a3):
// JavaScript would share those parts with code that does not hold the lock. An error that says
// to store an explicit copy (`structuredClone(…)`) or change the value in `write`.
class Box {
  items: number[][] = [[1, 2], [3]];
}
function main() {
  const a = new RwLock(new Box());
  const b = new RwLock(new Box());
  const out: number[][][] = [];
  const out2: number[][][] = [];
  a.read((x) => {
    const oloc: number[][][] = [];
    b.read((y) => {
      const c = y.items.concat(x.items);
      const loc: number[][][] = [];
      out.push(c);
      out2.push(c);
      loc.push(c);
      oloc.push(c);
      c.push([8]);
      console.log(loc[0].length, out[0] === out2[0]);
    });
    oloc[0].push([6]);
    out.push(oloc[0]);
    console.log(JSON.stringify(oloc));
  });
  out[0].push([4]);
  console.log(JSON.stringify(out), JSON.stringify(out2), out[0] === out2[0], out[1] === out[0]);
}
