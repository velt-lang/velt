// An `||` of `typeof` tests narrows only to the union of both sides (#1252): each use below of
// a member neither side allows is an error, on the same line as in tsc.
type Child = { type: string } | string | number | boolean;

function wide(c: Child): number {
  if (typeof c === "string" || typeof c === "number") {
    const n: number = c;
    return n;
  }
  return 0;
}

function object(c: Child): string {
  if (typeof c === "string" || typeof c === "boolean") return c.type;
  return "";
}

function negated(c: Child): string {
  if ((typeof c !== "string" && typeof c !== "boolean") || typeof c === "number") return c.type;
  return "";
}

function main() {
  console.log(wide(1), object("a"), negated(2));
}
