// `super(...)` must run exactly once, before `this` is used: as the first statement of a derived
// constructor, on its own (not inside `if`, a loop, a ternary or a closure), with arguments that
// do not use `this` or `super.m()`.
class A {
  x: i64;
  constructor(x: i64) {
    this.x = x;
  }
  get(): i64 {
    return this.x;
  }
}

class InIf extends A {
  constructor(c: bool) {
    if (c) {
      super(1);
    }
  }
}

class InLoop extends A {
  constructor(n: i64) {
    while (n > 0) {
      super(n);
    }
  }
}

class InClosure extends A {
  constructor() {
    const f = () => super(1);
    f();
  }
}

class Twice extends A {
  constructor() {
    super(1);
    super(2);
  }
}

class Late extends A {
  constructor() {
    console.log("before");
    super(1);
  }
}

class UsesThis extends A {
  y: i64 = 0;
  constructor() {
    super(this.y);
  }
}

class UsesSuperMethod extends A {
  constructor() {
    super(super.get());
  }
}

class Ternary extends A {
  constructor(c: bool) {
    c ? super(1) : super(2);
  }
}

class NotDerived {
  constructor() {
    super();
  }
}

class Missing extends A {
  constructor() {}
}

class Fine extends A {
  constructor(c: bool) {
    super(c ? 1 : 2);
    this.x += 1;
  }
}

function main() {
  console.log(new Fine(true).x);
}
