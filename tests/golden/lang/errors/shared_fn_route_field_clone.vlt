// A field changed by a copy of a field's function.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

function mk(): F {
  const b = new C();
  return (x: i64): i64 => {
    b.n += 1;
    return b.n;
  };
}

class H {
  f: F;
  constructor(f: F) {
    this.f = f;
  }
}

async function main() {
  const h = new H(mk());
  const f = shared(h.f.clone());
  console.log(f(1));
}
