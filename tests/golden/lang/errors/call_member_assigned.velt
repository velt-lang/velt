// `f.call(o)` of a method read through `any` reads the member again: in a program that assigns
// the member, Node calls the first value.
const made = new Proxy({}, {});
class A { m: () => string = () => "first"; }
function run<T>(o: T) {
  const d = (o as { m?: unknown } | null)?.m;
  (o as any).m = () => "second";
  if (typeof d === "function") { console.log((d as () => string).call(o)); }
}
run(new A());
