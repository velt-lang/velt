// Module state cannot hold a promise: it is initialized before `main`, and a promise has one
// owner while every task reads the state.
async function later(): Promise<number> {
  return 1;
}

let p = later();
let t = spawn(later());
let maybe: Promise<number> | null = null;
let o: { p: Promise<number> | null } = { p: null };
let pair: { inner: { p: Promise<number> } } | null = null;

async function main() {
  console.log(await p, await t, maybe == null);
  o = { p: later() };
  const q = o.p;
  if (q) {
    console.log(await q);
  }
  console.log(pair == null);
}
