// An `Atomic` in a field of a captured object, through a function the compiler can't follow.
type F = (x: i64) => i64;

class H {
  a: Atomic<i64> = new Atomic<i64>(0);
}

function mk(): F {
  const h = new H();
  return (x: i64): i64 => {
    h.a.store(h.a.load() + 1);
    return h.a.load();
  };
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
