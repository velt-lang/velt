// An optional chain on an object of an unknown type reports that only, not the local the chain
// binds its object to. The cast of `provides?.get(token)` (a `T | undefined`, as `Map.get` gives
// `undefined` for a missing key) compiles.

function getProvided<T>(provides: Map<string, T> | null | undefined, token: string): T | undefined {
  return provides?.get(token) as (T | undefined);
}

function size(p: Missing | null): number {
  return p?.get("a").size ?? 0;
}

