// An RwLock read probe (#1559): a compile error, where a silent copy would differ from Node.
// An interface-typed field on the lock side, narrowed to its class, returned
interface Shape { area(): number; }
class Sq implements Shape {
  xs: number[] = [1];
  area(): number { return 1; }
}
class Store { sh: Shape = new Sq(); }
function main() {
  const lk = new RwLock(new Store());
  const r = lk.read((s) => {
    const sh = s.sh;
    if (sh instanceof Sq) return sh.xs;
    return [0];
  });
  r.push(9);
  lk.read((s) => { const sh = s.sh; if (sh instanceof Sq) console.log(JSON.stringify(sh.xs)); });
}
