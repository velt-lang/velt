// A table holds numbers or booleans, each a literal (also negated or with `as`) or a module
// constant that is one.

function one(): u8 {
  return 1;
}

const NAMES: string[] = ["a", "b"];
const NESTED: u8[][] = [[1], [2]];
const CALLS: u8[] = [one(), 2];
const SUMS: u8[] = [1 + 2, 3];

function main() {
  console.log(NAMES, NESTED, CALLS, SUMS);
}
