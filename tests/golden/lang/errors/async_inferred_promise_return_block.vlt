// An async function without a result type whose `return` gives a promise (#1166): reported
// like a written `Promise<number>` result type, not an internal error.
async function inner(n: number): Promise<number> {
  return n * 2;
}

async function h(n: number) {
  if (n > 10) {
    return 0;
  }
  return inner(n);
}

async function main() {
  console.log(await h(3));
}
