// An RwLock read probe (#1559): a compile error, where a silent copy would differ from Node.
// Nested, the inner read returns a made object holding a subclass-hidden part to the outer, which stores it
class Node2 { v: number[] = []; kids: Node2[] = []; }
class Base { n: number = 0; }
class Der extends Base { items: Node2[] = [new Node2()]; }
class Box { b: Base = new Der(); }
class Cfg { n: number = 0; }
function main() {
  const a = new RwLock(new Box());
  const c = new RwLock(new Cfg());
  const top: Node2[] = [];
  a.read((x) => {
    const got = c.read((y) => {
      const n = new Node2();
      const d = x.b;
      if (d instanceof Der) n.kids.push(d.items[0]);
      return n;
    });
    top.push(got);
  });
  a.write((x) => { const d = x.b; if (d instanceof Der) d.items[0].v.push(5); x.b = new Base(); });
  console.log(top.length, top[0].kids.length, JSON.stringify(top[0].kids[0].v));
}
