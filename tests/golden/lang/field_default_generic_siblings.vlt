function call<E>(f: () => i64 throws E): i64 throws E {
  return f();
}

function mkf<E>(): () => i64 throws E {
  return (): i64 throws E => 1;
}

class Box<E> {
  n: i64 = call<E>(mkf<E>());
}

function main() {
  let total = 0;
  try {
    total += new Box<E1>().n;
    total += new Box<E2>().n;
    total += new Box<E3>().n;
    total += new Box<E4>().n;
    total += new Box<E5>().n;
    total += new Box<E6>().n;
    total += new Box<E7>().n;
