// check: no leaks
// Generator function expressions (#424): `function* (...) { ... }` and `async function*` as
// values, optionally named. Each call creates a new generator with its own copy of the
// variables the function uses. At module level, `const g = function* ...` is a generator
// function.
class Empty extends Error {}

const evens = function* (limit: i64): Generator<i64> {
  for (let i = 0; i < limit; i += 2) {
    yield i;
  }
};

function take(make: (n: i64) => Generator<string>, n: i64): string[] {
  return [...make(n)];
}

async function tick(): Promise<void> {}

class Shelf {
  constructor(private books: string[]) {}

  shouting(): Iterable<string> {
    const books = this.books.slice(0);
    const loud = function* (): Generator<string> {
      for (const b of books) {
        yield b.toUpperCase();
      }
    };
    return loud();
  }
}

async function main() {
  console.log("module level:", [...evens(7)]);
  const base = 10;
  const label = "item";
  const offsets = function* (n: i64): Generator<i64> {
    for (let i = 0; i < n; i++) {
      yield base + i;
    }
  };
  console.log("captures:", [...offsets(3)], [...offsets(1)]);
  for (const x of offsets(2)) {
    console.log("loop:", x);
  }
  const named = function* labels(k: i64): Generator<string> {
    try {
      for (let i = 0; i < k; i++) {
        yield `${label}${i}`;
      }
    } finally {
      console.log("labels closed");
    }
  };
  const [first] = named(5);
  console.log("first:", first);
  console.log(
    "argument:",
    take(function* (n: i64): Generator<string> {
      for (let i = 0; i < n; i++) {
        yield "#".repeat(i + 1);
      }
    }, 3),
  );
  const nonEmpty = function* (xs: string[]): Generator<string, Empty> {
    for (const x of xs) {
      if (x == "") {
        throw new Empty("empty string");
      }
      yield x;
    }
  };
  try {
    for (const s of nonEmpty(["a", "", "b"])) {
      console.log("value:", s);
    }
  } catch (e) {
    console.log("caught:", e.message);
  }
  const later = async function* (n: i64): AsyncGenerator<i64> {
    for (let i = 0; i < n; i++) {
      await tick();
      yield i * base;
    }
  };
  for await (const v of later(3)) {
    console.log("async:", v);
  }
  const g = offsets(2);
  console.log("next:", g.next().value, g.next().value, g.next().done);
  console.log("method:", [...new Shelf(["x", "y"]).shouting()]);
}
