// The length an `ArrayBuffer`'s views read their elements by (`fixed`, private) cannot be
// written through `any`, through the view's `buffer` either.
function main() {
  const u = new Uint8Array(16);
  const b: any = u.buffer;
  console.log(u.length, b.fixed);
  b.fixed = 1 << 20;
  console.log(u.length);
}
