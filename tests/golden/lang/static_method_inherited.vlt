// Static methods are inherited: `B.f()` calls base class `A`'s `static f` (TypeScript).
class A {
  static f(): number { return 1; }
  static g(x: number): number { return x + A.f(); }
  private static secret(): number { return 7; }
  static reveal(): number { return A.secret(); }
}
class B extends A {}
class C extends B {
  static h(): number { return C.f() + 10; }
  // A static of its own hides the inherited one.
  static g(x: number): number { return x * 100; }
}
class Box<T> {
  static make(n: number): number { return n * 2; }
}
class NumBox extends Box<string> {}
console.log(B.f());
console.log(B.g(2));
console.log(C.f(), C.g(5), C.h());
console.log(B.reveal(), C.reveal());
console.log(NumBox.make(21));
