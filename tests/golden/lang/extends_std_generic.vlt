// Classes extending generic std classes (`Map<K, V>`, `Set<T>`), with and without their own
// constructors and redefined methods (issue #1096).
class M extends Map<string, number> {}

const m = new M();
m.set("a", 1);
console.log(m.get("a"), m.size);

class Counted extends Map<string, number> {
  override get(k: string): number | undefined {
    const v = super.get(k);
    return v === undefined ? undefined : v * 10;
  }
}

const c = new Counted();
c.set("x", 4);
console.log(c.get("x"), c.get("y"));

class Named<V> extends Map<string, V> {
  constructor(public label: string, entries: [string, V][]) {
    super(entries);
  }
  describe(): string {
    const keys: string[] = [];
    for (const k of this.keys()) {
      keys.push(k);
    }
    return `${this.label}: ${keys.join(",")}`;
  }
}

const n = new Named<boolean>("flags", [
  ["on", true],
  ["off", false],
]);
console.log(n.describe(), n.get("on"));

class Tags extends Set<string> {}

const t = new Tags();
t.add("x");
t.add("y");
t.add("x");
console.log(t.has("x"), t.has("z"), t.size);

class Base<K> {
  n: number;
  constructor(xs: K[] = []) {
    this.n = xs.length;
  }
}

class Sub extends Base<string> {}

class SubSub extends Sub {}

console.log(new Sub().n, new SubSub().n);
