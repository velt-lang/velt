// A cell behind an interface value the function captured.
type F = (x: i64) => i64;

// `n` is assigned outside the closure too, so it lives in a cell the function holds.
function mk(): F {
  let n: i64 = 0;
  const g = (x: i64): i64 => {
    n += 1;
    return n;
  };
  n = 0;
  return g;
}

interface I {
  call(x: i64): i64;
}

class W implements I {
  f: F;
  constructor(f: F) {
    this.f = f;
  }
  call(x: i64): i64 {
    return this.f(x);
  }
}

async function main() {
  const h: I = new W(mk());
  const f = shared((x: i64): i64 => h.call(x));
  console.log(f(1));
}
