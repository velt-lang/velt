// With proxies in the program, the conversion in an initializer is a view.
const made = new Proxy({}, {});
type W = { a: number; b: number };
type N = { a: number };
var held: any = null;
class Box { v: W = held; }
function mk(): any { const p: any = Object.create(null); p.a = 1; p.b = 2; return p; }
function main() {
  const p: any = mk();
  held = p;
  const q: N = new Box().v;
  p.a = 5;
  console.log(q.a, p.a);
}
main();
