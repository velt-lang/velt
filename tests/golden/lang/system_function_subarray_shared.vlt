// requires: unix
// `system_function_subarray_owner` in a program that also shares the array (`const keep = g`),
// with a module variable never assigned before the calls: each call still names the array the
// variable held when its argument was evaluated (JS order), not the one a later argument stored.
declare system function open(path: readonly u8[], oflag: i32, mode: u32): i32;
declare system function pread(fd: i32, buf: u8[], offset: i64): isize;
declare system function write(fd: i32, buf: readonly u8[]): isize;

const ZERO: u8[] = [47, 100, 101, 118, 47, 122, 101, 114, 111, 0]; // /dev/zero
let g: u8[] = filled(8, 97);

function filled(n: usize, v: u8): u8[] {
  const xs: u8[] = Buffer.alloc(n);
  for (let i = 0; i < n; i++) xs[i] = v;
  return xs;
}

function swap(): i64 {
  g = filled(1, 122);
  return 8;
}

function main() {
  const nl: u8[] = [10];
  const fd = open(ZERO, 0, 0);
  const a = write(1, g.subarray(0, swap()));
  write(1, nl);
  g = filled(8, 65);
  const b = write(1, g.subarray(0, swap()));
  write(1, nl);
  console.log("A", a, "B", b);
  g = Buffer.alloc(8);
  console.log("C", pread(fd, g.subarray(0, 8), swap()), g.length);
  const keep = g;
  console.log("D", pread(fd, keep.subarray(0, 8), swap()), keep.length);
}
