// `this` in a static method is its class: `++this.n` updates the class's static field (#1501).
class C {
  static n: number = 0;
  static log: string[] = [];
  static inc(): number {
    return ++this.n;
  }
  static add(k: number): number {
    this.n += k;
    this.log.push("add " + k);
    return this.n;
  }
  static reset(): void {
    this.n = 0;
  }
}

console.log(C.inc(), C.inc(), C.n);
console.log(C.add(5), C.n, C.log.join());
C.reset();
console.log(C.n, C.inc());
