// A type parameter bounded by an object type reads and writes its fields in the generic body
// (`T extends { name: string }`; docs/internals/design/deferred-types.md, P3; #350, #1212).
class Person {
  constructor(public name: string, public age: number) {}
}

class Getter {
  get name(): string {
    return "got";
  }
}

function getName<T extends { name: string }>(p: T): string {
  return p.name;
}

function bump<T extends { count: number }>(c: T): T {
  c.count += 1;
  return c;
}

function val<U, T extends { value: U }>(t: T): U {
  return t.value;
}

function opt<T extends { id?: number }>(t: T): string {
  return `${t.id ?? "none"}`;
}

type Named = { name: string };

function viaAlias<T extends Named>(xs: T[]): string[] {
  return xs.map((x) => x.name);
}

function rename<T extends Named>(x: T, to: string): void {
  x.name = to;
}

console.log(
  getName(new Person("ann", 3)),
  getName(new Getter()),
  getName({ name: "lit", other: true }),
);
const c = { count: 1, label: "c" };
console.log(bump(c).count, c.count, c.label);
console.log(val<number, { value: number; z: string }>({ value: 5, z: "q" }));
console.log(opt({ id: 2 }), opt<{ id?: number }>({}));
console.log(viaAlias([new Person("a", 1), new Person("b", 2)]));
const p = new Person("old", 9);
rename(p, "new");
const o = { name: "o", n: 1 };
rename(o, "renamed");
console.log(p.name, o);
