// The function calls one in a captured array, which changes a `let`.
type F = (x: i64) => i64;

function mk(): F {
  let n: i64 = 0;
  return (x: i64): i64 => {
    n += 1;
    return n;
  };
}

async function main() {
  const fs = [mk()];
  const f = shared((x: i64): i64 => fs[0](x));
  console.log(f(1));
}
