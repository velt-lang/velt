// Valid: a closure of the same function type as one in `shared(...)` isn't refused for that.
type F = () => void;
interface Plugin { start(): void; }
class P implements Plugin { cb: F = () => {}; start(): void { this.cb(); } }
async function main() {
  const p: Plugin = new P();
  const s = shared(p);
  let n: i64 = 0;
  const hs: F[] = [];
  hs.push(() => { n += 1; });
  hs[0]();
  console.log(n, s == null);
}
