// A `read` callback stores the caller's own objects into the caller's containers: an element
// pushed again, a captured variable pushed, assigned, added to a `Set` or set in a `Map`, an
// element assigned over another, an element kept in a variable across its replacement. Each is
// the same object, as in JavaScript, counted by the caller (nothing is freed twice or early).
class Item {
  v: i64 = 0;
  nums: i64[] = [1, 2];
  tags: string[] = ["a"];
  constructor(v: i64) {
    this.v = v;
  }
}

class St {
  items: Item[] = [new Item(1), new Item(2), new Item(3)];
  names: string[] = ["x", "y"];
}

function pushedAgain(rw: shared<RwLock<St>>) {
  const out: Item[] = [new Item(1), new Item(2)];
  for (let i = 0; i < 3; i++) {
    rw.read((s) => {
      out.push(out[0]);
      return 0;
    });
  }
  console.log(out.length, out[2].v, out[2] === out[0]);
}

function capturedStored(rw: shared<RwLock<St>>) {
  const a = new Item(1);
  const out: Item[] = [a];
  rw.read((s) => {
    out.push(a);
    return 0;
  });
  out[1].v = 5;
  console.log(out[0].v, a.v, out[0] === out[1]);
  const b = new Item(1);
  const fresh: Item[] = [];
  rw.read((s) => {
    fresh.push(b);
    return 0;
  });
  console.log(fresh.length, b.v);
  const c = new Item(1);
  const slot: Item[] = [new Item(0)];
  rw.read((s) => {
    slot[0] = c;
    return 0;
  });
  console.log(slot[0].v, c.v, slot[0] === c);
  const d = new Item(1);
  const seen = new Set<Item>();
  const m = new Map<string, Item>();
  rw.read((s) => {
    seen.add(d);
    m.set("k", d);
    return 0;
  });
  console.log(seen.has(d), m.get("k")! === d, d.v);
  const nums: i64[] = [1, 2];
  const lists: i64[][] = [];
  rw.read((s) => {
    lists.push(nums);
    return 0;
  });
  lists[0].push(3);
  console.log(lists.length, nums.length);
}

function elements(rw: shared<RwLock<St>>) {
  const out: Item[] = [new Item(1), new Item(2)];
  rw.read((s) => {
    out[0] = out[1];
    return 0;
  });
  out[0].v = 7;
  console.log(out[1].v, out[0] === out[1]);
  const kept: Item[] = [new Item(1)];
  rw.read((s) => {
    const t = kept[0];
    kept[0] = new Item(2);
    kept.push(t);
    return 0;
  });
  kept[1].v = 7;
  console.log(kept.length, kept[0].v, kept[1].v);
  const popped: Item[] = [new Item(1)];
  const m = new Map<string, Item>();
  rw.read((s) => {
    const t = popped[0];
    popped.pop();
    m.set("k", t);
    return 0;
  });
  m.get("k")!.v = 7;
  console.log(popped.length, m.get("k")!.v);
}

function main() {
  const rw = shared(new RwLock<St>(new St()));
  pushedAgain(rw);
  capturedStored(rw);
  elements(rw);
  rw.read((s) => console.log(s.items.length, s.items[0].v, s.names.join(",")));
}
