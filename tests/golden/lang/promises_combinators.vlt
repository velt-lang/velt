// `Promise.race`, `Promise.allSettled` and `Promise.any` (JS semantics): race takes the first
// result and the losers keep running; allSettled reports every outcome in order; any takes the
// first fulfilled value and throws `AggregateError` for an empty array. Timers are >= 140 ms
// apart, so the order is the same on a loaded machine.
async function after(ms: i64, name: string): Promise<string> {
  await sleep(ms);
  console.log("finished", name);
  return name;
}

async function main() {
  const winner = await Promise.race([after(400, "slow"), after(10, "fast")]);
  console.log("race:", winner);

  const settled = await Promise.allSettled([after(150, "x"), after(10, "y")]);
  for (const s of settled) {
    switch (s.status) {
      case "fulfilled":
        console.log("fulfilled", s.value);
        break;
      case "rejected":
        console.log("rejected", s.reason.message);
        break;
    }
  }

  console.log("any:", await Promise.any([after(800, "p"), after(10, "q")]));

  const none: Promise<string>[] = [];
  try {
    await Promise.any(none);
  } catch (e) {
    console.log("caught", e.message);
  }
  console.log("main done");
}
