// A param a function captures in a closure it makes reaches the function value (#2527). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; }
const KK = (q: A2) => { q.c = new I2(); q.c.s = heap("zzzzzzzz"); q.xs = []; junk(); };
function r2(q: A2) { KK(q); }
function run(q: A2) { const inner = () => { r2(q); }; inner(); }
function t() { const a = new A2(); const x = a.c; run(a); junk(); console.log(x.s); }
t();
