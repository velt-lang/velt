// A right-hand side whose functions reassign variables of their own of the holder's type (a
// reducer, `c = merge(c, …)`) cannot replace the caller's variable: a variable that is not
// captured is assigned only by its own function (#876). Each assignment compiles and runs as in
// Node.
type Win = { width: number; height: number };
type Config = { window: Win; title: string };
type Inner = { v: number };
type Outer = { inner: Inner };
function merge(a: Config, b: Partial<Config>): Config { return { window: b.window ?? a.window, title: b.title ?? a.title }; }
function load(): Config {
  let c: Config = { window: { width: 1, height: 1 }, title: "t" };
  c = merge(c, { title: "x" });
  return c;
}
function widest(cs: Config[]): number { let w = 0; for (const c of cs) w = Math.max(w, c.window.width); return w; }
function apply(s: Config, t: string): Config { return { window: s.window, title: s.title + t }; }
function replay(log: string[]): Config { let s: Config = { window: { width: 2, height: 2 }, title: "" }; for (const t of log) s = apply(s, t); return s; }
function step(o: Outer, k: number): Outer { return { inner: { v: o.inner.v + k } }; }
function fold(ks: number[]): Outer { let acc: Outer = { inner: { v: 0 } }; for (const k of ks) acc = step(acc, k); return acc; }
function loaded(): void {
  const cfg: Config = { window: { width: 0, height: 0 }, title: "" };
  cfg.window.width = load().window.width + 10;
  console.log(cfg.window.width);
}
function replayed(): void {
  const cfg: Config = { window: { width: 0, height: 0 }, title: "" };
  const all: Config[] = [{ window: { width: 3, height: 1 }, title: "a" }];
  cfg.window.width = widest(all);
  cfg.window.height = replay(["a", "b"]).window.height;
  console.log(cfg.window.width, cfg.window.height);
}
function folded(): void {
  let o: Outer = { inner: { v: 0 } };
  o.inner.v = fold([1, 2, 3]).inner.v;
  o.inner.v += fold([4]).inner.v;
  o = step(o, 1);
  console.log(o.inner.v);
}
function main(): void {
  loaded();
  replayed();
  folded();
}
