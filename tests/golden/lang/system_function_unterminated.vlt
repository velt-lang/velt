// requires: unix
// A path for a system function must end with a 0 byte, or the C function would read past the
// array: the call stops the program instead.
declare system function unlink(path: readonly u8[]): i32;

function main() {
  const ok: u8[] = Buffer.alloc(4);
  ok.write("x");
  console.log(unlink(ok) == -1);
  const bad: u8[] = Buffer.alloc(1);
  bad.write("x");
  console.log(unlink(bad));
}
