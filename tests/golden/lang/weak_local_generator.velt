// check: no leaks
// A `weak` variable in a generator's suspended state is no edge: the trace glue leaves it out
// (visiting its slot as an object would read the slot's words as one). A weak map value holding
// the generator, whose variable refers to the key, lets the key go with its last outside
// reference, and the variable reads `null` once a target held elsewhere went (#3119).
class Raw {
  // A counted first field: tracing the slot as a `Raw` would follow the slot's count as one.
  peer: Raw | null = null;
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}

class Holder {
  g: Generator<number>;
  constructor(g: Generator<number>) {
    this.g = g;
  }
}

function valueOf(r: Raw | null): number {
  return r === null ? -1 : r.n;
}

let held: Raw | null = null;

// `other`, a strong `Raw` in the state, makes the map trace its values.
function* weakly(other: Raw): Generator<number> {
  const w: weak Raw | null = held;
  // Suspended before any read of `w`, whose result's release would look at the key's entries
  // while the generator runs (its state is not traced then).
  yield 0;
  while (true) {
    const v = valueOf(w) + other.n;
    yield v;
  }
}

function track(cache: WeakMap<Raw, Holder>, n: number): WeakRef<Raw> {
  const raw = new Raw(n);
  held = raw;
  cache.set(raw, new Holder(weakly(new Raw(10))));
  const first = cache.get(raw)!.g.next().value ?? 0;
  // The generator is suspended: this release traces its state.
  held = null;
  const second = cache.get(raw)!.g.next().value ?? 0;
  console.log("read", first, second);
  return new WeakRef(raw);
}

function main() {
  const cache = new WeakMap<Raw, Holder>();
  console.log("key freed:", track(cache, 3).deref() == null);
  held = new Raw(4);
  const g = weakly(new Raw(10));
  g.next();
  console.log("target alive:", g.next().value);
  held = null;
  console.log("target gone:", g.next().value);
  const kept = new Raw(5);
  cache.set(kept, new Holder(weakly(new Raw(10))));
  console.log("map in use:", cache.has(kept), cache.has(new Raw(0)));
}
