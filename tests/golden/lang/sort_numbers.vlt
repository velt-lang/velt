// `sort()` on integer arrays: every input shape pdqsort special-cases (sorted and reversed
// runs, duplicates, organ pipes, sawtooth, short ranges) against a reference merge sort.

// Deterministic LCG.
class Rng {
  state: i64 = 12345;

  // Next value in [0, bound).
  next(bound: i64): i64 {
    this.state = (this.state * 1103515245 + 12345) % 2147483648;
    return this.state % bound;
  }
}

function mergeSorted(xs: i64[]): i64[] {
  if (xs.length <= 1) {
    return xs.slice();
  }
  const mid = (xs.length / 2) as i64;
  const a = mergeSorted(xs.slice(0, mid));
  const b = mergeSorted(xs.slice(mid));
  const out: i64[] = [];
  let i: usize = 0;
  let j: usize = 0;
  while (i < a.length && j < b.length) {
    if (b[j] < a[i]) {
      out.push(b[j]);
      j++;
    } else {
      out.push(a[i]);
      i++;
    }
  }
  while (i < a.length) {
    out.push(a[i]);
    i++;
  }
  while (j < b.length) {
    out.push(b[j]);
    j++;
  }
  return out;
}

function make(rng: Rng, shape: string, n: i64): i64[] {
  const xs: i64[] = [];
  for (let i = 0; i < n; i++) {
    if (shape == "random") {
      xs.push(rng.next(1000000000) - 500000000);
    } else if (shape == "dups") {
      xs.push(rng.next(4));
    } else if (shape == "sorted") {
      xs.push(i);
    } else if (shape == "reversed") {
      xs.push(n - i);
    } else if (shape == "equal") {
      xs.push(7);
    } else if (shape == "organ") {
      xs.push(i < n / 2 ? i : n - i);
    } else if (shape == "sawtooth") {
      xs.push(i % 37);
    } else if (shape == "nearly") {
      xs.push(rng.next(50) == 0 ? rng.next(n + 1) : i);
    } else {
      xs.push(i % 2 == 0 ? i : -i);
    }
  }
  return xs;
}

function check(rng: Rng, shape: string, n: i64): bool {
  const xs = make(rng, shape, n);
  const want = mergeSorted(xs);
  xs.sort();
  if (xs.length != want.length) {
    return false;
  }
  for (let i: usize = 0; i < xs.length; i++) {
    if (xs[i] != want[i]) {
      console.log(`${shape} ${n}: index ${i} is ${xs[i]}, want ${want[i]}`);
      return false;
    }
  }
  return true;
}

function main() {
  const rng = new Rng();
  const shapes = [
    "random",
    "dups",
    "sorted",
    "reversed",
    "equal",
    "organ",
    "sawtooth",
    "nearly",
    "alternating",
  ];
  const sizes: i64[] = [0, 1, 2, 3, 5, 16, 20, 21, 22, 50, 128, 129, 130, 1000, 4099, 30000];
  for (const shape of shapes) {
    let ok = 0;
    for (const n of sizes) {
      if (check(rng, shape, n)) {
        ok++;
      }
    }
    console.log(`${shape}: ${ok}/${sizes.length} ok`);
  }

  // The other integer element types share the algorithm; spot-check them.
  const a: i32[] = [];
  const b: u64[] = [];
  const c: usize[] = [];
  for (let i = 0; i < 2000; i++) {
    const v = rng.next(100);
    a.push((v - 50) as i32);
    b.push(v as u64);
    c.push(v as usize);
  }
  a.sort();
  b.sort();
  c.sort();
  let sorted = true;
  for (let i: usize = 1; i < 2000; i++) {
    sorted = sorted && a[i - 1] <= a[i] && b[i - 1] <= b[i] && c[i - 1] <= c[i];
  }
  console.log("i32 / u64 / usize sorted:", sorted, a[0], a[1999], b[0], b[1999], c[1000]);

  const big = make(rng, "random", 200000);
  big.sort();
  let inOrder = true;
  for (let i: usize = 1; i < big.length; i++) {
    inOrder = inOrder && big[i - 1] <= big[i];
  }
  console.log("200000 random sorted:", inOrder, big[0], big[199999]);
}
