// A call that moves an object and lends a part of it: an owner captured by a closure argument (#2531). Output checked against Node.
function heap(a: string) { return a + "-".repeat(40); }
function junk() { return heap("xxxxxxxxxxxxxxxxxxxxxxxxx").length; }
class I2 { s: string = heap("a"); }
class A2 { c: I2 = new I2(); xs: I2[] = [new I2(), new I2()]; name: string = heap("n"); }
let hold: A2 | null = null;
function take(q: A2, v: string) { hold = q; hold = null; junk(); return v + "!"; }
let hf: (() => number) | null = null;
function takeF(f: () => number, v: string) { hf = f; hf = null; junk(); return v + "!"; }
function takeF2(v: string, f: () => number) { hf = f; hf = null; junk(); return v + "?"; }
function t() { const o = new A2(); console.log(takeF(() => o.name.length, o.name)); }
function u() { const o = new A2(); console.log(takeF2(o.name, () => o.name.length)); }
t();
u();
