// A stored closure that dies before its captured variable is assigned again (held by a `const`
// in a loop body, or in a `switch` case left by `break`) does not make the assignment an error.
// Regression (difftest seeds 40545, 41198).
// Also: a narrowed discriminated-union value passed to an async function and used again is
// copied, like a string (seed 40189, "use of moved value").
type Sh = { kind: "pt"; x: i64 } | { kind: "box"; x: i64; s: string };

async function g(s: Sh): Promise<i64> {
  return s.x;
}

async function main() {
  let w = 0;
  let total = 0;
  while (w < 3) {
    w++;
    const f = (x: i64): i64 => x + w;
    total += f(10);
    switch (w) {
      case 2: {
        const g2 = (x: i64): i64 => x * w;
        total += g2(100);
        break;
      }
      default:
        break;
    }
  }
  const c: Sh = { kind: "box", x: 2, s: "q" };
  if (c.kind === "box") {
    const n = (await g(c)) + c.x;
    console.log(total, n, c.s);
  }
}
