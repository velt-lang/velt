// Operators on objects held in `any` (#924): `ToPrimitive` calls a class's `valueOf` or
// `toString`, a `Date` is its time, a plain object `[object Object]`; compound assignments and
// updates of members and elements of an `any` read and write the member once.
class Money {
  cents: number;
  constructor(cents: number) {
    this.cents = cents;
  }
  valueOf(): number {
    return this.cents;
  }
}
class Label {
  text: string;
  constructor(text: string) {
    this.text = text;
  }
  toString(): string {
    return `<${this.text}>`;
  }
}
class Plain {
  x = 1;
}
const m: any = new Money(250);
const l: any = new Label("hi");
const p: any = new Plain();
const d: any = new Date(1000);
const mp: any = new Map([["a", 1]]);
const st: any = new Set([1]);
const f: any = (x: number) => x;
console.log(m * 2, m - 50, m > 100, -m);
console.log(l + "!", "?" + l, l + 1, l * 1);
console.log(p + "", p * 2, p == "[object Object]");
console.log(d - 0, d * 1, d > 500, d < 2000, +d);
console.log(mp * 1, st + 1, mp + "");
console.log(f * 1, f < 1, f > 1);
console.log([1] == (1 as any), ([] as any) == 0, ([1, 2] as any) == "1,2", (null as any) == 0, (undefined as any) == null);
const nums: any[] = [1, 2, 3];
let total: any = 0;
for (const n of nums) {
  total += n;
}
console.log(total, typeof total);
let acc: any = "";
for (const n of nums) {
  acc += n;
}
console.log(acc);
const rec: any = { count: 0, name: "x" };
rec.count += 5;
rec.count++;
++rec.count;
rec.count--;
rec.name += "y";
rec["count"] *= 2;
console.log(rec.count, rec.name);
const before = rec.count++;
const after = ++rec.count;
console.log(before, after, rec.count);
const arr: any = [10, 20];
arr[0]++;
arr[1] -= 5;
const v = (arr[0] += 1);
console.log(arr, v);
let n: any = 7;
n %= 4;
console.log(n);
n **= 3;
console.log(n);
n <<= 2;
console.log(n);
n |= 1;
console.log(n);
n >>= 1;
console.log(n);
n &= 6;
console.log(n);
n ^= 15;
console.log(n);
n >>>= 1;
console.log(n);
n /= 2;
console.log(n);
let z: any = null;
z += 1;
console.log(z);
let w: any = true;
w++;
console.log(w);
const typed: number = (n as any) * 2;
console.log(typed);
console.log(1 / (-0 as any), (-0 as any) * 1, 5 % (0 as any), 2 ** (0.5 as any));
console.log("3" as any > 12, ("3" as any) > "12", "b" > ("a" as any), (null as any) >= 0, (undefined as any) < 1);
// `ToPrimitive` keeps a number `valueOf()` gives, and passes `[Symbol.toPrimitive]` the hint.
class Cents {
  cents: number;
  constructor(c: number) {
    this.cents = c;
  }
  valueOf(): number {
    return this.cents;
  }
}
const c10: any = new Cents(10),
  c9: any = new Cents(9);
console.log(c10 + 1, 1 + c10, c10 + c9, c10 + "!", "$" + c10, `${c10}`);
console.log(c10 < c9, c10 < "9", c10 > 9.5, c10 <= 10, c9 >= c10);
console.log(c10 == "10.0", c10 == 10, c10 != 11, c10 == c9, c10 == c10);
class TP {
  [Symbol.toPrimitive](h: string): any {
    return h === "number" ? 42 : "dflt";
  }
}
const tp: any = new TP();
console.log(+tp, tp * 1, tp < 50, tp + 1, tp == "dflt", `${tp}`);
class B {
  valueOf(): any {
    return true;
  }
}
console.log((new B() as any) * 2, (new B() as any) + 1);
class S {
  toString(): string {
    return "7";
  }
}
const s7: any = new S();
console.log(s7 * 2, s7 + 1, s7 == 7, s7 < 10);
const lit: any = { valueOf: () => 5 };
console.log(lit + 1, lit * 2, lit == 5, lit < 6, `${lit}`);
const fn: any = function () {};
console.log(fn == 0, fn == 1, fn != 0, fn == null, fn * 1);
const d2: any = new Date(1000);
console.log(d2 - 0, d2 < 2000, typeof (d2 + 1));
const two: any = [2],
  none: any = [],
  ab: any = ["a"],
  pair: any = [1, 2];
console.log(two == 2, none == 0, ab == "a", pair == "1,2", none == false, 2 == two, two != 3);
