// check: no leaks
// `==` / `!=` on values of a type with a type parameter in it: `T | undefined` at `T = null`
// (and other nullable instantiations) has `null == undefined`, and `T = unknown` / `any`
// compare with JavaScript's coercions (`1 == "1"`, `0 == false`).
function eqU<T>(a: T | undefined, b: T | undefined): boolean {
  return a == b;
}

console.log(
  eqU<null>(null, undefined),
  eqU<string | null>(null, undefined),
  eqU<number | null>(undefined, null),
);
console.log(eqU<number>(1, 1), eqU<number>(1, undefined), eqU<string>(undefined, undefined));

function neU<T>(a: T | undefined, b: T | undefined): boolean {
  return a != b;
}

console.log(neU<null>(null, undefined), neU<number | null>(1, null));

function eq<T>(a: T, b: T): boolean {
  return a == b;
}

function ne<T>(a: T, b: T): boolean {
  return a != b;
}

console.log(eq<unknown>(1, "1"), eq<any>("1", 1), eq<unknown>(0, false), eq<any>(null, 0));
console.log(eq<unknown>(null, undefined), eq<unknown>(1, 2), ne<unknown>(1, "1"), ne<any>(null, 0));

function eqU2<T>(a: T | undefined, b: T | undefined): boolean {
  return a == b;
}

console.log(
  eqU2<string>("a", "a"),
  eqU2<string>("a", "b"),
  eqU2<string>(undefined, "b"),
  eqU2<unknown>(1, "1"),
);

function eqN<T>(a: T | null, b: T | null): boolean {
  return a == b;
}

console.log(eqN<number>(null, null), eqN<number>(1, null), eqN<string>(null, "a"));

function eq2<T>(a: T, b: T): boolean {
  return a == b;
}

console.log(
  eq<any>(undefined, null),
  eq2<unknown>("", 0),
  eq2<any>(true, "1"),
  eq2<unknown>(NaN, NaN),
  eq2<number | undefined>(undefined, undefined),
);

function ne2<T>(a: T, b: T): boolean {
  return a != b;
}

console.log(ne2<unknown>(1, "1"), ne2<any>(null, undefined), ne2<unknown>(2, 3));

function inc<T>(xs: T[], x: T): boolean {
  return xs.some((y) => y == x);
}

console.log(inc<unknown>([1, 2], "2"), inc<any>([null], undefined), inc<number>([1], 1));

function eqO<T>(a?: T, b?: T): boolean {
  return a == b;
}

console.log(eqO<null>(null), eqO<number>(1, 1), eqO<number>(), eqO<unknown>(0, false));

function e5<T>(a: T | null | undefined, b: T | null | undefined) {
  return a == b;
}

console.log(
  e5<unknown>(null, undefined),
  e5<number>(null, undefined),
  e5<unknown>("1", 1),
  e5<string>(undefined, "x"),
  e5<unknown>(0, false),
  e5<any>(1, "1"),
);
console.log(
  e5<any>(null, 0),
  e5<unknown>(undefined, undefined),
  e5<unknown>("a", null),
  e5<number>(2, 2),
  e5<any>(NaN, NaN),
);

function e6<T>(a: T | null | undefined, b: T | null | undefined) {
  return a != b;
}

console.log(
  e6<unknown>("1", 1),
  e6<any>(null, undefined),
  e6<unknown>(1, 2),
  e6<string>(undefined, "x"),
);

function e8<T>(a: T | null, b: T | null) {
  return a == b;
}

console.log(e8<number>(null, null), e8<number>(1, 1), e8<string>("a", null), e8<unknown>(1, "1"));

function e9<T>(v: T, w: T) {
  return e5<T>(v, w);
}

console.log(e9<unknown>(null, undefined), e9<unknown>("2", 2), e9<any>(0, null));
