// `toExponential`, `toPrecision` and `toFixed` (std/lang/hooks/number_digits: the exact digits,
// rounded half up), compared with Node: negative zero, NaN, the infinities, ties, precision 1 and
// 100, the largest and smallest doubles.

const values: number[] = [
  0, -0, 1, -1, 0.5, 1.5, 2.5, -2.5, 1.25, 1.005, 9.99, 99.99, 999.9, 123.456, -123.456, 0.00015,
  0.000123, 0.0000001, 1e21, 1e-7, 1e-6, 123456789012345680000, 5e-324, 2.2250738585072014e-308,
  1.7976931348623157e308, 0.1, 0.3, 1 / 3, 2 / 3, 9007199254740993, 4.35, 1.45, 8.345, 1e100,
  -1e-100, 0.05, 0.5e-6, NaN, Infinity, -Infinity,
];

for (const v of values) {
  console.log(v, v.toExponential(), v.toPrecision(), v.toString());
  for (const d of [0, 1, 2, 5, 16, 20, 50, 100]) {
    console.log(" e", d, v.toExponential(d));
  }
  for (const p of [1, 2, 3, 6, 7, 17, 21, 22, 60, 100]) {
    console.log(" p", p, v.toPrecision(p));
  }
  for (const f of [0, 1, 2, 10, 19, 20, 25, 100]) {
    console.log(" f", f, v.toFixed(f));
  }
}

// Generated values at every decimal scale from 1e-30 to 1e30.
let seed = 4321;
for (let i = 0; i < 150; i++) {
  seed = (seed * 1103 + 12347) % 1000003;
  let x = seed / 997;
  const scale = (i % 61) - 30;
  for (let k = 0; k < scale; k++) {
    x = x * 10;
  }
  for (let k = 0; k > scale; k--) {
    x = x / 10;
  }
  if (i % 3 == 0) {
    x = -x;
  }
  const d = i % 21;
  console.log(x.toExponential(), x.toExponential(d), x.toPrecision(d + 1), x.toFixed(d), x.toFixed(d + 30));
}
