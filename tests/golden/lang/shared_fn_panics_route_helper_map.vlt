// A helper changes what the function captured, and the function comes out of a `Map`.
type F = (x: i64) => i64;
class C {
  n: i64 = 0;
}

function bump(c: C): void {
  c.n += 1;
}

function mk(): F {
  const b = new C();
  return (x: i64): i64 => {
    bump(b);
    return b.n;
  };
}

async function main() {
  const m = new Map<string, F>();
  m.set("a", mk());
  const f = shared(m.get("a")!);
  console.log(f(1));
}
