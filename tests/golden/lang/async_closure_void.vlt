// Async arrows where a `void` function is expected (event handler fields, `(() => void) | null`
// parameters): as in TS they are accepted, and each call starts a promise that runs to
// completion on its own. Against a union of function types (`(() => void) | (() => Promise<void>)`)
// an arrow is typed by the member that fits: a sync arrow by the void one (the only member it
// fits here), an async arrow by the promise one.

// The two promises wait on channels, not timers, so the order holds on a loaded machine (#909).
import { channel } from "velt:channel";

type Attrs = { id: string; onClick?: () => void };

function click(a: Attrs) {
  const h = a.onClick;
  if (h != null) {
    h();
  }
  console.log(`clicked ${a.id}`);
}

function fire(h: (() => void) | null) {
  if (h != null) {
    h();
  }
}

type Handler = (() => void) | (() => Promise<void>);

// Which member an arrow became.
function kind(h: Handler | null): string {
  if (h == null) {
    return "none";
  }
  return "a handler";
}

async function main() {
  let count = 0.0;
  const fired = channel<bool>(1);
  const firedRx = fired.clone();
  const done = channel<bool>(1);
  const doneTx = done.clone();
  click({ id: "sync", onClick: () => count++ });
  click({
    id: "async",
    onClick: async () => {
      // Finishes after the `fire` callback below.
      await firedRx.receive();
      console.log("async onClick finished");
      await doneTx.send(true);
    },
  });
  fire(async () => {
    await yieldNow();
    console.log("async fire finished");
    await fired.send(true);
  });
  console.log(kind(() => count++), kind(async () => {}), kind(null));
  console.log(`count ${count}`);
  await done.receive();
  console.log("done");
}
