// `x as object` of an `unknown` holding a primitive stops with a `TypeError` (issue #926).
// Node keeps the number in the `object`; Velt checks the value where it enters `object`, which
// holds no primitive.
function asObject(u: unknown): object {
  return u as object;
}

function main(): void {
  console.log(typeof asObject([1]));
  console.log(asObject(5));
}
