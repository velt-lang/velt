class Counter {
  name: string;
  count: i64 = 0;

  constructor(name: string) {
    this.name = name;
  }

  inc(): i64 {
    this.count += 1;
    return this.count;
  }

  describe(): string {
    return `${this.name}=${this.count}`;
  }
}

class Animal {
  name: string;

  constructor(name: string) {
    this.name = name;
  }

  speak(): string {
    return `${this.name} makes a sound`;
  }

  intro(): string {
    return `I am ${this.name}: ${this.speak()}`;
  }
}

class Dog extends Animal {
  tricks: i64 = 2;

  constructor(name: string) {
    super(name);
  }

  override speak(): string {
    return `${this.name} barks`;
  }
}

function describeAll(xs: Animal[]) {
  for (const a of xs) {
    console.log(a.intro());
  }
}

function main() {
  let c = new Counter("clicks");
  c.inc();
  c.inc();
  console.log(c.inc(), c.describe());

  const d = new Dog("rex");
  console.log(d.speak(), d.tricks);

  const animals: Animal[] = [new Animal("cat"), new Dog("fido")];
  describeAll(animals);

  const moved = c; // ownership moves; `c` is no longer usable
  console.log(moved.describe());
  const copy = moved.clone();
  console.log(copy.describe(), moved.describe());
}
