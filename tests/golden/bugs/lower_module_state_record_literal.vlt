// check: no leaks
// A module-level Record built by an object literal and written by a function lives in the
// module state; its initializer's temporary is lowered there (the compiler used to stop with
// an index out of bounds). Expected output: Node's.
const cache: Record<string, string> = { seed: "s" };
const counts: Record<string, number> = {};
function remember(k: string): void {
  cache[k] = k.toUpperCase();
  counts[k] = (counts[k] ?? 0) + 1;
}
remember("a");
remember("a");
console.log(cache, counts);
