// Calling an async closure value copies a class argument into the call's state: the callee gets
// a separate instance (its changes are lost) and both copies are dropped, so `[Symbol.dispose]()` runs
// twice for one object (std/http's `Request` cannot own its runtime handle because of this).
// A direct call of an async function moves the argument, as it should.
class Res {
  raw: i64;

  constructor(raw: i64) {
    this.raw = raw;
  }

  [Symbol.dispose]() {
    console.log(`dispose ${this.raw}`);
  }
}

async function direct(r: Res): Promise<i64> {
  return r.raw;
}

async function viaClosure(handler: (r: Res) => Promise<i64>): Promise<i64> {
  return await handler(new Res(2));
}

async function main() {
  console.log(await direct(new Res(1)));
  console.log(await viaClosure(async (r: Res): Promise<i64> => r.raw));
}
