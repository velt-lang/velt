// check: no leaks
// `close()` stops the accept loop asynchronously, yet serving or listening on the same port
// right after works (#1020); and a fetch whose pooled keep-alive connection went to a server that shut down
// is sent again on a new connection.
import { serve } from "velt:http";
import { listen } from "velt:net";

async function hello(req: Request): Promise<Response> {
  return new Response("hello");
}

async function main() {
  const first = await serve({ port: 0 }, hello);
  const port = first.port;
  first.close();
  let served = 0;
  for (let i = 0; i < 20; i++) {
    const again = await serve({ port: port }, hello);
    if (again.port == port) {
      served++;
    }
    again.close();
  }
  console.log("served again on the same port:", served);

  let listened = 0;
  for (let i = 0; i < 20; i++) {
    const s = await serve({ port: port }, hello);
    s.close();
    const l = await listen(`127.0.0.1:${port}`);
    if (l.port == port) {
      listened++;
    }
    l.close();
  }
  console.log("listened on the port of a closed server:", listened);

  const a = await serve({ port: port }, hello);
  console.log("before:", await (await fetch(`http://127.0.0.1:${port}/`)).text());
  await a.shutdown();
  const b = await serve({ port: port }, hello);
  console.log("after:", await (await fetch(`http://127.0.0.1:${port}/`)).text());
  await b.shutdown();
}
