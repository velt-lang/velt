// A BigInt is a value, as in JavaScript (#3108): a compound assignment gives its variable a new
// number, so another variable holding the old one keeps it (`let z = x; z += y` leaves `x`), for
// every operator, through fields and array elements, and in a loop. The in-place methods
// (`addAssign`) still change the number itself.
import { BigInt } from "velt/math";

const n = (k: i64): BigInt => new BigInt(k);

const x = n(5);
let z = x;
z += new BigInt(1);
console.log(x.toString(), z.toString());

const a = n(100);
let b = a;
b -= new BigInt(1);
let c = a;
c *= new BigInt(3);
let d = a;
d /= new BigInt(7);
let e = a;
e %= new BigInt(7);
let f = a;
f <<= 2;
let g = a;
g >>= 2;
console.log(a.toString(), b.toString(), c.toString(), d.toString());
console.log(e.toString(), f.toString(), g.toString());

class Acc {
  total: BigInt = n(0);
}
const acc = new Acc();
const start = acc.total;
const xs = [n(1), n(2)];
const first = xs[0];
for (let i: i64 = 1; i <= 3; i++) {
  acc.total += new BigInt(i);
  xs[0] *= new BigInt(10);
}
console.log(start.toString(), acc.total.toString(), first.toString(), xs[0].toString());

let y = n(7);
y += y;
y *= y;
console.log(y.toString());

const m = n(40);
const kept = m;
m.addAssign(n(2));
console.log(m.toString(), kept.toString());

// Shapes where a number is held elsewhere: each holder keeps its value.
const s = (b: BigInt): string => b.toString();
const held = n(1);
const keep = (): string => s(held);
let c1 = held;
c1 += new BigInt(1);
let c2 = n(5);
const later = (): string => s(c2);
const c2old = c2;
c2 += new BigInt(1);
console.log(s(held), s(c1), keep(), later(), s(c2old));

const arr = [n(10)];
let e1 = arr[0];
e1 += new BigInt(1);
const map = new Map<string, BigInt>();
map.set("k", n(20));
let e2 = map.get("k")!;
e2 *= new BigInt(2);
const box = new Acc();
box.total = n(30);
let e3 = box.total;
e3 -= new BigInt(3);
console.log(s(arr[0]), s(e1), s(map.get("k")!), s(e2), s(box.total), s(e3));

function bump(p: BigInt): string {
  let q = p;
  q += new BigInt(1);
  return s(q);
}
const arg = n(40);
console.log(bump(arg), s(arg));

let self = n(3);
const selfOld = self;
self += self;
self *= self;
console.log(s(self), s(selfOld));

for (const el of arr) {
  let w = el;
  w += new BigInt(5);
  console.log(s(w), s(arr[0]));
}
const [d0] = [n(50)];
let d1 = d0;
d1 %= new BigInt(7);
console.log(s(d0), s(d1));

function twice<T>(x: T): T[] {
  return [x, x];
}
const pair = twice(n(60));
let g0 = pair[0];
g0 += new BigInt(1);
console.log(s(pair[0]), s(pair[1]), s(g0));

async function stepAsync(): Promise<string> {
  let a = n(70);
  const before = a;
  await null;
  a += new BigInt(1);
  await null;
  let b = n(80);
  await null;
  b += new BigInt(1);
  return `${s(before)} ${s(a)} ${s(b)}`;
}

let unique = n(1);
for (let i = 0; i < 5; i++) {
  unique *= new BigInt(3);
  unique += new BigInt(i);
}
console.log(s(unique));


let r = n(1);
const reassign = (): BigInt => {
  r = n(100);
  return n(2);
};
r += reassign();
console.log(s(r));

let t = new BigInt(1);
t += (t = new BigInt(5));
console.log(s(t));

// An operator method inside the right side runs the program's code, which may hold the number:
// a new number then (`new BigInt(a + a)` on a class with `[Symbol.add]`).
class Sneak {
  f: () => i64;
  constructor(f: () => i64) {
    this.f = f;
  }
  [Symbol.add](o: Sneak): i64 {
    return this.f() + o.f() - 2;
  }
  [Symbol.neg](): i64 {
    return this.f();
  }
}
let sneaked = new BigInt(0);
let sz = new BigInt(1);
const sa = new Sneak((): i64 => {
  sneaked = sz;
  return 2;
});
sz += new BigInt(sa + sa);
console.log(s(sneaked), s(sz));
let sy = new BigInt(10);
const sb = new Sneak((): i64 => {
  sneaked = sy;
  return 3;
});
sy *= new BigInt(-sb);
console.log(s(sneaked), s(sy));
const sneakStore: BigInt[] = [];
function sneakIn(): void {
  let z = new BigInt(1);
  const read = (): BigInt => z;
  const a = new Sneak((): i64 => {
    sneakStore.push(read());
    return 2;
  });
  z += new BigInt(a + a);
  let y = new BigInt(10);
  const readY = (): BigInt => y;
  const b = new Sneak((): i64 => {
    sneakStore.push(readY());
    return 3;
  });
  y *= new BigInt(-b);
  console.log(s(sneakStore[0]), s(z), s(sneakStore[2]), s(y));
}
sneakIn();
async function main(): Promise<void> {
  console.log(await stepAsync());
}
main();
