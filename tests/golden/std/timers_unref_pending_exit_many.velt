// check: no leaks
// Thousands of `unref()`'d timers made on several workers, due just after the last ref'd timer
// has run: a counted exit gives every one back while workers may still be granting turns
// (#3184). Whether a callback runs depends on when the process ends, so none prints.

// timing: the test is of timers pending or due at the moment the program ends.
async function arm(base: number): Promise<number> {
  let made = 0;
  for (let i = 0; i < 1500; i++) {
    const t = setTimeout(() => {}, base + (i % 20));
    t.unref();
    made++;
  }
  const every = setInterval(() => {}, base);
  every.unref();
  return made + 1;
}

async function main() {
  const tasks: Promise<number>[] = [];
  for (let w = 0; w < 4; w++) {
    tasks.push(spawn(arm(21 + w)));
  }
  let made = 0;
  for (const t of tasks) {
    made += await t;
  }
  // timing: the last ref'd timer; the unref'd ones are due from 1 ms after it.
  setTimeout(() => console.log("last ref'd timer"), 20);
  console.log(made);
}
