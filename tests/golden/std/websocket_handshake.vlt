// std/websocket's opening handshake (std/websocket/handshake, internal): the accept key, the
// checks a client makes on the server's response (RFC 6455 §4.1), and where a URL points.
import { acceptKey, checkResponse, generateKey, target } from "velt:websocket/handshake";
import { connectWebSocket } from "velt:websocket";
import { base64Decode } from "velt:encoding";

const KEY = "dGhlIHNhbXBsZSBub25jZQ==";

function head(extra: string): string {
  return `HTTP/1.1 101 Switching Protocols\r\nUpgrade: WebSocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Accept: ${acceptKey(KEY)}${extra}`;
}

function where(url: string): string {
  try {
    const t = target(url);
    return `${t.secure ? "tls " : ""}${t.host} ${t.port} ${t.path}`;
  } catch (e) {
    return `${e.code}: ${e.message}`;
  }
}

async function main() {
  // The example of RFC 6455 §1.3.
  console.log(acceptKey(KEY));
  const a = generateKey();
  const b = generateKey();
  console.log(a.length, base64Decode(a).length, a != b);

  console.log("ok:", checkResponse(head(""), KEY) == "");
  console.log(checkResponse("HTTP/1.1 404 Not Found", KEY));
  console.log(checkResponse(head("").replace("Upgrade: WebSocket\r\n", ""), KEY));
  console.log(checkResponse(head("").replace("keep-alive, Upgrade", "keep-alive"), KEY));
  console.log(checkResponse(head(""), "AAAAAAAAAAAAAAAAAAAAAA=="));
  console.log(checkResponse(head("\r\nSec-WebSocket-Extensions: permessage-deflate"), KEY));
  console.log(checkResponse(head("\r\nSec-WebSocket-Protocol: chat"), KEY));

  console.log(where("ws://example.com/chat?room=1"));
  console.log(where("wss://example.com"));
  console.log(where("ws://127.0.0.1:8080/"));
  console.log(where("wss://[::1]:9443/x"));
  console.log(where("http://example.com/"));
  console.log(where("not a url"));

  // Bad URLs are reported by `connectWebSocket` before anything is connected.
  try {
    await connectWebSocket("https://example.com/");
  } catch (e) {
    console.log(e.code, e.message);
  }
}
