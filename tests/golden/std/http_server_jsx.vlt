// check: no leaks
// TSX pages (velt:jsx) on velt:http/server: `renderToString` sent whole, and `renderToStream`
// streamed with `sendStream`: the markup above a pending async component reaches the client
// before the component loads (it loads only once the client has seen the head), and the
// streamed page is byte-identical to `renderToString` of the same tree. Text is escaped.
import { connect } from "velt:net";
import { channel, Channel } from "velt:channel";
import { renderToString, renderToStream } from "velt:jsx";
import { HttpRequest, HttpResponse, serve } from "velt:http/server";
import { page, Post } from "./_http_server_page";

function posts(): Post[] {
  return [new Post(1, "Velt <3 HTTP"), new Post(2, "Streaming & SSR")];
}

async function main() {
  const gate = channel<string>();
  const server = await serve({ port: 0 }, async (req: HttpRequest, res: HttpResponse) => {
    if (req.pathIs("/page")) {
      const html = await renderToString(page(null, posts()));
      res.html(html);
    } else if (req.pathIs("/stream")) {
      await res.sendStream(renderToStream(page(gate.clone(), posts())));
    } else if (req.pathIs("/stream-now")) {
      await res.sendStream(renderToStream(page(null, posts())));
    } else {
      res.status(404);
      res.send("no");
    }
  });
  const base = `http://127.0.0.1:${server.port}`;

  const whole = await fetch(`${base}/page`);
  const html = await whole.text();
  console.log(
    "page:",
    whole.headers.get("content-type"),
    whole.headers.get("content-length") != null,
  );
  console.log(html);

  // Streamed: the head arrives while the posts wait for the gate.
  const c = await connect(`127.0.0.1:${server.port}`);
  await c.write("GET /stream HTTP/1.1\r\nConnection: close\r\n\r\n");
  let received = "";
  let told = false;
  while (true) {
    const chunk = await c.readString();
    if (chunk == "") {
      break;
    }
    received += chunk;
    if (!told && received.includes("<h1>Today</h1>")) {
      told = true;
      console.log("head first, posts not yet:", !received.includes("post-1"));
      await gate.send("loaded late");
    }
  }
  c.close();
  console.log(
    "chunked:",
    received.includes("Transfer-Encoding: chunked"),
    "complete:",
    received.includes("<footer>end</footer>"),
    "late:",
    received.includes("loaded late"),
  );

  const streamed = await fetch(`${base}/stream-now`);
  const text = await streamed.text();
  console.log("same as renderToString:", text == html, streamed.headers.get("transfer-encoding"));

  server.close();
  gate.close();
}
