// check: no leaks
// A stream's microtask order against a chain of `then`s, as Node 22's (#3643): an `async` `pull`
// that returns a settled promise: the next pull runs three microtasks after it returns, as Node
// adopts the promise. The Node twin is streams_order_async_pull.mjs.
async function main(): Promise<void> {
  let n = 0;
  const s = new ReadableStream<number>({
    pull: async (c) => {
      n++;
      console.log("pull " + n);
      if (n <= 2) {
        c.enqueue(n);
      } else {
        c.close();
      }
    },
  });
  let p = Promise.resolve();
  for (let i = 0; i < 12; i++) {
    const k = i;
    p = p.then(() => {
      console.log("t" + k);
    });
  }
  const r = s.getReader();
  r.read().then((v) => console.log("read0 " + v.value));
  r.read().then((v) => console.log("read1 " + v.value));
  r.read().then((v) => console.log("read2 " + v.done));
  r.closed.then(() => console.log("closed"));
}

main();
