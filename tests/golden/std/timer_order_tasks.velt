// Node timers set by two spawned tasks on different workers take their turns in one order for the
// process, as in Node's single event loop: an immediate before any timer, one list per delay in
// the order the timers were inserted whichever task inserted them (`a 1000` before `b 1000`), the
// lists by expiry, an immediate set by a callback after its timers pass, and a timer of one task
// cleared by the other never runs.
//
// The tasks run on different workers: `main` stays busy until `a` has set its timers, and `a`
// stays busy until `b` has set its own, so each starts on a worker of its own (with one worker,
// the waits give up). `a`'s timers are inserted first, and are due once `a` is no longer busy;
// the first timer is due 1 s after it is set and the lists are 1 s apart, more than a loaded
// machine takes between the two tasks' timers (at 100 ms apart, a loaded Windows runner saw `a`'s
// first timer come due before `b` had set its immediate).
import { setImmediate, setTimeout, Timer } from "velt/time";

class State {
  aSet: boolean;
  bSet: boolean;
  toClear: Timer | null;
  constructor() {
    this.aSet = false;
    this.bSet = false;
    this.toClear = null;
  }
}

/** Busy until `ready` says so (at most 10 s). */
function spinUntil(ready: () => boolean) {
  const s = Date.now();
  while (!ready() && Date.now() - s < 10000) {}
}

async function main() {
  const state = shared(new Mutex<State>(new State()));
  const sa = state.clone();
  const a = spawn(async (): Promise<i32> => {
    setTimeout(() => console.log("a 1000"), 1000);
    setTimeout(
      () => {
        console.log("a 3000");
        setImmediate(() => console.log("a 3000's immediate"));
      },
      3000,
    );
    const t = setTimeout(() => console.log("a 4000 (cleared: never runs)"), 4000);
    sa.with((v) => {
      v.toClear = t;
      v.aSet = true;
    });
    spinUntil(() => sa.with((v) => v.bSet));
    return 0;
  });
  spinUntil(() => state.with((v) => v.aSet));
  const sb = state.clone();
  const b = spawn(async (): Promise<i32> => {
    setTimeout(
      () => {
        console.log("b 1000");
        setImmediate(() => console.log("b 1000's immediate"));
      },
      1000,
    );
    setImmediate(() => console.log("b immediate"));
    setTimeout(
      () => {
        console.log("b 2000 clears a 4000");
        sb.with((v) => {
          const t = v.toClear;
          if (t != null) {
            t.clear();
          }
        });
      },
      2000,
    );
    setTimeout(() => console.log("b 5000"), 5000);
    sb.with((v) => {
      v.bSet = true;
    });
    return 0;
  });
  await a;
  await b;
}

// timing: the order of timers is the subject; the delays of different lists are far apart
