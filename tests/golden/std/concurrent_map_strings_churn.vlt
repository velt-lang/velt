// check: unfreed blocks at most 140
// (Kept until the program exits: `velt:sync/epoch`'s registry of thread slots, 4 blocks, and a
// list of retired values per thread that retired one, 4 blocks each: 140 covers 34 threads. A
// key string or value a `set`, `delete` or split failed to retire, or dropped, is thousands more.)
// A `ConcurrentMap<string, string>` on worker threads: two writers each set and delete their own
// keys over and over, so slots empty and refill with other strings while readers compare against
// them, and leaves split, empty, unlink and are reused. The keys come in three families: all
// starting `https://` (they tie on their first 8 bytes), groups of 100 that tie on theirs, and
// keys whose first 8 bytes differ. Four readers `get` and `read` the same keys: every value they
// find is its key's. At the end every key is deleted and the epoch drained.

import { ConcurrentMap } from "velt:collections/concurrent_map";
import { collect, outstanding } from "velt:sync/epoch";

const KEYS: u64 = 3000;
const ROUNDS: u64 = 30;

function key(i: u64): string {
  if (i % 3 == 0) {
    return "https://example.com/items/" + String(i);
  }
  if (i % 3 == 1) {
    return "g" + String(i / 100).padStart(7, "0") + ":" + String(i);
  }
  return String(i).padStart(8, "0") + "/d";
}

function prefix(i: u64): string {
  return "v:" + String(i) + ":";
}

async function writer(m: shared<ConcurrentMap<string, string>>, t: u64) {
  for (let r: u64 = 0; r < ROUNDS; r++) {
    for (let i = t; i < KEYS; i += 2) {
      m.set(key(i), prefix(i) + String(r));
    }
    for (let i = t; i < KEYS; i += 2) {
      if ((i / 2 + r) % 2 == 0) {
        m.delete(key(i));
      }
    }
  }
}

async function reader(m: shared<ConcurrentMap<string, string>>): Promise<u64> {
  let wrong: u64 = 0;
  for (let r: u64 = 0; r < ROUNDS / 3; r++) {
    for (let i: u64 = 0; i < KEYS; i++) {
      const k = key(i);
      const p = prefix(i);
      const v = m.get(k);
      if (v != undefined && !v.startsWith(p)) {
        wrong++;
      }
      const ok = m.read(k, (s) => {
        const t: string = s;
        return t.startsWith(p);
      });
      if (ok == false) {
        wrong++;
      }
    }
  }
  return wrong;
}

function drain(): u64 {
  let rounds: u64 = 0;
  while (outstanding() > 0 && rounds < 10) {
    collect();
    rounds++;
  }
  return outstanding();
}

async function churn(): Promise<string> {
  const m: ConcurrentMap<string, string> = ConcurrentMap.create((2 * KEYS) as usize);
  const s = shared(m);
  const ws: Promise<void>[] = [spawn(writer(s, 0)), spawn(writer(s, 1))];
  const rs: Promise<u64>[] = [];
  for (let t = 0; t < 4; t++) {
    rs.push(spawn(reader(s)));
  }
  await Promise.all(ws);
  let wrong: u64 = 0;
  for (const w of await Promise.all(rs)) {
    wrong += w;
  }
  // The last round deletes the keys with (i / 2 + ROUNDS - 1) even and keeps the others.
  let present: u64 = 0;
  for (let i: u64 = 0; i < KEYS; i++) {
    const v = s.get(key(i));
    const kept = (i / 2 + ROUNDS - 1) % 2 != 0;
    if (v != undefined) {
      present++;
    }
    if (kept ? v != prefix(i) + String(ROUNDS - 1) : v != undefined) {
      wrong++;
    }
  }
  let deleted: u64 = 0;
  for (let i: u64 = 0; i < KEYS; i++) {
    if (s.delete(key(i))) {
      deleted++;
    }
  }
  return "wrong " + String(wrong) + " present " + String(present) + " deleted " + String(deleted);
}

async function main() {
  console.log(await churn());
  console.log("outstanding", drain());
}
