// A subclass that claims another kind (`__kind` is a method) gets a view of the bytes that were
// copied, not of its element count: a view's elements lie in its buffer, which its element
// reads rely on (std/lang/typed_array/buffer.vlt `element*`, no range check).
class Evil extends Int16Array {
  constructor() {
    super(4);
  }
  override __kind(): u32 {
    return 8;
  }
}

function main() {
  const f = new Float64Array(new Evil());
  console.log(f.length, f.byteLength);
  f[0] = 1.5;
  f[3] = 2.5; // out of range: ignored, as in JS
  console.log(f[0], f.length);
}
