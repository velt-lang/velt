// Element reads and writes of typed arrays (`xs[i]`, `xs[i] op= v`, `xs[i]++`) evaluate the
// array and the index once, in JS's order, and elements are numbers, as in Node.
function at(i: number): number {
  console.log(`index ${i}`);
  return i;
}

function main() {
  const a = new Uint8Array([10, 20, 30, 250]);
  a[at(1)] += 5;
  a[at(2)]++;
  console.log(a);
  const x = a[0];
  console.log(x * 300, a[3] + a[3], a[3] / 3, -a[0]);
  let v = (a[0] = 300);
  console.log(v, a[0]);
  v = a[1]++;
  console.log(v, a[1]);
  v = --a[1];
  console.log(v, a[1]);
  v = a[3] += 10;
  console.log(v, a[3]);
  a[0] ||= 7;
  a[2] &&= 0;
  a[2] ||= 9;
  console.log(a);
  const f = new Float64Array(2);
  f[0] = 0.1;
  f[0] += 0.2;
  f[1] = f[0] * 2;
  console.log(f, f[0] == 0.30000000000000004);
  const i32 = new Int32Array(1);
  i32[0] = 2147483647;
  i32[0]++;
  console.log(i32[0]);
  const maybe: Uint8Array | null = a.length > 2 ? a : null;
  console.log(maybe?.[0], maybe?.length);
  let total = 0;
  for (let i = 0; i < a.length; i++) {
    total += a[i];
  }
  console.log(total);
  const c = new Uint8ClampedArray(2);
  c[0] = 1000;
  c[1] = -3;
  c[0] -= 0.5;
  console.log(c);
}
