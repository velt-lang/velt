// Element reads and writes of typed arrays (`xs[i]`, `xs[i] op= v`, `xs[i]++`) evaluate the
// array and the index once, in JS's order, and elements are numbers, as in Node.
function at(i: number): number {
  console.log(`index ${i}`);
  return i;
}

function main() {
  const a = new Uint8Array([10, 20, 30, 250]);
  a[at(1)] += 5;
  a[at(2)]++;
  console.log(a);
  const x = a[0];
  console.log(x * 300, a[3] + a[3], a[3] / 3, -a[0]);
  let v = (a[0] = 300);
  console.log(v, a[0]);
  v = a[1]++;
  console.log(v, a[1]);
  v = --a[1];
  console.log(v, a[1]);
  v = a[3] += 10;
  console.log(v, a[3]);
  a[0] ||= 7;
  a[2] &&= 0;
  a[2] ||= 9;
  console.log(a);
  const f = new Float64Array(2);
  f[0] = 0.1;
  f[0] += 0.2;
  f[1] = f[0] * 2;
  console.log(f, f[0] == 0.30000000000000004);
  const i32 = new Int32Array(1);
  i32[0] = 2147483647;
  i32[0]++;
  console.log(i32[0]);
  const maybe: Uint8Array | null = a.length > 2 ? a : null;
  console.log(maybe?.[0], maybe?.length);
  let total = 0;
  for (let i = 0; i < a.length; i++) {
    total += a[i];
  }
  console.log(total);
  const c = new Uint8ClampedArray(2);
  c[0] = 1000;
  c[1] = -3;
  c[0] -= 0.5;
  console.log(c);
  // A chained assignment: the value is evaluated before the outer write, as in JS.
  const m = new Uint8Array(3);
  m[0] = m[1] = 300;
  m[2] = m[0] += 1;
  console.log(m);
  // `from` takes another typed array (any iterable of numbers).
  const i16 = new Int16Array([1, -2, 300]);
  console.log(
    Float64Array.from(i16),
    Uint8Array.from(i16, (x) => x * 2),
    Int8Array.from(new Float32Array([1.5, -1.5])),
  );
  // A length no buffer can have.
  for (const n of [2 ** 50, 2 ** 53]) {
    try {
      new Float64Array(n);
    } catch (e) {
      console.log(`${e.name}: ${e.message}`);
    }
  }
  try {
    new ArrayBuffer(2 ** 50);
  } catch (e) {
    console.log(`${e.name}: ${e.message}`);
  }
}
