// check: no leaks
// `u8[].copy(target, targetStart, sourceStart, sourceEnd)` (std/prelude/bytes.vlt), Node's
// `buf.copy`: a range into another array, as many bytes as fit, their number returned (within
// one array, `copyWithin`). Expected output is Node's (Buffer).
function main() {
  const src: u8[] = [1, 2, 3, 4, 5, 6, 7, 8];
  const dst: u8[] = Buffer.alloc(6);
  console.log(src.copy(dst), dst.join(","));
  console.log(src.copy(dst, 1, 5), dst.join(","));
  console.log(src.copy(dst, 4, 1, 3), dst.join(","));
  console.log(src.copy(dst, 0, 2, 100), dst.join(","));
  console.log(src.copy(dst, 6), src.copy(dst, 0, 3, 3), src.copy(dst, 0, 5, 2), src.copy(dst, 0, 8));
}
