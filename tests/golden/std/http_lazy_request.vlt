// check: no leaks
// A handler's `Request` reads its properties from the runtime request on access: `url`,
// `method`, `headers` (one name looked up, or all of them), an empty and a non-empty body; the
// second argument says where the request came from. A constant response header (interned by
// the runtime) and a varying one come back right on every response.
import { serve, ServeInfo } from "velt:http";

async function main() {
  const server = await serve({ port: 0 }, async (req: Request, info: ServeInfo): Promise<
    Response
  > => {
    const url = new URL(req.url);
    const accept = req.headers.get("X-Probe") ?? "none";
    const all = req.headers;
    const from = info.remoteAddr;
    const res = new Response(
      `${req.method} ${url.hostname} ${url.pathname} q=${url.search.slice(1)} probe=${accept} has=${all.has("x-probe")} from=${from.hostname} body=[${await req.text()}]`,
    );
    res.headers.append("server", "velt-golden");
    res.headers.append("x-path", url.pathname);
    return res;
  });
  const base = `http://127.0.0.1:${server.port}`;
  const probe = new Headers();
  probe.set("X-Probe", "yes");
  const urls = [`${base}/a?x=1`, `${base}/b`, `${base}/c`];
  for (const url of urls) {
    const r = await fetch(url, { headers: probe });
    console.log(r.headers.get("server") ?? "", r.headers.get("x-path") ?? "", await r.text());
  }
  const post = await fetch(`${base}/post`, { method: "POST", body: "payload" });
  console.log(await post.text());
  const empty = await fetch(`${base}/empty`, { method: "POST", body: "" });
  console.log(await empty.text());
  await server.shutdown();
}
