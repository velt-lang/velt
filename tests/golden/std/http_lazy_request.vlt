// `Request` reads its properties from the runtime request on access: getters, `header(name)`,
// `headers`, an empty and a non-empty body. A constant response header (interned by the
// runtime) and a varying one come back right on every response.
import { serve, fetch, Request, Response } from "velt:http";

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const accept = req.header("X-Probe") ?? "none";
    const all = req.headers;
    const res = Response.text(
      `${req.method} ${req.path} q=${req.query} probe=${accept} has=${all.has("x-probe")} body=[${req.body}]`,
    );
    res.header("server", "velt-golden");
    res.header("x-path", req.path);
    return res;
  });
  const base = `http://127.0.0.1:${server.port}`;
  const probe = new Map<string, string>();
  probe.set("x-probe", "yes");
  const urls = [`${base}/a?x=1`, `${base}/b`, `${base}/c`];
  for (const url of urls) {
    const r = await fetch(url, { headers: probe.clone() });
    console.log(r.headers.get("server") ?? "", r.headers.get("x-path") ?? "", await r.text());
  }
  const post = await fetch(`${base}/post`, { method: "POST", body: "payload" });
  console.log(await post.text());
  const empty = await fetch(`${base}/empty`, { method: "POST", body: "" });
  console.log(await empty.text());
  server.close();
}
