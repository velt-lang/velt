// check: no leaks
// velt:simd's carry-less multiplication (`u64x2.clmulLow` & co.): the products of known operands,
// which a debug build computes with the emulation and a release build on x86-64 or arm64 with
// the CPU's instruction (PCLMULQDQ, PMULL), and each method's choice of lanes.
import { u64x2 } from "velt:simd";

function hex(v: u64x2): string {
  return `${v.lane(0).toString(16)} ${v.lane(1).toString(16)}`;
}

function main() {
  const pairs: [u64, u64][] = [
    [0x0123456789abcdef, 0xfedcba9876543210],
    [0xffffffffffffffff, 0xffffffffffffffff],
    [0x8000000000000000, 0x8000000000000000],
    [0x87, 0xffffffff00000001],
  ];
  for (const [a, b] of pairs) {
    console.log(hex(u64x2.splat(a).clmulLow(u64x2.splat(b))));
  }
  // Each method takes its own lanes: the others hold a factor that gives 0.
  const a = u64x2.splat(0).withLane(1, 3);
  const b = u64x2.splat(3).withLane(1, 0);
  console.log(
    hex(a.clmulLow(b)),
    "|",
    hex(a.clmulHigh(b)),
    "|",
    hex(a.clmulHighLow(b)),
    "|",
    hex(b.clmulLowHigh(a)),
  );
  console.log(typeof u64x2.hasClmul());
}
