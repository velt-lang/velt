// Every power of ten std's float printing looks up (std/lang/number/pow10.velt `G`): a double at
// each binary exponent, with four mantissas, subnormals included, printed three ways and summed.
// A wrong power changes some digits, and the sum. Plus the special values, whose words are written
// by hand (std/lang/number/format.velt).

function sum(h: number, s: string): number {
  let out = h;
  for (let i = 0; i < s.length; i++) {
    out = (out * 31 + s.charCodeAt(i)) % 1000000007;
  }
  return out;
}

class Holder {
  x: number = 0;
}

function main(): void {
  const mantissas = [1, 1.3, 1.7320508075688772, 1.9999999999999998];
  const p = new Holder();
  for (const m of mantissas) {
    let h = 0;
    let count = 0;
    // Up from the smallest normal, then down through the subnormals.
    let x = m * 2.2250738585072014e-308;
    while (x != Infinity) {
      p.x = x;
      h = sum(h, `${p.x}|${String(x)}|` + -x);
      x = x * 2;
      count++;
    }
    x = m * 2.2250738585072014e-308;
    while (x != 0) {
      p.x = x;
      h = sum(h, `${p.x}|${String(x)}|` + -x);
      x = x / 2;
      count++;
    }
    console.log(m, count, h);
  }
  const special = [NaN, Infinity, -Infinity, -0, 0, 1e21, 1e-7, 0.5, 100, 1.5e300, 5e-324];
  for (const v of special) {
    p.x = v;
    const s = String(v);
    console.log(`${p.x} ${s} ${s.length} ${v + ""}`);
  }
}
