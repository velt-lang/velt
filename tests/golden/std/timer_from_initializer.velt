// A module's initializer reaches setTimeout and an async call through a function (#2196): the
// callback runs, and the kept promise starts, as in Node, where both run after the module's
// synchronous code; the kept promise's continuation is a microtask, before any timer. The
// initializer's timer comes before `main`'s with the same delay.
// timing: two timers of the same delay, which Node runs in the order they were set; no line
// depends on how long anything takes.

async function nothing(): Promise<void> {}

async function note(tag: string): Promise<void> {
  console.log(`${tag} sync`);
  await nothing();
  console.log(`${tag} later`);
}

function arm(): i64 {
  setTimeout(async () => {
    console.log("init timer");
  }, 1);
  const p = note("init call");
  return 1;
}

const armed = arm();

async function main() {
  console.log(`main ${armed}`);
  await new Promise<void>((resolve) => {
    setTimeout(async () => {
      console.log("main timer");
      resolve();
    }, 1);
  });
  console.log("end");
}
