// `console.log` of a `Headers` subclass reads the list, not the subclass's `get` (#3792). No Node
// twin: Node names the object `Headers`, Velt by its class.
class Loud extends Headers {
  get(name: string): string | null {
    console.log("get", name);
    return "overridden";
  }
}

function main() {
  const h = new Loud([
    ["b", "2"],
    ["a", "1"],
    ["b", "3"],
  ]);
  console.log(h);
  console.log({ h });
  console.log(h.get("b"));
}
