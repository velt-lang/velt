// A panic of the check at `shared(...)`, caught: the walk's scope ended with it, so the transfers
// after it are transfers of their own, each with its own copy.
import { catchPanic, PanicError } from "velt/task";

type F = (x: i64) => i64;

class B {
  n: i64 = 1;
}

interface Fi {
  make(): F;
}

class Fa implements Fi {
  make(): F {
    let k: i64 = 0;
    return (x: i64): i64 => {
      k += 1;
      return k;
    };
  }
}

async function bump(b: B): Promise<i64> {
  b.n += 1;
  return b.n;
}

async function main() {
  const m: Fi = new Fa();
  try {
    await catchPanic(async () => {
      const f = shared(m.make());
      return f(1);
    });
  } catch (e) {
    console.log(e instanceof PanicError);
  }
  const b = new B();
  console.log(await spawn(bump(b)), await spawn(bump(b)), b.n);
}
