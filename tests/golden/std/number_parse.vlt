// `Number(s)` and `parseFloat(s)` (velt:number/parse, #1658), checked against Node: the
// grammar (whitespace, signs, `0x`/`0o`/`0b`, `Infinity`, the empty string, trailing garbage,
// underscores), correct rounding (halfway cases, long mantissas, subnormals, the largest and
// smallest values, neighbours of 2^53 and 2^64, radix 2/8/16 ties) and exponents balanced
// against a million leading zeros. Each value is printed as its exact sign, odd significand and
// power of two, so the output does not depend on Velt's number printing. The file is plain
// TypeScript: the .out is Node's output
// (`cp number_parse.vlt /tmp/n.ts && node --experimental-strip-types /tmp/n.ts`).

// x = sign m * 2^e, m odd (or 0). Scaling by powers of two is exact.
function bits(x: number): string {
  if (x != x) {
    return "NaN";
  }
  const sign = x < 0 || (x == 0 && 1 / x < 0) ? "-" : "+";
  let a = Math.abs(x);
  if (a == Infinity) {
    return sign + "Infinity";
  }
  let e = 0;
  if (a != 0) {
    while (a != Math.floor(a)) {
      a = a * 4294967296;
      e -= 32;
    }
    while (a / 4294967296 == Math.floor(a / 4294967296)) {
      a = a / 4294967296;
      e += 32;
    }
    while (a / 2 == Math.floor(a / 2)) {
      a = a / 2;
      e += 1;
    }
  }
  return sign + a + "p" + e;
}

function label(s: string): string {
  return s.length <= 60
    ? JSON.stringify(s)
    : JSON.stringify(s.slice(0, 24)) + "...(" + s.length + ")";
}

function show(name: string, s: string): void {
  console.log(name, bits(Number(s)), bits(parseFloat(s)));
}

function check(s: string): void {
  show(label(s), s);
}

console.log("-- grammar");
const bodies: string[] = [
  "12",
  "-12",
  "+12",
  "1.5",
  ".5",
  "5.",
  "-.5",
  "+.5e1",
  "0x1F",
  "0X1f",
  "0o17",
  "0O17",
  "0b101",
  "0B101",
  "Infinity",
  "-Infinity",
  "+Infinity",
  "1e5",
  "12345678901234567890123",
  "1234567890123456789012345e-5",
  "0.000001",
  "-0",
  "0",
  "0x",
  "0b",
  "0o",
  "1_000",
  "1__0",
  "_1",
  "1_",
  "0x1_0",
  "1e1_0",
  "1.2.3",
  "1e5.5",
  "1e",
  "1e+",
  "1e-",
  "1E5",
  "00012",
  "-00",
  "0.0e0",
  "e5",
