for (let k = -3; k <= 3; k++) {
  check(String(9007199254740992 + k));
  check("1844674407370955161" + (5 + k));
  check("922337203685477580" + (7 + k));
}

console.log("-- leading zeros against the exponent");
const zeros: number[] = [10, 25, 100, 400, 1000, 5000, 100000, 1000005];
for (const z of zeros) {
  check("0." + "0".repeat(z) + "1e" + (z + 1));
  check("0." + "0".repeat(z) + "123456789e" + (z + 1));
  check("0." + "0".repeat(z) + "1e" + z);
  check("0".repeat(z) + "1.5");
  check("1." + "0".repeat(z) + "1");
  check("1." + "0".repeat(z));
}
check("0." + "0".repeat(1000000) + "1e1000001");
check("-0." + "0".repeat(1000010) + "25e1000005");
const big = "0." + "0".repeat(1000000) + "1e1000001";
const v: number = JSON.parse(big);
console.log("JSON.parse", bits(v));
