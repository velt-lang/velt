  "infinity",
  "INFINITY",
  "Infinit",
  "NaN",
  "-NaN",
  "nan",
  "１",
  "1\u0000",
];
const trailers: string[] = ["", "x", "1", ".", "e", " 2", "e5", "_", "abc", "Infinity", "\u0000"];
for (const b of bodies) {
  for (const t of trailers) {
    check(b + t);
  }
}

console.log("-- whitespace");
// JavaScript's whitespace and line terminators, then four that are not (U+180E, U+200B, U+0085,
// U+2060).
const ws: string[] = [
  " ",
  "\t",
  "\n",
  "\r",
  "\v",
  "\f",
  " ",
  " ",
  " ",
  " ",
  " ",
  " ",
  " ",
  " ",
  "　",
  "﻿",
  "᠎",
  "​",
  "\u0085",
  "⁠",
  " 　 \t",
];
const wsBodies: string[] = ["12", "-1.5e3", "0x1F", "Infinity", "12345678901234567890123", "1e"];
for (let i = 0; i < ws.length; i++) {
  const w = ws[i];
  show("ws" + i, w);
  show("ws" + i + " x2", w + w);
  for (const b of wsBodies) {
    show("ws" + i + " before " + label(b), w + b);
    show("ws" + i + " after " + label(b), b + w);
    show("ws" + i + " around " + label(b), w + b + w);
  }
}

console.log("-- radix 2, 8 and 16");
const radix: string[] = [
  "0x" + "f".repeat(300),
  "0x1" + "0".repeat(256),
  "0x1" + "0".repeat(255),
  "0x" + "f".repeat(256),
  "0x" + "f".repeat(255) + "e",
  "0b" + "1".repeat(54),
  "0b1" + "0".repeat(52) + "1",
  "0b1" + "0".repeat(52) + "11",
  "0x20000000000001",
  "0x20000000000003",
  "0x20000000000002",
  "0x200000000000010000001",
  "0x20000000000001000000",
  "0x2000000000000100000000000000000000000000001",
  "0o" + "7".repeat(400),
  "0o1" + "0".repeat(17) + "1",
  "0o4" + "0".repeat(17) + "1",
  "0o4" + "0".repeat(16) + "4",
  "0o4" + "0".repeat(16) + "40",
  "0o4" + "0".repeat(16) + "41",
  "0xFFFFFFFFFFFFF800",
  "0xFFFFFFFFFFFFFC00",
  "0xFFFFFFFFFFFFFC01",
  "0xFFFFFFFFFFFFFBFF",
  "0x1FFFFFFFFFFFFF",
  "0x3FFFFFFFFFFFFF",
  "0x7FFFFFFFFFFFFE",
  "0x1fffffffffffff8" + "0".repeat(240),
  "0x1fffffffffffffc" + "0".repeat(240),
  "0x1fffffffffffffbff" + "0".repeat(238),
];
for (const s of radix) {
  check(s);
}

