// `++` and `--` through a variable key of `globalThis`, as statements, also with `!`.
type Host = { __UA__?: number; __UB__?: number };
function inc(k: keyof Host): void {
  const h = globalThis as Host;
  h[k] ??= 0;
  h[k]!++;
  h[k]!++;
  h[k]!--;
}
inc("__UA__");
inc("__UB__");
inc("__UB__");
console.log((globalThis as Host).__UA__, (globalThis as Host).__UB__);
