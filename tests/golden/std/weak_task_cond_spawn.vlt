// spawn(c ? f(x) : g(y)) with a WeakRef argument (written type).
class V {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}

async function run(r: WeakRef<V>): Promise<number> {
  let s = 0;
  for (let j = 0; j < 100000; j++) {
    const x = r.deref();
    s += x === null ? -1 : x.n;
  }
  return s;
}

async function run2(r: WeakRef<V>): Promise<number> {
  return 0;
}

async function main() {
  const keep = new V(7);
  let total = 0;
  for (let r = 0; r < 20; r++) {
    const w = new WeakRef(keep);
    total += await spawn(r >= 0 ? run(w) : run2(w));
  }
  console.log(total, keep.n);
}
