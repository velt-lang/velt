// The ES2025 set algebra reads this set's own elements and, of `other`, only `size` (once,
// first), `has` and `keys`, choosing by size and stopping early as Node does; iterating a set
// never calls a subclass's `values` (#3792). Results are plain sets.
let log: string[] = [];

class L extends Set<number> {
  tag: string = "";
  constructor(xs: number[], tag: string) {
    super(xs);
    this.tag = tag;
  }
  override get size(): usize {
    log.push(`${this.tag}.size`);
    return super.values().length as usize;
  }
  override has(x: number): bool {
    log.push(`${this.tag}.has(${x})`);
    return super.has(x);
  }
  override keys(): number[] {
    log.push(`${this.tag}.keys`);
    return super.keys();
  }
  override values(): number[] {
    log.push(`${this.tag}.values`);
    return super.values();
  }
}

function elems(r: Set<number>): string {
  const out: number[] = [];
  r.forEach((x) => {
    out.push(x);
  });
  return out.join(",");
}

function showSet(name: string, r: Set<number>) {
  const calls = log.join(" ");
  log = [];
  console.log(`${name}: [${elems(r)}] ${r instanceof L} | ${calls}`);
}

function showBool(name: string, r: boolean) {
  const calls = log.join(" ");
  log = [];
  console.log(`${name}: ${r} | ${calls}`);
}

function mk(): L {
  return new L([1, 2, 3], "a");
}

function run(label: string, other: () => L) {
  console.log(`-- ${label}`);
  let a = mk();
  let o = other();
  log = [];
  showSet("union", a.union(o));
  a = mk();
  o = other();
  log = [];
  showSet("intersection", a.intersection(o));
  a = mk();
  o = other();
  log = [];
  showSet("difference", a.difference(o));
  a = mk();
  o = other();
  log = [];
  showSet("symmetricDifference", a.symmetricDifference(o));
  a = mk();
  o = other();
  log = [];
  showBool("isSubsetOf", a.isSubsetOf(o));
  a = mk();
  o = other();
  log = [];
  showBool("isSupersetOf", a.isSupersetOf(o));
  a = mk();
  o = other();
  log = [];
  showBool("isDisjointFrom", a.isDisjointFrom(o));
}

run("bigger", () => new L([2, 3, 4, 5], "b"));
run("smaller", () => new L([2], "c"));
run("early", () => new L([1, 5, 6, 7], "d"));

const a = mk();
log = [];
const seen: number[] = [];
for (const x of a) seen.push(x);
showBool(`for-of ${seen.join(",")}`, false);
const spread = [...a];
showBool(`spread ${spread.join(",")}`, false);
const ks = new Set<number>([3, 1, 3]);
console.log([...ks.keys()].join(","), [...ks.entries()].map((p) => `${p[0]}:${p[1]}`).join(" "));
