// An interface value holding a WeakRef is a spawn argument.
class V {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}

interface Peek {
  peek(): number;
}

class H implements Peek {
  r: WeakRef<V>;
  constructor(r: WeakRef<V>) {
    this.r = r;
  }
  peek(): number {
    const x = this.r.deref();
    if (x === null) {
      return -1;
    }
    return x.n;
  }
}

async function run(p: Peek): Promise<number> {
  let s = 0;
  for (let j = 0; j < 200000; j++) {
    s += p.peek();
  }
  return s;
}

async function main() {
  const keep = new V(7);
  let total = 0;
  for (let round = 0; round < 20; round++) {
    const p = spawn(run(new H(new WeakRef(keep))));
    const a: V[] = [];
    for (let j = 0; j < 200000; j++) {
      a.push(keep);
      if (a.length > 8) {
        a.length = 0;
      }
    }
    total += await p;
  }
  console.log(total, keep.n);
}
