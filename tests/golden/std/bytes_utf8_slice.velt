// `utf8Slice` of byte ranges (Node's `toString("utf8", start, end)`), in std (#2196): ASCII
// of 22, 23 and 24 bytes (around the inline string's 23), long ASCII, two-, three- and four-byte
// characters, invalid sequences (a lone continuation byte, an overlong form, a surrogate, a
// sequence the range's end cuts off) each as U+FFFD per maximal invalid subpart, ranges that
// start inside the array, and positions clamped to it. The Node twin is bytes_utf8_slice.mjs.
function show(s: string): string {
  return `${s.length} ${JSON.stringify(s)}`;
}

function main() {
  const ascii = Buffer.from("abcdefghijklmnopqrstuvwxyz0123456789");
  console.log(show(ascii.utf8Slice(0, 22)));
  console.log(show(ascii.utf8Slice(0, 23)));
  console.log(show(ascii.utf8Slice(0, 24)));
  console.log(show(ascii.utf8Slice(5, 36)));
  console.log(show(ascii.utf8Slice(30, 99)));
  console.log(show(ascii.utf8Slice(-3, 4)));
  console.log(show(ascii.utf8Slice(10, 5)));
  const long: u8[] = [];
  for (let i = 0; i < 300; i++) {
    long.push((97 + (i % 26)) as u8);
  }
  console.log(show(long.utf8Slice(1, 299)));
  const mixed = Buffer.from("añ€𝄞 and ascii after the non-ascii start, long enough");
  console.log(show(mixed.utf8Slice()));
  console.log(show(mixed.utf8Slice(1, 3)));
  console.log(show(mixed.utf8Slice(1, 2)));
  console.log(show(mixed.utf8Slice(3, 6)));
  console.log(show(mixed.utf8Slice(6, 9)));
  console.log(show(mixed.utf8Slice(6, 10)));
  const bad = Buffer.from([0x61, 0x80, 0x62, 0xc0, 0xaf, 0x63, 0xed, 0xa0, 0x80, 0x64, 0xf0, 0x9f]);
  console.log(show(bad.utf8Slice()));
  console.log(show(bad.utf8Slice(0, 3)));
  console.log(show(bad.utf8Slice(10, 12)));
  console.log(show(bad.utf8Slice(2, 6)));
  const longBad: u8[] = [];
  for (let i = 0; i < 40; i++) {
    longBad.push(0x78);
  }
  longBad.push(0xff);
  longBad.push(0x79);
  console.log(show(longBad.utf8Slice()));
}

main();
