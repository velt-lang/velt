// The byte helpers std/websocket is built on: `u8[].xorMask` (prelude), and the internal
// std/websocket/bytes (ranged UTF-8 checks and decoding, text copied into a buffer, `ByteBuf`).
import { ByteBuf, setText, textOf, utf8Prefix } from "velt:websocket/bytes";
import { utf8Encode } from "velt:encoding";

function main() {
  // xorMask: the mask's bytes most significant first, repeating from `start`; its own inverse.
  const data: u8[] = [];
  for (let i = 0; i < 21; i++) {
    data.push(i as u8);
  }
  data.xorMask(0x01020304u32, 2, 19);
  console.log(data);
  data.xorMask(0x01020304u32, 2, 19);
  console.log(data.every((b, i) => (b as i64) == i), data.length);
  const all: u8[] = [0u8, 0u8, 0u8, 0u8, 0u8];
  all.xorMask(0xa1b2c3d4u32);
  console.log(all);

  // utf8Prefix: how much of a range is valid, -1 when no continuation can fix it.
  const text = utf8Encode("aé✓😀");
  console.log(text.length, utf8Prefix(text, 0, 10), utf8Prefix(text, 0, 9), utf8Prefix(text, 0, 2));
  console.log(utf8Prefix(text, 1, 3), utf8Prefix(text, 2, 6), utf8Prefix(text, 4, 4));
  console.log(
    utf8Prefix([0x61u8, 0xffu8, 0x62u8], 0, 3),
    utf8Prefix([0xedu8, 0xa0u8, 0x80u8], 0, 3),
  );

  // textOf: a range as a string, null if it is not valid UTF-8.
  console.log(textOf(text, 1, 6), textOf(text, 0, 0) == "", textOf(text, 0, 2) == null);
  console.log(textOf(text, -4, 9223372036854775807));

  // setText and ByteBuf.
  const buf = new ByteBuf();
  console.log(buf.data.length, buf.cap);
  buf.append([1u8, 2u8, 3u8]);
  const hej: u8[] = Buffer.alloc(Buffer.byteLength("héj"));
  setText(hej, "héj", 0);
  buf.append(hej);
  buf.append([9u8, 9u8]);
  console.log(buf.data, buf.cap);
  buf.dropFront(3);
  console.log(textOf(buf.data, 0, 4), buf.data.length);
  for (let i = 0; i < 300; i++) {
    buf.append([7u8]);
  }
  console.log(buf.data.length, buf.cap, buf.data[5], buf.data[305]);
  const taken = buf.take();
  console.log(taken.length, buf.data.length, buf.cap);
  buf.adopt([4u8, 5u8]);
  buf.append([6u8]);
  console.log(buf.data, buf.cap >= 3);
}
