// check: no leaks
// Object.assign writes to the target itself, also when the target's fields are all numbers and
// booleans (an object stored inline), through a parameter, from a class instance and from an
// object with optional fields onto a Record (#925).

const t: { a: number } = { a: 0 };
const r = Object.assign(t, { a: 42 });
console.log(t.a, r.a, r === t);
const u = { a: 0, b: true };
Object.assign(u, { a: 42, b: false });
console.log(u);

function setA(p: { a: number }): void {
  Object.assign(p, { a: 7 });
}

setA(t);
console.log(t);

class Src {
  a = 9;
}

Object.assign(u, new Src());
console.log(u);

const o = { s: "x", n: 1 };
const o2 = Object.assign(o, { n: 2 });
console.log(o, o2 === o);

class Point {
  x = 0;
  y = 0;
  move(): void {
    Object.assign(this, { x: 3, y: 4 });
  }
}

const pt = new Point();
pt.move();
console.log(pt.x, pt.y);

const holder = { inner: { v: 1, ok: false } };
Object.assign(holder.inner, { v: 2, ok: true });
console.log(holder);

const recs: Record<string, string> = {};
const p: { name: string; color?: string } = { name: "x", color: "blue" };
Object.assign(recs, p);
console.log(recs);
const q: { name: string; color?: string } = { name: "y" };
const recs2: Record<string, string> = {};
Object.assign(recs2, q);
console.log(recs2, "color" in recs2);
const both: Record<string, string> = {};
Object.assign(both, q, p);
console.log(both);

// The result names the target's object: writes through it reach the target.
const w = { n: 1, on: false };
const w2 = Object.assign(w, { n: 2 });
w2.on = true;
console.log(w, w2 === w);

// Array elements are written in place too, each index evaluated once.
const arr: { a: number }[] = [{ a: 0 }, { a: 1 }];
Object.assign(arr[0], { a: 42 });
console.log(arr);
let calls = 0;

function next(): number {
  calls++;
  return calls;
}

Object.assign(arr[next()], { a: 7 });
console.log(arr, calls);
const pts: { x: number; y: number }[] = [{ x: 0, y: 0 }];
const moved = Object.assign(pts[0], { x: 4 });
moved.x = 5;
console.log(pts, moved === pts[0]);
const grid = { rows: [{ on: false }] };
Object.assign(grid.rows[0], { on: true });
console.log(grid);
