// `toExponential` and `toPrecision` as in Node (#795), and `toFixed` beside them.
function main() {
  const xs = [
    123.456,
    0,
    -0,
    1,
    -1,
    0.5,
    1.5,
    2.5,
    -2.5,
    1.25,
    1.005,
    9.99,
    99.99,
    999.9,
    0.00015,
    0.000123,
    0.0000001,
    1e-7,
    123456789,
    1e21,
    1.7976931348623157e308,
    5e-324,
    1 / 3,
    NaN,
    Infinity,
    -Infinity,
  ];
  for (const x of xs) {
    console.log(
      x,
      x.toExponential(),
      x.toExponential(0),
      x.toExponential(2),
      x.toExponential(20),
      x.toPrecision(),
      x.toPrecision(1),
      x.toPrecision(3),
      x.toPrecision(21),
      x.toFixed(2),
    );
  }
  console.log((123.456).toExponential(100));
  console.log((0.1).toPrecision(100));
  const digits = 3;
  console.log((2 / 3).toExponential(digits), (2 / 3).toPrecision(digits + 1));
  console.log(NaN.toExponential(101), Infinity.toPrecision(0));
  // A `number` argument is truncated (ToIntegerOrInfinity): 2.7 is 2.
  const d: number = 2.7;
  const y: number = 123.456;
  console.log(y.toExponential(d), y.toPrecision(d), y.toExponential(2.7), y.toPrecision(2.7));
  console.log(y.toExponential(0.9), y.toPrecision(1.9), y.toFixed(d));
}
