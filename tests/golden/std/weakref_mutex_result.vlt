// An object holding a `WeakRef` to a part of the locked value cannot leave `with`.
class K {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}

class Box {
  k: K;
  constructor(k: K) {
    this.k = k;
  }
}

class H {
  r: WeakRef<K>;
  constructor(r: WeakRef<K>) {
    this.r = r;
  }
}

async function main() {
  const m = shared(new Mutex<Box>(new Box(new K(5))));
  const h = m.with((v) => new H(new WeakRef(v.k)));
  console.log(h.r.deref() !== null);
}
