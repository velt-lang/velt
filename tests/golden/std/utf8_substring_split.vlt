// utf8Substring at a byte inside a character is a RangeError: inside a four-byte character too,
// although slice can cut its surrogate pair (no string position is inside its UTF-8 form).
import { utf8Substring } from "velt:encoding";

function main() {
  const s = "a😀";
  console.log(utf8Substring(s, 0, 5));
  console.log(utf8Substring(s, 0, 3));
}
