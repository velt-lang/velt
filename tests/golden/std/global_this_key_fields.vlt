// An instance field initializer of a module-level class runs when an instance is made: it reads
// a key constant declared after the class, as TypeScript allows.
type H = { __KA__?: number; __KB__?: number };
(globalThis as H).__KB__ = 2;
class C { v: number = (globalThis as H)[K]!; }
const K = "__KB__";
console.log(new C().v);
