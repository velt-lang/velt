// A `ConcurrentMap<string, string>` on worker threads, its keys sharing long prefixes (the
// first 8 bytes of a thousand keys at a time are the same), so separators tie with keys while
// leaves and inner nodes split under readers: writers setting and replacing their own keys, a
// deleter removing a known set, and readers checking, in place, that every value they find is
// their key's. At the end every key has its last value, and the deleted ones are gone.

import { ConcurrentMap } from "velt:collections/concurrent_map";

const N: u64 = 20000;

function key(i: u64): string {
  return `user:${`${i}`.padStart(6, "0")}:${i % 7 == 0 ? "tail" : ""}`;
}

async function writer(m: shared<ConcurrentMap<string, string>>, t: u64) {
  for (let i = t; i < N; i += 3) {
    m.set(key(i), `first ${i}`);
  }
  for (let i = t; i < N; i += 3) {
    m.set(key(i), `${i}`);
  }
}

async function deleter(m: shared<ConcurrentMap<string, string>>): Promise<u64> {
  let removed: u64 = 0;
  for (let i: u64 = 0; i < N; i += 2) {
    if (m.delete(key(N + i))) {
      removed++;
    }
  }
  return removed;
}

async function reader(m: shared<ConcurrentMap<string, string>>): Promise<u64> {
  let wrong: u64 = 0;
  for (let r = 0; r < 3; r++) {
    for (let i: u64 = 0; i < N; i++) {
      const ok = m.read(key(i), (v) => {
        const s: string = v;
        return s == `${i}` || s == `first ${i}`;
      });
      if (ok == false) {
        wrong++;
      }
      // A key of the deleter's: present with its value, or gone.
      const kept = m.get(key(N + i));
      if (kept != undefined && kept != `${N + i}`) {
        wrong++;
      }
    }
  }
  return wrong;
}

async function main() {
  const m: ConcurrentMap<string, string> = ConcurrentMap.create((3 * N) as usize);
  for (let i: u64 = 0; i < N; i++) {
    m.set(key(N + i), `${N + i}`);
  }
  const s = shared(m);
  const ws: Promise<void>[] = [];
  for (let t: u64 = 0; t < 3; t++) {
    ws.push(spawn(writer(s, t)));
  }
  const d = spawn(deleter(s));
  const rs: Promise<u64>[] = [spawn(reader(s)), spawn(reader(s))];
  await Promise.all(ws);
  const removed = await d;
  let wrong: u64 = 0;
  for (const w of await Promise.all(rs)) {
    wrong += w;
  }
  let missing: u64 = 0;
  for (let i: u64 = 0; i < N; i++) {
    if (s.get(key(i)) != `${i}`) {
      missing++;
    }
    const kept = s.get(key(N + i));
    if (i % 2 == 0 ? kept != undefined : kept != `${N + i}`) {
      missing++;
    }
  }
  console.log("removed", removed, "wrong", wrong, "missing", missing);
}
