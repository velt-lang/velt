// `Math.min` / `Math.max` with two or more plain arguments compile to a chain of two-value
// comparisons (no rest array, #1570): the same results as JS for NaN, -0, infinities and
// integers, arguments evaluated once each from left to right; spread, one and no arguments
// take the ordinary call.
function show(x: number): string {
  return Object.is(x, -0) ? "-0" : `${x}`;
}

// Edit distance with the usual two-row DP: a three-value `Math.min` per cell, in a loop.
function editDistance(a: string, b: string): number {
  let prev: number[] = [];
  let curr: number[] = [];
  for (let i = 0; i <= a.length; i++) {
    prev.push(i);
    curr.push(0);
  }
  for (let j = 1; j <= b.length; j++) {
    curr[0] = j;
    for (let i = 1; i <= a.length; i++) {
      const cost = a.charCodeAt(i - 1) === b.charCodeAt(j - 1) ? 0 : 1;
      curr[i] = Math.min(prev[i]! + 1, curr[i - 1]! + 1, prev[i - 1]! + cost);
    }
    const tmp = prev;
    prev = curr;
    curr = tmp;
  }
  return prev[a.length]!;
}

function main() {
  const xs = [3, 1, 2];
  const k: number = 7;
  console.log(show(Math.min(1, 2)), show(Math.max(1, 2)));
  console.log(show(Math.min(3, 1, 2)), show(Math.max(3, 1, 2, 9, -4)));
  console.log(show(Math.min(0, -0)), show(Math.min(-0, 0)), show(Math.max(0, -0)), show(Math.max(-0, 0)));
  console.log(show(Math.min(-0, 0, 0)), show(Math.max(-0, -0, 0)));
  console.log(show(Math.min(1, NaN, 0)), show(Math.max(NaN, 1)), show(Math.min(2, 1, NaN)));
  console.log(show(Math.min(...xs)), show(Math.max(...xs)), show(Math.min(5)), show(Math.min()), show(Math.max()));
  console.log(show(Math.min(k, 2.5, Infinity)), show(Math.max(-Infinity, k)));
  let order = 0;
  const next = (v: number): number => {
    order = order * 10 + v;
    return v;
  };
  console.log(show(Math.min(next(1), next(2), next(3))), order);
  console.log(editDistance("kitten", "sitting"), editDistance("", "abc"), editDistance("flaw", "lawn"));
}
