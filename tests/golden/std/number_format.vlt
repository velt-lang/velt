// Numbers as text through std/lang/number/format.vlt (#1982): integers of every width and sign
// as templates, String() and appends to a growing builder, and floats through the hooks whose
// whole numbers take the integer path. Every line matches Node.

import { appendJsonNumber, appendJsonUint } from "velt/encoding/json";

function integers() {
  const xs: i64[] = [
    0,
    1,
    -1,
    9,
    -9,
    10,
    -10,
    99999999,
    -99999999,
    100000000,
    -100000000,
    9223372036854775807,
    -9223372036854775807 - 1,
    1234567890123,
    -987654321987654321,
  ];
  for (const x of xs) {
    console.log(`${x}|${x}`, String(x), `[${x}]`);
  }
  let p: i64 = 1;
  for (let i = 0; i < 19; i++) {
    console.log(`${p - 1} ${p} ${-p} ${p + 1}`);
    p = p * 10;
  }
  const us: u64[] = [0, 18446744073709551615, 10000000000000000000, 9999999999999999999];
  for (const u of us) {
    console.log(`${u}`, String(u), `u=${u}.`);
  }
  let s = "";
  for (let i: i64 = 0; i < 2000; i += 37) {
    s += `${i - 1000},`;
  }
  console.log(s.length, s.slice(0, 60), s == s.slice(0));
  const k: i32 = -2147483648;
  const b: u8 = 255;
  console.log(`${k} ${b}`, `${k}` == "-2147483648", `${12}`.length);
}

function floats() {
  const xs: number[] = [
    0,
    -0,
    1,
    -1,
    0.5,
    -2.25,
    1e21,
    1e20,
    123456789012345680000,
    9007199254740992,
    9007199254740991,
    -9007199254740991,
    1 / 3,
    NaN,
    Infinity,
    -Infinity,
    1e-7,
    5e-324,
    4294967296.5,
    -1.2345678901234567e-100,
    -0.0000012345678901234567,
    0.0000012345678901234567,
    1.7976931348623157e308,
    -2.2250738585072014e-308,
    1e-323,
    2 ** 70,
    1e100,
    0.1 + 0.2,
    -123.456,
    100.5,
    1e-6,
    1e-5,
    // Two-digit subnormals that the JDK's `s >= 100` would print one digit too long.
    9e-323,
    1e-322,
    -9.9e-323,
  ];
  for (const x of xs) {
    console.log(`${x}`, String(x), x.toString(), `<${x}>`);
  }
  let s = "";
  for (let i = 0; i < 12; i++) {
    s += `${i * 1000000007} `;
  }
  console.log(s);
  for (let i = 0; i < 3; i++) {
    console.log(`${i}`, `i=${i}`, String(i * 2));
  }
}

// A StringBuilder's appendInt/appendNumber and JSON's numbers, through the same formatter.
function builderAndJson() {
  const xs: number[] = [
    0,
    -0,
    7,
    -7,
    0.1,
    -2.5e-7,
    1e21,
    123456.789,
    5e-324,
    1.7976931348623157e308,
    NaN,
    Infinity,
    -Infinity,
  ];
  const b = new StringBuilder();
  for (const x of xs) {
    b.appendNumber(x);
    b.append(",");
  }
  b.appendInt(-9223372036854775807 - 1);
  b.append(",");
  b.appendInt(1234567890123456789);
  console.log(b.toString());
  console.log(JSON.stringify(xs));
  console.log(JSON.stringify({ a: 1.5, b: -0, c: [1e-7, 2 ** 60], d: 0.000001 }));
  const j = new StringBuilder();
  appendJsonNumber(j, -0.5);
  j.append(" ");
  appendJsonNumber(j, NaN);
  j.append(" ");
  appendJsonUint(j, 18446744073709551615);
  console.log(j.toString());
}

// toFixed: exact ties away from zero, the most digits done in Velt (19) and the first done by
// the runtime (20), `String(x)` from 1e21 up, subnormals, `-0` and small negatives.
function fixed() {
  const xs: number[] = [
    0,
    -0,
    0.5,
    2.5,
    -1.25,
    1.005,
    9.995,
    0.125,
    -0.0001,
    1 / 3,
    5e-324,
    1e20,
    1e21,
    2 ** 70,
    NaN,
  ];
  for (const x of xs) {
    console.log([0, 1, 2, 6, 19, 20].map((d) => x.toFixed(d)).join(" "));
  }
}

function main() {
  integers();
  floats();
  builderAndJson();
  fixed();
}
