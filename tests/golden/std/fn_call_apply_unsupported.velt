// A `this` other than the one Velt's function keeps: "not supported yet" (tsc accepts all).
class Counter {
  n = 0;
  inc(by: number): number {
    this.n += by;
    return this.n;
  }
}
const a = new Counter();
const b = new Counter();
console.log(a.inc.call(b, 1));
const f = a.inc;
console.log(f.call(a, 1));
console.log(f.apply(b, [1]));
// `null` / `undefined` as `this` of a method using it: Node throws a TypeError.
class Box {
  n = 1;
  get1(): number {
    return this.n;
  }
}
class Base {
  static readonly base: number = 1;
  static make(): number {
    return this.base;
  }
}
class Derived extends Base {
  static readonly base: number = 2;
}
const box = new Box();
console.log(box.get1.call(null));
console.log(Derived.make.call(null));
const g = box.get1;
console.log(g.call(undefined));
// `Promise`'s statics make their value with `this`: Node throws "PromiseResolve called on non-object".
console.log(Promise.resolve.call(null, 5));
