// `JSON.stringify(x, replacer, space)` as Node writes it: indent numbers (clamped to 10) and
// strings (first 10 code units), empty containers, escapes, array replacers (#807).
class Point {
  x: number = 1;
  y: number = 2;
  label: string = "p\u00e9 \"q\"\n\t\u2028";
}

interface Row {
  id: number;
  tags: string[];
  meta: { a: number; b: number[] };
}

const rows: Row[] = [
  { id: 1, tags: ["a", "b"], meta: { a: 1, b: [] } },
  { id: 2, tags: [], meta: { a: 2, b: [3, 4] } },
];
const empty: number[] = [];
const nested: number[][] = [[], [1], [[]].length > 0 ? [] : [2]];
console.log(JSON.stringify(rows, null, 2));
console.log(JSON.stringify(rows, null, "\t"));
console.log(JSON.stringify(rows, null, "--"));
console.log(JSON.stringify(rows, null, 0));
console.log(JSON.stringify(rows, null, -3));
console.log(JSON.stringify(rows, null, 2.9));
console.log(JSON.stringify(rows, null, 20));
console.log(JSON.stringify(rows, null, ""));
console.log(JSON.stringify(rows, null, "abcdefghijklmno"));
console.log(JSON.stringify(empty, null, 2), JSON.stringify(nested, null, 2));
console.log(JSON.stringify(new Point(), null, 4));
console.log(
  JSON.stringify({}, null, 2),
  JSON.stringify("s\u00e9", null, 2),
  JSON.stringify(5, null, 2),
);
console.log(JSON.stringify(rows, ["id", "meta", "a"]));
console.log(JSON.stringify(rows, ["meta", "id", "b", "id"], 1));
console.log(JSON.stringify(new Point(), ["y", "x", "z"], "\t"));
console.log(JSON.stringify(new Point(), []));
const keys: string[] = ["label"];
console.log(JSON.stringify(new Point(), keys, 2));
const numKeys: number[] = [1, 0];
const m: { "0": string; "1": number } = { "0": "zero", "1": 1 };
console.log(JSON.stringify(m, numKeys));
console.log(JSON.stringify(rows, null));
const n: number | null = null;
console.log(JSON.stringify([n, 1.5, -0, 1e21], null, 1));
console.log(JSON.stringify("x", null, "😀😀😀😀😀😀"));
console.log(JSON.stringify([1], null, "😀😀😀😀😀😀"));
