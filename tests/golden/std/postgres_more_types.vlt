// requires-env: VELT_TEST_PG_URL
// std/postgres: interval, money, inet/cidr and macaddr columns decode without a ::text cast
// (to the text PostgreSQL prints for them), also inside arrays and as NULL.
import { env } from "velt:process";
import { connect } from "velt:postgres";

class Row {
  span: string;
  neg: string | null;
  price: string;
  host: string;
  net: string;
  v6: string;
  mac: string;
  hosts: string[];

  constructor(
    span: string,
    neg: string | null,
    price: string,
    host: string,
    net: string,
    v6: string,
    mac: string,
    hosts: string[],
  ) {
    this.span = span;
    this.neg = neg;
    this.price = price;
    this.host = host;
    this.net = net;
    this.v6 = v6;
    this.mac = mac;
    this.hosts = hosts;
  }
}

async function main() {
  const db = await connect(env("VELT_TEST_PG_URL") ?? "");
  const r: Row | null = await db.selectOne(
    `SELECT interval '1 year 2 months 3 days 04:05:06.5' AS span,
            CASE WHEN false THEN interval '1 day' END AS neg,
            '-1234.5'::numeric::money AS price,
            inet '10.0.0.1' AS host,
            cidr '10.0.0.0/8' AS net,
            inet '2001:db8::1/64' AS v6,
            macaddr '08:00:2b:01:02:03' AS mac,
            ARRAY[inet '192.168.0.1', inet '::1'] AS hosts`,
  );
  if (r != null) {
    console.log(r.span, "|", r.neg == null, "|", r.price);
    console.log(r.host, r.net, r.v6, r.mac, r.hosts.join(","));
  }
  const spans: Row[] = await db.select(
    "SELECT interval '-1 second' AS span, NULL::interval AS neg, 0::money AS price, " +
      "inet '::ffff:1.2.3.4' AS host, cidr '2001:db8::/32' AS net, inet '::' AS v6, " +
      "macaddr 'ff:ff:ff:ff:ff:ff' AS mac, ARRAY[]::inet[] AS hosts",
  );
  console.log(
    spans[0].span,
    spans[0].price,
    spans[0].host,
    spans[0].net,
    spans[0].v6,
    spans[0].mac,
  );
  console.log(spans[0].hosts.length);
  db.close();
}
