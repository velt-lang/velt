// The JSON globals load for a program that reaches them only through std: the `Value` alias
// of velt:json and the fetch API's `json()` (this file never spells the globals' names).
import { Value } from "velt:json";

function show(v: Value): string {
  return v.stringify();
}

async function main() {
  const v = await new Response('{"a":[1,2],"b":"x"}').json<Value>();
  console.log(show(v));
  console.log(v);
  const r = new Response('{"n":3}');
  const body = await r.json<{ n: i64 }>();
  console.log(body.n);
  const w = Response.json({ ok: true, list: [1, 2] });
  console.log(await w.text());
}
