function checkF64x2(): number {
  let failures = 0;
  for (let len: usize = 0; len <= 5; len++) {
    const xs: f64[] = [];
    for (let k: usize = 0; k < len; k++) {
      xs.push(((k * 37 + 11) % 251) as f64);
    }
    for (let at: usize = 0; at <= len; at++) {
      const v = f64x2.loadPartial(xs, at);
      for (let k: usize = 0; k < 2; k++) {
        const want = at + k < len ? xs[at + k] : (0 as f64);
        if (v.lane(k) != want) {
