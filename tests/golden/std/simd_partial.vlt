    const xs: u32[] = [];
    for (let k: usize = 0; k < len; k++) {
      xs.push(((k * 37 + 11) % 251) as u32);
    }
    for (let at: usize = 0; at <= len; at++) {
      const v = u32x4.loadPartial(xs, at);
      for (let k: usize = 0; k < 4; k++) {
        const want = at + k < len ? xs[at + k] : (0 as u32);
        if (v.lane(k) != want) {
          failures++;
        }
      }
      const out: u32[] = [];
      for (let k: usize = 0; k < len; k++) {
        out.push(1 as u32);
      }
      u32x4.splat(9 as u32).storePartial(out, at);
      for (let k: usize = 0; k < len; k++) {
        const want = k >= at && k < at + 4 ? (9 as u32) : (1 as u32);
        if (out[k] != want) {
          failures++;
        }
      }
    }
  }
  return failures;
}

