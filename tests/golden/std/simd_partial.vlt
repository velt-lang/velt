// `loadPartial` and `storePartial` against element-by-element loops: for every array length
// from 0 to two vectors and a half and every position from 0 to the length, each lane loaded
// and each element after a store. `at` equal to the length is valid (nothing is left);
// simd_partial_range covers the RangeError past it.
// check: no leaks

import { u8x16, i16x8, u32x4, i64x2, f32x4, f64x2 } from "velt/simd";

function checkU8x16(): number {
  let failures = 0;
  for (let len: usize = 0; len <= 40; len++) {
    const xs: u8[] = [];
    for (let k: usize = 0; k < len; k++) {
      xs.push(((k * 37 + 11) % 251) as u8);
    }
    for (let at: usize = 0; at <= len; at++) {
      const v = u8x16.loadPartial(xs, at);
      for (let k: usize = 0; k < 16; k++) {
        const want = at + k < len ? xs[at + k] : (0 as u8);
        if (v.lane(k) != want) {
          failures++;
        }
      }
      const out: u8[] = [];
      for (let k: usize = 0; k < len; k++) {
        out.push(1 as u8);
      }
      u8x16.splat(9 as u8).storePartial(out, at);
      for (let k: usize = 0; k < len; k++) {
        const want = k >= at && k < at + 16 ? (9 as u8) : (1 as u8);
        if (out[k] != want) {
          failures++;
        }
      }
    }
  }
  return failures;
}

function checkI16x8(): number {
  let failures = 0;
  for (let len: usize = 0; len <= 20; len++) {
    const xs: i16[] = [];
    for (let k: usize = 0; k < len; k++) {
      xs.push(((k * 37 + 11) % 251 - 100) as i16);
    }
    for (let at: usize = 0; at <= len; at++) {
      const v = i16x8.loadPartial(xs, at);
      for (let k: usize = 0; k < 8; k++) {
        const want = at + k < len ? xs[at + k] : (0 as i16);
        if (v.lane(k) != want) {
          failures++;
        }
      }
      const out: i16[] = [];
      for (let k: usize = 0; k < len; k++) {
        out.push(1 as i16);
      }
      i16x8.splat(9 as i16).storePartial(out, at);
      for (let k: usize = 0; k < len; k++) {
        const want = k >= at && k < at + 8 ? (9 as i16) : (1 as i16);
        if (out[k] != want) {
          failures++;
        }
      }
    }
  }
  return failures;
}

function checkU32x4(): number {
  let failures = 0;
