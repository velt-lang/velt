function main() {
  console.log("u8x16", checkU8x16());
  console.log("i16x8", checkI16x8());
  console.log("u32x4", checkU32x4());
  console.log("i64x2", checkI64x2());
  console.log("f32x4", checkF32x4());
  console.log("f64x2", checkF64x2());
}
