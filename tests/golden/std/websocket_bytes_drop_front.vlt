// ByteBuf.dropFront checks its count: dropping more bytes than there are (or a negative count)
// stops the program instead of making the length wrap around.
import { ByteBuf } from "velt/net/websocket/bytes";

function main() {
  const buf = new ByteBuf();
  buf.append([1u8, 2u8]);
  buf.dropFront(1);
  console.log(buf.data);
  buf.dropFront(5);
  console.log("not reached");
}
