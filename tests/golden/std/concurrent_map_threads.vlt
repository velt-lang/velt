// velt:collections/concurrent_map on worker threads: writers adding their own keys, a deleter
// removing a known set while they run, and readers checking that every key they find has its
// own value. At the end every key is where it should be.

import { ConcurrentMap } from "velt:collections/concurrent_map";

const N: u64 = 40000;

function mix(x: u64): u64 {
  let z = x + 0x9E3779B97F4A7C15;
  z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
  z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
  return z ^ (z >> 31);
}

async function writer(m: shared<ConcurrentMap>, t: u64) {
  for (let i = t; i < N; i += 3) {
    m.set(mix(i), i);
  }
}

async function deleter(m: shared<ConcurrentMap>): Promise<u64> {
  // Keys `N + i`, set before the threads start, deleted while the writers split leaves.
  let removed: u64 = 0;
  for (let i: u64 = 0; i < N; i += 2) {
    if (m.delete(mix(N + i))) removed++;
  }
  return removed;
}

async function reader(m: shared<ConcurrentMap>): Promise<u64> {
  let wrong: u64 = 0;
  for (let r = 0; r < 3; r++) {
    for (let i: u64 = 0; i < N; i++) {
      const v = m.get(mix(i));
      if (v != undefined && v != i) wrong++;
    }
  }
  return wrong;
}

async function main() {
  const m = ConcurrentMap.create((3 * N) as usize);
  for (let i: u64 = 0; i < N; i++) {
    m.set(mix(N + i), N + i);
  }
  const s = shared(m);
  const ws: Promise<void>[] = [];
  for (let t: u64 = 0; t < 3; t++) {
    ws.push(spawn(writer(s, t)));
  }
  const d = spawn(deleter(s));
  const rs: Promise<u64>[] = [spawn(reader(s)), spawn(reader(s))];
  await Promise.all(ws);
  const removed = await d;
  let wrong: u64 = 0;
  for (const w of await Promise.all(rs)) {
    wrong += w;
  }
  let missing: u64 = 0;
  for (let i: u64 = 0; i < N; i++) {
    if (s.get(mix(i)) != i) missing++;
    const kept = s.get(mix(N + i));
    if (i % 2 == 0 ? kept != undefined : kept != N + i) missing++;
  }
  console.log("removed", removed, "wrong", wrong, "missing", missing);
}
