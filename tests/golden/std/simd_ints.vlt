function lanesI16x8(what: string, got: i16x8, want: i16[]): i64 {
  for (let i: usize = 0; i < 8; i++) {
    if (got.lane(i) != want[i]) {
      console.log("FAIL", what, "lane", i, got.lane(i), want[i]);
    }
  }
  return 1;
}

