function lanesI64x2(what: string, got: i64x2, want: i64[]): i64 {
  for (let i: usize = 0; i < 2; i++) {
    if (got.lane(i) != want[i]) {
      console.log("FAIL", what, "lane", i, got.lane(i), want[i]);
    }
  }
  return 1;
}

