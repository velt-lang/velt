// Every integer SIMD operation against lanes computed outside the compiler (generated;
// the expected values are Python integer arithmetic). Prints the number of checks per
// type, and a line per lane that differs.

import {
  i8x16,
  u8x16,
  i16x8,
  u16x8,
  i32x4,
  u32x4,
  i64x2,
  u64x2,
  mask8x16,
  mask16x8,
  mask32x4,
  mask64x2,
} from "velt:simd";

function lanesI8x16(what: string, got: i8x16, want: i8[]): i64 {
  for (let i: usize = 0; i < 16; i++) {
    if (got.lane(i) != want[i]) {
      console.log("FAIL", what, "lane", i, got.lane(i), want[i]);
    }
  }
  return 1;
}

function testI8x16(): i64 {
  const a: i8[] = [0, 1, 127, -128, 126, 5, 100, -127, 3, 77, 63, -64, 9, 64, 2, 124];
  const b: i8[] = [1, 127, 1, -128, 2, 5, 27, 127, 4, 77, 3, 100, 0, 65, 126, 7];
