function bitmask(what: string, got: u64, want: u64): i64 {
  if (got != want) {
    console.log("FAIL", what, got, want);
  }
  return 1;
}

function count(what: string, got: usize, want: usize): i64 {
  if (got != want) {
    console.log("FAIL", what, got, want);
  }
  return 1;
}

function flag(what: string, got: bool, want: bool): i64 {
  if (got != want) {
    console.log("FAIL", what, got, want);
  }
  return 1;
}

function main() {
  console.log("i8x16", testI8x16(), "checks");
  console.log("u8x16", testU8x16(), "checks");
  console.log("i16x8", testI16x8(), "checks");
  console.log("u16x8", testU16x8(), "checks");
  console.log("i32x4", testI32x4(), "checks");
  console.log("u32x4", testU32x4(), "checks");
  console.log("i64x2", testI64x2(), "checks");
  console.log("u64x2", testU64x2(), "checks");
}
