  n += lanesU16x8("i16x8.asU16x8", va.asU16x8(), [0, 1, 32767, 32768, 32766, 5, 100, 32769]);
  return n;
}

function lanesU16x8(what: string, got: u16x8, want: u16[]): i64 {
