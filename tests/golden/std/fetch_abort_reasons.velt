// A `fetch` to a server that never answers rejects with its signal's reason, as in Node (#2991):
// a `DOMException` named `TimeoutError` for `AbortSignal.timeout`, `AbortError` for `abort()`,
// like `signal.reason` (the same object in Node: #3011). A custom reason:
// fetch_abort_custom_reason.velt (#3005).
// The server is velt/net's. The same requests in Node, to a `node:net` server that accepts and
// never answers, print the same lines.
import { channel } from "velt/sync";
import { listen, TcpStream } from "velt/net";

async function main() {
  const server = await listen("127.0.0.1:0");
  // Accepts the two requests and answers none, until `done`.
  const done = channel<bool>();
  const accepting = spawn(async () => {
    const held: TcpStream[] = [];
    for (let i = 0; i < 2; i++) {
      held.push(await server.accept());
    }
    await done.receive();
    for (const conn of held) {
      conn.close();
    }
  });
  const url = `http://127.0.0.1:${server.port}/`;

  const t = AbortSignal.timeout(50);
  try {
    await fetch(url, { signal: t });
    console.log("timeout: answered");
  } catch (e) {
    const x: any = e;
    console.log(
      "timeout:",
      x.name,
      x.message,
      x instanceof DOMException,
      x.code,
      x.name === t.reason.name,
    );
  }

  const c = new AbortController();
  setTimeout(() => c.abort(), 50);
  try {
    await fetch(url, { signal: c.signal });
    console.log("abort: answered");
  } catch (e) {
    const x: any = e;
    console.log(
      "abort:",
      x.name,
      x.message,
      x instanceof DOMException,
      x.code,
      x.name === c.signal.reason.name,
    );
  }

  await done.send(true);
  await accepting;
  server.close();
}

// timing: aborts by timers while the server holds the requests; one order
