// requires: unix
// Node's `readSync` and `writeSync` with typed arrays and `DataView`s: `offset` and `length`
// count bytes of the view, whatever its element type, and its errors are Node's (this program
// prints what `node` prints for it with `fs` from "node:fs").
import * as fs from "velt:fs/fd";
import { writeFileSync } from "velt:fs";

function attempt(f: () => string) {
  try {
    console.log(f());
  } catch (e) {
    console.log(e.name, e.message);
  }
}

function main() {
  const path = "velt_fs_fd_views_tmp.bin";
  writeFileSync(path, "hello world, byte views");
  const fd = fs.openSync(path, "r");
  const u = new Uint8Array(8);
  console.log(fs.readSync(fd, u, 2, 4, 0), u.join(","));
  const dv = new DataView(new ArrayBuffer(10), 2, 6);
  console.log(fs.readSync(fd, dv, 1, 3, 6), new Uint8Array(dv.buffer).join(","));
  const f64 = new Float64Array(2);
  console.log(fs.readSync(fd, f64, 0, 16, 0), new Uint8Array(f64.buffer).join(","));
  const sub = new Uint8Array(12).subarray(4, 9);
  console.log(fs.readSync(fd, sub), sub.join(","));
  attempt(() => `${fs.readSync(fd, new Uint8Array(0), 0, 1, 0)}`);
  attempt(() => `${fs.readSync(fd, new Float32Array(0), 0, 1, 0)}`);
  attempt(() => `${fs.readSync(fd, new DataView(new ArrayBuffer(0)), 0, 1, 0)}`);
  attempt(() => `${fs.readSync(fd, new Uint8Array(4), 3, 2, 0)}`);
  attempt(() => `${fs.readSync(fd, new Uint8Array(4), 5, 0, 0)}`);
  attempt(() => `${fs.readSync(fd, new DataView(new ArrayBuffer(4)), 0, 5, 0)}`);
  attempt(() => `${fs.readSync(fd, new Float32Array(2), 9, 1, 0)}`);
  fs.closeSync(fd);

  const w = fs.openSync(path, "w");
  console.log(fs.writeSync(w, new Uint8Array([65, 66, 67, 68]).subarray(1), 1, 2));
  console.log(fs.writeSync(w, new DataView(new Uint8Array([69, 70, 71]).buffer, 1), 0));
  console.log(fs.writeSync(w, new Uint16Array([0x4948]), 0, 2, 3));
  attempt(() => `${fs.writeSync(w, new Uint8Array(4), 5, 0)}`);
  attempt(() => `${fs.writeSync(w, new DataView(new ArrayBuffer(4)), 1, 4)}`);
  fs.closeSync(w);
  const all = fs.openSync(path, "r");
  const back = new Uint8Array(8);
  console.log(fs.readSync(all, back, 0, 8, 0), back.join(","));
  fs.closeSync(all);
  fs.unlinkSync(path);
}
