// Subclasses of `Response` and `Request` have `bytes()` and `arrayBuffer()` (an `extend` block
// of their base, std/fetch/typed.vlt), as in Node.
class MyRes extends Response {}
class Tagged extends MyRes {}
class MyReq extends Request {}

async function main() {
  const m = new MyRes("hello");
  console.log((await m.bytes()).length);
  console.log((await new Tagged("abc").arrayBuffer()).byteLength);
  console.log((await new MyReq("http://x/", { method: "POST", body: "hi" }).bytes()).length);
  console.log(await new MyRes("text").text());
}
