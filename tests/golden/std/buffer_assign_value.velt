// Expected output is Node's (v24): `node --experimental-strip-types` on a copy named .ts.
// #3453: an assignment to an element of a Buffer used as a value is the value assigned, before
// the store converts it: `(b[i] = v)` is `v`, and `(b[i] op= v)` is what `op` gives.
const b = Buffer.alloc(4);
const hex: any = "0x20";
const r = (b[0] = hex);
console.log(r, typeof r, b[0]);

const seven: any = "7";
b[1] = 0;
const s = (b[1] += seven);
console.log(s, typeof s, b[1]);
const one: any = "1";
const t = (b[2] -= one);
console.log(t, typeof t, b[2]);
const u = (b[3] |= seven);
const w = (b[3] *= one);
console.log(u, w, b[3]);

// Inside larger expressions, and from calls and elements of an `any[]`.
const vals: any[] = [true, "300", null];
const c = Buffer.alloc(3);
const out: any[] = [];
for (let i = 0; i < vals.length; i++) {
  out.push((c[i] = vals[i]));
}
console.log(out.join("|"), c.join(","));
const gives = (): any => "9";
console.log("v=" + (c[0] = gives()) + "," + (c[1] += gives()), c.join(","));

// `+=` reads the element before the right side runs.
const d = Buffer.alloc(1);
d[0] = 5;
const bump = (): any => {
  d[0] = 100;
  return "1";
};
const e = (d[0] += bump());
console.log(e, d[0]);

// The element stored is the one the target named, even when the right side gives the field or
// variable another Buffer first.
class Holder {
  buf: u8[] = Buffer.alloc(1);
  swap(): any {
    this.buf = Buffer.alloc(1);
    return "3";
  }
  run(): void {
    const old = this.buf;
    const r1 = (this.buf[0] = this.swap());
    const kept = this.buf;
    const r2 = (this.buf[0] += this.swap());
    console.log(r1, r2, old[0], kept[0], this.buf[0]);
  }
}
new Holder().run();

// Values that are numbers already: the element, as before.
const f = Buffer.alloc(2);
const n: u8 = 7;
console.log((f[0] = n), (f[1] += 3), (f[1] += n), f.join(","));

// As a statement too, the number `-` and `*` give wraps as the store converts it.
const g = Buffer.alloc(3);
const two: any = 2;
g[0] -= one;
g[1] -= two;
g[2] = 200;
g[2] *= two;
console.log(g.join(","));
