// velt/process's environment and working directory against Node: a variable set (with "=" and a
// non-ASCII letter in its value), read through `process.env` and `envAll()`, overwritten and
// removed; a variable set to "" (set, not undefined: Windows reports both as 0 chars); `chdir`
// there and back; and `chdir`'s error, whose message is Node's (`ENOENT: no such file or
// directory, chdir '<from>' -> '<to>'`). (Node: the same with `process.env.NAME = value`,
// `delete process.env.NAME`, `process.env` for `envAll()`, `process.cwd()` and `process.chdir()`.)
// Also: `execSync`'s child (this program again, with an argument) sees a variable `setEnv` set,
// and an `env` option's value of the same name replaces it.
import { args, argv, chdir, cwd, envAll, removeEnv, setEnv } from "velt/process";
import { execSync } from "velt/process/child";

function main() {
  if (args().length > 0) {
    console.log(process.env.VELT_ENV_INHERITED ?? "unset");
    return;
  }
  const self = argv()[0].clone();
  setEnv("VELT_ENV_INHERITED", "from setEnv");
  console.log(execSync(self, ["child"]).stdout.trim());
  const vars = new Map<string, string>();
  vars.set("VELT_ENV_INHERITED", "from the env option");
  console.log(execSync(self, ["child"], { env: vars }).stdout.trim());
  removeEnv("VELT_ENV_INHERITED");
  console.log(execSync(self, ["child"]).stdout.trim());

  setEnv("VELT_ENV_TEST", "värde=1");
  console.log(process.env.VELT_ENV_TEST);
  console.log(envAll()["VELT_ENV_TEST"]);
  setEnv("VELT_ENV_TEST", "second");
  console.log(process.env.VELT_ENV_TEST);
  removeEnv("VELT_ENV_TEST");
  console.log(process.env.VELT_ENV_TEST === undefined, envAll()["VELT_ENV_TEST"] === undefined);
  setEnv("VELT_ENV_EMPTY", "");
  console.log(process.env.VELT_ENV_EMPTY === "", envAll()["VELT_ENV_EMPTY"] === "");
  removeEnv("VELT_ENV_EMPTY");
  console.log(process.env.VELT_ENV_EMPTY === undefined);

  const start = cwd();
  chdir("..");
  console.log(cwd() !== start || start.length <= 3);
  chdir(start);
  console.log(cwd() === start);

  try {
    chdir("/velt-no-such-dir");
    console.log("no error");
  } catch (e) {
    const message = (e as Error).message;
    console.log((e as any).code);
    console.log(message.startsWith(`ENOENT: no such file or directory, chdir '${start}' -> `));
    console.log(message.endsWith(" -> '/velt-no-such-dir'"));
  }
  console.log(cwd() === start);
}
