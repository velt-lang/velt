// A closure capturing a WeakRef is sent on a channel.
import { channel } from "velt/sync";
class V { n: number; constructor(n: number) { this.n = n; } }
async function main() {
  const keep = new V(7);
  const r = new WeakRef(keep);
  const ch = channel<() => number>(4);
  await ch.send(() => { const x = r.deref(); return x === null ? -1 : x.n; });
  console.log(keep.n);
}
