// std/encoding: Base64 (standard + URL-safe), hex and UTF-8 round trips, edge cases and errors.

import {
  base64Encode,
  base64Decode,
  base64UrlEncode,
  base64UrlDecode,
  base64EncodeString,
  base64DecodeString,
  hexEncode,
  hexDecode,
  utf8Encode,
  utf8Decode,
  utf8DecodeLossy,
  utf8Valid,
} from "velt:encoding";

function rfcVectors() {
  const inputs = ["", "f", "fo", "foo", "foob", "fooba", "foobar"];
  for (const s of inputs) {
    const e = base64EncodeString(s);
    console.log(`"${s}" -> "${e}" -> "${base64DecodeString(e)}"`);
  }
}

function binary() {
  const all: u8[] = [];
  for (let i = 0; i < 256; i++) {
    all.push(i as u8);
  }
  const e = base64Encode(all);
  console.log(e.length, e.slice(0, 24), e.slice(-24));
  const back = base64Decode(e);
  let same = back.length == 256;
  for (let i: usize = 0; i < back.length; i++) {
    same = same && back[i] == all[i];
  }
  console.log("roundtrip 256:", same);
  const tricky: u8[] = [0xfb, 0xff, 0xbf, 0xfe];
  console.log(base64Encode(tricky), base64UrlEncode(tricky));
  console.log(base64UrlDecode("-_-_-g"), base64UrlDecode("-_-_-g=="));
  console.log(base64Decode("Zm9vYg"), base64Decode("Zm9vYmE="));
  console.log(hexEncode(all.slice(250, 256)), hexEncode([]));
}

function hex() {
  console.log(hexEncode(utf8Encode("Hi!")));
  console.log(hexDecode("DEADbeef00"), hexDecode(""));
}

function utf8() {
  const s = "héllo, wörld € 😀";
  const b = utf8Encode(s);
  console.log(b.length, utf8Valid(b), utf8Decode(b) == s);
  const cases: u8[][] = [
    [0x61, 0x80, 0x62],
    [0xc0, 0xaf],
    [0xe0, 0x80, 0x80],
    [0xed, 0xa0, 0x80],
    [0xf4, 0x90, 0x80, 0x80],
    [0xe2, 0x82],
    [0xf0, 0x9f, 0x98, 0x41],
    [0xff],
  ];
  for (const c of cases) {
    console.log(utf8Valid(c), hexEncode(utf8Encode(utf8DecodeLossy(c))));
  }
  const ok: u8[] = [0xf0, 0x9f, 0x98, 0x80, 0xef, 0xbf, 0xbf, 0xf4, 0x8f, 0xbf, 0xbf];
  console.log(utf8Valid(ok), utf8DecodeLossy(ok) == utf8Decode(ok));
}

function errors() {
  const bad64 = ["Zm9v!", "Z", "Zm9vY===", "Zm=9", "Zg=", "-_8"];
  for (const s of bad64) {
    try {
      console.log(base64Decode(s));
    } catch (e) {
      console.log(e.message);
    }
  }
  try {
    console.log(base64UrlDecode("ab+/"));
  } catch (e) {
    console.log(e.message);
  }
  const badHex = ["abc", "0g", "zz00"];
  for (const s of badHex) {
    try {
      console.log(hexDecode(s));
    } catch (e) {
      console.log(e.message);
    }
  }
  try {
    console.log(utf8Decode([0x68, 0x69, 0xc3]));
  } catch (e) {
    console.log(e.message);
  }
  try {
    console.log(base64DecodeString("/w=="));
  } catch (e) {
    console.log(e.message);
  }
}

function main() {
  rfcVectors();
  binary();
  hex();
  utf8();
  errors();
}
