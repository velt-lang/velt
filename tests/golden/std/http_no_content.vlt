// A 204 or 304 response has no body, so no body headers: no default `content-type` is added
// (Node and the Fetch API do the same), also when a handler passes on a fetched one. Other
// statuses keep them.
import { serve } from "velt:http";

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const url = new URL(req.url);
    if (url.pathname == "/none") {
      return new Response(null, { status: 204 });
    }
    if (url.pathname == "/cached") {
      return new Response(null, { status: 304, headers: { etag: "\"v1\"" } });
    }
    if (url.pathname == "/proxied") {
      return await fetch(`${url.origin}/none`);
    }
    return new Response("hello");
  });
  const base = `http://127.0.0.1:${server.port}`;
  for (const path of ["/none", "/cached", "/proxied", "/ok"]) {
    const r = await fetch(`${base}${path}`);
    const type = r.headers.get("content-type") ?? "none";
    const length = r.headers.get("content-length") ?? "none";
    const tag = r.headers.get("etag") ?? "-";
    console.log(path, r.status, type, length, tag, `[${await r.text()}]`);
  }
  server.close();
}
