// `Object` destructured at module level is the program's own.
interface Pair {
  get k(): number;
  set k(v: number);
}

const own = {
  Object: {
    defineProperty: (o: Pair, key: string, d: { get: () => number }): Pair => {
      console.log("own defineProperty", key, d.get());
      return o;
    },
  },
};
const { Object } = own;

let n = 1;
const o: Pair = {
  get k() {
    return n;
  },
  set k(v) {
    n = v;
  },
};
Object.defineProperty(o, "k", { get: () => 2 });
console.log(o.k);
