// `globalThis` asserted as a type that lists its keys, read and defined with a key held in a
// variable, as sigx's duplicate-copy guard does; and a property the program only defines.
interface Stamp {
  readonly version: string;
  warned?: boolean;
}
type StampKey = "__APP_A__" | "__APP_B__";
type StampHost = { [K in StampKey]?: Stamp };

function readStamp(key: StampKey): Stamp | undefined {
  return (globalThis as StampHost)[key];
}

function stamp(key: StampKey, version: string): void {
  const host = globalThis as StampHost;
  const prev = host[key];
  const warned = prev !== undefined && prev.version !== version;
  Object.defineProperty(host, key, {
    value: { version, warned },
    writable: true,
    configurable: true,
    enumerable: false,
  });
}

console.log(readStamp("__APP_A__"), readStamp("__APP_B__"));
stamp("__APP_A__", "1.0");
console.log(readStamp("__APP_A__"), readStamp("__APP_B__"));
stamp("__APP_A__", "2.0");
stamp("__APP_B__", "3.0");
console.log(readStamp("__APP_A__"), readStamp("__APP_B__")?.version);

type Flags = { __FLAG_X__?: number; __FLAG_Y__?: number };
function flag(k: "__FLAG_X__" | "__FLAG_Y__"): number {
  return (globalThis as Flags)[k] ?? -1;
}
(globalThis as Flags).__FLAG_Y__ = 7;
console.log(flag("__FLAG_X__"), flag("__FLAG_Y__"));

// Defined, never read: the call only evaluates its value.
let declared = false;
function declareLive(live = true): void {
  declared = live;
  Object.defineProperty(globalThis, "__LIVE_CLIENT__", {
    value: live,
    writable: true,
    configurable: true,
    enumerable: false,
  });
}
declareLive();
console.log(declared);

// Assigned with a variable key, also through a compound or logical assignment.
type Counters = { __HITS_A__?: number; __HITS_B__?: number };
function hit(k: keyof Counters): void {
  const g = globalThis as Counters;
  g[k] ??= 0;
  g[k] = (g[k] ?? 0) + 1;
}
hit("__HITS_A__");
hit("__HITS_A__");
hit("__HITS_B__");
const read = (k: keyof Counters): number => (global as Counters)[k] ?? -1;
console.log(read("__HITS_A__"), read("__HITS_B__"));
