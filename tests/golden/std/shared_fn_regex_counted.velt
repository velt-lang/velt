// A captured regex, shared within the function.
// `RegExp.clone()` runs on one object from every thread calling this function. Here `RegExp` is a
// counted class, so `clone()` must not update its count: a lost update frees it early or never.
type F = (x: i64) => i64;

function mk(): F {
  const h = /a+/;
  return (x: i64): i64 => {
    const q = h;
    return q.test("aa") ? 1 : 0;
  };
}

async function work(f: shared<F>, rounds: i64): Promise<i64> {
  let t: i64 = 0;
  for (let i: i64 = 0; i < rounds; i++) {
    t += f(i);
  }
  return t;
}

async function main() {
  const f = shared(mk());
  const ts: Promise<i64>[] = [];
  for (let t = 0; t < 8; t++) {
    ts.push(spawn(work(f.clone(), 5000)));
  }
  let all: i64 = 0;
  for (const t of ts) {
    all += await t;
  }
  console.log(all);
}
// check: no leaks
