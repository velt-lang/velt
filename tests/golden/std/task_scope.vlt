// check: no leaks
// velt:task taskScope: the scope settles only after its body and every child it spawned (so
// children never outlive it); a failing child aborts the scope's signal, the siblings stop
// cooperatively, and the scope fails with the first error in time, even one nobody awaited.
import { channel, Channel } from "velt:channel";
import { AbortSignal, AbortError, TaskScope, taskScope } from "velt:task";

class Failed extends Error {}

// What the scopes below can fail with: a child's own error, or a sibling's `AbortError`.
type ScopeError = Failed | AbortError;

async function step(name: string, ms: i64, signal: AbortSignal): Promise<string> throws AbortError {
  for (let i = 0; i < ms / 10; i++) {
    signal.throwIfAborted();
    await sleep(10);
  }
  console.log(name, "finished");
  return name;
}

// Like `step`, but it starts once `before` receives a value (when given) and reports its line on
// `lines`, for `main` to print, then on `after` (when given). A line printed by one task can
// appear after a line another task prints later (#249); this way the children's lines come in a
// fixed order however their tasks run.
async function stepInOrder(
  name: string,
  ms: i64,
  signal: AbortSignal,
  before: Channel<bool> | null,
  after: Channel<bool> | null,
  lines: Channel<string>,
): Promise<string> throws AbortError {
  if (before != null) {
    await before.receive();
  }
  for (let i = 0; i < ms / 10; i++) {
    signal.throwIfAborted();
    await sleep(10);
  }
  try {
    await lines.send(`${name} finished`);
    if (after != null) {
      await after.send(true);
    }
  } catch (e) {
    console.log("send failed");
  }
  return name;
}

async function failing(ms: i64): Promise<string> throws Failed {
  await sleep(ms);
  throw new Failed("child failed");
}

async function main() {
  const lines = channel<string>();
  const aDone = channel<bool>();
  const names = await taskScope(async (
    scope: TaskScope<AbortError>,
  ): Promise<string> throws AbortError => {
    const a = scope.spawn(stepInOrder("a", 30, scope.signal, null, aDone, lines));
    const b = scope.spawn(stepInOrder("b", 150, scope.signal, aDone, null, lines));
    return "body done";
  });
  // Both children finished before the scope settled.
  for (let i = 0; i < 2; i++) {
    console.log(await lines.receive());
  }
  lines.close();
  aDone.close();
  console.log("scope 1:", names);

  try {
    await taskScope(async (scope: TaskScope<ScopeError>): Promise<string> throws ScopeError => {
      const signal = scope.signal;
      // A minute: a hang guard, `slow` only finishes if the abort never reaches it.
      const slow = scope.spawn(step("slow", 60000, signal));
      await scope.spawn(failing(20));
      return "unreachable";
    });
  } catch (e) {
    // `slow` stopped early: it would print `slow finished` otherwise.
    console.log("scope 2 failed:", e.message);
  }

  // The first error in time wins over the `AbortError`s it causes in the siblings, whatever
  // the order the body awaits them in.
  try {
    await taskScope(async (scope: TaskScope<ScopeError>): Promise<string[]> throws ScopeError => {
      const signal = scope.signal;
      return await Promise.all([
        scope.spawn(step("c", 60000, signal)),
        scope.spawn(failing(20)),
      ]);
    });
  } catch (e) {
    console.log("scope 3 failed:", e.message);
  }

  // A child nobody awaits still fails the scope.
  try {
    await taskScope(async (scope: TaskScope<Failed>): Promise<i64> throws Failed => {
      const unawaited = scope.spawn(failing(5));
      return 1;
    });
  } catch (e) {
    console.log("scope 4 failed:", e.message);
  }

  // Children that cannot fail need no error type of their own; options turn off the
  // cancellation.
  const n = await taskScope(
    async (scope: TaskScope<Failed>): Promise<string> throws Failed => {
      const signal = scope.signal;
      const d = scope.spawn(quiet("d"));
      return await d;
    },
    { cancelOnError: false },
  );
  console.log("scope 5:", n);
}

async function quiet(name: string): Promise<string> {
  await sleep(5);
  return name;
}
