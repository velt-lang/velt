// A parsed value writes its 16-17 digit doubles with the runtime's printer straight into the
// tape writer's byte buffer: the text equals what Node prints, also across the buffer's 8 KB chunks.
const v = JSON.parseValue(
  "[0.1,1.7976931348623157e308,5e-324,-2.2250738585072014e-308,123456789012345678,0.30000000000000004,1e21,1.5e-7,-0.0]",
);
console.log(v.stringify());
const xs: f64[] = [];
for (let i = 1; i < 3000; i++) {
  xs.push(i / 3 * (i % 7 == 0 ? 1e-300 : 1));
}
const typed = JSON.stringify(xs);
const back = JSON.parseValue(typed).stringify();
console.log(back == typed, back.length);
