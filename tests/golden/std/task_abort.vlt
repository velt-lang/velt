// velt:task: an AbortController stops cooperative work (checked with `throwIfAborted()`, or
// raced with `whenAborted()`), also in a spawned task sharing the signal; `AbortSignal.timeout`
// and `AbortSignal.any` (which keeps its sources alive); `throwIfAborted()` throws
// `TimeoutError` for a timeout; `timeout(p, ms)` rejects with `TimeoutError` while `p` keeps
// running.
import { AbortController, AbortSignal, AbortError, TimeoutError, timeout } from "velt:task";

async function work(
  name: string,
  steps: i64,
  signal: AbortSignal,
): Promise<string> throws AbortError {
  for (let i = 0; i < steps; i++) {
    signal.throwIfAborted();
    await sleep(10);
  }
  return `${name} done`;
}

async function stopped(signal: AbortSignal): Promise<string> {
  await signal.whenAborted();
  return `stopped: ${signal.reason}`;
}

async function slow(ms: i64): Promise<string> {
  await sleep(ms);
  console.log("slow", ms, "finished");
  return `slow ${ms}`;
}

async function main() {
  const ac = new AbortController();
  const job = work("job", 100, ac.signal);
  await sleep(35);
  ac.abort("user cancelled");
  try {
    console.log(await job);
  } catch (e) {
    console.log("aborted:", e.message);
  }

  const shutdown = new AbortController();
  const worker = spawn(stopped(shutdown.signal));
  await sleep(10);
  shutdown.abort();
  console.log(await worker);

  const t = AbortSignal.timeout(20);
  console.log("before:", t.aborted, t.reason == "");
  await t.whenAborted();
  console.log("after:", t.aborted, t.reason);

  const a = new AbortController();
  const both = AbortSignal.any([a.signal, AbortSignal.timeout(1000)]);
  a.abort("first");
  a.abort("ignored");
  console.log("any:", both.aborted, both.reason);

  // Only the derived signal holds this timeout signal, and it still fires through it.
  const later = AbortSignal.any([new AbortController().signal, AbortSignal.timeout(20)]);
  await sleep(300);
  console.log("any of a timeout:", later.aborted, later.reason);
  try {
    later.throwIfAborted();
  } catch (e) {
    console.log("throwIfAborted:", e.message);
  }

  console.log(await timeout(slow(10), 100));
  try {
    console.log(await timeout(slow(200), 30));
  } catch (e) {
    console.log("timeout:", e.message, e.ms);
  }
  await sleep(600);
  console.log("done");
}
