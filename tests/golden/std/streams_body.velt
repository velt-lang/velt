// check: no leaks
// The shapes of sigx's server renderer as in Node: a ReadableStream of Uint8Array chunks made
// by pulling (`chunksToBytes`), one of strings (`renderStream`), read and decoded; and a
// response's body read as a ReadableStream.
function chunksToBytes(parts: string[]): ReadableStream<Uint8Array> {
  const encoder = new TextEncoder();
  let i = 0;
  return new ReadableStream<Uint8Array>({
    pull(controller) {
      if (i == parts.length) {
        controller.close();
      } else {
        controller.enqueue(encoder.encode(parts[i]));
        i++;
      }
    },
    cancel() {
      console.log("cancelled");
    },
  });
}

function renderStream(parts: string[]): ReadableStream<string> {
  return new ReadableStream<string>({
    start(controller) {
      for (const p of parts) {
        controller.enqueue(p);
      }
      controller.close();
    },
  });
}

async function readAll(s: ReadableStream<Uint8Array>): Promise<Uint8Array> {
  const reader = s.getReader();
  const chunks: Uint8Array[] = [];
  let total = 0;
  for (;;) {
    const r = await reader.read();
    if (r.done) {
      break;
    }
    total += r.value.byteLength;
    chunks.push(r.value);
  }
  const merged = new Uint8Array(total);
  let offset = 0;
  for (const c of chunks) {
    merged.set(c, offset);
    offset += c.byteLength;
  }
  return merged;
}

async function main() {
  const page = await readAll(chunksToBytes(["<html>", "<body>héllo</body>", "</html>"]));
  console.log(new TextDecoder().decode(page), page.length);
  let n = 0;
  for await (const chunk of chunksToBytes(["ab", "c"])) {
    n += chunk.length;
  }
  console.log(n);
  const early = chunksToBytes(["x", "y"]);
  for await (const chunk of early) {
    console.log(chunk);
    break;
  }
  // A string stream, encoded chunk by chunk.
  const encoder = new TextEncoder();
  const out: string[] = [];
  const reader = renderStream(["<p>", "x", "</p>"]).getReader();
  for (;;) {
    const r = await reader.read();
    if (r.done) {
      break;
    }
    out.push(new TextDecoder().decode(encoder.encode(r.value)));
  }
  console.log(out.join(""));
  // A response's body is a ReadableStream of Uint8Array chunks.
  const res = new Response("héllo, body");
  const body = res.body;
  if (body != null) {
    console.log(body.locked, new TextDecoder().decode(await readAll(body)), res.bodyUsed);
  }
}
