// check: no leaks
// Defining a brand again, as Node allows and refuses it (#922).
const K: unique symbol = Symbol("k");
const C: unique symbol = Symbol("c");
const N: unique symbol = Symbol("n");
const Z: unique symbol = Symbol("z");
interface Box {
  n: number;
  [K]?: string;
  [C]?: number;
  [N]?: number;
  [Z]?: number;
}
const b: Box = { n: 1 };
Object.defineProperty(b, K, { value: "a" });
Object.defineProperty(b, K, { value: "a" });
console.log("same value again:", b[K]);
try {
  Object.defineProperty(b, K, { value: "b" });
  console.log("redefined");
} catch (e) {
  console.log(e instanceof TypeError, (e as Error).message);
}
console.log(b[K]);
const box2: Box = { n: 2 };
Object.defineProperty(box2, C, { value: 1, configurable: true });
Object.defineProperty(box2, C, { value: 2, configurable: true });
console.log(C in box2, box2[C], box2);
Object.defineProperty(box2, K, { value: "b" });
console.log(box2[K]);
// SameValue: NaN is itself, -0 is not 0.
const box3: Box = { n: 3 };
Object.defineProperty(box3, N, { value: NaN });
Object.defineProperty(box3, N, { value: NaN });
console.log("NaN again:", box3[N]);
Object.defineProperty(box3, Z, { value: 0 });
try {
  Object.defineProperty(box3, Z, { value: -0 });
  console.log("redefined");
} catch (e) {
  console.log(e instanceof TypeError, (e as Error).message);
}
