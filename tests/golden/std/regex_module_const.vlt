// check: no leaks
// A module-level regex constant read inside functions: built once, when the module is
// evaluated, and the same object everywhere, so a `g` regex's `lastIndex` carries over from
// call to call as in Node. The shapes come from a server renderer: an escape test for every
// text node, a comment stripper and a user-agent check.
import { parseStringStyle } from "./_regex_module_const_lib";

const escapeRE = /[&<>"']/;

function escapeHtml(s: string): string {
  const match = escapeRE.exec(s);
  if (!match) return s;
  let html = "";
  let lastIndex = 0;
  let escaped: string;
  for (let i = match.index; i < s.length; i++) {
    switch (s.charCodeAt(i)) {
      case 38: escaped = "&amp;"; break;
      case 60: escaped = "&lt;"; break;
      case 62: escaped = "&gt;"; break;
      case 34: escaped = "&quot;"; break;
      case 39: escaped = "&#39;"; break;
      default: continue;
    }
    if (lastIndex !== i) html += s.slice(lastIndex, i);
    html += escaped;
    lastIndex = i + 1;
  }
  return lastIndex === s.length ? html : html + s.slice(lastIndex);
}

const BOT_UA = /bot|crawl|spider|slurp|bingpreview|facebookexternalhit/i;

function isBot(userAgent: string): boolean {
  return BOT_UA.test(userAgent);
}

const WORD = /o/g;

function nextWord(s: string): number {
  return WORD.test(s) ? WORD.lastIndex : -1;
}

function sameRegex(): boolean {
  return WORD === WORD && WORD.source === "o" && WORD.flags === "g";
}

let current = /x/;

function swap(): void {
  current = /y/;
}

console.log(escapeHtml("plain"), escapeHtml(`a <b> & "c" 'd'`));
console.log(isBot("Googlebot/2.1"), isBot("Mozilla/5.0 Firefox"), isBot("BingPreview"));
console.log(nextWord("foo"), nextWord("foo"), nextWord("foo"), nextWord("foo"));
WORD.lastIndex = 2;
console.log(nextWord("foo"), WORD.lastIndex, sameRegex());
console.log(JSON.stringify(parseStringStyle("color: red; /* note */ background: url(a;b)")));
console.log(current.test("x"), current.test("y"));
swap();
console.log(current.test("x"), current.test("y"));
