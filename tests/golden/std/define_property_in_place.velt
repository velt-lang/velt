// check: no leaks
// Object.defineProperty writes the object itself and returns it, as in Node (#922).
import { CELL, makeCell, type Cell } from "./_define_property_cell";
const K: unique symbol = Symbol("k");
const W: unique symbol = Symbol("w");
interface A {
  a: number;
  [K]?: boolean;
}
interface B {
  a: number;
}
interface C {
  a: number;
}
interface P {
  value: number;
  on: boolean;
}
interface Named {
  name: string;
}
// A top-level local with the field declared, and one with the field added.
const z: A = { a: 1 };
Object.defineProperty(z, K, { value: true });
console.log(K in z, z[K], z);
const y: B = { a: 2 };
Object.defineProperty(y, K, { value: true });
console.log(K in y, y, { ...y });
// A string key assigns the field.
const p: P = { value: 1, on: false };
Object.defineProperty(p, "value", { value: 9 });
console.log(p.value, p);
// A local in a function, and the result is the object itself.
function local(): void {
  const c: B = { a: 3 };
  const r = Object.defineProperty(c, K, { value: true });
  console.log(K in c, K in r, r === c);
  const r2 = Object.defineProperty(c, "a", { value: 4 });
  console.log(r2 === c, c.a, r.a);
}
local();
// A brand made in another module, read here.
const made = makeCell(1);
const plain: Cell = { n: 2 };
console.log(CELL in made, CELL in plain, made);
// Each element of an array, through the loop variable.
const items: B[] = [{ a: 1 }, { a: 2 }];
for (const it of items) Object.defineProperty(it, K, { value: true });
console.log(items.map((i) => K in i), items);
// An element and a field path.
const grid: B[][] = [[{ a: 5 }]];
Object.defineProperty(grid[0][0], K, { value: true });
const holder: { inner: B } = { inner: { a: 6 } };
Object.defineProperty(holder.inner, K, { value: true });
console.log(K in grid[0][0], K in holder.inner);
// An object held by reference (it has a string).
const named: Named = { name: "x" };
Object.defineProperty(named, K, { value: true });
console.log(K in named, named);
// Every attribute: enumerable, so it prints.
const w: C = { a: 5 };
Object.defineProperty(w, W, { value: true, writable: true, enumerable: true, configurable: true });
console.log(W in w, w);
