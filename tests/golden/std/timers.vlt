// std/timers: setTimeout ordering and cancellation, tasks owning values from frames that have
// returned, setImmediate, clearTimeout, and Ticker (fixed count, stop, stop from another task,
// missed ticks are skipped rather than burst). Gaps between ordered events are >= 100 ms.

import {
  setTimeout,
  setImmediate,
  clearTimeout,
  delay,
  Ticker,
  TickerStop,
  Timer,
} from "velt:timers";

async function say(msg: string): Promise<void> {
  console.log(msg);
}

class Doc {
  title: string;
  lines: string[];

  constructor(title: string, lines: string[]) {
    this.title = title;
    this.lines = lines;
  }
}

async function save(doc: Doc): Promise<void> {
  console.log(`saved ${doc.title} (${doc.lines.length} lines)`);
}

// The callbacks own heap values created here; they run after this frame has returned.
function scheduleFromFrame(): Timer {
  const doc = new Doc(`draft ${1 + 1}`, ["a", "b", "c"]);
  setTimeout(() => save(doc), 250);
  const name = `closure ${7 * 6}`;
  setTimeout(
    async () => {
      console.log(`${name} ran`);
    },
    150,
  );
  return setTimeout(() => say("cancelled task ran (bug)"), 200);
}

async function timeouts() {
  const cancelled = scheduleFromFrame();
  setTimeout(() => say("third (350 ms)"), 350);
  setTimeout(() => say("first (50 ms)"), 50);
  const late = setTimeout(() => say("cleared with clearTimeout (bug)"), 100);
  clearTimeout(late);
  cancelled.clear();
  console.log("cleared:", cancelled.cleared, late.cleared, "started:", cancelled.started);
  setImmediate(() => say("immediate"));
  await delay(500);
  const done = setTimeout(() => say("ran before clear"), 0);
  await delay(100);
  done.clear();
  console.log("clear after start:", done.cleared, done.started);
}

async function stopAfter(s: TickerStop, ms: i64): Promise<void> {
  await sleep(ms);
  s.stop();
  console.log("stopper fired");
}

async function tickers() {
  const t = new Ticker(20);
  let n = 0;
  while (await t.tick()) {
    n++;
    if (n == 3) {
      t.stop();
    }
  }
  console.log("ticks before stop:", n, "after stop:", await t.tick());

  const slow = new Ticker(300);
  spawn(stopAfter(slow.stopper(), 100));
  console.log("stopped from another task:", await slow.tick());

  // Period 100 ms; the body stalls 250 ms after the first tick. The late tick resolves at once
  // and the next waits for the next schedule point (400 ms) instead of bursting.
  const skip = new Ticker(100);
  await skip.tick();
  await delay(250);
  const a = performance.now();
  await skip.tick();
  const b = performance.now();
  await skip.tick();
  const c = performance.now();
  console.log("late tick immediate:", b - a < 40.0, "next tick waits:", c - b > 15.0);
}

async function main() {
  await timeouts();
  await tickers();
}
