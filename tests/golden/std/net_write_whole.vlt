// Writes to one stream from tasks on several workers at once: each write's bytes go out
// together, never with another write's bytes between its parts (a large write that the socket
// cannot take at once goes on later, in its turn).
import { connect, listen } from "velt/net";

const WRITERS = 8;
const SIZE = 1048576;

async function main() {
  const server = await listen("127.0.0.1:0");
  const accepted = spawn(async () => await server.accept());
  const out = await connect(`127.0.0.1:${server.port}`);
  const input = await accepted;

  const writes: Promise<void>[] = [];
  for (let w = 0; w < WRITERS; w++) {
    writes.push(
      spawn(async () => {
        const data: u8[] = Buffer.alloc(SIZE);
        data.fill((w + 1) as u8);
        try {
          await out.writeBytes(data);
        } catch (e) {
          console.log("write failed:", e.message);
        }
      }),
    );
  }

  // Runs of one byte value: each is one whole write.
  let total = 0;
  let runs = 0;
  let last = 0;
  let whole = true;
  let run = 0;
  while (total < WRITERS * SIZE) {
    const chunk = await input.read();
    for (const b of chunk) {
      const v = b as number;
      if (v != last) {
        if (last != 0 && run != SIZE) {
          whole = false;
        }
        runs++;
        run = 0;
        last = v;
      }
      run++;
    }
    total += chunk.length;
  }
  await Promise.all(writes);
  console.log("bytes:", total, "runs:", runs, "every write whole:", whole && run == SIZE);
  out.close();
  input.close();
  server.close();
}
