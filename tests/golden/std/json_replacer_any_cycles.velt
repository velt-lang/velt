// `JSON.stringify(value, replacer)` with a replacer declared with `any` whose result holds a
// cycle: as in Node, the walk goes through that result itself, calling the replacer for each
// key, and a value met again inside itself is a catchable `TypeError` only when the replacer
// keeps it; one it leaves out or replaces is no cycle (#3871). Shapes: a class instance that
// holds itself, an array that holds itself, the holder being walked, a cycle in a result the
// replacer returns for a member, results that are new cycles at every level (the depth limit),
// and the next calls after the errors. The Node twin is json_replacer_any_cycles.mjs.

class C {
  a = 1;
  self: C | null = null;
}

class Tree {
  name: string;
  kids: Tree[] = [];
  constructor(name: string) {
    this.name = name;
  }
}

const c = new C();
c.self = c;
const arr: any[] = [1];
arr.push(arr);
const root = new Tree("root");
root.kids.push(new Tree("kid"));

function attempt(what: string, f: () => string): void {
  try {
    console.log(what, f());
  } catch (e) {
    const kind =
      e instanceof TypeError ? "TypeError" : e instanceof RangeError ? "RangeError" : "other";
    console.log(what, kind);
  }
}

function dropSelf(k: string, v: any): any {
  if (k === "") {
    return { a: c };
  }
  if (k === "self") {
    return undefined;
  }
  return v;
}

function keepSelf(k: string, v: any): any {
  if (k === "") {
    return { a: c };
  }
  return v;
}

function logged(k: string, v: any): any {
  console.log(`  replacer ${JSON.stringify(k)}`);
  if (k === "") {
    return { a: c, b: 2 };
  }
  if (k === "self") {
    return "cut";
  }
  return v;
}

function arrayDropped(k: string, v: any): any {
  if (k === "") {
    return { list: arr };
  }
  if (k === "1") {
    return undefined;
  }
  return v;
}

function arrayKept(k: string, v: any): any {
  if (k === "") {
    return { list: arr };
  }
  return v;
}

// The array being walked (its elements), returned again inside an element's result.
function upKept(k: string, v: any): any {
  if (k === "0") {
    return { up: root.kids };
  }
  return v;
}

function upDropped(k: string, v: any): any {
  if (k === "0") {
    return { up: root.kids };
  }
  if (k === "up") {
    return 0;
  }
  return v;
}

// A member's result that holds a cycle, itself inside a result with one.
function nested(k: string, v: any): any {
  if (k === "") {
    return [c, 3];
  }
  if (k === "a") {
    return [arr, 4];
  }
  if (k === "self" || k === "1") {
    return undefined;
  }
  return v;
}

// A new cycle at every level: Node's stack overflow `RangeError`.
function endless(k: string, v: any): any {
  const o = new C();
  o.self = o;
  if (k === "self") {
    return { a: 2, next: o };
  }
  return v;
}

function main(): void {
  attempt("dropped:", () => JSON.stringify({ x: 1 }, dropSelf));
  attempt("kept:", () => JSON.stringify({ x: 1 }, keepSelf));
  attempt("logged:", () => JSON.stringify({ x: 1 }, logged));
  attempt("array dropped:", () => JSON.stringify({ x: 1 }, arrayDropped));
  attempt("array kept:", () => JSON.stringify({ x: 1 }, arrayKept));
  attempt("holder kept:", () => JSON.stringify(root, upKept));
  attempt("holder replaced:", () => JSON.stringify(root, upDropped));
  attempt("nested:", () => JSON.stringify({ x: 1 }, nested));
  attempt("endless:", () => JSON.stringify(c, endless));
  attempt("after:", () => JSON.stringify({ x: 1 }, dropSelf));
  attempt("plain after:", () => JSON.stringify(root));
}

main();
