// check: no leaks
// A streamed response (a `BodyStream` made from an async generator): the generator is read
// after the handler returned, with awaited sleeps between chunks; the client gets the headers
// that were set before returning, no content-length (chunked transfer), and every chunk in
// order. A generator that throws cuts the response off, so the client sees a failed body, not a
// complete one.
import { utf8Encode } from "velt:encoding";
import { BodyStream } from "velt:fetch";
import { serve } from "velt:http";

class RenderError extends Error {}

// The list, one chunk per item; each item's line is printed once it was sent (the next chunk is
// asked for once the client took the previous one).
async function* list(count: i64, broken: bool): AsyncGenerator<u8[], RenderError> {
  yield utf8Encode("<ul>");
  for (let i: i64 = 1; i <= count; i++) {
    yield utf8Encode(`<li>${i}</li>`);
    console.log(`server: sent ${i}`);
    // The task publishes its output when it suspends here, before the next chunk (or the end of
    // the body) goes out, so the client's lines come after every `server:` line.
    await sleep(20);
  }
  if (broken) {
    throw new RenderError("template failed");
  }
  yield utf8Encode("</ul>");
}

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const url = new URL(req.url);
    const count = parseInt(url.search.slice(1)) as i64;
    const res = new Response(BodyStream.from(list(count, url.pathname == "/broken")));
    res.headers.set("content-type", "text/html; charset=utf-8");
    res.headers.append("x-stream", "yes");
    console.log("server: response returned");
    return res;
  });
  const base = `http://127.0.0.1:${server.port}`;
  const res = await fetch(`${base}/list?3`);
  // `fetch` resolves with the headers, before the body is complete: read the body first, so
  // the server's lines come before the client's.
  const body = await res.text();
  console.log(res.status);
  console.log(res.headers.get("content-type"));
  console.log(res.headers.get("x-stream"));
  console.log(res.headers.get("content-length") ?? "no content-length");
  console.log(res.headers.get("transfer-encoding"));
  console.log(body);
  try {
    const broken = await fetch(`${base}/broken?1`);
    console.log("unexpected:", await broken.text());
  } catch (e) {
    console.log("broken stream: cut off");
  }
  await server.shutdown();
}
