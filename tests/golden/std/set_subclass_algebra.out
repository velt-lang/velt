-- bigger
union: [1,2,3,4,5] false | b.size b.keys
intersection: [2,3] false | b.size b.has(1) b.has(2) b.has(3)
difference: [1] false | b.size b.has(1) b.has(2) b.has(3)
symmetricDifference: [1,4,5] false | b.size b.keys
isSubsetOf: false | b.size b.has(1)
isSupersetOf: false | b.size
isDisjointFrom: false | b.size b.has(1) b.has(2)
-- smaller
union: [1,2,3] false | c.size c.keys
intersection: [2] false | c.size c.keys
difference: [1,3] false | c.size c.keys
symmetricDifference: [1,3] false | c.size c.keys
isSubsetOf: false | c.size
isSupersetOf: true | c.size c.keys
isDisjointFrom: false | c.size c.keys
-- early
union: [1,2,3,5,6,7] false | d.size d.keys
intersection: [1] false | d.size d.has(1) d.has(2) d.has(3)
difference: [2,3] false | d.size d.has(1) d.has(2) d.has(3)
symmetricDifference: [2,3,5,6,7] false | d.size d.keys
isSubsetOf: false | d.size d.has(1) d.has(2)
isSupersetOf: false | d.size
isDisjointFrom: false | d.size d.has(1)
for-of 1,2,3: false | 
spread 1,2,3: false | 
3,1 3:3 1:1
