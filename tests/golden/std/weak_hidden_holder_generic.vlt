// A generic class instantiated with a WeakRef, behind an interface, passed to spawn.
class V {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}

interface Peek {
  peek(): number;
}

class Holder<T> implements Peek {
  x: T;
  constructor(x: T) {
    this.x = x;
  }
  peek(): number {
    return 1;
  }
}

async function run(p: Peek): Promise<number> {
  return p.peek();
}

async function main() {
  const keep = new V(7);
  const p: Peek = new Holder<WeakRef<V>>(new WeakRef(keep));
  console.log(await spawn(run(p)), keep.n);
}
