// check: no leaks
// velt:http/server's time limits: a head not complete by `headersTimeout` (counted from its
// first byte, however the rest trickles in), or a body that does not arrive by `requestTimeout`,
// gets 408 and the connection closes, while the idle timeout (longer here) would have waited.
import { connect } from "velt:net";
import { HttpRequest, HttpResponse, serve } from "velt:http/server";

async function exchange(port: number, raw: string): Promise<string> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.write(raw);
  let all = "";
  while (true) {
    const chunk = await c.readString();
    if (chunk == "") {
      break;
    }
    all += chunk;
  }
  c.close();
  return (all.match(/HTTP\/1\.1 \d\d\d [A-Za-z ]+/g) ?? []).join(" | ");
}

async function main() {
  const server = await serve(
    { port: 0, idleTimeout: 30000, headersTimeout: 200, requestTimeout: 200 },
    async (req: HttpRequest, res: HttpResponse) => {
      const body = await req.bodyText();
      res.send(`got ${body.length}`);
    },
  );
  const port = server.port;
  // A complete request is answered; then a head that never ends.
  console.log(
    await exchange(port, "GET / HTTP/1.1\r\nHost: x\r\n\r\nGET / HTTP/1.1\r\nHost: x\r\n"),
  );
  // A body of 10 bytes of which 2 arrive.
  console.log(await exchange(port, "POST / HTTP/1.1\r\nHost: x\r\nContent-Length: 10\r\n\r\nab"));
  server.close();
}
