// A subclass of Date that overrides the methods Date's texts are made of (#3624): `toString()`
// and `toLocaleString()` format the date themselves, as Node; `toJSON()` (and JSON.stringify) go
// through `toISOString()`, and a string conversion through `toString()`, as JS calls them. The
// local-time texts are compared with a plain Date's, so the output holds in any time zone.
// The Node twin is date_subclass_text.mjs.
const T = 1705311000000;
const plain = new Date(T);

class DateText extends Date {
  override toDateString(): string {
    return "DATE";
  }
  override toTimeString(): string {
    return "TIME";
  }
}

class LocaleText extends Date {
  override toLocaleDateString(): string {
    return "LDATE";
  }
  override toLocaleTimeString(): string {
    return "LTIME";
  }
}

class Iso extends Date {
  override toISOString(): string {
    return "ISO";
  }
}

class Text extends Date {
  override toString(): string {
    return "TEXT";
  }
}

class Value extends Date {
  override valueOf(): number {
    return 42;
  }
  override getTime(): number {
    return 43;
  }
}

class Json extends Date {
  override toJSON(): string | null {
    return "JSON";
  }
}

class Utc extends Date {
  override toUTCString(): string {
    return "UTC";
  }
}

const a = new DateText(T);
console.log("toString", a.toString() == plain.toString(), a.toString().includes("DATE"));
console.log("toDateString", a.toDateString(), a.toTimeString());
console.log("template", `${a}` == `${plain}`, String(a) == String(plain), a + "" == plain + "");
const bad = new DateText(NaN);
console.log("invalid", bad.toString(), bad.toDateString());
const b = new LocaleText(T);
console.log(
  "toLocaleString",
  b.toLocaleString() == plain.toLocaleString(),
  b.toLocaleString().includes("LDATE"),
);
console.log("toLocaleDateString", b.toLocaleDateString(), b.toLocaleTimeString());
const c = new Iso(T);
console.log("toJSON", c.toJSON(), new Iso(NaN).toJSON());
console.log("JSON.stringify", JSON.stringify(c), JSON.stringify([c]), JSON.stringify({ c: c }));
const d = new Text(T);
console.log("toString override", `${d}`, String(d), d + "", `${[d]}`);
const e = new Value(T);
console.log(
  "valueOf override",
  e.toString() == plain.toString(),
  e.toISOString(),
  e.toUTCString(),
  e.toJSON(),
);
const f = new Json(T);
console.log("toJSON override", JSON.stringify(f), JSON.stringify({ f: f }));
const g = new Utc(T);
console.log(
  "toUTCString override",
  g.toUTCString(),
  g.toString() == plain.toString(),
  g.toISOString(),
);
