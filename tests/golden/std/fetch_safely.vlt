// check: no leaks
// The "fetch safely" pattern (#137): check the status, decode into a type (no schema step:
// `json<T>()` checks the data), time out with a signal, and catch every failure by type.
import { serve } from "velt:http";
import { IoError } from "velt:io";
import { AbortError, TimeoutError } from "velt:task";

type User = { id: number; name: string };

class HttpError extends Error {
  status: number;

  constructor(status: number, text: string) {
    super(`HTTP ${status} ${text}`);
    this.status = status;
  }
}

async function getUser(url: string, ms: i64): Promise<User> {
  const res = await fetch(url, { signal: AbortSignal.timeout(ms) });
  if (!res.ok) {
    throw new HttpError(res.status, res.statusText);
  }
  return await res.json<User>();
}

// `ms`: a minute for the paths that answer (a hang guard, never reached), a short timeout only
// for the one that never answers until the end.
async function show(url: string, ms: i64 = 60000) {
  try {
    const u = await getUser(url, ms);
    console.log("user", u.id, u.name);
  } catch (e) {
    if (e instanceof HttpError) {
      console.log("status", e.status, e.message);
    } else if (e instanceof JsonError) {
      console.log("bad body:", e.message);
    } else if (e instanceof TimeoutError) {
      console.log("timed out");
    } else if (e instanceof AbortError) {
      console.log("aborted");
    } else if (e instanceof IoError) {
      console.log("failed", e.code);
    }
  }
}

async function main() {
  const release = new AbortController();
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const path = new URL(req.url).pathname;
    if (path == "/ok") {
      return Response.json({ id: 1, name: "Ada" });
    }
    if (path == "/bad") {
      return Response.json({ id: "one" });
    }
    if (path == "/slow") {
      await release.signal.whenAborted();
      return new Response("late");
    }
    return new Response("no such user", { status: 404 });
  });
  const base = `http://127.0.0.1:${server.port}`;
  await show(`${base}/ok`);
  await show(`${base}/missing`);
  await show(`${base}/bad`);
  await show(`${base}/slow`, 50);
  release.abort();
  await server.shutdown();
}
