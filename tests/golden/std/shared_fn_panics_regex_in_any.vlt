// A `RegExp` behind an `any`: each call's copy would run its `clone()` through the interface value.
type F = (x: i64) => i64;

function mk(): F {
  const h: any = /a+/;
  return (x: i64): i64 => (h as RegExp).test("aa") ? 1 : 0;
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
