// A ping answered while the application's own frames fill the send queue past the high-water
// mark (a peer slow to read): the reader goes on reading. Only pongs past the mark stop it
// (std/websocket_ping_flood).
import { connect, listen } from "velt:net";
import { OP_BINARY } from "velt:websocket/frame";
import { SendQueue } from "velt:websocket/queue";
import { PING, Reader, Step } from "velt:websocket/reader";
import { other } from "velt:websocket/receive";
import { TimeoutError, timeout } from "velt:task";

async function main() {
  // A peer that accepts and then never reads.
  const listener = await listen("127.0.0.1:0");
  const peer = spawn(async () => await listener.accept());
  const stream = await connect(`127.0.0.1:${listener.port}`);
  const silent = await peer;

  // 2 MB of the application's frames queued, nothing written yet.
  const tx = shared(new Mutex<SendQueue>(new SendQueue(false, new Reader(true, []))));
  const chunk = Buffer.alloc(262144);
  for (let i = 0; i < 8; i++) {
    tx.with((q) => q.pushBytes(OP_BINARY, chunk));
  }
  console.log("queued past the mark:", tx.with((q) => q.out.length > 1048576));

  try {
    await timeout(other(stream, tx.clone(), new Step(PING, "", [1u8])), 5000);
    console.log("the reader goes on after a ping: true");
  } catch (e) {
    console.log("the reader goes on after a ping:", !(e instanceof TimeoutError));
  }
  stream.abort();
  stream.close();
  silent.close();
  listener.close();
}
