// check: no leaks
// `for await` over a `ReadableStream` against a chain of microtasks: each value arrives in the
// turn Node 22's does (#3711), also from a pull that settles later and for `next()` calls made
// at once, and leaving the loop early (`break`, a throw, `return`) lets the stream go before the
// cancel settles (#3717) and goes on in Node's turn (#3741).
// `loop` makes its stream itself: one passed in as a parameter is #3761. The Node twin is
// streams_for_await.mjs.
function ticks(log: string[]): Promise<void> {
  let p = Promise.resolve();
  for (let i = 0; i < 20; i++) {
    const k = i;
    p = p.then(() => {
      log.push("t" + k);
    });
  }
  return p;
}

async function loop(name: string, mk: () => ReadableStream<number>): Promise<void> {
  const log: string[] = [];
  const t = ticks(log);
  const s = mk();
  for await (const v of s) {
    log.push("v" + v);
  }
  log.push("end");
  await t;
  console.log(name + ": " + log.join(" "));
}

// A chain of `n` microtasks, each logged.
function chain(log: string[], n: number): Promise<void> {
  let p = Promise.resolve();
  for (let i = 0; i < n; i++) {
    const k = i;
    p = p.then(() => {
      log.push("t" + k);
    });
  }
  return p;
}

// A pull that settles after `waits` microtasks: the first value waits for it, in Node's turn.
async function slow(name: string, waits: number): Promise<void> {
  const log: string[] = [];
  const t = chain(log, 30);
  let d = 0;
  const s = new ReadableStream<number>({
    pull: async (c) => {
      for (let i = 0; i < waits; i++) {
        await null;
      }
      d++;
      if (d > 3) {
        c.close();
      } else {
        c.enqueue(d);
      }
    },
  });
  for await (const v of s) {
    log.push("v" + v);
  }
  log.push("end");
  await t;
  console.log(name + ": " + log.join(" "));
}

// Three `next()` calls at once: each waits for the one before it, as Node chains them.
async function concurrent(): Promise<void> {
  const log: string[] = [];
  const t = chain(log, 16);
  let n = 0;
  const s = new ReadableStream<number>({
    pull: (c) => {
      n++;
      if (n > 3) {
        c.close();
      } else {
        c.enqueue(n);
      }
    },
  });
  const it = s[Symbol.asyncIterator]();
  const a = it.next();
  const b = it.next();
  const c = it.next();
  a.then((r) => {
    log.push("a " + r.value);
  });
  b.then((r) => {
    log.push("b " + r.value);
  });
  c.then((r) => {
    log.push("c " + r.value);
  });
  await Promise.all([a, b, c]);
  await t;
  console.log("concurrent: " + log.join(" "));
}

// Three chunks and a `cancel` that logs, at once or after an `await`.
function three(log: string[], asyncCancel: boolean): ReadableStream<number> {
  if (asyncCancel) {
    return new ReadableStream<number>({
      start: (c) => {
        c.enqueue(1);
        c.enqueue(2);
        c.enqueue(3);
      },
      cancel: async (reason) => {
        log.push("cancel");
        await null;
        log.push("done");
      },
    });
  }
  return new ReadableStream<number>({
    start: (c) => {
      c.enqueue(1);
      c.enqueue(2);
      c.enqueue(3);
    },
    cancel: (reason) => {
      log.push("cancel");
    },
  });
}

// Leaving the loop by a throw at value `at`: the code after it runs in Node's turn.
async function throwAt(name: string, at: number, asyncCancel: boolean): Promise<void> {
  const log: string[] = [];
  const t = chain(log, 16);
  const s = three(log, asyncCancel);
  try {
    for await (const v of s) {
      log.push("v" + v);
      if (v == at) {
        throw new Error("x");
      }
    }
  } catch (e) {
    log.push("caught");
  }
  await t;
  console.log(name + ": " + log.join(" "));
}

// Leaving the loop by `break` at value `at`, with an async `cancel`.
async function breakAt(name: string, at: number): Promise<void> {
  const log: string[] = [];
  const t = chain(log, 16);
  const s = three(log, true);
  for await (const v of s) {
    log.push("v" + v);
    if (v == at) {
      break;
    }
  }
  log.push("after");
  await t;
  console.log(name + ": " + log.join(" "));
}

// `return v` from inside the loop, in an async function the caller awaits.
async function firstOf(s: ReadableStream<number>): Promise<number> {
  for await (const v of s) {
    return v;
  }
  return 0;
}

async function returnInside(): Promise<void> {
  const log: string[] = [];
  const t = chain(log, 16);
  const v = await firstOf(three(log, false));
  log.push("returned " + v);
  await t;
  console.log("return inside: " + log.join(" "));
}

async function main(): Promise<void> {
  await loop(
    "start",
    () => new ReadableStream<number>({
      start: (c) => {
        c.enqueue(1);
        c.enqueue(2);
        c.enqueue(3);
        c.close();
      },
    }),
  );

  let n = 0;
  await loop(
    "sync pull",
    () => new ReadableStream<number>({
      pull: (c) => {
        n++;
        if (n > 3) {
          c.close();
        } else {
          c.enqueue(n);
        }
      },
    }),
  );

  let m = 0;
  await loop(
    "async pull",
    () => new ReadableStream<number>({
      pull: async (c) => {
        m++;
        if (m > 3) {
          c.close();
        } else {
          c.enqueue(m);
        }
      },
    }),
  );

  // Leaving early: the stream is let go at once, before the source's `cancel` runs out and
  // before the loop goes on (#3717).
  const log: string[] = [];
  const s = new ReadableStream<number>({
    start: (c) => {
      c.enqueue(1);
      c.enqueue(2);
    },
    cancel: (reason) => {
      log.push("cancel");
    },
  });
  for await (const v of s) {
    log.push("v" + v);
    queueMicrotask(() => {
      log.push("locked " + s.locked);
    });
    break;
  }
  log.push("after locked " + s.locked);
  await null;
  console.log("break: " + log.join(" "));

  // An error after a value: the loop throws it in Node's turn, and the stream is let go.
  const elog: string[] = [];
  const et = ticks(elog);
  const es = new ReadableStream<number>({
    start: (c) => {
      c.enqueue(1);
    },
    pull: (c) => {
      c.error(new Error("boom"));
    },
  });
  try {
    for await (const v of es) {
      elog.push("v" + v);
    }
  } catch (e) {
    elog.push(`caught ${e} locked ${es.locked}`);
  }
  await et;
  console.log("error: " + elog.join(" "));

  // A `return()` is the current promise: a second `return()` and a `next()` after it settle
  // once its cancel has.
  const rlog: string[] = [];
  const rs = new ReadableStream<number>({
    start: (c) => {
      c.enqueue(1);
    },
    cancel: (reason) => {
      rlog.push("cancel");
    },
  });
  const it = rs[Symbol.asyncIterator]();
  const r1 = it.return!();
  const r2 = it.return!();
  const r3 = it.next();
  r3.then((r) => {
    rlog.push("next done " + r.done);
  });
  r2.then((r) => {
    rlog.push("return 2");
  });
  r1.then((r) => {
    rlog.push("return 1");
  });
  await Promise.all([r1, r2, r3]);
  console.log("return twice: " + rlog.join(" "));

  await slow("pull after 0 microtasks, an await not reached", 0);
  await slow("pull after 1 microtask", 1);
  await slow("pull after 2 microtasks", 2);
  await slow("pull after 3 microtasks", 3);
  await concurrent();
  await throwAt("throw at 2", 2, false);
  await throwAt("throw at 2, async cancel", 2, true);
  await breakAt("break at 1, async cancel", 1);
  await breakAt("break at 2, async cancel", 2);
  await returnInside();
}

main();
