function test_usize() {
  let c: u64 = 0xcbf29ce484222325;
  let s: u64 = 0xcbf29ce484222325;
  let w: u64 = 0xcbf29ce484222325;
  const vs: usize[] = [
    0,
    1,
    2,
    3,
    7,
    100,
    255,
    4294967296,
    4294967297,
    9223372036854775807,
    9223372036854775808,
    18446744073709551614,
    18446744073709551615,
  ];
  for (const a of vs) {
    for (const b of vs) {
      const kAdd = a.checkedAdd(b);
      c = mix(c, kAdd == null ? 0xdead : (kAdd as u64) + 1);
      s = mix(s, a.saturatingAdd(b) as u64);
      w = mix(w, a.wrappingAdd(b) as u64);
      const kSub = a.checkedSub(b);
      c = mix(c, kSub == null ? 0xdead : (kSub as u64) + 1);
      s = mix(s, a.saturatingSub(b) as u64);
      w = mix(w, a.wrappingSub(b) as u64);
      const kMul = a.checkedMul(b);
      c = mix(c, kMul == null ? 0xdead : (kMul as u64) + 1);
      s = mix(s, a.saturatingMul(b) as u64);
      w = mix(w, a.wrappingMul(b) as u64);
    }
  }
  console.log("usize", c, s, w);
}

function test_isize() {
  let c: u64 = 0xcbf29ce484222325;
  let s: u64 = 0xcbf29ce484222325;
  let w: u64 = 0xcbf29ce484222325;
  const vs: isize[] = [
    (-9223372036854775807 - 1),
    -9223372036854775807,
    -4611686018427387904,
    -3037000499,
    -100,
    -7,
    -2,
    -1,
    0,
    1,
    2,
    3,
    7,
    100,
    3037000499,
    3037000500,
    4611686018427387903,
    9223372036854775806,
    9223372036854775807,
  ];
  for (const a of vs) {
    for (const b of vs) {
      const kAdd = a.checkedAdd(b);
      c = mix(c, kAdd == null ? 0xdead : (kAdd as u64) + 1);
      s = mix(s, a.saturatingAdd(b) as u64);
      w = mix(w, a.wrappingAdd(b) as u64);
      const kSub = a.checkedSub(b);
      c = mix(c, kSub == null ? 0xdead : (kSub as u64) + 1);
      s = mix(s, a.saturatingSub(b) as u64);
      w = mix(w, a.wrappingSub(b) as u64);
      const kMul = a.checkedMul(b);
      c = mix(c, kMul == null ? 0xdead : (kMul as u64) + 1);
      s = mix(s, a.saturatingMul(b) as u64);
      w = mix(w, a.wrappingMul(b) as u64);
    }
  }
  console.log("isize", c, s, w);
}

function mix(h: u64, v: u64): u64 {
  return (h ^ v) * 0x100000001b3;
}

function main() {
  test_u8();
  test_i8();
  test_u16();
  test_i16();
  test_u32();
  test_i32();
  test_u64();
  test_i64();
  test_usize();
  test_isize();
  // The results keep their integer type: narrow arithmetic wraps, wide values stay exact.
  const a: u8 = 200;
  const b: u8 = 100;
  console.log(a.wrappingAdd(b) + 250);
  const x: i64 = 9007199254740993;
  const zero: i64 = 0;
  console.log(x.wrappingAdd(zero));
  const u: usize = 18446744073709551615;
  console.log(u.wrappingMul(1 as usize));
}
