// checkedAdd/Sub/Mul, saturatingAdd/Sub/Mul and wrappingAdd/Sub/Mul on every integer type,
// against Rust's checked_*, saturating_* and wrapping_* (the same checksums): every pair of
// 8-bit values, and every pair of edge values (0, ±1, MIN, MAX, their neighbours, √MAX) wider.

function test_u8() {
  let c: u64 = 0xcbf29ce484222325;
  let s: u64 = 0xcbf29ce484222325;
  let w: u64 = 0xcbf29ce484222325;
  for (let x = 0; x <= 255; x++) {
    for (let y = 0; y <= 255; y++) {
      const a = x as u8;
      const b = y as u8;
      const kAdd = a.checkedAdd(b);
      c = mix(c, kAdd == null ? 0xdead : (kAdd as u64) + 1);
      s = mix(s, a.saturatingAdd(b) as u64);
      w = mix(w, a.wrappingAdd(b) as u64);
      const kSub = a.checkedSub(b);
      c = mix(c, kSub == null ? 0xdead : (kSub as u64) + 1);
      s = mix(s, a.saturatingSub(b) as u64);
      w = mix(w, a.wrappingSub(b) as u64);
      const kMul = a.checkedMul(b);
      c = mix(c, kMul == null ? 0xdead : (kMul as u64) + 1);
      s = mix(s, a.saturatingMul(b) as u64);
      w = mix(w, a.wrappingMul(b) as u64);
    }
  }
  console.log("u8", c, s, w);
}

function test_i8() {
  let c: u64 = 0xcbf29ce484222325;
  let s: u64 = 0xcbf29ce484222325;
  let w: u64 = 0xcbf29ce484222325;
  for (let x = -128; x <= 127; x++) {
    for (let y = -128; y <= 127; y++) {
      const a = x as i8;
      const b = y as i8;
      const kAdd = a.checkedAdd(b);
      c = mix(c, kAdd == null ? 0xdead : (kAdd as u64) + 1);
      s = mix(s, a.saturatingAdd(b) as u64);
      w = mix(w, a.wrappingAdd(b) as u64);
      const kSub = a.checkedSub(b);
      c = mix(c, kSub == null ? 0xdead : (kSub as u64) + 1);
      s = mix(s, a.saturatingSub(b) as u64);
      w = mix(w, a.wrappingSub(b) as u64);
      const kMul = a.checkedMul(b);
      c = mix(c, kMul == null ? 0xdead : (kMul as u64) + 1);
      s = mix(s, a.saturatingMul(b) as u64);
      w = mix(w, a.wrappingMul(b) as u64);
    }
  }
  console.log("i8", c, s, w);
}

function test_u16() {
  let c: u64 = 0xcbf29ce484222325;
  let s: u64 = 0xcbf29ce484222325;
  let w: u64 = 0xcbf29ce484222325;
  const vs: u16[] = [0, 1, 2, 3, 7, 100, 255, 256, 257, 32767, 32768, 65534, 65535];
  for (const a of vs) {
    for (const b of vs) {
      const kAdd = a.checkedAdd(b);
      c = mix(c, kAdd == null ? 0xdead : (kAdd as u64) + 1);
      s = mix(s, a.saturatingAdd(b) as u64);
      w = mix(w, a.wrappingAdd(b) as u64);
      const kSub = a.checkedSub(b);
      c = mix(c, kSub == null ? 0xdead : (kSub as u64) + 1);
      s = mix(s, a.saturatingSub(b) as u64);
      w = mix(w, a.wrappingSub(b) as u64);
      const kMul = a.checkedMul(b);
      c = mix(c, kMul == null ? 0xdead : (kMul as u64) + 1);
      s = mix(s, a.saturatingMul(b) as u64);
      w = mix(w, a.wrappingMul(b) as u64);
    }
  }
  console.log("u16", c, s, w);
}

function test_i16() {
  let c: u64 = 0xcbf29ce484222325;
  let s: u64 = 0xcbf29ce484222325;
  let w: u64 = 0xcbf29ce484222325;
  const vs: i16[] = [
    (-32767 - 1),
    -32767,
    -16384,
    -181,
    -100,
    -7,
    -2,
    -1,
    0,
    1,
    2,
    3,
    7,
    100,
    181,
    182,
    16383,
    32766,
    32767,
  ];
  for (const a of vs) {
    for (const b of vs) {
      const kAdd = a.checkedAdd(b);
      c = mix(c, kAdd == null ? 0xdead : (kAdd as u64) + 1);
      s = mix(s, a.saturatingAdd(b) as u64);
      w = mix(w, a.wrappingAdd(b) as u64);
