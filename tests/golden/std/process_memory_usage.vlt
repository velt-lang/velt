// `process.memoryUsage()`: the resident set size and the heap's committed memory, in bytes. Both
// are positive, and both grow when the program fills a 64 MiB array. (On Windows the debug run
// used to hang at exit here: #297.)
async function main() {
  const before = process.memoryUsage();
  console.log(before.rss > 0, before.heapUsed > 0);
  const big = new Array<u8>(64 * 1024 * 1024).fill(1);
  const after = process.memoryUsage();
  console.log(after.rss > before.rss, after.heapUsed > before.heapUsed, big.length);
}
