// Window functions in the SQLite engine written in Velt (velt:sqlite/engine, #1720) on a database
// C SQLite writes (through velt:sqlite): ranking and value functions, aggregates over frames
// (ROWS, GROUPS, RANGE, EXCLUDE, FILTER), named windows and their errors; each value printed as
// SQLite's quote() prints it. The expected output is the sqlite3 shell's (`.mode quote`) for the
// same queries on the same data; rows of a query without ORDER BY are sorted on both sides.
import { open } from "velt:sqlite";
import { openDatabase, Database } from "velt:sqlite/engine";
import { BLOB, REAL } from "velt:sqlite/btree";
import { Val } from "velt:sqlite/exec/value";
import { quote } from "velt:sqlite/exec/func";
import { hexEncode } from "velt:encoding";
import { tmpdir } from "velt:os";
import { uuidv4 } from "velt:uuid";
import { removeSync } from "velt:fs";

const SETUP = `
CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT NOT NULL, age INT, score REAL, note,
  nick TEXT COLLATE NOCASE);
CREATE TABLE posts (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, title TEXT, body TEXT,
  created TEXT NOT NULL, stars NUMERIC);
CREATE INDEX posts_user ON posts (user_id);
CREATE INDEX posts_created ON posts (created DESC, id DESC);
CREATE TABLE tags (post_id INTEGER, tag TEXT, PRIMARY KEY (post_id, tag));
CREATE INDEX tags_tag ON tags (tag);
CREATE TABLE kv (k TEXT PRIMARY KEY, v);
CREATE VIEW popular AS SELECT post_id, count(*) AS n FROM tags GROUP BY post_id HAVING count(*) > 1;
INSERT INTO users VALUES
  (1, 'alice', 30, 4.5, NULL, 'Al'), (2, 'bob', 25, 3.0, 'hi', 'BOBBY'), (3, 'carol', 35, NULL, 7, 'cc'),
  (4, 'dave', 25, 2.25, x'00ff', 'Dave'), (5, 'eve', NULL, 5.0, 1.5, 'al'), (6, 'Frank', 41, -1.0, '12', NULL),
  (7, 'grace', 30, 1e10, '', 'GRACE'), (8, 'héloïse', 28, 0.1, 'ü', 'h');
INSERT INTO posts VALUES
  (1, 1, 'Hello', 'first post', '2024-01-01', 5), (2, 1, 'Again', 'second', '2024-01-03', '7'),
  (3, 2, 'Bob here', NULL, '2024-01-02', 2.5), (4, 3, 'x', 'carol''s', '2024-01-05', NULL),
  (5, 3, 'y', 'more', '2024-01-04', 0), (6, 3, 'z', '', '2024-01-04', -3), (7, 9, 'orphan', 'no user', '2024-01-06', 1),
  (8, 5, 'Eve', 'eve', '2024-01-07', '1e2'), (9, 7, 'Grace', 'g', '2024-01-02', 'abc'), (10, 2, 'Bob 2', 'b2', '2024-01-08', 4);
INSERT INTO tags VALUES (1, 'intro'), (1, 'misc'), (2, 'misc'), (3, 'intro'), (4, 'Misc'),
  (5, 'news'), (8, 'news'), (8, 'intro'), (9, 'misc'), (10, 'x');
INSERT INTO kv VALUES ('a', 1), ('b', '2'), ('c', 3.5), ('d', NULL), ('e', x'41'), ('f', 'text'),
  ('g', -9223372036854775808), ('h', 9223372036854775807), ('i', 1e300), ('j', 0.30000000000000004);
`;

const QUERIES: string[] = [
  // Window functions: ranking, values, aggregates over frames, named windows.
  "SELECT id, age, row_number() OVER (ORDER BY age, id), rank() OVER w, dense_rank() OVER w FROM users WINDOW w AS (ORDER BY age) ORDER BY id",
  "SELECT id, user_id, row_number() OVER (PARTITION BY user_id ORDER BY created DESC) AS n FROM posts ORDER BY user_id, n",
  "SELECT id, percent_rank() OVER (ORDER BY created), cume_dist() OVER (ORDER BY created), ntile(3) OVER (ORDER BY id) FROM posts ORDER BY id",
  "SELECT id, lag(title) OVER (ORDER BY id), lead(title, 2, '-') OVER (ORDER BY id) FROM posts ORDER BY id",
  "SELECT id, first_value(id) OVER w, last_value(id) OVER w, nth_value(id, 2) OVER w FROM posts WINDOW w AS (PARTITION BY user_id ORDER BY id) ORDER BY id",
  "SELECT id, sum(stars) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), avg(stars) OVER (ORDER BY id ROWS 2 PRECEDING) FROM posts ORDER BY id",
  "SELECT id, count(*) OVER (ORDER BY created GROUPS BETWEEN 1 PRECEDING AND CURRENT ROW EXCLUDE TIES), group_concat(id, '+') OVER (ORDER BY created RANGE BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) FROM posts ORDER BY id",
  "SELECT user_id, count(*), sum(count(*)) OVER (ORDER BY user_id) FROM posts GROUP BY user_id ORDER BY user_id",
  "SELECT name FROM (SELECT name, rank() OVER (ORDER BY score DESC) AS r FROM users) WHERE r <= 3 ORDER BY r",
  "SELECT id, total(score) FILTER (WHERE age > 26) OVER (ORDER BY id) FROM users ORDER BY id",
  "SELECT id, user_id, row_number() OVER (PARTITION BY user_id) FROM posts",
  // min() and max() over a moving frame give the latest of equal values; sums taking out a row that overflows go approximate as SQLite 3.54's.
  "SELECT x, min(y) OVER (ORDER BY x ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING), max(y) OVER (ORDER BY x ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM (SELECT 1 x, 5 y UNION ALL SELECT 2, 3.0 UNION ALL SELECT 3, 3 UNION ALL SELECT 4, 7 UNION ALL SELECT 5, 3 UNION ALL SELECT 6, 3.0 UNION ALL SELECT 7, 9 UNION ALL SELECT 8, 9.0) ORDER BY x",
  "SELECT k, total(v) OVER w, avg(v) OVER w FROM kv WINDOW w AS (ORDER BY k ROWS BETWEEN 1 PRECEDING AND 2 FOLLOWING) ORDER BY k",
  "SELECT x, total(y) OVER (ORDER BY x ROWS BETWEEN 1 PRECEDING AND 3 FOLLOWING) FROM (SELECT 1 x, -9223372036854775807 - 1 y UNION ALL SELECT 2, 5 UNION ALL SELECT 3, 9223372036854775807 UNION ALL SELECT 4, -1 UNION ALL SELECT 5, 1 UNION ALL SELECT 6, 4 UNION ALL SELECT 7, 6 UNION ALL SELECT 8, 6) ORDER BY x",
  "SELECT row_number() FROM users",
  "SELECT id FROM users WHERE rank() OVER () > 1",
  "SELECT sum(id) OVER w FROM users",
  // Bounds SQLite's grammar does not have, and a frame it rejects after parsing.
  "SELECT sum(id) OVER (ROWS BETWEEN UNBOUNDED FOLLOWING AND CURRENT ROW) FROM users",
  "SELECT sum(id) OVER (ROWS BETWEEN CURRENT ROW AND UNBOUNDED PRECEDING) FROM users",
  "SELECT sum(id) OVER (ROWS UNBOUNDED FOLLOWING) FROM users",
  "SELECT sum(id) OVER (ROWS BETWEEN 1 FOLLOWING AND CURRENT ROW) FROM users",
  // min()/max() from the partition's first row, and first/last/nth_value, read as the frame
  // grows or at a position in it: ties under NOCASE, FILTER, frames empty at first or past N.
  "SELECT id, max(nick) OVER (ORDER BY age), min(age) FILTER (WHERE id > 2) OVER (ORDER BY id) FROM users ORDER BY id",
  "SELECT id, max(note) OVER (ORDER BY age ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING), min(score) OVER (PARTITION BY age IS NULL ORDER BY name GROUPS BETWEEN UNBOUNDED PRECEDING AND 1 FOLLOWING) FROM users ORDER BY id",
  "SELECT id, last_value(nick) OVER (ORDER BY age), nth_value(name, 2) OVER (ORDER BY age ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), nth_value(score, 5) OVER (ORDER BY age), first_value(age) OVER (ORDER BY age ROWS BETWEEN 2 FOLLOWING AND UNBOUNDED FOLLOWING) FROM users ORDER BY id",
  // min()/max() over frames that lose rows: equal values under NOCASE in sliding frames (the
  // latest equal one is the result), and 20,000 rows in a frame that shrinks and in a wide
  // sliding one (stepping each row in and out once, not scanning the frame for each row).
  "SELECT id, max(nick) OVER (ORDER BY id ROWS BETWEEN 4 PRECEDING AND CURRENT ROW), min(nick) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND 4 FOLLOWING), max(nick) OVER (ORDER BY id ROWS BETWEEN 1 FOLLOWING AND 5 FOLLOWING) FROM users ORDER BY id",
  "WITH RECURSIVE c(p) AS (SELECT 1 UNION ALL SELECT p + 1 FROM c WHERE p < 20000) SELECT count(*), sum(w), sum(x) FROM (SELECT min((p * 7919) % 10007) OVER (ORDER BY p ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS w, max((p * 7919) % 10007) OVER (ORDER BY p ROWS BETWEEN 2000 PRECEDING AND 2000 FOLLOWING) AS x FROM c)",
  // A subquery's aggregate of a query with window functions makes it an aggregate query only in
  // the windows SQLite computes last (their terms, arguments and FILTER): the last group of
  // equal windows in the result columns, after ORDER BY's (a term naming a column copies it).
  "SELECT (SELECT count(users.id) FROM posts), row_number() OVER () FROM users",
  "SELECT id, count(*) OVER (PARTITION BY (SELECT count(users.id) FROM posts)) FROM users",
  "SELECT id, count(*) OVER (ORDER BY (SELECT count(users.id) FROM posts)) FROM users",
  "SELECT id, count(*) OVER (PARTITION BY (SELECT max(users.id))) FROM users",
  "SELECT id, count(*) OVER w FROM users WINDOW w AS (PARTITION BY (SELECT count(users.id) FROM posts))",
  "SELECT id, sum((SELECT count(users.id) FROM posts)) OVER (), count(*) FILTER (WHERE (SELECT max(users.id)) > 0) OVER () FROM users",
  "SELECT id, sum(1) OVER (), count(*) OVER (PARTITION BY (SELECT max(users.id))) FROM users",
  "SELECT id, count(*) OVER (PARTITION BY (SELECT max(users.id))), sum(1) OVER () FROM users",
  "SELECT id, count(*) OVER (PARTITION BY (SELECT max(users.id))), count(*) OVER (PARTITION BY (SELECT max(users.id))) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id), sum(1) OVER (), max((SELECT max(users.id))) OVER (ORDER BY  ID) FROM users",
  "SELECT id, count(*) OVER w, sum(1) OVER (ORDER BY id), max((SELECT max(users.id))) OVER w FROM users WINDOW w AS (ORDER BY id)",
  "SELECT id, count(*) OVER (PARTITION BY (SELECT max(users.id))) FROM users ORDER BY 2",
  "SELECT id FROM users ORDER BY count(*) OVER (PARTITION BY (SELECT max(users.id)))",
  "SELECT count(*), (SELECT count(users.id) FROM posts), count(*) OVER () FROM users",
  "SELECT age, count(*) OVER (), (SELECT count(users.id) FROM posts) FROM users GROUP BY age",
  "SELECT age, count(*) OVER (ORDER BY (SELECT count(users.id) FROM posts)) FROM users GROUP BY age",
  // A ROWS or GROUPS offset that is not a constant (a column or name, a function call, a
  // subquery, a window) is NULL to SQLite's parser: a frame error when rows come, before its names
  // resolve. Constant offsets are computed.
  "SELECT id, count(*) OVER (ORDER BY id ROWS (SELECT count(users.id) FROM posts) PRECEDING) FROM users",
  "SELECT id, count(*) OVER w FROM users WINDOW w AS (ORDER BY id ROWS (SELECT max(users.id)) PRECEDING)",
  "SELECT id, count(*) OVER (ORDER BY id ROWS BETWEEN CURRENT ROW AND (SELECT count(users.id) FROM posts) FOLLOWING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS (SELECT 1) PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND id FOLLOWING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS abs(-1) PRECEDING), count(*) OVER (ORDER BY id ROWS ('a' LIKE 'a') PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS max(1) PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS nosuch PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS row_number() OVER () PRECEDING) FROM users",
  "SELECT age, count(*) OVER (ORDER BY age ROWS EXISTS (SELECT 1) PRECEDING) FROM users GROUP BY age",
  "SELECT id, count(*) OVER (ORDER BY id ROWS (SELECT 1) PRECEDING) FROM users WHERE 0",
  "SELECT id, count(*) OVER (ORDER BY id ROWS -1 PRECEDING) FROM users WHERE 0",
  "SELECT id, count(*) OVER (ORDER BY id ROWS BETWEEN 1 + 1 PRECEDING AND CAST('1' AS INTEGER) FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN (1) PRECEDING AND CASE WHEN 1 THEN 2 END FOLLOWING) FROM users",
  // A non-constant part under a constant node (a cast, a minus, IS NULL) makes the offset NULL too.
  "SELECT id, count(*) OVER (ORDER BY id ROWS CAST(id AS INTEGER) PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS -id PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND -id FOLLOWING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND id IS NULL FOLLOWING) FROM users",
  // An offset gets numeric affinity first (OP_MustBeInt): TEXT that reads as an integer is one;
  // a REAL counts only if it is an integer strictly inside i64's range.
  "SELECT id, count(*) OVER (ORDER BY id ROWS '1' PRECEDING), count(*) OVER (ORDER BY id ROWS ' 1' PRECEDING), count(*) OVER (ORDER BY id ROWS '1 ' PRECEDING), count(*) OVER (ORDER BY id ROWS '1.0' PRECEDING), count(*) OVER (ORDER BY id ROWS '1e0' PRECEDING), count(*) OVER (ORDER BY id ROWS CAST(1 AS TEXT) PRECEDING), count(*) OVER (ORDER BY id ROWS '2' PRECEDING) FROM users WHERE id <= 4 ORDER BY id",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND '1' FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND ' 1' FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND '1.0' FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND '1e0 ' FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND CAST(1 AS TEXT) FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND '2' FOLLOWING), count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND 9.2233720368547748e18 FOLLOWING) FROM users WHERE id <= 4 ORDER BY id",
  "SELECT id, count(*) OVER (ORDER BY id ROWS 9223372036854775808 PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS 9223372036854775807.0 PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND 9223372036854775808 FOLLOWING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND 9223372036854775807.0 FOLLOWING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS 99999999999999999999 PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS -9223372036854775808 PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS '1.5' PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id ROWS 'abc' PRECEDING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND '' FOLLOWING) FROM users",
  "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND x'31' FOLLOWING) FROM users",
];

// Offsets bound as parameters (TEXT here): numeric affinity applies to them as well.
const BOUND: string[][] = [
  [
    "SELECT id, count(*) OVER (ORDER BY id ROWS ? PRECEDING) FROM users WHERE id <= 4 ORDER BY id",
    "1",
  ],
  [
    "SELECT id, count(*) OVER (ORDER BY id GROUPS BETWEEN CURRENT ROW AND ?1 FOLLOWING) FROM users WHERE id <= 4 ORDER BY id",
    " 2",
  ],
  ["SELECT id, count(*) OVER (ORDER BY id ROWS ? PRECEDING) FROM users", "1.5"],
];

/** A value as the shell's quote mode prints it: quote(), but blobs as x'…' and Inf. */
function shown(v: Val): string {
  if (v.t == BLOB) {
    return `x'${hexEncode(v.b)}'`;
  }
  if (v.t == REAL && (v.r == Infinity || v.r == -Infinity)) {
    return v.r > 0 ? "Inf" : "-Inf";
  }
  return quote(v);
}

/**
 * The rows of a query (with `params` bound, if any): each value as the shell's quote mode
 * prints it, or the error.
 */
function rows(db: Database, sql: string, params: string[]): string[] {
  const out: string[] = [];
  try {
    const st = db.prepare(sql);
    const vals = params.length == 0 ? st.values() : st.valuesWith(params);
    const n = st.columns().length as usize;
    const count: usize = n == 0 ? 0 : (vals.length as usize) / n;
    for (let r: usize = 0; r < count; r++) {
      const parts: string[] = [];
      for (let i: usize = 0; i < n; i++) {
        const v = vals[r * n + i];
        parts.push(shown(v));
      }
      out.push(parts.join(","));
    }
  } catch (e) {
    return [`error: ${e.message}`];
  }
  return out;
}

function main() {
  const path = `${tmpdir()}/velt-engine-query-${uuidv4()}.db`;
  const c = open(path);
  c.exec(SETUP);
  c.close();
  const db = openDatabase(path);
  for (const q of QUERIES) {
    let r = rows(db, q, []);
    if (!q.includes("ORDER BY")) {
      r = r.toSorted();
    }
    console.log(q);
    for (const line of r) {
      console.log(`  ${line}`);
    }
  }
  for (const b of BOUND) {
    console.log(`${b[0]} -- ${b[1]}`);
    for (const line of rows(db, b[0], b.slice(1))) {
      console.log(`  ${line}`);
    }
  }
  removeSync(path);
}
