// `x.toBits()` and `f32.fromBits(b)` on `f32`: IEEE 754 bit casts that no runtime defines; both
// backends emit them inline (one move), and the optimizer folds them on constants.
function main() {
  const xs: f32[] = [0, -0, 1, -1.5, 0.1, 1.401298464324817e-45, 3.4028234663852886e38];
  for (const x of xs) {
    const b = x.toBits();
    console.log(x, b.toString(16), f32.fromBits(b) == x, Object.is(f32.fromBits(b), x));
  }
  const inf = f32.fromBits(0x7f800000);
  console.log(inf, (-inf).toBits().toString(16));
  const nan = f32.fromBits(0x7fc00000);
  console.log(nan != nan, nan.toBits().toString(16));
  // A constant signalling NaN: the optimizer must not fold its bits (nor quiet it).
  console.log(f32.fromBits(0x7f800001).toBits().toString(16));
  // Every bit pattern comes back exactly, NaN payloads included: signalling, payload, negative
  // and all-ones NaNs, the largest subnormal and the smallest normal, through a function
  // parameter, an array element and a class field.
  const bits: u32[] = [
    0x7f800001,
    0x7fa00000,
    0x7fc00123,
    0xffc00000,
    0xffffffff,
    0x7fffffff,
    0x007fffff,
    0x00800000,
    0x80000001,
    0x80000000,
    0xff800001,
  ];
  const values: f32[] = [];
  for (const b of bits) {
    values.push(f32.fromBits(b));
  }
  const box = new Box();
  for (let i = 0; i < bits.length; i++) {
    box.x = values[i];
    const back = box.x.toBits();
    console.log(bits[i].toString(16), roundTrip(bits[i]) == bits[i], back == bits[i]);
  }
  // The sign, exponent and fraction fields, as code decoding floats by hand reads them.
  const b = (-6.25 as f32).toBits();
  console.log(b >>> 31, (b >>> 23) & 0xff, (b & 0x7fffff).toString(16));
  // A typed array's bytes are the same bits (std's element conversions use these casts).
  const fa = new Float32Array([0.1, -2]);
  const view = new DataView(fa.buffer);
  console.log(view.getUint32(0, true).toString(16), view.getUint32(4, true).toString(16));
  view.setUint32(0, 0x40490fdb, true);
  console.log(fa[0]);
}

class Box {
  x: f32 = 0;
}

function roundTrip(b: u32): u32 {
  return f32.fromBits(b).toBits();
}
