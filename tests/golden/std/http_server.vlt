// check: no leaks
// velt/net/http: a handler that throws gets a 500, and its error is printed to stderr. (The
// rest of what velt/net/http does is tested in tests/std/http/handlers.test.vlt.)
import { HttpRequest, HttpResponse, serveHttp } from "velt/net/http";

async function main() {
  const server = await serveHttp({ port: 0 }, async (req: HttpRequest, res: HttpResponse) => {
    if (req.pathIs("/fail")) {
      throw new Error("handler failed");
    }
    res.send("hello");
  });
  const failed = await fetch(`http://127.0.0.1:${server.port}/fail`);
  console.log(failed.status, await failed.text());
  server.close();
}
