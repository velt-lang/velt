// `toEqual` on values held as an interface or a base class compares their objects' fields
// (#1882), as Vitest does: two objects of one class with equal fields are equal, whatever type
// holds them, a subclass's own fields count, and cycles through interface values stop.
import { expect } from "velt/test";

interface Shape {
  area(): number;
  next: Shape | null;
}

class Sq implements Shape {
  next: Shape | null = null;
  s: number;
  constructor(s: number) {
    this.s = s;
  }
  area(): number {
    return this.s * this.s;
  }
}

class Animal {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
  speak(): string {
    return this.name;
  }
}

class Dog extends Animal {
  bark: number;
  constructor(name: string, bark: number) {
    super(name);
    this.bark = bark;
  }
  override speak(): string {
    return "woof";
  }
}

function check(name: string, f: () => void) {
  try {
    f();
    console.log(name, "equal");
  } catch (e) {
    console.log(name, "differ");
  }
}

function shapes() {
  const xs: Shape[] = [new Sq(2), new Sq(3)];
  check("shapes", () => expect(xs).toEqual([new Sq(2), new Sq(3)] as Shape[]));
  check("other shapes", () => expect(xs).toEqual([new Sq(2), new Sq(4)] as Shape[]));
  const a = new Sq(1);
  a.next = a;
  const b = new Sq(1);
  b.next = b;
  check("cycles", () => expect(a as Shape).toEqual(b as Shape));
  const c = new Sq(1);
  const d = new Sq(1);
  c.next = d;
  d.next = c;
  check("rings of two lengths", () => expect(a as Shape).toEqual(c as Shape));
}

function animals() {
  const a: Animal = new Dog("rex", 1);
  check("dogs", () => expect(a).toEqual(new Dog("rex", 1) as Animal));
  check("other dogs", () => expect(a).toEqual(new Dog("rex", 2) as Animal));
}

shapes();
animals();
