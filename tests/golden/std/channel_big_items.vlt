// check: no leaks
// Items much bigger than a word (a struct with twelve numbers, a string and a flag) cross a
// channel whole and in order: through a small bounded channel whose queue wraps around many
// times, and through an unbounded one that grows while items are queued and is closed before it
// is drained.
import { Channel, ChannelClosed, channel } from "velt:channel";

struct Reading {
  a: f64;
  b: f64;
  c: f64;
  d: f64;
  e: f64;
  f: f64;
  g: f64;
  h: f64;
  i: f64;
  j: f64;
  k: f64;
  l: f64;
  label: string;
  odd: bool;
}

function reading(n: i64): Reading {
  const x = n as f64;
  return {
    a: x,
    b: x + 1,
    c: x + 2,
    d: x + 3,
    e: x + 4,
    f: x + 5,
    g: x + 6,
    h: x + 7,
    i: x + 8,
    j: x + 9,
    k: x + 10,
    l: x + 11,
    label: `r${n}`,
    odd: n % 2 == 1,
  };
}

function whole(r: Reading, n: i64): boolean {
  const x = n as f64;
  return r.a == x && r.f == x + 5 && r.l == x + 11 && r.label == `r${n}` && r.odd == (n % 2 == 1);
}

async function produce(ch: Channel<Reading>, count: i64): Promise<void> throws ChannelClosed {
  for (let n = 0; n < count; n++) {
    await ch.send(reading(n));
  }
  ch.close();
}

async function main() {
  const bounded = channel<Reading>(3);
  const producer = spawn(produce(bounded, 100));
  let next = 0;
  let intact = 0;
  for await (const r of bounded) {
    if (whole(r, next)) {
      intact++;
    }
    next++;
  }
  await producer;
  console.log("bounded:", next, "received,", intact, "intact");

  const unbounded = channel<Reading>();
  for (let n = 0; n < 20; n++) {
    unbounded.trySend(reading(n));
  }
  unbounded.close();
  console.log("queued:", unbounded.length, "closed:", unbounded.closed);
  let drained = 0;
  let last = "";
  while (true) {
    const r = unbounded.tryReceive();
    if (r == null) {
      break;
    }
    if (whole(r, drained)) {
      drained++;
    }
    last = r.label;
  }
  console.log("unbounded:", drained, "intact, last:", last);
}
