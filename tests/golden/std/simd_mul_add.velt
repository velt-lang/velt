// `mulAdd` rounds once (fused multiply-add) on every CPU and in debug and release builds;
// `mulAddFast` may or may not fuse. (1 + 2^-27)(1 - 2^-27) - 1 is -2^-54 exactly, which a
// separate multiply rounds away to 0 (and (1 + 2^-13)(1 - 2^-13) - 1 for f32).
import { f32x4, f64x2 } from "velt/simd";

function f64s() {
  const a = f64x2.splat(1 + 2 ** -27).withLane(1, 3);
  const b = f64x2.splat(1 - 2 ** -27).withLane(1, 5);
  const c = f64x2.splat(-1).withLane(1, 7);
  const fused = a.mulAdd(b, c);
  console.log("f64 mulAdd", fused.lane(0), fused.lane(1));
  const fast = a.mulAddFast(b, c);
  console.log("f64 mulAddFast", fast.lane(0) == 0 || fast.lane(0) == fused.lane(0), fast.lane(1));
  const inf = f64x2.splat(Infinity).mulAdd(f64x2.splat(0), f64x2.splat(1));
  console.log("f64 Infinity * 0 + 1 is NaN", Number.isNaN(inf.lane(0)));
}

function f32s() {
  const a = f32x4.splat((1 + 2 ** -13) as f32).withLane(1, 3).withLane(2, -0.5).withLane(3, 2);
  const b = f32x4.splat((1 - 2 ** -13) as f32).withLane(1, 5).withLane(2, 0).withLane(3, 3e38);
  const c = f32x4.splat(-1).withLane(1, 7).withLane(2, 0).withLane(3, -3e38);
  const fused = a.mulAdd(b, c);
  // Lane 2: -0.5 * 0 + 0 is +0; lane 3: 2 * 3e38 overflows f32, but not before the add.
  console.log("f32 mulAdd", fused.lane(0), fused.lane(1), 1 / fused.lane(2), fused.lane(3));
  const fast = a.mulAddFast(b, c);
  console.log("f32 mulAddFast", fast.lane(0) == 0 || fast.lane(0) == fused.lane(0), fast.lane(1));
}

function main() {
  f64s();
  f32s();
}
