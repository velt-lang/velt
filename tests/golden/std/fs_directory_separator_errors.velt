// A directory named with the system's separator after it (`dir\` on Windows, `dir/` elsewhere)
// fails as a file the same way the plain name does, as in Node: a read and a mapping report
// EISDIR, and a write reports the failed `open` with the path (#3386: on Windows the open of
// `dir\` fails with another code than the plain name's "access denied"). Node names the path
// resolved on Windows (`C:\work\dir`, without the separator), and as given elsewhere (`dir/`):
// on Windows the message is printed relative, with `/`, and the separator put back, so the
// output is the same on every system.
import { MappedFile, mkdirSync, readFileSync, removeSync, writeFileSync } from "velt/fs";
import { IoError } from "velt/io";
import { platform } from "velt/os";
import { cwd } from "velt/process";

function report(e: unknown) {
  const err = e as IoError;
  let m = err.message;
  if (platform() == "win32") {
    m = m.split(`${cwd()}\\`).join("").replaceAll("\\", "/").replaceAll("_tmp'", "_tmp/'");
  }
  console.log(err instanceof IoError, err.code, m);
}

function main() {
  const dir = "velt_fs_directory_separator_tmp";
  const named = dir + (platform() == "win32" ? "\\" : "/");
  mkdirSync(dir, { recursive: true });
  try {
    readFileSync(named);
  } catch (e) {
    report(e);
  }
  try {
    writeFileSync(named, "x");
  } catch (e) {
    report(e);
  }
  try {
    MappedFile.open(named);
  } catch (e) {
    report(e);
  }
  removeSync(dir, { recursive: true });
}
