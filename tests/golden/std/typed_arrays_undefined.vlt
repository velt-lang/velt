// A typed array's `at`, `find` and `findLast` give `undefined` where nothing is found, as in
// JavaScript (std/typed_array is generated by scripts/gen-typed-arrays.py, which keeps that).
function main() {
  const u = new Uint8Array([1, 2, 3]);
  const f = new Float64Array([0.5, 1.5]);
  const i = new Int16Array([-1, 7]);
  console.log(u.at(99) === undefined, u.at(-1), u.at(-4));
  console.log(f.find((x) => x > 9) === undefined, f.find((x) => x > 1));
  console.log(i.findLast((x) => x > 100) === undefined, i.findLast((x) => x < 0));
  const a: number | undefined = u.at(5);
  console.log(a ?? "none", typeof a);
  console.log(new Uint32Array(0).at(0), new Int8Array(2).find((x) => x !== 0));
}
