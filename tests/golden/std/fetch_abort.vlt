// check: no leaks
// An `AbortSignal` cancels a `fetch`: before it starts, while it waits for the response, and
// while the body is received (`fetch` resolves once the headers are in, as in JS). A timeout
// signal rejects with `TimeoutError`. Events are ordered by signals, not by sleeps: the server
// reports each request's arrival and holds it until the client is done.
import { utf8Encode } from "velt:encoding";
import { BodyStream } from "velt:fetch";
import { serve } from "velt:http";
import { AbortError, AbortSignal, TimeoutError } from "velt:task";

// The body of `/stream`: a first part, then nothing until `release` is aborted.
async function* parts(release: AbortSignal): AsyncGenerator<u8[]> {
  yield utf8Encode("first part ");
  await release.whenAborted();
  yield utf8Encode("never read");
}

async function main() {
  const arrived = new AbortController();
  const release = new AbortController();
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    if (new URL(req.url).pathname == "/stream") {
      return new Response(BodyStream.from(parts(release.signal)));
    }
    arrived.abort("arrived");
    await release.signal.whenAborted();
    return new Response("late");
  });
  const base = `http://127.0.0.1:${server.port}`;

  // Already aborted: rejected at once, nothing is sent.
  const early = new AbortController();
  early.abort("not needed");
  try {
    await fetch(`${base}/hang`, { signal: early.signal });
  } catch (e) {
    console.log("before:", e instanceof AbortError, e.message);
  }

  // Aborted while the server holds the request.
  const ac = new AbortController();
  const pending = fetch(`${base}/hang`, { signal: ac.signal });
  await arrived.signal.whenAborted();
  ac.abort("user cancelled");
  try {
    await pending;
  } catch (e) {
    console.log("waiting:", e instanceof AbortError, e.message);
  }

  // A timeout signal.
  try {
    await fetch(`${base}/hang`, { signal: AbortSignal.timeout(30) });
  } catch (e) {
    console.log("timeout:", e instanceof TimeoutError, e.message);
  }

  // Aborted while the body is received.
  const body = new AbortController();
  const res = await fetch(`${base}/stream`, { signal: body.signal });
  console.log("headers:", res.status, res.headers.get("transfer-encoding"));
  const text = res.text();
  body.abort("enough");
  try {
    await text;
  } catch (e) {
    console.log("body:", e instanceof AbortError, e.message);
  }
  release.abort();
  await server.shutdown();
  console.log("done");
}
