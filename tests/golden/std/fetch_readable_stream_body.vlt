// check: no leaks
// A `ReadableStream` of `Uint8Array` chunks is a body (#1129): read whole, read again as a
// stream, and a chunk of another type fails the read as in Node. Valid TypeScript; prints what
// Node 22 prints.

async function* parts(): AsyncGenerator<Uint8Array> {
  yield new TextEncoder().encode("one ");
  yield new TextEncoder().encode("two");
}

async function main() {
  const stream: ReadableStream<Uint8Array> = ReadableStream.from(parts());
  const res = new Response(stream, { status: 201, headers: { "x-kind": "stream" } });
  console.log(res.status, res.headers.get("x-kind"), res.bodyUsed);
  console.log(await res.text(), res.bodyUsed);

  // Chunk by chunk through `body`.
  const again = new Response(ReadableStream.from(parts()));
  const body = again.body;
  const seen: string[] = [];
  if (body != null) {
    for await (const chunk of body) {
      seen.push(new TextDecoder().decode(chunk));
    }
  }
  console.log(seen.join("|"));

  const bad = new ReadableStream<string>({
    start(c) {
      c.enqueue("not bytes");
      c.close();
    },
  });
  try {
    await new Response(bad).text();
    console.log("unexpected");
  } catch (e) {
    console.log("bad chunk:", e.message);
  }
}
