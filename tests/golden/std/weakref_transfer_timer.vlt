// A timer callback that is a function value whose closure owns a WeakRef: the timer's task
// would run it on another thread, so handing it over panics.
import { setTimeout } from "velt:timers";
class V { n: number; constructor(n: number) { this.n = n; } }
async function tick(r: WeakRef<V>): Promise<void> { const x = r.deref(); console.log(x === undefined ? -1 : x.n); }
function task(keep: V): () => Promise<void> { const r = new WeakRef(keep); return () => tick(r); }
async function main() {
  const keep = new V(7);
  console.log("before");
  setTimeout(task(keep), 0);
  await sleep(10);
  console.log(keep.n);
}
