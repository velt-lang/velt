}
function f(): void {
  class D {
    w: number = (globalThis as H)[L3]!;
  }
  try {
    console.log(new D().w);
  } catch (e) {
    console.log("caught", (e as Error).name);
  }
  const L3 = "__KB__";
  console.log("end", L3);
}
const top = (globalThis as H)[TOP];
const TOP = "__KB__";
console.log(typeof inFn, typeof f, typeof Early, typeof direct, typeof inBlock, typeof casted, typeof later, typeof laterFn, top);
