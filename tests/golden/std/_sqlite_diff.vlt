// Differential checks of the Velt SQLite engine (velt/sqlite/engine) against C SQLite
// (velt/sqlite) on the same file: each query's rows, every value as `quote()` gives it, must be
// the same, in the same order when the query orders them; an error must have the same message.
import { Database as CDatabase } from "velt/sqlite";
import { Database, SqliteError } from "velt/sqlite/engine";
import { quote } from "velt/sqlite/exec/func";

struct Line {
  line: string;
}

/** The rows of `sql` in the Velt engine, each value quoted, or "error: <message>". */
export function veltRows(db: Database, sql: string): string[] {
  const out: string[] = [];
  try {
    const st = db.prepare(sql);
    const vals = st.values();
    const n = st.columns().length as usize;
    const rows: usize = n == 0 ? 0 : (vals.length as usize) / n;
    for (let r: usize = 0; r < rows; r++) {
      const parts: string[] = [];
      for (let i: usize = 0; i < n; i++) {
        parts.push(quote(vals[r * n + i]));
      }
      out.push(parts.join("|"));
    }
  } catch (e) {
    return [`error: ${e.message}`];
  }
  return out;
}

/** The rows of `sql` in C SQLite (`n` columns), quoted the same way. */
export function cRows(db: CDatabase, sql: string, n: usize): string[] {
  const names: string[] = [];
  const quoted: string[] = [];
  for (let i: usize = 0; i < n; i++) {
    names.push(`c${i}`);
    quoted.push(`quote(c${i})`);
  }
  const wrapped =
    n == 0
      ? sql
      : `WITH q(${names.join(",")}) AS (${sql}) SELECT ${quoted.join(" || '|' || ")} AS line FROM q`;
  try {
    const rows: Line[] = db.prepare(wrapped).all();
    return rows.map((r) => r.line);
  } catch (e) {
    // velt/sqlite adds where in the SQL the error is.
    const m = e.message;
    const at = m.indexOf(" in ");
    return [`error: ${at >= 0 ? m.slice(0, at) : m}`];
  }
}

/** The message C SQLite gives preparing `sql`, or "" when it compiles. */
function cPrepare(db: CDatabase, sql: string): string {
  try {
    db.prepare(sql);
    return "";
  } catch (e) {
    const m = e.message;
    const at = m.indexOf(" in ");
    return `error: ${at >= 0 ? m.slice(0, at) : m}`;
  }
}

/**
 * Compares `sql` in both engines; "" when they agree, else a report. Rows compare in order when
 * `ordered`, else as sorted lists.
 */
export function compare(c: CDatabase, v: Database, sql: string, ordered: bool): string {
  let n: usize = 0;
  try {
    n = v.prepare(sql).columns().length as usize;
  } catch (e) {
    const mine = `error: ${e.message}`;
    const theirs = cPrepare(c, sql);
    if (theirs == mine) {
      return "";
    }
    return `${sql}\n  velt: ${mine}\n  C:    ${theirs == "" ? "ok" : theirs}`;
  }
  const mine = veltRows(v, sql);
  const prepared = cPrepare(c, sql);
  if (prepared != "") {
    return `${sql}\n  velt: prepared\n  C:    ${prepared}`;
  }
  let theirs = cRows(c, sql, n);
  const mineErr = mine.length == 1 && mine[0].startsWith("error: ");
  const theirErr = theirs.length == 1 && theirs[0].startsWith("error: ");
  if (mineErr && theirErr) {
    // A failure while running (velt/sqlite reports it as a row that does not decode).
    return "";
  }
  let a = mine;
  if (!ordered) {
    a = mine.toSorted();
    theirs = theirs.toSorted();
  }
  if (a.join("\n") == theirs.join("\n")) {
    return "";
  }
  // The first row that differs, and the rows around it.
  let at: i64 = 0;
  while (at < (a.length as i64) && at < (theirs.length as i64) && a[at] == theirs[at]) {
    at++;
  }
  const from = at > 2 ? at - 2 : 0;
  return `${sql}\n  rows ${a.length} vs ${theirs.length}, from row ${from}:\n  velt: ${a.slice(from, from + 6).join(" ; ")}\n  C:    ${theirs.slice(from, from + 6).join(" ; ")}`;
}

/** Whether a query's top level orders its rows (an ORDER BY outside parentheses at the end). */
export function isOrdered(sql: string): bool {
  let depth = 0;
  let last: i64 = -1;
  const u = sql.toUpperCase();
  for (let i: i64 = 0; i < (u.length as i64); i++) {
    const ch = u.charCodeAt(i);
    if (ch == 40) {
      depth++;
    } else if (ch == 41) {
      depth--;
    } else if (depth == 0 && u.slice(i, i + 8) == "ORDER BY") {
      last = i;
    }
  }
  return last >= 0;
}

/** Runs each query in both engines and prints the ones that differ; then a summary line. */
export function checkAll(label: string, c: CDatabase, v: Database, queries: string[]) {
  let bad = 0;
  for (const q of queries) {
    const r = compare(c, v, q, isOrdered(q));
    if (r != "") {
      bad++;
      console.log(r);
    }
  }
  console.log(
    `${label}: ${queries.length} queries, ${bad == 0 ? "all the same" : bad + " differ"}`,
  );
}
