// Accessors defined after construction (#922): `Object.defineProperty(o, "k", { get, set })` on
// a literal of an interface declaring the accessor replaces its getter or setter, as in Node.
interface Cell<T> {
  get value(): T;
  set value(v: T);
  readonly label: string;
}

function cell<T>(initial: T, setter?: (v: T) => void): Cell<T> {
  let current = initial;
  const c: Cell<T> = {
    get value(): T {
      return current;
    },
    set value(v) {
      current = v;
    },
    label: "cell",
  };
  if (setter) {
    Object.defineProperty(c, "value", {
      get(): T {
        return current;
      },
      set(v: T) {
        setter(v);
      },
      enumerable: true,
      configurable: true,
    });
  }
  return c;
}

const plain = cell(1);
plain.value = 2;
console.log(plain.value, plain.label);
const logged = cell("a", (v) => console.log("set", v));
logged.value = "b";
console.log(logged.value);

// A getter only: the setter stays.
interface Counter {
  get n(): number;
  set n(v: number);
}

function counter(): Counter {
  let n = 0;
  const c: Counter = {
    get n() {
      return n;
    },
    set n(v) {
      n = v;
    },
  };
  Object.defineProperty(c, "n", { get: () => n * 10 });
  return c;
}

const k = counter();
k.n = 3;
console.log(k.n);

// Not configurable: defining it again throws.
function fixed(times: number): number {
  let n = 1;
  const c: Counter = {
    get n() {
      return n;
    },
    set n(v) {
      n = v;
    },
  };
  for (let i = 0; i < times; i++) {
    Object.defineProperty(c, "n", { get: () => n + i, configurable: false });
  }
  return c.n;
}

console.log(fixed(1));
try {
  fixed(2);
} catch (e) {
  console.log(String(e));
}

// An indexed access type reads an interface's getter.
type Value = Cell<string>["value"];
const v: Value = "typed";
console.log(v);

// Without `configurable`, a definition keeps the property's: the literal's accessor is
// configurable, so defining it again, twice or in a loop, doesn't throw.
function twice(): number {
  let n = 1;
  const c: Counter = {
    get n() {
      return n;
    },
    set n(v) {
      n = v;
    },
  };
  Object.defineProperty(c, "n", { get: () => n + 10 });
  Object.defineProperty(c, "n", { get: () => n + 20 });
  for (let i = 0; i < 3; i++) {
    Object.defineProperty(c, "n", { get: () => n + 100 * i });
  }
  return c.n;
}

console.log(twice());

interface Pair {
  get k(): number;
  set k(v: number);
}

// A shorthand descriptor: `{ get }` is `{ get: get }`.
function shorthand(): Pair {
  let n = 1;
  const o: Pair = {
    get k() {
      return n;
    },
    set k(v) {
      n = v;
    },
  };
  const get = () => 42;
  const set = (v: number) => {
    n = v * 2;
  };
  Object.defineProperty(o, "k", { get });
  Object.defineProperty(o, "k", { set });
  o.k = 5;
  console.log(n);
  return o;
}

console.log(shorthand().k);

// A local `Object` is the program's own.
function ownObject(): number {
  const Object = {
    defineProperty: (o: Pair, key: string, d: { get: () => number }): void => {
      console.log("own defineProperty", key, d.get());
    },
  };
  const o: Pair = {
    get k() {
      return 1;
    },
    set k(v) {},
  };
  Object.defineProperty(o, "k", { get: () => 2 });
  return o.k;
}

console.log(ownObject());
