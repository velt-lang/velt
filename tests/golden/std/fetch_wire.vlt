// check: no leaks
// The `fetch` client against a server that writes HTTP/1.1 by hand (velt:net): a chunked body
// with extensions and a trailer, a `100 Continue` before the response, a body that ends with the
// connection, a response written a byte at a time, reason phrases, keep-alive connections
// reused, a pooled connection the server closed (never used again: a GET and a POST both go out
// on a new connection, as in Node), a
// chunked gzip body read whole and as it arrives, and a response that is not HTTP.
import { connect, listen, TcpStream } from "velt:net";
import { hexDecode } from "velt:encoding";
import { IoError } from "velt:io";
import { Channel, channel } from "velt:channel";

let accepted = 0;

// "hello gzip" in gzip.
const GZIP = "1f8b08000000000002ffcb48cdc9c95748afca2c0000196ad2df0a000000";

const RESPONSES: Map<string, string> = new Map([
  [
    "/chunked",
    "HTTP/1.1 200 OK\r\ntransfer-encoding: chunked\r\n\r\n5;ext=1\r\nhello\r\n6\r\n world\r\n0\r\nx-trailer: t\r\n\r\n",
  ],
  ["/continue", "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nok"],
  ["/reason", "HTTP/1.1 299 Custom Reason\r\ncontent-length: 0\r\n\r\n"],
  ["/no-reason", "HTTP/1.1 404 \r\ncontent-length: 0\r\n\r\n"],
  ["/keep", "HTTP/1.1 200 OK\r\ncontent-length: 4\r\n\r\nkept"],
  ["/stale", "HTTP/1.1 200 OK\r\ncontent-length: 5\r\n\r\nstale"],
  ["/garbage", "SMTP is not HTTP\r\n\r\n"],
]);

async function serveOne(conn: TcpStream, closed: Channel<string>) {
  let input = "";
  while (true) {
    const end = input.indexOf("\r\n\r\n");
    if (end < 0) {
      const more = await conn.readString();
      if (more == "") {
        break;
      }
      input += more;
      continue;
    }
    const line = input.slice(0, input.indexOf("\r\n"));
    input = input.slice(end + 4);
    const path = line.split(" ")[1];
    if (path == "/close") {
      await conn.write("HTTP/1.1 200 OK\r\n\r\nuntil the end");
      break;
    }
    if (path == "/pieces") {
      for (const c of "HTTP/1.1 200 OK\r\ncontent-length: 6\r\n\r\npieces") {
        await conn.write(c);
      }
      continue;
    }
    if (path == "/gzip") {
      const body = hexDecode(GZIP);
      await conn.write(
        "HTTP/1.1 200 OK\r\ncontent-encoding: gzip\r\ntransfer-encoding: chunked\r\n\r\n",
      );
      for (let i: i64 = 0; i < (body.length as i64); i += 7) {
        const piece = body.slice(i, i + 7);
        await conn.write(`${piece.length.toString(16)}\r\n`);
        await conn.writeBytes(piece);
        await conn.write("\r\n");
      }
      await conn.write("0\r\n\r\n");
      continue;
    }
    await conn.write(RESPONSES.get(path) ?? "HTTP/1.1 500 Unknown\r\ncontent-length: 0\r\n\r\n");
    if (path == "/stale" || path == "/garbage") {
      conn.close();
      await closed.send(path);
      return;
    }
  }
  conn.close();
}

async function main() {
  const listener = await listen("127.0.0.1:0");
  const base = `http://127.0.0.1:${listener.port}`;
  // What the server closed without saying so, as it closes it.
  const closed = channel<string>(4);
  spawn(async () => {
    while (true) {
      let conn: TcpStream;
      try {
        conn = await listener.accept();
      } catch (e) {
        return;
      }
      accepted += 1;
      spawn(serveOne(conn, closed));
    }
  });

  const chunked = await fetch(`${base}/chunked`);
  console.log(chunked.status, chunked.headers.get("transfer-encoding"), await chunked.text());
  console.log("continue:", (await fetch(`${base}/continue`)).status);
  const reason = await fetch(`${base}/reason`);
  console.log(reason.status, reason.statusText, reason.ok);
  console.log((await fetch(`${base}/no-reason`)).statusText);
  console.log("close:", await (await fetch(`${base}/close`)).text());
  console.log("pieces:", await (await fetch(`${base}/pieces`)).text());

  // Three requests in turn: one connection.
  const before = accepted;
  for (let i = 0; i < 3; i++) {
    await (await fetch(`${base}/keep`)).text();
  }
  console.log("new connections for three requests:", accepted - before);

  // The server closes the connection after `/stale`, without saying so. Taken from the pool, the
  // connection is found closed (or, if the close arrives later, a GET that fails before any
  // response is sent again): the next request goes out on a new connection. A POST, which may
  // not be sent twice, too: the client checks every pooled connection before using it.
  console.log(await (await fetch(`${base}/stale`)).text());
  console.log("after stale:", await (await fetch(`${base}/keep`)).text());
  await (await fetch(`${base}/stale`)).text();
  await closed.receive();
  try {
    const res = await fetch(`${base}/keep`, { method: "POST", body: "x" });
    console.log("post after stale:", await res.text());
  } catch (e) {
    console.log("post failed:", e.message);
  }

  console.log("gzip:", await (await fetch(`${base}/gzip`)).text());
  const streamed = await fetch(`${base}/gzip`);
  const parts: string[] = [];
  const body = streamed.body;
  if (body != null) {
    for await (const chunk of body) {
      parts.push(new TextDecoder().decode(chunk));
    }
  }
  console.log("gzip streamed:", parts.join(""));

  try {
    await fetch(`${base}/garbage`);
  } catch (e) {
    console.log("garbage:", e instanceof IoError ? e.code : "", e.message);
  }
  await closed.receive();
  closed.close();
  listener.close();
}
