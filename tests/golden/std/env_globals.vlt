// Environment checks as Node 22 answers them (#922).
class Widget {}
const isServer = typeof window === "undefined";
console.log(isServer, typeof document, typeof HTMLElement, typeof globalThis);
console.log(typeof URL, typeof Widget, typeof navigator, typeof Event, typeof Math, typeof Map);
console.log(typeof window !== "undefined", typeof URL !== "undefined", typeof requestAnimationFrame === "function");
function boundaries(): string {
  return typeof window !== "undefined" ? String((window as unknown as { name: string }).name) : "server";
}
console.log(boundaries());
function readWindow(): string {
  try {
    return String(window);
  } catch (e) {
    return `${(e as Error).name}: ${(e as Error).message}`;
  }
}
console.log(readWindow());
