// requires: unix
// `readSync` and `writeSync` coerce `offset`, `length` and `position` as Node does: `length`
// truncated to a 32-bit integer for a read and used as-is for a write, left out is the rest of
// the buffer, `null` reads 0; a read's position is validated strictly, a write's bad position
// falls back to the file's own. This program prints what `node` prints for it ("node:fs").
import * as fs from "velt:fs";

function attempt(f: () => string) {
  try {
    console.log(f());
  } catch (e) {
    console.log(e.name, e.message);
  }
}

function bytes(s: string): u8[] {
  const b: u8[] = Buffer.alloc(Buffer.byteLength(s));
  b.write(s);
  return b;
}

function main() {
  const path = "velt_fs_fd_coerce_tmp.bin";
  const seed = fs.openSync(path, "w");
  fs.writeSync(seed, bytes("hello world!!"), 0, 13, 0);
  fs.closeSync(seed);

  const fd = fs.openSync(path, "r");
  const b: u8[] = Buffer.alloc(8);
  console.log(fs.readSync(fd, b, 0, null, 0));
  console.log(fs.readSync(fd, b, 0, 1.5, 0), b[0]);
  console.log(fs.readSync(fd, b, 0, 4294967296, 0));
  console.log(fs.readSync(fd, b, 0, 4294967299, 0));
  console.log(fs.readSync(fd, b, 2, 3, 0), b.utf8Slice(2, 5));
  console.log(fs.readSync(fd, b, 17, 0, 0));
  attempt(() => `${fs.readSync(fd, b, 0, -1, 0)}`);
  attempt(() => `${fs.readSync(fd, b, 0, 4, 1.5)}`);
  attempt(() => `${fs.readSync(fd, b, 0, 4, -2)}`);
  console.log(fs.readSync(fd, b, 0, 4, null), b.utf8Slice(0, 4));
  fs.closeSync(fd);

  const w = fs.openSync(path, "r+");
  console.log(fs.writeSync(w, bytes("ABCDEFGH"), 0, null, 0));
  console.log(fs.writeSync(w, bytes("xy"), 0, 2, 1.5));
  console.log(fs.writeSync(w, bytes("zz"), 0, 2, -2));
  attempt(() => `${fs.writeSync(w, b, 12)}`);
  attempt(() => `${fs.writeSync(w, b, 0, 4294967296, 0)}`);
  fs.closeSync(w);

  const back = fs.openSync(path, "r");
  const all: u8[] = Buffer.alloc(13);
  const n = fs.readSync(back, all, 0, 13, 0);
  console.log(all.utf8Slice(0, n as number));
  fs.closeSync(back);
  fs.unlinkSync(path);
}
