function values(): void {
  const n: number = 257;
  const b: u8[] = [0, 0];
  const r = (b[0] = n);
  const s = (b[1] += n);
  console.log(r, s, b[0], b[1]);
  const c: i8[] = [0, 0];
  const t = (c[0] = c[1] = 200.5);
  const w = (c[1] <<= 9);
  console.log(t, w, c[0], c[1]);
  const d: u16[] = [0];
  const x = (d[0] = -1);
  console.log(x, d[0]);
}

function literals(): void {
  const b = Buffer.alloc(3);
  b[0] = 256;
  b[1] = -1;
  b[2] = 3.9;
  console.log(b[0], b[1], b[2]);
  const f = Buffer.from([257, -1, 3.9]);
  console.log(f.join(","));
  const g: i16[] = [40000, -40000, 1.5, -0.5, 7];
  console.log(g.join(","));
}

function more(): void {
  const a: u8[] = [0, 0, 0, 0, 0, 0, 0];
  a[0] = 1 << 9;
  a[1] = -7 / 2;
  a[2] = -0;
  a[3] = -(0);
  a[4] = -(-1);
  a[5] = 2 * 200;
  a[6] = ~5;
  console.log(`u8 literal expressions: ${a.join(",")}`);
  const c: i8[] = [0, 0, 0, 0];
  c[0] = 1 << 9;
  c[1] = 200 + 100;
  c[2] = 255 + 1;
  c[3] = 2 * 200;
  console.log(`i8 literal expressions: ${c.join(",")}`);
  const w: u16[] = [0];
  const x: u32[] = [0];
  w[0] = -7 / 2;
  x[0] = -7 / 2;
  console.log(`u16, u32 -7 / 2: ${w[0]} ${x[0]}`);
  const v: u8[] = [0, 255];
  const r1 = (v[1] += 1);
  const r2 = (v[0] -= 1);
  console.log(`u8 op= as values: ${r1} ${r2} ${v.join(",")}`);
  const u: u8[] = [0, 255];
  const p1 = ++u[1];
  const p2 = --u[0];
  console.log(`u8 ++/-- as values: ${p1} ${p2} ${u.join(",")}`);
  const s8: i8[] = [127];
  const s32: u32[] = [4294967295];
  const q1 = (s8[0] += 1);
  const q2 = (s32[0] += 1);
  console.log(`ends as values: ${q1} ${q2} ${s8[0]} ${s32[0]}`);
  const m32: u32[] = [4294967295];
  m32[0] *= 2097153;
  const n32: i32[] = [2147483647];
  n32[0] *= 4194305;
  console.log(`32-bit wide products: ${m32[0]} ${n32[0]}`);
}

function main(): void {

  u8Rows();
  i8Rows();
  u16Rows();
  i16Rows();
  u32Rows();
  i32Rows();
  values();
  literals();
  more();
}

main();
