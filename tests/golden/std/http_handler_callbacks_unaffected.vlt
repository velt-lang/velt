// What an HTTP handler reaches is only an error when a callback it calls assigns a variable that
// callback captured (#873): callbacks that only read, a render function, a pool, closures each
// request makes for itself, a callback stored in a field no request reads (called in `main`),
// and a `() => void` that assigns while the handler calls `() => string` values (a closure
// returning nothing is never one of those) all compile and run.
import { serve } from "velt:http";

class Input {
  onChange: (v: string) => void = (v) => {};
}

class Widget {
  name = "w";
  onClick: () => void = () => {};
}

class Emitter {
  listeners: ((name: string) => void)[] = [];
  on(f: (name: string) => void) {
    this.listeners.push(f);
  }
  emit(name: string) {
    for (const l of this.listeners) {
      l(name);
    }
  }
}

class Pool {
  conns: string[] = ["a", "b"];
  pick(i: number): string {
    return this.conns[i % 2];
  }
}

async function main() {
  const prefix = "p";
  const i = new Input();
  i.onChange = (v: string) => {
    if (`${prefix}${v}`.length > 100) {
      console.log("long");
    }
  };
  let clicks = 0;
  const w = new Widget();
  w.onClick = () => {
    clicks++;
  };
  w.onClick();
  const render = (s: string): string => `<b>${s}</b>`;
  const pool = new Pool();
  const hits = shared(0);
  let configured = 0;
  const setupSteps: (() => void)[] = [];
  setupSteps.push(() => {
    configured++;
  });
  for (const step of setupSteps) {
    step();
  }
  const routes = new Map<string, () => string>();
  routes.set("/", () => "home");
  const requests = new Emitter();
  requests.on((name: string) => {
    if (routes.size > 5) {
      console.log(name);
    }
  });
  const a = await serve({ port: 0 }, async (req) => {
    requests.emit("request");
    const r = routes.get("/");
    let mine = 0;
    const bump = () => {
      mine += 1;
    };
    bump();
    i.onChange("x");
    hits.add(1);
    return new Response(render(`${pool.pick(mine)}${r === null ? "" : r()}${w.name}`));
  });
  for (let k = 0; k < 3; k++) {
    console.log(await (await fetch(`http://127.0.0.1:${a.port}/`)).text());
  }
  await a.shutdown();
  console.log(clicks, hits.get(), configured);
}
