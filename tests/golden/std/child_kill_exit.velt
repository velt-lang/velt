// A child's exit code: its own, or after `kill` the one a POSIX shell gives a death by that
// signal (128 + the signal), on Windows too, where `kill` terminates it (Node reports the signal
// there as well); a `kill` after the child ended does nothing; a negative exit code reads
// unsigned, as Node reads a Windows one. Also a child started in another working directory, and
// one whose stdin and output are the null device. The child is this very program, selected by
// its argument.
import { exec, execSync, spawn } from "velt/process/child";
import { argv, args, readAll } from "velt/process";
import { readDirSync } from "velt/fs";

async function child(mode: string): Promise<i32> {
  if (mode == "wait") {
    await readAll();
    return 0;
  }
  if (mode == "code") {
    return 42;
  }
  if (mode == "negative") {
    return -1;
  }
  if (mode == "ls") {
    console.log(readDirSync(".").includes(args()[1]));
    return 0;
  }
  if (mode == "quiet") {
    const input = await readAll();
    console.log(`read ${input.length}`);
    console.error("to stderr");
    return 5;
  }
  return 1;
}

async function parent(self: string) {
  const t = spawn(self, ["wait"], { stdin: "pipe" });
  console.log(`running ${t.exitCode == null}`);
  t.kill();
  console.log(`SIGTERM ${await t.wait()} ${t.exitCode}`);
  t.close();

  const k = spawn(self, ["wait"], { stdin: "pipe" });
  k.kill("SIGKILL");
  console.log(`SIGKILL ${await k.wait()} ${k.exitCode}`);
  k.close();

  const c = spawn(self, ["code"]);
  console.log(`own ${await c.wait()}`);
  c.kill();
  console.log(`after ${await c.wait()} ${c.exitCode}`);
  c.close();

  // -1 is 255 on macOS and Linux, 4294967295 on Windows (where Node reports it unsigned too).
  // `exitCode` reads it so as well: a crashed child (0xC0000005) does not read as still running.
  const n = spawn(self, ["negative"]);
  const ran = await exec(self, ["negative"]);
  const ranSync = execSync(self, ["negative"]);
  const waited = await n.wait();
  console.log(`negative ${waited > 0} ${ran.code > 0} ${ranSync.code > 0} ${n.exitCode === waited}`);
  n.close();

  const fwd = self.lastIndexOf("/");
  const back = self.lastIndexOf("\\");
  const slash = fwd > back ? fwd : back;
  const dir = self.slice(0, slash);
  const name = self.slice(slash + 1);
  const r = await exec(self, ["ls", name], { cwd: dir });
  console.log(`cwd ${r.code} ${r.stdout.trim()}`);

  const q = spawn(self, ["quiet"], { stdin: "ignore", stdout: "ignore", stderr: "ignore" });
  console.log(`ignored ${await q.wait()}`);
  q.close();
}

async function main(): Promise<i32> {
  const a = args();
  if (a.length > 0) {
    return await child(a[0]);
  }
  await parent(argv()[0].clone());
  return 0;
}
