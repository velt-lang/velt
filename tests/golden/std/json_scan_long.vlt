// velt:json/scan's sixteen-byte string scan (#1658): random strings long enough for whole
// blocks, mixing ASCII, two-, three- and four-byte characters, escapes and lone surrogates at
// every offset. The UTF-16 length the scanner counts, and the text it decodes, must be the
// string's own, and `JSON.parse<string>` must give the string back.
import { Scanner } from "velt:json/scan";

let seed: u64 = 1658;

function next(n: u64): u64 {
  seed = seed * 6364136223846793005 + 1442695040888963407;
  return (seed >> 33) % n;
}

function piece(): string {
  const k = next(12);
  if (k < 5) {
    return String.fromCharCode((0x20 + next(0x5e)) as number);
  }
  if (k == 5) {
    return "é";
  }
  if (k == 6) {
    return "日本";
  }
  if (k == 7) {
    return "😀";
  }
  if (k == 8) {
    return ["\n", "\"", "\\", "\t", "\u0001"][next(5) as usize];
  }
  if (k == 9) {
    return String.fromCharCode((0xd800 + next(0x800)) as number);
  }
  if (k == 10) {
    return "한국어";
  }
  return "abcdefghijklmnopqrstuvwxyz".slice(0, next(27) as number);
}

function main() {
  let bad = 0;
  for (let c = 0; c < 20000; c++) {
    let s = "";
    const parts = next(60);
    for (let i: u64 = 0; i < parts; i++) {
      s += piece();
    }
    const text = JSON.stringify(s);
    for (const decode of [true, false]) {
      const sc = new Scanner(text);
      if (!sc.string(decode) || sc.units != (s.length as usize) || (decode && sc.text() != s)) {
        bad++;
        if (bad <= 5) {
          console.log("mismatch", text, sc.units, s.length);
        }
      }
    }
    if (JSON.parse<string>(text) != s) {
      bad++;
    }
  }
  console.log("mismatches:", bad);
}
