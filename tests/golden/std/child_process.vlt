// Spawns this very program as the child (portable: no shell tools needed), selected by argv.
import { exec, execSync, spawn } from "velt:child_process";
import { argv, args, env } from "velt:process";
import { readLineSync, readAllSync } from "velt:stdin";

// Child modes (the parent passes one as the first argument).
function child(mode: string): i32 {
  if (mode == "upper") {
    const input = readAllSync();
    console.log(input.toUpperCase().trim());
    console.error("to stderr");
    return 7;
  }
  if (mode == "env") {
    console.log(env("VELT_CHILD_VAR") ?? "unset");
    return 0;
  }
  if (mode == "lines") {
    let n = 0;
    let line = readLineSync();
    while (line != null) {
      n++;
      console.log(`line ${n}: ${line}`);
      line = readLineSync();
    }
    console.log(`${n} lines`);
    return 0;
  }
  return 1;
}

async function parent() {
  const self = argv()[0].clone();
  const r = await exec(self, ["upper"], { input: "hello child\n" });
  console.log(r.code, r.ok, r.stdout.trim(), r.stderr.trim());

  const vars = new Map<string, string>();
  vars.set("VELT_CHILD_VAR", "from parent");
  const e = execSync(self, ["env"], { env: vars });
  console.log(e.stdout.trim());

  const p = spawn(self, ["lines"], { stdin: "pipe", stdout: "pipe" });
  await p.write("first\r\n");
  await p.write("second\n\nlast");
  await p.closeStdin();
  let out = "";
  let chunk = await p.readStdout();
  while (chunk != "") {
    out += chunk;
    chunk = await p.readStdout();
  }
  console.log(out.trim());
  console.log("exit", await p.wait(), p.exitCode ?? -1);
  p.close();

  try {
    const missing = await exec("velt-no-such-program");
    console.log(missing.code);
  } catch (err) {
    console.log(err.code, err.message.startsWith("spawn velt-no-such-program: "));
  }

  const idle = spawn(self, ["lines"], { stdin: "pipe", stdout: "ignore" });
  console.log(idle.pid > 0, idle.exitCode == null);
  idle.kill("SIGKILL");
  console.log("killed", (await idle.wait()) != 0);
  try {
    console.log(await idle.readStdout());
  } catch (err) {
    console.log(err.code);
  }
  idle.close();
}

async function main(): Promise<i32> {
  const a = args();
  if (a.length > 0) {
    return child(a[0]);
  }
  await parent();
  return 0;
}
