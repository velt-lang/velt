// `bytes()` is an `extend` method of `Response` (std/fetch/typed.vlt): a subclass cannot redefine
// it yet, since a call through a `Response` would not reach the subclass's method.
class MyRes extends Response {
  async bytes(): Promise<Uint8Array> {
    return new Uint8Array([9, 9]);
  }
}

async function main() {
  console.log((await new MyRes("x").bytes()).length);
}
