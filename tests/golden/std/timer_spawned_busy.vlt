// A spawned task that runs on without a pause holds back only its own timers: a timer of `main`
// due meanwhile still runs (here it ends the spin), and the spawned task's timer runs once that
// task pauses (#1332).
class Flag {
  set: boolean;
  constructor() {
    this.set = false;
  }
}

async function main() {
  const flag = shared(new Mutex<Flag>(new Flag()));
  const f2 = flag.clone();
  const h = spawn(async () => {
    setTimeout(() => console.log("spawned timer"), 1);
    const s = Date.now();
    while (!f2.with((v) => v.set)) {
      if (Date.now() - s > 10000) {
        console.log("spin gave up");
        return 0;
      }
    }
    // Paused: its timer runs now.
    await sleep(5);
    return 0;
  });
  setTimeout(
    () => {
      console.log("main timer sets the flag");
      flag.with((v) => {
        v.set = true;
      });
    },
    20,
  );
  await h;
  console.log("spawned task done");
}
