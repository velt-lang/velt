// `dotI8At` checks each range against its own array: an offset past the end is a RangeError even
// with nothing to read from there on, and so is a count that reaches past the end.

import { dotI8At } from "velt/simd";

function main() {
  const a: i8[] = [1, 2, 3, 4, 5, 6, 7, 8];
  const b: i8[] = [1, -1, 1, -1];
  console.log(dotI8At(a, 4, b, 0, 4));
  console.log(dotI8At(a, 8, b, 4, 0));
  console.log(dotI8At(a, 6, b, 0, 3));
}
