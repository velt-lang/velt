// A generic helper returns with's result; instantiated with an interface hiding a WeakRef.
class K {
  n: number;
  constructor(n: number) {
    this.n = n;
  }
}

class Box {
  k: K;
  constructor(k: K) {
    this.k = k;
  }
}

interface Peek {
  peek(): number;
}

class H implements Peek {
  r: WeakRef<K>;
  constructor(r: WeakRef<K>) {
    this.r = r;
  }
  peek(): number {
    return 1;
  }
}

function lockWith<T, R>(m: shared<Mutex<T>>, f: (v: T) => R): R {
  return m.with(f);
}

function mkPeek(v: Box): Peek {
  return new H(new WeakRef(v.k));
}

async function main() {
  const m = shared(new Mutex<Box>(new Box(new K(5))));
  const p = lockWith(m, mkPeek);
  console.log(p.peek());
}
