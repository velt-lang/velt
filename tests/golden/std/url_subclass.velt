// A `URL` subclass's overrides are not what the built-in members run on (#3792): the `host`
// setter sets the port without calling the `port` setter, and `toString`, `toJSON`,
// `JSON.stringify` and a template read the URL without calling the `href` getter. `origin` does
// read the `host` getter, as Node's does. The Node twin is url_subclass.mjs.
import { URL } from "velt/net/url";

class Ported extends URL {
  get port(): string {
    console.log("port get");
    return "0";
  }
  set port(v: string) {
    console.log("port set", v);
  }
}

class Hosted extends URL {
  get host(): string {
    console.log("host get");
    return "evil.example";
  }
  get href(): string {
    console.log("href get");
    return "evil:href";
  }
}

class Text extends URL {
  toString(): string {
    return "Text.toString";
  }
}

class Json extends URL {
  toJSON(): string {
    return "Json.toJSON";
  }
}

function main() {
  const p = new Ported("https://a.b:8080/p?q=1#f");
  p.host = "c.d:9090";
  console.log(p.toString());
  p.host = "e.f";
  console.log(p.toString());
  p.host = "g.h:443";
  console.log(p.toString());
  p.port = "1";
  console.log(p.toString(), p.port, p.host);

  const h = new Hosted("https://a.b:8080/p?q=1#f");
  console.log(h.toString());
  console.log(h.toJSON());
  console.log(JSON.stringify({ h }));
  console.log(`${h}`);
  console.log(String(h));
  console.log(h.origin);
  console.log(h.href, h.host, h.hostname);
  // `console.log` reads the getters, and names a subclass by its class, as Node does; past the
  // depth limit the base's name follows.
  console.log(h);
  console.log({ t: new Text("https://a.b/?q=1") });
  console.log({ a: { b: { c: new Text("https://a.b/") } } });

  const t = new Text("https://a.b/");
  console.log(t.toJSON(), t.href, `${t}`, JSON.stringify(t));
  const j = new Json("https://a.b/");
  console.log(j.toString(), j.href, `${j}`, JSON.stringify(j));
}
