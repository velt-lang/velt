// Pings answered while nothing is written (the flusher is stuck on a peer that reads nothing):
// the reader goes on until more than the high-water mark of pongs waits, then stops reading
// until the flusher takes them, and goes on again.
import { connect, listen } from "velt:net";
import { OP_CLOSE } from "velt:websocket/frame";
import { HIGH_WATER, SendQueue } from "velt:websocket/queue";
import { PING, Reader, Step } from "velt:websocket/reader";
import { other } from "velt:websocket/receive";
import { TimeoutError, timeout } from "velt:task";

async function main() {
  const listener = await listen("127.0.0.1:0");
  const peer = spawn(async () => await listener.accept());
  const stream = await connect(`127.0.0.1:${listener.port}`);
  const silent = await peer;

  const tx = shared(new Mutex<SendQueue>(new SendQueue(false, new Reader(true, []))));
  // A flusher is running (and writes nothing): pongs stay queued.
  tx.with((q) => {
    q.flushing = true;
  });
  const payload: u8[] = Buffer.alloc(125);
  let answered = 0;
  let stopped = false;
  while (!stopped && answered < 100000) {
    try {
      await timeout(other(stream, tx.clone(), new Step(PING, "", payload)), 2000);
      answered++;
    } catch (e) {
      stopped = e instanceof TimeoutError;
    }
  }
  const bytes = tx.with((q) => q.pongs);
  console.log(
    "stopped:",
    stopped,
    "past the mark:",
    bytes > HIGH_WATER,
    "by one pong:",
    bytes - 127 <= HIGH_WATER,
  );

  // The flusher takes what is queued: the next ping is answered and reading goes on.
  tx.with((q) => q.take());
  try {
    await timeout(other(stream, tx.clone(), new Step(PING, "", payload)), 5000);
    console.log("reads on once the peer takes them: true");
  } catch (e) {
    console.log("reads on once the peer takes them: false");
  }
  // A pong refused (a close frame is queued) is not counted: it never goes out.
  tx.with((q) => {
    q.take();
    q.pushBytes(OP_CLOSE, []);
  });
  for (let i = 0; i < 10000; i++) {
    tx.with((q) => q.pushPong(payload));
  }
  console.log("refused pongs counted:", tx.with((q) => q.pongs));
  stream.abort();
  stream.close();
  silent.close();
  listener.close();
}
