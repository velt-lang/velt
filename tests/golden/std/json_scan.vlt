// velt:json/scan, the JSON scanner written in Velt (#1668): UTF-16 lengths, decoded escapes,
// surrogates, numbers and error offsets, as the Rust scanner it replaces gives them.
import { Scanner, numberF64, numberI64 } from "velt:json/scan";

function str(src: string) {
  for (const decode of [true, false]) {
    const s = new Scanner(src);
    if (!s.string(decode)) {
      console.log(JSON.stringify(src), "error:", s.what, "at", s.at);
      return;
    }
    if (decode) {
      const t = s.text();
      console.log(JSON.stringify(src), s.units, t.length == s.units, JSON.stringify(t), s.lone);
    } else {
      console.log("  undecoded:", s.units);
    }
  }
}

function num(src: string) {
  const s = new Scanner(src);
  if (!s.number()) {
    console.log(src, "error:", s.what, "at", s.at);
    return;
  }
  console.log(src, s.integer, numberF64(src, s.start, s.end, s.integer), numberI64(src, s.start, s.end, s.integer));
}

function main() {
  str(`"plain"`);
  str(`""`);
  str(`"héllo 日本 😀"`);
  str(`"a\\"b\\\\c\\n"`);
  str(`"é日"`);
  str(`"😀!"`);
  str(`"\\ud83d x"`);
  str(`"😀\\n😀"`);
  str(`"\\ud83d\\ude00"`);
  str(`"\\u00e9\\/\\b\\f\\r\\t"`);
  str(`"\\ud800\\u0041"`);
  str(`"\\udc00"`);
  str(`"tab\there"`);
  str(`"bad \\x"`);
  str(`"bad \\u12g4"`);
  str(`"open`);
  str(`"esc \\`);

  num("0");
  num("-0");
  num("42");
  num("-17.25");
  num("1e3");
  num("2.5E-3");
  num("123456789012345678");
  num("9223372036854775807");
  num("9223372036854775808");
  num("-9223372036854775808");
  num("-9223372036854775809");
  num("1.0");
  num("1.5");
  num("0.1");
  num("1.7976931348623157e308");
  num("01");
  num("-");
  num("1.");
  num("1e+");

  const lit = new Scanner("nul");
  const ok = lit.literal("null");
  console.log(ok, lit.what, lit.at);
  const lit2 = new Scanner("nuxl");
  const ok2 = lit2.literal("null");
  console.log(ok2, lit2.what, lit2.at);
  const ws = new Scanner(" \t\r\n x");
  console.log(ws.peekNonWs(), ws.pos);
}
