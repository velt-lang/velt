// The query engine's scalar functions (velt:sqlite/exec/func: text and number functions, printf,
// the date and time functions) against C SQLite (velt:sqlite): each call's result is compared with
// what C SQLite computes for the same SQL; the calls that differ are printed. The arguments are
// literals, read back from C SQLite as typed values.
import { open, Database } from "velt:sqlite";
import { BLOB, INTEGER, NULL, REAL, TEXT } from "velt:sqlite/btree";
import { BINARY } from "velt:sqlite/record";
import { Val, blobVal, intVal, nullVal, realVal, textVal, toText } from "velt:sqlite/exec/value";
import { scalarFunction } from "velt:sqlite/exec/func";
import { hexDecode, hexEncode } from "velt:encoding";

struct Described {
  d: string;
}

struct Int {
  i: i64;
}

struct Typed {
  ty: string;
  v: string;
}

const DESCRIBE =
  "typeof(e) || ':' || CASE typeof(e) WHEN 'blob' THEN hex(e) WHEN 'null' THEN '' ELSE CAST(e AS TEXT) END AS d";

function describe(v: Val): string {
  if (v.t == NULL) {
    return "null:";
  }
  if (v.t == INTEGER) {
    return `integer:${toText(v)}`;
  }
  if (v.t == REAL) {
    return `real:${toText(v)}`;
  }
  if (v.t == TEXT) {
    return `text:${toText(v)}`;
  }
  return `blob:${hexEncode(v.b).toUpperCase()}`;
}

/** The value of literal `sql`, as C SQLite reads it. */
function literal(db: Database, sql: string): Val {
  const rows: Typed[] = db
    .prepare(
      `SELECT typeof(e) AS ty, CASE typeof(e) WHEN 'real' THEN printf('%!.17g', e) WHEN 'blob' THEN hex(e) ELSE coalesce(CAST(e AS TEXT), '') END AS v FROM (SELECT ${sql} AS e)`,
    )
    .all();
  const r = rows[0];
  if (r.ty == "null") {
    return nullVal();
  }
  if (r.ty == "integer") {
    const ints: Int[] = db.prepare(`SELECT ${sql} AS i`).all();
    return intVal(ints[0].i);
  }
  if (r.ty == "real") {
    return realVal(parseFloat(r.v));
  }
  if (r.ty == "text") {
    return textVal(r.v);
  }
  return blobVal(hexDecode(r.v));
}

function cValue(db: Database, expr: string): string {
  try {
    const rows: Described[] = db.prepare(`SELECT ${DESCRIBE} FROM (SELECT ${expr} AS e)`).all();
    return rows[0].d;
  } catch (e) {
    const m = e.message;
    const at = m.indexOf(" in ");
    return `error: ${at >= 0 ? m.slice(0, at) : m}`;
  }
}

function veltValue(db: Database, name: string, args: string[]): string {
  const evs: (() => Val throws Error)[] = [];
  for (const a of args) {
    const v = literal(db, a);
    evs.push(() => v);
  }
  try {
    const f = scalarFunction(name.toUpperCase(), name, evs, BINARY);
    if (f == null) {
      return `error: no such function: ${name}`;
    }
    return describe(f!());
  } catch (e) {
    return `error: ${e.message}`;
  }
}

struct Call {
  name: string;
  args: string[];
}

function call(name: string, args: string[]): Call {
  return Call { name: name, args: args };
}

const CALLS: Call[] = [
  call("length", ["'héllo'"]),
  call("length", ["x'00ff'"]),
  call("length", ["12.5"]),
  call("octet_length", ["'héllo'"]),
  call("lower", ["'ÀBC'"]),
  call("upper", ["'àbc'"]),
  call("typeof", ["1.0"]),
  call("abs", ["-9223372036854775807"]),
  call("abs", ["'-2.5'"]),
  call("coalesce", ["NULL", "NULL", "3"]),
  call("ifnull", ["NULL", "'x'"]),
  call("nullif", ["1", "1.0"]),
  call("iif", ["0", "'a'", "'b'"]),
  call("min", ["3", "'a'", "2.5"]),
  call("max", ["3", "'a'", "x'01'"]),
  call("max", ["3", "NULL"]),
  call("substr", ["'héllo'", "2", "3"]),
  call("substr", ["'hello'", "-3"]),
  call("substr", ["'hello'", "0", "2"]),
  call("substr", ["x'0102030405'", "2", "-1"]),
  call("substr", ["'hello'", "-2", "-5"]),
  call("instr", ["'héllo'", "'l'"]),
  call("instr", ["x'010203'", "x'03'"]),
  call("replace", ["'aaa'", "'a'", "'bb'"]),
  call("replace", ["'abc'", "''", "'x'"]),
  call("trim", ["'  x  '"]),
  call("ltrim", ["'xxyxx'", "'x'"]),
  call("rtrim", ["'aé!é'", "'é!'"]),
  call("round", ["2.5"]),
  call("round", ["-2.5"]),
  call("round", ["1.005", "2"]),
  call("round", ["123456.789", "-2"]),
  call("round", ["'7.45'", "1"]),
  call("hex", ["'é'"]),
  call("hex", ["12.5"]),
  call("quote", ["'it''s'"]),
  call("quote", ["0.1"]),
  call("quote", ["x'ab'"]),
  call("quote", ["NULL"]),
  call("char", ["72", "233", "128512"]),
  call("unicode", ["'é'"]),
  call("zeroblob", ["3"]),
  call("sign", ["-0.5"]),
  call("sign", ["'abc'"]),
  call("concat", ["'a'", "NULL", "1", "2.5"]),
  call("concat_ws", ["'-'", "'a'", "NULL", "'b'"]),
  call("like", ["'a%'", "'ABC'"]),
  call("glob", ["'a*'", "'ABC'"]),
  call("printf", ["'%d %5.2f %s %x'", "42", "3.14159", "'hi'", "255"]),
  call("printf", ["'%-6s|%06d|%+d'", "'ab'", "42", "7"]),
  call("printf", ["'%q %Q %w'", "'it''s'", "NULL", "'a\"b'"]),
  call("printf", ["'%.3e %g %g'", "123456.789", "0.0001", "1e20"]),
  call("printf", ["'%!.20g'", "0.1"]),
  call("printf", ["'%c%c'", "'xyz'", "65"]),
  call("printf", ["'%,d'", "1234567"]),
  call("printf", ["'%5.1s|'", "'abc'"]),
  call("format", ["'%lld%%'", "9223372036854775807"]),
  // SQLite's length limit (1,000,000,000 bytes), found before anything that big is built.
  call("replace", ["hex(zeroblob(100000))", "'0'", "hex(zeroblob(10000))"]),
  call("zeroblob", ["1000000001"]),
  call("printf", ["'%2147483647d'", "1"]),
  call("printf", ["'%1000000000d'", "1"]),
  call("printf", ["'%.*c'", "1500000000", "'x'"]),
  call("printf", ["'%.999999995d'", "1"]),
  call("printf", ["'%,.900000000d'", "1"]),
  call("printf", ["'%2147483647.1f'", "1.0"]),
  call("printf", ["'%999999987.3f'", "1.5"]),
  call("min", []),
  // An empty pattern (or one starting with a NUL) gives x's text; %c's width counts characters.
  call("replace", ["12", "''", "'x'"]),
  call("replace", ["'a'", "x'00'", "NULL"]),
  call("printf", ["'%y'"]),
  call("printf", ["'%5.3c|'", "'é'"]),
  // like() checks the ESCAPE before a NULL operand, as likeFunc does.
  call("like", ["NULL", "1", "12"]),
  call("like", ["1", "NULL", "12"]),
  call("date", ["'2024-02-29'", "'+1 year'"]),
  call("date", ["'2024-01-31'", "'+1 month'"]),
  call("time", ["'12:34:56.789'"]),
  call("datetime", ["1700000000", "'unixepoch'"]),
  call("datetime", ["'2024-03-10 12:00'", "'-36 hours'", "'start of day'"]),
  call("datetime", ["2460000.5"]),
  call("julianday", ["'2000-01-01 12:00:00'"]),
  call("unixepoch", ["'2038-01-19 03:14:08'"]),
  call("unixepoch", ["'2024-01-01'", "'subsec'"]),
  call("strftime", ["'%Y-%m-%d %H:%M:%f %j %w %W %s'", "'2024-12-31 23:59:59.5'"]),
  call("strftime", ["'%J %e %k %l %p %I %u %G %V %g'", "'2021-01-03 07:08:09'"]),
  call("date", ["'2024-05-15'", "'weekday 0'"]),
  call("date", ["'2024-05-15'", "'start of month'", "'+1 month'", "'-1 day'"]),
  call("date", ["'not a date'"]),
  call("date", ["'2024-02-30'"]),
  call("datetime", ["'2024-01-01T10:00:00+02:30'"]),
  call("time", ["'24:00'"]),
];

// Calls whose results are compared by type and size only: they are too long to print.
const SIZED: Call[] = [
  // A float's precision stops at 100,000,000 digits (SQLITE_FP_PRECISION_LIMIT).
  call("printf", ["'%.2147483647f'", "1.0"]),
  // The widest float C accepts: its buffer's NUL counts against the limit, the result's does not.
  call("printf", ["'%999999986.3f'", "1.5"]),
];

function sizeOf(v: Val): string {
  if (v.t == NULL) {
    return "null";
  }
  return v.t == BLOB ? `blob:${v.b.length}` : `text:${toText(v).length}`;
}

function main() {
  const db = open(":memory:");
  let bad = 0;
  for (const c of CALLS) {
    const sql = `${c.name}(${c.args.join(", ")})`;
    const want = cValue(db, sql);
    const mine = veltValue(db, c.name, c.args);
    if (want != mine) {
      bad++;
      console.log(`${sql}: velt ${mine}, C ${want}`);
    } else {
      console.log(`${sql} = ${mine}`);
    }
  }
  for (const c of SIZED) {
    const sql = `${c.name}(${c.args.join(", ")})`;
    const rows: Described[] = db
      .prepare(`SELECT typeof(e) || ':' || length(e) AS d FROM (SELECT ${sql} AS e)`)
      .all();
    const evs: (() => Val throws Error)[] = [];
    for (const a of c.args) {
      const v = literal(db, a);
      evs.push(() => v);
    }
    const mine = sizeOf(scalarFunction(c.name.toUpperCase(), c.name, evs, BINARY)!());
    if (mine != rows[0].d) {
      bad++;
    }
    console.log(`${sql}: velt ${mine}, C ${rows[0].d}`);
  }
  console.log(
    `${CALLS.length + SIZED.length} calls, ${bad == 0 ? "all the same" : bad + " differ"}`,
  );
}
