// A replacer function with a regex held in a variable or field: the offset and the string
// come after the groups, as in Node; parameter defaults and assignments to parameters.
class Patterns {
  readonly digit = /(\d)/g;
  readonly pair = /(\w)(\d)/g;
}
class Derived extends Patterns {}

function main() {
  const re2 = /\d/g;
  console.log("a1b2".replace(re2, (m, off) => `<${m}@${off}>`));
  console.log("a1b2".replace(re2, (m, off, str) => `<${m}@${off}:${str}>`));
  const lit = /(\w)(\d)/g;
  console.log("a1b2".replace(lit, (m, a, b, off) => b + a + off));
  const ctor = new RegExp("(\\d)", "g");
  const alias = ctor;
  const inClosure = () => "x7y8".replace(alias, (m, d, off) => `${d}@${off}`);
  console.log(inClosure());
  const p = new Patterns();
  console.log("axb5".replace(p.digit, (m, d, off, s) => `[${d}${off}${s.length}]`));
  const q = new Derived();
  console.log("a1b2".replace(q.pair, (m, a, b, off) => `${b}${a}${off}`));
  console.log("a1b2".replaceAll(re2, (m, off) => `${off}`));
  const g = (m: string, off: number) => `${m}@${off}`;
  console.log("a1b2".replace(re2, g));
  // Defaults: for a group that did not take part, and for an argument JS does not pass.
  console.log("abab".replace(/(x)?b/g, (m: string, p1: string = "dflt") => `<${p1}>`));
  console.log("a1b2".replace(re2, (m, off, s, extra = "E") => `${extra}${off}`));
  // Parameters are variables.
  console.log("a b".replace(/(a)/, (m, p1) => {
    p1 = p1.toUpperCase();
    return p1;
  }));
}
