// The SQLite engine written in Velt (velt/sqlite/engine, #1720) at SQLite's limits on nesting:
// FROM subqueries nested 200 deep (the parser's nesting bound, #1774, stops them before SQLite's
// 416, "Recursion limit"), views nest 999 deep
// and not 1000 ("VIEWs and/or subqueries nested too deep"), a statement references a table at
// most 65534 times (CTEs expanded; once in a query compiled again), an endless recursive CTE
// ends at an outer LIMIT, and a result has at most 2,000 columns (`*` counted as the columns it
// stands for, a VALUES row too), ORDER BY terms (a compound's too, a window's PARTITION BY and
// ORDER BY together) and GROUP BY terms.
// The expected output is the sqlite3 shell's for the same statements.
import { open } from "velt/sqlite";
import { openDatabase, Database } from "velt/sqlite/engine";
import { Val } from "velt/sqlite/exec/value";
import { quote } from "velt/sqlite/exec/func";
import { tmpdir } from "velt/os";
import { uuidv4 } from "velt/random/uuid";
import { removeSync } from "velt/fs";

function show(db: Database, what: string, sql: string) {
  try {
    const st = db.prepare(sql);
    const vals: Val[] = st.values();
    const parts: string[] = [];
    for (const v of vals) {
      parts.push(quote(v));
    }
    console.log(`${what}: ${parts.join(" ")}`);
  } catch (e) {
    console.log(`${what}: error: ${e.message}`);
  }
}

function nestedFrom(n: i64): string {
  let q = "SELECT 1 AS x";
  for (let i: i64 = 0; i < n; i++) {
    q = `SELECT x + 1 AS x FROM (${q}) WHERE x > 0`;
  }
  return q;
}

function cteChain(n: i64): string {
  let q = "WITH c0(x) AS (SELECT id FROM t)";
  for (let i: i64 = 1; i <= n; i++) {
    q += `, c${i}(x) AS (SELECT a.x FROM c${i - 1} a JOIN c${i - 1} b ON a.x = b.x)`;
  }
  return q + ` SELECT count(*) FROM c${n}`;
}

function main() {
  const path = `${tmpdir()}/velt-engine-limits-${uuidv4()}.db`;
  const c = open(path);
  let ddl = "CREATE TABLE t (id INTEGER PRIMARY KEY); INSERT INTO t VALUES (1), (2);";
  ddl += "CREATE VIEW v0 AS SELECT 1 AS x;";
  for (let i = 1; i < 1000; i++) {
    ddl += `CREATE VIEW v${i} AS SELECT x FROM v${i - 1};`;
  }
  // Tables of 1,000, 1,000 and 1,001 columns, for `*` at the result's 2,000 columns.
  const cols = (n: i64) => Array.from({ length: n }, (_, i) => `c${i + 1}`).join(", ");
  ddl += `CREATE TABLE w1 (${cols(1000)}); CREATE TABLE w2 (${cols(1000)});`;
  ddl += `CREATE TABLE w3 (${cols(1001)});`;
  c.exec(ddl);
  c.close();
  const db = openDatabase(path);
  show(db, "200 nested FROM subqueries", nestedFrom(200));
  show(db, "999 nested views", "SELECT x FROM v998");
  show(db, "1000 nested views", "SELECT x FROM v999");
  show(
    db,
    "4096 FROM terms once flattened",
    cteChain(12).replace(" JOIN ", ", ").replace(" ON a.x = b.x", ""),
  );
  show(db, "65536 references", cteChain(16));
  // A query that compiles again as an aggregate query counts its FROM's references once.
  show(
    db,
    "32768 references, compiled again",
    cteChain(15)
      .replaceAll("SELECT a.x", "SELECT DISTINCT a.x")
      .replace(" SELECT count(*) FROM c15", " SELECT (SELECT count(c15.x) FROM t) FROM c15"),
  );
  show(
    db,
    "endless recursion under LIMIT",
    "WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT n FROM r LIMIT 3",
  );
  // SQLITE_MAX_COLUMN: 2,000 result columns, ORDER BY terms and GROUP BY terms.
  const ones = (n: i64) => Array.from({ length: n }, () => "1").join(", ");
  const ids = (n: i64) => Array.from({ length: n }, () => "id").join(", ");
  show(db, "2000 result columns", `SELECT count(*) FROM (SELECT ${ones(2000)})`);
  show(db, "2001 result columns", `SELECT count(*) FROM (SELECT ${ones(2001)})`);
  show(db, "2000 ORDER BY terms", `SELECT id FROM t ORDER BY ${ids(2000)}`);
  show(db, "2001 ORDER BY terms", `SELECT id FROM t ORDER BY ${ids(2001)}`);
  show(db, "2000 GROUP BY terms", `SELECT id FROM t GROUP BY ${ids(2000)}`);
  show(db, "2001 GROUP BY terms", `SELECT id FROM t GROUP BY ${ids(2001)}`);
  const compound = (n: i64) => `SELECT id FROM t UNION SELECT 3 ORDER BY ${ones(n)}`;
  show(db, "2000 ORDER BY terms of a compound", compound(2000));
  show(db, "2001 ORDER BY terms of a compound", compound(2001));
  show(db, "a VALUES row of 2000", `SELECT count(*) FROM (VALUES (${ones(2000)}))`);
  show(db, "a VALUES row of 2001", `SELECT count(*) FROM (VALUES (${ones(2001)}))`);
  show(db, "* over 1000 + 1000 columns", "SELECT count(*) FROM (SELECT * FROM w1, w2)");
  show(db, "* over 1000 + 1001 columns", "SELECT count(*) FROM (SELECT * FROM w1, w3)");
  // A window's PARTITION BY and ORDER BY count together, as one ORDER BY, where it is used;
  // the error comes after the names resolve.
  const win = (over: string) => `SELECT count(*) OVER (${over}) FROM t`;
  show(db, "a window ORDER BY of 2000", win(`ORDER BY ${ids(2000)}`));
  show(db, "a window ORDER BY of 2001", win(`ORDER BY ${ids(2001)}`));
  show(db, "a window PARTITION BY of 2000", win(`PARTITION BY ${ids(2000)}`));
  show(db, "a window PARTITION BY of 2001", win(`PARTITION BY ${ids(2001)}`));
  show(db, "a window of 1000 + 1000", win(`PARTITION BY ${ids(1000)} ORDER BY ${ids(1000)}`));
  show(db, "a window of 1000 + 1001", win(`PARTITION BY ${ids(1000)} ORDER BY ${ids(1001)}`));
  const named = (n: i64) => `SELECT count(*) OVER w FROM t WINDOW w AS (ORDER BY ${ids(n)})`;
  show(db, "a named window of 2000", named(2000));
  show(db, "a named window of 2001", named(2001));
  show(db, "an unused window of 2001", `SELECT 1 FROM t WINDOW w AS (ORDER BY ${ids(2001)})`);
  const over2001 = `count(*) OVER (ORDER BY ${ids(2001)})`;
  show(db, "a window of 2001 in ORDER BY", `SELECT id FROM t ORDER BY ${over2001}`);
  show(db, "a window of 2001, then no such column", `SELECT ${over2001}, nosuch FROM t`);
  removeSync(path);
}
