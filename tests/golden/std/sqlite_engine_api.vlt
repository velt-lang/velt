// The statement API of the SQLite engine written in Velt (velt/sqlite/engine, #1720): typed rows
// by column name, parameters by position and by name, column names, the plan cache, errors.
import { open, Database as CDatabase } from "velt/sqlite";
import { openDatabase, Database, SqliteError } from "velt/sqlite/engine";
import { quote } from "velt/sqlite/exec/func";
import { tmpdir } from "velt/os";
import { uuidv4 } from "velt/random/uuid";
import { removeSync } from "velt/fs";

struct User {
  id: i64;
  name: string;
  score: f64;
  note: string | null;
}

struct Named {
  id: i64;
  label: string;
}

struct Count {
  n: i64;
}

struct Bound {
  t: string;
  q: string;
}

/** `params` bound to `sql` in the engine and in velt/sqlite: each row's `t|q`, or the error. */
function both<P>(db: Database, c: CDatabase, sql: string, params: P) {
  let mine = "";
  try {
    const rows: Bound[] = db.prepare(sql).allWith(params);
    mine = rows.map((r) => `${r.t}|${r.q}`).join(" ");
  } catch (e) {
    mine = e.message;
  }
  let theirs = "";
  try {
    const rows: Bound[] = c.prepare(sql).allWith(params);
    theirs = rows.map((r) => `${r.t}|${r.q}`).join(" ");
  } catch (e) {
    theirs = e.message;
  }
  const shown = JSON.stringify(params);
  console.log(
    mine == theirs ? `${shown}: ${mine}` : `${shown}: velt ${mine}, velt/sqlite ${theirs}`,
  );
}

struct Bytes {
  b: u8[];
}

function main() {
  const path = `${tmpdir()}/velt-engine-api-${uuidv4()}.db`;
  const c = open(path);
  c.exec(`
    CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, score REAL, note TEXT, data BLOB);
    INSERT INTO users VALUES (1, 'ann', 2, NULL, x'0102'), (2, 'bo', 3.5, 'hi', NULL),
      (3, 'cy', -1, 'x', x'');
  `);
  c.close();
  const db = openDatabase(path);

  // Rows into structs, a REAL column's integral value into an f64 field, NULL into `| null`.
  const all: User[] = db.prepare("SELECT id, name, score, note FROM users ORDER BY id").all();
  for (const u of all) {
    console.log(u.id, u.name, u.score, u.note ?? "(null)");
  }
  const one: User | null = db.prepare("SELECT * FROM users WHERE id = 2").get();
  console.log(one!.name, one!.score);
  const none: User | null = db.prepare("SELECT * FROM users WHERE id = 9").get();
  console.log(none == null);

  // Parameters: `?` in order, `?NNN`, and names with any sigil.
  const byPos: User | null = db.prepare("SELECT * FROM users WHERE id = ?").getWith([3]);
  console.log(byPos!.name);
  const range: Named[] = db
    .prepare("SELECT id, name AS label FROM users WHERE id >= ?2 AND id <= ?1 ORDER BY id")
    .allWith([3, 2]);
  console.log(range.map((r) => `${r.id}:${r.label}`).join(" "));
  const byName: Named[] = db
    .prepare(
      "SELECT id, name || :suffix AS label FROM users WHERE id < $max AND name != @skip ORDER BY id",
    )
    .allWith({ suffix: "!", max: 3, skip: "bo" });
  console.log(byName.map((r) => r.label).join(" "));
  const single: Count | null = db
    .prepare("SELECT count(*) AS n FROM users WHERE score > ?")
    .getWith(0);
  console.log(single!.n);
  const text: Count | null = db
    .prepare("SELECT count(*) AS n FROM users WHERE name = ?")
    .getWith("cy");
  console.log(text!.n);
  const blob: Bytes | null = db.prepare("SELECT data AS b FROM users WHERE id = 1").get();
  console.log(blob!.b.length, blob!.b[1]);

  // Column names: aliases, column names, the expression's text.
  const st = db.prepare("SELECT id, name AS who, score * 2, upper(name) FROM users");
  console.log(st.columns().join(" | "));
  // plan(): EXPLAIN QUERY PLAN's words.
  for (const sql of [
    "SELECT name FROM users WHERE id = 2",
    "SELECT name FROM users WHERE id IN (1, 3)",
    "SELECT name FROM users WHERE id > 1 AND id <= 3",
    "SELECT name FROM users",
  ]) {
    console.log(db.prepare(sql).plan().join(" ; "));
  }
  // The rowid's spellings are named after its alias column (else "rowid"), as in SQLite.
  console.log(
    db.prepare("SELECT _rowid_, oid, rowid, users.ROWID FROM users").columns().join(" | "),
  );
  // Prepared once: the same text gives the same statement.
  console.log(db.prepare("SELECT id, name AS who, score * 2, upper(name) FROM users") == st);
  // The plan cache keeps the 200 plans used last: an older text compiles again.
  const first = db.prepare("SELECT 0 AS n");
  for (let i = 1; i <= 200; i++) {
    db.prepare(`SELECT ${i} AS n`);
  }
  console.log(
    db.prepare("SELECT 200 AS n") == db.prepare("SELECT 200 AS n"),
    db.prepare("SELECT 0 AS n") == first,
  );

  // Rows read one at a time through the typed reads' getters are the rows values() gives.
  for (const sql of [
    "SELECT * FROM users",
    "SELECT id, name FROM users WHERE id > 1",
    "SELECT name, score FROM users ORDER BY id DESC LIMIT 2",
    "SELECT note, data, id + 1, upper(name) FROM users WHERE score > 0",
  ]) {
    const st = db.prepare(sql);
    const pulled = st.pulledValues().map((v) => quote(v)).join(" ");
    const all = st.values().map((v) => quote(v)).join(" ");
    console.log(pulled == all ? `pulled: ${pulled}` : `pulled ${pulled}, values() ${all}`);
  }

  // Parameters as velt/sqlite binds them: every i64 exactly (past it, REAL), one value for each
  // parameter, a field for each named one.
  const mem = open(":memory:");
  const one1 = "SELECT typeof(?1) AS t, quote(?1) AS q";
  const big: i64[] = [1234567890123456789, 9223372036854775807, -9223372036854775807 - 1];
  for (const n of big) {
    both(db, mem, one1, [n]);
  }
  // Through the reader (a field that is no integer): a negative of 18 digits, i64's ends, past them.
  const neg: i64 = -123456789012345678;
  const top: i64 = 9223372036854775807;
  const ab = "SELECT typeof(:a) AS t, quote(:a) || ' ' || quote(:b) || ' ' || quote(:c) AS q";
  both(db, mem, ab, { a: neg, b: "x", c: top });
  both(db, mem, ab, { a: -9223372036854775807 - 1, b: 1e20, c: "y" });
  both(db, mem, one1, 99999999999999999999.0);
  const noValues: i64[] = [];
  both(db, mem, one1, noValues);
  both(db, mem, one1, [1, 2]);
  both(db, mem, one1, { a: 1 });
  both(db, mem, "SELECT typeof(:a) AS t, quote(:b) AS q", { a: 1 });
  both(db, mem, "SELECT typeof(:a) AS t, quote(:a) AS q", { a: 1, z: 2 });
  for (const sql of [one1, "SELECT '1' AS t, '2' AS q"]) {
    let mine = "";
    try {
      const rows: Bound[] = db.prepare(sql).all();
      mine = `${rows.length} row(s)`;
    } catch (e) {
      mine = e.message;
    }
    let theirs = "";
    try {
      const rows: Bound[] = mem.prepare(sql).all();
      theirs = `${rows.length} row(s)`;
    } catch (e) {
      theirs = e.message;
    }
    console.log(
      mine == theirs
        ? `no parameters: ${mine}`
        : `no parameters: velt ${mine}, velt/sqlite ${theirs}`,
    );
  }
  mem.close();

  // Errors: SQLite's codes and messages.
  for (const sql of [
    "SELECT nosuch FROM users",
    "SELECT * FROM nosuch",
    "SELECT * FROM users WHERE",
    "DELETE FROM users",
    "SELECT sum(9223372036854775807) FROM users",
    "SELECT abs(-9223372036854775807 - 1)",
  ]) {
    try {
      const rows: Count[] = db.prepare(sql).all();
      console.log("ok", rows.length);
    } catch (e) {
      if (e instanceof SqliteError) {
        console.log(e.code, e.message);
      }
    }
  }
  try {
    const bad: User[] = db.prepare("SELECT name AS id FROM users").all();
    console.log(bad.length);
  } catch (e) {
    if (e instanceof SqliteError) {
      console.log(e.code);
    }
  }
  removeSync(path);
}
