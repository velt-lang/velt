// check: no leaks
// `Object.defineProperty(re, "lastIndex", { value })` sets the regex's own `lastIndex`, as in
// JavaScript (#3883; it was refused at compile time as a property `RegExp` doesn't declare), and
// returns the regex. A subclass's `lastIndex` accessors are not reached.

class R extends RegExp {
  override get lastIndex(): number {
    console.log("subclass getter");
    return 9;
  }
  override set lastIndex(v: number) {
    console.log("subclass setter", v);
  }
}

const g = /a/g;
const back = Object.defineProperty(g, "lastIndex", { value: 2 });
console.log(back === g, g.lastIndex, g.exec("aaaa")!.index, g.lastIndex);

const r = new R("a", "y");
Object.defineProperty(r, "lastIndex", { value: 1 });
console.log(r.lastIndex, r.test("aaa"), r.lastIndex);
