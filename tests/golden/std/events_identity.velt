// `removeEventListener` and a second `addEventListener` find a listener by the function or
// object passed, as in Node (#2378): closures with and without the event parameter, one that
// throws, a declared function, a handler object, a value typed `EventListener`, and the shapes below.
const t = new EventTarget();
const zero = () => console.log("zero");
const one = (e: Event) => console.log("one", e.type);
const throws = (e: Event) => {
  if (e.type === "never") {
    throw new Error("no");
  }
  console.log("throws", e.type);
};
function declared(e: Event) {
  console.log("declared", e.type);
}
const obj = {
  handleEvent(e: Event) {
    console.log("obj", e.type);
  },
};
const typed: EventListener = (e) => console.log("typed", e.type);
for (let i = 0; i < 2; i++) {
  t.addEventListener("x", zero);
  t.addEventListener("x", one);
  t.addEventListener("x", throws);
  t.addEventListener("x", declared);
  t.addEventListener("x", obj);
  t.addEventListener("x", typed);
}
t.dispatchEvent(new Event("x"));
console.log("--");
function off() {
  t.removeEventListener("x", zero);
  t.removeEventListener("x", throws);
  t.removeEventListener("x", obj);
}
off();
t.dispatchEvent(new Event("x"));
console.log("--");
const later = () => {
  t.removeEventListener("x", one);
  t.removeEventListener("x", declared);
  t.removeEventListener("x", typed);
};
later();
console.log(t.dispatchEvent(new Event("x")));
// A different closure with the same code is another listener.
const make = () => () => console.log("made");
t.addEventListener("y", make());
t.addEventListener("y", make());
t.dispatchEvent(new Event("y"));
// A default parameter, a rest parameter, an `any` parameter, and a function held as an `any`
// (with and without the parameter): each is found again (#2700 keeps a converted function's
// identity).
const t2 = new EventTarget();
const dflt = (e: Event | null = null) => console.log("default", e === null ? "none" : e.type);
const rest = (...args: any[]) => console.log("rest", args.length);
const anyParam = (e: any) => console.log("any param", e.type);
const held: any = () => console.log("held zero");
const heldOne: any = (e: Event) => console.log("held one", e.type);
for (let i = 0; i < 2; i++) {
  t2.addEventListener("x", dflt);
  t2.addEventListener("x", rest);
  t2.addEventListener("x", anyParam);
  t2.addEventListener("x", held);
  t2.addEventListener("x", heldOne);
}
t2.dispatchEvent(new Event("x"));
t2.removeEventListener("x", dflt);
t2.removeEventListener("x", rest);
t2.removeEventListener("x", anyParam);
t2.removeEventListener("x", held);
t2.removeEventListener("x", heldOne);
console.log(t2.dispatchEvent(new Event("x")));
