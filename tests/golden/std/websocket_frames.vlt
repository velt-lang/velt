// std/websocket's framing (std/websocket/frame, internal): every length class round trips,
// a partial frame asks for more bytes, and the rules for each side (RFC 6455 §5).
import { maskKey } from "velt:websocket/bytes";
import {
  Frame,
  INVALID,
  OP_BINARY,
  OP_PING,
  OP_TEXT,
  PARTIAL,
  WHOLE,
  closePayload,
  headSize,
  parse,
  validCloseCode,
  writeHead,
} from "velt:websocket/frame";
import { utf8Decode, utf8Encode } from "velt:encoding";

const MAX: i64 = 1048576;

// A whole frame carrying `payload`, masked like a client's if `masked`.
function encode(op: i64, payload: u8[], masked: bool): u8[] {
  const len = payload.length as i64;
  const out = Buffer.alloc((headSize(len, masked) + len) as usize);
  const mask = masked ? maskKey() : 0u32;
  const at = writeHead(out, 0, op, len, masked, mask);
  out.set(payload, at as usize);
  if (masked) {
    out.xorMask(mask, at, at + len);
  }
  return out;
}

function sameBytes(a: u8[], b: u8[]): bool {
  if (a.length != b.length) {
    return false;
  }
  for (let i = 0; i < a.length; i++) {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function status(buf: u8[], fromClient: bool, max: i64): string {
  const f = new Frame();
  const s = parse(buf, 0, fromClient, max, f);
  return s == WHOLE ? "whole" : s == PARTIAL ? "partial" : `invalid: ${f.error}`;
}

function main() {
  // Every length class, masked, behind some other bytes in the buffer.
  let ok = true;
  for (const n of [0, 1, 7, 8, 125, 126, 127, 65535, 65536, 70000]) {
    const payload = Buffer.alloc(n as usize);
    for (let i = 0; i < n; i++) {
      payload[i] = (i % 251) as u8;
    }
    const frame = encode(OP_BINARY, payload, true);
    const buf = [9u8, 9u8, 9u8].concat(frame);
    const f = new Frame();
    const s = parse(buf, 3, true, MAX, f);
    const good =
      s == WHOLE &&
      f.fin &&
      f.op == OP_BINARY &&
      f.len == n &&
      f.end == (buf.length as i64) &&
      sameBytes(buf.slice(f.start, f.end), payload);
    if (!good) {
      console.log("length", n, "failed", s, f.len, f.end);
      ok = false;
    }
  }
  console.log("every length class round trips:", ok);

  // Any strict prefix of a frame is partial.
  const hello = encode(OP_TEXT, utf8Encode("hello world"), true);
  let partial = true;
  for (let cut = 0; cut < hello.length; cut++) {
    partial = partial && status(hello.slice(0, cut), true, MAX) == "partial";
  }
  console.log("prefixes are partial:", partial, status(hello, true, MAX));

  // A server requires masked frames, small unfragmented control frames, no reserved bits.
  const plain = encode(OP_TEXT, utf8Encode("hi"), false);
  console.log("server:", status(plain.clone(), true, MAX));
  console.log("client:", status(plain.clone(), false, MAX));
  console.log("client:", status(encode(OP_TEXT, utf8Encode("hi"), true), false, MAX));
  console.log(status(encode(OP_PING, Buffer.alloc(126), true), true, MAX));
  const split = encode(OP_PING, [], true);
  split[0] = OP_PING as u8;
  console.log(status(split, true, MAX));
  console.log(status(encode(OP_BINARY, Buffer.alloc(100), true), true, 99));
  const reserved = encode(OP_TEXT, utf8Encode("x"), true);
  reserved[0] = reserved[0] | 0x40u8;
  console.log(status(reserved, true, MAX));
  const unknown = encode(OP_TEXT, [], true);
  unknown[0] = 0x83u8;
  console.log(status(unknown, true, MAX));

  // A 64-bit length with the top bit set is rejected whatever the limit (§5.2); the largest
  // legal one is just a frame that has not arrived.
  const top: u8[] = [0x82u8, 127u8, 0x80u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8];
  console.log(status(top, false, 9223372036854775807));
  const huge: u8[] = [
    0x82u8,
    127u8,
    0x7fu8,
    0xffu8,
    0xffu8,
    0xffu8,
    0xffu8,
    0xffu8,
    0xffu8,
    0xffu8,
  ];
  console.log(status(huge, false, 9223372036854775807), "|", status(huge, false, MAX));

  // Masking keys come from the OS random source.
  const keys = new Set<u32>();
  for (let i = 0; i < 200; i++) {
    keys.add(maskKey());
  }
  console.log("mask keys vary:", keys.size > 190);

  // Close codes that may go on the wire, and a reason cut to 123 bytes at a character boundary.
  const codes: i64[] = [];
  const all: i64[] = [
    999,
    1000,
    1003,
    1004,
    1005,
    1006,
    1007,
    1014,
    1015,
    2999,
    3000,
    4999,
    5000,
    65536,
  ];
  for (const c of all) {
    if (validCloseCode(c)) {
      codes.push(c);
    }
  }
  console.log("valid close codes:", codes);
  const cut = closePayload(1001, "é".repeat(100));
  console.log(
    cut.length,
    ((cut[0] as i64) << 8) | (cut[1] as i64),
    utf8Decode(cut.slice(2)).length,
  );
  console.log(closePayload(1000).length, utf8Decode(closePayload(4000, "bye").slice(2)));
}
