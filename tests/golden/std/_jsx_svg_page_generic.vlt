/** @jsxImportSource velt:jsx/generic */

// The page of `jsx_svg_mathml` under std/jsx's generic runtime: `_jsx_svg_page.vlt` under
// `velt:jsx/generic`.

export function icon(r: i64): JSX.Element {
  return <svg viewBox="0 0 10 10"><circle cx={5} cy={5} r={r} /></svg>;
}

export function chart(values: f64[], label: string): JSX.Element {
  return (
    <svg xmlns="http://www.w3.org/2000/svg" width={120} height="40" viewBox="0 0 120 40" role="img" version="1.1">
      <title>{label}</title>
      <style type="text/css">{"rect { shape-rendering: crispEdges; }"}</style>
      <defs>
        <linearGradient id="fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="teal" />
          <stop offset="100%" stop-color="teal" stop-opacity={0} />
        </linearGradient>
        <clipPath id="frame"><rect x={0} y={0} width={120} height={40} rx={4} /></clipPath>
        <filter id="soft"><feGaussianBlur in="SourceGraphic" stdDeviation={0.5} /></filter>
      </defs>
      <g clip-path="url(#frame)" fill="url(#fade)" stroke="black" stroke-width={1.5}>
        {values.map((v, i) => <rect x={i * 20} y={40 - v} width={18} height={v} />)}
        <polyline points="0,40 60,10 120,30" fill="none" filter="url(#soft)">
          <animate attributeName="opacity" attributeType="CSS" from={0} to={1} dur="1s" fill="freeze" />
        </polyline>
        <path d="M0 0 L120 40" stroke-dasharray="2 2" />
        <text x={2} y={12} font-size={10}>{label} <tspan dy={2}>&lt;max&gt;</tspan></text>
        <a href="/details" fill="red"><use href="#frame" xlink:href="#frame" /></a>
      </g>
    </svg>
  );
}

export function formula(n: i64): JSX.Element {
  return (
    <math display="block" alttext="x over n">
      <mrow>
        <mfrac><mi>x</mi><mn>{n}</mn></mfrac>
        <mo stretchy="false" lspace={0}>=</mo>
        <msqrt><msup><mi>y</mi><mn>2</mn></msup></msqrt>
        <mspace width="1em" />
        <mmultiscripts><mi>R</mi><mi>i</mi><none /><mprescripts /><none /><mi>j</mi></mmultiscripts>
        <munderover><mo largeop="true">∑</mo><mi>i</mi><mi>n</mi></munderover>
      </mrow>
      <annotation-xml encoding="application/x-tex">x/n</annotation-xml>
    </math>
  );
}
