// What a program sees of a `Response` and a `Request` stays their public state: `console.log`
// and a spread show none of the fields std keeps the body and its state in, and a subclass may
// declare fields and methods of its own (output from Node). That they have no JSON form and no
// `any` form is errors/fetch_private_state.vlt's.
class Tagged extends Response {
  tag: string;
  reads: number = 0;

  constructor(body: string, tag: string) {
    super(body, { status: 201, headers: { "x-tag": tag } });
    this.tag = tag;
  }

  label(): string {
    return `${this.tag}:${this.status}`;
  }

  async read(): Promise<string> {
    this.reads++;
    return await this.text();
  }
}

async function main() {
  const res = new Response("hello", { status: 202, statusText: "Accepted" });
  const req = new Request("http://example.com/a", { method: "POST", body: "data" });
  console.log(res);
  console.log(req);
  console.log({ ...res }, { ...req });
  const t = new Tagged("tagged body", "t1");
  const label = t.label();
  const body = await t.read();
  const xTag = t.headers.get("x-tag");
  console.log(label, t.tag, body, t.reads, t.bodyUsed, xTag);
  console.log(await res.text(), res.bodyUsed, await req.text(), req.bodyUsed);
}
