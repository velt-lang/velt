// check: no leaks
// std/websocket's sending side: frames go out in call order (also the ones queued before a
// server-side upgrade has completed, and past the high-water mark, where a send waits for the
// flusher), sends from several tasks keep each task's order, and closing ends the stream after
// everything queued.
import { serve } from "velt:http";
import { channel, Channel } from "velt:channel";
import { IoError } from "velt:io";
import { WebSocket, upgradeWebSocket, connectWebSocket } from "velt:websocket";

const BIG = 100000;

// 40 messages of 100 KB, all queued before the first is awaited: 4 MB, past the 1 MiB mark.
async function flood(ws: WebSocket, done: Channel<string>): Promise<void> {
  const sends: Promise<void, IoError>[] = [];
  for (let i = 0; i < 40; i++) {
    sends.push(ws.send(`${i}:` + "x".repeat(BIG)));
  }
  await Promise.all(sends);
  await ws.send("end of flood");
  await ws.close();
  await done.send("flood sent");
}

async function numbered(ws: WebSocket, task: i64, n: i64): Promise<void> {
  for (let i: i64 = 0; i < n; i++) {
    await ws.send(`${task}:${i}`);
    if (i % 50 == 0) {
      await yieldNow();
    }
  }
}

// Four tasks send through copies of one socket.
async function crowd(ws: WebSocket, done: Channel<string>): Promise<void> {
  const tasks: Promise<void, IoError>[] = [];
  for (let t: i64 = 0; t < 4; t++) {
    tasks.push(spawn(numbered(ws, t, 500)));
  }
  await Promise.all(tasks);
  await ws.close(1000, "all sent");
  await done.send("crowd sent");
}

async function quiet(ws: WebSocket, done: Channel<string>): Promise<void> {
  while ((await ws.receive()) != null) {}
  await ws.close();
  await done.send("quiet closed");
}

async function main() {
  const done = channel<string>();
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const up = upgradeWebSocket(req);
    const path = new URL(req.url).pathname;
    if (path == "/early") {
      // Before the 101 is returned: queued, and sent right after it.
      const ws = up.socket;
      await ws.send("first");
      await ws.sendBytes([2u8]);
      await ws.send("third");
      spawn(async () => {
        await ws.close();
        await done.send("early sent");
      });
    } else if (path == "/flood") {
      spawn(flood(up.socket, done));
    } else if (path == "/quiet") {
      spawn(quiet(up.socket, done));
    } else {
      spawn(crowd(up.socket, done));
    }
    return up.response;
  });
  const base = `ws://127.0.0.1:${server.port}`;

  const early = await connectWebSocket(`${base}/early`);
  const got: string[] = [];
  for await (const m of early) {
    got.push(m.isBinary ? `bytes ${m.data}` : m.text);
  }
  console.log(got.join(", "), "|", await done.receive());
  await early.close();

  const flood = await connectWebSocket(`${base}/flood`);
  let next = 0;
  let inOrder = true;
  let last = "";
  for await (const m of flood) {
    if (m.text.length > 100) {
      inOrder =
        inOrder && m.text.startsWith(`${next}:`) && m.text.length == BIG + `${next}:`.length;
      next++;
    } else {
      last = m.text;
    }
  }
  console.log("flood:", next, "in order:", inOrder, "then:", last, "|", await done.receive());
  await flood.close();

  const crowd = await connectWebSocket(`${base}/crowd`);
  const seen: i64[] = [0, 0, 0, 0];
  let perTask = true;
  for await (const m of crowd) {
    const parts = m.text.split(":");
    const task = parseInt(parts[0], 10) as i64;
    perTask = perTask && (parseInt(parts[1], 10) as i64) == seen[task];
    seen[task] += 1;
  }
  console.log("crowd:", seen, "each task in order:", perTask, "|", await done.receive());
  await crowd.close();

  // A send after the close frame was queued is refused, and so is one on a released handle.
  const late = await connectWebSocket(`${base}/quiet`);
  const closing = late.close();
  try {
    await late.send("too late");
    console.log("unexpected");
  } catch (e) {
    console.log("after close():", e.code, e.message);
  }
  await closing;
  try {
    await late.send("released");
  } catch (e) {
    console.log("released:", e.code, e.message);
  }
  console.log(await done.receive());
  await server.shutdown();
  done.close();
}
