// A proxy of an object shaped like a typed array is read as an array-like; its getters don't run.
function args(this: any, a: any, b: any): any {
  return `${this.tag}:${a},${b}`;
}
const f: any = args;
const self = { tag: "x" };
const like: any = new Proxy({ length: 1, byteLength: 1, byteOffset: 0, buffer: {}, 0: "a" } as any, {});
console.log(f.apply(self, like));
class Shape {
  length: number = 0;
  get byteLength(): number {
    console.log("getter ran");
    return 1;
  }
}
const shape: any = new Proxy(new Shape() as any, {});
console.log(f.apply(self, shape));
const view: any = new Proxy(new DataView(new ArrayBuffer(2)) as any, {});
console.log(f.apply(self, view));
const real: any = new Uint8Array([4, 5]);
console.log(f.apply(self, real));
