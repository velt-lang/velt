// Object.is, Array.isArray, Object.assign, Object.freeze, Object.fromEntries, Object.hasOwn,
// Object.prototype.hasOwnProperty.call / toString.call, Object.getPrototypeOf and prototypes,
// Object.create(null), as in Node (#925).

// Object.is: SameValue.
console.log(Object.is(NaN, NaN), Object.is(0, -0), Object.is(-0, -0), Object.is(1, 1), Object.is(NaN, 0));
console.log(Object.is("a", "a"), Object.is("a", "b"), Object.is(true, true), Object.is(null, null));
const o1 = { a: 1 };
const o2 = { a: 1 };
console.log(Object.is(o1, o1), Object.is(o1, o2), Object.is([1], [1]));
function changed<T>(a: T, b: T): boolean {
  return !Object.is(a, b);
}
console.log(changed(NaN, NaN), changed(0, -0), changed("x", "x"), changed(o1, o2));
const maybe: number | null = Math.random() > 2 ? 1 : null;
console.log(Object.is(maybe, null), Object.is(maybe, 0));
const u: number | string = Math.random() > 2 ? "s" : -0;
console.log(Object.is(u, 0), Object.is(u, -0), Object.is(u, "s"));
console.log(Object.is(1, "1"), Object.is(null, undefined), Object.is(undefined, undefined));

// Array.isArray, narrowing.
function len(x: number | number[]): number {
  return Array.isArray(x) ? x.length : x;
}
function first(x: string | string[] | null): string {
  if (!Array.isArray(x)) {
    return x === null ? "none" : x;
  }
  return x[0];
}
console.log(len(7), len([1, 2, 3]), first("s"), first(["a", "b"]), first(null));
console.log(Array.isArray([]), Array.isArray("abc"), Array.isArray({ length: 0 }));

// Object.assign.
const target = { a: 1, b: "x", c: true };
const same = Object.assign(target, { a: 2 }, { b: "y", a: 3 });
console.log(target, same === target);
class Point {
  x = 0;
  y = 0;
  private _label = "";
  set label(v: string) {
    this._label = `<${v}>`;
  }
  get label(): string {
    return this._label;
  }
}
const p = Object.assign(new Point(), { x: 5, label: "p" });
console.log(p.x, p.y, p.label);
const opt: { a: number; b?: string } = { a: 9 };
console.log(Object.assign({ a: 0, b: "kept" }, opt));
console.log(Object.assign({ a: 0, b: "kept" }, { a: 9, b: "new" } as { a: number; b?: string }));
const rec: Record<string, number> = { x: 1 };
const rec2 = Object.assign(rec, { y: 2 }, { x: 3 });
console.log(rec, rec2 === rec, Object.keys(rec));
const more: Record<string, number> = { "2": 2, z: 26 };
console.log(Object.assign({} as Record<string, number>, rec, more));

// Object.freeze of a new object literal.
const frozen = Object.freeze({ name: "inert", n: 0 });
console.log(frozen, frozen.name, Object.keys(frozen));
function show(v: Readonly<{ name: string; n: number }>): string {
  return `${v.name}:${v.n}`;
}
console.log(show(frozen));

// Object.fromEntries.
console.log(Object.fromEntries([["a", 1], ["b", 2], ["a", 3]]));
console.log(Object.fromEntries([["2", "two"], ["b", "bee"], ["1", "one"]]));
const m = new Map<string, boolean>([["on", true], ["off", false]]);
console.log(Object.fromEntries(m), Object.fromEntries(m.entries()));
function* pairs(): Generator<[string, number]> {
  yield ["g", 1];
  yield ["h", 2];
}
console.log(Object.fromEntries(pairs()));

// Own keys: Object.hasOwn, Object.prototype.hasOwnProperty.call.
const hasOwn = (o: Record<string, number>, k: string): boolean => Object.prototype.hasOwnProperty.call(o, k);
console.log(hasOwn(rec, "x"), hasOwn(rec, "nope"), hasOwn(rec, "toString"));
console.log(Object.prototype.hasOwnProperty.call(rec, "y"), Object.hasOwn(rec, "y"), Object.hasOwn(rec, "q"));
const withOpt: { a: number; b?: string } = { a: 1 };
const key: string = "b";
console.log(Object.hasOwn(withOpt, "a"), Object.hasOwn(withOpt, key), Object.hasOwn({ a: 1, b: "x" }, key));
console.log(Object.hasOwn(p, "x"), Object.hasOwn(p, "label"), Object.hasOwn(p, "toString"));
class Base {
  base = 1;
}
class Derived extends Base {
  extra = 2;
}
const asBase: Base = new Derived();
console.log(Object.hasOwn(asBase, "extra"), Object.hasOwn(new Base(), "extra"));

// Object.prototype.toString.call.
const tag = (v: string): void => console.log(v);
tag(Object.prototype.toString.call([1]));
tag(Object.prototype.toString.call("s"));
tag(Object.prototype.toString.call(1.5));
tag(Object.prototype.toString.call(false));
tag(Object.prototype.toString.call(new Map<string, number>()));
tag(Object.prototype.toString.call(new Set<number>()));
tag(Object.prototype.toString.call(new Date(0)));
tag(Object.prototype.toString.call(new TypeError("t")));
tag(Object.prototype.toString.call(p));
tag(Object.prototype.toString.call(rec));
tag(Object.prototype.toString.call(() => 1));
tag(Object.prototype.toString.call(maybe));
tag(Object.prototype.toString.call(u));

// Object.getPrototypeOf, Object.prototype, C.prototype.
console.log(Object.getPrototypeOf({ a: 1 }) === Object.prototype, Object.getPrototypeOf(rec) === Object.prototype);
console.log(Object.getPrototypeOf(p) === Point.prototype, Object.getPrototypeOf(p) === Object.prototype);
console.log(Object.getPrototypeOf(asBase) === Derived.prototype, Object.getPrototypeOf(asBase) === Base.prototype, Object.getPrototypeOf(new Base()) === Base.prototype);
console.log(Object.getPrototypeOf([1]) === Array.prototype, Object.getPrototypeOf(m) === Map.prototype, Object.getPrototypeOf(m) !== Object.prototype);
function isPlainObject(v: { a: number } | Point | number[]): boolean {
  if (Array.isArray(v)) {
    return false;
  }
  const proto = Object.getPrototypeOf(v);
  return proto === Object.prototype || proto === null;
}
console.log(isPlainObject({ a: 1 }), isPlainObject(p), isPlainObject([]));
console.log(Object.prototype, Point.prototype, Derived.prototype, Array.prototype, Map.prototype);
console.log([Object.getPrototypeOf(p)], { proto: Object.prototype });
console.log(String(Object.prototype), `${Point.prototype}`, JSON.stringify(Object.prototype), JSON.stringify(Array.prototype));

// Object.create(null): a record without a prototype.
const dict: Record<string, number> = Object.create(null);
dict["a"] = 1;
dict.b = 2;
console.log(dict, Object.keys(dict), JSON.stringify(dict), dict["a"]);
console.log("toString" in dict, "toString" in rec, "a" in dict, "constructor" in dict);
const k1: string = "toString";
console.log(k1 in dict, k1 in rec);
console.log(Object.getPrototypeOf(dict) === null, Object.getPrototypeOf(dict) === Object.prototype);
const empty: Record<string, string> = Object.create(null);
console.log(empty, [empty]);
const nested = { deep: { deeper: { dict, empty } } };
console.log(nested);
console.log({ ...dict }, Object.getPrototypeOf({ ...dict }) === Object.prototype);
console.log(Object.hasOwn(dict, "a"), Object.hasOwn(dict, "toString"));
