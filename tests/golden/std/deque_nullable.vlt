// check: no leaks
// A `Deque` whose element type allows `null` or `undefined` keeps a stored `null` and a stored
// `undefined` apart from an empty deque (the slots are `(T | undefined)[]`): `peekFront`, `at`,
// `popFront`, `toArray` and `forEach` give the stored value, as an array would.
import { Deque } from "velt:collections/deque";

function main() {
  const d = new Deque<string | null>();
  d.pushBack(null);
  d.pushBack("a");
  console.log(d.peekFront(), d.at(0), d.toArray(), d.length);
  console.log(d.popFront(), d.popFront(), d.popFront(), d.peekBack());

  const u = new Deque<number | undefined>();
  u.pushBack(undefined);
  u.pushFront(2);
  console.log(u.toArray(), u.at(1), u.length);
  u.forEach((x) => console.log("each", x));

  const b = new Deque<string | null | undefined>();
  for (let i = 0; i < 10; i++) {
    b.pushBack(i % 3 == 0 ? null : i % 3 == 1 ? undefined : `s${i}`);
  }
  console.log(b.toArray(), b.popBack(), b.popFront(), b.popFront(), b.length);
}
