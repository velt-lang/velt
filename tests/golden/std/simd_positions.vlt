// A `number` given as a position or lane index is used as itself when it is a whole number from
// 0 up; any other number is out of range (#1055): `fits` gives `false`, `load`, `store`, `lane`
// and `withLane` panic with their RangeError. Lane values and shift counts are converted as std
// converts every `number` it takes as an integer.

import { u8x16, f32x4 } from "velt:simd";

function main() {
  const d: u8[] = Buffer.alloc(32);
  d[0] = 7;
  d[2] = 9;
  const positions: number[] = [0, 2, 16, 17, -1, -0.5, 1.5, NaN, Infinity, -Infinity, 2 ** 64];
  for (const at of positions) {
    console.log(at, u8x16.fits(d, at), f32x4.fits([1, 2, 3, 4, 5], at));
  }
  const two: number = 2;
  console.log(u8x16.load(d, two).lane(0), u8x16.splat(4).withLane(two, 5).lane(two));
  const big: number = 300;
  const back: number = -1;
  console.log(u8x16.splat(big).lane(0), u8x16.splat(1).shl(back).lane(0));
  const at: number = -1;
  console.log(u8x16.load(d, at).lane(0));
}
