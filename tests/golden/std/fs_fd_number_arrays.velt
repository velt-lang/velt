// requires: unix
// Node's `readSync` and `writeSync` with arrays of a number type (`f32[]`, `i8[]`, `u32[]`,
// `f64[]`, as Node's `Float32Array`, `Int8Array`, `Uint32Array` and `Float64Array`): read into
// and written from the array's own memory, with `offset`, `length` and the result counting
// bytes as Node does for typed arrays (an offset inside an element included), and Node's errors.
// This program prints what `node` prints for the same calls on typed arrays
// (fs_fd_number_arrays.mjs beside it).
import * as fs from "velt/fs";

function attempt(f: () => string) {
  try {
    console.log(f());
  } catch (e) {
    console.log(e.name, e.message);
  }
}

function f32s(xs: f32[]): string {
  return xs.map((x) => x as number).join(",");
}

function main() {
  const path = "velt_fs_fd_number_arrays_tmp.bin";
  const w = fs.openSync(path, "w+");
  // Written from the array itself: 16 bytes of f32, then 5 of i8, then 8 of u32 at a position.
  const fs4: f32[] = [1.5, -2.25, 3, 0.5];
  console.log("write f32", fs.writeSync(w, fs4));
  const small: i8[] = [-1, 2, -3, 127, -128];
  console.log("write i8", fs.writeSync(w, small, 0, 5, 16));
  const words: u32[] = [0x04030201, 0xdeadbeef, 0x0c0b0a09];
  console.log("write u32 part", fs.writeSync(w, words, 4, 8, 21));
  console.log("file", fs.readFileBytesSync(path).join(","));

  // Read back into arrays of each type.
  const back: f32[] = [0, 0, 0, 0];
  console.log("read f32", fs.readSync(w, back, 0, 16, 0), f32s(back));
  const codes: i8[] = [0, 0, 0, 0, 0, 0];
  console.log("read i8", fs.readSync(w, codes, 1, 5, 16), codes.join(","));
  const ids: u32[] = [0, 0, 0];
  console.log("read u32", fs.readSync(w, ids, 4, 8, 21), ids.join(","));
  // At the end of the file: fewer bytes than asked, the rest of the array untouched.
  const tail: f64[] = [7, 7];
  console.log("read f64 at end", fs.readSync(w, tail, 0, 16, 21), tail[1]);
  // An offset inside an element: bytes 2..5 of the array, a partial element each side.
  const halves: f32[] = [0, 0];
  console.log("read f32 unaligned", fs.readSync(w, halves, 2, 4, 0), f32s(halves));
  // Without a position: at the file's own position, which advances.
  const r = fs.openSync(path, "r");
  const first: u32[] = [0, 0];
  console.log("read u32 at fd position", fs.readSync(r, first), first.join(","));
  console.log("and the next", fs.readSync(r, first, 0, 4), first.join(","));

  // Node's errors, counted in bytes.
  attempt(() => `${fs.readSync(r, [0, 0] as f32[], 0, 9, 0)}`);
  attempt(() => `${fs.readSync(r, [0, 0] as f32[], 9, 0, 0)}`);
  attempt(() => `${fs.readSync(r, [] as f64[], 0, 1, 0)}`);
  attempt(() => `${fs.writeSync(w, [1, 2] as u32[], 2, 7, 0)}`);
  fs.closeSync(r);
  fs.closeSync(w);
  fs.unlinkSync(path);
}
main();
