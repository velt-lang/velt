// `f32x8` from velt/simd (#3140): every operation gives, in each lane, the bits `f32x4` gives
// for the matching half, on special values (signed zeros, infinities, NaN payloads, subnormals,
// the largest float) and on pseudo-random ones; a result assigned over one of its operands
// reads the operand first; `load` and `store` reach the array's last 8 elements and no further;
// and a dot product kernel with `mulAddFast` equals the `f32x4` kernel that adds in the same
// order (their last bit may differ between CPUs, but not between the two widths on one CPU).

import { f32x4, f32x8 } from "velt/simd";

let seed: u32 = 2463534242;

function next(): u32 {
  seed = seed ^ (seed << 13);
  seed = seed ^ (seed >>> 17);
  seed = seed ^ (seed << 5);
  return seed;
}

function bits(v: f32x8): string {
  const out: string[] = [];
  for (let k: usize = 0; k < 8; k++) {
    const x = v.lane(k);
    out.push(x != x ? "nan" : x.toBits().toString(16));
  }
  return out.join(" ");
}

function same(v: f32x8, lo: f32x4, hi: f32x4): bool {
  return bits(v) == bits(f32x8.join(lo, hi));
}

// Each operation against `f32x4` on the halves; the names of those that differ.
function check(a: f32x8, b: f32x8, c: f32x8): string {
  const wrong: string[] = [];
  const [al, ah, bl, bh, cl, ch] = [a.low(), a.high(), b.low(), b.high(), c.low(), c.high()];
  if (!same(a.add(b), al.add(bl), ah.add(bh))) {
    wrong.push("add");
  }
  if (!same(a.sub(b), al.sub(bl), ah.sub(bh))) {
    wrong.push("sub");
  }
  if (!same(a.mul(b), al.mul(bl), ah.mul(bh))) {
    wrong.push("mul");
  }
  if (!same(a.div(b), al.div(bl), ah.div(bh))) {
    wrong.push("div");
  }
  if (!same(a.min(b), al.min(bl), ah.min(bh))) {
    wrong.push("min");
  }
  if (!same(a.max(b), al.max(bl), ah.max(bh))) {
    wrong.push("max");
  }
  if (!same(a.neg(), al.neg(), ah.neg())) {
    wrong.push("neg");
  }
  if (!same(a.abs(), al.abs(), ah.abs())) {
    wrong.push("abs");
  }
  if (!same(a.sqrt(), al.sqrt(), ah.sqrt())) {
    wrong.push("sqrt");
  }
  if (!same(a.mulAdd(b, c), al.mulAdd(bl, cl), ah.mulAdd(bh, ch))) {
    wrong.push("mulAdd");
  }
  return wrong.join(",");
}

function vector(xs: u32[], at: usize): f32x8 {
  const fs: f32[] = [];
  for (let k: usize = 0; k < 8; k++) {
    fs.push(f32.fromBits(xs[(at + k) % xs.length]));
  }
  return f32x8.load(fs);
}

function specials() {
  // 0, -0, 1, -1, Infinity, -Infinity, a quiet NaN with a payload, the smallest subnormal, the
  // largest float, 1.5, -2.5, 1e-30, a negative subnormal, 3, 2^24, 0.1.
  const xs: u32[] = [
    0x00000000,
    0x80000000,
    0x3f800000,
    0xbf800000,
    0x7f800000,
    0xff800000,
    0x7fc12345,
    0x00000001,
    0x7f7fffff,
    0x3fc00000,
    0xc0200000,
    0x0da24260,
    0x80000003,
    0x40400000,
    0x4b800000,
    0x3dcccccd,
  ];
  let wrong = "";
  for (let i: usize = 0; i < 16; i++) {
    for (let j: usize = 0; j < 16; j += 3) {
      wrong += check(vector(xs, i), vector(xs, j), vector(xs, i + j + 5));
    }
  }
  console.log(`special values: wrong "${wrong}"`);
  const a = vector(xs, 0);
  const b = vector(xs, 8);
  console.log("a      ", bits(a));
  console.log("b      ", bits(b));
  console.log("add    ", bits(a.add(b)));
  console.log("mul    ", bits(a.mul(b)));
  console.log("min    ", bits(a.min(b)));
  console.log("max    ", bits(a.max(b)));
  console.log("sqrt   ", bits(b.sqrt()));
  console.log("mulAdd ", bits(a.mulAdd(b, b)));
}

function random() {
  let wrong = "";
  for (let round = 0; round < 200; round++) {
    const xs: u32[] = [];
    for (let k = 0; k < 24; k++) {
      // Numbers of every size, some of them special.
      xs.push(next());
    }
    wrong += check(vector(xs, 0), vector(xs, 8), vector(xs, 16));
  }
  console.log(`200 random rounds: wrong "${wrong}"`);
}

// The result over an operand: the operation reads all of its operands before it writes.
function overOperands() {
  let v = f32x8.load([1, 2, 3, 4, 5, 6, 7, 8]);
  const w = f32x8.load([0.5, 0.25, 2, 4, 8, 16, 32, 64]);
  v = v.add(v);
  console.log("v + v          ", bits(v));
  v = v.mulAdd(v, v);
  console.log("v * v + v      ", bits(v));
  v = w.sub(v);
  console.log("w - v          ", bits(v));
  let acc = f32x8.splat(1);
  for (let i = 0; i < 5; i++) {
    acc = w.mulAdd(acc, acc);
  }
  console.log("acc = w*acc+acc", bits(acc));
  console.log("sum", acc.sum(), acc.low().add(acc.high()).sum(), f32x8.splat(0.5).sum());
}

function arrays() {
  const xs: f32[] = [];
  for (let i = 0; i < 19; i++) {
    xs.push((i * i) as f32);
  }
  console.log(
    "fits",
    f32x8.fits(xs, 0),
    f32x8.fits(xs, 11),
    f32x8.fits(xs, 12),
    f32x8.fits(xs, 19),
    f32x8.fits(xs, 20),
  );
  console.log("load 11", bits(f32x8.load(xs, 11)));
  const out: f32[] = new Array<f32>(10).fill(-1);
  f32x8.load(xs, 3).neg().store(out, 2);
  console.log("store", out.join(" "));
  const v = f32x8.join(f32x4.load(xs, 0), f32x4.load(xs, 8));
  console.log("join", bits(v), v.lane(0), v.lane(3), v.lane(4), v.lane(7));
}

function dot8(a: f32[], b: f32[]): f32 {
  let s0 = f32x8.splat(0);
  let s1 = f32x8.splat(0);
  let i: usize = 0;
  while (f32x8.fits(a, i + 8) && f32x8.fits(b, i + 8)) {
    s0 = f32x8.load(a, i).mulAddFast(f32x8.load(b, i), s0);
    s1 = f32x8.load(a, i + 8).mulAddFast(f32x8.load(b, i + 8), s1);
    i += 16;
  }
  return s0.add(s1).sum();
}

// The same sums in the same order with `f32x4`: accumulators 0 and 2 are the halves of `s0`.
function dot4(a: f32[], b: f32[]): f32 {
  let s0 = f32x4.splat(0);
  let s1 = f32x4.splat(0);
  let s2 = f32x4.splat(0);
  let s3 = f32x4.splat(0);
  let i: usize = 0;
  while (f32x4.fits(a, i + 12) && f32x4.fits(b, i + 12)) {
    s0 = f32x4.load(a, i).mulAddFast(f32x4.load(b, i), s0);
    s1 = f32x4.load(a, i + 4).mulAddFast(f32x4.load(b, i + 4), s1);
    s2 = f32x4.load(a, i + 8).mulAddFast(f32x4.load(b, i + 8), s2);
    s3 = f32x4.load(a, i + 12).mulAddFast(f32x4.load(b, i + 12), s3);
    i += 16;
  }
  return s0.add(s2).add(s1.add(s3)).sum();
}

function kernels() {
  const a: f32[] = [];
  const b: f32[] = [];
  for (let i = 0; i < 400; i++) {
    a.push(((next() % 2000) as number / 1000 - 1) as f32);
    b.push(((next() % 2000) as number / 1000 - 1) as f32);
  }
  console.log("dot8 == dot4", dot8(a, b) == dot4(a, b), Math.abs(dot8(a, b) - 0.9) < 20);
}

function main() {
  specials();
  random();
  overOperands();
  arrays();
  kernels();
}
