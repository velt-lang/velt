  "WITH old AS (SELECT * FROM users WHERE age >= 30) SELECT name FROM old ORDER BY name",
  "WITH a(n) AS (SELECT 1 UNION ALL SELECT 2), b AS (SELECT n * 10 AS m FROM a) SELECT n, m FROM a, b ORDER BY n, m",
  "SELECT 1 IN (SELECT 1), 2 IN (SELECT 1), NULL IN (SELECT 1 WHERE 0), 3 IN (SELECT NULL)",
  "WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 5) SELECT i, i * i FROM n",
  "WITH RECURSIVE n(i) AS (SELECT 1 UNION SELECT (i * 3) % 7 FROM n) SELECT i FROM n",
  "WITH RECURSIVE r(id, depth) AS (SELECT 1, 0 UNION ALL SELECT p.id, r.depth + 1 FROM posts p JOIN r ON p.user_id = r.id WHERE p.id != r.id) SELECT id, depth FROM r ORDER BY depth, id",
  "SELECT id FROM posts ORDER BY id DESC LIMIT 3",
  "SELECT id, created FROM posts WHERE created < '2024-01-05' ORDER BY created, id DESC",
  "SELECT title FROM posts ORDER BY title DESC LIMIT 2",
  // Compound selects and VALUES.
  "SELECT age FROM users UNION SELECT user_id FROM posts",
  "SELECT age FROM users UNION ALL SELECT user_id FROM posts ORDER BY 1",
  "SELECT user_id FROM posts INTERSECT SELECT id FROM users",
  "SELECT id FROM users EXCEPT SELECT user_id FROM posts ORDER BY 1 DESC",
  "SELECT 1, 'a' UNION ALL SELECT 2, 'b' UNION SELECT 1, 'a'",
  "VALUES (1, 'x'), (2, NULL), (3, 4.5)",
  "SELECT * FROM (VALUES (2), (1), (3)) ORDER BY 1",
  // Rowid bounds past the integers: a REAL of 2^63 or more is above every rowid, one under -2^63 below.
  "SELECT id FROM users WHERE id < 1e19 AND id > -1e30 ORDER BY id",
  "SELECT id FROM users WHERE id <= 9.2233720368547758e18 ORDER BY id DESC LIMIT 2",
  "SELECT id FROM users WHERE id > 1e19 OR id < -1e30 OR id = 1e19",
  // FROM subqueries and CTEs run as co-routines: a LIMIT outside stops them (an endless recursion too).
  "WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT n FROM r LIMIT 3",
  "WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r) SELECT n * 2 FROM r WHERE n % 3 = 0 LIMIT 2 OFFSET 1",
  "SELECT name FROM (SELECT name FROM users ORDER BY id) LIMIT 2",
  "SELECT * FROM (SELECT id, abs(-9223372036854775807 - 1) FROM users) LIMIT 1",
  "SELECT nick FROM users UNION SELECT name FROM users ORDER BY 1 COLLATE BINARY DESC LIMIT 4",
  "SELECT tag FROM tags INTERSECT SELECT nick FROM users ORDER BY 1 COLLATE NOCASE",
  "SELECT nick FROM users EXCEPT SELECT tag FROM tags ORDER BY nick COLLATE RTRIM",
  // An aggregate whose arguments read only an enclosing query's columns belongs to that query (SQLite's rule).
  "SELECT (SELECT sum(id)) FROM users",
  "SELECT age, (SELECT sum(users.id)) FROM users GROUP BY age ORDER BY 1",
  "SELECT age, count(*) FROM users GROUP BY age HAVING (SELECT count(users.id)) > 1 ORDER BY 1",
  "SELECT (SELECT count(*) FROM posts WHERE posts.id = max(users.id)) FROM users",
  "SELECT (SELECT max(id)), count(*) FROM users",
  "SELECT id FROM users WHERE (SELECT sum(users.id)) > 1",
  // min() or max() alone of an indexed column reads the index from that end (SQLite's min/max optimization): its bare columns are that entry's.
  "SELECT max(tag), post_id FROM tags",
  "SELECT min(tag), post_id FROM tags WHERE post_id > 3",
  "SELECT max(tag COLLATE NOCASE), post_id FROM tags",
  "SELECT min(tag), count(*) FROM tags",
  // A CTE is compiled once and shared by its uses; each use counts its tables' references (SQLite's limit of 65535).
  "WITH c0(x) AS (SELECT id FROM users), c1(x) AS (SELECT a.x FROM c0 a JOIN c0 b ON a.x = b.x), c2(x) AS (SELECT a.x FROM c1 a JOIN c1 b ON a.x = b.x), c3(x) AS (SELECT a.x FROM c2 a JOIN c2 b ON a.x = b.x), c4(x) AS (SELECT a.x FROM c3 a JOIN c3 b ON a.x = b.x), c5(x) AS (SELECT a.x FROM c4 a JOIN c4 b ON a.x = b.x), c6(x) AS (SELECT a.x FROM c5 a JOIN c5 b ON a.x = b.x), c7(x) AS (SELECT a.x FROM c6 a JOIN c6 b ON a.x = b.x), c8(x) AS (SELECT a.x FROM c7 a JOIN c7 b ON a.x = b.x), c9(x) AS (SELECT a.x FROM c8 a JOIN c8 b ON a.x = b.x), c10(x) AS (SELECT a.x FROM c9 a JOIN c9 b ON a.x = b.x), c11(x) AS (SELECT a.x FROM c10 a JOIN c10 b ON a.x = b.x), c12(x) AS (SELECT a.x FROM c11 a JOIN c11 b ON a.x = b.x), c13(x) AS (SELECT a.x FROM c12 a JOIN c12 b ON a.x = b.x), c14(x) AS (SELECT a.x FROM c13 a JOIN c13 b ON a.x = b.x), c15(x) AS (SELECT a.x FROM c14 a JOIN c14 b ON a.x = b.x), c16(x) AS (SELECT a.x FROM c15 a JOIN c15 b ON a.x = b.x) SELECT count(*) FROM c16",
  "WITH c0(x) AS (SELECT id FROM users), c1(x) AS (SELECT a.x FROM c0 a JOIN c0 b ON a.x = b.x), c2(x) AS (SELECT a.x FROM c1 a JOIN c1 b ON a.x = b.x), c3(x) AS (SELECT a.x FROM c2 a JOIN c2 b ON a.x = b.x), c4(x) AS (SELECT a.x FROM c3 a JOIN c3 b ON a.x = b.x), c5(x) AS (SELECT a.x FROM c4 a JOIN c4 b ON a.x = b.x), c6(x) AS (SELECT a.x FROM c5 a JOIN c5 b ON a.x = b.x), c7(x) AS (SELECT a.x FROM c6 a JOIN c6 b ON a.x = b.x), c8(x) AS (SELECT a.x FROM c7 a JOIN c7 b ON a.x = b.x), c9(x) AS (SELECT a.x FROM c8 a JOIN c8 b ON a.x = b.x), c10(x) AS (SELECT a.x FROM c9 a JOIN c9 b ON a.x = b.x), c11(x) AS (SELECT a.x FROM c10 a JOIN c10 b ON a.x = b.x), c12(x) AS (SELECT a.x FROM c11 a JOIN c11 b ON a.x = b.x) SELECT count(*), sum(x) FROM c12",
  "WITH c(x) AS (SELECT id FROM users) SELECT a.x, b.x FROM c a, c b WHERE a.x + 1 = b.x ORDER BY 1",
  // Only GROUP BY or an aggregate result column makes a query an aggregate one: HAVING or ORDER BY aggregates alone are errors, as in SQLite.
  "SELECT 1 FROM users HAVING count(*) > 3",
  "SELECT id FROM users ORDER BY count(*)",
  "SELECT count(*) FROM users ORDER BY sum(id)",
  "SELECT count(*) FROM users HAVING sum(id) > 3",
  // What SQLite rejects at prepare: likelihood() without a REAL literal of at most 1.0, INDEXED BY an unknown index, schemas other than main; printf() writing nothing is NULL, a final '%' itself; GROUP BY numbers count the columns * expands to.
  "SELECT likelihood(id, 2) FROM users",
  "SELECT likelihood(id, 0.5) FROM users WHERE id < 3",
  "SELECT id FROM users INDEXED BY nope",
  "SELECT tag FROM tags INDEXED BY tags_tag WHERE tag = 'misc' ORDER BY 1",
  "SELECT id FROM nosuch.users",
  "SELECT id FROM temp.users",
  "SELECT id FROM main.users WHERE id = 2",
  "SELECT printf(''), printf('%s', ''), printf('ab%'), printf('a%5'), printf('%5.2'), printf('%')",
  "SELECT * FROM (VALUES (1, 'a'), (2, 'b'), (1, 'c')) GROUP BY 1",
  "SELECT *, length(tag) FROM tags GROUP BY 3 ORDER BY 3",
  // IS and IS NULL look up an index as equalities (NULL finds NULL).
  "SELECT post_id, tag FROM tags WHERE tag IS 'misc' ORDER BY 1",
  "SELECT k FROM kv WHERE k IS NULL",
  "SELECT p.id, t.tag FROM posts p JOIN tags t ON t.tag IS p.title ORDER BY 1",
  // x = a OR x = b on an indexed column reads the index once per value, as x IN (a, b).
  "SELECT post_id, tag FROM tags WHERE tag = 'news' OR tag = 'intro' ORDER BY 1, 2",
  "SELECT DISTINCT tag FROM tags WHERE tag = 'x' OR 'misc' = tag",
  "SELECT id FROM posts WHERE user_id = 3 OR user_id = 2",
  // x IN (SELECT …) on an indexed column (or the rowid) reads it once per subquery value.
  "SELECT post_id, tag FROM tags WHERE tag IN (SELECT title FROM posts)",
  "SELECT id, name FROM users WHERE id IN (SELECT user_id FROM posts WHERE stars > 2)",
  "SELECT DISTINCT tag FROM tags WHERE tag IN (SELECT tag FROM tags WHERE post_id > 4)",
  // count(*) alone counts the loops' rows (LIMIT and OFFSET still apply to its one row).
  "SELECT count(*) FROM posts WHERE user_id = 3",
  "SELECT count(*) FROM posts LIMIT 1 OFFSET 1",
  "SELECT id, (SELECT count(*) FROM tags WHERE tags.post_id = posts.id) FROM posts ORDER BY id",
  // Equal keys of different forms: a REAL equal to an INTEGER, and texts equal under NOCASE.
  "SELECT a, count(*) FROM (SELECT 1 AS a UNION ALL SELECT 1.0) GROUP BY a",
  "SELECT DISTINCT a FROM (SELECT 1 AS a UNION ALL SELECT 1.0)",
  "SELECT count(DISTINCT a) FROM (SELECT 1 AS a UNION ALL SELECT 1.0)",
  "SELECT 1 UNION SELECT 1.0",
  "SELECT x COLLATE NOCASE, count(*) FROM (SELECT 'a' AS x UNION ALL SELECT 'A') GROUP BY 1",
  "SELECT DISTINCT x COLLATE NOCASE FROM (SELECT 'a' AS x UNION ALL SELECT 'A')",
  "SELECT count(DISTINCT x COLLATE NOCASE), count(DISTINCT x) FROM (SELECT 'a' AS x UNION ALL SELECT 'A')",
  // Errors.
  "SELECT nosuch FROM users",
  "SELECT * FROM nosuch",
  "SELECT id FROM users, posts",
  "SELECT count(*) FROM users WHERE count(*) > 1",
  // Where name resolution allows no aggregate, SQLite's other message.
  "SELECT count(count(*)) FROM users",
  "SELECT max(count(*)) FROM users",
  "SELECT id FROM users WHERE count(*) > 1",
  // An outer query's aggregate in a subquery in ORDER BY: too late to make it an aggregate query.
  "SELECT id FROM users ORDER BY (SELECT count(users.id) FROM posts)",
  // Where the call is written must allow an aggregate, even one of an enclosing query: not in
  // a subquery's WHERE or ON unless the subquery is an aggregate query; in its ORDER BY or HAVING
  // it may be.
  "SELECT (SELECT 1 FROM posts WHERE count(users.id) > 0) FROM users",
  "SELECT count(*), (SELECT 1 FROM posts WHERE count(users.id) > 0) FROM users",
  "SELECT (SELECT 1 FROM posts JOIN posts AS q ON count(users.id) > 0) FROM users",
  "SELECT (SELECT 1 FROM posts WHERE count(users.id) > 0 LIMIT 1) FROM users",
  "SELECT (SELECT 1 WHERE count(users.id) > 0) FROM users",
  "SELECT (SELECT 1 FROM posts WHERE posts.user_id IN (SELECT 1 WHERE count(users.id) > 0)) FROM users",
  "SELECT age, (SELECT 1 FROM posts WHERE count(users.id) > 0) FROM users GROUP BY age",
  "SELECT id FROM users WHERE (SELECT 1 FROM posts WHERE count(users.id) > 0)",
  "SELECT (SELECT count(*) FROM posts WHERE count(users.id) > 0) FROM users",
  "SELECT (SELECT max(posts.id) FROM posts WHERE count(users.id) > 0) FROM users",
  "SELECT (SELECT 1 FROM posts ORDER BY count(users.id)) FROM users",
  "SELECT (SELECT count(*) FROM posts HAVING count(users.id) > 0) FROM users",
  // LIMIT and OFFSET name no column, not even an enclosing query's.
  "SELECT (SELECT 1 FROM posts LIMIT count(users.id)) FROM users",
  "SELECT id FROM users WHERE EXISTS (SELECT 1 FROM posts LIMIT max(users.id))",
  "SELECT id FROM users LIMIT (SELECT count(users.id) FROM posts)",
  "SELECT (SELECT 1 FROM posts LIMIT 1 OFFSET users.id) FROM users",
  "SELECT (SELECT 1 UNION SELECT 2 LIMIT users.id) FROM users",
  "SELECT (WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r LIMIT users.id) SELECT count(*) FROM r) FROM users",
  "SELECT nosuchfn(1)",
  "SELECT substr('x')",
  "SELECT 1 FROM users ORDER BY 5",
  "SELECT 1 UNION SELECT 1, 2",
];

/** A value as the shell's quote mode prints it: quote(), but blobs as x'…' and Inf. */
function shown(v: Val): string {
  if (v.t == BLOB) {
    return `x'${hexEncode(v.b)}'`;
  }
  if (v.t == REAL && (v.r == Infinity || v.r == -Infinity)) {
    return v.r > 0 ? "Inf" : "-Inf";
  }
  return quote(v);
}

/** The rows of a query: each value as the shell's quote mode prints it, or the error. */
function rows(db: Database, sql: string): string[] {
  const out: string[] = [];
  try {
    const st = db.prepare(sql);
    const vals = st.values();
    const n = st.columns().length as usize;
    const count: usize = n == 0 ? 0 : (vals.length as usize) / n;
    for (let r: usize = 0; r < count; r++) {
      const parts: string[] = [];
      for (let i: usize = 0; i < n; i++) {
        const v = vals[r * n + i];
        parts.push(shown(v));
      }
      out.push(parts.join(","));
    }
  } catch (e) {
    return [`error: ${e.message}`];
  }
  return out;
}

function main() {
  const path = `${tmpdir()}/velt-engine-query-${uuidv4()}.db`;
  const c = open(path);
  c.exec(SETUP);
  c.close();
  const db = openDatabase(path);
  for (const q of QUERIES) {
    let r = rows(db, q);
    if (!q.includes("ORDER BY")) {
      r = r.toSorted();
    }
    console.log(q);
    for (const line of r) {
      console.log(`  ${line}`);
    }
  }
  removeSync(path);
}
