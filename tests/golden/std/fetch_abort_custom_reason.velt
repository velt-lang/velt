// A `fetch` aborted with a custom reason rejects with that value itself in Node, and
// `signal.reason` is it. Velt throws an `AbortError` whose `cause` it is (#3005: known failing). The server is velt/net's. The same request in Node, to a `node:net` server that
// accepts and never answers, prints this file's output.
import { channel } from "velt/sync";
import { listen, TcpStream } from "velt/net";

async function main() {
  const server = await listen("127.0.0.1:0");
  // Accepts the request and answers nothing, until `done`.
  const done = channel<bool>();
  const accepting = spawn(async () => {
    const conn: TcpStream = await server.accept();
    await done.receive();
    conn.close();
  });
  const c = new AbortController();
  setTimeout(() => c.abort("user"), 50);
  try {
    await fetch(`http://127.0.0.1:${server.port}/`, { signal: c.signal });
    console.log("custom: answered");
  } catch (e) {
    const x: any = e;
    console.log("custom:", c.signal.reason, typeof x, x === "user");
  }
  await done.send(true);
  await accepting;
  server.close();
}

// timing: an abort by a timer while the server holds the request
