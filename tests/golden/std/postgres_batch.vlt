// std/postgres batches: one statement with many parameter sets in one round trip (one Sync).
// Selects, first rows, updates, named parameters, an error in the middle (the SQLSTATE
// surfaces, nothing of the batch stays), empty and single-set batches, batches mixed with
// ordinary queries on one connection, inside a transaction, after a COPY, and on a pool.
// requires-env: VELT_TEST_PG_URL
import { connect, createPool, Client } from "velt:postgres";

class Item {
  id: i64;
  name: string;

  constructor(id: i64, name: string) {
    this.id = id;
    this.name = name;
  }
}

class Count {
  n: i64;

  constructor(n: i64) {
    this.n = n;
  }
}

function show(sets: Item[][]): string {
  const parts: string[] = [];
  for (const set of sets) {
    const names: string[] = [];
    for (const item of set) {
      names.push(`${item.id}:${item.name}`);
    }
    parts.push(`[${names.join(" ")}]`);
  }
  return parts.join(" ");
}

function showOne(items: (Item | null)[]): string {
  const parts: string[] = [];
  for (const item of items) {
    parts.push(item == null ? "null" : `${item.id}:${item.name}`);
  }
  return parts.join(" ");
}

async function total(db: Client): Promise<i64> {
  const c: Count | null = await db.selectOne("SELECT count(*)::int8 AS n FROM items");
  return c == null ? -1 : c.n;
}

async function single(db: Client, id: i64): Promise<string> {
  const item: Item | null = await db.queryOne("SELECT id, name FROM items WHERE id = $1", [id]);
  return item == null ? "none" : item.name;
}

async function selects(db: Client) {
  const sql = "SELECT id, name FROM items WHERE id <= $1 ORDER BY id";
  const sets: Item[][] = await db.batchQuery(sql, [[1], [3], [0]]);
  console.log("rows", show(sets));
  const one: (Item | null)[] = await db.batchQueryOne("SELECT id, name FROM items WHERE id = $1", [
    [2],
    [99],
    [1],
  ]);
  console.log("first", showOne(one));
  const named: Item[][] = await db.batchQuery("SELECT id, name FROM items WHERE name = :name", [
    { name: "c" },
    { name: "a" },
  ]);
  console.log("named", show(named));
  const none: i64[][] = [];
  const empty: Item[][] = await db.batchQuery(sql, none);
  console.log("empty", empty.length);
  const n1: Item[][] = await db.batchQuery(sql, [[2]]);
  console.log("one set", show(n1));
}

async function updates(db: Client) {
  const affected = await db.batchExecute(
    "UPDATE items SET name = name || :tail WHERE id >= :from",
    [
      { from: 3, tail: "!" },
      { from: 9, tail: "?" },
      { from: 1, tail: "+" },
    ],
  );
  console.log("affected", affected.join(","));
  const after: Item[][] = await db.batchQuery("SELECT id, name FROM items WHERE id = $1", [
    [1],
    [3],
  ]);
  console.log("after", show(after));
  const inserted = await db.batchExecute("INSERT INTO items VALUES (:id, :name)", [
    new Item(4, "d"),
  ]);
  console.log("inserted", inserted.join(","), await total(db));
}

async function failures(db: Client) {
  // The second insert violates the primary key: the third never runs, the first is undone.
  try {
    await db.batchExecute("INSERT INTO items VALUES (:id, :name)", [
      new Item(10, "x"),
      new Item(1, "dup"),
      new Item(11, "y"),
    ]);
    console.log("no error?");
  } catch (e) {
    console.log("dup", e.code, e.constraint);
  }
  console.log("count after dup", await total(db));
  try {
    const quotients: Count[][] = await db.batchQuery("SELECT 10 / $1 AS n", [[5], [0], [2]]);
    console.log(quotients.length);
  } catch (e) {
    console.log("division", e.code, e.message);
  }
  try {
    const wrong: Item[][] = await db.batchQuery("SELECT id, name FROM items WHERE id = $1", [
      [1],
      [1, 2],
    ]);
    console.log(wrong.length);
  } catch (e) {
    console.log("params", e.code, e.message);
  }
  try {
    const bad: Item[][] = await db.batchQuery("SELEC $1", [[1]]);
    console.log(bad.length);
  } catch (e) {
    console.log("syntax", e.code);
  }
  // The connection and the statement are still fine.
  const again: Item[][] = await db.batchQuery("SELECT id, name FROM items WHERE id = $1", [[2]]);
  console.log("again", show(again));
}

async function batched(db: Client, ids: i64[]): Promise<string> {
  const sets: i64[][] = [];
  for (const id of ids) {
    sets.push([id]);
  }
  const items: Item[][] = await db.batchQuery("SELECT id, name FROM items WHERE id = $1", sets);
  return show(items);
}

// Batches pipelined with ordinary queries on one connection keep their own results.
async function mixed(db: Client) {
  const results = await Promise.all([
    single(db, 1),
    batched(db, [2, 3]),
    single(db, 2),
    batched(db, [4]),
    single(db, 3),
  ]);
  console.log("mixed", results.join(" | "));
}

async function inTransaction(db: Client) {
  const tx = await db.begin();
  await db.batchExecute("UPDATE items SET name = :name WHERE id = :id", [
    new Item(1, "tx1"),
    new Item(2, "tx2"),
  ]);
  console.log("in tx", await single(db, 1), await single(db, 2));
  await tx.rollback();
  console.log("rolled back", await single(db, 1), await single(db, 2));
}

async function afterCopy(db: Client) {
  const w = await db.copyFrom("COPY items (id, name) FROM STDIN (FORMAT csv)");
  await w.write("20,t\n21,u\n");
  console.log("copied", await w.end());
  const sets: Item[][] = await db.batchQuery("SELECT id, name FROM items WHERE id = $1", [
    [20],
    [21],
  ]);
  console.log("after copy", show(sets));
}

async function main() {
  const url = process.env.VELT_TEST_PG_URL ?? "";
  const db = await connect(url);
  await db.batch(
    "CREATE TEMP TABLE items (id int PRIMARY KEY, name text NOT NULL); INSERT INTO items VALUES (1, 'a'), (2, 'b'), (3, 'c')",
  );
  await selects(db);
  await updates(db);
  await failures(db);
  await mixed(db);
  await inTransaction(db);
  await afterCopy(db);
  db.close();
  try {
    const none: i64[][] = [[]];
    const rows: Count[][] = await db.batchQuery("SELECT 1 AS n", none);
    console.log(rows.length);
  } catch (e) {
    console.log("closed", e.code);
  }

  const pool = createPool({ url: url, max: 2 });
  const squares: Count[][] = await pool.batchQuery("SELECT $1::int8 * $1 AS n", [[2], [3], [4]]);
  const parts: string[] = [];
  for (const s of squares) {
    parts.push(`${s[0].n}`);
  }
  console.log("pool", parts.join(","));
  const counts = await pool.batchExecute("SELECT generate_series(1, $1)", [[2], [5]]);
  console.log("pool counts", counts.join(","));
  pool.end();
}
