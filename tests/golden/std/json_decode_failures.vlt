// check: no leaks
// JSON.parse<T> failures after partly decoded owned values (strings, arrays, nested objects):
// the messages with their paths, duplicate and unknown keys, nested structs and classes,
// optional fields and narrow integers, and nothing leaked on any failure path. Moved from
// velt_vir's hand-built JSON glue tests, which can't run since the glue calls std's Velt reader
// and writer (#1668).
struct User {
  name: string;
  age: i64;
  tags: string[];
  email?: string;
}
struct P {
  x: i64;
  y: f64;
}
class Item {
  id: u8 = 0;
  ok: bool = false;
  w?: f64;
  at: P = { x: 0, y: 0 };
}
class Box {
  items: Item[] = [];
  label: string = "";
}
function users() {
  const docs = [
    `{"tags":["a","b"],"name":"x"}`,
    `{"name":"x","age":1,"tags":["a",2]}`,
    `{"tags":["a"],"name":"x","age":"no"}`,
    `[1]`,
    `{"name":"a","name":"b","extra":{"x":[1,{"y":null}],"s":"\\n"},"age":5,"tags":["t"]}`,
    `{"name":"c","age":7,"tags":[],"email":null} `,
    `{"name":"d","age":8,"tags":[]} x`,
    `{"name":"e","age":9.5,"tags":[]}`,
  ];
  for (const d of docs) {
    try {
      const u = JSON.parse<User>(d);
      console.log(u.name, u.age);
    } catch (e) {
      console.log("json error:", e.message);
    }
  }
}
function boxes() {
  const ok = `{"label":"L","items":[{"id":1,"ok":true,"at":{"x":-2,"y":0.5}},{"at":{"y":1e3,"x":7},"w":2.25,"ok":false,"id":255}]}`;
  console.log(JSON.stringify(JSON.parse<Box>(ok)));
  const bad = [
    `{"label":"L","items":[{"id":256,"ok":true,"at":{"x":1,"y":2}}]}`,
    `{"label":"L","items":[{"id":1,"ok":1,"at":{"x":1,"y":2}}]}`,
    `{"label":"L","items":[{"id":1,"ok":true,"at":{"x":1}}]}`,
  ];
  for (const d of bad) {
    try {
      JSON.parse<Box>(d);
    } catch (e) {
      console.log("json error:", e.message);
    }
  }
}
function main() {
  users();
  boxes();
}
