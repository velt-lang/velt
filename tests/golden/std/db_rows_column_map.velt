// The column-by-column reader of a `RowSource` matches each column to its field once per result:
// for a row type of up to 15 fields the first 16 columns' fields are kept in one word, and the
// columns past them in an array. A field may come from any column, before or past the 16th; a
// column no field names is skipped; a row type of 16 fields keeps every column's field in the array.
// A row type of 15 fields fills the word's top slot (column 15, field 14), whose bits reach the sign.
import { CellKind, readRow, readRows, RowSource } from "velt/db";

// Columns named `names`; the cell in column `i` of row `r` (from 0) is `(r + 1) * 100 + i`.
class Wide implements RowSource {
  names: string[];
  rows: i64;
  row: i64 = -1;

  constructor(names: string[], rows: i64) {
    this.names = names;
    this.rows = rows;
  }

  columnCount(): i64 {
    return this.names.length as i64;
  }
  columnName(i: i64): string {
    return this.names[i];
  }
  next(): bool {
    this.row++;
    return this.row < this.rows;
  }
  kind(i: i64): CellKind {
    return CellKind.Int;
  }
  bool(i: i64): bool {
    return false;
  }
  int(i: i64): i64 {
    return (this.row + 1) * 100 + i;
  }
  float(i: i64): f64 {
    return 0;
  }
  text(i: i64): string {
    return "";
  }
  blob(i: i64): u8[] {
    return [];
  }
  json(i: i64): string {
    return "null";
  }
}

struct Two {
  a: i64;
  q: i64;
}

struct Fifteen {
  f0: i64;
  f1: i64;
  f2: i64;
  f3: i64;
  f4: i64;
  f5: i64;
  f6: i64;
  f7: i64;
  f8: i64;
  f9: i64;
  f10: i64;
  f11: i64;
  f12: i64;
  f13: i64;
  f14: i64;
}

struct Sixteen {
  f0: i64;
  f1: i64;
  f2: i64;
  f3: i64;
  f4: i64;
  f5: i64;
  f6: i64;
  f7: i64;
  f8: i64;
  f9: i64;
  f10: i64;
  f11: i64;
  f12: i64;
  f13: i64;
  f14: i64;
  f15: i64;
}

// 19 columns: `q` is column 3, `a` column 17, the others no field's.
function wideNames(): string[] {
  const names: string[] = [];
  for (let i: i64 = 0; i < 19; i++) {
    names.push(i == 3 ? "q" : i == 17 ? "a" : `x${i}`);
  }
  return names;
}

function main() {
  for (const r of readRows<Two, Wide>(new Wide(wideNames(), 2))) {
    console.log("two", r.a, r.q);
  }
  const one: Two | null = readRow<Two, Wide>(new Wide(wideNames(), 1));
  if (one != null) {
    console.log("one", one.a, one.q);
  }

  // 16 columns named f15 down to f0.
  const reversed: string[] = [];
  for (let i: i64 = 15; i >= 0; i--) {
    reversed.push(`f${i}`);
  }
  for (const s of readRows<Sixteen, Wide>(new Wide(reversed, 1))) {
    console.log("sixteen", s.f0, s.f7, s.f15);
  }

  // Column 0 is no field's; columns 1 to 15 are f0 to f14, so f14 is in the top slot.
  const shifted: string[] = ["x0"];
  for (let i: i64 = 0; i < 15; i++) {
    shifted.push(`f${i}`);
  }
  for (const s of readRows<Fifteen, Wide>(new Wide(shifted, 1))) {
    console.log("fifteen", s.f0, s.f7, s.f14);
  }

  // A required field no column fills.
  try {
    readRows<Two, Wide>(new Wide(["a", "x"], 1));
  } catch (e) {
    console.log("missing:", e.message);
  }
}
