// A 0 in a path: the whole-file functions throw `IoError` EINVAL naming the call (Node throws a
// TypeError, ERR_INVALID_ARG_VALUE, instead; Velt's `throws IoError` keeps the runtime's error),
// sync and async alike, and `exists` is false without an error, as in Node.
import {
  appendFileSync,
  exists,
  existsSync,
  lstatSync,
  readFile,
  readFileBytesSync,
  readFileSync,
  stat,
  statSync,
  writeFileSync,
} from "velt/fs";
import { IoError } from "velt/io";

function attempt(what: string, f: () => void) {
  try {
    f();
    console.log(what, "no error");
  } catch (e) {
    console.log(
      what,
      e instanceof IoError,
      (e as IoError).code,
      JSON.stringify((e as Error).message),
    );
  }
}

async function main() {
  const p = "a\0b.txt";
  attempt("readFileSync", () => {
    readFileSync(p);
  });
  attempt("readFileBytesSync", () => {
    readFileBytesSync(p);
  });
  attempt("writeFileSync", () => {
    writeFileSync(p, "x");
  });
  attempt("appendFileSync", () => {
    appendFileSync(p, "x");
  });
  attempt("statSync", () => {
    statSync(p);
  });
  attempt("lstatSync", () => {
    lstatSync(p);
  });
  console.log("existsSync", existsSync(p), await exists(p));
  try {
    await readFile(p);
  } catch (e) {
    console.log("readFile", e instanceof IoError, (e as IoError).code);
  }
  try {
    await stat(p);
  } catch (e) {
    console.log("stat", e instanceof IoError, (e as IoError).code);
  }
}
