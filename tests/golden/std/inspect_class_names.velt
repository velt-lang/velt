// The name `console.log` prints a std object under, per class as in Node (#3792): the object's
// own class for an `EventTarget` or an `AbortController` (`this.constructor.name`), so a subclass
// prints under its name; the fixed names `Headers`, `Blob`, `Request` and `Response` for those,
// whose inspects write the name themselves, so a subclass prints under the std class's. Plain,
// subclassed and nested in an array and an object. Not here: an `Event` (its `timeStamp` differs
// from run to run; it is named like an `EventTarget`), and the forms past the depth limit
// (#3833). The Node twin is inspect_class_names.mjs.
class Tg extends EventTarget {}

class Ac extends AbortController {}

class H extends Headers {}

class B extends Blob {}

class Rq extends Request {}

class Rs extends Response {}

function main() {
  console.log(new EventTarget(), new Tg());
  console.log(new AbortController(), new Ac());
  console.log([new Tg()], { a: new Ac() });
  console.log({ a: { t: new Tg() } }, [[new Tg()]]);

  console.log(new Headers({ a: "1" }), new H({ a: "1" }));
  console.log(new Blob(["hi"]), new B(["hi"], { type: "text/plain" }));
  console.log([new H({ a: "1" })], { b: new B(["hi"]) });
  console.log({ a: { h: new H({ a: "1" }), b: new B(["hi"]) } });
  console.log(new Request("https://a.b/"));
  console.log(new Rq("https://a.b/"));
  console.log(new Response("hi"));
  console.log(new Rs("hi"));
  console.log([new Rs("hi")]);
}
