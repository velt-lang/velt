// check: no leaks
// http-server: a handler that throws gets a 500, and its error is printed to stderr. (The
// rest of what the server does is tested in packages/http-server/tests/handlers.test.vlt.)
import { HttpRequest, HttpResponse, serveHttp } from "http-server";

async function main() {
  const server = await serveHttp({ port: 0 }, async (req: HttpRequest, res: HttpResponse) => {
    if (req.pathIs("/fail")) {
      throw new Error("handler failed");
    }
    res.send("hello");
  });
  const failed = await fetch(`http://127.0.0.1:${server.port}/fail`);
  console.log(failed.status, await failed.text());
  server.close();
}
