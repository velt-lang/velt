// A store by a computed key elsewhere in the program (`o[k] = v` on an `any`, as a reactivity
// library's proxy `set` trap makes) reaches only objects converted to `any` (#854): `RenderCtx`
// never is, so its own `out` stays the request's, and `ctx.out.push(…)` changes nothing
// captured. Prints what Node prints.
import { serve } from "http-server";

class App {
  name: string = "app";
  plugins: string[] = ["a"];
}

class RenderCtx {
  app: App;
  out: string[] = [];
  constructor(app: App) {
    this.app = app;
  }
  emit(s: string): void {
    this.out.push(s);
  }
}

function setAny(o: any, k: string, v: any): void {
  o[k] = v;
}

function render(app: App): string {
  const ctx = new RenderCtx(app);
  ctx.emit(app.name);
  ctx.out.push("!");
  ctx.emit(`${ctx.app.plugins.length}`);
  return ctx.out.join("");
}

async function main() {
  const cfgAny: any = { x: [] as string[] };
  setAny(cfgAny, "x", ["y"]);
  const bag: any = { a: [] as string[], b: [] as string[] };
  for (const k of ["a", "b"]) {
    const v = [k];
    bag[k] = v;
  }
  console.log(cfgAny.x[0], bag.b[0]);
  const app = new App();
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    return new Response(render(app));
  });
  const r = await fetch(`http://127.0.0.1:${server.port}/`);
  console.log(await r.text());
  await server.shutdown();
}
