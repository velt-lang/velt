// Sending on a socket hands work to the peer, here a task of the same program that may run on
// another worker at once: what the sender printed before the send comes first, also while the
// sender keeps running without suspending. (In Node the peer runs once the sender suspends.)
import { serve } from "http-server";
import { connect, listen, TcpStream } from "velt/net";

// Runs for `ms` milliseconds without suspending.
function busy(ms: f64) {
  const start = performance.now();
  let spins = 0;
  while (performance.now() - start < ms) {
    spins++;
  }
}

async function readOne(s: TcpStream) {
  const data = await s.readString();
  console.log(`reader: got ${data}`);
  s.close();
}

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    console.log(`server: ${new URL(req.url).pathname}`);
    return new Response("ok");
  });
  const base = `http://127.0.0.1:${server.port}`;
  console.log("client: first request");
  const first = await fetch(`${base}/first`);
  console.log(`client: ${await first.text()}`);
  // The kept-alive connection takes the second request at once.
  console.log("client: second request");
  const pending = fetch(`${base}/second`);
  busy(50);
  const second = await pending;
  console.log(`client: ${await second.text()}`);
  await server.shutdown();

  const l = await listen("127.0.0.1:0");
  const c = await connect(`127.0.0.1:${l.port}`);
  const reader = spawn(readOne(await l.accept()));
  console.log("writer: sending");
  const sent = c.write("hello");
  busy(50);
  await sent;
  await reader;
  c.close();
  l.close();
}
