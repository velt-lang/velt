// `fetch` and the environment's proxy (#3693), as in Node 22.21+: used only with
// `NODE_USE_ENV_PROXY=1`; `http_proxy` before `HTTP_PROXY` (even when empty), `https_proxy` /
// `HTTPS_PROXY` for `https:` with the `http:` one as its fallback; the proxy's credentials as
// `proxy-authorization`; `NO_PROXY` hosts, `.`/`*` suffixes, ports, IPv6 in brackets, white
// space as a separator, `no_proxy` first, `*`; every request through a `CONNECT` tunnel, `http:`
// too, this machine too; redirects between `http:` and `https:` proxied hop by hop; a proxy that
// refuses and one that is not there. The variables are read when the program starts, so each run
// is this program again with its own environment ("child"); servers, proxy and its log are here.
// fetch_env_proxy.mjs is the Node twin and prints the same (the proxy is local, no network).
import { serve } from "http-server";
import { connect, listen, TcpStream } from "velt/net";
import { utf8DecodeLossy } from "velt/encoding";
import { envAll } from "velt/process";
import { exec } from "velt/process/child";
import { Channel, channel } from "velt/sync";
import { TEST_CA, TEST_CERT, TEST_KEY } from "../_tls";

const PROXY_VARS = [
  "NODE_USE_ENV_PROXY",
  "http_proxy",
  "HTTP_PROXY",
  "https_proxy",
  "HTTPS_PROXY",
  "all_proxy",
  "ALL_PROXY",
  "no_proxy",
  "NO_PROXY",
];

async function child(urls: string[]) {
  for (const url of urls) {
    try {
      const res = await fetch(url, { ca: TEST_CA });
      console.log(`${url} ${res.status} ${await res.text()}`);
    } catch (e) {
      console.log(`${url} failed`);
    }
  }
}

/** Copies `from` to `to` until `from` ends, then ends `to`'s writing side. */
async function pipe(from: TcpStream, to: TcpStream) {
  try {
    while (true) {
      const bytes = await from.read();
      if (bytes.length == 0) {
        break;
      }
      await to.writeBytes(bytes);
    }
    to.shutdown();
  } catch (e) {
    to.close();
  }
}

/** One connection to the proxy: `CONNECT` logged, then tunneled to 127.0.0.1 or refused. */
async function proxyOne(conn: TcpStream, log: Channel<string>) {
  let input: u8[] = [];
  let text = "";
  while (text.indexOf("\r\n\r\n") < 0) {
    const more = await conn.read();
    if (more.length == 0) {
      conn.close();
      return;
    }
    input = input.concat(more);
    text = utf8DecodeLossy(input);
  }
  const end = text.indexOf("\r\n\r\n");
  const lines = text.slice(0, end).split("\r\n");
  const [method, target] = lines[0].split(" ");
  if (method != "CONNECT") {
    await log.send(`proxy: ${method} ${target}`);
    await conn.write("HTTP/1.1 400 Bad Request\r\ncontent-length: 0\r\nconnection: close\r\n\r\n");
    conn.close();
    return;
  }
  let auth = "-";
  for (const line of lines.slice(1)) {
    if (line.toLowerCase().startsWith("proxy-authorization:")) {
      auth = line.slice(20).trim();
    }
  }
  await log.send(`proxy: CONNECT ${target} auth=${auth}`);
  if (target.startsWith("refuse.test:")) {
    await conn.write("HTTP/1.1 403 Forbidden\r\ncontent-length: 0\r\n\r\n");
    conn.close();
    return;
  }
  let origin: TcpStream;
  try {
    origin = await connect(`127.0.0.1:${target.slice(target.lastIndexOf(":") + 1)}`);
  } catch (e) {
    conn.close();
    return;
  }
  await conn.write("HTTP/1.1 200 Connection established\r\n\r\n");
  const rest = input.slice(end + 4);
  if (rest.length > 0) {
    await origin.writeBytes(rest);
  }
  spawn(pipe(origin, conn));
  await pipe(conn, origin);
}

async function main() {
  const log = channel<string>(256);

  const plain = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const url = new URL(req.url);
    if (url.pathname == "/to-https") {
      return new Response(null, {
        status: 302,
        headers: { location: `https://localhost:${url.searchParams.get("to")}/landed` },
      });
    }
    return new Response(`http ${req.headers.get("host")}${url.pathname}`);
  });
  const secure = await serve({ port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } }, async (
    req: Request,
  ): Promise<Response> => {
    const url = new URL(req.url);
    if (url.pathname == "/to-http") {
      return new Response(null, {
        status: 302,
        headers: { location: `http://r2.test:${url.searchParams.get("to")}/back` },
      });
    }
    return new Response(`https ${req.headers.get("host")}${url.pathname}`);
  });

  const listener = await listen("127.0.0.1:0");
  spawn(async () => {
    while (true) {
      let conn: TcpStream;
      try {
        conn = await listener.accept();
      } catch (e) {
        return;
      }
      spawn(proxyOne(conn, log));
    }
  });
  const proxyPort = listener.port as number;
  const P = `http://127.0.0.1:${proxyPort}`;
  const H = plain.port as number;
  const S = secure.port as number;

  const hide = (text: string): string =>
    text
      .split(`:${H}`)
      .join(":<http>")
      .split(`:${S}`)
      .join(":<https>")
      .split(`=${H}`)
      .join("=<http>")
      .split(`=${S}`)
      .join("=<https>")
      .split(`:${proxyPort}`)
      .join(":<proxy>");

  async function run(name: string, vars: Record<string, string>, urls: string[]) {
    console.log(`== ${name}`);
    const env = new Map<string, string>();
    const all = envAll();
    for (const k of Object.keys(all)) {
      if (!PROXY_VARS.includes(k)) {
        env.set(k, all[k]);
      }
    }
    for (const k of Object.keys(vars)) {
      env.set(k, vars[k]);
    }
    const r = await exec(process.argv[0], ["child", ...urls], { env, clearEnv: true });
    console.log(hide(r.stdout.trimEnd()));
    for (let line = log.tryReceive(); line != null; line = log.tryReceive()) {
      console.log(hide(line));
    }
  }

  const both: Record<string, string> = { http_proxy: P, https_proxy: P };
  await run("NODE_USE_ENV_PROXY unset: direct", both, [
    `http://localhost:${H}/a`,
    `http://a.test:${H}/`,
  ]);
  await run("NODE_USE_ENV_PROXY=true: direct", { NODE_USE_ENV_PROXY: "true", http_proxy: P, https_proxy: P }, [
    `http://b.test:${H}/`,
  ]);
  const withAuth = `http://u:p%40ss@127.0.0.1:${proxyPort}`;
  await run("http_proxy with credentials, for https: too", { NODE_USE_ENV_PROXY: "1", http_proxy: withAuth }, [
    `http://c.test:${H}/c`,
    `http://127.0.0.1:${H}/loopback`,
    `https://localhost:${S}/s`,
  ]);
  await run("uppercase HTTP_PROXY", { NODE_USE_ENV_PROXY: "1", HTTP_PROXY: P }, [`http://d.test:${H}/`]);
  await run("HTTPS_PROXY alone", { NODE_USE_ENV_PROXY: "1", HTTPS_PROXY: P }, [
    `https://localhost:${S}/e`,
    `http://e.test:${H}/`,
  ]);
  await run("http_proxy over HTTP_PROXY", { NODE_USE_ENV_PROXY: "1", http_proxy: P, HTTP_PROXY: "http://127.0.0.1:1" }, [
    `http://f.test:${H}/`,
  ]);
  await run("an empty http_proxy over HTTP_PROXY", { NODE_USE_ENV_PROXY: "1", http_proxy: "", HTTP_PROXY: P }, [
    `http://g.test:${H}/`,
  ]);
  await run(
    "NO_PROXY",
    {
      NODE_USE_ENV_PROXY: "1",
      HTTP_PROXY: P,
      NO_PROXY: `n1.test,.n2.test\t*.n3.test n4.test:1 n5.test:${H} [::1] ::5 N6.TEST`,
    },
    [
      `http://n1.test:${H}/`,
      `http://x.n1.test:${H}/`,
      `http://n2.test:${H}/`,
      `http://x.n2.test:${H}/`,
      `http://x.n3.test:${H}/`,
      `http://n4.test:${H}/`,
      `http://n5.test:${H}/`,
      `http://[::1]:${H}/`,
      `http://[::5]:${H}/`,
      `http://n6.test:${H}/`,
    ],
  );
  await run("no_proxy over NO_PROXY, even empty", { NODE_USE_ENV_PROXY: "1", HTTP_PROXY: P, no_proxy: "", NO_PROXY: "h.test" }, [
    `http://h.test:${H}/`,
  ]);
  await run("NO_PROXY=*", { NODE_USE_ENV_PROXY: "1", HTTP_PROXY: P, NO_PROXY: "*" }, [`http://i.test:${H}/`]);
  await run("redirects between http: and https:", { NODE_USE_ENV_PROXY: "1", HTTP_PROXY: P, HTTPS_PROXY: P, NO_PROXY: "localhost" }, [
    `http://r1.test:${H}/to-https?to=${S}`,
    `https://127.0.0.1:${S}/to-http?to=${H}`,
  ]);
  await run("a proxy that refuses", { NODE_USE_ENV_PROXY: "1", HTTP_PROXY: P }, [
    `http://refuse.test:${H}/`,
  ]);
  await run("no proxy there", { NODE_USE_ENV_PROXY: "1", HTTP_PROXY: "http://127.0.0.1:1" }, [
    `http://k.test:${H}/`,
  ]);
  listener.close();
  await plain.shutdown();
  await secure.shutdown();
}

if (process.argv.length > 2 && process.argv[2] == "child") {
  await child(process.argv.slice(3));
} else {
  await main();
}
