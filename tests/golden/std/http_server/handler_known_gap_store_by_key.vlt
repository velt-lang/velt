// KNOWN GAP (#854): a field of a new value filled from the capture by `Reflect.set` is not seen,
// so these handlers compile and each change goes to the request's copy of `app.plugins`, where
// Node shares it (a second request would show Node's list growing). Each class fills its list
// with the captured one through `Reflect.set`, with a literal and with a computed key: std's
// `Reflect.set` is not looked into until std declares its write effects (step 2 of
// docs/internals/design/write-effects.md; acceptance test E2 on #854). The same stores through
// the program's own code are errors (lang/errors/http_server/http_handler_store_by_key). Prints
// one request's lengths, which match Node.
import { serve } from "http-server";

class App {
  name: string = "app";
  plugins: string[] = ["a"];
}

class ByReflect {
  app: App;
  out: string[] = [];
  constructor(a: App) {
    this.app = a;
    Reflect.set(this, "out", a.plugins);
  }
}

class ByComputedKey {
  app: App;
  rows: string[] = [];
  constructor(a: App, key: string) {
    this.app = a;
    Reflect.set(this, key, a.plugins);
  }
}

async function one(port: number): Promise<string> {
  const r = await fetch(`http://127.0.0.1:${port}/`);
  return await r.text();
}

async function main() {
  const outs: string[] = [];
  const a6 = new App();
  const s6 = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const c = new ByReflect(a6);
    c.out.push("x");
    return new Response(`${c.out.length}`);
  });
  const a7 = new App();
  const s7 = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const c = new ByComputedKey(a7, "rows");
    c.rows.push("x");
    return new Response(`${c.rows.length}`);
  });
  for (const s of [s6, s7]) {
    outs.push(await one(s.port));
  }
  console.log(outs.join(" "));
  for (const s of [s6, s7]) {
    await s.shutdown();
  }
}
