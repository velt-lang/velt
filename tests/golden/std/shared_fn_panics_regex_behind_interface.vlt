// A class holding a `RegExp`, behind an interface value.
type F = (x: i64) => i64;

interface Tester {
  test(s: string): boolean;
}

class Route implements Tester {
  re: RegExp = /a+/;
  test(s: string): boolean {
    return this.re.test(s);
  }
}

function mk(): F {
  const h: Tester = new Route();
  return (x: i64): i64 => h.test("aa") ? 1 : 0;
}

async function main() {
  const f = shared(mk());
  console.log(f(1));
}
