// The Velt SQLite reader (velt:sqlite/format, velt:sqlite/btree, #1715) on damaged files: a file
// C SQLite wrote, with bytes changed the way a torn write or a hostile file would change them.
// Every case either reads (with bounded work and memory) or throws CorruptError; none panics.
import { open } from "velt:sqlite";
import { CorruptError, DbFile, localSize, readU16, readU32, readVarint } from "velt:sqlite/format";
import { Cursor } from "velt:sqlite/btree";
import { RecordBuilder, pushVarint } from "velt:sqlite/record";
import { tmpdir } from "velt:os";
import { uuidv4 } from "velt:uuid";
import { readFileBytesSync, removeSync } from "velt:fs";

const PAGE: usize = 1024;

struct Root {
  name: string;
  rootpage: i64;
}

/** Reads every row and column of every tree, and seeks the index. */
function scan(data: u8[], roots: u32[]): string {
  const f = new DbFile(data);
  let rows = 0;
  for (const r of roots) {
    const c = new Cursor(f, r);
    let more = c.first();
    while (more) {
      for (let i: usize = 0; i < c.columnCount(); i++) {
        c.text(i);
        c.blob(i);
      }
      rows++;
      more = c.next();
    }
  }
  const k = new RecordBuilder();
  k.addText("hello");
  new Cursor(f, roots[2]).seekKey(k.finish(), 1, [], []);
  return `ok, ${rows} rows`;
}

function attempt(label: string, data: u8[], roots: u32[]) {
  try {
    console.log(`${label}: ${scan(data, roots)}`);
  } catch (e) {
    if (e instanceof CorruptError) {
      console.log(`${label}: ${e.message}`);
    } else {
      console.log(`${label}: unexpected ${e.message}`);
    }
  }
}

function copy(data: u8[]): u8[] {
  return data.slice(0);
}

function page(n: u32): usize {
  return ((n - 1) as usize) * PAGE;
}

/** The offset of cell `i` of the leaf page `n`. */
function cell(data: u8[], n: u32, i: usize): usize {
  return page(n) + readU16(data, page(n) + 8 + 2 * i);
}

function put16(data: u8[], at: usize, v: usize) {
  data[at] = (v >> 8) as u8;
  data[at + 1] = (v & 0xff) as u8;
}

function put32(data: u8[], at: usize, v: u32) {
  for (let i: usize = 0; i < 4; i++) {
    data[at + i] = ((v >> ((24 - 8 * i) as u32)) & 0xff) as u8;
  }
}

/** Writes a table leaf cell header at `at`: payload size `size` (a varint) and rowid 2. */
function cellHeader(data: u8[], at: usize, size: u64): usize {
  const h: u8[] = [];
  pushVarint(h, size);
  h.push(2);
  for (let i: usize = 0; i < h.length; i++) {
    data[at + i] = h[i];
  }
  return h.length;
}

function main() {
  const path = `${tmpdir()}/velt-sqlite-corrupt-${uuidv4()}.db`;
  const db = open(path);
  db.exec(`
    PRAGMA page_size = 1024; PRAGMA journal_mode = DELETE;
    CREATE TABLE s (id INTEGER PRIMARY KEY, v);
    CREATE INDEX s_v ON s (v);
    INSERT INTO s VALUES (1, 'hello'), (2, zeroblob(3000)), (3, 42);
    CREATE TABLE u (v);
    WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 3000)
    INSERT INTO u SELECT printf('%050d', i) FROM n;
    CREATE INDEX u_v ON u (v);
    CREATE TABLE t (id INTEGER PRIMARY KEY, v);
    WITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 300)
    INSERT INTO t SELECT i, printf('%050d', i) FROM n;
  `);
  const rs: Root[] = db.prepare("SELECT name, rootpage FROM sqlite_schema ORDER BY name").all();
  db.close();
  let s: u32 = 0;
  let t: u32 = 0;
  let sv: u32 = 0;
  let uv: u32 = 0;
  for (const r of rs) {
    if (r.name == "s") {
      s = r.rootpage as u32;
    } else if (r.name == "t") {
      t = r.rootpage as u32;
    } else if (r.name == "s_v") {
      sv = r.rootpage as u32;
    } else if (r.name == "u_v") {
      uv = r.rootpage as u32;
    }
  }
  const roots: u32[] = [s, t, sv, uv];
  const base = readFileBytesSync(path);
  removeSync(path);
  const pages = readU32(base, 28);
  attempt("intact", base, roots);

  // Cell pointers: past the page, into the page header, more cells than the page holds.
  let d = copy(base);
  put16(d, page(s) + 8, 0xfff0);
  attempt("cell pointer past the page", d, roots);
  d = copy(base);
  put16(d, page(s) + 8, 4);
  attempt("cell pointer into the header", d, roots);
  d = copy(base);
  put16(d, page(s) + 3, 0xffff);
  attempt("cell count 65535", d, roots);

  // Row 2's payload spills: its overflow chain, then its payload size.
  const row2 = cell(base, s, 1);
  const size = readVarint(base, row2);
  const keep = localSize(PAGE, true, size.value as usize);
  const ovfAt = row2 + size.len + 1 + keep;
  const first = readU32(base, ovfAt);
  d = copy(base);
  put32(d, page(first), first);
  attempt("overflow chain loops (payload size in range)", d, roots);
  d = copy(base);
  put32(d, ovfAt, 0);
  attempt("overflow chain ends at once", d, roots);
  d = copy(base);
  put32(d, ovfAt, 9999);
  attempt("overflow page past the file", d, roots);
  d = copy(base);
  put32(d, page(first), first);
  // A payload past 2^31 - 1, and one larger than all the file's pages could hold.
  let n = cellHeader(d, row2, 1099511627776);
  attempt("payload size 2^40, looping chain", d, roots);
  d = copy(base);
  const big: u64 = 103 + 1019 + 1020 * ((pages as u64) + 10);
  n = cellHeader(d, row2, big);
  put32(d, row2 + n + 103, first);
  put32(d, page(first), first);
  attempt("payload size past the file, looping chain", d, roots);

  // Row 1's record: [header size 3][type 0: the rowid's NULL][type 23: text of 5]'hello'.
  const rec = cell(base, s, 0) + 2;
  d = copy(base);
  d[rec] = 0x7f;
  attempt("record header size past the payload", d, roots);
  d = copy(base);
  d[rec + 2] = 10;
  attempt("serial type 10", d, roots);
  d = copy(base);
  d[rec + 2] = 11;
  attempt("serial type 11", d, roots);
  d = copy(base);
  d[rec + 2] = 25;
  attempt("text longer than the payload", d, roots);
  d = copy(base);
  d[rec + 1] = 0x81;
  d[rec + 2] = 0x80;
  attempt("serial type varint running into the body", d, roots);

  // The index's first entry ('hello', 1) gets a reserved serial type: seeks compare it.
  const ix = cell(base, sv, 0);
  d = copy(base);
  d[ix + 2] = 11;
  attempt("index entry with serial type 11", d, roots);
  // A key whose only serial type is a 9-byte varint: -1.
  try {
    const key: u8[] = [10, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff];
    new Cursor(new DbFile(base), sv).seekKey(key, 1, [], []);
    console.log("negative serial type in a key: no error");
  } catch (e) {
    console.log(`negative serial type in a key: ${e.message}`);
  }

  // t's root is an interior page: its children.
  const right = readU32(base, page(t) + 8);
  d = copy(base);
  put16(d, page(right) + 3, 0);
  attempt("empty leaf below the root", d, roots);
  d = copy(base);
  put32(d, page(t) + 8, 9999);
  attempt("child page past the file", d, roots);
  d = copy(base);
  put32(d, page(t) + 8, t);
  attempt("child pointing at its own root", d, roots);
  d = copy(base);
  d[page(t)] = 7;
  attempt("unknown page type", d, roots);
  // A page below the root of the other kind of tree (SQLite's getAndInitPage): a table leaf
  // made an index leaf, and an interior page of u_v (three levels) made a table interior page,
  // which would otherwise read as a leaf and skip its subtrees.
  d = copy(base);
  d[page(right)] = 10;
  attempt("table leaf retyped as an index leaf", d, roots);
  const uvChild = readU32(base, page(uv) + readU16(base, page(uv) + 12));
  d = copy(base);
  if (d[page(uvChild)] == 2) {
    d[page(uvChild)] = 5;
  }
  attempt("index interior page retyped as a table page", d, roots);

  // The last page's first cell moved to its last 4 bytes, all 0xff: the varints run past the
  // end of the file. (If the last page is not a leaf of t, the scan reads past it anyway.)
  d = copy(base);
  const last = page(pages);
  if (d[last] == 13) {
    put16(d, last + 8, 1020);
    for (let i: usize = 1020; i < 1024; i++) {
      d[last + i] = 0xff;
    }
  }
  attempt("varint running off the end of the file", d, roots);
  // The same with 12 reserved bytes a page: a table leaf cell's two varints (up to 18 bytes)
  // start in the last 4 usable bytes and run past the reserved ones, off the end of the file.
  d = copy(base);
  if (d[last] == 13) {
    d[20] = 12;
    put16(d, last + 3, 1);
    put16(d, last + 8, 1008);
    for (let i: usize = 1008; i < 1024; i++) {
      d[last + i] = 0xff;
    }
  }
  try {
    const c = new Cursor(new DbFile(d), pages);
    let more = c.first();
    while (more) {
      more = c.next();
    }
    console.log("varints running past the reserved bytes: no error");
  } catch (e) {
    console.log(`varints running past the reserved bytes: ${e.message}`);
  }

  // The header: reserved bytes leaving less than 480 usable, a page size that is no power of 2.
  d = copy(base);
  d[20] = 255;
  d[16] = 2;
  d[17] = 0;
  attempt("usable size 257", d, roots);
  d = copy(base);
  d[16] = 3;
  d[17] = 0;
  attempt("page size 768", d, roots);
  // The header checks C SQLite makes when it opens a file: the read version (offset 19) at most
  // 2, where 2 (WAL) reads as the last checkpoint, and the payload fractions 64, 32, 32.
  d = copy(base);
  d[19] = 3;
  attempt("read version 3", d, roots);
  d = copy(base);
  d[18] = 2;
  d[19] = 2;
  attempt("WAL mode (read version 2)", d, roots);
  d = copy(base);
  d[21] = 63;
  attempt("max payload fraction 63", d, roots);
  d = copy(base);
  d[23] = 33;
  attempt("leaf payload fraction 33", d, roots);
  attempt("file cut short", base.slice(0, 60), roots);
  attempt("file cut mid-page", base.slice(0, ((pages as i64) - 1) * 1024 + 10), roots);
  wrapping();
}

/**
 * A 17 MiB file made in memory: one row whose record header is 2^24 bytes of serial type 10.
 * Each counts as more body than any payload has, and the sum must not wrap around to fit.
 */
function wrapping() {
  const P: usize = 65536;
  const hsize: usize = (1 << 24) + 4;
  const payload: u8[] = [];
  pushVarint(payload, hsize as u64);
  for (let i: usize = 0; i < 1 << 24; i++) {
    payload.push(10);
  }
  const keep = localSize(P, true, hsize);
  const overflow = (hsize - keep + P - 5) / (P - 4);
  const pages = 1 + overflow;
  const d: u8[] = [];
  for (let i: usize = 0; i < pages * P; i++) {
    d.push(0);
  }
  const magic = "SQLite format 3";
  for (let i: usize = 0; i < 15; i++) {
    d[i] = magic.charCodeAt(i as i64) as u8;
  }
  d[16] = 0;
  d[17] = 1;
  d[18] = 1;
  d[19] = 1;
  d[21] = 64;
  d[22] = 32;
  d[23] = 32;
  put32(d, 24, 1);
  put32(d, 28, pages as u32);
  put32(d, 44, 4);
  put32(d, 56, 1);
  put32(d, 92, 1);
  // Page 1: a table leaf with one cell at 200, its payload spilling onto pages 2, 3, ….
  d[100] = 13;
  put16(d, 103, 1);
  put16(d, 105, 200);
  put16(d, 108, 200);
  const h: u8[] = [];
  pushVarint(h, hsize as u64);
  h.push(1);
  let at: usize = 200;
  for (const b of h) {
    d[at] = b;
    at++;
  }
  for (let i: usize = 0; i < keep; i++) {
    d[at + i] = payload[i];
  }
  put32(d, at + keep, 2);
  let from = keep;
  for (let pg: usize = 2; pg <= pages; pg++) {
    const base = (pg - 1) * P;
    put32(d, base, pg < pages ? (pg + 1) as u32 : 0);
    let k: usize = 0;
    while (k < P - 4 && from < hsize) {
      d[base + 4 + k] = payload[from];
      k++;
      from++;
    }
  }
  try {
    const c = new Cursor(new DbFile(d), 1);
    c.first();
    console.log(`2^24 serial types 10 (${d.length} bytes): ${c.columnCount()} columns, no error`);
  } catch (e) {
    console.log(`2^24 serial types 10 (${d.length} bytes): ${e.message}`);
  }
}
