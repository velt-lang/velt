function rowsBf16x8(a: bf16[], at: usize, b: bf16[], dim: usize): string {
  let s: f32 = 0;
  let i: usize = 0;
  while (i + 16 <= dim) {
    const x = bf16x8.load(a, at + i);
    const y = bf16x8.load(a, at + i + 8);
    const z = bf16x8.load(b, i + 8);
    s += (x.lane(0) as f32) + (y.lane(7) as f32) + (z.lane(3) as f32);
    i += 16;
  }
  while (i + 8 <= dim && bf16x8.fits(a, at + i) && bf16x8.fits(b, i)) {
    const x = bf16x8.load(a, at + i);
    const z = bf16x8.load(b, i);
    s += (x.lane(5) as f32) - (z.lane(1) as f32);
    i += 8;
  }
  return `${s} ${i}`;
}

function runBf16x8(top: usize) {
  const a: bf16[] = [];
  const b: bf16[] = [];
  for (let k: usize = 0; k < 301; k++) {
    a.push((((k * 37) % 61) as f32 - 30) as bf16);
  }
  for (let k: usize = 0; k < 51; k++) {
    b.push((((k * 11 + 3) % 61) as f32 - 30) as bf16);
  }
  const len = a.length as usize;
  const out: string[] = [];
  const dims: usize[] = [0, 7, 8, 16, 17, 32, 48, 51];
  for (const dim of dims) {
    const ats: usize[] = [0, 1, 7, 19, len - dim];
    for (const at of ats) {
      out.push(rowsBf16x8(a, at, b, dim));
    }
  }
  // Rows the first loop does not reach: the second stops at the end, or at an offset that wraps.
  const short: usize[] = [8, 15];
  for (const dim of short) {
    const ats: usize[] = [len - 1, len, len + 5, top - 3, top];
    for (const at of ats) {
      out.push(rowsBf16x8(a, at, b, dim));
    }
  }
  console.log(`bf16x8: ${out.join(" | ")}`);
}

function main() {
  let top: usize = 0;
  top = top - 1;
  runI8x16(top);
  runU8x16(top);
  runI16x8(top);
  runU16x8(top);
  runI32x4(top);
  runU32x4(top);
  runI64x2(top);
  runU64x2(top);
  runF32x4(top);
  runF64x2(top);
  runF16x8(top);
  runF32x8(top);
  runBf16x8(top);
}
