// Vector loops over a range of an array, `i + 2n <= dim` with no `fits` and `fits` in the
// condition, for every vector type: the release build runs them in a copy without their range
// tests where one check in front proves every test true (velt_opt `range_versions`), and the
// original loop elsewhere. Rows inside the array, ranges at its end, offsets that wrap.

import { bf16x8, f16x8, f32x4, f32x8, f64x2, i16x8, i32x4, i64x2, i8x16, u16x8, u32x4, u64x2, u8x16 } from "velt/simd";

function rowsI8x16(a: i8[], at: usize, b: i8[], dim: usize): string {
  let s = i8x16.splat(0);
  let i: usize = 0;
  while (i + 32 <= dim) {
    s = s.add(i8x16.load(a, at + i)).add(i8x16.load(a, at + i + 16)).add(i8x16.load(b, i + 16));
    i += 32;
  }
  while (i + 16 <= dim && i8x16.fits(a, at + i) && i8x16.fits(b, i)) {
    s = s.add(i8x16.load(a, at + i)).add(i8x16.load(b, i));
    i += 16;
  }
  return `${s.lane(0)} ${s.lane(15)} ${s.lane(8)} ${i}`;
}

function runI8x16(top: usize) {
  const a: i8[] = [];
  const b: i8[] = [];
  for (let k: usize = 0; k < 597; k++) {
    a.push((((k * 37) % 251) as i32 - 125) as i8);
  }
  for (let k: usize = 0; k < 99; k++) {
    b.push((((k * 11 + 3) % 251) as i32 - 125) as i8);
  }
  const len = a.length as usize;
  const out: string[] = [];
  const dims: usize[] = [0, 15, 16, 32, 33, 64, 96, 99];
  for (const dim of dims) {
    const ats: usize[] = [0, 1, 15, 35, len - dim];
    for (const at of ats) {
      out.push(rowsI8x16(a, at, b, dim));
    }
  }
  // Rows the first loop does not reach: the second stops at the end, or at an offset that wraps.
  const short: usize[] = [16, 31];
  for (const dim of short) {
    const ats: usize[] = [len - 1, len, len + 5, top - 3, top];
    for (const at of ats) {
      out.push(rowsI8x16(a, at, b, dim));
    }
  }
  console.log(`i8x16: ${out.join(" | ")}`);
}

