import { serve, fetch, Request, Response } from "velt:http";
import { WebSocket, isWebSocketRequest, upgradeWebSocket, connectWebSocket } from "velt:websocket";
import { TEST_CA, TEST_CERT, TEST_KEY } from "./_tls";

// Server side of one connection: echoes text upper-cased and binary reversed until closed.
async function session(ws: WebSocket): Promise<void> {
  let m = await ws.receive();
  while (m != null) {
    if (m.isBinary) {
      const data = m.data.clone();
      data.reverse();
      await ws.sendBytes(data);
    } else {
      await ws.send(m.text.toUpperCase());
    }
    m = await ws.receive();
  }
  await ws.close();
}

async function handle(req: Request): Promise<Response> {
  if (req.path == "/ws" && isWebSocketRequest(req)) {
    const up = upgradeWebSocket(req);
    spawn(session(up.socket));
    return up.response;
  }
  return Response.text(`plain ${isWebSocketRequest(req)}`);
}

async function talk(url: string, ca: string) {
  const ws = await connectWebSocket(url, { ca: ca });
  await ws.send("hello");
  const a = await ws.receive();
  console.log(a?.text ?? "none", a?.isBinary ?? true);
  await ws.sendBytes([1u8, 2u8, 3u8]);
  const b = await ws.receive();
  console.log(b?.data ?? [], b?.isBinary ?? false);
  await ws.close(1000, "bye");
}

async function main() {
  const server = await serve(
    { port: 0 },
    async (req: Request): Promise<Response> => await handle(req),
  );
  await talk(`ws://127.0.0.1:${server.port}/ws`, "");
  const plain = await fetch(`http://127.0.0.1:${server.port}/ws`);
  console.log(await plain.text());
  try {
    const refused = await connectWebSocket(`ws://127.0.0.1:${server.port}/other`);
    await refused.close();
  } catch (e) {
    console.log("handshake refused:", e.message.startsWith("WebSocket handshake failed"));
  }
  server.close();

  const secure = await serve(
    { port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } },
    async (req: Request): Promise<Response> => await handle(req),
  );
  await talk(`wss://localhost:${secure.port}/ws`, TEST_CA);
  secure.close();
}
