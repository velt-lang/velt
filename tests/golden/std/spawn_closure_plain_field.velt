// A plain closure that returns an async call made with a captured object, passed to `spawn`:
// every task changes the one object, as in Node (#1646).
class C { n: i64 = 0; }
async function work(c: C, k: i64): Promise<void> { for (let i = 0; i < k; i++) c.n++; }

const c = new C();
const go = () => work(c, 1000);
const ps: Promise<void>[] = [];
for (let t = 0; t < 4; t++) ps.push(spawn(go()));
for (const p of ps) await p;
console.log(c.n);

function make(): () => Promise<void> { return () => work(c, 10); }
const g = make();
await spawn(g());
console.log(c.n);
