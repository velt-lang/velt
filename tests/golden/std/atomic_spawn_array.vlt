// An array of atomics still used after `spawn` is an error whose note shares the array itself
// (it has no constructor to call inside the `shared`).
async function work(xs: Atomic<u64>[]) {
  xs[0].add(1);
}

async function main() {
  const xs = [new Atomic<u64>(0)];
  await spawn(work(xs));
  console.log(xs[0].load());
}
