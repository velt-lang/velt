// `AbortSignal`'s reason, as in Node (#2991): `undefined` before an abort; a `DOMException`
// named `AbortError` (code 20) for `abort()` and `AbortSignal.abort()`, `TimeoutError` (code 23)
// for `AbortSignal.timeout`, also the one `throwIfAborted()` throws and an `AbortSignal.any`'s;
// a string passed to `abort(reason)` is the reason. (One object across reads, `===`:
// abort_signal_identity.velt, #3011.) Valid TypeScript; prints what Node prints.
const show = (label: string, e: any) => console.log(
  label,
  e?.name,
  JSON.stringify(e?.message),
  e instanceof DOMException,
  e?.code,
);
const c = new AbortController();
console.log("before", c.signal.reason);
c.abort();
show("abort()", c.signal.reason);
try {
  c.signal.throwIfAborted();
} catch (e) {
  show("throwIfAborted", e);
}
const c3 = new AbortController();
c3.abort("text");
console.log("string", c3.signal.reason);
const pre = AbortSignal.abort();
show("AbortSignal.abort()", pre.reason);
const t = AbortSignal.timeout(10);
setTimeout(
  () => {
    show("timeout", t.reason);
    const a = AbortSignal.any([new AbortController().signal, t]);
    show("any", a.reason);
  },
  50,
);

// timing: waits past an AbortSignal.timeout to read its reason
