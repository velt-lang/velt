// check: no leaks
// `Response.clone()` and `Request.clone()` (#573): each copy reads the whole body on its own, a
// streamed or fetched body teed between them; a used body cannot be cloned. A request's `signal`
// is never null. Prints what Node 22 prints (the server is Velt's).
import { serve } from "velt:http";

async function* parts(): AsyncGenerator<Uint8Array> {
  yield new TextEncoder().encode("one ");
  yield new TextEncoder().encode("two");
}

async function answer(req: Request): Promise<Response> {
  const path = new URL(req.url).pathname;
  if (path == "/echo") {
    // A received body, read by the clone and then by the request.
    const copy = req.clone();
    const first = await copy.text();
    return new Response(`${first}|${await req.text()}`);
  }
  if (path == "/stream") {
    return new Response(ReadableStream.from(parts()));
  }
  return new Response("x".repeat(100000), { headers: { "x-big": "yes" } });
}

async function main() {
  const made = new Response("hello", { status: 201, statusText: "Made", headers: { "x-a": "1" } });
  const copy = made.clone();
  console.log(copy.status, copy.statusText, copy.headers.get("x-a"), await copy.text());
  console.log(await made.text());
  try {
    made.clone();
  } catch (e) {
    console.log("used:", (e as Error).message);
  }

  const streamed = new Response(ReadableStream.from(parts()));
  const twin = streamed.clone();
  console.log(await twin.text(), "/", await streamed.text());

  const server = await serve({ port: 0 }, answer);
  const base = `http://127.0.0.1:${server.port}`;

  const big = await fetch(`${base}/big`);
  const bigCopy = big.clone();
  const [a, b] = await Promise.all([big.text(), bigCopy.text()]);
  console.log(a.length, b.length, bigCopy.headers.get("x-big"), bigCopy.url == big.url);

  const chunked = await fetch(`${base}/stream`);
  const chunkedCopy = chunked.clone();
  console.log(await chunked.text(), "/", await chunkedCopy.text());

  // Only the clone is read: the original is dropped unread.
  const once = await fetch(`${base}/stream`);
  console.log(await once.clone().text());

  const echoed = await fetch(`${base}/echo`, { method: "POST", body: "payload" });
  console.log(await echoed.text());

  const req = new Request(`${base}/echo`, { method: "PUT", body: "sent", headers: [["x-b", "2"]] });
  const reqCopy = req.clone();
  console.log(reqCopy.method, reqCopy.headers.get("x-b"), await reqCopy.text(), await req.text());
  try {
    req.clone();
  } catch (e) {
    console.log("used:", (e as Error).message);
  }
  console.log(req.signal.aborted, req.signal === req.signal);
  const ctl = new AbortController();
  console.log(new Request(base, { signal: ctl.signal }).signal.aborted);

  await server.shutdown();
}

await main();
