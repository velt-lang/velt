// copyFile's and copyFileSync's `mode` (fs.constants' COPYFILE_*), as Node 22 has it (#3561):
// COPYFILE_EXCL refuses a destination that exists (EEXIST) and leaves it as it was; FICLONE
// copies where the file system can't clone; a mode outside 0..7 or not finite is a RangeError,
// a fraction is cut to its integer part. COPYFILE_FICLONE_FORCE depends on the OS (ENOSYS on
// macOS and Windows, the clone or its errno on Linux), so the program prints whether it did what
// Node does there. The expected output is Node's, from a twin of this program over node:fs
// (fs_copy_mode.mjs in the pull request that added it).
import { platform } from "velt/os";
import {
  constants,
  copyFile,
  copyFileSync,
  existsSync,
  mkdir,
  readFileSync,
  remove,
  writeFileSync,
} from "velt/fs";

function show(label: string, f: () => void) {
  try {
    f();
    console.log(label, "ok");
  } catch (e) {
    console.log(label, e.name, e.message);
  }
}

function content(p: string): string {
  return existsSync(p) ? JSON.stringify(readFileSync(p)) : "missing";
}

async function main() {
  const d = "velt_fs_copy_mode_tmp";
  if (existsSync(d)) {
    await remove(d, { recursive: true }); // left by an interrupted run
  }
  await mkdir(d, { recursive: true });
  const a = `${d}/a.txt`;
  const b = `${d}/b.txt`;
  writeFileSync(a, "alpha");
  writeFileSync(b, "old");

  show("excl onto existing", () => copyFileSync(a, b, constants.COPYFILE_EXCL));
  console.log("  b:", content(b));
  show(
    "excl|ficlone onto existing",
    () => copyFileSync(a, b, constants.COPYFILE_EXCL | constants.COPYFILE_FICLONE),
  );
  console.log("  b:", content(b));
  show("default onto existing", () => copyFileSync(a, b));
  console.log("  b:", content(b));
  show("excl onto new", () => copyFileSync(a, `${d}/c.txt`, constants.COPYFILE_EXCL));
  console.log("  c:", content(`${d}/c.txt`));
  show("ficlone", () => copyFileSync(a, `${d}/f.txt`, constants.COPYFILE_FICLONE));
  console.log("  f:", content(`${d}/f.txt`));
  show("excl, missing source", () => copyFileSync(`${d}/nope`, b, constants.COPYFILE_EXCL));
  show("excl, directory destination", () => copyFileSync(a, d, constants.COPYFILE_EXCL));

  for (const m of [8, -1, 2 ** 31, NaN, Infinity, -Infinity, 1.5, -0.5, 0.5]) {
    show(`mode ${m}`, () => copyFileSync(a, `${d}/m${m}.txt`, m));
  }

  writeFileSync(b, "old");
  try {
    await copyFile(a, b, constants.COPYFILE_EXCL);
    console.log("async excl onto existing ok");
  } catch (e) {
    console.log("async excl onto existing", e.code, e.message);
  }
  console.log("  b:", content(b));
  try {
    await copyFile(a, b, 8);
    console.log("async mode 8 ok");
  } catch (e) {
    console.log("async mode 8", e.name, e.message);
  }

  // COPYFILE_FICLONE_FORCE: ENOSYS on macOS and Windows; on macOS the destination, opened by
  // then, is removed, on Windows nothing is touched. On Linux the clone, or its errno where the
  // file system has none (the destination removed).
  let asNode = false;
  try {
    copyFileSync(a, b, constants.COPYFILE_FICLONE_FORCE);
    asNode = platform() == "linux" && content(b) == '"alpha"';
  } catch (e) {
    const os = platform();
    if (os == "win32") {
      asNode = e.code == "ENOSYS" && content(b) == '"old"';
    } else if (os == "darwin") {
      asNode = e.code == "ENOSYS" && !existsSync(b);
    } else {
      asNode = e.code != "ENOSYS" && !existsSync(b);
    }
  }
  console.log("ficlone_force as Node:", asNode);

  await remove(d, { recursive: true });
}
