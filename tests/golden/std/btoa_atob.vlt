// `btoa` and `atob` are globals, as in Node: Base64 of "binary strings" (one code unit per
// byte), with atob's forgiving decoding (whitespace ignored, padding optional) and Node's
// `DOMException` (`InvalidCharacterError`) for bad input. The expected output is Node 22's
// (this file runs unchanged under `node --experimental-strip-types`).

function tryAtob(s: string): string {
  try {
    const r = atob(s);
    const codes: number[] = [];
    for (let i = 0; i < r.length; i++) {
      codes.push(r.charCodeAt(i));
    }
    return `ok ${JSON.stringify(r)} [${codes.join(",")}]`;
  } catch (e) {
    return `${e.name} (${e.code}): ${e.message}`;
  }
}

function tryBtoa(s: string): string {
  try {
    return `ok ${btoa(s)}`;
  } catch (e) {
    return `${e.name} (${e.code}): ${e.message}`;
  }
}

console.log(btoa("hello"), JSON.stringify(btoa("")), btoa("\xff\x00"), btoa("a"), btoa("ab"), btoa("abc"));
console.log(atob("aGVsbG8="), atob(" aGVs bG8 "), atob("aGVsbG8"), JSON.stringify(atob("")));

// atob: whitespace, padding and the characters it refuses.
const inputs: string[] = [
  "YQ==", "YR==", "YQ", "YQ=", "YQ= =", "YQ=\n=", "YWI=", "YWI", "YWJj", "YWJjZA",
  "aGVs\tbG8\n", "\x0cYQ==\r\n", " Y Q = = ", "   ", "=", "==", "===", "====", "Y===",
  "YQ==YQ==", "Y=Q=", "YQ===", "a", "abcde", "ab\x0bcd", "ab\u00a0cd", "ab-_", "ab+/",
  "€", "Y\u0100Q=", "*", "aGVsbG8==", "ab=c", "ab===", "/w==", "/+8=", "AAAA",
  "A=", "A==", "A=\n", "Y\x0c==", "YQ=Y", "9YABa=", "9YABa==", "YWJjZA=", "YWJjZA==\n",
];
for (const s of inputs) {
  console.log(JSON.stringify(s), tryAtob(s));
}

// btoa: code units above 0xFF are refused.
const texts: string[] = ["é", "\xfe\xff", "aĀ", "€", "😀", "\x7f\x80", "Ünïcödé"];
texts.push(String.fromCharCode(0xd800));
for (const s of texts) {
  console.log(JSON.stringify(s), tryBtoa(s));
}

// The error itself.
try {
  btoa("€");
} catch (e) {
  console.log(e.name, e.message, e.code, e instanceof DOMException, e instanceof Error);
  console.log(String(e), `${e}`);
}
try {
  atob("a");
} catch (e) {
  console.log(e instanceof DOMException, String(e));
}

// Every byte value round-trips.
let all = "";
for (let i = 0; i < 256; i++) {
  all += String.fromCharCode(i);
}
const b64 = btoa(all);
console.log(b64.length, b64.slice(0, 24), b64.slice(-24));
const back = atob(b64);
let same = back.length == 256;
for (let i = 0; i < back.length; i++) {
  if (back.charCodeAt(i) != i) {
    same = false;
  }
}
console.log(back.length, same, back == all);

// Long input, and MIME-style line breaks every 76 characters.
const long = "The quick brown fox \xe9\xff ".repeat(5000);
const enc = btoa(long);
console.log(long.length, enc.length, enc.slice(0, 40), enc.slice(-12));
console.log(atob(enc) == long);
let wrapped = "";
for (let i = 0; i < enc.length; i += 76) {
  wrapped += enc.slice(i, i + 76) + "\r\n";
}
console.log(wrapped.length, atob(wrapped) == long, btoa(atob(wrapped)) == enc);

// DOMException on its own.
const plain = new DOMException();
console.log(JSON.stringify(plain.name), JSON.stringify(plain.message), plain.code, JSON.stringify(String(plain)));
const m = new DOMException("just a message");
console.log(m.name, m.code, String(m));
const names: string[] = [
  "IndexSizeError", "DOMStringSizeError", "HierarchyRequestError", "WrongDocumentError",
  "InvalidCharacterError", "NoDataAllowedError", "NoModificationAllowedError", "NotFoundError",
  "NotSupportedError", "InUseAttributeError", "InvalidStateError", "SyntaxError",
  "InvalidModificationError", "NamespaceError", "InvalidAccessError", "ValidationError",
  "TypeMismatchError", "SecurityError", "NetworkError", "AbortError", "URLMismatchError",
  "QuotaExceededError", "TimeoutError", "InvalidNodeTypeError", "DataCloneError",
  "EncodingError", "Error", "MyOwnName",
];
const codes: string[] = [];
for (const n of names) {
  codes.push(`${n}=${new DOMException("x", n).code}`);
}
console.log(codes.join(" "));
console.log(DOMException.INDEX_SIZE_ERR, DOMException.INVALID_CHARACTER_ERR, DOMException.NOT_FOUND_ERR,
  DOMException.ABORT_ERR, DOMException.TIMEOUT_ERR, DOMException.DATA_CLONE_ERR, DOMException.VALIDATION_ERR);
function abort(): number {
  throw new DOMException("This operation was aborted", "AbortError");
}
try {
  abort();
} catch (e) {
  console.log(e instanceof DOMException, e instanceof Error, e.name, e.code, String(e));
}
