// `new Response(body, { status })` outside 200–599 stops the program with Node's RangeError
// message (a programming error, like an index out of bounds).
function main() {
  console.log(new Response("ok", { status: 299 }).status);
  const r = new Response("x", { status: 99 });
  console.log("unreachable", r.status);
}
