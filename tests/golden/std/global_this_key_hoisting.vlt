// A function-scoped string constant is a key of `globalThis` from its scope's start: a closure
// or nested function walked before its declaration reads it, not an outer constant.
type H = { __KA__?: number; __KB__?: number };
export const K = "__KA__";
(globalThis as H).__KA__ = 1;
(globalThis as H).__KB__ = 2;
function later(): number | undefined {
  const g = () => (globalThis as H)[K];
  const K = "__KB__";
  return g();
}
function laterFn(): number | undefined {
  function inner(): number | undefined {
    return (globalThis as H)[K];
  }
  const K = "__KB__";
  return inner();
}
function typedSelf(): number | undefined {
  const K: "__KB__" = "__KB__";
  return (globalThis as H)[K];
}
console.log(later(), laterFn(), typedSelf(), (globalThis as H)[K]);
