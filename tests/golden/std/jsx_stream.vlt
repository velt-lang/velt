// check: no leaks
// `renderToStream` as a std/http response body: the markup before a pending async component
// is sent before the component finishes loading (a raw TCP client sees the page
// head first), and the streamed body is byte-identical to `renderToString` of the same tree.
// In the logged run the components load only when told to: `second` once the client has seen
// the head, `first` once `second` has loaded, and the server reports its lines over a channel
// that `main` prints from, so the order of the lines doesn't depend on timing.
import { jsx, Fragment, jsxAsyncComponent } from "velt:jsx/jsx-runtime";
import { Element, renderToString, renderToStream } from "velt:jsx";
import { BodyStream } from "velt:fetch";
import { serve } from "velt:http";
import { IoError } from "velt:io";
import { AbortError } from "velt:task";
import { connect } from "velt:net";
import { channel, Channel } from "velt:channel";

// `wait`: load once it receives a value (else after `delay` ms); `then`: report there after;
// `lines`: where to report that it loaded.
type SlowProps = {
  label: string;
  delay: i64;
  lines: Channel<string> | null;
  wait: Channel<bool> | null;
  then: Channel<bool> | null;
};

// The channels that order the logged run.
type Cues = { headSeen: Channel<bool>; secondLoaded: Channel<bool>; lines: Channel<string> };

async function send(ch: Channel<bool>): Promise<void> {
  try {
    await ch.send(true);
  } catch (e) {
    console.log("send failed");
  }
}

// A server line, printed by `main` (a line printed by one task can appear after a line another
// task prints later, #249).
async function report(lines: Channel<string>, line: string): Promise<void> {
  try {
    await lines.send(line);
  } catch (e) {
    console.log("report failed");
  }
}

async function Slow(props: SlowProps): Promise<Element> {
  if (props.wait != null) {
    await props.wait.receive();
  } else {
    await sleep(props.delay);
  }
  if (props.lines != null) {
    await report(props.lines, `server: ${props.label} loaded`);
  }
  if (props.then != null) {
    await send(props.then);
  }
  return jsx("li", [], [], [props.label], null);
}

function page(delay: i64, cues: Cues | null): Element {
  let first: SlowProps = { label: "first", delay: delay, lines: null, wait: null, then: null };
  let second: SlowProps = {
    label: "second",
    delay: delay / 2,
    lines: null,
    wait: null,
    then: null,
  };
  if (cues != null) {
    first.lines = cues.lines;
    second.lines = cues.lines;
    first.wait = cues.secondLoaded;
    second.wait = cues.headSeen;
    second.then = cues.secondLoaded;
  }
  return Fragment(
    [
      jsx("h1", [], [], ["Posts & news"], null),
      jsx(
        "ul",
        [],
        [],
        [
          jsxAsyncComponent((p: SlowProps) => Slow(p), first, null, "jsx_stream#Slow"),
          jsxAsyncComponent((p: SlowProps) => Slow(p), second, null, "jsx_stream#Slow"),
        ],
        null,
      ),
      jsx("footer", [], [], ["end"], null),
    ],
    null,
  );
}

// `body`'s chunks, then a server line saying it ended.
async function* reportEnd(
  body: BodyStream,
  lines: Channel<string>,
): AsyncGenerator<u8[], IoError | AbortError> {
  for await (const chunk of body) {
    yield chunk;
  }
  await report(lines, "server: stream done");
}

// Reads a raw HTTP/1.1 response and reports whether the page head arrived before the posts;
// then lets the posts load.
async function rawClient(
  port: i64,
  headSeen: Channel<bool>,
  lines: Channel<string>,
): Promise<void> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.write("GET /log?150 HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
  let received = "";
  let reported = false;
  while (true) {
    const chunk = await c.readString();
    if (chunk == "") {
      break;
    }
    received += chunk;
    if (!reported && received.includes("<h1>")) {
      reported = true;
      console.log(`client: head received, posts included: ${received.includes("first")}`);
      await send(headSeen);
    }
  }
  c.close();
  // The server's three lines, reported before the response ended.
  for (let i = 0; i < 3; i++) {
    console.log(await lines.receive());
  }
  console.log(`client: complete: ${received.includes("<footer>end</footer>")}`);
}

async function main() {
  const headSeen = channel<bool>();
  const secondLoaded = channel<bool>();
  const lines = channel<string>();
  const cues: Cues = { headSeen: headSeen, secondLoaded: secondLoaded, lines: lines };
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const url = new URL(req.url);
    const delay = parseInt(url.search.slice(1)) as i64;
    const logged: Cues | null = url.pathname == "/log" ? cues : null;
    let body = renderToStream(page(delay, logged));
    if (logged != null) {
      body = BodyStream.from(reportEnd(body, logged.lines));
    }
    return new Response(body, { headers: { "content-type": "text/html; charset=utf-8" } });
  });
  await rawClient(server.port, headSeen, lines);
  const res = await fetch(`http://127.0.0.1:${server.port}/?10`);
  console.log(res.status, res.headers.get("content-type"), res.headers.get("transfer-encoding"));
  const body = await res.text();
  const expected = await renderToString(page(1, null));
  console.log(body);
  console.log(`same as renderToString: ${body == expected}`);
  await server.shutdown();
  headSeen.close();
  secondLoaded.close();
  lines.close();
}
