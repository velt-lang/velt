// Function values as timer and `void` callbacks (#789): a local function value, functions
// whose parameters are all optional or have defaults (called with none of them), and a
// function with a defaulted second parameter where one argument is passed.

import { delay } from "velt:timers";

function tick(n?: number) {
  console.log("optional", n == null ? "none" : `${n}`);
}

function withDefault(n: number = 3) {
  console.log("default", n);
}

function show(s: string, prefix: string = ">") {
  console.log(prefix, s);
}

function each(xs: string[], f: (s: string) => void) {
  for (const x of xs) {
    f(x);
  }
}

async function main() {
  const local = () => console.log("local");
  const localOptional = (n?: number) => console.log("local optional", n == null ? "none" : `${n}`);
  // Each timer fires before the next one is set: timer callbacks run as their own tasks, so
  // two that are due at once may run in either order.
  setTimeout(local, 1);
  await delay(20);
  setTimeout(tick, 1);
  await delay(20);
  setTimeout(withDefault, 1);
  await delay(20);
  setTimeout(localOptional, 1);
  await delay(20);
  const interval = setInterval(local, 30);
  await delay(45);
  clearInterval(interval);
  each(["a", "b"], show);
}
