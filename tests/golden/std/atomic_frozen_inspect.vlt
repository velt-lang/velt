// An `Atomic` inspected inside a loop of a function that borrows its holder: its word changes on
// every iteration, so each print shows the current value (the frozen pass never reads an atomic's
// bytes once, also where printing reads them as plain memory), in release builds too.
struct St {
  a: Atomic<u64>;
  k: u64;
}

class Node {
  a: Atomic<u64> = new Atomic<u64>(0);
  limit: u64 = 3;
}

class Holder {
  st: St = { a: new Atomic<u64>(5), k: 2 };
}

function show(n: Node): void {
  for (let i: u64 = 0; i < n.limit; i++) {
    n.a.add(1, "relaxed");
    console.log(n.a);
  }
}

function both(n: Node): void {
  for (let i: u64 = 0; i < n.limit; i++) {
    n.a.add(1, "relaxed");
    console.log(`${n.a.load()}`, n.a);
  }
}

function inner(h: Holder): void {
  for (let i: u64 = 0; i < h.st.k; i++) {
    h.st.a.add(1, "relaxed");
    console.log(h.st.a);
  }
}

function main() {
  const n = new Node();
  show(n);
  both(n);
  inner(new Holder());
}
