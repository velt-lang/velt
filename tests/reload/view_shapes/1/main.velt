// Array views whose helpers are shared by shape in debug builds (shape-sharing.md): a reload
// that adds an element type and edits the handler gives the new version's dictionaries to the
// shared code, swapped in or restarted.
import { serve } from "http-server";

type A = { a: number; b: string };
type B = { c: string; d: number };

function make(xs: any[]): any {
  return xs;
}

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const va = make([{ a: 1, b: "x" }]) as A[];
    const vb = make([{ c: "y", d: 2 }]) as B[];
    return new Response(`${va[0].a} ${vb[0].c}`);
  });
  console.log(`listening on ${server.port}`);
  await sleep(1000000000);
}
