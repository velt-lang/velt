// A changed signature restarts: frames on the stack would call the new code with the old ABI.
import { serve } from "velt:http";

function greet(name: string): string {
  return `hello ${name}`;
}

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    return new Response(greet("v1"));
  });
  console.log(`listening on ${server.port}`);
  await sleep(1000000000);
}
