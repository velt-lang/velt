// A field added to a class restarts: objects already in memory have the old shape.
import { serve, Request, Response } from "velt:http";

class Point {
  x: number;

  constructor(x: number) {
    this.x = x;
  }

  describe(): string {
    return `x=${this.x}`;
  }
}

async function main() {
  const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
    const p = new Point(1);
    return Response.text(p.describe());
  });
  console.log(`listening on ${server.port}`);
  await sleep(1000000000);
}
