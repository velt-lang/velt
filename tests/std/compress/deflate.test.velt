// The DEFLATE encoder (velt/compress `gzip`, `deflate`, `deflateRaw`, `DeflateEncoding`): what
// std's own decoders read back, in one piece and streamed with flushes, its frames' bytes, and its
// levels. Node's zlib and gzip read the same streams in tests/std/compress/interop (not in the suite).
import {
  CompressError,
  deflate,
  deflateRaw,
  DeflateEncoding,
  DeflateFormat,
  gunzip,
  gzip,
  inflate,
  InflateDecoder,
  inflateRaw,
} from "velt/compress";
import { describe, expect, it } from "velt/test";

/** `n` bytes of a fixed xorshift sequence, each byte taken modulo `alphabet`. */
function noise(n: i64, alphabet: u32, seed: u32): u8[] {
  const out: u8[] = [];
  let x = seed;
  for (let i: i64 = 0; i < n; i++) {
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    out.push((x % alphabet) as u8);
  }
  return out;
}

/** 16-bit counters, little-endian: no three bytes repeat, so a level-1 block is all literals. */
function counters(n: i64): u8[] {
  const out: u8[] = [];
  for (let k: i64 = 0; out.length < (n as usize); k++) {
    out.push((k & 255) as u8);
    out.push(((k >> 8) & 255) as u8);
  }
  return out;
}

function text(n: i64): u8[] {
  const words = [
    "the",
    "window",
    "slides",
    "down",
    "and",
    "a",
    "match",
    "is",
    "found",
    "or",
    "not",
  ];
  let s = "";
  let x: u32 = 7;
  while (s.length < (n as usize)) {
    x = x * 1103515245 + 12345;
    s += words[((x >> 16) % 11) as i64] + ((x >> 8) % 9 == 0 ? ".\n" : " ");
  }
  const out: u8[] = [];
  for (let i: i64 = 0; i < n; i++) {
    out.push(s.charCodeAt(i) as u8);
  }
  return out;
}

/**
 * Random bytes, then 8-byte copies whose distance codes run from 12 to 28 with counts growing
 * 1.7 times per code: frequencies that skewed make the code-length code reach its 7-bit limit.
 */
function skewedDistances(): u8[] {
  const out = noise(49400, 256, 11);
  const counts: i64[] = [];
  let c = 1.6;
  for (let code = 12; code <= 28; code++) {
    counts.push(Math.round(c) as i64);
    c *= 1.7;
  }
  // The first distance of each code (RFC 1951 3.2.5), from 12 on.
  const bases: i64[] = [
    65,
    97,
    129,
    193,
    257,
    385,
    513,
    769,
    1025,
    1537,
    2049,
    3073,
    4097,
    6145,
    8193,
    12289,
    16385,
  ];
  const filler = noise(20000, 256, 12);
  let f: usize = 0;
  let left = true;
  while (left) {
    left = false;
    for (let i: i64 = 0; i < 17; i++) {
      if (counts[i] == 0) {
        continue;
      }
      counts[i] -= 1;
      left = true;
      const from = (out.length as i64) - bases[i];
      for (let k: i64 = 0; k < 8; k++) {
        out.push(out[from + k]);
      }
      // A random byte between copies, so one copy doesn't run on into the next.
      out.push(filler[f % filler.length]);
      f++;
    }
  }
  return out;
}

/** A random block repeated at a period of 32,769: one byte past the farthest distance used. */
function farPeriod(): u8[] {
  const block = noise(32769, 256, 13);
  return block.concat(block).concat(block);
}

function run(n: i64, b: u8): u8[] {
  return new Array<u8>(n as usize).fill(b);
}

function same(a: u8[], b: u8[]): bool {
  if (a.length != b.length) {
    return false;
  }
  for (let i: usize = 0; i < a.length; i++) {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

/** Everything `d` can output now. */
function drain(d: InflateDecoder): u8[] {
  let out: u8[] = [];
  while (true) {
    const chunk = d.read(65536);
    if (chunk.length == 0) {
      return out;
    }
    out = out.concat(chunk);
  }
}

const CORPUS: [string, u8[]][] = [
  ["empty", []],
  ["one byte", [42]],
  ["text, 100 KB", text(100000)],
  ["literals past a block's symbol limit", counters(40000)],
  ["four letters, 200 KB", noise(200000, 4, 1)],
  ["a run of 1 MB", run(1000000, 97)],
  ["random, 100 KB", noise(100000, 256, 2)],
  ["distance codes skewed to the code-length code's limit", skewedDistances()],
  ["a period one past the farthest distance", farPeriod()],
];

describe("deflate encoder", () => {
  it("gives the input back through gunzip, inflate and inflateRaw, at every level", () => {
    for (const [name, input] of CORPUS) {
      for (let level = 1; level <= 9; level++) {
        const ok =
          same(gunzip(gzip(input, level)), input) &&
          same(inflate(deflate(input, level)), input) &&
          same(inflateRaw(deflateRaw(input, level)), input);
        expect(ok ? "" : `${name} at level ${level}`).toBe("");
      }
    }
  });

  it("gives the same bytes for the same input, whatever ran before it", () => {
    const t = text(50000).concat(noise(40000, 5, 14)).concat(farPeriod());
    for (const level of [1, 6, 9]) {
      const first = gzip(t, level);
      // Other encoders' buffers, freed, are the memory the next one may get.
      gzip(noise(90000, 7, 15), level);
      gzip(skewedDistances(), level);
      expect(same(gzip(t, level), first) ? "" : `level ${level}`).toBe("");
    }
  });

  it("writes an empty stream as zlib does", () => {
    expect(deflate([], 6)).toEqual([0x78, 0x9c, 0x03, 0x00, 0x00, 0x00, 0x00, 0x01]);
    expect(deflateRaw([], 6)).toEqual([0x03, 0x00]);
    expect(gzip([], 6)).toEqual([
      0x1f,
      0x8b,
      8,
      0,
      0,
      0,
      0,
      0,
      0,
      255,
      0x03,
      0x00,
      0,
      0,
      0,
      0,
      0,
      0,
      0,
      0,
    ]);
  });

  it("marks the level in the zlib and gzip headers", () => {
    expect(deflate([1], "fastest").slice(0, 2)).toEqual([0x78, 0x01]);
    expect(deflate([1], 3).slice(0, 2)).toEqual([0x78, 0x5e]);
    expect(deflate([1]).slice(0, 2)).toEqual([0x78, 0x9c]);
    expect(deflate([1], "smallest").slice(0, 2)).toEqual([0x78, 0xda]);
    expect(gzip([1], "fastest")[8]).toBe(4);
    expect(gzip([1], "smallest")[8]).toBe(2);
  });

  it("compresses text, more at higher levels, and grows random bytes by little", () => {
    const t = text(100000);
    const fast = gzip(t, "fastest").length;
    const small = gzip(t, "smallest").length;
    expect(small < fast).toBe(true);
    expect(small * 4 < t.length).toBe(true);
    const r = noise(100000, 256, 3);
    // Stored blocks, 5 bytes of header each, one per 16,383 symbols as in zlib: 7 here.
    expect(deflateRaw(r).length <= r.length + 5 * 7).toBe(true);
    expect(deflateRaw(run(1000000, 0)).length < 2000).toBe(true);
  });

  it("gives stock zlib's sizes on text, which a poor choice of codes would grow", () => {
    // zlib 1.2.12's raw DEFLATE of the same bytes, at levels 6 and 9; level 1 searches its own
    // way and does no worse than its 24,810.
    const t = text(100000);
    expect(deflateRaw(t, 1).length <= 24810).toBe(true);
    expect(deflateRaw(t, 6).length).toBe(18321);
    expect(deflateRaw(t, 9).length).toBe(17140);
  });

  it("reads a slot of level 1 that wrapped around 2^16 as no more than a candidate", () => {
    // The same block every `period` bytes: slots left from a period ago name the position
    // itself (65,536) or a place with other bytes (the others), and only the bytes can tell.
    const periods: i64[] = [65536, 65536 + 7, 65536 + 32000, 98304, 131072];
    for (const period of periods) {
      const block = noise(40000, 256, 11);
      const input: u8[] = [];
      for (let i: i64 = 0; i < 400000; i++) {
        input.push(i % period < 40000 ? block[i % period] : ((i * 2654435761) >> 13) as u8);
      }
      expect(same(inflateRaw(deflateRaw(input, 1)), input) ? "" : `period ${period}`).toBe("");
    }
  });

  it("keeps finding matches at level 1 after the window slides", () => {
    // 30,000 random bytes over and over: the first copy costs all of its bytes, the others
    // almost none, unless the slots stop meaning what they did after a slide, when a whole
    // copy goes out as literals.
    const block = noise(30000, 256, 13);
    const input: u8[] = [];
    for (let i: i64 = 0; i < 300000; i++) {
      input.push(block[i % 30000]);
    }
    expect(deflateRaw(input, 1).length < 40000).toBe(true);
  });

  it("stops a match where the input stops, around the last full-length match", () => {
    // A repeat running to the end, with the end at every distance around where level 1 changes
    // how it compares: 258 bytes and a 16-byte load from the end of the input.
    const unit = noise(1000, 256, 5);
    for (let n: i64 = 1200; n < 1300; n++) {
      const input: u8[] = [];
      for (let i: i64 = 0; i < n; i++) {
        input.push(unit[i % 300]);
      }
      for (const level of [1, 2, 6]) {
        expect(same(inflateRaw(deflateRaw(input, level)), input) ? "" : `${n} at ${level}`).toBe("");
      }
    }
  });

  it("gives back the farthest distances and the longest lengths at every level", () => {
    // Distances in the last code, whose 13 extra bits are all set or all clear, then lengths in
    // the codes around 258.
    const block = noise(3000, 256, 9);
    const fresh = noise(40000, 256, 21);
    const gaps: i64[] = [29506, 21577, 25672, 13385];
    for (const gap of gaps) {
      const input = block.concat(fresh.slice(0, gap)).concat(block);
      for (let level = 1; level <= 9; level++) {
        expect(same(inflateRaw(deflateRaw(input, level)), input) ? "" : `${gap} at ${level}`).toBe("");
      }
    }
  });

  it("refuses a level that isn't a whole number from 1 to 9", () => {
    for (const level of [0, 10, 2.5, NaN, -1]) {
      let threw = false;
      try {
        gzip([1], level);
      } catch (e) {
        threw = e instanceof RangeError;
      }
      expect(threw ? "" : `level ${level}`).toBe("");
    }
  });
});

describe("DeflateEncoding", () => {
  it("is named by its format", () => {
    const formats: DeflateFormat[] = ["gzip", "deflate", "deflate-raw"];
    for (const f of formats) {
      expect(new DeflateEncoding(f).name).toBe(f);
    }
  });

  it("outputs everything written so far at each flush, in pieces of any size", () => {
    const input = text(60000).concat(noise(90000, 4, 5)).concat(counters(30000));
    const steps: i64[] = [1, 7, 4099, 70000];
    for (const step of steps) {
      for (const level of [1, 6, 9]) {
        const e = new DeflateEncoding("deflate-raw", level).encoder();
        const d = new InflateDecoder("raw");
        let decoded: u8[] = [];
        let at: i64 = 0;
        let pieces = 0;
        const end = input.length as i64;
        let ok = true;
        // A piece of 1 byte is slow in debug builds: 3,000 of them make the point.
        const stop = step == 1 ? 3000 : end;
        while (at < stop) {
          const to = at + step < stop ? at + step : stop;
          d.feed(e.write(input, at, to));
          at = to;
          pieces++;
          if (pieces % 3 == 0 || at == stop) {
            d.feed(e.flush());
            decoded = decoded.concat(drain(d));
            ok = ok && same(decoded, input.slice(0, at));
          }
        }
        d.feed(e.finish());
        d.finish();
        decoded = decoded.concat(drain(d));
        ok = ok && d.done && same(decoded, input.slice(0, stop));
        expect(ok ? "" : `pieces of ${step} at level ${level}`).toBe("");
      }
    }
  });

  it("gives nothing for a flush with nothing new, and nothing after finish", () => {
    const e = new DeflateEncoding("gzip").encoder();
    e.write([1, 2, 3], 0, 3);
    expect(e.flush().length > 0).toBe(true);
    expect(e.flush()).toEqual([]);
    const tail = e.finish();
    expect(tail.length > 0).toBe(true);
    expect(e.finish()).toEqual([]);
    let threw = false;
    try {
      e.write([4], 0, 1);
    } catch (err) {
      threw = err instanceof CompressError;
    }
    expect(threw).toBe(true);
  });

  it("refuses a range outside the array, and goes on after it", () => {
    const formats: DeflateFormat[] = ["gzip", "deflate", "deflate-raw"];
    const ranges: [i64, i64][] = [
      [0, 50000000],
      [0, 64],
      [0, 100],
      [0, 4],
      [-1, 2],
      [2, 1],
    ];
    for (const f of formats) {
      for (const [start, end] of ranges) {
        const e = new DeflateEncoding(f).encoder();
        let threw = false;
        try {
          e.write([1, 2, 3], start, end);
        } catch (err) {
          threw = err instanceof RangeError;
        }
        const out = e.write([1, 2, 3], 0, 3).concat(e.finish());
        const back = f == "gzip" ? gunzip(out) : f == "deflate" ? inflate(out) : inflateRaw(out);
        const ok = threw && same(back, [1, 2, 3]);
        expect(ok ? "" : `${f} ${start} to ${end}`).toBe("");
      }
    }
  });

  it("reads only the part of the array it is given", () => {
    const e = new DeflateEncoding("deflate").encoder();
    const bytes = text(1000);
    const out = e.write(bytes, 100, 600).concat(e.finish());
    expect(same(inflate(out), bytes.slice(100, 600))).toBe(true);
  });
});
