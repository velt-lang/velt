// `startTls` (velt/net's TLS 1.3 client written in Velt, #2392) against the runtime's rustls
// server (`listenTls`): the handshake, ALPN, data both ways in records of every size, the end
// of the stream at the server's close_notify, a connection cut without it, and a refused
// certificate check.
import { connect, listenTls, startTls, TcpStream } from "velt/net";
import { describe, expect, it } from "velt/test";
import { TEST_CERT, TEST_KEY } from "../../golden/std/_tls";

// `n` bytes of a repeating pattern.
function pattern(n: usize): u8[] {
  const out: u8[] = [];
  for (let i: usize = 0; i < n; i++) {
    out.push(((i * 7) % 251) as u8);
  }
  return out;
}

describe("startTls against rustls", () => {
  it("agrees on ALPN and echoes data of every record size", async () => {
    const l = await listenTls("127.0.0.1:0", {
      cert: TEST_CERT,
      key: TEST_KEY,
      alpn: ["h2", "http/1.1"],
    });
    const accepting = l;
    // The server echoes everything until the client's close_notify ends its stream.
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      const proto = `${await conn.alpnProtocol()}`;
      let total: usize = 0;
      while (true) {
        const chunk = await conn.read();
        if (chunk.length == 0) {
          break;
        }
        total += chunk.length;
        await conn.writeBytes(chunk);
      }
      conn.close();
      return `${proto} ${total}`;
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), {
      serverName: "localhost",
      verify: false,
      alpn: ["http/1.1", "h2"],
    });
    expect(await tls.alpnProtocol()).toBe("h2");
    const sizes: usize[] = [1, 100, 16383, 16384, 16385, 70000, 200000];
    let sent: usize = 0;
    for (const n of sizes) {
      const data = pattern(n);
      await tls.writeBytes(data);
      sent += n;
      const back: u8[] = [];
      while (back.length < n) {
        const chunk = await tls.read();
        expect(chunk.length > 0).toBe(true);
        for (const b of chunk) {
          back.push(b);
        }
      }
      expect(back.length).toBe(n as number);
      let same = true;
      for (let i: usize = 0; i < n; i++) {
        same = same && back[i] == data[i];
      }
      expect(same).toBe(true);
    }
    await tls.shutdown();
    expect(await server).toBe(`h2 ${sent}`);
    l.close();
  });

  it("reads to the end at the server's close_notify, and writes text", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      const got = await conn.readString();
      await conn.write(`hello ${got}`);
      await conn.shutdown();
      conn.close();
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    expect(await tls.alpnProtocol()).toBe(null);
    await tls.write("velt");
    let text = "";
    while (true) {
      const chunk = await tls.read();
      if (chunk.length == 0) {
        break;
      }
      text += String.fromCharCode(...chunk.map((b) => b as number));
    }
    expect(text).toBe("hello velt");
    await server;
    tls.close();
    l.close();
  });

  it("throws on a read when the connection is cut without close_notify", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      await conn.write("partial");
      conn.close();
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    let text = "";
    while (text.length < 7) {
      const chunk = await tls.read();
      expect(chunk.length > 0).toBe(true);
      text += String.fromCharCode(...chunk.map((b) => b as number));
    }
    expect(text).toBe("partial");
    await expect(tls.read()).rejects.toThrow("TLS: the connection closed without close_notify");
    // Not an end of stream the next time either.
    await expect(tls.read()).rejects.toThrow("TLS: the connection closed without close_notify");
    await server;
    tls.close();
    l.close();
  });

  it("refuses to run without verify: false", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const tcp = await connect(`127.0.0.1:${l.port}`);
    await expect(startTls(tcp)).rejects.toThrow("certificate verification is not implemented yet");
    tcp.close();
    l.close();
  });
});
