// `startTls` (velt/net's TLS 1.3 client written in Velt, #2392) against the runtime's rustls
// server (`listenTls`): the handshake, ALPN, data both ways in records of every size, the end
// of the stream at the server's close_notify and a connection cut without it; and the checks of
// the server's certificate: its chain to a trusted CA, its name, and the options for both.
import { connect, listenTls, startTls, TcpListener, TcpStream, TlsStartOptions } from "velt/net";
import { describe, expect, it } from "velt/test";
import { TEST_CA, TEST_CERT, TEST_KEY } from "../../golden/std/_tls";
import * as certs from "./_verify_certs";

// `n` bytes of a repeating pattern.
function pattern(n: usize): u8[] {
  const out: u8[] = [];
  for (let i: usize = 0; i < n; i++) {
    out.push(((i * 7) % 251) as u8);
  }
  return out;
}

describe("startTls against rustls", () => {
  it("agrees on ALPN and echoes data of every record size", async () => {
    const l = await listenTls("127.0.0.1:0", {
      cert: TEST_CERT,
      key: TEST_KEY,
      alpn: ["h2", "http/1.1"],
    });
    const accepting = l;
    // The server echoes everything until the client's close_notify ends its stream.
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      const proto = `${await conn.alpnProtocol()}`;
      let total: usize = 0;
      while (true) {
        const chunk = await conn.read();
        if (chunk.length == 0) {
          break;
        }
        total += chunk.length;
        await conn.writeBytes(chunk);
      }
      conn.close();
      return `${proto} ${total}`;
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), {
      serverName: "localhost",
      verify: false,
      alpn: ["http/1.1", "h2"],
    });
    expect(await tls.alpnProtocol()).toBe("h2");
    const sizes: usize[] = [1, 100, 16383, 16384, 16385, 70000, 200000];
    let sent: usize = 0;
    for (const n of sizes) {
      const data = pattern(n);
      await tls.writeBytes(data);
      sent += n;
      const back: u8[] = [];
      while (back.length < n) {
        const chunk = await tls.read();
        expect(chunk.length > 0).toBe(true);
        for (const b of chunk) {
          back.push(b);
        }
      }
      expect(back.length).toBe(n as number);
      let same = true;
      for (let i: usize = 0; i < n; i++) {
        same = same && back[i] == data[i];
      }
      expect(same).toBe(true);
    }
    await tls.shutdown();
    expect(await server).toBe(`h2 ${sent}`);
    tls.close();
    l.close();
  });

  it("reads to the end at the server's close_notify, and writes text", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      const got = await conn.readString();
      await conn.write(`hello ${got}`);
      await conn.shutdown();
      conn.close();
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    expect(await tls.alpnProtocol()).toBe(null);
    await tls.write("velt");
    let text = "";
    while (true) {
      const chunk = await tls.read();
      if (chunk.length == 0) {
        break;
      }
      text += String.fromCharCode(...chunk.map((b) => b as number));
    }
    expect(text).toBe("hello velt");
    await server;
    tls.close();
    l.close();
  });

  it("throws on a read when the connection is cut without close_notify", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      await conn.write("partial");
      conn.close();
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    let text = "";
    while (text.length < 7) {
      const chunk = await tls.read();
      expect(chunk.length > 0).toBe(true);
      text += String.fromCharCode(...chunk.map((b) => b as number));
    }
    expect(text).toBe("partial");
    await expect(tls.read()).rejects.toThrow("TLS: the connection closed without close_notify");
    // Not an end of stream the next time either.
    await expect(tls.read()).rejects.toThrow("TLS: the connection closed without close_notify");
    await server;
    tls.close();
    l.close();
  });

  it("reads the server's answer after shutdown: a half-close", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      const got = await conn.readString();
      while (true) {
        const more = await conn.read();
        if (more.length == 0) {
          break;
        }
      }
      await conn.write(`answer to ${got}`);
      await conn.shutdown();
      conn.close();
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    await tls.write("request");
    await tls.shutdown();
    let text = "";
    while (true) {
      const chunk = await tls.read();
      if (chunk.length == 0) {
        break;
      }
      text += String.fromCharCode(...chunk.map((b) => b as number));
    }
    expect(text).toBe("answer to request");
    await server;
    tls.close();
    l.close();
  });

  it("gives concurrent reads the server's data in call order", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      await conn.write("AAAA");
      await conn.readString();
      await conn.write("BBBB");
      await conn.readString();
      await conn.write("CCCC");
      await conn.shutdown();
      await conn.read();
      conn.close();
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    const a = tls.read();
    const b = tls.read();
    const c = tls.read();
    const text = (bytes: u8[]): string => String.fromCharCode(...bytes.map((x) => x as number));
    expect(text(await a)).toBe("AAAA");
    await tls.write("1");
    expect(text(await b)).toBe("BBBB");
    await tls.write("2");
    expect(text(await c)).toBe("CCCC");
    await tls.shutdown();
    await server;
    tls.close();
    l.close();
  });

  it("keeps sequence numbers apart across closures and a task it moves to", async () => {
    const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = l;
    const server = spawn(async () => {
      const conn: TcpStream = await accepting.accept();
      let text = "";
      while (true) {
        const chunk = await conn.read();
        if (chunk.length == 0) {
          break;
        }
        text += String.fromCharCode(...chunk.map((b) => b as number));
      }
      conn.close();
      return text;
    });
    const tls = await startTls(await connect(`127.0.0.1:${l.port}`), { verify: false });
    await tls.write("a");
    const say = async (f: () => Promise<void, Error>) => {
      await f();
    };
    await say(async () => {
      await tls.write("b");
    });
    await say(async () => {
      await tls.write("c");
    });
    await spawn(async () => {
      await tls.write("d");
      await tls.shutdown();
      tls.close();
    });
    // rustls opens each record at the next sequence number: a repeat ends the stream with an error.
    expect(await server).toBe("abcd");
    l.close();
  });
});

// A server with `cert` (its certificate and the intermediate) and `key` that answers each
// connection's first bytes with "ok" and closes.
async function server(cert: string, key: string): Promise<TcpListener> {
  const l = await listenTls("127.0.0.1:0", { cert: cert + certs.INTERMEDIATE, key: key });
  const accepting = l;
  spawn(async () => {
    // A handshake the client gave up fails `accept` or the read; the server goes on to the next
    // connection. A closed listener fails every `accept`, which ends the task.
    let failures = 0;
    while (failures < 20) {
      try {
        const conn: TcpStream = await accepting.accept();
        failures = 0;
        await conn.read();
        await conn.write("ok");
        conn.close();
      } catch (e) {
        failures++;
      }
    }
  });
  return l;
}

// What the server answers over a verified connection made with `opts`.
async function answer(port: number, opts: TlsStartOptions): Promise<string> {
  const tls = await startTls(await connect(`127.0.0.1:${port}`), opts);
  await tls.write("hello");
  const text = new TextDecoder().decode(await tls.read());
  tls.close();
  return text;
}

describe("TlsStream.takeIn", () => {
  it(
    "takes a byte that was read from the socket outside the stream, and loses nothing",
    async () => {
      const l = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
      const accepting = l;
      const serving = spawn(async () => {
        const conn = await accepting.accept();
        await conn.read();
        await conn.write("a notification");
        await conn.shutdown();
        conn.close();
      });
      const tcp = await connect(`127.0.0.1:${l.port}`);
      const tls = await startTls(tcp, { verify: false });
      // A look at an idle connection: nothing has come, and nothing is taken.
      const one: u8[] = [0xee, 0];
      expect(tcp.tryRead(one, 1, 2)).toBe(0);
      await tls.write("go");
      // Now the server's record is on its way: one byte of it is read from the socket, as a look
      // at an idle connection does, and given to the stream. `readable()` may wake before the
      // record has arrived, and `tryRead` then finds nothing (0): wait again, a bounded number of
      // times (#3908). `null`, the end of the stream, stops the loop and fails below.
      let got: number | null = 0;
      for (let waits = 0; got === 0 && waits < 1000; waits++) {
        await tcp.readable();
        got = tcp.tryRead(one, 1, 2);
      }
      expect(got).toBe(1);
      tls.takeIn(one, 1, 2);
      let text = "";
      while (true) {
        const chunk = await tls.read();
        if (chunk.length == 0) {
          break;
        }
        text += String.fromCharCode(...chunk.map((b) => b as number));
      }
      expect(text).toBe("a notification");
      expect(() => tls.takeIn(one, 2, 1)).toThrow("takeIn: the range");
      tls.close();
      await serving;
      l.close();
    },
  );
});

describe("startTls verifying the server", () => {
  it("takes a chain to a CA given with `ca`, for each kind of server key", async () => {
    const keys: [string, string][] = [
      [certs.P256_CERT, certs.P256_KEY],
      [certs.P384_CERT, certs.P384_KEY],
      [certs.RSA_CERT, certs.RSA_KEY],
      [certs.ED_CERT, certs.ED_KEY],
    ];
    for (const [cert, key] of keys) {
      const l = await server(cert, key);
      expect(await answer(l.port, { serverName: "localhost", ca: certs.CA })).toBe("ok");
      l.close();
    }
  });

  it("checks by default, and refuses a chain to no trusted root", async () => {
    const l = await server(certs.P256_CERT, certs.P256_KEY);
    // The built-in roots alone, a CA with the right name and another key, and another CA.
    await expect(answer(l.port, { serverName: "localhost" })).rejects.toThrow(
      "TLS: unable to get local issuer certificate (UNABLE_TO_GET_ISSUER_CERT_LOCALLY)",
    );
    await expect(answer(l.port, { serverName: "localhost", ca: certs.OTHER_CA })).rejects.toThrow(
      "TLS: certificate signature failure",
    );
    await expect(answer(l.port, { serverName: "localhost", ca: TEST_CA })).rejects.toThrow(
      "TLS: unable to get local issuer certificate (UNABLE_TO_GET_ISSUER_CERT_LOCALLY)",
    );
    // With the right one among others it is found.
    const both: TlsStartOptions = {
      serverName: "localhost",
      ca: certs.OTHER_CA + TEST_CA + certs.CA,
    };
    expect(await answer(l.port, both)).toBe("ok");
    l.close();
  });

  it("takes the intermediate itself as a trusted CA", async () => {
    const l = await server(certs.P256_CERT, certs.P256_KEY);
    expect(await answer(l.port, { serverName: "localhost", ca: certs.INTERMEDIATE })).toBe("ok");
    l.close();
  });

  it("refuses a certificate that is not for the server's name", async () => {
    const l = await server(certs.P256_CERT, certs.P256_KEY);
    const names = ["a.velt.test", "LOCALHOST", "localhost.", "127.0.0.1", "::1", "[::1]"];
    for (const name of names) {
      expect(`${name} ${await answer(l.port, { serverName: name, ca: certs.CA })}`).toBe(
        `${name} ok`,
      );
    }
    // Another name, two labels under the wildcard, the wildcard's parent, the common name, and
    // addresses that are not in the certificate.
    const others = [
      "example.com",
      "a.b.velt.test",
      "velt.test",
      "not-a-name.test",
      "127.0.0.2",
      "::2",
      "::ffff:127.0.0.1",
    ];
    for (const name of others) {
      let message = "no failure";
      try {
        await answer(l.port, { serverName: name, ca: certs.CA });
      } catch (e) {
        message = `${e}`;
      }
      expect(`${name}: ${message}`).toContain(
        "TLS: Hostname/IP does not match certificate's altnames: ",
      );
      expect(message).toContain("(ERR_TLS_CERT_ALTNAME_INVALID)");
    }
    l.close();
  });

  it("checks the chain alone with checkServerName: false", async () => {
    const l = await server(certs.P256_CERT, certs.P256_KEY);
    const opts: TlsStartOptions = {
      serverName: "example.com",
      ca: certs.CA,
      checkServerName: false,
    };
    expect(await answer(l.port, opts)).toBe("ok");
    expect(await answer(l.port, { ca: certs.CA, checkServerName: false })).toBe("ok");
    // The CA alone, without the built-in roots: what checking a chain without the name is for.
    const own: TlsStartOptions = { ca: certs.CA, checkServerName: false, builtinRoots: false };
    expect(await answer(l.port, own)).toBe("ok");
    const wrong: TlsStartOptions = { ca: TEST_CA, checkServerName: false, builtinRoots: false };
    await expect(answer(l.port, wrong)).rejects.toThrow(
      "TLS: unable to get local issuer certificate (UNABLE_TO_GET_ISSUER_CERT_LOCALLY)",
    );
    await expect(answer(l.port, { checkServerName: false })).rejects.toThrow(
      "TLS: unable to get local issuer certificate (UNABLE_TO_GET_ISSUER_CERT_LOCALLY)",
    );
    l.close();
  });

  it("refuses options it cannot verify with, before anything is sent", async () => {
    const l = await server(certs.P256_CERT, certs.P256_KEY);
    await expect(answer(l.port, {})).rejects.toThrow("`serverName` is needed");
    await expect(answer(l.port, { serverName: "localhost", builtinRoots: false })).rejects.toThrow(
      "`ca` is needed when `builtinRoots` is false",
    );
    await expect(answer(l.port, { serverName: "bücher.example" })).rejects.toThrow("is not ASCII");
    // What rustls refuses as a server name: an empty label, a label ending in a hyphen, a last
    // label of digits that is no IP address, a port.
    for (const name of ["a..example", "host-.example", "1.2.3.400", "localhost:443", "*.example"]) {
      await expect(answer(l.port, { serverName: name })).rejects.toThrow(
        "is neither a DNS name nor an IP address",
      );
    }
    await expect(answer(l.port, { serverName: "localhost", ca: "not PEM" })).rejects.toThrow(
      "no certificate found in the CA PEM",
    );
    const broken = "-----BEGIN CERTIFICATE-----\nAAAA\n-----END CERTIFICATE-----\n";
    await expect(answer(l.port, { serverName: "localhost", ca: broken })).rejects.toThrow(
      "invalid CA certificate in the CA PEM",
    );
    // A key is not a certificate.
    await expect(answer(l.port, { serverName: "localhost", ca: certs.P256_KEY })).rejects.toThrow(
      "no certificate found in the CA PEM",
    );
    l.close();
  });

  it("still takes any certificate with verify: false", async () => {
    const l = await server(certs.P256_CERT, certs.P256_KEY);
    expect(await answer(l.port, { serverName: "example.com", verify: false })).toBe("ok");
    expect(await answer(l.port, { verify: false })).toBe("ok");
    l.close();
  });
});
