// velt/net/udp's sockets on the executor's reactor (epoll, kqueue, Windows' AFD): datagrams both
// ways with their sender, a receive limit (Winsock fails a datagram larger than the buffer; the
// socket keeps its first bytes and the sender, as the C library's `recvfrom` does), an empty
// datagram, broadcast on and off, a close while a receive waits (it rejects with `EBADF`, #2821),
// and the errors of a port in use, a closed socket and a datagram over 64 KiB.
import { bindUdp } from "velt/net/udp";
import { describe, expect, it } from "velt/test";

describe("UDP sockets", () => {
  it("carries datagrams both ways with their sender", async () => {
    const a = await bindUdp("127.0.0.1:0");
    const b = await bindUdp("127.0.0.1:0");
    expect(a.port > 0 && b.port != a.port).toBe(true);
    const incoming = b.recvFrom();
    expect(await a.sendTextTo("ping", `127.0.0.1:${b.port}`)).toBe(4);
    const d = await incoming;
    expect(d.text()).toBe("ping");
    expect(d.addr).toBe(`127.0.0.1:${a.port}`);
    expect(await b.sendTo([1u8, 2u8, 3u8], d.addr)).toBe(3);
    const back = await a.recvFrom();
    expect(back.data.length).toBe(3);
    expect(back.addr).toBe(`127.0.0.1:${b.port}`);
    a.close();
    b.close();
  });

  it("keeps a datagram's first bytes and its sender under a limit", async () => {
    const a = await bindUdp("127.0.0.1:0");
    const b = await bindUdp("127.0.0.1:0");
    const text = "0123456789".repeat(10);
    await a.sendTextTo(text, `127.0.0.1:${b.port}`);
    const cut = await b.recvFrom(7);
    expect(cut.text()).toBe("0123456");
    expect(cut.addr).toBe(`127.0.0.1:${a.port}`);
    // The rest of that datagram is gone: the next receive gets the next one whole.
    await a.sendTextTo(text, `127.0.0.1:${b.port}`);
    const whole = await b.recvFrom();
    expect(whole.text()).toBe(text);
    await a.sendTo([], `127.0.0.1:${b.port}`);
    const empty = await b.recvFrom();
    expect(empty.data.length).toBe(0);
    expect(empty.addr).toBe(`127.0.0.1:${a.port}`);
    a.close();
    b.close();
  });

  it("turns broadcast on and off", async () => {
    const a = await bindUdp("127.0.0.1:0");
    a.setBroadcast(true);
    a.setBroadcast(false);
    a.close();
    let code = "";
    try {
      a.setBroadcast(true);
    } catch (e) {
      code = e.code;
    }
    expect(code).toBe("EBADF");
  });

  it("rejects a receive waiting when the socket closes", async () => {
    const a = await bindUdp("127.0.0.1:0");
    const pending = a.recvFrom();
    a.close();
    let code = "";
    try {
      await pending;
    } catch (e) {
      code = e.code;
    }
    expect(code).toBe("EBADF");
    // Closing again is a no-op.
    a.close();
  });

  it("reports a port in use, a closed socket and a datagram too large", async () => {
    const a = await bindUdp("127.0.0.1:0");
    let taken = "";
    try {
      const b = await bindUdp(`127.0.0.1:${a.port}`);
      b.close();
    } catch (e) {
      taken = e.code;
    }
    expect(taken).toBe("EADDRINUSE");
    const big: u8[] = Buffer.alloc(70000);
    let large = "";
    try {
      await a.sendTo(big, `127.0.0.1:${a.port}`);
    } catch (e) {
      large = e.message;
    }
    expect(large.includes("os error")).toBe(true);
    a.close();
    let closed = "";
    try {
      await a.sendTextTo("x", "127.0.0.1:9");
    } catch (e) {
      closed = e.code;
    }
    expect(closed).toBe("EBADF");
  });
});
