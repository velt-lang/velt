// `fetch` through a proxy (#3693): `https:` and `http:` requests through a `CONNECT` tunnel to
// velt/http servers (the `https:` one with the test certificate), a proxy that refuses the tunnel
// or is not there, and the proxy the environment sets (used by default). The proxy is written
// here on velt/net. (Which proxy a request takes, and `NO_PROXY`, are white-box tests:
// std/net/http/fetch/client/proxy.test.velt; tests/golden/std/http_server/fetch_env_proxy.velt
// runs them beside Node.)
import { Channel, channel } from "velt/sync";
import { HttpServer, serve } from "http-server";
import { IoError } from "velt/io";
import { utf8DecodeLossy } from "velt/encoding";
import { connect, listen, listenTls, TcpListener, TcpStream } from "velt/net";
import { removeEnv, setEnv } from "velt/process";
import { describe, expect, it } from "velt/test";
import "velt/test/http";
import { TEST_CA, TEST_CERT, TEST_KEY } from "../../golden/std/_tls";

/** The request head that arrives first on `conn` (and whatever came after it). */
async function headOf(conn: TcpStream): Promise<string> {
  let input = "";
  while (input.indexOf("\r\n\r\n") < 0) {
    const more = await conn.readString();
    if (more == "") {
      break;
    }
    input += more;
  }
  return input;
}

/** Copies `from` to `to` until `from` ends, then closes `to`: a tunnel ends with either side. */
async function pipe(from: TcpStream, to: TcpStream) {
  try {
    while (true) {
      const bytes = await from.read();
      if (bytes.length == 0) {
        break;
      }
      await to.writeBytes(bytes);
    }
    to.close();
  } catch (e) {
    to.close();
  }
}

/**
 * One proxied connection: its head goes to `heads` before anything is answered or forwarded.
 * `CONNECT` to localhost is tunneled, and the first bytes sent through the tunnel go to `inner`;
 * to any other host it is refused with a 407. Any other request is answered with a 400.
 */
async function proxyOne(conn: TcpStream, heads: Channel<string>, inner: Channel<string>) {
  const head = await headOf(conn);
  await heads.send(head);
  const line = head.slice(0, head.indexOf("\r\n"));
  if (!line.startsWith("CONNECT ")) {
    await conn.write("HTTP/1.1 400 Bad Request\r\ncontent-length: 0\r\nconnection: close\r\n\r\n");
    conn.close();
    return;
  }
  const target = line.split(" ")[1];
  if (!target.startsWith("localhost:")) {
    await conn.write("HTTP/1.1 407 Proxy Authentication Required\r\ncontent-length: 0\r\n\r\n");
    conn.close();
    return;
  }
  const origin = await connect(`127.0.0.1:${target.slice(10)}`);
  await conn.write("HTTP/1.1 200 Connection established\r\n\r\n");
  const first = await conn.read();
  await inner.send(utf8DecodeLossy(first));
  await origin.writeBytes(first);
  spawn(pipe(origin, conn));
  await pipe(conn, origin);
}

/** `proxyOne`, closing `conn` on an error (a TLS proxy's, when the client does not trust it). */
async function proxyGuarded(conn: TcpStream, heads: Channel<string>, inner: Channel<string>) {
  try {
    await proxyOne(conn, heads, inner);
  } catch (e) {
    conn.close();
  }
}

/** Proxies each connection `listener` accepts until it is closed. */
function proxyAll(listener: TcpListener, heads: Channel<string>, inner: Channel<string>) {
  spawn(async () => {
    while (true) {
      let conn: TcpStream;
      try {
        conn = await listener.accept();
      } catch (e) {
        return;
      }
      spawn(proxyGuarded(conn, heads, inner));
    }
  });
}

/** What `fetch(url, init)` gives: `status body`, or `code message`. */
async function outcome(url: string, init: RequestInit): Promise<string> {
  try {
    const res = await fetch(url, init);
    return `${res.status} ${await res.text()}`;
  } catch (e) {
    return e instanceof IoError ? `${e.code} ${e.message}` : e.message;
  }
}

/** An HTTPS and an HTTP origin, and a proxy (`proxyOne`) with credentials. */
class Setup {
  heads: Channel<string> = channel<string>(64);
  inner: Channel<string> = channel<string>(64);
  origin: number = 0;
  plain: number = 0;
  proxy: string = "";
  listener: TcpListener | null = null;
  server: HttpServer | null = null;
  plainServer: HttpServer | null = null;

  /** Ends the servers. */
  close() {
    this.listener?.close();
    this.server?.close();
    this.plainServer?.close();
  }
}

async function answer(req: Request): Promise<Response> {
  const url = new URL(req.url);
  const auth = req.headers.get("authorization") ?? "-";
  return new Response(
    `origin ${req.method} ${url.pathname}${url.search} ${auth} ${await req.text()}`,
  );
}

/** The origins and the proxy; with `tls`, an `https://` proxy (the test certificate's). */
async function setup(tls: bool = false): Promise<Setup> {
  const s = new Setup();
  const server = await serve({ port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } }, answer);
  s.server = server;
  s.origin = server.port as number;
  const plainServer = await serve({ port: 0 }, answer);
  s.plainServer = plainServer;
  s.plain = plainServer.port as number;
  const listener =
    tls
      ? await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY })
      : await listen("127.0.0.1:0");
  s.listener = listener;
  s.proxy =
    tls
      ? `https://al%40ice:pw@localhost:${listener.port}`
      : `http://al%40ice:pw@127.0.0.1:${listener.port}`;
  proxyAll(listener, s.heads, s.inner);
  return s;
}

describe("fetch through a proxy", () => {
  it("tunnels https: with CONNECT, TLS to the origin inside", async () => {
    const s = await setup();
    const url = `https://localhost:${s.origin}/hello`;
    expect(await outcome(url, { ca: TEST_CA, proxy: s.proxy })).toBe("200 origin GET /hello - ");
    const head = s.heads.tryReceive() ?? "";
    expect(
      head.startsWith(`CONNECT localhost:${s.origin} HTTP/1.1\r\nhost: localhost:${s.origin}\r\n`),
    ).toBe(true);
    // base64("al@ice:pw")
    expect(head.includes("\r\nproxy-authorization: Basic YWxAaWNlOnB3\r\n")).toBe(true);
    const posted = await outcome(url, { method: "POST", body: "x", ca: TEST_CA, proxy: s.proxy });
    expect(posted).toBe("200 origin POST /hello - x");
    s.close();
  });

  it(
    "tunnels http: with CONNECT too, as Node, and the proxy never sees the URL's password",
    async () => {
      const s = await setup();
      const url = `http://bob:TARGETPW@localhost:${s.plain}/a/b?c=d`;
      const got = await outcome(url, { headers: { "x-a": "1" }, proxy: s.proxy });
      // Nor does the origin, as without a proxy (Node refuses such a URL).
      expect(got).toBe("200 origin GET /a/b?c=d - ");
      const head = s.heads.tryReceive() ?? "";
      expect(head.startsWith(`CONNECT localhost:${s.plain} HTTP/1.1\r\n`)).toBe(true);
      expect(head.includes("\r\nproxy-authorization: Basic YWxAaWNlOnB3\r\n")).toBe(true);
      expect(head.includes("TARGETPW") || head.includes("bob")).toBe(false);
      // The request inside the tunnel names the path alone.
      const request = s.inner.tryReceive() ?? "";
      expect(request.startsWith("GET /a/b?c=d HTTP/1.1\r\n")).toBe(true);
      expect(request.includes("TARGETPW")).toBe(false);
      expect(request.includes("\r\nx-a: 1\r\n")).toBe(true);
      expect(request.toLowerCase().includes("proxy-authorization")).toBe(false);
      s.close();
    },
  );

  it("fails when the proxy refuses the tunnel or is not there", async () => {
    const s = await setup();
    const at = s.proxy.slice(s.proxy.indexOf("@") + 1);
    expect(await outcome("https://refused.invalid/", { proxy: s.proxy })).toBe(
      `ECONNREFUSED fetch failed: proxy ${at} refused the tunnel to refused.invalid:443: HTTP/1.1 407 Proxy Authentication Required`,
    );
    expect(await outcome("http://refused.invalid/", { proxy: s.proxy })).toBe(
      `ECONNREFUSED fetch failed: proxy ${at} refused the tunnel to refused.invalid:80: HTTP/1.1 407 Proxy Authentication Required`,
    );
    s.close();
    const gone = await outcome("https://refused.invalid/", { proxy: "http://127.0.0.1:1" });
    expect(gone.startsWith("ECONNREFUSED fetch failed: ")).toBe(true);
    expect(gone.endsWith("(connecting to proxy 127.0.0.1:1)")).toBe(true);
    expect(
      (await outcome("https://x.invalid/", { proxy: "socks5://127.0.0.1:1" })).startsWith(
        "EINVAL fetch failed: invalid proxy in the proxy option: `socks5://` proxies are not supported",
      ),
    ).toBe(true);
  });

  it("takes the environment's proxy by default, for this machine too", async () => {
    const s = await setup();
    setEnv("http_proxy", s.proxy);
    setEnv("https_proxy", s.proxy);
    removeEnv("no_proxy");
    removeEnv("NO_PROXY");
    const plain = await outcome("http://origin.invalid/env", {});
    const tunneled = await outcome(`https://localhost:${s.origin}/env`, { ca: TEST_CA });
    setEnv("NO_PROXY", "127.0.0.1");
    // NO_PROXY's host is reached directly: the proxy would refuse a tunnel to 127.0.0.1.
    const direct = await outcome(`https://127.0.0.1:${s.origin}/direct`, { ca: TEST_CA });
    removeEnv("http_proxy");
    removeEnv("https_proxy");
    removeEnv("NO_PROXY");
    expect(plain.includes("refused the tunnel to origin.invalid:80")).toBe(true);
    expect(tunneled).toBe("200 origin GET /env - ");
    expect(direct).toBe("200 origin GET /direct - ");
    expect((s.heads.tryReceive() ?? "").startsWith("CONNECT origin.invalid:80 ")).toBe(true);
    expect((s.heads.tryReceive() ?? "").startsWith(`CONNECT localhost:${s.origin} `)).toBe(true);
    expect(s.heads.tryReceive() ?? "none").toBe("none");
    s.close();
  });

  it("speaks TLS to an https:// proxy, for https: (TLS within TLS) and http:", async () => {
    const s = await setup(true);
    const port = s.listener?.port ?? 0;
    const secure = await outcome(`https://localhost:${s.origin}/tls`, {
      ca: TEST_CA,
      proxy: s.proxy,
    });
    const plain = await outcome(`http://localhost:${s.plain}/p`, { ca: TEST_CA, proxy: s.proxy });
    expect(secure).toBe("200 origin GET /tls - ");
    expect(plain).toBe("200 origin GET /p - ");
    const first = s.heads.tryReceive() ?? "";
    expect(first.startsWith(`CONNECT localhost:${s.origin} `)).toBe(true);
    // base64("al@ice:pw")
    expect(first.includes("proxy-authorization: Basic YWxAaWNlOnB3")).toBe(true);
    expect((s.heads.tryReceive() ?? "").startsWith(`CONNECT localhost:${s.plain} `)).toBe(true);
    // The proxy's certificate is checked as an origin's: without the test CA it is not trusted.
    const untrusted = await outcome(`http://localhost:${s.plain}/u`, { proxy: s.proxy });
    expect(untrusted.endsWith(`(connecting to proxy localhost:${port})`)).toBe(true);
    // A fetch of an `http:` literal that follows no redirect has no TLS client (fetch.velt).
    let plainOnly = "";
    try {
      await fetch("http://localhost:1/none", { redirect: "manual", proxy: s.proxy });
    } catch (e) {
      plainOnly = e instanceof IoError ? `${e.code} ${e.message}` : e.message;
    }
    expect(plainOnly.startsWith(`ENOTSUP fetch failed: the https:// proxy localhost:${port}`)).toBe(
      true,
    );
    expect(s.heads.tryReceive() ?? "none").toBe("none");
    s.close();
  });

  it(
    "goes directly when the environment's proxy is socks5://, which it does not speak",
    async () => {
      const s = await setup();
      for (const name of ["HTTP_PROXY", "all_proxy", "ALL_PROXY", "no_proxy", "NO_PROXY"]) {
        removeEnv(name);
      }
      setEnv("http_proxy", "socks5://127.0.0.1:1");
      const got = await outcome(`http://localhost:${s.plain}/direct`, {});
      removeEnv("http_proxy");
      expect(got).toBe("200 origin GET /direct - ");
      expect(s.heads.tryReceive() ?? "none").toBe("none");
      s.close();
    },
  );
});
