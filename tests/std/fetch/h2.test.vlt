// `fetch` over HTTP/2: ALPN "h2" on https, one connection shared by concurrent requests
// (multiplexing), bodies both ways larger than the windows, redirects, compressed bodies, an
// abort, and HTTP/1.1 for a server that does not offer HTTP/2.
import { HttpRequest, HttpResponse, serveHttp } from "http-server";
import { AbortController, timeout } from "velt/task";
import { describe, expect, it } from "velt/test";
import { delay } from "velt/time";
import { TEST_CA, TEST_CERT, TEST_KEY } from "../../golden/std/_tls";

async function handler(req: HttpRequest, res: HttpResponse) {
  if (req.pathIs("/echo")) {
    const body = await req.body();
    res.header("x-proto", req.header(":path") == null ? "h2" : "?");
    res.send(`got ${body.length} ${req.method()}`);
  } else if (req.pathIs("/big")) {
    res.sendBytes(new Array<u8>(3000000).fill(120));
  } else if (req.pathIs("/redirect")) {
    res.status(302);
    res.header("location", "/echo");
    res.send("");
  } else if (req.pathIs("/gzip")) {
    res.header("content-encoding", "gzip");
    // gzip of "compressed over h2".
    const z: u8[] = [
      31,
      139,
      8,
      0,
      0,
      0,
      0,
      0,
      2,
      255,
      75,
      206,
      207,
      45,
      40,
      74,
      45,
      46,
      78,
      77,
      81,
      200,
      47,
      75,
      45,
      82,
      200,
      48,
      2,
      0,
      122,
      27,
      71,
      103,
      18,
      0,
      0,
      0,
    ];
    res.sendBytes(z);
  } else if (req.pathIs("/slow")) {
    const s = await res.stream();
    await s.write("a");
    await delay(2000);
    await s.end();
  } else {
    res.header("x-path", req.path());
    res.send(`hello ${req.method()} ${req.path()} ${req.header("host")}`);
  }
}

describe("fetch over HTTP/2", () => {
  it("speaks HTTP/2 with a server that offers it, bodies both ways", async () => {
    const server = await serveHttp({ port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } }, handler);
    try {
      const base = `https://localhost:${server.port}`;
      const r = await fetch(`${base}/a?b=1`, { ca: TEST_CA });
      expect(r.status).toBe(200);
      expect(r.headers.get("x-path")).toBe("/a");
      expect(await r.text()).toBe(`hello GET /a localhost:${server.port}`);
      const up = "y".repeat(2500000);
      const p = await fetch(`${base}/echo`, { method: "POST", body: up, ca: TEST_CA });
      expect(await p.text()).toBe("got 2500000 POST");
      // More than the stream window (1 MiB): reading gives the window back, or it stalls.
      const big = await fetch(`${base}/big`, { ca: TEST_CA });
      expect((await timeout(big.bytes(), 10000)).length).toBe(3000000);
      const red = await fetch(`${base}/redirect`, { ca: TEST_CA });
      expect(red.redirected).toBe(true);
      expect(await red.text()).toBe("got 0 GET");
      const z = await fetch(`${base}/gzip`, { ca: TEST_CA });
      expect(await z.text()).toBe("compressed over h2");
    } finally {
      server.close();
    }
  });

  it("shares one connection among concurrent requests", async () => {
    // Every response names the client's address: one connection, one client port.
    const server = await serveHttp({ port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } }, async (
      req: HttpRequest,
      res: HttpResponse,
    ) => {
      await delay(20);
      res.send(`${req.path()} ${req.remoteAddr()}`);
    });
    try {
      const all: Promise<string>[] = [];
      for (let i = 0; i < 50; i++) {
        all.push(
          fetch(`https://localhost:${server.port}/n${i}`, { ca: TEST_CA }).then((r) => r.text()),
        );
      }
      const texts = await Promise.all(all);
      expect(texts[49].startsWith("/n49 ")).toBe(true);
      const clients = new Set<string>();
      for (const t of texts) {
        clients.add(t.slice(t.indexOf(" ") + 1));
      }
      expect(clients.size).toBe(1);
    } finally {
      server.close();
    }
  });

  it("aborts a request in flight", async () => {
    const server = await serveHttp({ port: 0, tls: { cert: TEST_CERT, key: TEST_KEY } }, handler);
    try {
      const ac = new AbortController();
      const r = await fetch(`https://localhost:${server.port}/slow`, {
        ca: TEST_CA,
        signal: ac.signal,
      });
      ac.abort();
      let err = "";
      try {
        await r.text();
      } catch (e) {
        err = `${e}`;
      }
      expect(err.includes("aborted")).toBe(true);
    } finally {
      server.close();
    }
  });

  it("uses HTTP/1.1 with a server that does not offer HTTP/2", async () => {
    const server = await serveHttp(
      { port: 0, http2: false, tls: { cert: TEST_CERT, key: TEST_KEY } },
      handler,
    );
    try {
      for (let i = 0; i < 3; i++) {
        const r = await fetch(`https://localhost:${server.port}/x${i}`, { ca: TEST_CA });
        expect(await r.text()).toBe(`hello GET /x${i} localhost:${server.port}`);
      }
    } finally {
      server.close();
    }
  });
});
