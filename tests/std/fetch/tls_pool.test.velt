// `fetch`'s keep-alive pool for `https:` connections (the TLS client in Velt on the reactor):
// sequential requests to one origin share a connection, and an idle one the server closed is
// noticed and replaced rather than written to (a POST, which is never retried, shows it).
import { describe, expect, it } from "velt/test";
import { listenTls, TcpListener, TcpStream } from "velt/net";
import { TEST_CA, TEST_CERT, TEST_KEY } from "../../golden/std/_tls";

// Answers each request on `c` with "ok" until the client closes; with `once`, answers one and then
// closes the connection itself (with close_notify).
async function answer(c: TcpStream, once: bool) {
  let buf = "";
  while (true) {
    const t = await c.readString();
    if (t == "") {
      break;
    }
    buf += t;
    while (buf.indexOf("\r\n\r\n") >= 0) {
      buf = buf.slice(buf.indexOf("\r\n\r\n") + 4);
      await c.write("HTTP/1.1 200 OK\r\ncontent-length: 2\r\nconnection: keep-alive\r\n\r\nok");
      if (once) {
        c.shutdown();
        c.close();
        return;
      }
    }
  }
  c.close();
}

// Accepts `n` connections on `server`, answering each; resolves to how many there were.
async function accept(server: TcpListener, n: i64): Promise<i64> {
  for (let i = 0; i < n; i++) {
    const c = await server.accept();
    spawn(answer(c, false));
  }
  return n;
}

describe("fetch over https: the keep-alive pool", () => {
  it("sends sequential requests to one origin over one connection", async () => {
    const server = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    const accepting = spawn(accept(server, 1));
    let body = "";
    for (let i = 0; i < 4; i++) {
      const r = await fetch(`https://localhost:${server.port}/${i}`, { ca: TEST_CA });
      body += await r.text();
    }
    expect(body).toBe("okokokok");
    expect(await accepting).toBe(1);
    server.close();
  });

  it("dials again when the server closed the idle connection", async () => {
    const server = await listenTls("127.0.0.1:0", { cert: TEST_CERT, key: TEST_KEY });
    // The first connection answers once and is closed by the server; the test goes on once it is.
    const first = spawn(
      (async () => {
        await answer(await server.accept(), true);
      })(),
    );
    const a = await (await fetch(`https://localhost:${server.port}/a`, { ca: TEST_CA })).text();
    await first;
    // timing: the pool gives a POST only a connection idle for at least 5 ms (fd_pool.velt's
    // `SETTLED_NS`), so the closed one is offered to it.
    await sleep(20);
    const accepting = spawn(accept(server, 1));
    // A POST, which `fetch` never sends twice: it must not go to the closed connection.
    const b = await (await fetch(`https://localhost:${server.port}/b`, {
      ca: TEST_CA,
      method: "POST",
      body: "x",
    })).text();
    expect([a, b]).toEqual(["ok", "ok"]);
    expect(await accepting).toBe(1);
    server.close();
  });
});
