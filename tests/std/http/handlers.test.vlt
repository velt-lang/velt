// velt/http request handlers: one that throws, sync handlers, what a handler captures and how
// each request gets its own copy, module state shared by every request, and the handlers of
// velt/http/server.
import { serve, Server, ServeInfo } from "velt/http";
import { HttpRequest, HttpResponse, serve as serveRaw } from "velt/http/server";
import { IoError } from "velt/io";
import { connect } from "velt/net";
import { AbortError } from "velt/task";
import { afterAll, beforeAll, describe, expect, it } from "velt/test";

class NotAllowed extends Error {}

async function get(port: number, path: string): Promise<string> {
  const r = await fetch(`http://127.0.0.1:${port}${path}`);
  return `${r.status} ${await r.text()}`;
}

async function text(url: string): Promise<string> {
  return await (await fetch(url)).text();
}

describe("a handler that throws", () => {
  // A request handler that throws (its promise rejects) gets a 500 response; the error is
  // printed to stderr and the server keeps serving. (Was the golden std/http_handler_error.)
  let port = 0;
  let close = () => {};
  beforeAll(async () => {
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const path = new URL(req.url).pathname;
      if (path == "/admin") {
        throw new NotAllowed("admins only");
      }
      return new Response(`hello ${path}`);
    });
    port = server.port;
    close = () => server.close();
  });
  afterAll(() => close());

  it("gets a 500 response", async () => {
    expect(await get(port, "/admin")).toBe("500 Internal Server Error");
  });

  it("leaves the server serving", async () => {
    expect(await get(port, "/home")).toBe("200 hello /home");
  });
});

function hello(req: Request): Response {
  return new Response(`named ${new URL(req.url).pathname}`);
}

async function respond(t: string): Promise<Response> {
  return new Response(t);
}

async function respondThrows(path: string): Promise<Response> {
  if (path == "/admin") {
    throw new NotAllowed("admins only");
  }
  return new Response(`checked ${path}`);
}

function prefixed(prefix: string): (req: Request) => Response {
  return (req: Request): Response => new Response(`${prefix} ${req.method}`);
}

// A wrapper of `serve` with `serve`'s own handler type passes the handler on.
async function startWith<E>(
  h: (req: Request, info: ServeInfo) => Response | Promise<Response, E> throws E,
): Promise<Server> {
  return await serve({ port: 0 }, h);
}

describe("a sync handler", () => {
  // A handler may return a `Response` directly, as in Deno and Bun: a sync arrow, a named
  // function, a function value, or one a call returns. A sync arrow may declare its result
  // (`Response`, or the promise it returns) and may return a promise of a function that throws.
  // An async handler that throws still gets a 500. (Was the golden std/http_sync_handler.)
  it("a sync arrow", async () => {
    const s = await serve({ port: 0 }, (req) => new Response(`sync ${new URL(req.url).pathname}`));
    try {
      expect(await get(s.port, "/x")).toBe("200 sync /x");
    } finally {
      await s.shutdown();
    }
  });

  it("a named function", async () => {
    const s = await serve({ port: 0 }, hello);
    try {
      expect(await get(s.port, "/y")).toBe("200 named /y");
    } finally {
      await s.shutdown();
    }
  });

  it("a function value", async () => {
    const local = (req: Request): Response => new Response(`local ${req.method}`);
    const s = await serve({ port: 0 }, local);
    try {
      expect(await get(s.port, "/z")).toBe("200 local GET");
    } finally {
      await s.shutdown();
    }
  });

  it("an async handler that throws still gets a 500", async () => {
    const s = await serve({ port: 0 }, async (req) => {
      if (new URL(req.url).pathname == "/admin") {
        throw new NotAllowed("admins only");
      }
      return new Response("async ok");
    });
    try {
      expect(await get(s.port, "/home")).toBe("200 async ok");
      expect(await get(s.port, "/admin")).toBe("500 Internal Server Error");
    } finally {
      await s.shutdown();
    }
  });

  it("a sync arrow that declares Response", async () => {
    const s = await serve({ port: 0 }, (req): Response => new Response("declared"));
    try {
      expect(await get(s.port, "/")).toBe("200 declared");
    } finally {
      await s.shutdown();
    }
  });

  it("a sync arrow that declares the promise it returns", async () => {
    const s = await serve({ port: 0 }, (req: Request): Promise<Response> => respond("promise"));
    try {
      expect(await get(s.port, "/")).toBe("200 promise");
    } finally {
      await s.shutdown();
    }
  });

  it("a sync arrow returning the promise of a function that throws", async () => {
    const s = await serve({ port: 0 }, (req) => respondThrows(new URL(req.url).pathname));
    try {
      expect(await get(s.port, "/page")).toBe("200 checked /page");
      expect(await get(s.port, "/admin")).toBe("500 Internal Server Error");
    } finally {
      await s.shutdown();
    }
  });

  it("one a call returns", async () => {
    const s = await serve({ port: 0 }, prefixed("made"));
    try {
      expect(await get(s.port, "/")).toBe("200 made GET");
    } finally {
      await s.shutdown();
    }
  });

  it("passed on by a wrapper with serve's handler type", async () => {
    const s = await startWith((req, info) => new Response("wrapped"));
    try {
      expect(await get(s.port, "/")).toBe("200 wrapped");
    } finally {
      await s.shutdown();
    }
  });
});

// Counts its live instances in `live`, and the original's release in `originals`.
class Store {
  name: string;
  live: shared<i64>;
  originals: shared<i64>;

  constructor(name: string, live: shared<i64>, originals: shared<i64>) {
    this.name = name;
    this.live = live;
    this.originals = originals;
    live.add(1);
  }

  clone(): Store {
    return new Store("copy", this.live.clone(), this.originals.clone());
  }

  [Symbol.dispose]() {
    this.live.add(-1);
    if (this.name == "store") {
      this.originals.add(1);
    }
  }
}

async function client(base: string, n: i64): Promise<i64> {
  let ok: i64 = 0;
  for (let i = 0; i < n; i++) {
    if ((await text(`${base}/x`)) == "copy") {
      ok += 1;
    }
  }
  return ok;
}

// 8 clients at once, 50 requests each: the number of responses that were "copy".
async function load(port: number): Promise<i64> {
  const base = `http://127.0.0.1:${port}`;
  const ts: Promise<i64>[] = [];
  for (let i = 0; i < 8; i++) {
    ts.push(spawn(client(base, 50)));
  }
  let sum: i64 = 0;
  for (const x of await Promise.all(ts)) {
    sum += x;
  }
  return sum;
}

describe("a resource a handler captures", () => {
  // An HTTP handler runs concurrently on several threads, so each request's call of it gets its
  // own copy of what it captured: a resource is copied by its `clone()` and each copy released
  // once (a resource without `clone()` is a compile error: errors/http_handler_captures_resource).
  // The original is released when the server shuts down. (Was the golden
  // std/http_handler_clones_resource.)
  it(
    "is copied for each request of an async handler, the original released at shutdown",
    async () => {
      const live = shared<i64>(0);
      const originals = shared<i64>(0);
      const store = new Store("store", live.clone(), originals.clone());
      const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
        await sleep(1);
        return new Response(store.name);
      });
      try {
        expect(await load(server.port)).toBe(400);
        expect(originals.get()).toBe(0);
      } finally {
        await server.shutdown();
      }
      expect(originals.get()).toBe(1);
      expect(live.get()).toBe(0);
    },
  );

  // A sync HTTP handler (checked as an async one) does the same. (Was the golden
  // std/http_sync_handler_clones_resource.)
  it(
    "is copied for each request of a sync handler, the original released at shutdown",
    async () => {
      const live = shared<i64>(0);
      const originals = shared<i64>(0);
      const store = new Store("store", live.clone(), originals.clone());
      const server = await serve({ port: 0 }, (req) => new Response(store.name));
      try {
        expect(await load(server.port)).toBe(400);
        expect(originals.get()).toBe(0);
      } finally {
        await server.shutdown();
      }
      expect(originals.get()).toBe(1);
      expect(live.get()).toBe(0);
    },
  );
});

class Input {
  onChange: (v: string) => void = (v) => {};
}

class Widget {
  name = "w";
}

class Emitter {
  listeners: ((name: string) => void)[] = [];
  on(f: (name: string) => void) {
    this.listeners.push(f);
  }
  emit(name: string) {
    for (const l of this.listeners) {
      l(name);
    }
  }
}

class Pool {
  conns: string[] = ["a", "b"];
  pick(i: number): string {
    return this.conns[i % 2];
  }
}

describe("callbacks a handler reaches", () => {
  // What an HTTP handler reaches is only an error when a callback it reaches assigns a variable
  // that callback captured (#873): callbacks that only read, a render function, a pool, an object
  // whose callbacks assign nothing, and closures each request makes for itself all compile and
  // run. (Was the golden std/http_handler_callbacks_unaffected.)
  it("compile and run when they assign nothing they captured", async () => {
    const prefix = "p";
    const i = new Input();
    i.onChange = (v: string) => {
      if (`${prefix}${v}`.length > 100) {
        console.log("long");
      }
    };
    const w = new Widget();
    const render = (s: string): string => `<b>${s}</b>`;
    const pool = new Pool();
    const hits = shared(0);
    const routes = new Map<string, () => string>();
    routes.set("/", () => "home");
    const requests = new Emitter();
    requests.on((name: string) => {
      if (routes.size > 5) {
        console.log(name);
      }
    });
    const a = await serve({ port: 0 }, async (req) => {
      requests.emit("request");
      const r = routes.get("/");
      let mine = 0;
      const bump = () => {
        mine += 1;
      };
      bump();
      i.onChange("x");
      hits.add(1);
      return new Response(render(`${pool.pick(mine)}${r === undefined ? "" : r()}${w.name}`));
    });
    try {
      for (let k = 0; k < 3; k++) {
        expect(await text(`http://127.0.0.1:${a.port}/`)).toBe("<b>bhomew</b>");
      }
    } finally {
      await a.shutdown();
    }
    expect(hits.get()).toBe(3);
  });

  // An async handler calls a sync callback stored in a field of an object it captured, and the
  // callback changes state it shares with every request through `shared(new Mutex(...))`, the
  // fix the compiler proposes for a callback that assigns a captured variable (#873). Requests
  // run at the same time and take turns on the lock; the result matches Node's. (Was the golden
  // std/http_stored_callback_shared.)
  it("share state through a Mutex with every request", async () => {
    const last = shared(new Mutex({ value: "" }));
    const i = new Input();
    i.onChange = (v: string) => {
      last.with((s) => {
        s.value = `${v}${s.value.length}`;
      });
    };
    const a = await serve({ port: 0 }, async (req) => {
      i.onChange("x");
      return new Response("ok");
    });
    let n: i64 = 0;
    try {
      const ts: Promise<i64>[] = [];
      for (let k = 0; k < 8; k++) {
        ts.push(spawn(okCount(`http://127.0.0.1:${a.port}`, 40)));
      }
      for (const x of await Promise.all(ts)) {
        n += x;
      }
    } finally {
      await a.shutdown();
    }
    expect(n).toBe(320);
    expect(last.with((s) => s.value.length)).toBe(2);
  });
});

// The number of `n` requests that got a non-empty body.
async function okCount(base: string, n: i64): Promise<i64> {
  let ok: i64 = 0;
  for (let i = 0; i < n; i++) {
    const t = await text(`${base}/x`);
    ok += t.length > 0 ? 1 : 0;
  }
  return ok;
}

let hits = 0;
const byPath = new Map<string, number>();

async function burst(base: string, from: number): Promise<number> {
  let ok = 0;
  for (let i = 0; i < 10; i++) {
    const body = await text(`${base}/p${(from + i) % 3}`);
    if (body.startsWith("hit ")) {
      ok++;
    }
  }
  return ok;
}

describe("module state", () => {
  // One module state per process (#76): every request handler (a task of its own, on any core)
  // counts into the same module counter and Map, as a Node server does. (Was the golden
  // std/http_module_state.)
  it("is shared by every request handler", async () => {
    // The handler is an arrow in the test, which assigns the file's `hits` and changes its
    // `byPath`: module state, as in Node (#1872).
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const path = new URL(req.url).pathname;
      hits++;
      const n = hits;
      byPath.set(path, (byPath.get(path) ?? 0) + 1);
      await sleep(0);
      return new Response(`hit ${n}`);
    });
    let ok = 0;
    try {
      const base = `http://127.0.0.1:${server.port}`;
      const clients: Promise<number, AbortError | IoError>[] = [];
      for (let c = 0; c < 8; c++) {
        clients.push(spawn(burst(base, c)));
      }
      for (const n of await Promise.all(clients)) {
        ok += n;
      }
    } finally {
      await server.shutdown();
    }
    expect(ok).toBe(80);
    expect(hits).toBe(80);
    expect(byPath.get("/p0")).toBe(27);
    expect(byPath.get("/p1")).toBe(27);
    expect(byPath.get("/p2")).toBe(26);
  });
});

// Sends `raw` on a connection of its own and reads the answer until the server closes.
async function exchange(port: number, raw: string): Promise<string> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.write(raw);
  c.shutdown();
  let all = "";
  while (true) {
    const chunk = await c.readString();
    if (chunk == "") {
      break;
    }
    all += chunk;
  }
  c.close();
  // The Date header changes every second.
  return all.replace(/Date: [^\r]*\r\n/g, "");
}

function statusLines(t: string): string {
  return (t.match(/HTTP\/1\.1 \d\d\d [A-Za-z ]+/g) ?? []).join(" | ");
}

describe("velt/http/server", () => {
  // Requests parsed in place, responses written per batch. Routes, the method, path, query,
  // headers and body of a request, response headers and types, pipelined requests answered in
  // order, a request that arrives in pieces, HTTP/1.0 and Connection: close, and input that is
  // not a request (400, 431), a body over the limit (413). (Was the golden std/http_server; its
  // handler that throws, whose error goes to stderr, stays there.)
  let port = 0;
  let base = "";
  let close = () => {};
  beforeAll(async () => {
    const server = await serveRaw({ port: 0, maxBodySize: 64 }, async (
      req: HttpRequest,
      res: HttpResponse,
    ) => {
      if (req.pathIs("/hello")) {
        res.send("hello");
      } else if (req.pathIs("/info")) {
        res.header("X-Seen", req.header("x-test") ?? "none");
        res.json(
          JSON.stringify({
            method: req.method(),
            path: req.path(),
            query: req.query(),
            hasAuth: req.hasHeader("authorization"),
            post: req.isMethod("POST"),
          }),
        );
      } else if (req.pathIs("/echo")) {
        res.header("Content-Type", "text/x-echo");
        const body = await req.body();
        res.sendBytes(body);
      } else if (req.pathIs("/quiet")) {
        // Nothing sent: an empty 200.
      } else {
        res.status(404);
        res.send(`no ${req.target()}`);
      }
    });
    port = server.port;
    base = `http://127.0.0.1:${server.port}`;
    close = () => server.close();
  });
  afterAll(() => close());

  it("sends text with its type and the server header", async () => {
    const r = await fetch(`${base}/hello`);
    expect(r.status).toBe(200);
    expect(r.headers.get("content-type")).toBe("text/plain; charset=utf-8");
    expect(r.headers.get("server")).toBe("Velt");
    expect(await r.text()).toBe("hello");
  });

  it("reads the method, path, query and headers of a request", async () => {
    const r = await fetch(`${base}/info?a=1&b=2`, {
      method: "POST",
      headers: { "X-Test": "yes" },
      body: "x",
    });
    expect(r.status).toBe(200);
    expect(r.headers.get("x-seen")).toBe("yes");
    expect(await r.text()).toBe(
      "{\"method\":\"POST\",\"path\":\"/info\",\"query\":\"a=1&b=2\",\"hasAuth\":false,\"post\":true}",
    );
  });

  it("echoes a body with the type it set", async () => {
    const r = await fetch(`${base}/echo`, { method: "PUT", body: "some body" });
    expect(r.headers.get("content-type")).toBe("text/x-echo");
    expect(r.headers.get("content-length")).toBe("9");
    expect(await r.text()).toBe("some body");
  });

  it("sets a status", async () => {
    expect(await get(port, "/nope?q")).toBe("404 no /nope?q");
  });

  it("answers an empty 200 when the handler sends nothing", async () => {
    const r = await fetch(`${base}/quiet`);
    expect(r.status).toBe(200);
    expect(await r.text()).toBe("");
  });

  it("answers pipelined requests in order", async () => {
    // Three requests in one write; the last closes.
    const piped = await exchange(
      port,
      "GET /hello HTTP/1.1\r\nHost: x\r\n\r\nGET /nope HTTP/1.1\r\nHost: x\r\n\r\nGET /hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
    );
    expect(statusLines(piped)).toBe("HTTP/1.1 200 OK | HTTP/1.1 404 Not Found | HTTP/1.1 200 OK");
    expect(piped.endsWith("hello")).toBe(true);
  });

  it("reads a request that arrives in pieces, the body after the head", async () => {
    const c = await connect(`127.0.0.1:${port}`);
    let got = "";
    try {
      const parts = [
        "POST /ec",
        "ho HTTP/1.1\r\nHost: x\r\nCont",
        "ent-Length: 5\r\n",
        "\r\nab",
        "cde",
      ];
      for (const p of parts) {
        await c.write(p);
        await sleep(5);
      }
      while (!got.endsWith("abcde")) {
        got += await c.readString();
      }
    } finally {
      c.close();
    }
    expect(statusLines(got)).toBe("HTTP/1.1 200 OK");
    expect(got.endsWith("abcde")).toBe(true);
  });

  it("closes after an HTTP/1.0 response", async () => {
    const old = await exchange(port, "GET /hello HTTP/1.0\r\n\r\n");
    expect(statusLines(old)).toBe("HTTP/1.1 200 OK");
    expect(old).toContain("Connection: close");
  });

  // Not requests: answered, then the connection closes.
  it("answers 400 to input that is not a request", async () => {
    expect(statusLines(await exchange(port, "NOT A REQUEST\r\n\r\n"))).toBe(
      "HTTP/1.1 400 Bad Request",
    );
  });

  it("answers 400 to a header without a colon", async () => {
    expect(
      statusLines(await exchange(port, "GET / HTTP/1.1\r\nHost: x\r\nNo colon here\r\n\r\n")),
    ).toBe("HTTP/1.1 400 Bad Request");
  });

  it("answers 413 to a body over the limit", async () => {
    const raw = "POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 100\r\n\r\n" + "b".repeat(100);
    expect(statusLines(await exchange(port, raw))).toBe("HTTP/1.1 413 Payload Too Large");
  });

  it("decodes a chunked body, skipping extensions and trailers", async () => {
    const chunked = await exchange(
      port,
      "POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n3;x=1\r\nabc\r\n4\r\ndefg\r\n0\r\nX-Trailer: t\r\n\r\n",
    );
    expect(statusLines(chunked)).toBe("HTTP/1.1 200 OK");
    expect(chunked.endsWith("abcdefg")).toBe(true);
  });

  it("answers 431 to a head over the limit", async () => {
    const longHead = "GET / HTTP/1.1\r\nHost: x\r\nX-Long: " + "a".repeat(70000) + "\r\n\r\n";
    expect(statusLines(await exchange(port, longHead))).toBe(
      "HTTP/1.1 431 Request Header Fields Too Large",
    );
  });
});
