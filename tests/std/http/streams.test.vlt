// Streamed bodies: a response written while the client reads it (velt:http's `BodyStream`, and
// velt:http/server's `res.stream()` and Server-Sent Events), and an upload read piece by piece.
import { channel } from "velt:channel";
import { utf8Encode } from "velt:encoding";
import { BodyStream } from "velt:fetch";
import { serve } from "velt:http";
import { HttpRequest, HttpResponse, serve as serveRaw } from "velt:http/server";
import { connect } from "velt:net";
import { afterAll, beforeAll, beforeEach, describe, expect, it } from "velt:test";
import "velt:test/http";

class RenderError extends Error {}

// The list, one chunk per item; each item's line is logged once it was sent (the next chunk is
// asked for once the client took the previous one).
async function* list(
  count: i64,
  broken: bool,
  log: Shared<Mutex<string[]>>,
): AsyncGenerator<u8[], RenderError> {
  yield utf8Encode("<ul>");
  for (let i: i64 = 1; i <= count; i++) {
    yield utf8Encode(`<li>${i}</li>`);
    log.with((l) => {
      l.push(`sent ${i}`);
    });
    await sleep(20);
  }
  if (broken) {
    throw new RenderError("template failed");
  }
  yield utf8Encode("</ul>");
}

describe("a BodyStream response", () => {
  // A streamed response (a `BodyStream` made from an async generator): the generator is read
  // after the handler returned, with awaited sleeps between chunks; the client gets the headers
  // that were set before returning, no content-length (chunked transfer), and every chunk in
  // order. A generator that throws cuts the response off, so the client sees a failed body, not
  // a complete one. (Was the golden std/http_stream.)
  const log = shared(new Mutex<string[]>([]));
  let base = "";
  let close = () => {};
  beforeAll(async () => {
    const seen = log.clone();
    const server = await serve({ port: 0 }, async (req: Request): Promise<Response> => {
      const url = new URL(req.url);
      const count = parseInt(url.search.slice(1)) as i64;
      const res = new Response(
        BodyStream.from(list(count, url.pathname == "/broken", seen.clone())),
      );
      res.headers.set("content-type", "text/html; charset=utf-8");
      res.headers.append("x-stream", "yes");
      seen.with((l) => {
        l.push("response returned");
      });
      return res;
    });
    base = `http://127.0.0.1:${server.port}`;
    close = () => server.close();
  });
  afterAll(() => close());
  beforeEach(() => {
    log.with((l) => {
      l.length = 0;
    });
  });

  it("keeps the headers set before returning, chunked", async () => {
    const r = await fetch(`${base}/list?3`);
    expect(r).toHaveStatus(200);
    expect(r).toHaveHeader("content-type", "text/html; charset=utf-8");
    expect(r).toHaveHeader("x-stream", "yes");
    expect(r).not.toHaveHeader("content-length");
    expect(r).toHaveHeader("transfer-encoding", "chunked");
    await r.text();
  });

  it("sends every chunk in order, after the handler returned", async () => {
    const r = await fetch(`${base}/list?3`);
    // `fetch` resolves with the headers, before the body is complete: once the body is read,
    // every chunk was sent.
    expect(await r.text()).toBe("<ul><li>1</li><li>2</li><li>3</li></ul>");
    expect(log.with((l) => l.slice())).toEqual(["response returned", "sent 1", "sent 2", "sent 3"]);
  });

  it("a generator that throws cuts the response off", async () => {
    async function read(): Promise<string> {
      const r = await fetch(`${base}/broken?1`);
      return await r.text();
    }
    await expect(read()).rejects.toThrow();
    expect(log.with((l) => l.slice())).toEqual(["response returned", "sent 1"]);
  });
});

// Sends `text`, half-closes, reads everything; without the `Date` header.
async function raw(port: number, text: string): Promise<string> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.write(text);
  c.shutdown();
  let all = "";
  while (true) {
    const chunk = await c.readString();
    if (chunk == "") {
      break;
    }
    all += chunk;
  }
  c.close();
  return all.replace(/Date: [^\r]*\r\n/g, "");
}

describe("velt:http/server streaming", () => {
  // velt:http/server streaming: a response written piece by piece (chunked; to an HTTP/1.0
  // client up to the connection's end), Server-Sent Events, a proxy piping an upstream body
  // through, an upload read piece by piece (chunked or Content-Length, 100 Continue), an unread
  // body skipped before the next request, and a client that goes away mid-stream (the write
  // throws and the request's signal aborts). (Was the golden std/http_server_stream.)
  // What the `/forever` handler saw when its client went away.
  const gone = channel<string>();
  let port = 0;
  let base = "";
  let close = () => {};
  beforeAll(async () => {
    const server = await serveRaw({ port: 0 }, async (req: HttpRequest, res: HttpResponse) => {
      if (req.pathIs("/count")) {
        const s = await res.stream();
        for (let i = 1; i <= 3; i++) {
          await s.write(`piece ${i}\n`);
        }
        await s.end();
      } else if (req.pathIs("/events")) {
        const events = await res.sse();
        await events.send("hello");
        await events.send("two\nlines", "update", "7");
        await events.comment("ping");
        await events.end();
      } else if (req.pathIs("/upload")) {
        let pieces = 0;
        let bytes = 0;
        let piece = await req.read();
        while (piece != null) {
          pieces++;
          bytes += piece.length;
          piece = await req.read();
        }
        res.send(`${bytes} bytes${pieces > 1 ? " in pieces" : ""}`);
      } else if (req.pathIs("/ignore")) {
        res.send("ignored the body");
      } else if (req.pathIs("/forever")) {
        const signal = res.signal();
        const s = await res.stream("application/octet-stream");
        const block: u8[] = Buffer.alloc(65536);
        try {
          while (true) {
            await s.write(block);
          }
        } catch (e) {
          gone.trySend(`write failed, signal aborted: ${signal.aborted}`);
        }
      } else if (req.pathIs("/proxy")) {
        const upstream = await fetch(`http://127.0.0.1:${req.query()}/count`);
        const s = await res.stream();
        for await (const chunk of upstream.body!) {
          await s.write(chunk);
        }
        // Left open: the server ends it.
      } else {
        res.status(404);
        res.send("no");
      }
    });
    port = server.port;
    base = `http://127.0.0.1:${port}`;
    close = () => server.close();
  });
  afterAll(() => {
    close();
    gone.close();
  });

  it("pieces arrive as they are written", async () => {
    const r = await fetch(`${base}/count`);
    expect(r).toHaveHeader("transfer-encoding", "chunked");
    expect(await r.text()).toBe("piece 1\npiece 2\npiece 3\n");
  });

  it("the wire format: chunk sizes, then a last empty chunk", async () => {
    const wire = await raw(port, "GET /count HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n");
    expect(wire.substring(wire.indexOf("\r\n\r\n") + 4)).toBe(
      "8\r\npiece 1\n\r\n8\r\npiece 2\n\r\n8\r\npiece 3\n\r\n0\r\n\r\n",
    );
  });

  it("Server-Sent Events", async () => {
    const r = await fetch(`${base}/events`);
    expect(r).toHaveHeader("content-type", "text/event-stream");
    expect(r).toHaveHeader("cache-control", "no-cache");
    expect(await r.text()).toBe(
      "data: hello\n\nevent: update\nid: 7\ndata: two\ndata: lines\n\n: ping\n\n",
    );
  });

  it("a proxy pipes an upstream body through without collecting it", async () => {
    const r = await fetch(`${base}/proxy?${port}`);
    expect(await r.text()).toBe("piece 1\npiece 2\npiece 3\n");
  });

  it("HTTP/1.0: no chunking, the body ends with the connection", async () => {
    const old = await raw(port, "GET /count HTTP/1.0\r\n\r\n");
    expect(old).not.toContain("Transfer-Encoding");
    expect(old).toContain("Connection: close");
    expect(old.endsWith("piece 3\n")).toBe(true);
  });

  it("a chunked upload is read in pieces", async () => {
    const c = await connect(`127.0.0.1:${port}`);
    await c.write("POST /upload HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n");
    for (let i = 0; i < 4; i++) {
      await c.write("8000\r\n" + "x".repeat(32768) + "\r\n");
      await sleep(5);
    }
    await c.write("0\r\n\r\n");
    let reply = "";
    while (!reply.includes("in pieces") && !reply.includes(" bytes")) {
      reply += await c.readString();
    }
    c.close();
    expect(reply.substring(reply.lastIndexOf("\r\n") + 2)).toBe("131072 bytes in pieces");
  });

  it("a Content-Length upload is read in pieces", async () => {
    const r = await fetch(`${base}/upload`, { method: "POST", body: "y".repeat(300000) });
    expect(await r.text()).toBe("300000 bytes in pieces");
  });

  it("Expect: 100-continue: the body is sent after the interim response", async () => {
    const e = await connect(`127.0.0.1:${port}`);
    await e.write(
      "POST /upload HTTP/1.1\r\nHost: x\r\nContent-Length: 5\r\nExpect: 100-continue\r\n\r\n",
    );
    let interim = "";
    while (!interim.includes("\r\n\r\n")) {
      interim += await e.readString();
    }
    await e.write("hello");
    let after = "";
    while (!after.endsWith("5 bytes")) {
      after += await e.readString();
    }
    e.close();
    expect(interim.split("\r\n")[0]).toBe("HTTP/1.1 100 Continue");
    expect(after.substring(after.lastIndexOf("\r\n") + 2)).toBe("5 bytes");
  });

  it("a body the handler does not read is skipped", async () => {
    // The next request on the connection works.
    const skipped = await raw(
      port,
      "POST /ignore HTTP/1.1\r\nHost: x\r\nContent-Length: 6\r\n\r\nunreadGET /count HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n",
    );
    expect(skipped).toContain("ignored the body");
    expect(skipped).toContain("piece 3");
  });

  it("a client that goes away mid-stream", async () => {
    const f = await connect(`127.0.0.1:${port}`);
    await f.write("GET /forever HTTP/1.1\r\nHost: x\r\n\r\n");
    await f.read();
    f.abort();
    f.close();
    // A hang guard, not a wait: the handler reports as soon as its write fails, and a closed
    // channel gives `null`.
    const guard = setTimeout(() => gone.close(), 60000);
    const state = await gone.receive();
    clearTimeout(guard);
    expect(state).toBe("write failed, signal aborted: true");
  });
});
