// velt/net/http's WebSocket handshake (`acceptWebSocket`, `res.upgrade`) and a client from
// velt/net/websocket talking to it.
import { utf8Encode } from "velt/encoding";
import { HttpRequest, HttpResponse, serveHttp } from "velt/net/http";
import { connect } from "velt/net";
import { afterAll, beforeAll, describe, expect, it } from "velt/test";
import "velt/test/http";
import { connectWebSocket } from "velt/net/websocket";
import { acceptWebSocket } from "velt/net/http";

// Sends `head` (and `extra` right after it, in the same write), half-closes, reads everything.
async function raw(port: number, head: string, extra: u8[] = []): Promise<string> {
  const c = await connect(`127.0.0.1:${port}`);
  await c.writeBytes(utf8Encode(head).concat(extra));
  c.shutdown();
  let all = "";
  while (true) {
    const chunk = await c.readString();
    if (chunk == "") {
      break;
    }
    all += chunk;
  }
  c.close();
  return all;
}

function handshake(method: string, version: string, key: string): string {
  return `${method} /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n` +
    `Sec-WebSocket-Version: ${version}\r\nSec-WebSocket-Key: ${key}\r\n\r\n`;
}

function firstLine(text: string): string {
  return text.split("\r\n")[0];
}

describe("a WebSocket on velt/net/http", () => {
  // velt/net/http switches a connection to WebSockets (`acceptWebSocket`, `res.upgrade`): a
  // client from `connectWebSocket` talks to it, an ordinary request on the same server is still
  // answered, and a request that is not an upgrade is refused. A handshake that is not valid
  // (version, key, method) is answered 426 or 400; a frame sent along with the upgrade request is
  // not lost. (Was the golden std/http_server_websocket.)
  const key = "dGhlIHNhbXBsZSBub25jZQ==";
  let port = 0;
  let close = () => {};
  beforeAll(async () => {
    const server = await serveHttp({ port: 0 }, async (req: HttpRequest, res: HttpResponse) => {
      if (req.pathIs("/ws")) {
        // Not a valid handshake: acceptWebSocket answered it (426 or 400).
        const ws = acceptWebSocket(req, res);
        if (ws == null) {
          return;
        }
        spawn(async () => {
          for await (const m of ws) {
            await ws.send(`echo ${m.text}`);
          }
          await ws.close();
        });
      } else {
        res.send("plain");
      }
    });
    port = server.port;
    close = () => server.close();
  });
  afterAll(() => close());

  it("a client from connectWebSocket talks to it", async () => {
    const ws = await connectWebSocket(`ws://127.0.0.1:${port}/ws`);
    await ws.send("one");
    await ws.send("two");
    const got: string[] = [];
    for await (const m of ws) {
      got.push(m.text);
      if (got.length == 2) {
        break;
      }
    }
    await ws.close();
    expect(got).toEqual(["echo one", "echo two"]);
  });

  it("an ordinary request on the same server is answered", async () => {
    const r = await fetch(`http://127.0.0.1:${port}/other`);
    expect(r).toHaveStatus(200);
    expect(await r.text()).toBe("plain");
  });

  it("a request that is not an upgrade is refused", async () => {
    const r = await fetch(`http://127.0.0.1:${port}/ws`);
    expect(r).toHaveStatus(426);
    expect(r).toHaveHeader("sec-websocket-version", "13");
    expect(await r.text()).toBe("a WebSocket handshake (version 13) is required");
  });

  it("another version is 426", async () => {
    const v99 = await raw(port, handshake("GET", "99", key));
    expect(firstLine(v99)).toBe("HTTP/1.1 426 Upgrade Required");
    expect(v99).toContain("Sec-WebSocket-Version: 13");
  });

  it("a key that is not valid is 400", async () => {
    expect(firstLine(await raw(port, handshake("GET", "13", "short==")))).toBe(
      "HTTP/1.1 400 Bad Request",
    );
  });

  it("a POST is 400", async () => {
    expect(firstLine(await raw(port, handshake("POST", "13", key)))).toBe(
      "HTTP/1.1 400 Bad Request",
    );
  });

  it("the Connection tokens of every Connection header count", async () => {
    const split = await raw(
      port,
      `GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: keep-alive\r\n` +
        `Connection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: ${key}\r\n\r\n`,
    );
    expect(firstLine(split)).toBe("HTTP/1.1 101 Switching Protocols");
  });

  it("a frame sent along with the upgrade request is not lost", async () => {
    // A masked text frame "hi" (mask 0) in the same write as the request: echoed.
    const frame: u8[] = [0x81, 0x82, 0, 0, 0, 0, 0x68, 0x69];
    const early = await raw(port, handshake("GET", "13", key), frame);
    expect(firstLine(early)).toBe("HTTP/1.1 101 Switching Protocols");
    expect(early).toContain("echo hi");
  });
});
