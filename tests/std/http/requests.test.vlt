// velt/http's requests as a handler sees them: url, method, headers, where it came from, and
// its body.
import { serve, ServeInfo } from "velt/http";
import { afterAll, beforeAll, describe, expect, it } from "velt/test";
import "velt/test/http";

describe("a handler's request", () => {
  // A handler's `Request` reads its properties from the runtime request on access: `url`,
  // `method`, `headers` (one name looked up, or all of them), an empty and a non-empty body; the
  // second argument says where the request came from. A constant response header (interned by
  // the runtime) and a varying one come back right on every response. (Was the golden
  // std/http_lazy_request.)
  let base = "";
  let close = () => {};
  beforeAll(async () => {
    const server = await serve({ port: 0 }, async (
      req: Request,
      info: ServeInfo,
    ): Promise<Response> => {
      const url = new URL(req.url);
      const accept = req.headers.get("X-Probe") ?? "none";
      const all = req.headers;
      const from = info.remoteAddr;
      const res = new Response(
        `${req.method} ${url.hostname} ${url.pathname} q=${url.search.slice(1)} probe=${accept} has=${all.has("x-probe")} from=${from.hostname} body=[${await req.text()}]`,
      );
      res.headers.append("server", "velt-golden");
      res.headers.append("x-path", url.pathname);
      return res;
    });
    base = `http://127.0.0.1:${server.port}`;
    close = () => server.close();
  });
  afterAll(() => close());

  function probe(): Headers {
    const h = new Headers();
    h.set("X-Probe", "yes");
    return h;
  }

  it("a GET with a query and a header", async () => {
    const r = await fetch(`${base}/a?x=1`, { headers: probe() });
    expect(r).toHaveHeader("server", "velt-golden");
    expect(r).toHaveHeader("x-path", "/a");
    expect(await r.text()).toBe("GET 127.0.0.1 /a q=x=1 probe=yes has=true from=127.0.0.1 body=[]");
  });

  it("the response headers are right on every response", async () => {
    for (const path of ["/b", "/c"]) {
      const r = await fetch(`${base}${path}`, { headers: probe() });
      expect(r).toHaveHeader("server", "velt-golden");
      expect(r).toHaveHeader("x-path", path);
      expect(await r.text()).toBe(
        `GET 127.0.0.1 ${path} q= probe=yes has=true from=127.0.0.1 body=[]`,
      );
    }
  });

  it("a POST with a body and without the header", async () => {
    const r = await fetch(`${base}/post`, { method: "POST", body: "payload" });
    expect(await r.text()).toBe(
      "POST 127.0.0.1 /post q= probe=none has=false from=127.0.0.1 body=[payload]",
    );
  });

  it("a POST with an empty body", async () => {
    const r = await fetch(`${base}/empty`, { method: "POST", body: "" });
    expect(await r.text()).toBe(
      "POST 127.0.0.1 /empty q= probe=none has=false from=127.0.0.1 body=[]",
    );
  });
});

type Item = { name: string; count: i64 };

async function handleBody(req: Request): Promise<Response> {
  const url = new URL(req.url);
  if (url.pathname == "/upload") {
    let chunks = 0;
    let bytes = 0;
    const body = req.body;
    if (body != null) {
      for await (const chunk of body) {
        chunks++;
        bytes += chunk.length as i64;
      }
    }
    return new Response(`${bytes} bytes in ${chunks > 1 ? "several chunks" : "one chunk"}`);
  }
  if (url.pathname == "/item") {
    const item = await req.json<Item>();
    return Response.json({ name: item.name.toUpperCase(), twice: item.count * 2 });
  }
  if (url.pathname == "/none") {
    return new Response(`body null: ${req.body == null}, used: ${req.bodyUsed}`);
  }
  if (url.pathname == "/proxy") {
    return await fetch(`${url.origin}/item`, { method: "POST", body: `{"name":"p","count":4}` });
  }
  const bad = new Response("x");
  bad.headers.set("bad name", "1");
  return bad;
}

describe("a request body", () => {
  // A handler receives the request body while it reads it: chunk by chunk from `req.body` (a
  // large upload is never held whole), or whole with `req.json<T>()`; a GET has no body. It may
  // return a response `fetch` gave it (a proxy: the body is passed on as it arrives). A response
  // with an invalid header name gets a 500, and the error is printed to stderr. (Was the golden
  // std/http_request_body.)
  let base = "";
  let close = () => {};
  beforeAll(async () => {
    const server = await serve({ port: 0 }, handleBody);
    base = `http://127.0.0.1:${server.port}`;
    close = () => server.close();
  });
  afterAll(() => close());

  it("a large upload arrives in several chunks", async () => {
    const big: u8[] = [];
    for (let i = 0; i < 300000; i++) {
      big.push(97);
    }
    const r = await fetch(`${base}/upload`, { method: "POST", body: big });
    expect(await r.text()).toBe("300000 bytes in several chunks");
  });

  it("a JSON body read whole", async () => {
    const r = await fetch(`${base}/item`, { method: "POST", body: `{"name":"ab","count":21}` });
    expect(r).toHaveHeader("content-type", "application/json");
    expect(await r.text()).toBe(`{"name":"AB","twice":42}`);
  });

  it("a GET has no body", async () => {
    const r = await fetch(`${base}/none`);
    expect(await r.text()).toBe("body null: true, used: false");
  });

  it("a fetched response passed on", async () => {
    const r = await fetch(`${base}/proxy`);
    expect(r).toHaveStatus(200);
    expect(r).toHaveHeader("content-type", "application/json");
    expect(await r.text()).toBe(`{"name":"P","twice":8}`);
  });

  it("an invalid header name is a 500", async () => {
    const r = await fetch(`${base}/bad`);
    expect(r).toHaveStatus(500);
    expect(await r.text()).toBe("Internal Server Error");
  });
});
