// HKDF-SHA256 (velt/crypto `hkdfSha256`, `hkdfExtractSha256`, `hkdfExpandSha256`): RFC 5869's
// test cases 1-3 and Project Wycheproof's valid cases.
import { hkdfExpandSha256, hkdfExtractSha256, hkdfSha256 } from "velt/crypto";
import { hexDecode, hexEncode } from "velt/encoding";
import { describe, expect, it } from "velt/test";
import { HKDF_SHA256_CASES } from "./wycheproof_hkdf_sha256";

function bytes(s: string): u8[] {
  return s == "-" ? [] : hexDecode(s);
}

describe("HKDF-SHA256", () => {
  it("matches RFC 5869 test case 1 (extract and expand separately)", () => {
    const prk = hkdfExtractSha256(
      hexDecode("000102030405060708090a0b0c"),
      hexDecode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b"),
    );
    expect(hexEncode(prk)).toBe("077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    expect(hexEncode(hkdfExpandSha256(prk, hexDecode("f0f1f2f3f4f5f6f7f8f9"), 42))).toBe(
      "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
    );
  });

  it("matches RFC 5869 test case 3 (empty salt and info)", () => {
    const ikm = hexDecode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b");
    expect(hexEncode(hkdfExtractSha256([], ikm))).toBe(
      "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04",
    );
    expect(hexEncode(hkdfSha256(ikm, [], [], 42))).toBe(
      "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8",
    );
  });

  it("matches every valid Wycheproof case", () => {
    let checked = 0;
    for (const line of HKDF_SHA256_CASES) {
      const f = line.split(" ");
      const okm = bytes(f[3]);
      expect(hexEncode(hkdfSha256(bytes(f[0]), bytes(f[1]), bytes(f[2]), okm.length))).toBe(f[3]);
      checked++;
    }
    expect(checked).toBe(102);
  });

  it("throws CryptoError past 255 blocks of output", () => {
    expect(() => hkdfExpandSha256(Buffer.alloc(32), [], 8161)).toThrow(
      "HKDF-SHA256 output is at most 8160 bytes, asked for 8161",
    );
  });
});
