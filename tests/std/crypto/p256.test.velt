// ECDH on P-256 (velt/crypto `p256Ecdh`, `p256PublicKey`, `p256PrivateKey`): RFC 5903 §8.1's
// example, every Project Wycheproof ecdh_secp256r1_ecpoint case, and the scalars refused.
import { CryptoError, p256Ecdh, p256PrivateKey, p256PublicKey } from "velt/crypto";
import { hexDecode, hexEncode } from "velt/encoding";
import { describe, expect, it } from "velt/test";
import { ECDH_P256_CASES } from "./wycheproof_ecdh_p256";

// "" when the agreement succeeds, else the CryptoError's message.
function refusal(scalar: string, point: string): string {
  try {
    p256Ecdh(hexDecode(scalar), hexDecode(point));
    return "";
  } catch (e) {
    return e instanceof CryptoError ? e.message : `not a CryptoError: ${e}`;
  }
}

describe("P-256", () => {
  it("matches RFC 5903 §8.1", () => {
    const i = hexDecode("c88f01f510d9ac3f70a292daa2316de544e9aab8afe84049c62a9c57862d1433");
    const r = hexDecode("c6ef9c5d78ae012a011164acb397ce2088685d8f06bf9be0b283ab46476bee53");
    const gi = p256PublicKey(i);
    const gr = p256PublicKey(r);
    expect(hexEncode(gi)).toBe(
      "04dad0b65394221cf9b051e1feca5787d098dfe637fc90b9ef945d0c3772581180" +
        "5271a0461cdb8252d61f1c456fa3e59ab1f45b33accf5f58389e0577b8990bb3",
    );
    expect(hexEncode(gr)).toBe(
      "04d12dfb5289c8d4f81208b70270398c342296970a0bccb74c736fc7554494bf63" +
        "56fbf3ca366cc23e8157854c13c58d6aac23f046ada30f8353e74f33039872ab",
    );
    const shared = "d6840f6b42f6edafd13116e0e12565202fef8e9ece7dce03812464d04b9442de";
    expect(hexEncode(p256Ecdh(i, gr))).toBe(shared);
    expect(hexEncode(p256Ecdh(r, gi))).toBe(shared);
  });

  it("matches every Wycheproof ecdh_secp256r1_ecpoint case", () => {
    let valid = 0;
    let invalid = 0;
    for (const line of ECDH_P256_CASES) {
      const f = line.split(" ");
      const why = refusal(f[2], f[3]);
      if (f[1] == "v") {
        expect(`${f[0]} ${why}`).toBe(`${f[0]} `);
        expect(`${f[0]} ${hexEncode(p256Ecdh(hexDecode(f[2]), hexDecode(f[3])))}`).toBe(
          `${f[0]} ${f[4]}`,
        );
        valid++;
      } else {
        // Invalid points, and compressed ones (acceptable, but TLS 1.3 sends uncompressed); one
        // case's encoding is not even whole bytes.
        if (f[3].length % 2 == 0) {
          expect(why).toContain("not an uncompressed point on the curve");
        }
        invalid++;
      }
    }
    expect(valid).toBe(330);
    expect(invalid).toBe(25);
  });

  it("generates keys that agree", () => {
    const a = p256PrivateKey();
    const b = p256PrivateKey();
    expect(a.length).toBe(32);
    expect(hexEncode(p256Ecdh(a, p256PublicKey(b)))).toBe(hexEncode(p256Ecdh(b, p256PublicKey(a))));
  });

  it("refuses a coordinate that is not below p", () => {
    // (5, y) is on the curve; written with x + p instead of x, it must be refused.
    const k = "0612465c89a023ab17855b0a6bcebfd3febb53aef84138647b5352e02c10c346";
    const y = "459243b9aa581806fe913bce99817ade11ca503c64d9a3c533415c083248fbcc";
    expect(refusal(k, "04" + "00".repeat(31) + "05" + y)).toBe("");
    expect(
      refusal(k, "04ffffffff00000001000000000000000000000001000000000000000000000004" + y),
    ).toContain("not an uncompressed point on the curve");
  });

  it("refuses zero, n and a short scalar", () => {
    const g =
      "046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296" +
      "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5";
    expect(refusal("00".repeat(32), g)).toContain("between 1 and n - 1");
    expect(
      refusal("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551", g),
    ).toContain("between 1 and n - 1");
    expect(refusal("01", g)).toContain("between 1 and n - 1");
    // n - 1 is fine: (n - 1) G = -G, whose x is G's.
    expect(
      hexEncode(
        p256Ecdh(
          hexDecode("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632550"),
          hexDecode(g),
        ),
      ),
    ).toBe("6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296");
  });
});
