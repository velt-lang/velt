    "23f0634552ba15289fa02c8a37e3a391e79e230dca05db03a7696630c5ba3a3352d1624f52832e4d6183c0eb70198e9a",
    "e49c208e41556e859d1a52d14784a061c2d5ae2c8690a5360e9f9344f60861c1362a9ec05a9f08a4167b3da41bdd122a387413dd06976470e4beff5053f2ac71",
  ],
  [
    1000,
    "94c38db521ca733b8904c2d14b6e82d33dcfcc26e1318c579dbee1fc2f472019034e792263b9d46e90e700de2f6e7e91",
    "00e36fccf193e59697a92b5ab24666ce6326d7fa16bf10832d0991ddc591112e9dfa6a636950ed9c4d67344a760654c2ff7785e1d60094d651038735b5dccabd",
  ],
];

describe("SHA-384 and SHA-512", () => {
  it("match FIPS 180-4's examples", () => {
    expect(sha512Hex("abc")).toBe(
      "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a" +
        "2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
    );
    expect(sha384Hex("abc")).toBe(
      "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed" +
        "8086072ba1e7cc2358baeca134c825a7",
    );
    const long =
      "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopq" +
      "klmnopqrlmnopqrsmnopqrstnopqrstu";
    expect(sha512Hex(long)).toBe(
      "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018" +
        "501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909",
    );
    expect(sha384Hex("")).toBe(
      "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da" +
        "274edebfe76f65fbd51ad2f14898b95b",
    );
  });

  it("pad every length around the block boundaries", () => {
    for (const c of CASES) {
      const m: u8[] = [];
      for (let i: usize = 0; i < c[0]; i++) {
        m.push(((i * 7 + 3) & 255) as u8);
      }
      expect(`${c[0]} ${hexEncode(sha384(m))}`).toBe(`${c[0]} ${c[1]}`);
      expect(`${c[0]} ${hexEncode(sha512(m))}`).toBe(`${c[0]} ${c[2]}`);
    }
  });
});
