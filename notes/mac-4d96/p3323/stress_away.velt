// #3323 stress: promises handed to tasks on other workers and dropped or awaited there while the
// task that drives them is in its own polls (it keeps yielding), suspended or finishing, and
// some of those tasks then park for ever. Every block is given back.

class Holder {
  p: Promise<number>;
  constructor(p: Promise<number>) {
    this.p = p;
  }
}

async function dead(): Promise<number> {
  return await new Promise<number>((resolve) => {});
}

// Finishes after `n` turns of its task.
async function soon(n: i64): Promise<number> {
  for (let i: i64 = 0; i < n; i++) {
    await yieldNow();
  }
  return 1;
}

// On worker 1: starts a promise (one that never settles, or one that finishes after a few
// turns), hands it on, keeps running for a while, then ends or parks for ever.
async function maker(i: i64, give: (h: Holder) => void, parks: boolean): Promise<number> {
  const p = i % 2 == 0 ? dead() : soon(i % 6);
  give(new Holder(p));
  for (let y: i64 = 0; y < 4 + (i % 7); y++) {
    await yieldNow();
  }
  if (parks) {
    return await dead();
  }
  return 1;
}

// Drops what it was given after `wait` turns, unawaited.
async function dropper(h: Holder, wait: i64): Promise<number> {
  for (let y: i64 = 0; y < wait; y++) {
    await yieldNow();
  }
  return 1;
}

// Awaits what it was given (one that finishes) and drops it.
async function user(h: Holder): Promise<number> {
  return await h.p;
}

async function main() {
  let sum = 0;
  const waits: Promise<number>[] = [];
  for (let i: i64 = 0; i < 400; i++) {
    const got = Promise.withResolvers<Holder>();
    const parks = i % 3 == 0;
    if (parks) {
      void spawn(maker(i, got.resolve, true), { worker: 1 });
    } else {
      waits.push(spawn(maker(i, got.resolve, false), { worker: 1 }));
    }
    const h = await got.promise;
    const w = 2 + (i % 2);
    if (i % 2 == 1 && i % 4 == 1) {
      waits.push(spawn(user(h), { worker: w }));
    } else {
      waits.push(spawn(dropper(h, i % 9), { worker: w }));
    }
  }
  while (waits.length > 0) {
    sum += await waits.pop()!;
  }
  console.log(`done ${sum}`);
}
