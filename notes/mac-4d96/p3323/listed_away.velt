// #3323 with the promise counted owner-only first: its task awaits it (through a second promise
// of the same task), hands its holder on, and parks. The task is found parked for ever and its
// root is dropped; the handed-on holder is dropped later, on worker 2, and with it the promise,
// which is still on its task's list of owner-only promises.

class Holder {
  p: Promise<number>;
  constructor(p: Promise<number>) {
    this.p = p;
  }
}

async function dead(): Promise<number> {
  return await new Promise<number>((resolve) => {});
}

// Awaits the held promise in the holder's task: that poll leaves it owner-only.
async function watch(h: Holder): Promise<number> {
  return await h.p;
}

// On worker 1.
async function maker(give: (h: Holder) => void): Promise<number> {
  const h = new Holder(dead());
  const q = watch(h);
  await yieldNow();
  give(h);
  return await q;
}

// On worker 2: keeps the holder past the maker's park, then drops it.
async function dropper(h: Holder): Promise<number> {
  await sleep(10);
  return 1;
}

async function main() {
  const got = Promise.withResolvers<Holder>();
  void spawn(maker(got.resolve), { worker: 1 });
  const h = await got.promise;
  console.log(`dropped on worker 2: ${await spawn(dropper(h), { worker: 2 })}`);
}
