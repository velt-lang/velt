import { currentWorker } from "velt/task";

class Holder {
  p: Promise<void>;
  constructor(p: Promise<void>) {
    this.p = p;
  }
}

// On worker 2: waits past the sleep's deadline, then awaits the sleep worker 1's block held. By
// then it expired there (due on the first task's list, or fired), so the worker that gives it
// up finds it due or fired, not pending.
async function second(h: Holder): Promise<i64> {
  await sleep(15);
  await h.p;
  return currentWorker();
}

// On worker 1: polls a sleep there, hands it to a task on worker 2, and stays busy on worker 1
// past the deadline without awaiting the sleep again.
async function first(): Promise<i64> {
  const s = sleep(5);
  await Promise.race([s, yieldNow()]);
  const other = spawn(second(new Holder(s)), { worker: 2 });
  const until = Date.now() + 40;
  while (Date.now() < until) {
    await yieldNow();
  }
  return await other;
}

async function main() {
  console.log(`awaited on worker ${await spawn(first(), { worker: 1 })}`);
}
