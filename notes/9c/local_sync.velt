// mod_sync.velt without module state: the Map and the counter are `main`'s.
function handle(cache: Map<string, string>, i: number): number {
  let n = 0;
  for (let k = 0; k < 200; k++) {
    const v = cache.get("k" + ((i + k) % 32));
    if (v !== undefined) {
      n += v.length;
    }
  }
  return n;
}

function main() {
  const cache = new Map<string, string>();
  for (let i = 0; i < 32; i++) {
    cache.set("k" + i, "value-" + i);
  }
  let total = 0;
  let hits = 0;
  for (let r = 0; r < 4000; r++) {
    total += handle(cache, r);
    hits += 1;
  }
  console.log(total, hits);
}
