// Module state on the executor (#2196 9c PR A): a handler reads a module-level Map 200 times per
// call, as bench/http/modlock/server.velt's `module` mode does, across awaits (each call is a
// poll that takes the module lock), on several tasks.
const cache = new Map<string, string>();
let hits = 0;

function handle(i: number): number {
  let n = 0;
  for (let k = 0; k < 200; k++) {
    const v = cache.get("k" + ((i + k) % 32));
    if (v !== undefined) {
      n += v.length;
    }
  }
  hits += 1;
  return n;
}

async function worker(id: number, rounds: number): Promise<number> {
  let s = 0;
  for (let r = 0; r < rounds; r++) {
    s += handle(id * 1000 + r);
    await Promise.resolve();
  }
  return s;
}

async function main() {
  for (let i = 0; i < 32; i++) {
    cache.set("k" + i, "value-" + i);
  }
  const all: Promise<number>[] = [];
  for (let t = 0; t < 8; t++) {
    all.push(spawn(worker(t, 500)));
  }
  let total = 0;
  for (const p of all) {
    total += await p;
  }
  console.log(total, hits);
}
