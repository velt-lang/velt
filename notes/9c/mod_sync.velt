// Module state without the executor (#2196 9c PR B): the same handler as mod_async.velt, called
// from a synchronous main.
const cache = new Map<string, string>();
let hits = 0;

function handle(i: number): number {
  let n = 0;
  for (let k = 0; k < 200; k++) {
    const v = cache.get("k" + ((i + k) % 32));
    if (v !== undefined) {
      n += v.length;
    }
  }
  hits += 1;
  return n;
}

function main() {
  for (let i = 0; i < 32; i++) {
    cache.set("k" + i, "value-" + i);
  }
  let total = 0;
  for (let r = 0; r < 4000; r++) {
    total += handle(r);
  }
  console.log(total, hits);
}
