// #3097 step 1: the cost of a cross-worker call at c=1. main (worker 0) sends to a task pinned on
// the last worker and waits for its reply: one round trip = two cross-worker wakes. Prints the
// mean round trip in nanoseconds over `n` calls after a warmup, three times.
import { channel, Channel } from "velt/sync";
import { workerCount } from "velt/task";

async function pong(inbox: Channel<i64>, out: Channel<i64>): Promise<void> {
  while (true) {
    const v = await inbox.receive();
    if (v == null || v < 0) {
      return;
    }
    out.trySend(v + 1);
  }
}

async function rounds(a: Channel<i64>, b: Channel<i64>, n: i64): Promise<i64> {
  let v: i64 = 0;
  for (let i = 0; i < n; i++) {
    a.trySend(v);
    v = (await b.receive()) ?? 0;
  }
  return v;
}

async function main() {
  const w = workerCount();
  const a = channel<i64>();
  const b = channel<i64>();
  const p = spawn(pong(a, b), { worker: w - 1 });
  // The caller pinned too: a movable one runs where its reply comes from (the waker's worker).
  await spawn(rounds(a, b, 2000), { worker: 0 });
  const n: i64 = 20000;
  for (let r = 0; r < 3; r++) {
    const t0 = performance.now();
    await spawn(rounds(a, b, n), { worker: 0 });
    const ns = ((performance.now() - t0) * 1000000.0) / (n as f64);
    console.log(`workers ${w}: round trip ${Math.round(ns)} ns`);
  }
  a.trySend(-1);
  await p;
}
