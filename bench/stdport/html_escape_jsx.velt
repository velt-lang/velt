// HTML escaping in a server-rendered page: the TechEmpower fortunes as a class with a string
// field, sorted with a comparator, each message escaped by `escapeHtml` and rendered by std/jsx
// as text and as an attribute (`escapeHtmlHexApos`), 20,000 times.
//
// On the warm list (share/velt/warm/programs.txt) for the std cache's release objects: in a
// program that sorts an array of a class holding a string, the escapers' `string` parameters
// are declared with other attributes than in `html_escape`, and those are in an object's key.
import { renderToStringSync } from "velt/jsx";
import { escapeHtml } from "velt/text";

class Fortune {
  constructor(public id: i64, public message: string) {}
}

function page(fortunes: Fortune[]): string {
  return renderToStringSync(
    <ul>
      {fortunes.map((f) => (
        <li title={f.message}>
          {f.id}: {f.message}
        </li>
      ))}
    </ul>,
  );
}

function main() {
  const fortunes: Fortune[] = [
    new Fortune(1, "fortune: No such file or directory"),
    new Fortune(2, "A computer scientist is someone who fixes things that aren't broken."),
    new Fortune(3, "After enough decimal places, nobody gives a damn."),
    new Fortune(4, "A bad random number generator: 1, 1, 1, 1, 1, 4.33e+67, 1, 1, 1"),
    new Fortune(5, "A computer program does what you tell it to do, not what you want it to do."),
    new Fortune(6, "Emacs is a nice operating system, but I prefer UNIX. — Tom Christaensen"),
    new Fortune(7, "Any program that runs right is obsolete."),
    new Fortune(8, "A list is only as strong as its weakest link. — Donald Knuth"),
    new Fortune(9, "Feature: A bug with seniority."),
    new Fortune(10, "Computers make very fast, very accurate mistakes."),
    new Fortune(
      11,
      "<script>alert(\"This should not be displayed in a browser alert box.\");</script>",
    ),
    new Fortune(12, "フレームワークのベンチマーク"),
    new Fortune(0, "Additional fortune added at request time."),
  ];
  fortunes.sort((a, b) => a.message.compareTo(b.message));
  console.log(page(fortunes));
  let total: usize = 0;
  for (let i = 0; i < 20000; i++) {
    total += page(fortunes).length;
    for (const f of fortunes) {
      total += escapeHtml(f.message).length;
    }
  }
  console.log(total);
}
