// Byte arrays made and copied (std/lang/bytes/raw.velt, #2196): `Buffer.alloc` of 16 bytes 1M
// times, of 1 KiB 200k times, of 1 MiB 500 times and of 64 MiB 8 times (each touched once);
// `allocUnsafe` of 1 KiB 200k times; `set`, `copy`, `copyWithin` and `slice` of 16 bytes 1M
// times, of 1 KiB 200k times and of 1 MiB 300 times. The Rust port uses `vec![0; n]` (calloc),
// `Vec::with_capacity` + `set_len`, `copy_from_slice` and `copy_within`, as the runtime did.
function main() {
  let total: i64 = 0;
  for (let round: usize = 0; round < 1000000; round++) {
    const b = Buffer.alloc(16);
    b[round % 16] = 1;
    total += b[(round + 1) % 16] as i64;
  }
  for (let round: usize = 0; round < 200000; round++) {
    const b = Buffer.alloc(1024);
    total += b[round % 1024] as i64 + (b.length as i64);
  }
  for (let round: usize = 0; round < 500; round++) {
    const b = Buffer.alloc(1048576);
    total += b[round * 1000] as i64 + (b.length as i64);
  }
  for (let round: usize = 0; round < 8; round++) {
    const b = Buffer.alloc(67108864);
    total += b[round * 4096] as i64 + (b.length as i64);
  }
  for (let round: usize = 0; round < 200000; round++) {
    const b = Buffer.allocUnsafe(1024);
    b[0] = (round % 251) as u8;
    total += b[0] as i64;
  }
  const sizes: usize[] = [16, 1024, 1048576];
  const rounds: usize[] = [1000000, 200000, 300];
  for (let k = 0; k < 3; k++) {
    const n = sizes[k];
    const src = Buffer.alloc(n);
    const dst = Buffer.alloc(n * 2);
    for (let i: usize = 0; i < n; i++) {
      src[i] = (i % 251) as u8;
    }
    for (let round: usize = 0; round < rounds[k]; round++) {
      src[round % n] = (round % 7) as u8;
      dst.set(src, (round % (n + 1)) as number);
      total += src.copy(dst, (round % n) as number, 1, n as number) as i64;
      dst.copyWithin(1, 0, n as number);
      const s = src.slice(1, n as number);
      total += (dst[round % (n * 2)] as i64) + (s[s.length - 1] as i64) + (s.length as i64);
    }
  }
  console.log(total);
}

main();
