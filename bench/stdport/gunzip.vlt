// gzip decompression (`velt:compress/inflate`): the 1 MB JSON of `json.gz`
// (rust/src/bin/gen_inputs.rs, written by run.sh), decoded 50 times. The Rust port uses
// `flate2`, which the runtime's `fetch` decoded gzip bodies with before the client was Velt code.
import { readFileBytesSync } from "velt:fs";
import { gunzip } from "velt:compress/inflate";

function main() {
  const input = readFileBytesSync(`${process.env.STDPORT_INPUTS ?? "."}/json.gz`);
  let total: i64 = 0;
  let sum: i64 = 0;
  for (let i = 0; i < 50; i++) {
    const out = gunzip(input);
    total += out.length as i64;
    sum += out[(out.length as i64) / 2] as i64;
  }
  console.log(`${total} ${sum}`);
}
