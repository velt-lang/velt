// `Promise.all` over two stored promises whose timers are due at once: the join adopts them, so
// their timers wake the same waiter (bench/async/timers_due_join.vlt).
async function step(ms: i64): Promise<i64> {
  await sleep(ms);
  return ms + 1;
}

async function main() {
  let sum = 0;
  for (let i = 0; i < 20000; i++) {
    const a = step(0);
    const b = step(0);
    const r = await Promise.all([a, b]);
    sum += r[0] + r[1];
  }
  console.log(sum);
}
