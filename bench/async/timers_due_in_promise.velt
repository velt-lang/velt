// Fixed-arity joins over due timers in several started promises at once: each join's timers wake
// its promise, and the timers come one join after the other (bench/async/timers_due_join.velt).
async function step(ms: i64): Promise<i64> {
  await sleep(ms);
  return ms + 1;
}

async function join(): Promise<i64> {
  const r = await Promise.all([step(0), step(0), step(0), step(0)]);
  return r[0] + r[3];
}

async function main() {
  let sum = 0;
  for (let i = 0; i < 5000; i++) {
    const a = join();
    const b = join();
    const c = join();
    const d = join();
    sum += await a;
    sum += await b;
    sum += await c;
    sum += await d;
  }
  console.log(sum);
}
