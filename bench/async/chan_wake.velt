// The cost of a wait and its wake: 64 tasks in a ring, each with its own channel, pass 8 tokens
// along (800k hops). A task holds nothing between tokens, so every receive finds its channel
// empty, waits, and is woken by the trySend of the task before it: the shape of a pool with 8
// connections and 64 tasks, where most queries wait once for a connection (bench/db
// pool_select_64). Instructions per hop are the wait-and-wake cost.
import { channel, Channel } from "velt/sync";

const TASKS: i64 = 64;
const TOKENS: i64 = 8;
const HOPS: i64 = 100000;

async function member(inbox: Channel<i64>, next: Channel<i64>, done: Channel<i64>): Promise<i64> {
  let seen: i64 = 0;
  while (true) {
    const v = await inbox.receive();
    if (v == null) {
      return seen;
    }
    seen++;
    if (v + 1 >= HOPS) {
      done.trySend(seen);
    } else {
      next.trySend(v + 1);
    }
  }
}

async function main() {
  const inboxes: Channel<i64>[] = [];
  for (let i: i64 = 0; i < TASKS; i++) {
    inboxes.push(channel<i64>());
  }
  const done = channel<i64>();
  const members: Promise<i64>[] = [];
  for (let i: i64 = 0; i < TASKS; i++) {
    members.push(spawn(member(inboxes[i], inboxes[(i + 1) % TASKS], done)));
  }
  for (let t: i64 = 0; t < TOKENS; t++) {
    inboxes[t * (TASKS / TOKENS)].trySend(0);
  }
  for (let t: i64 = 0; t < TOKENS; t++) {
    await done.receive();
  }
  for (const inbox of inboxes) {
    inbox.close();
  }
  let hops: i64 = 0;
  for (const n of await Promise.all(members)) {
    hops += n;
  }
  console.log(hops);
}
