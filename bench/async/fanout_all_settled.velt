// 1000 rounds of Promise.allSettled over 1000 small async tasks, every 7th of which rejects:
// each input is handled from the call, so no rejection is reported, and each outcome is read.
class Failed extends Error {}

async function task(round: i64, i: i64): Promise<i64> throws Failed {
  if (i % 7 == 3) {
    throw new Failed("odd one");
  }
  return (round * 1000 + i) % 7919;
}

async function main() {
  let total = 0;
  let failed = 0;
  for (let round = 0; round < 1000; round++) {
    const ps: Promise<i64, Failed>[] = [];
    for (let i = 0; i < 1000; i++) {
      ps.push(task(round, i));
    }
    const rs = await Promise.allSettled(ps);
    for (const r of rs) {
      if (r.status == "fulfilled") {
        total += r.value;
      } else {
        failed += 1;
      }
    }
  }
  console.log(total, failed);
}
