// #211 step 0: 4 owner tasks each keep a Map; 64 callers make 5000 request/reply calls each
// (320k in total) to the owner of their key, over a channel plus Promise.withResolvers: the
// pattern of the actors runtime (#182), whose cost is mostly cross-thread wakes. Every key has
// one owner, so the printed total is the same in any order.
import { channel, Channel } from "velt:channel";

type Call = { key: string; reply: (n: i64) => void };

async function owner(inbox: Channel<Call>): Promise<void> {
  const counts = new Map<string, i64>();
  while (true) {
    const c = await inbox.receive();
    if (c == null) {
      return;
    }
    const n = (counts.get(c.key) ?? 0) + 1;
    counts.set(c.key, n);
    c.reply(n);
  }
}

async function caller(inbox: Channel<Call>, key: string, calls: i64): Promise<i64> {
  let sum: i64 = 0;
  for (let i: i64 = 0; i < calls; i++) {
    const { promise, resolve } = Promise.withResolvers<i64>();
    inbox.trySend({ key: key, reply: resolve });
    sum += await promise;
  }
  return sum;
}

async function main() {
  const owners = 4;
  const inboxes: Channel<Call>[] = [];
  const running: Promise<void>[] = [];
  for (let i = 0; i < owners; i++) {
    const inbox = channel<Call>();
    inboxes.push(inbox);
    running.push(spawn(owner(inbox)));
  }
  const callers: Promise<i64>[] = [];
  for (let c = 0; c < 64; c++) {
    // Key k always belongs to owner k % 4 (16 keys).
    callers.push(spawn(caller(inboxes[c % owners], `k${c % 16}`, 5000)));
  }
  let total: i64 = 0;
  for (const r of await Promise.all(callers)) {
    total += r;
  }
  for (const inbox of inboxes) {
    inbox.close();
  }
  await Promise.all(running);
  console.log(total);
}
