import type { Package } from "velt/package";

// The benchmark's Velt programs, on the repository's database packages (the native libraries of
// those that have one are built with cargo the first time).
export const pkg: Package = {
  name: "db-bench",
  version: "0.1.0",
  // Packages with native code run with no safety net, so the program lists the ones it trusts.
  allowNative: ["postgres", "redis", "sqlite"],
  dependencies: {
    postgres: { path: "../../../packages/postgres" },
    redis: { path: "../../../packages/redis" },
    sqlite: { path: "../../../packages/sqlite" },
  },
};
