// TechEmpower-style benchmark server: /plaintext, /json and a DB-less /fortunes (the 12
// TechEmpower fortunes built per request in place of the query, plus one added at request
// time, sorted by message and rendered as an escaped HTML table).
// Usage: server <port> (bench/http/techempower/run.sh picks the port).

import { escapeHtml } from "velt:html";
import { serve } from "velt:http";
import { args } from "velt:process";

class Fortune {
  id: i64;
  message: string;

  constructor(id: i64, message: string) {
    this.id = id;
    this.message = message;
  }
}

// Stands in for `SELECT id, message FROM fortune`: a fresh list per request.
function loadFortunes(): Fortune[] {
  return [
    new Fortune(1, "fortune: No such file or directory"),
    new Fortune(2, "A computer scientist is someone who fixes things that aren't broken."),
    new Fortune(3, "After enough decimal places, nobody gives a damn."),
    new Fortune(4, "A bad random number generator: 1, 1, 1, 1, 1, 4.33e+67, 1, 1, 1"),
    new Fortune(5, "A computer program does what you tell it to do, not what you want it to do."),
    new Fortune(6, "Emacs is a nice operating system, but I prefer UNIX. — Tom Christaensen"),
    new Fortune(7, "Any program that runs right is obsolete."),
    new Fortune(8, "A list is only as strong as its weakest link. — Donald Knuth"),
    new Fortune(9, "Feature: A bug with seniority."),
    new Fortune(10, "Computers make very fast, very accurate mistakes."),
    new Fortune(
      11,
      "<script>alert(\"This should not be displayed in a browser alert box.\");</script>",
    ),
    new Fortune(12, "フレームワークのベンチマーク"),
  ];
}

function fortunesPage(): Response {
  const fortunes = loadFortunes();
  fortunes.push(new Fortune(0, "Additional fortune added at request time."));
  fortunes.sort((a, b) => a.message.compareTo(b.message));
  const parts: string[] = [
    "<!DOCTYPE html><html><head><title>Fortunes</title></head><body><table><tr><th>id</th><th>message</th></tr>",
  ];
  for (const f of fortunes) {
    parts.push(`<tr><td>${f.id}</td><td>${escapeHtml(f.message)}</td></tr>`);
  }
  parts.push("</table></body></html>");
  return new Response(parts.join(""), { headers: { "content-type": "text/html; charset=utf-8" } });
}

// The path of `url`, an absolute URL as a server request has it (`http://host/path?query`): from
// the first `/` after the scheme (`https://` is 8 characters) up to the query.
function pathOf(url: string): string {
  const start = url.indexOf("/", 8);
  const end = url.indexOf("?", start);
  return end < 0 ? url.slice(start) : url.slice(start, end);
}

async function main() {
  const argv = args();
  const port = argv.length > 0 ? parseInt(argv[0], 10) : 8080;
  const server = await serve({ port: port }, async (req: Request): Promise<Response> => {
    const path = pathOf(req.url);
    if (path == "/json") {
      return Response.json({ message: "Hello, World!" });
    }
    if (path == "/fortunes") {
      return fortunesPage();
    }
    return new Response("Hello, World!");
  });
  console.log(`listening on http://127.0.0.1:${server.port}`);
  await sleep(1000000000);
}
