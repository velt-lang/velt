import { workerCount } from "velt/task";

class Node {
  name: string;
  next: Node | null = null;
  kids: Node[] = [];
  constructor(name: string) {
    this.name = name;
  }
}

const first = new Map<string, Node>();

async function churn(id: number): Promise<number> {
  for (let i = 0; i < 5000; i++) {
    const a = first.get("a")!;
    await yieldNow();
    a.kids.push(new Node(`k${id}-${i}`));
    if (a.kids.length > 50) {
      a.kids = [];
    }
  }
  return 0;
}

async function main() {
  first.set("a", new Node("a"));
  const ps: Promise<number>[] = [];
  for (let t: i64 = 0; t < 8; t++) {
    ps.push(spawn(churn(t as number), { worker: t % workerCount() }));
  }
  for (const p of ps) {
    await p;
  }
  console.log(`kids ${first.get("a")!.kids.length}`);
}
