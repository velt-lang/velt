// HTTPS benchmark server: /plaintext over TLS 1.3 with the goldens' throwaway P-256 certificate
// (tests/golden/std/_tls.velt), HTTP/1.1 only. Its TLS server is the one in Velt on the reactor
// (std/net/tls/fd_ops.velt); built against a std without it (bench/http/tls/run.sh's `BASE`), the
// runtime's (tokio-rustls).
// Usage: server <port> (bench/http/tls/run.sh picks the port).

import { serve } from "http-server";
import { TlsListenOptions } from "velt/net";
import { args } from "velt/process";
import { TEST_CERT, TEST_KEY } from "../../../tests/golden/std/_tls";

async function main() {
  const argv = args();
  const port = argv.length > 0 ? parseInt(argv[0], 10) : 8443;
  const tls: TlsListenOptions = { cert: TEST_CERT, key: TEST_KEY, alpn: ["http/1.1"] };
  const server = await serve({ port: port, tls: tls }, async (req: Request): Promise<Response> => {
    return new Response("Hello, World!");
  });
  console.log(`listening on https://127.0.0.1:${server.port}`);
  await sleep(1000000000);
}
