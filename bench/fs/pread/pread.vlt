// requires: unix
// Positioned file I/O through velt/fs's fd API (Velt over system functions, no runtime in
// between): random 4 KiB `readSync` at a position in a 64 MiB file, sequential 64 KiB reads of
// the whole file, and small `writeSync` + `fsyncSync`. The same work as pread.js (Node) and
// rust/ (`FileExt::read_at`). Prints `name ms checksum` per workload. Usage: pread <file>.
import * as fs from "velt/fs/fd";

const PAGE = 4096;
const READS = 200000;
const PASSES = 8;
const SYNCS = 200;

function report(name: string, ms: number, check: number) {
  console.log(`${name} ${ms.toFixed(1)} ${check}`);
}

function main() {
  const path = process.argv[2];
  const fd = fs.openSync(path, "r");
  const size = fs.fstatSync(fd).size as number;
  const pages = Math.floor(size / PAGE);
  const page: u8[] = Buffer.alloc(PAGE);

  // Random pages (xorshift, the same sequence in every language).
  let x: u32 = 2463534242;
  let sum = 0;
  let start = performance.now();
  for (let i = 0; i < READS; i++) {
    x ^= x << 13;
    x ^= x >> 17;
    x ^= x << 5;
    const at = (x % (pages as u32)) as number;
    const n = fs.readSync(fd, page, 0, PAGE, at * PAGE);
    sum += n + page[0];
  }
  report("random_4k", performance.now() - start, sum);

  // The whole file in 64 KiB reads at the file's own position.
  const chunk: u8[] = Buffer.alloc(65536);
  sum = 0;
  start = performance.now();
  for (let p = 0; p < PASSES; p++) {
    let at = 0;
    while (true) {
      const n = fs.readSync(fd, chunk, 0, 65536, at);
      if (n == 0) {
        break;
      }
      at += n;
      sum += n + chunk[n - 1];
    }
  }
  report("sequential_64k", performance.now() - start, sum);
  fs.closeSync(fd);

  // 100-byte writes at a position, each made durable.
  const wpath = `${path}.w`;
  const w = fs.openSync(wpath, "w");
  const rec: u8[] = Buffer.alloc(100);
  start = performance.now();
  for (let i = 0; i < SYNCS; i++) {
    rec[0] = (i & 255) as u8;
    fs.writeSync(w, rec, 0, 100, i * 100);
    fs.fsyncSync(w);
  }
  report("pwrite_fsync", performance.now() - start, fs.fstatSync(w).size as number);
  fs.closeSync(w);
  fs.unlinkSync(wpath);
}
