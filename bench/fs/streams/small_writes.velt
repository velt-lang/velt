// File streams (std/fs/stream_sched.velt): 200,000 small writes through a `FileWriter` (gathered
// in its buffer, written 64 KiB at a time). Counted by bench/std_ab.sh (one worker).
import { openWrite, remove } from "velt/fs";
import { tmpdir } from "velt/os";

async function main() {
  const path = `${tmpdir()}/velt-bench-stream-writes-${Date.now()}.txt`;
  const w = await openWrite(path);
  for (let i = 0; i < 200000; i++) {
    await w.write(`line ${i} of the stream benchmark\n`);
  }
  await w.close();
  await remove(path);
  console.log("written");
}

main();
