// An array spread of a place, then of a call's array (`[...xs, ...f()]`): the place is copied
// before the call runs (the call may change it), and the call's elements are pushed after it
// returns, into room made for exactly their number.
function tail(i: number): number[] {
  return [i, i + 1, i + 2, i + 3, i + 4, i + 5, i + 6, i + 7];
}

function main() {
  const xs: number[] = [];
  for (let k = 0; k < 64; k++) {
    xs.push(k);
  }
  let total = 0;
  for (let i = 0; i < 300000; i++) {
    const a = [...xs, ...tail(i)];
    total += a.length + a[a.length - 1];
  }
  console.log(total);
}
