// Sorts of an `any[]` with an arrow that only reads through `any`, in a program whose calls
// through `any` throw (#1938): 20 × `sort` and `toSorted` of 5,000 objects (bench/any_calls/ab.sh).
function check(x: number): number {
  if (x < 0) throw new RangeError("negative");
  return x;
}
const table: any = { check };
console.log(table.check(1));
let total = 0;
for (let r = 0; r < 20; r++) {
  const rows: any[] = [];
  let seed = r + 1;
  for (let i = 0; i < 5000; i++) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    rows.push({ k: seed });
  }
  rows.sort((a: any, b: any): number => (a.k as number) - (b.k as number));
  const back = rows.toSorted((a: any, b: any): number => (b.k as number) - (a.k as number));
  total += (rows[0].k as number) + (back[0].k as number);
}
console.log(total);
