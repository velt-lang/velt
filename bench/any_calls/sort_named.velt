// Sorts with named comparators that call nothing through `any`, in a program whose calls through
// `any` throw (#1938): 20 sorts of 20,000 numbers (bench/any_calls/ab.sh).
function check(x: number): number {
  if (x < 0) throw new RangeError("negative");
  return x;
}
const table: any = { check };
console.log(table.check(1));
function byValue(a: number, b: number): number {
  return a - b;
}
let total = 0;
for (let r = 0; r < 20; r++) {
  const xs: number[] = [];
  let seed = r + 1;
  for (let i = 0; i < 20000; i++) {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    xs.push(seed);
  }
  xs.sort(byValue);
  total += xs[0] + xs[xs.length - 1];
}
console.log(total);
