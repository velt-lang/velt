// The global `fetch` against a Velt server in the same process, for the nightly instruction
// guard (bench/nightly.sh, #601): sequential keep-alive GETs of a small body, of a JSON body read
// with `json<T>()`, and of a gzip-compressed body. The client's work dominates; the full client
// comparison with Node and reqwest is bench/http/fetch.
import { serve } from "velt:http";

struct Item {
  id: i64;
  name: string;
}

const items: Item[] = [];
for (let i: i64 = 0; i < 100; i++) {
  items.push({ id: i, name: `item ${i}` });
}
const listJson = JSON.stringify(items);
// "velt fetch " 2000 times, gzipped.
const packed: u8[] = [
  31,
  139,
  8,
  0,
  0,
  0,
  0,
  0,
  2,
  255,
  237,
  198,
  177,
  13,
  0,
  32,
  8,
  0,
  176,
  87,
  248,
  205,
  96,
  24,
  28,
  9,
  247,
  251,
  3,
  115,
  59,
  117,
  242,
  117,
  220,
  236,
  83,
  49,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
  170,
