  170,
  170,
  170,
  170,
  170,
  170,
  186,
  239,
  7,
  32,
  82,
  36,
  25,
  240,
  85,
  0,
  0,
];

async function answer(req: Request): Promise<Response> {
  const path = new URL(req.url).pathname;
  if (path == "/json") {
    return new Response(listJson, { headers: { "content-type": "application/json" } });
  }
  if (path == "/gzip") {
    return new Response(packed, { headers: { "content-encoding": "gzip" } });
  }
  return new Response("hello");
}

async function main() {
  const server = await serve({ port: 0 }, answer);
  const base = `http://127.0.0.1:${server.port}`;
  let total: i64 = 0;
  for (let i: i64 = 0; i < 2000; i++) {
    total += (await (await fetch(`${base}/small`)).text()).length as i64;
  }
  for (let i: i64 = 0; i < 300; i++) {
    const list: Item[] = await (await fetch(`${base}/json`)).json();
    total += list.length as i64;
  }
  for (let i: i64 = 0; i < 300; i++) {
    total += (await (await fetch(`${base}/gzip`)).text()).length as i64;
  }
  console.log(total);
  await server.shutdown();
}

await main();
