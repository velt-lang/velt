// A probe for scripts/ct-counts.py: P-384's public key and ECDH agreement for the 48-byte
// private key in the file named by the first argument. The key is read as bytes and nothing
// here branches on it.
import { p384Ecdh, p384PublicKey } from "velt/crypto";
import { readFileBytesSync } from "velt/fs";

// G, as the peer's key.
const PEER: u8[] = [
  0x04,
  0xaa,
  0x87,
  0xca,
  0x22,
  0xbe,
  0x8b,
  0x05,
  0x37,
  0x8e,
  0xb1,
  0xc7,
  0x1e,
  0xf3,
  0x20,
  0xad,
  0x74,
  0x6e,
  0x1d,
  0x3b,
  0x62,
  0x8b,
  0xa7,
  0x9b,
  0x98,
  0x59,
  0xf7,
  0x41,
  0xe0,
  0x82,
  0x54,
  0x2a,
  0x38,
  0x55,
  0x02,
  0xf2,
  0x5d,
  0xbf,
  0x55,
  0x29,
  0x6c,
  0x3a,
  0x54,
  0x5e,
  0x38,
  0x72,
  0x76,
  0x0a,
  0xb7,
  0x36,
  0x17,
  0xde,
  0x4a,
  0x96,
  0x26,
  0x2c,
  0x6f,
  0x5d,
  0x9e,
  0x98,
  0xbf,
  0x92,
  0x92,
  0xdc,
  0x29,
  0xf8,
  0xf4,
  0x1d,
  0xbd,
  0x28,
  0x9a,
  0x14,
  0x7c,
  0xe9,
  0xda,
  0x31,
  0x13,
  0xb5,
  0xf0,
  0xb8,
  0xc0,
  0x0a,
  0x60,
  0xb1,
  0xce,
  0x1d,
  0x7e,
  0x81,
  0x9d,
  0x7a,
  0x43,
  0x1d,
  0x7c,
  0x90,
  0xea,
  0x0e,
  0x5f,
];

const key = readFileBytesSync(process.argv[2] ?? "");
const peer: u8[] = [];
for (let i: usize = 0; i < 97; i++) {
  peer.push(PEER[i]);
}
// Nothing is done with the results that depends on their value: memcheck, with the key marked
// undefined, would report it (scripts/ct-counts.py --memcheck).
const pub = p384PublicKey(key);
const shared = p384Ecdh(key, peer);
console.log(pub.length + shared.length);
