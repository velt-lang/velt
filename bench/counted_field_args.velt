// Fields of a counted object passed to calls that can't assign them: no count update per call
// (#2480). Each row is one way of writing such a call; bench/counted_field_args.sh counts them one
// at a time, and with no argument the program runs them all, which the nightly list guards.
class Inner { s: string = "inner-string-on-the-heap-".repeat(2); }
class Rec {
  s: string = "label-string-on-the-heap-".repeat(2);
  prefix: string = "lab";
  sep: string = "-";
  u: string | number = "union-string-on-the-heap-".repeat(2);
  opt: string | null = "optional-string-on-the-heap-".repeat(2);
  t: [string, number] = ["tuple-string-on-the-heap-".repeat(2), 1];
  inner: Inner = new Inner();
  n: number = 0;
  plainM(v: string): boolean { return check(v) && this.n >= 0; }
  run(): number {
    let c = 0;
    for (let i = 0; i < N; i++) { if (checkAt(this.s, i)) c++; }
    return c;
  }
}
const N = 300000;
function check(v: string): boolean { return v.startsWith("lab"); }
function checkU(v: string | number): boolean { return typeof v === "string" && v.startsWith("uni"); }
function checkOpt(v: string | null): boolean { return v !== null && v.startsWith("opt"); }
function readT(v: [string, number], i: number): boolean { return v[0].charCodeAt(i % 3) > 0; }
function checkAt(v: string, i: number): boolean { return v.startsWith("lab") && v.charCodeAt(i % 3) > 0; }

function rec(): Rec {
  const o = new Rec();
  const alias = o;
  alias.n = 2;
  return o;
}
function thisPlain() { return rec().run(); }
function recvStartsWithField() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (o.s.startsWith(o.prefix)) c++; }
  return c;
}
function union() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (checkU(o.u)) c++; }
  return c;
}
function optional() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (checkOpt(o.opt)) c++; }
  return c;
}
function recvStartsWithLit() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (o.s.startsWith("lab")) c++; }
  return c;
}
function plain() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (check(o.s)) c++; }
  return c;
}
function fnValue() {
  const o = rec(); let c = 0;
  const g: (v: string) => boolean = check;
  for (let i = 0; i < N; i++) { if (g(o.s)) c++; }
  return c;
}
function method() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (o.plainM(o.s)) c++; }
  return c;
}
function twoObjects() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (check(o.inner.s)) c++; }
  return c;
}
function indexOf() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { c += o.s.indexOf(o.sep); }
  return c;
}
function slice() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { c += o.s.slice(1, 3).length; }
  return c;
}
function tuple() {
  const o = rec(); let c = 0;
  for (let i = 0; i < N; i++) { if (readT(o.t, i)) c++; }
  return c;
}
function includes() {
  const o = rec(); let c = 0;
  const xs = ["a", "b", "c", o.s];
  for (let i = 0; i < N; i++) { if (xs.includes(o.s)) c++; }
  return c;
}
function forOf() {
  const xs = [rec(), rec(), rec()]; let c = 0;
  for (let i = 0; i < N / 3; i++) { for (const it of xs) { if (checkAt(it.s, i)) c++; } }
  return c;
}
// Fields one function writes, and none of these calls reach: the callee decides. Only `written`
// and `renamed` are assigned, so these rows catch a callee fact that stops working.
class Kept {
  written: string = "written-string-on-the-heap-".repeat(2);
  inner: KeptInner = new KeptInner();
  n: number = 0;
}
class KeptInner { renamed: string = "inner-written-on-the-heap-".repeat(2); }
function rename(k: Kept) {
  k.written = k.written + "x";
  k.inner.renamed = k.inner.renamed + "x";
}
function kept(): Kept {
  const o = new Kept();
  const alias = o;
  rename(alias);
  return o;
}
function startsWithZ(v: string): boolean { return v.startsWith("z"); }
function dashAt(v: string): number { return v.indexOf("-"); }
function middle(v: string): number { return v.slice(1, 3).length; }
function joined(v: string): number { return (v + "x").length; }
function makes(v: string): number { return new KeptInner().renamed.length + v.length; }
function writtenPlain() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { if (check(o.written)) c++; }
  return c;
}
function writtenInner() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { if (check(o.inner.renamed)) c++; }
  return c;
}
function writtenStartsWith() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { if (startsWithZ(o.written)) c++; }
  return c;
}
function writtenIndexOf() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { c += dashAt(o.written); }
  return c;
}
function writtenSlice() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { c += middle(o.written); }
  return c;
}
function writtenConcat() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { c += joined(o.written); }
  return c;
}
function writtenFnValue() {
  const o = kept(); let c = 0;
  const g: (v: string) => boolean = check;
  for (let i = 0; i < N; i++) { if (g(o.written)) c++; }
  return c;
}
function writtenNew() {
  const o = kept(); let c = 0;
  for (let i = 0; i < N; i++) { c += makes(o.written); }
  return c;
}
function all() {
  console.log(thisPlain());
  console.log(recvStartsWithField());
  console.log(union());
  console.log(optional());
  console.log(recvStartsWithLit());
  console.log(plain());
  console.log(fnValue());
  console.log(method());
  console.log(twoObjects());
  console.log(indexOf());
  console.log(slice());
  console.log(tuple());
  console.log(includes());
  console.log(forOf());
  console.log(writtenPlain());
  console.log(writtenInner());
  console.log(writtenStartsWith());
  console.log(writtenIndexOf());
  console.log(writtenSlice());
  console.log(writtenConcat());
  console.log(writtenFnValue());
  console.log(writtenNew());
}
all();
