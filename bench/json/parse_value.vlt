// Dynamic parse: `JSON.parseValue` of 100k objects (about 8 MB), 8 times.
function doc(n: i64): string {
  const parts: string[] = [];
  for (let i: i64 = 0; i < n; i++) {
    parts.push(
      `{"id":${i},"name":"user ${i}","score":${i % 1000}.5,"active":${i % 2 == 0},"tags":["t${i % 7}","x"]}`,
    );
  }
  return `[${parts.join(",")}]`;
}

function main() {
  const text = doc(100000);
  let sum: i64 = 0;
  for (let round = 0; round < 8; round++) {
    const v = JSON.parseValue(text);
    sum += (v.len() + (v.at(round)?.len() ?? 0)) as i64;
  }
  console.log(text.length, sum);
}
