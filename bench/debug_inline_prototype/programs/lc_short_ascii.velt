function main(): void {
  const w = ["apple","Banana","cherry","date","Elder","fig","grape","Honey","kiwi","lemon","Mango","nut","olive","Peach","quince","rose"];
  let t = 0;
  for (let i = 0; i < 1000000; i++) {
    t += w[i & 15].localeCompare(w[(i * 7 + 3) & 15]);
  }
  console.log(t);
}
main();
