function main(): void {
  const w = ["привет","мир","слово","дом","γειά","κόσμος","λόγος","σπίτι","résumé","déjà","naïve","café","Ångström","Übung","señor","façade"];
  let t = 0;
  for (let i = 0; i < 1000000; i++) {
    t += w[i & 15].localeCompare(w[(i * 7 + 3) & 15]);
  }
  console.log(t);
}
main();
