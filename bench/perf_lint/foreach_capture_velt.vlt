// perf/foreach-capture, the Velt form: `for…of`, the body in place.
// The pair is measured in README.md.
function main() {
  const xs: number[] = [];
  for (let i = 0; i < 1000; i++) xs.push(i * 0.5);
  let total = 0.0;
  for (let r = 0; r < 20000; r++) {
    for (const x of xs) { total += x; }
  }
  console.log(total);
}
