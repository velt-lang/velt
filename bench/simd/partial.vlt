// The last elements of an array, fewer than a vector, one element at a time against one
// partial vector (`loadPartial` / `storePartial`): `partial <loop|partial> <length> <calls>`
// counts a byte and XORs the array with a 4-byte key, `calls` times (partial.sh runs it).
// Every call changes a byte first, so no call repeats the one before.
import { args } from "velt/process";
import { u8x16, mask8x16 } from "velt/simd";

function countLoop(d: u8[], b: u8): u64 {
  const needle = u8x16.splat(b);
  let c: u64 = 0;
  let i: usize = 0;
  while (u8x16.fits(d, i)) {
    c += u8x16.load(d, i).eq(needle).count() as u64;
    i += 16;
  }
  while (i < d.length) {
    if (d[i] == b) {
      c++;
    }
    i++;
  }
  return c;
}

function countPartial(d: u8[], b: u8): u64 {
  const needle = u8x16.splat(b);
  let c: u64 = 0;
  let i: usize = 0;
  while (u8x16.fits(d, i)) {
    c += u8x16.load(d, i).eq(needle).count() as u64;
    i += 16;
  }
  const last = u8x16.loadPartial(d, i).eq(needle);
  return c + (last.and(mask8x16.prefix((d.length as usize) - i)).count() as u64);
}

function xorLoop(d: u8[], key: u8[]) {
  const k = u8x16.load(key);
  let i: usize = 0;
  while (u8x16.fits(d, i)) {
    u8x16.load(d, i).xor(k).store(d, i);
    i += 16;
  }
  while (i < d.length) {
    d[i] = d[i] ^ key[i & 3];
    i++;
  }
}

function xorPartial(d: u8[], key: u8[]) {
  const k = u8x16.load(key);
  let i: usize = 0;
  while (u8x16.fits(d, i)) {
    u8x16.load(d, i).xor(k).store(d, i);
    i += 16;
  }
  u8x16.loadPartial(d, i).xor(k).storePartial(d, i);
}

function main() {
  const a = args();
  const partial = a[0] == "partial";
  const n = parseInt(a[1]) as usize;
  const calls = parseInt(a[2]) as usize;
  const d = Buffer.alloc(n);
  for (let i: usize = 0; i < n; i++) {
    d[i] = (i % 7) as u8;
  }
  const key: u8[] = [];
  for (let i: usize = 0; i < 16; i++) {
    key.push((1 << (i & 3)) as u8);
  }
  let total: u64 = 0;
  for (let round: usize = 0; round < calls; round++) {
    d[round % n] = (round % 5) as u8;
    if (partial) {
      total += countPartial(d, 3);
      xorPartial(d, key);
    } else {
      total += countLoop(d, 3);
      xorLoop(d, key);
    }
  }
  let sum: u64 = 0;
  for (let i: usize = 0; i < n; i++) {
    sum += d[i] as u64;
  }
  console.log(total, sum);
}
