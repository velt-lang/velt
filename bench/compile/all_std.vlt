// Compile-time benchmark input: imports every public std module (a folder's index.vlt outside
// prelude/ and lang/, all user code may import; their own imports reach the internal files), so
// with VELT_EAGER_STD=1 sema checks all of std that a program can reach, and the prelude (without
// it, the prelude's free functions and statics this program doesn't reach stay unchecked;
// docs/internals/design/lazy-std.md). bench/nightly.sh divides its instructions with
// VELT_EAGER_STD=1 by the code lines of all of std/, which is only a cost per line when all of
// std is checked; crates/veltc/tests/bench_programs.rs checks that no public module is missing
// and that all of std checks without diagnostics. std's white-box tests (`*.test.vlt`) are
// `velt test std/`'s. A small main touches a few modules and names the globals loaded on demand
// whose modules nothing imports (`Proxy` and `Reflect`, std/prelude/global/proxy.vlt).
import { RequestInit } from "velt/net/http";
import { existsSync } from "velt/fs";
import { ioError } from "velt/native";
import { Value } from "velt/encoding/json";
import { clamp, gcd } from "velt/math";
import { connect } from "velt/net";
import { join } from "velt/path";
import { argv } from "velt/process";
import * as std_cli from "velt/cli";
import * as std_collections from "velt/collections";
import * as std_compress from "velt/compress";
import * as std_crypto from "velt/crypto";
import * as std_db from "velt/db";
import * as std_dev from "velt/dev";
import * as std_encoding from "velt/encoding";
import * as std_encoding_csv from "velt/encoding/csv";
import * as std_encoding_json from "velt/encoding/json";
import * as std_fs from "velt/fs";
import * as std_generate from "velt/generate";
import * as std_hash from "velt/hash";
import * as std_io from "velt/io";
import * as std_jsx from "velt/jsx";
import * as std_jsx_attrs from "velt/jsx/attrs";
import * as std_jsx_generic_jsx_runtime from "velt/jsx/generic/jsx-runtime";
import * as std_jsx_jsx_runtime from "velt/jsx/jsx-runtime";
import * as std_math from "velt/math";
import * as std_mem from "velt/mem";
import * as std_native from "velt/native";
import * as std_net from "velt/net";
import * as std_net_dns from "velt/net/dns";
import * as std_net_http from "velt/net/http";
import * as std_net_http_h2 from "velt/net/http/h2";
import * as std_net_udp from "velt/net/udp";
import * as std_net_url from "velt/net/url";
import * as std_net_websocket from "velt/net/websocket";
import * as std_os from "velt/os";
import * as std_package from "velt/package";
import * as std_path from "velt/path";
import * as std_process from "velt/process";
import * as std_process_child from "velt/process/child";
import * as std_random from "velt/random";
import * as std_random_uuid from "velt/random/uuid";
import * as std_simd from "velt/simd";
import * as std_sync from "velt/sync";
import * as std_sync_epoch from "velt/sync/epoch";
import * as std_task from "velt/task";
import * as std_test from "velt/test";
import * as std_test_http from "velt/test/http";
import * as std_text from "velt/text";
import * as std_time from "velt/time";

function main() {
  const p = join("a", "b");
  console.log(`${p} ${existsSync(p)} ${clamp(gcd(12, 18), 0, 5)} ${argv().length}`);
  console.log(process.env.HOME ?? "");
  const opts: RequestInit = { method: "GET" };
  const r = new Response("ok");
  r.headers.set("x-a", "1");
  console.log(`${opts.method} ${r.headers.get("x-a")}`);
  const px: any = new Proxy({ a: 1 }, {});
  console.log(Reflect.has(px, "a"));
}
