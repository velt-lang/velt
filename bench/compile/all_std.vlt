function main() {
  const p = join("a", "b");
  console.log(`${p} ${existsSync(p)} ${clamp(gcd(12, 18), 0, 5)} ${argv().length}`);
  console.log(process.env.HOME ?? "");
  const opts: HttpServeOptions = { port: 0 };
  const r = new Response("ok");
  r.headers.set("x-a", "1");
  console.log(`${opts.port} ${r.headers.get("x-a")}`);
  const px: any = new Proxy({ a: 1 }, {});
  console.log(Reflect.has(px, "a"));
}
