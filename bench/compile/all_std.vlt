// Compile-time benchmark input: imports every std module (so sema checks all of std and the
// prelude), with a small main that touches each one, and names the globals loaded on demand
// whose modules nothing imports (`Proxy` and `Reflect`, std/prelude/global/proxy.vlt).
import { existsSync } from "velt:fs";
import { ServeOptions } from "velt:http";
import { ioError } from "velt:io";
import { Value } from "velt:json";
import { clamp, gcd } from "velt:math";
import { connect } from "velt:net";
import { writeBytesTo } from "velt:net_bytes";
import { join } from "velt:path";
import { argv } from "velt:process";

function main() {
  const p = join("a", "b");
  console.log(`${p} ${existsSync(p)} ${clamp(gcd(12, 18), 0, 5)} ${argv().length}`);
  console.log(process.env.HOME ?? "");
  const opts: ServeOptions = { port: 0 };
  const r = new Response("ok");
  r.headers.set("x-a", "1");
  console.log(`${opts.port} ${r.headers.get("x-a")}`);
  const px: any = new Proxy({ a: 1 }, {});
  console.log(Reflect.has(px, "a"));
}
