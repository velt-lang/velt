// A small async program (bench/compile/edit_loop.sh): what the executor costs a build, against
// its sync twin sync_fs.velt.
import { readFile, writeFile } from "velt/fs";
import { tmpdir } from "velt/os";

async function main() {
  const path = `${tmpdir()}/velt-edit-loop-async.txt`;
  await writeFile(path, "hello async\n");
  console.log((await readFile(path)).length);
}
