// Floating-point and number-typed loops: dot products, a numeric integral, a prime sieve on
// number[] indexed with number variables.
function dot(a: number[], b: number[]): number {
  let s = 0.0;
  for (let i = 0; i < a.length; i++) s += a[i] * b[i];
  return s;
}

function sieve(n: number): number {
  const flags: boolean[] = [];
  for (let i = 0; i <= n; i++) flags.push(true);
  let count = 0;
  for (let i = 2; i <= n; i++) {
    if (flags[i]) {
      count++;
      for (let j = i * i; j <= n; j += i) flags[j] = false;
    }
  }
  return count;
}

function main() {
  const a: number[] = [];
  const b: number[] = [];
  for (let i = 0; i < 1000000; i++) {
    a.push(((i * 7919) % 1000) / 1000 - 0.5);
    b.push(((i * 104729) % 1000) / 1000 - 0.5);
  }
  let d = 0.0;
  for (let r = 0; r < 50; r++) d += dot(a, b);
  let integral = 0.0;
  const n = 20000000;
  const h = 1 / n;
  for (let i = 0; i < n; i++) {
    const x = (i + 0.5) * h;
    integral += Math.sqrt(1 - x * x) * h;
  }
  console.log(d.toFixed(6), integral.toFixed(9), sieve(10000000));
}
