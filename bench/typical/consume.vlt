// A parser that consumes its input from the front, as hand-written TypeScript parsers often do:
// look at the start of `rest`, take a token, then `rest = rest.slice(n)` (#402). It reads 10 MB
// of text as inputs of 1 KB, 1 MB and 10 MB, so the time per byte should not depend on the
// input's size. An argument N scales it: N bytes in all per size, as inputs of 1 KB, N/10 and N
// (bench/runtime_ab.sh passes 1000000, because a slice that copies takes hours at 10 MB).
function isWordCode(c: number): boolean {
  return (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c === 95;
}

function parse(text: string): number[] {
  let rest = text;
  let words = 0;
  let numbers = 0;
  let sum = 0;
  while (rest.length > 0) {
    const c = rest.charCodeAt(0);
    if (c === 32 || c === 10) {
      rest = rest.slice(1);
    } else if (c >= 48 && c <= 57) {
      let i = 1;
      while (i < rest.length && rest.charCodeAt(i) >= 48 && rest.charCodeAt(i) <= 57) i++;
      numbers++;
      sum += i;
      rest = rest.slice(i);
    } else if (isWordCode(c)) {
      let i = 1;
      while (i < rest.length && isWordCode(rest.charCodeAt(i))) i++;
      words++;
      sum += i;
      rest = rest.slice(i);
    } else {
      sum += c;
      rest = rest.slice(1);
    }
  }
  return [words, numbers, sum];
}

function makeText(size: number): string {
  const parts: string[] = [];
  let n = 0;
  let x = 1;
  while (n < size) {
    x = (x * 48271) % 2147483647;
    const kind = x % 3;
    const piece =
      kind === 0 ? `${x % 1000} ` : kind === 1 ? `name_${x % 97}, ` : `v${x % 13} = (a + b);\n`;
    parts.push(piece);
    n += piece.length;
  }
  return parts.join("").slice(0, size);
}

function main() {
  const total: number = process.argv.length > 2 ? Number(process.argv[2]) : 10000000;
  const sizes: number[] = [1000, total / 10, total];
  for (const size of sizes) {
    const text = makeText(size);
    let words: number = 0;
    let numbers: number = 0;
    let sum: number = 0;
    for (let rep: number = 0; rep < total / size; rep++) {
      const r = parse(text);
      words += r[0];
      numbers += r[1];
      sum += r[2];
    }
    console.log(size, words, numbers, sum);
  }
}
