// The TechEmpower plaintext and JSON tests on velt:http/server, the HTTP/1.1 server written in
// Velt on std/net (not std/http, which is hyper): bench/web/README.md, `velt-native`.
// Usage: server [port]; env PORT, HOST (127.0.0.1).

import { HttpRequest, HttpResponse, serve } from "velt:http/server";
import { args } from "velt:process";
import { renderToString, renderToStringSync, renderToStream } from "velt:jsx";
import { asyncPage, page } from "./page";

class Message {
  message: string;

  constructor(message: string) {
    this.message = message;
  }
}

async function main() {
  const argv = args();
  const port = Number(argv.length > 0 ? argv[0] : process.env.PORT ?? "8080");
  const host = process.env.HOST ?? "127.0.0.1";
  await serve({ port: port, host: host }, async (req: HttpRequest, res: HttpResponse) => {
    if (req.pathIs("/plaintext")) {
      res.send("Hello, World!");
    } else if (req.pathIs("/json")) {
      // Serialized per request, as the rules ask.
      res.json(JSON.stringify(new Message("Hello, World!")));
    } else if (req.pathIs("/tsx")) {
      res.html(renderToStringSync(page()));
    } else if (req.pathIs("/tsx-async")) {
      const html = await renderToString(asyncPage());
      res.html(html);
    } else if (req.pathIs("/tsx-stream")) {
      await res.sendStream(renderToStream(asyncPage()));
    } else {
      res.status(404);
      res.send("Not Found");
    }
  });
}
