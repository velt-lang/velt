// The routes of ./server.vlt on velt:http (hyper), to compare velt:http/server with
// (bench/web/README.md, `velt-native`): /json, /plaintext and the TSX fortunes page whole, with
// an async component and streamed. Usage: std_http [port]; env PORT, HOST (127.0.0.1).

import { serve } from "velt:http";
import { args } from "velt:process";
import { renderToString, renderToStringSync, renderToStream } from "velt:jsx";
import { asyncPage, page } from "./page";

class Message {
  message: string;

  constructor(message: string) {
    this.message = message;
  }
}

const HTML = "text/html; charset=utf-8";

async function main() {
  const argv = args();
  const port = Number(argv.length > 0 ? argv[0] : process.env.PORT ?? "8080");
  const host = process.env.HOST ?? "127.0.0.1";
  await serve({ port: port, host: host }, async (req: Request): Promise<Response> => {
    const path = new URL(req.url).pathname;
    if (path == "/plaintext") {
      return new Response("Hello, World!");
    }
    if (path == "/json") {
      return Response.json(new Message("Hello, World!"));
    }
    if (path == "/tsx") {
      return new Response(renderToStringSync(page()), { headers: { "content-type": HTML } });
    }
    if (path == "/tsx-async") {
      const html = await renderToString(asyncPage());
      return new Response(html, { headers: { "content-type": HTML } });
    }
    if (path == "/tsx-stream") {
      return new Response(renderToStream(asyncPage()), { headers: { "content-type": HTML } });
    }
    return new Response("Not Found", { status: 404 });
  });
}
