// An HTTP/1.1 server written in Velt on std/net (bench/web/README.md, `velt-native`): keep-alive
// and pipelining, requests parsed in place from the connection's own read buffer, responses
// built into one buffer per connection and written once per batch of requests. A prototype for
// a std HTTP/1.1 server: bodies by Content-Length only (chunked requests get 501).
//
// No module state on the request path: a module-level constant whose value is not a literal
// (`const X = utf8Encode(...)`) is module state, which one process-wide lock guards for each
// poll of every task that touches it, so every connection would wait for the others. The byte
// strings below are made per connection instead.

import { listen, TcpStream } from "velt:net";
import { utf8Encode } from "velt:encoding";

const CR: u8 = 13;
const LF: u8 = 10;
const SP: u8 = 32;
const COLON: u8 = 58;
/// The buffer a connection starts with; it grows for a request that does not fit.
const INITIAL: i64 = 16384;
/// Read at least this much at a time.
const MIN_READ: i64 = 4096;
/// A request head (request line and headers) larger than this is refused (431).
const MAX_HEAD: i64 = 65536;
/// A request body larger than this is refused (413).
const MAX_BODY: i64 = 8388608;

/// A request parsed in place: ranges of the connection's read buffer, valid until the handler
/// returns.
export class Request {
  buf: u8[] = [];
  methodStart: i64 = 0;
  methodEnd: i64 = 0;
  targetStart: i64 = 0;
  targetEnd: i64 = 0;
  bodyStart: i64 = 0;
  bodyEnd: i64 = 0;
  /// The connection stays open after the response (HTTP/1.1 unless `Connection: close`).
  keepAlive: bool = true;

  /// Is the method `m` (bytes, e.g. `GET`)?
  methodIs(m: u8[]): bool {
    return rangeIs(this.buf, this.methodStart, this.methodEnd, m);
  }

  /// Is the path (the target up to `?`) `p`?
  pathIs(p: u8[]): bool {
    let end = this.targetStart;
    while (end < this.targetEnd && this.buf[end] != 63) {
      end++;
    }
    return rangeIs(this.buf, this.targetStart, end, p);
  }

  /// The request target as a string (allocates).
  target(): string {
    return new TextDecoder().decode(this.buf.slice(this.targetStart, this.targetEnd));
  }

  /// The body's bytes (a copy).
  body(): u8[] {
    return this.buf.slice(this.bodyStart, this.bodyEnd);
  }
}

function rangeIs(buf: u8[], start: i64, end: i64, want: u8[]): bool {
  if (end - start != (want.length as i64)) {
    return false;
  }
  for (let i: i64 = 0; i < end - start; i++) {
    if (buf[start + i] != want[i]) {
      return false;
    }
  }
  return true;
}

/// Is `buf[start..end)` `want` (lowercase ASCII), ignoring case?
function rangeIsLower(buf: u8[], start: i64, end: i64, want: u8[]): bool {
  if (end - start != (want.length as i64)) {
    return false;
  }
  for (let i: i64 = 0; i < end - start; i++) {
    if ((buf[start + i] | 32) != want[i]) {
      return false;
    }
  }
  return true;
}

/// Why a request could not be parsed: the status to answer with before closing.
class BadRequest {
  status: i64;

  constructor(status: i64) {
    this.status = status;
  }
}

/// A connection's read buffer and the requests in it.
class Parser {
  buf: u8[] = Buffer.alloc(INITIAL as usize);
  pos: i64 = 0; // the first byte of the next request
  end: i64 = 0; // bytes read
  scanned: i64 = 0; // the head's end was searched for up to here
  // The header names and values that matter (lowercase).
  private contentLength: u8[] = utf8Encode("content-length");
  private connection: u8[] = utf8Encode("connection");
  private transferEncoding: u8[] = utf8Encode("transfer-encoding");
  private close: u8[] = utf8Encode("close");
  private keepAlive: u8[] = utf8Encode("keep-alive");

  /// Reads what `conn` has into the buffer: the bytes read, 0 when nothing has arrived yet,
  /// null at the end of the stream.
  readFrom(conn: TcpStream): number | null {
    if (this.pos == this.end) {
      this.pos = 0;
      this.end = 0;
      this.scanned = 0;
    }
    if (this.end + MIN_READ > (this.buf.length as i64)) {
      this.room(MIN_READ);
    }
    const n = conn.tryRead(this.buf, this.end as number, this.buf.length as number);
    if (n != null && n > 0) {
      this.end += n as i64;
    }
    return n;
  }

  /// Room for `n` more bytes: drops what was parsed, then grows by doubling.
  private room(n: i64) {
    if (this.pos > 0) {
      this.buf.copyWithin(0, this.pos as number, this.end as number);
      this.end -= this.pos;
      this.scanned -= this.pos;
      this.pos = 0;
    }
    if (this.end + n > (this.buf.length as i64)) {
      let size = (this.buf.length as i64) * 2;
      while (size < this.end + n) {
        size *= 2;
      }
      const grown = Buffer.alloc(size as usize);
      grown.set(this.buf.slice(0, this.end), 0);
      this.buf = grown;
    }
  }

  /// The next complete request into `req`: true when there is one, false when more input is
  /// needed. Throws `BadRequest` for input that is not a request.
  next(req: Request): bool {
    const b = this.buf;
    // The end of the head: the first CR LF CR LF.
    let i = this.scanned < this.pos + 3 ? this.pos + 3 : this.scanned;
    let headEnd: i64 = -1;
    while (i < this.end) {
      if (b[i] == LF && b[i - 1] == CR && b[i - 2] == LF && b[i - 3] == CR) {
        headEnd = i + 1;
        break;
      }
      i++;
    }
    if (headEnd < 0) {
      this.scanned = i;
      if (this.end - this.pos > MAX_HEAD) {
        throw new BadRequest(431);
      }
      return false;
    }
    // The request line: METHOD SP target SP HTTP/1.x CR LF.
    let p = this.pos;
    // Empty lines before a request are ignored (RFC 9112 §2.2).
    while (p + 1 < headEnd && b[p] == CR && b[p + 1] == LF) {
      p += 2;
    }
    req.buf = b;
    req.methodStart = p;
    while (p < headEnd && b[p] != SP) {
      p++;
    }
    req.methodEnd = p;
    p++;
    req.targetStart = p;
    while (p < headEnd && b[p] != SP) {
      p++;
    }
    req.targetEnd = p;
    p++;
    if (req.methodEnd == req.methodStart || req.targetEnd == req.targetStart || p + 8 > headEnd) {
      throw new BadRequest(400);
    }
    // HTTP/1.1 keeps the connection open by default, HTTP/1.0 closes it.
    const minor = b[p + 7];
    if (b[p] != 72 || b[p + 4] != 47 || b[p + 5] != 49 || b[p + 6] != 46) {
      throw new BadRequest(400);
    }
    req.keepAlive = minor == 49;
    while (p < headEnd && b[p] != LF) {
      p++;
    }
    p++;
    // The headers that matter here; the others are skipped.
    let length: i64 = 0;
    while (p < headEnd - 2) {
      const nameStart = p;
      while (p < headEnd && b[p] != COLON && b[p] != CR) {
        p++;
      }
      if (b[p] != COLON) {
        throw new BadRequest(400);
      }
      const nameEnd = p;
      p++;
      while (b[p] == SP || b[p] == 9) {
        p++;
      }
      const valueStart = p;
      while (b[p] != CR) {
        p++;
      }
      let valueEnd = p;
      while (valueEnd > valueStart && (b[valueEnd - 1] == SP || b[valueEnd - 1] == 9)) {
        valueEnd--;
      }
      p += 2;
      const len = nameEnd - nameStart;
      if (len == 14 && rangeIsLower(b, nameStart, nameEnd, this.contentLength)) {
        length = 0;
        if (valueStart == valueEnd) {
          throw new BadRequest(400);
        }
        for (let k = valueStart; k < valueEnd; k++) {
          const d = (b[k] as i64) - 48;
          if (d < 0 || d > 9 || length > MAX_BODY) {
            throw new BadRequest(d < 0 || d > 9 ? 400 : 413);
          }
          length = length * 10 + d;
        }
      } else if (len == 10 && rangeIsLower(b, nameStart, nameEnd, this.connection)) {
        if (rangeIsLower(b, valueStart, valueEnd, this.close)) {
          req.keepAlive = false;
        } else if (rangeIsLower(b, valueStart, valueEnd, this.keepAlive)) {
          req.keepAlive = true;
        }
      } else if (len == 17 && rangeIsLower(b, nameStart, nameEnd, this.transferEncoding)) {
        throw new BadRequest(501);
      }
    }
    if (length > MAX_BODY) {
      throw new BadRequest(413);
    }
    if (this.end - headEnd < length) {
      // The body has not all arrived: room for it, and the head is parsed again then.
      if (headEnd + length > (this.buf.length as i64)) {
        this.room(headEnd + length - this.end);
      }
      this.scanned = this.pos;
      return false;
    }
    req.bodyStart = headEnd;
    req.bodyEnd = headEnd + length;
    this.pos = headEnd + length;
    this.scanned = this.pos;
    return true;
  }
}

/// The responses to the requests of one batch, written to the connection in one go.
export class Response {
  buf: u8[] = Buffer.alloc(INITIAL as usize);
  length: i64 = 0;
  /// `Date` header bytes for `dateSecond` (recomputed once a second, checked once a batch).
  private date: u8[] = [];
  private dateSecond: i64 = -1;
  /// The request being answered keeps the connection open.
  keepAlive: bool = true;
  // The content types `send` takes by number (TEXT, JSON, HTML).
  private types: u8[][] = [
    utf8Encode("text/plain"),
    utf8Encode("application/json"),
    utf8Encode("text/html; charset=utf-8"),
  ];
  // The fixed parts of a response head.
  private ok: u8[] = utf8Encode("HTTP/1.1 200 OK\r\nServer: Velt\r\nDate: ");
  private statusStart: u8[] = utf8Encode("HTTP/1.1 ");
  private serverDate: u8[] = utf8Encode("\r\nServer: Velt\r\nDate: ");
  private contentType: u8[] = utf8Encode("\r\nContent-Type: ");
  private contentLengthHead: u8[] = utf8Encode("\r\nContent-Length: ");
  private connectionClose: u8[] = utf8Encode("\r\nConnection: close");
  private headEnd: u8[] = utf8Encode("\r\n\r\n");

  private reserve(n: i64) {
    if (this.length + n <= (this.buf.length as i64)) {
      return;
    }
    let size = (this.buf.length as i64) * 2;
    while (size < this.length + n) {
      size *= 2;
    }
    const grown = Buffer.alloc(size as usize);
    grown.set(this.buf.slice(0, this.length), 0);
    this.buf = grown;
  }

  private byte(b: u8) {
    this.buf[this.length] = b;
    this.length++;
  }

  /// The bytes of `data`.
  bytes(data: u8[]) {
    this.reserve(data.length as i64);
    this.buf.set(data, this.length as usize);
    this.length += data.length as i64;
  }

  /// The UTF-8 bytes of `s`, written in place when it is ASCII.
  text(s: string) {
    const n = s.length as i64;
    this.reserve(n);
    for (let i = 0; i < s.length; i++) {
      const c = s.charCodeAt(i);
      if (c >= 128) {
        // Not ASCII: what was written of it is dropped and its UTF-8 bytes go instead.
        this.length -= i as i64;
        this.bytes(utf8Encode(s));
        return;
      }
      this.buf[this.length] = c as u8;
      this.length++;
    }
  }

  /// The decimal digits of `n` (not negative).
  private number(n: i64) {
    this.reserve(20);
    const start = this.length;
    let v = n;
    do {
      this.byte((48 + v % 10) as u8);
      v = v / 10;
    } while (v > 0);
    let i = start;
    let j = this.length - 1;
    while (i < j) {
      const t = this.buf[i];
      this.buf[i] = this.buf[j];
      this.buf[j] = t;
      i++;
      j--;
    }
  }

  /// A whole response: status line, Server, Date, Content-Type (`type`: TEXT, JSON or HTML),
  /// Content-Length, then `body`.
  send(status: i64, type: i64, body: u8[]) {
    this.head(status, type, body.length as i64);
    this.bytes(body);
  }

  /// [`send`] with a text body.
  sendText(status: i64, type: i64, body: string) {
    this.head(status, type, Buffer.byteLength(body) as i64);
    this.text(body);
  }

  /// [`bytes`] of a field of `this` (`this.bytes(this.f)` would pass `this` twice).
  private piece(p: u8[]) {
    const n = p.length as i64;
    this.reserve(n);
    this.buf.set(p, this.length as usize);
    this.length += n;
  }

  private head(status: i64, type: i64, length: i64) {
    if (status == 200) {
      const ok = this.ok;
      this.piece(ok);
    } else {
      const start = this.statusStart;
      this.piece(start);
      this.number(status);
      this.byte(SP);
      this.text(reason(status));
      const sd = this.serverDate;
      this.piece(sd);
    }
    const date = this.date;
    this.piece(date);
    const ct = this.contentType;
    this.piece(ct);
    const t = this.types[type];
    this.piece(t);
    const cl = this.contentLengthHead;
    this.piece(cl);
    this.number(length);
    if (!this.keepAlive) {
      const close = this.connectionClose;
      this.piece(close);
    }
    const end = this.headEnd;
    this.piece(end);
  }

  /// The `Date` header for this batch of responses (once a second a new one).
  tick() {
    const now = Date.now();
    const second = (now / 1000) as i64;
    if (second != this.dateSecond) {
      this.dateSecond = second;
      this.date = utf8Encode(new Date(now).toUTCString());
    }
  }

  clear() {
    this.length = 0;
  }
}

function reason(status: i64): string {
  if (status == 200) {
    return "OK";
  }
  if (status == 400) {
    return "Bad Request";
  }
  if (status == 404) {
    return "Not Found";
  }
  if (status == 413) {
    return "Content Too Large";
  }
  if (status == 431) {
    return "Request Header Fields Too Large";
  }
  if (status == 500) {
    return "Internal Server Error";
  }
  if (status == 501) {
    return "Not Implemented";
  }
  return "Unknown";
}

/// Content types for `Response.send`.
export const TEXT: i64 = 0;
export const JSON_TYPE: i64 = 1;
export const HTML: i64 = 2;

/// Answers a request into `res` (`res.send`); runs on the connection's task.
export type Handler = (req: Request, res: Response) => void;

/// Makes a connection's handler (once per connection: what it prepares is its own, not module
/// state).
export type Setup = () => Handler;

async function connection(conn: TcpStream, setup: Setup): Promise<void> {
  const handler = setup();
  const parser = new Parser();
  const req = new Request();
  const res = new Response();
  try {
    let open = true;
    while (open) {
      const n = parser.readFrom(conn);
      if (n == null) {
        break;
      }
      if (n == 0) {
        await conn.readable();
        continue;
      }
      // Every complete request read so far, answered into one buffer.
      res.tick();
      try {
        while (open && parser.next(req)) {
          res.keepAlive = req.keepAlive;
          handler(req, res);
          open = req.keepAlive;
        }
      } catch (e) {
        if (e instanceof BadRequest) {
          res.keepAlive = false;
          res.sendText(e.status, TEXT, reason(e.status));
        }
        open = false;
      }
      if (res.length > 0) {
        await conn.writeBytes(res.buf, 0, res.length as number);
        res.clear();
      }
    }
  } catch (e) {
    // The client went away.
  }
  conn.close();
}

/// Serves on `addr` ("host:port") until the process ends: each connection gets the handler
/// `setup` makes.
export async function serve(addr: string, setup: Setup): Promise<void> {
  const listener = await listen(addr);
  while (true) {
    const conn = await listener.accept();
    spawn(connection(conn, setup));
  }
}
