// A map with 200,000 string keys, 40% of them deleted (tombstones, no compaction), read 5
// times (forEach and for...of). Value type `number | null`. See run.sh.

function main() {
  const m = new Map<string, number | null>();
  for (let i = 0; i < 200000; i++) {
    m.set(`k${i}`, i);
  }
  for (let i = 0; i < 200000; i++) {
    if (i % 5 < 2) {
      m.delete(`k${i}`);
    }
  }
  let total = 0;
  for (let round = 0; round < 5; round++) {
    m.forEach((v, k) => {
      total++;
    });
    for (const [k, v] of m) {
      total++;
    }
  }
  console.log(m.size, total);
}
