// The baseline of spread_gen.vlt: a hand-written loop pushing 0..N into an array, which is then
// summed modulo a prime.
function main(): void {
  let sum = 0;
  for (let round = 0; round < 20; round++) {
    const xs: i64[] = [];
    let i = 0;
    while (i < 5000000) {
      xs.push(i);
      i++;
    }
    for (const x of xs) {
      sum += x;
      if (sum >= 1000000007) {
        sum -= 1000000007;
      }
    }
  }
  console.log(sum);
}
