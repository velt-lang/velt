import type { Package } from "velt/package";

// The benchmark's Velt programs, on the repository's HTTP server and database packages (their
// native libraries are built with cargo the first time).
export const pkg: Package = {
  name: "chat-bench",
  version: "0.1.0",
  // Packages with native code run with no safety net, so the program lists the ones it trusts.
  allowNative: ["sqlite"],
  dependencies: {
    "http-server": { path: "../../../packages/http-server" },
    sqlite: { path: "../../../packages/sqlite" },
  },
};
