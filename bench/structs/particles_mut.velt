// A particle update over `Vec2[]` arrays of a mutable record written in place: the same values
// as particles_struct.velt, but `Vec2` is an object type and each position and velocity is
// updated field by field (`v.y = …`), which an immutable `struct` does not allow.
type Vec2 = { x: number; y: number };

function add(a: Vec2, o: Vec2): Vec2 {
  return { x: a.x + o.x, y: a.y + o.y };
}

function scale(a: Vec2, k: number): Vec2 {
  return { x: a.x * k, y: a.y * k };
}

function main() {
  const n = 10000;
  const pos: Vec2[] = [];
  const vel: Vec2[] = [];
  for (let i = 0; i < n; i++) {
    pos.push({ x: (i % 100) * 0.1, y: 1 + (i % 37) * 0.25 });
    vel.push({ x: ((i % 7) - 3) * 0.5, y: (i % 11) * 0.2 });
  }
  const g: Vec2 = { x: 0, y: -9.81 };
  const dt = 0.001;
  for (let s = 0; s < 500; s++) {
    for (let i = 0; i < n; i++) {
      const v = vel[i];
      v.x = v.x + g.x * dt;
      v.y = v.y + g.y * dt;
      const p = pos[i];
      p.x = p.x + v.x * dt;
      p.y = p.y + v.y * dt;
      if (p.y < 0) {
        p.y = -p.y;
        v.y = -v.y * 0.9;
      }
    }
  }
  let sx: number = 0;
  let sy: number = 0;
  for (let i = 0; i < n; i++) {
    sx += pos[i].x;
    sy += pos[i].y + vel[i].y;
  }
  console.log(sx.toFixed(6), sy.toFixed(6));
}
