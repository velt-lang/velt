// Vector math in a loop, n-body style, with classes: the usual TypeScript style, `new Vec3`
// for every intermediate result and bodies replaced whole in a `Body[]` array.
class Vec3 {
  x: number;
  y: number;
  z: number;

  constructor(x: number, y: number, z: number) {
    this.x = x;
    this.y = y;
    this.z = z;
  }

  add(o: Vec3): Vec3 {
    return new Vec3(this.x + o.x, this.y + o.y, this.z + o.z);
  }

  sub(o: Vec3): Vec3 {
    return new Vec3(this.x - o.x, this.y - o.y, this.z - o.z);
  }

  scale(k: number): Vec3 {
    return new Vec3(this.x * k, this.y * k, this.z * k);
  }

  dot(o: Vec3): number {
    return this.x * o.x + this.y * o.y + this.z * o.z;
  }
}

class Body {
  pos: Vec3;
  vel: Vec3;
  mass: number;

  constructor(pos: Vec3, vel: Vec3, mass: number) {
    this.pos = pos;
    this.vel = vel;
    this.mass = mass;
  }
}

function makeBodies(n: number): Body[] {
  const bs: Body[] = [];
  for (let i = 0; i < n; i++) {
    const sign = i % 2 == 0 ? 1.0 : -1.0;
    bs.push(
      new Body(
        new Vec3(i * 1.5, i * 0.5 - 1, 0.1 * i),
        new Vec3(0.01 * i, 0.3 * sign, -0.02 * i),
        1 + i * 0.25,
      ),
    );
  }
  return bs;
}

function step(bs: Body[], dt: number) {
  const n = bs.length;
  for (let i = 0; i < n; i++) {
    const b = bs[i];
    let acc = new Vec3(0, 0, 0);
    for (let j = 0; j < n; j++) {
      if (j == i) continue;
      const d = bs[j].pos.sub(b.pos);
      const r2 = d.dot(d) + 0.01;
      acc = acc.add(d.scale(bs[j].mass / (r2 * Math.sqrt(r2))));
    }
    bs[i] = new Body(b.pos, b.vel.add(acc.scale(dt)), b.mass);
  }
  for (let i = 0; i < n; i++) {
    const b = bs[i];
    bs[i] = new Body(b.pos.add(b.vel.scale(dt)), b.vel, b.mass);
  }
}

function energy(bs: Body[]): number {
  let e: number = 0;
  for (let i = 0; i < bs.length; i++) {
    e += 0.5 * bs[i].mass * bs[i].vel.dot(bs[i].vel);
    for (let j = i + 1; j < bs.length; j++) {
      const d = bs[i].pos.sub(bs[j].pos);
      e -= (bs[i].mass * bs[j].mass) / Math.sqrt(d.dot(d) + 0.01);
    }
  }
  return e;
}

function main() {
  const bs = makeBodies(5);
  console.log(energy(bs).toFixed(9));
  for (let s = 0; s < 1000000; s++) {
    step(bs, 0.001);
  }
  console.log(energy(bs).toFixed(9));
}
