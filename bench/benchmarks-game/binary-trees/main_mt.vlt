// binary-trees (Benchmarks Game): multi-threaded Velt, the shape of Node #6 / Go #2 (one task
// per depth, results printed in order): `spawn` + `Promise.all` instead of worker threads.
import { args } from "velt:process";

const MIN_DEPTH = 4;

class TreeNode {
  left: TreeNode | null;
  right: TreeNode | null;

  constructor(left: TreeNode | null, right: TreeNode | null) {
    this.left = left;
    this.right = right;
  }

  // Counts the nodes. `?.` because fields can't be narrowed (`if (this.left === null)`).
  check(): i64 {
    return 1 + (this.left?.check() ?? 0) + (this.right?.check() ?? 0);
  }
}

function bottomUpTree(depth: i64): TreeNode {
  return depth > 0
    ? new TreeNode(bottomUpTree(depth - 1), bottomUpTree(depth - 1))
    : new TreeNode(null, null);
}

async function work(iterations: i64, depth: i64): Promise<string> {
  let check = 0;
  for (let i = 0; i < iterations; i++) {
    check += bottomUpTree(depth).check();
  }
  return `${iterations}\t trees of depth ${depth}\t check: ${check}`;
}

async function main() {
  const argv = args();
  const n = argv.length > 0 ? parseInt(argv[0]) as i64 : 10;
  const maxDepth = n > MIN_DEPTH + 2 ? n : MIN_DEPTH + 2;

  const stretchDepth = maxDepth + 1;
  console.log(
    `stretch tree of depth ${stretchDepth}\t check: ${bottomUpTree(stretchDepth).check()}`,
  );

  const longLivedTree = bottomUpTree(maxDepth);

  const tasks: Promise<string>[] = [];
  for (let depth = MIN_DEPTH; depth <= maxDepth; depth += 2) {
    const iterations = 1 << (maxDepth - depth + MIN_DEPTH);
    tasks.push(spawn(work(iterations, depth)));
  }
  for (const line of await Promise.all(tasks)) {
    console.log(line);
  }

  console.log(`long lived tree of depth ${maxDepth}\t check: ${longLivedTree.check()}`);
}
