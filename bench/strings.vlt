// Strings: build 1M lines with template literals, join them, and scan the result.
function main() {
  const lines: string[] = [];
  for (let i = 0; i < 1000000; i++) {
    const kind = i % 3 == 0 ? "fizz" : "buzz";
    lines.push(`line ${i}: ${kind} ${(i * i) % 1000} ok`);
  }
  const text = lines.join("\n");
  let digits = 0;
  for (let i: i64 = 0; i < (text.length as i64); i++) {
    const c = text.charCodeAt(i);
    if (c >= 48 && c <= 57) {
      digits++;
    }
  }
  console.log(lines.length, text.length, digits, lines[123456]);
}
