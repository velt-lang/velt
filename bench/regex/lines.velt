// Patterns that are no literal, searched for line by line, as a log or CSV scanner does: 2,000
// lines of 250 or 320 bytes, one `RegExp` per row, a `test` or `exec` per line
// (`bench/regex/run.sh` counts each row's instructions). The argument names the row, 0 to 7;
// without one, every row runs.
function lines(width: number): string[] {
  const out: string[] = [];
  for (let i = 0; i < 2000; i++) {
    let line = "";
    let k = i;
    while (line.length < width - 24) {
      line += "key" + (k % 97) + "=value" + (k % 13) + ", ";
      k = (k * 31 + 7) % 1000;
    }
    out.push(line.padEnd(width - 2, "x") + ", ");
  }
  return out;
}

function row(which: number): number {
  const width = which < 4 ? 320 : 250;
  const all = lines(width);
  let found = 0;
  const kind = which % 4;
  if (kind == 0) {
    const re = /(\w+)=(\d+);/;
    for (const line of all) {
      found += re.test(line) ? 1 : 0;
    }
  } else if (kind == 1) {
    const re = /(\w+), $/;
    for (const line of all) {
      found += re.exec(line)?.index ?? 0;
    }
  } else if (kind == 2) {
    const re = /([^,]*,)*#/;
    for (const line of all) {
      found += re.test(line) ? 1 : 0;
    }
  } else {
    const re = /value\d+;/i;
    for (const line of all) {
      found += re.test(line) ? 1 : 0;
    }
  }
  return found;
}

function main() {
  const which = process.argv.length > 2 ? parseInt(process.argv[2]) : -1;
  let total = 0;
  for (let r = 0; r < 8; r++) {
    if (which < 0 || which == r) {
      total += row(r);
    }
  }
  console.log(total);
}
