// The loop of dot_generic.vlt written on numbers (#2050).
function dot(a: number[], b: number[], zero: number): number {
  let s = zero;
  for (let i = 0; i < a.length; i++) {
    s += a[i] * b[i];
  }
  return s;
}

function main() {
  const n = 1000;
  const a: number[] = [];
  const b: number[] = [];
  for (let i = 0; i < n; i++) {
    a.push(i * 0.5);
    b.push(n - i);
  }
  let total = 0;
  for (let r = 0; r < 20000; r++) {
    total += dot(a, b, 0);
  }
  console.log(total);
}
