// Matrix multiplication through an indexer with two keys, `c[i, j] += a[i, k] * b[k, j]`
// (#2179); matmul_method.velt is the same loop with the method calls written out. Both run the
// same instructions in release builds.
class Matrix {
  data: f64[] = [];
  constructor(public n: usize) {
    for (let i: usize = 0; i < n * n; i++) this.data.push(0);
  }
  [Symbol.index](i: usize, j: usize): f64 { return this.data[i * this.n + j]; }
  [Symbol.setIndex](i: usize, j: usize, v: f64): void { this.data[i * this.n + j] = v; }
}

function mul(a: Matrix, b: Matrix, c: Matrix) {
  const n = a.n;
  for (let i: usize = 0; i < n; i++) {
    for (let k: usize = 0; k < n; k++) {
      for (let j: usize = 0; j < n; j++) {
        c[i, j] += a[i, k] * b[k, j];
      }
    }
  }
}

function main() {
  const n: usize = 120;
  const a = new Matrix(n);
  const b = new Matrix(n);
  const c = new Matrix(n);
  for (let i: usize = 0; i < n; i++) {
    for (let j: usize = 0; j < n; j++) {
      a[i, j] = (i + j) as f64 * 0.5;
      b[i, j] = (i * 2 + j) as f64 * 0.25;
    }
  }
  for (let r = 0; r < 4; r++) mul(a, b, c);
  console.log(c[3, 7], c[n - 1, n - 1]);
}
