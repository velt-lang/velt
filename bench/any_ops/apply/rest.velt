function pick(this: any, a: any, b: any): any {
  return this.base + (a as number) + (b as number);
}
const f: any = pick;
const self = { base: 1 };
const xs: any[] = [1, 2];
let sum = 0;
function run(...rest: any[]): any {
  return f.apply(self, rest);
}
for (let i = 0; i < 100000; i++) {
  sum += run(1, 2) as number;
}
console.log(sum);
