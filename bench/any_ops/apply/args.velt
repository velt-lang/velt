function pick(this: any, a: any, b: any): any {
  return this.base + (a as number) + (b as number);
}
const f: any = pick;
const self = { base: 1 };
const run: any = function (this: any) {
  return f.apply(this, arguments);
};
let sum = 0;
for (let i = 0; i < 100000; i++) {
  sum += run.call(self, 1, 2) as number;
}
console.log(sum);
