// 300 ECDSA P-256 verifications of RFC 6979 §A.2.5's SHA-256 signature of "sample".
import { p256Verify, sha256 } from "velt/crypto";
import { hexDecode, utf8Encode } from "velt/encoding";

function main() {
  const pub = hexDecode(
    "0460fed4ba255a9d31c961eb74c6356d68c049b8923b61fa6ce669622e60f29fb6" +
      "7903fe1008b8bc99a41ae9e95628bc64f2f1b20c2d7e9f5177a3c294d4462299",
  );
  const sig = hexDecode(
    "3046022100efd48b2aacb6a8fd1140dd9cd45e81d69d2c877b56aaf991c34d0ea84eaf3716" +
      "022100f7cb1c942d657c41d436c7a1b6e29f65f3e900dbb9aff4064dc4ab2f843acda8",
  );
  const digest = sha256(utf8Encode("sample"));
  let ok = 0;
  for (let i = 0; i < 300; i++) {
    if (p256Verify(pub, digest, sig)) {
      ok++;
    }
  }
  console.log(`${ok}`);
}
