// #3487 review: as ns_waiting_shared, then a promise of the task hands a holder of the first
// shared promise to worker 3, which takes that promise off the list and `side`, shared meanwhile,
// with it: `side`'s own hub takes its references back too.

class Holder {
  p: Promise<number>;
  constructor(p: Promise<number>) {
    this.p = p;
  }
}

const KEPT: Holder[] = [];
const PARKED = new Atomic<i64>(0);
const USED = new Atomic<i64>(0);

async function dead(): Promise<number> {
  return await new Promise<number>((resolve) => {});
}

async function inner(h: Holder): Promise<number> {
  return await h.p;
}

async function user(h: Holder): Promise<void> {
  await yieldNow();
  USED.add(1);
}

async function later(h: Holder): Promise<number> {
  await yieldNow();
  await yieldNow();
  void spawn(user(h), { worker: 3 });
  return 1;
}

async function maker(): Promise<number> {
  const d = new Holder(dead());
  KEPT.push(new Holder(d.p));
  const side = inner(d);
  const r = inner(d);
  await yieldNow();
  await yieldNow();
  const s = new Holder(side);
  KEPT.push(s);
  const q = s.p;
  void later(new Holder(d.p));
  PARKED.add(1);
  return (await d.p) + (await r) + (await q);
}

async function main() {
  const n: i64 = 20;
  for (let i: i64 = 0; i < n; i++) {
    void spawn(maker(), { worker: 1 + (i % 2) });
  }
  while (PARKED.load() < n || USED.load() < n) {
    await yieldNow();
  }
  for (let y = 0; y < 200; y++) {
    await yieldNow();
  }
  KEPT.length = 0;
  console.log(`parked ${PARKED.load()}`);
}
