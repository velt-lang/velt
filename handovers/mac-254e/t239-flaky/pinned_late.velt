// a_pinned_spawn_runs_its_timers's program, printing how late each pinned 5 ms timer ran (ms).
const T0 = new Atomic<i64>(0);

async function pinned(): Promise<i64> {
  const a = Date.now();
  await new Promise<void>((resolve) => setTimeout(() => resolve(), 5));
  const b = Date.now();
  setTimeout(() => console.log(`late ${b - a - 5} ${Date.now() - b - 5} ${Date.now() - T0.load()}`), 5);
  await sleep(2000);
  return 2;
}

async function main() {
  T0.store(Date.now());
  setTimeout(() => {}, 400);
  const n = await spawn(pinned(), { worker: 1 });
  console.log(n);
}
