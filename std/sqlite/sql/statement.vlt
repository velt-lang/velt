// velt:sqlite/sql/statement — the statements of SQLite's grammar besides SELECT: INSERT (with
// UPSERT and RETURNING), UPDATE, DELETE, CREATE TABLE / INDEX / VIEW, DROP, ALTER TABLE,
// BEGIN / COMMIT / ROLLBACK / SAVEPOINT / RELEASE, PRAGMA and EXPLAIN.

import { Parser } from "velt:sqlite/sql/parser";
import { SqlError, T_EOF, T_IDENT, T_OP, T_QUOTED, T_SEMI } from "velt:sqlite/sql/lexer";
import {
  ColumnDef,
  E_COLLATE,
  E_COLUMN,
  E_STAR,
  Expr,
  IndexedColumn,
  KeyConstraint,
  ResultColumn,
  S_ALTER,
  S_BEGIN,
  S_COMMIT,
  S_CREATE_INDEX,
  S_CREATE_TABLE,
  S_CREATE_VIEW,
  S_DELETE,
  S_DROP,
  S_EXPLAIN,
  S_INSERT,
  S_PRAGMA,
  S_RELEASE,
  S_ROLLBACK,
  S_SAVEPOINT,
  S_SELECT,
  S_UPDATE,
  Statement,
  Upsert,
} from "velt:sqlite/sql/ast";

/** Parses the statements of `sql` (separated by `;`; empty ones are skipped). */
export function parseAll(sql: string): Statement[] {
  const p = new Parser(sql);
  const out: Statement[] = [];
  while (true) {
    while (p.peek().kind == T_SEMI) {
      p.advance();
    }
    if (p.peek().kind == T_EOF) {
      return out;
    }
    out.push(statement(p));
    if (p.peek().kind != T_SEMI && p.peek().kind != T_EOF) {
      p.fail();
    }
  }
}

/** Parses exactly one statement (a trailing `;` is allowed). */
export function parseOne(sql: string): Statement {
  const all = parseAll(sql);
  if (all.length != 1) {
    throw new SqlError(all.length == 0 ? "not an error" : "more than one statement", 0);
  }
  return all[0];
}

/** One statement at the parser's position. */
export function statement(p: Parser): Statement {
  const from = p.peek().start;
  const s = verb(p);
  s.sql = p.text(from, p.peek().start).trimEnd();
  return s;
}

function verb(p: Parser): Statement {
  if (p.eatKw("EXPLAIN")) {
    const s = new Statement(S_EXPLAIN);
    if (p.eatKw("QUERY")) {
      p.expectKw("PLAN");
      s.queryPlan = true;
    }
    s.inner = verb(p);
    return s;
  }
  if (p.isKw("SELECT") || p.isKw("VALUES") || (p.isKw("WITH") && withSelect(p))) {
    const s = new Statement(S_SELECT);
    s.select = p.select();
    return s;
  }
  if (p.isKw("WITH")) {
    // WITH … INSERT / UPDATE / DELETE: the CTEs go on the statement's select.
    throw new SqlError("WITH before INSERT, UPDATE or DELETE is not supported yet", p.peek().start);
  }
  if (p.isKw("INSERT") || p.isKw("REPLACE")) {
    return insert(p);
  }
  if (p.eatKw("UPDATE")) {
    return update(p);
  }
  if (p.eatKw("DELETE")) {
    return remove(p);
  }
  if (p.eatKw("CREATE")) {
    return create(p);
  }
  if (p.eatKw("DROP")) {
    return drop(p);
  }
  if (p.eatKw("ALTER")) {
    return alter(p);
  }
  if (p.eatKw("BEGIN")) {
    const s = new Statement(S_BEGIN);
    if (p.isKw("DEFERRED") || p.isKw("IMMEDIATE") || p.isKw("EXCLUSIVE")) {
      s.mode = p.advance().upper;
    }
    p.eatKw("TRANSACTION");
    return s;
  }
  if (p.eatKw("COMMIT") || p.eatKw("END")) {
    p.eatKw("TRANSACTION");
    return new Statement(S_COMMIT);
  }
  if (p.eatKw("ROLLBACK")) {
    const s = new Statement(S_ROLLBACK);
    p.eatKw("TRANSACTION");
    if (p.eatKw("TO")) {
      p.eatKw("SAVEPOINT");
      s.name = p.name();
    }
    return s;
  }
  if (p.eatKw("SAVEPOINT")) {
    const s = new Statement(S_SAVEPOINT);
    s.name = p.name();
    return s;
  }
  if (p.eatKw("RELEASE")) {
    const s = new Statement(S_RELEASE);
    p.eatKw("SAVEPOINT");
    s.name = p.name();
    return s;
  }
  if (p.eatKw("PRAGMA")) {
    return pragma(p);
  }
  p.fail();
}

/** Whether WITH at the parser's position starts a SELECT (looks past the CTEs' parentheses). */
function withSelect(p: Parser): bool {
  let depth = 0;
  let k: usize = 0;
  while (true) {
    const t = p.peekAt(k);
    if (t.kind == T_EOF || t.kind == T_SEMI) {
      return true;
    }
    if (t.kind == T_OP && t.text == "(") {
      depth++;
    } else if (t.kind == T_OP && t.text == ")") {
      depth--;
    } else if (
      depth == 0 &&
      t.kind == T_IDENT &&
      (t.upper == "INSERT" || t.upper == "UPDATE" || t.upper == "DELETE" || t.upper == "REPLACE")
    ) {
      return false;
    } else if (depth == 0 && t.kind == T_IDENT && (t.upper == "SELECT" || t.upper == "VALUES")) {
      return true;
    }
    k++;
  }
}

/** schema.name or name. */
function qualified(p: Parser, s: Statement) {
  s.name = p.name();
  if (p.eatOp(".")) {
    s.schema = s.name;
    s.name = p.name();
  }
}

function names(p: Parser): string[] {
  p.expectOp("(");
  const out: string[] = [p.name()];
  while (p.eatOp(",")) {
    out.push(p.name());
  }
  p.expectOp(")");
  return out;
}

function returning(p: Parser, s: Statement) {
  if (!p.eatKw("RETURNING")) {
    return;
  }
  while (true) {
    if (p.isOp("*")) {
      const star = new Expr(E_STAR, p.advance().start);
      s.returning.push(ResultColumn { expr: star, alias: "" });
    } else {
      const e = p.expr();
      let alias = "";
      if (p.eatKw("AS") || p.isName()) {
        alias = p.name();
      }
      s.returning.push(ResultColumn { expr: e, alias: alias });
    }
    if (!p.eatOp(",")) {
      return;
    }
  }
}

function insert(p: Parser): Statement {
  const s = new Statement(S_INSERT);
  if (p.eatKw("REPLACE")) {
    s.orConflict = "REPLACE";
  } else {
    p.expectKw("INSERT");
    if (p.eatKw("OR")) {
      s.orConflict = conflictResolution(p);
    }
  }
  p.expectKw("INTO");
  qualified(p, s);
  if (p.eatKw("AS")) {
    s.alias = p.name();
  }
  if (p.isOp("(")) {
    s.columns = names(p);
  }
  if (p.eatKw("DEFAULT")) {
    p.expectKw("VALUES");
    s.defaultValues = true;
  } else if (p.isKw("VALUES") && !compoundValues(p)) {
    p.advance();
    while (true) {
      p.expectOp("(");
      const row: Expr[] = [p.expr()];
      while (p.eatOp(",")) {
        row.push(p.expr());
      }
      p.expectOp(")");
      s.rows.push(row);
      if (!p.eatOp(",")) {
        break;
      }
    }
  } else {
    s.select = p.select();
  }
  while (p.isKw("ON") && p.isKwAt(1, "CONFLICT")) {
    p.advance();
    p.advance();
    s.upserts.push(upsert(p));
  }
  returning(p, s);
  return s;
}

/** VALUES followed by UNION, ORDER BY or LIMIT is a select, not plain rows. */
function compoundValues(p: Parser): bool {
  let depth = 0;
  let k: usize = 0;
  while (true) {
    const t = p.peekAt(k);
    if (t.kind == T_EOF || t.kind == T_SEMI) {
      return false;
    }
    if (t.kind == T_OP && t.text == "(") {
      depth++;
    } else if (t.kind == T_OP && t.text == ")") {
      depth--;
    } else if (
      depth == 0 &&
      t.kind == T_IDENT &&
      (
        t.upper == "UNION" ||
        t.upper == "EXCEPT" ||
        t.upper == "INTERSECT" ||
        t.upper == "ORDER" ||
        t.upper == "LIMIT"
      )
    ) {
      return true;
    } else if (depth == 0 && t.kind == T_IDENT && (t.upper == "ON" || t.upper == "RETURNING")) {
      return false;
    }
    k++;
  }
}

function upsert(p: Parser): Upsert {
  const u = new Upsert();
  if (p.isOp("(")) {
    u.target = indexedColumns(p);
    if (p.eatKw("WHERE")) {
      u.targetWhere = p.expr();
    }
  }
  p.expectKw("DO");
  if (p.eatKw("NOTHING")) {
    return u;
  }
  p.expectKw("UPDATE");
  p.expectKw("SET");
  u.doNothing = false;
  assignments(p, u.setColumns, u.setValues);
  if (p.eatKw("WHERE")) {
    u.where = p.expr();
  }
  return u;
}

function assignments(p: Parser, columns: string[][], values: Expr[]) {
  while (true) {
    if (p.isOp("(")) {
      columns.push(names(p));
    } else {
      columns.push([p.name()]);
    }
    p.expectOp("=");
    values.push(p.expr());
    if (!p.eatOp(",")) {
      return;
    }
  }
}

/** ROLLBACK, ABORT, REPLACE, FAIL or IGNORE (after OR, or ON CONFLICT). */
function conflictResolution(p: Parser): string {
  const w = p.peek().upper;
  if (
    p.peek().kind != T_IDENT ||
    (w != "ROLLBACK" && w != "ABORT" && w != "REPLACE" && w != "FAIL" && w != "IGNORE")
  ) {
    p.fail();
  }
  p.advance();
  return w;
}

function update(p: Parser): Statement {
  const s = new Statement(S_UPDATE);
  if (p.eatKw("OR")) {
    s.orConflict = conflictResolution(p);
  }
  qualified(p, s);
  if (p.eatKw("AS")) {
    s.alias = p.name();
  } else if (p.isName() && !p.isKw("SET")) {
    s.alias = p.name();
  }
  p.expectKw("SET");
  assignments(p, s.setColumns, s.setValues);
  if (p.eatKw("FROM")) {
    s.from = p.fromItems();
  }
  if (p.eatKw("WHERE")) {
    s.where = p.expr();
  }
  returning(p, s);
  return s;
}

function remove(p: Parser): Statement {
  const s = new Statement(S_DELETE);
  p.expectKw("FROM");
  qualified(p, s);
  if (p.eatKw("AS")) {
    s.alias = p.name();
  }
  if (p.eatKw("WHERE")) {
    s.where = p.expr();
  }
  returning(p, s);
  return s;
}

function create(p: Parser): Statement {
  const temp = p.eatKw("TEMP") || p.eatKw("TEMPORARY");
  if (p.eatKw("TABLE")) {
    const s = createTable(p);
    s.temp = temp;
    return s;
  }
  const unique = p.eatKw("UNIQUE");
  if (p.eatKw("INDEX")) {
    const s = new Statement(S_CREATE_INDEX);
    s.unique = unique;
    s.ifNotExists = ifNotExists(p);
    qualified(p, s);
    p.expectKw("ON");
    s.table = p.name();
    s.indexed = indexedColumns(p);
    if (p.eatKw("WHERE")) {
      s.where = p.expr();
    }
    return s;
  }
  if (!unique && p.eatKw("VIEW")) {
    const s = new Statement(S_CREATE_VIEW);
    s.temp = temp;
    s.ifNotExists = ifNotExists(p);
    qualified(p, s);
    if (p.isOp("(")) {
      s.columns = names(p);
    }
    p.expectKw("AS");
    s.select = p.select();
    return s;
  }
  if (p.isKw("TRIGGER") || p.isKw("VIRTUAL")) {
    throw new SqlError(`CREATE ${p.peek().upper} is not supported yet`, p.peek().start);
  }
  p.fail();
}

function ifNotExists(p: Parser): bool {
  if (p.isKw("IF")) {
    p.advance();
    p.expectKw("NOT");
    p.expectKw("EXISTS");
    return true;
  }
  return false;
}

/** `(col [COLLATE c] [ASC|DESC], …)` of an index, a key or an upsert target. */
export function indexedColumns(p: Parser): IndexedColumn[] {
  p.expectOp("(");
  const out: IndexedColumn[] = [];
  while (true) {
    let e = p.expr();
    let collate = "";
    // `x COLLATE c` parses as an expression; keep the column and the collation apart.
    if (e.kind == E_COLLATE && e.a != null) {
      collate = e.name;
      e = e.a!;
    }
    let desc = false;
    if (p.eatKw("DESC")) {
      desc = true;
    } else {
      p.eatKw("ASC");
    }
    out.push(IndexedColumn { expr: e, collate: collate, desc: desc });
    if (!p.eatOp(",")) {
      break;
    }
  }
  p.expectOp(")");
  return out;
}

function createTable(p: Parser): Statement {
  const s = new Statement(S_CREATE_TABLE);
  s.ifNotExists = ifNotExists(p);
  qualified(p, s);
  if (p.eatKw("AS")) {
    s.select = p.select();
    return s;
  }
  p.expectOp("(");
  while (true) {
    if (
      p.isKw("CONSTRAINT") ||
      p.isKw("PRIMARY") ||
      p.isKw("UNIQUE") ||
      p.isKw("CHECK") ||
      p.isKw("FOREIGN")
    ) {
      tableConstraint(p, s);
    } else {
      const c = columnDef(p);
      s.columnDefs.push(c);
      columnKeys(s, c);
    }
    if (!p.eatOp(",")) {
      break;
    }
  }
  p.expectOp(")");
  /** Table options: WITHOUT ROWID, STRICT. */
  while (p.isKw("WITHOUT") || p.isKw("STRICT")) {
    if (p.eatKw("STRICT")) {
      s.strict = true;
    } else {
      p.advance();
      if (p.peek().upper != "ROWID") {
        p.fail();
      }
      p.advance();
      s.withoutRowid = true;
    }
    p.eatOp(",");
  }
  return s;
}

/** A column's PRIMARY KEY and UNIQUE constraints, as single-column keys. */
function columnKeys(s: Statement, c: ColumnDef) {
  const e = new Expr(E_COLUMN, 0);
  e.name = c.name;
  if (c.primaryKey) {
    const k = IndexedColumn { expr: e, collate: "", desc: c.desc };
    s.keys.push(KeyConstraint { primary: true, columns: [k] });
  }
  if (c.unique) {
    const k = IndexedColumn { expr: e, collate: "", desc: false };
    s.keys.push(KeyConstraint { primary: false, columns: [k] });
  }
}

function tableConstraint(p: Parser, s: Statement) {
  if (p.eatKw("CONSTRAINT")) {
    p.name();
  }
  if (p.eatKw("PRIMARY")) {
    p.expectKw("KEY");
    s.primaryKey = indexedColumns(p);
    s.keys.push(KeyConstraint { primary: true, columns: s.primaryKey });
    conflictClause(p);
  } else if (p.eatKw("UNIQUE")) {
    const u = indexedColumns(p);
    s.uniques.push(u);
    s.keys.push(KeyConstraint { primary: false, columns: u });
    conflictClause(p);
  } else if (p.eatKw("CHECK")) {
    p.expectOp("(");
    s.checks.push(p.expr());
    p.expectOp(")");
  } else if (p.eatKw("FOREIGN")) {
    p.expectKw("KEY");
    names(p);
    foreignKey(p);
  } else {
    p.fail();
  }
}

/** ON CONFLICT <resolution> of a constraint (kept by SQLite in the schema; enforced later). */
function conflictClause(p: Parser) {
  if (p.isKw("ON") && p.isKwAt(1, "CONFLICT")) {
    p.advance();
    p.advance();
    conflictResolution(p);
  }
}

function foreignKey(p: Parser) {
  p.expectKw("REFERENCES");
  p.name();
  if (p.isOp("(")) {
    names(p);
  }
  /** ON DELETE/UPDATE actions, MATCH, DEFERRABLE: read and kept in the schema text only. */
  while (
    p.isKw("ON") ||
    p.isKw("MATCH") ||
    p.isKw("DEFERRABLE") ||
    (p.isKw("NOT") && p.isKwAt(1, "DEFERRABLE"))
  ) {
    if (p.eatKw("ON")) {
      p.advance();
      if (p.eatKw("SET")) {
        p.advance();
      } else if (p.eatKw("NO")) {
        p.expectKw("ACTION");
      } else {
        p.advance();
      }
    } else if (p.eatKw("MATCH")) {
      p.name();
    } else {
      p.eatKw("NOT");
      p.expectKw("DEFERRABLE");
      if (p.eatKw("INITIALLY")) {
        p.advance();
      }
    }
  }
}

function columnDef(p: Parser): ColumnDef {
  const c = new ColumnDef(p.name());
  c.type = p.typeName();
  while (true) {
    if (p.eatKw("CONSTRAINT")) {
      p.name();
    }
    if (p.eatKw("PRIMARY")) {
      p.expectKw("KEY");
      c.primaryKey = true;
      if (p.eatKw("DESC")) {
        c.desc = true;
      } else {
        p.eatKw("ASC");
      }
      conflictClause(p);
      c.autoincrement = p.eatKw("AUTOINCREMENT");
    } else if (p.isKw("NOT") && p.isKwAt(1, "NULL")) {
      p.advance();
      p.advance();
      c.notNull = true;
      conflictClause(p);
    } else if (p.eatKw("NULL")) {
      conflictClause(p);
    } else if (p.eatKw("UNIQUE")) {
      c.unique = true;
      conflictClause(p);
    } else if (p.eatKw("CHECK")) {
      p.expectOp("(");
      c.check.push(p.expr());
      p.expectOp(")");
    } else if (p.eatKw("DEFAULT")) {
      if (p.eatOp("(")) {
        c.dflt = p.expr();
        p.expectOp(")");
      } else {
        // A literal, a signed number, or a bare word (taken as a string).
        c.dflt = p.unary();
      }
    } else if (p.eatKw("COLLATE")) {
      c.collate = p.name().toUpperCase();
    } else if (p.eatKw("REFERENCES")) {
      p.pos--;
      foreignKey(p);
    } else if (p.eatKw("GENERATED") || p.isKw("AS")) {
      if (!p.eatKw("AS")) {
        p.expectKw("ALWAYS");
        p.expectKw("AS");
      }
      p.expectOp("(");
      c.generated = p.expr();
      p.expectOp(")");
      if (p.eatKw("STORED")) {
        c.stored = true;
      } else {
        p.eatKw("VIRTUAL");
      }
    } else {
      return c;
    }
  }
}

function drop(p: Parser): Statement {
  const s = new Statement(S_DROP);
  const w = p.peek().upper;
  if (p.peek().kind != T_IDENT || (w != "TABLE" && w != "INDEX" && w != "VIEW" && w != "TRIGGER")) {
    p.fail();
  }
  p.advance();
  s.what = w;
  if (p.eatKw("IF")) {
    p.expectKw("EXISTS");
    s.ifExists = true;
  }
  qualified(p, s);
  return s;
}

function alter(p: Parser): Statement {
  const s = new Statement(S_ALTER);
  p.expectKw("TABLE");
  qualified(p, s);
  if (p.eatKw("RENAME")) {
    if (p.eatKw("TO")) {
      s.action = "RENAME";
      s.newName = p.name();
      return s;
    }
    p.eatKw("COLUMN");
    s.action = "RENAME COLUMN";
    s.columns = [p.name()];
    p.expectKw("TO");
    s.newName = p.name();
    return s;
  }
  if (p.eatKw("ADD")) {
    p.eatKw("COLUMN");
    s.action = "ADD COLUMN";
    s.column = columnDef(p);
    return s;
  }
  if (p.eatKw("DROP")) {
    p.eatKw("COLUMN");
    s.action = "DROP COLUMN";
    s.columns = [p.name()];
    return s;
  }
  p.fail();
}

function pragma(p: Parser): Statement {
  const s = new Statement(S_PRAGMA);
  qualified(p, s);
  s.name = s.name.toLowerCase();
  if (p.eatOp("=")) {
    s.value = pragmaValue(p);
  } else if (p.eatOp("(")) {
    s.value = pragmaValue(p);
    p.expectOp(")");
  }
  return s;
}

/**
 * A pragma's value: a signed number, a string, or a word as a column name, upper case (ON,
 * FULL, WAL, TRUE): any name, and the keywords ON, DELETE and DEFAULT, as SQLite's grammar.
 */
function pragmaValue(p: Parser): Expr {
  const t = p.peek();
  if (t.kind == T_IDENT || t.kind == T_QUOTED) {
    const w = t.upper;
    if (!p.isName() && w != "ON" && w != "DELETE" && w != "DEFAULT" && !isJoinWord(w)) {
      p.fail();
    }
    p.advance();
    const e = new Expr(E_COLUMN, t.start);
    e.name = w;
    return e;
  }
  return p.unary();
}

/** Join keywords, which SQLite also takes as names. */
function isJoinWord(w: string): bool {
  return w == "LEFT" ||
    w == "RIGHT" ||
    w == "FULL" ||
    w == "INNER" ||
    w == "OUTER" ||
    w == "CROSS" ||
    w == "NATURAL";
}
