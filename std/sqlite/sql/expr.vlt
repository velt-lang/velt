// velt/sqlite/sql/expr — the expressions of SQLite's grammar (parse.y),
// by recursive descent. SELECT and the statements are in velt/sqlite/sql/parser, a subclass
// (expressions hold subqueries, so they call its `select()`).
//
// Precedence, lowest first (https://sqlite.org/lang_expr.html#operators):
// OR; AND; NOT; = == != <> IS IN LIKE GLOB MATCH REGEXP BETWEEN ISNULL NOTNULL;
// < <= > >=; & | << >>; + -; * / %; || -> ->>; COLLATE; unary - + ~.
// The binary levels are parsed by precedence climbing (`binaryFrom`), and nesting is bounded
// (velt/sqlite/sql/cursor's `enter`), so deeply nested input fails with SQLite's error.

import {
  K_RESERVED,
  T_BLOB,
  T_IDENT,
  T_INTEGER,
  T_OP,
  T_PARAM,
  T_QUOTED,
  T_REAL,
  T_STRING,
  SqlError,
  Token,
  dequote,
} from "velt/sqlite/sql/lexer";
import {
  E_BETWEEN,
  E_BLOB,
  E_CALL,
  E_CASE,
  E_CAST,
  E_COLLATE,
  E_COLUMN,
  E_EXISTS,
  E_FALSE,
  E_IN_LIST,
  E_IN_SELECT,
  E_LIKE,
  E_NULL,
  E_PARAM,
  E_REAL,
  E_ROW,
  E_STAR,
  E_STRING,
  E_SUBQUERY,
  E_TRUE,
  E_UNARY,
  Expr,
  FromItem,
  Window,
  ResultColumn,
  Select,
  SelectCore,
} from "velt/sqlite/sql/ast";
import { TokenCursor } from "velt/sqlite/sql/cursor";
import {
  L_AND,
  L_CMP,
  L_CONCAT,
  L_EQ,
  L_NONE,
  L_NOT,
  L_OR,
  MAX_VARIABLE,
  binary,
  integerLiteral,
  isExpr,
  isMatchWord,
  isNull,
  opLevel,
  prefix,
  sized,
} from "velt/sqlite/sql/expr_tree";
import { strByteAt } from "velt/lang/intrinsics";

/** The expression grammar, on a token cursor. */
export abstract class ExprParser extends TokenCursor {
  /** `?` parameters are numbered in order; `?NNN` sets the counter. */
  params: i64 = 0;
  /** The index each named parameter was given at its first use. */
  names: Map<string, i64> = new Map<string, i64>();

  constructor(sql: string) {
    super(sql);
  }

  /** A whole SELECT (velt/sqlite/sql/parser). */
  abstract select(): Select;

  /** The window after OVER (velt/sqlite/sql/parser). */
  abstract over(): Window;

  // Expressions, lowest precedence first.

  expr(): Expr {
    this.enter();
    const e = this.binaryFrom(L_OR);
    this.leave();
    return e;
  }

  /**
   * An operand followed by the binary operators that bind at least as tightly as level `min`,
   * left to right (precedence climbing: one frame per level actually used, so nesting stays
   * cheap on the stack).
   */
  binaryFrom(min: i64): Expr {
    let e = this.collate();
    while (true) {
      const level = this.levelHere();
      if (level < min) {
        return e;
      }
      e = this.infix(e, level);
    }
  }

  /** The level of the binary operator at the cursor, or L_NONE. */
  levelHere(): i64 {
    const t = this.peek();
    if (t.kind == T_OP) {
      return opLevel(t.text);
    }
    if (t.kind != T_IDENT) {
      return L_NONE;
    }
    const w = t.upper;
    if (w == "OR") {
      return L_OR;
    }
    if (w == "AND") {
      return L_AND;
    }
    if (w == "IS" || w == "ISNULL" || w == "NOTNULL" || isMatchWord(w) || w == "IN") {
      return L_EQ;
    }
    if (w == "BETWEEN") {
      return L_EQ;
    }
    // NOT after an operand starts NOT IN, NOT LIKE (GLOB, MATCH, REGEXP), NOT BETWEEN or NOT
    // NULL; anything else after it is the error (`equality`).
    if (w == "NOT") {
      return L_EQ;
    }
    return L_NONE;
  }

  /** The operator at the cursor (of level `level`) applied to `e` and its right side. */
  infix(e: Expr, level: i64): Expr {
    if (level == L_EQ) {
      return this.equality(e);
    }
    const t = this.advance();
    if (level == L_CONCAT) {
      return binary(t.text, e, this.collate(), t.start);
    }
    const op = t.kind == T_IDENT ? t.upper : t.text == "==" ? "=" : t.text == "<>" ? "!=" : t.text;
    // A right operand nests (`1+(1+(…`): it counts toward the recursion bound.
    this.enter();
    const right = this.binaryFrom(level + 1);
    this.leave();
    return binary(op, e, right, t.start);
  }

  /** NOT and its operand: everything up to the next AND or OR (`1 = NOT 0 AND x`). */
  notOperand(): Expr {
    // A run of NOTs shares one operand: counted, not recursed into.
    const ats: usize[] = [];
    while (this.isKw("NOT")) {
      ats.push(this.advance().start);
    }
    this.enter();
    let e = this.binaryFrom(L_NOT);
    this.leave();
    for (let k = ats.length; k > 0; k--) {
      const u = new Expr(E_UNARY, ats[k - 1]);
      u.op = "NOT";
      u.a = e;
      e = sized(u);
    }
    return e;
  }

  /** One operator of `=`'s level: = == != <> IS, IN, LIKE and kin, BETWEEN, ISNULL, NOT NULL. */
  equality(e: Expr): Expr {
    // Its operands nest through its own frame and an operand's: a level of its own. A chain
    // (`a = b = c`) is a loop of calls, each left before the next.
    this.enter();
    const r = this.equalityBody(e);
    this.leave();
    return r;
  }

  equalityBody(e: Expr): Expr {
    const t = this.peek();
    if (t.kind == T_OP) {
      this.pos++;
      const op = t.text == "==" ? "=" : t.text == "<>" ? "!=" : t.text;
      return binary(op, e, this.binaryFrom(L_CMP), t.start);
    }
    let not = false;
    let k: usize = 0;
    if (t.upper == "NOT") {
      not = true;
      k = 1;
      const n = this.peekAt(1);
      if (
        !(
          n.kind == T_IDENT &&
          (n.upper == "IN" || n.upper == "BETWEEN" || n.upper == "NULL" || isMatchWord(n.upper))
        )
      ) {
        this.pos++;
        this.fail();
      }
    }
    const word = this.peekAt(k).upper;
    if (word == "IS") {
      this.pos++;
      const n = this.eatKw("NOT");
      if (this.eatKw("DISTINCT")) {
        // IS [NOT] DISTINCT FROM: IS NOT / IS.
        this.expectKw("FROM");
        return isExpr(e, this.binaryFrom(L_CMP), !n, t.start);
      }
      return isExpr(e, this.binaryFrom(L_CMP), n, t.start);
    }
    if (word == "ISNULL" || word == "NOTNULL" || word == "NULL") {
      this.pos += k + 1;
      return isNull(e, word != "ISNULL", t.start);
    }
    this.pos += k + 1;
    if (word == "IN") {
      return this.inExpr(e, not, t.start);
    }
    if (word == "BETWEEN") {
      const b = new Expr(E_BETWEEN, t.start);
      b.a = e;
      // The low bound binds like `=` (`x BETWEEN 1 = 1 AND 3`), the high one tighter. The low
      // bound can hold another BETWEEN (`a BETWEEN b BETWEEN c AND d AND e`): it nests.
      this.enter();
      b.b = this.binaryFrom(L_EQ);
      this.leave();
      this.expectKw("AND");
      b.c = this.binaryFrom(L_CMP);
      b.not = not;
      return sized(b);
    }
    const l = new Expr(E_LIKE, t.start);
    l.op = word;
    l.a = e;
    l.b = this.binaryFrom(L_CMP);
    if (this.eatKw("ESCAPE")) {
      l.c = this.binaryFrom(L_CMP);
    }
    l.not = not;
    return sized(l);
  }

  inExpr(left: Expr, not: bool, at: usize): Expr {
    if (!this.isOp("(")) {
      // IN [schema.]table, or IN a table-valued function (`IN json_each(x)`): a subquery
      // over all of it.
      const s = new Select();
      const core = new SelectCore();
      const item = new FromItem();
      item.name = this.name();
      if (this.eatOp(".")) {
        item.schema = item.name;
        item.name = this.name();
      }
      if (this.eatOp("(")) {
        this.enter();
        if (!this.isOp(")")) {
          item.args.push(this.expr());
          while (this.eatOp(",")) {
            item.args.push(this.expr());
          }
        }
        this.leave();
        this.expectOp(")");
      }
      core.from.push(item);
      core.columns.push(ResultColumn { expr: new Expr(E_STAR, at), alias: "", span: "*" });
      s.cores.push(core);
      const e = new Expr(E_IN_SELECT, at);
      e.a = left;
      e.select = s;
      e.not = not;
      return sized(e);
    }
    this.pos++;
    if (this.isKw("SELECT") || this.isKw("WITH") || this.isKw("VALUES")) {
      const e = new Expr(E_IN_SELECT, at);
      e.a = left;
      e.select = this.select();
      e.not = not;
      this.expectOp(")");
      return sized(e);
    }
    const e = new Expr(E_IN_LIST, at);
    e.a = left;
    e.not = not;
    if (!this.isOp(")")) {
      e.args.push(this.expr());
      while (this.eatOp(",")) {
        e.args.push(this.expr());
      }
    }
    this.expectOp(")");
    return sized(e);
  }

  collate(): Expr {
    let e = this.unary();
    while (this.isKw("COLLATE")) {
      const at = this.advance().start;
      // The collation is `ID` or a string (not a join word or INDEXED).
      if (!this.isAlias()) {
        this.fail();
      }
      const name = this.advance().text.toUpperCase();
      if (e.kind == E_COLLATE) {
        // A run of COLLATE is one node: the outermost collation wins, as in SQLite
        // (`'a' = 'A' COLLATE nocase COLLATE binary` is 0), and the tree stays as high as it is.
        e.name = name;
        continue;
      }
      const c = new Expr(E_COLLATE, at);
      c.a = e;
      c.name = name;
      // COLLATE adds no level (SQLite's TK_COLLATE node carries no height).
      c.height = e.height;
      e = c;
    }
    return e;
  }

  unary(): Expr {
    // Prefix operators are read as a run and applied innermost first: no recursion per operator.
    const ops: Token[] = [];
    while (true) {
      const t = this.peek();
      if (t.kind == T_OP && (t.text == "-" || t.text == "+" || t.text == "~")) {
        ops.push(t);
        this.pos++;
      } else {
        break;
      }
    }
    let e = this.primary();
    for (let k = ops.length; k > 0; k--) {
      e = prefix(ops[k - 1], e);
    }
    return e;
  }

  /**
   * An operand. The productions that nest (parentheses, CAST, EXISTS, CASE, NOT, calls) are
   * methods of their own, so the stack a level of nesting costs is theirs, not every branch's.
   */
  primary(): Expr {
    const i = this.pos;
    if (this.toks[i].kind == T_OP && this.toks[i].text == "(") {
      return this.parenthesized();
    }
    if (this.toks[i].kind == T_IDENT) {
      const w = this.toks[i].upper;
      if (w == "NOT") {
        // NOT in an operand's place (`1 = NOT 0`); NOT EXISTS is NOT of EXISTS, as in SQLite.
        return this.notOperand();
      }
      if (w == "CASE") {
        return this.caseExpr();
      }
      if (w == "CAST") {
        return this.castExpr();
      }
      if (w == "EXISTS") {
        return this.existsExpr();
      }
      if (w == "RAISE") {
        return this.raise();
      }
    }
    return this.operand();
  }

  /** `(expr)`, a row value `(a, b, …)`, or a subquery. */
  parenthesized(): Expr {
    const at = this.advance().start;
    if (this.isKw("SELECT") || this.isKw("WITH") || this.isKw("VALUES")) {
      const e = new Expr(E_SUBQUERY, at);
      e.select = this.select();
      this.expectOp(")");
      return sized(e);
    }
    // Parentheses add no level: SQLite makes no node for them.
    const first = this.expr();
    if (this.isOp(",")) {
      const row = new Expr(E_ROW, at);
      row.args.push(first);
      while (this.eatOp(",")) {
        row.args.push(this.expr());
      }
      this.expectOp(")");
      return sized(row);
    }
    this.expectOp(")");
    return first;
  }

  castExpr(): Expr {
    const e = new Expr(E_CAST, this.advance().start);
    this.expectOp("(");
    // Its frame is a call's (the type name's parsing): a level more than a parenthesis.
    this.enter();
    e.a = this.expr();
    this.leave();
    this.expectKw("AS");
    e.name = dequote(this.typeName());
    this.expectOp(")");
    return sized(e);
  }

  existsExpr(): Expr {
    const e = new Expr(E_EXISTS, this.advance().start);
    this.expectOp("(");
    e.select = this.select();
    this.expectOp(")");
    return sized(e);
  }

  /** A literal, a parameter, or a name: a column, `t.c`, `s.t.c`, or a call. */
  operand(): Expr {
    const t = this.peek();
    const at = t.start;
    if (t.kind == T_INTEGER) {
      this.pos++;
      return integerLiteral(t.text, at);
    }
    if (t.kind == T_REAL) {
      this.pos++;
      const e = new Expr(E_REAL, at);
      e.rval = parseFloat(t.text);
      return e;
    }
    if (t.kind == T_STRING && !this.isOpAt(1, ".")) {
      this.pos++;
      const e = new Expr(E_STRING, at);
      e.text = t.text;
      return e;
    }
    if (t.kind == T_BLOB) {
      this.pos++;
      const e = new Expr(E_BLOB, at);
      e.text = t.text;
      return e;
    }
    if (t.kind == T_PARAM) {
      this.pos++;
      return this.param(t);
    }
    if (t.kind == T_IDENT) {
      const w = t.upper;
      if (w == "NULL") {
        this.pos++;
        return new Expr(E_NULL, at);
      }
      if (w == "TRUE" && !this.isOpAt(1, "(")) {
        this.pos++;
        return new Expr(E_TRUE, at);
      }
      if (w == "FALSE" && !this.isOpAt(1, "(")) {
        this.pos++;
        return new Expr(E_FALSE, at);
      }
      if (w == "CURRENT_TIME" || w == "CURRENT_DATE" || w == "CURRENT_TIMESTAMP") {
        this.pos++;
        const e = new Expr(E_CALL, at);
        e.name = w;
        return e;
      }
    }
    // A name: ID, INDEXED or a join word, a call of one (quoted names included, as SQLite's
    // tokenizer makes them ID too), or `nm.nm` / `nm.nm.nm`, whose first name may be a string.
    if (
      t.kind == T_QUOTED ||
      (t.kind == T_IDENT && this.classAt(this.pos) != K_RESERVED) ||
      (t.kind == T_STRING && this.isOpAt(1, "."))
    ) {
      this.pos++;
      if (t.kind != T_STRING && this.isOp("(")) {
        return this.call(t);
      }
      if (this.eatOp(".")) {
        // `t.*` is a result column of its own, not an operand (velt/sqlite/sql/parser).
        const second = this.name();
        const c = new Expr(E_COLUMN, at);
        if (this.eatOp(".")) {
          c.table = second;
          c.name = this.name();
        } else {
          c.table = t.text;
          c.name = second;
        }
        return c;
      }
      const c = new Expr(E_COLUMN, at);
      c.name = t.text;
      // A double-quoted word that names no column is a string (SQLite's fallback); the
      // planner decides, so remember the quoting.
      c.op = t.kind == T_QUOTED ? "quoted" : "";
      return c;
    }
    this.fail();
  }

  /**
   * RAISE(IGNORE) or RAISE(ROLLBACK | ABORT | FAIL, message): parsed as SQLite does, then
   * rejected with its error, as only a trigger may raise (and triggers are not supported).
   */
  raise(): never {
    const at = this.advance().start;
    this.expectOp("(");
    if (!this.eatKw("IGNORE")) {
      if (!this.eatKw("ROLLBACK") && !this.eatKw("ABORT") && !this.eatKw("FAIL")) {
        this.fail();
      }
      this.expectOp(",");
      this.expr();
    }
    this.expectOp(")");
    throw new SqlError("RAISE() may only be used within a trigger-program", at);
  }

  param(t: Token): Expr {
    const e = new Expr(E_PARAM, t.start);
    e.text = t.text;
    if (t.text == "?") {
      this.params++;
      e.ival = this.params;
    } else if (strByteAt(t.text, 0) == 63) {
      const n = parseInt(t.text.slice(1), 10) as i64;
      if (n < 1 || n > MAX_VARIABLE) {
        throw new SqlError(`variable number must be between ?1 and ?32766`, t.start);
      }
      e.ival = n;
      if (n > this.params) {
        this.params = n;
      }
    } else {
      // A name keeps the index of its first use.
      const i = this.names.get(t.text);
      if (i != null) {
        e.ival = i!;
        return e;
      }
      this.params++;
      this.names.set(t.text, this.params);
      e.ival = this.params;
    }
    if (t.text == "?" || strByteAt(t.text, 0) != 63) {
      // A new `?` or name past SQLite's SQLITE_MAX_VARIABLE_NUMBER.
      if (e.ival > MAX_VARIABLE) {
        throw new SqlError("too many SQL variables", t.start);
      }
    }
    return e;
  }

  call(fn: Token): Expr {
    // A call's arguments nest a level deeper (its frames are more than a parenthesis's).
    this.enter();
    const e = this.callBody(fn);
    this.leave();
    return e;
  }

  /** The call of `fn` (its name already consumed): arguments, FILTER. */
  callBody(fn: Token): Expr {
    const e = new Expr(E_CALL, fn.start);
    e.name = fn.upper;
    this.expectOp("(");
    if (this.eatOp("*")) {
      e.star = true;
    } else if (!this.isOp(")")) {
      e.distinct = this.eatKw("DISTINCT");
      if (!e.distinct) {
        this.eatKw("ALL");
      }
      e.args.push(this.expr());
      while (this.eatOp(",")) {
        e.args.push(this.expr());
      }
    }
    this.expectOp(")");
    if (this.isKeyword("FILTER")) {
      this.pos++;
      this.expectOp("(");
      this.expectKw("WHERE");
      e.filter = this.expr();
      this.expectOp(")");
    }
    if (this.isKeyword("OVER")) {
      this.pos++;
      e.over = this.over();
    }
    return sized(e);
  }

  caseExpr(): Expr {
    const e = new Expr(E_CASE, this.advance().start);
    if (!this.isKw("WHEN")) {
      e.a = this.expr();
    }
    if (!this.isKw("WHEN")) {
      this.fail();
    }
    while (this.eatKw("WHEN")) {
      e.args.push(this.expr());
      this.expectKw("THEN");
      e.args.push(this.expr());
    }
    if (this.eatKw("ELSE")) {
      e.b = this.expr();
    }
    this.expectKw("END");
    return sized(e);
  }

  /**
   * A type name (`typetoken`): words (names or strings), then an optional `(n)` or `(n, m)` of
   * signed numbers, as written in the source (a column keeps it so; SQLite dequotes it). Keywords that fall back to names are words of it, GENERATED ALWAYS included (a
   * column definition strips those, velt/sqlite/sql/statement).
   */
  typeName(): string {
    const first = this.peek();
    if (!this.isAlias()) {
      return "";
    }
    let last = this.advance();
    while (this.isAlias()) {
      last = this.advance();
    }
    if (this.isOp("(")) {
      this.pos++;
      this.signedNumber();
      if (this.eatOp(",")) {
        this.signedNumber();
      }
      last = this.peek();
      this.expectOp(")");
    }
    return this.text(first.start, last.end);
  }

  /** `signed`: an optional + or -, then an integer or a real, written without separators. */
  signedNumber() {
    if (!this.eatOp("+")) {
      this.eatOp("-");
    }
    const t = this.peek();
    if ((t.kind != T_INTEGER && t.kind != T_REAL) || this.raw(t).includes("_")) {
      this.fail();
    }
    this.pos++;
  }
}
