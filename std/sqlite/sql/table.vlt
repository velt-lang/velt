// velt:sqlite/sql/table — CREATE TABLE of SQLite's grammar (parse.y): column definitions with
// their constraints and DEFAULT values, table constraints and options; and the pieces the other
// statements (velt:sqlite/sql/statement) share with it: names, indexed columns, conflict
// resolutions, literals.

import { Parser } from "velt:sqlite/sql/parser";
import {
  SqlError,
  T_BLOB,
  T_IDENT,
  T_INTEGER,
  T_QUOTED,
  T_REAL,
  T_STRING,
  dequote,
} from "velt:sqlite/sql/lexer";
import {
  ColumnDef,
  E_COLLATE,
  E_COLUMN,
  E_FALSE,
  E_INT,
  E_REAL,
  E_STRING,
  E_TRUE,
  E_UNARY,
  Expr,
  IndexedColumn,
  KeyConstraint,
  S_CREATE_TABLE,
  Statement,
} from "velt:sqlite/sql/ast";

/** `schema.name` or `name` into the statement's `schema` and `name`. */
export function qualified(p: Parser, s: Statement) {
  s.name = p.name();
  if (p.eatOp(".")) {
    s.schema = s.name;
    s.name = p.name();
  }
}

/** ROLLBACK, ABORT, REPLACE, FAIL or IGNORE (after OR, or ON CONFLICT). */
export function conflictResolution(p: Parser): string {
  const w = p.peek().upper;
  if (
    p.peek().kind != T_IDENT ||
    (w != "ROLLBACK" && w != "ABORT" && w != "REPLACE" && w != "FAIL" && w != "IGNORE")
  ) {
    p.fail();
  }
  p.advance();
  return w;
}

/** `IF NOT EXISTS`, if there. */
export function ifNotExists(p: Parser): bool {
  if (p.isKw("IF")) {
    p.advance();
    p.expectKw("NOT");
    p.expectKw("EXISTS");
    return true;
  }
  return false;
}

/**
 * `(name, …)` of a view, a foreign key or REFERENCES (`eidlist`): SQLite's grammar lets each
 * name take COLLATE and ASC/DESC only to report "syntax error after column name".
 */
export function columnNames(p: Parser): string[] {
  p.expectOp("(");
  const out: string[] = [];
  while (true) {
    const t = p.peek();
    out.push(p.name());
    if (p.isKw("COLLATE") || p.isKw("ASC") || p.isKw("DESC")) {
      throw new SqlError(`syntax error after column name "${p.raw(t)}"`, t.start);
    }
    if (!p.eatOp(",")) {
      break;
    }
  }
  p.expectOp(")");
  return out;
}

/** `(col [COLLATE c] [ASC|DESC], …)` of an index, a key or an upsert target. */
export function indexedColumns(p: Parser): IndexedColumn[] {
  p.expectOp("(");
  const out = keyColumns(p);
  p.expectOp(")");
  return out;
}

/** The columns of `indexedColumns`, without the parentheses (`sortlist`). */
function keyColumns(p: Parser): IndexedColumn[] {
  const out: IndexedColumn[] = [];
  while (true) {
    let e = p.expr();
    let collate = "";
    // `x COLLATE c` parses as an expression; keep the column and the collation apart.
    if (e.kind == E_COLLATE && e.a != null) {
      collate = e.name;
      e = e.a!;
    }
    let desc = false;
    if (p.eatKw("DESC")) {
      desc = true;
    } else {
      p.eatKw("ASC");
    }
    if (p.isKw("NULLS")) {
      // The grammar's sortlist allows it; SQLite rejects it here.
      const at = p.advance().start;
      const where = p.isKw("FIRST") || p.isKw("LAST") ? p.advance().upper : "";
      if (where == "") {
        p.fail();
      }
      throw new SqlError(`unsupported use of NULLS ${where}`, at);
    }
    out.push(IndexedColumn { expr: e, collate: collate, desc: desc });
    if (!p.eatOp(",")) {
      return out;
    }
  }
}

/** CREATE TABLE after TABLE: `[IF NOT EXISTS] name (columns, constraints) options`, or AS SELECT. */
export function createTable(p: Parser): Statement {
  const s = new Statement(S_CREATE_TABLE);
  s.ifNotExists = ifNotExists(p);
  qualified(p, s);
  if (p.eatKw("AS")) {
    s.select = p.select();
    return s;
  }
  // Columns first, then table constraints (commas between those are optional): no column
  // after a table constraint.
  p.expectOp("(");
  while (true) {
    const c = columnDef(p);
    s.columnDefs.push(c);
    columnKeys(s, c);
    if (!p.eatOp(",")) {
      break;
    }
    if (startsTableConstraint(p)) {
      while (true) {
        tableConstraint(p, s);
        if (!p.eatOp(",") && !startsTableConstraint(p)) {
          break;
        }
      }
      break;
    }
  }
  p.expectOp(")");
  tableOptions(p, s);
  return s;
}

/** Table options after the definition: WITHOUT ROWID and STRICT, separated by commas. */
function tableOptions(p: Parser, s: Statement) {
  if (!p.isName()) {
    return;
  }
  while (true) {
    if (p.eatKw("WITHOUT")) {
      const t = p.peek();
      p.name();
      if (p.raw(t).toUpperCase() != "ROWID") {
        throw new SqlError(`unknown table option: ${p.raw(t)}`, t.start);
      }
      s.withoutRowid = true;
    } else {
      const t = p.peek();
      p.name();
      if (p.raw(t).toUpperCase() != "STRICT") {
        throw new SqlError(`unknown table option: ${p.raw(t)}`, t.start);
      }
      s.strict = true;
    }
    if (!p.eatOp(",")) {
      return;
    }
  }
}

/** A column's PRIMARY KEY and UNIQUE constraints, as single-column keys. */
function columnKeys(s: Statement, c: ColumnDef) {
  const e = new Expr(E_COLUMN, 0);
  e.name = c.name;
  if (c.primaryKey) {
    const k = IndexedColumn { expr: e, collate: "", desc: c.desc };
    s.keys.push(KeyConstraint { primary: true, columns: [k] });
  }
  if (c.unique) {
    const k = IndexedColumn { expr: e, collate: "", desc: false };
    s.keys.push(KeyConstraint { primary: false, columns: [k] });
  }
}

function startsTableConstraint(p: Parser): bool {
  return p.isKw("CONSTRAINT") ||
    p.isKw("PRIMARY") ||
    p.isKw("UNIQUE") ||
    p.isKw("CHECK") ||
    p.isKw("FOREIGN");
}

/** One table constraint (`tcons`; CONSTRAINT name is one of its own). */
function tableConstraint(p: Parser, s: Statement) {
  if (p.eatKw("CONSTRAINT")) {
    p.name();
  } else if (p.eatKw("PRIMARY")) {
    p.expectKw("KEY");
    p.expectOp("(");
    s.primaryKey = keyColumns(p);
    const auto = p.eatKw("AUTOINCREMENT");
    p.expectOp(")");
    s.keys.push(KeyConstraint { primary: true, columns: s.primaryKey });
    if (auto && s.primaryKey.length == 1) {
      for (const c of s.columnDefs) {
        if (s.primaryKey[0].expr.kind == E_COLUMN && c.name == s.primaryKey[0].expr.name) {
          c.autoincrement = true;
        }
      }
    }
    conflictClause(p);
  } else if (p.eatKw("UNIQUE")) {
    const u = indexedColumns(p);
    s.uniques.push(u);
    s.keys.push(KeyConstraint { primary: false, columns: u });
    conflictClause(p);
  } else if (p.eatKw("CHECK")) {
    p.expectOp("(");
    s.checks.push(p.expr());
    p.expectOp(")");
    conflictClause(p);
  } else if (p.eatKw("FOREIGN")) {
    p.expectKw("KEY");
    columnNames(p);
    references(p);
    deferrable(p);
  } else {
    p.fail();
  }
}

/** ON CONFLICT <resolution> of a constraint (kept by SQLite in the schema; enforced later). */
function conflictClause(p: Parser) {
  if (p.isKw("ON") && p.isKwAt(1, "CONFLICT")) {
    p.advance();
    p.advance();
    conflictResolution(p);
  }
}

/**
 * REFERENCES table [(columns)], then ON DELETE / UPDATE / INSERT actions and MATCH: read and
 * kept in the schema text only.
 */
function references(p: Parser) {
  p.expectKw("REFERENCES");
  p.name();
  if (p.isOp("(")) {
    columnNames(p);
  }
  while (true) {
    if (p.eatKw("MATCH")) {
      p.name();
    } else if (p.eatKw("ON")) {
      if (!p.eatKw("DELETE") && !p.eatKw("UPDATE") && !p.eatKw("INSERT")) {
        p.fail();
      }
      // SET NULL, SET DEFAULT, CASCADE, RESTRICT, NO ACTION.
      if (p.eatKw("SET")) {
        if (!p.eatKw("NULL") && !p.eatKw("DEFAULT")) {
          p.fail();
        }
      } else if (p.eatKw("NO")) {
        p.expectKw("ACTION");
      } else if (!p.eatKw("CASCADE") && !p.eatKw("RESTRICT")) {
        p.fail();
      }
    } else {
      return;
    }
  }
}

/** `[NOT] DEFERRABLE [INITIALLY DEFERRED | INITIALLY IMMEDIATE]`, if there. */
function deferrable(p: Parser): bool {
  if (p.isKw("NOT") && p.isKwAt(1, "DEFERRABLE")) {
    p.advance();
  }
  if (!p.eatKw("DEFERRABLE")) {
    return false;
  }
  if (p.eatKw("INITIALLY")) {
    if (!p.eatKw("DEFERRED")) {
      p.expectKw("IMMEDIATE");
    }
  }
  return true;
}

/** A column definition: name, type, then column constraints in any order. */
export function columnDef(p: Parser): ColumnDef {
  const c = new ColumnDef(p.name());
  c.type = columnType(p.typeName());
  while (true) {
    if (p.eatKw("CONSTRAINT")) {
      p.name();
    } else if (p.eatKw("PRIMARY")) {
      p.expectKw("KEY");
      c.primaryKey = true;
      if (p.eatKw("DESC")) {
        c.desc = true;
      } else {
        p.eatKw("ASC");
      }
      conflictClause(p);
      c.autoincrement = p.eatKw("AUTOINCREMENT");
    } else if (p.isKw("NOT") && !p.isKwAt(1, "DEFERRABLE")) {
      p.advance();
      p.expectKw("NULL");
      c.notNull = true;
      conflictClause(p);
    } else if (p.eatKw("NULL")) {
      conflictClause(p);
    } else if (p.eatKw("UNIQUE")) {
      c.unique = true;
      conflictClause(p);
    } else if (p.eatKw("CHECK")) {
      p.expectOp("(");
      c.check.push(p.expr());
      p.expectOp(")");
    } else if (p.eatKw("DEFAULT")) {
      c.dflt = defaultValue(p);
    } else if (p.eatKw("COLLATE")) {
      if (!p.isAlias()) {
        p.fail();
      }
      c.collate = p.advance().text.toUpperCase();
    } else if (p.isKw("REFERENCES")) {
      references(p);
    } else if (deferrable(p)) {
      // A column's DEFERRABLE is a constraint of its own.
    } else if (p.eatKw("GENERATED") || p.isKw("AS")) {
      if (!p.eatKw("AS")) {
        p.expectKw("ALWAYS");
        p.expectKw("AS");
      }
      generated(p, c);
    } else {
      return c;
    }
  }
}

/**
 * A column's declared type as SQLite keeps it (sqlite3AddColumn): without a trailing GENERATED
 * ALWAYS, which the type's words take in (`a INT GENERATED ALWAYS AS (…)` has the type INT),
 * then dequoted as SQLite does it.
 */
function columnType(written: string): string {
  let t = withoutGeneratedAlways(written);
  // sqlite3DequoteToken: a type that starts with a quote and has none inside loses its first
  // and last characters (`[x] y` is `x] `); then sqlite3Dequote.
  const n = t.length as i64;
  if (n >= 3 && isQuote(t.charCodeAt(0))) {
    let inner = false;
    for (let i: i64 = 1; i < n - 1; i++) {
      if (isQuote(t.charCodeAt(i))) {
        inner = true;
        break;
      }
    }
    if (!inner) {
      t = t.slice(1, n - 1);
    }
  }
  return dequote(t);
}

function isQuote(c: i64): bool {
  return c == 39 || c == 34 || c == 96 || c == 91;
}

/** `t` without a trailing `GENERATED ALWAYS` (or `ALWAYS`), when it is 16 characters or more. */
function withoutGeneratedAlways(t: string): string {
  let n = t.length as i64;
  if (n < 16 || t.slice(n - 6).toUpperCase() != "ALWAYS") {
    return t;
  }
  n -= 6;
  while (n > 0 && isSpace(t.charCodeAt(n - 1))) {
    n--;
  }
  if (n >= 9 && t.slice(n - 9, n).toUpperCase() == "GENERATED") {
    n -= 9;
    while (n > 0 && isSpace(t.charCodeAt(n - 1))) {
      n--;
    }
  }
  return t.slice(0, n);
}

function isSpace(c: i64): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

/** `(expr) [STORED | VIRTUAL]` of a generated column. */
function generated(p: Parser, c: ColumnDef) {
  p.expectOp("(");
  c.generated = p.expr();
  p.expectOp(")");
  if (p.isId()) {
    const t = p.advance();
    if (t.upper == "STORED") {
      c.stored = true;
    } else if (t.upper != "VIRTUAL") {
      throw new SqlError(`error in generated column "${c.name}"`, t.start);
    }
  }
}

/**
 * DEFAULT's value: `(expr)`, a literal (number, string, blob, NULL, CURRENT_TIME…) with an
 * optional sign, or a bare name, which is a string (TRUE and FALSE are booleans).
 */
function defaultValue(p: Parser): Expr {
  if (p.eatOp("(")) {
    const e = p.expr();
    p.expectOp(")");
    return e;
  }
  if (p.isOp("+") || p.isOp("-")) {
    const sign = p.advance();
    const e = literal(p);
    return sign.text == "-" ? negated(e, sign.start) : e;
  }
  const t = p.peek();
  if (p.isId() || (t.kind == T_IDENT && t.upper == "INDEXED")) {
    if (t.kind == T_IDENT && !isLiteralWord(t.upper)) {
      p.advance();
      const e = new Expr(
        t.upper == "TRUE" ? E_TRUE : t.upper == "FALSE" ? E_FALSE : E_STRING,
        t.start,
      );
      e.text = t.text;
      return e;
    }
    if (t.kind == T_QUOTED) {
      p.advance();
      const e = new Expr(E_STRING, t.start);
      e.text = t.text;
      return e;
    }
  }
  return literal(p);
}

/** CURRENT_TIME, CURRENT_DATE and CURRENT_TIMESTAMP: literals, not names, after DEFAULT. */
function isLiteralWord(w: string): bool {
  return w == "CURRENT_TIME" || w == "CURRENT_DATE" || w == "CURRENT_TIMESTAMP";
}

/** One literal token (`term`): a number, a string, a blob, NULL or CURRENT_TIME and kin. */
export function literal(p: Parser): Expr {
  const t = p.peek();
  if (t.kind == T_STRING) {
    p.advance();
    const e = new Expr(E_STRING, t.start);
    e.text = t.text;
    return e;
  }
  if (
    t.kind == T_INTEGER ||
    t.kind == T_REAL ||
    t.kind == T_BLOB ||
    (t.kind == T_IDENT && (t.upper == "NULL" || isLiteralWord(t.upper)))
  ) {
    return p.primary();
  }
  p.fail();
}

/** `-e` of a DEFAULT or PRAGMA value: a number folds (as SQLite's value), anything else not. */
export function negated(e: Expr, at: usize): Expr {
  if (e.kind == E_REAL) {
    e.rval = -e.rval;
    return e;
  }
  if (e.kind == E_INT && e.text == "" && e.ival != -9223372036854775807 - 1) {
    e.ival = -e.ival;
    return e;
  }
  if (e.kind == E_INT && e.text == "9223372036854775808") {
    e.ival = -9223372036854775807 - 1;
    e.text = "";
    return e;
  }
  const u = new Expr(E_UNARY, at);
  u.op = "-";
  u.a = e;
  return u;
}
