// velt:sqlite/sql/ast — the syntax tree of SQLite's SQL, as velt:sqlite/sql/parser builds it.
// One class per node family with a `kind` tag (an expression's operator, a statement's verb),
// so the planner switches on a byte instead of testing types.

/** Expression kinds. */
export const E_NULL: u8 = 0;
export const E_INT: u8 = 1; // ival
export const E_REAL: u8 = 2; // rval
export const E_STRING: u8 = 3; // text
export const E_BLOB: u8 = 4; // text: hex digits
export const E_PARAM: u8 = 5; // text: "?", "?3", ":name"; ival: its 1-based index
export const E_COLUMN: u8 = 6; // table (may be ""), name
export const E_UNARY: u8 = 7; // op: "-", "+", "~", "NOT"; a
export const E_BINARY: u8 = 8; // op; a, b
export const E_CALL: u8 = 9; // name (upper case), args, distinct, star (count(*)), filter
export const E_CASE: u8 = 10; // a: operand or null; args: when, then, when, then…; b: else or null
export const E_CAST: u8 = 11; // a; name: type
export const E_IN_LIST: u8 = 12; // a; args; not
export const E_IN_SELECT: u8 = 13; // a; select; not
export const E_BETWEEN: u8 = 14; // a; b: low; c: high; not
export const E_LIKE: u8 =
  15; // op: "LIKE" | "GLOB" | "REGEXP" | "MATCH"; a; b; c: escape or null; not
export const E_IS: u8 = 16; // a; b; not (IS NOT, IS NOT DISTINCT FROM is IS)
export const E_ISNULL: u8 = 17; // a; not (NOTNULL / NOT NULL)
export const E_EXISTS: u8 = 18; // select; not
export const E_SUBQUERY: u8 = 19; // select (scalar)
export const E_COLLATE: u8 = 20; // a; name: collation (upper case)
export const E_STAR: u8 = 21; // result column `*` or `table.*` (table)
export const E_ROW: u8 = 22; // (a, b, …): args
export const E_TRUE: u8 = 23;
export const E_FALSE: u8 = 24;

/** An expression. Fields not used by a kind keep their defaults. */
export class Expr {
  kind: u8;
  op: string = "";
  ival: i64 = 0;
  rval: f64 = 0;
  text: string = "";
  table: string = "";
  name: string = "";
  a: Expr | null = null;
  b: Expr | null = null;
  c: Expr | null = null;
  args: Expr[] = [];
  select: Select | null = null;
  not: bool = false;
  distinct: bool = false;
  star: bool = false;
  filter: Expr | null = null;
  /** The source offset, for errors. */
  at: usize = 0;
  /** The tree's height (a leaf is 1), bounded as in SQLite (velt:sqlite/sql/expr). */
  height: i64 = 1;

  constructor(kind: u8, at: usize) {
    this.kind = kind;
    this.at = at;
  }
}

/** A result column: an expression and its alias (`*` and `t.*` are E_STAR). */
export struct ResultColumn {
  expr: Expr;
  alias: string;
}

/** Join kinds. */
export const J_INNER: u8 = 0;
export const J_LEFT: u8 = 1;
export const J_RIGHT: u8 = 2;
export const J_FULL: u8 = 3;
export const J_CROSS: u8 = 4;

/** One FROM item: a table (or CTE) by name, or a subquery, with how it joins the items before it. */
export class FromItem {
  schema: string = "";
  name: string = "";
  alias: string = "";
  subquery: Select | null = null;
  /** Table-valued function arguments (`json_each(x)`, `generate_series(1, 9)`). */
  args: Expr[] = [];
  join: u8 = J_INNER;
  natural: bool = false;
  on: Expr | null = null;
  using: string[] = [];
  /** INDEXED BY name, or NOT INDEXED (`notIndexed`). */
  indexedBy: string = "";
  notIndexed: bool = false;
}

/** An ORDER BY term: the expression, its direction, and where NULLs go. */
export struct OrderTerm {
  expr: Expr;
  desc: bool;
  /** 0: default (NULLS FIRST ascending, LAST descending), 1: NULLS FIRST, 2: NULLS LAST. */
  nulls: u8;
}

/** A common table expression of a WITH clause. */
export class Cte {
  name: string;
  columns: string[] = [];
  select: Select;
  materialized: u8 = 0;

  constructor(name: string, select: Select) {
    this.name = name;
    this.select = select;
  }
}

/** Compound operators joining a select core to the one before it. */
export const C_NONE: u8 = 0;
export const C_UNION: u8 = 1;
export const C_UNION_ALL: u8 = 2;
export const C_INTERSECT: u8 = 3;
export const C_EXCEPT: u8 = 4;

/** One SELECT (or VALUES) core of a compound select. */
export class SelectCore {
  /** How this core combines with the result so far (C_NONE for the first). */
  op: u8 = C_NONE;
  distinct: bool = false;
  columns: ResultColumn[] = [];
  from: FromItem[] = [];
  where: Expr | null = null;
  groupBy: Expr[] = [];
  having: Expr | null = null;
  /** VALUES (…), (…): one row per entry. */
  values: Expr[][] = [];
}

/** A whole SELECT: WITH, the compound cores, ORDER BY, LIMIT, OFFSET. */
export class Select {
  /** The height of its highest expression (SQLite's heightOfSelect), for the subquery's. */
  height: i64 = 0;
  with: Cte[] = [];
  recursive: bool = false;
  cores: SelectCore[] = [];
  orderBy: OrderTerm[] = [];
  limit: Expr | null = null;
  offset: Expr | null = null;
}

/** Statement kinds. */
export const S_SELECT: u8 = 0;
export const S_INSERT: u8 = 1;
export const S_UPDATE: u8 = 2;
export const S_DELETE: u8 = 3;
export const S_CREATE_TABLE: u8 = 4;
export const S_CREATE_INDEX: u8 = 5;
export const S_DROP: u8 = 6;
export const S_BEGIN: u8 = 7;
export const S_COMMIT: u8 = 8;
export const S_ROLLBACK: u8 = 9;
export const S_PRAGMA: u8 = 10;
export const S_SAVEPOINT: u8 = 11;
export const S_RELEASE: u8 = 12;
export const S_ALTER: u8 = 13;
export const S_CREATE_VIEW: u8 = 14;
export const S_EXPLAIN: u8 = 15;

/** A column definition of CREATE TABLE. */
export class ColumnDef {
  name: string;
  type: string = "";
  primaryKey: bool = false;
  desc: bool = false;
  autoincrement: bool = false;
  notNull: bool = false;
  unique: bool = false;
  dflt: Expr | null = null;
  collate: string = "";
  check: Expr[] = [];
  generated: Expr | null = null;
  stored: bool = false;

  constructor(name: string) {
    this.name = name;
  }
}

/** An indexed column of CREATE INDEX or a table constraint. */
export struct IndexedColumn {
  expr: Expr;
  collate: string;
  desc: bool;
}

/**
 * A PRIMARY KEY or UNIQUE constraint of CREATE TABLE, on a column or the table. SQLite names the
 * automatic indexes of these (sqlite_autoindex_<table>_<n>) in this order.
 */
export struct KeyConstraint {
  primary: bool;
  columns: IndexedColumn[];
}

/** UPSERT: ON CONFLICT (target) DO NOTHING | DO UPDATE SET … WHERE …. */
export class Upsert {
  target: IndexedColumn[] = [];
  targetWhere: Expr | null = null;
  doNothing: bool = true;
  setColumns: string[][] = [];
  setValues: Expr[] = [];
  where: Expr | null = null;
}

/** Any statement; the fields used depend on `kind`. */
export class Statement {
  kind: u8;
  select: Select | null = null;
  /** INSERT, UPDATE, DELETE, CREATE, DROP, PRAGMA: the object's schema and name. */
  schema: string = "";
  name: string = "";
  alias: string = "";
  /** INSERT: OR <conflict>, columns, VALUES rows / SELECT / DEFAULT VALUES, upserts. */
  orConflict: string = "";
  replace: bool = false;
  columns: string[] = [];
  rows: Expr[][] = [];
  defaultValues: bool = false;
  upserts: Upsert[] = [];
  /** UPDATE: SET (columns per assignment: one, or several for `(a, b) = …`) and values. */
  setColumns: string[][] = [];
  setValues: Expr[] = [];
  from: FromItem[] = [];
  /** UPDATE, DELETE: INDEXED BY name, or NOT INDEXED (`notIndexed`). */
  indexedBy: string = "";
  notIndexed: bool = false;
  where: Expr | null = null;
  returning: ResultColumn[] = [];
  orderBy: OrderTerm[] = [];
  limit: Expr | null = null;
  offset: Expr | null = null;
  /** CREATE TABLE / INDEX / VIEW. */
  ifNotExists: bool = false;
  temp: bool = false;
  columnDefs: ColumnDef[] = [];
  primaryKey: IndexedColumn[] = [];
  uniques: IndexedColumn[][] = [];
  /** Every PRIMARY KEY and UNIQUE constraint, column ones included, in source order. */
  keys: KeyConstraint[] = [];
  checks: Expr[] = [];
  withoutRowid: bool = false;
  strict: bool = false;
  table: string = "";
  indexed: IndexedColumn[] = [];
  unique: bool = false;
  /** DROP: what (TABLE, INDEX, VIEW, TRIGGER), IF EXISTS. */
  what: string = "";
  ifExists: bool = false;
  /** BEGIN DEFERRED/IMMEDIATE/EXCLUSIVE, PRAGMA value, SAVEPOINT name. */
  mode: string = "";
  /** BEGIN, COMMIT, ROLLBACK: the name after TRANSACTION, which SQLite ignores. */
  transaction: string = "";
  value: Expr | null = null;
  /** ALTER TABLE: RENAME TO / RENAME COLUMN / ADD COLUMN / DROP COLUMN. */
  action: string = "";
  newName: string = "";
  column: ColumnDef | null = null;
  /** EXPLAIN [QUERY PLAN] statement. */
  inner: Statement | null = null;
  queryPlan: bool = false;
  /** The statement's source text (CREATE statements are stored in sqlite_schema as written). */
  sql: string = "";

  constructor(kind: u8) {
    this.kind = kind;
  }
}
