// velt:sqlite/sql/lexer — SQLite's SQL tokens (https://sqlite.org/lang_keywords.html,
// tokenize.c): identifiers (bare, "double-quoted", [bracketed], `backticked`), string literals
// with '' escapes, blob literals X'…', integers (decimal and 0x hex), reals, parameters (?, ?NNN,
// :name, @name, $name), operators and comments. Keywords are identifiers here; the parser
// decides by context, as SQLite's fallback rules let most keywords name things.

/** Token kinds. */
export const T_EOF: u8 = 0;
export const T_IDENT: u8 = 1; // bare word (keyword or name)
export const T_QUOTED: u8 = 2; // "x", [x], `x`: always a name (or a string, by SQLite's fallback)
export const T_STRING: u8 = 3;
export const T_BLOB: u8 = 4;
export const T_INTEGER: u8 = 5;
export const T_REAL: u8 = 6;
export const T_PARAM: u8 = 7;
export const T_OP: u8 = 8;
export const T_SEMI: u8 = 9;

/** A SQL syntax error, with the byte offset it was found at. */
export class SqlError extends Error {
  at: usize;

  constructor(message: string, at: usize) {
    super(message);
    this.at = at;
  }
}

/** One token: its kind, its source bytes `[start, end)`, and its decoded text. */
export struct Token {
  kind: u8;
  start: usize;
  end: usize;
  /** Identifier text (upper-cased for T_IDENT in `upper`), string contents, blob hex digits,
   *  the number's digits, the parameter's name with its sigil, or the operator. */
  text: string;
  upper: string;
}

function isIdentStart(b: u8): bool {
  return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || b == 95 || b >= 0x80;
}

function isIdentPart(b: u8): bool {
  return isIdentStart(b) || (b >= 48 && b <= 57) || b == 36;
}

function isDigit(b: u8): bool {
  return b >= 48 && b <= 57;
}

function isHex(b: u8): bool {
  return isDigit(b) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70);
}

/**
 * Byte offsets of a string to UTF-16 indexes (what `slice` takes), from a running position:
 * offsets asked for in increasing order cost one pass over the string in all, so tokenizing
 * and cutting statements out of a long script stays linear.
 */
export class Utf16Index {
  s: string;
  byte: usize = 0;
  unit: i64 = 0;

  constructor(s: string) {
    this.s = s;
  }

  /** The UTF-16 index of byte offset `at` (a character boundary). */
  at(at: usize): i64 {
    if (at < this.byte) {
      if (at < this.byte - at) {
        this.byte = 0;
        this.unit = 0;
      } else {
        // Back over characters: a lead byte (not 10xxxxxx) starts one; four bytes are two units.
        while (this.byte > at) {
          this.byte--;
          const b = __intrinsic_str_byte_at(this.s, this.byte as u64);
          if ((b & 0xc0) != 0x80) {
            this.unit -= b >= 0xf0 ? 2 : 1;
          }
        }
        return this.unit;
      }
    }
    let i = this.byte;
    let units = this.unit;
    while (i < at) {
      const b = __intrinsic_str_byte_at(this.s, i as u64);
      if (b < 0x80) {
        i += 1;
        units += 1;
      } else if (b < 0xe0) {
        i += 2;
        units += 1;
      } else if (b < 0xf0) {
        i += 3;
        units += 1;
      } else {
        i += 4;
        units += 2;
      }
    }
    this.byte = i;
    this.unit = units;
    return units;
  }

  /** The text of bytes [from, to). */
  slice(from: usize, to: usize): string {
    const a = this.at(from);
    const b = this.at(to);
    return this.s.slice(a, b);
  }
}

/**
 * `s` with ASCII letters upper-cased and every other character kept: SQLite folds keywords
 * and names by ASCII only, so `ſelect` is not SELECT.
 */
export function asciiUpper(s: string): string {
  const n = s.length as i64;
  let out = "";
  let from: i64 = 0;
  let i: i64 = 0;
  while (i < n) {
    if (s.charCodeAt(i) < 0x80) {
      i++;
      continue;
    }
    let j = i;
    while (j < n && s.charCodeAt(j) >= 0x80) {
      j++;
    }
    out += s.slice(from, i).toUpperCase() + s.slice(i, j);
    from = j;
    i = j;
  }
  return from == 0 ? s.toUpperCase() : out + s.slice(from).toUpperCase();
}

/** Splits `sql` into tokens; the last is T_EOF. Throws `SqlError` on an unclosed token. */
export function tokenize(sql: string): Token[] {
  const n = __intrinsic_str_byte_len(sql) as usize;
  const u = new Utf16Index(sql);
  const out: Token[] = [];
  let i: usize = 0;
  while (i < n) {
    const b = __intrinsic_str_byte_at(sql, i as u64);
    // Whitespace and comments.
    if (b == 32 || b == 9 || b == 10 || b == 13 || b == 12) {
      i++;
      continue;
    }
    if (b == 45 && i + 1 < n && __intrinsic_str_byte_at(sql, (i + 1) as u64) == 45) {
      while (i < n && __intrinsic_str_byte_at(sql, i as u64) != 10) {
        i++;
      }
      continue;
    }
    // `/*` at the very end is `/` and then `*`, as in tokenize.c.
    if (b == 47 && i + 2 < n && __intrinsic_str_byte_at(sql, (i + 1) as u64) == 42) {
      i += 2;
      while (
        i + 1 < n &&
        !(
          __intrinsic_str_byte_at(sql, i as u64) == 42 &&
          __intrinsic_str_byte_at(sql, (i + 1) as u64) == 47
        )
      ) {
        i++;
      }
      // An unclosed block comment runs to the end, as in SQLite.
      i = i + 1 < n ? i + 2 : n;
      continue;
    }
    const start = i;
    // Blob literal X'…'.
    if ((b == 120 || b == 88) && i + 1 < n && __intrinsic_str_byte_at(sql, (i + 1) as u64) == 39) {
      i += 2;
      const from = i;
      while (i < n && isHex(__intrinsic_str_byte_at(sql, i as u64))) {
        i++;
      }
      if (i >= n || __intrinsic_str_byte_at(sql, i as u64) != 39 || (i - from) % 2 != 0) {
        // The bad token runs to its closing quote, or to the end.
        while (i < n && __intrinsic_str_byte_at(sql, i as u64) != 39) {
          i++;
        }
        throw new SqlError(
          `unrecognized token: "${byteSlice(sql, start, i < n ? i + 1 : n)}"`,
          start,
        );
      }
      const hex = u.slice(from, i);
      i++;
      out.push(Token { kind: T_BLOB, start: start, end: i, text: hex, upper: "" });
      continue;
    }
    if (isIdentStart(b)) {
      while (i < n && isIdentPart(__intrinsic_str_byte_at(sql, i as u64))) {
        i++;
      }
      const word = u.slice(start, i);
      out.push(Token { kind: T_IDENT, start: start, end: i, text: word, upper: asciiUpper(word) });
      continue;
    }
    if (
      isDigit(b) || (b == 46 && i + 1 < n && isDigit(__intrinsic_str_byte_at(sql, (i + 1) as u64)))
    ) {
      out.push(number(u, n, start));
      i = out[out.length - 1].end;
      continue;
    }
    if (b == 39) {
      out.push(quoted(u, n, start, 39, T_STRING));
      i = out[out.length - 1].end;
      continue;
    }
    if (b == 34 || b == 96) {
      out.push(quoted(u, n, start, b, T_QUOTED));
      i = out[out.length - 1].end;
      continue;
    }
    if (b == 91) {
      // [name]: no escapes.
      i++;
      while (i < n && __intrinsic_str_byte_at(sql, i as u64) != 93) {
        i++;
      }
      if (i >= n) {
        throw new SqlError(`unrecognized token: "${byteSlice(sql, start, n)}"`, start);
      }
      const name = u.slice(start + 1, i);
      i++;
      out.push(Token { kind: T_QUOTED, start: start, end: i, text: name, upper: asciiUpper(name) });
      continue;
    }
    if (b == 63) {
      i++;
      while (i < n && isDigit(__intrinsic_str_byte_at(sql, i as u64))) {
        i++;
      }
      out.push(Token { kind: T_PARAM, start: start, end: i, text: u.slice(start, i), upper: "" });
      continue;
    }
    if (b == 58 || b == 64 || b == 36) {
      i++;
      while (i < n && isIdentPart(__intrinsic_str_byte_at(sql, i as u64))) {
        i++;
      }
      if (i == start + 1) {
        throw new SqlError(`unrecognized token: "${byteSlice(sql, start, i)}"`, start);
      }
      out.push(Token { kind: T_PARAM, start: start, end: i, text: u.slice(start, i), upper: "" });
      continue;
    }
    if (b == 59) {
      i++;
      out.push(Token { kind: T_SEMI, start: start, end: i, text: ";", upper: ";" });
      continue;
    }
    // Operators: the two-byte ones first.
    if (i + 1 < n) {
      const two = u.slice(i, i + 2);
      if (
        two == "||" ||
        two == "<=" ||
        two == ">=" ||
        two == "==" ||
        two == "!=" ||
        two == "<>" ||
        two == "<<" ||
        two == ">>" ||
        two == "->"
      ) {
        i += 2;
        if (two == "->" && i < n && __intrinsic_str_byte_at(sql, i as u64) == 62) {
          i++;
          out.push(Token { kind: T_OP, start: start, end: i, text: "->>", upper: "->>" });
          continue;
        }
        out.push(Token { kind: T_OP, start: start, end: i, text: two, upper: two });
        continue;
      }
    }
    if (
      b == 40 ||
      b == 41 ||
      b == 44 ||
      b == 46 ||
      b == 43 ||
      b == 45 ||
      b == 42 ||
      b == 47 ||
      b == 37 ||
      b == 60 ||
      b == 62 ||
      b == 61 ||
      b == 38 ||
      b == 124 ||
      b == 126
    ) {
      i++;
      const op = u.slice(start, i);
      out.push(Token { kind: T_OP, start: start, end: i, text: op, upper: op });
      continue;
    }
    throw new SqlError(`unrecognized token: "${byteSlice(sql, start, start + 1)}"`, start);
  }
  out.push(Token { kind: T_EOF, start: n, end: n, text: "", upper: "" });
  return out;
}

/**
 * `s` without its enclosing quotes when it starts with one (' " ` or [), a doubled quote inside
 * read as one, as sqlite3Dequote: the text up to the matching close quote. Anything else is
 * returned as it is.
 */
export function dequote(s: string): string {
  const q = s.length > 0 ? s.charCodeAt(0) : 0;
  if (q != 39 && q != 34 && q != 96 && q != 91) {
    return s;
  }
  const close = q == 91 ? 93 : q;
  let out = "";
  let i: i64 = 1;
  const n = s.length as i64;
  while (i < n) {
    const c = s.charCodeAt(i);
    if (c == close) {
      if (close != 93 && i + 1 < n && s.charCodeAt(i + 1) == close) {
        out += s.slice(i, i + 1);
        i += 2;
        continue;
      }
      break;
    }
    out += s.slice(i, i + 1);
    i++;
  }
  return out;
}

/**
 * The text of bytes [from, to) of `s` (token boundaries are character boundaries). It scans
 * from the start: for one-off use (error messages); a running `Utf16Index` for many.
 */
export function byteSlice(s: string, from: usize, to: usize): string {
  return new Utf16Index(s).slice(from, to);
}

/**
 * A string or quoted identifier from `start` (its opening quote `q`); a doubled quote is one
 * quote character.
 */
function quoted(u: Utf16Index, n: usize, start: usize, q: u8, kind: u8): Token {
  const sql = u.s;
  let i = start + 1;
  let text = "";
  let from = i;
  while (true) {
    if (i >= n) {
      throw new SqlError(`unrecognized token: "${byteSlice(sql, start, n)}"`, start);
    }
    const b = __intrinsic_str_byte_at(sql, i as u64);
    if (b == q) {
      if (i + 1 < n && __intrinsic_str_byte_at(sql, (i + 1) as u64) == q) {
        text += u.slice(from, i + 1);
        i += 2;
        from = i;
        continue;
      }
      text += u.slice(from, i);
      i++;
      break;
    }
    i++;
  }
  return Token {
    kind: kind,
    start: start,
    end: i,
    text: text,
    upper: kind == T_QUOTED ? asciiUpper(text) : "",
  };
}

/**
 * A numeric literal from `start`: 0x hex integers, decimal integers, reals with a fraction
 * and/or exponent. `_` may separate digits (SQLite 3.46): `1_000`, `0xff_ff`, `1.5e1_0`.
 */
function number(u: Utf16Index, n: usize, start: usize): Token {
  const sql = u.s;
  let i = start;
  if (__intrinsic_str_byte_at(sql, i as u64) == 48 && i + 2 < n) {
    const x = __intrinsic_str_byte_at(sql, (i + 1) as u64);
    if ((x == 120 || x == 88) && isHex(__intrinsic_str_byte_at(sql, (i + 2) as u64))) {
      i = digits(sql, n, i + 2, true);
      return finishNumber(u, n, start, i, T_INTEGER, true);
    }
  }
  let kind = T_INTEGER;
  i = digits(sql, n, i, false);
  if (i < n && __intrinsic_str_byte_at(sql, i as u64) == 46) {
    kind = T_REAL;
    i = digits(sql, n, i + 1, false);
  }
  if (i < n) {
    const e = __intrinsic_str_byte_at(sql, i as u64);
    if (e == 101 || e == 69) {
      let j = i + 1;
      if (j < n) {
        const s = __intrinsic_str_byte_at(sql, j as u64);
        if (s == 43 || s == 45) {
          j++;
        }
      }
      if (j < n && isDigit(__intrinsic_str_byte_at(sql, j as u64))) {
        kind = T_REAL;
        i = digits(sql, n, j, false);
      }
    }
  }
  return finishNumber(u, n, start, i, kind, false);
}

/** The end of a run of (hex) digits and `_` separators from `i`. */
function digits(sql: string, n: usize, from: usize, hex: bool): usize {
  let i = from;
  while (i < n) {
    const b = __intrinsic_str_byte_at(sql, i as u64);
    if (!(hex ? isHex(b) : isDigit(b)) && b != 95) {
      break;
    }
    i++;
  }
  return i;
}

function finishNumber(
  u: Utf16Index,
  n: usize,
  start: usize,
  end: usize,
  kind: u8,
  hex: bool,
): Token {
  const sql = u.s;
  /** A number running into a name (`12abc`) is one bad token in SQLite. */
  if (end < n && isIdentPart(__intrinsic_str_byte_at(sql, end as u64))) {
    let bad = end;
    while (bad < n && isIdentPart(__intrinsic_str_byte_at(sql, bad as u64))) {
      bad++;
    }
    throw new SqlError(`unrecognized token: "${byteSlice(sql, start, bad)}"`, start);
  }
  let text = u.slice(start, end);
  if (text.includes("_")) {
    // Each separator stands between two digits (hex digits in a hex literal).
    for (let i = start; i < end; i++) {
      if (__intrinsic_str_byte_at(sql, i as u64) != 95) {
        continue;
      }
      const before = __intrinsic_str_byte_at(sql, (i - 1) as u64);
      const after = i + 1 < end ? __intrinsic_str_byte_at(sql, (i + 1) as u64) : 0;
      if (!(hex ? isHex(before) && isHex(after) : isDigit(before) && isDigit(after))) {
        throw new SqlError(`unrecognized token: "${text}"`, start);
      }
    }
    text = text.replaceAll("_", "");
  }
  return Token { kind: kind, start: start, end: end, text: text, upper: text };
}
