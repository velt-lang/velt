// velt:sqlite/engine — the SQLite engine written in Velt: queries over a database file's bytes,
// with the statement API of velt:sqlite (docs/std/sqlite_engine.md). Read-only for now: SELECT
// with joins, subqueries, CTEs, aggregates, compound selects; writing is step 4 of
// docs/internals/design/sqlite-engine.md.
//
// `prepare` parses and plans once and caches the plan per SQL text, so preparing the same text
// again is a map lookup. A plan runs as closures composed at prepare time (no bytecode VM); rows
// are read straight from the b-tree pages and decoded only for the columns a query uses.

import { DbFile } from "velt:sqlite/format";
import { NULL, INTEGER, REAL, TEXT } from "velt:sqlite/btree";
import { Schema, loadSchema } from "velt:sqlite/schema";
import { Parser } from "velt:sqlite/sql/parser";
import { statement } from "velt:sqlite/sql/statement";
import { T_EOF, T_SEMI } from "velt:sqlite/sql/lexer";
import { S_SELECT } from "velt:sqlite/sql/ast";
import { Out, Params, Query } from "velt:sqlite/exec/scope";
import { Pull } from "velt:sqlite/exec/pull";
import { SelectCompiler } from "velt:sqlite/exec/select";
import { SqlRunError } from "velt:sqlite/exec/errors";
import { bindJson } from "velt:sqlite/exec/bind";
import { Val, blobVal, intVal, nullVal, realVal, textVal } from "velt:sqlite/exec/value";
import { CellKind, RowSource, readRow, readRows } from "velt:db";
import { readFileBytesSync } from "velt:fs";

/**
 * A failed operation. `code` is SQLite's result code name: "SQLITE_ERROR" (bad SQL, an unknown
 * table or column, a failure while running), "SQLITE_CORRUPT" (a malformed file),
 * "SQLITE_CANTOPEN" (a file that cannot be read), "SQLITE_RANGE" (parameters),
 * "SQLITE_MISMATCH" (a row that does not fit the requested type).
 */
export class SqliteError extends Error {
  code: string;

  constructor(code: string, message: string) {
    super(message);
    this.code = code;
  }
}

/** The rows of a run, read by velt:db's `readRows` into typed values. */
export class Rows implements RowSource {
  out: Out;
  names: string[];
  row: i64 = -1;

  constructor(out: Out, names: string[]) {
    this.out = out;
    this.names = names;
  }

  columnCount(): i64 {
    return this.names.length as i64;
  }

  columnName(i: i64): string {
    return this.names[i as usize];
  }

  next(): bool {
    this.row++;
    return this.row < (this.out.rows as i64);
  }

  // The value's position in the output (fields are read in place: no copy of the value).
  pos(i: i64): usize {
    return (this.row as usize) * this.out.width + (i as usize);
  }

  kind(i: i64): CellKind {
    const t = this.out.vals[this.pos(i)].t;
    if (t == NULL) {
      return CellKind.Null;
    }
    if (t == INTEGER) {
      return CellKind.Int;
    }
    if (t == REAL) {
      return CellKind.Float;
    }
    return t == TEXT ? CellKind.Text : CellKind.Blob;
  }

  bool(i: i64): bool {
    return this.out.vals[this.pos(i)].i != 0;
  }

  int(i: i64): i64 {
    return this.out.vals[this.pos(i)].i;
  }

  float(i: i64): f64 {
    return this.out.vals[this.pos(i)].r;
  }

  text(i: i64): string {
    return this.out.vals[this.pos(i)].s;
  }

  blob(i: i64): u8[] {
    return this.out.vals[this.pos(i)].b;
  }

  json(i: i64): string {
    return "null";
  }
}

/** A prepared statement of a `Database`. */
export class Statement {
  sql: string;
  query: Query;
  params: Params;
  /** Parameter names (`:id` → "id") by index, "" for positional ones. */
  names: string[];
  count: usize;

  /** When the plan cache last handed it out (velt:sqlite/engine's LRU bound). */
  used: i64 = 0;

  constructor(sql: string, query: Query, params: Params, names: string[], count: usize) {
    this.sql = sql;
    this.query = query;
    this.params = params;
    this.names = names;
    this.count = count;
  }

  /** How the statement reads its tables, one line per FROM item of its SELECT. */
  plan(): string[] {
    return this.query.plan;
  }

  /** The result's column names. */
  columns(): string[] {
    return this.query.names;
  }

  /** Every row. */
  all<T>(): T[] {
    const p = this.query.pull;
    if (p != null) {
      return this.pullAll<T>(p!);
    }
    this.exec(-1);
    return this.decodeAll<T>();
  }

  /** Every row, with `params` bound (an array binds `?` by position, an object by name). */
  allWith<T, P>(params: P): T[] {
    this.bind<P>(params);
    const p = this.query.pull;
    if (p != null) {
      return this.pullAll<T>(p!);
    }
    this.exec(-1);
    return this.decodeAll<T>();
  }

  /** The first row, or null if there is none. */
  get<T>(): T | null {
    const p = this.query.pull;
    if (p != null) {
      return this.pullFirst<T>(p!);
    }
    this.exec(1);
    return this.decodeFirst<T>();
  }

  getWith<T, P>(params: P): T | null {
    this.bind<P>(params);
    const p = this.query.pull;
    if (p != null) {
      return this.pullFirst<T>(p!);
    }
    this.exec(1);
    return this.decodeFirst<T>();
  }

  /**
   * Every row as values, read one at a time through the getters typed reads use when the
   * query allows it (else as `values()`): for tests comparing the two paths.
   */
  pulledValues(): Val[] {
    const p = this.query.pull;
    if (p == null) {
      return this.values();
    }
    this.params.epoch++;
    p!.begin(-1);
    const out: Val[] = [];
    const n = p!.columnCount();
    while (p!.next()) {
      for (let i: i64 = 0; i < n; i++) {
        const k = p!.kind(i);
        if (k == CellKind.Int) {
          out.push(intVal(p!.int(i)));
        } else if (k == CellKind.Float) {
          out.push(realVal(p!.float(i)));
        } else if (k == CellKind.Text) {
          out.push(textVal(p!.text(i)));
        } else if (k == CellKind.Blob) {
          out.push(blobVal(p!.blob(i)));
        } else {
          out.push(nullVal());
        }
      }
    }
    this.pulled(p!, "");
    return out;
  }

  // The rows decoded as they are read (no values in between).
  private pullAll<T>(p: Pull): T[] {
    this.params.epoch++;
    p.begin(-1);
    let rows: T[] = [];
    let mismatch = "";
    try {
      rows = readRows<T, Pull>(p);
    } catch (e) {
      mismatch = e.message;
    }
    this.pulled(p, mismatch);
    return rows;
  }

  private pullFirst<T>(p: Pull): T | null {
    this.params.epoch++;
    p.begin(1);
    let row: T | null = null;
    let mismatch = "";
    try {
      row = readRow<T, Pull>(p);
    } catch (e) {
      mismatch = e.message;
    }
    this.pulled(p, mismatch);
    return row;
  }

  // After a pulled run: the parameters dropped, and its error (a failure while running comes
  // first: a row the decoder rejected may only be its consequence).
  private pulled(p: Pull, mismatch: string) {
    __intrinsic_array_truncate(this.params.vals, 0);
    if (p.err != null) {
      const e = p.err!;
      p.err = null;
      if (e instanceof SqlRunError) {
        throw new SqliteError("SQLITE_ERROR", e.message);
      }
      throw new SqliteError("SQLITE_CORRUPT", e.message);
    }
    if (mismatch != "") {
      throw new SqliteError(
        "SQLITE_MISMATCH",
        `row does not match the requested type: ${mismatch}`,
      );
    }
  }

  /** Every row as values (velt:sqlite/exec/value's `Val`), `columns().length` a row. */
  values(): Val[] {
    this.exec(-1);
    return this.query.out.vals;
  }

  valuesWith<P>(params: P): Val[] {
    this.bind<P>(params);
    this.exec(-1);
    return this.query.out.vals;
  }

  private bind<P>(params: P) {
    const msg = bindJson(JSON.stringify(params), this.params, this.names, this.count);
    if (msg != "") {
      throw new SqliteError("SQLITE_RANGE", msg);
    }
  }

  private exec(need: i64) {
    const q = this.query;
    this.params.epoch++;
    q.need = need;
    try {
      q.run();
    } catch (e) {
      if (e instanceof SqlRunError) {
        throw new SqliteError("SQLITE_ERROR", e.message);
      }
      throw new SqliteError("SQLITE_CORRUPT", e.message);
    }
    __intrinsic_array_truncate(this.params.vals, 0);
  }

  private decodeAll<T>(): T[] {
    try {
      return readRows<T, Rows>(new Rows(this.query.out, this.query.names));
    } catch (e) {
      throw new SqliteError(
        "SQLITE_MISMATCH",
        `row does not match the requested type: ${e.message}`,
      );
    }
  }

  private decodeFirst<T>(): T | null {
    try {
      return readRow<T, Rows>(new Rows(this.query.out, this.query.names));
    } catch (e) {
      throw new SqliteError(
        "SQLITE_MISMATCH",
        `row does not match the requested type: ${e.message}`,
      );
    }
  }
}

/** The most plans a database keeps cached by their text. */
const CACHE_SIZE: usize = 200;

/** A database: the bytes of a SQLite file, its schema, and the statements prepared on it. */
export class Database {
  file: DbFile;
  schema: Schema;
  cache: Map<string, Statement> = new Map();
  /** Counts lookups: a statement's `used` is the last one that found it. */
  tick: i64 = 0;
  last: Statement | null = null;
  lastSql: string = "";

  constructor(data: u8[]) {
    this.file = openFile(data);
    this.schema = schemaOf(this.file);
  }

  /** Compiles one SELECT (cached by its text). Throws `SqliteError` for SQL it cannot run. */
  prepare(sql: string): Statement {
    // The statement prepared last, without hashing the text again.
    if (this.last != null && this.lastSql == sql) {
      return this.last!;
    }
    const st = this.lookup(sql);
    this.lastSql = sql;
    this.last = st;
    return st;
  }

  private lookup(sql: string): Statement {
    this.tick++;
    const hit = this.cache.get(sql);
    if (hit != null) {
      hit!.used = this.tick;
      return hit!;
    }
    const st = this.compile(sql);
    st.used = this.tick;
    // At most CACHE_SIZE plans: the one used longest ago goes (a statement held stays usable).
    if (this.cache.size >= CACHE_SIZE) {
      let oldest = "";
      let at: i64 = 9223372036854775807;
      for (const [k, v] of this.cache) {
        if (v.used < at) {
          at = v.used;
          oldest = k;
        }
      }
      this.cache.delete(oldest);
    }
    this.cache.set(sql, st);
    return st;
  }

  private compile(sql: string): Statement {
    const params = new Params();
    try {
      const p = new Parser(sql);
      while (p.peek().kind == T_SEMI) {
        p.advance();
      }
      const s = statement(p);
      while (p.peek().kind == T_SEMI) {
        p.advance();
      }
      if (p.peek().kind != T_EOF) {
        throw new SqliteError("SQLITE_MISUSE", "more than one statement");
      }
      if (s.kind != S_SELECT) {
        throw new SqliteError("SQLITE_ERROR", "only SELECT statements are supported yet");
      }
      const c = new SelectCompiler(this.file, this.schema, params, sql);
      const q = c.select(s.select!, null);
      if (c.tooManyTerms) {
        throw new SqliteError("SQLITE_ERROR", "too many FROM clause terms, max: 200");
      }
      const names: string[] = [];
      for (let i: i64 = 0; i < p.params; i++) {
        names.push("");
      }
      for (const [name, at] of p.names) {
        names[(at - 1) as usize] = name;
      }
      return new Statement(sql, q, params, names, p.params as usize);
    } catch (e) {
      if (e instanceof SqliteError) {
        throw e;
      }
      throw new SqliteError("SQLITE_ERROR", e.message);
    }
  }
}

function openFile(data: u8[]): DbFile {
  try {
    return new DbFile(data);
  } catch (e) {
    throw new SqliteError("SQLITE_CORRUPT", e.message);
  }
}

function schemaOf(f: DbFile): Schema {
  try {
    return loadSchema(f);
  } catch (e) {
    throw new SqliteError("SQLITE_CORRUPT", e.message);
  }
}

/** Opens the database file at `path` (read into memory). Throws `SqliteError`. */
export function openDatabase(path: string): Database {
  let data: u8[] = [];
  try {
    data = readFileBytesSync(path);
  } catch (e) {
    throw new SqliteError("SQLITE_CANTOPEN", e.message);
  }
  return new Database(data);
}
