// velt/sqlite/btree_seek — seeking a b-tree: a table to a rowid (the leaf it is on, or the first
// row after it), an index to a key decoded once (velt/sqlite/record's KeyRec). Each probe of a
// binary search reads its cell in place (rowids of one or two varint bytes without a call, an
// index payload that fits the page without copying, integer keys without decoding the record),
// with the cell checks the rest of the reader makes.

import {
  CorruptError,
  INTERIOR_INDEX,
  INTERIOR_TABLE,
  LEAF_INDEX,
  LEAF_TABLE,
  corrupt,
  readU16,
  readU32,
  readVarint,
} from "velt/sqlite/format";
import { Cursor, intValue } from "velt/sqlite/btree";
import { KeyRec, compareToKey } from "velt/sqlite/record";

/** A b-tree is at most this deep (btree.vlt's limit). */
const MAX_DEPTH: usize = 20;

/**
 * Bytes that must follow a page in the file for its index cells to be compared in place: a
 * payload size and header size, a type byte and the bytes of an integer after a header of up
 * to 127 bytes.
 */
const IN_PLACE_MARGIN: usize = 160;

extend Cursor {
  /** On a table b-tree, moves to the first row with key >= `rowid`; false if there is none. */
  seekRowidGe(rowid: i64): bool {
    const lo = this.findLeaf(rowid);
    const leaf = this.db.header(this.pages[this.pages.length - 1]);
    const n = readU16(this.db.data, leaf + 3);
    if (lo < n) {
      this.cells.push(lo);
      return this.load();
    }
    if (n == 0) {
      this.cells.push(0);
      this.valid = false;
      return false;
    }
    // Past this leaf's last row: the next row is on a later leaf, if any.
    this.cells.push(n - 1);
    this.load();
    return this.next();
  }

  /**
   * Descends a table b-tree to the leaf where `rowid` is or would be, leaving the path to it
   * (the leaf's cell not yet pushed); returns the leaf's first cell whose key is >= rowid.
   */
  findLeaf(rowid: i64): usize {
    const data = this.db.data;
    __intrinsic_array_truncate(this.pages, 0);
    __intrinsic_array_truncate(this.cells, 0);
    let page = this.root;
    while (true) {
      if (this.pages.length >= MAX_DEPTH) {
        corrupt("b-tree too deep");
      }
      // The page's b-tree header (DbFile.header, in place).
      if (page == 0 || page > this.db.pageCount) {
        this.db.page(page);
      }
      const h = page == 1 ? 100 : ((page - 1) as usize) * this.db.pageSize;
      const base = h == 100 ? 0 : h;
      const t = data[h];
      const n = readU16(data, h + 3);
      const usable = this.db.usable;
      // The cell pointers must fit the page; each cell is checked as the search reads it.
      const cellsEnd = h + (t == LEAF_TABLE ? 8 : 12) + 2 * n;
      if (cellsEnd > base + usable) {
        corrupt(`cell count ${n} overflows its page`);
      }
      const leaf = t == LEAF_TABLE;
      if (!leaf && t != INTERIOR_TABLE) {
        throw new CorruptError(`page ${page} is not a table b-tree page`);
      }
      // The first cell whose key is >= rowid (on an interior page it holds the rowid in its
      // left subtree).
      // Cells read in place need 18 bytes after the page in the file (two varints of a cell
      // at its end); the file's last pages are read with checked varints instead.
      const safe = base + usable + 18 <= data.length;
      const lo = searchTable(data, h, base, cellsEnd, usable, leaf, n, rowid, safe);
      if (leaf) {
        this.pages.push(page);
        return lo;
      }
      this.pages.push(page);
      this.cells.push(lo);
      if (lo < n) {
        // The child pointer of cell `lo`, checked as cellOffset checks a cell.
        const ptr = h + 12 + 2 * lo;
        const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
        if (base + off < cellsEnd || off + 4 > usable) {
          corrupt(`cell offset ${off} out of range`);
        }
        page = readU32(data, base + off);
      } else {
        page = readU32(data, h + 8);
      }
    }
  }

  /** The current payload against a decoded key over its first `fields` fields. */
  compareKeyRec(k: KeyRec, fields: usize, colls: u8[], desc: bool[]): i64 {
    if (this.local) {
      return compareToKey(this.db.data, this.start, this.size, k, fields, colls, desc);
    }
    return compareToKey(this.scratch, 0, this.size, k, fields, colls, desc);
  }

  /** Cell `i` of the index page at `h` against `k`: in place when its payload fits the page. */
  probe(
    h: usize,
    leaf: bool,
    i: usize,
    cellsEnd: usize,
    k: KeyRec,
    fields: usize,
    colls: u8[],
    desc: bool[],
  ): i64 {
    const data = this.db.data;
    const ptr = h + (leaf ? 8 : 12) + 2 * i;
    const base = h == 100 ? 0 : h;
    if (base + this.db.usable + IN_PLACE_MARGIN > data.length) {
      this.locate(h, i);
      return this.compareKeyRec(k, fields, colls, desc);
    }
    const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
    if (base + off < cellsEnd || off + 4 > this.db.usable) {
      corrupt(`cell offset ${off} out of range`);
    }
    let at = base + off;
    if (!leaf) {
      at += 4;
    }
    let size: usize = 0;
    if (data[at] < 0x80) {
      size = data[at] as usize;
      at++;
    } else {
      const sz = readVarint(data, at);
      size = sz.value as usize;
      at += sz.len;
    }
    if (size <= this.maxIndexLocal) {
      if (at + size > base + this.db.usable) {
        corrupt(`cell payload of ${size} bytes overflows its page`);
      }
      // A one-byte header size and an integer first field: compared here.
      if (k.firstInt && data[at] < 0x80) {
        const t = data[at + 1] as i64;
        if (t >= 1 && t <= 9 && t != 7) {
          const body = at + (data[at] as usize);
          const v =
            t == 1
              ? ((data[body] as i64) << 56) >> 56
              : t == 2
                ? ((((data[body] as i64) << 8) | (data[body + 1] as i64)) << 48) >> 48
                : intValue(data, body, t);
          const w = k.ints[0];
          if (v != w) {
            const c: i64 = v < w ? -1 : 1;
            return desc.length > 0 && desc[0] ? -c : c;
          }
          if (fields == 1) {
            return 0;
          }
        }
      }
      return compareToKey(data, at, size, k, fields, colls, desc);
    }
    this.locate(h, i);
    return this.compareKeyRec(k, fields, colls, desc);
  }

  /** `seekKey` with the key decoded once. */
  seekKeyRec(k: KeyRec, fields: usize, colls: u8[], desc: bool[]): bool {
    return this.seekKeyIn(k, fields, colls, desc, false);
  }

  /** Moves to the first entry whose first `fields` fields compare > `k`; false when none. */
  seekKeyRecAfter(k: KeyRec, fields: usize, colls: u8[], desc: bool[]): bool {
    return this.seekKeyIn(k, fields, colls, desc, true);
  }

  /** The first entry >= `k` (> `k` when `after`). */
  seekKeyIn(k: KeyRec, fields: usize, colls: u8[], desc: bool[], after: bool): bool {
    const data = this.db.data;
    __intrinsic_array_truncate(this.pages, 0);
    __intrinsic_array_truncate(this.cells, 0);
    let page = this.root;
    while (true) {
      if (this.pages.length >= MAX_DEPTH) {
        corrupt("b-tree too deep");
      }
      const h = this.db.header(page);
      const t = data[h];
      if (t != LEAF_INDEX && t != INTERIOR_INDEX) {
        throw new CorruptError(`page ${page} is not an index b-tree page`);
      }
      const leaf = t == LEAF_INDEX;
      const n = readU16(data, h + 3);
      const cellsEnd = h + (leaf ? 8 : 12) + 2 * n;
      if (cellsEnd > (h == 100 ? 0 : h) + this.db.usable) {
        corrupt(`cell count ${n} overflows its page`);
      }
      // The first cell >= key. A one-field integer key against cells whose first field is an
      // integer (the common case) is compared right here, without a call per probe.
      const base = h == 100 ? 0 : h;
      const usable = this.db.usable;
      const hl: usize = leaf ? 8 : 12;
      const skip: usize = leaf ? 0 : 4;
      // The in-place comparisons read a few bytes past a cell's header: not on the file's last
      // pages, which go through the checked path (Cursor.locate).
      const quick =
        base + usable + IN_PLACE_MARGIN <= data.length &&
        k.firstInt &&
        fields == 1 &&
        (desc.length == 0 || !desc[0]);
      const w = quick ? k.ints[0] : 0;
      let lo: usize = 0;
      let hi = n;
      if (quick) {
        // Integer keys: guessed by interpolation; -1 when a cell is not of the common form.
        const at = searchIndexInt(data, h, base, cellsEnd, usable, hl, skip, n, w, after);
        if (at >= 0) {
          lo = at as usize;
          hi = lo;
        }
      }
      while (lo < hi) {
        const mid = (lo + hi) >> 1;
        let c: i64 = 2;
        if (quick) {
          const ptr = h + hl + 2 * mid;
          const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
          if (base + off < cellsEnd || off + 4 > usable) {
            corrupt(`cell offset ${off} out of range`);
          }
          const at = base + off + skip;
          // A one-byte payload size, a one-byte header size, a one- or two-byte integer type.
          if (data[at] < 0x80 && data[at + 1] < 0x80) {
            const ty = data[at + 2];
            const body = at + 1 + (data[at + 1] as usize);
            if (ty == 1) {
              const v = ((data[body] as i64) << 56) >> 56;
              c = v < w ? -1 : v > w ? 1 : 0;
            } else if (ty == 2) {
              const v = ((((data[body] as i64) << 8) | (data[body + 1] as i64)) << 48) >> 48;
              c = v < w ? -1 : v > w ? 1 : 0;
            }
          }
        }
        if (c == 2) {
          c = this.probe(h, leaf, mid, cellsEnd, k, fields, colls, desc);
        }
        if (c < 0 || (after && c == 0)) {
          lo = mid + 1;
        } else {
          hi = mid;
        }
      }
      this.pages.push(page);
      if (leaf) {
        if (lo < n) {
          this.cells.push(lo);
          return this.load();
        }
        if (n == 0) {
          if (this.pages.length > 1) {
            corrupt(`page ${page} is an empty leaf below the root`);
          }
          this.valid = false;
          return false;
        }
        // Past this leaf's last entry: the next entry is in an ancestor, if any.
        this.cells.push(n - 1);
        this.load();
        return this.next();
      }
      // Entries equal to the key may sit in the subtree left of cell `lo`.
      this.cells.push(lo);
      page = lo < n ? this.childAt(h, lo) : readU32(data, h + 8);
    }
  }
}

/**
 * The first of a table page's `n` cells whose key is >= `rowid` (`n` when none): the page's
 * end keys first, then guesses by interpolation, since rowids are mostly dense (a lookup is
 * usually three or four probes); past two guesses, bisection. One probe site, read in place.
 */
function searchTable(
  data: u8[],
  h: usize,
  base: usize,
  cellsEnd: usize,
  usable: usize,
  leaf: bool,
  n: usize,
  rowid: i64,
  safe: bool,
): usize {
  if (n == 0) {
    return 0;
  }
  // Probes: the last cell, the first, then guesses; key(lo) < rowid <= key(hi) from the third.
  let lo: usize = 0;
  let hi = n - 1;
  let klo: i64 = 0;
  let khi: i64 = 0;
  let step = 0;
  let g = hi;
  const first = h + (leaf ? 8 : 12);
  while (true) {
    const ptr = first + 2 * g;
    const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
    if (base + off < cellsEnd || off + 4 > usable) {
      corrupt(`cell offset ${off} out of range`);
    }
    let at = base + off;
    if (!safe) {
      at += leaf ? readVarint(data, at).len : 4;
    } else if (leaf) {
      const from = at;
      while (data[at] >= 0x80 && at < from + 8) {
        at++;
      }
      at++;
    } else {
      at += 4;
    }
    let k: i64 = 0;
    if (!safe) {
      k = readVarint(data, at).value;
    } else if (data[at] < 0x80) {
      k = data[at] as i64;
    } else if (data[at + 1] < 0x80) {
      k = (((data[at] & 0x7f) as i64) << 7) | (data[at + 1] as i64);
    } else {
      k = readVarint(data, at).value;
    }
    if (step == 0) {
      // The last cell.
      if (k < rowid) {
        return n;
      }
      if (hi == 0) {
        return 0;
      }
      khi = k;
      g = 0;
    } else if (step == 1) {
      // The first cell.
      if (k >= rowid) {
        return 0;
      }
      klo = k;
    } else {
      if (k == rowid) {
        return g;
      }
      if (k < rowid) {
        lo = g;
        klo = k;
      } else {
        hi = g;
        khi = k;
      }
    }
    step++;
    if (step >= 2) {
      if (hi - lo <= 1) {
        return hi;
      }
      g = (lo + hi) >> 1;
      if (step < 4 && khi > klo) {
        const f = ((rowid as f64) - (klo as f64)) / ((khi as f64) - (klo as f64));
        const x = (lo as f64) + f * ((hi - lo) as f64);
        g =
          x <= (lo as f64) + 1.0
            ? lo + 1
            : x >= (hi as f64) - 1.0 ? hi - 1 : Math.round(x) as usize;
      }
    }
  }
}

/**
 * On an index page whose cells start with a one- or two-byte integer: the first of its `n`
 * cells whose integer is >= `w` (> `w` when `after`): the end cells first, then two guesses by
 * interpolation, then bisection. -1 when a cell probed is of another form (the caller searches
 * the general way).
 */
function searchIndexInt(
  data: u8[],
  h: usize,
  base: usize,
  cellsEnd: usize,
  usable: usize,
  hl: usize,
  skip: usize,
  n: usize,
  w: i64,
  after: bool,
): i64 {
  if (n == 0) {
    return 0;
  }
  // Probes: the last cell, the first, then guesses; left(lo) and !left(hi) from the third.
  let lo: usize = 0;
  let hi = n - 1;
  let vlo: i64 = 0;
  let vhi: i64 = 0;
  let step = 0;
  let g = hi;
  while (true) {
    const ptr = h + hl + 2 * g;
    const off = ((data[ptr] as usize) << 8) | (data[ptr + 1] as usize);
    if (base + off < cellsEnd || off + 4 > usable) {
      corrupt(`cell offset ${off} out of range`);
    }
    const at = base + off + skip;
    if (data[at] >= 0x80 || data[at + 1] >= 0x80) {
      return -1;
    }
    const ty = data[at + 2];
    const body = at + 1 + (data[at + 1] as usize);
    let v: i64 = 0;
    if (ty == 1) {
      v = ((data[body] as i64) << 56) >> 56;
    } else if (ty == 2) {
      v = ((((data[body] as i64) << 8) | (data[body + 1] as i64)) << 48) >> 48;
    } else {
      return -1;
    }
    const left = v < w || (after && v == w);
    if (step == 0) {
      if (left) {
        return n as i64;
      }
      if (hi == 0) {
        return 0;
      }
      vhi = v;
      g = 0;
    } else if (step == 1) {
      if (!left) {
        return 0;
      }
      vlo = v;
    } else if (left) {
      lo = g;
      vlo = v;
    } else {
      hi = g;
      vhi = v;
    }
    step++;
    if (step >= 2) {
      if (hi - lo <= 1) {
        return hi as i64;
      }
      g = (lo + hi) >> 1;
      if (step < 4 && vhi > vlo) {
        const f = ((w as f64) - (vlo as f64)) / ((vhi as f64) - (vlo as f64));
        const x = (lo as f64) + f * ((hi - lo) as f64);
        g =
          x <= (lo as f64) + 1.0
            ? lo + 1
            : x >= (hi as f64) - 1.0 ? hi - 1 : Math.round(x) as usize;
      }
    }
  }
}
