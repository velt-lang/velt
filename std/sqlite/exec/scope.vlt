// velt:sqlite/exec/scope — what compiled expressions share with the query around them: the
// scopes names resolve in, the statement's bound parameters, and subqueries with the rows they
// produce.

import { NULL } from "velt:sqlite/btree";
import { Expr, ResultColumn, SelectCore, Window } from "velt:sqlite/sql/ast";
import { Out, Source } from "velt:sqlite/exec/source";

export { Out } from "velt:sqlite/exec/source";
import { AggCtx } from "velt:sqlite/exec/agg";
import { WinCtx } from "velt:sqlite/exec/window";
import { Pull } from "velt:sqlite/exec/pull";
import { Val, nullVal } from "velt:sqlite/exec/value";

/** A compiled expression: evaluates to a value against the rows the loops stand on. */
export type Ev = () => Val throws Error;
/** A compiled condition: true when the expression is true (not false, not NULL). */
export type Pred = () => bool throws Error;
/** A compiled step of a query's loops. */
export type Step = () => void throws Error;

/** The values bound to a statement's parameters, `?1` at index 0. */
export class Params {
  vals: Val[] = [];
  /** Counts the statement's runs: an uncorrelated subquery runs once per run. */
  epoch: i64 = 0;

  get(i: usize): Val {
    return i < this.vals.length ? this.vals[i] : nullVal();
  }
}

/** A compiled SELECT: `run()` fills `out`. */
export class Query {
  out: Out = new Out();
  body: Step = () => {};
  names: string[] = [];
  affs: u8[] = [];
  colls: i64[] = [];
  /** For each result column that is a plain column: its source and column (else null, -2). */
  refSrc: (Source | null)[] = [];
  refCol: i64[] = [];
  /** Each result column's expression (null for one `*` expanded to). */
  exprOf: (Expr | null)[] = [];
  /** Reads columns of an enclosing query, so it runs again for each of its rows. */
  correlated: bool = false;
  /** The run (`Params.epoch`) whose rows `out` holds, for uncorrelated subqueries. */
  ranEpoch: i64 = -1;
  /** How the loops read each FROM item (EXPLAIN QUERY PLAN's words). */
  plan: string[] = [];
  /** The rows read one at a time, when they go out in the loops' order (velt:sqlite/exec/pull). */
  pull: Pull | null = null;
  /** At most this many rows are needed (-1: all): EXISTS and scalar subqueries need one. */
  need: i64 = -1;

  /** Rows set from outside (a recursive CTE's current row): `run` leaves them. */
  fixed: bool = false;

  run() {
    if (this.fixed) {
      return;
    }
    this.out.reset();
    this.body();
  }

  /** Runs unless the rows of this statement run are already there. */
  runFor(p: Params) {
    if (this.correlated || this.ranEpoch != p.epoch) {
      this.run();
      this.ranEpoch = p.epoch;
    }
  }

  /**
   * Rows made on demand, as SQLite's co-routines make them: `lazyStart` begins a run,
   * `lazyMore` adds one more row to `out` (false when there is none). A FROM item reads
   * through `open` and `has`, so a LIMIT outside stops the rows being made (an endless
   * recursive CTE included).
   */
  lazyStart: Step | null = null;
  lazyMore: (() => bool throws Error) | null = null;
  ended: bool = false;

  /** For a reader of the rows from the start: begins the run unless it is this statement run's. */
  open(p: Params) {
    if (this.lazyMore == null) {
      this.runFor(p);
      return;
    }
    if (this.correlated || this.ranEpoch != p.epoch) {
      this.out.reset();
      this.ended = false;
      this.lazyStart!();
      this.ranEpoch = p.epoch;
    }
  }

  /** Whether row `r` is there (made now if it is still to come). */
  has(r: usize): bool {
    while (r >= this.out.rows) {
      if (this.lazyMore == null || this.ended) {
        return false;
      }
      if (!this.lazyMore!()) {
        this.ended = true;
        return false;
      }
    }
    return true;
  }

  /** The first value of the first row, or NULL. */
  first(): Val {
    return this.out.rows > 0 ? this.out.vals[0] : nullVal();
  }
}

/** Where names resolve: the FROM items of one SELECT, then the enclosing ones. */
export class Scope {
  /** The FROM items in the order the loops run them. */
  sources: Source[] = [];
  /** The FROM items as written (for `*`), when the loops run them in another order. */
  fromOrder: Source[] = [];
  parent: Scope | null = null;
  /** The result columns, for names that are their aliases. */
  aliases: ResultColumn[] = [];
  /** Aliases being expanded (an alias defined by itself is an error). */
  expanding: string[] = [];
  /** In an aggregate query's output: columns read the group's saved values. */
  agg: AggCtx | null = null;
  /** In output mode, the same scope in row mode (for aggregate arguments). */
  base: Scope | null = null;
  /** Set when a name resolved in an enclosing scope. */
  outer: bool = false;
  /**
   * In the output of a query with window functions: the windows, and the scope the rows are
   * collected in (expressions without window functions are computed there and read back).
   */
  win: WinCtx | null = null;
  winBase: Scope | null = null;
  /** The named windows of the WINDOW clause. */
  windows: Window[] = [];
  /**
   * Set on a query with window functions while its result columns and ORDER BY compile. SQLite
   * computes the windows in a query around the rest (sqlite3WindowRewrite), so a subquery's
   * aggregate of this query is allowed only where `winAgg` is set.
   */
  windowed: bool = false;
  /** Set while the terms, arguments and FILTER of a window function computed last compile. */
  winAgg: bool = false;
  /** The window function calls among the result columns whose windows are computed last. */
  lastWins: Expr[] = [];
  /** The core whose FROM items these are, and whether its output (result columns on) compiles. */
  core: SelectCore | null = null;
  output: bool = false;
  /** Set while the result columns of a core that is not (yet) an aggregate query compile. */
  results: bool = false;
  /** Set while an aggregate's arguments or FILTER compile: no aggregate is allowed there. */
  inAggArgs: bool = false;
  /**
   * Set while the core's WHERE and ON terms compile: an aggregate is allowed there only when
   * the core is an aggregate query, whichever query the aggregate belongs to.
   */
  where: bool = false;
  /**
   * Set while the core's GROUP BY terms compile: an aggregate the core owns is not allowed
   * there, even inside a subquery; one an enclosing query owns is.
   */
  groupBy: bool = false;

  /** The same sources in the output of a query with window functions. */
  forWindows(win: WinCtx, windows: Window[]): Scope {
    const s = new Scope();
    s.sources = this.sources;
    s.fromOrder = this.fromOrder;
    s.parent = this.parent;
    s.aliases = this.aliases;
    s.agg = this.agg;
    s.base = this.base;
    s.core = this.core;
    s.output = true;
    s.win = win;
    s.winBase = this;
    s.windows = windows;
    return s;
  }

  /** The same sources in an aggregate query's output mode. */
  forOutput(agg: AggCtx): Scope {
    const s = new Scope();
    s.sources = this.sources;
    s.fromOrder = this.fromOrder;
    s.parent = this.parent;
    s.aliases = this.aliases;
    s.agg = agg;
    s.base = this;
    s.core = this.core;
    s.output = true;
    return s;
  }
}

/**
 * Thrown while compiling a subquery that holds an aggregate of `core` (SQLite's rule: the
 * innermost query whose columns it reads owns it), when `core` was compiled as not aggregate:
 * `core` compiles again, as an aggregate query.
 */
export class AggRestart extends Error {
  core: SelectCore;

  constructor(core: SelectCore) {
    super("ICE: aggregate restart");
    this.core = core;
  }
}

/** Whether a value is NULL (for closures that test it often). */
export function isNull(v: Val): bool {
  return v.t == NULL;
}
