// velt/sqlite/exec/text — text as SQLite handles it: on UTF-8 bytes, with case folded for ASCII
// letters only (no ICU), and the LIKE and GLOB matchers (patternCompare in SQLite's func.c).

import { SqlRunError } from "velt/sqlite/exec/errors";
import { utf8Encode } from "velt/encoding";
import { arrayTruncate, arrayWithCapacity, strByteAt, strByteLen } from "velt/lang/intrinsics";

/** The byte length of `s`'s UTF-8. */
export function byteLen(s: string): usize {
  return strByteLen(s);
}

/** Byte `i` of `s`'s UTF-8 (in range). */
export function byteAt(s: string, i: usize): u8 {
  return strByteAt(s, i as u64);
}

/** `s` with ASCII letters in lower case. */
export function asciiLower(s: string): string {
  return mapAscii(s, 65, 90, 32);
}

/** `s` with ASCII letters in upper case. */
export function asciiUpper(s: string): string {
  return mapAscii(s, 97, 122, -32);
}

function mapAscii(s: string, lo: u8, hi: u8, delta: i64): string {
  const n = byteLen(s);
  let first: usize = n;
  for (let i: usize = 0; i < n; i++) {
    const c = byteAt(s, i);
    if (c >= lo && c <= hi) {
      first = i;
      break;
    }
  }
  if (first == n) {
    return s;
  }
  const b = utf8Encode(s);
  for (let i = first; i < n; i++) {
    const c = b[i];
    if (c >= lo && c <= hi) {
      b[i] = ((c as i64) + delta) as u8;
    }
  }
  return b.utf8Slice(0, n as i64);
}

/** The number of characters of `s` before its first NUL (SQLite's length() of text). */
export function charLength(s: string): i64 {
  const n = byteLen(s);
  let k: i64 = 0;
  for (let i: usize = 0; i < n; i++) {
    const c = byteAt(s, i);
    if (c == 0) {
      break;
    }
    if ((c & 0xc0) != 0x80) {
      k++;
    }
  }
  return k;
}

/** The byte offset of character `k` of `b` (or `b.length` past the end). */
export function charOffset(b: u8[], k: i64): usize {
  let i: usize = 0;
  let seen: i64 = 0;
  while (i < b.length && seen < k) {
    i++;
    while (i < b.length && (b[i] & 0xc0) == 0x80) {
      i++;
    }
    seen++;
  }
  return i;
}

/** The character starting at byte `at` of `b`, as a code point, and its length in bytes. */
export struct Char {
  c: i64;
  len: usize;
}

export function charAt(b: u8[], at: usize): Char {
  const b0 = b[at] as i64;
  if (b0 < 0xc0) {
    return Char { c: b0, len: 1 };
  }
  let n: usize = b0 >= 0xf0 ? 4 : b0 >= 0xe0 ? 3 : 2;
  let c = b0 & (n == 4 ? 0x07 : n == 3 ? 0x0f : 0x1f);
  let k: usize = 1;
  while (k < n && at + k < b.length && (b[at + k] & 0xc0) == 0x80) {
    c = (c << 6) | ((b[at + k] & 0x3f) as i64);
    k++;
  }
  return Char { c: c, len: k };
}

function lowerC(c: i64): i64 {
  return c >= 65 && c <= 90 ? c + 32 : c;
}

function upperC(c: i64): i64 {
  return c >= 97 && c <= 122 ? c - 32 : c;
}

/** SQLITE_MAX_LIKE_PATTERN_LENGTH: a longer LIKE or GLOB pattern is an error, as in SQLite. */
export const LIKE_PATTERN_LIMIT: usize = 50000;

/** A LIKE or GLOB pattern's wildcards. */
export class PatternInfo {
  all: i64;
  one: i64;
  /** The ESCAPE character for LIKE, `[` for GLOB, or 0. */
  other: i64;
  noCase: bool;
  glob: bool;

  constructor(glob: bool, escape: i64) {
    this.glob = glob;
    this.all = glob ? 42 : 37;
    this.one = glob ? 63 : 95;
    this.other = glob ? 91 : escape;
    this.noCase = !glob;
    // An ESCAPE that is `%` or `_` turns that wildcard off (likeFunc in SQLite's func.c).
    if (!glob && escape == this.all) {
      this.all = -1;
    }
    if (!glob && escape == this.one) {
      this.one = -1;
    }
  }
}

/** What one pattern element is: `%`, `_`, a character to match, a class, or one never matching. */
const T_ALL: i64 = 0;
const T_ONE: i64 = 1;
const T_CHAR: i64 = 2;
const T_CLASS: i64 = 3;
const T_FAIL: i64 = 4;

/**
 * Whether `str` matches `pat` (both UTF-8), with SQLite's answers (patternCompare in func.c).
 * Each element but `%` matches exactly one character, so on a mismatch it is enough to go back
 * to the last `%` and let it take one more character: no recursion, so the depth does not grow
 * with the pattern. Throws SQLite's error for a pattern longer than `LIKE_PATTERN_LIMIT` bytes.
 */
export function patternMatch(pat: u8[], str: u8[], info: PatternInfo): bool {
  if (pat.length > LIKE_PATTERN_LIMIT) {
    throw new SqlRunError("LIKE or GLOB pattern too complex");
  }
  let pi: usize = 0;
  let si: usize = 0;
  // Where the pattern goes on after the last `%`, and the string position it was tried at.
  let starP: i64 = -1;
  let starS: usize = 0;
  // Right after a `%`, SQLite reads `_` before the ESCAPE character (and checks `%` first always).
  let afterAll = false;
  while (true) {
    if (pi < pat.length) {
      const pc = charAt(pat, pi);
      let c = pc.c;
      let next = pi + pc.len;
      let kind = T_CHAR;
      if (c == info.all) {
        kind = T_ALL;
      } else if (afterAll && c == info.one) {
        kind = T_ONE;
      } else if (c == info.other && info.other != 0) {
        if (info.glob) {
          kind = T_CLASS;
        } else if (next >= pat.length) {
          kind = T_FAIL;
        } else {
          const esc = charAt(pat, next);
          c = esc.c;
          next += esc.len;
        }
      } else if (c == info.one) {
        kind = T_ONE;
      }
      if (kind == T_ALL) {
        if (next >= pat.length) {
          return true;
        }
        afterAll = true;
        pi = next;
        starP = next as i64;
        starS = si;
        continue;
      }
      afterAll = kind == T_ONE && afterAll;
      if (si < str.length && kind != T_FAIL) {
        const sc = charAt(str, si);
        let ok = false;
        if (kind == T_ONE) {
          ok = true;
        } else if (kind == T_CHAR) {
          ok = c == sc.c || (info.noCase && c < 0x80 && sc.c < 0x80 && lowerC(c) == lowerC(sc.c));
        } else {
          const end = classEnd(pat, next, sc.c);
          if (end > 0) {
            next = end as usize;
            ok = true;
          }
        }
        if (ok) {
          pi = next;
          si += sc.len;
          continue;
        }
      }
    } else if (si >= str.length) {
      return true;
    }
    // A mismatch: the last `%` takes one more character, or there is no match.
    if (starP < 0 || starS >= str.length) {
      return false;
    }
    starS += charAt(str, starS).len;
    si = starS;
    pi = starP as usize;
    afterAll = true;
  }
}

/**
 * A GLOB class `[abc]`, `[a-z]`, `[^x]`, `[]x]` starting after its `[` at `at`: the position
 * after its `]` when it holds `c`, else 0 (also for a class that is not closed).
 */
function classEnd(p: u8[], at: usize, c: i64): i64 {
  let pi = at;
  let seen = false;
  let invert = false;
  let prior: i64 = 0;
  if (pi >= p.length) {
    return 0;
  }
  let c2 = charAt(p, pi);
  pi += c2.len;
  if (c2.c == 94) {
    invert = true;
    if (pi >= p.length) {
      return 0;
    }
    c2 = charAt(p, pi);
    pi += c2.len;
  }
  if (c2.c == 93) {
    if (c == 93) {
      seen = true;
    }
    if (pi >= p.length) {
      return 0;
    }
    c2 = charAt(p, pi);
    pi += c2.len;
  }
  while (true) {
    if (c2.c == 93) {
      return seen == invert ? 0 : pi as i64;
    }
    if (c2.c == 45 && pi < p.length && p[pi] != 93 && prior > 0) {
      const hi = charAt(p, pi);
      pi += hi.len;
      if (c >= prior && c <= hi.c) {
        seen = true;
      }
      prior = 0;
    } else {
      if (c == c2.c) {
        seen = true;
      }
      prior = c2.c;
    }
    if (pi >= p.length) {
      return 0;
    }
    c2 = charAt(p, pi);
    pi += c2.len;
  }
}

/** Uppercase hex of bytes. */
export function hexUpper(b: u8[]): string {
  const digits = "0123456789ABCDEF";
  const out: u8[] = arrayWithCapacity(b.length * 2);
  for (const x of b) {
    out.push(byteAt(digits, (x >> 4) as usize));
    out.push(byteAt(digits, (x & 15) as usize));
  }
  return out.utf8Slice(0, out.length as i64);
}

/** Whether character `c` is in `set` (code points). */
export function inSet(set: i64[], c: i64): bool {
  for (const x of set) {
    if (x == c) {
      return true;
    }
  }
  return false;
}

/** The code points of `b`. */
export function chars(b: u8[]): i64[] {
  const out: i64[] = [];
  let i: usize = 0;
  while (i < b.length) {
    const ch = charAt(b, i);
    out.push(ch.c);
    i += ch.len;
  }
  return out;
}

export function upperChar(c: i64): i64 {
  return upperC(c);
}

/** The UTF-8 of `s` up to its first NUL (functions read text as a C string). */
export function cBytes(s: string): u8[] {
  const b = utf8Encode(s);
  for (let i: usize = 0; i < b.length; i++) {
    if (b[i] == 0) {
      arrayTruncate(b, i);
      break;
    }
  }
  return b;
}
