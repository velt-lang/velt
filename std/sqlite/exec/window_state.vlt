// velt/sqlite/exec/window_state — the states of min(), max() and group_concat() over a moving
// window frame (velt/sqlite/exec/window), kept as SQLite keeps them so that a row leaving the
// frame takes out what SQLite takes out.

import { NULL } from "velt/sqlite/btree";
import { Val, compareVals, nullVal, textVal, toText } from "velt/sqlite/exec/value";
import { utf8Encode } from "velt/encoding";
import { arrayTruncate } from "velt/lang/intrinsics";

/**
 * min() or max() over a frame that loses rows, with SQLite's answers: the result is the frame's
 * best value, and of equal ones the latest. Rows enter and leave in partition order, so it keeps
 * only the values that can still be the result: a deque, best first, each later value worse than
 * the one before it. A value coming in drops the ones it beats or equals from the back, and a row
 * leaving is the oldest in the frame, so it leaves only from the front. O(1) a row, amortized,
 * where scanning the frame was O(frame) (SQLite keeps an ordered index: O(log frame)).
 */
export class MinMax {
  max: bool;
  coll: u8;
  vals: Val[] = [];
  /** When each value in `vals` came in: 1 for the first non-NULL value stepped. */
  seqs: i64[] = [];
  /** Where the deque starts in `vals`; the entries before it have left. */
  head: usize = 0;
  next: i64 = 0;
  /** How many non-NULL values have left the frame. */
  gone: i64 = 0;

  constructor(max: bool, coll: u8) {
    this.max = max;
    this.coll = coll;
  }

  add(v: Val) {
    if (v.t == NULL) {
      return;
    }
    this.next++;
    while (this.vals.length > this.head) {
      const c = compareVals(this.vals[this.vals.length - 1], v, this.coll);
      if (this.max ? c > 0 : c < 0) {
        break;
      }
      this.vals.pop();
      this.seqs.pop();
    }
    this.vals.push(v);
    this.seqs.push(this.next);
  }

  /** The oldest value in the frame leaves (`v`, which SQLite looks up by value). */
  remove(v: Val) {
    if (v.t == NULL) {
      return;
    }
    this.gone++;
    if (this.head < this.vals.length && this.seqs[this.head] == this.gone) {
      this.head++;
    }
    if (this.head == this.vals.length) {
      this.vals = [];
      this.seqs = [];
      this.head = 0;
    } else if (this.head >= 1024 && this.head * 2 >= this.vals.length) {
      this.vals = this.vals.slice(this.head as i64);
      this.seqs = this.seqs.slice(this.head as i64);
      this.head = 0;
    }
  }

  value(): Val {
    return this.head < this.vals.length ? this.vals[this.head] : nullVal();
  }
}

/**
 * group_concat() over a moving frame, byte for byte as SQLite's groupConcatStep and
 * groupConcatInverse keep it: a value leaving takes its bytes and the separator after it off
 * the front, and a text emptied that way starts again without a separator.
 */
export class Concat {
  buf: u8[] = [];
  /** SQLite's `mxAlloc != 0`: the text has been started (the next value gets a separator). */
  started: bool = false;
  count: i64 = 0;
  firstSep: i64 = 0;
  /** The length of each separator, once they differ. */
  seps: i64[] | null = null;
  stepped: bool = false;

  step(v: Val, sep: Val, hasSep: bool) {
    if (v.t == NULL) {
      return;
    }
    this.stepped = true;
    const first = !this.started;
    this.started = true;
    if (!hasSep) {
      if (!first) {
        this.buf.push(44);
      } else {
        this.firstSep = 1;
      }
    } else if (!first) {
      let n: i64 = 0;
      if (sep.t != NULL) {
        const b = utf8Encode(toText(sep));
        for (const x of b) {
          this.buf.push(x);
        }
        n = b.length as i64;
      }
      if (n != this.firstSep || this.seps != null) {
        if (this.seps == null) {
          const l: i64[] = [];
          for (let i: i64 = 0; i < this.count - 1; i++) {
            l.push(this.firstSep);
          }
          this.seps = l;
        }
        const l = this.seps!;
        while ((l.length as i64) > this.count - 1 && l.length > 0) {
          l.pop();
        }
        if (this.count > 0) {
          l.push(n);
        }
      }
    } else {
      this.firstSep = sep.t == NULL ? 0 : utf8Encode(toText(sep)).length as i64;
    }
    this.count++;
    for (const x of utf8Encode(toText(v))) {
      this.buf.push(x);
    }
  }

  inverse(v: Val) {
    if (v.t == NULL) {
      return;
    }
    let n = utf8Encode(toText(v)).length as i64;
    this.count--;
    if (this.seps != null) {
      const l = this.seps!;
      if (this.count > 0 && l.length > 0) {
        n += l[0];
        l.shift();
      }
    } else {
      n += this.firstSep;
    }
    if (n >= (this.buf.length as i64)) {
      arrayTruncate(this.buf, 0);
    } else {
      this.buf = this.buf.slice(n);
    }
    if (this.buf.length == 0) {
      this.started = false;
      this.seps = null;
    }
  }

  value(): Val {
    if (!this.stepped) {
      return nullVal();
    }
    if (this.buf.length == 0) {
      // SQLite returns "" with a length of 1 for a text emptied with values still in.
      return this.count > 0 ? textVal("\u0000") : nullVal();
    }
    return textVal(this.buf.utf8Slice(0, this.buf.length as i64));
  }
}
