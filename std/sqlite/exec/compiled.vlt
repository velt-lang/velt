// velt:sqlite/exec/compiled — what the expression compiler knows about a compiled
// expression (affinity, collation), and the small decisions made from it at compile time.

import { NULL } from "velt:sqlite/btree";
import { BINARY } from "velt:sqlite/record";
import { E_CALL, Expr } from "velt:sqlite/sql/ast";
import { Source } from "velt:sqlite/exec/source";
import { Ev } from "velt:sqlite/exec/scope";
import { aggregateKind } from "velt:sqlite/exec/agg";
import {
  AFF_NONE,
  BIT_AND,
  BIT_OR,
  BIT_SHL,
  BIT_SHR,
  OP_ADD,
  OP_DIV,
  OP_EQ,
  OP_GE,
  OP_GT,
  OP_LE,
  OP_LT,
  OP_MUL,
  OP_NE,
  OP_REM,
  OP_SUB,
  compareAff,
  holds,
} from "velt:sqlite/exec/ops";
import { Val } from "velt:sqlite/exec/value";

/** A compiled expression with what comparisons need to know about it. */
export struct C {
  ev: Ev;
  /** Its affinity (a column's, a CAST's), or AFF_NONE. */
  aff: u8;
  /** Its collation, or -1; `explicit` when a COLLATE clause gave it. */
  coll: i64;
  explicit: bool;
}

/** An expression without affinity or collation. */
export function plain(ev: Ev): C {
  return C { ev: ev, aff: AFF_NONE, coll: -1, explicit: false };
}

/** The value of a constant expression. */
export function constant(v: Val): C {
  // Made afresh on each call from its parts: a Val captured whole costs a copy of its fields.
  const t = v.t;
  const i = v.i;
  const r = v.r;
  const s = v.s;
  const o = v.o;
  return plain(() => Val { t: t, i: i, r: r, s: s, o: o });
}

/** The collation a comparison of `x` and `y` uses (sqlite3BinaryCompareCollSeq). */
export function binaryColl(x: C, y: C): u8 {
  if (x.explicit) {
    return x.coll as u8;
  }
  if (y.explicit) {
    return y.coll as u8;
  }
  if (x.coll >= 0) {
    return x.coll as u8;
  }
  if (y.coll >= 0) {
    return y.coll as u8;
  }
  return BINARY;
}

/** A comparison operator's code, or -1. */
export function comparisonOp(op: string): i64 {
  if (op == "=") {
    return OP_EQ as i64;
  }
  if (op == "!=") {
    return OP_NE as i64;
  }
  if (op == "<") {
    return OP_LT as i64;
  }
  if (op == "<=") {
    return OP_LE as i64;
  }
  if (op == ">") {
    return OP_GT as i64;
  }
  if (op == ">=") {
    return OP_GE as i64;
  }
  return -1;
}

/** Whether `e` calls an aggregate function outside any subquery. */
export function hasAggregate(e: Expr | null): bool {
  if (e == null) {
    return false;
  }
  const x = e!;
  if (x.kind == E_CALL && aggregateKind(x.name, x.args.length, x.star) >= 0) {
    return true;
  }
  if (hasAggregate(x.a) || hasAggregate(x.b) || hasAggregate(x.c) || hasAggregate(x.filter)) {
    return true;
  }
  for (const a of x.args) {
    if (hasAggregate(a)) {
      return true;
    }
  }
  return false;
}

/** An operator's result: it keeps an explicit COLLATE of an operand (SQLite's EP_Collate). */
export function joinedColl(ev: Ev, x: C, y: C): C {
  if (x.explicit) {
    return C { ev: ev, aff: AFF_NONE, coll: x.coll, explicit: true };
  }
  if (y.explicit) {
    return C { ev: ev, aff: AFF_NONE, coll: y.coll, explicit: true };
  }
  return plain(ev);
}

/** A name's source and column. */
export class Found {
  src: Source;
  col: i64;

  constructor(src: Source, col: i64) {
    this.src = src;
    this.col = col;
  }
}

/** 1 when `v op w` holds, 0 when not, -1 when `w` is NULL. */
export function bound(v: Val, w: Val, aff: u8, coll: u8, op: u8): i64 {
  if (w.t == NULL) {
    return -1;
  }
  return holds(op, compareAff(v, w, aff, coll)) ? 1 : 0;
}

/** The code of an arithmetic operator (`+ - * / %`), or -1. */
export function arithCode(op: string): i64 {
  if (op == "+") {
    return OP_ADD as i64;
  }
  if (op == "-") {
    return OP_SUB as i64;
  }
  if (op == "*") {
    return OP_MUL as i64;
  }
  if (op == "/") {
    return OP_DIV as i64;
  }
  if (op == "%") {
    return OP_REM as i64;
  }
  return -1;
}

/** The code of a bitwise operator (`& | << >>`), or -1. */
export function bitCode(op: string): i64 {
  if (op == "&") {
    return BIT_AND as i64;
  }
  if (op == "|") {
    return BIT_OR as i64;
  }
  if (op == "<<") {
    return BIT_SHL as i64;
  }
  if (op == ">>") {
    return BIT_SHR as i64;
  }
  return -1;
}
