// velt/sqlite/exec/value — SQLite's dynamically typed values and their rules: comparison across
// storage classes, affinity conversions, arithmetic with integer overflow to REAL, and text forms
// (https://sqlite.org/datatype3.html, https://sqlite.org/lang_expr.html).

import { NULL, INTEGER, REAL, TEXT, BLOB } from "velt/sqlite/btree";
import { A_INTEGER, A_NUMERIC, A_REAL, A_TEXT } from "velt/sqlite/schema";
import { BINARY, NOCASE, RTRIM } from "velt/sqlite/record";
import { realText } from "velt/sqlite/real";
import { utf8Encode, utf8DecodeLossy } from "velt/encoding";
import { atof } from "velt/sqlite/exec/fp";
import { SqlRunError } from "velt/sqlite/exec/errors";
import { strByteAt, strByteLen } from "velt/lang/intrinsics";

/** A BLOB's bytes, boxed: a value that is no BLOB holds none (no empty array to make). */
export class Blob {
  bytes: u8[];

  constructor(bytes: u8[]) {
    this.bytes = bytes;
  }
}

/** One value: its storage class `t` (velt/sqlite/btree's NULL … BLOB) and the field for it. */
export struct Val {
  t: u8;
  i: i64;
  r: f64;
  s: string;
  o: Blob | null;

  /** A BLOB's bytes (empty for other values). */
  get b(): u8[] {
    return this.o == null ? [] : this.o!.bytes;
  }
}

/** NULL. */
export function nullVal(): Val {
  return Val { t: NULL, i: 0, r: 0, s: "", o: null };
}

/** An INTEGER. */
export function intVal(i: i64): Val {
  return Val { t: INTEGER, i: i, r: 0, s: "", o: null };
}

/** A REAL (NaN becomes NULL, as in SQLite). */
export function realVal(r: f64): Val {
  // NaN is NULL in SQLite.
  if (r != r) {
    return nullVal();
  }
  return Val { t: REAL, i: 0, r: r, s: "", o: null };
}

/** A TEXT value. */
export function textVal(s: string): Val {
  return Val { t: TEXT, i: 0, r: 0, s: s, o: null };
}

/** A BLOB value. */
export function blobVal(b: u8[]): Val {
  return Val { t: BLOB, i: 0, r: 0, s: "", o: new Blob(b) };
}

/** A boolean as SQLite has them: the INTEGER 1 or 0. */
export function boolVal(x: bool): Val {
  return intVal(x ? 1 : 0);
}

/** A REAL's text as SQLite writes it (velt/sqlite/real). */
export { realText } from "velt/sqlite/real";

/** The text of a value, as `CAST(v AS TEXT)` and concatenation give it (NULL is ""). */
export function toText(v: Val): string {
  if (v.t == TEXT) {
    return v.s;
  }
  if (v.t == INTEGER) {
    return String(v.i);
  }
  if (v.t == REAL) {
    return realText(v.r);
  }
  if (v.t == BLOB) {
    return utf8DecodeLossy(v.b);
  }
  return "";
}

/** The bytes of a value, as `CAST(v AS BLOB)` gives them. */
export function toBlob(v: Val): u8[] {
  if (v.t == BLOB) {
    return v.b;
  }
  if (v.t == NULL) {
    return [];
  }
  return utf8Encode(toText(v));
}

/** SQLITE_MAX_LENGTH: the most bytes a TEXT or BLOB value can have (1,000,000,000). */
export const MAX_LENGTH: u64 = 1000000000;

/** SQLite's `string or blob too big` (SQLITE_TOOBIG). */
export function tooBig(): never {
  throw new SqlRunError("string or blob too big");
}

/**
 * Throws SQLite's `string or blob too big` when a value of `n` bytes is over `MAX_LENGTH`. Every
 * function whose result size the SQL controls calls it before it builds the value.
 */
export function checkLength(n: u64) {
  if (n > MAX_LENGTH) {
    tooBig();
  }
}

/** A value's size in bytes as `sqlite3_value_bytes` counts it: its text's UTF-8, or a blob's. */
export function valueBytes(v: Val): usize {
  if (v.t == TEXT) {
    return strByteLen(v.s);
  }
  if (v.t == BLOB) {
    return v.b.length;
  }
  if (v.t == NULL) {
    return 0;
  }
  return strByteLen(toText(v));
}

/** `x || y`: the texts joined, NULL if either is NULL, an error past `MAX_LENGTH`. */
export function concatOp(x: Val, y: Val): Val {
  if (x.t == NULL || y.t == NULL) {
    return nullVal();
  }
  const a = toText(x);
  const b = toText(y);
  checkLength((strByteLen(a) + strByteLen(b)) as u64);
  return textVal(a + b);
}

/** A number read from text: its value, and whether the whole text (but spaces) was the number. */
export struct Numeric {
  v: Val;
  whole: bool;
}

function isSpace(c: i64): bool {
  return c == 32 || c == 9 || c == 10 || c == 13 || c == 12 || c == 11;
}

/**
 * The longest prefix of `s` that is a number, as SQLite reads text in numeric context
 * (`'12abc' + 0` is 12, `'abc' + 0` is 0, `' 1.5e3x'` is 1500.0). An integer is exact; one
 * outside i64 is a REAL. `whole` is set when the entire text (but surrounding spaces) is the
 * number.
 */
export function parseNumeric(s: string): Numeric {
  const n = s.length as i64;
  let i: i64 = 0;
  while (i < n && isSpace(s.charCodeAt(i))) {
    i++;
  }
  const start = i;
  if (i < n && (s.charCodeAt(i) == 43 || s.charCodeAt(i) == 45)) {
    i++;
  }
  const digits0 = i;
  while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
    i++;
  }
  let intDigits = i - digits0;
  let real = false;
  let fracDigits: i64 = 0;
  if (i < n && s.charCodeAt(i) == 46) {
    const f0 = i + 1;
    let j = f0;
    while (j < n && s.charCodeAt(j) >= 48 && s.charCodeAt(j) <= 57) {
      j++;
    }
    fracDigits = j - f0;
    if (intDigits > 0 || fracDigits > 0) {
      real = true;
      i = j;
    }
  }
  if (intDigits == 0 && fracDigits == 0) {
    return Numeric { v: intVal(0), whole: false };
  }
  if (i < n && (s.charCodeAt(i) == 101 || s.charCodeAt(i) == 69)) {
    let j = i + 1;
    if (j < n && (s.charCodeAt(j) == 43 || s.charCodeAt(j) == 45)) {
      j++;
    }
    const e0 = j;
    while (j < n && s.charCodeAt(j) >= 48 && s.charCodeAt(j) <= 57) {
      j++;
    }
    if (j > e0) {
      real = true;
      i = j;
    }
  }
  const text = s.slice(start, i);
  let end = i;
  while (end < n && isSpace(s.charCodeAt(end))) {
    end++;
  }
  const whole = end == n;
  if (!real) {
    // Exact in i64, else (only then) a REAL.
    return Numeric { v: exactInt(text), whole: whole };
  }
  return Numeric { v: realVal(sqliteAtof(text)), whole: whole };
}

// Decimal text to a double as SQLite converts it (not always the nearest double).
function sqliteAtof(text: string): f64 {
  return atof(utf8Encode(text), 0).value;
}

// A decimal integer, exactly, if it fits in i64 (else a REAL).
function exactInt(text: string): Val {
  let neg = false;
  let i: i64 = 0;
  if (text.charCodeAt(0) == 45 || text.charCodeAt(0) == 43) {
    neg = text.charCodeAt(0) == 45;
    i = 1;
  }
  let v: u64 = 0;
  while (i < (text.length as i64)) {
    const d = (text.charCodeAt(i) - 48) as u64;
    if (v > (18446744073709551615 - d) / 10) {
      return realVal(sqliteAtof(text));
    }
    v = v * 10 + d;
    i++;
  }
  if (neg) {
    if (v > 9223372036854775808) {
      return realVal(sqliteAtof(text));
    }
    return intVal(v == 9223372036854775808 ? -9223372036854775807 - 1 : -(v as i64));
  }
  if (v > 9223372036854775807) {
    return realVal(sqliteAtof(text));
  }
  return intVal(v as i64);
}

/** A value in numeric context: TEXT and BLOB read as their numeric prefix, NULL stays. */
export function toNumber(v: Val): Val {
  if (v.t == INTEGER || v.t == REAL || v.t == NULL) {
    return v;
  }
  return parseNumeric(toText(v)).v;
}

/**
 * A REAL that is an integer strictly inside i64's range as an INTEGER (for affinity), else
 * itself: SQLite's sqlite3VdbeIntegerAffinity leaves -2^63 a REAL.
 */
function realToInt(v: Val): Val {
  if (
    v.t == REAL &&
    v.r == Math.trunc(v.r) &&
    v.r > -9223372036854775808.0 &&
    v.r < 9223372036854775808.0
  ) {
    return intVal(v.r as i64);
  }
  return v;
}

/** Applies a column affinity to a value being stored or compared (§3, §4.2 of datatype3). */
export function applyAffinity(v: Val, a: u8): Val {
  if (a == A_TEXT) {
    if (v.t == INTEGER || v.t == REAL) {
      return textVal(toText(v));
    }
    return v;
  }
  if (a == A_INTEGER || a == A_NUMERIC) {
    if (v.t == TEXT) {
      const n = parseNumeric(v.s);
      if (n.whole) {
        return realToInt(n.v);
      }
      return v;
    }
    if (v.t == REAL) {
      return realToInt(v);
    }
    return v;
  }
  if (a == A_REAL) {
    if (v.t == TEXT) {
      const n = parseNumeric(v.s);
      if (n.whole) {
        return n.v.t == INTEGER ? realVal(n.v.i as f64) : positiveZero(n.v);
      }
      return v;
    }
    if (v.t == INTEGER) {
      return realVal(v.i as f64);
    }
    return positiveZero(v);
  }
  return v;
}

/**
 * -0.0 as 0.0: a REAL column stores an integral value as an integer (fileformat2 §2.1), so
 * SQLite reads -0.0 back as 0.0.
 */
function positiveZero(v: Val): Val {
  return v.t == REAL && v.r == 0 ? realVal(0.0) : v;
}

/** Whether a value is true in a WHERE clause (NULL is not; text reads as a number). */
export function truthy(v: Val): bool {
  if (v.t == INTEGER) {
    return v.i != 0;
  }
  if (v.t == REAL) {
    return v.r != 0;
  }
  if (v.t == NULL) {
    return false;
  }
  const n = toNumber(v);
  return n.t == INTEGER ? n.i != 0 : n.r != 0;
}

function rank(t: u8): i64 {
  if (t == NULL) {
    return 0;
  }
  if (t == INTEGER || t == REAL) {
    return 1;
  }
  return t == TEXT ? 2 : 3;
}

function compareIntReal(i: i64, r: f64): i64 {
  if (r < -9223372036854775808.0) {
    return 1;
  }
  if (r >= 9223372036854775808.0) {
    return -1;
  }
  const t = Math.trunc(r);
  const ti = t as i64;
  if (i != ti) {
    return i < ti ? -1 : 1;
  }
  return r > t ? -1 : r < t ? 1 : 0;
}

/** Text under a collation: BINARY compares UTF-8 bytes (code point order). */
export function compareText(a: string, b: string, coll: u8): i64 {
  let x = a;
  let y = b;
  if (coll == RTRIM) {
    x = trimSpaces(x);
    y = trimSpaces(y);
  }
  const fold = coll == NOCASE;
  // UTF-8 bytes, as SQLite's memcmp (NOCASE folds ASCII letters).
  if (x == y) {
    return 0;
  }
  const nx = strByteLen(x);
  const ny = strByteLen(y);
  const n = nx < ny ? nx : ny;
  for (let i: usize = 0; i < n; i++) {
    let p = strByteAt(x, i as u64);
    let q = strByteAt(y, i as u64);
    if (fold) {
      p = p >= 65 && p <= 90 ? p + 32 : p;
      q = q >= 65 && q <= 90 ? q + 32 : q;
    }
    if (p != q) {
      return p < q ? -1 : 1;
    }
  }
  return nx == ny ? 0 : nx < ny ? -1 : 1;
}

// Without trailing spaces (RTRIM ignores only U+0020).
function trimSpaces(s: string): string {
  let end = s.length as i64;
  while (end > 0 && s.charCodeAt(end - 1) == 32) {
    end--;
  }
  return end == (s.length as i64) ? s : s.slice(0, end);
}

function compareBlob(a: u8[], b: u8[]): i64 {
  const n = a.length < b.length ? a.length : b.length;
  for (let i: usize = 0; i < n; i++) {
    if (a[i] != b[i]) {
      return a[i] < b[i] ? -1 : 1;
    }
  }
  return a.length == b.length ? 0 : a.length < b.length ? -1 : 1;
}

/** Total order of SQLite's sort: NULL < numbers < TEXT < BLOB. */
export function compareVals(a: Val, b: Val, coll: u8): i64 {
  const ra = rank(a.t);
  const rb = rank(b.t);
  if (ra != rb) {
    return ra < rb ? -1 : 1;
  }
  if (ra == 0) {
    return 0;
  }
  if (ra == 1) {
    if (a.t == INTEGER && b.t == INTEGER) {
      return a.i < b.i ? -1 : a.i > b.i ? 1 : 0;
    }
    if (a.t == REAL && b.t == REAL) {
      return a.r < b.r ? -1 : a.r > b.r ? 1 : 0;
    }
    if (a.t == INTEGER) {
      return compareIntReal(a.i, b.r);
    }
    return -compareIntReal(b.i, a.r);
  }
  if (ra == 2) {
    return compareText(a.s, b.s, coll);
  }
  return compareBlob(a.b, b.b);
}

/** Whether two values are the same for DISTINCT, GROUP BY and IS (NULLs are equal). */
export function sameVal(a: Val, b: Val, coll: u8): bool {
  return compareVals(a, b, coll) == 0;
}

const I64_MAX: i64 = 9223372036854775807;
const I64_MIN: i64 = -9223372036854775807 - 1;

/** |x| as a u64 (2^63 for I64_MIN). */
function magnitude(x: i64): u64 {
  return x < 0 ? ((-(x + 1)) as u64) + 1 : x as u64;
}

/** p * q, exactly when it fits in i64, else in REAL. */
function multiply(p: i64, q: i64): Val {
  if (p == 0 || q == 0) {
    return intVal(0);
  }
  const neg = (p < 0) != (q < 0);
  const a = magnitude(p);
  const b = magnitude(q);
  const limit: u64 = neg ? 9223372036854775808 : 9223372036854775807;
  if (a > limit / b) {
    return realVal((p as f64) * (q as f64));
  }
  const m = a * b;
  if (!neg) {
    return intVal(m as i64);
  }
  return intVal(m == 9223372036854775808 ? I64_MIN : -(m as i64));
}

/** Arithmetic operators (arithOp). */
export const OP_ADD: u8 = 0;
export const OP_SUB: u8 = 1;
export const OP_MUL: u8 = 2;
export const OP_DIV: u8 = 3;
export const OP_REM: u8 = 4;

/** `arithOp` by the operator's spelling (`+`, `-`, `*`, `/`, `%`). */
export function arith(op: string, a: Val, b: Val): Val {
  const code =
    op == "+" ? OP_ADD : op == "-" ? OP_SUB : op == "*" ? OP_MUL : op == "/" ? OP_DIV : OP_REM;
  return arithOp(code, a, b);
}

/** Integer arithmetic that overflows to REAL, as SQLite's; REAL arithmetic otherwise. */
export function arithOp(op: u8, a: Val, b: Val): Val {
  if (a.t == NULL || b.t == NULL) {
    return nullVal();
  }
  const x = a.t == INTEGER || a.t == REAL ? a : numericOf(a);
  const y = b.t == INTEGER || b.t == REAL ? b : numericOf(b);
  if (x.t == INTEGER && y.t == INTEGER) {
    const p = x.i;
    const q = y.i;
    // Each operation is checked before it is done: one that would overflow is done in REAL.
    if (op == OP_ADD) {
      if ((q > 0 && p > I64_MAX - q) || (q < 0 && p < I64_MIN - q)) {
        return realVal((p as f64) + (q as f64));
      }
      return intVal(p + q);
    }
    if (op == OP_SUB) {
      if ((q < 0 && p > I64_MAX + q) || (q > 0 && p < I64_MIN + q)) {
        return realVal((p as f64) - (q as f64));
      }
      return intVal(p - q);
    }
    if (op == OP_MUL) {
      return multiply(p, q);
    }
    if (op == OP_DIV) {
      if (q == 0) {
        return nullVal();
      }
      if (q == -1 && p == -9223372036854775807 - 1) {
        return realVal(9223372036854775808.0);
      }
      return intVal((p / q) as i64);
    }
    if (op == OP_REM) {
      if (q == 0) {
        return nullVal();
      }
      if (q == -1) {
        return intVal(0);
      }
      return intVal(p % q);
    }
  }
  if (op == OP_REM) {
    // SQLite takes both operands as integers (sqlite3VdbeIntValue), and the result as a REAL.
    const ix = intValue(a);
    let iy = intValue(b);
    if (iy == 0) {
      return nullVal();
    }
    if (iy == -1) {
      iy = 1;
    }
    return realVal((ix % iy) as f64);
  }
  const fx = realOf(a, x);
  const fy = realOf(b, y);
  if (op == OP_ADD) {
    return realVal(fx + fy);
  }
  if (op == OP_SUB) {
    return realVal(fx - fy);
  }
  if (op == OP_MUL) {
    return realVal(fx * fy);
  }
  return fy == 0 ? nullVal() : realVal(fx / fy);
}

/**
 * Text or a blob as arithmetic reads it (numericType in vdbe.c). Text with a NUL inside reads
 * up to the NUL, and an integer there counts as REAL (the integer check sees the rest).
 */
function numericOf(v: Val): Val {
  if (v.t == TEXT) {
    const nul = v.s.indexOf("\u0000");
    if (nul >= 0) {
      const n = parseNumeric(v.s.slice(0, nul));
      if (n.whole && n.v.t == INTEGER) {
        return realVal(n.v.i as f64);
      }
      return n.v;
    }
  }
  return toNumber(v);
}

/**
 * The REAL of operand `v` (its numeric value `n`) in REAL arithmetic: text reads as a double,
 * so `'-0'` is -0.0 there (`0.5 * '-0'` is -0.0), though `'-0' + 0` is the INTEGER 0.
 */
function realOf(v: Val, n: Val): f64 {
  if (n.t != INTEGER) {
    return n.r;
  }
  if (n.i == 0 && (v.t == TEXT || v.t == BLOB) && negativeZero(toText(v))) {
    return -0.0;
  }
  return n.i as f64;
}

/** Whether text that reads as zero starts (after spaces) with a minus sign. */
function negativeZero(s: string): bool {
  const n = s.length as i64;
  let i: i64 = 0;
  while (i < n && isSpace(s.charCodeAt(i))) {
    i++;
  }
  return i < n && s.charCodeAt(i) == 45;
}

/**
 * A value as an integer, as SQLite's sqlite3VdbeIntValue: an INTEGER exactly, a REAL truncated
 * and saturated at the ends of i64, text (and a blob's bytes) by its integer prefix only
 * (`'3.0e2'` is 3), saturated too; NULL is 0.
 */
export function intValue(v: Val): i64 {
  if (v.t == INTEGER) {
    return v.i;
  }
  if (v.t == REAL) {
    if (v.r != v.r) {
      return 0;
    }
    if (v.r <= -9223372036854775808.0) {
      return I64_MIN;
    }
    if (v.r >= 9223372036854775807.0) {
      return I64_MAX;
    }
    return Math.trunc(v.r) as i64;
  }
  if (v.t == NULL) {
    return 0;
  }
  const s = toText(v);
  const n = s.length as i64;
  let i: i64 = 0;
  while (i < n && isSpace(s.charCodeAt(i))) {
    i++;
  }
  let neg = false;
  if (i < n && (s.charCodeAt(i) == 43 || s.charCodeAt(i) == 45)) {
    neg = s.charCodeAt(i) == 45;
    i++;
  }
  let m: u64 = 0;
  let over = false;
  while (i < n && s.charCodeAt(i) >= 48 && s.charCodeAt(i) <= 57) {
    const d = (s.charCodeAt(i) - 48) as u64;
    if (m > (18446744073709551615 - d) / 10) {
      over = true;
    } else {
      m = m * 10 + d;
    }
    i++;
  }
  if (neg) {
    return over || m >= 9223372036854775808 ? I64_MIN : -(m as i64);
  }
  return over || m > 9223372036854775807 ? I64_MAX : m as i64;
}
