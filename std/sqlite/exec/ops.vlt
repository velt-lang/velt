// velt/sqlite/exec/ops — SQLite's operators on values, as compiled expressions call them:
// comparison under an affinity and a collation, arithmetic, bitwise operators, CAST
// (https://sqlite.org/lang_expr.html, https://sqlite.org/datatype3.html#comparisons).

import { NULL, INTEGER, REAL, TEXT, BLOB } from "velt/sqlite/btree";
import { A_BLOB, A_INTEGER, A_NUMERIC, A_REAL, A_TEXT } from "velt/sqlite/schema";
import {
  Val,
  applyAffinity,
  blobVal,
  compareVals,
  intVal,
  intValue,
  arithOp,
  nullVal,
  OP_SUB,
  parseNumeric,
  realVal,
  textVal,
  toBlob,
  toNumber,
  toText,
} from "velt/sqlite/exec/value";

export {
  OP_ADD,
  OP_DIV,
  OP_MUL,
  OP_REM,
  OP_SUB,
  arithOp,
  intValue as toI64,
} from "velt/sqlite/exec/value";

/** An expression with no affinity (a literal, a function's result, an operator's). */
export const AFF_NONE: u8 = 255;

/** Comparison operators. */
export const OP_EQ: u8 = 0;
export const OP_NE: u8 = 1;
export const OP_LT: u8 = 2;
export const OP_LE: u8 = 3;
export const OP_GT: u8 = 4;
export const OP_GE: u8 = 5;

function isNumericAff(a: u8): bool {
  return a == A_INTEGER || a == A_REAL || a == A_NUMERIC;
}

/**
 * The affinity a comparison applies to both operands, from the operands' own affinities
 * (sqlite3CompareAffinity): numeric when either is, none between two columns otherwise, else
 * the one operand's that has one.
 */
export function comparisonAffinity(a1: u8, a2: u8): u8 {
  if (a1 != AFF_NONE && a2 != AFF_NONE) {
    return isNumericAff(a1) || isNumericAff(a2) ? A_NUMERIC : A_BLOB;
  }
  if (a1 == AFF_NONE && a2 == AFF_NONE) {
    return A_BLOB;
  }
  return a1 == AFF_NONE ? a2 : a1;
}

/** A value as a comparison under affinity `aff` sees it. */
export function forCompare(v: Val, aff: u8): Val {
  if (aff == A_TEXT) {
    if (v.t == INTEGER || v.t == REAL) {
      return textVal(toText(v));
    }
    return v;
  }
  if (isNumericAff(aff) && v.t == TEXT) {
    // SQLite reads the text as a C string: a number ends at a NUL.
    const nul = v.s.indexOf("\u0000");
    if (nul >= 0) {
      const n = applyAffinity(textVal(v.s.slice(0, nul)), A_NUMERIC);
      return n.t == TEXT ? v : n;
    }
    return applyAffinity(v, A_NUMERIC);
  }
  return v;
}

/** Two non-NULL values compared under an affinity and a collation: -1, 0 or 1. */
export function compareAff(x: Val, y: Val, aff: u8, coll: u8): i64 {
  if (x.t == INTEGER && y.t == INTEGER) {
    return x.i < y.i ? -1 : x.i > y.i ? 1 : 0;
  }
  return compareVals(forCompare(x, aff), forCompare(y, aff), coll);
}

/** Whether a comparison result `c` satisfies operator `op`. */
export function holds(op: u8, c: i64): bool {
  if (op == OP_EQ) {
    return c == 0;
  }
  if (op == OP_NE) {
    return c != 0;
  }
  if (op == OP_LT) {
    return c < 0;
  }
  if (op == OP_LE) {
    return c <= 0;
  }
  if (op == OP_GT) {
    return c > 0;
  }
  return c >= 0;
}

/** `x op y`: 1, 0, or NULL when either is NULL. */
export function compareOp(op: u8, x: Val, y: Val, aff: u8, coll: u8): Val {
  if (x.t == NULL || y.t == NULL) {
    return nullVal();
  }
  return intVal(holds(op, compareAff(x, y, aff, coll)) ? 1 : 0);
}

/** A REAL as an integer the way SQLite converts (saturating at the ends of i64). */
export function realToI64(r: f64): i64 {
  if (r != r) {
    return 0;
  }
  if (r <= -9223372036854775808.0) {
    return -9223372036854775807 - 1;
  }
  if (r >= 9223372036854775807.0) {
    return 9223372036854775807;
  }
  return r as i64;
}

/** A value as a float (sqlite3VdbeRealValue). */
export function toF64(v: Val): f64 {
  if (v.t == REAL) {
    return v.r;
  }
  if (v.t == INTEGER) {
    return v.i as f64;
  }
  if (v.t == NULL) {
    return 0;
  }
  const n = toNumber(v);
  return n.t == INTEGER ? n.i as f64 : n.r;
}

/**
 * Unary minus, as SQLite compiles it: `0 - x` (so text reads as arithmetic reads it: `-'0.0'` is
 * the REAL 0.0), the INTEGER minimum becoming a REAL.
 */
export function negate(v: Val): Val {
  if (v.t == INTEGER) {
    if (v.i == -9223372036854775807 - 1) {
      return realVal(9223372036854775808.0);
    }
    return intVal(-v.i);
  }
  return arithOp(OP_SUB, intVal(0), v);
}

/** Bitwise operators. */
export const BIT_AND: u8 = 0;
export const BIT_OR: u8 = 1;
export const BIT_SHL: u8 = 2;
export const BIT_SHR: u8 = 3;
export const BIT_NOT: u8 = 4;

/** `&`, `|`, `<<`, `>>` and `~` (BIT_NOT ignores `b`). */
export function bitOp(op: u8, a: Val, b: Val): Val {
  if (a.t == NULL || (op != BIT_NOT && b.t == NULL)) {
    return nullVal();
  }
  const x = intValue(a);
  if (op == BIT_NOT) {
    return intVal(~x);
  }
  const y = intValue(b);
  if (op == BIT_AND) {
    return intVal(x & y);
  }
  if (op == BIT_OR) {
    return intVal(x | y);
  }
  // Shifts: a negative count shifts the other way; 64 or more clears (or fills with the sign).
  let left = op == BIT_SHL;
  let n = y;
  if (n < 0) {
    left = !left;
    n = n <= -64 ? 64 : -n;
  }
  if (n >= 64) {
    return intVal(!left && x < 0 ? -1 : 0);
  }
  return intVal(left ? x << n : x >> n);
}

/** Truth of a value in a boolean context: NULL stays NULL, else 1 or 0. */
export function truth(v: Val): i64 {
  if (v.t == NULL) {
    return -1;
  }
  if (v.t == INTEGER) {
    return v.i != 0 ? 1 : 0;
  }
  return toF64(v) != 0 ? 1 : 0;
}

/** CAST(v AS type), with `a` the type's affinity (velt/sqlite/schema's `affinityOf`). */
export function castTo(v: Val, a: u8): Val {
  if (v.t == NULL) {
    return v;
  }
  if (a == A_TEXT) {
    return v.t == TEXT ? v : textVal(toText(v));
  }
  if (a == A_BLOB) {
    return v.t == BLOB ? v : blobVal(toBlob(v));
  }
  if (a == A_INTEGER) {
    return intVal(intValue(v));
  }
  if (a == A_REAL) {
    return realVal(toF64(v));
  }
  // NUMERIC: text as a number, an integral REAL from text as an INTEGER.
  if (v.t == INTEGER || v.t == REAL) {
    return v;
  }
  const n = parseNumeric(toText(v)).v;
  if (n.t == REAL) {
    // sqlite3RealSameAsInt: zero, or an integer below 2^51 that reads back exactly.
    const i = realToI64(n.r);
    if (n.r == 0 || ((i as f64) == n.r && i >= -2251799813685248 && i < 2251799813685248)) {
      return intVal(i);
    }
  }
  return n;
}
