// velt:sqlite/exec/date_format — the text of a date and time (velt:sqlite/exec/date): the
// `YYYY-MM-DD` and `HH:MM:SS` forms and strftime()'s conversions, as SQLite's date.c writes them.

import { DateTime, at, computeHMS, computeJD, computeYMD } from "velt:sqlite/exec/date";
import { FMT_FLOAT, FMT_GENERIC, formatReal } from "velt:sqlite/exec/fp";
import { cBytes } from "velt:sqlite/exec/text";
import { Val, nullVal, textVal } from "velt:sqlite/exec/value";

// `v` as C's `%0<w>d` writes it: the sign counts in the width (-1 in four is `-001`).
function pad(v: i64, w: usize): string {
  let s = String(v < 0 ? -v : v);
  const digits = v < 0 && w > 0 ? w - 1 : w;
  while (s.length < digits) {
    s = "0" + s;
  }
  return v < 0 ? "-" + s : s;
}

function space(v: i64, w: usize): string {
  let s = String(v);
  while (s.length < w) {
    s = " " + s;
  }
  return s;
}

/** `YYYY-MM-DD` (a negative year with its sign), as date() writes it. */
export function ymdText(p: DateTime): string {
  const Y = p.Y < 0 ? -p.Y : p.Y;
  return (p.Y < 0 ? "-" : "") + pad(Y, 4) + "-" + pad(p.M, 2) + "-" + pad(p.D, 2);
}

/** `HH:MM:SS` (with `.SSS` under 'subsec'), as time() writes it. */
export function hmsText(p: DateTime): string {
  let s = pad(p.h, 2) + ":" + pad(p.m, 2) + ":";
  if (p.useSubsec) {
    const ms = (1000 * p.s + 0.5) as i64;
    return s + pad(ms / 1000, 2) + "." + pad(ms % 1000, 3);
  }
  return s + pad(p.s as i64, 2);
}

function daysAfterJan01(p: DateTime): i64 {
  const j = new DateTime();
  j.Y = p.Y;
  j.M = 1;
  j.D = 1;
  j.h = p.h;
  j.m = p.m;
  j.s = p.s;
  j.validYMD = true;
  j.validHMS = true;
  computeJD(j);
  return (p.iJD - j.iJD + 43200000) / 86400000;
}

function daysAfterMonday(p: DateTime): i64 {
  return ((p.iJD + 43200000) / 86400000) % 7;
}

function daysAfterSunday(p: DateTime): i64 {
  return ((p.iJD + 129600000) / 86400000) % 7;
}

// The Thursday of `p`'s week (for ISO weeks).
function thursday(p: DateTime): DateTime {
  const y = new DateTime();
  y.iJD = p.iJD + (3 - daysAfterMonday(p)) * 86400000;
  y.validJD = true;
  computeYMD(y);
  computeHMS(y);
  return y;
}

/** strftime()'s text of `p` for the format `fmt` (NULL for an unknown conversion). */
export function strftime(fmt: string, p: DateTime): Val {
  computeJD(p);
  computeYMD(p);
  computeHMS(p);
  let out = "";
  const f = cBytes(fmt);
  let i: usize = 0;
  while (i < f.length) {
    if (f[i] != 37) {
      let j = i;
      while (j < f.length && f[j] != 37) {
        j++;
      }
      out += f.utf8Slice(i as i64, j as i64);
      i = j;
      continue;
    }
    i++;
    const cf = at(f, i);
    i++;
    if (cf == 100) {
      out += pad(p.D, 2);
    } else if (cf == 101) {
      out += space(p.D, 2);
    } else if (cf == 102) {
      const s = p.s > 59.999 ? 59.999 : p.s;
      const ms = (s * 1000 + 0.5) as i64;
      out += pad(ms / 1000, 2) + "." + pad(ms % 1000, 3);
    } else if (cf == 70) {
      out += pad(p.Y, 4) + "-" + pad(p.M, 2) + "-" + pad(p.D, 2);
    } else if (cf == 71 || cf == 103) {
      const y = thursday(p);
      out += cf == 103 ? pad(y.Y % 100, 2) : pad(y.Y, 4);
    } else if (cf == 72) {
      out += pad(p.h, 2);
    } else if (cf == 107) {
      out += space(p.h, 2);
    } else if (cf == 73 || cf == 108) {
      let h = p.h;
      if (h > 12) {
        h -= 12;
      }
      if (h == 0) {
        h = 12;
      }
      out += cf == 73 ? pad(h, 2) : space(h, 2);
    } else if (cf == 106) {
      out += pad(daysAfterJan01(p) + 1, 3);
    } else if (cf == 74) {
      out += formatReal((p.iJD as f64) / 86400000.0, FMT_GENERIC, 16, false, false, false);
    } else if (cf == 109) {
      out += pad(p.M, 2);
    } else if (cf == 77) {
      out += pad(p.m, 2);
    } else if (cf == 112 || cf == 80) {
      out += p.h >= 12 ? (cf == 112 ? "PM" : "pm") : (cf == 112 ? "AM" : "am");
    } else if (cf == 82) {
      out += pad(p.h, 2) + ":" + pad(p.m, 2);
    } else if (cf == 115) {
      if (p.useSubsec) {
        out += formatReal(
          ((p.iJD - 210866760000000) as f64) / 1000.0,
          FMT_FLOAT,
          3,
          false,
          false,
          false,
        );
      } else {
        out += String(p.iJD / 1000 - 210866760000);
      }
    } else if (cf == 83) {
      out += pad(p.s as i64, 2);
    } else if (cf == 84) {
      out += pad(p.h, 2) + ":" + pad(p.m, 2) + ":" + pad(p.s as i64, 2);
    } else if (cf == 117 || cf == 119) {
      let d = daysAfterSunday(p);
      if (d == 0 && cf == 117) {
        d = 7;
      }
      out += String(d);
    } else if (cf == 85) {
      out += pad((daysAfterJan01(p) - daysAfterSunday(p) + 7) / 7, 2);
    } else if (cf == 86) {
      const y = thursday(p);
      out += pad(daysAfterJan01(y) / 7 + 1, 2);
    } else if (cf == 87) {
      out += pad((daysAfterJan01(p) - daysAfterMonday(p) + 7) / 7, 2);
    } else if (cf == 89) {
      out += pad(p.Y, 4);
    } else if (cf == 37) {
      out += "%";
    } else {
      return nullVal();
    }
  }
  return textVal(out);
}
