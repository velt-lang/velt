// velt:sqlite/exec/loop — the loop of one FROM level, as a closure around the loops inside it:
// a full scan, a rowid lookup or range, an index scan (prefix equality, a range on the next
// column), or the rows of a subquery; for a LEFT JOIN, the row of NULLs when nothing matched.

import { Cursor, NULL } from "velt:sqlite/btree";
import { KeyRec } from "velt:sqlite/record";
import "velt:sqlite/btree_back";
import { Source } from "velt:sqlite/exec/source";
import { Ev, Out, Params, Pred, Query, Step } from "velt:sqlite/exec/scope";
import { ExprCompiler } from "velt:sqlite/exec/expr";
import {
  ACC_INDEX,
  ACC_ROWID_EQ,
  ACC_ROWID_IN,
  ACC_ROWID_RANGE,
  ACC_ROWS,
  Access,
  Term,
  addKeyField,
  beyondRowids,
  rowidKey,
} from "velt:sqlite/exec/plan";
import { forCompare } from "velt:sqlite/exec/ops";
import { Val, compareVals } from "velt:sqlite/exec/value";

/** Whether a LEFT JOIN level found a row this time round. */
class Matched {
  v: bool = false;
}

export function allOf(ps: Pred[]): Pred | null {
  if (ps.length == 0) {
    return null;
  }
  if (ps.length == 1) {
    return ps[0];
  }
  if (ps.length == 2) {
    const a = ps[0];
    const b = ps[1];
    return () => a() && b();
  }
  return () => {
    for (const p of ps) {
      if (!p()) {
        return false;
      }
    }
    return true;
  };
}

/**
 * The loop of level `lv`: for each row of `src` that its terms accept, `inner` runs. Stops
 * early once `out.stop` is set (LIMIT reached).
 */
export function levelLoop(
  c: ExprCompiler,
  src: Source,
  acc: Access,
  terms: Term[],
  lv: usize,
  left: bool,
  out: Out,
  inner: Step,
): Step {
  const wh: Pred[] = [];
  const on: Pred[] = [];
  for (const t of terms) {
    if (t.level != (lv as i64) || t.used || t.virtual) {
      continue;
    }
    if (left && t.on == (lv as i64)) {
      on.push(t.pred);
    } else {
      wh.push(t.pred);
    }
  }
  const where = allOf(wh);
  const next: Step =
    where == null
      ? inner
      : () => {
        if (where!()) {
          inner();
        }
      };
  if (!left) {
    return scan(c, src, acc, out, next);
  }
  const onp = allOf(on);
  const m = new Matched();
  const each: Step = () => {
    if (onp == null || onp!()) {
      m.v = true;
      next();
    }
  };
  const loop = scan(c, src, acc, out, each);
  return () => {
    m.v = false;
    loop();
    if (!m.v && !out.stop) {
      src.nullRow = true;
      next();
      src.nullRow = false;
    }
  };
}

function scan(c: ExprCompiler, src: Source, acc: Access, out: Out, each: Step): Step {
  if (acc.kind == ACC_ROWS) {
    const q = c.rowsQuery(src);
    const p = c.params;
    return () => {
      q.open(p);
      let r: usize = 0;
      while (!out.stop && q.has(r)) {
        src.at = r;
        each();
        r++;
      }
    };
  }
  const cur = src.cur!;
  if (acc.kind == ACC_ROWID_EQ) {
    const ve = acc.eq[0];
    const aff = acc.eqAff[0];
    return () => {
      const k = rowidKey(ve(), aff, false);
      if (k.ok && !k.frac && cur.seekRowid(k.value)) {
        each();
      }
    };
  }
  if (acc.kind == ACC_ROWID_RANGE) {
    return rowidRange(cur, acc, out, each);
  }
  if (acc.kind == ACC_ROWID_IN) {
    const list = acc.inList!;
    const inq = acc.inQuery;
    const p = c.params;
    const aff = acc.inAff;
    return () => {
      for (const v of inValues(list, inq, p, aff, 0)) {
        if (out.stop) {
          break;
        }
        const k = rowidKey(v, aff, false);
        if (k.ok && !k.frac && cur.seekRowid(k.value)) {
          each();
        }
      }
    };
  }
  if (acc.kind == ACC_INDEX) {
    return indexScan(src, acc, out, each, c.params);
  }
  if (acc.reverse) {
    return () => {
      let ok = cur.last();
      while (ok && !out.stop) {
        each();
        ok = cur.prev();
      }
    };
  }
  return () => {
    let ok = cur.first();
    while (ok && !out.stop) {
      each();
      ok = cur.next();
    }
  };
}

/** An IN list's values as lookups take them: affinity applied, NULLs out, sorted, distinct. */
export function inValues(list: Ev[], q: Query | null, p: Params, aff: u8, coll: u8): Val[] {
  const vals: Val[] = [];
  if (q != null) {
    // A subquery's rows (run once per statement run unless correlated).
    const sub = q!;
    sub.runFor(p);
    for (let r: usize = 0; r < sub.out.rows; r++) {
      const v = forCompare(sub.out.vals[r * sub.out.width], aff);
      if (v.t != NULL) {
        vals.push(v);
      }
    }
  }
  for (const e of list) {
    const v = forCompare(e(), aff);
    if (v.t != NULL) {
      vals.push(v);
    }
  }
  vals.sort((a, b) => compareVals(a, b, coll) as f64);
  const out: Val[] = [];
  for (const v of vals) {
    if (out.length == 0 || compareVals(out[out.length - 1], v, coll) != 0) {
      out.push(v);
    }
  }
  return out;
}

function rowidRange(cur: Cursor, acc: Access, out: Out, each: Step): Step {
  const lo = acc.lo;
  const hi = acc.hi;
  const loAff = acc.loAff;
  const hiAff = acc.hiAff;
  const loIncl = acc.loIncl;
  const hiIncl = acc.hiIncl;
  const reverse = acc.reverse;
  return () => {
    let hasLo = false;
    let start: i64 = 0;
    if (lo != null) {
      const v = lo!();
      if (v.t == NULL) {
        return;
      }
      const k = rowidKey(v, loAff, true);
      if (!k.ok) {
        // Above every integer (text, a REAL past 2^63): no row; below them all: no bound.
        if (beyondRowids(v, loAff) != -1) {
          return;
        }
      } else {
        hasLo = true;
        start = k.value;
        if (!loIncl && !k.frac) {
          if (start == 9223372036854775807) {
            return;
          }
          start++;
        }
      }
    }
    let hasHi = false;
    let end: i64 = 0;
    if (hi != null) {
      const v = hi!();
      if (v.t == NULL) {
        return;
      }
      const k = rowidKey(v, hiAff, false);
      if (k.ok) {
        hasHi = true;
        end = k.value;
        if (!hiIncl && !k.frac) {
          if (end == -9223372036854775807 - 1) {
            return;
          }
          end--;
        }
      } else if (beyondRowids(v, hiAff) != 1) {
        return;
      }
    }
    if (reverse) {
      let ok = hasHi ? cur.seekRowidLe(end) : cur.last();
      while (ok && !out.stop) {
        if (hasLo && cur.rowid < start) {
          break;
        }
        each();
        ok = cur.prev();
      }
      return;
    }
    let ok = hasLo ? cur.seekRowidGe(start) : cur.first();
    while (ok && !out.stop) {
      if (hasHi && cur.rowid > end) {
        break;
      }
      each();
      ok = cur.next();
    }
  };
}

function indexScan(src: Source, acc: Access, out: Out, each: Step, p: Params): Step {
  if (acc.inList != null) {
    return indexIn(src, acc, out, each, p);
  }
  const ix = src.ix!;
  const index = acc.index!;
  const colls = index.colls;
  const desc = index.desc;
  const eq = acc.eq;
  const eqAff = acc.eqAff;
  const eqIs = acc.eqIs;
  const nEq = eq.length;
  const lo = acc.lo;
  const hi = acc.hi;
  const loAff = acc.loAff;
  const hiAff = acc.hiAff;
  const loIncl = acc.loIncl;
  const hiIncl = acc.hiIncl;
  const reverse = acc.reverse;
  // Reused from run to run: the keys, built field by field (no record encoding).
  const prefix = new KeyRec([]);
  const loKey = new KeyRec([]);
  const hiKey = new KeyRec([]);
  return () => {
    prefix.clear();
    for (let i: usize = 0; i < nEq; i++) {
      const v = forCompare(eq[i](), eqAff[i]);
      if (v.t == NULL && !eqIs[i]) {
        return;
      }
      addKeyField(prefix, v);
    }
    let hasHi = false;
    if (hi != null) {
      const v = hi!();
      if (v.t == NULL) {
        return;
      }
      hiKey.clear();
      for (let i: usize = 0; i < nEq; i++) {
        addKeyField(hiKey, forCompare(eq[i](), eqAff[i]));
      }
      addKeyField(hiKey, forCompare(v, hiAff));
      hasHi = true;
    }
    let hasLo = false;
    if (lo != null) {
      const v = lo!();
      if (v.t == NULL) {
        return;
      }
      loKey.clear();
      for (let i: usize = 0; i < nEq; i++) {
        addKeyField(loKey, forCompare(eq[i](), eqAff[i]));
      }
      addKeyField(loKey, forCompare(v, loAff));
      hasLo = true;
    }
    if (reverse) {
      let ok = false;
      if (hasHi) {
        ok = ix.seekLastBefore(hiKey, nEq + 1, colls, desc, !hiIncl);
      } else if (nEq > 0) {
        ok = ix.seekLastBefore(prefix, nEq, colls, desc, false);
      } else {
        ok = ix.last();
      }
      while (ok && !out.stop) {
        if (nEq > 0 && ix.compareKeyRec(prefix, nEq, colls, desc) != 0) {
          break;
        }
        if (hasLo) {
          const r = ix.compareKeyRec(loKey, nEq + 1, colls, desc);
          if (r < 0 || (r == 0 && !loIncl)) {
            break;
          }
        }
        src.seeked = false;
        each();
        ok = ix.prev();
      }
      return;
    }
    let ok = false;
    if (hasLo) {
      ok = ix.seekKeyRec(loKey, nEq + 1, colls, desc);
    } else if (nEq > 0) {
      ok = ix.seekKeyRec(prefix, nEq, colls, desc);
    } else {
      ok = ix.first();
    }
    while (ok && !out.stop) {
      if (nEq > 0 && ix.compareKeyRec(prefix, nEq, colls, desc) != 0) {
        break;
      }
      if (hasHi) {
        const r = ix.compareKeyRec(hiKey, nEq + 1, colls, desc);
        if (r > 0 || (r == 0 && !hiIncl)) {
          break;
        }
      }
      src.seeked = false;
      each();
      ok = ix.next();
    }
  };
}

// An index lookup per value of `col IN (list)` (the column after the equalities).
function indexIn(src: Source, acc: Access, out: Out, each: Step, p: Params): Step {
  const ix = src.ix!;
  const index = acc.index!;
  const colls = index.colls;
  const desc = index.desc;
  const eq = acc.eq;
  const eqAff = acc.eqAff;
  const eqIs = acc.eqIs;
  const nEq = eq.length;
  const list = acc.inList!;
  const inq = acc.inQuery;
  const inAff = acc.inAff;
  const inColl = acc.inColl;
  const key = new KeyRec([]);
  return () => {
    const fixed: Val[] = [];
    for (let i: usize = 0; i < nEq; i++) {
      const v = forCompare(eq[i](), eqAff[i]);
      if (v.t == NULL && !eqIs[i]) {
        return;
      }
      fixed.push(v);
    }
    for (const v of inValues(list, inq, p, inAff, inColl)) {
      if (out.stop) {
        break;
      }
      key.clear();
      for (const f of fixed) {
        addKeyField(key, f);
      }
      addKeyField(key, v);
      let ok = ix.seekKeyRec(key, nEq + 1, colls, desc);
      while (ok && !out.stop) {
        if (ix.compareKeyRec(key, nEq + 1, colls, desc) != 0) {
          break;
        }
        src.seeked = false;
        each();
        ok = ix.next();
      }
    }
  };
}
