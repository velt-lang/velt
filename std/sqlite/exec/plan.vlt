// velt:sqlite/exec/plan — how each FROM item is read: the planner splits WHERE into AND terms
// and, per FROM level (in FROM order), picks a rowid lookup, a rowid range, an index prefix of
// equalities with a range on the next column, or a full scan; then the loop of each level.
//
// A term an access path answers exactly (a rowid or index equality) is not checked again; a
// range term still is, so the index only narrows the rows. A term is checked at the innermost
// level it reads (a LEFT JOIN's ON terms at its own level, before the NULL row decision).

import { NULL, INTEGER, REAL, TEXT, BLOB } from "velt:sqlite/btree";
import { Cursor } from "velt:sqlite/btree";
import { KeyRec } from "velt:sqlite/record";
import { A_BLOB, A_INTEGER, A_NUMERIC, A_REAL, A_TEXT, Index } from "velt:sqlite/schema";
import {
  E_BETWEEN,
  E_BINARY,
  E_COLUMN,
  E_IN_LIST,
  E_IN_SELECT,
  E_IS,
  E_ISNULL,
  E_NULL,
  Expr,
} from "velt:sqlite/sql/ast";
import { ROWID, SRC_ROWS, Source } from "velt:sqlite/exec/source";
import { Ev, Pred, Query, Scope } from "velt:sqlite/exec/scope";
import {
  AFF_NONE,
  comparisonAffinity,
  forCompare,
  OP_EQ,
  OP_GE,
  OP_GT,
  OP_LE,
  OP_LT,
} from "velt:sqlite/exec/ops";
import { C, ExprCompiler, binaryColl, comparisonOp } from "velt:sqlite/exec/expr";
import { Val } from "velt:sqlite/exec/value";

/** Access paths. */
export const ACC_SCAN: u8 = 0;
export const ACC_ROWID_EQ: u8 = 1;
export const ACC_ROWID_RANGE: u8 = 2;
export const ACC_INDEX: u8 = 3;
export const ACC_ROWS: u8 = 4;
export const ACC_ROWID_IN: u8 = 5;

/** A bound that is `col IN (list)`. */
const OP_IN: u8 = 9;

/** A WHERE or ON term. */
export class Term {
  expr: Expr;
  pred: Pred;
  /** The sources of this SELECT it reads. */
  srcs: Source[] = [];
  /** The innermost FROM level it reads (-1: none). */
  level: i64;
  /** For a LEFT JOIN's ON term, its level; else -1. */
  on: i64;
  /** Answered by an access path: not checked again. */
  used: bool = false;
  /** Made for the planner from another term (`x = 1 OR x = 2` as `x IN (1, 2)`): never checked. */
  virtual: bool = false;

  constructor(expr: Expr, pred: Pred, level: i64, on: i64) {
    this.expr = expr;
    this.pred = pred;
    this.level = level;
    this.on = on;
  }
}

/** One side of a term that compares a column of a level with a value from outer levels. */
class Bound {
  col: i64;
  op: u8;
  value: Ev;
  aff: u8;
  coll: u8;
  term: Term;
  /** OP_IN: the list's values. */
  list: Ev[] = [];
  /** An equality written `IS` (or `IS NULL`): a NULL value matches NULL. */
  isIs: bool = false;
  /** OP_IN over a subquery: its rows' values (instead of `list`). */
  inQuery: Query | null = null;

  constructor(col: i64, op: u8, value: Ev, aff: u8, coll: u8, term: Term) {
    this.col = col;
    this.op = op;
    this.value = value;
    this.aff = aff;
    this.coll = coll;
    this.term = term;
  }
}

// An equality a lookup answers: `=`/`==`, `IS`, `IS NULL`.
function eqTerm(e: Expr): bool {
  return e.kind == E_BINARY || e.kind == E_IS || e.kind == E_ISNULL;
}

// The NULL literal an `x IS NULL` compares with.
function nullLiteral(at: Expr): Expr {
  return new Expr(E_NULL, at.at);
}

/** How one level is read. */
export class Access {
  kind: u8 = ACC_SCAN;
  index: Index | null = null;
  /** Values of the index's leading columns (or the rowid), compared under `eqAff`. */
  eq: Ev[] = [];
  eqAff: u8[] = [];
  /** Which equalities are `IS` ones (a NULL value looks up NULL rather than nothing). */
  eqIs: bool[] = [];
  lo: Ev | null = null;
  loAff: u8 = A_BLOB;
  hi: Ev | null = null;
  hiAff: u8 = A_BLOB;
  /** Lower bound inclusive (>=), upper bound inclusive (<=). */
  loIncl: bool = true;
  hiIncl: bool = true;
  /** Scanned last to first (ORDER BY ... DESC without a sort). */
  reverse: bool = false;
  /** `col IN (list)` on the rowid or the index column after `eq`: one lookup per value. */
  inList: Ev[] | null = null;
  inAff: u8 = A_BLOB;
  /** `col IN (SELECT …)`: the values are the subquery's (its first column). */
  inQuery: Query | null = null;
  inColl: u8 = 0;
  /** Terms this access answers exactly (marked used once the access is chosen). */
  uses: Term[] = [];
}

/** A rough cost of reading a level through `acc`, for ordering joins (lower is better). */
export function accessCost(acc: Access): i64 {
  if (acc.kind == ACC_ROWID_EQ) {
    return 1;
  }
  if (acc.kind == ACC_ROWID_IN) {
    return 2;
  }
  if (acc.kind == ACC_INDEX) {
    const ix = acc.index!;
    if (acc.inList == null && ix.unique && acc.eq.length == ix.columns.length) {
      return 3;
    }
    if (acc.eq.length > 0 || acc.inList != null) {
      return 20 - (acc.eq.length as i64);
    }
    return acc.lo != null || acc.hi != null ? 50 : 900;
  }
  if (acc.kind == ACC_ROWID_RANGE) {
    return 60;
  }
  if (acc.kind == ACC_ROWS) {
    return 500;
  }
  return 1000;
}

function isNumericAff(a: u8): bool {
  return a == A_INTEGER || a == A_REAL || a == A_NUMERIC;
}

function swapOp(op: u8): u8 {
  if (op == OP_LT) {
    return OP_GT;
  }
  if (op == OP_LE) {
    return OP_GE;
  }
  if (op == OP_GT) {
    return OP_LT;
  }
  if (op == OP_GE) {
    return OP_LE;
  }
  return op;
}

/** The levels (positions in `sources`) of the sources compiled expressions touched. */
export function levelOf(touched: Source[], from: usize, sources: Source[]): i64 {
  let level: i64 = -1;
  for (let k = from; k < touched.length; k++) {
    const t = touched[k];
    for (let i: usize = 0; i < sources.length; i++) {
      if (sources[i] == t && (i as i64) > level) {
        level = i as i64;
      }
    }
  }
  return level;
}

/** The column of level `lv` that `e` names, or -2. */
function columnOf(c: ExprCompiler, e: Expr, sc: Scope, lv: usize): i64 {
  if (e.kind != E_COLUMN) {
    return -2;
  }
  const f = c.lookup(e, sc);
  if (f == null || f!.src != sc.sources[lv]) {
    return -2;
  }
  return f!.col;
}

/**
 * The bounds terms give on level `lv`'s columns: `col op value` where the value reads only
 * outer levels.
 */
function boundsOf(c: ExprCompiler, terms: Term[], sc: Scope, lv: usize, left: bool): Bound[] {
  const out: Bound[] = [];
  const src = sc.sources[lv];
  for (const t of terms) {
    // A LEFT JOIN's level uses only its ON terms; other levels never use them.
    if (left ? t.on != (lv as i64) : t.on >= 0) {
      continue;
    }
    const e = t.expr;
    if (e.kind == E_BETWEEN && !e.not) {
      const col = columnOf(c, e.a!, sc, lv);
      if (col != -2) {
        addBound(c, out, src, sc, lv, col, OP_GE, e.a!, e.b!, t, true);
        addBound(c, out, src, sc, lv, col, OP_LE, e.a!, e.c!, t, true);
      }
      continue;
    }
    if (e.kind == E_IN_SELECT && !e.not) {
      const col = columnOf(c, e.a!, sc, lv);
      if (col != -2) {
        addInSelectBound(c, out, sc, lv, col, e, t);
      }
      continue;
    }
    if (e.kind == E_IN_LIST && !e.not && e.args.length > 0) {
      const col = columnOf(c, e.a!, sc, lv);
      if (col != -2) {
        addInBound(c, out, src, sc, lv, col, e, t);
      }
      continue;
    }
    if ((e.kind == E_IS || e.kind == E_ISNULL) && !e.not) {
      // `x IS y` and `x IS NULL`: equalities that match NULL too (an index looks NULL up).
      const isNullTest = e.kind == E_ISNULL;
      const ca = columnOf(c, e.a!, sc, lv);
      if (ca != -2) {
        const val = isNullTest ? nullLiteral(e) : e.b!;
        const before = out.length;
        addBound(c, out, src, sc, lv, ca, OP_EQ, e.a!, val, t, true);
        if (out.length > before) {
          out[out.length - 1].isIs = true;
        }
      }
      if (!isNullTest) {
        const cb = columnOf(c, e.b!, sc, lv);
        if (cb != -2) {
          const before = out.length;
          addBound(c, out, src, sc, lv, cb, OP_EQ, e.b!, e.a!, t, false);
          if (out.length > before) {
            out[out.length - 1].isIs = true;
          }
        }
      }
      continue;
    }
    if (e.kind != E_BINARY) {
      continue;
    }
    const op = comparisonOp(e.op);
    if (op < 0 || op == 1) {
      continue;
    }
    const ca = columnOf(c, e.a!, sc, lv);
    if (ca != -2) {
      addBound(c, out, src, sc, lv, ca, op as u8, e.a!, e.b!, t, true);
    }
    const cb = columnOf(c, e.b!, sc, lv);
    if (cb != -2) {
      addBound(c, out, src, sc, lv, cb, swapOp(op as u8), e.b!, e.a!, t, false);
    }
  }
  return out;
}

function addBound(
  c: ExprCompiler,
  out: Bound[],
  src: Source,
  sc: Scope,
  lv: usize,
  col: i64,
  op: u8,
  colExpr: Expr,
  valExpr: Expr,
  t: Term,
  colLeft: bool,
) {
  const mark = c.track();
  const v = c.expr(valExpr, sc);
  if (levelOf(c.touched, mark, sc.sources) >= (lv as i64)) {
    return;
  }
  const k = c.expr(colExpr, sc);
  const aff = comparisonAffinity(k.aff, v.aff);
  // The collation follows the operands' order as written (the left one's first).
  const coll = colLeft ? binaryColl(k, v) : binaryColl(v, k);
  out.push(new Bound(col, op, v.ev, aff, coll, t));
}

function addInBound(
  c: ExprCompiler,
  out: Bound[],
  src: Source,
  sc: Scope,
  lv: usize,
  col: i64,
  e: Expr,
  t: Term,
) {
  const list: Ev[] = [];
  for (const a of e.args) {
    const mark = c.track();
    const v = c.expr(a, sc);
    if (levelOf(c.touched, mark, sc.sources) >= (lv as i64)) {
      return;
    }
    list.push(v.ev);
  }
  const k = c.expr(e.a!, sc);
  // IN compares under the left side's affinity and collation.
  const aff = k.aff == AFF_NONE ? A_BLOB : k.aff;
  const coll: u8 = k.coll >= 0 ? k.coll as u8 : 0;
  const b = new Bound(col, OP_IN, list[0], aff, coll, t);
  b.list = list;
  out.push(b);
}

// `col IN (SELECT …)` with a subquery that reads no level from `lv` on: a lookup per value.
function addInSelectBound(
  c: ExprCompiler,
  out: Bound[],
  sc: Scope,
  lv: usize,
  col: i64,
  e: Expr,
  t: Term,
) {
  const mark = c.track();
  const q = c.subquery(e.select!, sc);
  if (q.names.length != 1 || levelOf(c.touched, mark, sc.sources) >= (lv as i64)) {
    return;
  }
  const k = c.expr(e.a!, sc);
  // As the IN test compares: the two sides' affinity, the left side's collation first.
  const aff = comparisonAffinity(q.affs[0], k.aff);
  const coll = binaryColl(k, C { ev: k.ev, aff: q.affs[0], coll: q.colls[0], explicit: false });
  const b = new Bound(col, OP_IN, k.ev, aff == AFF_NONE ? A_BLOB : aff, coll, t);
  b.inQuery = q;
  out.push(b);
}

// Whether a comparison under `aff` can use an index on a column of affinity `colAff`.
function affinityOk(aff: u8, colAff: u8): bool {
  if (aff == A_BLOB) {
    return true;
  }
  if (aff == A_TEXT) {
    return colAff == A_TEXT;
  }
  return isNumericAff(colAff);
}

function isRowid(src: Source, col: i64): bool {
  return col == ROWID || (col >= 0 && col == src.rowidCol);
}

/** Picks how level `lv` is read. */
export function chooseAccess(
  c: ExprCompiler,
  terms: Term[],
  sc: Scope,
  lv: usize,
  left: bool,
): Access {
  const src = sc.sources[lv];
  const acc = new Access();
  if (src.kind == SRC_ROWS) {
    acc.kind = ACC_ROWS;
    return acc;
  }
  const bounds = boundsOf(c, terms, sc, lv, left);
  // A rowid equality: one row.
  for (const b of bounds) {
    if (isRowid(src, b.col) && b.op == OP_EQ && eqTerm(b.term.expr)) {
      acc.kind = ACC_ROWID_EQ;
      acc.eq.push(b.value);
      acc.eqAff.push(b.aff);
      acc.eqIs.push(b.isIs);
      acc.uses.push(b.term);
      return acc;
    }
  }
  for (const b of bounds) {
    if (isRowid(src, b.col) && b.op == OP_IN) {
      acc.kind = ACC_ROWID_IN;
      acc.inList = b.list;
      acc.inQuery = b.inQuery;
      acc.inAff = b.aff;
      acc.uses.push(b.term);
      return acc;
    }
  }
  const t = src.table!;
  let best: Index | null = null;
  let bestScore: i64 = 0;
  // Newest index first, as SQLite keeps a table's indexes: it wins a tie.
  for (let i = t.indexes.length; i > 0; i--) {
    const ix = t.indexes[i - 1];
    if (ix.partial) {
      continue;
    }
    const s = indexScore(src, ix, bounds);
    if (s > bestScore) {
      best = ix;
      bestScore = s;
    }
  }
  if (best != null) {
    useIndex(src, acc, best!, bounds);
    return acc;
  }
  for (const b of bounds) {
    if (isRowid(src, b.col) && b.op != OP_EQ && b.op != OP_IN) {
      acc.kind = ACC_ROWID_RANGE;
      setRange(acc, b);
    }
  }
  return acc;
}

function setRange(acc: Access, b: Bound) {
  if (b.op == OP_GT || b.op == OP_GE) {
    if (acc.lo == null) {
      acc.lo = b.value;
      acc.loAff = b.aff;
      acc.loIncl = b.op == OP_GE;
    }
  } else if (b.op == OP_LT || b.op == OP_LE) {
    if (acc.hi == null) {
      acc.hi = b.value;
      acc.hiAff = b.aff;
      acc.hiIncl = b.op == OP_LE;
    }
  }
}

// The bound on index column `k` usable for op class `eq` (equality) or a range.
function boundFor(src: Source, ix: Index, k: usize, b: Bound): bool {
  const col = ix.columns[k];
  if (col == -2) {
    return false;
  }
  const same = col == -1 ? isRowid(src, b.col) : b.col == col;
  if (!same) {
    return false;
  }
  if (col == -1) {
    return true;
  }
  return b.coll == ix.colls[k] && affinityOk(b.aff, src.affs[col as usize]);
}

function indexScore(src: Source, ix: Index, bounds: Bound[]): i64 {
  let k: usize = 0;
  while (k < ix.columns.length) {
    let found = false;
    for (const b of bounds) {
      if (b.op == OP_EQ && eqTerm(b.term.expr) && boundFor(src, ix, k, b)) {
        found = true;
        break;
      }
    }
    if (!found) {
      break;
    }
    k++;
  }
  if (k < ix.columns.length) {
    for (const b of bounds) {
      if (b.op == OP_IN && boundFor(src, ix, k, b)) {
        // One lookup per value: as good as an equality, a little less.
        const unique = ix.unique && k + 1 == ix.columns.length ? 1000 : 0;
        return unique + ((k + 1) as i64) * 4 - 1;
      }
    }
  }
  let range = false;
  if (k < ix.columns.length) {
    for (const b of bounds) {
      if (b.op != OP_EQ && b.op != OP_IN && boundFor(src, ix, k, b)) {
        range = true;
      }
    }
  }
  if (k == 0 && !range) {
    return 0;
  }
  const unique = ix.unique && k == ix.columns.length ? 1000 : 0;
  return unique + (k as i64) * 4 + (range ? 2 : 0);
}

function useIndex(src: Source, acc: Access, ix: Index, bounds: Bound[]) {
  acc.kind = ACC_INDEX;
  acc.index = ix;
  let k: usize = 0;
  while (k < ix.columns.length) {
    let found: Bound | null = null;
    for (const b of bounds) {
      if (b.op == OP_EQ && eqTerm(b.term.expr) && boundFor(src, ix, k, b)) {
        found = b;
        break;
      }
    }
    if (found == null) {
      break;
    }
    acc.eq.push(found!.value);
    acc.eqAff.push(found!.aff);
    acc.eqIs.push(found!.isIs);
    acc.uses.push(found!.term);
    k++;
  }
  if (k < ix.columns.length) {
    for (const b of bounds) {
      if (b.op == OP_IN && boundFor(src, ix, k, b)) {
        acc.inList = b.list;
        acc.inQuery = b.inQuery;
        acc.inAff = b.aff;
        acc.inColl = ix.colls[k];
        acc.uses.push(b.term);
        return;
      }
    }
    for (const b of bounds) {
      if (b.op != OP_EQ && b.op != OP_IN && boundFor(src, ix, k, b)) {
        setRange(acc, b);
      }
    }
    // A descending column holds larger values first: the bounds swap in the index's order.
    if (ix.desc[k]) {
      const lo = acc.lo;
      const loAff = acc.loAff;
      const loIncl = acc.loIncl;
      acc.lo = acc.hi;
      acc.loAff = acc.hiAff;
      acc.loIncl = acc.hiIncl;
      acc.hi = lo;
      acc.hiAff = loAff;
      acc.hiIncl = loIncl;
    }
  }
}

/** Prepares `src` to read through `ix` (an ordered or constrained index scan). */
export function attachIndex(src: Source, ix: Index) {
  const t = src.table!;
  src.ix = new Cursor(src.cur!.db, ix.root);
  src.viaIndex = true;
  src.ixMap = [];
  for (let i: usize = 0; i < t.columns.length; i++) {
    let at: i64 = -1;
    for (let k: usize = 0; k < ix.columns.length; k++) {
      if (ix.columns[k] == (i as i64)) {
        at = k as i64;
      }
    }
    src.ixMap.push(at);
  }
}

/** Adds a value to a decoded index key. */
export function addKeyField(k: KeyRec, v: Val) {
  if (v.t == NULL) {
    k.addNull();
  } else if (v.t == INTEGER) {
    k.addInt(v.i);
  } else if (v.t == REAL) {
    k.addReal(v.r);
  } else if (v.t == 3) {
    k.addText(v.s);
  } else {
    k.addBlob(v.b);
  }
}

/** A rowid from a value compared under numeric affinity: its integer, or none. */
export struct RowidKey {
  ok: bool;
  value: i64;
  /** For a REAL between integers: the value was rounded (exclusive bounds move). */
  frac: bool;
}

export function rowidKey(v0: Val, aff: u8, up: bool): RowidKey {
  const v = forCompare(v0, aff == AFF_NONE ? A_NUMERIC : aff);
  if (v.t == INTEGER) {
    return RowidKey { ok: true, value: v.i, frac: false };
  }
  if (v.t == REAL) {
    const r = v.r;
    if (r != r || r >= 9223372036854775808.0 || r < -9223372036854775808.0) {
      return RowidKey { ok: false, value: 0, frac: false };
    }
    const t = up ? Math.ceil(r) : Math.floor(r);
    return RowidKey { ok: true, value: t as i64, frac: t != r };
  }
  return RowidKey { ok: false, value: 0, frac: false };
}

/**
 * Where a bound that is no rowid lies (`rowidKey` not ok): 1 above every integer (a REAL of
 * 2^63 or more, text, a blob), -1 below every integer (a REAL under -2^63), 0 nowhere (NULL).
 */
export function beyondRowids(v0: Val, aff: u8): i64 {
  const v = forCompare(v0, aff == AFF_NONE ? A_NUMERIC : aff);
  if (v.t == REAL) {
    return v.r < 0 ? -1 : (v.r > 0 ? 1 : 0);
  }
  if (v.t == TEXT || v.t == BLOB) {
    return 1;
  }
  return 0;
}
