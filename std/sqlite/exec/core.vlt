// velt:sqlite/exec/core — one SELECT core compiled into nested loops: the FROM items (tables,
// subqueries, CTEs) with their joins, WHERE terms placed at the innermost level they read, and
// the rows going to the output stage, through the groups of an aggregate query when it is one.

import { BINARY } from "velt:sqlite/record";
import {
  E_BINARY,
  E_CALL,
  E_COLUMN,
  Expr,
  FromItem,
  J_FULL,
  J_LEFT,
  J_RIGHT,
  OrderTerm,
  SelectCore,
} from "velt:sqlite/sql/ast";
import { SRC_ROWS, Source } from "velt:sqlite/exec/source";
import { AggRestart, Ev, Pred, Query, Scope, Step } from "velt:sqlite/exec/scope";
import { AG_COUNT_STAR, AggCtx } from "velt:sqlite/exec/agg";
import { prepareError } from "velt:sqlite/exec/errors";
import { ExprCompiler } from "velt:sqlite/exec/expr";
import { hasWindow } from "velt:sqlite/exec/compiled";
import {
  MAX_COLUMN,
  checkResultWidth,
  checkTerms,
  orderKeys,
  rangeError,
  resultColumns,
  resultIndex,
} from "velt:sqlite/exec/result";
export { checkTerms, ordinal, rangeError, resultIndex } from "velt:sqlite/exec/result";
import { WinCtx } from "velt:sqlite/exec/window";
import { lastWindowCalls } from "velt:sqlite/exec/window_call";
import { Pull } from "velt:sqlite/exec/pull";
import { walkOf } from "velt:sqlite/exec/walk";
import { ownsAggregate } from "velt:sqlite/exec/agg_owner";
import {
  accessInOrder,
  coveringIndex,
  coveringLike,
  covers,
  describe,
  distinctOrdered,
  groupIndex,
  minMaxIndex,
  orAsIn,
  orderJoins,
} from "velt:sqlite/exec/core_plan";
import { Emitter, limitValue } from "velt:sqlite/exec/emit";
import {
  ACC_INDEX,
  ACC_SCAN,
  Access,
  Term,
  accessCost,
  attachIndex,
  chooseAccess,
  levelOf,
} from "velt:sqlite/exec/plan";
import { allOf, levelLoop } from "velt:sqlite/exec/loop";
import { GroupState, groupStepFor, outputGroups } from "velt:sqlite/exec/group";
import { AFF_NONE } from "velt:sqlite/exec/ops";
import { Val, intVal, nullVal } from "velt:sqlite/exec/value";

/** ORDER BY, LIMIT and OFFSET of the SELECT a core is the whole of. */
export class Tail {
  orderBy: OrderTerm[] = [];
  limit: Expr | null = null;
  offset: Expr | null = null;
}

/** Splits `e` into its AND terms. */
export function andTerms(e: Expr | null, out: Expr[]) {
  if (e == null) {
    return;
  }
  const x = e!;
  if (x.kind == E_BINARY && x.op == "AND") {
    andTerms(x.a, out);
    andTerms(x.b, out);
    return;
  }
  out.push(x);
}

function colExpr(table: string, name: string): Expr {
  const e = new Expr(E_COLUMN, 0);
  e.table = table;
  e.name = name;
  return e;
}

function eqExpr(a: Expr, b: Expr): Expr {
  const e = new Expr(E_BINARY, 0);
  e.op = "=";
  e.a = a;
  e.b = b;
  return e;
}

/** Compiles one core (with the SELECT's ORDER BY and LIMIT when it is the only core). */
export function compileCore(
  c: ExprCompiler,
  core: SelectCore,
  outer: Scope | null,
  tail: Tail,
): Query {
  // Again as an aggregate query when a subquery turns out to hold one of its aggregates.
  while (true) {
    const again = core.aggFromInner;
    const refs = c.refMark();
    const rows = c.rowsSrc.length;
    try {
      if (core.values.length > 0) {
        return valuesCore(c, core, outer, tail, new Query());
      }
      const fp = compileFrom(c, core, outer);
      return compileCoreOnce(c, core, outer, tail, fp);
    } catch (e) {
      if (e instanceof AggRestart && e.core == core && !again) {
        // The FROM items compile again: what they counted the first time is taken back.
        c.rewind(refs, rows);
        continue;
      }
      throw e;
    }
  }
}

/** A core's FROM items compiled: their scope, LEFT JOIN levels, ON terms and their levels. */
class FromPart {
  sc: Scope = new Scope();
  left: bool[] = [];
  onExprs: Expr[] = [];
  onLevel: i64[] = [];
}

// The FROM items: compiled before the rest of the core, in a small frame, since a nested
// subquery, view or CTE compiles inside it (the rest of the core's frame is not on the stack
// while nested queries compile).
function compileFrom(c: ExprCompiler, core: SelectCore, outer: Scope | null): FromPart {
  const fp = new FromPart();
  const sc = fp.sc;
  sc.parent = outer;
  sc.core = core;
  for (const item of core.from) {
    const lv = sc.sources.length;
    const src = c.fromSource(item, outer);
    if (item.join == J_RIGHT || item.join == J_FULL) {
      prepareError("RIGHT and FULL OUTER JOINs are not supported yet");
    }
    const isLeft = item.join == J_LEFT && lv > 0;
    joinColumns(sc, src, item, fp.onExprs, fp.onLevel, isLeft ? lv as i64 : -1);
    sc.sources.push(src);
    fp.left.push(isLeft);
    if (item.on != null) {
      const parts: Expr[] = [];
      andTerms(item.on, parts);
      for (const p of parts) {
        fp.onExprs.push(p);
        fp.onLevel.push(isLeft ? lv as i64 : -1);
      }
    }
  }
  // After its FROM items compiled: theirs are counted (and kept) already.
  c.noteFromTerms(core);
  return fp;
}

function compileCoreOnce(
  c: ExprCompiler,
  core: SelectCore,
  outer: Scope | null,
  tail: Tail,
  fp: FromPart,
): Query {
  const q = new Query();
  const sc = fp.sc;
  const terms: Term[] = [];
  const left = fp.left;
  const onExprs = fp.onExprs;
  const onLevel = fp.onLevel;
  sc.aliases = core.columns;
  checkResultWidth(core.columns, sc);
  // WHERE and ON terms, each at the innermost level it reads.
  const whereParts: Expr[] = [];
  andTerms(core.where, whereParts);
  for (const e of whereParts) {
    onExprs.push(e);
    onLevel.push(-1);
  }
  for (let i: usize = 0; i < onExprs.length; i++) {
    const mark = c.track();
    sc.where = true;
    let pred: Pred = () => false;
    try {
      pred = c.pred(onExprs[i], sc);
    } finally {
      sc.where = false;
    }
    let level = levelOf(c.touched, mark, sc.sources);
    if (onLevel[i] > level) {
      level = onLevel[i];
    }
    const t = new Term(onExprs[i], pred, level, onLevel[i]);
    for (let k = mark; k < c.touched.length; k++) {
      if (sc.sources.includes(c.touched[k]) && !t.srcs.includes(c.touched[k])) {
        t.srcs.push(c.touched[k]);
      }
    }
    terms.push(t);
    const inTerm = orAsIn(onExprs[i]);
    if (inTerm != null) {
      const v = new Term(inTerm!, pred, level, onLevel[i]);
      v.srcs = t.srcs;
      v.virtual = true;
      terms.push(v);
    }
  }
  // Inner joins run in the order of their cheapest access paths.
  if (sc.sources.length > 1 && !left.includes(true)) {
    sc.fromOrder = sc.sources.slice();
    orderJoins(c, terms, sc);
  }
  // How each level is read.
  const access: Access[] = [];
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const a = chooseAccess(c, terms, sc, lv, left[lv]);
    for (const t of a.uses) {
      t.used = true;
    }
    if (a.kind == ACC_INDEX) {
      attachIndex(sc.sources[lv], a.index!);
    }
    access.push(a);
  }
  // Aggregates and the output scope.
  // An aggregate query: GROUP BY, or an aggregate among the result columns (one in ORDER BY
  // or HAVING alone does not make it one, as in SQLite).
  let isAgg = core.groupBy.length > 0 || core.aggFromInner;
  for (const rc of core.columns) {
    if (ownsAggregate(c, rc.expr, sc)) {
      isAgg = true;
    }
  }
  if (core.having != null && !isAgg) {
    prepareError("HAVING clause on a non-aggregate query");
  }
  const agg = new AggCtx();
  const osc0 = isAgg ? sc.forOutput(agg) : sc;
  // Window functions: the rows are collected, and go out once the windows are computed.
  let hasWin = false;
  for (const rc of core.columns) {
    hasWin = hasWin || hasWindow(rc.expr);
  }
  for (const o of tail.orderBy) {
    hasWin = hasWin || hasWindow(o.expr);
  }
  const win = new WinCtx();
  const osc = hasWin ? osc0.forWindows(win, core.windows) : osc0;
  const em = new Emitter(q.out);
  em.distinct = core.distinct;
  sc.output = !isAgg;
  // With window functions SQLite makes it an aggregate query from a subquery's aggregate only
  // in the windows it computes last (window_call's lastWindowCalls); elsewhere that is its
  // misuse error.
  sc.results = !isAgg && !hasWin;
  if (hasWin) {
    osc.lastWins = lastWindowCalls(core.columns, tail.orderBy, core.windows);
  }
  setWindowed([sc, osc0, osc], hasWin);
  try {
    resultColumns(c, core.columns, osc, q, em);
    sc.results = false;
    osc.lastWins = [];
    q.out.width = q.names.length;
    // ORDER BY: by the loops' order when the first level gives it, else a sort.
    checkTerms(tail.orderBy.length, "ORDER");
    if (tail.orderBy.length > 0) {
      orderKeys(c, tail.orderBy, osc, q, em);
    }
  } finally {
    sc.results = false;
    setWindowed([sc, osc0, osc], false);
  }
  let sortedTerms: usize = 0;
  if (tail.orderBy.length > 0 && !isAgg && !hasWin && sc.sources.length > 0) {
    sortedTerms = accessInOrder(c, em.sort, tail.orderBy, osc, access, left, q);
    if (sortedTerms == em.sort.length) {
      em.sorting = false;
    }
  }
  // The window computed first sorts the rows: as in SQLite, the loops give its order when they
  // can (its sort is stable, so the rows it ties keep the loops' order).
  let winOrder = false;
  if (hasWin && !isAgg && sc.sources.length > 0 && win.specs.length > 0) {
    const sp = win.specs[win.specs.length - 1];
    if (sp.sk.length > 0) {
      winOrder = accessInOrder(c, sp.sk, sp.terms, sc, access, left, q) > 0;
    }
  }
  // LIMIT and OFFSET name no column, not even an enclosing query's (SQLite resolves them in an
  // empty name context).
  const limitEv: Ev | null = tail.limit == null ? null : c.ev(tail.limit!, new Scope());
  const offsetEv: Ev | null = tail.offset == null ? null : c.ev(tail.offset!, new Scope());
  // Terms that read no level of this core run once, before the loops.
  const pre: Pred[] = [];
  for (const t of terms) {
    if (t.level < 0 && !t.used && !t.virtual) {
      pre.push(t.pred);
    }
  }
  let groupStep: Step | null = null;
  const groups = new GroupState();
  if (isAgg) {
    checkTerms(core.groupBy.length, "GROUP");
    groupStep = groupStepFor(c, core, sc, agg, groups, q);
  }
  const having: Pred | null = core.having == null ? null : c.pred(core.having!, osc0);
  // SQLite sorts by a window's PARTITION BY and ORDER BY together, as one ORDER BY.
  if (win.tooManyTerms) {
    prepareError("too many terms in ORDER BY clause");
  }
  // GROUP BY or DISTINCT without ORDER BY on one table: SQLite scans an index led by the first
  // grouping column, which decides which row of a group shows its bare columns. For DISTINCT
  // over a range it does so only when the index orders all the result columns (else the range
  // stays, and DISTINCT uses a temporary b-tree).
  if (
    tail.orderBy.length == 0 &&
    !(hasWin && !isAgg) &&
    sc.sources.length == 1 &&
    accessCost(access[0]) >= 50 &&
    (core.groupBy.length > 0 || core.distinct)
  ) {
    // Over a range scan too: the range's terms are still checked on each row.
    const ix = groupIndex(c, core, sc);
    // For DISTINCT over a range, only an index that orders every result column wins.
    const ranged = core.groupBy.length == 0 && accessCost(access[0]) < 900;
    if (ix != null && (!ranged || distinctOrdered(c, core, sc, ix!))) {
      const a = new Access();
      a.kind = ACC_INDEX;
      a.index = ix;
      access[0] = a;
      attachIndex(sc.sources[0], ix!);
    }
  }
  const minmax = isAgg && !hasWin && minMaxIndex(c, core, sc, agg, access, left);
  // A full scan reads a covering index instead when one holds every column used (as SQLite
  // does: index rows are smaller), unless the table's rowid order is the ORDER BY's.
  const keepOrder = (tail.orderBy.length > 0 && !em.sorting) || winOrder;
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    if (access[lv].kind == ACC_SCAN && !(lv == 0 && keepOrder)) {
      const ix = coveringIndex(sc.sources[lv]);
      if (ix != null) {
        access[lv].kind = ACC_INDEX;
        access[lv].index = ix;
        attachIndex(sc.sources[lv], ix!);
      }
    }
  }
  // An index the plan reads that lacks a column the query uses gives way to one that has every
  // column (and the same leading ones): SQLite prefers the covering index.
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const a = access[lv];
    if (a.kind == ACC_INDEX && !covers(sc.sources[lv], a.index!)) {
      const better = coveringLike(sc.sources[lv], a);
      if (better != null) {
        a.index = better;
        attachIndex(sc.sources[lv], better!);
      }
    }
  }
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const line = describe(sc.sources[lv], access[lv]);
    // min() or max() read at one end of the index: SQLite calls that a search.
    q.plan.push(lv == 0 && minmax && line.startsWith("SCAN ") ? "SEARCH " + line.slice(5) : line);
  }
  if (em.sorting) {
    const rest = em.sort.length - sortedTerms;
    q.plan.push(
      sortedTerms == 0
        ? "USE TEMP B-TREE FOR ORDER BY"
        : rest == 1
          ? "USE TEMP B-TREE FOR LAST TERM OF ORDER BY"
          : `USE TEMP B-TREE FOR LAST ${rest} TERMS OF ORDER BY`,
    );
  }
  const emitRow: Step = hasWin ? () => win.collect() : () => em.row();
  let rowFn: Step = groupStep != null ? groupStep! : emitRow;
  if (minmax) {
    // The first row with a value is the minimum (maximum): the loops stop there.
    const step = groupStep!;
    const stopAt = q.out;
    rowFn = () => {
      step();
      if (groups.single!.accs[0].has) {
        stopAt.stop = true;
      }
    };
  }
  // `SELECT count(*) FROM … [WHERE …]` alone: the loops only count.
  const countOnly = countOnlyCore(core, isAgg, hasWin, agg);
  const counter = new Counter();
  if (countOnly) {
    rowFn = () => {
      counter.n++;
    };
  }
  let inner = rowFn;
  for (let lv = sc.sources.length; lv > 0; lv--) {
    inner = levelLoop(
      c,
      sc.sources[lv - 1],
      access[lv - 1],
      terms,
      lv - 1,
      left[lv - 1],
      q.out,
      inner,
    );
  }
  const loops = inner;
  q.correlated = sc.outer || osc0.outer || osc.outer;
  for (const src of sc.sources) {
    if (src.kind == SRC_ROWS && c.rowsQuery(src).correlated) {
      q.correlated = true;
    }
  }
  // Rows that go out in the loops' order can also be read one at a time (velt:db's decoders).
  if (!isAgg && !hasWin && !em.distinct && !em.sorting) {
    const pl = pullOf(c, sc, access, terms, left, pre, em, q, limitEv, offsetEv);
    q.pull = pl;
    // Read as a FROM item, its rows are made as the reader wants them (a co-routine).
    const lazyOut = q.out;
    q.lazyStart = () => pl.begin(-1);
    q.lazyMore = () => {
      const ok = pl.next();
      if (pl.err != null) {
        throw pl.err!;
      }
      if (!ok) {
        return false;
      }
      for (let i: usize = 0; i < lazyOut.width; i++) {
        lazyOut.vals.push(pl.rowVal(i));
      }
      if (pl.err != null) {
        throw pl.err!;
      }
      lazyOut.rows++;
      return true;
    };
  }
  const need = q;
  const out = q.out;
  if (countOnly) {
    q.body = () => {
      let limit = limitValue(limitEv, -1);
      const offset = limitValue(offsetEv, 0);
      if (need.need >= 0 && (limit < 0 || limit > need.need)) {
        limit = need.need;
      }
      if (limit == 0) {
        return;
      }
      counter.n = 0;
      let ok = true;
      for (const p of pre) {
        if (!p()) {
          ok = false;
          break;
        }
      }
      if (ok) {
        loops();
      }
      if (offset > 0) {
        return;
      }
      out.vals.push(intVal(counter.n));
      out.rows = 1;
    };
    return q;
  }
  q.body = () => {
    let limit = limitValue(limitEv, -1);
    const offset = limitValue(offsetEv, 0);
    if (need.need >= 0 && (limit < 0 || limit > need.need)) {
      limit = need.need;
    }
    em.begin(limit, offset);
    if (limit == 0) {
      return;
    }
    if (isAgg) {
      groups.reset(agg);
    }
    if (hasWin) {
      win.reset();
    }
    for (const p of pre) {
      if (!p()) {
        if (isAgg && core.groupBy.length == 0) {
          outputGroups(agg, groups, having, em.out, emitRow, core.groupBy.length > 0);
        }
        if (hasWin) {
          win.finish(() => em.row(), () => out.stop);
        }
        em.finish();
        return;
      }
    }
    loops();
    if (minmax) {
      out.stop = false;
    }
    if (isAgg) {
      outputGroups(agg, groups, having, em.out, emitRow, core.groupBy.length > 0);
    }
    if (hasWin) {
      win.finish(() => em.row(), () => out.stop);
    }
    em.finish();
  };
  return q;
}

/** Rows counted by a count-only query's loops. */
class Counter {
  n: i64 = 0;
}

// Whether a core is `SELECT count(*) FROM … [WHERE …]` (no GROUP BY, HAVING, DISTINCT, other
// aggregate or column): its run counts the loops' rows and outputs the count.
function countOnlyCore(core: SelectCore, isAgg: bool, hasWin: bool, agg: AggCtx): bool {
  if (!isAgg || hasWin || core.groupBy.length > 0 || core.having != null || core.distinct) {
    return false;
  }
  if (agg.fns.length != 1 || agg.bareSrc.length > 0 || core.columns.length != 1) {
    return false;
  }
  const f = agg.fns[0];
  const e = core.columns[0].expr;
  return (
    f.kind == AG_COUNT_STAR &&
    f.filter == null &&
    e.kind == E_CALL &&
    e.star &&
    e.over == null &&
    e.filter == null
  );
}

// The query as a `Pull`: a walk per level, the terms its loop checks, the result columns.
function pullOf(
  c: ExprCompiler,
  sc: Scope,
  access: Access[],
  terms: Term[],
  left: bool[],
  pre: Pred[],
  em: Emitter,
  q: Query,
  limitEv: Ev | null,
  offsetEv: Ev | null,
): Pull {
  const p = new Pull(q.names);
  for (let lv: usize = 0; lv < sc.sources.length; lv++) {
    const src = sc.sources[lv];
    p.walks.push(walkOf(c, src, access[lv]));
    p.srcs.push(src);
    p.left.push(left[lv]);
    const wh: Pred[] = [];
    const on: Pred[] = [];
    for (const t of terms) {
      if (t.level != (lv as i64) || t.used || t.virtual) {
        continue;
      }
      if (left[lv] && t.on == (lv as i64)) {
        on.push(t.pred);
      } else {
        wh.push(t.pred);
      }
    }
    p.wheres.push(allOf(wh));
    p.ons.push(allOf(on));
  }
  p.pre = pre;
  p.evs = em.results;
  for (let i: usize = 0; i < q.refSrc.length; i++) {
    p.plain.push(q.refSrc[i]);
    p.cols.push(q.refCol[i]);
  }
  p.readers();
  p.limitEv = limitEv;
  p.offsetEv = offsetEv;
  p.single = sc.sources.length == 1 && !left[0];
  return p;
}

/** USING and NATURAL: the right side's shared columns are hidden, and joined by equality. */
function joinColumns(sc: Scope, src: Source, item: FromItem, ons: Expr[], lv: i64[], on: i64) {
  let names: string[] = item.using;
  if (item.natural) {
    names = [];
    for (let i: usize = 0; i < src.cols.length; i++) {
      for (const l of sc.sources) {
        const k = l.column(src.cols[i]);
        if (k >= 0 && !l.hidden[k as usize] && !names.includes(src.cols[i])) {
          names.push(src.cols[i]);
        }
      }
    }
  }
  for (const n of names) {
    const r = src.column(n);
    let from: Source | null = null;
    for (const l of sc.sources) {
      const k = l.column(n);
      if (k >= 0 && !l.hidden[k as usize] && from == null) {
        from = l;
      }
    }
    if (r < 0 || from == null) {
      prepareError(`cannot join using column ${n} - column not present in both tables`);
    }
    src.hidden[r as usize] = true;
    ons.push(eqExpr(colExpr(from!.name, n), colExpr(src.name, n)));
    lv.push(on);
  }
}

/** VALUES (…), (…): each row's expressions. */
function valuesCore(
  c: ExprCompiler,
  core: SelectCore,
  outer: Scope | null,
  tail: Tail,
  q: Query,
): Query {
  const sc = new Scope();
  sc.parent = outer;
  const rows: Ev[][] = [];
  const width = core.values[0].length;
  if (width > MAX_COLUMN) {
    prepareError("too many columns in result set");
  }
  for (const r of core.values) {
    if (r.length != width) {
      prepareError("all VALUES must have the same number of terms");
    }
    const evs: Ev[] = [];
    for (const e of r) {
      evs.push(c.ev(e, sc));
    }
    rows.push(evs);
  }
  for (let i: usize = 0; i < width; i++) {
    q.names.push(`column${i + 1}`);
    q.affs.push(AFF_NONE);
    q.colls.push(-1);
  }
  q.out.width = width;
  q.correlated = sc.outer;
  const out = q.out;
  const em = new Emitter(out);
  for (let i: usize = 0; i < width; i++) {
    em.results.push(() => nullVal());
    em.colls.push(BINARY);
  }
  const limitEv: Ev | null = tail.limit == null ? null : c.ev(tail.limit!, new Scope());
  const offsetEv: Ev | null = tail.offset == null ? null : c.ev(tail.offset!, new Scope());
  const need = q;
  q.body = () => {
    let limit = limitValue(limitEv, -1);
    const offset = limitValue(offsetEv, 0);
    if (need.need >= 0 && (limit < 0 || limit > need.need)) {
      limit = need.need;
    }
    em.begin(limit, offset);
    const tmp: Val[] = [];
    for (const r of rows) {
      if (out.stop) {
        break;
      }
      __intrinsic_array_truncate(tmp, 0);
      for (const e of r) {
        tmp.push(e());
      }
      em.put(tmp, 0);
    }
  };
  return q;
}

// Marks (or unmarks) the scopes of a query with window functions while its result columns and
// ORDER BY compile (Scope.windowed).
function setWindowed(scopes: Scope[], on: bool) {
  for (const s of scopes) {
    s.windowed = on;
  }
}
