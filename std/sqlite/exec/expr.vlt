// velt:sqlite/exec/expr — expressions compiled into closures: names resolved against the FROM
// items of the query and its enclosing queries, operators with SQLite's affinity, collation and
// NULL rules (https://sqlite.org/lang_expr.html, https://sqlite.org/datatype3.html).
//
// Compiling happens once, at `prepare`; a compiled expression (`Ev`) reads the columns of the
// rows the loops stand on each time it runs. Subqueries are compiled by the SELECT compiler
// (velt:sqlite/exec/select, a subclass) and run again for each row only when correlated.

import { DbFile } from "velt:sqlite/format";
import { NULL } from "velt:sqlite/btree";
import { BINARY } from "velt:sqlite/record";
import { A_BLOB, A_INTEGER, Schema, affinityOf, collationOf } from "velt:sqlite/schema";
import {
  E_BETWEEN,
  E_BINARY,
  E_BLOB,
  E_CALL,
  E_CASE,
  E_CAST,
  E_COLLATE,
  E_COLUMN,
  E_EXISTS,
  E_FALSE,
  E_INT,
  E_IN_LIST,
  E_IN_SELECT,
  E_IS,
  E_ISNULL,
  E_LIKE,
  E_NULL,
  E_PARAM,
  E_REAL,
  E_STRING,
  E_SUBQUERY,
  E_TRUE,
  E_UNARY,
  Expr,
  FromItem,
  Select,
  SelectCore,
} from "velt:sqlite/sql/ast";
import { ROWID, Source } from "velt:sqlite/exec/source";
import { AggRestart, Ev, Params, Pred, Query, Scope } from "velt:sqlite/exec/scope";
import { AggFn, aggregateKind } from "velt:sqlite/exec/agg";
import { windowKind } from "velt:sqlite/exec/window";
import { windowCall } from "velt:sqlite/exec/window_call";
import { aggMisuse, aggOwner, aggregateCore } from "velt:sqlite/exec/agg_owner";
import { prepareError } from "velt:sqlite/exec/errors";
import { scalarFunction } from "velt:sqlite/exec/func";
import { compileLike } from "velt:sqlite/exec/like";
import {
  AFF_NONE,
  BIT_NOT,
  OP_GE,
  OP_LE,
  arithOp,
  bitOp,
  castTo,
  compareAff,
  comparisonAffinity,
  holds,
  negate,
  truth,
} from "velt:sqlite/exec/ops";
import {
  blobVal,
  concatOp,
  intVal,
  nullVal,
  realVal,
  textVal,
  toText,
} from "velt:sqlite/exec/value";
import {
  C,
  Found,
  arithCode,
  binaryColl,
  bitCode,
  bound,
  comparisonOp,
  constant,
  hasWindow,
  joinedColl,
  plain,
} from "velt:sqlite/exec/compiled";

export { C, binaryColl, comparisonOp, hasAggregate } from "velt:sqlite/exec/compiled";
import { hexDecode } from "velt:encoding";
import { byteSlice } from "velt:sqlite/sql/lexer";

/** Compiles expressions; the SELECT compiler extends it with subqueries. */
export abstract class ExprCompiler {
  db: DbFile;
  schema: Schema;
  params: Params;
  /** Sources the expressions compiled since the last `track()` read. */
  touched: Source[] = [];

  /** The statement's text, for names in messages as they were written. */
  sql: string = "";

  constructor(db: DbFile, schema: Schema, params: Params) {
    this.db = db;
    this.schema = schema;
    this.params = params;
  }

  /** A function name as the statement spells it. */
  written(e: Expr): string {
    const n = __intrinsic_str_byte_len(e.name);
    if (e.at + n <= __intrinsic_str_byte_len(this.sql)) {
      const s = byteSlice(this.sql, e.at, e.at + n);
      if (s.toUpperCase() == e.name) {
        return s;
      }
    }
    return e.name.toLowerCase();
  }

  /** FROM subqueries and CTE references, and the queries that fill their rows. */
  rowsSrc: Source[] = [];
  rowsQ: Query[] = [];

  /** Compiles a subquery whose names may also resolve in `sc`. */
  abstract subquery(s: Select, sc: Scope): Query;

  /** The source a FROM item reads (`outer`: the scope enclosing its SELECT). */
  abstract fromSource(item: FromItem, outer: Scope | null): Source;

  /** Notes how many FROM terms `core` has once SQLite's flattener merged its subqueries. */
  abstract noteFromTerms(core: SelectCore): void;

  /** Where the table references counted so far end, for `rewind`. */
  abstract refMark(): usize;

  /**
   * Takes back what a core's compile counted and made after `refs` (references) and `rows`
   * (FROM sources), when the core compiles again as an aggregate query.
   */
  rewind(refs: usize, rows: usize) {
    this.rewindRefs(refs);
    __intrinsic_array_truncate(this.rowsSrc, rows);
    __intrinsic_array_truncate(this.rowsQ, rows);
  }

  /** Takes back the table references counted after `mark`. */
  abstract rewindRefs(mark: usize): void;

  /** The query filling a materialized source. */
  rowsQuery(src: Source): Query {
    for (let i: usize = 0; i < this.rowsSrc.length; i++) {
      if (this.rowsSrc[i] == src) {
        return this.rowsQ[i];
      }
    }
    prepareError("ICE: a FROM subquery without its query");
  }

  /**
   * Starts recording the sources the next expressions read: they are `touched` from the
   * position returned (nested compiles only add to the list).
   */
  track(): usize {
    return this.touched.length;
  }

  ev(e: Expr, sc: Scope): Ev {
    return this.expr(e, sc).ev;
  }

  expr(e: Expr, sc: Scope): C {
    const k = e.kind;
    if (sc.win != null && !hasWindow(e)) {
      return this.collected(e, sc);
    }
    if (k == E_INT) {
      return constant(e.text != "" ? realVal(9223372036854775808.0) : intVal(e.ival));
    }
    if (k == E_REAL) {
      return constant(realVal(e.rval));
    }
    if (k == E_STRING) {
      return constant(textVal(e.text));
    }
    if (k == E_NULL) {
      return constant(nullVal());
    }
    if (k == E_TRUE || k == E_FALSE) {
      return constant(intVal(k == E_TRUE ? 1 : 0));
    }
    if (k == E_BLOB) {
      return constant(blobVal(hexDecode(e.text)));
    }
    if (k == E_PARAM) {
      const p = this.params;
      const i = (e.ival - 1) as usize;
      return plain(() => p.get(i));
    }
    if (k == E_COLUMN) {
      return this.column(e, sc);
    }
    if (k == E_UNARY) {
      return this.unary(e, sc);
    }
    if (k == E_BINARY) {
      return this.binary(e, sc);
    }
    if (k == E_IS || k == E_ISNULL || k == E_BETWEEN) {
      return this.nullTests(e, sc);
    }
    if (k == E_IN_LIST) {
      return this.inList(e, sc);
    }
    if (k == E_IN_SELECT || k == E_EXISTS || k == E_SUBQUERY) {
      return this.subqueryExpr(e, sc);
    }
    if (k == E_CASE) {
      return this.caseExpr(e, sc);
    }
    if (k == E_CAST) {
      const x = this.expr(e.a!, sc);
      const a = affinityOf(e.name);
      const xe = x.ev;
      return C { ev: () => castTo(xe(), a), aff: a, coll: x.coll, explicit: x.explicit };
    }
    if (k == E_COLLATE) {
      const x = this.expr(e.a!, sc);
      const coll = collationOf(e.name);
      if (coll < 0) {
        prepareError(`no such collation sequence: ${e.name}`);
      }
      return C { ev: x.ev, aff: x.aff, coll: coll, explicit: true };
    }
    if (k == E_LIKE) {
      if (e.op == "REGEXP" || e.op == "MATCH") {
        prepareError(`no such function: ${e.op}`);
      }
      const x = this.expr(e.a!, sc);
      const p = this.expr(e.b!, sc);
      const esc: Ev | null = e.c == null ? null : this.ev(e.c!, sc);
      return plain(compileLike(x.ev, p.ev, esc, e.op == "GLOB", e.not));
    }
    if (k == E_CALL) {
      return this.call(e, sc);
    }
    prepareError(e.kind == 22 ? "row value misused" : "unsupported expression");
  }

  /** A condition: true only when the expression is true. */
  pred(e: Expr, sc: Scope): Pred {
    if (e.kind == E_BINARY && (e.op == "AND" || e.op == "OR")) {
      const a = this.pred(e.a!, sc);
      const b = this.pred(e.b!, sc);
      if (e.op == "AND") {
        return () => a() && b();
      }
      return () => a() || b();
    }
    if (e.kind == E_BINARY) {
      const op = comparisonOp(e.op);
      if (op >= 0) {
        const x = this.expr(e.a!, sc);
        const y = this.expr(e.b!, sc);
        const aff = comparisonAffinity(x.aff, y.aff);
        const coll = binaryColl(x, y);
        const xe = x.ev;
        const ye = y.ev;
        const o = op as u8;
        return () => {
          const p = xe();
          const q = ye();
          if (p.t == NULL || q.t == NULL) {
            return false;
          }
          return holds(o, compareAff(p, q, aff, coll));
        };
      }
    }
    const c = this.expr(e, sc).ev;
    return () => truth(c()) == 1;
  }

  column(e: Expr, sc: Scope): C {
    let s: Scope | null = sc;
    while (s != null) {
      const here = s!;
      const r = this.lookup(e, here);
      if (r != null) {
        // Every scope from `sc` out to (not including) `here` reads an enclosing query.
        let m: Scope | null = sc;
        while (m != null && m! != here) {
          m!.outer = true;
          m = m!.parent;
        }
        return this.columnRef(r!.src, r!.col, here);
      }
      if (e.table == "") {
        const alias = this.aliasRef(e.name, here);
        if (alias != null) {
          return alias!;
        }
      }
      s = here.parent;
    }
    if (e.op == "quoted" && e.table == "") {
      return constant(textVal(e.name));
    }
    prepareError(`no such column: ${e.table != "" ? e.table + "." : ""}${e.name}`);
  }

  /** The column `e` names among the sources of `s`, or null. */
  lookup(e: Expr, s: Scope): Found | null {
    const t = e.table.toUpperCase();
    let found: Source | null = null;
    let col: i64 = -2;
    let n = 0;
    for (const src of s.sources) {
      if (t != "" && src.name.toUpperCase() != t) {
        continue;
      }
      const c = src.column(e.name);
      if (c >= 0 && !(t == "" && src.hidden[c as usize])) {
        n++;
        found = src;
        col = c;
      }
    }
    if (n == 0) {
      for (const src of s.sources) {
        if ((t == "" || src.name.toUpperCase() == t) && src.isRowidName(e.name)) {
          n++;
          found = src;
          col = ROWID;
        }
      }
    }
    if (n > 1) {
      prepareError(`ambiguous column name: ${e.table != "" ? e.table + "." : ""}${e.name}`);
    }
    if (n == 0) {
      return null;
    }
    return new Found(found!, col);
  }

  /** A column of `src` read in scope `s` (the group's saved value in aggregate output). */
  columnRef(src: Source, col: i64, s: Scope): C {
    this.touched.push(src);
    if (col >= 0 && (col as usize) < src.used.length) {
      src.used[col as usize] = true;
    }
    const rowid = col < 0 || col == src.rowidCol;
    const aff = rowid ? A_INTEGER : src.affs[col as usize];
    const coll: i64 = rowid ? BINARY as i64 : src.colls[col as usize] as i64;
    if (s.agg != null) {
      const agg = s.agg!;
      const slot = agg.bareSlot(src, col);
      return C { ev: () => agg.cur.bare[slot], aff: aff, coll: coll, explicit: false };
    }
    return C { ev: () => src.col(col), aff: aff, coll: coll, explicit: false };
  }

  /** A result column's alias used as a name in the same SELECT. */
  aliasRef(name: string, s: Scope): C | null {
    const n = name.toUpperCase();
    for (const rc of s.aliases) {
      if (rc.alias != "" && rc.alias.toUpperCase() == n) {
        if (s.expanding.includes(n)) {
          prepareError(`misuse of alias: ${name}`);
        }
        s.expanding.push(n);
        const c = this.expr(rc.expr, s);
        s.expanding.pop();
        return c;
      }
    }
    return null;
  }

  unary(e: Expr, sc: Scope): C {
    const x = this.expr(e.a!, sc);
    const xe = x.ev;
    if (e.op == "-") {
      return plain(() => negate(xe()));
    }
    if (e.op == "+") {
      // +x has no affinity but keeps x's collation.
      return C { ev: xe, aff: AFF_NONE, coll: x.coll, explicit: x.explicit };
    }
    if (e.op == "~") {
      return plain(() => bitOp(BIT_NOT, xe(), xe()));
    }
    // NOT
    return plain(() => {
      const t = truth(xe());
      return t < 0 ? nullVal() : intVal(1 - t);
    });
  }

  binary(e: Expr, sc: Scope): C {
    const op = e.op;
    const x = this.expr(e.a!, sc);
    const y = this.expr(e.b!, sc);
    const xe = x.ev;
    const ye = y.ev;
    const cmp = comparisonOp(op);
    if (cmp >= 0) {
      const aff = comparisonAffinity(x.aff, y.aff);
      const coll = binaryColl(x, y);
      const o = cmp as u8;
      return plain(() => {
        const p = xe();
        const q = ye();
        if (p.t == NULL || q.t == NULL) {
          return nullVal();
        }
        return intVal(holds(o, compareAff(p, q, aff, coll)) ? 1 : 0);
      });
    }
    if (op == "AND") {
      return plain(() => {
        const a = truth(xe());
        if (a == 0) {
          return intVal(0);
        }
        const b = truth(ye());
        if (b == 0) {
          return intVal(0);
        }
        return a < 0 || b < 0 ? nullVal() : intVal(1);
      });
    }
    if (op == "OR") {
      return plain(() => {
        const a = truth(xe());
        if (a == 1) {
          return intVal(1);
        }
        const b = truth(ye());
        if (b == 1) {
          return intVal(1);
        }
        return a < 0 || b < 0 ? nullVal() : intVal(0);
      });
    }
    if (op == "||") {
      return joinedColl(() => concatOp(xe(), ye()), x, y);
    }
    const ar = arithCode(op);
    if (ar >= 0) {
      const a = ar as u8;
      return joinedColl(() => arithOp(a, xe(), ye()), x, y);
    }
    const bit = bitCode(op);
    if (bit >= 0) {
      const b = bit as u8;
      return joinedColl(() => bitOp(b, xe(), ye()), x, y);
    }
    prepareError(`the ${op} operator is not supported yet`);
  }

  /** IS, IS NOT, ISNULL, NOTNULL, BETWEEN. */
  nullTests(e: Expr, sc: Scope): C {
    const x = this.expr(e.a!, sc);
    const xe = x.ev;
    const not = e.not;
    if (e.kind == E_ISNULL || (e.kind == E_IS && e.b!.kind == E_NULL)) {
      // A column of this query is tested without decoding its value.
      const a = e.a!;
      if (a.kind == E_COLUMN && sc.agg == null) {
        const f = this.lookup(a, sc);
        if (f != null) {
          const src = f!.src;
          const col = f!.col;
          return plain(() => intVal(src.isNull(col) != not ? 1 : 0));
        }
      }
      return plain(() => intVal((xe().t == NULL) != not ? 1 : 0));
    }
    if (e.kind == E_IS) {
      const y = this.expr(e.b!, sc);
      const ye = y.ev;
      const aff = comparisonAffinity(x.aff, y.aff);
      const coll = binaryColl(x, y);
      return plain(() => {
        const p = xe();
        const q = ye();
        let same = false;
        if (p.t == NULL || q.t == NULL) {
          same = p.t == q.t;
        } else {
          same = compareAff(p, q, aff, coll) == 0;
        }
        return intVal(same != not ? 1 : 0);
      });
    }
    // BETWEEN: x >= lo AND x <= hi, each comparison with its own affinity and collation.
    const lo = this.expr(e.b!, sc);
    const hi = this.expr(e.c!, sc);
    const affLo = comparisonAffinity(x.aff, lo.aff);
    const affHi = comparisonAffinity(x.aff, hi.aff);
    const collLo = binaryColl(x, lo);
    const collHi = binaryColl(x, hi);
    const le = lo.ev;
    const he = hi.ev;
    return plain(() => {
      // Every operand is evaluated (its errors count), as SQLite does.
      const v = xe();
      const lv = le();
      const hv = he();
      const a = v.t == NULL ? -1 : bound(v, lv, affLo, collLo, OP_GE);
      const b = v.t == NULL ? -1 : bound(v, hv, affHi, collHi, OP_LE);
      const r: i64 = a == 0 || b == 0 ? 0 : a < 0 || b < 0 ? -1 : 1;
      if (r < 0) {
        return nullVal();
      }
      return intVal((r == 1) != not ? 1 : 0);
    });
  }

  inList(e: Expr, sc: Scope): C {
    const x = this.expr(e.a!, sc);
    const xe = x.ev;
    const aff = x.aff == AFF_NONE ? A_BLOB : x.aff;
    const coll: u8 = x.coll >= 0 ? x.coll as u8 : BINARY;
    const not = e.not;
    if (e.args.length == 0) {
      return constant(intVal(not ? 1 : 0));
    }
    const items: Ev[] = [];
    for (const a of e.args) {
      items.push(this.ev(a, sc));
    }
    return plain(() => {
      const v = xe();
      if (v.t == NULL) {
        return nullVal();
      }
      let sawNull = false;
      for (const it of items) {
        const w = it();
        if (w.t == NULL) {
          sawNull = true;
        } else if (compareAff(v, w, aff, coll) == 0) {
          return intVal(not ? 0 : 1);
        }
      }
      return sawNull ? nullVal() : intVal(not ? 1 : 0);
    });
  }

  subqueryExpr(e: Expr, sc: Scope): C {
    const q = this.subquery(e.select!, sc);
    const p = this.params;
    const not = e.not;
    if (e.kind == E_EXISTS) {
      q.need = 1;
      return plain(() => {
        q.runFor(p);
        return intVal((q.out.rows > 0) != not ? 1 : 0);
      });
    }
    if (q.names.length != 1) {
      prepareError(`sub-select returns ${q.names.length} columns - expected 1`);
    }
    if (e.kind == E_SUBQUERY) {
      q.need = 1;
      return C {
        ev: () => {
          q.runFor(p);
          return q.first();
        },
        aff: q.affs[0],
        coll: q.colls[0],
        explicit: false,
      };
    }
    // IN (SELECT ...)
    const x = this.expr(e.a!, sc);
    const xe = x.ev;
    const aff = comparisonAffinity(q.affs[0], x.aff);
    const coll = binaryColl(x, C { ev: xe, aff: q.affs[0], coll: q.colls[0], explicit: false });
    return plain(() => {
      const v = xe();
      q.runFor(p);
      const out = q.out;
      if (out.rows == 0) {
        return intVal(not ? 1 : 0);
      }
      if (v.t == NULL) {
        return nullVal();
      }
      let sawNull = false;
      for (let i: usize = 0; i < out.rows; i++) {
        const w = out.vals[i];
        if (w.t == NULL) {
          sawNull = true;
        } else if (compareAff(v, w, aff, coll) == 0) {
          return intVal(not ? 0 : 1);
        }
      }
      return sawNull ? nullVal() : intVal(not ? 1 : 0);
    });
  }

  caseExpr(e: Expr, sc: Scope): C {
    const whens: Ev[] = [];
    const thens: Ev[] = [];
    const affs: u8[] = [];
    const colls: u8[] = [];
    let base: Ev | null = null;
    let bc: C | null = null;
    // An explicit COLLATE in the operand, else in the first WHEN, THEN or ELSE that has one,
    // is the result's (SQLite's EP_Collate).
    let coll: i64 = -1;
    if (e.a != null) {
      bc = this.expr(e.a!, sc);
      base = bc!.ev;
      if (bc!.explicit) {
        coll = bc!.coll;
      }
    }
    for (let i: usize = 0; i + 1 < e.args.length; i += 2) {
      const w = this.expr(e.args[i], sc);
      whens.push(w.ev);
      const t = this.expr(e.args[i + 1], sc);
      thens.push(t.ev);
      if (coll < 0 && w.explicit) {
        coll = w.coll;
      }
      if (coll < 0 && t.explicit) {
        coll = t.coll;
      }
      if (bc != null) {
        affs.push(comparisonAffinity(bc!.aff, w.aff));
        colls.push(binaryColl(bc!, w));
      }
    }
    let other: Ev | null = null;
    if (e.b != null) {
      const o = this.expr(e.b!, sc);
      other = o.ev;
      if (coll < 0 && o.explicit) {
        coll = o.coll;
      }
    }
    const ev: Ev = () => {
      if (base != null) {
        const b = base!();
        for (let i: usize = 0; i < whens.length; i++) {
          const w = whens[i]();
          if (b.t != NULL && w.t != NULL && compareAff(b, w, affs[i], colls[i]) == 0) {
            return thens[i]();
          }
        }
      } else {
        for (let i: usize = 0; i < whens.length; i++) {
          if (truth(whens[i]()) == 1) {
            return thens[i]();
          }
        }
      }
      return other == null ? nullVal() : other!();
    };
    if (coll >= 0) {
      return C { ev: ev, aff: AFF_NONE, coll: coll, explicit: true };
    }
    return plain(ev);
  }

  /** In the output of a query with window functions: a value computed as the rows are collected. */
  collected(e: Expr, sc: Scope): C {
    const w = sc.win!;
    const x = this.expr(e, sc.winBase!);
    w.captures.push(x.ev);
    const k = w.captures.length - 1;
    return C { ev: () => w.capture(k), aff: x.aff, coll: x.coll, explicit: x.explicit };
  }

  call(e: Expr, sc: Scope): C {
    const lname = this.written(e);
    if (e.over != null) {
      if (sc.win == null) {
        prepareError(`misuse of window function ${lname}()`);
      }
      return windowCall(this, e, sc, lname);
    }
    if (windowKind(e.name) >= 0) {
      prepareError(`misuse of window function ${lname}()`);
    }
    const kind = aggregateKind(e.name, e.args.length, e.star);
    if (kind >= 0) {
      // Where the call is written must allow an aggregate (SQLite's name context), even one
      // that belongs to an enclosing query.
      if (sc.inAggArgs || sc.core == null || (sc.where && !aggregateCore(this, sc))) {
        aggMisuse(this, e, sc, `misuse of aggregate function ${lname}()`);
      }
      // An aggregate reading only an enclosing query's columns is that query's.
      const owner = aggOwner(this, e, sc);
      if (owner.groupBy) {
        aggMisuse(this, e, sc, "aggregate functions are not allowed in the GROUP BY clause");
      }
      if (owner.agg == null) {
        // Only from a result column: in ORDER BY it is too late (SQLite's misuse error).
        if (owner != sc && owner.results && owner.core != null && !owner.core!.aggFromInner) {
          owner.core!.aggFromInner = true;
          throw new AggRestart(owner.core!);
        }
        const resolving = !sc.output && !aggregateCore(this, sc);
        aggMisuse(
          this,
          e,
          sc,
          resolving ? `misuse of aggregate function ${lname}()` : `misuse of aggregate: ${lname}()`,
        );
      }
      // The queries in between read the owner's values: they run again for each of its rows.
      let between: Scope | null = sc;
      while (between != null && between! != owner) {
        between!.outer = true;
        between = between!.parent;
      }
      const agg = owner.agg!;
      const base = owner.base!;
      const f = new AggFn(kind as u8, e.name.toLowerCase());
      const was = base.inAggArgs;
      base.inAggArgs = true;
      try {
        for (const a of e.args) {
          const c = this.expr(a, base);
          if (f.args.length == 0 && c.coll >= 0) {
            f.coll = c.coll as u8;
          }
          f.args.push(c.ev);
        }
        if (e.filter != null) {
          f.filter = this.pred(e.filter!, base);
        }
      } finally {
        base.inAggArgs = was;
      }
      f.distinct = e.distinct;
      if (e.distinct && e.args.length != 1) {
        prepareError("DISTINCT aggregates must have exactly one argument");
      }
      agg.fns.push(f);
      const slot = agg.fns.length - 1;
      return plain(() => agg.value(slot));
    }
    if (kind == -2) {
      prepareError(`wrong number of arguments to function ${lname}()`);
    }
    if (e.filter != null) {
      prepareError("FILTER clause may only be used with aggregate window functions");
    }
    if (e.star) {
      prepareError(`wrong number of arguments to function ${lname}()`);
    }
    const args: C[] = [];
    for (const a of e.args) {
      args.push(this.expr(a, sc));
    }
    // likely(), unlikely() and likelihood() are their first argument.
    if ((e.name == "LIKELY" || e.name == "UNLIKELY") && args.length == 1) {
      return args[0];
    }
    if (e.name == "LIKELIHOOD" && args.length == 2) {
      // Its probability is a REAL literal of at most 1.0 (resolve.c's exprProbability).
      const pr = e.args[1];
      if (pr.kind != E_REAL || pr.rval > 1.0) {
        prepareError("second argument to likelihood() must be a constant between 0.0 and 1.0");
      }
      return args[0];
    }
    let coll: u8 = BINARY;
    for (const a of args) {
      if (a.coll >= 0) {
        coll = a.coll as u8;
        break;
      }
    }
    const evs: Ev[] = [];
    for (const a of args) {
      evs.push(a.ev);
    }
    const f = scalarFunction(e.name, lname, evs, coll);
    if (f == null) {
      prepareError(`no such function: ${lname}`);
    }
    // An explicit COLLATE in an argument carries to the result (SQLite's EP_Collate).
    for (const a of args) {
      if (a.explicit) {
        return C { ev: f!, aff: AFF_NONE, coll: a.coll, explicit: true };
      }
    }
    return plain(f!);
  }
}
