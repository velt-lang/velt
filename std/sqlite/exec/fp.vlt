// velt:sqlite/exec/fp — SQLite's own conversions between doubles and decimal text, ported from
// its util.c and printf.c (3.53): `sqlite3FpDecode` (a double's significant digits, rounded as
// printf asks), `sqlite3AtoF` (decimal text to a double), and the `%g`, `%f` and `%e` renderings
// with the `!` flag. The powers of ten and `sqlite3Fp10Convert2` are velt:sqlite/real's. REAL values print and parse exactly as C SQLite's, which
// does not always agree with the shortest round-trip form (`1.0/3` is 0.33333333333333331 in
// C's printf and 0.33333333333333332 in SQLite).

import { leadingZeros, mul128, powerOfTen, pwr10to2, pwr2to10, toDouble } from "velt:sqlite/real";

/** A double's decimal digits (sqlite3FpDecode): `digits` (ASCII) times 10^(iDP - n). */
export class FpDecode {
  sign: u8 = 43;
  /** 1: infinity, 2: NaN. */
  special: u8 = 0;
  digits: u8[] = [];
  /** Where the decimal point goes: after `iDP` digits. */
  iDP: i64 = 0;
}

/**
 * Decodes `r`: iRound <= 0 rounds to -iRound digits after the point (at most `mxRound`
 * significant), iRound > 0 to min(iRound, mxRound) significant digits.
 */
export function fpDecode(r0: f64, iRound0: i64, mxRound: i64): FpDecode {
  const p = new FpDecode();
  let r = r0;
  let iRound = iRound0;
  if (r < 0) {
    p.sign = 45;
    r = -r;
  } else if (r == 0) {
    p.digits.push(48);
    p.iDP = 1;
    return p;
  }
  let v = r.toBits();
  let e = ((v >> 52) & 0x7ff) as i64;
  if (e == 0x7ff) {
    p.special = v != 0x7ff0000000000000 ? 2 : 1;
    return p;
  }
  v = v & 0x000fffffffffffff;
  if (e == 0) {
    const nn = leadingZeros(v);
    v = v << (nn as u64);
    e = -1074 - nn;
  } else {
    v = (v << 11) | 0x8000000000000000;
    e -= 1086;
  }
  const want = iRound <= 0 || iRound >= 18 ? 18 : iRound + 1;
  // sqlite3Fp2Convert10
  const pp = want - 1 - pwr2to10(e + 63);
  let h = mul128(v, powerOfTen(pp).hi).hi;
  if (want == 18) {
    h = h >> ((-(e + pwr10to2(pp) + 2)) as u64);
    v = (h + ((h << 1) & 2)) >> 1;
  } else {
    v = h >> ((-(e + pwr10to2(pp) + 1)) as u64);
  }
  const exp = -pp;
  // The digits, most significant first; one slot in front for a carry.
  const z: u8[] = [48];
  const tmp: u8[] = [];
  while (v > 0) {
    tmp.push((48 + (v % 10)) as u8);
    v = v / 10;
  }
  for (let i = tmp.length; i > 0; i--) {
    z.push(tmp[i - 1]);
  }
  let start: usize = 1;
  let n = tmp.length as i64;
  p.iDP = n + exp;
  if (iRound <= 0) {
    iRound = p.iDP - iRound;
    if (iRound == 0 && z[start] >= 53) {
      iRound = 1;
      start = 0;
      z[0] = 48;
      n++;
      p.iDP++;
    }
  }
  if (iRound > 0 && (iRound < n || n > mxRound)) {
    if (iRound > mxRound) {
      iRound = mxRound;
    }
    if (iRound == 17) {
      iRound = shorten(z, start, n, exp, r, iRound, p.iDP);
    }
    n = iRound;
    if (z[start + (iRound as usize)] >= 53) {
      let j = start + (iRound as usize) - 1;
      while (true) {
        z[j]++;
        if (z[j] <= 57) {
          break;
        }
        z[j] = 48;
        if (j == start) {
          start--;
          z[start] = 49;
          n++;
          p.iDP++;
          break;
        }
        j--;
      }
    }
  }
  while (n > 1 && z[start + (n as usize) - 1] == 48) {
    n--;
  }
  for (let i: usize = 0; i < (n as usize); i++) {
    p.digits.push(z[start + i]);
  }
  return p;
}

// With precision 17 (the "!" flag), fewer digits when they read back as the same double.
function shorten(z: u8[], s: usize, n: i64, exp: i64, r: f64, iRound: i64, iDP: i64): i64 {
  if (z[s + 15] == 57 && z[s + 14] == 57) {
    let jj: i64 = 14;
    while (jj > 0 && z[s + (jj as usize) - 1] == 57) {
      jj--;
    }
    let v2: u64 = 1;
    if (jj > 0) {
      v2 = (z[s] - 48) as u64;
      for (let kk: i64 = 1; kk < jj; kk++) {
        v2 = v2 * 10 + ((z[s + (kk as usize)] - 48) as u64);
      }
      v2++;
    }
    if (r == toDouble(v2, exp + n - jj)) {
      return jj + 1;
    }
  } else if (iDP >= n || (z[s + 15] == 48 && z[s + 14] == 48 && z[s + 13] == 48)) {
    let jj: i64 = 13;
    while (z[s + (jj as usize) - 1] == 48) {
      jj--;
    }
    let v2 = (z[s] - 48) as u64;
    for (let kk: i64 = 1; kk < jj; kk++) {
      v2 = v2 * 10 + ((z[s + (kk as usize)] - 48) as u64);
    }
    if (r == toDouble(v2, exp + n - jj)) {
      return jj + 1;
    }
  }
  return iRound;
}

/** printf conversions. */
export const FMT_FLOAT: u8 = 0; // %f
export const FMT_EXP: u8 = 1; // %e
export const FMT_GENERIC: u8 = 2; // %g

/**
 * `r` as SQLite's printf renders `%<flags>.<precision><conv>`: `alt2` is the "!" flag,
 * `zeropad` the "0" flag (infinity as 9.0e+999), `alt` the "#" flag.
 */
export function formatReal(
  r: f64,
  conv: u8,
  precision0: i64,
  alt2: bool,
  zeropad: bool,
  alt: bool,
): string {
  let precision = precision0 < 0 ? 6 : precision0;
  let xtype = conv;
  let iRound: i64 = 0;
  if (xtype == FMT_FLOAT) {
    iRound = -precision;
  } else if (xtype == FMT_GENERIC) {
    if (precision == 0) {
      precision = 1;
    }
    iRound = precision;
  } else {
    iRound = precision + 1;
  }
  const s = fpDecode(r, iRound, alt2 ? 20 : 16);
  if (s.special != 0) {
    if (s.special == 2) {
      return zeropad ? "null" : "NaN";
    }
    if (!zeropad) {
      return s.sign == 45 ? "-Inf" : "Inf";
    }
    s.digits = [57];
    s.iDP = 1000;
  }
  const out: u8[] = [];
  if (s.sign == 45) {
    if (!(alt && xtype == FMT_FLOAT && s.iDP <= iRound)) {
      out.push(45);
    }
  }
  let rtz = false;
  if (xtype == FMT_GENERIC) {
    precision--;
    rtz = !alt;
    const exp = s.iDP - 1;
    if (exp < -4 || exp > precision) {
      xtype = FMT_EXP;
    } else {
      precision = precision - exp;
      xtype = FMT_FLOAT;
    }
  } else {
    rtz = alt2;
  }
  let e2: i64 = xtype == FMT_EXP ? 0 : s.iDP - 1;
  const z = s.digits;
  const zn = z.length as i64;
  const dp = precision > 0 || alt || alt2;
  let j: i64 = 0;
  if (e2 < 0) {
    out.push(48);
  } else {
    j = e2 + 1;
    if (j > zn) {
      j = zn;
    }
    for (let i: i64 = 0; i < j; i++) {
      out.push(z[i as usize]);
    }
    e2 -= j;
    while (e2 >= 0) {
      out.push(48);
      e2--;
    }
  }
  const mark = out.length;
  if (dp) {
    out.push(46);
  }
  if (e2 < -1 && precision > 0) {
    let nn = -1 - e2;
    if (nn > precision) {
      nn = precision;
    }
    for (let i: i64 = 0; i < nn; i++) {
      out.push(48);
    }
    precision -= nn;
  }
  if (precision > 0) {
    let nn = zn - j;
    if (nn > precision) {
      nn = precision;
    }
    for (let i: i64 = 0; i < nn; i++) {
      out.push(z[(j + i) as usize]);
    }
    if (nn > 0) {
      precision -= nn;
    }
    if (precision > 0 && !rtz) {
      for (let i: i64 = 0; i < precision; i++) {
        out.push(48);
      }
    }
  }
  if (rtz && dp) {
    while (out.length > mark + 1 && out[out.length - 1] == 48) {
      out.pop();
    }
    if (out[out.length - 1] == 46) {
      if (alt2) {
        out.push(48);
      } else {
        out.pop();
      }
    }
  }
  if (xtype == FMT_EXP) {
    let exp = s.iDP - 1;
    out.push(101);
    if (exp < 0) {
      out.push(45);
      exp = -exp;
    } else {
      out.push(43);
    }
    if (exp >= 100) {
      out.push((48 + exp / 100) as u8);
      exp = exp % 100;
    }
    out.push((48 + exp / 10) as u8);
    out.push((48 + exp % 10) as u8);
  }
  return out.utf8Slice(0, out.length as i64);
}

/** What `atof` read: the value, how far, and SQLite's state bits (1 digits, 2 real). */
export struct AtoF {
  value: f64;
  /** Bytes read, spaces after the number included. */
  end: usize;
  state: i64;
  /** The whole text (but surrounding spaces) is the number. */
  whole: bool;
}

function isSpaceByte(c: u8): bool {
  return c == 32 || (c >= 9 && c <= 13);
}

/** Decimal text in `b` from `at` to a double, as sqlite3AtoF reads it. */
export function atof(b: u8[], at: usize): AtoF {
  let i = at;
  const n = b.length;
  let neg = false;
  let s: u64 = 0;
  let d: i64 = 0;
  let state: i64 = 0;
  while (i < n && isSpaceByte(b[i])) {
    i++;
  }
  if (i < n && (b[i] == 45 || b[i] == 43)) {
    neg = b[i] == 45;
    i++;
  }
  if (i < n && b[i] >= 48 && b[i] <= 57) {
    state = 1;
    while (i < n && b[i] >= 48 && b[i] <= 57) {
      s = s * 10 + ((b[i] - 48) as u64);
      i++;
      if (s >= (18446744073709551615 - 9) / 10) {
        state = 9;
        while (i < n && b[i] >= 48 && b[i] <= 57) {
          i++;
          d++;
        }
        break;
      }
    }
  }
  if (i < n && b[i] == 46) {
    i++;
    if (i < n && b[i] >= 48 && b[i] <= 57) {
      state = state | 1;
      while (i < n && b[i] >= 48 && b[i] <= 57) {
        if (s < (18446744073709551615 - 9) / 10) {
          s = s * 10 + ((b[i] - 48) as u64);
          d--;
        } else {
          state = 11;
        }
        i++;
      }
    } else if (state == 0) {
      return AtoF { value: 0, end: at, state: 0, whole: false };
    }
    state = state | 2;
  } else if (state == 0) {
    return AtoF { value: 0, end: at, state: 0, whole: false };
  }
  if (i < n && (b[i] == 101 || b[i] == 69)) {
    let j = i + 1;
    let esign: i64 = 1;
    if (j < n && b[j] == 45) {
      esign = -1;
      j++;
    } else if (j < n && b[j] == 43) {
      j++;
    }
    if (j < n && b[j] >= 48 && b[j] <= 57) {
      let ex: i64 = 0;
      while (j < n && b[j] >= 48 && b[j] <= 57) {
        ex = ex < 10000 ? ex * 10 + ((b[j] - 48) as i64) : 10000;
        j++;
      }
      state = state | 2;
      d += esign * ex;
      i = j;
    }
  }
  let value: f64 = 0;
  if (s == 0) {
    state = state | 4;
  } else {
    value = toDouble(s, d);
  }
  if (neg) {
    value = -value;
  }
  while (i < n && isSpaceByte(b[i])) {
    i++;
  }
  return AtoF { value: value, end: i, state: state, whole: i == n };
}
