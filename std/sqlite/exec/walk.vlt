// velt:sqlite/exec/walk — the rows of one FROM level as a `Walk` stepped from outside, one row
// at a time (velt:sqlite/exec/pull): the same access paths as velt:sqlite/exec/loop's loops (a
// full scan, a rowid lookup, list or range, an index scan with a prefix equality and a range on
// the next column, an index lookup per IN value, the rows of a subquery).

import { Cursor, NULL } from "velt:sqlite/btree";
import { KeyRec } from "velt:sqlite/record";
import "velt:sqlite/btree_back";
import { Source } from "velt:sqlite/exec/source";
import { Ev, Params, Query } from "velt:sqlite/exec/scope";
import { ExprCompiler } from "velt:sqlite/exec/expr";
import {
  ACC_INDEX,
  ACC_ROWID_EQ,
  ACC_ROWID_IN,
  ACC_ROWID_RANGE,
  ACC_ROWS,
  Access,
  addKeyField,
  beyondRowids,
  rowidKey,
} from "velt:sqlite/exec/plan";
import { inValues } from "velt:sqlite/exec/loop";
import { forCompare } from "velt:sqlite/exec/ops";
import { Val } from "velt:sqlite/exec/value";

/** The rows of one level, in its access path's order: `start` for the first, `step` after. */
export abstract class Walk {
  /** Moves to the first row; false when there is none. */
  abstract start(): bool;
  /** Moves to the next row; false past the last. */
  abstract step(): bool;
}

/** Every row of a table, by rowid (backwards when `reverse`). */
class ScanWalk extends Walk {
  cur: Cursor;
  reverse: bool;

  constructor(cur: Cursor, reverse: bool) {
    super();
    this.cur = cur;
    this.reverse = reverse;
  }

  start(): bool {
    return this.reverse ? this.cur.last() : this.cur.first();
  }

  step(): bool {
    return this.reverse ? this.cur.prev() : this.cur.next();
  }
}

/** The rows of a subquery, a CTE or VALUES. */
class RowsWalk extends Walk {
  src: Source;
  q: Query;
  params: Params;

  constructor(src: Source, q: Query, params: Params) {
    super();
    this.src = src;
    this.q = q;
    this.params = params;
  }

  start(): bool {
    this.q.open(this.params);
    this.src.at = 0;
    return this.q.has(0);
  }

  step(): bool {
    this.src.at++;
    return this.q.has(this.src.at);
  }
}

/** The row with a rowid. */
class RowidEqWalk extends Walk {
  cur: Cursor;
  ve: Ev;
  aff: u8;

  constructor(cur: Cursor, ve: Ev, aff: u8) {
    super();
    this.cur = cur;
    this.ve = ve;
    this.aff = aff;
  }

  start(): bool {
    const r = rowidKey(this.ve(), this.aff, false);
    return r.ok && !r.frac && this.cur.seekRowid(r.value);
  }

  step(): bool {
    return false;
  }
}

/** The rows whose rowid is in a list. */
class RowidInWalk extends Walk {
  cur: Cursor;
  list: Ev[];
  inq: Query | null;
  params: Params;
  aff: u8;
  vals: Val[] = [];
  vi: usize = 0;

  constructor(cur: Cursor, acc: Access, params: Params) {
    super();
    this.cur = cur;
    this.list = acc.inList!;
    this.inq = acc.inQuery;
    this.params = params;
    this.aff = acc.inAff;
  }

  start(): bool {
    this.vals = inValues(this.list, this.inq, this.params, this.aff, 0);
    this.vi = 0;
    return this.step();
  }

  step(): bool {
    while (this.vi < this.vals.length) {
      const v = this.vals[this.vi];
      this.vi++;
      const r = rowidKey(v, this.aff, false);
      if (r.ok && !r.frac && this.cur.seekRowid(r.value)) {
        return true;
      }
    }
    return false;
  }
}

/** The rows whose rowid is in a range. */
class RowidRangeWalk extends Walk {
  cur: Cursor;
  reverse: bool;
  lo: Ev | null;
  hi: Ev | null;
  loAff: u8;
  hiAff: u8;
  loIncl: bool;
  hiIncl: bool;
  hasLo: bool = false;
  hasHi: bool = false;
  first: i64 = 0;
  last: i64 = 0;

  constructor(cur: Cursor, acc: Access) {
    super();
    this.cur = cur;
    this.reverse = acc.reverse;
    this.lo = acc.lo;
    this.hi = acc.hi;
    this.loAff = acc.loAff;
    this.hiAff = acc.hiAff;
    this.loIncl = acc.loIncl;
    this.hiIncl = acc.hiIncl;
  }

  start(): bool {
    this.hasLo = false;
    this.hasHi = false;
    if (this.lo != null) {
      const v = this.lo!();
      if (v.t == NULL) {
        return false;
      }
      const r = rowidKey(v, this.loAff, true);
      if (!r.ok) {
        // Above every integer (text, a REAL past 2^63): no row; below them all: no bound.
        if (beyondRowids(v, this.loAff) != -1) {
          return false;
        }
      } else {
        this.hasLo = true;
        this.first = r.value;
        if (!this.loIncl && !r.frac) {
          if (this.first == 9223372036854775807) {
            return false;
          }
          this.first++;
        }
      }
    }
    if (this.hi != null) {
      const v = this.hi!();
      if (v.t == NULL) {
        return false;
      }
      const r = rowidKey(v, this.hiAff, false);
      if (r.ok) {
        this.hasHi = true;
        this.last = r.value;
        if (!this.hiIncl && !r.frac) {
          if (this.last == -9223372036854775807 - 1) {
            return false;
          }
          this.last--;
        }
      } else if (beyondRowids(v, this.hiAff) != 1) {
        return false;
      }
    }
    const cur = this.cur;
    let ok = false;
    if (this.reverse) {
      ok = this.hasHi ? cur.seekRowidLe(this.last) : cur.last();
    } else {
      ok = this.hasLo ? cur.seekRowidGe(this.first) : cur.first();
    }
    return this.inRange(ok);
  }

  step(): bool {
    const ok = this.reverse ? this.cur.prev() : this.cur.next();
    return this.inRange(ok);
  }

  inRange(ok: bool): bool {
    if (!ok) {
      return false;
    }
    const id = this.cur.rowid;
    if (this.reverse) {
      return !(this.hasLo && id < this.first);
    }
    return !(this.hasHi && id > this.last);
  }
}

/** An index's entries: equal to the equalities' values, within a range on the next column. */
class IndexWalk extends Walk {
  src: Source;
  ix: Cursor;
  reverse: bool;
  colls: u8[];
  desc: bool[];
  eq: Ev[];
  eqAff: u8[];
  eqIs: bool[];
  nEq: usize;
  lo: Ev | null;
  hi: Ev | null;
  loAff: u8;
  hiAff: u8;
  loIncl: bool;
  hiIncl: bool;
  hasLo: bool = false;
  hasHi: bool = false;
  // Reused from run to run: the keys, built field by field (no record encoding).
  prefix: KeyRec = new KeyRec([]);
  loKey: KeyRec = new KeyRec([]);
  hiKey: KeyRec = new KeyRec([]);

  constructor(src: Source, acc: Access) {
    super();
    this.src = src;
    this.ix = src.ix!;
    this.reverse = acc.reverse;
    const index = acc.index!;
    this.colls = index.colls;
    this.desc = index.desc;
    this.eq = acc.eq;
    this.eqAff = acc.eqAff;
    this.eqIs = acc.eqIs;
    this.nEq = acc.eq.length;
    this.lo = acc.lo;
    this.hi = acc.hi;
    this.loAff = acc.loAff;
    this.hiAff = acc.hiAff;
    this.loIncl = acc.loIncl;
    this.hiIncl = acc.hiIncl;
  }

  start(): bool {
    const nEq = this.nEq;
    const eq = this.eq;
    const eqAff = this.eqAff;
    const prefix = this.prefix;
    prefix.clear();
    for (let i: usize = 0; i < nEq; i++) {
      const v = forCompare(eq[i](), eqAff[i]);
      if (v.t == NULL && !this.eqIs[i]) {
        return false;
      }
      addKeyField(prefix, v);
    }
    this.hasHi = false;
    if (this.hi != null) {
      const v = this.hi!();
      if (v.t == NULL) {
        return false;
      }
      const hk = this.hiKey;
      hk.clear();
      for (let i: usize = 0; i < nEq; i++) {
        addKeyField(hk, forCompare(eq[i](), eqAff[i]));
      }
      addKeyField(hk, forCompare(v, this.hiAff));
      this.hasHi = true;
    }
    this.hasLo = false;
    if (this.lo != null) {
      const v = this.lo!();
      if (v.t == NULL) {
        return false;
      }
      const lk = this.loKey;
      lk.clear();
      for (let i: usize = 0; i < nEq; i++) {
        addKeyField(lk, forCompare(eq[i](), eqAff[i]));
      }
      addKeyField(lk, forCompare(v, this.loAff));
      this.hasLo = true;
    }
    const ix = this.ix;
    const colls = this.colls;
    const desc = this.desc;
    let ok = false;
    if (this.reverse) {
      if (this.hasHi) {
        ok = ix.seekLastBefore(this.hiKey, nEq + 1, colls, desc, !this.hiIncl);
      } else if (nEq > 0) {
        ok = ix.seekLastBefore(prefix, nEq, colls, desc, false);
      } else {
        ok = ix.last();
      }
    } else if (this.hasLo) {
      ok = ix.seekKeyRec(this.loKey, nEq + 1, colls, desc);
    } else if (nEq > 0) {
      ok = ix.seekKeyRec(prefix, nEq, colls, desc);
    } else {
      ok = ix.first();
    }
    return this.inRange(ok);
  }

  step(): bool {
    const ok = this.reverse ? this.ix.prev() : this.ix.next();
    return this.inRange(ok);
  }

  // Whether the index entry reached is still in the walk's range.
  inRange(ok: bool): bool {
    if (!ok) {
      return false;
    }
    const ix = this.ix;
    const nEq = this.nEq;
    if (nEq > 0 && ix.compareKeyRec(this.prefix, nEq, this.colls, this.desc) != 0) {
      return false;
    }
    if (this.reverse) {
      if (this.hasLo) {
        const r = ix.compareKeyRec(this.loKey, nEq + 1, this.colls, this.desc);
        if (r < 0 || (r == 0 && !this.loIncl)) {
          return false;
        }
      }
    } else if (this.hasHi) {
      const r = ix.compareKeyRec(this.hiKey, nEq + 1, this.colls, this.desc);
      if (r > 0 || (r == 0 && !this.hiIncl)) {
        return false;
      }
    }
    this.src.seeked = false;
    return true;
  }
}

/** An index lookup per value of `col IN (list)` (the column after the equalities). */
class IndexInWalk extends Walk {
  src: Source;
  ix: Cursor;
  colls: u8[];
  desc: bool[];
  eq: Ev[];
  eqAff: u8[];
  eqIs: bool[];
  nEq: usize;
  list: Ev[];
  inq: Query | null;
  params: Params;
  aff: u8;
  inColl: u8;
  key: KeyRec = new KeyRec([]);
  fixed: Val[] = [];
  vals: Val[] = [];
  vi: usize = 0;

  constructor(src: Source, acc: Access, params: Params) {
    super();
    this.src = src;
    this.ix = src.ix!;
    const index = acc.index!;
    this.colls = index.colls;
    this.desc = index.desc;
    this.eq = acc.eq;
    this.eqAff = acc.eqAff;
    this.eqIs = acc.eqIs;
    this.nEq = acc.eq.length;
    this.list = acc.inList!;
    this.inq = acc.inQuery;
    this.params = params;
    this.aff = acc.inAff;
    this.inColl = acc.inColl;
  }

  start(): bool {
    __intrinsic_array_truncate(this.fixed, 0);
    this.vals = [];
    this.vi = 0;
    for (let i: usize = 0; i < this.nEq; i++) {
      const v = forCompare(this.eq[i](), this.eqAff[i]);
      if (v.t == NULL && !this.eqIs[i]) {
        return false;
      }
      this.fixed.push(v);
    }
    this.vals = inValues(this.list, this.inq, this.params, this.aff, this.inColl);
    return this.nextValue();
  }

  step(): bool {
    const n = this.nEq + 1;
    if (this.ix.next() && this.ix.compareKeyRec(this.key, n, this.colls, this.desc) == 0) {
      this.src.seeked = false;
      return true;
    }
    return this.nextValue();
  }

  // The first entry of the next IN value that has one.
  nextValue(): bool {
    const key = this.key;
    const n = this.nEq + 1;
    while (this.vi < this.vals.length) {
      const v = this.vals[this.vi];
      this.vi++;
      key.clear();
      for (const f of this.fixed) {
        addKeyField(key, f);
      }
      addKeyField(key, v);
      if (
        this.ix.seekKeyRec(key, n, this.colls, this.desc) &&
        this.ix.compareKeyRec(key, n, this.colls, this.desc) == 0
      ) {
        this.src.seeked = false;
        return true;
      }
    }
    return false;
  }
}

/** The walk of `src` through `acc`. */
export function walkOf(c: ExprCompiler, src: Source, acc: Access): Walk {
  if (acc.kind == ACC_ROWS) {
    return new RowsWalk(src, c.rowsQuery(src), c.params);
  }
  if (acc.kind == ACC_INDEX) {
    if (acc.inList != null) {
      return new IndexInWalk(src, acc, c.params);
    }
    return new IndexWalk(src, acc);
  }
  const cur = src.cur!;
  if (acc.kind == ACC_ROWID_EQ) {
    return new RowidEqWalk(cur, acc.eq[0], acc.eqAff[0]);
  }
  if (acc.kind == ACC_ROWID_IN) {
    return new RowidInWalk(cur, acc, c.params);
  }
  if (acc.kind == ACC_ROWID_RANGE) {
    return new RowidRangeWalk(cur, acc);
  }
  return new ScanWalk(cur, acc.reverse);
}
