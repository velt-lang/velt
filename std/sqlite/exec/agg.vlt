// velt:sqlite/exec/agg — aggregate functions (count, sum, total, avg, min, max, group_concat,
// string_agg) and the groups of an aggregate query (https://sqlite.org/lang_aggfunc.html).
//
// An aggregate query runs its loops once, stepping the accumulators of each row's group; then
// each group gives one output row. Columns read outside aggregates ("bare" columns) take the
// values of a row of the group, saved as the group steps: the last row, or, with min() or max(),
// the row that holds the extreme value, as SQLite does.

import { NULL, INTEGER, TEXT } from "velt:sqlite/btree";
import { BINARY } from "velt:sqlite/record";
import { Source } from "velt:sqlite/exec/source";
import { SqlRunError } from "velt:sqlite/exec/errors";
import { toF64, toI64 } from "velt:sqlite/exec/ops";
import {
  Val,
  checkLength,
  compareVals,
  intVal,
  nullVal,
  parseNumeric,
  realVal,
  textVal,
  toText,
} from "velt:sqlite/exec/value";
import { KeySet } from "velt:sqlite/exec/keys";

/** Aggregate kinds. */
export const AG_COUNT_STAR: u8 = 0;
export const AG_COUNT: u8 = 1;
export const AG_SUM: u8 = 2;
export const AG_TOTAL: u8 = 3;
export const AG_AVG: u8 = 4;
export const AG_MIN: u8 = 5;
export const AG_MAX: u8 = 6;
export const AG_CONCAT: u8 = 7;

/** The aggregate kind of a call to `name` with `n` arguments, or -1 if it is no aggregate. */
export function aggregateKind(name: string, n: usize, star: bool): i64 {
  if (name == "COUNT") {
    return star || n == 0 ? AG_COUNT_STAR as i64 : n == 1 ? AG_COUNT as i64 : -2;
  }
  if (name == "SUM" || name == "TOTAL" || name == "AVG") {
    if (n != 1) {
      return -2;
    }
    return name == "SUM" ? AG_SUM as i64 : name == "TOTAL" ? AG_TOTAL as i64 : AG_AVG as i64;
  }
  if (name == "MIN" || name == "MAX") {
    // With several arguments min() and max() are scalar functions.
    if (n == 1) {
      return name == "MIN" ? AG_MIN as i64 : AG_MAX as i64;
    }
    return n == 0 ? -2 : -1;
  }
  if (name == "GROUP_CONCAT") {
    return n == 1 || n == 2 ? AG_CONCAT as i64 : -2;
  }
  if (name == "STRING_AGG") {
    return n == 2 ? AG_CONCAT as i64 : -2;
  }
  return -1;
}

/** One aggregate call of a query. */
export class AggFn {
  kind: u8;
  args: (() => Val throws Error)[] = [];
  distinct: bool = false;
  filter: (() => bool throws Error) | null = null;
  /** The argument's collation (min, max, DISTINCT). */
  coll: u8 = BINARY;
  name: string;

  constructor(kind: u8, name: string) {
    this.kind = kind;
    this.name = name;
  }
}

/** The state of one aggregate call over one group. */
export class Acc {
  cnt: i64 = 0;
  isum: i64 = 0;
  rsum: f64 = 0;
  rerr: f64 = 0;
  approx: bool = false;
  ovrfl: bool = false;
  best: Val = nullVal();
  has: bool = false;
  text: string = "";
  /** count(DISTINCT x) and the like: the values seen (`one` holds the value looked up). */
  seen: KeySet | null = null;
  one: Val[] = [nullVal()];

  reset() {
    this.cnt = 0;
    this.isum = 0;
    this.rsum = 0;
    this.rerr = 0;
    this.approx = false;
    this.ovrfl = false;
    this.has = false;
    this.text = "";
    this.seen = null;
  }
}

/** One group of an aggregate query: its key, aggregates' states and results, saved columns. */
export class Group {
  key: Val[] = [];
  /** The aggregates' results, once the group is complete. */
  done: Val[] = [];
  /** A row was stepped: without min() or max(), the saved columns are the first row's. */
  started: bool = false;
  accs: Acc[] = [];
  bare: Val[] = [];
}

/** The aggregates and saved columns of one aggregate query. */
export class AggCtx {
  fns: AggFn[] = [];
  bareSrc: Source[] = [];
  bareCol: i64[] = [];
  /** The group being output. */
  cur: Group = new Group();

  /** The slot of a column read outside aggregates. */
  bareSlot(src: Source, col: i64): usize {
    for (let i: usize = 0; i < this.bareSrc.length; i++) {
      if (this.bareSrc[i] == src && this.bareCol[i] == col) {
        return i;
      }
    }
    this.bareSrc.push(src);
    this.bareCol.push(col);
    return this.bareSrc.length - 1;
  }

  /** A group with fresh accumulators and NULL saved columns. */
  newGroup(key: Val[]): Group {
    const g = new Group();
    g.key = key;
    for (let i: usize = 0; i < this.fns.length; i++) {
      g.accs.push(new Acc());
    }
    for (let i: usize = 0; i < this.bareSrc.length; i++) {
      g.bare.push(nullVal());
    }
    return g;
  }

  /** Makes `g` a fresh group again (one group without GROUP BY, reused each run). */
  resetGroup(g: Group) {
    for (const a of g.accs) {
      a.reset();
    }
    g.started = false;
    for (let i: usize = 0; i < g.bare.length; i++) {
      g.bare[i] = nullVal();
    }
  }

  /** Steps every aggregate of `g` with the current row, then saves its columns. */
  step(g: Group) {
    // Without min() or max(), the columns are saved from the group's first row; with them,
    // from each row that holds a new extreme (SQLite's "magnet" register).
    let skip = g.started;
    for (let i: usize = 0; i < this.fns.length; i++) {
      const f = this.fns[i];
      if (f.filter != null && !f.filter!()) {
        continue;
      }
      const notBest = stepOne(f, g.accs[i]);
      // Each min() or max() resets the flag: the last one decides (SQLite's OP_CollSeq).
      if (f.kind == AG_MIN || f.kind == AG_MAX) {
        skip = notBest;
      }
    }
    g.started = true;
    if (!skip) {
      for (let i: usize = 0; i < this.bareSrc.length; i++) {
        g.bare[i] = this.bareSrc[i].col(this.bareCol[i]);
      }
    }
  }

  /** Computes every aggregate of `g` (all of them, before HAVING, as SQLite's AggFinal). */
  finishGroup(g: Group) {
    __intrinsic_array_truncate(g.done, 0);
    for (let k: usize = 0; k < this.fns.length; k++) {
      g.done.push(finish(this.fns[k], g.accs[k]));
    }
  }

  /** The result of aggregate `k` over the group being output. */
  value(k: usize): Val {
    return this.cur.done[k];
  }
}

// Steps one aggregate; true when the row is not the min/max one (its columns are not saved).
function stepOne(f: AggFn, a: Acc): bool {
  if (f.kind == AG_COUNT_STAR) {
    a.cnt++;
    return false;
  }
  const v = f.args[0]();
  const sep = f.kind == AG_CONCAT && f.args.length > 1 ? f.args[1]() : nullVal();
  return stepValues(f, a, v, sep, f.args.length > 1);
}

/**
 * Steps an aggregate with its argument's value `v` (and group_concat's separator `sep`, when
 * `hasSep`); true when the row is not the min/max one.
 */
export function stepValues(f: AggFn, a: Acc, v: Val, sep: Val, hasSep: bool): bool {
  if (f.kind == AG_COUNT_STAR) {
    a.cnt++;
    return false;
  }
  if (f.distinct) {
    if (v.t == NULL) {
      return false;
    }
    if (a.seen == null) {
      a.seen = new KeySet(1, [f.coll]);
    }
    a.one[0] = v;
    if (a.seen!.find(a.one, 0) >= 0) {
      return false;
    }
  }
  if (f.kind == AG_COUNT) {
    if (v.t != NULL) {
      a.cnt++;
    }
    return false;
  }
  if (f.kind == AG_SUM || f.kind == AG_TOTAL || f.kind == AG_AVG) {
    sumStep(a, v);
    return false;
  }
  if (f.kind == AG_MIN || f.kind == AG_MAX) {
    if (v.t == NULL) {
      return a.has;
    }
    if (!a.has) {
      a.best = v;
      a.has = true;
      return false;
    }
    const c = compareVals(a.best, v, f.coll);
    if ((f.kind == AG_MAX && c < 0) || (f.kind == AG_MIN && c > 0)) {
      a.best = v;
      return false;
    }
    return true;
  }
  // group_concat
  if (v.t == NULL) {
    return false;
  }
  const s = a.cnt == 0 ? "" : !hasSep ? "," : sep.t == NULL ? "" : toText(sep);
  const t = toText(v);
  // SQLite's buffer holds the text and a NUL within its length limit.
  const n =
    __intrinsic_str_byte_len(a.text) + __intrinsic_str_byte_len(s) + __intrinsic_str_byte_len(t);
  checkLength((n + 1) as u64);
  a.text += s;
  a.text += t;
  a.cnt++;
  return false;
}

// Kahan-Babushka-Neumaier summation, as SQLite's sum(), total() and avg().
function kbn(a: Acc, r: f64) {
  const s = a.rsum;
  const t = s + r;
  if (Math.abs(s) > Math.abs(r)) {
    a.rerr += (s - t) + r;
  } else {
    a.rerr += (r - t) + s;
  }
  a.rsum = t;
}

function kbnInt(a: Acc, v: i64) {
  if (v <= -4503599627370496 || v >= 4503599627370496) {
    const sm = v % 16384;
    kbn(a, (v - sm) as f64);
    kbn(a, sm as f64);
  } else {
    kbn(a, v as f64);
  }
}

function kbnInit(a: Acc, v: i64) {
  if (v <= -4503599627370496 || v >= 4503599627370496) {
    const sm = v % 16384;
    a.rsum = (v - sm) as f64;
    a.rerr = sm as f64;
  } else {
    a.rsum = v as f64;
    a.rerr = 0;
  }
}

// The numeric type sum() sees: text that is wholly a number counts as that number.
function numericType(v: Val): u8 {
  if (v.t != TEXT) {
    return v.t;
  }
  // Read as a C string: up to a NUL.
  let t = toText(v);
  const nul = t.indexOf("\u0000");
  if (nul >= 0) {
    t = t.slice(0, nul);
  }
  const n = parseNumeric(t);
  return n.whole ? n.v.t : v.t;
}

function sumStep(a: Acc, v: Val) {
  const t = numericType(v);
  if (t == NULL) {
    return;
  }
  a.cnt++;
  if (!a.approx) {
    if (t != INTEGER) {
      kbnInit(a, a.isum);
      a.approx = true;
      kbn(a, toF64(v));
    } else {
      const x = toI64(v);
      const s = a.isum + x;
      if ((a.isum >= 0) == (x >= 0) && (s >= 0) != (x >= 0)) {
        a.ovrfl = true;
        kbnInit(a, a.isum);
        a.approx = true;
        kbnInt(a, x);
      } else {
        a.isum = s;
      }
    }
  } else if (t == INTEGER) {
    kbnInt(a, toI64(v));
  } else {
    a.ovrfl = false;
    kbn(a, toF64(v));
  }
}

function isOverflow(r: f64): bool {
  return r != r || r == Infinity || r == -Infinity;
}

function approxSum(a: Acc): f64 {
  if (!a.approx) {
    return a.isum as f64;
  }
  return isOverflow(a.rerr) ? a.rsum : a.rsum + a.rerr;
}

/** An aggregate's result over what it was stepped with. */
export function finish(f: AggFn, a: Acc): Val {
  if (f.kind == AG_COUNT_STAR || f.kind == AG_COUNT) {
    return intVal(a.cnt);
  }
  if (f.kind == AG_SUM) {
    if (a.cnt == 0) {
      return nullVal();
    }
    if (a.approx) {
      if (a.ovrfl) {
        throw new SqlRunError("integer overflow");
      }
      return realVal(approxSum(a));
    }
    return intVal(a.isum);
  }
  if (f.kind == AG_TOTAL) {
    return realVal(approxSum(a));
  }
  if (f.kind == AG_AVG) {
    return a.cnt == 0 ? nullVal() : realVal(approxSum(a) / (a.cnt as f64));
  }
  if (f.kind == AG_MIN || f.kind == AG_MAX) {
    return a.has ? a.best : nullVal();
  }
  return a.cnt == 0 ? nullVal() : textVal(a.text);
}
