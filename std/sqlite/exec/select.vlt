// velt:sqlite/exec/select — whole SELECT statements: WITH (common table expressions), compound
// selects (UNION [ALL], INTERSECT, EXCEPT) and the FROM items that read tables, subqueries and
// CTEs. Each core is compiled by velt:sqlite/exec/core.

import { DbFile } from "velt:sqlite/format";
import { INTEGER } from "velt:sqlite/btree";
import { BINARY } from "velt:sqlite/record";
import { A_NUMERIC, Schema, Table, View, collationOf } from "velt:sqlite/schema";
import {
  C_INTERSECT,
  C_NONE,
  C_UNION,
  C_UNION_ALL,
  E_COLLATE,
  E_COLUMN,
  E_STAR,
  Expr,
  FromItem,
  ResultColumn,
  Select,
  SelectCore,
} from "velt:sqlite/sql/ast";
import { SRC_ROWS, Source } from "velt:sqlite/exec/source";
import { Ev, Params, Query, Scope } from "velt:sqlite/exec/scope";
import { SqlRunError, prepareError } from "velt:sqlite/exec/errors";
import { ExprCompiler, hasAggregate } from "velt:sqlite/exec/expr";
import { hasWindow } from "velt:sqlite/exec/compiled";
import { SortKey } from "velt:sqlite/exec/emit";
import { KeySet } from "velt:sqlite/exec/keys";
import { compoundRows } from "velt:sqlite/exec/compound";
import {
  Tail,
  checkTerms,
  compileCore,
  ordinal,
  rangeError,
  resultIndex,
} from "velt:sqlite/exec/core";
import { forCompare } from "velt:sqlite/exec/ops";
import { Val } from "velt:sqlite/exec/value";

/** A WITH clause's table: its SELECT, compiled where it is used. */
class CteDef {
  name: string;
  cols: string[];
  select: Select;
  outer: Scope | null;
  active: bool = false;
  /** While its recursive part compiles: the query holding the row being expanded. */
  current: Query | null = null;
  /** Its FROM terms once flattened (-1: not yet counted). */
  flat: i64 = -1;
  /** Its compiled query, once a use compiled it, and the tables it read (counted per table). */
  query: Query | null = null;
  refNames: string[] = [];
  refCounts: i64[] = [];

  constructor(name: string, cols: string[], select: Select, outer: Scope | null) {
    this.name = name;
    this.cols = cols;
    this.select = select;
    this.outer = outer;
  }
}

/** The state of a recursive CTE's run: its queue, the rows seen (UNION), LIMIT and OFFSET. */
class RecState {
  queue: Val[] = [];
  seen: KeySet = new KeySet(0, []);
  head: usize = 0;
  limit: i64 = -1;
  offset: i64 = 0;
  done: bool = false;
}

// Whether a compound has UNION, INTERSECT or EXCEPT and an ORDER BY term with a COLLATE.
function collatedOrder(s: Select): bool {
  let distinct = false;
  for (let i: usize = 1; i < s.cores.length; i++) {
    if (s.cores[i].op != C_UNION_ALL) {
      distinct = true;
    }
  }
  if (!distinct) {
    return false;
  }
  for (const t of s.orderBy) {
    if (hasCollate(t.expr)) {
      return true;
    }
  }
  return false;
}

function hasCollate(e: Expr | null): bool {
  if (e == null) {
    return false;
  }
  const x = e!;
  if (x.kind == E_COLLATE) {
    return true;
  }
  if (hasCollate(x.a) || hasCollate(x.b) || hasCollate(x.c)) {
    return true;
  }
  for (const a of x.args) {
    if (hasCollate(a)) {
      return true;
    }
  }
  return false;
}

// The FROM terms of `core` once SQLite's query flattener merged the simple subqueries, CTEs and
// views it reads into it (an approximation of flattenSubquery's rules; stops past 200).
function flatTerms(c: SelectCompiler, core: SelectCore, depth: usize): i64 {
  if (core.flat >= 0) {
    return core.flat;
  }
  let n: i64 = 0;
  for (const item of core.from) {
    n += itemTerms(c, item, depth);
    if (n > 200) {
      break;
    }
  }
  core.flat = n;
  return n;
}

function itemTerms(c: SelectCompiler, item: FromItem, depth: usize): i64 {
  if (depth > 64) {
    return 1;
  }
  if (item.subquery != null) {
    const s = item.subquery!;
    return flattenable(s) ? flatTerms(c, s.cores[0], depth + 1) : 1;
  }
  if (item.schema == "") {
    const def = c.cteNamed(item.name);
    if (def != null) {
      const d = def!;
      if (d.flat < 0) {
        d.flat = 1;
        if (!d.active && !refersTo(d.select, d.name) && flattenable(d.select)) {
          d.active = true;
          d.flat = flatTerms(c, d.select.cores[0], depth + 1);
          d.active = false;
        }
      }
      return d.flat;
    }
  }
  const v = c.schema.view(item.name);
  if (v != null && flattenable(v!.select)) {
    return flatTerms(c, v!.select.cores[0], depth + 1);
  }
  return 1;
}

// Whether SQLite's flattener merges `s` into the query reading it: one plain core.
function flattenable(s: Select): bool {
  if (s.cores.length != 1 || s.limit != null || s.with.length > 0) {
    return false;
  }
  const core = s.cores[0];
  if (core.distinct || core.groupBy.length > 0 || core.having != null || core.values.length > 0) {
    return false;
  }
  if (core.from.length == 0) {
    return false;
  }
  for (const rc of core.columns) {
    if (hasAggregate(rc.expr) || hasWindow(rc.expr)) {
      return false;
    }
  }
  return true;
}

// Out-of-line messages (they keep the frames of the functions that report them small).
/**
 * The deepest nesting of views, subqueries and CTEs: SQLite stops nested views at 1000; this
 * engine at a depth its compile and run recursion hold on an 8 MiB stack.
 */
const MAX_NESTING: usize = 1000;

function tooDeep(): never {
  prepareError("VIEWs and/or subqueries nested too deep");
}

function noSuchFunction(name: string): never {
  prepareError(`no such table-valued function: ${name}`);
}

function circular(name: string): never {
  prepareError(`circular reference: ${name}`);
}

function cteWidth(name: string, got: usize, want: usize): never {
  prepareError(`table ${name} has ${got} values for ${want} columns`);
}

function noSuchTable(schema: string, name: string): never {
  prepareError(`no such table: ${schema != "" ? schema + "." + name : name}`);
}

// INDEXED BY must name an index of the table (the planner treats it as a hint).
function checkIndexedBy(t: Table, name: string) {
  for (const ix of t.indexes) {
    if (ix.name.toUpperCase() == name.toUpperCase()) {
      return;
    }
  }
  prepareError(`no such index: ${name}`);
}

function subqueryName(n: i64): string {
  return `(subquery-${n})`;
}

/** Compiles SELECT statements of one database. */
export class SelectCompiler extends ExprCompiler {
  ctes: CteDef[] = [];
  anon: i64 = 0;
  /** How many SELECTs (subqueries, views, CTEs) the one compiling is nested in. */
  depth: usize = 0;
  viewsOpen: string[] = [];
  /** References to each table and view in the statement, CTEs expanded (SQLite's nTabRef). */
  tableRefs: Map<string, i64> = new Map();
  refNames: string[] = [];
  refCounts: i64[] = [];

  constructor(db: DbFile, schema: Schema, params: Params, sql: string) {
    super(db, schema, params);
    this.sql = sql;
  }

  subquery(s: Select, sc: Scope): Query {
    return this.select(s, sc);
  }

  /** Compiles `s`, whose names may also resolve in `outer` (null at the top). */
  select(s: Select, outer: Scope | null): Query {
    // Each nested SELECT compiles (and runs) a level deeper on the stack.
    this.depth++;
    if (this.depth > MAX_NESTING) {
      tooDeep();
    }
    const q = this.selectIn(s, outer);
    this.depth--;
    return q;
  }

  selectIn(s: Select, outer: Scope | null): Query {
    const mark = this.ctes.length;
    for (const c of s.with) {
      this.ctes.push(new CteDef(c.name, c.columns, c.select, outer));
    }
    let q: Query;
    if (s.cores.length == 1) {
      const tail = new Tail();
      tail.orderBy = s.orderBy;
      tail.limit = s.limit;
      tail.offset = s.offset;
      q = compileCore(this, s.cores[0], outer, tail);
    } else {
      q = this.compound(s, outer);
    }
    __intrinsic_array_truncate(this.ctes, mark);
    return q;
  }

  // The functions on the path a nested FROM item compiles through keep small stack frames
  // (messages are made out of line): views and subqueries nest a thousand deep.

  fromSource(item: FromItem, outer: Scope | null): Source {
    if (item.subquery != null) {
      return this.subquerySource(item, outer);
    }
    if (item.args.length > 0) {
      noSuchFunction(item.name);
    }
    if (item.schema == "") {
      const at = this.cteAt(item.name);
      if (at >= 0) {
        return this.cteSource(at as usize, item);
      }
    }
    return this.tableSource(item);
  }

  subquerySource(item: FromItem, outer: Scope | null): Source {
    const q = this.select(item.subquery!, outer);
    this.anon++;
    return this.rowsSource(q, item.alias != "" ? item.alias : subqueryName(this.anon), []);
  }

  /** The position in `ctes` of the CTE `name` stands for, or -1. */
  cteAt(name: string): i64 {
    const want = name.toUpperCase();
    for (let i = this.ctes.length; i > 0; i--) {
      if (this.ctes[i - 1].name.toUpperCase() == want) {
        return (i - 1) as i64;
      }
    }
    return -1;
  }

  cteSource(at: usize, item: FromItem): Source {
    const def = this.ctes[at];
    const name = item.alias != "" ? item.alias : def.name;
    if (def.current != null) {
      return this.rowsSource(def.current!, name, def.cols);
    }
    if (def.active) {
      circular(def.name);
    }
    // Compiled once and shared by every use (its rows made once per run), unless it reads an
    // enclosing query: then each use runs its own.
    if (def.query != null && !def.query!.correlated) {
      // Each use counts the tables the CTE reads again, as SQLite expands it per use.
      for (let r: usize = 0; r < def.refNames.length; r++) {
        this.reference(def.refNames[r], def.refCounts[r]);
      }
      return this.rowsSource(def.query!, name, def.cols);
    }
    const refsFrom = this.refNames.length;
    // The CTE's SELECT sees the CTEs before it, not those after.
    const later: CteDef[] = [];
    while (this.ctes.length > at + 1) {
      later.push(this.ctes.pop()!);
    }
    def.active = true;
    const q =
      refersTo(def.select, def.name) ? this.recursive(def) : this.select(def.select, def.outer);
    def.active = false;
    while (later.length > 0) {
      this.ctes.push(later.pop()!);
    }
    if (def.cols.length > 0 && def.cols.length != q.names.length) {
      cteWidth(def.name, q.names.length, def.cols.length);
    }
    def.query = q;
    this.countCteRefs(def, refsFrom);
    return this.rowsSource(q, name, def.cols);
  }

  /** The references a CTE's compile counted (from `from` on), summed per table. */
  countCteRefs(def: CteDef, from: usize) {
    for (let r = from; r < this.refNames.length; r++) {
      const n = this.refNames[r];
      const at = def.refNames.indexOf(n);
      if (at < 0) {
        def.refNames.push(n);
        def.refCounts.push(this.refCounts[r]);
      } else {
        def.refCounts[at as usize] += this.refCounts[r];
      }
    }
  }

  tableSource(item: FromItem): Source {
    // The main schema only (no other database is attached; the temporary one is empty).
    if (item.schema != "" && item.schema.toLowerCase() != "main") {
      noSuchTable(item.schema, item.name);
    }
    let name = item.name;
    if (name.toUpperCase() == "SQLITE_MASTER") {
      name = "sqlite_schema";
    }
    const view = this.schema.view(name);
    if (view != null) {
      return this.viewSource(view!, item.alias != "" ? item.alias : item.name);
    }
    const t = this.schema.table(name);
    if (t == null) {
      noSuchTable(item.schema, item.name);
    }
    if (t!.withoutRowid) {
      prepareError("WITHOUT ROWID tables are not supported yet");
    }
    if (item.indexedBy != "") {
      checkIndexedBy(t!, item.indexedBy);
    }
    this.reference(t!.name, 1);
    return Source.ofTable(this.db, t!, item.alias != "" ? item.alias : item.name);
  }

  /**
   * A recursive CTE: `initial UNION [ALL] recursive`. Rows go through a queue: each row taken
   * from it is output, then the recursive part runs with the CTE standing for that row alone,
   * and its rows join the queue (UNION drops rows seen before), as SQLite runs them.
   */
  recursive(def: CteDef): Query {
    const s = def.select;
    let k: usize = 0;
    while (k < s.cores.length && !coreRefersTo(s.cores[k], def.name)) {
      k++;
    }
    if (k == 0 || k == s.cores.length) {
      prepareError(`recursive reference in a subquery: ${def.name}`);
    }
    const op = s.cores[k].op;
    if (op != C_UNION && op != C_UNION_ALL) {
      prepareError(`circular reference: ${def.name}`);
    }
    if (s.orderBy.length > 0) {
      prepareError("ORDER BY in a recursive common table expression is not supported yet");
    }
    const init = new Select();
    const rec = new Select();
    for (let i: usize = 0; i < s.cores.length; i++) {
      if (i < k) {
        init.cores.push(s.cores[i]);
      } else {
        rec.cores.push(s.cores[i]);
      }
    }
    const qi = this.select(init, def.outer);
    const width = qi.names.length;
    if (def.cols.length > 0 && def.cols.length != width) {
      prepareError(`table ${def.name} has ${width} values for ${def.cols.length} columns`);
    }
    const cur = new Query();
    cur.fixed = true;
    cur.names = def.cols.length > 0 ? def.cols : qi.names;
    cur.affs = qi.affs;
    cur.colls = qi.colls;
    cur.out.width = width;
    def.current = cur;
    const firstOp = rec.cores[0].op;
    rec.cores[0].op = C_NONE;
    const qr = this.select(rec, def.outer);
    rec.cores[0].op = firstOp;
    def.current = null;
    if (qr.names.length != width) {
      prepareError(
        `SELECTs to the left and right of ${op == C_UNION ? "UNION" : "UNION ALL"} do not have the same number of result columns`,
      );
    }
    const q = new Query();
    q.names = cur.names;
    q.affs = qi.affs;
    q.colls = qi.colls;
    q.out.width = width;
    q.correlated = qi.correlated || qr.correlated;
    for (let i: usize = 0; i < width; i++) {
      q.refSrc.push(null);
      q.refCol.push(-2);
    }
    // LIMIT and OFFSET name no column (SQLite's empty name context).
    const limitEv: Ev | null = s.limit == null ? null : this.ev(s.limit!, new Scope());
    const offsetEv: Ev | null = s.offset == null ? null : this.ev(s.offset!, new Scope());
    const distinct = op == C_UNION;
    const colls: u8[] = [];
    for (const c of qi.colls) {
      colls.push(c >= 0 ? c as u8 : BINARY);
    }
    const out = q.out;
    // Run as a co-routine: each row is made when the reader wants it (an endless recursion
    // stops at a LIMIT outside).
    const st = new RecState();
    q.lazyStart = () => {
      st.limit = limitOf(limitEv, -1);
      st.offset = limitOf(offsetEv, 0);
      st.queue = [];
      st.seen = new KeySet(width, colls);
      st.head = 0;
      st.done = st.limit == 0;
      if (!st.done) {
        qi.run();
        enqueue(st.queue, qi.out.vals, width, distinct, st.seen);
      }
    };
    q.lazyMore = () => {
      while (!st.done && st.head * width < st.queue.length) {
        const at = st.head * width;
        st.head++;
        let made = false;
        if (st.offset > 0) {
          st.offset--;
        } else {
          for (let j: usize = 0; j < width; j++) {
            out.vals.push(st.queue[at + j]);
          }
          out.rows++;
          made = true;
          if (st.limit > 0 && (out.rows as i64) >= st.limit) {
            st.done = true;
            return true;
          }
        }
        cur.out.reset();
        for (let j: usize = 0; j < width; j++) {
          cur.out.vals.push(st.queue[at + j]);
        }
        cur.out.rows = 1;
        qr.run();
        enqueue(st.queue, qr.out.vals, width, distinct, st.seen);
        if (made) {
          return true;
        }
      }
      return false;
    };
    const start = q.lazyStart!;
    const more = q.lazyMore!;
    q.body = () => {
      start();
      while (more()) {}
    };
    return q;
  }

  /** A FROM clause past SQLite's 200 terms once flattened: reported after the whole statement. */
  tooManyTerms: bool = false;

  noteFromTerms(core: SelectCore) {
    if (!this.tooManyTerms && flatTerms(this, core, 0) > 200) {
      this.tooManyTerms = true;
    }
  }

  /** The CTE `name` resolves to here, or null. */
  cteNamed(name: string): CteDef | null {
    const want = name.toUpperCase();
    for (let i = this.ctes.length; i > 0; i--) {
      if (this.ctes[i - 1].name.toUpperCase() == want) {
        return this.ctes[i - 1];
      }
    }
    return null;
  }

  refMark(): usize {
    return this.refNames.length;
  }

  rewindRefs(mark: usize) {
    for (let r = mark; r < this.refNames.length; r++) {
      const key = this.refNames[r].toLowerCase();
      this.tableRefs.set(key, this.tableRefs.get(key)! - this.refCounts[r]);
    }
    __intrinsic_array_truncate(this.refNames, mark);
    __intrinsic_array_truncate(this.refCounts, mark);
  }

  /** Counts `n` more references to a table or view: SQLite's limit is 65535 a statement. */
  reference(name: string, n: i64) {
    const key = name.toLowerCase();
    const now = (this.tableRefs.has(key) ? this.tableRefs.get(key)! : 0) + n;
    if (now >= 65535) {
      prepareError(`too many references to "${name}": max 65535`);
    }
    this.tableRefs.set(key, now);
    this.refNames.push(name);
    this.refCounts.push(n);
  }

  /** A view, compiled like a subquery in FROM (it sees no enclosing query). */
  viewSource(v: View, name: string): Source {
    this.reference(v.name, 1);
    if (this.viewsOpen.includes(v.name.toUpperCase())) {
      prepareError(`view ${v.name} is circularly defined`);
    }
    this.viewsOpen.push(v.name.toUpperCase());
    // CTEs of the statement are not visible inside the view.
    const saved: CteDef[] = this.ctes;
    this.ctes = [];
    const q = this.select(v.select, null);
    this.ctes = saved;
    this.viewsOpen.pop();
    if (v.columns.length > 0 && v.columns.length != q.names.length) {
      prepareError(
        `expected ${v.columns.length} columns for '${v.name}' but got ${q.names.length}`,
      );
    }
    return this.rowsSource(q, name, v.columns);
  }

  /** A source over the rows `q` produces. */
  rowsSource(q: Query, name: string, cols: string[]): Source {
    const src = new Source(SRC_ROWS, name);
    for (let i: usize = 0; i < q.names.length; i++) {
      src.cols.push(cols.length > 0 ? cols[i] : q.names[i]);
      src.affs.push(q.affs[i]);
      src.colls.push(q.colls[i] >= 0 ? q.colls[i] as u8 : BINARY);
      src.hidden.push(false);
    }
    src.rows = q.out;
    src.width = q.names.length;
    this.rowsSrc.push(src);
    this.rowsQ.push(q);
    return src;
  }

  compound(s: Select, outer: Scope | null): Query {
    // UNION, INTERSECT or EXCEPT ordered under a COLLATE of its own: as SQLite
    // (convertCompoundSelectToSubquery), `SELECT * FROM (compound) ORDER BY … LIMIT …`, so that
    // rows match under their columns' collations and the ORDER BY's only orders them.
    if (collatedOrder(s)) {
      const inner = new Select();
      inner.cores = s.cores;
      inner.height = s.height;
      const wrap = new Select();
      wrap.height = s.height;
      const core = new SelectCore();
      core.columns.push(ResultColumn { expr: new Expr(E_STAR, 0), alias: "", span: "*" });
      const item = new FromItem();
      item.subquery = inner;
      core.from.push(item);
      wrap.cores.push(core);
      wrap.orderBy = s.orderBy;
      wrap.limit = s.limit;
      wrap.offset = s.offset;
      return this.select(wrap, outer);
    }
    const parts: Query[] = [];
    for (const core of s.cores) {
      parts.push(compileCore(this, core, outer, new Tail()));
    }
    const first = parts[0];
    const width = first.names.length;
    for (let i: usize = 1; i < parts.length; i++) {
      if (parts[i].names.length != width) {
        const op = s.cores[i].op;
        const name =
          op == C_UNION_ALL
            ? "UNION ALL"
            : op == C_UNION ? "UNION" : op == C_INTERSECT ? "INTERSECT" : "EXCEPT";
        prepareError(
          `SELECTs to the left and right of ${name} do not have the same number of result columns`,
        );
      }
    }
    const q = new Query();
    q.names = first.names;
    q.affs = first.affs;
    q.colls = first.colls;
    q.out.width = width;
    for (const p of parts) {
      if (p.correlated) {
        q.correlated = true;
      }
    }
    for (let i: usize = 0; i < width; i++) {
      q.refSrc.push(null);
      q.refCol.push(-2);
    }
    const colls: u8[] = [];
    for (const c of first.colls) {
      colls.push(c >= 0 ? c as u8 : BINARY);
    }
    const sort: SortKey[] = [];
    checkTerms(s.orderBy.length, "ORDER");
    for (let k: usize = 0; k < s.orderBy.length; k++) {
      const t = s.orderBy[k];
      let i = resultIndex(t.expr, s.cores[0].columns, width, "ORDER", k);
      if (i >= (width as i64)) {
        rangeError(k, "ORDER", width);
      }
      if (i < 0 && t.expr.kind == E_COLUMN) {
        for (let j: usize = 0; j < width; j++) {
          if (first.names[j].toUpperCase() == t.expr.name.toUpperCase()) {
            i = j as i64;
            break;
          }
        }
      }
      if (i < 0) {
        prepareError(`${ordinal(k + 1)} ORDER BY term does not match any column in the result set`);
      }
      const coll: u8 =
        t.expr.kind == E_COLLATE ? collationOf(t.expr.name) as u8 : colls[i as usize];
      sort.push(new SortKey(i, null, t.desc, t.nulls, coll));
    }
    // LIMIT and OFFSET name no column (SQLite's empty name context).
    const limitEv: Ev | null = s.limit == null ? null : this.ev(s.limit!, new Scope());
    const offsetEv: Ev | null = s.offset == null ? null : this.ev(s.offset!, new Scope());
    const ops: u8[] = [];
    for (const core of s.cores) {
      ops.push(core.op);
    }
    const out = q.out;
    const need = q;
    q.body = () => {
      let limit = limitOf(limitEv, -1);
      let offset = limitOf(offsetEv, 0);
      if (need.need >= 0 && (limit < 0 || limit > need.need)) {
        limit = need.need;
      }
      for (const p of parts) {
        p.run();
      }
      const rows = compoundRows(
        parts,
        ops,
        parts.length - 1,
        sort.length > 0 ? sort : null,
        width,
        colls,
      );
      const n = rows.length / width;
      const order: i64[] = [];
      for (let r: usize = 0; r < n; r++) {
        order.push(r as i64);
      }
      for (const r of order) {
        if (limit >= 0 && (out.rows as i64) >= limit) {
          break;
        }
        if (offset > 0) {
          offset--;
          continue;
        }
        for (let j: usize = 0; j < width; j++) {
          out.vals.push(rows[(r as usize) * width + j]);
        }
        out.rows++;
      }
    };
    return q;
  }
}

// Rows appended to a recursive CTE's queue (UNION: only rows not seen before).
function enqueue(queue: Val[], rows: Val[], width: usize, distinct: bool, seen: KeySet) {
  const n = width == 0 ? 0 : rows.length / width;
  for (let r: usize = 0; r < n; r++) {
    if (distinct && seen.find(rows, r * width) >= 0) {
      continue;
    }
    for (let j: usize = 0; j < width; j++) {
      queue.push(rows[r * width + j]);
    }
  }
}

// Whether a FROM item of a core names `name` (a recursive CTE's reference to itself).
function coreRefersTo(core: SelectCore, name: string): bool {
  const n = name.toUpperCase();
  for (const f of core.from) {
    if (f.schema == "" && f.subquery == null && f.name.toUpperCase() == n) {
      return true;
    }
  }
  return false;
}

function refersTo(s: Select, name: string): bool {
  for (const c of s.cores) {
    if (coreRefersTo(c, name)) {
      return true;
    }
  }
  return false;
}

function limitOf(ev: Ev | null, dflt: i64): i64 {
  if (ev == null) {
    return dflt;
  }
  const v = forCompare(ev!(), A_NUMERIC);
  if (v.t != INTEGER) {
    throw new SqlRunError("datatype mismatch");
  }
  return v.i;
}
