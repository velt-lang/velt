// velt:sqlite/record — building records and comparing them as SQLite orders index keys
// (https://sqlite.org/fileformat2.html#record_format, https://sqlite.org/datatype3.html#sort_order).
//
// Order: NULL < INTEGER and REAL (by value, compared exactly across the two) < TEXT (by the
// column's collation; BINARY compares the UTF-8 bytes) < BLOB (bytes). A key that is a prefix of
// a record compares equal to it here; the caller decides what equal means for a seek.

import { corrupt, fieldSize, readBe, readVarint } from "velt:sqlite/format";
import { utf8Encode } from "velt:encoding";

/** Collations of index columns. */
export const BINARY: u8 = 0;
export const NOCASE: u8 = 1;
export const RTRIM: u8 = 2;

/** A record being built, one value at a time; `finish()` gives its bytes. */
export class RecordBuilder {
  types: i64[] = [];
  body: u8[] = [];

  addNull() {
    this.types.push(0);
  }

  addInt(v: i64) {
    if (v == 0 || v == 1) {
      this.types.push(8 + v);
      return;
    }
    // The smallest of 1, 2, 3, 4, 6 and 8 bytes that holds v.
    let n: usize = 8;
    let t: i64 = 6;
    if (v >= -128 && v <= 127) {
      n = 1;
      t = 1;
    } else if (v >= -32768 && v <= 32767) {
      n = 2;
      t = 2;
    } else if (v >= -8388608 && v <= 8388607) {
      n = 3;
      t = 3;
    } else if (v >= -2147483648 && v <= 2147483647) {
      n = 4;
      t = 4;
    } else if (v >= -140737488355328 && v <= 140737488355327) {
      n = 6;
      t = 5;
    }
    this.types.push(t);
    pushBe(this.body, v as u64, n);
  }

  addReal(v: f64) {
    this.types.push(7);
    pushBe(this.body, v.toBits(), 8);
  }

  addText(s: string) {
    const bytes = utf8Encode(s);
    this.types.push(13 + 2 * (bytes.length as i64));
    for (const b of bytes) {
      this.body.push(b);
    }
  }

  addBlob(bytes: u8[]) {
    this.types.push(12 + 2 * (bytes.length as i64));
    for (const b of bytes) {
      this.body.push(b);
    }
  }

  /** The record's bytes: the header (its size, then the serial types) and the body. */
  finish(): u8[] {
    const head: u8[] = [];
    for (const t of this.types) {
      pushVarint(head, t as u64);
    }
    // The header size counts its own varint.
    let size = head.length + 1;
    while (head.length + varintLen(size as u64) != size) {
      size = head.length + varintLen(size as u64);
    }
    const out: u8[] = __intrinsic_array_with_capacity(size + this.body.length);
    pushVarint(out, size as u64);
    for (const b of head) {
      out.push(b);
    }
    for (const b of this.body) {
      out.push(b);
    }
    return out;
  }
}

function pushBe(out: u8[], v: u64, n: usize) {
  for (let i: usize = n; i > 0; i--) {
    out.push(((v >> ((8 * (i - 1)) as u64)) & 0xff) as u8);
  }
}

/** The length of `v` as a varint. */
export function varintLen(v: u64): usize {
  if (v >= 0x0100000000000000) {
    return 9;
  }
  let n: usize = 1;
  let rest = v >> 7;
  while (rest != 0) {
    n++;
    rest = rest >> 7;
  }
  return n;
}

/** Appends `v` as a varint. */
export function pushVarint(out: u8[], v: u64) {
  const n = varintLen(v);
  if (n == 9) {
    // Eight bytes of 7 bits, then all 8 bits of the last.
    for (let i: usize = 0; i < 8; i++) {
      out.push((((v >> ((57 - 7 * i) as u64)) & 0x7f) | 0x80) as u8);
    }
    out.push((v & 0xff) as u8);
    return;
  }
  for (let i: usize = n; i > 1; i--) {
    out.push((((v >> ((7 * (i - 1)) as u64)) & 0x7f) | 0x80) as u8);
  }
  out.push((v & 0x7f) as u8);
}

/** The class rank of a serial type: NULL 0, numbers 1, text 2, blob 3. */
function rank(t: i64): i64 {
  if (t == 0) {
    return 0;
  }
  if (t < 12) {
    return 1;
  }
  return (t & 1) == 1 ? 2 : 3;
}

function intAt(data: u8[], at: usize, t: i64): i64 {
  if (t == 8) {
    return 0;
  }
  if (t == 9) {
    return 1;
  }
  const n: usize = t == 5 ? 6 : t == 6 ? 8 : t as usize;
  const v = readBe(data, at, n);
  if (n == 8) {
    return v as i64;
  }
  const shift = (64 - 8 * n) as u64;
  return ((v << shift) as i64) >> (shift as i64);
}

/** -1, 0 or 1 for an integer against a float, exactly (as sqlite3IntFloatCompare). */
function compareIntReal(i: i64, r: f64): i64 {
  if (r != r) {
    // NaN is stored as NULL; treat as smaller than any number for safety.
    return 1;
  }
  if (r < -9223372036854775808.0) {
    return 1;
  }
  if (r >= 9223372036854775808.0) {
    return -1;
  }
  const t = Math.trunc(r);
  const ti = t as i64;
  if (i < ti) {
    return -1;
  }
  if (i > ti) {
    return 1;
  }
  // Same integer part: the fraction decides.
  return r > t ? -1 : r < t ? 1 : 0;
}

function sign(x: i64): i64 {
  return x < 0 ? -1 : x > 0 ? 1 : 0;
}

function foldAscii(b: u8): u8 {
  return b >= 65 && b <= 90 ? b + 32 : b;
}

/** Bytes [a, a + na) against [b, b + nb) under a collation. */
function compareBytes(x: u8[], a: usize, na: usize, y: u8[], b: usize, nb: usize, coll: u8): i64 {
  if (coll == RTRIM) {
    while (na > 0 && x[a + na - 1] == 32) {
      na--;
    }
    while (nb > 0 && y[b + nb - 1] == 32) {
      nb--;
    }
  }
  const n = na < nb ? na : nb;
  for (let i: usize = 0; i < n; i++) {
    let p = x[a + i];
    let q = y[b + i];
    if (coll == NOCASE) {
      p = foldAscii(p);
      q = foldAscii(q);
    }
    if (p != q) {
      return p < q ? -1 : 1;
    }
  }
  return sign((na as i64) - (nb as i64));
}

/**
 * Compares the record at `a` (in `x`, `na` bytes) with the record at `b` (in `y`) field by
 * field, over the first `fields` fields or the shorter record. `colls[i]` and `desc[i]` give
 * field `i`'s collation and direction (missing entries are BINARY, ascending). Returns a
 * negative number, zero or a positive number.
 */
export function compareRecords(
  x: u8[],
  a: usize,
  na: usize,
  y: u8[],
  b: usize,
  nb: usize,
  fields: usize,
  colls: u8[],
  desc: bool[],
): i64 {
  const ha = readVarint(x, a);
  const hb = readVarint(y, b);
  if (ha.value < 0 || (ha.value as usize) > na || hb.value < 0 || (hb.value as usize) > nb) {
    corrupt("record header size");
  }
  const enda = a + (ha.value as usize);
  const endb = b + (hb.value as usize);
  let ta = a + ha.len;
  let tb = b + hb.len;
  let ba = enda;
  let bb = endb;
  let i: usize = 0;
  while (i < fields && ta < enda && tb < endb) {
    const va = readVarint(x, ta);
    const vb = readVarint(y, tb);
    ta += va.len;
    tb += vb.len;
    const sa = va.value;
    const sb = vb.value;
    // Each field's body must lie inside its record.
    const za = fieldSize(sa, a + na - ba);
    const zb = fieldSize(sb, b + nb - bb);
    let c: i64 = 0;
    const ra = rank(sa);
    const rb = rank(sb);
    if (ra != rb) {
      c = ra < rb ? -1 : 1;
    } else if (ra == 1) {
      if (sa == 7 && sb == 7) {
        const fa = f64.fromBits(readBe(x, ba, 8));
        const fb = f64.fromBits(readBe(y, bb, 8));
        c = fa < fb ? -1 : fa > fb ? 1 : 0;
      } else if (sa == 7) {
        c = -compareIntReal(intAt(y, bb, sb), f64.fromBits(readBe(x, ba, 8)));
      } else if (sb == 7) {
        c = compareIntReal(intAt(x, ba, sa), f64.fromBits(readBe(y, bb, 8)));
      } else {
        const ia = intAt(x, ba, sa);
        const ib = intAt(y, bb, sb);
        c = ia < ib ? -1 : ia > ib ? 1 : 0;
      }
    } else if (ra >= 2) {
      const coll = ra == 2 && i < colls.length ? colls[i] : BINARY;
      c = compareBytes(x, ba, za, y, bb, zb, coll);
    }
    if (c != 0) {
      return i < desc.length && desc[i] ? -c : c;
    }
    ba += za;
    bb += zb;
    i++;
  }
  return 0;
}
