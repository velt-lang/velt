// velt:sqlite/schema — the tables and indexes of a database, read from `sqlite_schema` (page 1)
// and parsed from the CREATE statements stored there
// (https://sqlite.org/schematab.html, https://sqlite.org/datatype3.html#type_affinity).

import { DbFile } from "velt:sqlite/format";
import { Cursor } from "velt:sqlite/btree";
import { parseOne } from "velt:sqlite/sql/statement";
import {
  E_COLUMN,
  IndexedColumn,
  S_CREATE_INDEX,
  S_CREATE_TABLE,
  Statement,
} from "velt:sqlite/sql/ast";
import { BINARY, NOCASE, RTRIM } from "velt:sqlite/record";
import { SqlError } from "velt:sqlite/sql/lexer";

/** Column affinities. */
export const A_BLOB: u8 = 0; // "none"
export const A_TEXT: u8 = 1;
export const A_NUMERIC: u8 = 2;
export const A_INTEGER: u8 = 3;
export const A_REAL: u8 = 4;

/** The affinity of a declared type, by SQLite's rules (§3.1 of datatype3). */
export function affinityOf(type: string): u8 {
  const t = type.toUpperCase();
  if (t.includes("INT")) {
    return A_INTEGER;
  }
  if (t.includes("CHAR") || t.includes("CLOB") || t.includes("TEXT")) {
    return A_TEXT;
  }
  if (t.includes("BLOB") || t.length == 0) {
    return A_BLOB;
  }
  if (t.includes("REAL") || t.includes("FLOA") || t.includes("DOUB")) {
    return A_REAL;
  }
  return A_NUMERIC;
}

/** A collation's code from its name (unknown names are reported by the caller). */
export function collationOf(name: string): i64 {
  const n = name.toUpperCase();
  if (n == "" || n == "BINARY") {
    return BINARY as i64;
  }
  if (n == "NOCASE") {
    return NOCASE as i64;
  }
  if (n == "RTRIM") {
    return RTRIM as i64;
  }
  return -1;
}

/** A column of a table: its declared type and affinity, constraints and collation. */
export class Column {
  name: string;
  type: string;
  affinity: u8;
  notNull: bool = false;
  collation: u8 = BINARY;
  /** The declared collation's name, upper case ("BINARY" when none is declared). */
  collationName: string = "BINARY";
  /** The column is the rowid (`INTEGER PRIMARY KEY`): not stored in the record (NULL there). */
  isRowid: bool = false;
  hasDefault: bool = false;
  /** A generated column (`AS (…)`); `stored` when it is STORED, VIRTUAL otherwise. */
  generated: bool = false;
  stored: bool = false;
  /**
   * The column's field in the table's records: VIRTUAL generated columns have none (-1), and a
   * WITHOUT ROWID table's records hold its primary key columns first.
   */
  field: i64 = -1;

  constructor(name: string, type: string) {
    this.name = name;
    this.type = type;
    this.affinity = affinityOf(type);
  }
}

/** An index of a table: declared (CREATE INDEX) or automatic (UNIQUE, PRIMARY KEY). */
export class Index {
  name: string;
  table: string;
  root: u32;
  unique: bool;
  /** For each key column: its column's position in the table (-1 for the rowid, -2 for an
   *  expression), collation and direction; the rowid follows the key columns in each entry. */
  columns: i64[] = [];
  colls: u8[] = [];
  desc: bool[] = [];
  partial: bool = false;
  /**
   * False when a key column has a collation this engine does not know: the entries are in an
   * order it cannot compare in, so the index must not be used for seeks.
   */
  seekable: bool = true;
  /** Why the index cannot be used (its CREATE INDEX does not parse), or "". */
  unsupported: string = "";

  constructor(name: string, table: string, root: u32, unique: bool) {
    this.name = name;
    this.table = table;
    this.root = root;
    this.unique = unique;
  }
}

/** A table: its columns, its rowid alias, and its indexes. */
export class Table {
  name: string;
  root: u32;
  columns: Column[] = [];
  /** The position of the rowid alias column, or -1. */
  rowidColumn: i64 = -1;
  withoutRowid: bool = false;
  /** A STRICT table: its ANY columns have no affinity. */
  strict: bool = false;
  indexes: Index[] = [];
  sql: string;
  /** "table", or "view" or "virtual table" (which this engine cannot read yet). */
  kind: string = "table";
  /**
   * Why the table cannot be used, or "": its CREATE statement does not parse (the parser's
   * message), or it is a view or a virtual table. `Schema.table` throws this for it.
   */
  unsupported: string = "";

  constructor(name: string, root: u32, sql: string) {
    this.name = name;
    this.root = root;
    this.sql = sql;
  }

  /** The position of column `name` (case-insensitive), or -1. */
  column(name: string): i64 {
    const n = name.toUpperCase();
    for (let i: usize = 0; i < this.columns.length; i++) {
      if (this.columns[i].name.toUpperCase() == n) {
        return i as i64;
      }
    }
    return -1;
  }
}

/** One row of sqlite_schema, as stored: every row is kept, whether this engine can use it or not. */
export struct SchemaRow {
  type: string;
  name: string;
  tableName: string;
  root: u32;
  sql: string;
}

/** The schema of one database file. */
export class Schema {
  /** Tables, views and virtual tables, usable or not (`Table.unsupported`). */
  tables: Table[] = [];
  /** Every row of sqlite_schema (tables, indexes, views, triggers), in its order. */
  rows: SchemaRow[] = [];
  cookie: u32 = 0;

  /**
   * The table `name` (case-insensitive), or null if there is none. One this engine cannot use
   * throws why (SqlError), so it never reads as missing.
   */
  table(name: string): Table | null {
    const t = this.find(name);
    if (t != null && t!.unsupported != "") {
      throw new SqlError(`${t!.name}: ${t!.unsupported}`, 0);
    }
    return t;
  }

  /** The table, view or virtual table `name` (case-insensitive), usable or not, or null. */
  find(name: string): Table | null {
    const n = name.toUpperCase();
    for (const t of this.tables) {
      if (t.name.toUpperCase() == n) {
        return t;
      }
    }
    return null;
  }
}

/**
 * Reads the schema of `db`. Every sqlite_schema row is kept (`Schema.rows`); a table, view or
 * virtual table this engine cannot use is in `tables` with why (`Table.unsupported`), and an
 * index it cannot use is on its table with why (`Index.unsupported`).
 */
export function loadSchema(db: DbFile): Schema {
  const schema = new Schema();
  schema.cookie = db.schemaCookie;
  const master = new Table("sqlite_schema", 1, "");
  for (const c of ["type", "name", "tbl_name", "rootpage", "sql"]) {
    master.columns.push(new Column(c, c == "rootpage" ? "INT" : "TEXT"));
  }
  fields(master, []);
  schema.tables.push(master);
  const pending: Statement[] = [];
  const failed: string[] = [];
  const roots: u32[] = [];
  const names: string[] = [];
  const c = new Cursor(db, 1);
  let more = c.first();
  while (more) {
    const row = SchemaRow {
      type: c.text(0),
      name: c.text(1),
      tableName: c.text(2),
      root: c.int(3) as u32,
      sql: c.text(4),
    };
    schema.rows.push(row);
    if (row.type == "table") {
      schema.tables.push(table(row));
    } else if (row.type == "view") {
      const t = new Table(row.name, 0, row.sql);
      t.kind = "view";
      t.unsupported = "views are not supported yet";
      schema.tables.push(t);
    } else if (row.type == "index") {
      // Indexes after their tables; an automatic index (UNIQUE, PRIMARY KEY) has no SQL.
      names.push(row.name);
      roots.push(row.root);
      let s = new Statement(0);
      let why = "";
      if (row.sql != "") {
        try {
          s = parseOne(row.sql);
        } catch (e) {
          why = e.message;
        }
      }
      // Remember the table (an automatic index has only its name).
      s.table = s.kind == S_CREATE_INDEX ? s.table : row.tableName;
      pending.push(s);
      failed.push(why);
    }
    more = c.next();
  }
  for (let i: usize = 0; i < pending.length; i++) {
    addIndex(schema, pending[i], names[i], roots[i], failed[i]);
  }
  return schema;
}

function tryParse(sql: string): Statement | null {
  try {
    return parseOne(sql);
  } catch (e) {
    return null;
  }
}

/** The table of a sqlite_schema row: usable, or with why not. */
function table(row: SchemaRow): Table {
  let st = new Statement(0);
  try {
    st = parseOne(row.sql);
  } catch (e) {
    const t = new Table(row.name, row.root, row.sql);
    t.unsupported = e.message;
    if (row.sql.toUpperCase().startsWith("CREATE VIRTUAL")) {
      t.kind = "virtual table";
    }
    return t;
  }
  if (st.kind != S_CREATE_TABLE) {
    const t = new Table(row.name, row.root, row.sql);
    t.unsupported = "not a CREATE TABLE statement";
    return t;
  }
  const t = new Table(st.name, row.root, row.sql);
  t.withoutRowid = st.withoutRowid;
  t.strict = st.strict;
  for (const d of st.columnDefs) {
    const col = new Column(d.name, d.type);
    // In a STRICT table, ANY means no affinity at all.
    if (st.strict && d.type.toUpperCase() == "ANY") {
      col.affinity = A_BLOB;
    }
    col.notNull = d.notNull;
    col.hasDefault = d.dflt != null;
    col.generated = d.generated != null;
    col.stored = d.stored;
    const coll = collationOf(d.collate);
    // An unknown collation keeps BINARY here; indexes over the column are marked not seekable.
    col.collation = coll < 0 ? BINARY : coll as u8;
    col.collationName = d.collate == "" ? "BINARY" : d.collate.toUpperCase();
    t.columns.push(col);
  }
  /**
   * INTEGER PRIMARY KEY (exactly that type, not DESC) is the rowid; so is PRIMARY KEY (x)
   * naming one INTEGER column.
   */
  let pk: i64 = -1;
  for (let i: usize = 0; i < st.columnDefs.length; i++) {
    const d = st.columnDefs[i];
    if (d.primaryKey && d.type.toUpperCase() == "INTEGER" && !d.desc) {
      pk = i as i64;
    }
  }
  if (st.primaryKey.length == 1 && st.primaryKey[0].expr.kind == E_COLUMN) {
    const i = t.column(st.primaryKey[0].expr.name);
    if (i >= 0 && t.columns[i as usize].type.toUpperCase() == "INTEGER") {
      pk = i;
    }
  }
  if (pk >= 0 && !t.withoutRowid) {
    t.rowidColumn = pk;
    t.columns[pk as usize].isRowid = true;
  }
  // A WITHOUT ROWID table's key columns are NOT NULL, declared or not (as SQLite enforces).
  const keyCols: i64[] = [];
  if (t.withoutRowid) {
    for (const k of st.keys) {
      if (!k.primary) {
        continue;
      }
      for (const c of k.columns) {
        const i = c.expr.kind == E_COLUMN ? t.column(c.expr.name) : -1;
        if (i >= 0) {
          t.columns[i as usize].notNull = true;
          if (!keyCols.includes(i)) {
            keyCols.push(i);
          }
        }
      }
    }
  }
  fields(t, keyCols);
  return t;
}

/**
 * Each column's field in the records: the key columns `first` (a WITHOUT ROWID table's primary
 * key), then the others in order, VIRTUAL generated columns left out (sqlite3TableColumnToStorage).
 */
function fields(t: Table, first: i64[]) {
  let n: i64 = 0;
  for (const i of first) {
    t.columns[i as usize].field = n;
    n++;
  }
  for (let i: usize = 0; i < t.columns.length; i++) {
    const col = t.columns[i];
    if (first.includes(i as i64) || (col.generated && !col.stored)) {
      continue;
    }
    col.field = n;
    n++;
  }
}

function addIndex(schema: Schema, s: Statement, name: string, root: u32, why: string) {
  if (why != "") {
    // A CREATE INDEX that does not parse: on its table, unusable.
    const t = schema.find(s.table);
    if (t != null) {
      const ix = new Index(name, t!.name, root, false);
      ix.unsupported = why;
      ix.seekable = false;
      t!.indexes.push(ix);
    }
    return;
  }
  if (s.kind == S_CREATE_INDEX) {
    const t = schema.find(s.table);
    if (t == null) {
      return;
    }
    const ix = new Index(name, t!.name, root, s.unique);
    if (t!.unsupported != "") {
      ix.unsupported = t!.unsupported;
      ix.seekable = false;
      t!.indexes.push(ix);
      return;
    }
    ix.partial = s.where != null;
    keyColumns(t!, ix, s.indexed);
    t!.indexes.push(ix);
    return;
  }
  /** An automatic index: sqlite_autoindex_<table>_<n>, for a UNIQUE or PRIMARY KEY constraint. */
  const t = schema.find(s.table);
  if (t == null) {
    return;
  }
  if (t!.unsupported != "") {
    // The index of a table this engine cannot use: kept, unusable for the same reason.
    const ix = new Index(name, t!.name, root, true);
    ix.unsupported = t!.unsupported;
    ix.seekable = false;
    t!.indexes.push(ix);
    return;
  }
  const def = tryParse(t!.sql);
  if (def == null) {
    return;
  }
  const n = autoIndexNumber(name);
  const keys = autoIndexKeys(t!, def!);
  if (n < 1 || n > keys.length) {
    return;
  }
  const ix = new Index(name, t!.name, root, true);
  keyColumns(t!, ix, keys[n - 1]);
  t!.indexes.push(ix);
}

/**
 * The keys of a table's automatic indexes, in the order SQLite numbers them: its PRIMARY KEY and
 * UNIQUE constraints in source order (column ones where their column is), except a PRIMARY KEY
 * that is the rowid, and except a constraint over the same columns with the same collations as
 * an earlier one (SQLite makes no second index for it). A WITHOUT ROWID table's PRIMARY KEY
 * takes a number, though its index is the table itself and has no row in sqlite_schema.
 */
function autoIndexKeys(t: Table, def: Statement): IndexedColumn[][] {
  const keys: IndexedColumn[][] = [];
  const seen: string[] = [];
  for (const k of def.keys) {
    if (k.primary && t.rowidColumn >= 0) {
      continue;
    }
    const sig = signature(t, k.columns);
    if (seen.includes(sig)) {
      continue;
    }
    seen.push(sig);
    keys.push(k.columns);
  }
  return keys;
}

/** The columns and collations of a key, as text: two keys index alike when these are equal. */
function signature(t: Table, cols: IndexedColumn[]): string {
  let s = "";
  for (const k of cols) {
    const pos = k.expr.kind == E_COLUMN ? t.column(k.expr.name) : -2;
    let coll = k.collate.toUpperCase();
    if (coll == "" && pos >= 0) {
      coll = t.columns[pos as usize].collationName;
    }
    s += `${pos}:${coll == "" ? "BINARY" : coll},`;
  }
  return s;
}

function autoIndexNumber(name: string): usize {
  const at = name.lastIndexOf("_");
  return at < 0 ? 0 : parseInt(name.slice(at + 1), 10) as usize;
}

function keyColumns(t: Table, ix: Index, cols: IndexedColumn[]) {
  for (const k of cols) {
    let pos: i64 = -2;
    let at: i64 = -1;
    if (k.expr.kind == E_COLUMN) {
      at = t.column(k.expr.name);
      pos = at >= 0 && t.columns[at as usize].isRowid ? -1 : at;
    }
    ix.columns.push(pos);
    // An index column takes its column's collation unless it names one.
    let name = k.collate;
    if (name == "" && at >= 0) {
      name = t.columns[at as usize].collationName;
    }
    const coll = collationOf(name);
    if (coll < 0) {
      ix.seekable = false;
    }
    ix.colls.push(coll < 0 ? BINARY : coll as u8);
    ix.desc.push(k.desc);
  }
}
