// velt/net (internal): `peekSocket` on Windows: Winsock's `recv` with `MSG_PEEK` looks at what
// arrived on a socket without taking it (the runtime's sockets don't block, so it doesn't
// wait). A variant of `#socket-peek` (std/imports.vlt); the variants export the same API.

import { lastOsError } from "velt/os/rt";
import { PEEK_CLOSED, PEEK_OPEN, PEEK_UNKNOWN } from "velt/net/peek/state";

declare system function recv(s: usize, buf: u8[], flags: i32): i32;

const MSG_PEEK: i32 = 2;
const WSAEINTR: i32 = 10004;
const WSAEWOULDBLOCK: i32 = 10035;

/**
 * What a look at socket `handle` (a Winsock `SOCKET`; -1: none) finds: `PEEK_OPEN` when nothing
 * arrived yet, `PEEK_CLOSED` when the peer closed or reset the connection, `PEEK_UNKNOWN` when
 * bytes wait (they come first) or no look is possible.
 */
export function peekSocket(handle: i64): i32 {
  if (handle < 0) {
    return PEEK_UNKNOWN;
  }
  const one: u8[] = [0];
  const n = recv(handle as usize, one, MSG_PEEK);
  if (n > 0) {
    return PEEK_UNKNOWN;
  }
  if (n == 0) {
    return PEEK_CLOSED;
  }
  const err = lastOsError();
  if (err == WSAEWOULDBLOCK) {
    return PEEK_OPEN;
  }
  return err == WSAEINTR ? PEEK_UNKNOWN : PEEK_CLOSED;
}
