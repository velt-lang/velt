// velt/net/http: the HTTP client and the web types both sides of HTTP share, as the web globals
// of Node, Deno and Bun: `fetch` (HTTP/1.1, and HTTP/2 where the origin offers it), `Request`,
// `Response`, `Headers` and their bodies; and what a server written in Velt needs of them
// (`RequestSource`, `responseParts`, `statusText`; packages/http-server is one). HTTP/2's wire
// format is velt/net/http/h2. docs/std/fetch.md.

export {
  BodyInit,
  BodyStream,
  fetch,
  Headers,
  HeadersInit,
  Request,
  RequestInit,
  RequestRedirect,
  Response,
  ResponseInit,
} from "velt/net/http/fetch/fetch";
export { RequestSource, requestSource, serverRequest } from "velt/net/http/fetch/source";
export { statusText } from "velt/net/http/fetch/status";
export {
  BodyKind,
  ResponseParts,
  responseParts,
  switchingProtocols,
} from "velt/net/http/fetch/parts";
