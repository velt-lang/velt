// Whether every character of `s[from..to)` is one `table` allows (ASCII only).
function allOf(s: string, from: i64, to: i64, table: u8[]): bool {
  for (let i = from; i < to; i++) {
    const c = s.charCodeAt(i);
    if (c >= 128 || table[c as usize] == 0) {
      return false;
    }
  }
  return true;
}

function isToken(s: string): bool {
  return s.length > 0 && allOf(s, 0, s.length as i64, TOKEN);
}

function isCookieValue(s: string): bool {
  return allOf(s, 0, s.length as i64, COOKIE_OCTET);
}

// The first index in `[from, to)` that isn't a space or tab (`to` if none).
function skipSpace(s: string, from: i64, to: i64): i64 {
  let i = from;
  while (i < to && (s.charCodeAt(i) == 0x20 || s.charCodeAt(i) == 0x09)) {
    i++;
  }
  return i;
}

// The end of `[from, to)` without trailing spaces and tabs.
function trimSpace(s: string, from: i64, to: i64): i64 {
  let e = to;
  while (e > from && (s.charCodeAt(e - 1) == 0x20 || s.charCodeAt(e - 1) == 0x09)) {
    e--;
  }
  return e;
}

// A `Domain`, `Path` or extra attribute: no `;` and no control characters.
function checkAttribute(what: string, s: string) {
  for (let i: i64 = 0; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    if (c < 0x20 || c == 0x7f || c == 0x3b) {
      throw new TypeError(`Invalid cookie ${what}: "${s}"`);
    }
  }
}
