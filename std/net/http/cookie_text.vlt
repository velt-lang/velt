// velt/net/http (internal): the character classes and scanning helpers of cookies
// (std/net/http/cookie.vlt): RFC 7230 tokens, RFC 6265 cookie-octets, spaces and digits.

// One or more ASCII digits.
export function isDigits(s: string): bool {
  if (s.length == 0) {
    return false;
  }
  for (let i: i64 = 0; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    if (c < 0x30 || c > 0x39) {
      return false;
    }
  }
  return true;
}

