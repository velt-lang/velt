// velt/net/http (internal): reading the body of a `Request` (request.velt): as text, as bytes, chunk
// by chunk.

import { IoError } from "velt/io/error";
import { AbortError } from "velt/task";
import { utf8DecodeLossy, utf8Encode } from "velt/encoding";
import { BodyParts, collect } from "velt/net/http/fetch/body";
import { BodyStream } from "velt/net/http/fetch/body_stream";
import { Request } from "velt/net/http/fetch/request";
import { Extra } from "velt/net/http/fetch/request_extra";
import { RequestSource } from "velt/net/http/fetch/source";

/** A body read from `chunks`. */
export function streamed(chunks: AsyncIterator<u8[], IoError | AbortError>): BodyParts {
  return { kind: 3, text: "", bytes: [], stream: BodyStream.adopt(chunks), implied: 0 };
}

/** The body of a request without one, as `fetch` takes it. */
export function noBody(): BodyParts {
  return { kind: 0, text: "", bytes: [], stream: null, implied: 0 };
}

/** `r.text()`: the body as text (invalid UTF-8 becomes U+FFFD, as in JS). */
export async function requestText(r: Request): Promise<string, IoError | AbortError> {
  r.claim();
  const received = r.fromServer();
  if (received != null) {
    return utf8DecodeLossy(await received.body());
  }
  const body = r.made();
  if (body == null) {
    return "";
  }
  if (body.kind == 1) {
    return body.text;
  }
  const s = body.stream;
  return utf8DecodeLossy(s == null ? body.bytes : await collect(s));
}

/** The body of `r` as Velt's byte array (`bytes()`, `formData()`, …). */
export async function requestBytes(r: Request): Promise<u8[], IoError | AbortError> {
  r.claim();
  const received = r.fromServer();
  if (received != null) {
    return await received.body();
  }
  const body = r.made();
  if (body == null) {
    return [];
  }
  if (body.kind == 1) {
    return utf8Encode(body.text);
  }
  const s = body.stream;
  return s == null ? body.bytes : await collect(s);
}

/**
 * A request's body chunk by chunk, for `BodyStream`; reading them uses the body up. They hold the
 * request's state `e` and its server side `received`, not the request: the body they read may be
 * a stream of such chunks, which would make a cycle of every `Request`
 * (docs/internals/design/cycles.md, #3119). Both are read at the first chunk, so a `clone()`
 * before that tees what they read, as when the request held them.
 */
export function requestChunks(
  e: Extra,
  received: RequestSource | null,
): AsyncIterator<u8[], IoError | AbortError> {
  return new RequestChunks(e, received);
}

// `requestChunks`. The body is claimed at the first `next`, or at `return` (a stream cancelled
// before its first read uses the body up too, as in Node).
class RequestChunks implements AsyncIterator<u8[], IoError | AbortError> {
  private e: Extra;
  private received: RequestSource | null;
  private chunks: AsyncIterator<u8[], IoError | AbortError> | null = null;

  constructor(e: Extra, received: RequestSource | null) {
    this.e = e;
    this.received = received;
  }

  // A body another stream drained (read to its end, or cancelled) gives nothing more, as Node's
  // one closed stream; one used any other way (`text()`, a stream still reading) is locked.
  // `used` comes before whether a body is left: a received body that was read has none.
  private open(): AsyncIterator<u8[], IoError | AbortError> throws IoError {
    const made = this.chunks;
    if (made != null) {
      return made;
    }
    const e = this.e;
    if (e.used && !e.drained) {
      throw new IoError("EINVAL", "Invalid state: ReadableStream is locked");
    }
    const body = e.drained ? null : e.body;
    const received = e.drained ? null : this.received;
    if (body == null ? received != null && received.hasBody() : true) {
      e.used = true;
    }
    const opened = bodyChunks(body, received);
    this.chunks = opened;
    return opened;
  }

  async next(): Promise<IteratorResult<u8[]>, IoError | AbortError> {
    const r = await this.open().next();
    if (r.done) {
      this.e.drained = true;
    }
    return r;
  }

  async return(): Promise<IteratorResult<u8[]>> {
    let opened: AsyncIterator<u8[], IoError | AbortError> | null = null;
    try {
      opened = this.open();
    } catch (e) {
      // Used by another read: nothing of this stream's to end.
    }
    if (opened != null) {
      await opened.return();
      this.e.drained = true;
    }
    return { done: true };
  }
}

// The chunks of a made body, or of the connection's for a received one.
async function* bodyChunks(
  body: BodyParts | null,
  received: RequestSource | null,
): AsyncIterator<u8[], IoError | AbortError> {
  if (body == null) {
    while (received != null) {
      const chunk = await received.read();
      if (chunk == null) {
        return;
      }
      if (chunk.length > 0) {
        yield chunk;
      }
    }
    return;
  }
  const s = body.stream;
  if (body.kind == 1) {
    yield utf8Encode(body.text);
  } else if (s != null) {
    for await (const chunk of s) {
      yield chunk;
    }
  } else if (body.bytes.length > 0) {
    yield body.bytes;
  }
}

/** A received request's body as the connection receives it, chunk by chunk. */
export async function* receivedChunks(
  received: RequestSource | null,
): AsyncIterator<u8[], IoError | AbortError> {
  if (received == null) {
    return;
  }
  while (true) {
    const chunk = await received.read();
    if (chunk == null) {
      return;
    }
    if (chunk.length > 0) {
      yield chunk;
    }
  }
}
