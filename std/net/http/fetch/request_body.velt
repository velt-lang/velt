// velt/net/http (internal): reading the body of a `Request` (request.velt): as text, as bytes, chunk
// by chunk.

import { IoError } from "velt/io/error";
import { AbortError } from "velt/task";
import { utf8DecodeLossy, utf8Encode } from "velt/encoding";
import { BodyParts, collect } from "velt/net/http/fetch/body";
import { BodyStream } from "velt/net/http/fetch/body_stream";
import { Request } from "velt/net/http/fetch/request";
import { Extra } from "velt/net/http/fetch/request_extra";
import { RequestSource } from "velt/net/http/fetch/source";

/** A body read from `chunks`. */
export function streamed(chunks: AsyncIterator<u8[], IoError | AbortError>): BodyParts {
  return { kind: 3, text: "", bytes: [], stream: BodyStream.adopt(chunks), implied: 0 };
}

/** The body of a request without one, as `fetch` takes it. */
export function noBody(): BodyParts {
  return { kind: 0, text: "", bytes: [], stream: null, implied: 0 };
}

/** `r.text()`: the body as text (invalid UTF-8 becomes U+FFFD, as in JS). */
export async function requestText(r: Request): Promise<string, IoError | AbortError> {
  r.claim();
  const received = r.fromServer();
  if (received != null) {
    return utf8DecodeLossy(await received.body());
  }
  const body = r.made();
  if (body == null) {
    return "";
  }
  if (body.kind == 1) {
    return body.text;
  }
  const s = body.stream;
  return utf8DecodeLossy(s == null ? body.bytes : await collect(s));
}

/** The body of `r` as Velt's byte array (`bytes()`, `formData()`, …). */
export async function requestBytes(r: Request): Promise<u8[], IoError | AbortError> {
  r.claim();
  const received = r.fromServer();
  if (received != null) {
    return await received.body();
  }
  const body = r.made();
  if (body == null) {
    return [];
  }
  if (body.kind == 1) {
    return utf8Encode(body.text);
  }
  const s = body.stream;
  return s == null ? body.bytes : await collect(s);
}

/**
 * A request's body chunk by chunk, for `BodyStream`; reading them uses the body up. It takes the
 * request's state `e` and its server side `received`, not the request: the body it reads may be a
 * stream of these chunks' own type, which would make a cycle of every `Request`
 * (docs/internals/design/cycles.md, #3119). Both are read at the first chunk, so a `clone()`
 * before that tees what it reads, as when the request held them.
 */
export async function* requestChunks(
  e: Extra,
  received: RequestSource | null,
): AsyncIterator<u8[], IoError | AbortError> {
  // `used` before whether a body is left: a received body that was read has none, but is used.
  if (e.used) {
    throw new IoError("EINVAL", "Body is unusable: Body has already been read");
  }
  const body = e.body;
  if (body == null ? received != null && received.hasBody() : true) {
    e.used = true;
  }
  if (body == null) {
    while (received != null) {
      const chunk = await received.read();
      if (chunk == null) {
        return;
      }
      if (chunk.length > 0) {
        yield chunk;
      }
    }
    return;
  }
  const s = body.stream;
  if (body.kind == 1) {
    yield utf8Encode(body.text);
  } else if (s != null) {
    for await (const chunk of s) {
      yield chunk;
    }
  } else if (body.bytes.length > 0) {
    yield body.bytes;
  }
}

/** A received request's body as the connection receives it, chunk by chunk. */
export async function* receivedChunks(
  received: RequestSource | null,
): AsyncIterator<u8[], IoError | AbortError> {
  if (received == null) {
    return;
  }
  while (true) {
    const chunk = await received.read();
    if (chunk == null) {
      return;
    }
    if (chunk.length > 0) {
      yield chunk;
    }
  }
}
