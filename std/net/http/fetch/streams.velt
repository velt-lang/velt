// velt/net/http (internal): `Response.body` and `Request.body`, the body as a `ReadableStream` of
// `Uint8Array`s. `extend` blocks of their own, loaded (with velt/io/streams/streams and the typed arrays)
// only by programs that use `Response` and read a `body` property
// (std/prelude/global/fetch_body.velt), so other fetch and http programs don't compile them.

import { AbortError } from "velt/task";
import { IoError } from "velt/io/error";
import { Request } from "velt/net/http/fetch/request";
import { Response } from "velt/net/http/fetch/response";
import { ReadableStream } from "velt/io/streams/streams";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";

extend Response {
  /**
   * The body as it arrives, a `ReadableStream` of `Uint8Array`s: `getReader()`, or
   * `for await (const chunk of res.body)`. Null for a status that has no body (101, 103, 204,
   * 205, 304), for a `HEAD` request's response and for a response made without one.
   */
  get body(): ReadableStream<Uint8Array> | null {
    if (!this.streams()) {
      return null;
    }
    return bodyStream(this.chunks(), this.bodyUsed);
  }
}

extend Request {
  /**
   * The body as a `ReadableStream` of `Uint8Array`s; null without a body. Reading it uses the
   * body up, as `text()` does.
   */
  get body(): ReadableStream<Uint8Array> | null {
    if (!this.hasBody()) {
      return null;
    }
    return bodyStream(this.chunks(), this.bodyUsed);
  }
}

// A `body` getter's stream: the chunks of `chunks` as `Uint8Array`s (not copied), read only
// when the stream is read.
function bodyStream(
  chunks: AsyncIterator<u8[], IoError | AbortError>,
  used: bool,
): ReadableStream<Uint8Array> {
  return ReadableStream.body<Uint8Array>(new ByteChunks(chunks), used);
}

// Leaving early (the stream cancelled, or a `for await` left) ends `chunks` too, also while a
// `next` waits, so the body's source hears it: a server's `ReadableStream` `cancel` at once, a
// generator's `finally` at its next `yield`.
class ByteChunks implements AsyncIterator<Uint8Array, Error> {
  private chunks: AsyncIterator<u8[], IoError | AbortError>;

  constructor(chunks: AsyncIterator<u8[], IoError | AbortError>) {
    this.chunks = chunks;
  }

  async next(): Promise<IteratorResult<Uint8Array>, Error> {
    const r = await this.chunks.next();
    if (r.done) {
      return { done: true };
    }
    return { value: Uint8Array.wrap(r.value), done: false };
  }

  async return(): Promise<IteratorResult<Uint8Array>> {
    await this.chunks.return();
    return { done: true };
  }
}
