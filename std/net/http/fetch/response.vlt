// velt/net/http (internal): the WHATWG `Response` (https://veltlang.com/docs/std/net/http/): what `fetch` resolves to,
// what a server handler returns (`serve`), or a response built with `new Response(body, init)`
// / `Response.json(data)`.
//
// A fetched response holds the transport's response (`Fetched` of `#http-transport`: client/fetched.vlt,
// or client/transport/js_fetched.vlt on JS hosts) whose head has arrived; its body is received by the first `text()`, `json()`, `bytes()` or
// `arrayBuffer()`, or chunk by chunk through `res.body` (a second read throws, as in JS). A
// compressed body (`content-encoding: gzip`, `deflate`, `br`) arrives decoded. Dropping the
// response closes the connection of a body nobody read. The status text and headers are made
// into strings the first time they are read (most programs read neither), and stay readable
// after the body was read. A built response
// makes no `Headers` until they are read: the `content-type` its body implies waits in
// `headImplied`, and a server sends it from there.

import { JSON } from "velt/prelude/json/json";
import { JsonError } from "velt/prelude/json/json_error";
import { IoError } from "velt/io/error";
import { AbortError, AbortSignal } from "velt/task";
import {
  BodyInit,
  JSON_TYPE,
  TEXT_TYPE,
  bodyParts,
  impliedType,
  sourceType,
} from "velt/net/http/fetch/body";
import { BodyStream } from "velt/net/http/fetch/body_stream";
import { Headers } from "velt/net/http/fetch/headers";
import { ResponseInit } from "velt/net/http/fetch/response_init";
import { Fetched } from "#http-transport";
import { ResponseParts } from "velt/net/http/fetch/parts";
import { INSPECT } from "velt/lang/hooks/keys";
import { Remote } from "velt/net/http/fetch/response_remote";
import {
  cloneResponse,
  NONE,
  responseBytes,
  responseChunks,
  responseText,
  RUNTIME,
  serverParts,
  TEXT,
} from "velt/net/http/fetch/response_body";

export class Response {
  private headCode: i64 = 200;
  // Null until `headers` is first read.
  private headFields: Headers | null = null;
  // The `content-type` the body implies (`impliedType`), until `headers` is first read.
  private headImplied: u32 = 0;
  // A fetched response's status text and URL: null until first read.
  private headReason: string | null = "";
  // A fetched response's signal, URL and `redirected`: null for one made here.
  private headRemote: Remote | null = null;
  private bodyRead: bool = false;
  private bodySource: i64 = 0;
  private bodyText: string = "";
  // A bytes body (null for any other), so a response without one allocates no array.
  private bodyBytes: u8[] | null = null;
  private bodyStream: BodyStream | null = null;
  // A fetched response's head and body (also of a HEAD request's, whose source is NONE).
  private bodyFetched: Fetched | null = null;

  constructor(body: BodyInit | null = null, init?: ResponseInit) {
    if (init == null && typeof body == "string") {
      // Most responses: text and no options, so no parts and no status to check.
      this.bodySource = TEXT;
      this.bodyText = body;
      this.headImplied = TEXT_TYPE;
      return;
    }
    if (body != null || init != null) {
      this.setUp(body, init, 0);
    }
  }

  // The constructor's work; `type` (if not 0) replaces the `content-type` the body implies.
  private setUp(body: BodyInit | null, init: ResponseInit | null | undefined, type: u32) {
    if (init != null) {
      this.init(init);
    }
    if (body == null) {
      return;
    }
    const status = this.headCode;
    if (status == 204 || status == 205 || status == 304) {
      panic(`TypeError: Response constructor: Invalid response status code ${status}`);
    }
    let implied = type;
    if (typeof body == "string") {
      // Most bodies: no parts to make.
      this.bodySource = TEXT;
      this.bodyText = body;
      implied = type != 0 ? type : TEXT_TYPE;
    } else {
      const parts = bodyParts(body);
      this.bodySource = parts.kind as i64;
      this.bodyText = parts.text;
      if (parts.kind == 2) {
        this.bodyBytes = parts.bytes;
      }
      this.bodyStream = parts.stream;
      implied = type != 0 ? type : parts.implied;
      const st = sourceType(body);
      if (st != null && type == 0) {
        // A blob's or form's type: a header of its own, unless `init` named one.
        const h = this.headers;
        if (!h.has("content-type")) {
          h.set("content-type", st);
        }
      }
    }
    const fields = this.headFields;
    if (fields == null) {
      this.headImplied = implied;
      return;
    }
    const ct = impliedType(implied);
    if (ct != null && !fields.has("content-type")) {
      fields.set("content-type", ct);
    }
  }

  // The status, status text and headers of `init`.
  private init(init: ResponseInit) {
    const status = (init.status ?? 200) as i64;
    if (status < 200 || status > 599) {
      panic(`RangeError: init["status"] must be in the range of 200 to 599, inclusive.`);
    }
    this.headCode = status;
    this.headReason = init.statusText ?? "";
    const given = init.headers;
    if (given != null) {
      this.headFields = new Headers(given);
    }
  }

  // The response `fetch` received, whose body aborts with `signal` (std only). The response to
  // a HEAD request has no body, whatever its headers say: `body` is null and `text()` is "".
  private static adopt(f: Fetched, signal: AbortSignal | null, head: bool): Response {
    const r = new Response();
    r.headCode = f.status;
    r.headReason = null;
    const remote = new Remote(signal);
    remote.url = f.url;
    remote.redirected = f.redirected;
    r.headRemote = remote;
    r.bodySource = head ? NONE : RUNTIME;
    r.bodyFetched = f;
    return r;
  }

  // A `101 Switching Protocols` response with `headers` (`switchingProtocols`, parts.vlt; the
  // constructor takes 200-599).
  private static switching(headers: Headers): Response {
    const r = new Response();
    r.headCode = 101;
    r.headFields = headers;
    return r;
  }

  /**
   * A response whose body is `JSON.stringify(data)`, with `content-type: application/json`
   * unless `init` sets one.
   */
  static json<T>(data: T, init?: ResponseInit): Response {
    const r = new Response();
    if (init == null) {
      r.bodySource = TEXT;
      r.bodyText = JSON.stringify(data);
      r.headImplied = JSON_TYPE;
      return r;
    }
    r.setUp(JSON.stringify(data), init, JSON_TYPE);
    return r;
  }

  /** A network error: status 0, type "error". */
  static error(): Response {
    const r = new Response();
    r.headCode = 0;
    return r;
  }

  /** A redirect to `url` (`status` 301, 302, 303, 307 or 308). */
  static redirect(url: string, status: i64 = 302): Response {
    if (status != 301 && status != 302 && status != 303 && status != 307 && status != 308) {
      panic(`RangeError: Invalid status code ${status}`);
    }
    const r = new Response(null, { status: status as number });
    r.headers.set("location", url);
    return r;
  }

  /** The headers; a fetched response's are immutable. */
  get headers(): Headers {
    const known = this.headFields;
    if (known != null) {
      return known;
    }
    let h = new Headers();
    const f = this.bodyFetched;
    if (f != null) {
      h = Headers.adopt(f.headers());
      h.frozen = true;
    }
    // `h` is empty: the implied type moves over as its number (std/net/http/fetch/headers.vlt).
    h.implied = this.headImplied;
    this.headImplied = 0;
    this.headFields = h;
    return h;
  }

  get status(): i64 {
    return this.headCode;
  }

  /** Whether the status is 200–299. */
  get ok(): bool {
    return this.headCode >= 200 && this.headCode <= 299;
  }

  /**
   * The status message (`OK`, `Not Found`): the server's reason phrase, else the standard one for
   * the status ("" for a status without one, and for a constructed response by default).
   */
  get statusText(): string {
    const known = this.headReason;
    if (known != null) {
      return known;
    }
    const f = this.bodyFetched;
    const s = f == null ? "" : f.statusText();
    this.headReason = s;
    return s;
  }

  /** The URL the response came from, after redirects ("" for a constructed response). */
  get url(): string {
    const remote = this.headRemote;
    if (remote == null) {
      return "";
    }
    return remote.url ?? "";
  }

  /** Whether `fetch` followed a redirect to get it. */
  get redirected(): bool {
    const remote = this.headRemote;
    if (remote == null) {
      return false;
    }
    return remote.redirected ?? false;
  }

  /** "basic" (fetched), "default" (constructed) or "error" (`Response.error()`). */
  get type(): string {
    if (this.headCode == 0) {
      return "error";
    }
    return this.headRemote != null ? "basic" : "default";
  }

  /**
   * A copy of the response whose body can be read on its own: a streamed or fetched body is
   * teed, each chunk going to both. Throws `IoError` "EINVAL" (JS: `TypeError`) when the body
   * was already read.
   */
  clone(): Response throws IoError {
    return cloneResponse(this);
  }

  // `headRemote`, for a fetched response (which has one).
  private decodedRemote(): Remote {
    const remote = this.headRemote;
    if (remote == null) {
      panic("ICE: a fetched response without its remote state");
    }
    return remote;
  }

  // `body` is in velt/net/http/fetch/streams, loaded with the streams it gives
  // (std/prelude/global/fetch_body.vlt).

  // Whether the response has a body to stream (`body` is not null).
  private streams(): bool {
    const code = this.headCode;
    const none = code == 101 || code == 103 || code == 204 || code == 205;
    return !(none || code == 304 || this.bodySource == NONE);
  }

  /** Whether the body has been read. */
  get bodyUsed(): bool {
    return this.bodyRead;
  }

  /** The body as text (invalid UTF-8 becomes U+FFFD, as in JS). */
  async text(): Promise<string, IoError | AbortError> {
    return await responseText(this);
  }

  /**
   * `JSON.parse<T>` of the body: the JSON is checked against `T` (`JsonError` if it doesn't
   * match). Velt has no `any`: name the type, `await res.json<User[]>()`, or annotate the
   * variable that receives it.
   */
  async json<T>(): Promise<T, IoError | AbortError | JsonError> {
    return JSON.parse<T>(await this.text());
  }

  // The body's bytes, as Velt's byte array.
  private rawBytes(): Promise<u8[], IoError | AbortError> {
    return responseBytes(this);
  }

  // `bytes()` and `arrayBuffer()` are in velt/net/http/fetch/typed, loaded with the typed arrays they
  // give (std/prelude/global/fetch_bytes.vlt).

  // The body's chunks, for `BodyStream` (std only); reading them uses the body up.
  private chunks(): AsyncIterator<u8[], IoError | AbortError> {
    return responseChunks(this);
  }

  // What a server writes for this response (`responseParts`, parts.vlt; `serverParts`,
  // response_body.vlt).
  private serverBody(): ResponseParts throws IoError {
    return serverParts(this);
  }

  // Whether a fetched body arrives decoded (its `content-encoding` no longer applies).
  private decoded(): bool {
    const f = this.bodyFetched;
    if (f != null) {
      return f.decoded();
    }
    const remote = this.headRemote;
    return remote != null && remote.decoded;
  }

  // Marks the body read; throws if it was already. A response without a body can be read any
  // number of times, as in JS.
  private claim() throws IoError {
    if (this.bodySource == NONE) {
      return;
    }
    if (this.bodyRead) {
      throw new IoError("EINVAL", "Body is unusable: Body has already been read");
    }
    this.bodyRead = true;
  }

  /** How `console.log` shows the response, like Node: its public state. */
  [INSPECT]() {
    return {
      status: this.status,
      statusText: this.statusText,
      headers: this.headers,
      // As Node shows a body stream (printed without loading velt/io/streams/streams).
      body: this.streams() ? BodyStream.adopt(this.chunks(), this.bodyRead) : null,
      bodyUsed: this.bodyUsed,
      ok: this.ok,
      redirected: this.redirected,
      type: this.type,
      url: this.url,
    };
  }

  /** Drop hook: closes the connection of a fetched body nobody finished reading. */
  [Symbol.dispose]() {
    const f = this.bodyFetched;
    if (f != null) {
      f.close();
      this.bodyFetched = null;
    }
  }
}
