// velt/net/http (internal): `RequestInit`, the options of `fetch(input, init)` and `new
// Request(input, init)`, and the methods they name.

import { AbortSignal } from "velt/task";
import { BodyInit } from "velt/net/http/fetch/body";
import { HeadersInit } from "velt/net/http/fetch/headers";

/** What `fetch` does with a redirect: follow it (default, up to 20), fail, or return it. */
export type RequestRedirect = "follow" | "error" | "manual";

/** The options of `fetch(input, init)` and `new Request(input, init)`. */
export type RequestInit = {
  /** Default "GET"; `get`, `post`, `put`, `delete`, `head` and `options` are uppercased. */
  method?: string;
  headers?: HeadersInit;
  body?: BodyInit;
  redirect?: RequestRedirect;
  /**
   * Aborting it rejects the `fetch` (and a body read in progress) with its `AbortError`
   * (`TimeoutError` for `AbortSignal.timeout(ms)`), and cancels the request.
   */
  signal?: AbortSignal;
  /** Velt: extra trusted CA certificates (PEM) for `https://`, e.g. a private or test CA. */
  ca?: string;
  /**
   * Velt (as Bun's): the proxy for this request and its redirects,
   * `http://[user:password@]host[:port]`, or `""` to connect directly. Without it, `fetch` uses
   * the environment's, as Bun does (Node only with `NODE_USE_ENV_PROXY=1`): `https_proxy` /
   * `HTTPS_PROXY` for `https:`, `http_proxy` / `HTTP_PROXY` for `http:`, else `ALL_PROXY`,
   * except for the hosts `NO_PROXY` lists (`NO_PROXY=*` for none), read at every request; a
   * variable naming another kind of proxy (`socks5://`, `https://`) is ignored, which this option
   * refuses (`EINVAL`). Only `fetch` reads it, not `new Request`; on
   * `wasm32-unknown-unknown` the host's `fetch` runs and this is ignored.
   */
  proxy?: string;
};

/** The method as the Fetch standard normalizes it (std only: `fetch` uses it too). */
export function normalizeMethod(m: string): string {
  const up = m.toUpperCase();
  if (
    up == "DELETE" || up == "GET" || up == "HEAD" || up == "OPTIONS" || up == "POST" || up == "PUT"
  ) {
    return up;
  }
  return m;
}
