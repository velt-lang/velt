// velt/net/http (internal): the WHATWG `Blob` and `File` (docs/std/net/http.md): immutable bytes with
// a media type, which a `Response` or `Request` takes as its body (the type becomes its
// `content-type`), and which `FormData` sends as a file. The bytes are held whole, in one array.
//
// `bytes()`, `arrayBuffer()` and `stream()` give typed arrays and streams: they are in
// velt/net/http/fetch/blob_typed, loaded only by programs that call them
// (std/prelude/global/blob_typed.vlt), as `Response.bytes()` is.

import { ArrayBuffer, BufferView } from "velt/lang/typed_array/core";
import { utf8DecodeLossy, utf8Encode } from "velt/encoding";
import { BODY_TYPE, WHOLE_BODY, ByteSource } from "velt/io/streams/byte_source";
import { INSPECT } from "velt/lang/hooks/keys";
import { VIEW_SIZE } from "velt/lang/hooks/keys";

/** What a blob is made of: text (encoded as UTF-8), bytes, or another blob. */
export type BlobPart = string | u8[] | BufferView | ArrayBuffer | Blob;

/** The options of `new Blob(parts, options)`. */
export struct BlobPropertyBag {
  /** The media type, lowercased ("" if it has a character outside printable ASCII). */
  type?: string;
}

/** The options of `new File(parts, name, options)`. */
export struct FilePropertyBag {
  type?: string;
  /** Milliseconds since the epoch; default now. */
  lastModified?: i64;
}

export class Blob extends ByteSource {
  #bytes: u8[] = [];
  #kind: string = "";

  constructor(parts: BlobPart[] = [], options?: BlobPropertyBag) {
    super();
    this.#bytes = joined(parts);
    if (options != null) {
      this.#kind = mediaType(options.type ?? "");
    }
  }

  // A blob of `bytes` (not copied) and type `type` as given (std only).
  private static adopt(bytes: u8[], type: string): Blob {
    const b = new Blob();
    b.#bytes = bytes;
    b.#kind = type;
    return b;
  }

  /** The number of bytes. */
  get size(): i64 {
    return this.#bytes.length as i64;
  }

  /** The media type ("" when unknown). */
  get type(): string {
    return this.#kind;
  }

  /**
   * The bytes from `start` to `end` (negative: from the end, as `Array.slice` counts) in a new
   * blob of type `contentType` ("" by default).
   */
  slice(start: i64 = 0, end?: i64, contentType: string = ""): Blob {
    const n = this.#bytes.length as i64;
    const from = clamp(start, n);
    const to = clamp(end ?? n, n);
    return Blob.adopt(this.#bytes.slice(from, to > from ? to : from), mediaType(contentType));
  }

  /** The bytes as text (invalid UTF-8 becomes U+FFFD, as in JS). */
  async text(): Promise<string> {
    return utf8DecodeLossy(this.#bytes);
  }

  // The bytes themselves (std only: not to be changed).
  private held(): u8[] {
    return this.#bytes;
  }

  [WHOLE_BODY](): u8[] | null {
    // A copy: a body's bytes may become an `ArrayBuffer`, whose bytes nothing else may hold.
    return this.#bytes.slice();
  }

  [BODY_TYPE](): string {
    return this.#kind;
  }

  /** How `console.log` shows a blob, like Node: `Blob { size: 5, type: 'text/plain' }`. */
  [INSPECT]() {
    return { size: this.size, type: this.type };
  }
}

/** A `Blob` with a file name and a modification time, as `FormData` holds a file. */
export class File extends Blob {
  #name: string = "";
  #modified: i64 = 0;

  constructor(parts: BlobPart[], name: string, options?: FilePropertyBag) {
    super(parts, { type: options == null ? "" : (options.type ?? "") });
    this.#name = name;
    const at = options == null ? null : options.lastModified;
    this.#modified = at ?? Date.now();
  }

  get name(): string {
    return this.#name;
  }

  get lastModified(): i64 {
    return this.#modified;
  }

  get webkitRelativePath(): string {
    return "";
  }
}

/** The bytes of `parts`, one after another. */
function joined(parts: BlobPart[]): u8[] {
  if (parts.length == 0) {
    return [];
  }
  let out: u8[] = [];
  for (const part of parts) {
    if (typeof part == "string") {
      out = out.concat(utf8Encode(part));
    } else if (part instanceof Blob) {
      out = out.concat(part.held());
    } else if (part instanceof BufferView) {
      const o = part.off as i64;
      out = out.concat(part.buf.bytes.slice(o, o + ((part.len * part[VIEW_SIZE]()) as i64)));
    } else if (part instanceof ArrayBuffer) {
      out = out.concat(part.bytes);
    } else {
      out = out.concat(part);
    }
  }
  return out;
}

/** `t` lowercased, or "" if it has a character outside printable ASCII (the File API's rule). */
function mediaType(t: string): string {
  for (let i: i64 = 0; i < (t.length as i64); i++) {
    const c = t.charCodeAt(i);
    if (c < 32 || c > 126) {
      return "";
    }
  }
  return t.toLowerCase();
}

/** An index of `slice` within `0..n`. */
function clamp(i: i64, n: i64): i64 {
  if (i < 0) {
    return n + i > 0 ? n + i : 0;
  }
  return i < n ? i : n;
}
