/** Whether `buf[s..e]` is a token (a header name: no space, no separator). */
export function token(buf: u8[], s: i64, e: i64): bool {
  for (let i = s; i < e; i++) {
    if ((CLASS[buf[i] as i64] & 1) == 0) {
      return false;
    }
  }
  return true;
}

/** Whether `buf[s..e]` has no control character but tab (a header value, a reason phrase). */
export function plainText(buf: u8[], s: i64, e: i64): bool {
  let all: u8 = 2;
  for (let i = s; i < e; i++) {
    all &= CLASS[buf[i] as i64];
  }
  return all != 0;
}
