// velt/net/http (internal): `fetch`'s plain-TCP connections under the executor in Velt (#2649),
// every native program's: the `std-scheduler` variant of `#fetch-dial` (std/imports.velt; the
// other is dial_rt.velt). An `http:` connection is a non-blocking socket on the executor's
// reactor (std/net/fd_socket.velt), as `connect`'s, so every operation on it is Velt on the
// worker, and its keep-alive pool is Velt too (std/net/fd_pool.velt, behind `TcpStream.park`).
//
// An `https:` connection is such a socket with the TLS client in Velt over it
// (std/net/tls/fd_client.velt, #2392 step 6), kept in the reactor's table of TLS streams, so it
// pools as a plain one does. The client is called by role (`sched_tls_handshake`): a program loads
// it only when live code can dial `https:`. A build whose OS has no reactor
// (std/lang/hooks/reactor_none.velt) has no sockets: a dial fails with `ENOTSUP`.

import { IoError } from "velt/io/error";
import { hookCall, promiseAt, stdUsed } from "velt/lang/intrinsics";
import { errorCodeName } from "velt/native/error";
import { unwrapIo } from "velt/native/result";
import { TcpStream } from "velt/net";
import { TlsOn } from "velt/net/http/fetch/client/target";
import { AbortError, AbortSignal } from "velt/task";
import * as io from "velt/lang/hooks/sched_io";
import * as m from "velt/lang/hooks/sched_mem";
import * as wt from "velt/lang/hooks/sched_io_wait";
import * as fio from "velt/net/fd_io";
import * as fs from "velt/net/fd_socket";
import { readReady } from "velt/net/fd_ready";
import * as tb from "velt/lang/hooks/sched_io_table";
import * as tls from "velt/net/tls/fd_hook";

/** How long connecting may take (milliseconds) before `ETIMEDOUT`, as conn.velt's `CONNECT_MS`. */
const CONNECT_MS: u64 = 10000;

/** Whether the executor's reactor runs (not on an OS without one). */
export function reactorUp(): bool {
  return io.supported();
}

/**
 * A new plain-TCP connection to `addr` on the reactor, within `CONNECT_MS` and before an abort.
 * Losing to either ends the connect itself (its socket is closed): a connect in Velt that lost a
 * race would otherwise run on, keeping a socket nobody closes and the process alive.
 */
export async function dialPlain(
  addr: string,
  signal: AbortSignal | null,
): Promise<TcpStream, IoError | AbortError> {
  return TcpStream.ofHandle(await dialSocket(addr, signal));
}

/**
 * A new TLS connection to `addr` on the reactor (`fetch`'s `https:`): the socket as `dialPlain`'s,
 * then the TLS client's handshake, checking the certificate against the built-in roots and the
 * PEM certificates of `ca` for `serverName`, offering the comma-separated ALPN protocols of
 * `alpn`; both within `CONNECT_MS` and before an abort.
 */
export async function dialTls(
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
  tls: TlsOn,
  signal: AbortSignal | null,
): Promise<TcpStream, IoError | AbortError> {
  const start = wt.now();
  const fd = await dialSocket(addr, signal);
  const spent = ((wt.now() - start) / 1000000) as i64;
  return TcpStream.ofHandle(
    await tls(fd, addr, serverName, ca, alpn, (CONNECT_MS as i64) - spent, signal),
  );
}

/**
 * The TLS client's handshake on connected socket `fd` (the reactor's) to `addr`, as `dialTls`
 * describes, within `left` milliseconds: the TLS stream's handle (`TlsOn`); on a failure the socket is closed.
 */
export async function tlsOn(
  fd: u64,
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
  left: i64,
  signal: AbortSignal | null,
): Promise<u64, IoError | AbortError> {
  const r = await hookCall("sched_tls_handshake", fd, serverName, ca, alpn, left, signal);
  if (r.code === 0) {
    return r.value;
  }
  if (signal != null) {
    signal.throwIfAborted();
  }
  const code = errorCodeName(r.code);
  throw code == "ETIMEDOUT"
    ? new IoError("ETIMEDOUT", `fetch failed: connect timeout to ${addr}`)
    : new IoError(code, `fetch failed: ${r.message}`);
}

// `dialPlain`'s socket handle.
async function dialSocket(
  addr: string,
  signal: AbortSignal | null,
): Promise<u64, IoError | AbortError> {
  if (signal != null) {
    signal.throwIfAborted();
  }
  const deadline = wt.now() + CONNECT_MS * 1000000;
  const cell = m.zeroed(16);
  const connecting = fs.connectUntil(addr, deadline, cell);
  if (signal != null) {
    await Promise.race([connecting.then((_) => {}), signal.whenAborted()]);
    if (signal.aborted) {
      // Given up: the socket connecting now is closed, which ends the connect's wait.
      m.st32(cell + 8, 1);
      const h = m.ld(cell) as u64;
      if (h !== 0) {
        fio.close(h);
      }
      const late = await connecting;
      m.release(cell, 16);
      if (late.code === 0) {
        fio.close(late.value);
      }
      signal.throwIfAborted();
    }
  }
  const r = await connecting;
  m.release(cell, 16);
  if (r.code === fs.TIMED_OUT) {
    throw new IoError("ETIMEDOUT", `fetch failed: connect timeout to ${addr}`);
  }
  try {
    return unwrapIo(r);
  } catch (e) {
    throw e.message.startsWith("fetch failed")
      ? e
      : new IoError(e.code, `fetch failed: ${e.message}`);
  }
}

/**
 * `c.readableWithin(ms)` for an idle connection (an HTTP/2 session without streams): true once a
 * `tryRead` may find something, false when `ms` milliseconds passed first. Its wait does not keep
 * the process alive (sched_io_wait.velt `waitIdle`), as Node's idle sockets are unref'd: a program
 * whose last `fetch` is done ends at once, the session given up with it.
 */
export async function idleReadable(c: TcpStream, ms: i64): Promise<bool> {
  const deadline = wt.now() + (ms as u64) * 1000000;
  const h = c.handle;
  if (!(stdUsed("reactorTls") && tls.isTls(h))) {
    return await idleSocket(h, deadline);
  }
  // A readable socket may hold part of a record: the stream is asked again after each wait, as
  // tcp_sched.velt's `tlsReadableWithin` does.
  while (true) {
    const fd = tls.readyOrFd(h);
    if (fd.code !== 0 || fd.value == 0) {
      return true;
    }
    if (!(await idleSocket(fd.value, deadline))) {
      return false;
    }
  }
}

/**
 * Whether the program is ending and gave the idle waits back (a counted run, sched_io_wait.velt
 * `endIdle`): an idle session closes then rather than wait again.
 */
export function idleEnding(): bool {
  return wt.idleEnded();
}

/** `idleReadable` of socket `h` on the reactor, until `deadline` (`wt.now()`). */
async function idleSocket(h: u64, deadline: u64): Promise<bool> {
  const s = tb.enter(h);
  if (s === 0) {
    return true;
  }
  const has = readReady(s);
  tb.leave(s);
  if (has) {
    return true;
  }
  if (wt.now() >= deadline) {
    return false;
  }
  // SAFETY: `waitIdle` makes a heap future, given up to the promise.
  await unsafe { promiseAt<void>(wt.waitIdle(h, io.K_READ, 0, deadline)) };
  const again = tb.enter(h);
  if (again === 0) {
    return true;
  }
  const now = wt.satisfied(again, io.K_READ, 0);
  tb.leave(again);
  return now;
}
