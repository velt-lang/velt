// velt/net/http (internal): HTTP/1.1 on the wire (RFC 9112): the request head the client
// writes (the response head it reads is in head.vlt).
//
// A request head goes into one byte array with its body when the body is small, so most
// requests leave in one write. The headers `fetch` adds (`host`, `accept`, `user-agent`,
// `accept-encoding`) are written unless the caller set them; the caller's names and values are
// checked as hyper checks them (a token; no control characters but tab). The framing is always
// the client's own, as undici's: `content-length` is written from the body (a caller's must
// agree with it), and a caller's `transfer-encoding` is refused, so a header cannot make the
// server read a different body than the one sent (request smuggling).

import { IoError } from "velt/io/error";
import { Target } from "velt/net/http/fetch/client/target";
import { setBytes, writeUtf8 } from "velt/lang/bytes/copy";

/** A request body this small is sent in the same write as the head. */
const INLINE_BODY: i64 = 65536;

/** A request's head (and small body) as bytes, `data[0..length]`; `body` is still to send. */
export struct Encoded {
  data: u8[];
  length: i64;
  bodyInline: bool;
}

/** Whether `c` may be in a token (a header name, a method; RFC 9110 §5.6.2). */
function isTchar(c: i64): bool {
  if ((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)) {
    return true;
  }
  // ! # $ % & ' * + - . ^ _ ` | ~
  return c == 33 ||
    (c >= 35 && c <= 39) ||
    c == 42 ||
    c == 43 ||
    c == 45 ||
    c == 46 ||
    (c >= 94 && c <= 96) ||
    c == 124 ||
    c == 126;
}

/** Whether `s` may be a header name (a token). */
export function validName(s: string): bool {
  const n = s.length as i64;
  if (n == 0) {
    return false;
  }
  for (let i: i64 = 0; i < n; i++) {
    if (!isTchar(s.charCodeAt(i))) {
      return false;
    }
  }
  return true;
}

/** Whether `s` may be a header value: no control characters but tab. */
export function validValue(s: string): bool {
  const n = s.length as i64;
  for (let i: i64 = 0; i < n; i++) {
    const c = s.charCodeAt(i);
    if ((c < 32 && c != 9) || c == 127) {
      return false;
    }
  }
  return true;
}

/** A request head being written into a growing byte array. */
class Writer {
  data: u8[];
  at: i64 = 0;

  constructor(size: i64) {
    this.data = Buffer.allocUnsafe(size as usize);
  }

  put(s: string) {
    const n = Buffer.byteLength(s) as i64;
    if (this.at + n > (this.data.length as i64)) {
      this.grow(n);
    }
    writeUtf8(this.data, s, this.at as usize);
    this.at += n;
  }

  bytes(b: u8[]) {
    const n = b.length as i64;
    if (this.at + n > (this.data.length as i64)) {
      this.grow(n);
    }
    setBytes(this.data, b, this.at as usize);
    this.at += n;
  }

  private grow(n: i64) {
    let size = (this.data.length as i64) * 2;
    if (size < this.at + n) {
      size = this.at + n;
    }
    const bigger: u8[] = Buffer.allocUnsafe(size as usize);
    setBytes(bigger, this.data, 0);
    this.data = bigger;
  }
}

/** The headers `fetch` adds, found among the caller's. */
const HAS_HOST: i64 = 1;
const HAS_ACCEPT: i64 = 2;
const HAS_AGENT: i64 = 4;
const HAS_CODINGS: i64 = 8;
/** A caller's `content-length`, checked and replaced; or `transfer-encoding`, refused. */
const FRAMING: i64 = 16;

function known(name: string): i64 {
  if (name == "host") {
    return HAS_HOST;
  }
  if (name == "accept") {
    return HAS_ACCEPT;
  }
  if (name == "user-agent") {
    return HAS_AGENT;
  }
  if (name == "accept-encoding") {
    return HAS_CODINGS;
  }
  return name == "content-length" || name == "transfer-encoding" ? FRAMING : 0;
}

/**
 * The head of a request: `method` to `t`, the caller's `headers` (`[name, value, …]`, names
 * lowercase) and the defaults; `body` (or `text`) inline when it is small. `EINVAL` for a
 * header name or value that is not valid HTTP.
 */
export function encode(
  method: string,
  t: Target,
  headers: string[],
  codings: string,
  kind: u32,
  text: string,
  body: u8[],
): Encoded throws IoError {
  const length = kind == 1 ? Buffer.byteLength(text) as i64 : kind == 2 ? body.length as i64 : -1;
  const w = new Writer(256 + (length > 0 && length <= INLINE_BODY ? length : 0));
  w.put(method);
  w.put(" ");
  w.put(t.path);
  w.put(" HTTP/1.1\r\n");
  let has: i64 = 0;
  const n = headers.length as i64;
  for (let i: i64 = 0; i + 1 < n; i += 2) {
    has |= known(headers[i]);
  }
  if ((has & HAS_HOST) == 0) {
    w.put("host: ");
    w.put(t.host);
    w.put("\r\n");
  }
  for (let i: i64 = 0; i + 1 < n; i += 2) {
    const name = headers[i];
    const value = headers[i + 1];
    if ((has & FRAMING) != 0 && known(name) == FRAMING) {
      framing(name, value, length);
      continue;
    }
    if (!validName(name)) {
      throw new IoError("EINVAL", `invalid header name "${name}"`);
    }
    if (!validValue(value)) {
      throw new IoError("EINVAL", `invalid value of header ${name}`);
    }
    w.put(name);
    w.put(": ");
    w.put(value);
    w.put("\r\n");
  }
  if ((has & HAS_ACCEPT) == 0) {
    w.put("accept: */*\r\n");
  }
  if ((has & HAS_AGENT) == 0) {
    w.put("user-agent: velt\r\n");
  }
  if ((has & HAS_CODINGS) == 0) {
    w.put("accept-encoding: ");
    w.put(codings);
    w.put("\r\n");
  }
  if (length >= 0) {
    w.put(`content-length: ${length}\r\n`);
  } else if (method == "POST" || method == "PUT" || method == "PATCH") {
    w.put("content-length: 0\r\n");
  }
  w.put("\r\n");
  const inline = length > 0 && length <= INLINE_BODY;
  if (inline) {
    if (kind == 1) {
      w.put(text);
    } else {
      w.bytes(body);
    }
  }
  return { data: w.data, length: w.at, bodyInline: inline || length <= 0 };
}

/**
 * A caller's `content-length` or `transfer-encoding`, for a body of `length` bytes (-1: none):
 * `EINVAL` (with undici's words) for any `transfer-encoding`, and for a `content-length` that is
 * not the body's length; a `content-length` without a body is dropped, as undici does.
 */
function framing(name: string, value: string, length: i64) throws IoError {
  if (name == "transfer-encoding") {
    throw new IoError("EINVAL", "fetch failed: invalid transfer-encoding header");
  }
  if (length >= 0 && value.trim() != `${length}`) {
    throw new IoError(
      "EINVAL",
      "fetch failed: Request body length does not match content-length header",
    );
  }
}
