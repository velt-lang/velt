// velt/net/http (internal): the proxy a `fetch` goes through (#3693). The request's `proxy`
// option, when it has one, decides: a proxy URL, or "" for none. Otherwise the environment's
// proxy is used, always, read as Bun reads it (`fromEnv`), as it is at each request and redirect
// hop: read again after `setEnv` or `removeEnv` changed the environment, else kept (a program
// that never fetches reads none of the variables):
// - `http_proxy`, else `HTTP_PROXY`, for `http:`; `https_proxy`, else `HTTPS_PROXY`, for `https:`
//   (never the `http:` one). The lowercase one is taken when it is set and not empty, else the
//   uppercase one (CI environments often set `http_proxy=""`). A value that is empty, `""` or
//   `''` (a shell's empty quotes) is no proxy, and then `all_proxy`, else `ALL_PROXY`, is read.
// - A value is `http://…`, `https://…` (TLS to the proxy) or `host:port`. One that names another
//   kind of proxy (`socks5://`) is ignored, as no proxy: this client does not speak it (Bun
//   ignores it in `ALL_PROXY` and fails a request through one in the scheme's variable).
// - `no_proxy`, else `NO_PROXY` (each read only when not empty), lists the hosts reached directly
//   (no_proxy.velt: domains with their subdomains, IP addresses, CIDR blocks, ports). This
//   machine is not special (`localhost` goes to the proxy too).
// Opting out is `NO_PROXY=*` or `proxy: ""`. Node 22.21+ reads the environment's proxy only with
// `NODE_USE_ENV_PROXY=1` (Velt never reads that variable), once when it starts, and otherwise as
// undici's `EnvHttpProxyAgent`: no `ALL_PROXY`, a set lowercase variable wins even when empty,
// `https:` through the `http:` proxy when no `https:` one is set, and a `NO_PROXY` entry names
// that host alone (`.example.com` only its subdomains), without IP blocks.
//
// A proxy is `http[s]://[user:password@]host[:port][/]` (port 80, or 443 for `https://`); its
// user and password, when it has both, become `proxy-authorization: Basic …` (with only one of
// them, none, as in undici). Every request goes through a `CONNECT` tunnel to the origin's host
// and port (tunnel.velt), `http:` too, as undici does; to an `https://` proxy over TLS, its
// certificate checked as an origin's (built-in roots and the request's `ca`). For `https:` TLS to
// the origin runs inside the tunnel, as without a proxy. The `proxy` option rejects any other
// proxy with `EINVAL`, as it does a proxy URL with a path, query or fragment (in a variable too).

import { IoError } from "velt/io/error";
import { base64Encode, utf8Encode } from "velt/encoding";
import { URL } from "velt/net/url";
import { decodeLenient } from "velt/net/url/encode";
import { getEnv } from "#env-sys";
import { envChanges } from "velt/process/env_changes";
import { noProxy } from "velt/net/http/fetch/client/no_proxy";

/** A proxy to send requests through. */
export class Via {
  /** `host:port` to connect to (IPv6 in brackets). */
  addr: string;
  /** The `proxy-authorization` header's value; "" for none. */
  authorization: string;
  /** Whether it is an `https://` proxy, spoken to over TLS. */
  tls: bool;
  /** Its host as its certificate names it (an IPv6 address without brackets). */
  host: string;

  constructor(addr: string, authorization: string, tls: bool, host: string) {
    this.addr = addr;
    this.authorization = authorization;
    this.tls = tls;
    this.host = host;
  }
}

/**
 * The proxy of a request to `hostname` (as the URL parser serializes it: IPv6 in brackets) on
 * `port`: the request's `given` one ("" for none), or when it is null the environment's. Throws
 * `EINVAL` for a proxy URL this client cannot use (another scheme, a path), naming where it came
 * from, never its value (which may hold a password); a variable naming another kind of proxy is
 * ignored instead (module comment).
 */
export function proxyFor(
  https: bool,
  hostname: string,
  port: i64,
  given: string | null,
): Via | null throws IoError {
  if (given != null) {
    return given.length == 0 ? null : parseProxy(given, "the proxy option");
  }
  return fromEnv(https, hostname, port);
}

/**
 * The environment's proxy for a request to `hostname` on `port`, its variables as they are now
 * (module comment).
 */
export function fromEnv(https: bool, hostname: string, port: i64): Via | null throws IoError {
  const vars = envProxy();
  const value = https ? vars.https : vars.http;
  if (value == null) {
    return null;
  }
  const list = vars.list;
  if (list != null && noProxy(list, hostname, port)) {
    return null;
  }
  return parseProxy(value, `$${https ? vars.httpsName : vars.httpName}`);
}

/** What the proxy variables say, as the environment's `changes`-th version has them. */
class EnvProxy {
  changes: u64;
  /** The proxy of `http:` requests, and the variable it is from; null for none. */
  http: string | null;
  httpName: string;
  /** The proxy of `https:` requests, and the variable it is from; null for none. */
  https: string | null;
  httpsName: string;
  /** `no_proxy`, else `NO_PROXY`; null when neither is set. */
  list: string | null;

  constructor(changes: u64) {
    this.changes = changes;
    this.http = null;
    this.httpName = "";
    this.https = null;
    this.httpsName = "";
    this.list = null;
  }
}

/** What the proxy variables said when last read. */
let known: EnvProxy | null = null;

/**
 * What the proxy variables say now: read again only after `setEnv` or `removeEnv` changed the
 * environment (std/process/env_changes.velt), so a request reads none of them otherwise.
 */
function envProxy(): EnvProxy {
  const changes = envChanges();
  const last = known;
  if (last != null && last.changes == changes) {
    return last;
  }
  const vars = new EnvProxy(changes);
  const allName = lowerThenUpper("all_proxy", "ALL_PROXY");
  const all = proxyIn(allName);
  vars.httpName = lowerThenUpper("http_proxy", "HTTP_PROXY");
  vars.http = proxyIn(vars.httpName);
  if (vars.http == null && all != null) {
    vars.http = all;
    vars.httpName = allName;
  }
  vars.httpsName = lowerThenUpper("https_proxy", "HTTPS_PROXY");
  vars.https = proxyIn(vars.httpsName);
  if (vars.https == null && all != null) {
    vars.https = all;
    vars.httpsName = allName;
  }
  vars.list = emptyish(getEnv("no_proxy")) ?? emptyish(getEnv("NO_PROXY"));
  known = vars;
  return vars;
}

/** As Bun's `get_lower_then_upper`: `lower` when it is set and not empty, else `upper`. */
function lowerThenUpper(lower: string, upper: string): string {
  const value = getEnv(lower);
  return value != null && value.length > 0 ? lower : upper;
}

/** The proxy variable `name` names: null when it is no proxy or one ignored (module comment). */
function proxyIn(name: string): string | null {
  const value = emptyish(getEnv(name));
  if (value == null) {
    return null;
  }
  const text = value.trim();
  const sep = text.indexOf("://");
  if (sep < 0) {
    return value;
  }
  const scheme = text.slice(0, sep).toLowerCase();
  return scheme == "http" || scheme == "https" ? value : null;
}

/** `value`, or null when it is unset, empty, `""` or `''` (as Bun's `is_emptyish`). */
function emptyish(value: string | undefined): string | null {
  if (value == null || value.length == 0 || value == `""` || value == "''") {
    return null;
  }
  return value;
}

/** The proxy `value` names; `what` says where it came from in an error. */
export function parseProxy(value: string, what: string): Via throws IoError {
  let text = value.trim();
  const sep = text.indexOf("://");
  let tls = false;
  if (sep < 0) {
    text = `http://${text}`;
  } else {
    const scheme = text.slice(0, sep).toLowerCase();
    if (scheme != "http" && scheme != "https") {
      throw invalid(
        what,
        `\`${scheme}://\` proxies are not supported (only \`http://\` and \`https://\`)`,
      );
    }
    tls = scheme == "https";
  }
  const u = URL.parse(text);
  if (u == null || u.hostname.length == 0) {
    throw invalid(what, "not a URL with a host");
  }
  // undici's `parseOrigin`: only an origin, with or without a `/`.
  if (u.pathname != "/" || u.search.length > 0 || u.hash.length > 0) {
    throw invalid(what, "a path, query or fragment after the host");
  }
  // The URL parser leaves out a scheme's default port.
  const port = u.port.length > 0 ? u.port : tls ? "443" : "80";
  let authorization = "";
  // As undici's `ProxyAgent`: only with both a user and a password.
  if (u.username.length > 0 && u.password.length > 0) {
    const plain = `${decodeLenient(u.username, false)}:${decodeLenient(u.password, false)}`;
    for (let i: i64 = 0; i < (plain.length as i64); i++) {
      const c = plain.charCodeAt(i);
      if (c < 32 || c == 127) {
        throw invalid(what, "a control character in the user or password");
      }
    }
    authorization = `Basic ${base64Encode(utf8Encode(plain))}`;
  }
  const host =
    u.hostname.startsWith("[") ? u.hostname.slice(1, (u.hostname.length as i64) - 1) : u.hostname;
  return new Via(`${u.hostname}:${port}`, authorization, tls, host);
}

function invalid(what: string, why: string): IoError {
  return new IoError("EINVAL", `fetch failed: invalid proxy in ${what}: ${why}`);
}
