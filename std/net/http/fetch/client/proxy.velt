// velt/net/http (internal): the proxy a `fetch` goes through (#3693). The request's `proxy`
// option, when it has one, decides: a proxy URL, or "" for none. Otherwise, as in Node 22.21+,
// the environment's proxy is used only when `NODE_USE_ENV_PROXY=1` (read once, at the first
// request: `envProxyOn`), and then as undici's `EnvHttpProxyAgent` reads it (`fromEnv`):
// `http_proxy`, else `HTTP_PROXY`, for `http:`; `https_proxy`, else `HTTPS_PROXY`, for `https:`,
// and the `http:` one when neither is set. A lowercase variable that is set wins even when it is
// empty, and an empty value means no proxy. `no_proxy`, else `NO_PROXY`, lists the hosts reached
// directly (`noProxy`); this machine is not special (Node sends `localhost` to the proxy too).
//
// A proxy is `http://[user:password@]host[:port]` (port 80 by default); its user and password
// become `proxy-authorization: Basic …`. Every request goes through a `CONNECT` tunnel to the
// origin's host and port (tunnel.velt), `http:` too, as undici does; for `https:` TLS to the
// origin runs inside it, as without a proxy. Where Node differs: it starts no program whose
// proxy variable is not a URL (Velt also takes `host:port`, and rejects a `fetch` through any
// other proxy with `EINVAL`), and it speaks TLS to an `https://` proxy, which Velt refuses.
// The proxy variables and `NO_PROXY` are read for each request.

import { IoError } from "velt/io/error";
import { base64Encode, utf8Encode } from "velt/encoding";
import { URL } from "velt/net/url";
import { decodeLenient } from "velt/net/url/encode";
import { getEnv } from "#env-sys";

/** A proxy to send requests through. */
export class Via {
  /** `host:port` to connect to (IPv6 in brackets). */
  addr: string;
  /** The `proxy-authorization` header's value; "" for none. */
  authorization: string;

  constructor(addr: string, authorization: string) {
    this.addr = addr;
    this.authorization = authorization;
  }
}

/**
 * Whether `NODE_USE_ENV_PROXY` is `1`: -1 before the first request reads it, then 0 or 1. Starts
 * at a literal: an atomic started at a constant's name is built anew at every use.
 */
const ENV_PROXY = new Atomic<i32>(-1);

/** Whether the environment's proxy is used (`NODE_USE_ENV_PROXY=1`, read once per process). */
function envProxyOn(): bool {
  let on = ENV_PROXY.load("relaxed");
  if (on < 0) {
    on = getEnv("NODE_USE_ENV_PROXY") == "1" ? 1 : 0;
    ENV_PROXY.store(on, "relaxed");
  }
  return on == 1;
}

/**
 * The proxy of a request to `hostname` (as the URL parser serializes it: IPv6 in brackets) on
 * `port`: the request's `given` one ("" for none), or when it is null the environment's, if
 * `NODE_USE_ENV_PROXY=1`. Throws `EINVAL` for a proxy URL that is not `http:`, naming where it
 * came from, never its value (which may hold a password).
 */
export function proxyFor(
  https: bool,
  hostname: string,
  port: i64,
  given: string | null,
): Via | null throws IoError {
  if (given != null) {
    return given.length == 0 ? null : parseProxy(given, "the proxy option");
  }
  return envProxyOn() ? fromEnv(https, hostname, port) : null;
}

/** The environment's proxy for a request to `hostname` on `port`, as `EnvHttpProxyAgent`'s. */
export function fromEnv(https: bool, hostname: string, port: i64): Via | null throws IoError {
  let name = "http_proxy";
  let value = getEnv(name);
  if (value == null) {
    name = "HTTP_PROXY";
    value = getEnv(name);
  }
  if (https) {
    let secureName = "https_proxy";
    let secure = getEnv(secureName);
    if (secure == null) {
      secureName = "HTTPS_PROXY";
      secure = getEnv(secureName);
    }
    if (secure != null && secure.length > 0) {
      name = secureName;
      value = secure;
    }
  }
  if (value == null || value.length == 0) {
    return null;
  }
  let list = getEnv("no_proxy");
  if (list == null) {
    list = getEnv("NO_PROXY");
  }
  if (list != null && noProxy(list, hostname, port)) {
    return null;
  }
  return parseProxy(value, `$${name}`);
}

/** The proxy `value` names; `what` says where it came from in an error. */
export function parseProxy(value: string, what: string): Via throws IoError {
  let text = value.trim();
  const sep = text.indexOf("://");
  if (sep < 0) {
    text = `http://${text}`;
  } else {
    const scheme = text.slice(0, sep).toLowerCase();
    if (scheme != "http") {
      throw invalid(what, `\`${scheme}://\` proxies are not supported (only \`http://\`)`);
    }
  }
  const u = URL.parse(text);
  if (u == null || u.hostname.length == 0) {
    throw invalid(what, "not a URL with a host");
  }
  const port = u.port.length > 0 ? u.port : "80";
  let authorization = "";
  if (u.username.length > 0 || u.password.length > 0) {
    const plain = `${decodeLenient(u.username, false)}:${decodeLenient(u.password, false)}`;
    for (let i: i64 = 0; i < (plain.length as i64); i++) {
      const c = plain.charCodeAt(i);
      if (c < 32 || c == 127) {
        throw invalid(what, "a control character in the user or password");
      }
    }
    authorization = `Basic ${base64Encode(utf8Encode(plain))}`;
  }
  return new Via(`${u.hostname}:${port}`, authorization);
}

function invalid(what: string, why: string): IoError {
  return new IoError("EINVAL", `fetch failed: invalid proxy in ${what}: ${why}`);
}

/**
 * Whether `list` names `hostname` on `port`, as `EnvHttpProxyAgent` reads it: entries separated
 * by commas and white space, each `host` or `host:port` (a port only covers that port), compared
 * without case. A host that starts with `.` or `*` names every host ending in it (after the `*`):
 * `.example.com` and `*.example.com` its subdomains, `*` everything; any other is that host
 * alone. IPv6 addresses are written in brackets, as in URLs (`[::1]`, `[::1]:8080`).
 */
export function noProxy(list: string, hostname: string, port: i64): bool {
  const host = hostname.toLowerCase();
  const n = list.length as i64;
  let start: i64 = 0;
  for (let i: i64 = 0; i <= n; i++) {
    if (i < n && !separator(list.charCodeAt(i))) {
      continue;
    }
    if (i > start && listed(list.slice(start, i).toLowerCase(), host, port)) {
      return true;
    }
    start = i + 1;
  }
  return false;
}

/** Whether `entry` (lowercase) of a `NO_PROXY` list names `host` (lowercase) on `port`. */
function listed(entry: string, host: string, port: i64): bool {
  let name = entry;
  // `host:port`, as undici's `/^(.+):(\d+)$/` reads it: the last colon, only digits after it.
  const colon = entry.lastIndexOf(":");
  if (colon > 0 && colon + 1 < (entry.length as i64)) {
    const want = digits(entry.slice(colon + 1));
    if (want >= 0) {
      // A port of 0 (`host:0`) is no port, as in undici.
      if (want != 0 && want != port) {
        return false;
      }
      name = entry.slice(0, colon);
    }
  }
  if (name.startsWith(".") || name.startsWith("*")) {
    return host.endsWith(name.startsWith("*") ? name.slice(1) : name);
  }
  return host == name;
}

/** A separator of `NO_PROXY` entries: a comma, or white space as a regex's `\s` is. */
function separator(c: i64): bool {
  return (
    c == 44 ||
    c == 32 ||
    (c >= 9 && c <= 13) ||
    c == 0xa0 ||
    c == 0x1680 ||
    (c >= 0x2000 && c <= 0x200a) ||
    c == 0x2028 ||
    c == 0x2029 ||
    c == 0x202f ||
    c == 0x205f ||
    c == 0x3000 ||
    c == 0xfeff
  );
}

/**
 * The decimal number `s` (digits only), or -1. It stops growing past nine digits, still no port
 * (as undici's `parseInt` of a long one).
 */
function digits(s: string): i64 {
  if (s.length == 0) {
    return -1;
  }
  let n: i64 = 0;
  for (let i: i64 = 0; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i) - 48;
    if (c < 0 || c > 9) {
      return -1;
    }
    if (n < 1000000000) {
      n = n * 10 + c;
    }
  }
  return n;
}
