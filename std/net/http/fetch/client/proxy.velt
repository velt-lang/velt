// velt/net/http (internal): the proxy a `fetch` goes through (#3693). The request's `proxy`
// option, when it has one, decides: a proxy URL, or "" for none. Otherwise the environment's
// proxy is used, always, read as Bun reads it (`fromEnv`), at every request and redirect hop (a
// program that never fetches reads none of the variables):
// - `http_proxy`, else `HTTP_PROXY`, for `http:`; `https_proxy`, else `HTTPS_PROXY`, for `https:`
//   (never the `http:` one); `all_proxy`, else `ALL_PROXY`, for both when the scheme's is unset.
//   A lowercase variable that is empty counts as unset, so the uppercase one is read (CI
//   environments often set `http_proxy=""`), and so do `""` and `''` (a shell's empty quotes).
// - A value is `http://…` or `host:port`; one that names another kind of proxy (`https://`,
//   `socks5://`) is ignored: this client speaks to neither (Bun speaks TLS to an `https://` one).
// - `no_proxy`, else `NO_PROXY` (empty counts as unset), lists the hosts reached directly
//   (no_proxy.velt: domains with their subdomains, IP addresses, CIDR blocks, ports). This
//   machine is not special (`localhost` goes to the proxy too).
// Opting out is `NO_PROXY=*` or `proxy: ""`. Node 22.21+ reads the environment's proxy only with
// `NODE_USE_ENV_PROXY=1` (Velt never reads that variable), once when it starts, and otherwise as
// undici's `EnvHttpProxyAgent`: no `ALL_PROXY`, a set lowercase variable wins even when empty,
// `https:` through the `http:` proxy when no `https:` one is set, and a `NO_PROXY` entry names
// that host alone (`.example.com` only its subdomains), without IP blocks.
//
// A proxy is `http://[user:password@]host[:port][/]` (port 80 by default); its user and password,
// when it has both, become `proxy-authorization: Basic …` (with only one of them, none, as in
// undici). Every request goes through a `CONNECT` tunnel to the
// origin's host and port (tunnel.velt), `http:` too, as undici does; for `https:` TLS to the
// origin runs inside it, as without a proxy. The `proxy` option rejects any other proxy with
// `EINVAL`, as it does a proxy URL with a path, query or fragment (in a variable too).

import { IoError } from "velt/io/error";
import { base64Encode, utf8Encode } from "velt/encoding";
import { URL } from "velt/net/url";
import { decodeLenient } from "velt/net/url/encode";
import { getEnv } from "#env-sys";
import { noProxy } from "velt/net/http/fetch/client/no_proxy";

/** A proxy to send requests through. */
export class Via {
  /** `host:port` to connect to (IPv6 in brackets). */
  addr: string;
  /** The `proxy-authorization` header's value; "" for none. */
  authorization: string;

  constructor(addr: string, authorization: string) {
    this.addr = addr;
    this.authorization = authorization;
  }
}

/**
 * The proxy of a request to `hostname` (as the URL parser serializes it: IPv6 in brackets) on
 * `port`: the request's `given` one ("" for none), or when it is null the environment's. Throws
 * `EINVAL` for a proxy URL that is not `http:`, naming where it came from, never its value
 * (which may hold a password).
 */
export function proxyFor(
  https: bool,
  hostname: string,
  port: i64,
  given: string | null,
): Via | null throws IoError {
  if (given != null) {
    return given.length == 0 ? null : parseProxy(given, "the proxy option");
  }
  return fromEnv(https, hostname, port);
}

/**
 * The environment's proxy for a request to `hostname` on `port`, its variables read now (module
 * comment).
 */
export function fromEnv(https: bool, hostname: string, port: i64): Via | null throws IoError {
  let name = https ? "https_proxy" : "http_proxy";
  let value = usable(variable(name));
  if (value == null) {
    name = https ? "HTTPS_PROXY" : "HTTP_PROXY";
    value = usable(variable(name));
  }
  if (value == null) {
    name = "all_proxy";
    value = usable(variable(name));
  }
  if (value == null) {
    name = "ALL_PROXY";
    value = usable(variable(name));
  }
  if (value == null) {
    return null;
  }
  let list = variable("no_proxy");
  if (list == null) {
    list = variable("NO_PROXY");
  }
  if (list != null && noProxy(list, hostname, port)) {
    return null;
  }
  return parseProxy(value, `$${name}`);
}

/** Variable `name`, or null when it is unset, empty, `""` or `''` (as Bun's `is_emptyish`). */
function variable(name: string): string | null {
  const value = getEnv(name);
  if (value == null || value.length == 0 || value == `""` || value == "''") {
    return null;
  }
  return value;
}

/** `value` when it names an `http:` proxy (or has no scheme), else null (module comment). */
function usable(value: string | null): string | null {
  if (value == null) {
    return null;
  }
  const text = value.trim();
  const sep = text.indexOf("://");
  return sep < 0 || text.slice(0, sep).toLowerCase() == "http" ? value : null;
}

/** The proxy `value` names; `what` says where it came from in an error. */
export function parseProxy(value: string, what: string): Via throws IoError {
  let text = value.trim();
  const sep = text.indexOf("://");
  if (sep < 0) {
    text = `http://${text}`;
  } else {
    const scheme = text.slice(0, sep).toLowerCase();
    if (scheme != "http") {
      throw invalid(what, `\`${scheme}://\` proxies are not supported (only \`http://\`)`);
    }
  }
  const u = URL.parse(text);
  if (u == null || u.hostname.length == 0) {
    throw invalid(what, "not a URL with a host");
  }
  // undici's `parseOrigin`: only an origin, with or without a `/`.
  if (u.pathname != "/" || u.search.length > 0 || u.hash.length > 0) {
    throw invalid(what, "a path, query or fragment after the host");
  }
  const port = u.port.length > 0 ? u.port : "80";
  let authorization = "";
  // As undici's `ProxyAgent`: only with both a user and a password.
  if (u.username.length > 0 && u.password.length > 0) {
    const plain = `${decodeLenient(u.username, false)}:${decodeLenient(u.password, false)}`;
    for (let i: i64 = 0; i < (plain.length as i64); i++) {
      const c = plain.charCodeAt(i);
      if (c < 32 || c == 127) {
        throw invalid(what, "a control character in the user or password");
      }
    }
    authorization = `Basic ${base64Encode(utf8Encode(plain))}`;
  }
  return new Via(`${u.hostname}:${port}`, authorization);
}

function invalid(what: string, why: string): IoError {
  return new IoError("EINVAL", `fetch failed: invalid proxy in ${what}: ${why}`);
}
