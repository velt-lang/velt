// velt/net/http (internal): the host functions `fetch` calls on JS hosts: the import module
// `velt:fetch`, which the JS glue provides over the host's own `fetch`
// (crates/velt_rt_wasm/js/velt_web.mjs, `fetchHost`).
//
// A call is one JS object (a `HostRef`): the request's `AbortController`, then its `Response`,
// the reader of its body and the piece of it last read. The async ones fulfill with nothing (what
// they got is taken by a synchronous call), so a wait on any of them races the request's signal
// the same way (js_fetched.vlt `settled`). A rejection is an `IoError` whose code is what native
// `fetch` throws for the same failure (`ECONNREFUSED`, `ECONNRESET`, `EINVAL`, `UNKNOWN`, …),
// and `AbortError` once the call was aborted.

import { HostRef } from "velt/host/host_ref";
// The hooks lowering awaits an async host function's promise with (a program's module loads
// them through std/prelude/global/host_async.vlt; std modules import what they use).
import "velt/host/promise";

/** A new call, with its `AbortController`. */
export declare host("velt:fetch") function requestStart(): HostRef;

/**
 * Sends the request with the host's `fetch` (headers `name\nvalue\n…`, `redirect` "follow",
 * "error" or "manual"; the body as `fetch` has it: none (0), `text` (1) or `body` (2)) and
 * fulfills once the response's head arrived.
 */
export declare host("velt:fetch") async function requestSend(
  call: HostRef,
  method: string,
  url: string,
  headers: string,
  redirect: string,
  kind: u32,
  text: string,
  body: readonly u8[],
): Promise<void>;

/** Aborts the call: its `fetch` and a body read reject with `AbortError`. */
export declare host("velt:fetch") function requestAbort(call: HostRef): void;

/** The response's status. */
export declare host("velt:fetch") function responseStatus(call: HostRef): u32;

/** The response's status text, as the host has it ("" over HTTP/2). */
export declare host("velt:fetch") function responseStatusText(call: HostRef): string;

/** The response's URL, after redirects. */
export declare host("velt:fetch") function responseUrl(call: HostRef): string;

/** Whether the host followed a redirect to get the response. */
export declare host("velt:fetch") function responseRedirected(call: HostRef): bool;

/** The response's headers, `name\nvalue\n…` ("" for none), names lowercase. */
export declare host("velt:fetch") function responseHeaders(call: HostRef): string;

/** Reads the next piece of the body (never empty; empty at its end), or (`all`) the rest. */
export declare host("velt:fetch") async function bodyRead(call: HostRef, all: bool): Promise<void>;

/** What the last `bodyRead` got. */
export declare host("velt:fetch") function bodyTake(call: HostRef): u8[];

/** Stops receiving a body nobody will read (the host closes or frees its connection). */
export declare host("velt:fetch") function bodyCancel(call: HostRef): void;
