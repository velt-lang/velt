// velt/net/http (internal): a response the host's `fetch` received on a JS host (`Fetched` of
// `#http-transport` under `js`, js.vlt): the status, URL and `redirected` read at once, the
// status text and headers when asked, and the body received from the host piece by piece as it
// is read (one host call per piece). The host decodes a compressed body itself.
//
// While the program waits on the host for a request with a signal, a task aborts the host's call
// when the signal aborts (`settled`), and the wait throws the signal's `AbortError`. Nothing
// waits on the signal in between, so a response nobody reads keeps no task alive.

import { IoError } from "velt/io/error";
import { AbortController, AbortError, AbortSignal } from "velt/task";
import { HostRef } from "velt/host/host_ref";
import { statusText } from "velt/net/http/fetch/status";
import {
  bodyCancel,
  bodyRead,
  bodyTake,
  requestAbort,
  responseHeaders,
  responseRedirected,
  responseStatusText,
  responseUrl,
} from "velt/net/http/fetch/client/transport/js_host";

/**
 * Waits for `op`, a host call on `call`. While it waits, a task aborts the call when `signal`
 * aborts (the host's promise then rejects), and the wait throws the signal's `AbortError`; the
 * task ends with the wait.
 */
export async function settled(
  op: Promise<void, IoError>,
  call: HostRef,
  signal: AbortSignal | null,
): Promise<void, IoError | AbortError> {
  if (signal == null) {
    await op;
    return;
  }
  const stop = new AbortController();
  spawn(watch(signal, stop.signal, call.clone()));
  try {
    await op;
  } catch (e) {
    stop.abort();
    // A rejection the abort caused is the abort.
    signal.throwIfAborted();
    throw e;
  }
  stop.abort();
}

/**
 * Aborts the host's `call` once `signal` aborts, unless `stop` aborts first. Both are the
 * runtime's waits, so the one that loses is dropped and nothing stays pending. (`op` itself is
 * not raced: the wasm executor loses track of a task when a started promise loses a race inside
 * a stream's pull, #2040.)
 */
async function watch(signal: AbortSignal, stop: AbortSignal, call: HostRef): Promise<void> {
  await Promise.race([signal.whenAborted(), stop.whenAborted()]);
  if (signal.aborted && !stop.aborted) {
    requestAbort(call);
  }
}

/** Whether JS hosts decode content coding `c` (lowercase). */
function hostDecodes(c: string): bool {
  return c == "gzip" || c == "x-gzip" || c == "deflate" || c == "br" || c == "zstd";
}

/** A response `fetch` received from the host. */
export class Fetched {
  status: i64;
  url: string;
  redirected: bool;
  /** The host's call, which holds the response and the reader of its body. */
  private call: HostRef;
  /** The request's signal, which aborts a wait for the body. */
  private signal: AbortSignal | null;
  private used: bool = false;
  /** The body ended, failed or was given up: the call needs nothing more. */
  private done: bool = false;

  private constructor(call: HostRef, status: i64, signal: AbortSignal | null) {
    this.status = status;
    this.url = responseUrl(call);
    this.redirected = responseRedirected(call);
    this.call = call;
    this.signal = signal;
  }

  /** The server's reason phrase, else the standard one for the status. */
  statusText(): string {
    const given = responseStatusText(this.call);
    return given != "" ? given : statusText(this.status as number);
  }

  /** The headers, `[name, value, …]`, names lowercase. */
  headers(): string[] {
    const flat = responseHeaders(this.call);
    return flat == "" ? [] : flat.split("\n");
  }

  /**
   * Whether the body arrives decoded: the host undoes a `content-encoding` of codings it knows
   * (gzip, deflate, br, zstd) and hands over any other body as it was sent.
   */
  decoded(): bool {
    const h = this.headers();
    let any = false;
    for (let i: i64 = 0; i + 1 < (h.length as i64); i += 2) {
      if (h[i] != "content-encoding") {
        continue;
      }
      for (const part of h[i + 1].split(",")) {
        const coding = part.trim().toLowerCase();
        if (coding == "" || coding == "identity") {
          continue;
        }
        if (!hostDecodes(coding)) {
          return false;
        }
        any = true;
      }
    }
    return any;
  }

  /** Throws once a body has been read: each response's body is received once. */
  private claim() throws IoError {
    if (this.used) {
      throw new IoError("EINVAL", "Body is unusable: Body has already been read");
    }
    this.used = true;
  }

  /** The whole body. */
  async bytes(): Promise<u8[], IoError | AbortError> {
    this.claim();
    return await this.receive(true);
  }

  /** The whole body as text: UTF-8, invalid bytes as U+FFFD, a byte order mark dropped. */
  async text(): Promise<string, IoError | AbortError> {
    const b = await this.bytes();
    const bom = b.length >= 3 && b[0] == 239 && b[1] == 187 && b[2] == 191;
    return b.utf8Slice(bom ? 3 : 0, b.length as i64);
  }

  /** The next piece of the body as the host received it; `[]` once it is complete. */
  async chunk(): Promise<u8[], IoError | AbortError> {
    if (!this.used) {
      this.claim();
    }
    return await this.receive(false);
  }

  /** The next piece of the body, or (`all`) the rest of it. */
  private async receive(all: bool): Promise<u8[], IoError | AbortError> {
    if (this.done) {
      return [];
    }
    try {
      await settled(bodyRead(this.call, all), this.call, this.signal);
    } catch (e) {
      this.done = true;
      throw e;
    }
    const piece = bodyTake(this.call);
    if (all || piece.length == 0) {
      this.done = true;
    }
    return piece;
  }

  /** Releases the response: a body nobody finished reading is cancelled. */
  close() {
    if (!this.done) {
      this.done = true;
      bodyCancel(this.call);
    }
  }
}
