// velt/net/http (internal): the messages between `fetch` and an HTTP/2 client session's task:
// requests and controls going to the session (`H2Call`), the response's head, body pieces and
// end coming back to the request (`H2Event`), one channel each way.

import { Channel } from "velt/sync";

// `H2Call.kind`.
/// A request: open a stream.
export const CALL_REQUEST: i64 = 0;
/// `n` bytes of stream `id`'s body were read: its window may be given back.
export const CALL_CREDIT: i64 = 1;
/// The request does not want the rest of stream `id` (aborted, or its body abandoned).
export const CALL_CANCEL: i64 = 2;

/// A message to a session.
export struct H2Call {
  kind: i64;
  /// The stream (credit and cancel).
  id: i64;
  n: i64;
  method: string;
  scheme: string;
  authority: string;
  path: string;
  /// The fields after the pseudo-headers: lowercase name, value, ...
  fields: string[];
  body: u8[];
  /// Where the response goes.
  events: Channel<H2Event>;
}

// `H2Event.kind`.
/// The response's head: `status`, `fields`, and `id` the stream; `ended` when it has no body.
export const EVENT_HEAD: i64 = 0;
/// A piece of the body.
export const EVENT_DATA: i64 = 1;
/// The body is complete.
export const EVENT_END: i64 = 2;
/// The request failed (`message`); `retry` when the server did not process it (a GOAWAY's
/// streams above its last one, REFUSED_STREAM, a session that closed before sending it).
export const EVENT_ERROR: i64 = 3;

/// A message to a request.
export struct H2Event {
  kind: i64;
  id: i64;
  status: i64;
  fields: string[];
  ended: bool;
  data: u8[];
  message: string;
  retry: bool;
}

/// An error event.
export function errorEvent(message: string, retry: bool): H2Event {
  return {
    kind: EVENT_ERROR,
    id: 0,
    status: 0,
    fields: [],
    ended: true,
    data: [],
    message: message,
    retry: retry,
  };
}
