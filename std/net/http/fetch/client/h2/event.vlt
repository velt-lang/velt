// velt/net/http (internal): what an HTTP/2 client session's task sends back to a request
// (`H2Event`): the response's head, its body pieces, its end, or an error.

// `H2Event.kind`.
/// The response's head: `status`, `fields`, and `id` the stream; `ended` when it has no body.
export const EVENT_HEAD: i64 = 0;
/// A piece of the body.
export const EVENT_DATA: i64 = 1;
/// The body is complete.
export const EVENT_END: i64 = 2;
/// The request failed (`message`); `retry` when the server did not process it (a GOAWAY's
/// streams above its last one, REFUSED_STREAM, a session that closed before sending it).
export const EVENT_ERROR: i64 = 3;

/// A message to a request.
export struct H2Event {
  kind: i64;
  id: i64;
  status: i64;
  fields: string[];
  ended: bool;
  data: u8[];
  message: string;
  retry: bool;
}

/// An error event.
export function errorEvent(message: string, retry: bool): H2Event {
  return {
    kind: EVENT_ERROR,
    id: 0,
    status: 0,
    fields: [],
    ended: true,
    data: [],
    message: message,
    retry: retry,
  };
}
