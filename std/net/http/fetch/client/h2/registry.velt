// velt/net/http (internal): the process's HTTP/2 client sessions by origin, so that every task's
// `fetch` to an origin shares one connection (multiplexing). A map behind a `Mutex`, kept in a
// static atomic (its word is in the program's data; the reference is released at exit for the
// leak counters), as velt/net/websocket's topics are.
//
// Not a module-level `shared` value: that would be module state, which every task touching it
// then locks at each poll.

import { Channel } from "velt/sync/channel";
import { H2Call } from "velt/net/http/fetch/client/h2/call";

/// An origin's session: its channel and its number.
struct Origin {
  calls: Channel<H2Call>;
  id: i64;
}

type Origins = Mutex<Map<string, Origin>>;

/// The process's map, made on first use.
const ORIGINS = new Atomic<shared<Origins> | null>(null);

function origins(): shared<Origins> {
  const found = ORIGINS.load("acquire");
  if (found != null) {
    return found;
  }
  // Two first calls race: one value wins, the other is dropped.
  ORIGINS.compareExchange(
    null,
    shared(new Mutex<Map<string, Origin>>(new Map<string, Origin>())),
    "acqrel",
  );
  const made = ORIGINS.load("acquire");
  if (made == null) {
    panic("ICE: the sessions' map is set once and never cleared");
  }
  return made;
}

/// Numbers sessions, so that a closing one forgets only its own entry.
const NEXT_ID = new Atomic<i64>(1);

/// The session of `key`, if one is open.
export function sessionOf(key: string): Channel<H2Call> | null {
  return origins().with((m) => {
    const o = m.get(key);
    return o == undefined ? null : o.calls;
  });
}

/// Registers the session `calls` for `key` if none is there (its connection is being made;
/// requests may queue on it already): its number, or 0 when another came first.
export function claim(key: string, calls: Channel<H2Call>): i64 {
  const id = NEXT_ID.add(1);
  const claimed = origins().with((m) => {
    if (m.has(key)) {
      return false;
    }
    m.set(key, { calls: calls, id: id });
    return true;
  });
  return claimed ? id : 0;
}

/// Forgets session `id` of `key`, if it is still the registered one.
export function forget(key: string, id: i64) {
  origins().with((m) => {
    const o = m.get(key);
    if (o != undefined && o.id == id) {
      m.delete(key);
    }
  });
}
