// velt/net/http (internal): what a `Response` (response.velt) does with its body: `text()`, the
// bytes and the chunks it reads, `clone()`, which tees it, and what a server writes for it.

import { IoError } from "velt/io/error";
import { AbortError } from "velt/task";
import { utf8DecodeLossy, utf8Encode } from "velt/encoding";
import { collect, impliedType } from "velt/net/http/fetch/body";
import { BodyStream } from "velt/net/http/fetch/body_stream";
import { Headers } from "velt/net/http/fetch/headers";
import { Fetched } from "#http-transport";
import { BodyKind, ResponseParts } from "velt/net/http/fetch/parts";
import { tee } from "velt/net/http/fetch/tee";
import { Response } from "velt/net/http/fetch/response";

/** Where a response's body is (`Response.bodySource`); the first four are a `BodyKind` (parts.velt). */
export const NONE: i64 = 0;
export const TEXT: i64 = 1;
export const BYTES: i64 = 2;
export const STREAM: i64 = 3;
/** A fetched response's body, received by the `fetch` client. */
export const RUNTIME: i64 = 4;

/** `res.clone()` (`Response.clone`). */
export function cloneResponse(res: Response): Response throws IoError {
  if (res.bodyRead) {
    throw new IoError("EINVAL", "Response.clone: Body has already been consumed.");
  }
  const r = new Response();
  r.headCode = res.headCode;
  r.headRemote = res.headRemote;
  r.bodySource = res.bodySource;
  r.bodyText = res.bodyText;
  const data = res.bodyBytes;
  if (data != null) {
    r.bodyBytes = data.slice();
  }
  const f = res.bodyFetched;
  if (f != null) {
    // Both read the head from here on; the body (if any) goes to both through a tee, which
    // now owns the connection.
    r.headReason = res.statusText;
    if (f.decoded()) {
      res.decodedRemote().decoded = true;
      r.headRemote = res.headRemote;
    }
    const h = Headers.adopt(res.headers.raw());
    h.frozen = true;
    r.headFields = h;
    res.bodyFetched = null;
    if (res.bodySource == RUNTIME) {
      split(res, r, bodyOf(new Held(f)));
    }
    return r;
  }
  r.headReason = res.headReason;
  const fields = res.headFields;
  if (fields != null) {
    r.headFields = new Headers(fields);
  } else {
    r.headImplied = res.headImplied;
  }
  const s = res.bodyStream;
  res.bodyStream = null;
  if (res.bodySource == STREAM && s != null) {
    split(res, r, s[Symbol.asyncIterator]());
  }
  return r;
}

/** The body `chunks` teed between `res` and its clone `r`, both now streamed. */
function split(res: Response, r: Response, chunks: AsyncIterator<u8[], IoError | AbortError>) {
  const [mine, theirs] = tee(chunks);
  res.bodySource = STREAM;
  res.bodyStream = BodyStream.adopt(mine);
  r.bodySource = STREAM;
  r.bodyStream = BodyStream.adopt(theirs);
}

/** `res.text()`: the body as text (invalid UTF-8 becomes U+FFFD, as in JS). */
export async function responseText(r: Response): Promise<string, IoError | AbortError> {
  r.claim();
  const f = r.bodyFetched;
  if (r.bodySource == RUNTIME && f != null) {
    return await f.text();
  }
  if (r.bodySource == TEXT) {
    return r.bodyText;
  }
  let d = r.bodyBytes ?? [];
  // Taken out: the body is read once (and a borrow of the field here reads freed memory, #1115).
  const s = r.bodyStream;
  r.bodyStream = null;
  if (r.bodySource == STREAM && s != null) {
    d = await collect(s);
  }
  // A leading byte order mark is not text, as in JS.
  const bom = d.length >= 3 && d[0] == 239 && d[1] == 187 && d[2] == 191;
  return utf8DecodeLossy(bom ? d.slice(3) : d);
}

/** The body of `r` as Velt's byte array. */
export async function responseBytes(r: Response): Promise<u8[], IoError | AbortError> {
  r.claim();
  const f = r.bodyFetched;
  if (r.bodySource == RUNTIME && f != null) {
    return await f.bytes();
  }
  if (r.bodySource == TEXT) {
    return utf8Encode(r.bodyText);
  }
  // Taken out: the body is read once (and a borrow of the field here reads freed memory, #1115).
  const s = r.bodyStream;
  r.bodyStream = null;
  if (r.bodySource == STREAM && s != null) {
    return await collect(s);
  }
  return r.bodyBytes ?? [];
}

/** The body of `r` chunk by chunk, for `BodyStream`; reading them uses the body up. */
export async function* responseChunks(r: Response): AsyncIterator<u8[], IoError | AbortError> {
  r.claim();
  const f = r.bodyFetched;
  if (r.bodySource == RUNTIME && f != null) {
    while (true) {
      const chunk = await f.chunk();
      if (chunk.length == 0) {
        return;
      }
      yield chunk;
    }
  }
  // Taken out: the body is read once (and a borrow of the field here reads freed memory, #1115).
  const s = r.bodyStream;
  r.bodyStream = null;
  if (r.bodySource == TEXT) {
    yield utf8Encode(r.bodyText);
  } else if (r.bodySource == STREAM && s != null) {
    for await (const chunk of s) {
      yield chunk;
    }
  } else {
    const d = r.bodyBytes;
    if (d != null && d.length > 0) {
      yield d;
    }
  }
}

/**
 * What a server writes for `r` (`responseParts`, parts.velt): a streamed body (a `BodyStream`, or a
 * fetched response's body) is used up, as sending it does in JS. A fetched response's head is
 * passed on without what only held for the message it came in (`passedOn`).
 */
export function serverParts(r: Response): ResponseParts throws IoError {
  const source = r.bodySource;
  let headers: string[] = [];
  let implied = r.headImplied;
  const fields = r.headFields;
  if (fields != null) {
    const [list, type] = fields.serverFlat();
    headers = list;
    implied = type;
  } else if (r.bodyFetched != null) {
    headers = r.headers.raw();
  }
  if (r.headRemote != null) {
    headers = passedOn(headers, r.decoded());
  }
  let stream: BodyStream | null = null;
  if (source == STREAM || source == RUNTIME) {
    if (r.bodyRead) {
      throw new IoError("EINVAL", "Body is unusable: Body has already been read");
    }
    if (source == STREAM) {
      r.bodyRead = true;
      stream = r.bodyStream;
      r.bodyStream = null;
    } else {
      // `chunks` marks the body used when it starts.
      stream = BodyStream.adopt(r.chunks());
    }
  }
  return {
    status: r.headCode,
    headers: headers,
    type: impliedType(implied),
    kind: kindOf(source == RUNTIME ? STREAM : source),
    text: r.bodyText,
    bytes: r.bodyBytes ?? [],
    stream: stream,
  };
}

/**
 * `[name, value, …]` of a fetched response, without the fields that end at the connection it came
 * over and those its `connection` names (RFC 9110 §7.6.1), and its `date` (the server sending it on
 * writes its own). A `decoded` body
 * no longer has the coding it was sent in, nor the `content-length` that counted the coded bytes.
 */
function passedOn(list: string[], decoded: bool): string[] {
  const named = connectionNames(list);
  const out: string[] = [];
  for (let i: i64 = 0; i + 1 < (list.length as i64); i += 2) {
    const name = list[i];
    if (
      name != "connection" &&
      name != "keep-alive" &&
      name != "proxy-connection" &&
      name != "te" &&
      name != "trailer" &&
      name != "upgrade" &&
      name != "date" &&
      !(decoded && (name == "content-encoding" || name == "content-length")) &&
      !named.includes(name)
    ) {
      out.push(name);
      out.push(list[i + 1]);
    }
  }
  return out;
}

/** The field names the `connection` fields of `[name, value, …]` list, in lowercase. */
function connectionNames(list: string[]): string[] {
  const names: string[] = [];
  for (let i: i64 = 0; i + 1 < (list.length as i64); i += 2) {
    if (list[i] == "connection") {
      for (const name of list[i + 1].split(",")) {
        names.push(name.trim().toLowerCase());
      }
    }
  }
  return names;
}

/**
 * A fetched body teed by `clone`: dropped with the last reader, it closes a connection whose
 * body nobody finished reading.
 */
class Held {
  fetched: Fetched;

  constructor(fetched: Fetched) {
    this.fetched = fetched;
  }

  [Symbol.dispose]() {
    this.fetched.close();
  }
}

async function* bodyOf(held: Held): AsyncGenerator<u8[], IoError | AbortError> {
  while (true) {
    const chunk = await held.fetched.chunk();
    if (chunk.length == 0) {
      return;
    }
    yield chunk;
  }
}

/** The `BodyKind` of a body source (`NONE` to `STREAM`). */
function kindOf(source: i64): BodyKind {
  if (source == TEXT) {
    return BodyKind.Text;
  }
  if (source == BYTES) {
    return BodyKind.Bytes;
  }
  return source == STREAM ? BodyKind.Stream : BodyKind.None;
}
