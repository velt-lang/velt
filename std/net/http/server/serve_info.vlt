// velt/net/http (internal): `ServeInfo`, what `serve` tells a handler about a request beyond the
// `Request` itself (Deno's `ServeHandlerInfo`), and `NetAddr`, the address a connection came from.

import { Received } from "velt/net/http/server/received";

/** An address a connection came from (Deno's `NetAddr`). */
export interface NetAddr {
  /** "tcp" */
  transport: string;
  /** The IP address, e.g. "127.0.0.1" or "::1". */
  hostname: string;
  port: number;
}

/** What `serve` knows about a request beyond the `Request`: a handler's second argument. */
export class ServeInfo {
  private received: Received;

  constructor(received: Received) {
    this.received = received;
  }

  /** The client's address. Valid while the handler runs, like its request. */
  get remoteAddr(): NetAddr {
    const addr = this.received.remoteAddr();
    const colon = addr.lastIndexOf(":");
    let host = colon < 0 ? addr : addr.slice(0, colon);
    if (host.startsWith("[") && host.endsWith("]")) {
      host = host.slice(1, (host.length as i64) - 1);
    }
    const port = colon < 0 ? 0 : parseInt(addr.slice(colon + 1));
    return { transport: "tcp", hostname: host, port: port };
  }
}
