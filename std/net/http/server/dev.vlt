// velt/net/http (internal): the graceful stop under `velt dev` (crates/velt_rt/src/dev/shutdown.rs).
// Before the supervisor starts the next version of the program, it asks this one to stop: a
// server joined here then stops accepting (the supervisor keeps the listening socket, so new
// connections wait for the next version), answers its in-flight requests, and tells the runtime,
// which exits once every server did (or after a bounded wait). Outside `velt dev` nothing joins.

import { AbortSignal } from "velt/task";

declare function velt_rt_dev_server_stop(): u64;
declare function velt_rt_dev_server_drained();

/**
 * Under `velt dev`: a signal aborted once the program is asked to stop; the server must call
 * `drained` after it stopped and its connections finished. Null outside `velt dev`.
 */
export function devStop(): AbortSignal | null {
  const handle = velt_rt_dev_server_stop();
  return handle == 0 ? null : AbortSignal.adopt(handle);
}

/** A server that joined the graceful stop (`devStop`) finished. */
export function drained() {
  velt_rt_dev_server_drained();
}
