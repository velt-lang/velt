// velt/net/http (internal): the lingering close after an error response to input the server did
// not read (a head or body too large, an HTTP/2 connection error), as nginx's and Kestrel's.

import { TcpStream } from "velt/net";

/// The most of the peer's remaining input that is read, and for how long.
const LINGER_BYTES: i64 = 1048576;
const LINGER_MS: i64 = 2000;

/// Reads (and drops, into `scratch`) what the peer still sends, up to `LINGER_BYTES` for
/// `LINGER_MS`, so closing with unread input does not reset the connection before the peer read
/// the response (or the GOAWAY). The sending side is shut down already.
export async function linger(conn: TcpStream, scratch: u8[]) {
  const until = Date.now() + LINGER_MS;
  let left = LINGER_BYTES;
  while (left > 0) {
    const wait = until - Date.now();
    if (wait <= 0) {
      return;
    }
    const n = conn.tryRead(scratch);
    if (n == null) {
      return;
    }
    if (n == 0) {
      if (!(await conn.readableWithin(wait as number))) {
        return;
      }
      continue;
    }
    left -= n as i64;
  }
}
