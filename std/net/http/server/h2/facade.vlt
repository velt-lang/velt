// velt/net/http (internal): `serveHttp`'s handlers over HTTP/2: each stream's `H2Request` and
// `H2Response` reach the handler as the `HttpRequest` and `HttpResponse` it is written for, which
// pass every call on to them. A connection keeps the pairs its streams used for the next ones
// (as many as ran at once), so a request costs no allocation of them.

import { TcpStream } from "velt/net";
import { AbortSignal } from "velt/task";
import { Parser } from "velt/net/http/server/parse";
import { HttpRequest } from "velt/net/http/server/request";
import { HttpResponse } from "velt/net/http/server/response";
import { H2Options } from "velt/net/http/server/h2/options";
import { H2Request } from "velt/net/http/server/h2/request";
import { H2Response } from "velt/net/http/server/h2/response";
import { serveH2 } from "velt/net/http/server/h2/serve";

/// Serves `conn` as HTTP/2 with an `HttpRequest`/`HttpResponse` handler (see `serveH2`).
export async function serveH2Http<E>(
  conn: TcpStream,
  initial: u8[],
  opts: H2Options,
  stopped: AbortSignal,
  handler: (req: HttpRequest, res: HttpResponse) => Promise<void, E> throws E,
): Promise<void> {
  const facades = new Facades(conn, stopped);
  await serveH2(conn, initial, opts, stopped, async (r: H2Request, s: H2Response) => {
    const req = facades.request(r);
    const res = facades.response(s, req);
    try {
      await handler(req, res);
    } finally {
      facades.keep(req, res);
    }
  });
}

/// A connection's facades: the pairs its streams used, kept for the next ones.
class Facades {
  private conn: TcpStream;
  private stopped: AbortSignal;
  // One parser for every request facade: it is used only over HTTP/1.1.
  private parser: Parser = new Parser(0, 0, 0);
  private requests: HttpRequest[] = [];
  private responses: HttpResponse[] = [];

  constructor(conn: TcpStream, stopped: AbortSignal) {
    this.conn = conn;
    this.stopped = stopped;
  }

  /// A request facade passing its calls on to `r`.
  request(r: H2Request): HttpRequest {
    const req = this.requests.pop() ?? new HttpRequest(this.parser, this.conn, 0);
    req.bindH2(r);
    return req;
  }

  /// A response facade passing its calls on to `s`.
  response(s: H2Response, req: HttpRequest): HttpResponse {
    const res = this.responses.pop() ?? new HttpResponse(this.conn, this.stopped, req.head);
    res.bindH2(s);
    return res;
  }

  /// The handler returned: the pair is unbound (nothing of the stream, or the connection, stays
  /// reachable from it) and kept.
  keep(req: HttpRequest, res: HttpResponse) {
    req.bindH2(null);
    res.bindH2(null);
    this.requests.push(req);
    this.responses.push(res);
  }
}
