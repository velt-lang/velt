// velt/net/http (internal): how an HTTP/2 connection waits for input: no longer than its idle
// timeout (without streams) or the earliest request body deadline (with them), and ended early
// by the server's stop or, while draining, by its last stream ending.

import { AbortController } from "velt/task";
import { NO_ERROR } from "velt/net/http/h2";
import { H2Connection } from "velt/net/http/server/h2/connection";
import { expire } from "velt/net/http/server/h2/streams";

/// No deadline.
const MAX_TIME: i64 = 9007199254740991;

/// Waits for input: false when the connection should end (idle with no streams, or the server
/// stopped and the last stream is done).
export async function waitForInput(c: H2Connection): Promise<bool> {
  while (true) {
    if (c.stopped.aborted && !c.goingAway) {
      c.goaway(NO_ERROR, "");
      c.flush();
    }
    if (c.goingAway && c.inUse == 0) {
      return false;
    }
    let signal = c.stopped;
    if (c.goingAway || c.stopped.aborted) {
      const w = new AbortController();
      c.wakeLoop = w;
      signal = w.signal;
    }
    let idle = c.inUse > 0 ? 3600000 : c.opts.idleTimeout;
    if (c.inUse > 0 && c.nextDeadline < MAX_TIME) {
      // Not past the next request body's deadline.
      const left = (c.nextDeadline - Date.now()) as number;
      idle = left < 1 ? 1 : left < idle ? left : idle;
    }
    const ready = await c.conn.readableWithin(idle, signal);
    c.wakeLoop = null;
    if (c.nextDeadline <= Date.now()) {
      expire(c);
      c.flush();
    }
    if (ready) {
      return true;
    }
    if (!c.stopped.aborted && !c.goingAway && c.inUse == 0) {
      // Idle: tell the peer, then close.
      c.goaway(NO_ERROR, "idle");
      c.flush();
      return false;
    }
  }
}
