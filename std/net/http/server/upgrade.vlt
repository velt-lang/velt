// velt/net/http (internal): switching the connection of a request `serve` received to another
// protocol (`Upgrade`), the way a WebSocket server takes it over (velt/net/websocket).

import { IoError } from "velt/io/error";
import { TcpStream } from "velt/net";
import { Headers, HeadersInit } from "velt/net/http/fetch/headers";
import { Request } from "velt/net/http/fetch/request";
import { Response } from "velt/net/http/fetch/response";

/** What `upgradeConnection` returns: the connection, and the response to return from the handler. */
export interface ConnectionUpgrade {
  /** The connection, now in the new protocol (over TLS if the server is). */
  stream: TcpStream;
  /** What the client sent after its request, already in the new protocol (Node's `head`). */
  head: u8[];
  /** `101 Switching Protocols`: return it from the handler. */
  response: Response;
}

/** Whether `req` asks to switch its connection to `protocol` (an HTTP/1.1 `Upgrade` request). */
export function isUpgradeRequest(req: Request, protocol: string): bool {
  const received = req.serverSide();
  return received != null && received.isUpgrade(protocol);
}

/**
 * Takes over the connection of an upgrade request: `101 Switching Protocols` with `upgrade:
 * protocol`, `connection: Upgrade` and `headers` is queued at once (ahead of anything written
 * to `stream`), and from then on the connection is `stream`, a byte stream like any `velt/net`
 * connection; return `response` from the handler. Throws `IoError` "EINVAL" if `req` is not an
 * upgrade request (`isUpgradeRequest`), its connection was taken already, or a header is not
 * valid. Only HTTP/1.1 connections can be upgraded.
 */
export function upgradeConnection(
  req: Request,
  protocol: string,
  headers: HeadersInit | null = null,
): ConnectionUpgrade throws IoError {
  const received = req.serverSide();
  if (received == null || !received.isUpgrade(protocol)) {
    throw new IoError("EINVAL", "not an upgrade request (or its connection was taken already)");
  }
  const fields = new Headers(headers);
  const pairs: [string, string][] = [];
  for (const [name, value] of fields) {
    pairs.push([name, value]);
  }
  try {
    const [stream, head] = received.upgrade(protocol, pairs);
    fields.set("upgrade", protocol);
    fields.set("connection", "Upgrade");
    return { stream: stream, head: head, response: Response.switching(fields) };
  } catch (e) {
    throw new IoError("EINVAL", `cannot upgrade the connection: ${e}`);
  }
}
