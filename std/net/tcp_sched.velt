// velt/net (internal): velt/net's TCP functions in a build compiled with the executor in Velt
// (`VELT_SCHEDULER=std`, #2649 step 2): the `std-scheduler` variant of `#net-tcp`
// (std/imports.velt), with the names and signatures of the runtime's (std/net/rt.velt), so
// `TcpStream`, `TcpListener`, `connect` and `listen` are the same code in every build.
//
// `connect` and `listen` open non-blocking sockets on the executor's reactor
// (std/lang/hooks/sched_io.velt): their handles have the top bit set (sched_io_table.velt), and
// every operation on such a handle runs here (std/net/fd_socket.velt, std/net/fd_io.velt), on the
// worker, with no Rust in between. `listenTls` does the same with the TLS server in Velt
// (std/net/tls/fd_server.velt, whose handles are ours too) for a P-256 key, in a program that
// loaded it (std/net/tls/fd_hook.velt); only a program that can listen with it tests for TLS
// handles (`stdUsed("reactorTls")`, a constant the server's `listen` sets). Everything else is
// handed to the runtime: `listenTls` with another key (RSA, P-384, Ed25519), `connectTls` (it
// needs the built-in roots and RSA, #2392 step 3; TLS in Velt over a plain stream is `startTls`),
// listeners under `velt dev` (the supervisor hands them over, `devHandover`), `fetch`'s pooled
// connections (`park`/`unpark`), and every socket on an OS without a reactor
// (std/lang/hooks/reactor_none.velt). A stream of ours `park`ed for `fetch`'s keep-alive pool is
// closed instead: the pool is the runtime's. What a runtime stream defers (`writeLater`) waits in
// Velt and is handed to the runtime's `write` (std/net/rt_later.velt): the runtime sends its own
// deferred bytes only after polls of its own tasks, which never run on this executor's worker.

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { utf8Encode } from "velt/encoding/utf8";
import { stdUsed } from "velt/lang/intrinsics";
import { moduleStateUsed } from "velt/lang/intrinsics/task";
import { schedWorkerCount } from "velt/lang/hooks/sched";
import { processEnv } from "velt/lang/hooks/process";
import * as io from "velt/lang/hooks/sched_io";
import * as tb from "velt/lang/hooks/sched_io_table";
import * as fio from "velt/net/fd_io";
import * as fs from "velt/net/fd_socket";
import { readableUntil } from "velt/net/fd_until";
import * as rt from "velt/net/rt";
import * as lat from "velt/net/rt_later";
import { isTls, TlsServer } from "velt/net/tls/fd_hook";

// The TLS server's operations (std/net/tls/fd_server.velt), or stubs when the program didn't load
// it (std/net/tls/fd_hook.velt).
const TLS: TlsServer = {};

declare function velt_rt_signal_aborted(s: u64): bool;
declare async function velt_rt_signal_wait(s: u64): Promise<void>;

/**
 * Whether listeners come from `velt dev`'s supervisor (`VELT_DEV_SOCKET`, velt_rt's `dev::bind`),
 * which keeps the socket across a restart: the runtime asks it for each one, and the listener and
 * its streams are then the runtime's.
 */
function devHandover(): bool {
  const socket = processEnv("VELT_DEV_SOCKET");
  return socket !== undefined && socket.length > 0;
}

export async function velt_rt_tcp_listen(addr: string): Promise<IoResult<u64>> {
  if (!io.supported() || devHandover()) {
    return await rt.velt_rt_tcp_listen(addr);
  }
  return await fs.listenOn(addr);
}

export function velt_rt_tcp_listener_port(l: u64): u32 {
  if (!tb.ours(l)) {
    return rt.velt_rt_tcp_listener_port(l);
  }
  return fs.portOf(stdUsed("reactorTls") && isTls(l) ? TLS.listenerFd(l) : l);
}

export function velt_rt_tcp_listener_close(l: u64) {
  if (stdUsed("reactorTls") && isTls(l)) {
    TLS.closeListener(l);
  } else if (tb.ours(l)) {
    fs.closeListener(l);
  } else {
    rt.velt_rt_tcp_listener_close(l);
  }
}

/**
 * The executor's workers (`workerCount()`), as the runtime's: a task pinned to one runs there, and
 * a socket of ours follows the task that uses it to its worker's reactor
 * (std/lang/hooks/sched_io_table.velt `follow`). In a program with module state only one, for the
 * runtime's reason (std/net/rt.velt `listenerWorkers`).
 */
export function listenerWorkers(l: u64): u64 {
  return moduleStateUsed() ? 1 : schedWorkerCount();
}

export async function velt_rt_tcp_accept(l: u64): Promise<IoResult<u64>> {
  if (!tb.ours(l)) {
    return await rt.velt_rt_tcp_accept(l);
  }
  return stdUsed("reactorTls") && isTls(l) ? await TLS.accept(l) : await fs.accept(l);
}

export async function velt_rt_tcp_connect(addr: string): Promise<IoResult<u64>> {
  if (!io.supported()) {
    return await rt.velt_rt_tcp_connect(addr);
  }
  return await fs.connect(addr);
}

export async function velt_rt_tcp_read(s: u64, max: u64): Promise<IoResult<u8[]>> {
  if (!tb.ours(s)) {
    return await rt.velt_rt_tcp_read(s, max);
  }
  return stdUsed("reactorTls") && isTls(s) ? await TLS.read(s, max) : await fio.read(s, max);
}

export async function velt_rt_tcp_read_string(s: u64, max: u64): Promise<IoResult<string>> {
  if (!tb.ours(s)) {
    return await rt.velt_rt_tcp_read_string(s, max);
  }
  return stdUsed("reactorTls") && isTls(s)
    ? await TLS.readString(s, max)
    : await fio.readString(s, max);
}

export async function velt_rt_tcp_write(s: u64, data: string): Promise<IoStatus> {
  if (!tb.ours(s)) {
    if (stdUsed("rt-later")) {
      return await lat.writeText(s, data);
    }
    return await rt.velt_rt_tcp_write(s, data);
  }
  if (stdUsed("reactorTls") && isTls(s)) {
    const b = utf8Encode(data);
    return await TLS.writeRange(s, b, 0, b.length as u64);
  }
  return await fio.writeText(s, data);
}

export async function velt_rt_tcp_write_bytes(s: u64, data: u8[]): Promise<IoStatus> {
  if (!tb.ours(s)) {
    if (stdUsed("rt-later")) {
      return await lat.writeRange(s, data, 0, data.length as u64);
    }
    return await rt.velt_rt_tcp_write_bytes(s, data);
  }
  // One expression: a branch the compiler leaves out moves `data` in no drop flag.
  return stdUsed("reactorTls") && isTls(s)
    ? await TLS.writeRange(s, data, 0, data.length as u64)
    : await fio.writeRange(s, data, 0, data.length as u64);
}

export function velt_rt_tcp_try_write(s: u64, data: u8[]): u64 {
  if (!tb.ours(s)) {
    if (stdUsed("rt-later")) {
      if (lat.busy(s)) {
        return 0;
      }
    }
    return rt.velt_rt_tcp_try_write(s, data);
  }
  if (stdUsed("reactorTls") && isTls(s)) {
    return TLS.tryWriteRange(s, data, 0, data.length as u64);
  }
  return fio.tryWriteRange(s, data, 0, data.length as u64);
}

export function velt_rt_tcp_try_read_into(s: u64, data: u8[], start: u64, end: u64): IoResult<i64> {
  if (!tb.ours(s)) {
    return rt.velt_rt_tcp_try_read_into(s, data, start, end);
  }
  return stdUsed("reactorTls") && isTls(s)
    ? TLS.tryReadInto(s, data, start, end)
    : fio.tryReadInto(s, data, start, end);
}

export async function velt_rt_tcp_readable(s: u64): Promise<IoStatus> {
  if (!tb.ours(s)) {
    return await rt.velt_rt_tcp_readable(s);
  }
  return stdUsed("reactorTls") && isTls(s) ? await TLS.readable(s) : await fio.readable(s);
}

export function velt_rt_tcp_write_later(s: u64, data: string): IoResult<u64> {
  if (!tb.ours(s)) {
    return lat.writeLaterText(s, data);
  }
  if (stdUsed("reactorTls") && isTls(s)) {
    const b = utf8Encode(data);
    return TLS.writeLaterRange(s, b, 0, b.length as u64);
  }
  return fio.writeLaterText(s, data);
}

export function velt_rt_tcp_write_later_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): IoResult<u64> {
  if (!tb.ours(s)) {
    return lat.writeLaterRange(s, data, start, end);
  }
  if (stdUsed("reactorTls") && isTls(s)) {
    return TLS.writeLaterRange(s, data, start, end);
  }
  return fio.writeLaterRange(s, data, start, end);
}

export async function velt_rt_tcp_drained(s: u64, max: u64): Promise<IoStatus> {
  if (!tb.ours(s)) {
    if (stdUsed("rt-later")) {
      return await lat.drained(s, max);
    }
    return await rt.velt_rt_tcp_drained(s, max);
  }
  return stdUsed("reactorTls") && isTls(s) ? await TLS.drained(s, max) : await fio.drained(s, max);
}

export async function velt_rt_tcp_readable_within(
  s: u64,
  ms: i64,
  signal: u64,
): Promise<IoResult<u8>> {
  if (!tb.ours(s)) {
    return await rt.velt_rt_tcp_readable_within(s, ms, signal);
  }
  if (stdUsed("reactorTls") && isTls(s)) {
    // Decrypted bytes or a whole record buffered: ready without the socket.
    const fd = TLS.readyOrFd(s);
    if (fd.code !== 0) {
      return fs.failed({ code: fd.code, message: fd.message }, 0);
    }
    if (fd.value == 0) {
      return fs.value(1);
    }
    return await velt_rt_tcp_readable_within(fd.value, ms, signal);
  }
  if (signal === 0) {
    return await fio.readableWithin(s, ms);
  }
  if (velt_rt_signal_aborted(signal)) {
    return fs.value(0);
  }
  if (ms < 0) {
    return await readableUntil(s, signal);
  }
  // The signal's wait is the runtime's: whichever ends first ends the other (dropped).
  const within = fio.readableWithin(s, ms);
  await Promise.race([within.then((_) => {}), velt_rt_signal_wait(signal)]);
  if (velt_rt_signal_aborted(signal)) {
    return fs.value(0);
  }
  return await within;
}

export async function velt_rt_tcp_write_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): Promise<IoStatus> {
  if (!tb.ours(s)) {
    if (stdUsed("rt-later")) {
      return await lat.writeRange(s, data, start, end);
    }
    return await rt.velt_rt_tcp_write_range(s, data, start, end);
  }
  return stdUsed("reactorTls") && isTls(s)
    ? await TLS.writeRange(s, data, start, end)
    : await fio.writeRange(s, data, start, end);
}

export function velt_rt_tcp_try_write_range(s: u64, data: u8[], start: u64, end: u64): u64 {
  if (!tb.ours(s)) {
    if (stdUsed("rt-later")) {
      if (lat.busy(s)) {
        return 0;
      }
    }
    return rt.velt_rt_tcp_try_write_range(s, data, start, end);
  }
  return stdUsed("reactorTls") && isTls(s)
    ? TLS.tryWriteRange(s, data, start, end)
    : fio.tryWriteRange(s, data, start, end);
}

export function velt_rt_tcp_shutdown(s: u64): IoStatus {
  if (tb.ours(s)) {
    return stdUsed("reactorTls") && isTls(s) ? TLS.shutdown(s) : fio.shutdown(s);
  }
  if (stdUsed("rt-later")) {
    return lat.shutdown(s);
  }
  return rt.velt_rt_tcp_shutdown(s);
}

export function velt_rt_tcp_peer_addr(s: u64): string {
  if (!tb.ours(s)) {
    return rt.velt_rt_tcp_peer_addr(s);
  }
  return fs.peerOf(stdUsed("reactorTls") && isTls(s) ? TLS.fdOf(s) : s);
}

export function velt_rt_tcp_abort(s: u64) {
  if (tb.ours(s)) {
    fio.abort(stdUsed("reactorTls") && isTls(s) ? TLS.fdOf(s) : s);
  } else {
    if (stdUsed("rt-later")) {
      lat.abort(s);
    } else {
      rt.velt_rt_tcp_abort(s);
    }
  }
}

export function velt_rt_tcp_close(s: u64) {
  if (stdUsed("reactorTls") && isTls(s)) {
    TLS.close(s);
  } else if (tb.ours(s)) {
    fio.close(s);
  } else {
    if (stdUsed("rt-later")) {
      lat.close(s);
    } else {
      rt.velt_rt_tcp_close(s);
    }
  }
}

export async function velt_rt_tcp_listen_tls(
  addr: string,
  cert: string,
  key: string,
  alpn: string,
): Promise<IoResult<u64>> {
  // Under `velt dev` the supervisor keeps the listener, as for `listen`: the runtime's.
  if (io.supported() && !devHandover()) {
    const ours = await TLS.listen(addr, cert, key, alpn);
    if (ours != null) {
      return ours;
    }
  }
  return await rt.velt_rt_tcp_listen_tls(addr, cert, key, alpn);
}

export async function velt_rt_tcp_alpn(s: u64): Promise<IoResult<string>> {
  if (!tb.ours(s)) {
    return await rt.velt_rt_tcp_alpn(s);
  }
  return stdUsed("reactorTls") && isTls(s) ? await TLS.alpn(s) : fs.value("");
}

export function velt_rt_tcp_park(s: u64, key: string) {
  if (stdUsed("reactorTls") && isTls(s)) {
    TLS.close(s);
  } else if (tb.ours(s)) {
    fio.close(s);
  } else {
    if (stdUsed("rt-later")) {
      lat.park(s, key);
    } else {
      rt.velt_rt_tcp_park(s, key);
    }
  }
}

export function velt_rt_tcp_unpark(key: string, settled: u32): u64 {
  return rt.velt_rt_tcp_unpark(key, settled);
}

export async function velt_rt_tcp_connect_tls(
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
): Promise<IoResult<u64>> {
  return await rt.velt_rt_tcp_connect_tls(addr, serverName, ca, alpn);
}
