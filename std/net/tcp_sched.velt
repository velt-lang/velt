// velt/net (internal): velt/net's TCP functions in a build compiled with the executor in Velt
// (`VELT_SCHEDULER=std`, #2649 step 2): the `std-scheduler` variant of `#net-tcp`
// (std/imports.velt), with the names and signatures of the runtime's (std/net/rt.velt), so
// `TcpStream`, `TcpListener`, `connect` and `listen` are the same code in every build.
//
// `connect` and `listen` open non-blocking sockets on the executor's reactor
// (std/lang/hooks/sched_io.velt): their handles have the top bit set (sched_io_table.velt), and
// every operation on such a handle runs here (std/net/fd_socket.velt, std/net/fd_io.velt), on the
// worker, with no Rust in between. TLS is the client and server in Velt (std/net/tls/), called by
// role (`hookCall`) so that a program loads them only when live code listens or connects with TLS,
// and their handles are ours too; only a program with TLS tests for them (`stdUsed("reactorTls")`,
// std/net/tls/fd_hook.velt's operations). Their sockets are the reactor's: a listener under
// `velt dev` is the supervisor's, handed over through the runtime (`devHandover`) and registered
// here. An OS without a reactor (std/lang/hooks/reactor_none.velt) has no sockets: `listen` and
// `connect` fail with `ENOTSUP`. `fetch`'s keep-alive pool (`park`/`unpark`) is Velt's
// (std/net/tcp_sched_pool.velt).

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { utf8Encode } from "velt/encoding/utf8";
import { hookCall, noteStdUse, stdUsed } from "velt/lang/intrinsics";
import { schedStays, schedWorkerCount } from "velt/lang/hooks/sched";
import { processEnv } from "velt/lang/hooks/process";
import * as io from "velt/lang/hooks/sched_io";
import * as fio from "velt/net/fd_io";
import * as pool from "velt/net/fd_pool";
import * as fs from "velt/net/fd_socket";
import { readableUntil } from "velt/net/fd_until";
import * as rt from "velt/net/rt";
import { parkStream, unparkStream } from "velt/net/tcp_sched_pool";
import { isTls } from "velt/net/tls/fd_hook";
import * as tlsOps from "velt/net/tls/fd_hook";

// std's own signals, not `#task-signal`: this file is the executor in Velt's only (a file shared
// with WebAssembly, whose signals are its runtime's, imports `#task-signal`).
import { signalAborted, signalWait } from "velt/task/signal_sched";

/**
 * Whether listeners come from `velt dev`'s supervisor (`VELT_DEV_SOCKET`, velt_rt's `dev::bind`),
 * which keeps the socket across a restart: the runtime asks it for each one and hands its socket
 * here, to be registered with the reactor as one of ours.
 */
function devHandover(): bool {
  const socket = processEnv("VELT_DEV_SOCKET");
  return socket !== undefined && socket.length > 0;
}

export async function velt_rt_tcp_listen(addr: string): Promise<IoResult<u64>> {
  if (!io.supported()) {
    return { code: 12, message: `listen: no sockets on this OS`, value: 0 };
  }
  if (!devHandover()) {
    return await fs.listenOn(addr);
  }
  const handed = await rt.velt_rt_tcp_listen(addr);
  if (handed.code !== 0) {
    return handed;
  }
  return fs.adopt(handed.value as i32, io.F_LISTENER, io.READ);
}

export function velt_rt_tcp_listener_port(l: u64): u32 {
  // A TLS listener's socket is a plain listener of ours.
  return stdUsed("reactorTls") && isTls(l)
    ? velt_rt_tcp_listener_port(tlsOps.listenerFd(l))
    : fs.portOf(l);
}

export function velt_rt_tcp_listener_close(l: u64) {
  if (stdUsed("reactorTls") && isTls(l)) {
    tlsOps.closeListener(l);
  } else {
    fs.closeListener(l);
  }
}

/**
 * The executor's workers (`workerCount()`), as the runtime's: a task pinned to one runs there, and
 * a socket of ours follows the task that uses it to its worker's reactor
 * (std/lang/hooks/sched_io_table.velt `follow`). A program with module state spreads too
 * (#2726 (c)): its tasks that touch it take the module lock for each poll. Only one whose tasks
 * stay on their worker (`connectionsSpread`) gets one.
 */
export function listenerWorkers(l: u64): u64 {
  return connectionsSpread() ? schedWorkerCount() : 1;
}

/**
 * May a server spread its connections over the workers (velt/net `spreadsConnections`)? Not in a
 * program whose tasks stay on their worker (std/lang/hooks/sched.velt `schedStays`): one that may
 * give a declared function properties through `any`, placed as when the runtime's module lock,
 * which only worker 0 held, guarded them.
 */
export function connectionsSpread(): bool {
  return !schedStays();
}

export async function velt_rt_tcp_accept(l: u64): Promise<IoResult<u64>> {
  return stdUsed("reactorTls") && isTls(l) ? await tlsOps.accept(l) : await fs.accept(l);
}

export async function velt_rt_tcp_connect(addr: string): Promise<IoResult<u64>> {
  if (!io.supported()) {
    return { code: 12, message: `connect: no sockets on this OS`, value: 0 };
  }
  return await fs.connect(addr);
}

export async function velt_rt_tcp_read(s: u64, max: u64): Promise<IoResult<u8[]>> {
  return stdUsed("reactorTls") && isTls(s) ? await tlsOps.read(s, max) : await fio.read(s, max);
}

export async function velt_rt_tcp_read_string(s: u64, max: u64): Promise<IoResult<string>> {
  return stdUsed("reactorTls") && isTls(s)
    ? await tlsOps.readString(s, max)
    : await fio.readString(s, max);
}

export async function velt_rt_tcp_write(s: u64, data: string): Promise<IoStatus> {
  if (stdUsed("reactorTls") && isTls(s)) {
    const b = utf8Encode(data);
    return await tlsOps.writeRange(s, b, 0, b.length as u64);
  }
  return await fio.writeText(s, data);
}

export async function velt_rt_tcp_write_bytes(s: u64, data: u8[]): Promise<IoStatus> {
  // One expression: a branch the compiler leaves out moves `data` in no drop flag.
  return stdUsed("reactorTls") && isTls(s)
    ? await tlsOps.writeRange(s, data, 0, data.length as u64)
    : await fio.writeRange(s, data, 0, data.length as u64);
}

export function velt_rt_tcp_try_write(s: u64, data: u8[]): u64 {
  if (stdUsed("reactorTls") && isTls(s)) {
    return tlsOps.tryWriteRange(s, data, 0, data.length as u64);
  }
  return fio.tryWriteRange(s, data, 0, data.length as u64);
}

export function velt_rt_tcp_try_read_into(s: u64, data: u8[], start: u64, end: u64): IoResult<i64> {
  return stdUsed("reactorTls") && isTls(s)
    ? tlsOps.tryReadInto(s, data, start, end)
    : fio.tryReadInto(s, data, start, end);
}

export async function velt_rt_tcp_readable(s: u64): Promise<IoStatus> {
  return stdUsed("reactorTls") && isTls(s) ? await tlsOps.readable(s) : await fio.readable(s);
}

export function velt_rt_tcp_write_later(s: u64, data: string): IoResult<u64> {
  if (stdUsed("reactorTls") && isTls(s)) {
    const b = utf8Encode(data);
    return tlsOps.writeLaterRange(s, b, 0, b.length as u64);
  }
  return fio.writeLaterText(s, data);
}

export function velt_rt_tcp_write_later_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): IoResult<u64> {
  if (stdUsed("reactorTls") && isTls(s)) {
    return tlsOps.writeLaterRange(s, data, start, end);
  }
  return fio.writeLaterRange(s, data, start, end);
}

export async function velt_rt_tcp_drained(s: u64, max: u64): Promise<IoStatus> {
  return stdUsed("reactorTls") && isTls(s)
    ? await tlsOps.drained(s, max)
    : await fio.drained(s, max);
}

// `velt_rt_tcp_readable_within` of TLS stream `s`: readable when a `tryRead` would find something.
// A readable socket may hold part of a record, or its wait end on a used event (a re-armed poll),
// so the stream is asked again after each wait, which repeats until the time runs out.
async function tlsReadableWithin(s: u64, ms: i64, signal: u64): Promise<IoResult<u8>> {
  const until = (Date.now() as number) + (ms as number);
  for (let waited = false;; waited = true) {
    const fd = tlsOps.readyOrFd(s);
    if (fd.code !== 0) {
      return fs.failed({ code: fd.code, message: fd.message }, 0);
    }
    const left = ms > 0 ? ((until - (Date.now() as number)) as i64) : ms;
    // Ready; or `ms == 0` (only looks) and the socket was asked; or the time ran out.
    if (fd.value == 0 || (ms == 0 && waited) || (ms > 0 && left <= 0)) {
      return fs.value(fd.value == 0 ? 1 : 0);
    }
    const r = await velt_rt_tcp_readable_within(fd.value, left, signal);
    if (r.code !== 0 || r.value == 0) {
      return r;
    }
  }
}

export async function velt_rt_tcp_readable_within(
  s: u64,
  ms: i64,
  signal: u64,
): Promise<IoResult<u8>> {
  if (stdUsed("reactorTls") && isTls(s)) {
    return await tlsReadableWithin(s, ms, signal);
  }
  if (signal === 0) {
    return await fio.readableWithin(s, ms);
  }
  if (signalAborted(signal)) {
    return fs.value(0);
  }
  if (ms < 0) {
    return await readableUntil(s, signal);
  }
  // Whichever ends first ends the other (dropped). Not `timed`: the socket's wait keeps the
  // process alive.
  const within = fio.readableWithin(s, ms);
  await Promise.race([within.then((_) => {}), signalWait(signal, false)]);
  if (signalAborted(signal)) {
    return fs.value(0);
  }
  return await within;
}

export async function velt_rt_tcp_write_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): Promise<IoStatus> {
  return stdUsed("reactorTls") && isTls(s)
    ? await tlsOps.writeRange(s, data, start, end)
    : await fio.writeRange(s, data, start, end);
}

export function velt_rt_tcp_try_write_range(s: u64, data: u8[], start: u64, end: u64): u64 {
  return stdUsed("reactorTls") && isTls(s)
    ? tlsOps.tryWriteRange(s, data, start, end)
    : fio.tryWriteRange(s, data, start, end);
}

export function velt_rt_tcp_shutdown(s: u64): IoStatus {
  return stdUsed("reactorTls") && isTls(s) ? tlsOps.shutdown(s) : fio.shutdown(s);
}

export function velt_rt_tcp_peer_addr(s: u64): string {
  return stdUsed("reactorTls") && isTls(s) ? velt_rt_tcp_peer_addr(tlsOps.fdOf(s)) : fs.peerOf(s);
}

export function velt_rt_tcp_abort(s: u64) {
  if (stdUsed("reactorTls") && isTls(s)) {
    velt_rt_tcp_abort(tlsOps.fdOf(s));
  } else {
    fio.abort(s);
  }
}

export function velt_rt_tcp_close(s: u64) {
  if (stdUsed("reactorTls") && isTls(s)) {
    tlsOps.close(s);
  } else {
    fio.close(s);
  }
}

export async function velt_rt_tcp_listen_tls(
  addr: string,
  cert: string,
  key: string,
  alpn: string,
): Promise<IoResult<u64>> {
  // The TLS server in Velt (std/net/tls/fd_server.velt), by role: a program loads it only when
  // live code can listen with TLS (#2392).
  if (io.supported() && !devHandover()) {
    return await hookCall("sched_tls_listen", addr, cert, key, alpn, 0);
  }
  // Under `velt dev` the supervisor keeps the listener, as for `listen`: the plain listener it
  // hands over, on the reactor, with the TLS server in Velt on its streams.
  const plain = await velt_rt_tcp_listen(addr);
  if (plain.code !== 0) {
    return plain;
  }
  const ours = await hookCall("sched_tls_listen", addr, cert, key, alpn, plain.value);
  if (ours.code !== 0) {
    fs.closeListener(plain.value);
  }
  return ours;
}

export async function velt_rt_tcp_alpn(s: u64): Promise<IoResult<string>> {
  // A TLS stream is the Velt client's or server's (`isTls`), on a socket of either kind.
  return stdUsed("reactorTls") && isTls(s) ? await tlsOps.alpn(s) : fs.value("");
}

/** Keeps idle stream `s` in `fetch`'s keep-alive pool under `key` (std/net/tcp_sched_pool.velt). */
export function velt_rt_tcp_park(s: u64, key: string) {
  parkStream(s, key);
}

/** A usable idle stream of `key` from the pool, or 0 (std/net/tcp_sched_pool.velt). */
export function velt_rt_tcp_unpark(key: string, settled: u32): u64 {
  return unparkStream(key, settled);
}

export async function velt_rt_tcp_connect_tls(
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
): Promise<IoResult<u64>> {
  // The client in Velt (std/net/tls/fd_client.velt), by role, over a socket of the reactor's, or
  // of the runtime's where there is none: loaded only when live code can connect with TLS.
  return await hookCall("sched_tls_connect", addr, serverName, ca, alpn);
}
