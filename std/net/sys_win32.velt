// velt/net (internal): the socket constants and layouts of Windows for velt/net's sockets on the
// reactor of the executor in Velt (std/net/tcp_sched.velt, #2649 step 2): what differs from
// `<sys/socket.h>` and `<netdb.h>` in Winsock's headers, and the runtime's error code of a
// Winsock error (std/native/error.velt), as Rust's `io::ErrorKind` sorts them.

import { addressLoad } from "velt/lang/intrinsics";

/** `AF_INET6`. */
export const AF_INET6: i32 = 23;
/** `SOL_SOCKET`, `SO_ERROR`, `SO_REUSEADDR`. */
export const SOL_SOCKET: i32 = 0xffff;
export const SO_ERROR: i32 = 0x1007;
/**
 * What a listener sets before it binds: `SO_EXCLUSIVEADDRUSE` (`~SO_REUSEADDR`). Windows'
 * `SO_REUSEADDR` would let it bind a port another socket listens on; the runtime (Rust) sets
 * neither, and a port in use is `EADDRINUSE` either way.
 */
export const SO_REUSEADDR: i32 = -5;
/** `SO_BROADCAST` (UDP sockets: std/net/udp/udp_sched.velt). */
export const SO_BROADCAST: i32 = 0x20;
/** Where `ADDRINFOA` keeps `ai_addr` (after a `size_t` `ai_addrlen` and `ai_canonname`). */
export const AI_ADDR: usize = 32;

/** The family of the `sockaddr` at `sa`: a `u16` at byte 0. */
export function familyOf(sa: usize): i32 {
  // SAFETY: `sa` is a socket address the OS filled.
  return unsafe { addressLoad<u16>(sa + 0) } as i32;
}

/** The runtime's error code (std/native/error.velt) of Winsock error `e`. */
export function codeOf(e: i32): i32 {
  switch (e) {
    case 10013:
      return 2;
    case 10022:
      return 4;
    case 10060:
      return 6;
    case 10061:
      return 7;
    case 10053:
    case 10054:
    case 10057:
      return 8;
    case 10048:
      return 9;
    case 10058:
      return 10;
    case 10045:
    case 10047:
      return 12;
    case 6:
    case 10009:
    case 10038:
      return 16;
    default:
      return 99;
  }
}
