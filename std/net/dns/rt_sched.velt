// velt/net/dns (internal): the resolver function, in a build compiled with the executor in Velt
// (`VELT_SCHEDULER=std`, #2649 step 4): the `std-scheduler` variant of `#net-dns`
// (std/imports.velt), with the name and signature of the runtime's (std/net/dns/rt.velt). It
// calls its twin on the executor (lookup_sched.velt) by role (`hookCall`, velt_common
// `std_hooks.rs`): a program loads it only when live code resolves a name (#2882).

import { IoResult } from "velt/native/result";
import { hookCall } from "velt/lang/intrinsics";
// The resolver's text decoding reaches `EncodingError`, a class extending `Error`, which can't
// arrive in the middle of a check (velt_loader std_index's (a1) rule): it is loaded with this.
import "velt/encoding/errors";

export async function velt_rt_dns_lookup(host: string): Promise<IoResult<string[]>> {
  return await hookCall("sched_dns_lookup", host);
}
