// velt/net/url (internal): what `console.log` and `util.inspect` print for a `URL` and a
// `URLSearchParams`, as Node's custom inspects of the two write it (lib/internal/url.js).

import { inspectStr } from "velt/lang/hooks/inspect";

declare function velt_rt_strbuf_new(cap: u64, out: string);
declare function velt_rt_strbuf_push_str(buf: string, s: string);
declare function velt_rt_strbuf_finish(buf: string, out: string);

/** Node's `breakLength`: a `URLSearchParams` whose pairs are longer is broken across lines. */
const BREAK_LENGTH: i64 = 80;

/**
 * `s` as Node's `util.inspect` quotes it at indentation `indent` (`'a'`, `"it's"`): split after
 * each line break when it is longer than 16 units and than the room left on the line, each piece
 * quoted on its own and joined by ` +` and a new line (std/lang/hooks/inspect_layout_string.velt
 * `splitString`). Written here, not with the `inspect` intrinsic, which starts a top-level value
 * and with it would make the layout forget the custom inspect text of the value being printed.
 */
function quoted(s: string, indent: i64): string {
  const n = s.length as i64;
  let out = "";
  velt_rt_strbuf_new((n as u64) + 2, out);
  if (n <= 16 || n + indent + 4 <= BREAK_LENGTH || s.indexOf("\n") < 0) {
    inspectStr(out, s);
  } else {
    const separator = ` +\n${" ".repeat(indent + 2)}`;
    let from: i64 = 0;
    while (from < n) {
      const at = s.indexOf("\n", from);
      const end = at < 0 ? n : at + 1;
      if (from > 0) {
        velt_rt_strbuf_push_str(out, separator);
      }
      const piece = s.slice(from, end);
      inspectStr(out, piece);
      from = end;
    }
  }
  let text = "";
  velt_rt_strbuf_finish(out, text);
  return text;
}

/**
 * What follows the class's name in `URLSearchParams { 'a' => '1', 'b' => '2' }` or
 * `URLSearchParams {}`; pairs longer than 80 characters in all go one per line, the closing brace
 * after the last.
 */
export function paramsText(names: string[], vals: string[]): string {
  if (names.length == 0) {
    return " {}";
  }
  const items: string[] = [];
  // As Node counts it: each pair and a `, ` between two (UTF-16 code units).
  let length: i64 = -2;
  for (let i: usize = 0; i < names.length; i++) {
    const item = `${quoted(names[i], 0)} => ${quoted(vals[i], 0)}`;
    length += (item.length as i64) + 2;
    items.push(item);
  }
  if (length > BREAK_LENGTH) {
    return ` {\n  ${items.join(",\n  ")} }`;
  }
  return ` { ${items.join(", ")} }`;
}

/**
 * What follows the class's name in `URL {` and its getters one per line (`  href: '…',`), then `}`: Node prints them as a plain
 * object, always too long for one line. `values` are the getters' in Node's order, `href` to
 * `hash` without `searchParams`; `params` is `paramsText` of the query, its lines after the
 * first indented to the getter's.
 */
export function urlText(values: string[], params: string): string {
  const names = ["href", "origin", "protocol", "username", "password", "host", "hostname"];
  names.push("port", "pathname", "search", "hash");
  const lines: string[] = [];
  for (let i: usize = 0; i < names.length; i++) {
    lines.push(`${names[i]}: ${quoted(values[i], 2)}`);
    if (names[i] == "search") {
      lines.push(`searchParams: URLSearchParams${params.replaceAll("\n", "\n  ")}`);
    }
  }
  return ` {\n  ${lines.join(",\n  ")}\n}`;
}
