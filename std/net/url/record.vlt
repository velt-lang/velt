// velt/net/url (internal): the URL record, its parser and serializer, for std/url.
//
// A simplified WHATWG basic URL parser (url.spec.whatwg.org §4.4): the input is split into
// scheme, authority, path, query and fragment by scanning for delimiters instead of running the
// spec's character state machine, which gives the same results for the inputs the spec accepts
// (minus the gaps listed in std/net/url/index.vlt). Relative references resolve against a base record
// like RFC 3986 §5.2 with WHATWG's special-scheme rules (`\` is a separator, empty hosts are
// invalid, default ports are dropped). Parsers return null where the URL is invalid.

import {
  FRAGMENT,
  QUERY,
  SPECIAL_QUERY,
  PATH,
  USERINFO,
  C0,
  encodeSet,
  inSetCode,
  isAscii,
} from "velt/net/url/encode";
import { parseHost } from "velt/net/url/host";

/**
 * A parsed URL. `path` is serialized (it starts with "/" unless it is empty or `opaque`, e.g.
 * `mailto:` paths); `port` is "" when absent or the scheme's default. Optional components are
 * a flag plus a string (not `string | null`) so they can be read without cloning.
 */
export class UrlRecord {
  scheme: string = "";
  username: string = "";
  password: string = "";
  hasHost: bool = false;
  host: string = "";
  port: string = "";
  path: string = "";
  opaque: bool = false;
  hasQuery: bool = false;
  query: string = "";
  hasFragment: bool = false;
  fragment: string = "";
}

// Byte values used by the scanners.
const SLASH: i64 = 47;
const BACKSLASH: i64 = 92;
const QUESTION: i64 = 63;
const HASH: i64 = 35;
const COLON: i64 = 58;
const AT: i64 = 64;
const OPEN_BRACKET: i64 = 91;
const CLOSE_BRACKET: i64 = 93;

// Up to this many code units, `removeTabNewline` looks through an ASCII text itself. The
// runtime's three searches cost a fixed amount and little per unit, so they are the cheaper way
// from about 48 units on.
const SCAN_UP_TO: i64 = 32;

/** Whether `scheme` is one of WHATWG's special schemes. */
export function isSpecial(scheme: string): bool {
  return scheme == "http" ||
    scheme == "https" ||
    scheme == "ws" ||
    scheme == "wss" ||
    scheme == "ftp" ||
    scheme == "file";
}

/** The default port of a special scheme as a string, or "". */
export function defaultPort(scheme: string): string {
  if (scheme == "http" || scheme == "ws") {
    return "80";
  }
  if (scheme == "https" || scheme == "wss") {
    return "443";
  }
  return scheme == "ftp" ? "21" : "";
}

/** Parses `input` (absolute, or relative to `base`); null if it is not a valid URL. */
export function parseUrl(input: string, base: UrlRecord | null): UrlRecord | null {
  const s = cleanInput(input);
  const colon = schemeEnd(s);
  if (colon < 0) {
    return base == null ? null : parseRelative(s, base);
  }
  const scheme = s.slice(0, colon).toLowerCase();
  if (base != null && isSpecial(scheme) && base.scheme == scheme) {
    const rest = s.slice(colon + 1);
    if (!rest.startsWith("//")) {
      return parseRelative(rest, base);
    }
  }
  return parseAbsolute(scheme, s, colon + 1);
}

// Strips leading/trailing C0 controls and spaces, and removes tabs and newlines (WHATWG).
function cleanInput(input: string): string {
  let start: i64 = 0;
  let end = input.length as i64;
  while (start < end && input.charCodeAt(start) <= 32) {
    start++;
  }
  while (end > start && input.charCodeAt(end - 1) <= 32) {
    end--;
  }
  return removeTabNewline(input.slice(start, end));
}

/**
 * `s` without ASCII tabs and newlines, which the WHATWG parser drops everywhere (the constructor
 * and every setter that runs it).
 */
export function removeTabNewline(s: string): string {
  // A short ASCII text is looked through where it stands; a long one, or one where each
  // `charCodeAt` has a position to find first, is searched by the runtime.
  if ((s.length as i64) <= SCAN_UP_TO && isAscii(s)) {
    let found = false;
    for (let i: i64 = 0; i < (s.length as i64); i++) {
      const c = s.charCodeAt(i);
      if (c == 9 || c == 10 || c == 13) {
        found = true;
        break;
      }
    }
    if (!found) {
      return s;
    }
  } else if (s.indexOf("\t") < 0 && s.indexOf("\n") < 0 && s.indexOf("\r") < 0) {
    return s;
  }
  return s.replaceAll("\t", "").replaceAll("\n", "").replaceAll("\r", "");
}

// Index of the `:` ending a scheme (`ALPHA *(ALPHA / DIGIT / "+" / "-" / ".")`), or -1.
function schemeEnd(s: string): i64 {
  const first = s.charCodeAt(0);
  if (!((first >= 65 && first <= 90) || (first >= 97 && first <= 122))) {
    return -1;
  }
  for (let i: i64 = 1; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    if (c == 58) {
      return i;
    }
    const ok =
      (c >= 65 && c <= 90) ||
      (c >= 97 && c <= 122) ||
      (c >= 48 && c <= 57) ||
      c == 43 ||
      c == 45 ||
      c == 46;
    if (!ok) {
      return -1;
    }
  }
  return -1;
}

// Whether the byte at `i` separates path segments.
function isSep(s: string, i: i64, special: bool): bool {
  const c = s.charCodeAt(i);
  return c == SLASH || (special && c == BACKSLASH);
}

// Index of the first byte of `s` at or after `from` ending an authority (or a path, when
// `pathToo` is false: then only `?` and `#` end it).
function componentEnd(s: string, from: i64, special: bool, pathToo: bool): i64 {
  for (let i = from; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    if (c == QUESTION || c == HASH || (pathToo && isSep(s, i, special))) {
      return i;
    }
  }
  return s.length as i64;
}

// Parses `s[from..]`, everything after the scheme's colon. The components are found by index
// in `s`; only the ones kept are cut out of it.
function parseAbsolute(scheme: string, s: string, from: i64): UrlRecord | null {
  const special = isSpecial(scheme);
  if (!special && s.charCodeAt(from) != SLASH) {
    // Decided before the cut below, so that an opaque URL is sliced once.
    const o = new UrlRecord();
    o.scheme = scheme;
    return parseOpaque(o, s.slice(from));
  }
  if (from > 0 && !isAscii(s)) {
    // Finding a position in text that is not ASCII costs more the further in it is: cut the
    // scheme off first.
    return parseAbsolute(scheme, s.slice(from), 0);
  }
  const file = scheme == "file";
  const r = new UrlRecord();
  r.scheme = scheme;
  let at = from;
  const twoSlashes = isSep(s, from, special) && isSep(s, from + 1, special);
  if (special && !file) {
    while (isSep(s, at, true)) {
      at++;
    }
  } else if (twoSlashes) {
    at = from + 2;
  }
  if (file && twoSlashes && startsWithDrive(s, at)) {
    // `file://C:/x`: a drive letter where the host would be starts the path (the URL spec's
    // file host state), so the host is empty.
    r.hasHost = true;
  } else if (at > from || (special && !file)) {
    const end = componentEnd(s, at, special, true);
    if (!parseAuthority(r, s, at, end, special)) {
      return null;
    }
    at = end;
  } else if (file) {
    r.hasHost = true;
  }
  applyTail(r, s, at, [], special);
  return r;
}

// `mailto:a@b`, `data:...`: the path is kept as written (C0-encoded), without dot segments.
function parseOpaque(r: UrlRecord, rest: string): UrlRecord {
  const end = componentEnd(rest, 0, false, false);
  r.opaque = true;
  r.path = encodeSet(rest.slice(0, end), C0);
  applyQueryFragment(r, rest, end, false);
  return r;
}

// Fills userinfo, host and port from the authority `s[from..end]`; false if any of them is
// invalid.
function parseAuthority(r: UrlRecord, s: string, from: i64, end: i64, special: bool): bool {
  if (r.scheme == "file") {
    return setFileHost(r, s.slice(from, end));
  }
  if (!isAscii(s)) {
    // The scans below are for ASCII text.
    return parseWideAuthority(r, s.slice(from, end), special);
  }
  // The last `@` ends the userinfo.
  let at: i64 = -1;
  for (let i = from; i < end; i++) {
    if (s.charCodeAt(i) == AT) {
      at = i;
    }
  }
  if (at >= 0) {
    const info = s.slice(from, at);
    const colon = info.indexOf(":");
    if (colon >= 0) {
      r.username = encodeSet(info.slice(0, colon), USERINFO);
      r.password = encodeSet(info.slice(colon + 1), USERINFO);
    } else {
      r.username = encodeSet(info, USERINFO);
    }
  }
  const hostStart = at < 0 ? from : at + 1;
  // An IPv6 literal's colons are not the port separator: the search starts at its `]`.
  let colon = hostStart;
  if (s.charCodeAt(hostStart) == OPEN_BRACKET) {
    let close = hostStart;
    while (close < end && s.charCodeAt(close) != CLOSE_BRACKET) {
      close++;
    }
    if (close < end) {
      colon = close;
    }
  }
  while (colon < end && s.charCodeAt(colon) != COLON) {
    colon++;
  }
  if (colon == hostStart) {
    if (special && r.scheme != "file") {
      return false;
    }
    r.hasHost = true;
    return at < 0 && colon == end;
  }
  const host = parseHost(s.slice(hostStart, colon), special);
  if (host == null) {
    return false;
  }
  r.hasHost = true;
  r.host = host;
  return parsePort(r, s, colon + 1, end);
}

/**
 * A `file:` URL's authority is only a host (no credentials or port: `@` and `:` are forbidden
 * host code points); `localhost` means the empty host. False if `text` is not a valid host.
 */
export function setFileHost(r: UrlRecord, text: string): bool {
  let host = "";
  if (text.length > 0) {
    const parsed = parseHost(text, true);
    if (parsed == null) {
      return false;
    }
    host = parsed == "localhost" ? "" : parsed;
  }
  r.hasHost = true;
  r.host = host;
  return true;
}

// `parseAuthority` for the authority of a URL that is not ASCII: the runtime's searches find
// `@` and `:`, and the parts are cut out to be looked at.
function parseWideAuthority(r: UrlRecord, auth: string, special: bool): bool {
  const at = auth.lastIndexOf("@");
  if (at >= 0) {
    const info = auth.slice(0, at);
    const colon = info.indexOf(":");
    if (colon >= 0) {
      r.username = encodeSet(info.slice(0, colon), USERINFO);
      r.password = encodeSet(info.slice(colon + 1), USERINFO);
    } else {
      r.username = encodeSet(info, USERINFO);
    }
  }
  const hostPort = auth.slice(at + 1);
  // An IPv6 literal's colons are not the port separator.
  let colon = hostPort.indexOf(":", hostPort.startsWith("[") ? hostPort.indexOf("]") : 0);
  if (colon < 0) {
    colon = hostPort.length as i64;
  }
  const hostText = hostPort.slice(0, colon);
  if (hostText.length == 0) {
    if (special && r.scheme != "file") {
      return false;
    }
    r.hasHost = true;
    return at < 0 && colon == (hostPort.length as i64);
  }
  const host = parseHost(hostText, special);
  if (host == null) {
    return false;
  }
  r.hasHost = true;
  r.host = host;
  const port = hostPort.slice(colon + 1);
  return parsePort(r, port, 0, port.length as i64);
}

// The port `s[from..end]` (empty: none): digits only, at most 65535; leading zeros and the
// scheme's default port are dropped.
function parsePort(r: UrlRecord, s: string, from: i64, end: i64): bool {
  if (from >= end) {
    return true;
  }
  let v: i64 = 0;
  for (let i = from; i < end; i++) {
    const c = s.charCodeAt(i);
    if (c < 48 || c > 57) {
      return false;
    }
    v = v * 10 + (c - 48);
    if (v > 65535) {
      return false;
    }
  }
  const port = `${v}`;
  r.port = port == defaultPort(r.scheme) ? "" : port;
  return true;
}

// Resolves a scheme-less reference against `base`.
function parseRelative(rest: string, base: UrlRecord): UrlRecord | null {
  if (base.opaque) {
    if (!rest.startsWith("#")) {
      return null;
    }
    const r = base.clone();
    r.hasFragment = true;
    r.fragment = encodeSet(rest.slice(1), FRAGMENT);
    return r;
  }
  const special = isSpecial(base.scheme);
  if (isSep(rest, 0, special) && isSep(rest, 1, special)) {
    return parseAbsolute(base.scheme.clone(), rest, 0);
  }
  const r = new UrlRecord();
  r.scheme = base.scheme.clone();
  r.username = base.username.clone();
  r.password = base.password.clone();
  r.hasHost = base.hasHost;
  r.host = base.host.clone();
  r.port = base.port.clone();
  const end = componentEnd(rest, 0, special, false);
  if (end == 0) {
    r.path = base.path.clone();
    applyQueryFragment(r, rest, 0, special);
    if (!r.hasQuery) {
      r.hasQuery = base.hasQuery;
      r.query = base.query.clone();
    }
    return r;
  }
  if (isSep(rest, 0, special)) {
    // A `file:` URL keeps its base's Windows drive letter (`/x` against `file:///C:/p` is
    // `file:///C:/x`), unless the path names one itself.
    const drive: string[] = [];
    const first = base.path.length > 0 ? base.path.slice(1).split("/")[0] : "";
    if (r.scheme == "file" && isDriveLetter(first) && !startsWithDrive(rest, 1)) {
      drive.push(first);
    }
    applyTail(r, rest, 0, drive, special);
    return r;
  }
  // A relative path continues from the base's directory, unless a `file:` URL's path starts
  // with a drive letter (`C|/x`), which takes none of the base's path (the URL spec's file
  // state).
  const drive = r.scheme == "file" && startsWithDrive(rest, 0);
  const segs = base.path.length > 0 && !drive ? base.path.slice(1).split("/") : [];
  if (!drive) {
    segs.pop();
  }
  applyTail(r, rest, 0, segs, special);
  return r;
}

// Sets path, query and fragment from `s[from..]` (everything after the authority); a relative
// path continues from `segs`. `special`: whether `r.scheme` is special.
function applyTail(r: UrlRecord, s: string, from: i64, segs: string[], special: bool) {
  if (from > 0 && !isAscii(s)) {
    // As in `parseAbsolute`: positions are counted from the tail's start.
    applyTail(r, s.slice(from), 0, segs, special);
    return;
  }
  const end = componentEnd(s, from, special, false);
  r.path = parsePath(s.slice(from, end), segs, special, r.scheme == "file");
  applyQueryFragment(r, s, end, special);
}

// Sets query and fragment from `s[from..]`, which is empty or starts with `?` or `#`.
function applyQueryFragment(r: UrlRecord, s: string, from: i64, special: bool) {
  let hash = s.indexOf("#", from);
  if (hash < 0) {
    hash = s.length as i64;
  } else {
    r.hasFragment = true;
    r.fragment = encodeSet(s.slice(hash + 1), FRAGMENT);
  }
  if (from < hash && s.charCodeAt(from) == QUESTION) {
    r.hasQuery = true;
    r.query = encodeSet(s.slice(from + 1, hash), special ? SPECIAL_QUERY : QUERY);
  }
}

/**
 * Serializes path `p` (after `segs`), percent-encoding segments and resolving `.` and `..`. In
 * a `file:` URL (`file`), a first segment `C|` is the drive letter `C:`, and `..` does not
 * remove a drive letter.
 */
export function parsePath(p: string, segs: string[], special: bool, file: bool = false): string {
  const len = p.length as i64;
  if (len == 0 && segs.length == 0) {
    return special ? "/" : "";
  }
  if (segs.length == 0 && !file && isSerializedPath(p)) {
    return p;
  }
  let i: i64 = isSep(p, 0, special) ? 1 : 0;
  while (true) {
    let j = i;
    while (j < len && !isSep(p, j, special)) {
      j++;
    }
    const last = j >= len;
    const dots = dotSegment(p, i, j);
    // A final `.` or `..` leaves an empty last segment (the path ends in `/`), except for a
    // `..` that had nothing to remove in a non-special URL: its path stays empty, as Node has
    // it (`foo://h/..` is `foo://h`, `foo://h/a/..` is `foo://h/`).
    const emptied = dots == 2 && segs.length == 0;
    if (dots == 2 && !(file && segs.length == 1 && isDriveLetter(segs[0]))) {
      segs.pop();
    }
    if (dots == 0) {
      const seg = p.slice(i, j);
      // A `file:` URL's first segment `C|` is the drive letter `C:`.
      const drive =
        file &&
        segs.length == 0 &&
        seg.length == 2 &&
        seg.charCodeAt(1) == 124 &&
        startsWithDrive(seg, 0);
      segs.push(drive ? `${seg.slice(0, 1)}:` : encodeSet(seg, PATH));
    } else if (last && (special || !emptied)) {
      segs.push("");
    }
    if (last) {
      break;
    }
    i = j + 1;
  }
  return segs.length == 0 ? "" : `/${segs.join("/")}`;
}

// Is `s` a normalized Windows drive letter (`C:`)?
function isDriveLetter(s: string): bool {
  if (s.length != 2 || s.charCodeAt(1) != 58) {
    return false;
  }
  const c = s.charCodeAt(0);
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

// Does `s[from..]` start with a Windows drive letter (`C:` or `C|`) followed by the end, `/`,
// `\`, `?` or `#`?
function startsWithDrive(s: string, from: i64): bool {
  const len = s.length as i64;
  if (from + 2 > len) {
    return false;
  }
  const c = s.charCodeAt(from);
  const second = s.charCodeAt(from + 1);
  const letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
  if (!letter || (second != 58 && second != 124)) {
    return false;
  }
  if (from + 2 == len) {
    return true;
  }
  const next = s.charCodeAt(from + 2);
  return next == 47 || next == 92 || next == 63 || next == 35;
}

// Whether `parsePath` would give back `p` unchanged, found in one pass without building the
// segments: `p` starts with `/`, has nothing to escape and no `\` (a separator only in special
// URLs; the others just take the long way), and no segment starts with `.` or `%` (every
// spelling of a dot segment does).
function isSerializedPath(p: string): bool {
  if (!isAscii(p) || p.charCodeAt(0) != SLASH) {
    return false;
  }
  let segmentStart = true;
  for (let i: i64 = 1; i < (p.length as i64); i++) {
    const c = p.charCodeAt(i);
    if (c == SLASH) {
      segmentStart = true;
      continue;
    }
    if (c == BACKSLASH || inSetCode(c, PATH)) {
      return false;
    }
    if (segmentStart && (c == 46 || c == 37)) {
      return false;
    }
    segmentStart = false;
  }
  return true;
}

// 1 for a `.` segment, 2 for `..` (also spelled with `%2e`), else 0.
function dotSegment(p: string, from: i64, to: i64): i64 {
  const n = to - from;
  if (n == 0 || n > 6) {
    return 0;
  }
  const first = p.charCodeAt(from);
  if (first != 46 && first != 37) {
    return 0;
  }
  const seg = p.slice(from, to).toLowerCase();
  if (seg == "." || seg == "%2e") {
    return 1;
  }
  return seg == ".." || seg == ".%2e" || seg == "%2e." || seg == "%2e%2e" ? 2 : 0;
}

/** The serialized URL (WHATWG "URL serializer"). */
export function serialize(r: UrlRecord): string {
  // Appended in place: one buffer that grows, not a new string per component.
  let out = `${r.scheme}:`;
  if (r.hasHost) {
    out += "//";
    out += userinfo(r);
    out += r.host;
    if (r.port.length > 0) {
      out += ":";
      out += r.port;
    }
  } else if (!r.opaque && r.path.startsWith("//")) {
    out += "/.";
  }
  out += r.path;
  if (r.hasQuery) {
    out += "?";
    out += r.query;
  }
  if (r.hasFragment) {
    out += "#";
    out += r.fragment;
  }
  return out;
}

/** `user:pass@`, `user@` or "". */
export function userinfo(r: UrlRecord): string {
  if (r.username.length == 0 && r.password.length == 0) {
    return "";
  }
  if (r.password.length == 0) {
    return `${r.username}@`;
  }
  return `${r.username}:${r.password}@`;
}
