// velt/net/url (internal): the WHATWG IPv6 parser and serializer (url.spec.whatwg.org §3.5,
// "IPv6 parser" and "IPv6 serializer") for a bracketed host. The address is parsed into its eight
// 16-bit pieces, so every spelling of one address serializes the same: lower-case hex without
// leading zeros, the first longest run of two or more zero pieces compressed to `::`, and an
// embedded IPv4 address (`::ffff:127.0.0.1`) written as two hex pieces (`::ffff:7f00:1`), as
// Node's `URL` does. A zone ID (`%eth0`) or any other character is invalid.

/** The serialized host for the bracketed literal `input` (`[...]`), or null if it is invalid. */
export function parseIpv6(input: string): string | null {
  const end = (input.length as i64) - 1;
  if (end < 1 || input.charCodeAt(end) != 93) {
    return null;
  }
  const pieces: i64[] = [0, 0, 0, 0, 0, 0, 0, 0];
  let piece: i64 = 0;
  let compress: i64 = -1;
  // `input[p]`, the code point the spec's pointer is at; `end` (the `]`) is its EOF.
  let p: i64 = 1;
  if (p < end && input.charCodeAt(p) == 58) {
    if (p + 1 >= end || input.charCodeAt(p + 1) != 58) {
      return null;
    }
    p += 2;
    piece++;
    compress = piece;
  }
  while (p < end) {
    if (piece == 8) {
      return null;
    }
    if (input.charCodeAt(p) == 58) {
      if (compress != -1) {
        return null;
      }
      p++;
      piece++;
      compress = piece;
      continue;
    }
    let value: i64 = 0;
    let length: i64 = 0;
    while (length < 4 && p < end && hexValue(input.charCodeAt(p)) >= 0) {
      value = value * 16 + hexValue(input.charCodeAt(p));
      p++;
      length++;
    }
    if (p < end && input.charCodeAt(p) == 46) {
      // An IPv4 address in the last two pieces.
      if (length == 0 || piece > 6) {
        return null;
      }
      p -= length;
      const next = ipv4Pieces(input, p, end, pieces, piece);
      if (next < 0) {
        return null;
      }
      piece = next;
      p = end;
      break;
    }
    if (p < end && input.charCodeAt(p) == 58) {
      p++;
      if (p >= end) {
        return null;
      }
    } else if (p < end) {
      return null;
    }
    pieces[piece] = value;
    piece++;
  }
  if (compress != -1) {
    // The pieces after the `::` move to the end; the ones they leave are zero.
    let swaps = piece - compress;
    let i: i64 = 7;
    while (i != 0 && swaps > 0) {
      const j = compress + swaps - 1;
      const t = pieces[i];
      pieces[i] = pieces[j];
      pieces[j] = t;
      i--;
      swaps--;
    }
  } else if (piece != 8) {
    return null;
  }
  return serialize(pieces);
}

// The dotted IPv4 address `input[p..end]` into `pieces[piece]` and `pieces[piece + 1]`: the
// index after them, or -1 if it is not four decimal numbers of at most 255 without leading zeros.
function ipv4Pieces(input: string, from: i64, end: i64, pieces: i64[], at: i64): i64 {
  let p = from;
  let piece = at;
  let seen: i64 = 0;
  while (p < end) {
    if (seen > 0) {
      if (input.charCodeAt(p) != 46 || seen >= 4) {
        return -1;
      }
      p++;
    }
    if (p >= end || !isDigit(input.charCodeAt(p))) {
      return -1;
    }
    let n: i64 = -1;
    while (p < end && isDigit(input.charCodeAt(p))) {
      const d = input.charCodeAt(p) - 48;
      if (n == 0) {
        return -1;
      }
      n = n < 0 ? d : n * 10 + d;
      if (n > 255) {
        return -1;
      }
      p++;
    }
    pieces[piece] = pieces[piece] * 256 + n;
    seen++;
    if (seen == 2 || seen == 4) {
      piece++;
    }
  }
  return seen == 4 ? piece : -1;
}

// `[a:b:...]` with the first longest run of two or more zero pieces as `::`.
function serialize(pieces: i64[]): string {
  let compress: i64 = -1;
  let best: i64 = 1;
  let i: i64 = 0;
  while (i < 8) {
    let j = i;
    while (j < 8 && pieces[j] == 0) {
      j++;
    }
    if (j - i > best) {
      best = j - i;
      compress = i;
    }
    i = j == i ? i + 1 : j;
  }
  let out = "[";
  let k: i64 = 0;
  while (k < 8) {
    if (k == compress) {
      out += k == 0 ? "::" : ":";
      k += best;
      continue;
    }
    out += pieces[k].toString(16);
    if (k != 7) {
      out += ":";
    }
    k++;
  }
  return out + "]";
}

function isDigit(c: i64): bool {
  return c >= 48 && c <= 57;
}

function hexValue(c: i64): i64 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return -1;
}
