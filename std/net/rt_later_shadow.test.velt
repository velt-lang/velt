// velt/net (tests): white-box tests of the shadows of runtime streams (rt_later_shadow.velt),
// run by `velt test std/`.
//
// The end of a program gives the flushers of deferred bytes up (`dropFlights`). A flusher whose
// wake was on its way then runs once more: the shadow it finds must have nothing left to send,
// or it hands the batch whose write was dropped to the runtime a second time.
import { describe, expect, it } from "velt/test";
import * as io from "velt/lang/hooks/sched_io";
import * as m from "velt/lang/hooks/sched_mem";
import * as tb from "velt/lang/hooks/sched_io_table";
import * as wr from "velt/lang/hooks/sched_io_write";
import { dropFlights, shadowOf, status } from "velt/net/rt_later_shadow";
import * as sh from "velt/net/rt_later_shadow";

/** A handle no runtime stream has: the shadow is never handed to the runtime here. */
const RH: u64 = 0x7fff_0000_0000_0001;

describe("velt/net rt_later shadows", () => {
  it("a shadow given up at the end of the program has nothing left to send", () => {
    const s = shadowOf(RH, true);
    expect(s !== 0).toBe(true);
    // Bytes buffered, a flusher running and a shutdown asked for behind them.
    expect(wr.room(s, 5) !== 0).toBe(true);
    m.st(s + io.S_LEN, 5);
    m.st32(s + io.S_FLAGS, m.ld32(s + io.S_FLAGS) | io.F_FLUSHING | io.F_SHUT);
    tb.leave(s);

    dropFlights();

    const g = shadowOf(RH, false);
    expect(g).toBe(s);
    expect(m.ld(g + io.S_LEN)).toBe(0);
    const fl = m.ld32(g + io.S_FLAGS);
    expect((fl & io.F_ABORTED) !== 0).toBe(true);
    expect((fl & io.F_SHUT) !== 0).toBe(false);
    expect(status(g).code !== 0).toBe(true);
    // Done with: the shadow and its buffer go.
    m.st32(g + io.S_FLAGS, fl & ~io.F_FLUSHING);
    sh.drop(g, RH);
    expect(shadowOf(RH, false)).toBe(0);
  });
});
