// velt/net (internal): the runtime's TCP functions that velt/net's streams and listeners
// call (docs/internals/contracts/rt_abi_async.md §6), through `#net-tcp` (std/imports.velt). This
// file is the variant of a build without the executor in Velt (WebAssembly), whose runtime defines
// them without a network. A build with the executor uses std/net/tcp_sched.velt, which exports the
// same names on the executor's reactor and calls only `velt_rt_tcp_listen` here, for the listener
// `velt dev` hands over.

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { moduleStateUsed } from "velt/lang/intrinsics/task";
import { velt_rt_worker_count } from "velt/task/rt";

/**
 * Under `velt dev`: the listening socket the supervisor hands over (a descriptor, or a `SOCKET` on
 * Windows), which std/net/tcp_sched.velt registers with the reactor. No other build has it.
 */
export declare async function velt_rt_tcp_listen(addr: string): Promise<IoResult<u64>>;

/**
 * A build that takes this file (WebAssembly) has no sockets, so no listener: this and the two
 * below are what velt/net's listener calls through `#net-tcp`, and nothing reaches them with a
 * real handle.
 */
export function velt_rt_tcp_listener_port(l: u64): u32 {
  return 0;
}

/** Nothing to close: no listener in this build. */
export function velt_rt_tcp_listener_close(l: u64) {}

/** Fails with `ENOTSUP`: no listener in this build. */
export async function velt_rt_tcp_accept(l: u64): Promise<IoResult<u64>> {
  return { code: 12, message: "accept: no sockets on this OS", value: 0 };
}

export declare async function velt_rt_tcp_connect(addr: string): Promise<IoResult<u64>>;
export declare async function velt_rt_tcp_read(s: u64, max: u64): Promise<IoResult<u8[]>>;
export declare async function velt_rt_tcp_read_string(s: u64, max: u64): Promise<IoResult<string>>;
export declare async function velt_rt_tcp_write(s: u64, data: string): Promise<IoStatus>;
export declare async function velt_rt_tcp_write_bytes(s: u64, data: u8[]): Promise<IoStatus>;
/** Writes what the stream takes of `data` right now; the number of bytes written. */
export declare function velt_rt_tcp_try_write(s: u64, data: u8[]): u64;
/** Reads into and writes from a range of the program's own bytes (a `Uint8Array`'s buffer). */
export declare function velt_rt_tcp_try_read_into(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): IoResult<i64>;
export declare async function velt_rt_tcp_readable(s: u64): Promise<IoStatus>;
export declare function velt_rt_tcp_write_later(s: u64, data: string): IoResult<u64>;
export declare function velt_rt_tcp_write_later_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): IoResult<u64>;
export declare async function velt_rt_tcp_drained(s: u64, max: u64): Promise<IoStatus>;
export declare async function velt_rt_tcp_readable_within(
  s: u64,
  ms: i64,
  signal: u64,
): Promise<IoResult<u8>>;
export declare async function velt_rt_tcp_write_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): Promise<IoStatus>;
export declare function velt_rt_tcp_try_write_range(s: u64, data: u8[], start: u64, end: u64): u64;
export declare function velt_rt_tcp_shutdown(s: u64): IoStatus;
export declare function velt_rt_tcp_peer_addr(s: u64): string;
export declare function velt_rt_tcp_abort(s: u64);
export declare function velt_rt_tcp_close(s: u64);
export declare function velt_rt_tcp_park(s: u64, key: string);
export declare function velt_rt_tcp_unpark(key: string, settled: u32): u64;

// TLS is the client and server in Velt (std/net/tls/), which run on the executor in Velt
// (std/net/tcp_sched.velt), so this build (WebAssembly, which has no network either) has none: a
// TLS listener or connection fails as its socket does, or else with `ENOTSUP`.

export async function velt_rt_tcp_listen_tls(
  addr: string,
  cert: string,
  key: string,
  alpn: string,
): Promise<IoResult<u64>> {
  const r = await velt_rt_tcp_listen(addr);
  if (r.code !== 0) {
    return r;
  }
  velt_rt_tcp_listener_close(r.value);
  return noTls("listenTls");
}

/** The protocol ALPN chose: none, as no stream of this build is TLS. */
export async function velt_rt_tcp_alpn(s: u64): Promise<IoResult<string>> {
  return { code: 0, message: "", value: "" };
}

export async function velt_rt_tcp_connect_tls(
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
): Promise<IoResult<u64>> {
  const r = await velt_rt_tcp_connect(addr);
  if (r.code !== 0) {
    return r;
  }
  velt_rt_tcp_close(r.value);
  return noTls("connectTls");
}

function noTls(who: string): IoResult<u64> {
  return { code: 12, message: `${who}: no TLS in this build`, value: 0 };
}

/**
 * The workers that can serve the connections listener `l` accepts (`TcpListener.workers`): the
 * runtime's sockets go to any of them, but in a program with module state only one. Its tasks
 * that touch module state take the process-wide module lock for every poll (rt_abi.md "Module
 * state"), so connections served on several workers would wait for each other on it and serve
 * fewer requests than on one; one until #2726 replaces the module lock.
 */
export function listenerWorkers(l: u64): u64 {
  return connectionsSpread() ? velt_rt_worker_count() : 1;
}

/**
 * May a server spread its connections over the workers (velt/net `spreadsConnections`)? Not in a
 * program with module state under the runtime's executor (`listenerWorkers`); the executor in
 * Velt, every native build's, spreads them in one too (std/net/tcp_sched.velt).
 */
export function connectionsSpread(): bool {
  return !moduleStateUsed();
}
