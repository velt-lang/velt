// velt/net (internal): `streamPair`, two connected streams on the reactor of the executor in Velt
// (std/lang/hooks/sched_io.velt): a `socketpair` on macOS and Linux, a loopback connection on
// Windows (`#net-pair`). Both ends are the reactor's sockets, so every `TcpStream` operation on
// them runs in Velt on the worker, as on a connected socket.

import { TcpStream } from "velt/net/tcp_stream";
import * as io from "velt/lang/hooks/sched_io";
import * as fs from "velt/net/fd_socket";
import { connectedPair } from "#net-pair";

/**
 * Two connected in-memory streams, as Node's `duplexPair()` (or a `socketpair`): what one
 * writes, the other reads, and one's `shutdown()` is the other's end of stream. Each is a
 * `TcpStream` like any other (close both). For a protocol carried inside another one: the HTTP/2
 * server gives a WebSocket over an HTTP/2 stream one end, and moves bytes between the other end
 * and the stream's frames. Panics when the OS refuses the sockets (out of descriptors).
 */
export function streamPair(): [TcpStream, TcpStream] {
  if (!io.supported()) {
    panic("streamPair: this platform has no reactor for sockets");
  }
  const fds = connectedPair();
  if (fds.code !== 0) {
    panic(`streamPair: ${fds.message}`);
  }
  const a = fs.adopt(fds.value[0], io.F_PAIR, io.READ | io.WRITE);
  if (a.code !== 0) {
    fs.closeFd(fds.value[1]);
    panic(`streamPair: ${a.message}`);
  }
  const b = fs.adopt(fds.value[1], io.F_PAIR, io.READ | io.WRITE);
  if (b.code !== 0) {
    const first = TcpStream.ofHandle(a.value);
    first.close();
    panic(`streamPair: ${b.message}`);
  }
  return [TcpStream.ofHandle(a.value), TcpStream.ofHandle(b.value)];
}
