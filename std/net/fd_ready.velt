// velt/net (internal): whether a socket of the executor in Velt's reactor has input now, for
// `readable` and `readableWithin` (std/net/fd_io.velt).

import { recv$net } from "#net-calls";
import * as r from "#reactor";
import * as io from "velt/lang/hooks/sched_io";
import * as m from "velt/lang/hooks/sched_mem";
import * as wt from "velt/lang/hooks/sched_io_wait";

/** `MSG_PEEK`: the same on Linux, macOS and Windows. */
const MSG_PEEK: i32 = 2;

/**
 * Would a read of socket `s` (locked) find something now? Its readiness stays up after an event
 * or a read that found bytes until a read finds nothing, and a new socket starts readable (its
 * first read tries at once), so the readiness alone may be stale: a peek at one byte decides,
 * and finding nothing clears it as `tryReadInto` does. A failed or aborted source, and a pipe
 * (which can't be peeked at), go by the readiness.
 */
export function readReady(s: usize): bool {
  if (!wt.satisfied(s, io.K_READ, 0)) {
    return false;
  }
  if (m.ld32(s + io.S_ERR) !== 0 || (m.ld32(s + io.S_FLAGS) & (io.F_ABORTED | io.F_PIPE)) !== 0) {
    return true;
  }
  const fd = m.ld(s + io.S_FD) as i32;
  while (true) {
    let n: isize = 0;
    // SAFETY: this thread's scratch buffer holds 64 bytes; the descriptor is open.
    unsafe {
      n = recv$net(fd, m.ptr(m.scratch()), 1, MSG_PEEK);
    }
    const e = n < 0 ? r.errno() : 0;
    if (e === r.EINTR) {
      continue;
    }
    if (e === r.EAGAIN) {
      io.notReady(s, io.READ | io.HUP | io.ERR);
      return false;
    }
    return true;
  }
}
