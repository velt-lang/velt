// velt/net/udp (internal): `UdpSocket`, a bound UDP socket, and `bindUdp`, which binds one.

import { unwrapIo } from "velt/native/result";
import { checkIo } from "velt/native/status";
import { utf8Encode } from "velt/encoding";
import { Datagram } from "velt/net/udp/datagram";
import {
  velt_rt_udp_bind,
  velt_rt_udp_close,
  velt_rt_udp_port,
  velt_rt_udp_recv_from,
  velt_rt_udp_send_to,
  velt_rt_udp_set_broadcast,
} from "velt/net/udp/rt";

/**
 * A bound UDP socket: a Copy handle like std/net's `TcpStream` (async methods take `this` by
 * copy, so it can be used repeatedly and from several tasks), released by `close()`; after
 * that, every copy throws `IoError` `EBADF`.
 */
export struct UdpSocket {
  /** The bound local port (useful after binding port 0). */
  port: number;
  private handle: u64;

  /** Sends one datagram to "host:port"; resolves with the number of bytes sent. */
  async sendTo(data: u8[], addr: string): Promise<i64> {
    return unwrapIo(await velt_rt_udp_send_to(this.handle, data, addr)) as i64;
  }

  /** Sends `text` as UTF-8. */
  async sendTextTo(text: string, addr: string): Promise<i64> {
    return unwrapIo(await velt_rt_udp_send_to(this.handle, utf8Encode(text), addr)) as i64;
  }

  /** The next datagram (at most `max` bytes are kept; 0 = up to 64 KiB). */
  async recvFrom(max: u64 = 0): Promise<Datagram> {
    const raw = unwrapIo(await velt_rt_udp_recv_from(this.handle, max));
    return new Datagram(raw.data, raw.addr);
  }

  /** Allows sending to broadcast addresses. */
  setBroadcast(on: bool) {
    checkIo(velt_rt_udp_set_broadcast(this.handle, on));
  }

  /** Closes the socket (operations in flight finish first). */
  close() {
    velt_rt_udp_close(this.handle);
  }
}

/** Binds a UDP socket to "host:port" (port 0 picks a free port; read it from `.port`). */
export async function bindUdp(addr: string): Promise<UdpSocket> {
  const handle = unwrapIo(await velt_rt_udp_bind(addr));
  return UdpSocket { port: velt_rt_udp_port(handle), handle: handle };
}
