// velt/net/udp (internal): the UDP functions, in a build compiled with the executor in Velt
// (`VELT_SCHEDULER=std`, #2649 step 4): the `std-scheduler` variant of `#net-udp`
// (std/imports.velt), with the names and signatures of the runtime's (std/net/udp/rt.velt).
//
// `bind` opens a non-blocking datagram socket on the executor's reactor (std/lang/hooks/
// sched_io.velt), registered as TCP's sockets are, with a handle of the reactor's table (top bit
// set); `recvFrom` and `sendTo` try at once and wait for readiness on EAGAIN, on the worker, with
// no Rust in between. Addresses are resolved as `connect`'s are (std/net/fd_addr.velt
// `resolve`: a numeric one on the worker, a name on the blocking pool), the first address used,
// as tokio's `send_to` does. On an OS without the reactor, every call is the runtime's.

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { Ptr } from "velt/ffi/ptr";
import { arrayTruncate, promiseAt } from "velt/lang/intrinsics";
import * as r from "#reactor";
import * as sys from "#net-sys";
import * as io from "velt/lang/hooks/sched_io";
import * as m from "velt/lang/hooks/sched_mem";
import * as tb from "velt/lang/hooks/sched_io_table";
import * as t from "velt/lang/hooks/sched_task";
import * as wt from "velt/lang/hooks/sched_io_wait";
import * as wk from "velt/lang/hooks/sched_wake";
import * as fa from "velt/net/fd_addr";
import * as fs from "velt/net/fd_socket";
import * as rt from "./rt";
import { RawDatagram } from "./rt";

export { RawDatagram } from "./rt";

const SOCK_DGRAM: i32 = 2;
const AI_ADDRLEN: usize = 16;
const AI_FAMILY: usize = 4;
/** The largest UDP payload: every receive takes a buffer this size, then truncates. */
const MAX_DATAGRAM: usize = 65536;
/** A `sockaddr_storage` and its length word. */
const SA_SIZE: usize = 128;

// Pointers are `Ptr`s, as in a program's own declarations of these symbols: one C symbol has one
// signature in a program.
declare c("c") function socket$udp(family: i32, kind: i32, protocol: i32): i32;
declare c("c") function bind$udp(fd: i32, addr: Ptr<u8>, len: u32): i32;
declare c("c") function setsockopt$udp(
  fd: i32,
  level: i32,
  name: i32,
  value: Ptr<u8>,
  len: u32,
): i32;
declare c("c") function recvfrom$udp(
  fd: i32,
  buf: Ptr<u8>,
  n: usize,
  flags: i32,
  addr: Ptr<u8>,
  len: Ptr<u8>,
): isize;
declare c("c") function sendto$udp(
  fd: i32,
  buf: Ptr<u8>,
  n: usize,
  flags: i32,
  addr: Ptr<u8>,
  len: u32,
): isize;
/**
 * The address of a byte array's elements (a copy of nothing returns its destination), until
 * `declare c` can take a pointer into an array (#2187), as std/net/fd_io.velt does.
 */
declare c("c") function memset$bytes(dst: u8[], c: i32, n: usize): Ptr<u8>;

/** The address of byte `at` of `data` (which has it). */
function addressOf(data: u8[], at: usize): usize {
  // SAFETY: a copy of nothing; `data` is borrowed for the call.
  return Ptr.addressOf(unsafe { memset$bytes(data, 0, 0) }) + at;
}

function noDatagram(): RawDatagram {
  return { data: [], addr: "" };
}

export async function velt_rt_udp_bind(addr: string): Promise<IoResult<u64>> {
  if (!io.supported()) {
    return await rt.velt_rt_udp_bind(addr);
  }
  const found = await fa.resolve(addr, true);
  if (found.code !== 0) {
    return fs.failed({ code: found.code, message: found.message }, 0);
  }
  const ai = found.value;
  // SAFETY: no precondition.
  const fd = unsafe { socket$udp(m.ld32(ai + AI_FAMILY) as i32, SOCK_DGRAM | r.SOCKET_FLAGS, 0) };
  let st = fs.ok();
  if (fd < 0) {
    st = fs.osError(r.errno());
  } else {
    const prep = r.prepare(fd);
    if (prep !== 0) {
      st = fs.osError(prep);
    } else {
      // SAFETY: the address and its length from getaddrinfo's entry.
      if (unsafe { bind$udp(fd, m.ptr(m.ld(ai + sys.AI_ADDR)), m.ld32(ai + AI_ADDRLEN)) } !== 0) {
        st = fs.osError(r.errno());
      }
    }
  }
  fa.freeList(ai);
  if (st.code !== 0) {
    if (fd >= 0) {
      fs.closeFd(fd);
    }
    return fs.failed(st, 0);
  }
  // A datagram may be queued already: the first receive tries at once.
  return fs.adopt(fd, 0, io.READ | io.WRITE);
}

export function velt_rt_udp_port(u: u64): u32 {
  return tb.ours(u) ? fs.portOf(u) : rt.velt_rt_udp_port(u);
}

export async function velt_rt_udp_send_to(
  u: u64,
  data: u8[],
  addr: string,
): Promise<IoResult<u64>> {
  if (!tb.ours(u)) {
    return await rt.velt_rt_udp_send_to(u, data, addr);
  }
  // A hand-off: the receiver (often a task of this program) may get the datagram at once, so
  // what this thread printed comes first (the runtime's `publish_before_handoff`).
  const w = t.here();
  if (w !== 0 && (m.ld32(w + t.E_MODE) !== 0 || m.ld(w + t.E_LAZY) !== 0)) {
    wk.publish(w);
  }
  const found = await fa.resolve(addr, false);
  if (found.code !== 0) {
    return fs.failed({ code: found.code, message: found.message }, 0);
  }
  const ai = found.value;
  const got = await sendTo(u, data, m.ld(ai + sys.AI_ADDR), m.ld32(ai + AI_ADDRLEN));
  fa.freeList(ai);
  return got;
}

/** Sends `data` to the `sockaddr` at `sa` (`len` bytes) on socket `u`, waiting while it's full. */
async function sendTo(u: u64, data: u8[], sa: usize, len: u32): Promise<IoResult<u64>> {
  while (true) {
    const s = tb.enter(u);
    if (s === 0) {
      return fs.failed(fs.closed(), 0);
    }
    const n = data.length;
    const p = n === 0 ? 0 : addressOf(data, 0);
    // SAFETY: `data` holds `n` bytes at `p` (none: no buffer read); the address is getaddrinfo's.
    const sent =
      unsafe { sendto$udp(m.ld(s + io.S_FD) as i32, m.ptr(p), n, r.SEND_FLAGS, m.ptr(sa), len) };
    if (sent >= 0) {
      tb.leave(s);
      return fs.value(sent as u64);
    }
    const e = r.errno();
    if (e === r.EAGAIN) {
      io.notReady(s, io.WRITE);
    }
    tb.leave(s);
    if (e === r.EAGAIN) {
      // SAFETY: `waitFor` makes a heap future, given up to the promise.
      await unsafe { promiseAt<void>(wt.waitFor(u, io.K_WRITE, 0, 0)) };
    } else if (e !== r.EINTR) {
      return fs.failed(fs.osError(e), 0);
    }
  }
}

export async function velt_rt_udp_recv_from(u: u64, max: u64): Promise<IoResult<RawDatagram>> {
  if (!tb.ours(u)) {
    return await rt.velt_rt_udp_recv_from(u, max);
  }
  const size = max === 0 || max > (MAX_DATAGRAM as u64) ? MAX_DATAGRAM : max as usize;
  const buf: u8[] = Buffer.alloc(MAX_DATAGRAM);
  const sa = m.zeroed(SA_SIZE + 8);
  while (true) {
    const s = tb.enter(u);
    if (s === 0) {
      m.release(sa, SA_SIZE + 8);
      return fs.failed(fs.closed(), noDatagram());
    }
    m.st32(sa + SA_SIZE, SA_SIZE as u32);
    const p = addressOf(buf, 0);
    // SAFETY: `buf` holds MAX_DATAGRAM bytes at `p`; a sockaddr_storage and its length word.
    const n =
      unsafe { recvfrom$udp(
        m.ld(s + io.S_FD) as i32,
        m.ptr(p),
        MAX_DATAGRAM,
        0,
        m.ptr(sa),
        m.ptr(sa + SA_SIZE),
      ) };
    if (n >= 0) {
      tb.leave(s);
      arrayTruncate(buf, (n as usize) < size ? n as usize : size);
      const from = fa.addrText(sa);
      m.release(sa, SA_SIZE + 8);
      return fs.value<RawDatagram>({ data: buf, addr: from });
    }
    const e = r.errno();
    if (e === r.EAGAIN) {
      io.notReady(s, io.READ);
    }
    tb.leave(s);
    if (e === r.EAGAIN) {
      // SAFETY: `waitFor` makes a heap future, given up to the promise.
      await unsafe { promiseAt<void>(wt.waitFor(u, io.K_READ, 0, 0)) };
    } else if (e !== r.EINTR) {
      m.release(sa, SA_SIZE + 8);
      return fs.failed(fs.osError(e), noDatagram());
    }
  }
}

export function velt_rt_udp_set_broadcast(u: u64, on: bool): IoStatus {
  if (!tb.ours(u)) {
    return rt.velt_rt_udp_set_broadcast(u, on);
  }
  const s = tb.enter(u);
  if (s === 0) {
    return fs.closed();
  }
  const word = m.zeroed(16);
  m.st32(word, on ? 1 : 0);
  // SAFETY: an int option in `word`.
  const rc =
    unsafe { setsockopt$udp(
      m.ld(s + io.S_FD) as i32,
      sys.SOL_SOCKET,
      sys.SO_BROADCAST,
      m.ptr(word),
      4,
    ) };
  m.release(word, 16);
  const st = rc === 0 ? fs.ok() : fs.osError(r.errno());
  tb.leave(s);
  return st;
}

export function velt_rt_udp_close(u: u64) {
  if (!tb.ours(u)) {
    rt.velt_rt_udp_close(u);
    return;
  }
  const s = tb.enter(u);
  if (s !== 0) {
    fs.discard(u, s);
    tb.leave(s);
  }
}
