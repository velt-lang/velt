// std/websocket/frame (std-internal): RFC 6455 framing, parsing (and unmasking in place) and
// the header of a frame to send. Not part of the public API.

import { utf8Encode } from "velt/encoding";

export const OP_CONT: i64 = 0;
export const OP_TEXT: i64 = 1;
export const OP_BINARY: i64 = 2;
export const OP_CLOSE: i64 = 8;
export const OP_PING: i64 = 9;
export const OP_PONG: i64 = 10;

/** The parse error for a frame or message over the size limit (closes with 1009, not 1002). */
export const TOO_LONG = "message too long";

/** `parse`: the buffer holds only part of a frame. */
export const PARTIAL: i64 = 0;
/** `parse`: a whole frame, described by the `Frame`. */
export const WHOLE: i64 = 1;
/** `parse`: a protocol error, in the `Frame`'s `error`. */
export const INVALID: i64 = 2;

/**
 * A whole frame in a buffer: the payload (unmasked) is `len` bytes from `start`, and the frame
 * ends at `end` (all positions in the buffer).
 */
export class Frame {
  fin: bool = false;
  op: i64 = 0;
  start: i64 = 0;
  len: i64 = 0;
  end: i64 = 0;
  error: string = "";
}

function invalid(f: Frame, what: string): i64 {
  f.error = what;
  return INVALID;
}

/**
 * The frame at `buf[pos..]`, its payload unmasked in place. `fromClient`: a server requires every
 * frame masked, a client requires none masked (§5.1). `max`: the largest payload accepted.
 */
export function parse(buf: u8[], pos: i64, fromClient: bool, max: i64, f: Frame): i64 {
  const n = (buf.length as i64) - pos;
  if (n < 2) {
    return PARTIAL;
  }
  const b0 = buf[pos] as i64;
  const b1 = buf[pos + 1] as i64;
  if ((b0 & 0x70) != 0) {
    return invalid(f, "reserved bits set (no extension was negotiated)");
  }
  const op = b0 & 0x0f;
  if (op > OP_BINARY && (op < OP_CLOSE || op > OP_PONG)) {
    return invalid(f, "unknown opcode");
  }
  const fin = (b0 & 0x80) != 0;
  const masked = (b1 & 0x80) != 0;
  if (fromClient && !masked) {
    return invalid(f, "unmasked frame from a client");
  }
  if (!fromClient && masked) {
    return invalid(f, "masked frame from a server");
  }
  let at: i64 = 2;
  let len = b1 & 0x7f;
  if (len == 126) {
    if (n < 4) {
      return PARTIAL;
    }
    len = ((buf[pos + 2] as i64) << 8) | (buf[pos + 3] as i64);
    at = 4;
  } else if (len == 127) {
    if (n < 10) {
      return PARTIAL;
    }
    // §5.2: the most significant bit of a 64-bit length must be 0.
    if (((buf[pos + 2] as i64) & 0x80) != 0) {
      return invalid(f, "frame length with the top bit set");
    }
    len = 0;
    for (let i: i64 = 2; i < 10; i++) {
      len = (len << 8) | (buf[pos + i] as i64);
    }
    at = 10;
  }
  if (op >= OP_CLOSE && (len > 125 || !fin)) {
    return invalid(f, "invalid control frame");
  }
  if (len > max) {
    return invalid(f, TOO_LONG);
  }
  let mask: i64 = 0;
  if (masked) {
    if (n < at + 4) {
      return PARTIAL;
    }
    const m = pos + at;
    mask =
      ((buf[m] as i64) << 24) |
      ((buf[m + 1] as i64) << 16) |
      ((buf[m + 2] as i64) << 8) |
      (buf[m + 3] as i64);
    at += 4;
  }
  if (n - at < len) {
    return PARTIAL;
  }
  const start = pos + at;
  if (masked) {
    buf.xorMask(mask as u32, start, start + len);
  }
  f.fin = fin;
  f.op = op;
  f.start = start;
  f.len = len;
  f.end = start + len;
  return WHOLE;
}

/** The size of the header of a frame with `len` payload bytes. */
export function headSize(len: i64, masked: bool): i64 {
  return (len < 126 ? 2 : len < 65536 ? 4 : 10) + (masked ? 4 : 0);
}

/**
 * Writes the header of a frame (FIN set) with `len` payload bytes to `out[at..]` and returns
 * where the payload goes. A masked frame carries `mask`; the caller XORs the payload with it.
 */
export function writeHead(out: u8[], at: i64, op: i64, len: i64, masked: bool, mask: u32): i64 {
  const bit: i64 = masked ? 0x80 : 0;
  out[at] = (0x80 | op) as u8;
  let p = at + 2;
  if (len < 126) {
    out[at + 1] = (bit | len) as u8;
  } else if (len < 65536) {
    out[at + 1] = (bit | 126) as u8;
    out[at + 2] = (len >> 8) as u8;
    out[at + 3] = (len & 0xff) as u8;
    p = at + 4;
  } else {
    out[at + 1] = (bit | 127) as u8;
    for (let i: i64 = 0; i < 8; i++) {
      out[at + 2 + i] = ((len >> (56 - 8 * i)) & 0xff) as u8;
    }
    p = at + 10;
  }
  if (masked) {
    const m = mask as i64;
    out[p] = ((m >> 24) & 0xff) as u8;
    out[p + 1] = ((m >> 16) & 0xff) as u8;
    out[p + 2] = ((m >> 8) & 0xff) as u8;
    out[p + 3] = (m & 0xff) as u8;
    p += 4;
  }
  return p;
}

/**
 * Close codes that go on the wire (RFC 6455 §7.4): the defined ones, and 3000-4999 for libraries
 * and applications. 1005, 1006 and 1015 never do; the rest is reserved.
 */
export function validCloseCode(code: i64): bool {
  return (code >= 1000 && code <= 1003) ||
    (code >= 1007 && code <= 1014) ||
    (code >= 3000 && code <= 4999);
}

/**
 * The payload of a close frame: the code, and `reason` cut to the 123 bytes there is room for,
 * at a character boundary (the reason must stay valid UTF-8, §5.5.1).
 */
export function closePayload(code: i64, reason: string = ""): u8[] {
  let end = Buffer.byteLength(reason) as i64;
  if (end == 0) {
    return [((code >> 8) & 0xff) as u8, (code & 0xff) as u8];
  }
  const text = utf8Encode(reason);
  end = text.length as i64;
  if (end > 123) {
    end = 123;
    while (end > 0 && ((text[end] as i64) & 0xc0) == 0x80) {
      end--;
    }
  }
  const out = Buffer.alloc((2 + end) as usize);
  out[0] = ((code >> 8) & 0xff) as u8;
  out[1] = (code & 0xff) as u8;
  out.set(end == (text.length as i64) ? text : text.slice(0, end), 2);
  return out;
}
