// velt/net/websocket (internal): the opening handshake (RFC 6455 §4), server side (the
// accept key) and client side (the HTTP/1.1 upgrade request over a std/net stream, and the check
// of its response).

import { randomBytes, sha1 } from "velt/crypto";
import { base64Encode, utf8DecodeLossy, utf8Encode } from "velt/encoding";
import { IoError } from "velt/io/error";
import { TcpStream } from "velt/net/tcp_stream";
import { Target } from "velt/net/websocket/target";

const GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
// The response head may be this long.
const MAX_HEAD: usize = 16384;

/**
 * The `Sec-WebSocket-Accept` value that answers a client's `Sec-WebSocket-Key` (RFC 6455
 * §4.2.2).
 */
export function webSocketAccept(key: string): string {
  return base64Encode(sha1(utf8Encode(key + GUID)));
}

/** A fresh `Sec-WebSocket-Key`: 16 random bytes, base64. */
export function generateKey(): string {
  return base64Encode(randomBytes(16));
}

function failed(what: string): IoError {
  return new IoError("UNKNOWN", `WebSocket handshake failed: ${what}`);
}

// The values of header `name` (lower case) in the lines of a response head.
function values(lines: string[], name: string): string[] {
  const out: string[] = [];
  for (let i = 1; i < lines.length; i++) {
    const colon = lines[i].indexOf(":");
    if (colon > 0 && lines[i].slice(0, colon).trim().toLowerCase() == name) {
      out.push(lines[i].slice(colon + 1).trim());
    }
  }
  return out;
}

/**
 * Checks a `101` response head to an upgrade request with `key` (§4.1): the status,
 * `Upgrade: websocket`, `Connection: upgrade`, the accept key, and no extension or subprotocol
 * (this client asks for none). "" if it is fine, else what is wrong.
 */
export function checkResponse(head: string, key: string): string {
  const lines = head.split("\r\n");
  const status = lines[0];
  const words = status.split(" ").filter((w) => w != "");
  if (words.length < 2 || words[1] != "101") {
    const space = status.indexOf(" ");
    return `HTTP error: ${space < 0 ? status : status.slice(space + 1)}`;
  }
  if (!values(lines, "upgrade").some((v) => v.toLowerCase() == "websocket")) {
    return "no Upgrade: websocket";
  }
  const upgrades = (v: string): bool => v
    .split(",")
    .some((t) => t.trim().toLowerCase() == "upgrade");
  if (!values(lines, "connection").some(upgrades)) {
    return "no Connection: upgrade";
  }
  const accept = values(lines, "sec-websocket-accept");
  if (accept.length == 0 || accept[0] != webSocketAccept(key)) {
    return "wrong Sec-WebSocket-Accept";
  }
  if (values(lines, "sec-websocket-extensions").some((v) => v != "")) {
    return "the server chose an extension that wasn't requested";
  }
  if (values(lines, "sec-websocket-protocol").some((v) => v != "")) {
    return "the server chose a subprotocol that wasn't requested";
  }
  return "";
}

// Where the blank line that ends the head starts in `buf`, or -1.
function headEnd(buf: u8[]): i64 {
  let at = buf.indexOf(13u8, 0);
  while (at >= 0 && at + 3 < (buf.length as i64)) {
    if (buf[at + 1] == 10u8 && buf[at + 2] == 13u8 && buf[at + 3] == 10u8) {
      return at;
    }
    at = buf.indexOf(13u8, at + 1);
  }
  return -1;
}

/**
 * Sends the upgrade request and checks the response; returns the bytes read past the response
 * (the first frames, if the server was quick).
 */
export async function handshake(stream: TcpStream, t: Target): Promise<u8[]> {
  const key = generateKey();
  const usual = t.port == (t.secure ? 443 : 80);
  const name = t.host.includes(":") ? `[${t.host}]` : t.host;
  const host = usual ? name : `${name}:${t.port}`;
  await stream.write(
    `GET ${t.path} HTTP/1.1\r\nHost: ${host}\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: ${key}\r\n\r\n`,
  );
  let buf: u8[] = [];
  let end = headEnd(buf);
  while (end < 0) {
    if (buf.length > MAX_HEAD) {
      throw failed("response head too large");
    }
    const chunk = await stream.read(4096);
    if (chunk.length == 0) {
      throw failed("connection closed during the handshake");
    }
    buf = buf.length == 0 ? chunk : buf.concat(chunk);
    end = headEnd(buf);
  }
  const wrong = checkResponse(utf8DecodeLossy(buf.slice(0, end)), key);
  if (wrong != "") {
    throw failed(wrong);
  }
  return buf.slice(end + 4);
}
