// velt/net/websocket (tests): white-box tests, run by `velt test std/`.
//
// White-box tests of velt/net/websocket (RFC 6455): its protocol against a peer that speaks it by
// hand (`RawClient`), the opening handshake (velt/net/websocket/handshake), framing
// (velt/net/websocket/frame), the byte helpers (velt/net/websocket/text, byte_buf, mask_keys),
// and the send queue's bounds against a peer that reads slowly or not at all
// (velt/net/websocket/queue, reader, receive, writer). The server side is a `WebSocket` over a
// stream whose handshake `serveWebSockets` answered (`webSocketAccept`, `webSocketOver`), as a
// server outside std builds it. (Were tests/std/websocket/protocol.test.vlt and internals.test.vlt.)
import { Set } from "velt/collections";
import { channel, Channel } from "velt/sync";
import { base64Decode, utf8Decode, utf8Encode } from "velt/encoding";
import { connect, listen, TcpListener, TcpStream } from "velt/net";
import { TimeoutError, timeout } from "velt/task";
import { afterAll, beforeAll, describe, expect, it } from "velt/test";
import {
  WebSocket,
  connectWebSocket,
  webSocketAccept as acceptKey,
  webSocketOver,
} from "velt/net/websocket";
import { ByteBuf } from "velt/net/websocket/byte_buf";
import {
  Frame,
  OP_BINARY,
  OP_CLOSE,
  OP_CONT,
  OP_PING,
  OP_PONG,
  OP_TEXT,
  PARTIAL,
  WHOLE,
  closePayload,
  headSize,
  parse,
  validCloseCode,
  writeHead,
} from "velt/net/websocket/frame";
import { webSocketAccept, checkResponse, generateKey } from "velt/net/websocket/handshake";
import { maskKey } from "velt/net/websocket/mask_keys";
import { CLOSED, FAILED, HIGH_WATER, START, STATUS, SendQueue } from "velt/net/websocket/queue";
import { Reader } from "velt/net/websocket/reader";
import { other } from "velt/net/websocket/receive";
import { PING, Step } from "velt/net/websocket/step";
import { target } from "velt/net/websocket/target";
import { setText, textOf, utf8Prefix } from "velt/net/websocket/text";
import { finish, flush, settleQuietly } from "velt/net/websocket/writer";

/** A test server on 127.0.0.1 that speaks no more HTTP than the opening handshake. */
class TestServer {
  listener: TcpListener;
  port: number;

  constructor(listener: TcpListener) {
    this.listener = listener;
    this.port = listener.port;
  }

  close() {
    this.listener.close();
  }
}

/** The index just past the blank line that ends an HTTP head in `buf`, or -1. */
function headEnd(buf: u8[]): i64 {
  for (let i: i64 = 0; i + 3 < (buf.length as i64); i++) {
    if (buf[i] == 13u8 && buf[i + 1] == 10u8 && buf[i + 2] == 13u8 && buf[i + 3] == 10u8) {
      return i + 4;
    }
  }
  return -1;
}

/** Answers the opening handshake on `stream` and hands the socket and its path to `handler`. */
async function answer(stream: TcpStream, handler: (ws: WebSocket, path: string) => void) {
  let buf: u8[] = [];
  let end: i64 = -1;
  while (end < 0) {
    const chunk = await stream.read();
    if (chunk.length == 0) {
      stream.close();
      return;
    }
    buf = buf.concat(chunk);
    end = headEnd(buf);
  }
  const lines = utf8Decode(buf.slice(0, end)).split("\r\n");
  const path = lines[0].split(" ")[1];
  let key = "";
  for (const line of lines) {
    if (line.toLowerCase().startsWith("sec-websocket-key:")) {
      key = line.slice(18).trim();
    }
  }
  await stream.write(
    `HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ${acceptKey(key)}\r\n\r\n`,
  );
  handler(webSocketOver(stream, true, buf.slice(end)), path);
}

/** Serves WebSockets on a free port: each connection's socket goes to `handler`. */
async function serveWebSockets(
  handler: (ws: WebSocket, path: string) => void,
): Promise<TestServer> {
  const listener = await listen("127.0.0.1:0");
  const server = new TestServer(listener);
  spawn(async () => {
    while (true) {
      try {
        const stream = await listener.accept();
        spawn(answer(stream, handler));
      } catch (e) {
        return;
      }
    }
  });
  return server;
}

/** A frame as it arrived. */
struct RawFrame {
  op: i64;
  fin: bool;
  payload: u8[];
}

class RawClient {
  conn: TcpStream;
  buf: u8[] = [];

  constructor(conn: TcpStream) {
    this.conn = conn;
  }

  /** Sends one frame; `masked: false` is what a client must not do. */
  async send(op: i64, payload: u8[], fin: bool = true, masked: bool = true): Promise<void> {
    const len = payload.length as i64;
    const out = Buffer.alloc((headSize(len, masked) + len) as usize);
    const mask = masked ? maskKey() : 0u32;
    const at = writeHead(out, 0, op, len, masked, mask);
    out.set(payload, at as usize);
    if (masked) {
      out.xorMask(mask, at, at + len);
    }
    if (!fin) {
      out[0] = out[0] & 0x7fu8;
    }
    await this.conn.writeBytes(out);
  }

  /** The next frame from the server, or null once it has closed the connection. */
  async next(): Promise<RawFrame | null> {
    const f = new Frame();
    while (true) {
      const s = parse(this.buf, 0, false, 268435456, f);
      if (s == WHOLE) {
        const frame = RawFrame { op: f.op, fin: f.fin, payload: this.buf.slice(f.start, f.end) };
        this.buf = this.buf.slice(f.end);
        return frame;
      }
      if (s != PARTIAL) {
        panic(`the server sent an invalid frame: ${f.error}`);
      }
      let chunk: u8[] = [];
      try {
        chunk = await this.conn.read();
      } catch (e) {
        return null;
      }
      if (chunk.length == 0) {
        return null;
      }
      this.buf = this.buf.concat(chunk);
    }
  }

  /** The code of a close frame's payload (0: none), and its reason. */
  static closeCode(payload: u8[]): i64 {
    return payload.length < 2 ? 0 : ((payload[0] as i64) << 8) | (payload[1] as i64);
  }

  static closeReason(payload: u8[]): string {
    return payload.length <= 2 ? "" : utf8Decode(payload.slice(2));
  }

  close() {
    this.conn.close();
  }
}

/** Connects to `ws://127.0.0.1:port` + `path` and shakes hands. */
async function rawConnect(port: number, path: string): Promise<RawClient> {
  const conn = await connect(`127.0.0.1:${port}`);
  await conn.write(
    `GET ${path} HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n`,
  );
  const client = new RawClient(conn);
  // The head ends at the first blank line; what follows it are frames already.
  let head: u8[] = [];
  while (true) {
    head = head.concat(await conn.read());
    for (let i: i64 = 0; i + 3 < (head.length as i64); i++) {
      if (head[i] == 13u8 && head[i + 1] == 10u8 && head[i + 2] == 13u8 && head[i + 3] == 10u8) {
        client.buf = head.slice(i + 4);
        return client;
      }
    }
  }
}

// Echoes until the connection ends, then reports how it ended.
async function session(ws: WebSocket, ended: Channel<string>): Promise<void> {
  let how = "closed";
  try {
    let m = await ws.receive();
    while (m != null) {
      if (m.isBinary) {
        await ws.sendBytes(m.data);
      } else {
        await ws.send(m.text.toUpperCase());
      }
      m = await ws.receive();
    }
  } catch (e) {
    // A failed connection stays failed: later receives see it closed.
    const after = await ws.receive();
    how = `${e.code} ${e.message}${after == null ? "" : " (then a message)"}`;
  }
  await ws.close();
  await ended.send(how);
}

async function goodbye(ws: WebSocket, ended: Channel<string>): Promise<void> {
  await ws.send("before the close");
  await ws.close(1001, "é".repeat(100));
  await ended.send("said goodbye");
}

function show(f: RawFrame | null): string {
  if (f == null) {
    return "end of stream";
  }
  if (f.op == OP_CLOSE) {
    return `close ${RawClient.closeCode(f.payload)} "${RawClient.closeReason(f.payload)}"`;
  }
  const name =
    f.op == OP_TEXT
      ? "text"
      : f.op == OP_BINARY ? "binary" : f.op == OP_PONG ? "pong" : `op ${f.op}`;
  return f.op == OP_BINARY ? `binary ${f.payload}` : `${name} "${utf8Decode(f.payload)}"`;
}

describe("the WebSocket protocol against a peer by hand", () => {
  // Fragments are joined and pings answered, a close frame is answered with the right code, and
  // every protocol violation fails the connection with its close code (RFC 6455 §5, §7.4,
  // §8.1). (Was the golden std/websocket_protocol.)
  const ended = channel<string>();
  let port = 0;
  let close = () => {};
  beforeAll(async () => {
    const server = await serveWebSockets((ws: WebSocket, path: string) => {
      if (path == "/bye") {
        spawn(goodbye(ws, ended));
      } else {
        spawn(session(ws, ended));
      }
    });
    port = server.port;
    close = () => {
      server.close();
      ended.close();
    };
  });
  afterAll(() => close());

  /** What a connection that was sent `payload` as one frame of `op` gets back, and how it ended. */
  async function answer(op: i64, payload: u8[], fin: bool = true): Promise<string> {
    const c = await rawConnect(port, "/");
    await c.send(op, payload, fin);
    const got = `${show(await c.next())} | ${await ended.receive()}`;
    c.close();
    return got;
  }

  /** The same, for bytes written as they are. */
  async function answerRaw(bytes: u8[]): Promise<string> {
    const c = await rawConnect(port, "/");
    await c.conn.writeBytes(bytes);
    const got = `${show(await c.next())} | ${await ended.receive()}`;
    c.close();
    return got;
  }

  it("joins fragments, answers pings and ignores an unasked pong", async () => {
    // A text message in three fragments, cut inside characters, with a ping in between; then a
    // fragmented binary message and an unsolicited pong (ignored).
    const a = await rawConnect(port, "/");
    const text = utf8Encode("héllo wörld ✓");
    await a.send(OP_TEXT, text.slice(0, 2), false);
    await a.send(OP_PING, utf8Encode("p1"));
    await a.send(OP_CONT, text.slice(2, 9), false);
    await a.send(OP_PONG, utf8Encode("unasked"));
    await a.send(OP_CONT, text.slice(9));
    expect(show(await a.next())).toBe('pong "p1"');
    expect(show(await a.next())).toBe('text "HÉLLO WÖRLD ✓"');
    await a.send(OP_BINARY, [1u8, 2u8], false);
    await a.send(OP_CONT, [], false);
    await a.send(OP_CONT, [3u8]);
    expect(show(await a.next())).toBe("binary 1,2,3");
    await a.send(OP_CLOSE, []);
    expect(show(await a.next())).toBe('close 1000 ""');
    expect(show(await a.next())).toBe("end of stream");
    expect(await ended.receive()).toBe("closed");
    a.close();
  });

  it("answers a close frame with the peer's code if it may be sent", async () => {
    expect(await answer(OP_CLOSE, [0x03u8, 0xe8u8, 0x62u8, 0x79u8, 0x65u8])).toBe(
      'close 1000 "" | closed',
    );
    expect(await answer(OP_CLOSE, [0x0bu8, 0xb8u8])).toBe('close 3000 "" | closed');
    // 1005 is never on the wire; then half a code; then a reason that is not UTF-8.
    expect(await answer(OP_CLOSE, [0x03u8, 0xedu8])).toBe('close 1002 "" | closed');
    expect(await answer(OP_CLOSE, [0x03u8])).toBe('close 1002 "" | closed');
    expect(await answer(OP_CLOSE, [0x03u8, 0xe8u8, 0xffu8])).toBe('close 1007 "" | closed');
  });

  it("fails the connection on a protocol violation, with its close code", async () => {
    const error = "EILSEQ WebSocket protocol error:";
    const c = await rawConnect(port, "/");
    // Unmasked, as a server would send it.
    await c.send(OP_TEXT, utf8Encode("hi"), true, false);
    expect(`${show(await c.next())} | ${await ended.receive()}`).toBe(
      `close 1002 "" | ${error} unmasked frame from a client`,
    );
    c.close();
    // Invalid UTF-8 fails at the fragment that has it, before the message is complete; a
    // character cut by the end of the message is invalid too.
    expect(await answer(OP_TEXT, [0x61u8, 0xffu8], false)).toBe(
      `close 1007 "" | ${error} invalid UTF-8 in a text message`,
    );
    expect(await answer(OP_TEXT, [0x61u8, 0xc3u8])).toBe(
      `close 1007 "" | ${error} invalid UTF-8 in a text message`,
    );
    expect(await answer(OP_CONT, utf8Encode("x"))).toBe(
      `close 1002 "" | ${error} continuation without a message`,
    );
    const f = await rawConnect(port, "/");
    await f.send(OP_TEXT, utf8Encode("x"), false);
    await f.send(OP_TEXT, utf8Encode("y"));
    expect(`${show(await f.next())} | ${await ended.receive()}`).toBe(
      `close 1002 "" | ${error} new message inside a fragmented one`,
    );
    f.close();
    // A frame announcing more than the 64 MiB limit: refused from its header.
    expect(
      await answerRaw([
        0x82u8,
        0xffu8,
        0u8,
        0u8,
        0u8,
        0u8,
        0x04u8,
        0u8,
        0u8,
        0x01u8,
        1u8,
        2u8,
        3u8,
        4u8,
      ]),
    ).toBe(`close 1009 "" | ${error} message too long`);
    expect(await answerRaw([0xc1u8, 0x80u8, 1u8, 2u8, 3u8, 4u8])).toBe(
      `close 1002 "" | ${error} reserved bits set (no extension was negotiated)`,
    );
  });

  it("sends what was queued before the server's close frame", async () => {
    // The close frame's reason is cut to the 123 bytes there is room for, at a character
    // boundary.
    const i = await rawConnect(port, "/bye");
    expect(show(await i.next())).toBe('text "before the close"');
    const last = await i.next();
    expect(last?.op ?? -1).toBe(OP_CLOSE);
    if (last != null) {
      expect(RawClient.closeCode(last.payload)).toBe(1001);
      expect(RawClient.closeReason(last.payload)).toBe("é".repeat(61));
    }
    await i.send(OP_CLOSE, [0x03u8, 0xe9u8]);
    expect(await ended.receive()).toBe("said goodbye");
    expect(show(await i.next())).toBe("end of stream");
    i.close();
  });
});

const KEY = "dGhlIHNhbXBsZSBub25jZQ==";

function head(extra: string): string {
  return `HTTP/1.1 101 Switching Protocols\r\nUpgrade: WebSocket\r\nConnection: keep-alive, Upgrade\r\nSec-WebSocket-Accept: ${webSocketAccept(KEY)}${extra}`;
}

function where(url: string): string {
  try {
    const t = target(url);
    return `${t.secure ? "tls " : ""}${t.host} ${t.port} ${t.path}`;
  } catch (e) {
    return `${e.code}: ${e.message}`;
  }
}

describe("the opening handshake", () => {
  // The accept key, the checks a client makes on the server's response (RFC 6455 §4.1), and
  // where a URL points. (Was the golden std/websocket_handshake.)
  it("makes the accept key of RFC 6455 §1.3, and random keys", () => {
    expect(webSocketAccept(KEY)).toBe("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=");
    const a = generateKey();
    const b = generateKey();
    expect(a.length).toBe(24);
    expect(base64Decode(a).length).toBe(16);
    expect(a != b).toBe(true);
  });

  it("checks the server's response", () => {
    expect(checkResponse(head(""), KEY)).toBe("");
    expect(checkResponse("HTTP/1.1 404 Not Found", KEY)).toBe("HTTP error: 404 Not Found");
    expect(checkResponse(head("").replace("Upgrade: WebSocket\r\n", ""), KEY)).toBe(
      "no Upgrade: websocket",
    );
    expect(checkResponse(head("").replace("keep-alive, Upgrade", "keep-alive"), KEY)).toBe(
      "no Connection: upgrade",
    );
    expect(checkResponse(head(""), "AAAAAAAAAAAAAAAAAAAAAA==")).toBe("wrong Sec-WebSocket-Accept");
    expect(checkResponse(head("\r\nSec-WebSocket-Extensions: permessage-deflate"), KEY)).toBe(
      "the server chose an extension that wasn't requested",
    );
    expect(checkResponse(head("\r\nSec-WebSocket-Protocol: chat"), KEY)).toBe(
      "the server chose a subprotocol that wasn't requested",
    );
  });

  it("finds where a URL points", () => {
    expect(where("ws://example.com/chat?room=1")).toBe("example.com 80 /chat?room=1");
    expect(where("wss://example.com")).toBe("tls example.com 443 /");
    expect(where("ws://127.0.0.1:8080/")).toBe("127.0.0.1 8080 /");
    expect(where("wss://[::1]:9443/x")).toBe("tls ::1 9443 /x");
    expect(where("http://example.com/")).toBe("EINVAL: WebSocket URLs start with ws:// or wss://");
    expect(where("not a url")).toBe("EINVAL: invalid WebSocket URL");
  });

  it("reports a bad URL before anything is connected", async () => {
    let why = "";
    try {
      await connectWebSocket("https://example.com/");
    } catch (e) {
      why = `${e.code} ${e.message}`;
    }
    expect(why).toBe("EINVAL WebSocket URLs start with ws:// or wss://");
  });
});

const MAX: i64 = 1048576;

// A whole frame carrying `payload`, masked like a client's if `masked`.
function encode(op: i64, payload: u8[], masked: bool): u8[] {
  const len = payload.length as i64;
  const out = Buffer.alloc((headSize(len, masked) + len) as usize);
  const mask = masked ? maskKey() : 0u32;
  const at = writeHead(out, 0, op, len, masked, mask);
  out.set(payload, at as usize);
  if (masked) {
    out.xorMask(mask, at, at + len);
  }
  return out;
}

function sameBytes(a: u8[], b: u8[]): bool {
  if (a.length != b.length) {
    return false;
  }
  for (let i = 0; i < a.length; i++) {
    if (a[i] != b[i]) {
      return false;
    }
  }
  return true;
}

function status(buf: u8[], fromClient: bool, max: i64): string {
  const f = new Frame();
  const s = parse(buf, 0, fromClient, max, f);
  return s == WHOLE ? "whole" : s == PARTIAL ? "partial" : `invalid: ${f.error}`;
}

describe("framing", () => {
  // Every length class round trips, a partial frame asks for more bytes, and the rules for each
  // side (RFC 6455 §5). (Was the golden std/websocket_frames.)
  it("round trips every length class", () => {
    // Masked, behind some other bytes in the buffer.
    const failed: number[] = [];
    for (const n of [0, 1, 7, 8, 125, 126, 127, 65535, 65536, 70000]) {
      const payload = Buffer.alloc(n as usize);
      for (let i = 0; i < n; i++) {
        payload[i] = (i % 251) as u8;
      }
      const frame = encode(OP_BINARY, payload, true);
      const buf = [9u8, 9u8, 9u8].concat(frame);
      const f = new Frame();
      const s = parse(buf, 3, true, MAX, f);
      const good =
        s == WHOLE &&
        f.fin &&
        f.op == OP_BINARY &&
        f.len == n &&
        f.end == (buf.length as i64) &&
        sameBytes(buf.slice(f.start, f.end), payload);
      if (!good) {
        failed.push(n);
      }
    }
    expect(failed).toEqual([]);
  });

  it("finds any strict prefix of a frame partial", () => {
    const hello = encode(OP_TEXT, utf8Encode("hello world"), true);
    let partial = true;
    for (let cut: i64 = 0; cut < (hello.length as i64); cut++) {
      partial = partial && status(hello.slice(0, cut), true, MAX) == "partial";
    }
    expect(partial).toBe(true);
    expect(status(hello, true, MAX)).toBe("whole");
  });

  it("holds each side to its rules", () => {
    // A server requires masked frames, small unfragmented control frames, no reserved bits.
    const plain = encode(OP_TEXT, utf8Encode("hi"), false);
    expect(status(plain.clone(), true, MAX)).toBe("invalid: unmasked frame from a client");
    expect(status(plain.clone(), false, MAX)).toBe("whole");
    expect(status(encode(OP_TEXT, utf8Encode("hi"), true), false, MAX)).toBe(
      "invalid: masked frame from a server",
    );
    expect(status(encode(OP_PING, Buffer.alloc(126), true), true, MAX)).toBe(
      "invalid: invalid control frame",
    );
    const split = encode(OP_PING, [], true);
    split[0] = OP_PING as u8;
    expect(status(split, true, MAX)).toBe("invalid: invalid control frame");
    expect(status(encode(OP_BINARY, Buffer.alloc(100), true), true, 99)).toBe(
      "invalid: message too long",
    );
    const reserved = encode(OP_TEXT, utf8Encode("x"), true);
    reserved[0] = reserved[0] | 0x40u8;
    expect(status(reserved, true, MAX)).toBe(
      "invalid: reserved bits set (no extension was negotiated)",
    );
    const unknown = encode(OP_TEXT, [], true);
    unknown[0] = 0x83u8;
    expect(status(unknown, true, MAX)).toBe("invalid: unknown opcode");
  });

  it("rejects a 64-bit length with the top bit set whatever the limit", () => {
    // (§5.2); the largest legal one is just a frame that has not arrived.
    const top: u8[] = [0x82u8, 127u8, 0x80u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8];
    expect(status(top, false, 9223372036854775807)).toBe(
      "invalid: frame length with the top bit set",
    );
    const huge: u8[] = [
      0x82u8,
      127u8,
      0x7fu8,
      0xffu8,
      0xffu8,
      0xffu8,
      0xffu8,
      0xffu8,
      0xffu8,
      0xffu8,
    ];
    expect(status(huge, false, 9223372036854775807)).toBe("partial");
    expect(status(huge, false, MAX)).toBe("invalid: message too long");
  });

  it("takes masking keys from the OS random source", () => {
    const keys = new Set<u32>();
    for (let i = 0; i < 200; i++) {
      keys.add(maskKey());
    }
    expect(keys.size).toBeGreaterThan(190);
  });

  it("knows the close codes that may go on the wire, and cuts a reason to 123 bytes", () => {
    const codes: i64[] = [];
    const all: i64[] = [
      999,
      1000,
      1003,
      1004,
      1005,
      1006,
      1007,
      1014,
      1015,
      2999,
      3000,
      4999,
      5000,
      65536,
    ];
    for (const c of all) {
      if (validCloseCode(c)) {
        codes.push(c);
      }
    }
    expect(codes).toEqual([1000, 1003, 1007, 1014, 3000, 4999]);
    // At a character boundary.
    const cut = closePayload(1001, "é".repeat(100));
    expect(cut.length).toBe(124);
    expect(((cut[0] as i64) << 8) | (cut[1] as i64)).toBe(1001);
    expect(utf8Decode(cut.slice(2)).length).toBe(61);
    expect(closePayload(1000).length).toBe(2);
    expect(utf8Decode(closePayload(4000, "bye").slice(2))).toBe("bye");
  });
});

describe("the byte helpers", () => {
  // `u8[].xorMask` (prelude), and std/net/websocket/text.vlt and byte_buf.vlt: ranged UTF-8
  // checks and decoding, text copied into a buffer, `ByteBuf`. (Was the golden std/websocket_bytes.)
  it("xorMask applies the mask most significant byte first, from start", () => {
    const data: u8[] = [];
    for (let i = 0; i < 21; i++) {
      data.push(i as u8);
    }
    data.xorMask(0x01020304u32, 2, 19);
    expect(data).toEqual([
      0u8,
      1u8,
      3u8,
      1u8,
      7u8,
      1u8,
      7u8,
      5u8,
      11u8,
      13u8,
      11u8,
      9u8,
      15u8,
      9u8,
      15u8,
      13u8,
      19u8,
      21u8,
      19u8,
      19u8,
      20u8,
    ]);
    // Its own inverse.
    data.xorMask(0x01020304u32, 2, 19);
    expect(data.every((b, i) => (b as i64) == i)).toBe(true);
    expect(data.length).toBe(21);
    const all: u8[] = [0u8, 0u8, 0u8, 0u8, 0u8];
    all.xorMask(0xa1b2c3d4u32);
    expect(all).toEqual([161u8, 178u8, 195u8, 212u8, 161u8]);
  });

  it("utf8Prefix: how much of a range is valid, -1 when no continuation can fix it", () => {
    const text = utf8Encode("aé✓😀");
    expect(text.length).toBe(10);
    expect([utf8Prefix(text, 0, 10), utf8Prefix(text, 0, 9), utf8Prefix(text, 0, 2)]).toEqual([
      10,
      6,
      1,
    ]);
    expect([utf8Prefix(text, 1, 3), utf8Prefix(text, 2, 6), utf8Prefix(text, 4, 4)]).toEqual([
      2,
      -1,
      0,
    ]);
    expect(utf8Prefix([0x61u8, 0xffu8, 0x62u8], 0, 3)).toBe(-1);
    expect(utf8Prefix([0xedu8, 0xa0u8, 0x80u8], 0, 3)).toBe(-1);
  });

  it("textOf: a range as a string, null if it is not valid UTF-8", () => {
    const text = utf8Encode("aé✓😀");
    expect(textOf(text, 1, 6)).toBe("é✓");
    expect(textOf(text, 0, 0)).toBe("");
    expect(textOf(text, 0, 2)).toBeNull();
    expect(textOf(text, -4, 9223372036854775807)).toBe("😀");
  });

  it("setText and ByteBuf", () => {
    const buf = new ByteBuf();
    expect(buf.data.length).toBe(0);
    expect(buf.cap).toBe(0);
    buf.append([1u8, 2u8, 3u8]);
    const hej: u8[] = Buffer.alloc(Buffer.byteLength("héj"));
    setText(hej, "héj", 0);
    buf.append(hej);
    buf.append([9u8, 9u8]);
    expect(buf.data).toEqual([1u8, 2u8, 3u8, 104u8, 195u8, 169u8, 106u8, 9u8, 9u8]);
    expect(buf.cap).toBe(256);
    buf.dropFront(3);
    expect(textOf(buf.data, 0, 4)).toBe("héj");
    expect(buf.data.length).toBe(6);
    for (let i = 0; i < 300; i++) {
      buf.append([7u8]);
    }
    expect(buf.data.length).toBe(306);
    expect(buf.cap).toBe(512);
    expect([buf.data[5], buf.data[305]]).toEqual([9u8, 7u8]);
    const taken = buf.take();
    expect(taken.length).toBe(306);
    expect(buf.data.length).toBe(0);
    expect(buf.cap).toBe(0);
    buf.adopt([4u8, 5u8]);
    buf.append([6u8]);
    expect(buf.data).toEqual([4u8, 5u8, 6u8]);
    expect(buf.cap).toBeGreaterThanOrEqual(3);
  });
});

describe("a peer that stops reading", () => {
  it("bounds how long a close waits for the flusher", async () => {
    // A closing WebSocket does not wait for ever: the flusher gets a bounded time to write what
    // is queued (30 s through the public API; the internal pieces are driven here with 300 ms),
    // then the stream is aborted and the queue reports the failure. (Was the golden
    // std/websocket_close_bounded.)
    const listener = await listen("127.0.0.1:0");
    const peer = spawn(async () => await listener.accept());
    const stream = await connect(`127.0.0.1:${listener.port}`);
    const silent = await peer;

    // Fill the socket first: once it takes nothing more, it never will (the peer reads
    // nothing), so the flusher's write is stuck however large the socket buffers are. (A
    // Windows socket takes a whole 64 MB write while it has any room, so queueing a lot is not
    // enough.)
    const chunk = Buffer.alloc(1048576);
    while (stream.tryWrite(chunk) > 0) {}

    // 4 MB queued at once (past the high-water mark), for one flusher to take in one batch.
    const tx = shared(new Mutex<SendQueue>(new SendQueue(false, new Reader(true, []))));
    const r0 = tx.with((q) => {
      let r: i64 = 0;
      for (let i = 0; i < 4; i++) {
        r |= q.pushBytes(OP_BINARY, chunk);
      }
      return r;
    });
    expect((r0 & START) != 0).toBe(true);
    // Waits until the flusher has taken the batch.
    const taken = tx.with((q) => q.out.length > 0 ? q.wait() : null);
    if ((r0 & START) != 0) {
      spawn(flush(stream, tx.clone()));
    }
    if (taken != null) {
      await taken.receive();
    }
    expect(tx.with((q) => q.flushing && q.stopped == "" && q.out.length == 0)).toBe(true);

    const bye = closePayload(1000);
    const r = tx.with((q) => q.pushBytes(OP_CLOSE, bye));
    // As `closeDown`: whoever queues into an idle connection starts its flusher (this one is
    // busy).
    settleQuietly(stream, tx, r);
    expect((r & STATUS) != CLOSED && (r & STATUS) != FAILED).toBe(true);
    const t0 = performance.now();
    await finish(stream, tx, 300);
    const took = performance.now() - t0;
    expect(took).toBeGreaterThanOrEqual(250);
    expect(took).toBeLessThan(10000);
    expect(tx.with((q) => q.stopped)).toBe("ECONNRESET");
    expect(tx.with((q) => q.flushing)).toBe(false);
    // Nothing more is queued, and finishing again returns at once.
    expect((tx.with((q) => q.pushBytes(OP_BINARY, [1u8])) & STATUS) == FAILED).toBe(true);
    await finish(stream, tx, 300);
    tx.with((q) => q.release());
    stream.close();
    silent.close();
    listener.close();
  });

  it("stops the server reading pings once their pongs pass the high-water mark", async () => {
    // A peer that sends pings and never reads the pongs: the server stops reading from it until
    // it takes them, so the pongs cannot pile up in the server's memory. The client's 64 MB of
    // pings then never all get written. (Was the golden std/websocket_ping_flood.)
    const server = await serveWebSockets((ws: WebSocket, path: string) => {
      spawn(async () => {
        try {
          while ((await ws.receive()) != null) {}
        } catch (e) {}
      });
    });
    const client = await rawConnect(server.port, "/ws");
    const ping: u8[] = Buffer.alloc(125);
    const flood = spawn(async () => {
      for (let i = 0; i < 64 * 1048576 / 131; i++) {
        await client.send(OP_PING, ping);
      }
    });
    let stopped = false;
    try {
      await timeout(flood, 3000);
    } catch (e) {
      stopped = e instanceof TimeoutError;
    }
    expect(stopped).toBe(true);
    // Closed, not only aborted: the server's pending pongs then fail, which ends its session.
    client.conn.abort();
    client.close();
    server.close();
  });

  it("goes on reading after a ping while the application's frames fill the queue", async () => {
    // Only pongs past the mark stop the reader. (Was the golden
    // std/websocket_ping_while_sending.)
    const listener = await listen("127.0.0.1:0");
    const peer = spawn(async () => await listener.accept());
    const stream = await connect(`127.0.0.1:${listener.port}`);
    const silent = await peer;

    // 2 MB of the application's frames queued, nothing written yet.
    const tx = shared(new Mutex<SendQueue>(new SendQueue(false, new Reader(true, []))));
    const chunk = Buffer.alloc(262144);
    for (let i = 0; i < 8; i++) {
      tx.with((q) => q.pushBytes(OP_BINARY, chunk));
    }
    expect(tx.with((q) => q.out.length > 1048576)).toBe(true);
    let goesOn = true;
    try {
      await timeout(other(stream, tx.clone(), new Step(PING, "", [1u8])), 5000);
    } catch (e) {
      goesOn = !(e instanceof TimeoutError);
    }
    expect(goesOn).toBe(true);
    stream.abort();
    stream.close();
    silent.close();
    listener.close();
  });

  it(
    "stops reading once more than the high-water mark of pongs waits, and goes on after",
    async () => {
      // Pings answered while nothing is written (the flusher is stuck on a peer that reads
      // nothing). (Was the golden std/websocket_pong_limit.)
      const listener = await listen("127.0.0.1:0");
      const peer = spawn(async () => await listener.accept());
      const stream = await connect(`127.0.0.1:${listener.port}`);
      const silent = await peer;

      const tx = shared(new Mutex<SendQueue>(new SendQueue(false, new Reader(true, []))));
      // A flusher is running (and writes nothing): pongs stay queued.
      tx.with((q) => {
        q.flushing = true;
      });
      const payload: u8[] = Buffer.alloc(125);
      let answered = 0;
      let stopped = false;
      while (!stopped && answered < 100000) {
        try {
          await timeout(other(stream, tx.clone(), new Step(PING, "", payload)), 2000);
          answered++;
        } catch (e) {
          stopped = e instanceof TimeoutError;
        }
      }
      const bytes = tx.with((q) => q.pongs);
      expect(stopped).toBe(true);
      expect(bytes).toBeGreaterThan(HIGH_WATER);
      // By one pong.
      expect(bytes - 127).toBeLessThanOrEqual(HIGH_WATER);

      // The flusher takes what is queued: the next ping is answered and reading goes on.
      tx.with((q) => q.take());
      let readsOn = true;
      try {
        await timeout(other(stream, tx.clone(), new Step(PING, "", payload)), 5000);
      } catch (e) {
        readsOn = false;
      }
      expect(readsOn).toBe(true);
      // A pong refused (a close frame is queued) is not counted: it never goes out.
      tx.with((q) => {
        q.take();
        q.pushBytes(OP_CLOSE, []);
      });
      for (let i = 0; i < 10000; i++) {
        tx.with((q) => q.pushPong(payload));
      }
      expect(tx.with((q) => q.pongs)).toBe(0);
      stream.abort();
      stream.close();
      silent.close();
      listener.close();
    },
  );
});
