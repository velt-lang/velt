// velt/net/websocket: WebSocket connections (RFC 6455), accepted by a std/http server or opened as
// a client (`ws://`, `wss://`). Written in Velt on std/net streams: framing in std/websocket/frame,
// the receiving side in std/websocket/reader and receive, the sending side in std/websocket/queue
// and writer, the handshake in std/websocket/handshake, topics in std/websocket/topics.
//
// Server: inside a `serve` handler, `upgradeWebSocket(req)` claims the connection and gives
// back the `101` response the handler must return; talk to the socket from a spawned task:
//   if (isWebSocketRequest(req)) {
//     const up = upgradeWebSocket(req);
//     spawn(session(up.socket));
//     return up.response;
//   }
// Client: `const ws = await connectWebSocket("ws://127.0.0.1:8080/chat");`.
//
// `WebSocket` is a handle like std/net's `TcpStream` (its copies share one connection, so one
// task can wait in `receive` while another `send`s), released by `close()`: a `receive` already
// waiting then sees the peer's close (null), and later operations through any copy throw
// `IoError` `EBADF` ("handle is closed"). Messages are pulled with `receive` (null once the peer
// has closed); pings are answered automatically. Only HTTP/1.1 upgrades are supported (HTTP/2
// clients fall back to HTTP/1.1 for WebSockets).

import { IoError } from "velt/io/error";
import { IoResult } from "velt/native/result";
import { ioError } from "velt/native/error";
import { isUpgradeRequest, upgradeConnection } from "velt/net/http/server/upgrade";
import { HttpRequest } from "velt/net/http/server/request";
import { HttpResponse } from "velt/net/http/server/response";
import { Request } from "velt/net/http/fetch/request";
import { Response } from "velt/net/http/fetch/response";
import { TcpStream } from "velt/net";
import { setText } from "velt/net/websocket/bytes";
import {
  OP_BINARY,
  OP_TEXT,
  closePayload,
  headSize,
  validCloseCode,
  writeHead,
} from "velt/net/websocket/frame";
import { acceptKey, open } from "velt/net/websocket/handshake";
import { DIRECT, QUEUED, START, SendQueue } from "velt/net/websocket/queue";
import { BINARY, CLOSED, READ, Reader, Step } from "velt/net/websocket/reader";
import { READ_CHUNK, ReadTurn, other } from "velt/net/websocket/receive";
import { leave, publish as publishFrame, subscribe, unsubscribe } from "velt/net/websocket/topics";
import { Tx, closeDown, closedHandle, flush, settle, writeDirect } from "velt/net/websocket/writer";

/** One received message: text, or binary data. */
export class WsMessage {
  /** True for a binary message (`data`), false for text (`text`). */
  isBinary: bool;
  text: string;
  data: u8[];

  constructor(isBinary: bool, text: string, data: u8[]) {
    this.isBinary = isBinary;
    this.text = text;
    this.data = data;
  }
}

// Queueing a frame, in plain functions: `send` and `receive` keep only what they await (a task
// per connection holds their state, so its size is memory per connection), and the queue is
// used as it is in the handle, so a send that only queues touches no reference count.
function pushText(ws: WebSocket, text: string): i64 {
  if (ws.tx == null) {
    throw closedHandle();
  }
  return ws.tx!.with((q) => q.pushText(OP_TEXT, text));
}

function pushBytes(ws: WebSocket, data: u8[]): i64 {
  if (ws.tx == null) {
    throw closedHandle();
  }
  return ws.tx!.with((q) => q.pushBytes(OP_BINARY, data));
}

// Starts what sends a frame queued with status `r` (not `QUEUED`); false if the caller has to
// wait or the frame was refused (`settle` then).
function begun(ws: WebSocket, r: i64): bool {
  if (r == DIRECT) {
    // Most likely a reply from the task that reads this connection: written here.
    writeDirect(ws.handle, ws.tx!);
    return true;
  }
  if (r == START) {
    spawn(flush(ws.handle, ws.tx!.clone()));
    return true;
  }
  return false;
}

// The connection's queue (plain functions like this one keep temporaries out of `receive`'s
// state).
function queueOf(ws: WebSocket): Tx {
  const tx = ws.tx;
  if (tx == null) {
    throw closedHandle();
  }
  return tx;
}

function readTurn(tx: Tx): ReadTurn {
  return new ReadTurn(tx.clone());
}

// The reader's first step for a `receive`.
function firstStep(tx: Tx): Step {
  return tx.with((q) => q.next(true));
}

// What the reading task read, handed to the reader; its next step. A failed read is thrown.
function fedStep(tx: Tx, chunk: u8[], turn: ReadTurn): Step {
  turn.done();
  return tx.with((q) => q.fed(chunk));
}

function message(step: Step): WsMessage | null {
  if (step.kind == CLOSED) {
    return null;
  }
  return new WsMessage(step.kind == BINARY, step.text, step.data);
}

// A whole unmasked frame, for `publish`.
function textFrame(text: string): u8[] {
  const len = Buffer.byteLength(text) as i64;
  const out = Buffer.alloc((headSize(len, false) + len) as usize);
  const at = writeHead(out, 0, OP_TEXT, len, false, 0u32);
  setText(out, text, at);
  return out;
}

function binaryFrame(data: u8[]): u8[] {
  const len = data.length as i64;
  const out = Buffer.alloc((headSize(len, false) + len) as usize);
  const at = writeHead(out, 0, OP_BINARY, len, false, 0u32);
  out.set(data, at as usize);
  return out;
}

/**
 * An open WebSocket connection. A handle like std/net's `TcpStream`: its copies share one
 * connection, so one task can wait in `receive` while another `send`s. Released by `close()`.
 */
export struct WebSocket implements AsyncIterable<WsMessage, IoError> {
  // The connection's stream (std/net).
  private handle: TcpStream;
  // The connection's send queue, which also holds its receiving side: one shared value, so a
  // copy of the handle costs one reference. Always there on a connection std made.
  private tx?: Tx;

  private stream(): TcpStream {
    return this.handle;
  }

  private sending(): Tx {
    const tx = this.tx;
    if (tx == null) {
      throw closedHandle();
    }
    return tx;
  }

  /**
   * Sends a text message: returns once it is queued (everything queued goes out in one write),
   * waiting while more than 1 MiB is queued for this connection.
   */
  async send(text: string): Promise<void> {
    const r = pushText(this, text);
    if (r != QUEUED && !begun(this, r)) {
      const waiting = settle(this.stream(), queueOf(this), r);
      await waiting;
    }
  }

  /** Sends a binary message, queued like `send`. */
  async sendBytes(data: u8[]): Promise<void> {
    const r = pushBytes(this, data);
    if (r != QUEUED && !begun(this, r)) {
      const waiting = settle(this.stream(), queueOf(this), r);
      await waiting;
    }
  }

  /** The next message, or null once the peer has closed the connection. */
  async receive(): Promise<WsMessage | null> {
    const tx = queueOf(this);
    let step = firstStep(tx);
    // The read is the only thing awaited in place: a task that waits here is what an idle
    // connection costs.
    while (step.kind > BINARY) {
      if (step.kind == READ) {
        const turn = readTurn(tx);
        const r = await this.handle.read(READ_CHUNK);
        step = fedStep(tx, r, turn);
      } else {
        const handled = other(this.stream(), tx, step);
        step = await handled;
      }
    }
    return message(step);
  }

  /**
   * Subscribes this connection to `topic`: messages published to it (`publish`) are sent here
   * until `unsubscribe(topic)` or the connection closes. Subscribing twice is a no-op.
   */
  async subscribe(topic: string): Promise<void> {
    const tx = this.sending();
    if (!subscribe(this.handle, tx, topic)) {
      throw closedHandle();
    }
  }

  /** Leaves `topic` (nothing happens if this connection is not subscribed to it). */
  unsubscribe(topic: string) {
    const tx = this.tx;
    if (tx != null) {
      unsubscribe(tx, topic);
    }
  }

  /**
   * Sends `text` to every connection subscribed to `topic` except this one (Bun's
   * `ws.publish`); the number of connections it was queued for.
   */
  publish(topic: string, text: string): i64 {
    return publishFrame(
      topic,
      textFrame(text),
      headSize(Buffer.byteLength(text) as i64, false),
      this.tx ?? null,
    );
  }

  /** `publish` with a binary message. */
  publishBytes(topic: string, data: u8[]): i64 {
    return publishFrame(
      topic,
      binaryFrame(data),
      headSize(data.length as i64, false),
      this.tx ?? null,
    );
  }

  /**
   * `for await (const m of ws)`: the messages until the peer has closed the connection.
   * Leaving the loop early leaves the connection open.
   */
  async *[Symbol.asyncIterator](): AsyncIterator<WsMessage, IoError> {
    while (true) {
      const m = await this.receive();
      if (m == null) {
        return;
      }
      yield m;
    }
  }

  /**
   * Sends a close frame (`code` 1000 = normal closure; 1000-1003, 1007-1014 or 3000-4999, else
   * `IoError` "EINVAL", nothing is sent and the connection stays open) after everything queued,
   * waits until it is written, and releases the handle. Closing a connection the peer already closed, or closing
   * twice, is fine; other operations on the handle (through any copy) throw `IoError` `EBADF`
   * afterwards.
   */
  async close(code: i64 = 1000, reason: string = ""): Promise<void> {
    if (!validCloseCode(code)) {
      throw new IoError(
        "EINVAL",
        `invalid WebSocket close code ${code} (1000-1003, 1007-1014 or 3000-4999)`,
      );
    }
    const tx = this.tx;
    if (tx == null) {
      return;
    }
    const stream = this.stream();
    const closing = closeDown(stream, tx, closePayload(code, reason));
    const topics = await closing;
    if (topics == null) {
      return;
    }
    for (const topic of topics) {
      leave(tx, topic);
    }
    stream.close();
  }
}

/**
 * Sends `text` to every connection subscribed to `topic` (`ws.subscribe`): the frame is encoded
 * once and queued for each subscriber, which sends it with whatever else is queued. A subscriber
 * with more than 16 MiB already queued misses the message. Returns the number of connections it
 * was queued for.
 */
export function publish(topic: string, text: string): i64 {
  return publishFrame(
    topic,
    textFrame(text),
    headSize(Buffer.byteLength(text) as i64, false),
    null,
  );
}

/** `publish` with a binary message. */
export function publishBytes(topic: string, data: u8[]): i64 {
  return publishFrame(topic, binaryFrame(data), headSize(data.length as i64, false), null);
}

/** What `upgradeWebSocket` returns: the connection, and the response to return from the handler. */
export struct WebSocketUpgrade {
  socket: WebSocket;
  response: Response;
}

/** Whether `req` asks to be upgraded to a WebSocket. */
export function isWebSocketRequest(req: Request): bool {
  return isUpgradeRequest(req, "websocket");
}

// A connection over `stream`; `prefix`: bytes already read from it past the handshake.
function connection(stream: TcpStream, client: bool, prefix: u8[]): WebSocket {
  return WebSocket {
    handle: stream,
    tx: shared(new Mutex<SendQueue>(new SendQueue(client, new Reader(!client, prefix)))),
  };
}

/**
 * Accepts a WebSocket upgrade request `serve` received (throws `IoError` "EINVAL" if `req` is
 * not one, or was already accepted): the `101` is queued at once, ahead of what the socket
 * sends; return `response` from the handler.
 */
export function upgradeWebSocket(req: Request): WebSocketUpgrade {
  const key = req.headers.get("sec-websocket-key") ?? "";
  if (key == "") {
    throw new IoError("EINVAL", "not a WebSocket upgrade request");
  }
  try {
    const up = upgradeConnection(req, "websocket", { "sec-websocket-accept": acceptKey(key) });
    return WebSocketUpgrade {
      socket: connection(up.stream, false, up.head),
      response: up.response,
    };
  } catch (e) {
    throw new IoError("EINVAL", "not a WebSocket upgrade request");
  }
}

/**
 * Accepts a WebSocket upgrade request on a `velt/net/http` server: answers `101 Switching
 * Protocols` with the handshake's accept key and returns the socket (the connection is the
 * socket's from then on). A request that is not a valid handshake (RFC 6455 §4.2.1: `GET`,
 * HTTP/1.1, `Upgrade: websocket`, `Connection: upgrade`, `Sec-WebSocket-Version: 13`, a key of 16
 * base64-encoded bytes) is answered here instead (RFC 6455 §4.2.2): 426 with
 * `Sec-WebSocket-Version: 13` for another version or no upgrade, else 400; it then returns null.
 * Throws `IoError` "EINVAL" if a response was started.
 */
export function acceptWebSocket(req: HttpRequest, res: HttpResponse): WebSocket | null {
  if (res.sent()) {
    throw new IoError("EINVAL", "a response was already started");
  }
  const version = req.header("sec-websocket-version");
  if (!req.isUpgrade("websocket") || (version != null && version != "13")) {
    res.status(426);
    res.header("Upgrade", "websocket");
    res.header("Sec-WebSocket-Version", "13");
    res.send("a WebSocket handshake (version 13) is required");
    return null;
  }
  const key = req.header("sec-websocket-key") ?? "";
  if (!req.isMethod("GET") || version == null || !validKey(key)) {
    res.status(400);
    res.send("invalid WebSocket handshake");
    return null;
  }
  const stream = res.upgrade("websocket", [["Sec-WebSocket-Accept", acceptKey(key)]]);
  // What the client sent past the request (its first frames, if it did not wait for the 101).
  return connection(stream, false, req.takeUnread());
}

// Whether `key` is 16 bytes in base64: 22 characters of its alphabet and `==`.
function validKey(key: string): bool {
  if (key.length != 24 || !key.endsWith("==")) {
    return false;
  }
  for (let i = 0; i < 22; i++) {
    const c = key.charCodeAt(i);
    const letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    if (!letter && !(c >= 48 && c <= 57) && c != 43 && c != 47) {
      return false;
    }
  }
  return true;
}

export struct WsConnectOptions {
  /** Extra trusted CA certificates (PEM) for `wss://`, e.g. a private or test CA. */
  ca?: string;
}

/** Opens a client connection to a `ws://` or `wss://` URL. */
export async function connectWebSocket(
  url: string,
  opts: WsConnectOptions = {},
): Promise<WebSocket> {
  const opened = await open(url, opts.ca ?? "");
  return connection(opened.stream, true, opened.rest);
}
