// velt/net/websocket (internal): `Target`, where a `ws://` or `wss://` URL points.

import { IoError } from "velt/io/error";
import { URL } from "velt/net/url/url";

/** Where a `ws://` or `wss://` URL points. */
export struct Target {
  secure: bool;
  /** Without the brackets of an IPv6 literal. */
  host: string;
  port: i64;
  /** Path and query. */
  path: string;
}

function invalid(what: string): IoError {
  return new IoError("EINVAL", what);
}

/** Parses a WebSocket URL; throws `IoError` "EINVAL" for anything else. */
export function target(url: string): Target {
  const u = URL.parse(url);
  if (u == null) {
    throw invalid("invalid WebSocket URL");
  }
  if (u.protocol != "ws:" && u.protocol != "wss:") {
    throw invalid("WebSocket URLs start with ws:// or wss://");
  }
  const secure = u.protocol == "wss:";
  let host = u.hostname;
  if (host.startsWith("[") && host.endsWith("]")) {
    host = host.slice(1, (host.length as i64) - 1);
  }
  if (host == "") {
    throw invalid("WebSocket URL without a host");
  }
  const port: i64 = u.port == "" ? (secure ? 443 : 80) : (parseInt(u.port, 10) as i64);
  return Target { secure: secure, host: host, port: port, path: u.pathname + u.search };
}
