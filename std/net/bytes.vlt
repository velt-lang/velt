// std/net_bytes (std-internal): writing a `u8[]` to a stream (`velt_rt_tcp_write_bytes`).
// Not part of the public API.

import { IoStatus } from "velt/native/result";

declare async function velt_rt_tcp_write_bytes(s: u64, data: u8[]): Promise<IoStatus>;
declare function velt_rt_tcp_try_write(s: u64, data: u8[]): u64;

/** Writes what the stream handle `s` takes of `data` right now; the number of bytes written. */
export function tryWriteTo(s: u64, data: u8[]): i64 {
  return velt_rt_tcp_try_write(s, data) as i64;
}

/** Writes every byte of `data` to the stream handle `s`. */
export async function writeBytesTo(s: u64, data: u8[]): Promise<IoStatus> {
  return await velt_rt_tcp_write_bytes(s, data);
}
