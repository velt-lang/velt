// velt/net (internal): opening sockets on the reactor of the executor in Velt (#2649 step 2,
// std/net/tcp_sched.velt): `connect` (each address of the name in turn, non-blocking), `listen`,
// `accept`, the bound port and the peer's address, and the results and errors they report as the
// runtime's functions do (`IoResult`, `IoStatus`; codes of std/native/error.velt, messages as
// Rust's "… (os error N)").
//
// Names are resolved with `getaddrinfo`, which blocks the worker while it asks DNS (numeric
// addresses and /etc/hosts answer at once): the runtime runs it on its blocking pool; a resolver
// in Velt is #2649 step 2's.

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { CString } from "velt/ffi/c_string";
import { Ptr } from "velt/ffi/ptr";
import { utf8DecodeLossy } from "velt/encoding/utf8";
import { addressLoad, promiseAt } from "velt/lang/intrinsics";
import * as r from "#reactor";
import * as sys from "#net-sys";
import * as io from "velt/lang/hooks/sched_io";
import * as m from "velt/lang/hooks/sched_mem";
import * as tb from "velt/lang/hooks/sched_io_table";
import * as wt from "velt/lang/hooks/sched_io_wait";

const SOCK_STREAM: i32 = 1;
const IPPROTO_TCP: i32 = 6;
const TCP_NODELAY: i32 = 1;
const AI_PASSIVE: i32 = 1;
const AI_ADDRLEN: usize = 16;
const AI_NEXT: usize = 40;
const AI_FAMILY: usize = 4;
const AI_PROTOCOL: usize = 12;
/** A `sockaddr_storage` and its length word. */
const SA_SIZE: usize = 128;

// Pointers are `Ptr`s, as in a program's own declarations of these symbols: one C symbol has one
// signature in a program. Addresses become `Ptr`s with `m.ptr` (0 passes `NULL`).
declare c("c") function getaddrinfo(
  host: CString,
  port: CString,
  hints: Ptr<u8>,
  res: Ptr<u8>,
): i32;
declare c("c") function freeaddrinfo(ai: Ptr<u8>): void;
declare c("c") function gai_strerror(e: i32): Ptr<u8>;
declare c("c") function socket(family: i32, kind: i32, protocol: i32): i32;
declare c("c") function connect$net(fd: i32, addr: Ptr<u8>, len: u32): i32;
declare c("c") function bind(fd: i32, addr: Ptr<u8>, len: u32): i32;
declare c("c") function listen(fd: i32, backlog: i32): i32;
declare c("c") function getsockopt(
  fd: i32,
  level: i32,
  name: i32,
  value: Ptr<u8>,
  len: Ptr<u8>,
): i32;
declare c("c") function setsockopt(fd: i32, level: i32, name: i32, value: Ptr<u8>, len: u32): i32;
declare c("c") function getsockname(fd: i32, addr: Ptr<u8>, len: Ptr<u8>): i32;
declare c("c") function getpeername(fd: i32, addr: Ptr<u8>, len: Ptr<u8>): i32;
declare c("c") function inet_ntop(
  family: i32,
  src: Ptr<u8>,
  dst: Ptr<u8>,
  size: u32,
): Ptr<u8> | null;
declare c("c") function strerror(e: i32): Ptr<u8>;
declare c("c") function close$net(fd: i32): i32;

/** The NUL-terminated text at `p` (a message of the C library, an address inet_ntop wrote). */
function cText(p: usize): string {
  const out: u8[] = [];
  let i: usize = 0;
  while (true) {
    // SAFETY: a byte of the text, up to and including its NUL.
    const b = unsafe { addressLoad<u8>(p + i) };
    if (b === 0) {
      return utf8DecodeLossy(out);
    }
    out.push(b);
    i++;
  }
}

/** A successful status. */
export function ok(): IoStatus {
  return { code: 0, message: "" };
}

/** The status of failure `errno`, as Rust words it. */
export function osError(errno: i32): IoStatus {
  // SAFETY: strerror returns a NUL-terminated message.
  const text = cText(Ptr.addressOf(unsafe { strerror(errno) }));
  return { code: sys.codeOf(errno), message: `${text} (os error ${errno})` };
}

/** The status of a closed handle. */
export function closed(): IoStatus {
  return { code: 16, message: "handle is closed" };
}

/** The status of an aborted stream. */
export function aborted(): IoStatus {
  return { code: 8, message: "the stream was aborted" };
}

/** `IoResult` of `v`. */
export function value<T>(v: T): IoResult<T> {
  return { code: 0, message: "", value: v };
}

/** `IoResult` failing with `s` (`zero`: the value slot's "owns nothing"). */
export function failed<T>(s: IoStatus, zero: T): IoResult<T> {
  return { code: s.code, message: s.message, value: zero };
}

/** "host:port" (the host may be "[v6]"): the host, the port. */
function split(addr: string): string[] {
  const at = addr.lastIndexOf(":");
  if (at < 0) {
    return [addr, ""];
  }
  let host = addr.slice(0, at);
  if (host.startsWith("[") && host.endsWith("]")) {
    host = host.slice(1, (host.length as i64) - 1);
  }
  return [host, addr.slice(at + 1)];
}

/** The addresses of "host:port" (`getaddrinfo`'s list, freed by the caller), or a failure. */
function resolve(addr: string, passive: bool): IoResult<usize> {
  const parts = split(addr);
  if (parts[1] === "") {
    return failed({ code: 4, message: "invalid socket address" }, 0);
  }
  const host = parts[0] === "" ? (passive ? "0.0.0.0" : "localhost") : parts[0];
  const hints = m.zeroed(64);
  m.st32(hints, passive ? (AI_PASSIVE as u32) : 0);
  m.st32(hints + 8, SOCK_STREAM as u32);
  // A name holding a NUL is no address (as the runtime's parse says): caught here, so these
  // functions throw nothing, as the runtime's (std/net/rt.velt) don't.
  let hostC: CString;
  let portC: CString;
  try {
    hostC = new CString(host);
    portC = new CString(parts[1]);
  } catch (e) {
    m.release(hints);
    return failed({ code: 4, message: "invalid socket address" }, 0);
  }
  const res = m.zeroed(16);
  // SAFETY: NUL-terminated host and port, hints and a result word in raw memory.
  const e = unsafe { getaddrinfo(hostC, portC, m.ptr(hints), m.ptr(res)) };
  const list = m.ld(res);
  m.release(hints);
  m.release(res);
  if (e !== 0) {
    // SAFETY: gai_strerror returns a NUL-terminated message.
    const why = cText(Ptr.addressOf(unsafe { gai_strerror(e) }));
    return failed({ code: 99, message: `failed to lookup address information: ${why}` }, 0);
  }
  return value(list);
}

/** Sets an `int` socket option to 1. */
function setOn(fd: i32, level: i32, name: i32): void {
  const one = m.alloc(16);
  m.st32(one, 1);
  // SAFETY: an int option in `one`.
  unsafe {
    setsockopt(fd, level, name, m.ptr(one), 4);
  }
  m.release(one);
}

/** Closes descriptor `fd` (not registered). */
function closeFd(fd: i32): void {
  // SAFETY: a descriptor this module opened, not used after.
  unsafe {
    close$net(fd);
  }
}

/** A registered source and handle for connected or listening socket `fd`: the handle. */
function adopt(fd: i32, flags: u32, ready: u32): IoResult<u64> {
  const s = io.register(fd, flags, ready);
  if (s === 0) {
    const st = osError(r.errno());
    closeFd(fd);
    return failed(st, 0);
  }
  return value(tb.handleOf(s));
}

/** `connect("host:port")`: each address in turn, until one answers; the stream's handle. */
export async function connect(addr: string): Promise<IoResult<u64>> {
  const found = resolve(addr, false);
  if (found.code !== 0) {
    return failed({ code: found.code, message: found.message }, 0);
  }
  const list = found.value;
  let last: IoStatus = { code: 4, message: "could not resolve to any addresses" };
  let ai = list;
  while (ai !== 0) {
    const r1 = await connectOne(ai);
    if (r1.code === 0) {
      // SAFETY: the list getaddrinfo made, freed once.
      unsafe {
        freeaddrinfo(m.ptr(list));
      }
      return r1;
    }
    last = { code: r1.code, message: r1.message };
    ai = m.ld(ai + AI_NEXT);
  }
  // SAFETY: as above.
  unsafe {
    freeaddrinfo(m.ptr(list));
  }
  return failed(last, 0);
}

/** Connects to the address of `addrinfo` `ai`: the handle, or the failure. */
async function connectOne(ai: usize): Promise<IoResult<u64>> {
  const family = m.ld32(ai + AI_FAMILY) as i32;
  // SAFETY: no precondition.
  const fd =
    unsafe { socket(family, SOCK_STREAM | r.SOCKET_FLAGS, m.ld32(ai + AI_PROTOCOL) as i32) };
  if (fd < 0) {
    return failed(osError(r.errno()), 0);
  }
  const prep = r.prepare(fd);
  if (prep !== 0) {
    closeFd(fd);
    return failed(osError(prep), 0);
  }
  setOn(fd, IPPROTO_TCP, TCP_NODELAY);
  // SAFETY: the address and its length from getaddrinfo's entry.
  const rc = unsafe { connect$net(fd, m.ptr(m.ld(ai + sys.AI_ADDR)), m.ld32(ai + AI_ADDRLEN)) };
  if (rc === 0) {
    return adopt(fd, 0, io.READ | io.WRITE);
  }
  const e = r.errno();
  if (e !== r.EINPROGRESS && e !== r.EINTR) {
    closeFd(fd);
    return failed(osError(e), 0);
  }
  // Registered once connecting (Linux reports an unconnected socket hung up): not ready yet.
  const got = adopt(fd, 0, 0);
  if (got.code !== 0) {
    return got;
  }
  const h = got.value;
  // SAFETY: `waitFor` makes a heap future, given up to the promise.
  await unsafe { promiseAt<void>(wt.waitFor(h, io.K_WRITE, 0, 0)) };
  const s = tb.lookup(h);
  if (s === 0) {
    return failed(closed(), 0);
  }
  const word = m.zeroed(16);
  m.st32(word + 8, 4);
  // SAFETY: an int option and its length word.
  unsafe {
    getsockopt(fd, sys.SOL_SOCKET, sys.SO_ERROR, m.ptr(word), m.ptr(word + 8));
  }
  const err = m.ld32(word) as i32;
  m.release(word);
  if (err !== 0) {
    discard(h, s);
    return failed(osError(err), 0);
  }
  // Connected: the first read tries at once (writable is known).
  m.st32(s + io.S_READY, m.ld32(s + io.S_READY) | io.READ);
  return got;
}

/** Closes the source of handle `h` at once (nothing sent on it yet). */
function discard(h: u64, s: usize): void {
  tb.forget(h);
  closeFd(m.ld(s + io.S_FD) as i32);
  io.free(s);
}

/** `listen("host:port")`: the listener's handle. */
export async function listenOn(addr: string): Promise<IoResult<u64>> {
  const found = resolve(addr, true);
  if (found.code !== 0) {
    return failed({ code: found.code, message: found.message }, 0);
  }
  const ai = found.value;
  // SAFETY: no precondition.
  const fd = unsafe { socket(m.ld32(ai + AI_FAMILY) as i32, SOCK_STREAM | r.SOCKET_FLAGS, 0) };
  let st = ok();
  if (fd < 0) {
    st = osError(r.errno());
  } else {
    const prep = r.prepare(fd);
    setOn(fd, sys.SOL_SOCKET, sys.SO_REUSEADDR);
    // SAFETY: the address and its length from getaddrinfo's entry; a backlog.
    if (prep !== 0) {
      st = osError(prep);
    } else if (unsafe { bind(fd, m.ptr(m.ld(ai + sys.AI_ADDR)), m.ld32(ai + AI_ADDRLEN)) } !== 0) {
      st = osError(r.errno());
    } else if (unsafe { listen(fd, 1024) } !== 0) {
      st = osError(r.errno());
    }
  }
  // SAFETY: the list getaddrinfo made, freed once.
  unsafe {
    freeaddrinfo(m.ptr(ai));
  }
  if (st.code !== 0) {
    if (fd >= 0) {
      closeFd(fd);
    }
    return failed(st, 0);
  }
  return adopt(fd, io.F_LISTENER, io.READ);
}

/** The next connection of listener `l`: its stream's handle. */
export async function accept(l: u64): Promise<IoResult<u64>> {
  while (true) {
    const s = tb.lookup(l);
    if (s === 0) {
      return failed(closed(), 0);
    }
    const fd = r.accept(m.ld(s + io.S_FD) as i32, 0, 0);
    if (fd >= 0) {
      setOn(fd, IPPROTO_TCP, TCP_NODELAY);
      return adopt(fd, 0, io.READ | io.WRITE);
    }
    const e = r.errno();
    if (e === r.EAGAIN) {
      io.notReady(s, io.READ);
      // SAFETY: `waitFor` makes a heap future, given up to the promise.
      await unsafe { promiseAt<void>(wt.waitFor(l, io.K_READ, 0, 0)) };
    } else if (e !== r.EINTR && sys.codeOf(e) !== 8) {
      return failed(osError(e), 0);
    }
  }
}

/** The port listener `l` is bound to (0 once closed). */
export function portOf(l: u64): u32 {
  const s = tb.lookup(l);
  if (s === 0) {
    return 0;
  }
  const sa = m.zeroed(SA_SIZE + 8);
  m.st32(sa + SA_SIZE, SA_SIZE as u32);
  // SAFETY: a sockaddr_storage and its length word.
  unsafe {
    getsockname(m.ld(s + io.S_FD) as i32, m.ptr(sa), m.ptr(sa + SA_SIZE));
  }
  const port = ((m.ld32(sa) >> 16) & 0xffff) as u32;
  m.release(sa);
  return ((port & 0xff) << 8) | (port >> 8);
}

/** Closes listener `l` (nothing more to accept); again does nothing. */
export function closeListener(l: u64): void {
  const s = tb.lookup(l);
  if (s !== 0) {
    discard(l, s);
  }
}

/** The peer's "ip:port" of stream `h` ("" once closed). */
export function peerOf(h: u64): string {
  const s = tb.lookup(h);
  if (s === 0) {
    return "";
  }
  const sa = m.zeroed(SA_SIZE + 8);
  m.st32(sa + SA_SIZE, SA_SIZE as u32);
  // SAFETY: a sockaddr_storage and its length word.
  const rc = unsafe { getpeername(m.ld(s + io.S_FD) as i32, m.ptr(sa), m.ptr(sa + SA_SIZE)) };
  let out = "";
  if (rc === 0) {
    const v6 = sys.familyOf(sa) === sys.AF_INET6;
    const text = m.zeroed(64);
    // SAFETY: the address bytes of the sockaddr (at 8 for v6, 4 for v4), 64 bytes of text room.
    unsafe {
      inet_ntop(v6 ? sys.AF_INET6 : 2, m.ptr(sa + (v6 ? 8 : 4)), m.ptr(text), 64);
    }
    const ip = cText(text);
    m.release(text);
    const p = (m.ld32(sa) >> 16) & 0xffff;
    const port = ((p & 0xff) << 8) | (p >> 8);
    out = v6 ? `[${ip}]:${port}` : `${ip}:${port}`;
  }
  m.release(sa);
  return out;
}
