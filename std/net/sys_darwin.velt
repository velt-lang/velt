// velt/net (internal): the socket constants and layouts of macOS for velt/net's sockets on the
// reactor of the executor in Velt (std/net/tcp_sched.velt, #2649 step 2): what differs per OS in
// `<sys/socket.h>`, `<netdb.h>` and `<errno.h>`, and the runtime's error code of an `errno`
// (std/native/error.velt).

import { addressLoad, addressStore } from "velt/lang/intrinsics";

/** `AF_INET6`. */
export const AF_INET6: i32 = 30;
/** `SOL_SOCKET`, `SO_ERROR`, `SO_REUSEADDR`. */
export const SOL_SOCKET: i32 = 0xffff;
export const SO_ERROR: i32 = 0x1007;
export const SO_REUSEADDR: i32 = 4;
/** `SO_BROADCAST` (UDP sockets: std/net/udp/udp_sched.velt). */
export const SO_BROADCAST: i32 = 0x20;
/** Where `struct addrinfo` keeps `ai_addr` (macOS has it after `ai_canonname`). */
export const AI_ADDR: usize = 32;

/** The family of the `sockaddr` at `sa`: `sa_len` is byte 0, the family byte 1. */
export function familyOf(sa: usize): i32 {
  // SAFETY: `sa` is a socket address the OS filled.
  return unsafe { addressLoad<u8>(sa + 1) } as i32;
}

/** Before socket `fd` connects to `sa`: nothing here (a refused connect fails at once). */
export function beforeConnect(fd: i32, sa: usize): void {}

// A Unix socket address (`sockaddr_un`, velt dev's channel, std/dev/handover_posix.velt): a
// `u8` length and a `u8` family, then up to 104 bytes of path. `cmsghdr`: a `u32` length, the
// level and type `int`s, then the data.
export const SUN_PATH_AT: usize = 2;
export const SUN_PATH_MAX: usize = 104;
export const CMSG_LEVEL: usize = 4;
export const CMSG_TYPE: usize = 8;
export const CMSG_DATA: usize = 12;

/** Writes the length and family of a Unix socket address at `sa` with a `len`-byte path. */
export function unixAddress(sa: usize, len: usize): u32 {
  const n = SUN_PATH_AT + len + 1;
  // SAFETY: `sa` is a zeroed `sockaddr_un`.
  unsafe {
    addressStore<u8>(sa, n as u8);
    addressStore<u8>(sa + 1, 1);
  }
  return n as u32;
}

/** The runtime's error code (std/native/error.velt) of `errno` `e`. */
export function codeOf(e: i32): i32 {
  switch (e) {
    case 2:
      return 1;
    case 13:
    case 1:
      return 2;
    case 17:
      return 3;
    case 22:
      return 4;
    case 60:
      return 6;
    case 61:
      return 7;
    case 54:
    case 53:
    case 57:
      return 8;
    case 48:
      return 9;
    case 32:
      return 10;
    case 78:
      return 12;
    case 9:
      return 16;
    default:
      return 99;
  }
}
