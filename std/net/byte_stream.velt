// velt/net (internal): `ByteStream`, the reading and writing a TLS stream runs over and offers:
// a `TcpStream`, a `TlsStream`, or a program's own transport (#2392).

import { Uint8Array } from "velt/lang/typed_array/uint8_array";

/**
 * A duplex byte stream: what `startTls` runs over and what `TcpStream` and `TlsStream` both
 * are, so code can hold either (a database driver that may or may not upgrade its connection).
 */
export interface ByteStream {
  /** Reads what has arrived into `buf`: the number of bytes, or null at the end of the stream. */
  readInto(buf: Uint8Array): Promise<number | null>;
  /** Resolves once `data[start..end]` is written. */
  writeBytes(data: u8[] | Uint8Array, start: number, end?: number): Promise<void>;
  /**
   * Half-closes: ends what this side sends, once what was written before has gone. Reading stays
   * open until `close()`, so the peer's answer still arrives.
   */
  halfClose(): Promise<void>;
  /** Closes the stream at once, both ways. */
  close(): void;
  /** This stream as a `TryStream`, or null if it can't read and write without waiting. */
  tryStream(): TryStream | null {
    return null;
  }
}

/**
 * A `ByteStream` that also reads and writes without waiting, as a `TcpStream` does. A `TlsStream`
 * over one has `tryRead`, `writeBytesLater` and `tryWrite`.
 */
export interface TryStream extends ByteStream {
  /**
   * Reads what has arrived into `buf[start..end]`: the number of bytes, 0 when nothing has yet, or
   * null at the end of the stream.
   */
  tryRead(buf: u8[] | Uint8Array, start: number, end?: number): number | null;
  /** Writes what can go now of `data[start..end]`, and returns how many bytes that was. */
  tryWrite(data: u8[] | Uint8Array, start: number, end?: number): i64;
  /** Queues `data[start..end]`, copied, for the task's next wait: the bytes left to send. */
  writeBytesLater(data: u8[] | Uint8Array, start: number, end?: number): i64;
}
