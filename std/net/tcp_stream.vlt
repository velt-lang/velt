// velt/net (internal): `TcpStream`, a connected TCP (or TLS) stream: a Copy handle released by
// `close()` (std/net/index.vlt).

import { unwrapIo } from "velt/native/result";
import { checkIo } from "velt/native/status";
import { tryWriteTo, writeBytesTo } from "velt/net/bytes";
import { clampTo, toIndex } from "velt/net/offsets";
import {
  velt_rt_tcp_abort,
  velt_rt_tcp_alpn,
  velt_rt_tcp_close,
  velt_rt_tcp_drained,
  velt_rt_tcp_park,
  velt_rt_tcp_peer_addr,
  velt_rt_tcp_read,
  velt_rt_tcp_read_string,
  velt_rt_tcp_readable,
  velt_rt_tcp_readable_within,
  velt_rt_tcp_shutdown,
  velt_rt_tcp_try_read_into,
  velt_rt_tcp_try_write_range,
  velt_rt_tcp_unpark,
  velt_rt_tcp_write,
  velt_rt_tcp_write_later,
  velt_rt_tcp_write_later_range,
  velt_rt_tcp_write_range,
} from "velt/net/rt";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { AbortSignal } from "velt/task";

/** A connected TCP stream. */
export struct TcpStream {
  private handle: u64;

  /** The next 1..max bytes (`max == 0`: up to 64 KiB); an empty array means end of stream. */
  async read(max: u64 = 0): Promise<u8[]> {
    return unwrapIo(await velt_rt_tcp_read(this.handle, max));
  }

  /**
   * The next chunk as UTF-8 (a character split across reads is completed by the next call,
   * invalid bytes become U+FFFD); "" means end of stream.
   */
  async readString(max: u64 = 0): Promise<string> {
    return unwrapIo(await velt_rt_tcp_read_string(this.handle, max));
  }

  /**
   * Reads what has arrived into `buf`, at most `buf.length` bytes, straight from the socket
   * (nothing is allocated or copied on the way for a plain TCP stream): the number of bytes
   * read, or `null` at the end of the stream (as Deno's `conn.read`). Waits only when nothing
   * has arrived yet. An empty `buf` reads nothing and returns 0. Reusing one buffer per
   * connection, and `subarray` views of what was read, keeps a server from copying its input.
   */
  async readInto(buf: Uint8Array): Promise<number | null> {
    const start = buf.off as u64;
    const end = (buf.off + buf.len) as u64;
    if (start === end) {
      return 0;
    }
    while (true) {
      const n = unwrapIo(velt_rt_tcp_try_read_into(this.handle, buf.buf.bytes, start, end));
      if (n >= 0) {
        return n === 0 ? null : n as number;
      }
      checkIo(await velt_rt_tcp_readable(this.handle));
    }
  }

  /**
   * Reads what has arrived into `buf[start..end]` without waiting: the number of bytes read,
   * `0` when nothing has arrived yet (`await readable()`, then try again), or `null` at the end
   * of the stream. A plain TCP stream reads straight into `buf`, so a parser can read into its
   * own buffer with nothing allocated or copied (`readInto` does the waiting for a
   * `Uint8Array`). `RangeError` for an empty or out-of-range range.
   */
  tryRead(buf: u8[] | Uint8Array, start: number = 0, end?: number): number | null {
    let bytes: u8[];
    let base: u64 = 0;
    let len: number;
    if (buf instanceof Uint8Array) {
      bytes = buf.buf.bytes;
      base = buf.off as u64;
      len = buf.len as number;
    } else {
      bytes = buf;
      len = buf.length as number;
    }
    // Indices as JS takes them (truncated, NaN as 0); then the range must be inside `buf`.
    const from = toIndex(start);
    const to = end === undefined ? len : toIndex(end);
    if (!(from >= 0 && from < to && to <= len)) {
      throw new RangeError(`tryRead: the range ${from}..${to} is empty or outside 0..${len}`);
    }
    const n = unwrapIo(
      velt_rt_tcp_try_read_into(this.handle, bytes, base + (from as u64), base + (to as u64)),
    );
    if (n > 0) {
      return n as number;
    }
    return n === 0 ? null : 0;
  }

  /**
   * Resolves once a `tryRead` may find data, the end of the stream or an error (it may also
   * find nothing yet: wait again). Holds no buffer while it waits.
   */
  async readable(): Promise<void> {
    checkIo(await velt_rt_tcp_readable(this.handle));
  }

  /**
   * `readable()` with a limit: true once a `tryRead` may find something, false when `ms`
   * milliseconds passed first or `signal` was aborted. One wait in the runtime, so nothing of it
   * is left behind (unlike `Promise.race` with a timer): a server waiting for the next request on
   * each idle connection.
   */
  async readableWithin(ms: number, signal: AbortSignal | null = null): Promise<bool> {
    const h = signal == null ? 0u64 : signal.handle();
    return unwrapIo(await velt_rt_tcp_readable_within(this.handle, ms as i64, h)) == 1;
  }

  /** The protocol TLS's ALPN chose (`"h2"`), or null (none, not TLS); waits for the handshake. */
  async alpnProtocol(): Promise<string | null> {
    const p = unwrapIo(await velt_rt_tcp_alpn(this.handle));
    return p == "" ? null : p;
  }

  /** Resolves once every byte is written; `data` is copied at the call. */
  async write(data: string): Promise<void> {
    checkIo(await velt_rt_tcp_write(this.handle, data));
  }

  /**
   * Resolves once every byte is written. What the socket takes at the call is written from
   * `data` itself; only what it cannot take yet is copied.
   */
  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const bytes = data.buf.bytes;
      const from = at + clampTo(start, len);
      checkIo(
        await velt_rt_tcp_write_range(this.handle, bytes, from, at + clampTo(end ?? len, len)),
      );
      return;
    }
    if (start === 0 && end == null) {
      checkIo(await writeBytesTo(this.handle, data));
      return;
    }
    const len = data.length as number;
    const from = clampTo(start, len);
    checkIo(await velt_rt_tcp_write_range(this.handle, data, from, clampTo(end ?? len, len)));
  }

  /**
   * Writes what the socket takes of `data` right now, without waiting, and returns the number
   * of bytes written (0 when it takes nothing now, while an earlier `write` is still going on,
   * for a TLS stream, and after an error, which the next `write` reports). For protocols that
   * send small messages: when everything was written there is nothing to await.
   */
  tryWrite(data: u8[] | Uint8Array, start: number = 0, end?: number): i64 {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      const to = at + clampTo(end ?? len, len);
      return velt_rt_tcp_try_write_range(this.handle, data.buf.bytes, from, to) as i64;
    }
    if (start === 0 && end == null) {
      return tryWriteTo(this.handle, data);
    }
    const len = data.length as number;
    const from = clampTo(start, len);
    return velt_rt_tcp_try_write_range(this.handle, data, from, clampTo(end ?? len, len)) as i64;
  }

  /**
   * Queues `data` to be sent when the current task next waits (or finishes), together with
   * everything else it queued until then: one system call where a write each would make
   * several, and nothing held back past a wait. Returns the number of bytes still to be sent on
   * this stream; `await drained(max)` keeps that bounded. A `write` goes after what was queued
   * before it. Throws `IoError` once sending failed (the error a `write` would have reported),
   * the stream was aborted or the handle closed.
   */
  writeLater(data: string): i64 {
    return unwrapIo(velt_rt_tcp_write_later(this.handle, data)) as i64;
  }

  /** `writeLater` of bytes `start..end` of `data` (copied at the call). */
  writeBytesLater(data: u8[] | Uint8Array, start: number = 0, end?: number): i64 {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      const to = at + clampTo(end ?? len, len);
      return unwrapIo(velt_rt_tcp_write_later_range(this.handle, data.buf.bytes, from, to)) as i64;
    }
    const len = data.length as number;
    const from = clampTo(start, len);
    const to = clampTo(end ?? len, len);
    return unwrapIo(velt_rt_tcp_write_later_range(this.handle, data, from, to)) as i64;
  }

  /**
   * Resolves once at most `max` bytes queued by `writeLater` (or a `write` after them) are still
   * to be sent: right away when there are no more, otherwise once the peer has read enough.
   * Throws `IoError` when sending failed.
   */
  async drained(max: number = 0): Promise<void> {
    checkIo(await velt_rt_tcp_drained(this.handle, (max < 0 ? 0 : max) as u64));
  }

  /**
   * Half-close: the peer reads end of stream, after every byte written or queued (`writeLater`)
   * before; this side can still read.
   */
  shutdown() {
    checkIo(velt_rt_tcp_shutdown(this.handle));
  }

  /** The peer's "ip:port" ("" once the handle is closed). */
  peerAddr(): string {
    return velt_rt_tcp_peer_addr(this.handle);
  }

  /**
   * Fails the operations in flight on this stream (a `write` to a peer that stopped reading
   * would otherwise never finish) and every later one; nothing more is sent or received. The
   * handle stays open until `close()`.
   */
  abort() {
    velt_rt_tcp_abort(this.handle);
  }

  /**
   * Releases the handle: later operations through any copy throw `IoError` `EBADF`, and closing
   * again does nothing. The socket closes once the operations in flight have finished.
   */
  close() {
    velt_rt_tcp_close(this.handle);
  }

  /**
   * Hands this idle stream to the runtime's pool under `key` (std only: `fetch`'s keep-alive
   * connections, crates/velt_rt/src/net/park.rs), for `TcpStream.unpark(key)` in any task. This
   * copy must not be used any more.
   */
  private park(key: string) {
    velt_rt_tcp_park(this.handle, key);
  }

  /**
   * The stream most recently parked under `key` that is still open, or null (std only); with
   * `settled`, only one idle long enough that a close sent right after its last response has
   * arrived (for a request that may not be sent twice). One idle too long is closed.
   */
  private static unpark(key: string, settled: bool = false): TcpStream | null {
    const h = velt_rt_tcp_unpark(key, settled ? 1 : 0);
    return h == 0 ? null : TcpStream { handle: h };
  }

  /** The stream behind runtime handle `h` (std only: a connect the `fetch` client raced). */
  private static ofHandle(h: u64): TcpStream {
    return TcpStream { handle: h };
  }
}
