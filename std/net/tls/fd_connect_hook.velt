// velt/net (internal): the `connect` hook of std/net/tls/fd_reactor.velt: a stub that answers null
// (this program has no TLS client on the reactor), which std/net/tls/fd_client.velt's more specific `extend`
// replaces when the program loads it.

import { IoResult } from "velt/native/result";

/** `connectTls` on the reactor: a TLS stream, or null when this program has no TLS client. */
export interface ConnectHook {
  connect(
    addr: string,
    serverName: string,
    ca: string,
    alpn: string,
  ): Promise<IoResult<u64> | null>;
}

/** What has `ConnectHook`: the stub below, or std/net/tls/fd_client.velt's. */
export struct TlsConnectSide {}

/** The types the stub below is for. */
export interface ConnectStubbed {}

extend TlsConnectSide implements ConnectStubbed {}

extend<T extends ConnectStubbed> T implements ConnectHook {
  async connect(
    addr: string,
    serverName: string,
    ca: string,
    alpn: string,
  ): Promise<IoResult<u64> | null> {
    return null;
  }
}
