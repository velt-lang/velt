// velt/net (internal): `TlsStream`, a TLS 1.3 client stream written in Velt (#2392) over any
// `ByteStream`, as `startTls` returns it.

import { utf8Encode } from "velt/encoding/utf8";
import { IoError } from "velt/io/error";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { ByteStream } from "velt/net/byte_stream";
import { clampTo, toIndex } from "velt/net/offsets";
import { DATA, ENDED, TlsEngine } from "velt/net/tls/tls_engine";
import { Turns } from "velt/net/tls/turns";

/**
 * A TLS 1.3 connection over another stream (`startTls`): the reading and writing of a
 * `TcpStream`, encrypted. It is itself a `ByteStream`. `shutdown()` sends TLS's close_notify and
 * half-closes, `close()` closes at once. Reads go one at a time in call order, as writes do.
 *
 * It holds keys and sequence numbers, so it is never copied: passing it to another task is a
 * compile error while it is still used here, and a panic where the compiler cannot see that.
 *
 * With `verify: false`, required for now, the server is not authenticated: this protects against
 * passive observers only, and anyone who can intercept the connection can impersonate the server.
 */
export class TlsStream implements ByteStream {
  private e: TlsEngine;
  private reads: Turns;

  /** The stream of a connection whose handshake is done (std only: `startTls`). */
  constructor(engine: TlsEngine) {
    this.e = engine;
    this.reads = new Turns();
  }

  /** The next 1..max bytes (`max == 0`: whatever has arrived); an empty array means end of stream. */
  async read(max: u64 = 0): Promise<u8[]> {
    await this.reads.turn();
    try {
      if (!(await this.e.fill())) {
        return [];
      }
      const have = this.e.available();
      const n = max == 0 || (max as usize) > have ? have : (max as usize);
      return this.e.take(n);
    } finally {
      this.reads.done();
    }
  }

  /**
   * Reads what has arrived into `buf`, at most `buf.length` bytes: the number of bytes read, or
   * `null` at the end of the stream. Waits only when nothing has arrived yet.
   */
  async readInto(buf: Uint8Array): Promise<number | null> {
    if (buf.len == 0) {
      return 0;
    }
    await this.reads.turn();
    try {
      if (!(await this.e.fill())) {
        return null;
      }
      const have = this.e.available();
      const n = have < buf.len ? have : buf.len;
      this.e.takeInto(buf.buf.bytes, buf.off, n);
      return n as number;
    } finally {
      this.reads.done();
    }
  }

  /**
   * Reads what has arrived into `buf[start..end]` without waiting: the number of bytes read, `0`
   * when nothing has arrived yet (wait on the transport, then try again), or `null` at the end of
   * the stream. For a stream over a `TcpStream`, whose `readable()` is the wait unless
   * `hasBuffered()` says the bytes are here already. Nothing waits, so a holder can keep this
   * stream behind a `Mutex` and read and write from whichever task has its turn. Not during `read`
   * or `readInto`. `RangeError` for an empty or out-of-range range.
   */
  tryRead(buf: u8[] | Uint8Array, start: number = 0, end?: number): number | null {
    let bytes: u8[];
    let base: usize = 0;
    let len: number;
    if (buf instanceof Uint8Array) {
      bytes = buf.buf.bytes;
      base = buf.off;
      len = buf.len as number;
    } else {
      bytes = buf;
      len = buf.length as number;
    }
    const from = toIndex(start);
    const to = end === undefined ? len : toIndex(end);
    if (!(from >= 0 && from < to && to <= len)) {
      throw new RangeError(`tryRead: the range ${from}..${to} is empty or outside 0..${len}`);
    }
    if (this.reads.busy) {
      throw new IoError("EBUSY", "TLS stream: a read is in progress");
    }
    const found = this.e.tryFill();
    if (found == ENDED) {
      return null;
    }
    if (found != DATA) {
      return 0;
    }
    const have = this.e.available();
    const room = (to - from) as usize;
    const n = have < room ? have : room;
    this.e.takeInto(bytes, base + (from as usize), n);
    return n as number;
  }

  /**
   * Whether a `tryRead` has something to find that the transport won't announce: decrypted bytes
   * not taken yet, or a whole record or the end of the stream among what was read.
   */
  hasBuffered(): bool {
    return this.e.hasBuffered();
  }

  /** Resolves once `data` (as UTF-8) is written. */
  async write(data: string): Promise<void> {
    const b = utf8Encode(data);
    await this.e.write(b, 0, b.length);
  }

  /** Resolves once `data[start..end]` is written, in records of at most 16 KiB. */
  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      const to = at + clampTo(end ?? len, len);
      await this.e.write(data.buf.bytes, from as usize, to as usize);
      return;
    }
    const len = data.length as number;
    await this.e.write(data, clampTo(start, len) as usize, clampTo(end ?? len, len) as usize);
  }

  /**
   * Seals `data[start..end]` now and queues the records on the transport, to go when the current
   * task next waits: the bytes the transport has left to send, for its `drained`. For a stream over
   * a `TcpStream`, not during a `write`. Throws `IoError` once the connection failed.
   */
  writeBytesLater(data: u8[] | Uint8Array, start: number = 0, end?: number): i64 {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      return this.e.out.writeLater(
        data.buf.bytes,
        from as usize,
        (at + clampTo(end ?? len, len)) as usize,
      );
    }
    const len = data.length as number;
    return this.e.out.writeLater(
      data,
      clampTo(start, len) as usize,
      clampTo(end ?? len, len) as usize,
    );
  }

  /**
   * Writes `data[start..end]` now, for a last small message before the connection ends: the number
   * of bytes written, or 0 if the socket didn't take the records whole, and then the connection has
   * failed (half a record can't be taken back). For a stream over a `TcpStream`, not during a
   * `write`.
   */
  tryWrite(data: u8[] | Uint8Array, start: number = 0, end?: number): i64 {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      return this.e.out.tryWrite(
        data.buf.bytes,
        from as usize,
        (at + clampTo(end ?? len, len)) as usize,
      );
    }
    const len = data.length as number;
    return this.e.out.tryWrite(
      data,
      clampTo(start, len) as usize,
      clampTo(end ?? len, len) as usize,
    );
  }

  /** `shutdown()`, as `ByteStream` has it. */
  async halfClose(): Promise<void> {
    await this.e.shutdown();
  }

  /** The protocol agreed with ALPN, or null. */
  async alpnProtocol(): Promise<string | null> {
    return this.e.alpn;
  }

  /** Sends close_notify and half-closes the underlying stream; reading stays open. */
  async shutdown(): Promise<void> {
    await this.e.shutdown();
  }

  /** Closes the underlying stream at once (no close_notify). */
  close() {
    this.e.close();
  }

  /** Closes the connection at the end of its scope. */
  [Symbol.dispose]() {
    this.e.close();
  }
}
