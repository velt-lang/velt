// velt/net (internal): `TlsStream`, a TLS 1.3 client stream written in Velt (#2392) over any
// `ByteStream`, as `startTls` returns it.

import { utf8Encode } from "velt/encoding/utf8";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { ByteStream } from "velt/net/byte_stream";
import { clampTo } from "velt/net/offsets";
import { TlsEngine } from "velt/net/tls/tls_engine";
import { Turns } from "velt/net/tls/turns";

/**
 * A TLS 1.3 connection over another stream (`startTls`): the reading and writing of a
 * `TcpStream`, encrypted. It is itself a `ByteStream`. `shutdown()` sends TLS's close_notify and
 * half-closes, `close()` closes at once. Reads go one at a time in call order, as writes do.
 *
 * It holds keys and sequence numbers, so it is never copied: passing it to another task is a
 * compile error while it is still used here, and a panic where the compiler cannot see that.
 *
 * With `verify: false`, required for now, the server is not authenticated: this protects against
 * passive observers only, and anyone who can intercept the connection can impersonate the server.
 */
export class TlsStream implements ByteStream {
  private e: TlsEngine;
  private reads: Turns;

  /** The stream of a connection whose handshake is done (std only: `startTls`). */
  constructor(engine: TlsEngine) {
    this.e = engine;
    this.reads = new Turns();
  }

  /** The next 1..max bytes (`max == 0`: whatever has arrived); an empty array means end of stream. */
  async read(max: u64 = 0): Promise<u8[]> {
    await this.reads.turn();
    try {
      if (!(await this.e.fill())) {
        return [];
      }
      const have = this.e.available();
      const n = max == 0 || (max as usize) > have ? have : (max as usize);
      return this.e.take(n);
    } finally {
      this.reads.done();
    }
  }

  /**
   * Reads what has arrived into `buf`, at most `buf.length` bytes: the number of bytes read, or
   * `null` at the end of the stream. Waits only when nothing has arrived yet.
   */
  async readInto(buf: Uint8Array): Promise<number | null> {
    if (buf.len == 0) {
      return 0;
    }
    await this.reads.turn();
    try {
      if (!(await this.e.fill())) {
        return null;
      }
      const have = this.e.available();
      const n = have < buf.len ? have : buf.len;
      this.e.takeInto(buf.buf.bytes, buf.off, n);
      return n as number;
    } finally {
      this.reads.done();
    }
  }

  /** Resolves once `data` (as UTF-8) is written. */
  async write(data: string): Promise<void> {
    const b = utf8Encode(data);
    await this.e.write(b, 0, b.length);
  }

  /** Resolves once `data[start..end]` is written, in records of at most 16 KiB. */
  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      const to = at + clampTo(end ?? len, len);
      await this.e.write(data.buf.bytes, from as usize, to as usize);
      return;
    }
    const len = data.length as number;
    await this.e.write(data, clampTo(start, len) as usize, clampTo(end ?? len, len) as usize);
  }

  /** `shutdown()`, as `ByteStream` has it. */
  async halfClose(): Promise<void> {
    await this.e.shutdown();
  }

  /** The protocol agreed with ALPN, or null. */
  async alpnProtocol(): Promise<string | null> {
    return this.e.alpn;
  }

  /** Sends close_notify and half-closes the underlying stream; reading stays open. */
  async shutdown(): Promise<void> {
    await this.e.shutdown();
  }

  /** Closes the underlying stream at once (no close_notify). */
  close() {
    this.e.close();
  }

  /** Closes the connection at the end of its scope. */
  [Symbol.dispose]() {
    this.e.close();
  }
}
