// velt/net (internal): `TlsEngine`, a TLS 1.3 client connection over any `ByteStream`: the
// handshake driven by `ClientHandshake`, the reading side of the record layer (RFC 8446 §5), and
// what comes after the handshake (NewSessionTicket, KeyUpdate, alerts, close_notify).
//
// Built for throughput: `RecordReader` reads and decrypts records in place in one reused
// buffer, and writes seal up to four records in place in a second reused buffer and go out in
// one transport write (`RecordWriter`). Opening and sealing a record allocate nothing; each
// transport read allocates its view of the buffer (3 blocks, all freed), `TlsStream.read` its
// result, and the handshake and each post-handshake message allocate.

import { IoError } from "velt/io/error";
import { ByteStream } from "velt/net/byte_stream";
import { TlsFailure, UNEXPECTED_MESSAGE } from "velt/net/tls/alert";
import {
  checkKeyUpdate,
  ClientHandshake,
  FINISHED_DONE,
  HANDSHAKE_KEYS,
  KEY_UPDATE,
  NEW_SESSION_TICKET,
  SEND_RETRY,
} from "velt/net/tls/client_handshake";
import { HelloInput } from "velt/net/tls/client_hello";
import { HandshakeBuffer } from "velt/net/tls/handshake_buffer";
import { nextSecret } from "velt/net/tls/key_schedule";
import { RecordCipher } from "velt/net/tls/record_cipher";
import {
  APPLICATION_DATA,
  CHANGE_CIPHER_SPEC,
  END,
  HANDSHAKE,
  MORE,
  RecordReader,
} from "velt/net/tls/record_reader";
import { RecordWriter } from "velt/net/tls/record_writer";

/** What `tryFill` found: nothing has arrived yet. */
export const NOTHING_YET: u8 = 0;
/** What `tryFill` found: application data is buffered. */
export const DATA: u8 = 1;
/** What `tryFill` found: the end of the stream. */
export const ENDED: u8 = 2;

/** One TLS 1.3 client connection. */
export class TlsEngine {
  private r: RecordReader;
  /** The writing half. */
  out: RecordWriter;
  private hs: HandshakeBuffer;
  private suite: usize;
  private readSecret: u8[];
  /** The protocol chosen with ALPN, or null. */
  alpn: string | null;
  /** The server's certificate chain (DER, leaf first), unchecked with `verify: false`. */
  certificates: u8[][];

  /** A connection over `t`, before its handshake. */
  constructor(t: ByteStream) {
    this.r = new RecordReader(t);
    this.out = new RecordWriter(t);
    this.hs = new HandshakeBuffer();
    this.suite = 0;
    this.readSecret = [];
    this.alpn = null;
    this.certificates = [];
  }

  /**
   * Runs the client handshake for `input` with the X25519 key `privateKey`. A non-empty session
   * id turns on middlebox compatibility (a ChangeCipherSpec before the second flight).
   */
  async handshake(input: HelloInput, privateKey: u8[]): Promise<void> {
    const h = new ClientHandshake(input, privateKey);
    const compat = input.sessionId.length > 0;
    let ccsSent = false;
    try {
      await this.out.sendPlain(HANDSHAKE, h.hello(), 1);
      while (!h.done()) {
        const step = h.onMessage(await this.handshakeMessage(false));
        if (step == SEND_RETRY) {
          if (compat) {
            await this.out.sendCcs();
            ccsSent = true;
          }
          await this.out.sendPlain(HANDSHAKE, h.retryHello, 3);
        } else if (step == HANDSHAKE_KEYS) {
          this.hs.checkEmpty();
          this.suite = h.suite;
          this.r.cipher = new RecordCipher(h.suite, h.serverHandshake);
          this.out.cipher = new RecordCipher(h.suite, h.clientHandshake);
        } else if (step == FINISHED_DONE) {
          this.hs.checkEmpty();
          // The ChangeCipherSpec (once, in compatibility mode) goes out with the flight.
          await this.out.sendProtected(HANDSHAKE, h.lastFlight, compat && !ccsSent);
          this.readSecret = h.serverApplication;
          this.r.cipher = new RecordCipher(h.suite, this.readSecret);
          this.out.secret = h.clientApplication;
          this.out.suite = h.suite;
          this.out.cipher = new RecordCipher(h.suite, h.clientApplication);
        }
      }
      this.r.handshaking = false;
      this.alpn = h.alpn;
      this.certificates = h.certificates;
    } catch (e) {
      throw await this.out.failed(e);
    }
  }

  /** Waits until application data is buffered: false at the end of the stream. */
  async fill(): Promise<bool> {
    const r = this.r;
    while (r.available() == 0) {
      const f = this.out.failure;
      if (f != null) {
        throw f;
      }
      if (r.ended) {
        return false;
      }
      try {
        const type = await r.next(true);
        if (type == APPLICATION_DATA) {
          r.keepContent();
        } else if (type == HANDSHAKE) {
          this.addHandshake();
          while (this.hs.hasMessage()) {
            await this.postHandshake(this.hs.take());
          }
        } else if (type != END) {
          throw new TlsFailure(UNEXPECTED_MESSAGE, `unexpected record type ${type}`);
        }
      } catch (e) {
        throw await this.out.failed(e);
      }
    }
    return true;
  }

  /**
   * `fill` without waiting, over a transport that can: DATA, NOTHING_YET, or ENDED. The state
   * changes only here, so whoever then waits on the transport and goes away leaves nothing half done.
   */
  tryFill(): u8 {
    const t = this.out.tryTransport();
    const r = this.r;
    try {
      while (r.available() == 0) {
        const f = this.out.failure;
        if (f != null) {
          throw f;
        }
        if (r.ended) {
          return ENDED;
        }
        const step = r.step();
        if (step == MORE) {
          const got = r.tryMore(t);
          if (got == null) {
            r.cut(true);
          } else if (got == 0) {
            return NOTHING_YET;
          }
          continue;
        }
        const type = step as u8;
        if (type == APPLICATION_DATA) {
          r.keepContent();
        } else if (type == HANDSHAKE) {
          this.addHandshake();
          while (this.hs.hasMessage()) {
            this.noteHandshake(this.hs.take());
          }
        } else if (type != END) {
          throw new TlsFailure(UNEXPECTED_MESSAGE, `unexpected record type ${type}`);
        }
      }
    } catch (e) {
      throw this.out.failedNow(e);
    }
    return DATA;
  }

  /**
   * Whether `tryFill` has something to find without the transport: data, a record, or the end. When
   * false, what comes next comes through the transport.
   */
  hasBuffered(): bool {
    const r = this.r;
    return r.available() > 0 || r.ended || this.out.failure != null || r.hasRecord();
  }

  /** Application data buffered by `fill`. */
  available(): usize {
    return this.r.available();
  }

  /** Copies `n` buffered bytes (at most `available()`) to `out[at..]` and consumes them. */
  takeInto(out: u8[], at: usize, n: usize) {
    this.r.takeInto(out, at, n);
  }

  /** The next `n` buffered bytes (at most `available()`), consumed. */
  take(n: usize): u8[] {
    return this.r.take(n);
  }

  /** Writes `bytes[from..to]` as application data, after the writes called before. */
  async write(bytes: u8[], from: usize, to: usize): Promise<void, IoError> {
    await this.out.write(bytes, from, to);
  }

  /** Sends close_notify (once) and half-closes the transport: reading stays open (§6.1). */
  async shutdown(): Promise<void> {
    await this.out.shutdown();
  }

  /** Closes the transport at once. */
  close() {
    this.out.close();
  }

  // The next whole handshake message (with its header) during the handshake.
  private async handshakeMessage(after: bool): Promise<u8[]> {
    while (!this.hs.hasMessage()) {
      const r = this.r;
      const type = await r.next(after);
      if (type == HANDSHAKE) {
        this.addHandshake();
      } else if (type == CHANGE_CIPHER_SPEC) {
        // Middlebox compatibility (RFC 8446 §5): one byte, 1, and nothing else.
        if (r.cend - r.cstart != 1 || r.buf[r.cstart] != 1) {
          throw new TlsFailure(UNEXPECTED_MESSAGE, "a malformed ChangeCipherSpec");
        }
      } else {
        throw new TlsFailure(
          UNEXPECTED_MESSAGE,
          `unexpected record type ${type} during the handshake`,
        );
      }
    }
    return this.hs.take();
  }

  // Adds the last record's content to the handshake messages. A handshake record is never empty
  // (RFC 8446 §5.1).
  private addHandshake() {
    const r = this.r;
    if (r.cstart == r.cend) {
      throw new TlsFailure(UNEXPECTED_MESSAGE, "an empty handshake record");
    }
    this.hs.append(r.buf, r.cstart, r.cend);
  }

  private async postHandshake(m: u8[]): Promise<void> {
    const type = m[0];
    if (type == NEW_SESSION_TICKET) {
      return;
    }
    if (type != KEY_UPDATE) {
      throw new TlsFailure(
        UNEXPECTED_MESSAGE,
        `unexpected handshake message ${type} after the handshake`,
      );
    }
    if (this.keyUpdate(m) && !this.out.shutDown) {
      // After the writes in progress, which keep the old keys; the ones after it use the next.
      await this.out.turns.turn();
      try {
        await this.out.updateWriteKey();
      } finally {
        this.out.turns.done();
      }
    }
  }

  // `postHandshake` for a reader that can't wait: the KeyUpdate it owes goes before the next write.
  private noteHandshake(m: u8[]) {
    const type = m[0];
    if (type == NEW_SESSION_TICKET) {
      return;
    }
    if (type != KEY_UPDATE) {
      throw new TlsFailure(
        UNEXPECTED_MESSAGE,
        `unexpected handshake message ${type} after the handshake`,
      );
    }
    if (this.keyUpdate(m) && !this.out.shutDown) {
      this.out.updateOwed = true;
    }
  }

  // Moves to the server's next read keys: whether it asked for a KeyUpdate back.
  private keyUpdate(m: u8[]): bool {
    checkKeyUpdate(m);
    // New read keys from the next record on (RFC 8446 §4.6.3).
    this.hs.checkEmpty();
    this.readSecret = nextSecret(this.readSecret);
    this.r.cipher = new RecordCipher(this.suite, this.readSecret);
    return m[4] == 1;
  }
}
