// velt/net (tests): `hostOf` (fd_client.velt), the name `connectTls` checks the server's
// certificate against when no `serverName` is given.
import { describe, expect, it } from "velt/test";
import { hostOf } from "velt/net/tls/fd_client";

describe("hostOf", () => {
  it("takes the host of host:port, an IPv6 address without its brackets", () => {
    expect(hostOf("example.com:443")).toBe("example.com");
    expect(hostOf("127.0.0.1:8443")).toBe("127.0.0.1");
    expect(hostOf("[::1]:443")).toBe("::1");
    expect(hostOf("[2001:db8::1]:8443")).toBe("2001:db8::1");
    expect(hostOf("localhost")).toBe("localhost");
  });
});
