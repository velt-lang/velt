// velt/net (internal): `RecordCipher`, one direction's record protection (RFC 8446 §5.2-5.3):
// the AEAD keyed from a traffic secret, the per-record nonce (the IV XOR the sequence number),
// sealing and opening records in place in the stream's buffers. Nothing is allocated per record.

import { Aead } from "velt/crypto/aead";
import { AesGcm } from "velt/crypto/aes_gcm";
import { ChaCha20Poly1305 } from "velt/crypto/chacha20_poly1305";
import { BAD_RECORD_MAC, INTERNAL_ERROR, TlsFailure } from "velt/net/tls/alert";
import { expandLabel } from "velt/net/tls/key_schedule";

/** TLS_AES_128_GCM_SHA256. */
export const AES_128_GCM_SHA256: usize = 0x1301;
/** TLS_CHACHA20_POLY1305_SHA256. */
export const CHACHA20_POLY1305_SHA256: usize = 0x1303;

/** Bytes of a record header. */
export const HEADER: usize = 5;
/** Bytes an AEAD tag adds. */
export const TAG: usize = 16;

// The last sequence number, never used: the next one would wrap and repeat the nonce (RFC 8446
// §5.3).
const LAST_SEQUENCE: u64 = 0xffffffffffffffff;

/** The AEAD of `suite` under the `secret`'s traffic key. */
function aeadOf(suite: usize, secret: u8[]): Aead {
  if (suite == AES_128_GCM_SHA256) {
    return new AesGcm(expandLabel(secret, "key", [], 16));
  }
  return new ChaCha20Poly1305(expandLabel(secret, "key", [], 32));
}

/** One direction's keys and sequence number. */
export class RecordCipher {
  private aead: Aead;
  private iv: u8[];
  private nonce: u8[];
  private aad: u8[];
  /** The next record's sequence number. */
  seq: u64;

  /** The protection of `suite` for the traffic `secret`, sequence number 0. */
  constructor(suite: usize, secret: u8[]) {
    this.aead = aeadOf(suite, secret);
    this.iv = expandLabel(secret, "iv", [], 12);
    this.nonce = Buffer.alloc(12);
    this.aad = Buffer.alloc(HEADER);
    this.seq = 0;
  }

  // The nonce of the next record: the IV with the sequence number XORed into its last 8 bytes.
  private next() {
    if (this.seq == LAST_SEQUENCE) {
      throw new TlsFailure(INTERNAL_ERROR, "the record sequence number ran out");
    }
    for (let i: usize = 0; i < 12; i++) {
      this.nonce[i] = this.iv[i];
    }
    for (let i: usize = 0; i < 8; i++) {
      this.nonce[4 + i] ^= ((this.seq >> (56 - 8 * (i as u64))) & 0xff) as u8;
    }
    this.seq += 1;
  }

  /**
   * Seals the record at `buf[at..]` whose inner plaintext (content, then the content type
   * byte) is the `n` bytes at `buf[at + 5..]`: writes the header (application_data, 0x0303,
   * the length) in front and the tag after. The record's length, `5 + n + 16`.
   * Throws `internal_error` at the last sequence number, here and in `open`.
   */
  seal(buf: u8[], at: usize, n: usize): usize {
    const len = n + TAG;
    this.aad[0] = 23;
    this.aad[1] = 3;
    this.aad[2] = 3;
    this.aad[3] = ((len >> 8) & 0xff) as u8;
    this.aad[4] = (len & 0xff) as u8;
    for (let i: usize = 0; i < HEADER; i++) {
      buf[at + i] = this.aad[i];
    }
    this.next();
    this.aead.sealInPlace(this.nonce, this.aad, buf, at + HEADER, at + HEADER + n);
    return HEADER + len;
  }

  /**
   * Opens the protected record whose header is `buf[at..at + 5]` and body `buf[at + 5..end]` in
   * place: the inner plaintext's length (it starts at `at + 5`). Throws `bad_record_mac` when
   * the tag does not match.
   */
  open(buf: u8[], at: usize, end: usize): usize {
    for (let i: usize = 0; i < HEADER; i++) {
      this.aad[i] = buf[at + i];
    }
    this.next();
    if (!this.aead.openInPlace(this.nonce, this.aad, buf, at + HEADER, end)) {
      throw new TlsFailure(BAD_RECORD_MAC, "a record failed authentication (bad_record_mac)");
    }
    return end - at - HEADER - TAG;
  }
}
