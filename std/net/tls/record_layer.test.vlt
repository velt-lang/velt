// velt/net (tests): the TLS record layer, key schedule and wire codec, run by `velt test std/`.
//
// Against RFC 8448's "Simple 1-RTT Handshake" trace: the key schedule derives the trace's
// secrets, `RecordCipher` opens the server's records and seals the client's byte for byte, and
// `RecordReader` frames, opens and rejects records from a played-back transport. The records
// that are not in the trace were sealed by Node (`createCipheriv`, keys from HKDF-Expand-Label
// over `createHmac`), or are built with `seal` where only the outcome is compared; `seal` itself
// is compared with Node and the trace byte for byte.
import { hkdfExpandSha256 } from "velt/crypto/hkdf";
import { sha256 } from "velt/crypto/sha256";
import { hexDecode, hexEncode } from "velt/encoding/hex";
import { IoError } from "velt/io/error";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { ByteStream } from "velt/net/byte_stream";
import { TlsFailure } from "velt/net/tls/alert";
import { ByteReader } from "velt/net/tls/byte_reader";
import { ByteWriter } from "velt/net/tls/byte_writer";
import { HandshakeBuffer } from "velt/net/tls/handshake_buffer";
import {
  expandLabel,
  finishedMac,
  handshakeSecret,
  masterSecret,
  nextSecret,
} from "velt/net/tls/key_schedule";
import { RecordCipher } from "velt/net/tls/record_cipher";
import { APPLICATION_DATA, END, HANDSHAKE, RecordReader } from "velt/net/tls/record_reader";
import { describe, expect, it } from "velt/test";

