// velt/net (internal): `WriteTurns`, the order of a TLS connection's writes: records carry
// implicit sequence numbers, so one write seals and sends at a time, in the order they asked.

/** Whose turn it is to seal and send. */
export class WriteTurns {
  /** Whether a write has the turn. */
  writing: bool;
  private waiting: (() => void)[];

  constructor() {
    this.writing = false;
    this.waiting = [];
  }

  /** Waits until no other write is sealing or sending (writes go in the order they call it). */
  async turn(): Promise<void> {
    if (!this.writing) {
      this.writing = true;
      return;
    }
    const w = Promise.withResolvers<void>();
    this.waiting.push(w.resolve);
    await w.promise;
  }

  /** Ends a write's turn: the next waiting write's starts (`writing` stays true for it). */
  done() {
    if (this.waiting.length == 0) {
      this.writing = false;
      return;
    }
    const next = this.waiting.shift();
    if (next != null) {
      next();
    }
  }
}
