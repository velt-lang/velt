}

const SERVER_RANDOM = "7777777777777777777777777777777777777777777777777777777777777777";
const SERVER_X25519 = "d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d3d353";

// A transport that has `input` all at once and records what is written.
class Wire implements TryStream {
  private input: u8[];
  private pos: usize;
  written: u8[];
  closed: bool;

  constructor(input: u8[]) {
    this.input = input;
    this.pos = 0;
    this.written = [];
    this.closed = false;
  }

  async readInto(buf: Uint8Array): Promise<number | null> {
    throw new Error("the server reads without waiting");
  }

  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    throw new Error("the server writes without waiting");
  }

  close() {
    this.closed = true;
  }

  async halfClose(): Promise<void> {}

  tryStream(): TryStream | null {
    return this;
  }

  tryRead(buf: u8[] | Uint8Array, start: number, end?: number): number | null {
    if (buf instanceof Uint8Array) {
      throw new Error("a test reads into arrays");
    }
    if (this.pos == this.input.length) {
      return 0;
    }
    const to = end ?? (buf.length as number);
    let n = this.input.length - this.pos;
    const room = (to - start) as usize;
    n = n < room ? n : room;
    for (let i: usize = 0; i < n; i++) {
      buf[(start as usize) + i] = this.input[this.pos + i];
    }
    this.pos += n;
    return n as number;
  }

  tryWrite(data: u8[] | Uint8Array, start: number, end?: number): i64 {
    return this.writeBytesLater(data, start, end);
  }

  writeBytesLater(data: u8[] | Uint8Array, start: number, end?: number): i64 {
    if (data instanceof Uint8Array) {
      throw new Error("a test writes arrays");
    }
    const to = end ?? (data.length as number);
    for (let i = start as usize; i < (to as usize); i++) {
      this.written.push(data[i]);
    }
    return (to - start) as i64;
  }
}

// The plaintext record of the handshake message `m`.
function plainRecord(m: string): string {
  const n = m.length / 2;
  return "160303" + hexEncode([((n >> 8) & 0xff) as u8, (n & 0xff) as u8]) + m;
}

/** What the server wrote, read, and how it ended. */
class Served {
  written: string = "";
  done: bool = false;
  read: string = "";
  error: string = "";
  alpn: string | null = null;
}

// The server's side for the client's bytes `client`: the handshake, then "ping" read and "pong"
// written.
function serve(client: string): Served {
  const w = new Wire(hexDecode(client));
  const h = new ServerHandshake(serverKey(CERT, KEY)!, ["http/1.1"]);
  h.fixedRandom = hexDecode(SERVER_RANDOM);
  h.fixedKey = hexDecode(SERVER_X25519);
  const e = new TlsEngine(w);
  const out = new Served();
  try {
    out.done = e.tryServerHandshake(h);
    if (out.done) {
      out.alpn = e.alpn;
      if (e.tryFill() == DATA) {
        for (const c of e.take(e.available())) {
          out.read += String.fromCharCode(c as number);
        }
        e.out.tryWrite(utf8Encode("pong"), 0, 4);
        // Whatever comes next: nothing, or a renegotiation.
        e.tryFill();
      }
    }
  } catch (err) {
    out.error = err instanceof IoError ? err.message : `${err}`;
  }
  out.written = hexEncode(w.written);
  return out;
}

describe("the TLS 1.2 server", () => {
  for (let i: usize = 0; i < 4; i++) {
    it(`answers a TLS 1.2 client as Node expects (${names()[i]})`, () => {
      const c = cases()[i];
      const s = serve(plainRecord(c[0]) + c[2]);
      expect(s.error).toBe("");
      expect(s.done).toBe(true);
      expect(s.alpn).toBe("http/1.1");
      expect(s.read).toBe("ping");
      expect(s.written).toBe(c[1] + c[3]);
    });
  }

  it("sends its flight, then waits for the client's", () => {
    const c = cases()[0];
    const s = serve(plainRecord(c[0]));
    expect(s.done).toBe(false);
    expect(s.written).toBe(c[1]);
    // The downgrade sentinel ends the server random (RFC 8446 §4.1.3).
    expect(s.written.slice(22 + 48, 22 + 64)).toBe("444f574e47524401");
  });

  it("refuses a changed client Finished, and records in the wrong order", () => {
    const c = cases()[0];
    const client = hexDecode(c[2]);
    // ClientKeyExchange (5 + 37 bytes), ChangeCipherSpec (6), then the Finished record.
    const fin = 42 + 6;
    const changed = client.slice();
    changed[fin + 20] ^= 1;
    expect(serve(plainRecord(c[0]) + hexEncode(changed)).error).toBe(
      "TLS: a record failed authentication (bad_record_mac)",
    );
    // A Finished whose verify_data is wrong, though its record opens: decrypt_error.
    for (const k of cases()) {
      const bad = serve(plainRecord(k[0]) + k[5]);
      expect(bad.error).toBe("TLS: the client's Finished does not match the handshake");
    }
    // The Finished before the ChangeCipherSpec: no keys yet.
    const noCcs = hexEncode(client.slice(0, 42)) + hexEncode(client.slice(fin as i64));
    expect(serve(plainRecord(c[0]) + noCcs).error).toContain("TLS: ");
    // A ChangeCipherSpec before the ClientKeyExchange.
    const early = "140303000101" + c[2];
    expect(serve(plainRecord(c[0]) + early).error).toBe("TLS: a ChangeCipherSpec out of place");
  });

  it("refuses ClientHellos it can't serve, with the alert each needs", () => {
    const hello = cases()[0][0];
    // [what changes, into what, the message, the alert].
    const changes: [string, string, string, string][] = [
      // TLS_FALLBACK_SCSV for the renegotiation SCSV: a client that fell back from TLS 1.3.
      ["c02bc02f00ff", "c02bc02f5600", "a TLS 1.2 fallback from a TLS 1.3 client", "56"],
      // CBC only.
      ["c02bc02f00ff", "c023c02f00ff", "no TLS 1.2 cipher suite in common", "28"],
      // TLS 1.1.
      ["010000760303", "010000760302", "the client offers neither TLS 1.3 nor TLS 1.2", "46"],
      // No null compression method.
      ["00ff0100", "00ff0101", "a ClientHello without the null compression method", "2f"],
      // ec_point_formats without uncompressed points.
      ["000b000403000102", "000b000403010202", "ec_point_formats without uncompressed", "2f"],
      // No ecdsa_secp256r1_sha256.
      ["000a0008040305", "000a0008060305", "the client accepts no signature scheme", "28"],
      // No group of the server's.
      ["0006001d00170018", "0006001e00190018", "no key exchange group in common", "28"],
      // A server name that is not UTF-8.
      ["096c6f63616c686f7374", "09ff6f63616c686f7374", "a server name that is not UTF-8", "32"],
      // An ALPN name that is not UTF-8 ("\xfftp/1.1"): bytes, which match no protocol.
      ["08687474702f312e31", "08ff7474702f312e31", "the client offers no ALPN protocol", "78"],
    ];
    for (const [from, to, message, alert] of changes) {
      expect(hello.includes(from)).toBe(true);
      const s = serve(plainRecord(hello.replace(from, to)));
      expect(s.error).toContain(`TLS: ${message}`);
      // The fatal alert, in plaintext.
      expect(s.written).toBe("150303000202" + alert);
    }
  });

  it("refuses a second ClientHello that drops TLS 1.3 after its HelloRetryRequest", () => {
    // cases()[0]'s ClientHello with TLS 1.3 too: TLS_AES_128_GCM_SHA256, supported_versions
    // 1.3 and 1.2, and a key_share with no share, so the server asks for one.
    const hello = cases()[0][0];
    expect(hello.slice(2 * 38, 2 * 51)).toBe("00" + "0006c02bc02f00ff" + "0100" + "0047");
    const exts = hello.slice(2 * 51) + "002b00050403040303" + "003300020000";
    const body = "0303" + "6b".repeat(32) + "00" + "00081301c02bc02f00ff" + "0100";
    const n = (body.length + exts.length + 4) / 2;
    const first =
      "010000" + n.toString(16) + body + (exts.length / 2).toString(16).padStart(4, "0") + exts;
    const retry = serve(plainRecord(first));
    expect(retry.error).toBe("");
    expect(retry.done).toBe(false);
    // A HelloRetryRequest: its special random after the version.
    expect(retry.written.slice(22, 86)).toBe(
      "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c",
    );
    // Then the TLS 1.2-only ClientHello.
    const s = serve(plainRecord(first) + plainRecord(hello));
    expect(s.error).toBe("TLS: the second ClientHello drops TLS 1.3");
    expect(s.written.startsWith(retry.written)).toBe(true);
    expect(s.written.endsWith("15030300020" + "22f")).toBe(true);
  });

  it("refuses a renegotiation after the handshake, with no_renegotiation", () => {
    const c = cases()[0];
    // The ClientHello again, protected, after "ping".
    const s = serve(plainRecord(c[0]) + c[2] + c[4]);
    expect(s.read).toBe("ping");
    expect(s.error).toBe("TLS: the client asked to renegotiate, which is refused");
  });

  it("fails only with a TLS failure on changed client bytes", () => {
    // The ClientHello, the client's flight and a renegotiation, changed in 1 to 3 places (most
    // in the ClientHello) by a fixed generator: a byte changed, set to 0, 1, 2 or 0xff, inserted
    // or removed, or the bytes cut there.
    let seed = 12345;
    function next(n: usize): usize {
      seed = (seed * 48271) % 2147483647;
      return (seed % (n as number)) as usize;
    }
    for (let i: usize = 0; i < 300; i++) {
      const c = cases()[i % 4];
      const b = hexDecode(plainRecord(c[0]) + c[2] + c[4]);
      const changes = 1 + next(3);
      for (let k: usize = 0; k < changes && b.length > 0; k++) {
        const at = next(2) == 0 ? next(b.length < 130 ? b.length : 130) : next(b.length);
        const op = next(5);
        if (op == 0) {
          b[at] ^= (1 + next(255)) as u8;
        } else if (op == 1) {
          b[at] = [0, 1, 2, 0xff][next(4)] as u8;
        } else if (op == 2) {
          b.splice(at as i64, 0, next(256) as u8);
        } else if (op == 3) {
          b.splice(at as i64, 1);
        } else {
          b.splice(at as i64, (b.length - at) as i64);
        }
      }
      const s = serve(hexEncode(b));
      // A TlsFailure's message; another error shows as "TLS: Error: …" (and sends no alert).
      if (s.error != "" && (!s.error.startsWith("TLS: ") || s.error.includes("Error: "))) {
        expect(`${s.error} for ${hexEncode(b)}`).toBe("a TLS failure");
      }
    }
  });
});
