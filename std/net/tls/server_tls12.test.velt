// velt/net (tests): the TLS 1.2 server, for a client that has only TLS 1.2. The ClientHello is
// fixed (as OpenSSL 1.1.1's `s_client -tls1_2` sends one) and so are the server's random and
// ECDHE key, so the server's flight is fixed too (ECDSA signs with RFC 6979's nonces). The
// client's records and the server's expected answer come from scripts/tls12-server-trace.js,
// which checks the ServerKeyExchange's signature against the certificate with Node's crypto and
// runs the key schedule on its own: the server must take the client's Finished and answer with
// the Finished and records Node computed. Run by `velt test std/`.
import { hexDecode, hexEncode } from "velt/encoding/hex";
import { utf8Encode } from "velt/encoding/utf8";
import { IoError } from "velt/io/error";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { TryStream } from "velt/net/byte_stream";
import { ServerHandshake } from "velt/net/tls/server_handshake";
import { serverKey } from "velt/net/tls/server_key";
import { DATA, TlsEngine } from "velt/net/tls/tls_engine";
import { describe, expect, it } from "velt/test";

// A test certificate for localhost and its P-256 key.
const CERT =
  "-----BEGIN CERTIFICATE-----\n" +
  "MIIBfDCCASOgAwIBAgIUbOEJE3w+3rEECtAfNMflvpgZqtwwCgYIKoZIzj0EAwIw\n" +
  "FDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MTExNzEzNDUzOVoXDTM2MTExNDEz\n" +
