// velt/net (tests): the TLS 1.3 client against RFC 8448's "Simple 1-RTT Handshake" trace, run
// by `velt test std/`.
//
// The trace's own ClientHello and X25519 key go in, the server's records come from a fake
// transport (in one piece and a byte at a time), and what the client writes must be the trace's
// records byte for byte: its Finished, its application data, its close_notify. Tampered and
// broken server flights must fail with the right alert.
import { hkdfExpandSha256 } from "velt/crypto/hkdf";
import { sha256 } from "velt/crypto/sha256";
import { hexDecode, hexEncode } from "velt/encoding/hex";
import { IoError } from "velt/io/error";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { ByteStream } from "velt/net/byte_stream";
import { finishedMac } from "velt/net/tls/key_schedule";
import { RecordCipher } from "velt/net/tls/record_cipher";
import { startTls } from "velt/net/tls/start_tls";
import { TlsEngine } from "velt/net/tls/tls_engine";
import { TlsStream } from "velt/net/tls/tls_stream";
import { describe, expect, it } from "velt/test";

