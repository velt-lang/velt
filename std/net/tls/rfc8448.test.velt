  "59a8fcc49c4bf2e5f0a21c0047c2abf332540dd032e167c2955d";
// 24 bytes.
const CLIENT_ALERT_RECORD = "1703030013c9872760655666b74d7ff1153efd6db6d0b0e3";
// 24 bytes.
const SERVER_ALERT_RECORD = "1703030013b58fd67166ebf599d24720cfbe7efa7a8864a9";

// A transport that plays back `input` in pieces of `chunk` bytes and records what is written.
// With `slow`, a write takes the bytes at once but finishes a turn of the event loop later, as
// a socket's does when its buffer is full; `mostWrites` counts the writes in flight at once.
class Playback implements ByteStream {
  private input: u8[];
  private pos: usize;
  private chunk: usize;
  written: u8[];
  closed: bool;
  shutdowns: usize;
  slow: bool;
  private writes: usize;
  mostWrites: usize;

  constructor(input: u8[], chunk: usize) {
    this.input = input;
    this.pos = 0;
    this.chunk = chunk;
    this.written = [];
    this.closed = false;
    this.shutdowns = 0;
    this.slow = false;
    this.writes = 0;
    this.mostWrites = 0;
  }

  async readInto(buf: Uint8Array): Promise<number | null> {
    if (this.pos == this.input.length) {
      return null;
    }
    let n = this.input.length - this.pos;
    if (n > this.chunk) {
      n = this.chunk;
    }
    if (n > buf.len) {
      n = buf.len;
    }
    for (let i: usize = 0; i < n; i++) {
      buf.buf.bytes[buf.off + i] = this.input[this.pos + i];
    }
    this.pos += n;
    return n as number;
  }

  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    if (data instanceof Uint8Array) {
      return;
    }
    const to = end ?? (data.length as number);
    for (let i = start as usize; i < (to as usize); i++) {
      this.written.push(data[i]);
    }
    if (this.slow) {
      this.writes++;
      if (this.writes > this.mostWrites) {
        this.mostWrites = this.writes;
      }
      const later = Promise.withResolvers<void>();
      setImmediate(async () => {
        later.resolve();
      });
      await later.promise;
      this.writes--;
    }
  }

  close() {
    this.closed = true;
  }

  async halfClose(): Promise<void> {
    this.shutdowns++;
  }
}

// The client's handshake against `server` (the server's bytes), as in the trace.
async function handshake(t: Playback): Promise<TlsStream> {
  const e = new TlsEngine(t);
  await e.handshake(
    {
      random: [],
      sessionId: [],
      publicKey: [],
      serverName: "",
      alpn: [],
      fixed: hexDecode(CLIENT_HELLO),
      fixedRetry: null,
      retryKey: null,
    },
    hexDecode(CLIENT_PRIVATE),
  );
  return new TlsStream(e);
}

// The error message of a handshake against `server`, "" if it succeeds.
async function failure(server: string): Promise<string> {
  try {
    await handshake(new Playback(hexDecode(server), 1000000));
    return "";
  } catch (e) {
    return e instanceof IoError ? `${e.code} ${e.message}` : `${e}`;
  }
}

// The server's side of the trace. (A function: a constant built from constants fails to
// resolve in a test file, #2409.)
function server(): string {
  return SERVER_HELLO_RECORD +
    SERVER_FLIGHT_RECORD +
    TICKET_RECORD +
    SERVER_DATA_RECORD +
    SERVER_ALERT_RECORD;
}

function payload(n: usize): u8[] {
  const out: u8[] = [];
  for (let i: usize = 0; i < n; i++) {
    out.push(i as u8);
  }
  return out;
}

// The server's encrypted flight with `change` applied to its plaintext, sealed again under the
// trace's server handshake keys, with `padding` zero bytes after the content type.
function resealed(change: (p: u8[]) => void, padding: usize = 0): string {
  const p = hexDecode(SERVER_FLIGHT);
  change(p);
  const buf = Buffer.alloc(p.length + padding + 22);
  for (let i: usize = 0; i < p.length; i++) {
    buf[5 + i] = p[i];
  }
  buf[5 + p.length] = 22;
  const n = new RecordCipher(0x1301, hexDecode(SERVER_HS_SECRET)).seal(
    buf,
    0,
    p.length + 1 + padding,
  );
  return hexEncode(buf.slice(0, n as i64));
}

// The trace's client handshake traffic secret.
const CLIENT_HS_SECRET = "b3eddb126e067f35a780b3abf45e2d8f3b1a950738f52e9600746a0e27a55a21";

// The trace's application traffic secrets.
const SERVER_AP_SECRET = "a11af9f05531f856ad47116b45a950328204b4f44bfb6b3a4b4f1f3fcb631643";
const CLIENT_AP_SECRET = "9e40646ce79a7f9dc05af8889bce6552875afa0b06df0087f792ebb7c17504a5";

// The secret after a KeyUpdate, written out independently of the code under test:
// HKDF-Expand(secret, length 32 | "tls13 traffic upd" | empty context, 32).
function updated(secret: string): u8[] {
  return hkdfExpandSha256(
    hexDecode(secret),
    hexDecode("002011746c73313320747261666669632075706400"),
    32,
  );
}

// Records sealing each of `inners` (content then content type) in turn under `cipher`.
function sealAll(cipher: RecordCipher, inners: u8[][]): string {
  let out = "";
  for (const inner of inners) {
    const buf = Buffer.alloc(inner.length + 21);
    for (let i: usize = 0; i < inner.length; i++) {
      buf[5 + i] = inner[i];
    }
    const n = cipher.seal(buf, 0, inner.length);
    out += hexEncode(buf.slice(0, n as i64));
  }
  return out;
}

// The application data in the records `rec[at..]` under `cipher`, in order.
function openAll(cipher: RecordCipher, rec: u8[], at: usize): string {
  let out = "";
  let pos = at;
  while (pos < rec.length) {
    const [inner, next] = openAt(cipher, rec, pos);
    expect(inner.endsWith("17")).toBe(true);
    out += inner.slice(0, (inner.length - 2) as i64);
    pos = next;
  }
  return out;
}

// The inner plaintext of the record at `rec[at..]` under `cipher`, and where the next starts.
function openAt(cipher: RecordCipher, rec: u8[], at: usize): [string, usize] {
  const len = ((rec[at + 3] as usize) << 8) | (rec[at + 4] as usize);
  const n = cipher.open(rec, at, at + 5 + len);
  return [hexEncode(rec.slice((at + 5) as i64, (at + 5 + n) as i64)), at + 5 + len];
}

const HRR_RANDOM = "cf21ad74e59a6111be1d8c021e65b891c2a211167abb8c5e079e09e2c8a8339c";

// A HelloRetryRequest record for the session id `sid` with the extensions `exts` (hex).
function retryRequest(sid: u8[], exts: string): string {
  const e = hexDecode(exts);
  const body: u8[] = [3, 3];
  for (const b of hexDecode(HRR_RANDOM)) {
    body.push(b);
  }
  body.push(sid.length as u8);
  for (const b of sid) {
    body.push(b);
  }
  for (const b of [0x13, 0x01, 0, (e.length >> 8) as u8, (e.length & 0xff) as u8]) {
    body.push(b);
  }
  for (const b of e) {
    body.push(b);
  }
  const n = body.length + 4;
  const head: u8[] = [
    22,
    3,
    3,
    (n >> 8) as u8,
    (n & 0xff) as u8,
    2,
    0,
    (body.length >> 8) as u8,
    (body.length & 0xff) as u8,
  ];
  return hexEncode(head) + hexEncode(body);
}

// A handshake with our own ClientHello (32-byte session id: compatibility mode) against `server`.
async function retried(server: string): Promise<[string, string]> {
  const t = new Playback(hexDecode(server), 1000000);
  const sid = payload(32);
  const e = new TlsEngine(t);
  let message = "";
  try {
    await e.handshake(
      {
        random: payload(32),
        sessionId: sid,
        publicKey: payload(32),
        serverName: "example.com",
        alpn: [],
        fixed: null,
        fixedRetry: null,
        retryKey: null,
      },
      hexDecode(CLIENT_PRIVATE),
    );
  } catch (err) {
    message = err instanceof IoError ? err.message : `${err}`;
  }
  return [hexEncode(t.written), message];
}

describe("TLS 1.3 client, RFC 8448 §3", () => {
  const chunks: usize[] = [1000000, 1];
  for (const chunk of chunks) {
    it(`writes the trace's records, reading the server in pieces of ${chunk}`, async () => {
      const t = new Playback(hexDecode(server()), chunk);
      const s = await handshake(t);
      expect(hexEncode(t.written)).toBe(CLIENT_HELLO_RECORD + CLIENT_FINISHED_RECORD);
      await s.writeBytes(payload(50));
      expect(hexEncode(t.written.slice(259))).toBe(CLIENT_DATA_RECORD);
      // The NewSessionTicket is read and ignored on the way to the data.
      expect(hexEncode(await s.read())).toBe(hexEncode(payload(50)));
      await s.shutdown();
      expect(hexEncode(t.written.slice(331))).toBe(CLIENT_ALERT_RECORD);
      expect(t.shutdowns).toBe(1);
      expect(t.closed).toBe(false);
      // The server's close_notify ends the stream.
      expect((await s.read()).length).toBe(0);
    });
  }

  it("hands out application data with read(max) and readInto", async () => {
    const s = await handshake(new Playback(hexDecode(server()), 7));
    expect(hexEncode(await s.read(20))).toBe(hexEncode(payload(20)));
    const view = Buffer.alloc(40).subarray(0, 40);
    expect(await s.readInto(view)).toBe(30);
    expect(view[29]).toBe(49);
    expect(await s.readInto(view)).toBe(null);
  });

  it("rejects a flight that fails authentication", async () => {
    const flight = hexDecode(SERVER_FLIGHT_RECORD);
    flight[100] ^= 1;
    expect(await failure(SERVER_HELLO_RECORD + hexEncode(flight))).toBe(
      "EPROTO TLS: a record failed authentication (bad_record_mac)",
    );
  });

  it("rejects a server Finished that does not match the transcript", async () => {
    const bad = resealed((p) => {
      p[p.length - 1] ^= 1;
    });
    expect(await failure(SERVER_HELLO_RECORD + bad)).toBe(
      "EPROTO TLS: the server's Finished does not match the handshake",
    );
    // The same flight resealed unchanged is accepted, and so is one with padding.
    expect(await failure(SERVER_HELLO_RECORD + resealed((p) => {}))).toBe("");
    expect(await failure(SERVER_HELLO_RECORD + resealed((p) => {}, 300))).toBe("");
  });

  it("rejects a certificate that changed (the transcript covers it)", async () => {
    const bad = resealed((p) => {
      p[200] ^= 1;
    });
    expect(await failure(SERVER_HELLO_RECORD + bad)).toBe(
      "EPROTO TLS: the server's Finished does not match the handshake",
    );
  });

  it("rejects a TLS 1.2 ServerHello", async () => {
    // The trace's ServerHello without its supported_versions extension (the last 6 bytes).
    const sh = hexDecode(SERVER_HELLO_RECORD);
    const short = sh.slice(0, (sh.length - 6) as i64);
    short[4] -= 6;
    short[8] -= 6;
    short[sh.length - 6 - 41] -= 6;
    expect(await failure(hexEncode(short))).toBe(
      "EPROTO TLS: the server does not speak TLS 1.3 (TLS 1.2 is not supported yet)",
    );
  });

  it("rejects a legacy_version other than 0x0303, with the matching alert", async () => {
    const cases: [u8, string, string][] = [
      [2, "the server does not speak TLS 1.3 (it chose version 0x0302)", "46"],
      [4, "the ServerHello's legacy_version is 0x0304, not 0x0303", "2f"],
    ];
    for (const [minor, message, alert] of cases) {
      const sh = hexDecode(SERVER_HELLO_RECORD);
      sh[10] = minor;
      const t = new Playback(sh, 1000000);
      let got = "";
      try {
        await handshake(t);
      } catch (e) {
        got = e instanceof IoError ? e.message : `${e}`;
      }
      expect(got).toBe(`TLS: ${message}`);
      expect(hexEncode(t.written)).toBe(CLIENT_HELLO_RECORD + "150303000202" + alert);
    }
  });

  it("reports the server's alert, a closed connection and an unexpected message", async () => {
    expect(await failure("1503030002022800")).toBe(
      "EPROTO TLS: the server sent the alert handshake_failure (40)",
    );
    expect(await failure(SERVER_HELLO_RECORD)).toBe(
      "EPROTO TLS: the connection closed during the handshake",
    );
    expect(await failure("160303000401000000")).toBe(
      "EPROTO TLS: unexpected handshake message 1 during the handshake",
    );
    expect(await failure("1603030006020000020303")).toBe("EPROTO TLS: truncated ServerHello");
    expect(await failure("170303000100")).toBe("EPROTO TLS: an unprotected record of type 23");
  });

  it("answers a HelloRetryRequest's cookie with a second ClientHello", async () => {
    const sid = payload(32);
    // supported_versions TLS 1.3, cookie "c00c1e".
    const [written, message] = await retried(retryRequest(sid, "002b00020304002c00050003c00c1e"));
    expect(message).toBe("TLS: the connection closed during the handshake");
    // ClientHello, then ChangeCipherSpec (compatibility mode), then the second ClientHello,
    // which carries the cookie extension and the same random.
    const ccs = written.indexOf("140303000101");
    expect(ccs > 0).toBe(true);
    const second = written.slice(ccs + 12);
    expect(second.startsWith("160303")).toBe(true);
    expect(second.includes("002c00050003c00c1e")).toBe(true);
    expect(written.slice(0, ccs).includes("002c")).toBe(false);
    expect(second.includes(hexEncode(payload(32)))).toBe(true);
  });

  it("answers a HelloRetryRequest for secp256r1 with a P-256 share", async () => {
    const sid = payload(32);
    const [written, message] = await retried(
      retryRequest(sid, "002b0002030400330002 0017".replace(" ", "")),
    );
    expect(message).toBe("TLS: the connection closed during the handshake");
    const ccs = written.indexOf("140303000101");
    const second = written.slice(ccs + 12);
    // supported_groups X25519 and secp256r1 in both; the key share is X25519's, then P-256's
    // (an uncompressed point), and no cookie.
    expect(written.slice(0, ccs).includes("000a00060004001d0017")).toBe(true);
    expect(written.slice(0, ccs).includes("00330026002400 1d0020".replace(" ", ""))).toBe(true);
    expect(second.includes("000a00060004001d0017")).toBe(true);
    const share = second.indexOf("003300470045001700 4104".replace(" ", ""));
    expect(share >= 0).toBe(true);
    // No cookie extension (0x002c). The share's 65-byte point is random, so its hex may hold
    // "002c" itself (about one run in 550): look outside it.
    const outside = second.slice(0, share) + second.slice(share + 20 + 130);
    expect(outside.includes("002c")).toBe(false);
  });

  it("rejects HelloRetryRequests it cannot honour", async () => {
    const sid = payload(32);
    expect((await retried(retryRequest(sid, "002b0002030400330002001d")))[1]).toBe(
      "TLS: the HelloRetryRequest asks for the X25519 share already sent",
    );
    expect((await retried(retryRequest(sid, "002b0002030400330002001e")))[1]).toBe(
      "TLS: the HelloRetryRequest asks for key exchange group 0x1e, which was not offered",
    );
    expect((await retried(retryRequest(sid, "002b00020304")))[1]).toBe(
      "TLS: a HelloRetryRequest that changes nothing",
    );
    const twice = retryRequest(sid, "002b00020304002c00050003c00c1e");
    expect((await retried(twice + twice))[1]).toBe("TLS: a second HelloRetryRequest");
    expect((await retried(retryRequest(payload(31), "002b00020304002c00050003c00c1e")))[1]).toBe(
      "TLS: the ServerHello does not echo the session id",
    );
  });

  it("follows a KeyUpdate that asks for one back", async () => {
    // After the ticket (sequence 0): KeyUpdate(update_requested) under the old keys, then data
    // and close_notify under the next ones.
    const old = new RecordCipher(0x1301, hexDecode(SERVER_AP_SECRET));
    sealAll(old, [[0]]);
    const ku = sealAll(old, [[24, 0, 0, 1, 1, 22]]);
    const data = payload(50);
    data.push(23);
    const after = sealAll(new RecordCipher(0x1301, updated(SERVER_AP_SECRET)), [data, [1, 0, 21]]);
    const t = new Playback(
      hexDecode(SERVER_HELLO_RECORD + SERVER_FLIGHT_RECORD + TICKET_RECORD + ku + after),
      1000000,
    );
    const s = await handshake(t);
    expect(hexEncode(await s.read())).toBe(hexEncode(payload(50)));
    await s.writeBytes(payload(5));
    // The client answered with KeyUpdate(update_not_requested) under its old keys and wrote
    // the data under its next ones.
    const out = t.written.slice(259);
    const [first, next] = openAt(new RecordCipher(0x1301, hexDecode(CLIENT_AP_SECRET)), out, 0);
    expect(first).toBe("180000010016");
    const [second, end] = openAt(new RecordCipher(0x1301, updated(CLIENT_AP_SECRET)), out, next);
    expect(second).toBe(hexEncode(payload(5)) + "17");
    expect(end).toBe(out.length);
    expect((await s.read()).length).toBe(0);
  });

  it("writes one write's records after another's, one transport write at a time", async () => {
    const t = new Playback(hexDecode(server()), 1000000);
    const s = await handshake(t);
    t.slow = true;
    // Five records, sealed in two batches; the second write starts while the first waits.
    const big = payload(5 * 16384);
    for (let i: usize = 0; i < big.length; i++) {
      big[i] = (i % 251) as u8;
    }
    const small = payload(7);
    await Promise.all([s.writeBytes(big), s.writeBytes(small)]);
    expect(t.mostWrites).toBe(1);
    const cipher = new RecordCipher(0x1301, hexDecode(CLIENT_AP_SECRET));
    expect(openAll(cipher, t.written, 259) == hexEncode(big) + hexEncode(small)).toBe(true);
  });

  it("lets the writes called before shutdown() finish before its close_notify", async () => {
    const t = new Playback(hexDecode(server()), 1000000);
    const s = await handshake(t);
    t.slow = true;
    const first = s.writeBytes(payload(5 * 16384));
    const second = s.writeBytes(payload(9));
    await s.shutdown();
    await first;
    await second;
    const c = new RecordCipher(0x1301, hexDecode(CLIENT_AP_SECRET));
    let pos: usize = 259;
    for (let r = 0; r < 6; r++) {
      pos = openAt(c, t.written, pos)[1];
    }
    expect(openAt(c, t.written, pos)[0]).toBe("010015");
    expect(t.closed).toBe(true);
  });

  it("sends a KeyUpdate after the write it waits behind, under the old keys", async () => {
    const old = new RecordCipher(0x1301, hexDecode(SERVER_AP_SECRET));
    sealAll(old, [[0]]);
    const ku = sealAll(old, [[24, 0, 0, 1, 1, 22]]);
    const data = payload(50);
    data.push(23);
    const after = sealAll(new RecordCipher(0x1301, updated(SERVER_AP_SECRET)), [data]);
    const t = new Playback(
      hexDecode(SERVER_HELLO_RECORD + SERVER_FLIGHT_RECORD + TICKET_RECORD + ku + after),
      1000000,
    );
    const s = await handshake(t);
    t.slow = true;
    const big = payload(5 * 16384);
    const writing = s.writeBytes(big);
    expect(hexEncode(await s.read())).toBe(hexEncode(payload(50)));
    await writing;
    await s.writeBytes(payload(5));
    // The write's five records under the old keys, the KeyUpdate under them too, then the
    // next write under the new keys.
    const out = t.written;
    const c = new RecordCipher(0x1301, hexDecode(CLIENT_AP_SECRET));
    let pos: usize = 259;
    let sent = "";
    for (let r = 0; r < 5; r++) {
      const [inner, next] = openAt(c, out, pos);
      sent += inner.slice(0, (inner.length - 2) as i64);
      pos = next;
    }
    expect(sent == hexEncode(big)).toBe(true);
    const [update, next] = openAt(c, out, pos);
    expect(update).toBe("180000010016");
    expect(openAll(new RecordCipher(0x1301, updated(CLIENT_AP_SECRET)), out, next)).toBe(
      hexEncode(payload(5)),
    );
  });

  it("reassembles a handshake message split across records", async () => {
    // The Certificate (bytes 40..485 of the flight) ends one byte into the second record.
    const flight = hexDecode(SERVER_FLIGHT);
    const a = flight.slice(0, 484);
    a.push(22);
    const b = flight.slice(484);
    b.push(22);
    const two = sealAll(new RecordCipher(0x1301, hexDecode(SERVER_HS_SECRET)), [a, b]);
    expect(await failure(SERVER_HELLO_RECORD + two)).toBe("");
  });

  it("reads no more than a short view holds", async () => {
    const s = await handshake(new Playback(hexDecode(server()), 1000000));
    const backing = Buffer.alloc(40);
    const view = backing.subarray(0, 10);
    expect(await s.readInto(view)).toBe(10);
    expect(backing[10]).toBe(0);
    expect(hexEncode(await s.read())).toBe(hexEncode(payload(50).slice(10)));
  });

  it("answers a CertificateRequest with an empty Certificate before its Finished", async () => {
    // The trace's flight with a CertificateRequest (no context, signature_algorithms
    // ecdsa_secp256r1_sha256) after EncryptedExtensions, and the server Finished recomputed.
    const flight = hexDecode(SERVER_FLIGHT);
    const request = hexDecode("0d00000b000008000d000400020403");
    const head: u8[] = [];
    for (const b of hexDecode(CLIENT_HELLO)) {
      head.push(b);
    }
    for (const b of hexDecode(SERVER_HELLO_RECORD).slice(5)) {
      head.push(b);
    }
    const server: u8[] = flight.slice(0, 40);
    for (const b of request) {
      server.push(b);
    }
    for (const b of flight.slice(40, 621)) {
      server.push(b);
    }
    const transcript = head.slice();
    for (const b of server) {
      transcript.push(b);
    }
    const fin: u8[] = [20, 0, 0, 32];
    for (const b of finishedMac(hexDecode(SERVER_HS_SECRET), sha256(transcript))) {
      fin.push(b);
    }
    for (const b of fin) {
      server.push(b);
      transcript.push(b);
    }
    server.push(22);
    const sealed = sealAll(new RecordCipher(0x1301, hexDecode(SERVER_HS_SECRET)), [server]);
    const t = new Playback(hexDecode(SERVER_HELLO_RECORD + sealed), 1000000);
    await handshake(t);
    // The client's flight under its handshake keys: an empty Certificate, then a Finished over
    // the transcript that includes it.
    const [inner, end] = openAt(
      new RecordCipher(0x1301, hexDecode(CLIENT_HS_SECRET)),
      t.written,
      201,
    );
    expect(end).toBe(t.written.length);
    const empty: u8[] = [11, 0, 0, 4, 0, 0, 0, 0];
    for (const b of empty) {
      transcript.push(b);
    }
    const mac = hexEncode(finishedMac(hexDecode(CLIENT_HS_SECRET), sha256(transcript)));
    expect(inner).toBe(hexEncode(empty) + "14000020" + mac + "16");
  });

  it("refuses to start without verify: false", async () => {
    let message = "";
    try {
      await startTls(new Playback([], 1));
    } catch (e) {
      message = e instanceof IoError ? e.code : "other";
    }
    expect(message).toBe("EINVAL");
  });
});
