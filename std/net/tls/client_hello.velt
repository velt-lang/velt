// velt/net (internal): the ClientHello (RFC 8446 §4.1.2) a TLS 1.3 client sends: both SHA-256
// suites, X25519 only, SNI and ALPN when given, the cookie of a HelloRetryRequest, and a
// legacy session id so middleboxes see what looks like a resumed TLS 1.2 session (§D.4).

import { utf8Encode } from "velt/encoding/utf8";
import { ByteWriter } from "velt/net/tls/byte_writer";
import { AES_128_GCM_SHA256, CHACHA20_POLY1305_SHA256 } from "velt/net/tls/record_cipher";

/** The X25519 named group. */
export const X25519: usize = 0x001d;

// Extension numbers (RFC 8446 §4.2).
export const EXT_SERVER_NAME: usize = 0;
export const EXT_SUPPORTED_GROUPS: usize = 10;
export const EXT_SIGNATURE_ALGORITHMS: usize = 13;
export const EXT_ALPN: usize = 16;
export const EXT_SUPPORTED_VERSIONS: usize = 43;
export const EXT_COOKIE: usize = 44;
export const EXT_KEY_SHARE: usize = 51;

// Signature schemes the server may sign with: ECDSA P-256/P-384, RSA-PSS, Ed25519, and RSA
// PKCS#1 v1.5 for certificates. With `verify: false` none is checked yet (#2392 step 3).
const SCHEMES: usize[] = [0x0403, 0x0503, 0x0804, 0x0805, 0x0806, 0x0807, 0x0401, 0x0501, 0x0601];

/** What goes into the ClientHello (the same for a second one after a HelloRetryRequest). */
export struct HelloInput {
  /** 32 random bytes. */
  random: u8[];
  /** The legacy session id: 32 random bytes (middlebox compatibility), or none. */
  sessionId: u8[];
  /** The X25519 public key (32 bytes). */
  publicKey: u8[];
  /** The server's DNS name for SNI ("" for none). */
  serverName: string;
  /** The ALPN protocols, most preferred first. */
  alpn: string[];
  /** The whole first ClientHello message to send instead (RFC 8448's trace), or null. */
  fixed: u8[] | null;
}

/** Whether `name` is an IP address (no SNI for those, RFC 6066 §3). */
function isIpLiteral(name: string): bool {
  if (name.includes(":")) {
    return true;
  }
  // Dotted digits only (IPv4); a DNS name has a letter or a hyphen somewhere.
  for (let i: usize = 0; i < name.length; i++) {
    const c = name.charCodeAt(i as i64);
    if (c != 46 && (c < 48 || c > 57)) {
      return false;
    }
  }
  return true;
}

/** The ClientHello handshake message (with its 4-byte header), with `cookie` when not null. */
export function clientHello(h: HelloInput, cookie: u8[] | null): u8[] {
  const fixed = h.fixed;
  if (fixed != null && cookie == null) {
    return fixed.slice();
  }
  const w = new ByteWriter();
  w.u8(1);
  const body = w.begin(3);
  w.u16(0x0303);
  w.put(h.random);
  const sid = w.begin(1);
  w.put(h.sessionId);
  w.end(sid, 1);
  const suites = w.begin(2);
  w.u16(CHACHA20_POLY1305_SHA256);
  w.u16(AES_128_GCM_SHA256);
  w.end(suites, 2);
  w.u8(1);
  w.u8(0);
  const exts = w.begin(2);
  if (h.serverName != "" && !isIpLiteral(h.serverName)) {
    w.u16(EXT_SERVER_NAME);
    const e = w.begin(2);
    const list = w.begin(2);
    w.u8(0);
    const n = w.begin(2);
    w.put(utf8Encode(h.serverName));
    w.end(n, 2);
    w.end(list, 2);
    w.end(e, 2);
  }
  w.u16(EXT_SUPPORTED_VERSIONS);
  w.u16(3);
  w.u8(2);
  w.u16(0x0304);
  w.u16(EXT_SUPPORTED_GROUPS);
  w.u16(4);
  w.u16(2);
  w.u16(X25519);
  w.u16(EXT_SIGNATURE_ALGORITHMS);
  const sa = w.begin(2);
  const sl = w.begin(2);
  for (const s of SCHEMES) {
    w.u16(s);
  }
  w.end(sl, 2);
  w.end(sa, 2);
  w.u16(EXT_KEY_SHARE);
  const ks = w.begin(2);
  const shares = w.begin(2);
  w.u16(X25519);
  const key = w.begin(2);
  w.put(h.publicKey);
  w.end(key, 2);
  w.end(shares, 2);
  w.end(ks, 2);
  if (h.alpn.length > 0) {
    w.u16(EXT_ALPN);
    const e = w.begin(2);
    const list = w.begin(2);
    for (const p of h.alpn) {
      const one = w.begin(1);
      w.put(utf8Encode(p));
      w.end(one, 1);
    }
    w.end(list, 2);
    w.end(e, 2);
  }
  if (cookie != null) {
    w.u16(EXT_COOKIE);
    const e = w.begin(2);
    const c = w.begin(2);
    w.put(cookie);
    w.end(c, 2);
    w.end(e, 2);
  }
  w.end(exts, 2);
  w.end(body, 3);
  return w.bytes;
}
