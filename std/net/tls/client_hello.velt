// velt/net (internal): the ClientHello (RFC 8446 §4.1.2) a TLS client sends: the three TLS 1.3
// suites (the fastest on this CPU first) and TLS 1.2's six ECDHE AEAD suites, an X25519 key share
// (and secp256r1 and secp384r1 supported, for a HelloRetryRequest or a TLS 1.2 server to ask
// for), SNI and ALPN when given, the cookie of a HelloRetryRequest, and a legacy session id so
// middleboxes see what looks like a resumed TLS 1.2 session (§D.4).

import { CertificateVerifier } from "velt/net/tls/verifier";
import { utf8Encode } from "velt/encoding/utf8";
import { ByteWriter } from "velt/net/tls/byte_writer";
import {
  AES_128_GCM_SHA256,
  AES_256_GCM_SHA384,
  CHACHA20_POLY1305_SHA256,
} from "velt/net/tls/record_cipher";
import { clientSuites12, tls12Suite } from "velt/net/tls/suites12";
import { u8x16 } from "velt/simd";

/** The named groups (RFC 8446 §4.2.7): X25519, secp256r1 (NIST P-256) and secp384r1 (P-384). */
export const X25519: usize = 0x001d;
export const SECP256R1: usize = 0x0017;
export const SECP384R1: usize = 0x0018;

// Extension numbers (RFC 8446 §4.2).

export const EXT_SERVER_NAME: usize = 0;
export const EXT_SUPPORTED_GROUPS: usize = 10;
export const EXT_EC_POINT_FORMATS: usize = 11;
export const EXT_SIGNATURE_ALGORITHMS: usize = 13;
export const EXT_ALPN: usize = 16;
export const EXT_EXTENDED_MASTER_SECRET: usize = 23;
export const EXT_SUPPORTED_VERSIONS: usize = 43;
export const EXT_COOKIE: usize = 44;
export const EXT_KEY_SHARE: usize = 51;
export const EXT_RENEGOTIATION_INFO: usize = 0xff01;

/**
 * Signature schemes the server may sign with: ECDSA P-256/P-384, RSA-PSS, Ed25519, and RSA
 * PKCS#1 v1.5 for certificates and for TLS 1.2's handshake signature.
 */
export const SCHEMES: usize[] = [
  0x0403,
  0x0503,
  0x0804,
  0x0805,
  0x0806,
  0x0807,
  0x0401,
  0x0501,
  0x0601,
];

/** What goes into the ClientHello (the same for a second one after a HelloRetryRequest). */
export struct HelloInput {
  /** 32 random bytes. */
  random: u8[];
  /** The legacy session id: 32 random bytes (middlebox compatibility), or none. */
  sessionId: u8[];
  /** The X25519 public key (32 bytes) of the first ClientHello. */
  publicKey: u8[];
  /** The server's DNS name for SNI ("" for none). */
  serverName: string;
  /** The ALPN protocols, most preferred first. */
  alpn: string[];
  /** The cipher suites, most preferred first (`preferredSuites()`). */
  suites: usize[];
  /** The whole first ClientHello message to send instead (RFC 8448's trace), or null. */
  fixed: u8[] | null;
  /**
   * The second ClientHello to use instead, and the private key of its share (of the curve the
   * HelloRetryRequest asks for) to use instead of a new one (RFC 8448 §5), or null.
   */
  fixedRetry: u8[] | null;
  retryKey: u8[] | null;
  /** What checks the server's certificates; without one they are kept unchecked. */
  verifier?: CertificateVerifier;
}

/** Whether `name` is an IP address (no SNI for those, RFC 6066 §3). */
function isIpLiteral(name: string): bool {
  if (name.includes(":")) {
    return true;
  }
  // Dotted digits only (IPv4); a DNS name has a letter or a hyphen somewhere.
  for (let i: usize = 0; i < name.length; i++) {
    const c = name.charCodeAt(i as i64);
    if (c != 46 && (c < 48 || c > 57)) {
      return false;
    }
  }
  return true;
}

/**
 * The suites in the client's order of preference, fastest on this CPU first: where it has AES and
 * carry-less multiply instructions (`u8x16.hasAes()`), AES-128-GCM, AES-256-GCM (14 rounds to
 * 10), then ChaCha20-Poly1305; elsewhere ChaCha20-Poly1305 first (bitsliced AES is several times
 * slower), then the two AES suites. All are constant time either way, and the server may choose
 * by its own order.
 */
export function preferredSuites(): usize[] {
  const aes = u8x16.hasAes();
  const tls13 =
    aes
      ? [AES_128_GCM_SHA256, AES_256_GCM_SHA384, CHACHA20_POLY1305_SHA256]
      : [CHACHA20_POLY1305_SHA256, AES_128_GCM_SHA256, AES_256_GCM_SHA384];
  // Then TLS 1.2's (ECDHE with an AEAD only), in the same order.
  return tls13.concat(clientSuites12(aes));
}

/**
 * The ClientHello handshake message (with its 4-byte header) with the key share `publicKey` for
 * `group`; a second one (`retry`) carries `cookie` when not null.
 */
export function clientHello(
  h: HelloInput,
  retry: bool,
  cookie: u8[] | null,
  group: usize,
  publicKey: u8[],
): u8[] {
  const fixed = retry ? h.fixedRetry : h.fixed;
  if (fixed != null) {
    return fixed.slice();
  }
  const w = new ByteWriter();
  w.u8(1);
  const body = w.begin(3);
  w.u16(0x0303);
  w.put(h.random);
  const sid = w.begin(1);
  w.put(h.sessionId);
  w.end(sid, 1);
  const suites = w.begin(2);
  for (const suite of h.suites) {
    w.u16(suite);
  }
  w.end(suites, 2);
  w.u8(1);
  w.u8(0);
  const exts = w.begin(2);
  if (h.serverName != "" && !isIpLiteral(h.serverName)) {
    w.u16(EXT_SERVER_NAME);
    const e = w.begin(2);
    const list = w.begin(2);
    w.u8(0);
    const n = w.begin(2);
    w.put(utf8Encode(h.serverName));
    w.end(n, 2);
    w.end(list, 2);
    w.end(e, 2);
  }
  // TLS 1.2 too when a suite of it is offered (preferredSuites), with what RFC 7627 (the extended
  // master secret), RFC 5746 (an initial handshake's empty renegotiation_info) and RFC 8422
  // (uncompressed points) have a client send.
  let tls12 = false;
  for (const suite of h.suites) {
    tls12 = tls12 || tls12Suite(suite);
  }
  w.u16(EXT_SUPPORTED_VERSIONS);
  if (tls12) {
    w.u16(5);
    w.u8(4);
    w.u16(0x0304);
    w.u16(0x0303);
    w.u16(EXT_EXTENDED_MASTER_SECRET);
    w.u16(0);
    w.u16(EXT_RENEGOTIATION_INFO);
    w.u16(1);
    w.u8(0);
    w.u16(EXT_EC_POINT_FORMATS);
    w.u16(2);
    w.u8(1);
    w.u8(0);
  } else {
    w.u16(3);
    w.u8(2);
    w.u16(0x0304);
  }
  w.u16(EXT_SUPPORTED_GROUPS);
  w.u16(8);
  w.u16(6);
  w.u16(X25519);
  w.u16(SECP256R1);
  w.u16(SECP384R1);
  w.u16(EXT_SIGNATURE_ALGORITHMS);
  const sa = w.begin(2);
  const sl = w.begin(2);
  for (const s of SCHEMES) {
    w.u16(s);
  }
  w.end(sl, 2);
  w.end(sa, 2);
  w.u16(EXT_KEY_SHARE);
  const ks = w.begin(2);
  const shares = w.begin(2);
  w.u16(group);
  const key = w.begin(2);
  w.put(publicKey);
  w.end(key, 2);
  w.end(shares, 2);
  w.end(ks, 2);
  if (h.alpn.length > 0) {
    w.u16(EXT_ALPN);
    const e = w.begin(2);
    const list = w.begin(2);
    for (const p of h.alpn) {
      const one = w.begin(1);
      w.put(utf8Encode(p));
      w.end(one, 1);
    }
    w.end(list, 2);
    w.end(e, 2);
  }
  if (cookie != null) {
    w.u16(EXT_COOKIE);
    const e = w.begin(2);
    const c = w.begin(2);
    w.put(cookie);
    w.end(c, 2);
    w.end(e, 2);
  }
  w.end(exts, 2);
  w.end(body, 3);
  return w.bytes;
}
