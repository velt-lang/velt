// velt/net (internal): `TicketStore`, the session tickets a TLS listener issued and has not seen
// used yet (RFC 8446 §4.6.1, stateful tickets as rustls's default `ServerSessionMemoryCache`):
// what each ticket's PSK resumes, keyed by the ticket, which is random and carries nothing. A
// ticket is taken when a client offers it, so it resumes at most once; the oldest go first when
// the store is full. One per listener, shared by its connections behind a mutex
// (std/net/tls/fd_server.velt).

import { hexEncode } from "velt/encoding/hex";
import { Ticket } from "velt/net/tls/ticket";

/** How many tickets a listener keeps. */
const CAPACITY: usize = 1024;

/** The tickets of one listener (module docs). */
export class TicketStore {
  private tickets: Map<string, Ticket> = new Map<string, Ticket>();
  /** The keys in the order they were added (some may be taken already). */
  private order: string[] = [];
  private next: usize = 0;

  /** Keeps `t` for the ticket `id`, forgetting the oldest when full. */
  put(id: u8[], t: Ticket) {
    const key = hexEncode(id);
    if (this.tickets.size >= CAPACITY) {
      while (this.next < this.order.length) {
        const old = this.order[this.next];
        this.next++;
        if (this.tickets.delete(old)) {
          break;
        }
      }
    }
    if (this.next > CAPACITY) {
      this.order = this.order.slice(this.next as i64);
      this.next = 0;
    }
    this.tickets.set(key, t);
    this.order.push(key);
  }

  /** The ticket `id`, taken out (it resumes once), or null when unknown. */
  take(id: u8[]): Ticket | null {
    const key = hexEncode(id);
    const t = this.tickets.get(key) ?? null;
    if (t != null) {
      this.tickets.delete(key);
    }
    return t;
  }
}
