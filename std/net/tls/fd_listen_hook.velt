// velt/net (internal): the `listen` hook of std/net/tls/fd_reactor.velt: a stub that answers null
// (this program has no TLS server on the reactor), which std/net/tls/fd_server.velt's more specific `extend`
// replaces when the program loads it.

import { IoResult } from "velt/native/result";

/** `listenTls` on the reactor: a TLS listener, or null when this program has no TLS server. */
export interface ListenHook {
  listen(addr: string, cert: string, key: string, alpn: string): Promise<IoResult<u64> | null>;
}

/** What has `ListenHook`: the stub below, or std/net/tls/fd_server.velt's. */
export struct TlsListenSide {}

/** The types the stub below is for. */
export interface ListenStubbed {}

extend TlsListenSide implements ListenStubbed {}

extend<T extends ListenStubbed> T implements ListenHook {
  async listen(
    addr: string,
    cert: string,
    key: string,
    alpn: string,
  ): Promise<IoResult<u64> | null> {
    return null;
  }
}
