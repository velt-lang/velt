// velt/net (internal): `RecordReader`, the reading half of the TLS record layer (RFC 8446 §5):
// records read with `readInto` into one reused buffer, framed, decrypted in place, alerts
// handled, and application data handed out from where it was decrypted. Framing and opening a
// record allocate nothing; each transport read allocates its view of the buffer (3 blocks, all
// freed).

import "velt/lang/typed_array/bytes_view";
import { ByteStream, TryStream } from "velt/net/byte_stream";
import {
  alertName,
  CLOSE_NOTIFY,
  DECODE_ERROR,
  RECORD_OVERFLOW,
  TlsFailure,
  UNEXPECTED_MESSAGE,
} from "velt/net/tls/alert";
import { HEADER, RecordCipher } from "velt/net/tls/record_cipher";
import { arrayMove } from "velt/lang/intrinsics/array";

/** The content type change_cipher_spec. */
export const CHANGE_CIPHER_SPEC: u8 = 20;
/** The content type alert. */
export const ALERT: u8 = 21;
/** The content type handshake. */
export const HANDSHAKE: u8 = 22;
/** The content type application_data. */
export const APPLICATION_DATA: u8 = 23;
/** Not a content type: the stream ended with close_notify. */
export const END: u8 = 0;
/** Not a content type (none fits in a byte): no whole record has been read yet. */
export const MORE: u16 = 256;

/** The most content a record carries. */
export const MAX_PLAIN: usize = 16384;
const MAX_CIPHER: usize = 16384 + 256;
// Room for two whole records, so one can be completed behind another.
const BUFFER: usize = 2 * (5 + 16384 + 256);

/** Reads and opens the records of one connection. */
export class RecordReader {
  private t: ByteStream;
  /** The buffer; the last record's content is `buf[cstart..cend]`. */
  buf: u8[];
  cstart: usize;
  cend: usize;
  private rstart: usize;
  private rend: usize;
  // Application data not yet handed out: buf[pstart..pend].
  private pstart: usize;
  private pend: usize;
  /** The read keys (null before the handshake keys). */
  cipher: RecordCipher | null;
  /** Whether ChangeCipherSpec records are still allowed (until the handshake is done). */
  handshaking: bool;
  /** Whether the stream ended with close_notify. */
  ended: bool;
  // The first failure: nothing is read past it, and `next` throws it again.
  private failure: TlsFailure | null;

  constructor(t: ByteStream) {
    this.t = t;
    this.buf = Buffer.alloc(BUFFER);
    this.cstart = 0;
    this.cend = 0;
    this.rstart = 0;
    this.rend = 0;
    this.pstart = 0;
    this.pend = 0;
    this.cipher = null;
    this.handshaking = true;
    this.ended = false;
    this.failure = null;
  }

  /** Application data not yet handed out. */
  available(): usize {
    return this.pend - this.pstart;
  }

  /** Makes the last record's content the application data to hand out. */
  keepContent() {
    this.pstart = this.cstart;
    this.pend = this.cend;
  }

  /** Copies `n` bytes of application data (at most `available()`) to `out[at..]`. */
  takeInto(out: u8[], at: usize, n: usize) {
    arrayMove(out, at, this.buf, this.pstart, n);
    this.pstart += n;
  }

  /** The next `n` bytes of application data (at most `available()`). */
  take(n: usize): u8[] {
    const out = this.buf.slice(this.pstart as i64, (this.pstart + n) as i64);
    this.pstart += n;
    return out;
  }

  /**
   * Reads the next record and decrypts it in place: its content type, the content at
   * `buf[cstart..cend]`. END at close_notify and at every call after it: what follows is ignored
   * (RFC 8446 §6.1). Throws a `TlsFailure` for a record the protocol
   * forbids, an alert other than close_notify, and a transport that ends without close_notify,
   * which may be a truncation (`after`: once the handshake is done). After a failure every call
   * throws it again.
   */
  async next(after: bool): Promise<u8> {
    while (true) {
      const type = this.step();
      if (type != MORE) {
        return type as u8;
      }
      if (!(await this.readMore())) {
        this.cut(after);
      }
    }
  }

  /**
   * `next` from what has been read so far, a content type or END; MORE when no whole record is
   * left in it.
   */
  step(): u16 {
    if (this.ended) {
      return END as u16;
    }
    const failed = this.failure;
    if (failed != null) {
      throw failed;
    }
    try {
      while (true) {
        const avail = this.rend - this.rstart;
        if (avail < HEADER) {
          return MORE;
        }
        const at = this.rstart;
        const len = ((this.buf[at + 3] as usize) << 8) | (this.buf[at + 4] as usize);
        if (len > MAX_CIPHER) {
          throw new TlsFailure(RECORD_OVERFLOW, `a record of ${len} bytes`);
        }
        if (avail < HEADER + len) {
          return MORE;
        }
        this.rstart = at + HEADER + len;
        const type = this.open(at, len);
        if (type != ALERT) {
          return type as u16;
        }
        if (this.alert()) {
          return END as u16;
        }
      }
    } catch (e) {
      if (e instanceof TlsFailure) {
        this.failure = e;
      }
      throw e;
    }
  }

  /** Whether `step` would find a whole record, or a failure in one, in what has been read. */
  hasRecord(): bool {
    const avail = this.rend - this.rstart;
    if (avail < HEADER) {
      return false;
    }
    const at = this.rstart;
    const len = ((this.buf[at + 3] as usize) << 8) | (this.buf[at + 4] as usize);
    return len > MAX_CIPHER || avail >= HEADER + len;
  }

  /** The transport ended where a record or close_notify was due: throws what that means. */
  cut(after: bool) {
    const failure = new TlsFailure(
      CLOSE_NOTIFY,
      !after
        ? "the connection closed during the handshake"
        : this.rend > this.rstart
          ? "the connection closed in the middle of a record"
          : "the connection closed without close_notify",
      false,
    );
    this.failure = failure;
    throw failure;
  }

  /**
   * Reads what the transport has now behind the unread records: the number of bytes, or null at
   * its end.
   */
  tryMore(t: TryStream): number | null {
    this.makeRoom();
    const got = t.tryRead(this.buf, this.rend as number, BUFFER as number);
    if (got != null) {
      this.rend += got as usize;
    }
    return got;
  }

  // The content type of the record at buf[at..at + 5 + len], its content decrypted in place.
  private open(at: usize, len: usize): u8 {
    const type = this.buf[at];
    const cipher = this.cipher;
    if (type == CHANGE_CIPHER_SPEC || cipher == null) {
      if (type == APPLICATION_DATA || (type == CHANGE_CIPHER_SPEC && !this.handshaking)) {
        throw new TlsFailure(UNEXPECTED_MESSAGE, `an unprotected record of type ${type}`);
      }
      if (len > MAX_PLAIN) {
        throw new TlsFailure(RECORD_OVERFLOW, `an unprotected record of ${len} bytes`);
      }
      this.cstart = at + HEADER;
      this.cend = at + HEADER + len;
      return type;
    }
    if (type != APPLICATION_DATA) {
      throw new TlsFailure(
        UNEXPECTED_MESSAGE,
        `an unprotected record of type ${type} after encryption started`,
      );
    }
    const n = cipher.open(this.buf, at, at + HEADER + len);
    if (n > MAX_PLAIN + 1) {
      throw new TlsFailure(RECORD_OVERFLOW, `an inner plaintext of ${n} bytes`);
    }
    // The content type is the last non-zero byte; zeros after it are padding.
    let end = at + HEADER + n;
    while (end > at + HEADER && this.buf[end - 1] == 0) {
      end--;
    }
    if (end == at + HEADER) {
      throw new TlsFailure(UNEXPECTED_MESSAGE, "a protected record without a content type");
    }
    const inner = this.buf[end - 1];
    if (inner == CHANGE_CIPHER_SPEC) {
      throw new TlsFailure(UNEXPECTED_MESSAGE, "a protected change_cipher_spec");
    }
    this.cstart = at + HEADER;
    this.cend = end - 1;
    return inner;
  }

  // Handles the alert just read: true for close_notify (the end of the stream).
  private alert(): bool {
    if (this.cend - this.cstart != 2) {
      throw new TlsFailure(DECODE_ERROR, "a malformed alert");
    }
    const d = this.buf[this.cstart + 1];
    if (d == CLOSE_NOTIFY) {
      this.ended = true;
      return true;
    }
    if (d == 90) {
      // user_canceled: a warning, followed by close_notify.
      return false;
    }
    throw new TlsFailure(d, `the server sent the alert ${alertName(d)} (${d})`, false);
  }

  // Reads more of the transport behind the unread records: false at its end.
  private async readMore(): Promise<bool> {
    this.makeRoom();
    const got = await this.t.readInto(this.buf.subarray(this.rend as number, BUFFER as number));
    if (got == null) {
      return false;
    }
    this.rend += got as usize;
    return true;
  }

  // Moves the unread records to the front. Only when no application data is waiting.
  private makeRoom() {
    if (this.rstart > 0 && this.pstart == this.pend) {
      const n = this.rend - this.rstart;
      for (let i: usize = 0; i < n; i++) {
        this.buf[i] = this.buf[this.rstart + i];
      }
      this.rstart = 0;
      this.rend = n;
      this.pstart = 0;
      this.pend = 0;
    }
  }
}
