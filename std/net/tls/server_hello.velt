// velt/net (internal): parsing the ServerHello (RFC 8446 §4.1.3), which is a HelloRetryRequest
// (§4.1.4) when its random is the special value: version, suite, key share, cookie.

import {
  ILLEGAL_PARAMETER,
  MISSING_EXTENSION,
  PROTOCOL_VERSION,
  TlsFailure,
  UNEXPECTED_MESSAGE,
} from "velt/net/tls/alert";
import {
  EXT_COOKIE,
  EXT_KEY_SHARE,
  EXT_SUPPORTED_VERSIONS,
  SECP256R1,
  X25519,
} from "velt/net/tls/client_hello";
import { ByteReader } from "velt/net/tls/byte_reader";
import { AES_128_GCM_SHA256, CHACHA20_POLY1305_SHA256 } from "velt/net/tls/record_cipher";

// SHA-256("HelloRetryRequest"): a ServerHello with this random is a HelloRetryRequest.
const HRR_RANDOM: u8[] = [
  0xcf,
  0x21,
  0xad,
  0x74,
  0xe5,
  0x9a,
  0x61,
  0x11,
  0xbe,
  0x1d,
  0x8c,
  0x02,
  0x1e,
  0x65,
  0xb8,
  0x91,
  0xc2,
  0xa2,
  0x11,
  0x16,
  0x7a,
  0xbb,
  0x8c,
  0x5e,
  0x07,
  0x9e,
  0x09,
  0xe2,
  0xc8,
  0xa8,
  0x33,
  0x9c,
];

/** What a ServerHello or HelloRetryRequest says. */
export struct ServerHello {
  /** Whether it is a HelloRetryRequest. */
  retry: bool;
  /** The cipher suite chosen. */
  suite: usize;
  /** The server's key share (ServerHello) for `group`, empty in a HelloRetryRequest. */
  keyShare: u8[];
  /** The key share's group, or the one a HelloRetryRequest asks for (0 when it asks for none). */
  group: usize;
  /** A HelloRetryRequest's cookie, or null. */
  cookie: u8[] | null;
}

/**
 * The ServerHello in `body` (the message without its 4-byte header), checked against `sessionId`
 * and the group `offered` of the client's last key share. `retried` says a HelloRetryRequest came
 * already: another one is `unexpected_message` whatever it says (RFC 8446 §4.1.4).
 */
export function parseServerHello(
  body: u8[],
  sessionId: u8[],
  offered: usize,
  retried: bool,
): ServerHello {
  const r = new ByteReader(body, 0, body.length, "ServerHello");
  checkLegacyVersion(r.u16());
  const random = r.bytes(32);
  let retry = true;
  for (let i: usize = 0; i < 32; i++) {
    if (random[i] != HRR_RANDOM[i]) {
      retry = false;
    }
  }
  if (retry && retried) {
    throw new TlsFailure(UNEXPECTED_MESSAGE, "a second HelloRetryRequest");
  }
  const echo = r.vector(1);
  const sid = echo.bytes(echo.left());
  let same = sid.length == sessionId.length;
  for (let i: usize = 0; same && i < sid.length; i++) {
    same = sid[i] == sessionId[i];
  }
  if (!same) {
    throw new TlsFailure(ILLEGAL_PARAMETER, "the ServerHello does not echo the session id");
  }
  const suite = r.u16();
  if (suite != AES_128_GCM_SHA256 && suite != CHACHA20_POLY1305_SHA256) {
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the server chose a cipher suite not offered (0x${suite.toString(16)})`,
    );
  }
  if (r.u8() != 0) {
    throw new TlsFailure(ILLEGAL_PARAMETER, "the server chose a compression method");
  }
  let version: usize = 0;
  let keyShare: u8[] = [];
  let group: usize = 0;
  let cookie: u8[] | null = null;
  // TLS 1.2 servers may omit the extensions altogether.
  if (r.left() > 0) {
    const exts = r.vector(2);
    while (exts.left() > 0) {
      const type = exts.u16();
      const e = exts.vector(2);
      if (type == EXT_SUPPORTED_VERSIONS) {
        version = e.u16();
      } else if (type == EXT_KEY_SHARE) {
        group = e.u16();
        if (!retry) {
          const k = e.vector(2);
          keyShare = k.bytes(k.left());
        }
      } else if (type == EXT_COOKIE && retry) {
        const c = e.vector(2);
        cookie = c.bytes(c.left());
      } else {
        e.bytes(e.left());
      }
      e.finish();
    }
  }
  r.finish();
  if (version != 0x0304) {
    throw new TlsFailure(
      PROTOCOL_VERSION,
      "the server does not speak TLS 1.3 (TLS 1.2 is not supported yet)",
    );
  }
  if (!retry) {
    if (group == 0) {
      throw new TlsFailure(MISSING_EXTENSION, "the ServerHello has no key share");
    }
    if (group != offered || keyShare.length != (group == X25519 ? 32 : 65)) {
      throw new TlsFailure(
        ILLEGAL_PARAMETER,
        `the server's key share is not a ${groupName(offered)} key`,
      );
    }
  } else if (group == offered) {
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the HelloRetryRequest asks for the ${groupName(group)} share already sent`,
    );
  } else if (group != 0 && group != X25519 && group != SECP256R1) {
    // Not one of supported_groups (RFC 8446 §4.1.4).
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the HelloRetryRequest asks for key exchange group 0x${group.toString(16)}, which was not offered`,
    );
  }
  return { retry: retry, suite: suite, keyShare: keyShare, group: group, cookie: cookie };
}

// TLS 1.3 fixes the legacy_version at 0x0303 (§4.1.3): below it the server chose an older
// version, which is not supported (protocol_version); above it the field is wrong.
function checkLegacyVersion(v: usize) {
  if (v < 0x0303) {
    throw new TlsFailure(
      PROTOCOL_VERSION,
      `the server does not speak TLS 1.3 (it chose version 0x${hex4(v)})`,
    );
  }
  if (v != 0x0303) {
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the ServerHello's legacy_version is 0x${hex4(v)}, not 0x0303`,
    );
  }
}

function hex4(v: usize): string {
  return v.toString(16).padStart(4, "0");
}

/** The name of the named group `g` for messages: X25519, secp256r1, else its number in hex. */
export function groupName(g: usize): string {
  if (g == X25519) {
    return "X25519";
  }
  if (g == SECP256R1) {
    return "secp256r1";
  }
  return `group 0x${hex4(g)}`;
}
