// velt/net (internal): parsing the ServerHello (RFC 8446 §4.1.3), which is a HelloRetryRequest
// (§4.1.4) when its random is the special value: version, suite, key share, cookie. A TLS 1.2
// ServerHello (no supported_versions) is checked for the downgrade sentinel, which a server
// with TLS 1.3 puts in its random, and gives the random, extended_master_secret and ALPN.

import { utf8DecodeLossy } from "velt/encoding/utf8";
import {
  HANDSHAKE_FAILURE,
  ILLEGAL_PARAMETER,
  MISSING_EXTENSION,
  PROTOCOL_VERSION,
  TlsFailure,
  UNEXPECTED_MESSAGE,
} from "velt/net/tls/alert";
import {
  EXT_ALPN,
  EXT_COOKIE,
  EXT_EXTENDED_MASTER_SECRET,
  EXT_KEY_SHARE,
  EXT_RENEGOTIATION_INFO,
  EXT_SUPPORTED_VERSIONS,
  SECP256R1,
  SECP384R1,
  X25519,
} from "velt/net/tls/client_hello";
import { ByteReader } from "velt/net/tls/byte_reader";
import { groupSupported, pointFormOk } from "velt/net/tls/key_exchange";
import { knownSuite } from "velt/net/tls/record_cipher";
import { DOWNGRADE_TLS12, tls12Suite } from "velt/net/tls/suites12";

/** SHA-256("HelloRetryRequest"): a ServerHello with this random is a HelloRetryRequest. */
export const HRR_RANDOM: u8[] = [
  0xcf,
  0x21,
  0xad,
  0x74,
  0xe5,
  0x9a,
  0x61,
  0x11,
  0xbe,
  0x1d,
  0x8c,
  0x02,
  0x1e,
  0x65,
  0xb8,
  0x91,
  0xc2,
  0xa2,
  0x11,
  0x16,
  0x7a,
  0xbb,
  0x8c,
  0x5e,
  0x07,
  0x9e,
  0x09,
  0xe2,
  0xc8,
  0xa8,
  0x33,
  0x9c,
];

/** What a ServerHello or HelloRetryRequest says. */
export struct ServerHello {
  /** Whether it is a HelloRetryRequest. */
  retry: bool;
  /** The cipher suite chosen. */
  suite: usize;
  /** The server's key share (ServerHello) for `group`, empty in a HelloRetryRequest. */
  keyShare: u8[];
  /** The key share's group, or the one a HelloRetryRequest asks for (0 when it asks for none). */
  group: usize;
  /** A HelloRetryRequest's cookie, or null. */
  cookie: u8[] | null;
  /** Whether the server chose TLS 1.2 (RFC 5246 §7.4.1.3): what follows is only for it. */
  tls12: bool;
  /** The server's random. */
  random: u8[];
  /** Whether the server agreed to the extended master secret (RFC 7627). */
  ems: bool;
  /** The protocol the server chose with ALPN, or null (TLS 1.3 sends it encrypted instead). */
  alpn: string | null;
}

/**
 * The ServerHello in `body` (the message without its 4-byte header), checked against `sessionId`
 * and the group `offered` of the client's last key share; the suite must be one of `suites`, the
 * client's. `retried` says a HelloRetryRequest came already: another one is `unexpected_message`
 * whatever it says (RFC 8446 §4.1.4).
 */
export function parseServerHello(
  body: u8[],
  sessionId: u8[],
  suites: usize[],
  offered: usize,
  retried: bool,
): ServerHello {
  const r = new ByteReader(body, 0, body.length, "ServerHello");
  checkLegacyVersion(r.u16());
  const random = r.bytes(32);
  let retry = true;
  for (let i: usize = 0; i < 32; i++) {
    if (random[i] != HRR_RANDOM[i]) {
      retry = false;
    }
  }
  if (retry && retried) {
    throw new TlsFailure(UNEXPECTED_MESSAGE, "a second HelloRetryRequest");
  }
  const echo = r.vector(1);
  const sid = echo.bytes(echo.left());
  let same = sid.length == sessionId.length;
  for (let i: usize = 0; same && i < sid.length; i++) {
    same = sid[i] == sessionId[i];
  }
  const suite = r.u16();
  if (r.u8() != 0) {
    throw new TlsFailure(ILLEGAL_PARAMETER, "the server chose a compression method");
  }
  let version: usize = 0;
  let keyShare: u8[] = [];
  let group: usize = 0;
  let cookie: u8[] | null = null;
  let ems = false;
  let alpn: string | null = null;
  // TLS 1.2 servers may omit the extensions altogether.
  if (r.left() > 0) {
    const exts = r.vector(2);
    const seen: usize[] = [];
    while (exts.left() > 0) {
      const type = exts.u16();
      const e = exts.vector(2);
      if (seen.includes(type)) {
        throw new TlsFailure(ILLEGAL_PARAMETER, `the extension ${type} twice in the ServerHello`);
      }
      seen.push(type);
      if (type == EXT_SUPPORTED_VERSIONS) {
        version = e.u16();
      } else if (type == EXT_KEY_SHARE) {
        group = e.u16();
        if (!retry) {
          const k = e.vector(2);
          keyShare = k.bytes(k.left());
        }
      } else if (type == EXT_COOKIE && retry) {
        const c = e.vector(2);
        cookie = c.bytes(c.left());
      } else if (type == EXT_EXTENDED_MASTER_SECRET) {
        ems = true;
      } else if (type == EXT_RENEGOTIATION_INFO) {
        // An initial handshake's is empty (RFC 5746 §3.4).
        const c = e.vector(1);
        if (c.left() != 0) {
          throw new TlsFailure(HANDSHAKE_FAILURE, "a renegotiation_info that is not empty");
        }
      } else if (type == EXT_ALPN) {
        const list = e.vector(2);
        const one = list.vector(1);
        list.finish();
        // Protocol names are bytes (RFC 7301 §3.1): one that is not UTF-8 is not one offered.
        alpn = utf8DecodeLossy(one.bytes(one.left()));
      } else {
        e.skip(e.left());
      }
      e.finish();
    }
  }
  r.finish();
  if (version == 0) {
    // No supported_versions: the server chose TLS 1.2 by legacy_version (RFC 8446 §4.1.3).
    let offered12 = false;
    for (const s of suites) {
      offered12 = offered12 || tls12Suite(s);
    }
    if (!offered12) {
      throw new TlsFailure(PROTOCOL_VERSION, "the server chose TLS 1.2, which was not offered");
    }
    if (retried) {
      throw new TlsFailure(ILLEGAL_PARAMETER, "a TLS 1.2 ServerHello after a HelloRetryRequest");
    }
    if (sameBytes(random, 24, DOWNGRADE_TLS12)) {
      throw new TlsFailure(
        ILLEGAL_PARAMETER,
        "the server has TLS 1.3 but chose TLS 1.2: a downgrade (RFC 8446 §4.1.3)",
      );
    }
    if (same && sid.length > 0) {
      // Echoing the session id resumes a session, and this client never offered one.
      throw new TlsFailure(ILLEGAL_PARAMETER, "a TLS 1.2 ServerHello that resumes a session");
    }
    if (!suites.includes(suite) || !tls12Suite(suite)) {
      throw new TlsFailure(
        ILLEGAL_PARAMETER,
        `the server chose a TLS 1.2 cipher suite not offered (0x${suite.toString(16)})`,
      );
    }
    return {
      retry: false,
      suite: suite,
      keyShare: [],
      group: 0,
      cookie: null,
      tls12: true,
      random: random,
      ems: ems,
      alpn: alpn,
    };
  }
  if (!same) {
    throw new TlsFailure(ILLEGAL_PARAMETER, "the ServerHello does not echo the session id");
  }
  if (!suites.includes(suite) || !knownSuite(suite)) {
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the server chose a cipher suite not offered (0x${suite.toString(16)})`,
    );
  }
  if (version != 0x0304) {
    throw new TlsFailure(
      PROTOCOL_VERSION,
      `the server chose version 0x${hex4(version)} in supported_versions`,
    );
  }
  if (!retry) {
    if (group == 0) {
      throw new TlsFailure(MISSING_EXTENSION, "the ServerHello has no key share");
    }
    if (group != offered || !pointFormOk(group, keyShare)) {
      throw new TlsFailure(
        ILLEGAL_PARAMETER,
        `the server's key share is not for ${groupName(offered)}`,
      );
    }
  } else if (group == offered) {
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the HelloRetryRequest asks for the ${groupName(group)} share already sent`,
    );
  } else if (group != 0 && !groupSupported(group)) {
    // Not one of supported_groups (RFC 8446 §4.1.4).
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the HelloRetryRequest asks for key exchange group 0x${group.toString(16)}, which was not offered`,
    );
  }
  return {
    retry: retry,
    suite: suite,
    keyShare: keyShare,
    group: group,
    cookie: cookie,
    tls12: false,
    random: random,
    ems: false,
    alpn: null,
  };
}

// Whether `a[at..]` starts with `b`.
function sameBytes(a: u8[], at: usize, b: u8[]): bool {
  for (let i: usize = 0; i < b.length; i++) {
    if (a[at + i] != b[i]) {
      return false;
    }
  }
  return true;
}

// TLS 1.3 and 1.2 both have legacy_version 0x0303 (§4.1.3): below it the server chose a version
// older than TLS 1.2, which is not supported (protocol_version); above it the field is wrong.
function checkLegacyVersion(v: usize) {
  if (v < 0x0303) {
    throw new TlsFailure(
      PROTOCOL_VERSION,
      `the server chose version 0x${hex4(v)}, older than TLS 1.2`,
    );
  }
  if (v != 0x0303) {
    throw new TlsFailure(
      ILLEGAL_PARAMETER,
      `the ServerHello's legacy_version is 0x${hex4(v)}, not 0x0303`,
    );
  }
}

function hex4(v: usize): string {
  return v.toString(16).padStart(4, "0");
}

/** The name of the named group `g` for messages: X25519, secp256r1, secp384r1, else its number in hex. */
export function groupName(g: usize): string {
  if (g == X25519) {
    return "X25519";
  }
  if (g == SECP256R1) {
    return "secp256r1";
  }
  if (g == SECP384R1) {
    return "secp384r1";
  }
  return `group 0x${hex4(g)}`;
}
