    "69664326d36365cd607dd824812b3ad6a4773f0cc2ed70506c8913cdb0d06e475d805ae518e33db54041d6c23df36419",
  ];
}

// A transport that plays back `input` in pieces of `chunk` bytes and records what is written.
class Playback implements ByteStream {
  private input: u8[];
  private pos: usize;
  private chunk: usize;
  written: u8[];

  constructor(input: u8[], chunk: usize) {
    this.input = input;
    this.pos = 0;
    this.chunk = chunk;
    this.written = [];
  }

  async readInto(buf: Uint8Array): Promise<number | null> {
    if (this.pos == this.input.length) {
      return null;
    }
    let n = this.input.length - this.pos;
    if (n > this.chunk) {
      n = this.chunk;
    }
    if (n > buf.len) {
      n = buf.len;
    }
    for (let i: usize = 0; i < n; i++) {
      buf.buf.bytes[buf.off + i] = this.input[this.pos + i];
    }
    this.pos += n;
    return n as number;
  }

  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    if (data instanceof Uint8Array) {
      return;
    }
    const to = end ?? (data.length as number);
    for (let i = start as usize; i < (to as usize); i++) {
      this.written.push(data[i]);
    }
  }

  close() {}

  async halfClose(): Promise<void> {}
}

// The plaintext record of the ClientHello `hello`, as the client sends it (record version 3.1).
function helloRecord(hello: string): string {
  const n = hello.length / 2;
  return "160301" + hexEncode([((n >> 8) & 0xff) as u8, (n & 0xff) as u8]) + hello;
}

/** What a replay wrote, read and how it ended. */
class Outcome {
  written: string = "";
  reply: string = "";
  error: string = "";
}

// The client's handshake against the server's recorded bytes `server` (changed or not), then the
// request and the reply, read in pieces of `chunk`.
async function replay(trace: string[], server: string, chunk: usize = 1000000): Promise<Outcome> {
  const t = new Playback(hexDecode(server), chunk);
  const out = new Outcome();
  try {
    const e = new TlsEngine(t);
    await e.handshake(
      {
        random: hexDecode("5a".repeat(32)),
        sessionId: hexDecode("3c".repeat(32)),
        publicKey: x25519PublicKey(hexDecode(X25519_PRIVATE)),
        serverName: "",
        alpn: [],
        fixed: hexDecode(trace[0]),
        fixedRetry: null,
        suites: SUITES.slice(),
        retryKey: hexDecode(P256_PRIVATE),
      },
      hexDecode(X25519_PRIVATE),
    );
    const s = new TlsStream(e);
    await s.write(REQUEST);
    while (true) {
      const b = await s.read();
      if (b.length == 0) {
        break;
      }
      for (const c of b) {
        out.reply += String.fromCharCode(c as number);
      }
    }
  } catch (err) {
    out.error = err instanceof IoError ? err.message : `${err}`;
  }
  out.written = hexEncode(t.written);
  return out;
}

// `hex` with the byte at `at` XORed with `x`.
function flip(hex: string, at: usize, x: u8): string {
  const b = hexDecode(hex);
  b[at] ^= x;
  return hexEncode(b);
}

// The offset of the `n`th record (from 0) in the records `hex`.
function recordAt(hex: string, n: usize): usize {
  const b = hexDecode(hex);
  let at: usize = 0;
  for (let i: usize = 0; i < n; i++) {
    at += 5 + (((b[at + 3] as usize) << 8) | (b[at + 4] as usize));
  }
  return at;
}

function names(): string[] {
  return ["AES-128-GCM, X25519", "AES-256-GCM-SHA384, secp256r1", "ChaCha20, RSA", "no EMS"];
}

function traces(): string[][] {
  return [aes128Trace(), aes256Trace(), chachaTrace(), noEmsTrace()];
}

describe("the TLS 1.2 client against OpenSSL", () => {
  for (let i: usize = 0; i < 4; i++) {
    it(`writes the recorded records and reads the reply (${names()[i]})`, async () => {
      const trace = traces()[i];
      for (const chunk of [1000000, 1] as usize[]) {
        const o = await replay(trace, trace[1], chunk);
        expect(o.written).toBe(helloRecord(trace[0]) + trace[2]);
        expect(o.reply.startsWith("HTTP/1.0 200 ok\r\n")).toBe(true);
        expect(o.reply.includes("Protocol  : TLSv1.2")).toBe(true);
        // s_server -www closes without close_notify.
        expect(o.error).toBe("TLS: the connection closed without close_notify");
      }
    });
  }

  it("refuses a changed server Finished, and a changed key exchange", async () => {
    const trace = aes128Trace();
    // The Finished record (the sixth): its tag no longer matches.
    const fin = recordAt(trace[1], 5);
    expect((await replay(trace, flip(trace[1], fin + 20, 1))).error).toBe(
      "TLS: a record failed authentication (bad_record_mac)",
    );
    // A byte of the server's X25519 point (in the third record): another shared secret.
    const ske = recordAt(trace[1], 2);
    expect((await replay(trace, flip(trace[1], ske + 5 + 4 + 4 + 3, 1))).error).toBe(
      "TLS: a record failed authentication (bad_record_mac)",
    );
  });

  it("refuses the downgrade sentinel in the server random", async () => {
    // ServerHello's random starts 11 bytes into its record; the sentinel is its last 8 bytes.
    const sh = hexDecode(aes128Trace()[1]);
    const sentinel: u8[] = [0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x01];
    for (let i: usize = 0; i < 8; i++) {
      sh[11 + 24 + i] = sentinel[i];
    }
    const o = await replay(aes128Trace(), hexEncode(sh));
    expect(o.error).toBe(
      "TLS: the server has TLS 1.3 but chose TLS 1.2: a downgrade (RFC 8446 §4.1.3)",
    );
    // The alert went: illegal_parameter.
    expect(o.written.endsWith("15030300020" + "22f")).toBe(true);
  });

  it("refuses a ServerHello that resumes the session id it was sent", async () => {
    // OpenSSL's ServerHello has a session id of its own, 32 bytes after the random: make it the
    // client's (3c..), which offers to resume nothing.
    const sh = hexDecode(aes128Trace()[1]);
    expect(sh[43]).toBe(32);
    for (let i: usize = 0; i < 32; i++) {
      sh[44 + i] = 0x3c;
    }
    expect((await replay(aes128Trace(), hexEncode(sh))).error).toBe(
      "TLS: a TLS 1.2 ServerHello that resumes a session",
    );
  });

  it("refuses a second ChangeCipherSpec and a Finished without one", async () => {
    const trace = aes128Trace();
    const ccs = recordAt(trace[1], 4);
    const fin = recordAt(trace[1], 5);
    const twice =
      trace[1].slice(0, (2 * fin) as i64) + "140303000101" + trace[1].slice((2 * fin) as i64);
    expect((await replay(trace, twice)).error).toBe("TLS: a ChangeCipherSpec out of place");
    const none = trace[1].slice(0, (2 * ccs) as i64) + trace[1].slice((2 * fin) as i64);
    expect((await replay(trace, none)).error).toContain("TLS: ");
    expect((await replay(trace, none)).reply).toBe("");
  });

  it(
    "ends the connection with close_notify at the write key's limit: TLS 1.2 has no KeyUpdate",
    async () => {
      const trace = aes128Trace();
      const t = new Playback(hexDecode(trace[1]), 1000000);
      const e = new TlsEngine(t);
      await e.handshake(
        {
          random: hexDecode("5a".repeat(32)),
          sessionId: hexDecode("3c".repeat(32)),
          publicKey: x25519PublicKey(hexDecode(X25519_PRIVATE)),
          serverName: "",
          alpn: [],
          fixed: hexDecode(trace[0]),
          fixedRetry: null,
          suites: SUITES.slice(),
          retryKey: hexDecode(P256_PRIVATE),
        },
        hexDecode(X25519_PRIVATE),
      );
      // The Finished went at sequence number 0: one more record, then the limit.
      e.out.writeLimit = 2;
      const s = new TlsStream(e);
      await s.write(REQUEST);
      expect(hexEncode(t.written)).toBe(helloRecord(trace[0]) + trace[2]);
      let error = "";
      try {
        await s.write(REQUEST);
      } catch (err) {
        error = err instanceof IoError ? err.message : `${err}`;
      }
      expect(error).toContain("TLS 1.2 has no KeyUpdate");
      // One more record went: close_notify, protected (5 + 8 + 2 + 16 bytes), no KeyUpdate.
      const extra = hexEncode(t.written).slice((helloRecord(trace[0]) + trace[2]).length as i64);
      expect(extra.slice(0, 10)).toBe("150303001a");
      expect(extra.length).toBe(2 * 31);
    },
  );

  it("refuses a ServerHello that left out the extended master secret OpenSSL used", async () => {
    // Without it the client derives the master secret from the randoms, and OpenSSL's records
    // don't open: the extension is what both sides agree on. (Its type, 0x0017, renamed to an
    // unknown 0x7717.)
    const trace = aes128Trace();
    const sh = trace[1].slice(0, (2 * recordAt(trace[1], 1)) as i64);
    const at = sh.indexOf("00170000");
    expect(at > 0).toBe(true);
    const changed = sh.slice(0, at as i64) + "77170000" + trace[1].slice((at + 8) as i64);
    expect((await replay(trace, changed)).error).toBe(
      "TLS: a record failed authentication (bad_record_mac)",
    );
  });
});
