// velt/net (internal): whether a certificate is for a name, as rustls's webpki decides it
// (its subject_name module, ported rule for rule): the server's DNS name or IP address against
// the certificate's subjectAltName, and the matching of DNS names and IP addresses that name
// constraints (velt/net/tls/x509/name_constraints) share.
//
// DNS names: only dNSName entries count, never the subject's common name. Letters compare
// without case. A presented name may start with one wildcard label, exactly `*`, which stands
// for one whole label and needs two more labels after it. The reference name (what the caller
// connects to) may end with a dot. A presented name that is not a valid DNS name is skipped.
// IP addresses: only iPAddress entries count, compared byte for byte.

import { Certificate } from "velt/net/tls/x509/certificate";
import { DerReader } from "velt/net/tls/x509/der";

/** What a comparison says: a match, none, or why it could not be made. */
export const MATCH: i32 = 1;
export const NO_MATCH: i32 = 0;
export const MALFORMED_DNS_NAME: i32 = -1;
export const MALFORMED_CONSTRAINT: i32 = -2;
export const BAD_NETWORK_MASK: i32 = -3;
export const BAD_NAME_ENCODING: i32 = -4;

/** What the second name of `dnsNameMatches` is. */
export const REFERENCE: i32 = 0;
export const PERMITTED_SUBTREE: i32 = 2;
export const EXCLUDED_SUBTREE: i32 = 3;
// The first name's role, for `validDnsId` only.
const PRESENTED: i32 = 1;

/** GeneralName's tags (RFC 5280 §4.2.1.6) that are matched. */
export const DNS_NAME: u8 = 0x82;
export const DIRECTORY_NAME: u8 = 0xa4;
export const URI: u8 = 0x86;
export const IP_ADDRESS: u8 = 0x87;

function lower(b: u8): u8 {
  return b >= 0x41 && b <= 0x5a ? b + 0x20 : b;
}

// Whether `b[s..e]` is a DNS name in `role`: labels of letters, digits, `-` and `_`, at most 63
// bytes each and 253 in all, none starting or ending with a hyphen, the last not all digits. A
// reference may end with a dot; a constraint may be empty or start with one; with `wildcards` a
// first label `*` is allowed when at least two labels follow.
function validDnsId(b: u8[], s: usize, e: usize, role: i32, wildcards: bool): bool {
  if (e - s > 253) {
    return false;
  }
  const constraint = role == PERMITTED_SUBTREE || role == EXCLUDED_SUBTREE;
  if (constraint && s == e) {
    return true;
  }
  let dots = 0;
  let labelLength = 0;
  let allNumeric = false;
  let endsWithHyphen = false;
  let p = s;
  const wildcard = wildcards && p < e && b[p] == 0x2a;
  let first = !wildcard;
  if (wildcard) {
    if (p + 2 > e || b[p + 1] != 0x2e) {
      return false;
    }
    p += 2;
    dots = 1;
  }
  while (true) {
    if (p >= e) {
      return false;
    }
    const c = b[p];
    p += 1;
    if (c == 0x2d) {
      if (labelLength == 0) {
        return false;
      }
      allNumeric = false;
      endsWithHyphen = true;
      labelLength += 1;
    } else if (c >= 0x30 && c <= 0x39) {
      if (labelLength == 0) {
        allNumeric = true;
      }
      endsWithHyphen = false;
      labelLength += 1;
    } else if ((c >= 0x61 && c <= 0x7a) || (c >= 0x41 && c <= 0x5a) || c == 0x5f) {
      allNumeric = false;
      endsWithHyphen = false;
      labelLength += 1;
    } else if (c == 0x2e) {
      dots += 1;
      if (labelLength == 0 && (!constraint || !first)) {
        return false;
      }
      if (endsWithHyphen) {
        return false;
      }
      labelLength = 0;
    } else {
      return false;
    }
    if (labelLength > 63) {
      return false;
    }
    first = false;
    if (p == e) {
      break;
    }
  }
  if (labelLength == 0 && role != REFERENCE) {
    return false;
  }
  if (endsWithHyphen || allNumeric) {
    return false;
  }
  if (wildcard) {
    const labels = labelLength == 0 ? dots : dots + 1;
    if (labels < 3) {
      return false;
    }
  }
  return true;
}

/**
 * Whether the presented DNS name `p[ps..pe]` (from a certificate) matches `r[rs..re]`, which is
 * the reference name (`role` `REFERENCE`) or a name constraint's base (`PERMITTED_SUBTREE`,
 * `EXCLUDED_SUBTREE`): `MATCH`, `NO_MATCH`, or `MALFORMED_DNS_NAME` / `MALFORMED_CONSTRAINT`
 * when a name is not one.
 *
 * A constraint matches the names at or under it (one starting with a dot only those under it; an
 * empty one all). A wildcard counts as inside a permitted subtree only when all it can stand
 * for is, and as inside an excluded one when any of it can be.
 */
export function dnsNameMatches(
  p: u8[],
  ps: usize,
  pe: usize,
  role: i32,
  r: u8[],
  rs: usize,
  re: usize,
): i32 {
  if (!validDnsId(p, ps, pe, PRESENTED, true)) {
    return MALFORMED_DNS_NAME;
  }
  const constraint = role != REFERENCE;
  if (!validDnsId(r, rs, re, role, false)) {
    return constraint ? MALFORMED_CONSTRAINT : MALFORMED_DNS_NAME;
  }
  let pi = ps;
  let ri = rs;
  const pLen = pe - ps;
  const rLen = re - rs;
  if (constraint && pLen > rLen) {
    if (rLen == 0) {
      return MATCH;
    }
    // Compare the presented name's end: all of the constraint, on a label's edge.
    if (r[rs] == 0x2e) {
      pi += pLen - rLen;
    } else {
      pi += pLen - rLen - 1;
      if (p[pi] != 0x2e) {
        return NO_MATCH;
      }
      pi += 1;
    }
  }
  if (pi < pe && p[pi] == 0x2a && role != PERMITTED_SUBTREE) {
    // The wildcard takes the reference's first label.
    pi += 1;
    while (true) {
      if (ri >= re) {
        return NO_MATCH;
      }
      ri += 1;
      if (ri < re && r[ri] == 0x2e) {
        break;
      }
    }
  }
  while (true) {
    if (pi >= pe || ri >= re) {
      return NO_MATCH;
    }
    const pb = p[pi];
    if (lower(pb) != lower(r[ri])) {
      return NO_MATCH;
    }
    pi += 1;
    ri += 1;
    if (pi == pe) {
      if (pb == 0x2e) {
        return MALFORMED_DNS_NAME;
      }
      break;
    }
  }
  if (ri != re) {
    // A reference may go on with its final dot, a constraint with nothing.
    if (!constraint) {
      if (r[ri] != 0x2e) {
        return NO_MATCH;
      }
      ri += 1;
    }
    if (ri != re) {
      return NO_MATCH;
    }
  }
  return MATCH;
}

/**
 * Whether the presented address `name[ns..ne]` is inside the constraint `c[cs..ce]` (an address
 * and a mask, RFC 5280 §4.2.1.10): `MATCH`, `NO_MATCH` (also for the other IP version),
 * `BAD_NETWORK_MASK` for a mask whose one bits are not all in front or a constraint of another
 * length, `BAD_NAME_ENCODING` for a name that is not 4 or 16 bytes.
 */
export function ipInConstraint(
  name: u8[],
  ns: usize,
  ne: usize,
  c: u8[],
  cs: usize,
  ce: usize,
): i32 {
  const n = ne - ns;
  const cLen = ce - cs;
  if (n != 4 && n != 16) {
    return BAD_NAME_ENCODING;
  }
  if (cLen != 2 * n) {
    return (n == 4 && cLen == 32) || (n == 16 && cLen == 8) ? NO_MATCH : BAD_NETWORK_MASK;
  }
  let seenZero = false;
  for (let i: usize = 0; i < n; i++) {
    const mask = c[cs + n + i];
    // Ones, then zeros: the complement plus one is a power of two (or zero).
    const inverse = ~mask;
    if ((inverse & (inverse + 1)) != 0) {
      return BAD_NETWORK_MASK;
    }
    if (seenZero && mask != 0) {
      return BAD_NETWORK_MASK;
    }
    if (mask != 0xff) {
      seenZero = true;
    }
    if (((name[ns + i] ^ c[cs + i]) & mask) != 0) {
      return NO_MATCH;
    }
  }
  return MATCH;
}

/**
 * Whether `cert` has a dNSName in its subjectAltName that matches the DNS name `name` (ASCII;
 * an internationalized name in its A-label form).
 */
export function certificateHasDnsName(cert: Certificate, name: u8[]): bool {
  const san = cert.subjectAltName;
  if (san.tag == 0) {
    return false;
  }
  const r = new DerReader(cert.der);
  r.pos = san.start;
  while (r.pos < san.end) {
    const t = r.any(san.end);
    if (t.tag != DNS_NAME) {
      continue;
    }
    if (dnsNameMatches(cert.der, t.start, t.end, REFERENCE, name, 0, name.length) == MATCH) {
      return true;
    }
  }
  return false;
}

/** Whether `cert` has the IP address `ip` (4 or 16 bytes) as an iPAddress in its subjectAltName. */
export function certificateHasIpAddress(cert: Certificate, ip: u8[]): bool {
  const san = cert.subjectAltName;
  if (san.tag == 0 || (ip.length != 4 && ip.length != 16)) {
    return false;
  }
  const r = new DerReader(cert.der);
  r.pos = san.start;
  while (r.pos < san.end) {
    const t = r.any(san.end);
    if (t.tag != IP_ADDRESS || t.end - t.start != ip.length) {
      continue;
    }
    let same = true;
    for (let i: usize = 0; i < ip.length; i++) {
      if (cert.der[t.start + i] != ip[i]) {
        same = false;
      }
    }
    if (same) {
      return true;
    }
  }
  return false;
}
