// velt/net (tests): the built-in trust anchors (roots.velt): how many there are and of which
// kinds, a hash of the whole table, and a root everyone knows. That the table equals
// webpki-roots' anchors one by one is crates/velt_http/tests/roots_table.rs.
import { describe, expect, it } from "velt/test";
import { sha256 } from "velt/crypto/sha256";
import { hexDecode, hexEncode } from "velt/encoding/hex";
import { utf8Encode } from "velt/encoding/utf8";
import { KEY_P256, KEY_P384, KEY_RSA } from "velt/net/tls/x509/algorithms";
import { Certificate } from "velt/net/tls/x509/certificate";
import { PathBuilder } from "velt/net/tls/x509/path";
import { verifySignature } from "velt/net/tls/x509/signed";
import { INVALID_SIGNATURE, UNKNOWN_ISSUER, VALID } from "velt/net/tls/x509/verify_error";
import { builtinAnchorBytes, builtinAnchors, builtinAnchorsNamed } from "velt/net/tls/x509/roots";

// Whether `needle` occurs in `hay`.
function contains(hay: u8[], needle: u8[]): bool {
  for (let i: usize = 0; i + needle.length <= hay.length; i++) {
    let same = true;
    for (let j: usize = 0; j < needle.length && same; j++) {
      same = hay[i + j] == needle[j];
    }
    if (same) {
      return true;
    }
  }
  return false;
}

// Let's Encrypt's intermediate R10 (letsencrypt.org/certs/2024/r10.der), which ISRG Root X1
// signed, valid from 2024-03-13 to 2027-03-12.
const R10 =
  "";
// A certificate for localhost that names R10 as its issuer and was signed with another key.
const NOT_BY_R10 =
  "";
// 2027-01-01, within the validity of both.
const NOW: i64 = 1798761600;

describe("the built-in trust anchors", () => {
  it("are webpki-roots 1.0.9's 121, byte for byte", () => {
    const anchors = builtinAnchors();
    expect(anchors.length).toBe(121);
    // SHA-256 of every anchor's subject, key and name constraints, one after the other.
    expect(hexEncode(sha256(builtinAnchorBytes()))).toBe(
      "174cc5b93953394b1c3c1eb08deba372bdd26309456c1cda62060ce070871110",
    );
    let total: usize = 0;
    for (const a of anchors) {
      total += a.subject.length + a.spki.length + a.nameConstraints.length;
    }
    expect(total).toBe(builtinAnchorBytes().length);
  });

  it("have keys path validation can read, but for one", () => {
    let rsa = 0;
    let p256 = 0;
    let p384 = 0;
    let other = 0;
    for (const a of builtinAnchors()) {
      const k = a.keyAlgorithm();
      if (k == KEY_RSA) {
        rsa++;
        // An RSAPublicKey of 2048 bits or more.
        expect(a.key().length >= 270).toBe(true);
      } else if (k == KEY_P256) {
        p256++;
        expect(a.key().length).toBe(65);
      } else if (k == KEY_P384) {
        p384++;
        expect(a.key().length).toBe(97);
      } else {
        other++;
      }
    }
    // The other is a P-521 key, which rustls's webpki does not verify with either.
    expect([rsa, p256, p384, other]).toEqual([80, 3, 37, 1]);
  });

  it("are found by name, the same anchors as in the whole list", () => {
    const all = builtinAnchors();
    let found = 0;
    for (const a of all) {
      // Inside other bytes, to see that the range is what is compared.
      const name: u8[] = [0xff];
      for (const b of a.subject) {
        name.push(b);
      }
      name.push(0xff);
      const same = builtinAnchorsNamed(name, 1, name.length - 1);
      // Two roots may share a name; each of them is in the answer.
      let here = false;
      for (const s of same) {
        expect(hexEncode(s.subject)).toBe(hexEncode(a.subject));
        if (hexEncode(s.spki) == hexEncode(a.spki)) {
          here = hexEncode(s.nameConstraints) == hexEncode(a.nameConstraints);
        }
      }
      expect(here).toBe(true);
      found += same.length;
      expect(builtinAnchorsNamed(name, 0, name.length).length).toBe(0);
      expect(builtinAnchorsNamed(name, 1, name.length - 2).length).toBe(0);
    }
    expect(found >= 121).toBe(true);
    expect(builtinAnchorsNamed([], 0, 0).length).toBe(0);
  });

  it("verify a real intermediate: ISRG Root X1's key checks Let's Encrypt R10's signature", () => {
    const der = hexDecode(R10);
    const r10 = new Certificate(der);
    const roots = builtinAnchorsNamed(der, r10.issuer.start, r10.issuer.end);
    expect(roots.length).toBe(1);
    const tbs = der.slice(r10.tbs.head as i64, r10.tbs.end as i64);
    const sig = der.slice(r10.signature.start as i64, r10.signature.end as i64);
    const root = roots[0];
    const check = (): i32 => verifySignature(
      r10.signatureAlgorithm,
      root.keyAlgorithm(),
      root.key(),
      tbs,
      sig,
    );
    expect(check()).toBe(VALID);
    sig[100] ^= 1;
    expect(check()).toBe(INVALID_SIGNATURE);
  });

  it("are path validation's anchors only when it is told so", () => {
    // The path reaches ISRG Root X1 through R10; then the leaf's signature is not R10's.
    const leaf = new Certificate(hexDecode(NOT_BY_R10));
    expect(new PathBuilder([], [hexDecode(R10)], NOW, true).verify(leaf)).toBe(INVALID_SIGNATURE);
    expect(new PathBuilder([], [hexDecode(R10)], NOW, false).verify(leaf)).toBe(UNKNOWN_ISSUER);
    expect(new PathBuilder([], [hexDecode(R10)], NOW).verify(leaf)).toBe(UNKNOWN_ISSUER);
    // Without R10 there is no way from the leaf to a root.
    expect(new PathBuilder([], [], NOW, true).verify(leaf)).toBe(UNKNOWN_ISSUER);
  });

  it("include ISRG Root X1, and one anchor with name constraints", () => {
    let isrg = 0;
    let constrained = 0;
    for (const a of builtinAnchors()) {
      if (contains(a.subject, utf8Encode("ISRG Root X1"))) {
        isrg++;
        expect(hexEncode(a.subject)).toBe(
          "310b300906035504061302555331293027060355040a1320496e7465726e657420536563757269747920" +
            "52657365617263682047726f7570311530130603550403130c4953524720526f6f74205831",
        );
      }
      if (a.nameConstraints.length > 0) {
        constrained++;
      }
    }
    expect([isrg, constrained]).toEqual([1, 1]);
  });
});
