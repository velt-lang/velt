// velt/net (tests): DNS name and IP address matching (names.velt) against the tables of
// rustls-webpki 0.103.15's own tests (src/subject_name/dns_name.rs and ip_address.rs), which
// this code ports: each row is the presented name, the reference or constraint, and webpki's
// answer (t a match, f none, d a malformed DNS name, c a malformed constraint, m a bad network
// mask), the names in hex and "-" for an empty one.
import { hexDecode } from "velt/encoding/hex";
import { utf8Encode } from "velt/encoding/utf8";
import { describe, expect, it } from "velt/test";
import {
  BAD_NAME_ENCODING,
  BAD_NETWORK_MASK,
  dnsNameMatches,
  EXCLUDED_SUBTREE,
  ipInConstraint,
  MALFORMED_CONSTRAINT,
  MALFORMED_DNS_NAME,
  MATCH,
  NO_MATCH,
  PERMITTED_SUBTREE,
  REFERENCE,
} from "velt/net/tls/x509/names";

// PRESENTED_MATCHES_REFERENCE: a presented name against a reference name.
