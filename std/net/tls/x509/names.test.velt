  return [
    "2e - d",
    "7777772e6578616d706c652e636f6d2e - d",
    "7777772e6578616d706c652e636f6d2e 7777772e6578616d706c652e636f6d2e d",
    "7777772e6578616d706c652e636f6d 2e c",
    "7777772e6578616d706c652e636f6d 7777772e6578616d706c652e636f6d2e c",
    "7777772e6578616d706c652e636f6d 2a2e6578616d706c652e636f6d c",
    "- - d",
    "6578616d706c652e636f6d - t",
    "2a2e6578616d706c652e636f6d - t",
    "7777772e6578616d706c652e636f6d 2e6578616d706c652e636f6d t",
    "7777772e6578616d706c652e636f6d 2e4558414d504c452e434f4d t",
    "7777772e6578616d706c652e636f6d 2e6178616d706c652e636f6d f",
    "7777772e6578616d706c652e636f6d 2e78616d706c652e636f6d f",
    "7777772e6578616d706c652e636f6d 2e6578616d706c2e636f6d f",
    "6261646578616d706c652e636f6d 2e6578616d706c652e636f6d f",
    "7777772e6578616d706c652e636f6d 6578616d706c652e636f6d t",
    "7777772e6578616d706c652e636f6d 4558414d504c452e434f4d t",
    "7777772e6578616d706c652e636f6d 6178616d706c652e636f6d f",
    "7777772e6578616d706c652e636f6d 78616d706c652e636f6d f",
    "7777772e6578616d706c652e636f6d 6578616d706c2e636f6d f",
    "6261646578616d706c652e636f6d 6578616d706c652e636f6d f",
    "2a2e6578616d706c652e636f6d 2e6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 7777772e6578616d706c652e636f6d f",
    "2a2e6578616d706c652e636f6d 7777772e4558414d504c452e434f4d f",
