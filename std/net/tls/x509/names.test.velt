    "2a2e6578616d706c652e636f6d 78616d706c652e636f6d f",
    "2a2e6578616d706c652e636f6d 2e6578616d706c2e636f6d f",
    "2a2e6578616d706c652e636f6d 6578616d706c2e636f6d f",
    "7777772e6578616d706c652e636f6d 7777772e6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 7777772e6578616d706c652e636f6d f",
    "2a2e7777772e6578616d706c652e636f6d 7777772e6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 612e622e6578616d706c652e636f6d f",
    "2a2e622e6578616d706c652e636f6d 612e622e6578616d706c652e636f6d f",
  ];
}

// WILDCARD_EXCLUDED_INTERSECTION: against an excluded subtree.
function excludedRows(): string[] {
  return [
    "2a2e6578616d706c652e636f6d 6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 2e6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 7777772e6578616d706c652e636f6d t",
    "2a2e6578616d706c652e636f6d 7777772e4558414d504c452e434f4d t",
    "2a2e6578616d706c652e636f6d 612e622e6578616d706c652e636f6d f",
    "2a2e6578616d706c652e636f6d 7777772e6f746865722e636f6d f",
  ];
}

// ip_address.rs's PRESENTED_MATCHES_CONSTRAINT: an address against an address and a mask.
function ipRows(): string[] {
  return [
    "20010db8000000000000000000000000 08080808ffffffff f",
    "08080808 20010db8000000000000000000000000ffff0000000000000000000000000000 f",
    "08080808 08080808ffffff01 m",
    "08080808 08080808ffff00ff m",
    "08080808 08080808ff00ffff m",
    "08080808 0808080800ffffff m",
    "08080808 0808080801ffffff m",
    "08080808 0808080880808080 m",
    "08080808 08080808ffffffff t",
    "08080809 08080808ffffffff f",
    "08080809 08080808fffffffe t",
    "0808080a 08080808fffffffe f",
    "0808080a 08080808ffffff00 t",
    "08080f0a 08080808fffff800 t",
    "0808100a 08080808fffff800 f",
    "0808100a 08080808ffff0000 t",
    "081f100a 08080808ffe00000 t",
    "0820100a 08080808ffe00000 f",
    "0820100a 08080808ff000000 t",
    "3f20100a 08080808c0000000 t",
    "4020100a 08080808c0000000 f",
    "4020100a 0808080800000000 t",
    "20010db8000000000000000000000000 20010db8000000000000000000000000fffeffff000000000000000000000000 m",
    "20010db8000000000000000000000000 20010db8000000000000000000000000fffffdff000000000000000000000000 m",
    "20010db8000000000000000000000000 20010db8000000000000000000000000fffffeff000000000000000000000000 m",
    "20010db8000000000000000000000000 20010db8000000000000000000000000fffffcff000000000000000000000000 m",
    "20010db8000000000000000000000000 20010db80000000000000000000000007fffffff000000000000000000000000 m",
    "20010db8000000000000000000000000 20010db8000000000000000000000000ffffffff000000000000000000000000 t",
    "20010db9000000000000000000000000 20010db8000000000000000000000000ffffffff000000000000000000000000 f",
    "20010db9000000000000000000000000 20010db8000000000000000000000000fffffffe000000000000000000000000 t",
    "20010dba000000000000000000000000 20010db8000000000000000000000000fffffffe000000000000000000000000 f",
    "20010dba000000000000000000000000 20010db8000000000000000000000000ffffff00000000000000000000000000 t",
    "20010dca000000000000000000000000 20010db8000000000000000000000000fffffe00000000000000000000000000 t",
    "20010fca000000000000000000000000 20010db8000000000000000000000000fffffe00000000000000000000000000 f",
    "20010fca000000000000000000000000 20010db8000000000000000000000000ffff0000000000000000000000000000 t",
    "20000fca000000000000000000000000 20010db8000000000000000000000000fffe0000000000000000000000000000 t",
    "20030fca000000000000000000000000 20010db8000000000000000000000000fffe0000000000000000000000000000 f",
    "20030fca000000000000000000000000 20010db8000000000000000000000000ff000000000000000000000000000000 t",
    "10030fca000000000000000000000000 20010db8000000000000000000000000e0000000000000000000000000000000 f",
    "10030fca000000000000000000000000 20010db800000000000000000000000000000000000000000000000000000000 t",
  ];
}

function bytes(s: string): u8[] {
  return s == "-" ? [] : hexDecode(s);
}

function letter(result: i32): string {
  if (result == MATCH) {
    return "t";
  }
  if (result == NO_MATCH) {
    return "f";
  }
  if (result == MALFORMED_DNS_NAME) {
    return "d";
  }
  if (result == MALFORMED_CONSTRAINT) {
    return "c";
  }
  return result == BAD_NETWORK_MASK ? "m" : "e";
}

// Runs `rows` in `role` and returns how many there were.
function run(rows: string[], role: i32): number {
  let n = 0;
  for (const row of rows) {
    const f = row.split(" ");
    const p = bytes(f[0]);
    const r = bytes(f[1]);
    const got = letter(dnsNameMatches(p, 0, p.length, role, r, 0, r.length));
    expect(`${row}: ${got}`).toBe(`${row}: ${f[2]}`);
    n++;
  }
  return n;
}

describe("dnsNameMatches", () => {
  it("answers webpki's reference-name table as webpki does", () => {
    expect(run(referenceRows(), REFERENCE)).toBe(110);
  });

  it("answers webpki's permitted-subtree tables as webpki does", () => {
    expect(run(permittedRows(), PERMITTED_SUBTREE)).toBe(35);
  });

  it("answers webpki's excluded-subtree table as webpki does", () => {
    expect(run(excludedRows(), EXCLUDED_SUBTREE)).toBe(6);
  });

  it("reads the names where they are in their arrays", () => {
    const p = hexDecode("ff2a2e622e61ff"); // "*.b.a" inside other bytes
    const r = hexDecode("0000632e622e6100"); // "c.b.a"
    expect(dnsNameMatches(p, 1, 6, REFERENCE, r, 2, 7)).toBe(MATCH);
    expect(dnsNameMatches(p, 1, 6, REFERENCE, r, 2, 8)).toBe(MALFORMED_DNS_NAME);
    expect(dnsNameMatches(p, 0, 6, REFERENCE, r, 2, 7)).toBe(MALFORMED_DNS_NAME);
  });

  it("takes labels of 63 bytes and names of 253, and no more", () => {
    const label: u8[] = [];
    for (let i = 0; i < 63; i++) {
      label.push(0x61);
    }
    expect(dnsNameMatches(label, 0, 63, REFERENCE, label, 0, 63)).toBe(MATCH);
    label.push(0x61);
    expect(dnsNameMatches(label, 0, 64, REFERENCE, label, 0, 64)).toBe(MALFORMED_DNS_NAME);
    // Labels of one letter: "a.a. .. .a" is 253 bytes with 127 of them, 255 with 128.
    const name: u8[] = [0x61];
    for (let i = 0; i < 126; i++) {
      name.push(0x2e);
      name.push(0x61);
    }
    expect(name.length).toBe(253);
    expect(dnsNameMatches(name, 0, 253, REFERENCE, name, 0, 253)).toBe(MATCH);
    name.push(0x2e);
    name.push(0x61);
    expect(dnsNameMatches(name, 0, 255, REFERENCE, name, 0, 255)).toBe(MALFORMED_DNS_NAME);
  });

  it("refuses a name of 254 bytes", () => {
    // "aa", then 126 times ".a".
    const name: u8[] = [0x61, 0x61];
    for (let i = 0; i < 126; i++) {
      name.push(0x2e);
      name.push(0x61);
    }
    expect(name.length).toBe(254);
    expect(dnsNameMatches(name, 0, 254, REFERENCE, name, 0, 254)).toBe(MALFORMED_DNS_NAME);
    expect(dnsNameMatches(name, 1, 254, REFERENCE, name, 1, 254)).toBe(MATCH);
  });

  it(
    "takes underscores, and refuses a last label of digits and a label ending with a hyphen",
    () => {
      const same = (name: string): i32 => {
        const b = utf8Encode(name);
        return dnsNameMatches(b, 0, b.length, REFERENCE, b, 0, b.length);
      };
      expect(same("a_b.test")).toBe(MATCH);
      expect(same("_a.test")).toBe(MATCH);
      expect(same("a.123")).toBe(MALFORMED_DNS_NAME);
      expect(same("192.0.2.1")).toBe(MALFORMED_DNS_NAME);
      expect(same("123.a")).toBe(MATCH);
      expect(same("a.1b")).toBe(MATCH);
      expect(same("a-")).toBe(MALFORMED_DNS_NAME);
      expect(same("a-.test")).toBe(MALFORMED_DNS_NAME);
      expect(same("-a.test")).toBe(MALFORMED_DNS_NAME);
      expect(same("a-b.test")).toBe(MATCH);
    },
  );
});

describe("ipInConstraint", () => {
  it("answers webpki's table as webpki does", () => {
    let n = 0;
    for (const row of ipRows()) {
      const f = row.split(" ");
      const name = hexDecode(f[0]);
      const c = hexDecode(f[1]);
      const got = letter(ipInConstraint(name, 0, name.length, c, 0, c.length));
      expect(`${row}: ${got}`).toBe(`${row}: ${f[2]}`);
      n++;
    }
    expect(n).toBe(40);
  });

  it("refuses names and constraints of other lengths", () => {
    const v4 = hexDecode("c0000201");
    const v6 = hexDecode("20010db8000000000000000000000001");
    const mask4 = hexDecode("c0000200ffffff00");
    expect(ipInConstraint(v4, 0, 4, mask4, 0, 8)).toBe(MATCH);
    expect(ipInConstraint(v4, 0, 3, mask4, 0, 8)).toBe(BAD_NAME_ENCODING);
    expect(ipInConstraint(v4, 0, 0, mask4, 0, 8)).toBe(BAD_NAME_ENCODING);
    expect(ipInConstraint(v4, 0, 4, mask4, 0, 7)).toBe(BAD_NETWORK_MASK);
    expect(ipInConstraint(v4, 0, 4, mask4, 0, 0)).toBe(BAD_NETWORK_MASK);
    expect(ipInConstraint(v6, 0, 16, mask4, 0, 8)).toBe(NO_MATCH);
    expect(ipInConstraint(v6, 0, 16, mask4, 0, 4)).toBe(BAD_NETWORK_MASK);
  });
});
