// velt/net (tests): signature and public key algorithms: real certificates from OpenSSL for each
// mapping, hand-built AlgorithmIdentifiers for the rules.
import { hexDecode } from "velt/encoding/hex";
import {
  KEY_ED25519,
  KEY_P256,
  KEY_P384,
  KEY_RSA,
  KEY_UNKNOWN,
  SIG_ECDSA_SHA256,
  SIG_ECDSA_SHA384,
  SIG_ECDSA_SHA512,
  SIG_ED25519,
  SIG_RSA_PKCS1_SHA256,
  SIG_RSA_PKCS1_SHA384,
  SIG_RSA_PKCS1_SHA512,
  SIG_RSA_PSS_SHA256,
  SIG_RSA_PSS_SHA384,
  SIG_RSA_PSS_SHA512,
  SIG_UNKNOWN,
} from "velt/net/tls/x509/algorithms";
import { Certificate } from "velt/net/tls/x509/certificate";
import { ED25519_ALG, el, KEY_BITS, Parts } from "./parts.test";
import { describe, expect, it } from "velt/test";

