// `-sha384 -sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:48`, RSA-1536.
const PSS_SHA384_DER =
  "308202c5308201baa00302010202142dc247ed941d517aebe30a6ffc9909a63021a9ff304106092a864886f70d01" +
  "010a3034a00f300d06096086480165030402020500a11c301a06092a864886f70d010108300d0609608648016503" +
  "0402020500a2030201303011310f300d06035504030c06707373333834301e170d3236313130363133353830355a" +
  "170d3336313130333133353830355a3011310f300d06035504030c067073733338343081df300d06092a864886f7" +
  "0d01010105000381cd003081c90281c100d41f5d9fa398214789ac8ef6e5f2fd0e8ec5f5c924295bbf50fc0050d5" +
  "bc59802a7e116531e4d65feed2deceeb095c74ad18a4ce66f12c49700546ae74059e27451dd12259b274cc829998" +
  "f945c126ae60996112feb913d5588693f3d8eabb63292008c0e33e3dbbd5809fb10e847d5b13c1d94fda8f473425" +
