// velt/net (tests): the shape of a certificate: stray bytes and wrong tags at each level, the
// version, the serial number, unique IDs and the extension list. Certificates are hand-built.
import { hexEncode } from "velt/encoding/hex";
import { Certificate } from "velt/net/tls/x509/certificate";
import {
  CRITICAL,
  ED25519_ALG,
  el,
  ext,
  KEY_BITS,
  NAME,
  Parts,
  partsWith,
  TIME,
  withExtensions,
} from "./parts.test";
import { describe, expect, it } from "velt/test";

const STRAY = "0500";
const SKI = ext("551d0e", "", "0401aa");

function serialOf(c: Certificate): string {
  return hexEncode(c.der.slice(c.serial.start as i64, c.serial.end as i64));
}

function withSerial(contents: string): Parts {
  const p = new Parts();
  p.serial = el("02", contents);
  return p;
}

describe("a hand-built certificate", () => {
  it("parses", () => {
    const c = new Parts().parsed();
    expect(c.notBefore).toBe(1767225600);
    expect(c.pathLen).toBe(-1);
    expect(c.keyUsage).toBe(-1);
  });
});

describe("stray bytes", () => {
  it("are refused in the outer SEQUENCE", () => {
    const p = new Parts();
    p.outerExtra = STRAY;
    expect(p.failure()).toContain("stray bytes");
  });

  it("are refused after the version", () => {
    const p = new Parts();
    p.version = el("a0", "020102" + STRAY);
    expect(p.failure()).toContain("stray bytes");
  });

  it("are refused in the validity", () => {
    const p = new Parts();
    p.validity = el("30", TIME + TIME + STRAY);
    expect(p.failure()).toContain("stray bytes");
  });

  it("are refused in the SubjectPublicKeyInfo", () => {
    const p = new Parts();
    p.spki = el("30", ED25519_ALG + KEY_BITS + STRAY);
    expect(p.failure()).toContain("stray bytes");
  });

  it("are refused after an extension's value", () => {
    const bad = el("30", el("06", "551d0e") + el("04", "0401aa") + STRAY);
    expect(partsWith(bad).failure()).toContain("stray bytes");
  });

  it("are refused after the extension list", () => {
    const p = new Parts();
    p.exts = el("a3", el("30", SKI) + STRAY);
    expect(p.failure()).toContain("stray bytes");
  });

  it("are refused after the signed fields", () => {
    const p = new Parts();
    p.tbsExtra = STRAY;
    expect(p.failure()).toContain("stray bytes");
  });
});

describe("tags", () => {
  it("are checked on the signed part, the algorithms and the signature", () => {
    const tbs = new Parts();
    tbs.tbsTag = "31";
    expect(tbs.failure()).toContain("expected tag 48, found 49");
    const outer = new Parts();
    outer.outerAlg = el("31", "06032b6570");
    expect(outer.failure()).toContain("expected tag 48, found 49");
    const inner = new Parts();
    inner.innerAlg = el("31", "06032b6570");
    inner.outerAlg = el("31", "06032b6570");
    expect(inner.failure()).toContain("expected tag 48, found 49");
    const sig = new Parts();
    sig.signature = "0403000102";
    expect(sig.failure()).toContain("expected tag 3, found 4");
  });

  it("are checked on the serial, issuer and subject", () => {
    const serial = new Parts();
    serial.serial = "040101";
    expect(serial.failure()).toContain("expected tag 2, found 4");
    const issuer = new Parts();
    issuer.issuer = el("31", NAME.slice(4));
    expect(issuer.failure()).toContain("expected tag 48, found 49");
    const subject = new Parts();
    subject.subject = el("31", NAME.slice(4));
    expect(subject.failure()).toContain("expected tag 48, found 49");
  });

  it("are checked on an extension's id and value", () => {
    const id = el("30", "0403551d0e" + el("04", "0401aa"));
    expect(partsWith(id).failure()).toContain("expected tag 6, found 4");
    const notOctets = el("30", el("06", "551d0e") + el("0c", "0401aa"));
    expect(partsWith(notOctets).failure()).toContain("expected tag 4, found 12");
  });
});

describe("the version", () => {
  it("must be there", () => {
    const p = new Parts();
    p.version = "";
    expect(p.failure()).toContain("not a v3 certificate");
  });

  it("must be v3", () => {
    for (const v of ["020100", "020101", "020103"]) {
      const p = new Parts();
      p.version = el("a0", v);
      expect(p.failure()).toContain("not a v3 certificate");
    }
  });
});

describe("the outer and inner signature algorithms", () => {
  it("must be the same length", () => {
    const longer = new Parts();
    longer.outerAlg = el("30", "06032b6570" + "0500");
    expect(longer.failure()).toContain("differs inside and outside");
    const shorter = new Parts();
    shorter.innerAlg = el("30", "06032b6570" + "0500");
    expect(shorter.failure()).toContain("differs inside and outside");
  });
});

describe("the serial number", () => {
  it("keeps zero, which real trust anchors have", () => {
    expect(serialOf(withSerial("00").parsed())).toBe("00");
  });

  it("keeps a negative value", () => {
    expect(serialOf(withSerial("ff").parsed())).toBe("ff");
    expect(serialOf(withSerial("80").parsed())).toBe("80");
    expect(serialOf(withSerial("ff7f").parsed())).toBe("ff7f");
    expect(serialOf(withSerial("8000000000000000").parsed())).toBe("8000000000000000");
  });

  it("keeps a sign byte that is needed", () => {
    expect(serialOf(withSerial("0080").parsed())).toBe("0080");
    expect(serialOf(withSerial("00ff").parsed())).toBe("00ff");
  });

  it("has no length limit", () => {
    const lengths: i64[] = [19, 20, 21, 22, 40, 127, 128, 300];
    for (const n of lengths) {
      const contents = "7f" + "ee".repeat(n);
      expect(serialOf(withSerial(contents).parsed())).toBe(contents);
    }
  });

  it("must not be empty", () => {
    expect(withSerial("").failure()).toContain("empty INTEGER");
  });

  it("must be minimal", () => {
    expect(withSerial("0001").failure()).toContain("shortest form");
    expect(withSerial("0000").failure()).toContain("shortest form");
    expect(withSerial("ff80").failure()).toContain("shortest form");
    expect(withSerial("ffff").failure()).toContain("shortest form");
  });
});

describe("unique IDs", () => {
  it("are refused, well-formed or not, as webpki refuses them", () => {
    for (const ids of [
      "81020001",
      "82020001",
      "8102000182020001",
      "8202000181020001",
      "8100",
      "81020901",
    ]) {
      const p = new Parts();
      p.afterSpki = ids;
      expect(p.failure()).toContain("stray bytes");
    }
  });

  it("are refused after the extensions as well", () => {
    const p = new Parts();
    p.tbsExtra = "81020001";
    expect(p.failure()).toContain("stray bytes");
  });
});

describe("the extension list", () => {
  it("may be absent", () => {
    const p = new Parts();
    p.exts = "";
    expect(p.failure()).toBe("");
  });

  it("must not be empty", () => {
    const p = new Parts();
    p.exts = withExtensions("");
    expect(p.failure()).toContain("empty extensions");
  });

  it("must hold each extension whole", () => {
    // The list ends two bytes in, inside an extension that goes on inside the [3] element.
    const p = new Parts();
    p.exts = el("a3", "3002" + SKI);
    expect(p.failure()).toContain("past its parent");
  });

  it("must be a SEQUENCE of SEQUENCEs", () => {
    const list = new Parts();
    list.exts = el("a3", el("31", SKI));
    expect(list.failure()).toContain("expected tag 48, found 49");
    const each = new Parts();
    each.exts = withExtensions(el("31", el("06", "551d0e") + el("04", "0401aa")));
    expect(each.failure()).toContain("expected tag 48, found 49");
  });

  it("reads the critical flag strictly, and FALSE as webpki does", () => {
    const bad = ext("551d09", "010101", "0500");
    expect(partsWith(bad).failure()).toContain("bad BOOLEAN");
    expect(partsWith(ext("551d09", "010100", "0500")).failure()).toBe("");
    expect(partsWith(ext("551d09", CRITICAL, "0500")).failure()).toContain("unsupported critical");
  });
});

describe("what parsing does not read", () => {
  it("leaves Name contents to verification", () => {
    const p = new Parts();
    p.issuer = el("30", "ffff");
    p.subject = "3000";
    expect(p.failure()).toBe("");
  });

  it("leaves the key's bytes to verification", () => {
    const p = new Parts();
    p.spki = el("30", ED25519_ALG + "030100");
    const c = p.parsed();
    expect(c.publicKey.end - c.publicKey.start).toBe(0);
  });
});
