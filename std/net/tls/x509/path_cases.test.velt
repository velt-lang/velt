/**
 * "name time leaf intermediates anchors expected webpki": the time in seconds since the Unix
 * epoch, the intermediates as sent and the anchors by name ("-" for none, "," between), what
 * `PathBuilder` must answer (`VALID:` with the number of intermediates on the path), and
 * webpki's own word for it.
 */
export function chainCases(): string[] {
  return [
    "chain_p256_sha256 1797781060 leaf_p256_sha256 int_p256_sha256 root_p256_sha256 VALID:1 Ok:1",
    "chain_p384_sha384 1797781060 leaf_p384_sha384 int_p384_sha384 root_p384_sha384 VALID:1 Ok:1",
    "chain_rsa_sha256 1797781060 leaf_rsa_sha256 int_rsa_sha256 root_rsa_sha256 VALID:1 Ok:1",
    "chain_rsa_sha384 1797781060 leaf_rsa_sha384 int_rsa_sha384 root_rsa_sha384 VALID:1 Ok:1",
    "chain_rsa_sha512 1797781060 leaf_rsa_sha512 int_rsa_sha512 root_rsa_sha512 VALID:1 Ok:1",
    "chain_rsa_sha256_pss 1797781060 leaf_rsa_sha256_pss int_rsa_sha256_pss root_rsa_sha256_pss VALID:1 Ok:1",
    "chain_rsa_sha384_pss 1797781060 leaf_rsa_sha384_pss int_rsa_sha384_pss root_rsa_sha384_pss VALID:1 Ok:1",
    "chain_rsa_sha512_pss 1797781060 leaf_rsa_sha512_pss int_rsa_sha512_pss root_rsa_sha512_pss VALID:1 Ok:1",
    "chain_ed_None 1797781060 leaf_ed_None int_ed_None root_ed_None VALID:1 Ok:1",
    "p384_signs_sha256 1797781060 mix_leaf256 - mix_root VALID:0 Ok:0",
    "p384_signs_sha384 1797781060 mix_leaf384 - mix_root VALID:0 Ok:0",
    "p256_signs_sha384 1797781060 mix_leaf2 - mix_root2 VALID:0 Ok:0",
    "ecdsa_sha512 1797781060 mix_leaf512 - mix_root2 UNSUPPORTED_SIGNATURE_ALGORITHM UnsupportedSignatureAlgorithmContext",
    "rsa_signs_ec_leaf 1797781060 rsa_signs_ec - rsa_root VALID:0 Ok:0",
    "rsa_1024_root 1797781060 weak_leaf - weak_root INVALID_SIGNATURE InvalidSignatureForPublicKey",
    "p521_root 1797781060 p521_leaf - p521_root UNSUPPORTED_SIGNATURE_FOR_KEY UnsupportedSignatureAlgorithmForPublicKeyContext",
    "valid 1797781060 leaf int root VALID:1 Ok:1",
    "leaf_directly_under_root 1797781060 leaf0 - root VALID:0 Ok:0",
    "no_intermediate_sent 1797781060 leaf - root UNKNOWN_ISSUER UnknownIssuer",
    "wrong_root 1797781060 leaf int root_p384_sha384 UNKNOWN_ISSUER UnknownIssuer",
    "no_anchors 1797781060 leaf int - UNKNOWN_ISSUER UnknownIssuer",
    "intermediate_as_anchor 1797781060 leaf - int VALID:0 Ok:0",
    "leaf_as_anchor_self 1797781060 leaf - leaf UNKNOWN_ISSUER UnknownIssuer",
    "expired 2140789060 leaf int root CERT_EXPIRED CertExpired",
    "not_yet_valid 1795016260 leaf int root CERT_NOT_VALID_YET CertNotValidYet",
    "order_shuffled 1797781060 leaf root_p384_sha384,leaf0,int,root root VALID:1 Ok:1",
    "duplicates 1797781060 leaf int,int,int root VALID:1 Ok:1",
    "expired_intermediate 1797781060 leaf_long int_short root CERT_EXPIRED CertExpired",
    "expired_leaf_only 1797781060 leaf_short int root CERT_EXPIRED CertExpired",
