// velt/net (internal): the X.509 v3 extensions (RFC 5280 §4.2) a TLS client reads, as
// rustls's webpki does: keyUsage, subjectAltName, basicConstraints, nameConstraints,
// cRLDistributionPoints (read, not used) and extKeyUsage, plus the key identifiers for chain
// building. Any other extension is skipped, or refused when it is critical.

import { Certificate } from "velt/net/tls/x509/certificate";
import {
  BIT_STRING,
  BOOLEAN,
  DerReader,
  INTEGER,
  OCTET_STRING,
  OID,
  SEQUENCE,
} from "velt/net/tls/x509/der";
import { Tlv } from "velt/net/tls/x509/tlv";
import {
  CE_AUTHORITY_KEY_ID,
  CE_BASIC_CONSTRAINTS,
  CE_CRL_DISTRIBUTION_POINTS,
  CE_EXT_KEY_USAGE,
  CE_KEY_USAGE,
  CE_NAME_CONSTRAINTS,
  CE_SUBJECT_ALT_NAME,
  CE_SUBJECT_KEY_ID,
} from "velt/net/tls/x509/oids";

/**
 * Reads the extension `id` (an OID) with the value `value` (an OCTET STRING) into `c`; `seen`
 * has bit n set for each id-ce extension n read so far, and the result adds this one.
 */
export function readExtension(
  c: Certificate,
  r: DerReader,
  id: Tlv,
  critical: bool,
  value: Tlv,
  seen: u64,
): u64 {
  const b = r.b;
  // id-ce (2.5.29) extensions are 0x55 0x1d n.
  if (id.end - id.start != 3 || b[id.start] != 0x55 || b[id.start + 1] != 0x1d) {
    if (critical) {
      r.fail("an unsupported critical extension");
    }
    return seen;
  }
  const n = b[id.start + 2];
  if (n >= 64) {
    if (critical) {
      r.fail("an unsupported critical extension");
    }
    return seen;
  }
  const bit: u64 = 1 << (n as u64);
  if ((seen & bit) != 0) {
    r.fail(`extension 2.5.29.${n} twice`);
  }
  const end = value.end;
  r.pos = value.start;
  if (n == CE_SUBJECT_KEY_ID) {
    c.subjectKeyId = r.next(OCTET_STRING, end);
  } else if (n == CE_AUTHORITY_KEY_ID) {
    const s = r.enter(SEQUENCE, end);
    if (r.peek(s.end) == 0x80) {
      c.authorityKeyId = r.next(0x80, s.end);
    }
    r.pos = s.end;
  } else if (n == CE_KEY_USAGE) {
    const ku = r.next(BIT_STRING, end);
    c.keyUsage = keyUsageBits(r, ku);
  } else if (n == CE_SUBJECT_ALT_NAME) {
    c.subjectAltName = generalNames(r, end);
  } else if (n == CE_BASIC_CONSTRAINTS) {
    const s = r.enter(SEQUENCE, end);
    if (r.peek(s.end) == (BOOLEAN as i32)) {
      const ca = r.next(BOOLEAN, s.end);
      c.isCa = r.boolean(ca);
    }
    if (r.peek(s.end) == (INTEGER as i32)) {
      const len = r.next(INTEGER, s.end);
      c.pathLen = r.smallInt(len);
    }
    r.done(s.end);
  } else if (n == CE_NAME_CONSTRAINTS) {
    c.nameConstraints = r.next(SEQUENCE, end);
  } else if (n == CE_CRL_DISTRIBUTION_POINTS) {
    r.next(SEQUENCE, end);
  } else if (n == CE_EXT_KEY_USAGE) {
    const s = r.enter(SEQUENCE, end);
    if (s.end == s.start) {
      r.fail("empty extKeyUsage");
    }
    while (r.pos < s.end) {
      r.next(OID, s.end);
    }
    c.extKeyUsage = s;
  } else {
    if (critical) {
      r.fail(`an unsupported critical extension 2.5.29.${n}`);
    }
    r.pos = end;
    return seen;
  }
  r.done(end);
  return seen | bit;
}

// keyUsage's BIT STRING as bits (bit i is the RFC's bit i, the first byte's top bit bit 0).
function keyUsageBits(r: DerReader, t: Tlv): i64 {
  const b = r.b;
  const n = t.end - t.start;
  if (n < 2 || n > 3 || b[t.start] > 7) {
    r.fail("bad keyUsage");
  }
  const unused = b[t.start] as u64;
  const last = b[t.end - 1] as u64;
  // DER: the unused bits are zero and the last byte has a bit set.
  if (last == 0 || (last & ((1 << unused) - 1)) != 0) {
    r.fail("bad keyUsage");
  }
  let bits: i64 = 0;
  for (let i: usize = 0; i < (n - 1) * 8; i++) {
    const byte = b[t.start + 1 + (i >> 3)] as i64;
    bits |= ((byte >> (7 - (i & 7) as i64)) & 1) << (i as i64);
  }
  return bits;
}

// The GeneralNames SEQUENCE (RFC 5280 §4.2.1.6) below `end`: each name a well-formed element.
function generalNames(r: DerReader, end: usize): Tlv {
  const s = r.enter(SEQUENCE, end);
  if (s.end == s.start) {
    r.fail("empty subjectAltName");
  }
  while (r.pos < s.end) {
    const name = r.any(s.end);
    // iPAddress [7]: 4 or 16 bytes in a certificate's SAN.
    if (name.tag == 0x87 && name.end - name.start != 4 && name.end - name.start != 16) {
      r.fail("bad iPAddress");
    }
  }
  return s;
}
