// velt/net (internal): the object identifiers a TLS client reads in X.509 certificates (RFC
// 5280, RFC 3279, RFC 4055, RFC 5480, RFC 8410), as the contents of their DER encoding.

// Public key algorithms and curves.
export const OID_RSA_ENCRYPTION: u8[] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x01];
export const OID_EC_PUBLIC_KEY: u8[] = [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x02, 0x01];
export const OID_P256: u8[] = [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x03, 0x01, 0x07];
export const OID_P384: u8[] = [0x2b, 0x81, 0x04, 0x00, 0x22];
export const OID_ED25519: u8[] = [0x2b, 0x65, 0x70];

// Signature algorithms.
export const OID_SHA256_RSA: u8[] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0b];
export const OID_SHA384_RSA: u8[] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0c];
export const OID_SHA512_RSA: u8[] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0d];
export const OID_RSA_PSS: u8[] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x0a];
export const OID_MGF1: u8[] = [0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d, 0x01, 0x01, 0x08];
export const OID_ECDSA_SHA256: u8[] = [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x02];
export const OID_ECDSA_SHA384: u8[] = [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x03];
export const OID_ECDSA_SHA512: u8[] = [0x2a, 0x86, 0x48, 0xce, 0x3d, 0x04, 0x03, 0x04];

// Hashes (NIST, 2.16.840.1.101.3.4.2.x), for RSA-PSS parameters.
export const OID_SHA256: u8[] = [0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01];
export const OID_SHA384: u8[] = [0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x02];
export const OID_SHA512: u8[] = [0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x03];

// Certificate extensions (id-ce, 2.5.29.x): the last byte after 0x55 0x1d.
export const CE_SUBJECT_KEY_ID: u8 = 14;
export const CE_KEY_USAGE: u8 = 15;
export const CE_SUBJECT_ALT_NAME: u8 = 17;
export const CE_BASIC_CONSTRAINTS: u8 = 19;
export const CE_NAME_CONSTRAINTS: u8 = 30;
export const CE_CRL_DISTRIBUTION_POINTS: u8 = 31;
export const CE_CERTIFICATE_POLICIES: u8 = 32;
export const CE_AUTHORITY_KEY_ID: u8 = 35;
export const CE_EXT_KEY_USAGE: u8 = 37;

// Extended key usages.
export const OID_KP_SERVER_AUTH: u8[] = [0x2b, 0x06, 0x01, 0x05, 0x05, 0x07, 0x03, 0x01];
export const OID_ANY_EXT_KEY_USAGE: u8[] = [0x55, 0x1d, 0x25, 0x00];
