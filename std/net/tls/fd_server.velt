// velt/net (internal): `listenTls` on the reactor under the executor in Velt (#2649): the TLS
// server in Velt (TLS 1.3, and TLS 1.2 for older clients; #2392 steps 4 and 5) for each accepted
// socket. std/net/tcp_sched.velt's `listenTls` calls `velt_rt_tls_listen` by role (velt_common
// `std_hooks.rs` `sched_tls_listen`), so a program loads the server only when live code can listen
// with TLS.

import { IoError } from "velt/io/error";
import { noteStdUse } from "velt/lang/intrinsics";
import { IoResult } from "velt/native/result";
import * as fs from "velt/net/fd_socket";
import { TcpStream } from "velt/net/tcp_stream";
import { FdTlsConn } from "velt/net/tls/fd_conn";
import { installReactorOps, status } from "velt/net/tls/fd_reactor";
import { TlsSession, TlsSessions } from "velt/net/tls/fd_session";
import { addListener, TlsListen } from "velt/net/tls/fd_table";
import { ServerHandshake } from "velt/net/tls/server_handshake";
import { ServerKey, serverKey } from "velt/net/tls/server_key";
import { TicketStore } from "velt/net/tls/ticket_store";
import { TlsEngine } from "velt/net/tls/tls_engine";

/** How long an accepted stream's handshake may take (as the runtime's listener). */
const HANDSHAKE_MS = 10000;

/**
 * The server sessions of one listener: its credentials, ALPN protocols and the session tickets it
 * issued (TLS 1.3 resumption, std/net/tls/server_resume.velt).
 */
export class FdServerSessions implements TlsSessions {
  private key: ServerKey;
  private protocols: string[];
  private tickets: shared<Mutex<TicketStore>>;

  constructor(key: ServerKey, protocols: string[]) {
    this.key = key;
    this.protocols = protocols;
    this.tickets = shared(new Mutex<TicketStore>(new TicketStore()));
  }

  /** The session of accepted socket `fd`; its handshake runs with its first operations. */
  open(fd: u64): TlsSession {
    const h = new ServerHandshake(this.key, this.protocols);
    h.tickets = this.tickets;
    return new FdTlsConn(
      fd,
      new TlsEngine(TcpStream.ofHandle(fd)),
      h,
      (Date.now() as number) + HANDSHAKE_MS,
    );
  }
}

/**
 * A TLS listener served in Velt with any key kind the server signs with (P-256, P-384, Ed25519,
 * RSA; #2392 step 6): on `addr`, bound on the reactor, or on `handed` when not 0 (the runtime's
 * plain listener under `velt dev`, whose supervisor keeps the socket, or with no reactor). Null
 * for a key of another kind. Throws `IoError` `EINVAL` for a certificate or key that is not valid
 * PEM.
 */
export async function listenTls(
  addr: string,
  cert: string,
  key: string,
  alpn: string,
  handed: u64,
): Promise<IoResult<u64> | null, IoError> {
  const sk = serverKey(cert, key, true);
  if (sk == null) {
    return null;
  }
  const l = handed != 0 ? fs.value(handed) : await fs.listenOn(addr);
  if (l.code !== 0) {
    return l;
  }
  const protocols = alpn == "" ? ([] as string[]) : alpn.split(",");
  const sessions: TlsSessions = new FdServerSessions(sk, protocols);
  const entry = shared(new Mutex<TlsListen>(new TlsListen(l.value, sessions)));
  return fs.value(addListener(entry));
}

/**
 * `listenTls` on the reactor for std/net/tcp_sched.velt, which calls it by role (`sched_tls_listen`):
 * `listenTls`'s listener, or the status of its failure (`EINVAL` for a certificate or key that is
 * not valid PEM, or a key of a kind the server doesn't sign with).
 */
export async function velt_rt_tls_listen(
  addr: string,
  cert: string,
  key: string,
  alpn: string,
  handed: u64,
): Promise<IoResult<u64>> {
  // The program can listen with TLS on the reactor: tcp_sched's `stdUsed("reactorTls")` tests are
  // true, so its operations check for TLS handles.
  noteStdUse("reactorTls");
  installReactorOps();
  try {
    const l = await listenTls(addr, cert, key, alpn, handed);
    if (l == null) {
      return fs.failed(
        { code: 4, message: "listenTls: a key of a kind the TLS server doesn't sign with" },
        0,
      );
    }
    return l;
  } catch (e) {
    return fs.failed(status(e), 0);
  }
}
