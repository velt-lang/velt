// EARLY_DERIVED with SHA-384: Derive-Secret(HKDF-Extract(0, 0), "derived", "") over 48 bytes.
const EARLY_DERIVED_384: u8[] = [
  0x15,
  0x91,
  0xda,
  0xc5,
  0xcb,
  0xbf,
  0x03,
