/** The hash of the empty string with the hash of `len` bytes (32: SHA-256, 48: SHA-384). */
export function emptyHash(len: usize): u8[] {
  return len == SHA384_LEN ? EMPTY_HASH_384.slice() : EMPTY_HASH.slice();
}

/** Derive-Secret(secret, "derived", "") for the next extract. */
export function derived(secret: u8[]): u8[] {
  if (secret.length == SHA384_LEN) {
    return expandLabel(secret, "derived", EMPTY_HASH_384, SHA384_LEN);
  }
  return expandLabel(secret, "derived", EMPTY_HASH, 32);
}

/**
 * The handshake secret from the (EC)DHE shared secret, without a PSK, for a suite whose hash
 * has `hashLen` bytes (32 for SHA-256, 48 for SHA-384).
 */
export function handshakeSecret(shared: u8[], hashLen: usize): u8[] {
  if (hashLen == SHA384_LEN) {
    return hkdfExtractSha384(EARLY_DERIVED_384.slice(), shared);
  }
  return hkdfExtractSha256(EARLY_DERIVED.slice(), shared);
}

/** The master secret after `handshake`. */
export function masterSecret(handshake: u8[]): u8[] {
  if (handshake.length == SHA384_LEN) {
    return hkdfExtractSha384(derived(handshake), Buffer.alloc(SHA384_LEN));
  }
  return hkdfExtractSha256(derived(handshake), Buffer.alloc(32));
}

/** The Finished verify_data for the traffic secret `base` over the transcript hash `hash`. */
export function finishedMac(base: u8[], hash: u8[]): u8[] {
  const key = expandLabel(base, "finished", [], base.length);
  return base.length == SHA384_LEN ? hmacSha384(key, hash) : hmacSha256(key, hash);
}

/** The next traffic secret after a KeyUpdate (RFC 8446 §7.2). */
export function nextSecret(secret: u8[]): u8[] {
  return expandLabel(secret, "traffic upd", [], secret.length);
}
