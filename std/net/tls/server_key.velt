// velt/net (internal): a TLS server's certificate chain and private key from PEM text (#2392 step
// 4), as `listenTls` takes them: CERTIFICATE blocks (leaf first) and a P-256, P-384, Ed25519 or
// RSA key (private_key.velt has the forms). The key must match the leaf's public key. A key of
// another kind is reported as such, not as an error, so a caller can choose another server for
// it.

import { RsaSigner } from "velt/crypto/rsa_sign";
import { base64Decode } from "velt/encoding/base64";
import { IoError } from "velt/io/error";
import { fromPkcs1, fromPkcs8, fromSec1, PrivateKey } from "velt/net/tls/private_key";
import { KEY_P256, KEY_RSA } from "velt/net/tls/x509/algorithms";
import { Certificate } from "velt/net/tls/x509/certificate";
import { DerReader, INTEGER, SEQUENCE } from "velt/net/tls/x509/der";

/**
 * A server's credentials: the chain (DER, leaf first) and its private key. `key` is the scalar
 * of a P-256 or P-384 key or the seed of an Ed25519 key; `kind` says which (`KEY_*` of
 * velt/net/tls/x509/algorithms; absent: P-256). An Ed25519 key comes with its `publicKey`, and
 * an RSA key is `rsa` (and `key` is empty).
 */
export struct ServerKey {
  chain: u8[][];
  key: u8[];
  kind?: i32;
  publicKey?: u8[];
  rsa?: RsaSigner;
}

/** One PEM block: its label ("CERTIFICATE") and its DER bytes. */
struct PemBlock {
  label: string;
  der: u8[];
}

// The runtime's messages (crates/velt_rt/src/tls.rs), so both servers fail alike.
function invalid(message: string): IoError {
  return new IoError("EINVAL", message);
}

/**
 * The PEM blocks of `text`, in order. Throws `EINVAL` for a block that is not valid PEM, naming
 * `what` ("certificate", "key").
 */
function pemBlocks(text: string, what: string): PemBlock[] {
  const out: PemBlock[] = [];
  let at = 0;
  while (true) {
    const begin = text.indexOf("-----BEGIN ", at);
    if (begin < 0) {
      return out;
    }
    const labelEnd = text.indexOf("-----", begin + 11);
    if (labelEnd < 0) {
      throw invalid(`invalid ${what} PEM: a BEGIN line without its end`);
    }
    const label = text.slice(begin + 11, labelEnd);
    const endLine = `-----END ${label}-----`;
    const end = text.indexOf(endLine, labelEnd + 5);
    if (end < 0) {
      throw invalid(`invalid ${what} PEM: "${label}" without its END line`);
    }
    let b64 = "";
    for (const line of text.slice(labelEnd + 5, end).split("\n")) {
      b64 += line.trim();
    }
    let der: u8[] = [];
    try {
      der = base64Decode(b64);
    } catch (e) {
      throw invalid(`invalid ${what} PEM: "${label}" is not valid base64`);
    }
    if (der.length == 0) {
      throw invalid(`invalid ${what} PEM: "${label}" is empty`);
    }
    out.push({ label: label, der: der });
    at = end + (endLine.length as i64);
  }
}

/**
 * The chain of `certPem` and the key of `keyPem`, checked to belong together. The key may be
 * P-256, and with `all` also P-384, Ed25519 or RSA; null for any other, so that a caller can
 * choose another server for it (`listenTls` asks for P-256 only until the others are as fast as
 * the runtime's, #2392 step 6). Throws `IoError` `EINVAL` for
 * text that isn't PEM, no certificate, no key, a malformed certificate or key, or a key that
 * doesn't match the leaf certificate.
 */
export function serverKey(
  certPem: string,
  keyPem: string,
  all: bool = false,
): ServerKey | null throws IoError {
  const chain: u8[][] = [];
  for (const b of pemBlocks(certPem, "certificate")) {
    if (b.label == "CERTIFICATE") {
      chain.push(b.der);
    }
  }
  if (chain.length == 0) {
    throw invalid("no certificate found in the certificate PEM");
  }
  let leaf: Certificate;
  try {
    leaf = new Certificate(chain[0]);
  } catch (e) {
    throw invalid(`invalid certificate PEM: ${e}`);
  }
  let key: PrivateKey | null = null;
  let found = false;
  for (const b of pemBlocks(keyPem, "key")) {
    if (b.label == "PRIVATE KEY") {
      key = fromPkcs8(b.der);
    } else if (b.label == "EC PRIVATE KEY") {
      key = fromSec1(b.der, 0);
    } else if (b.label == "RSA PRIVATE KEY") {
      key = fromPkcs1(b.der);
    } else {
      continue;
    }
    found = true;
    break;
  }
  if (!found) {
    throw invalid("invalid key PEM: no private key found");
  }
  if (key == null || (!all && key.kind != KEY_P256)) {
    return null;
  }
  if (leaf.keyAlgorithm != key.kind || !samePublicKey(leaf, key)) {
    throw invalid("certificate and key do not match: the public keys differ");
  }
  return {
    chain: chain,
    key: key.key,
    kind: key.kind,
    publicKey: key.publicKey,
    rsa: key.rsa ?? undefined,
  };
}

// Whether the leaf's subjectPublicKey is `key`'s public half.
function samePublicKey(leaf: Certificate, key: PrivateKey): bool {
  const d = leaf.der;
  const pk = leaf.publicKey;
  if (key.kind != KEY_RSA) {
    const pub = key.publicKey;
    let same = pk.end - pk.start == pub.length;
    for (let i: usize = 0; same && i < pub.length; i++) {
      same = d[pk.start + i] == pub[i];
    }
    return same;
  }
  // An RSAPublicKey: the modulus and the exponent, each without its sign byte.
  try {
    const r = new DerReader(d);
    r.pos = pk.start;
    const top = r.enter(SEQUENCE, pk.end);
    let at: usize = 0;
    for (let part = 0; part < 2; part++) {
      const t = r.next(INTEGER, top.end);
      let start = t.start;
      if (t.end - start > 1 && d[start] == 0) {
        start += 1;
      }
      const len = part == 0 ? key.modulusLength : key.publicKey.length - key.modulusLength;
      if (t.end - start != len) {
        return false;
      }
      for (let i: usize = 0; i < len; i++) {
        if (d[start + i] != key.publicKey[at + i]) {
          return false;
        }
      }
      at += len;
    }
    return true;
  } catch (e) {
    return false;
  }
}
