// velt/net (internal): `connectTls` on the reactor under the executor in Velt (#2649, #2392 step
// 6): a socket dialled on the reactor, the TLS client in Velt's handshake over it (`startTls`'s,
// which checks the server's certificate against the built-in roots and `ca`), then the stream in
// the reactor's table of TLS streams (std/net/tls/fd_table.velt), where it is read, written and
// closed as a `listenTls` stream is (std/net/tls/fd_ops.velt). As std/net/tls/fd_reactor.velt's
// `ConnectHook`. Only the conditional global std/prelude/global/tls_client_reactor.velt loads
// this file, so a program that can't connect with TLS loads none of the client.

import { IoError } from "velt/io/error";
import { IoResult } from "velt/native/result";
import * as fio from "velt/net/fd_io";
import * as fs from "velt/net/fd_socket";
import { TcpStream } from "velt/net/tcp_stream";
import { FdTlsConn } from "velt/net/tls/fd_conn";
import { ConnectHook, TlsConnectSide } from "velt/net/tls/fd_connect_hook";
import "velt/net/tls/fd_reactor";
import { TlsSession } from "velt/net/tls/fd_session";
import { addConn, Conn } from "velt/net/tls/fd_table";
import { clientHandshake } from "velt/net/tls/start_tls";

/** The host of "host:port" ("[v6]:port" gives the address without its brackets). */
export function hostOf(addr: string): string {
  if (addr.startsWith("[")) {
    const close = addr.indexOf("]");
    return close > 0 ? addr.slice(1, close) : addr;
  }
  const colon = addr.lastIndexOf(":");
  return colon >= 0 ? addr.slice(0, colon) : addr;
}

/**
 * A TLS stream to `addr` once its handshake is done: the server's certificate checked against
 * the built-in roots and the PEM certificates of `ca`, for `serverName` (the address's host when
 * ""), offering the comma-separated ALPN protocols of `alpn`. A failure to connect is a status;
 * a handshake that fails throws (`EPROTO`, "TLS: …"; `EINVAL` for a bad `ca` or name).
 */
export async function connectTls(
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
): Promise<IoResult<u64>, IoError> {
  const name = serverName == "" ? hostOf(addr) : serverName;
  const d = await fs.connect(addr);
  if (d.code !== 0) {
    return d;
  }
  const fd = d.value;
  try {
    const engine = await clientHandshake(
      TcpStream.ofHandle(fd),
      { serverName: name, ca: ca, alpn: alpn == "" ? [] : alpn.split(",") },
      "connectTls",
    );
    const c: Conn = shared(new Mutex<TlsSession>(new FdTlsConn(fd, engine, null, 0)));
    return fs.value(addConn(c));
  } catch (e) {
    fio.close(fd);
    // A failure of the crypto (a point off the curve, say) is the handshake's, as TLS reports it.
    throw e instanceof IoError ? e : new IoError("EPROTO", `TLS: ${e}`);
  }
}

/** The client's `connect` for std/net/tls/fd_reactor.velt. */
extend TlsConnectSide implements ConnectHook {
  async connect(
    addr: string,
    serverName: string,
    ca: string,
    alpn: string,
  ): Promise<IoResult<u64> | null> {
    return await connectTls(addr, serverName, ca, alpn);
  }
}
