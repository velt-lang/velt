// velt/net (internal): `park` and `unpark` of std/net/tcp_sched.velt, which calls these: the
// keep-alive pool of `fetch`'s connections under the executor in Velt. The streams of the
// reactor, plain sockets and TLS streams alike, wait in Velt's pool (std/net/fd_pool.velt), which
// is looked at through the right kind before a stream is handed out again (a TLS stream through
// its session, std/net/tls/fd_ops.velt's `idleOpen`).

import { noteStdUse, stdUsed } from "velt/lang/intrinsics";
import * as fio from "velt/net/fd_io";
import * as pool from "velt/net/fd_pool";
import { isTls } from "velt/net/tls/fd_hook";
import * as tlsOps from "velt/net/tls/fd_hook";

export function parkStream(s: u64, key: string) {
  // `fetch` parks here: it then dials plain TCP and TLS on the reactor (fetch/client/conn.velt
  // `dial`).
  noteStdUse("fetch-pool-reactor");
  if (!pool.park(s, key)) {
    closeOurs(s);
  }
}

export function unparkStream(key: string, settled: u32): u64 {
  while (true) {
    const taken = pool.unpark(key, settled !== 0);
    // Closed with the pool's lock let go: closing hands this thread's output off.
    for (const stale of taken.stale) {
      closeOurs(stale);
    }
    if (taken.h === 0) {
      return 0;
    }
    const tls = stdUsed("reactorTls") && isTls(taken.h);
    if (tls ? tlsOps.idleOpen(taken.h) : pool.idleOpen(taken.h)) {
      return taken.h;
    }
    closeOurs(taken.h);
  }
}

// Closes stream `s` of the reactor's: a TLS stream or a socket.
function closeOurs(s: u64) {
  if (stdUsed("reactorTls") && isTls(s)) {
    tlsOps.close(s);
  } else {
    fio.close(s);
  }
}
