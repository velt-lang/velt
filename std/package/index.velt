// velt/package: the type of the package manifest, `package.velt` (https://veltlang.com/docs/tooling/manifest/).
//
// Types only. `velt` never compiles a manifest: it reads it as data (vpm::manifest::read). These
// types give editors completion, hover and errors while writing one:
//
//   import type { Package } from "velt/package";
//
//   export const pkg: Package = { name: "hello", version: "0.1.0" };

export type {
  AllowNative,
  AllowNativeSource,
  Build,
  CLibrary,
  Dependency,
  DependencySource,
  Import,
  Imports,
  Jsx,
  Lint,
  LintLevel,
  Native,
  Package,
} from "./manifest";
export type { Workspace } from "./workspace";
