// velt/package (internal): the types of a package manifest, `package.vlt`
// (https://veltlang.com/docs/tooling/manifest/): `Package` and the types of its fields.

/// A package manifest: the one `export const pkg: Package = { … }` of a `package.vlt`.
export type Package = {
  /// The package name: lowercase letters and digits, starting with a letter, words joined by single
  /// `-` or `_` (`text-kit`). `std`, Windows device names (`con`, `nul`, …) and names whose first
  /// word is `rt`, `sig` or `native` are reserved.
  name: string;
  /// A semantic version, such as `"0.1.0"`.
  version: string;
  /// The velt versions that build the package, such as `"0.1"`: the newest installed `0.1.x`
  /// (`"0.1.3"`: at least `0.1.3`; `"=0.1.3"`: exactly). The velt launcher runs that
  /// toolchain, installing it when it is missing.
  velt?: string;
  /// One line about the package, shown by `velt search` and registry listings: at most 300
  /// characters, no line breaks, no surrounding whitespace.
  description?: string;
  /// Search words, such as `["json", "parser"]`: at most 10, each lowercase letters, digits and
  /// `-` (at most 32 characters).
  keywords?: string[];
  /// The program's root file, a `/`-separated path inside the package (default `"src/main.vlt"`).
  entry?: string;
  /// The registry for dependencies and `velt publish`: an `http://` or `https://` URL (default:
  /// the local registry; `VELT_REGISTRY` takes precedence). Only the root package's is used.
  registry?: string;
  /// Dependencies by package name: a semver requirement (`"^1.2"`), a `DependencySource`, or
  /// `"workspace"` in a member of a workspace (another member, or the workspace's requirement).
  dependencies?: Record<string, Dependency>;
  /// Import aliases, like TypeScript's `compilerOptions.paths`: `{ "@app/*": "src/*" }`. A
  /// pattern and its target have at most one `*`, at the end; targets stay inside the package.
  paths?: Record<string, string>;
  /// Conditional imports, like Node's `imports`: `#name` → a file, or the files per build
  /// condition, `{ "#io": { js: "./src/io/js.vlt", default: "./src/io/native.vlt" } }`. The first
  /// condition the build has wins; `default` comes last. A `#name` resolves only in the package's
  /// own modules.
  imports?: Record<string, Import>;
  /// The JavaScript of the host modules the package's `declare host("m")` functions import, for
  /// the glue a `velt build --host <package>` build writes: `{ kv: "./src/kv.mjs" }`.
  /// Each file is an ES module below `./src/` whose default export makes the module's functions.
  /// A package provides only modules it declares; `velt:` modules are the runtime's.
  hostModules?: Record<string, string>;
  /// Makes the package a host package: `velt build --host <package>` builds programs for the
  /// JavaScript platform it describes.
  host?: Host;
  /// How the package's modules compile JSX.
  jsx?: Jsx;
  /// Build-time constants, as Vite's `define`: `{ __DEV__: "false" }`. Each value is the source
  /// of a literal (`true`, `false`, `null`, a number, or a quoted string such as `"\"1.0\""`);
  /// every use of the name as a value is that literal, so `if (__DEV__)` branches fold. Only the
  /// root package's apply.
  define?: Record<string, string>;
  /// A Rust crate in the package, built into a native library.
  native?: Native;
  /// The packages with native code (C libraries or a Rust crate) the program allows:
  /// `["sqlite"]` from the registry (or a local path), `{ name: "llama", git: "https://…" }` from
  /// that repository, `{ name: "duck", url: "https://…/releases/download/" }` from archives under
  /// that prefix. Installing or building with any other package that has native code, or with a
  /// listed one from another source, is an error. Only the root package's applies.
  allowNative?: AllowNative[];
  /// Folders whose modules stay valid TypeScript too, such as `["src/components", "src/models"]`:
  /// `/`-separated paths relative to the package root. `velt check --ts-compat` and the editor
  /// lint them.
  tsCompat?: string[];
  /// How loud the lint rules are in the package's own modules: `{ perf: "warn" }`.
  lint?: Lint;
  /// How the package's program is built. Only the root package's applies.
  build?: Build;
};

/// A conditional import's files: one file (`"./src/config.vlt"`), or one per build condition, in
/// the order they are tried: `{ js: "./src/io/js.vlt", default: "./src/io/native.vlt" }`. Paths
/// are `./`-relative to the package root and below `./src/`, with their extension. The
/// conditions: `native` (any native target), `darwin`, `linux`, `win32`, `wasm` (any WebAssembly
/// target), `wasi` (`wasm32-wasip1`), `js` (`wasm32-unknown-unknown`, run by JavaScript) and
/// `default` (every build), and a host package's own condition (`Host.condition`), which only a
/// `velt build --host` build for that package has.
export type Import = string | Record<string, string>;

/// A host package's platform (`velt build --host <package>`): the compiler knows no platform, so
/// everything a platform needs is here.
export type Host = {
  /// The target triple the host's builds are for: `"wasm32-unknown-unknown"`.
  target: string;
  /// The condition the host's builds have on top of the target's, which `imports` variants of any
  /// package can name: lowercase letters, digits and `-`, not a built-in condition.
  condition: string;
  /// The platform's entry: a JavaScript module below `./src/` that every build copies beside its
  /// files under its file name. It imports `./program.wasm`, `./velt_serve.mjs` (the glue's core)
  /// and `./velt_modules.mjs` (the host modules the program imports).
  entry: string;
  /// Configuration files a build writes when absent, so edits stay: the path in the build's
  /// directory → the package's file below `./src/`. `{{name}}` in one becomes the program's name.
  scaffold?: Record<string, string>;
};

/// The standard library's conditional imports (`std/imports.vlt`): the `imports` of a package,
/// its files `./`-relative to the std root.
export type Imports = Record<string, Import>;

/// A package whose native code the program allows: its name (from the registry, or a local path),
/// or its name and the source it is allowed from.
export type AllowNative = string | AllowNativeSource;

/// An `allowNative` entry bound to a source: exactly one of `git` and `url`.
export type AllowNativeSource = {
  /// The package's name.
  name: string;
  /// The git repository it is allowed from, at any commit (compared without a trailing `/` or
  /// `.git`, the host in any case).
  git?: string;
  /// An https URL prefix its archives are allowed from, with a path under the host:
  /// `https://github.com/o/duck/releases/download/`. It matches whole path segments.
  url?: string;
};

/// A dependency: a semver requirement such as `"^1.2"`, or where to get it.
export type Dependency = string | DependencySource;

/// Where a dependency comes from: a registry version, a local directory, a git repository, or a
/// version and one of the others.
export type DependencySource = {
  /// A semver requirement.
  version?: string;
  /// A local package directory, relative to this manifest; with `git`, the package's directory in
  /// the repository.
  path?: string;
  /// A git repository URL (`https://…`, `ssh://…`, `git@host:path`): the package comes from it,
  /// at the commit `velt.lock.json` records.
  git?: string;
  /// With `git`: the branch to follow (default: the repository's default branch); `velt update`
  /// moves to its newest commit.
  branch?: string;
  /// With `git`: a tag.
  tag?: string;
  /// With `git`: a full commit hash.
  rev?: string;
};

/// JSX settings of a package.
export type Jsx = {
  /// The module whose `jsx-runtime` compiles JSX: a dependency, `"velt/jsx"` (the default), a
  /// `paths` alias, or `./dir` relative to the package root. A `// @jsxImportSource` comment in
  /// a file wins.
  importSource?: string;
};

/// How a package's program is built (https://veltlang.com/docs/tooling/platforms/ "CPU").
/// How loud the lint rules are in the package's own modules
/// (https://veltlang.com/docs/tooling/cli/).
export type Lint = {
  /// The level of every `perf/…` rule: `"hint"` (the default: `velt check --perf` and the editor
  /// show them), `"warn"`, `"deny"` (`velt check` fails) or `"off"`.
  perf?: LintLevel;
  /// Levels of single rules by code, which win over `perf`: `{ "perf/number-double": "off" }`.
  rules?: Record<string, LintLevel>;
};

/// How loud a lint rule is.
export type LintLevel = "off" | "hint" | "warn" | "deny";

export type Build = {
  /// The CPU the program is built for, as `velt build --cpu`: `"baseline"`, `"x86-64-v2"` (the
  /// default on x86-64), `"x86-64-v3"`, `"x86-64-v4"`, `"native"` or a CPU name such as
  /// `"znver4"`. `--cpu` and `VELT_CPU` take precedence; a CPU of another architecture does not
  /// apply to a build for this one.
  cpu?: string;
};

/// A package's native library (https://veltlang.com/docs/book/native-packages/).
export type Native = {
  /// The crate's directory, one directory name in the package root (default `"native"`).
  path?: string;
  /// The targets `velt publish` publishes a prebuilt library for, such as
  /// `"x86_64-unknown-linux-gnu"` or `"aarch64-apple-darwin"`.
  targets?: string[];
  /// WebAssembly libraries are not supported yet: must be `false` (the default).
  wasm?: boolean;
  /// The C libraries the package's `declare c("<library>")` functions name, by that name: where
  /// each comes from on each target. `"c"`, the platform's C library, needs no entry (one lists
  /// only its `headers`), but a package declaring C functions has this object (`c: {}` for the
  /// C library's only), so programs see it has native code.
  c?: Record<string, CLibrary>;
};

/// A C library of a package (`native.c.<library>`).
export type CLibrary = {
  /// The platform's library, by build condition (`darwin`, `linux`, `win32`, `native`,
  /// `default`): `{ linux: "sqlite3" }` links `-lsqlite3`, and `"framework:Accelerate"` a macOS
  /// framework. The first condition the build has applies; a target none applies to can't call
  /// the library's functions.
  system?: Record<string, string>;
  /// The C headers the library's declarations are checked against when the package builds,
  /// once per target: a path in the package (`"native/sqlite3.h"`), or `"<string.h>"` for a C
  /// library header.
  headers?: string[];
  /// The library has no headers (a binary-only SDK): its declarations go unchecked, which
  /// `velt check` and `allowNative`'s error say.
  unchecked?: boolean;
};
