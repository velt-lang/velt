// velt/dev (internal): the graceful stop of a server under `velt dev`. Before the supervisor
// starts the next version of the program, it asks this one to stop: a server that joined then
// stops accepting (the supervisor keeps the listening socket, so new connections wait for the
// next version), answers its in-flight requests, and says it `drained`; the runtime exits once
// every server that joined did (or after a bounded wait). Outside `velt dev` nothing joins.

import {
  velt_rt_dev_server_drained,
  velt_rt_dev_server_stop,
  velt_rt_signal_free,
  velt_rt_signal_reason,
  velt_rt_signal_wait,
} from "velt/dev/rt";
import { AbortSignal } from "velt/task";
import { signalAbort, signalFree, signalNew, signalRetain } from "#task-signal";

/**
 * Joins the graceful stop of `velt dev`: a signal aborted once the program is asked to stop
 * for its next version, after which the caller stops taking work, finishes what it has and
 * calls `drained()`; the program exits once everything that joined did. Null outside
 * `velt dev`, where nothing waits.
 */
export function joinStop(): AbortSignal | null {
  const stop = velt_rt_dev_server_stop();
  if (stop == 0) {
    return null;
  }
  const handle = signalNew();
  const task = spawn(abortOnStop(new Held(stop, signalRetain(handle))));
  return AbortSignal.adopt(handle);
}

// The runtime's stop signal and the stop's own reference to the server's signal, both given back
// when the stop came or its task is dropped.
class Held {
  stop: u64;
  signal: u64;

  constructor(stop: u64, signal: u64) {
    this.stop = stop;
    this.signal = signal;
  }

  [Symbol.dispose]() {
    velt_rt_signal_free(this.stop);
    signalFree(this.signal);
  }
}

// Waits for the stop request (the runtime aborts its signal), then aborts the server's signal
// with the runtime's reason.
async function abortOnStop(held: Held): Promise<void> {
  using h = held;
  await velt_rt_signal_wait(h.stop, false);
  signalAbort(h.signal, velt_rt_signal_reason(h.stop));
}

/** What joined the graceful stop (`joinStop`) finished. */
export function drained() {
  velt_rt_dev_server_drained();
}
