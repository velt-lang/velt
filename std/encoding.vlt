// std/encoding: byte <-> text encodings — Base64 (RFC 4648 §4 and the URL-safe §5 alphabet),
// lowercase hex, and UTF-8 (strict and lossy decoding, validation).
//
// Strings are stored as UTF-8, so `utf8Encode` is a copy of a string's bytes (a lone surrogate
// written as U+FFFD) and decoding validates them. Encoders build the output as ASCII bytes and turn them into a string with one
// runtime copy. Decoders throw `EncodingError` on malformed input.

import { IoResult } from "velt:io";
import {
  HEX_DIGITS,
  HEX_VALUES,
  STD_DIGITS,
  STD_VALUES,
  URL_DIGITS,
  URL_VALUES,
} from "velt:encoding/tables";

// `(const VeltStr* s, VeltBytes* out)`: copies a string's bytes.
declare function velt_rt_bytes_from_str(s: string): u8[];
// `(const VeltBytes* b, IoResult<VeltStr>* out)`: copies bytes into a string, `EILSEQ` if invalid.
declare function velt_rt_bytes_to_str(b: u8[]): IoResult<string>;
declare function velt_rt_bytes_utf8_valid(b: u8[]): bool;

// Marks a byte that is not a digit in the decode tables.
const INVALID: u8 = 0xff;

// `=`
const PAD: u8 = 61;

/** Thrown for malformed Base64, hex or UTF-8 input. */
export class EncodingError extends Error {
  constructor(message: string) {
    super(message);
  }
}

// ───────────────────────────── Base64 ─────────────────────────────

/** Standard Base64 (`+/` alphabet) with `=` padding. */
export function base64Encode(data: u8[]): string {
  return encode64(data, false, true);
}

/**
 * Decodes standard Base64; padding is optional. Throws `EncodingError` on a character outside the
 * alphabet or a length or padding that cannot come from whole bytes.
 */
export function base64Decode(s: string): u8[] {
  return decode64(s, false);
}

/** URL-safe Base64 (`-_` alphabet, RFC 4648 §5) without padding. */
export function base64UrlEncode(data: u8[]): string {
  return encode64(data, true, false);
}

/** Decodes URL-safe Base64; padding is optional. Throws `EncodingError`. */
export function base64UrlDecode(s: string): u8[] {
  return decode64(s, true);
}

/** Base64 of the UTF-8 bytes of `s`. */
export function base64EncodeString(s: string): string {
  return encode64(velt_rt_bytes_from_str(s), false, true);
}

/** Decodes Base64 to bytes and those as UTF-8. Throws `EncodingError` on bad Base64 or UTF-8. */
export function base64DecodeString(s: string): string {
  return utf8Decode(decode64(s, false));
}

function encode64(data: u8[], url: bool, pad: bool): string {
  const n = data.length;
  const rest = n % 3;
  const full = n - rest;
  let size = full / 3 * 4;
  if (rest > 0) {
    size += pad ? 4 : rest + 1;
  }
  // Sized once and written by index: no growth check per character.
  const out = unfilled(size);
  let o: usize = 0;
  for (let i: usize = 0; i < full; i += 3) {
    const t = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8) | (data[i + 2] as u32);
    out[o] = digit(t >> 18, url);
    out[o + 1] = digit((t >> 12) & 63, url);
    out[o + 2] = digit((t >> 6) & 63, url);
    out[o + 3] = digit(t & 63, url);
    o += 4;
  }
  if (rest > 0) {
    let t = (data[full] as u32) << 16;
    if (rest == 2) {
      t = t | ((data[full + 1] as u32) << 8);
    }
    out[o] = digit(t >> 18, url);
    out[o + 1] = digit((t >> 12) & 63, url);
    if (rest == 2) {
      out[o + 2] = digit((t >> 6) & 63, url);
      if (pad) {
        out[o + 3] = PAD;
      }
    } else if (pad) {
      out[o + 2] = PAD;
      out[o + 3] = PAD;
    }
  }
  return validToString(out);
}

// Texts of at least this many digits (without their padding) are read from a copy of their
// bytes, which makes a digit two loads; shorter ones are read where they stand, one `charCodeAt`
// per digit, which saves the copy (in instructions, the two meet at about 20 digits).
const COPY_FROM: i64 = 24;

// Throws on characters outside the alphabet (`url`: the URL-safe one), on `=` anywhere but the
// (at most two) final positions, and on a length that cannot come from whole bytes. Leftover
// bits are ignored. A short text is read where it stands, a long one from a copy of its bytes;
// they agree up to the first character that is not ASCII, which is not a digit either way.
function decode64(s: string, url: bool): u8[] {
  let n = s.length as i64;
  if (n == 0) {
    return [];
  }
  let pads: i64 = 0;
  while (n > 0 && pads < 2 && s.charCodeAt(n - 1) == (PAD as i64)) {
    n--;
    pads++;
  }
  const tail = n % 4;
  const out = unfilled((n / 4 * 3 + (tail == 3 ? 2 : tail == 2 ? 1 : 0)) as usize);
  let o: usize = 0;
  let i: i64 = 0;
  if (n >= COPY_FROM) {
    const text = velt_rt_bytes_from_str(s);
    while (i + 4 <= n) {
      const at = i as usize;
      const a = value(text[at] as usize, url);
      const b = value(text[at + 1] as usize, url);
      const c = value(text[at + 2] as usize, url);
      const d = value(text[at + 3] as usize, url);
      if ((a | b | c | d) < 0) {
        break;
      }
      put3(out, o, (a << 18) | (b << 12) | (c << 6) | d);
      o += 3;
      i += 4;
    }
  } else {
    while (i + 4 <= n) {
      const a = unitValue(s.charCodeAt(i), url);
      const b = unitValue(s.charCodeAt(i + 1), url);
      const c = unitValue(s.charCodeAt(i + 2), url);
      const d = unitValue(s.charCodeAt(i + 3), url);
      if ((a | b | c | d) < 0) {
        break;
      }
      put3(out, o, (a << 18) | (b << 12) | (c << 6) | d);
      o += 3;
      i += 4;
    }
  }
  // The last one to three digits, or the group with a character that is not a digit.
  let acc: i64 = 0;
  let bits: i64 = 0;
  while (i < n) {
    const v = unitValue(s.charCodeAt(i), url);
    if (v < 0) {
      throw new EncodingError(`Invalid base64 character at offset ${i}`);
    }
    acc = (acc << 6) | v;
    bits += 6;
    if (bits >= 8) {
      bits -= 8;
      out[o] = ((acc >> bits) & 0xff) as u8;
      o++;
    }
    i++;
  }
  if (tail == 1 || (pads > 0 && (n + pads) % 4 != 0)) {
    throw new EncodingError("Invalid base64: bad length or padding");
  }
  return out;
}

// `n` bytes that are not set to anything: each caller writes every one of them before it returns
// the array, and throws it away otherwise. Cheaper than `Buffer.alloc`, which zeroes them first.
function unfilled(n: usize): u8[] {
  const out: u8[] = __intrinsic_array_with_capacity(n);
  __intrinsic_array_set_len(out, n);
  return out;
}

// Writes the 24 bits of `t` as three bytes at `out[o]`.
function put3(out: u8[], o: usize, t: i64) {
  out[o] = (t >> 16) as u8;
  out[o + 1] = ((t >> 8) & 0xff) as u8;
  out[o + 2] = (t & 0xff) as u8;
}

// The digit for 6-bit value `v`.
function digit(v: u32, url: bool): u8 {
  return url ? URL_DIGITS[v as usize] : STD_DIGITS[v as usize];
}

// The value of UTF-16 code unit `c` as a digit, -1 if it is not one.
function unitValue(c: i64, url: bool): i64 {
  return c >= 0 && c < 256 ? value(c as usize, url) : -1;
}

// The value of byte `c` as a digit, -1 if it is not one.
function value(c: usize, url: bool): i64 {
  return (url ? URL_VALUES[c] : STD_VALUES[c]) as i64;
}

// ───────────────────────────── hex ─────────────────────────────

/** Lowercase hex, two digits per byte. */
export function hexEncode(data: u8[]): string {
  // Sized once and written by index, like Base64.
  const out = unfilled(data.length * 2);
  for (let i: usize = 0; i < data.length; i++) {
    const b = data[i];
    out[2 * i] = HEX_DIGITS[(b >> 4) as usize];
    out[2 * i + 1] = HEX_DIGITS[(b & 15) as usize];
  }
  return validToString(out);
}

/**
 * Decodes hex digits (either case). Throws `EncodingError` on odd length or a non-hex character.
 */
export function hexDecode(s: string): u8[] {
  if (s.length == 0) {
    return [];
  }
  const text = velt_rt_bytes_from_str(s);
  if (text.length % 2 != 0) {
    throw new EncodingError("Invalid hex: odd length");
  }
  const out = unfilled(text.length / 2);
  for (let i: usize = 0; i < text.length; i += 2) {
    const hi = HEX_VALUES[text[i] as usize];
    const lo = HEX_VALUES[text[i + 1] as usize];
    if (hi == INVALID || lo == INVALID) {
      throw new EncodingError(`Invalid hex character at offset ${hi == INVALID ? i : i + 1}`);
    }
    out[i / 2] = (hi << 4) | lo;
  }
  return out;
}

// ───────────────────────────── UTF-8 ─────────────────────────────

/** The UTF-8 bytes of `s` (a copy). */
export function utf8Encode(s: string): u8[] {
  return velt_rt_bytes_from_str(s);
}

/**
 * Decodes UTF-8. Throws `EncodingError` if `data` is not valid UTF-8 (overlong forms,
 * surrogates and code points above U+10FFFF are invalid).
 */
export function utf8Decode(data: u8[]): string {
  const r = velt_rt_bytes_to_str(data);
  if (r.code != 0) {
    throw new EncodingError(`Invalid UTF-8 at offset ${firstInvalid(data)}`);
  }
  return r.value;
}

/**
 * Decodes UTF-8, replacing each maximal invalid subsequence with U+FFFD (WHATWG / Unicode
 * "substitution of maximal subparts", as `TextDecoder` and Rust's `from_utf8_lossy` do).
 */
export function utf8DecodeLossy(data: u8[]): string {
  const bad = firstInvalid(data);
  if (bad < 0) {
    return validToString(data);
  }
  const out: u8[] = __intrinsic_array_with_capacity(data.length + 8);
  let i: usize = 0;
  while (i < data.length) {
    const len = sequenceAt(data, i);
    if (len > 0) {
      for (let k: usize = 0; k < (len as usize); k++) {
        out.push(data[i + k]);
      }
      i += len as usize;
    } else {
      out.push(0xef);
      out.push(0xbf);
      out.push(0xbd);
      i += (-len) as usize;
    }
  }
  return validToString(out);
}

/** Whether `data` is valid UTF-8. */
export function utf8Valid(data: u8[]): bool {
  return velt_rt_bytes_utf8_valid(data);
}

// Offset of the first byte that starts an invalid sequence, or -1.
function firstInvalid(data: u8[]): i64 {
  let i: usize = 0;
  const n = data.length;
  while (i < n) {
    if (data[i] < 0x80) {
      i++;
      continue;
    }
    const len = sequenceAt(data, i);
    if (len < 0) {
      return i as i64;
    }
    i += len as usize;
  }
  return -1;
}

// Length of the valid sequence starting at `i`, or minus the length of its maximal invalid
// subpart (the bytes one U+FFFD replaces). Follows Unicode Table 3-7 (well-formed sequences).
function sequenceAt(data: u8[], i: usize): i64 {
  const b0 = data[i];
  if (b0 < 0x80) {
    return 1;
  }
  let need: usize = 0;
  let lo: u8 = 0x80;
  let hi: u8 = 0xbf;
  if (b0 >= 0xc2 && b0 <= 0xdf) {
    need = 1;
  } else if (b0 >= 0xe0 && b0 <= 0xef) {
    need = 2;
    lo = b0 == 0xe0 ? 0xa0 : 0x80;
    hi = b0 == 0xed ? 0x9f : 0xbf;
  } else if (b0 >= 0xf0 && b0 <= 0xf4) {
    need = 3;
    lo = b0 == 0xf0 ? 0x90 : 0x80;
    hi = b0 == 0xf4 ? 0x8f : 0xbf;
  } else {
    return -1;
  }
  for (let k: usize = 1; k <= need; k++) {
    if (i + k >= data.length) {
      return -(k as i64);
    }
    const b = data[i + k];
    if (b < lo || b > hi) {
      return -(k as i64);
    }
    lo = 0x80;
    hi = 0xbf;
  }
  return (need + 1) as i64;
}

// Bytes known to be valid UTF-8 (encoder output, repaired lossy input) as a string.
function validToString(bytes: u8[]): string {
  const r = velt_rt_bytes_to_str(bytes);
  if (r.code != 0) {
    panic("ICE: std/encoding produced invalid UTF-8");
  }
  return r.value;
}

// ──────────────────────── TextEncoder, TextDecoder ────────────────────────

// Whether `label` names UTF-8 in the WHATWG Encoding standard (ASCII case-insensitive, with
// surrounding whitespace ignored).
function isUtf8Label(label: string): bool {
  const l = label.trim().toLowerCase();
  return (
    l == "utf-8" ||
    l == "utf8" ||
    l == "unicode-1-1-utf-8" ||
    l == "unicode11utf8" ||
    l == "unicode20utf8" ||
    l == "x-unicode20utf8"
  );
}

/** `TextDecoder`'s options. */
export struct TextDecoderOptions {
  /** Throw `EncodingError` on invalid UTF-8 instead of writing U+FFFD (default false). */
  fatal?: bool;
  /** Keep a leading byte order mark instead of dropping it (default false). */
  ignoreBOM?: bool;
}

/**
 * The WHATWG `TextEncoder` (a global, as in Node): strings to UTF-8 bytes. The bytes are a
 * `u8[]`, where JS has a `Uint8Array`.
 */
export class TextEncoder {
  /** Always `"utf-8"`. */
  readonly encoding: string = "utf-8";

  /** The UTF-8 bytes of `input` (a lone surrogate is written as U+FFFD, as in JS). */
  encode(input: string = ""): u8[] {
    return velt_rt_bytes_from_str(input);
  }
}

/**
 * The WHATWG `TextDecoder` (a global, as in Node) for UTF-8, the only encoding it takes: a
 * leading byte order mark is dropped (unless `ignoreBOM`), and invalid input becomes U+FFFD
 * (or throws `EncodingError` with `fatal`). One `decode` call decodes one whole input.
 */
export class TextDecoder {
  /** Always `"utf-8"`. */
  readonly encoding: string = "utf-8";
  /** Whether invalid input throws. */
  readonly fatal: bool;
  /** Whether a leading byte order mark is kept. */
  readonly ignoreBOM: bool;

  /** Throws `EncodingError` for a `label` that does not name UTF-8, as Node's RangeError. */
  constructor(label: string = "utf-8", options: TextDecoderOptions = {}) {
    if (!isUtf8Label(label)) {
      throw new EncodingError(`The "${label}" encoding is not supported`);
    }
    this.fatal = options.fatal ?? false;
    this.ignoreBOM = options.ignoreBOM ?? false;
  }

  /** The text `input` encodes. */
  decode(input: u8[] = []): string {
    let data = input;
    if (
      !this.ignoreBOM &&
      input.length >= 3 &&
      input[0] == 0xef &&
      input[1] == 0xbb &&
      input[2] == 0xbf
    ) {
      data = input.slice(3);
    }
    if (!this.fatal) {
      return utf8DecodeLossy(data);
    }
    if (firstInvalid(data) >= 0) {
      throw new EncodingError("The encoded data was not valid for encoding utf-8");
    }
    return validToString(data);
  }
}
