// std/encoding: byte <-> text encodings — Base64 (RFC 4648 §4 and the URL-safe §5 alphabet),
// lowercase hex, and UTF-8 (strict and lossy decoding, validation).
//
// Strings are stored as UTF-8, so `utf8Encode` is a copy of a string's bytes (a lone surrogate
// written as U+FFFD) and decoding validates them. Encoders build the output as ASCII bytes and turn them into a string with one
// runtime copy. Decoders throw `EncodingError` on malformed input.

import { IoResult } from "velt:io";

// `(const VeltStr* s, VeltBytes* out)`: copies a string's bytes.
declare function velt_rt_bytes_from_str(s: string): u8[];
// `(const VeltBytes* b, IoResult<VeltStr>* out)`: copies bytes into a string, `EILSEQ` if invalid.
declare function velt_rt_bytes_to_str(b: u8[]): IoResult<string>;
declare function velt_rt_bytes_utf8_valid(b: u8[]): bool;
// The SIMD operations hex and `firstInvalid` use (`velt:simd`, std/simd/*.vlt, is the API;
// declared again here so that this module does not load it). `load` and `store` do not check
// their range.
declare function velt_simd_u8x16_ge(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_mask8x16_any(m: mask8x16): bool;
declare function velt_simd_mask8x16_first(m: mask8x16): u64;
declare function velt_simd_u8x16_splat(x: u8): u8x16;
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_store(v: u8x16, to: u8[], at: u64);
declare function velt_simd_u8x16_add(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_sub(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_and(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_or(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_shr(v: u8x16, count: u32): u8x16;
declare function velt_simd_u8x16_gt(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_le(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_select(m: mask8x16, a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_zip_low(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_zip_high(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_as_u16x8(v: u8x16): u16x8;
declare function velt_simd_u16x8_splat(x: u16): u16x8;
declare function velt_simd_u16x8_and(a: u16x8, b: u16x8): u16x8;
declare function velt_simd_u16x8_or(a: u16x8, b: u16x8): u16x8;
declare function velt_simd_u16x8_shl(v: u16x8, count: u32): u16x8;
declare function velt_simd_u16x8_shr(v: u16x8, count: u32): u16x8;
declare function velt_simd_u16x8_narrow(a: u16x8, b: u16x8): u8x16;
declare function velt_simd_mask8x16_or(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_all(m: mask8x16): bool;

const BASE64_STD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const BASE64_URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

// Marks a byte that is not a digit in the decode tables.
const INVALID: u8 = 0xff;

// `=`
const PAD: u8 = 61;

/** Thrown for malformed Base64, hex or UTF-8 input. */
export class EncodingError extends Error {
  constructor(message: string) {
    super(message);
  }
}

// ───────────────────────────── Base64 ─────────────────────────────

/** Standard Base64 (`+/` alphabet) with `=` padding. */
export function base64Encode(data: u8[]): string {
  return encode64(data, BASE64_STD, true);
}

/**
 * Decodes standard Base64; padding is optional. Throws `EncodingError` on a character outside the
 * alphabet or a length or padding that cannot come from whole bytes.
 */
export function base64Decode(s: string): u8[] {
  return decode64(s, false);
}

/** URL-safe Base64 (`-_` alphabet, RFC 4648 §5) without padding. */
export function base64UrlEncode(data: u8[]): string {
  return encode64(data, BASE64_URL, false);
}

/** Decodes URL-safe Base64; padding is optional. Throws `EncodingError`. */
export function base64UrlDecode(s: string): u8[] {
  return decode64(s, true);
}

/** Base64 of the UTF-8 bytes of `s`. */
export function base64EncodeString(s: string): string {
  return encode64(velt_rt_bytes_from_str(s), BASE64_STD, true);
}

/** Decodes Base64 to bytes and those as UTF-8. Throws `EncodingError` on bad Base64 or UTF-8. */
export function base64DecodeString(s: string): string {
  return utf8Decode(decode64(s, false));
}

function encode64(data: u8[], alphabet: string, pad: bool): string {
  const n = data.length;
  const rest = n % 3;
  const full = n - rest;
  let size = full / 3 * 4;
  if (rest > 0) {
    size += pad ? 4 : rest + 1;
  }
  const digits = velt_rt_bytes_from_str(alphabet);
  // Sized once and written by index: no growth check per character.
  const out = Buffer.alloc(size);
  let o: usize = 0;
  for (let i: usize = 0; i < full; i += 3) {
    const t = ((data[i] as u32) << 16) | ((data[i + 1] as u32) << 8) | (data[i + 2] as u32);
    out[o] = digits[(t >> 18) as usize];
    out[o + 1] = digits[((t >> 12) & 63) as usize];
    out[o + 2] = digits[((t >> 6) & 63) as usize];
    out[o + 3] = digits[(t & 63) as usize];
    o += 4;
  }
  if (rest > 0) {
    let t = (data[full] as u32) << 16;
    if (rest == 2) {
      t = t | ((data[full + 1] as u32) << 8);
    }
    out[o] = digits[(t >> 18) as usize];
    out[o + 1] = digits[((t >> 12) & 63) as usize];
    if (rest == 2) {
      out[o + 2] = digits[((t >> 6) & 63) as usize];
      if (pad) {
        out[o + 3] = PAD;
      }
    } else if (pad) {
      out[o + 2] = PAD;
      out[o + 3] = PAD;
    }
  }
  return validToString(out);
}

// Texts of at least this many digits (without their padding) are decoded through a table
// (`valueTable`): a digit costs about half through it of what computing it costs, and from here
// on that pays for building the table (in instructions, the two paths meet at 24 digits).
const TABLE_FROM: i64 = 24;

// Throws on characters outside the alphabet (`url`: the URL-safe one), on `=` anywhere but the
// (at most two) final positions, and on a length that cannot come from whole bytes. Leftover
// bits are ignored. A short text is read where it stands, a long one from a copy of its bytes;
// they agree up to the first character that is not ASCII, which is not a digit either way.
function decode64(s: string, url: bool): u8[] {
  let n = s.length as i64;
  let pads: i64 = 0;
  while (n > 0 && pads < 2 && s.charCodeAt(n - 1) == (PAD as i64)) {
    n--;
    pads++;
  }
  const tail = n % 4;
  const out = Buffer.alloc((n / 4 * 3 + (tail == 3 ? 2 : tail == 2 ? 1 : 0)) as usize);
  let o: usize = 0;
  let i: i64 = 0;
  if (n >= TABLE_FROM) {
    // A long text pays for a table of the 256 byte values and a copy of its bytes, which make
    // each digit two loads.
    const table = valueTable(url);
    const text = velt_rt_bytes_from_str(s);
    while (i + 4 <= n) {
      const at = i as usize;
      const a = table[text[at] as usize] as i64;
      const b = table[text[at + 1] as usize] as i64;
      const c = table[text[at + 2] as usize] as i64;
      const d = table[text[at + 3] as usize] as i64;
      if ((a | b | c | d) < 0) {
        break;
      }
      put3(out, o, (a << 18) | (b << 12) | (c << 6) | d);
      o += 3;
      i += 4;
    }
  } else {
    while (i + 4 <= n) {
      const a = value64(s.charCodeAt(i), url);
      const b = value64(s.charCodeAt(i + 1), url);
      const c = value64(s.charCodeAt(i + 2), url);
      const d = value64(s.charCodeAt(i + 3), url);
      if ((a | b | c | d) < 0) {
        break;
      }
      put3(out, o, (a << 18) | (b << 12) | (c << 6) | d);
      o += 3;
      i += 4;
    }
  }
  // The last one to three digits, or the group with a character that is not a digit.
  let acc: i64 = 0;
  let bits: i64 = 0;
  while (i < n) {
    const v = value64(s.charCodeAt(i), url);
    if (v < 0) {
      throw new EncodingError(`Invalid base64 character at offset ${i}`);
    }
    acc = (acc << 6) | v;
    bits += 6;
    if (bits >= 8) {
      bits -= 8;
      out[o] = ((acc >> bits) & 0xff) as u8;
      o++;
    }
    i++;
  }
  if (tail == 1 || (pads > 0 && (n + pads) % 4 != 0)) {
    throw new EncodingError("Invalid base64: bad length or padding");
  }
  return out;
}

// Writes the 24 bits of `t` as three bytes at `out[o]`.
function put3(out: u8[], o: usize, t: i64) {
  out[o] = (t >> 16) as u8;
  out[o + 1] = ((t >> 8) & 0xff) as u8;
  out[o + 2] = (t & 0xff) as u8;
}

// The value of every byte as a digit, -1 for the others: what `value64` computes, laid out
// with one pass of -1 and a store per digit. Signed, so that one sign test finds a byte that is
// not a digit among four.
function valueTable(url: bool): i8[] {
  const table: i8[] = __intrinsic_array_with_capacity(256);
  __intrinsic_array_set_len(table, 256);
  for (let c: usize = 0; c < 256; c++) {
    table[c] = -1;
  }
  for (let k: usize = 0; k < 26; k++) {
    table[65 + k] = k as i8;
    table[97 + k] = (26 + k) as i8;
  }
  for (let k: usize = 0; k < 10; k++) {
    table[48 + k] = (52 + k) as i8;
  }
  table[url ? 45 : 43] = 62;
  table[url ? 95 : 47] = 63;
  return table;
}

// The value of Base64 digit `c` (a character code), or -1 if it is not one. Computed, so a
// decode of a few digits builds no table: letters and digits are ranges, and the two alphabets differ
// only in the characters for 62 and 63.
function value64(c: i64, url: bool): i64 {
  if (c >= 97) {
    return c <= 122 ? c - 71 : -1;
  }
  if (c >= 65) {
    if (c <= 90) {
      return c - 65;
    }
    return url && c == 95 ? 63 : -1;
  }
  if (c >= 48) {
    return c <= 57 ? c + 4 : -1;
  }
  if (url) {
    return c == 45 ? 62 : -1;
  }
  if (c == 43) {
    return 62;
  }
  return c == 47 ? 63 : -1;
}

// ───────────────────────────── hex ─────────────────────────────

/** Lowercase hex, two digits per byte. */
export function hexEncode(data: u8[]): string {
  const n = data.length;
  const out = Buffer.alloc(n * 2);
  let i: usize = 0;
  // Sixteen bytes per step: each half byte becomes its digit (`0` + n, or `a` - 10 + n past 9),
  // and the digits of the high and low halves are written in turn.
  const nine = velt_simd_u8x16_splat(9);
  const digit = velt_simd_u8x16_splat(48);
  const letter = velt_simd_u8x16_splat(87);
  while (i + 16 <= n) {
    const v = velt_simd_u8x16_load(data, i as u64);
    const high = hexDigits(velt_simd_u8x16_shr(v, 4), nine, digit, letter);
    const low = hexDigits(velt_simd_u8x16_and(v, velt_simd_u8x16_splat(15)), nine, digit, letter);
    velt_simd_u8x16_store(velt_simd_u8x16_zip_low(high, low), out, (i * 2) as u64);
    velt_simd_u8x16_store(velt_simd_u8x16_zip_high(high, low), out, (i * 2 + 16) as u64);
    i += 16;
  }
  while (i < n) {
    const high = data[i] >> 4;
    const low = data[i] & 15;
    out[i * 2] = high + (high > 9 ? 87 : 48);
    out[i * 2 + 1] = low + (low > 9 ? 87 : 48);
    i++;
  }
  return validToString(out);
}

// The hex digits of sixteen values below 16.
function hexDigits(v: u8x16, nine: u8x16, digit: u8x16, letter: u8x16): u8x16 {
  return velt_simd_u8x16_add(v, velt_simd_u8x16_select(velt_simd_u8x16_gt(v, nine), letter, digit));
}

/**
 * Decodes hex digits (either case). Throws `EncodingError` on odd length or a non-hex character.
 */
export function hexDecode(s: string): u8[] {
  const text = velt_rt_bytes_from_str(s);
  if (text.length % 2 != 0) {
    throw new EncodingError("Invalid hex: odd length");
  }
  const out = Buffer.alloc(text.length / 2);
  let i: usize = 0;
  // 32 digits per step. A vector with a character that is not a digit ends the steps: the
  // loop below finds which one it is.
  while (i + 32 <= text.length) {
    const first = hexPairs(velt_simd_u8x16_load(text, i as u64));
    const second = hexPairs(velt_simd_u8x16_load(text, (i + 16) as u64));
    if (!(first.ok && second.ok)) {
      break;
    }
    velt_simd_u8x16_store(velt_simd_u16x8_narrow(first.bytes, second.bytes), out, (i / 2) as u64);
    i += 32;
  }
  while (i < text.length) {
    const hi = hexValue(text[i]);
    const lo = hexValue(text[i + 1]);
    if (hi == INVALID || lo == INVALID) {
      throw new EncodingError(`Invalid hex character at offset ${hi == INVALID ? i : i + 1}`);
    }
    out[i / 2] = (hi << 4) | lo;
    i += 2;
  }
  return out;
}

// Sixteen hex digits as eight bytes, one per 16-bit lane, and whether all sixteen were digits.
type HexPairs = { bytes: u16x8; ok: bool };

function hexPairs(c: u8x16): HexPairs {
  // `0`..`9` are 0..9 after subtracting `0`; a letter of either case is 0..5 after setting
  // the lower-case bit and subtracting `a`. Anything else is past those ranges (wrapping).
  const digit = velt_simd_u8x16_sub(c, velt_simd_u8x16_splat(48));
  const isDigit = velt_simd_u8x16_le(digit, velt_simd_u8x16_splat(9));
  const letter = velt_simd_u8x16_sub(
    velt_simd_u8x16_or(c, velt_simd_u8x16_splat(0x20)),
    velt_simd_u8x16_splat(97),
  );
  const isLetter = velt_simd_u8x16_le(letter, velt_simd_u8x16_splat(5));
  const value = velt_simd_u8x16_select(
    isDigit,
    digit,
    velt_simd_u8x16_add(letter, velt_simd_u8x16_splat(10)),
  );
  // A pair of values as one 16-bit lane has the first digit's in its low byte.
  const pairs = velt_simd_u8x16_as_u16x8(value);
  const low = velt_simd_u16x8_and(pairs, velt_simd_u16x8_splat(0xff));
  const bytes = velt_simd_u16x8_or(velt_simd_u16x8_shl(low, 4), velt_simd_u16x8_shr(pairs, 8));
  return { bytes, ok: velt_simd_mask8x16_all(velt_simd_mask8x16_or(isDigit, isLetter)) };
}

function hexValue(c: u8): u8 {
  if (c >= 48 && c <= 57) {
    return c - 48;
  }
  if (c >= 97 && c <= 102) {
    return c - 87;
  }
  if (c >= 65 && c <= 70) {
    return c - 55;
  }
  return INVALID;
}

// ───────────────────────────── UTF-8 ─────────────────────────────

/** The UTF-8 bytes of `s` (a copy). */
export function utf8Encode(s: string): u8[] {
  return velt_rt_bytes_from_str(s);
}

/**
 * Decodes UTF-8. Throws `EncodingError` if `data` is not valid UTF-8 (overlong forms,
 * surrogates and code points above U+10FFFF are invalid).
 */
export function utf8Decode(data: u8[]): string {
  const r = velt_rt_bytes_to_str(data);
  if (r.code != 0) {
    throw new EncodingError(`Invalid UTF-8 at offset ${firstInvalid(data)}`);
  }
  return r.value;
}

/**
 * Decodes UTF-8, replacing each maximal invalid subsequence with U+FFFD (WHATWG / Unicode
 * "substitution of maximal subparts", as `TextDecoder` and Rust's `from_utf8_lossy` do).
 */
export function utf8DecodeLossy(data: u8[]): string {
  const bad = firstInvalid(data);
  if (bad < 0) {
    return validToString(data);
  }
  const out: u8[] = __intrinsic_array_with_capacity(data.length + 8);
  let i: usize = 0;
  while (i < data.length) {
    const len = sequenceAt(data, i);
    if (len > 0) {
      for (let k: usize = 0; k < (len as usize); k++) {
        out.push(data[i + k]);
      }
      i += len as usize;
    } else {
      out.push(0xef);
      out.push(0xbf);
      out.push(0xbd);
      i += (-len) as usize;
    }
  }
  return validToString(out);
}

/** Whether `data` is valid UTF-8. */
export function utf8Valid(data: u8[]): bool {
  return velt_rt_bytes_utf8_valid(data);
}

/** Offset of the first byte of `data` that starts an invalid UTF-8 sequence, or -1. */
export function firstInvalid(data: u8[]): i64 {
  let i: usize = 0;
  const n = data.length;
  const high = velt_simd_u8x16_splat(0x80);
  while (i < n) {
    if (data[i] < 0x80) {
      i = asciiEnd(data, i + 1, high);
      continue;
    }
    const len = sequenceAt(data, i);
    if (len < 0) {
      return i as i64;
    }
    i += len as usize;
  }
  return -1;
}

// The position of the first byte at or after `from` that is not ASCII (`high`: sixteen 0x80),
// or the length. Most text is ASCII: 64 bytes per step with one test, then 16, then single
// bytes.
function asciiEnd(data: u8[], from: usize, high: u8x16): usize {
  const n = data.length;
  let i = from;
  while (i + 64 <= n) {
    const a = velt_simd_u8x16_or(
      velt_simd_u8x16_load(data, i as u64),
      velt_simd_u8x16_load(data, (i + 16) as u64),
    );
    const b = velt_simd_u8x16_or(
      velt_simd_u8x16_load(data, (i + 32) as u64),
      velt_simd_u8x16_load(data, (i + 48) as u64),
    );
    if (velt_simd_mask8x16_any(velt_simd_u8x16_ge(velt_simd_u8x16_or(a, b), high))) {
      break;
    }
    i += 64;
  }
  while (i + 16 <= n) {
    const m = velt_simd_u8x16_ge(velt_simd_u8x16_load(data, i as u64), high);
    if (velt_simd_mask8x16_any(m)) {
      return i + (velt_simd_mask8x16_first(m) as usize);
    }
    i += 16;
  }
  while (i < n && data[i] < 0x80) {
    i++;
  }
  return i;
}

// Length of the valid sequence starting at `i`, or minus the length of its maximal invalid
// subpart (the bytes one U+FFFD replaces). Follows Unicode Table 3-7 (well-formed sequences).
function sequenceAt(data: u8[], i: usize): i64 {
  const b0 = data[i];
  if (b0 < 0x80) {
    return 1;
  }
  let need: usize = 0;
  let lo: u8 = 0x80;
  let hi: u8 = 0xbf;
  if (b0 >= 0xc2 && b0 <= 0xdf) {
    need = 1;
  } else if (b0 >= 0xe0 && b0 <= 0xef) {
    need = 2;
    lo = b0 == 0xe0 ? 0xa0 : 0x80;
    hi = b0 == 0xed ? 0x9f : 0xbf;
  } else if (b0 >= 0xf0 && b0 <= 0xf4) {
    need = 3;
    lo = b0 == 0xf0 ? 0x90 : 0x80;
    hi = b0 == 0xf4 ? 0x8f : 0xbf;
  } else {
    return -1;
  }
  for (let k: usize = 1; k <= need; k++) {
    if (i + k >= data.length) {
      return -(k as i64);
    }
    const b = data[i + k];
    if (b < lo || b > hi) {
      return -(k as i64);
    }
    lo = 0x80;
    hi = 0xbf;
  }
  return (need + 1) as i64;
}

/** Bytes known to be valid UTF-8 (encoder output, repaired lossy input) as a string. */
export function validToString(bytes: u8[]): string {
  const r = velt_rt_bytes_to_str(bytes);
  if (r.code != 0) {
    panic("ICE: std/encoding produced invalid UTF-8");
  }
  return r.value;
}
