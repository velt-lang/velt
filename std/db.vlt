// std/db: what database drivers share (docs/std/db.md): rows of any source into typed values.
// A driver written in Velt
// (a database's wire protocol parsed in place, a file format) implements `RowSource`, and
// `readRows<T>` fills a `T` per row: each column the field of its name, as `JSON.parse<T>` fills
// fields from keys, with the same conversions and the same messages for a row that does not
// fit. The native drivers of std (velt:sqlite, velt:postgres) read their rows the same way.
//
// For a row type of plain fields (numbers, bools, strings, `T | null` of those, `u8[]`) and a
// source class whose methods do not throw, the compiler reads the rows column by column from
// the source itself (`__intrinsic_read_rows`, null for any other type: nothing read): no text, no
// copy beyond the values kept. Any other row type is read through the JSON text of the rows
// (`rowsJson`), with the same result.

import { JSON } from "velt:prelude/json/json";

/** What a column of the current row holds. */
export enum CellKind {
  Null,
  Bool,
  Int,
  Float,
  /** Text (UTF-8). */
  Text,
  /** Bytes, a `u8[]`. */
  Blob,
  /** A nested value (an array or object) as its JSON text. */
  Json,
}

/**
 * Rows as a driver produces them: their columns, and the current row's values by column. The
 * reader asks each value's kind before taking it with the getter of that kind.
 */
export interface RowSource {
  /** The number of columns. */
  columnCount(): i64;
  /** The name of column `i` (from 0): the field it fills. */
  columnName(i: i64): string;
  /** Moves to the next row (the first on the first call): false when there is none. */
  next(): bool;
  /** What column `i` of the current row holds. */
  kind(i: i64): CellKind;
  bool(i: i64): bool;
  int(i: i64): i64;
  float(i: i64): f64;
  text(i: i64): string;
  blob(i: i64): u8[];
  json(i: i64): string;
}

/** A row that does not fit the requested type (`expected i64 at $[0].id`). */
export class RowError extends Error {
  constructor(message: string) {
    super(message);
  }
}

/** Every remaining row of `src` as a `T`. Throws `RowError` for a row that does not fit. */
export function readRows<T, S extends RowSource>(src: S): T[] {
  try {
    const direct: T[] | null = __intrinsic_read_rows<T, S>(src);
    if (direct != null) {
      return direct;
    }
  } catch (e) {
    throw new RowError(e.message);
  }
  const text = rowsJson<S>(src);
  try {
    return JSON.parse<T[]>(text);
  } catch (e) {
    throw new RowError(e.message);
  }
}

/** The next row of `src` as a `T`, or null when there is none. */
export function readRow<T, S extends RowSource>(src: S): T | null {
  if (!src.next()) {
    return null;
  }
  try {
    const direct: T | null = __intrinsic_read_row<T, S>(src);
    if (direct != null) {
      return direct;
    }
  } catch (e) {
    throw new RowError(e.message);
  }
  const text = rowJson<S>(src);
  try {
    return JSON.parse<T>(text);
  } catch (e) {
    throw new RowError(e.message);
  }
}

// The remaining rows as the JSON text they stand for: `[{"col":value,...},...]`.
function rowsJson<S extends RowSource>(src: S): string {
  const rows: string[] = [];
  while (src.next()) {
    rows.push(rowJson<S>(src));
  }
  return `[${rows.join(",")}]`;
}

// The current row as a JSON object.
function rowJson<S extends RowSource>(src: S): string {
  const parts: string[] = [];
  const n = src.columnCount();
  for (let i: i64 = 0; i < n; i++) {
    parts.push(`${JSON.stringify(src.columnName(i))}:${cellJson<S>(src, i)}`);
  }
  return `{${parts.join(",")}}`;
}

function cellJson<S extends RowSource>(src: S, i: i64): string {
  const kind = src.kind(i);
  if (kind == CellKind.Bool) {
    return src.bool(i) ? "true" : "false";
  }
  if (kind == CellKind.Int) {
    return `${src.int(i)}`;
  }
  if (kind == CellKind.Float) {
    return JSON.stringify(src.float(i));
  }
  if (kind == CellKind.Text) {
    return JSON.stringify(src.text(i));
  }
  if (kind == CellKind.Blob) {
    return JSON.stringify(src.blob(i));
  }
  if (kind == CellKind.Json) {
    return src.json(i);
  }
  return "null";
}
