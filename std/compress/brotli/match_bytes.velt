// velt/compress (internal): unchecked reads of the Brotli encoder's input, and the writes of its
// table, for the match finder.

import { inline } from "velt/lang/intrinsics";
import { u32x4, u64x2, u8x16 } from "velt/simd";

// Unchecked: each caller keeps the 16 bytes inside the array.
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_xor(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_as_u64x2(v: u8x16): u64x2;
declare function velt_simd_u64x2_lane(v: u64x2, index: u64): u64;
// Checked by the runtime: the four bytes it writes must be inside the array.
declare function velt_simd_u8x16_store_partial(v: u8x16, to: u8[], at: u64, count: u64): void;
declare function velt_simd_u32x4_splat(x: u32): u32x4;
declare function velt_simd_u32x4_as_u8x16(v: u32x4): u8x16;

/** The eight bytes at `at`, little-endian; 16 from it must be inside `d`. */
export function word(d: u8[], at: i64): u64 {
  inline();
  return velt_simd_u64x2_lane(velt_simd_u8x16_as_u64x2(velt_simd_u8x16_load(d, at as u64)), 0);
}

/**
 * The bytes `d[a..]` and `d[b..]` (a < b) have in common, at most `max`: 16 at a time while a
 * load of 16 stays inside the array, then one at a time.
 */
export function common(d: u8[], a: i64, b: i64, max: i64): i64 {
  let n: i64 = 0;
  const wide = (d.length as i64) - 16 - b;
  const most = max < wide ? max : wide;
  while (n < most) {
    const x = velt_simd_u8x16_as_u64x2(
      velt_simd_u8x16_xor(
        velt_simd_u8x16_load(d, (a + n) as u64),
        velt_simd_u8x16_load(d, (b + n) as u64),
      ),
    );
    const lo = velt_simd_u64x2_lane(x, 0);
    if (lo != 0) {
      n += (lo.trailingZeros() >> 3) as i64;
      return n < max ? n : max;
    }
    const hi = velt_simd_u64x2_lane(x, 1);
    if (hi != 0) {
      n += 8 + (hi.trailingZeros() >> 3) as i64;
      return n < max ? n : max;
    }
    n += 16;
  }
  while (n < max && d[a + n] == d[b + n]) {
    n++;
  }
  return n < max ? n : max;
}

/** Writes `value` as a little-endian `u32` at `at`, which must be inside `table`. */
export function put32(table: u8[], at: u64, value: u64) {
  inline();
  const v = velt_simd_u32x4_as_u8x16(velt_simd_u32x4_splat(value as u32));
  velt_simd_u8x16_store_partial(v, table, at, 4);
}

/** Writes `value` as `n` little-endian `u32`s from `at`, which must be inside `table`. */
export function fill32(table: u8[], at: u64, value: u64, n: u64) {
  const v = velt_simd_u32x4_as_u8x16(velt_simd_u32x4_splat(value as u32));
  let i: u64 = 0;
  while (i + 4 <= n) {
    velt_simd_u8x16_store_partial(v, table, at + i * 4, 16);
    i += 4;
  }
  while (i < n) {
    velt_simd_u8x16_store_partial(v, table, at + i * 4, 4);
    i++;
  }
}
