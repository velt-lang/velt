/** The prefixes and suffixes of the transforms, back to back (UTF-8: `\u00a0` is two bytes). */
export const AFFIXES =
  "  the s  of  and ,  in  to e \".\">\n] for  a  that .  with ' from  by . The  on  as  is ing \n\t:ed ( at ly =\".com/ of the . This , not er al ='ful ive less est ize \u00a0ous ";

/**
 * The 121 transforms (RFC 7932 appendix B), one number each: the prefix's byte offset in
 * `AFFIXES` (bits 0-7) and length (8-11), the transform (12-16: 0 identity, 1-9 omit that many
 * last bytes, 10 uppercase the first character, 11 all of them, 12-20 omit 1-9 first bytes), and
 * the suffix's offset (17-24) and length (25-28).
