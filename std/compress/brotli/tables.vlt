// velt/compress (internal): the fixed tables of RFC 7932. Module constants that are arrays of
// number literals, so each is read-only data that costs nothing to reach
// (docs/reference/variables.md, "Tables").

/** The order in which the code lengths of the code length alphabet are sent (section 3.5). */
export const CODE_LENGTH_ORDER: u8[] = [
  1,
  2,
  3,
  4,
  0,
  5,
  17,
  6,
  16,
  7,
  8,
  9,
  10,
  11,
  12,
  13,
  14,
  15,
];

/**
 * The fixed prefix code of those code lengths, by the next four bits of input: the length (low
 * four bits) and the code length it stands for (high four bits).
 */
export const CODE_LENGTH_CODE: u8[] = [2, 66, 50, 35, 2, 66, 50, 20, 2, 66, 50, 35, 2, 66, 50, 84];

