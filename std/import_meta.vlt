// std/import_meta (std-internal): the value of `import.meta` (docs/reference/modules.md). The
// parser imports `ImportMeta` (as `__ImportMeta`) into every module that mentions `import.meta`
// and makes the module constant `new __ImportMeta(dirname, filename, main, url)`, whose
// arguments the compiler fills in. Not part of the public API.

import { URL } from "velt:url";

/**
 * `import.meta`: Node's fields in Node's order, printed as Node prints them
 * (`[Object: null prototype] { … }`), and in JSON without `resolve`.
 */
export class ImportMeta {
  readonly dirname: string;
  readonly filename: string;
  readonly main: boolean;
  readonly resolve: (specifier: string) => string throws Error;
  readonly url: string;

  constructor(dirname: string, filename: string, main: boolean, url: string) {
    this.dirname = dirname;
    this.filename = filename;
    this.main = main;
    this.resolve = (specifier: string): string throws Error => resolveSpecifier(
      specifier,
      url,
      filename,
    );
    this.url = url;
  }

  /** How `console.log` shows it, as Node does. */
  __inspect(): string {
    const fields = [
      `dirname: ${quoted(this.dirname)}`,
      `filename: ${quoted(this.filename)}`,
      `main: ${this.main}`,
      "resolve: [Function: resolve]",
      `url: ${quoted(this.url)}`,
    ];
    return `[Object: null prototype] {\n  ${fields.join(",\n  ")}\n}`;
  }

  /** Its JSON, as Node's `JSON.stringify` writes it: the function is left out. */
  toJSON(): { dirname: string; filename: string; main: boolean; url: string } {
    return { dirname: this.dirname, filename: this.filename, main: this.main, url: this.url };
  }
}

/**
 * `specifier` resolved against `base` (the module's `file:` URL), as Node's
 * `import.meta.resolve` resolves it: an absolute URL as the URL parser normalizes it, a relative
 * or absolute path (`./x.ts`, `../y?q#h`, `/z`, `//host/p`) against `base`, and the name of one
 * of Node's built-in modules as `node:<name>`. The file need not exist. A package name throws
 * an `Error` with Node's message (`Cannot find package '…' imported from <file>`): a Velt
 * program's packages are compiled into it, not looked up while it runs.
 */
function resolveSpecifier(specifier: string, base: string, filename: string): string throws Error {
  const path =
    specifier.startsWith("/") ||
    specifier.startsWith("./") ||
    specifier.startsWith("../") ||
    specifier == "." ||
    specifier == "..";
  if (path) {
    const resolved = URL.parse(specifier, base);
    if (resolved != null) {
      return resolved.href;
    }
  } else {
    const absolute = URL.parse(specifier);
    if (absolute != null) {
      return absolute.href;
    }
    if (!specifier.includes(" ") && NODE_BUILTINS.includes(` ${specifier} `)) {
      return `node:${specifier}`;
    }
  }
  throw new Error(`Cannot find package '${specifier}' imported from ${filename}`);
}

/** Node's built-in modules that can be named without `node:` (`module.builtinModules`). */
const NODE_BUILTINS =
  " assert assert/strict async_hooks buffer child_process cluster console constants crypto dgram" +
  " diagnostics_channel dns dns/promises domain events fs fs/promises http http2 https inspector" +
  " inspector/promises module net os path path/posix path/win32 perf_hooks process punycode" +
  " querystring readline readline/promises repl stream stream/consumers stream/promises" +
  " stream/web string_decoder sys timers timers/promises tls trace_events tty url util" +
  " util/types v8 vm wasi worker_threads zlib _http_agent _http_client _http_common" +
  " _http_incoming _http_outgoing _http_server _stream_duplex _stream_passthrough" +
  " _stream_readable _stream_transform _stream_wrap _stream_writable _tls_common _tls_wrap ";

/**
 * `s` as `console.log` quotes a string inside an object: in `'…'`, or in `"…"` or `` `…` `` when
 * it holds `'` and not the other quote, with `\` and control characters escaped.
 */
function quoted(s: string): string {
  let quote = "'";
  if (s.includes("'")) {
    if (!s.includes('"')) {
      quote = '"';
    } else if (!s.includes("`") && !s.includes("${")) {
      quote = "`";
    }
  }
  let out = quote;
  for (let i: i64 = 0; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    const ch = s.charAt(i);
    if (ch == "\\") {
      out += "\\\\";
    } else if (ch == quote) {
      out += `\\${quote}`;
    } else if (c == 10) {
      out += "\\n";
    } else if (c == 9) {
      out += "\\t";
    } else if (c == 13) {
      out += "\\r";
    } else if (c == 8) {
      out += "\\b";
    } else if (c == 12) {
      out += "\\f";
    } else if (c == 11) {
      out += "\\v";
    } else if (c < 32 || c == 127) {
      out += `\\x${c < 16 ? "0" : ""}${c.toString(16).toUpperCase()}`;
    } else {
      out += ch;
    }
  }
  return out + quote;
}
