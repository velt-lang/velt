// std/import_meta (std-internal): `import.meta.resolve(specifier)` (docs/reference/modules.md).
// The parser imports this module into every module that mentions `import.meta`, whose `resolve`
// calls `__import_meta_resolve` with the module's `file:` URL. Not part of the public API.

import { encodeSet, PATH } from "velt:url/encode";

/**
 * `specifier` resolved against `base` (a module's `file:` URL), as Node's `import.meta.resolve`
 * resolves it: a URL (`node:fs`, `https://…`) is returned as it is, and a relative or absolute
 * path (`./x.ts`, `../y`, `/z`) is joined to `base`'s directory, with `.` and `..` segments
 * removed and the bytes a URL path cannot hold percent-encoded. The file need not exist. A
 * package name throws, as Node does for one it cannot find: a Velt program's packages are
 * compiled into it, not looked up while it runs.
 */
export function __import_meta_resolve(specifier: string, base: string): string {
  if (hasScheme(specifier)) {
    return specifier;
  }
  const relative =
    specifier == "." ||
    specifier == ".." ||
    specifier.startsWith("./") ||
    specifier.startsWith("../");
  if (!relative && !specifier.startsWith("/")) {
    throw new Error(`Cannot find package '${specifier}' imported from ${base}`);
  }
  const root = "file:///";
  const segs: string[] = [];
  if (relative) {
    const dir = base.slice(root.length as i64, base.lastIndexOf("/"));
    for (const s of dir.split("/")) {
      if (s != "") {
        segs.push(s);
      }
    }
  }
  const parts = specifier.split("/");
  for (let i: usize = 0; i < parts.length; i++) {
    const p = parts[i];
    const last = i + 1 == parts.length;
    if (p == "." || p == "..") {
      if (p == ".." && segs.length > 0) {
        segs.pop();
      }
      if (last) {
        segs.push("");
      }
    } else if (i > 0 || p != "") {
      segs.push(encodeSet(p, PATH));
    }
  }
  return root + segs.join("/");
}

/** Does `s` start with a URL scheme (`node:`, `https:`): a letter, then letters, digits, `+`, `-` or `.`, then `:`? */
function hasScheme(s: string): bool {
  const colon = s.indexOf(":");
  if (colon < 1) {
    return false;
  }
  for (let i: i64 = 0; i < colon; i++) {
    const c = s.charCodeAt(i);
    const letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
    const other = (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46;
    if (!(letter || (i > 0 && other))) {
      return false;
    }
  }
  return true;
}
