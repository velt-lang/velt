// std/url/encode (std-internal): percent-encoding and UTF-8 helpers shared by std/url.
//
// Works on the UTF-8 bytes of a string: an encoder copies them into a `u8[]` once, escapes what
// its set asks for, and turns the bytes back into a string once. The copy writes a lone
// surrogate as U+FFFD (what `URL` and `URLSearchParams` encode, `%EF%BF%BD`, as WHATWG says);
// `encodeURI`/`encodeURIComponent` refuse one instead, and decoding never makes one (surrogate
// bytes such as `%ED%A0%BD` are invalid UTF-8). Decoders and `encodeUri` return null where the
// public API throws (std/url owns the error class), so this module has no dependency on it.

import { IoResult } from "velt:io";

declare function velt_rt_bytes_from_str(s: string): u8[];
declare function velt_rt_bytes_to_str(b: u8[]): IoResult<string>;
declare function velt_rt_str_is_well_formed(s: string): bool;

/**
 * WHATWG percent-encode sets (url.spec.whatwg.org §1.3). Each set after `C0` up to `FORM`
 * contains the previous one, except `FRAGMENT` (C0 plus a few) and `SPECIAL_QUERY` (QUERY + ').
 */
export const C0: i64 = 0;
export const FRAGMENT: i64 = 1;
export const QUERY: i64 = 2;
export const SPECIAL_QUERY: i64 = 3;
export const PATH: i64 = 4;
export const USERINFO: i64 = 5;
export const COMPONENT: i64 = 6;
export const FORM: i64 = 7;

// Byte values used by the scanners.
const PERCENT: u8 = 37;
const PLUS: u8 = 43;
const SPACE: u8 = 32;

/** The bytes of `s` (a copy). */
export function bytesOf(s: string): u8[] {
  return velt_rt_bytes_from_str(s);
}

/** `bytes` as a string, or null if they are not valid UTF-8. */
export function strictUtf8(bytes: u8[]): string | null {
  const r = velt_rt_bytes_to_str(bytes);
  if (r.code != 0) {
    return null;
  }
  return r.value;
}

/**
 * `bytes` as a string, invalid sequences replaced by U+FFFD (WHATWG "UTF-8 decode without BOM").
 */
export function lossyUtf8(bytes: u8[]): string {
  const direct = strictUtf8(bytes);
  if (direct != null) {
    return direct;
  }
  const fixed: u8[] = __intrinsic_array_with_capacity(bytes.length + 8);
  let i: usize = 0;
  while (i < bytes.length) {
    const n = validSequenceLength(bytes, i);
    if (n == 0) {
      fixed.push(0xef as u8);
      fixed.push(0xbf as u8);
      fixed.push(0xbd as u8);
      i += invalidSubpartLength(bytes, i);
      continue;
    }
    for (let k: usize = 0; k < n; k++) {
      fixed.push(bytes[i + k]);
    }
    i += n;
  }
  return strictUtf8(fixed) ?? "";
}

// Length of the well-formed UTF-8 sequence at `i`, or 0.
function validSequenceLength(b: u8[], i: usize): usize {
  const lead = b[i] as i64;
  if (lead < 0x80) {
    return 1;
  }
  const n = sequenceLength(lead);
  if (n == 0 || i + n > b.length) {
    return 0;
  }
  return invalidSubpartLength(b, i) == n ? n : 0;
}

// Bytes a sequence led by `lead` should have (0: not a lead byte).
function sequenceLength(lead: i64): usize {
  if (lead >= 0xc2 && lead <= 0xdf) {
    return 2;
  }
  if (lead >= 0xe0 && lead <= 0xef) {
    return 3;
  }
  if (lead >= 0xf0 && lead <= 0xf4) {
    return 4;
  }
  return 0;
}

// Length of the maximal prefix of a valid sequence at `i` (at least 1): the unit that one
// U+FFFD replaces (Unicode "maximal subpart" practice, as WHATWG and JS's TextDecoder do).
function invalidSubpartLength(b: u8[], i: usize): usize {
  const lead = b[i] as i64;
  const n = sequenceLength(lead);
  if (n == 0) {
    return 1;
  }
  let lo: i64 = 0x80;
  let hi: i64 = 0xbf;
  if (lead == 0xe0) {
    lo = 0xa0;
  } else if (lead == 0xed) {
    hi = 0x9f;
  } else if (lead == 0xf0) {
    lo = 0x90;
  } else if (lead == 0xf4) {
    hi = 0x8f;
  }
  let k: usize = 1;
  while (k < n && i + k < b.length) {
    const c = b[i + k] as i64;
    if (c < lo || c > hi) {
      break;
    }
    lo = 0x80;
    hi = 0xbf;
    k++;
  }
  return k;
}

/** Whether byte `b` is escaped by percent-encode set `set`. */
export function inSet(b: u8, set: i64): bool {
  const c = b as i64;
  if (isAlnum(c)) {
    return false;
  }
  if (c < 0x20 || c > 0x7e) {
    return true;
  }
  if (set == C0) {
    return false;
  }
  if (set == FRAGMENT) {
    return c == 32 || c == 34 || c == 60 || c == 62 || c == 96;
  }
  if (c == 32 || c == 34 || c == 35 || c == 60 || c == 62) {
    return true;
  }
  if (set == QUERY || set == SPECIAL_QUERY) {
    return set == SPECIAL_QUERY && c == 39;
  }
  if (c == 63 || c == 94 || c == 96 || c == 123 || c == 125) {
    return true;
  }
  if (set == PATH) {
    return false;
  }
  if (c == 47 || c == 58 || c == 59 || c == 61 || c == 64 || (c >= 91 && c <= 93) || c == 124) {
    return true;
  }
  if (set == USERINFO) {
    return false;
  }
  if ((c >= 36 && c <= 38) || c == 43 || c == 44) {
    return true;
  }
  return set == FORM && (c == 33 || (c >= 39 && c <= 41) || c == 126);
}

/** ASCII letter or digit. */
export function isAlnum(c: i64): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

// Kept by `encodeURIComponent`: alphanumerics and `- _ . ! ~ * ' ( )`.
function uriUnreserved(c: i64): bool {
  return isAlnum(c) || c == 45 || c == 95 || c == 46 || c == 33 || c == 126 || (c >= 39 && c <= 42);
}

// Kept by `encodeURI` besides the unreserved characters: `; , / ? : @ & = + $ #`.
function uriReserved(c: i64): bool {
  return c == 59 ||
    c == 44 ||
    c == 47 ||
    c == 63 ||
    c == 58 ||
    c == 64 ||
    c == 38 ||
    c == 61 ||
    c == 43 ||
    c == 36 ||
    c == 35;
}

/** `s` percent-encoded with WHATWG set `set`; `FORM` also turns spaces into `+`. */
export function encodeSet(s: string, set: i64): string {
  const b = bytesOf(s);
  let first: usize = 0;
  while (first < b.length && !inSet(b[first], set)) {
    first++;
  }
  if (first == b.length) {
    return s.clone();
  }
  const out: u8[] = __intrinsic_array_with_capacity(b.length + 16);
  for (let i: usize = 0; i < b.length; i++) {
    if (!inSet(b[i], set)) {
      out.push(b[i]);
    } else if (set == FORM && b[i] == SPACE) {
      out.push(PLUS);
    } else {
      pushEscape(out, b[i]);
    }
  }
  return strictUtf8(out) ?? "";
}

/**
 * JS `encodeURIComponent` (`keepReserved` false) / `encodeURI` (true); null where JS throws
 * `URIError` (a lone surrogate, which has no UTF-8).
 */
export function encodeUri(s: string, keepReserved: bool): string | null {
  if (!velt_rt_str_is_well_formed(s)) {
    return null;
  }
  const b = bytesOf(s);
  const out: u8[] = __intrinsic_array_with_capacity(b.length + 16);
  for (let i: usize = 0; i < b.length; i++) {
    const c = b[i] as i64;
    if (uriUnreserved(c) || (keepReserved && uriReserved(c))) {
      out.push(b[i]);
    } else {
      pushEscape(out, b[i]);
    }
  }
  return strictUtf8(out) ?? "";
}

// Appends `%XX` (uppercase hex) for byte `b`.
function pushEscape(out: u8[], b: u8) {
  out.push(PERCENT);
  out.push(hexDigit((b as i64) >> 4));
  out.push(hexDigit((b as i64) & 15));
}

function hexDigit(v: i64): u8 {
  return (v < 10 ? 48 + v : 55 + v) as u8;
}

// Value of hex digit byte `c`, or -1.
function hexValue(c: u8): i64 {
  const v = c as i64;
  if (v >= 48 && v <= 57) {
    return v - 48;
  }
  if (v >= 65 && v <= 70) {
    return v - 55;
  }
  if (v >= 97 && v <= 102) {
    return v - 87;
  }
  return -1;
}

// The byte encoded by `%XX` at `i`, or -1 if there is no valid escape there.
function escapeAt(b: u8[], i: usize): i64 {
  if (b[i] != PERCENT || i + 2 >= b.length) {
    return -1;
  }
  const hi = hexValue(b[i + 1]);
  const lo = hexValue(b[i + 2]);
  return hi < 0 || lo < 0 ? -1 : hi * 16 + lo;
}

/**
 * WHATWG percent-decode (invalid escapes stay literal), `+` → space when `plusAsSpace`, then
 * lossy UTF-8.
 */
export function decodeLenient(s: string, plusAsSpace: bool): string {
  const b = bytesOf(s);
  const out: u8[] = __intrinsic_array_with_capacity(b.length);
  let i: usize = 0;
  while (i < b.length) {
    const e = escapeAt(b, i);
    if (e >= 0) {
      out.push(e as u8);
      i += 3;
      continue;
    }
    out.push(plusAsSpace && b[i] == PLUS ? SPACE : b[i]);
    i++;
  }
  return lossyUtf8(out);
}

/**
 * JS `decodeURIComponent` / `decodeURI` (`keepReserved`: escapes of reserved characters stay
 * escaped); null where JS throws `URIError` (bad escape or invalid UTF-8).
 */
export function decodeUri(s: string, keepReserved: bool): string | null {
  const b = bytesOf(s);
  const out: u8[] = __intrinsic_array_with_capacity(b.length);
  let i: usize = 0;
  while (i < b.length) {
    if (b[i] != PERCENT) {
      out.push(b[i]);
      i++;
      continue;
    }
    const e = escapeAt(b, i);
    if (e < 0) {
      return null;
    }
    if (keepReserved && uriReserved(e)) {
      out.push(b[i]);
      out.push(b[i + 1]);
      out.push(b[i + 2]);
    } else {
      out.push(e as u8);
    }
    i += 3;
  }
  return strictUtf8(out);
}
