// std/arena: a typed memory pool (region). Values are appended to one growing array and named by
// their `u32` index, and the whole pool is released at once with `reset()`, which keeps the
// memory for the next round: a per-iteration tree costs no allocation after the first one.
//
// Best with Copy structs that link to each other by index
// (`struct Node { left: u32; right: u32 }`), the arena shape of Rust's bumpalo / typed-arena
// programs. `u32` indices are half the size of pointers, so twice as many nodes fit in each cache
// line. Indices stay valid until `reset()`.

export class Arena<T> {
  private items: T[];

  /** `capacity` values fit before the pool first grows. */
  constructor(capacity: usize = 0) {
    this.items = __intrinsic_array_with_capacity(capacity);
  }

  /** Number of values allocated since the last `reset()`. */
  get length(): usize {
    return this.items.length;
  }

  /** Stores `value`; returns its index. */
  alloc(value: T): u32 {
    if (this.items.length >= 4294967295) {
      panic("Arena: too many values");
    }
    const index = this.items.length as u32;
    this.items.push(value);
    return index;
  }

  /** The value at `index` (a copy for Copy types, else a clone). */
  get(index: u32): T {
    return this.items[index as usize].clone();
  }

  /** Replaces the value at `index`. */
  set(index: u32, value: T) {
    this.items[index as usize] = value;
  }

  /** Drops every value but keeps the memory: the next allocations reuse it. */
  reset() {
    __intrinsic_array_truncate(this.items, 0);
  }
}
