// velt/reflect (internal): `RuntimeType`, what `typeOf` tells of a dynamic value.

/** What a dynamic value holds at run time (`typeOf`). */
export class RuntimeType {
  /**
   * `"undefined"`, `"null"`, `"boolean"`, `"number"`, `"string"`, `"symbol"`, `"function"`,
   * `"array"`, `"tuple"`, `"object"` (an object type), `"class"`, `"struct"`, `"map"`,
   * `"record"`, `"set"`, `"shared"`, `"proxy"`, `"interface"`, `"enum"` or `"opaque"` (a value
   * whose structure is not shown, such as a promise).
   */
  readonly kind: string;
  /** `i64`, `u8`, `f64`, … for a number; `""` otherwise. */
  readonly repr: string;
  /** The type's name as messages show it (`User`, `Map`, `number`). */
  readonly name: string;
  /** The hooks its class has, of `toJSON`, `toString` and `__inspect`. */
  readonly hooks: string[];

  constructor(kind: string, repr: string, name: string, hooks: string[]) {
    this.kind = kind;
    this.repr = repr;
    this.name = name;
    this.hooks = hooks;
  }

  /** Whether its class has the hook `name` (`toJSON`, `toString`, `__inspect`). */
  hasHook(name: string): bool {
    return this.hooks.includes(name);
  }
}
