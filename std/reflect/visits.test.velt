// velt/reflect (tests): white-box tests, run by `velt test std/`.
//
// White-box tests of the visit stack (`beginVisit`, `endVisit`): a value being visited is found
// again at any depth, past the four kept in thread-locals too, and the stack empties and grows
// again (its block of deeper visits given back and taken anew without a leak).
import { describe, expect, it } from "velt/test";
import { beginVisit, endVisit } from "velt/reflect/reflect";

describe("visits", () => {
  it("find a value being visited at any depth", () => {
    for (let round = 0; round < 3; round++) {
      for (let id: u64 = 1; id <= 40; id++) {
        expect(beginVisit(id * 8)).toBe(true);
      }
      for (const again of [8, 16, 32, 40, 48, 200, 320]) {
        expect(beginVisit(again as u64)).toBe(false);
      }
      expect(beginVisit(41 * 8)).toBe(true);
      endVisit();
      for (let id: u64 = 1; id <= 40; id++) {
        endVisit();
      }
      expect(beginVisit(8)).toBe(true);
      endVisit();
    }
  });

  it("ends only the innermost visit", () => {
    expect(beginVisit(1)).toBe(true);
    expect(beginVisit(2)).toBe(true);
    endVisit();
    expect(beginVisit(1)).toBe(false);
    expect(beginVisit(2)).toBe(true);
    endVisit();
    endVisit();
    endVisit();
    expect(beginVisit(1)).toBe(true);
    endVisit();
  });
});
