// std/net: TCP, and TLS over TCP, over the runtime (docs/internals/contracts/rt_abi_async.md
// §6). A TLS connection (`connectTls`, a `listenTls` listener) is a `TcpStream` like any other.
//
// Handles: the runtime's `VeltListener` / `VeltStream` are opaque `u64` handles (rt_abi_async.md
// §3.2), declared and defined as `u64` on every target.
// `TcpListener` and `TcpStream` are Copy structs around that handle, like file descriptors:
// - async methods take `this` by copy, so `await conn.readString()` never moves `conn` and a
//   listener can be moved into a spawned task while its `port` is still read outside;
// - the handle is released only by `close()`: an unclosed handle leaks until process exit. The
//   handle is a key into a runtime table, not an address: after `close()` through any copy,
//   every copy is dead: its operations throw `IoError` `EBADF` ("handle is closed") and closing
//   again does nothing. They cannot use a `[Symbol.dispose]()` drop hook: a type with one is never Copy,
//   and an async method owns (moves) its `this`, so `await conn.readString(); await
//   conn.write(...)` would not compile. The runtime keeps a socket alive while an operation is
//   in flight, so `close()` may be called at any time.

import { IoResult, IoStatus, unwrapIo, checkIo } from "velt:io";
import { tryWriteTo, writeBytesTo } from "velt:net_bytes";
import { Uint8Array } from "velt:typed_array/uint8_array";

declare async function velt_rt_tcp_listen(addr: string): Promise<IoResult<u64>>;
declare function velt_rt_tcp_listener_port(l: u64): u32;
declare function velt_rt_tcp_listener_close(l: u64);
declare async function velt_rt_tcp_accept(l: u64): Promise<IoResult<u64>>;
declare async function velt_rt_tcp_connect(addr: string): Promise<IoResult<u64>>;
declare async function velt_rt_tcp_read(s: u64, max: u64): Promise<IoResult<u8[]>>;
declare async function velt_rt_tcp_read_string(s: u64, max: u64): Promise<IoResult<string>>;
// The `u8[]` variant, `velt_rt_tcp_write_bytes`, is declared in std/net_bytes.
declare async function velt_rt_tcp_write(s: u64, data: string): Promise<IoStatus>;
// Reads into and writes from a range of the program's own bytes (a `Uint8Array`'s buffer).
declare function velt_rt_tcp_try_read_into(s: u64, data: u8[], start: u64, end: u64): IoResult<i64>;
declare async function velt_rt_tcp_readable(s: u64): Promise<IoStatus>;
declare async function velt_rt_tcp_write_range(
  s: u64,
  data: u8[],
  start: u64,
  end: u64,
): Promise<IoStatus>;
declare function velt_rt_tcp_try_write_range(s: u64, data: u8[], start: u64, end: u64): u64;
declare function velt_rt_tcp_shutdown(s: u64): IoStatus;
declare function velt_rt_tcp_peer_addr(s: u64): string;
declare function velt_rt_tcp_abort(s: u64);
declare function velt_rt_tcp_close(s: u64);
declare async function velt_rt_tcp_listen_tls(
  addr: string,
  cert: string,
  key: string,
  alpn: string,
): Promise<IoResult<u64>>;
declare async function velt_rt_tcp_connect_tls(
  addr: string,
  serverName: string,
  ca: string,
  alpn: string,
): Promise<IoResult<u64>>;

/** A bound listening socket. */
export struct TcpListener {
  /** The real bound port (useful after listening on port 0). */
  port: number;
  private handle: u64;

  /**
   * Waits for the next connection (TCP_NODELAY is on). On a `listenTls` listener the TLS
   * handshake runs with the stream's first read or write, which throws if it fails (10 s limit).
   */
  async accept(): Promise<TcpStream> {
    return TcpStream { handle: unwrapIo(await velt_rt_tcp_accept(this.handle)) };
  }

  /**
   * Releases the handle: later `accept`s through any copy throw `IoError` `EBADF`, and closing
   * again does nothing. An `accept` already waiting keeps the socket open until it completes.
   */
  close() {
    velt_rt_tcp_listener_close(this.handle);
  }
}

/** A connected TCP stream. */
export struct TcpStream {
  private handle: u64;

  /** The next 1..max bytes (`max == 0`: up to 64 KiB); an empty array means end of stream. */
  async read(max: u64 = 0): Promise<u8[]> {
    return unwrapIo(await velt_rt_tcp_read(this.handle, max));
  }

  /**
   * The next chunk as UTF-8 (a character split across reads is completed by the next call,
   * invalid bytes become U+FFFD); "" means end of stream.
   */
  async readString(max: u64 = 0): Promise<string> {
    return unwrapIo(await velt_rt_tcp_read_string(this.handle, max));
  }

  /**
   * Reads what has arrived into `buf`, at most `buf.length` bytes, straight from the socket
   * (nothing is allocated or copied on the way for a plain TCP stream): the number of bytes
   * read, or `null` at the end of the stream (as Deno's `conn.read`). Waits only when nothing
   * has arrived yet. An empty `buf` reads nothing and returns 0. Reusing one buffer per
   * connection, and `subarray` views of what was read, keeps a server from copying its input.
   */
  async readInto(buf: Uint8Array): Promise<number | null> {
    const start = buf.off as u64;
    const end = (buf.off + buf.len) as u64;
    if (start === end) {
      return 0;
    }
    while (true) {
      const n = unwrapIo(velt_rt_tcp_try_read_into(this.handle, buf.buf.bytes, start, end));
      if (n >= 0) {
        return n === 0 ? null : n as number;
      }
      checkIo(await velt_rt_tcp_readable(this.handle));
    }
  }

  /**
   * Reads what has arrived into `buf[start..end]` without waiting: the number of bytes read,
   * `0` when nothing has arrived yet (`await readable()`, then try again), or `null` at the end
   * of the stream. A plain TCP stream reads straight into `buf`, so a parser can read into its
   * own buffer with nothing allocated or copied (`readInto` does the waiting for a
   * `Uint8Array`). `RangeError` for an empty or out-of-range range.
   */
  tryRead(buf: u8[] | Uint8Array, start: number = 0, end?: number): number | null {
    let bytes: u8[];
    let base: u64 = 0;
    let len: number;
    if (buf instanceof Uint8Array) {
      bytes = buf.buf.bytes;
      base = buf.off as u64;
      len = buf.len as number;
    } else {
      bytes = buf;
      len = buf.length as number;
    }
    // Indices as JS takes them (truncated, NaN as 0); then the range must be inside `buf`.
    const from = toIndex(start);
    const to = end === undefined ? len : toIndex(end);
    if (!(from >= 0 && from < to && to <= len)) {
      throw new RangeError(`tryRead: the range ${from}..${to} is empty or outside 0..${len}`);
    }
    const n = unwrapIo(
      velt_rt_tcp_try_read_into(this.handle, bytes, base + (from as u64), base + (to as u64)),
    );
    if (n > 0) {
      return n as number;
    }
    return n === 0 ? null : 0;
  }

  /**
   * Resolves once a `tryRead` may find data, the end of the stream or an error (it may also
   * find nothing yet: wait again). Holds no buffer while it waits.
   */
  async readable(): Promise<void> {
    checkIo(await velt_rt_tcp_readable(this.handle));
  }

  /** Resolves once every byte is written; `data` is copied at the call. */
  async write(data: string): Promise<void> {
    checkIo(await velt_rt_tcp_write(this.handle, data));
  }

  /**
   * Resolves once every byte is written. What the socket takes at the call is written from
   * `data` itself; only what it cannot take yet is copied.
   */
  async writeBytes(data: u8[] | Uint8Array, start: number = 0, end?: number): Promise<void> {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const bytes = data.buf.bytes;
      const from = at + clampTo(start, len);
      checkIo(
        await velt_rt_tcp_write_range(this.handle, bytes, from, at + clampTo(end ?? len, len)),
      );
      return;
    }
    if (start === 0 && end == null) {
      checkIo(await writeBytesTo(this.handle, data));
      return;
    }
    const len = data.length as number;
    const from = clampTo(start, len);
    checkIo(await velt_rt_tcp_write_range(this.handle, data, from, clampTo(end ?? len, len)));
  }

  /**
   * Writes what the socket takes of `data` right now, without waiting, and returns the number
   * of bytes written (0 when it takes nothing now, while an earlier `write` is still going on,
   * for a TLS stream, and after an error, which the next `write` reports). For protocols that send small messages: when everything was
   * written there is nothing to await.
   */
  tryWrite(data: u8[] | Uint8Array, start: number = 0, end?: number): i64 {
    if (data instanceof Uint8Array) {
      const len = data.len as number;
      const at = data.off as u64;
      const from = at + clampTo(start, len);
      const to = at + clampTo(end ?? len, len);
      return velt_rt_tcp_try_write_range(this.handle, data.buf.bytes, from, to) as i64;
    }
    if (start === 0 && end == null) {
      return tryWriteTo(this.handle, data);
    }
    const len = data.length as number;
    const from = clampTo(start, len);
    return velt_rt_tcp_try_write_range(this.handle, data, from, clampTo(end ?? len, len)) as i64;
  }

  /** Half-close: the peer reads end of stream; this side can still read. */
  shutdown() {
    checkIo(velt_rt_tcp_shutdown(this.handle));
  }

  /** The peer's "ip:port" ("" once the handle is closed). */
  peerAddr(): string {
    return velt_rt_tcp_peer_addr(this.handle);
  }

  /**
   * Fails the operations in flight on this stream (a `write` to a peer that stopped reading
   * would otherwise never finish) and every later one; nothing more is sent or received. The handle stays open until `close()`.
   */
  abort() {
    velt_rt_tcp_abort(this.handle);
  }

  /**
   * Releases the handle: later operations through any copy throw `IoError` `EBADF`, and closing
   * again does nothing. The socket closes once the operations in flight have finished.
   */
  close() {
    velt_rt_tcp_close(this.handle);
  }
}

/** `i` as an offset into `len` bytes, as `subarray` takes it: from the end when negative. */
function clampTo(i: number, len: number): u64 {
  const t = toIndex(i);
  const at = t < 0 ? len + t : t;
  return at <= 0 ? 0 : at >= len ? len as u64 : at as u64;
}

/** An index argument as JS takes it: truncated toward zero, NaN as 0. */
function toIndex(i: number): number {
  return Number.isNaN(i) ? 0 : Math.trunc(i);
}

/** Listens on "host:port" (port 0 picks a free port; read it back from `.port`). */
export async function listen(addr: string): Promise<TcpListener> {
  const handle = unwrapIo(await velt_rt_tcp_listen(addr));
  return TcpListener { port: velt_rt_tcp_listener_port(handle), handle: handle };
}

/** Connects to "host:port". */
export async function connect(addr: string): Promise<TcpStream> {
  return TcpStream { handle: unwrapIo(await velt_rt_tcp_connect(addr)) };
}

export struct TlsListenOptions {
  /** The certificate chain, PEM text. */
  cert: string;
  /** Its private key, PEM text. */
  key: string;
  /** The protocols to offer with ALPN, most preferred first (default: none). */
  alpn?: string[];
}

/**
 * `listen` for TLS connections: `accept` gives streams that are encrypted with `opts.cert`.
 * Throws `IoError` "EINVAL" for a certificate or key that is not valid PEM.
 */
export async function listenTls(addr: string, opts: TlsListenOptions): Promise<TcpListener> {
  const alpn = (opts.alpn ?? []).join(",");
  const handle = unwrapIo(await velt_rt_tcp_listen_tls(addr, opts.cert, opts.key, alpn));
  return TcpListener { port: velt_rt_tcp_listener_port(handle), handle: handle };
}

export struct TlsConnectOptions {
  /** The name the server's certificate must be for (default: the host in the address). */
  serverName?: string;
  /** Extra trusted CA certificates (PEM), e.g. a private or test CA. */
  ca?: string;
  /** The protocols to offer with ALPN, most preferred first (default: none). */
  alpn?: string[];
}

/**
 * Connects to "host:port" over TLS; resolves once the handshake is done (the server's
 * certificate is checked against the built-in roots and `opts.ca`).
 */
export async function connectTls(addr: string, opts: TlsConnectOptions = {}): Promise<TcpStream> {
  const alpn = (opts.alpn ?? []).join(",");
  const name = opts.serverName ?? "";
  return TcpStream {
    handle: unwrapIo(await velt_rt_tcp_connect_tls(addr, name, opts.ca ?? "", alpn)),
  };
}
