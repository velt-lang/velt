// std/http: the HTTP server over the runtime (hyper; rt_abi_async.md §7). Handlers take the
// global `Request` and return the global `Response` (std/fetch), as in Deno and Bun; the client
// is the global `fetch`.
//
// Server: `serve` hands the runtime a `VeltHandler` (init/poll/drop/state size/align/env). That
// descriptor is produced by the compiler intrinsic `__intrinsic_http_handler(f)` from an async
// closure literal `f: (raw: u64) => Promise<u64>` (`VeltReq` handle in, response out):
// the closure's own state machine is the per-request state (result at offset 0), `init` writes its
// initial state from `(env, req)`, `poll`/`drop` are the closure's `$poll`/`$drop`, and `env` is
// the closure's heap environment (shared with in-flight requests; the runtime drops it once the
// server is closed and its last request finished, so captured values' `[Symbol.dispose]()`
// hooks run). `serve` wraps the user handler in such a closure, which hands it the raw request as
// a `Request` that reads it lazily (std/fetch/request.vlt), releases the raw request once the
// handler settled, and hands the returned `Response` to the request in one call (a complete
// body), or builds it into a runtime response that a `BodyStream` body is then copied into
// (std/http/stream.vlt), so the intrinsic only ever sees one closure type.
//
// Handles (`VeltServer`: a `u64`, rt_abi_async.md §3.2) are released by the owning value's
// `[Symbol.dispose]()` drop hook, which zeroes the handle so it runs at most once. A `Server`
// stops only on `close()`; dropping it releases the handle but keeps it serving (like Node).

import { IoResult, unwrapIo } from "velt:io";
import { Request } from "velt:fetch/request";
import { Response } from "velt:fetch/response";
import { pump } from "velt:http/stream";

// `VeltHandler` field by field: init, poll, drop, state_size, state_align, env (48 bytes).
type RtHandler = [u64, u64, u64, u64, u64, u64];

declare async function velt_rt_http_serve(addr: string, h: RtHandler): Promise<IoResult<u64>>;
declare async function velt_rt_http_serve_tls(
  addr: string,
  h: RtHandler,
  cert: string,
  key: string,
): Promise<IoResult<u64>>;
declare function velt_rt_http_server_port(s: u64): u32;
declare function velt_rt_http_server_close(s: u64);
declare async function velt_rt_http_server_shutdown(s: u64): Promise<void>;
declare function velt_rt_http_server_detach(s: u64);

declare function velt_rt_http_req_remote_host(r: u64): string;
declare function velt_rt_http_req_remote_port(r: u64): u32;
declare function velt_rt_http_req_drop(r: u64);

// Loopback unless the caller asks for more (pass `host: "0.0.0.0"` to listen on all interfaces).
const DEFAULT_HOST = "127.0.0.1";

/** A certificate chain and its private key, both PEM text (e.g. read with `readFile`). */
export struct TlsOptions {
  cert: string;
  key: string;
}

export struct ServeOptions {
  port: i64;
  host?: string;
  /** Serve HTTPS (HTTP/2 and HTTP/1.1, negotiated with ALPN) instead of plain HTTP. */
  tls?: TlsOptions;
}

/** An address a connection came from (Deno's `NetAddr`). */
export struct NetAddr {
  /** "tcp" */
  transport: string;
  /** The IP address, e.g. "127.0.0.1" or "::1". */
  hostname: string;
  port: i64;
}

/**
 * What the server knows about a request beyond the `Request` itself: a handler's second
 * argument (Deno's `ServeHandlerInfo`). Valid while the handler runs, like its request.
 */
export struct ServeInfo {
  private raw: u64;

  /** The client's address. */
  get remoteAddr(): NetAddr {
    return {
      transport: "tcp",
      hostname: velt_rt_http_req_remote_host(this.raw),
      port: velt_rt_http_req_remote_port(this.raw) as i64,
    };
  }
}

/** A running server; requests are handled concurrently on the runtime's workers. */
export class Server {
  /** The real port (useful after `port: 0`). */
  port: i64 = 0;
  #handle: u64 = 0;

  // The server behind runtime key `handle` (std only).
  private static adopt(handle: u64): Server {
    const s = new Server();
    s.port = velt_rt_http_server_port(handle) as i64;
    s.#handle = handle;
    return s;
  }

  /**
   * Stops accepting, lets in-flight requests finish, closes idle connections. Idempotent. The
   * handler (and whatever it captured) is dropped once the last request finished.
   */
  close() {
    if (this.#handle != 0) {
      velt_rt_http_server_close(this.#handle);
      this.#handle = 0;
    }
  }

  /**
   * `close()`, then waits until every in-flight request has finished and the handler (with
   * everything it captured) was dropped. Consumes the server (an async method takes `this`).
   */
  async shutdown() {
    if (this.#handle != 0) {
      const handle = this.#handle;
      this.#handle = 0;
      await velt_rt_http_server_shutdown(handle);
    }
  }

  /**
   * Drop hook: releasing the handle does NOT stop the server (like Node: it keeps serving, and
   * keeps the process alive, until `close()` or process exit).
   */
  [Symbol.dispose]() {
    if (this.#handle != 0) {
      velt_rt_http_server_detach(this.#handle);
      this.#handle = 0;
    }
  }
}

// What the handler for request `raw` returns to the runtime for the response `res`: the
// response is handed to the request, or a runtime response a streamed body is copied into; 0 if
// a header name or value is not valid HTTP.
function build(res: Response, raw: u64): u64 {
  const r = res.toServer(raw);
  const stream = res.serverStream();
  if (r != 0 && stream != null) {
    pump(r, stream);
  }
  return r;
}

// The response to a handler that failed.
function failure(raw: u64): u64 {
  return new Response("Internal Server Error", { status: 500 }).toServer(raw);
}

/**
 * Binds `host:port` (default host 127.0.0.1; port 0 = any free port) and serves `handler` in the
 * background. Handlers run concurrently, so like spawned tasks they must not mutate captured
 * variables (use `shared`). A handler that throws (rejects with `E`) gets a 500 response, and
 * the error is printed to stderr (like Deno's and Bun's `serve`).
 */
export async function serve<E>(
  opts: ServeOptions,
  handler: (req: Request, info: ServeInfo) => Promise<Response, E>,
): Promise<Server> {
  const addr = `${opts.host ?? DEFAULT_HOST}:${opts.port}`;
  const h: RtHandler = __intrinsic_http_handler(async (raw: u64): Promise<u64> => {
    let out: u64 = 0;
    try {
      const res = await handler(Request.adopt(raw), ServeInfo { raw: raw });
      out = build(res, raw);
      if (out == 0) {
        console.error("request handler failed: the response has an invalid header name or value");
      }
    } catch (e) {
      console.error("request handler failed:", e);
    }
    if (out == 0) {
      out = failure(raw);
    }
    velt_rt_http_req_drop(raw);
    return out;
  });
  const tls = opts.tls;
  const handle =
    tls == null
      ? unwrapIo(await velt_rt_http_serve(addr, h))
      : unwrapIo(await velt_rt_http_serve_tls(addr, h, tls.cert, tls.key));
  return Server.adopt(handle);
}
