// std/http: HTTP/1.1 server and client over the runtime (hyper; rt_abi_async.md §7).
//
// Server: `serve` hands the runtime a `VeltHandler` (init/poll/drop/state size/align/env). That
// descriptor is produced by the compiler intrinsic `__intrinsic_http_handler(f)` from an async
// closure literal `f: (raw: u64) => Promise<u64>` (`VeltReq` handle in, `VeltResp` handle out):
// the closure's own state machine is the per-request state (result at offset 0), `init` writes its
// initial state from `(env, req)`, `poll`/`drop` are the closure's `$poll`/`$drop`, and `env` is
// the closure's heap environment (shared with in-flight requests; the runtime drops it once the
// server is closed and its last request finished, so captured values' `[Symbol.dispose]()` hooks run).
// `serve` wraps the user handler in such a closure, which converts the raw request into a
// `Request` (copying its fields, then releasing it) and the returned `Response` back to its raw
// pointer, so the intrinsic only ever sees one closure type.
//
// Handles (`VeltServer`, `VeltResp`, `VeltFetchResp`: `u64`s, rt_abi_async.md §3.2) are
// released by the owning value's `[Symbol.dispose]()` drop hook, which zeroes the handle so it runs at
// most once: a `Response` that is dropped instead of returned from a handler, a `FetchResponse`
// when it is dropped (reading its body consumes it). A `Server` stops only on `close()`;
// dropping it releases the handle but keeps it serving (like Node).

import { IoResult, unwrapIo } from "velt:io";

// `VeltHandler` field by field: init, poll, drop, state_size, state_align, env (48 bytes).
type RtHandler = [u64, u64, u64, u64, u64, u64];

declare async function velt_rt_http_serve(addr: string, h: RtHandler): Promise<IoResult<u64>>;
declare async function velt_rt_http_serve_tls(
  addr: string,
  h: RtHandler,
  cert: string,
  key: string,
): Promise<IoResult<u64>>;
declare function velt_rt_http_server_port(s: u64): u32;
declare function velt_rt_http_server_close(s: u64);
declare async function velt_rt_http_server_shutdown(s: u64): Promise<void>;
declare function velt_rt_http_server_detach(s: u64);

declare function velt_rt_http_req_method(r: u64): string;
declare function velt_rt_http_req_path(r: u64): string;
declare function velt_rt_http_req_query(r: u64): string;
declare function velt_rt_http_req_body(r: u64): string;
declare function velt_rt_http_req_header_names(r: u64): string[];
declare function velt_rt_http_req_header_values(r: u64): string[];
declare function velt_rt_http_req_upgrade(r: u64): u64;
declare function velt_rt_http_req_drop(r: u64);

declare function velt_rt_http_resp_new(status: u32): u64;
declare function velt_rt_http_resp_header(r: u64, name: string, value: string): bool;
declare function velt_rt_http_resp_set_header(r: u64, name: string, value: string): bool;
// These three take the body: the string/array is moved out and left empty.
declare function velt_rt_http_resp_body_text(r: u64, body: string);
declare function velt_rt_http_resp_body_bytes(r: u64, body: u8[]);
declare function velt_rt_http_resp_json(r: u64, json: string);
declare function velt_rt_http_resp_drop(r: u64);

// `headers` points at `2 * nHeaders` contiguous strings (name, value, …); `ca` = extra trusted
// PEM CA certificates ("" = none).
declare async function velt_rt_http_fetch_ca(
  method: string,
  url: string,
  headers: string,
  nHeaders: u64,
  body: string,
  ca: string,
): Promise<IoResult<u64>>;
declare function velt_rt_http_fetch_resp_status(r: u64): u32;
declare function velt_rt_http_fetch_resp_header(r: u64, name: string, out: string): bool;
declare function velt_rt_http_fetch_resp_text(r: u64): IoResult<string>;
declare function velt_rt_http_fetch_resp_bytes(r: u64): u8[];
declare function velt_rt_http_fetch_resp_drop(r: u64);

// Loopback unless the caller asks for more (pass `host: "0.0.0.0"` to listen on all interfaces).
const DEFAULT_HOST = "127.0.0.1";

// A certificate chain and its private key, both PEM text (e.g. read with `readFile`).
export struct TlsOptions {
  cert: string;
  key: string;
}

export struct ServeOptions {
  port: i64;
  host?: string;
  // Serve HTTPS (HTTP/2 and HTTP/1.1, negotiated with ALPN) instead of plain HTTP.
  tls?: TlsOptions;
}

// Request headers, copied out of the runtime request; names are lowercase.
export class Headers {
  names: string[];
  values: string[];

  constructor(names: string[], values: string[]) {
    this.names = names;
    this.values = values;
  }

  // The first value of header `name` (case-insensitive), or null.
  get(name: string): string | null {
    const key = name.toLowerCase();
    for (let i: usize = 0; i < this.names.length; i++) {
      if (this.names[i] == key) {
        return this.values[i];
      }
    }
    return null;
  }

  has(name: string): bool {
    return this.names.includes(name.toLowerCase());
  }
}

// An incoming request; the body has been read completely (decoded as UTF-8, lossily). A plain
// value owned by the handler, so its fields can be moved out (`{ path: req.path }`).
export struct Request {
  method: string;
  // Without the query string.
  path: string;
  // Without the leading `?`.
  query: string;
  headers: Headers;
  body: string;
  // Runtime key of a requested protocol upgrade (0 = none); consumed by std/websocket.
  upgrade: u64;
}

// An outgoing response (a runtime `VeltResp` handle), built by the static constructors.
export class Response {
  raw: u64;

  constructor(raw: u64) {
    this.raw = raw;
  }

  // `text/plain; charset=utf-8`. The body is handed to the runtime without a copy.
  static text(body: string, status: i64 = 200): Response {
    const r = velt_rt_http_resp_new(status as u32);
    let owned = body;
    velt_rt_http_resp_body_text(r, owned);
    return new Response(r);
  }

  // `JSON.stringify(value)` with `content-type: application/json`.
  static json<T>(value: T, status: i64 = 200): Response {
    const r = velt_rt_http_resp_new(status as u32);
    let text = JSON.stringify(value);
    velt_rt_http_resp_json(r, text);
    return new Response(r);
  }

  // `text/html; charset=utf-8`.
  static html(body: string, status: i64 = 200): Response {
    const r = velt_rt_http_resp_new(status as u32);
    velt_rt_http_resp_header(r, "content-type", "text/html; charset=utf-8");
    let owned = body;
    velt_rt_http_resp_body_text(r, owned);
    return new Response(r);
  }

  // `application/octet-stream` unless a `content-type` header is set.
  static bytes(body: u8[], status: i64 = 200): Response {
    const r = velt_rt_http_resp_new(status as u32);
    let owned = body;
    velt_rt_http_resp_body_bytes(r, owned);
    return new Response(r);
  }

  // Appends a header; false if the name or value is not valid in HTTP.
  header(name: string, value: string): bool {
    return velt_rt_http_resp_header(this.raw, name, value);
  }

  // Sets a header, replacing earlier values (such as the default `content-type`); false if the
  // name or value is not valid in HTTP.
  setHeader(name: string, value: string): bool {
    return velt_rt_http_resp_set_header(this.raw, name, value);
  }

  // Gives up the runtime response (the handler adapter returns it to the runtime).
  intoRaw(): u64 {
    const r = this.raw;
    this.raw = 0;
    return r;
  }

  // Drop hook: frees a response that was not returned from a handler.
  [Symbol.dispose]() {
    if (this.raw != 0) {
      velt_rt_http_resp_drop(this.raw);
      this.raw = 0;
    }
  }
}

// A running server; requests are handled concurrently on the runtime's workers.
export class Server {
  // The real port (useful after `port: 0`).
  port: i64;
  handle: u64;

  constructor(port: i64, handle: u64) {
    this.port = port;
    this.handle = handle;
  }

  // Stops accepting, lets in-flight requests finish, closes idle connections. Idempotent. The
  // handler (and whatever it captured) is dropped once the last request finished.
  close() {
    if (this.handle != 0) {
      velt_rt_http_server_close(this.handle);
      this.handle = 0;
    }
  }

  // `close()`, then waits until every in-flight request has finished and the handler (with
  // everything it captured) was dropped. Consumes the server (an async method takes `this`).
  async shutdown() {
    if (this.handle != 0) {
      const handle = this.handle;
      this.handle = 0;
      await velt_rt_http_server_shutdown(handle);
    }
  }

  // Drop hook: releasing the handle does NOT stop the server (like Node: it keeps serving, and
  // keeps the process alive, until `close()` or process exit).
  [Symbol.dispose]() {
    if (this.handle != 0) {
      velt_rt_http_server_detach(this.handle);
      this.handle = 0;
    }
  }
}

// Copies a runtime request into a `Request` and releases the runtime request.
function requestFromRaw(raw: u64): Request {
  const names = velt_rt_http_req_header_names(raw);
  const values = velt_rt_http_req_header_values(raw);
  const req = Request {
    method: velt_rt_http_req_method(raw),
    path: velt_rt_http_req_path(raw),
    query: velt_rt_http_req_query(raw),
    headers: new Headers(names, values),
    body: velt_rt_http_req_body(raw),
    upgrade: velt_rt_http_req_upgrade(raw),
  };
  velt_rt_http_req_drop(raw);
  return req;
}

// Binds `host:port` (default host 127.0.0.1; port 0 = any free port) and serves `handler` in the
// background. Handlers run concurrently, so like spawned tasks they must not mutate captured
// variables (use `shared`). A handler that throws (rejects with `E`) gets a 500 response, and
// the error is printed to stderr (like Deno's and Bun's `serve`).
export async function serve<E>(
  opts: ServeOptions,
  handler: (req: Request) => Promise<Response, E>,
): Promise<Server> {
  const addr = `${opts.host ?? DEFAULT_HOST}:${opts.port}`;
  const h: RtHandler = __intrinsic_http_handler(async (raw: u64): Promise<u64> => {
    try {
      let resp = await handler(requestFromRaw(raw));
      return resp.intoRaw();
    } catch (e) {
      console.error("request handler failed:", e);
      let failed = Response.text("Internal Server Error", 500);
      return failed.intoRaw();
    }
  });
  const tls = opts.tls;
  const handle =
    tls == null
      ? unwrapIo(await velt_rt_http_serve(addr, h))
      : unwrapIo(await velt_rt_http_serve_tls(addr, h, tls.cert, tls.key));
  return new Server(velt_rt_http_server_port(handle) as i64, handle);
}

export struct FetchOptions {
  // Default "GET".
  method?: string;
  body?: string;
  headers?: Map<string, string>;
  // Extra trusted CA certificates (PEM) for `https://`, e.g. a private or test CA.
  ca?: string;
}

// Header lookup on a fetched response. A view of the response's handle: valid only while the
// response is alive (i.e. before `text()`/`json()`/`bytes()` consume it or it is dropped).
export struct FetchHeaders {
  handle: u64;

  // The value of header `name` (case-insensitive), or null.
  get(name: string): string | null {
    let out = "";
    if (velt_rt_http_fetch_resp_header(this.handle, name, out)) {
      return out;
    }
    return null;
  }
}

// A fetched response; the body has been read completely. Reading the body (`text`, `json`,
// `bytes`) consumes the response (async methods own `this`), like Rust's reqwest; the handle is
// released when the response is dropped.
export class FetchResponse {
  status: i64;
  headers: FetchHeaders;
  handle: u64;

  constructor(handle: u64) {
    this.status = velt_rt_http_fetch_resp_status(handle) as i64;
    this.headers = FetchHeaders { handle: handle };
    this.handle = handle;
  }

  // The body as UTF-8 (`IoError` "EILSEQ" if it is not).
  async text(): Promise<string> {
    return unwrapIo(velt_rt_http_fetch_resp_text(this.handle));
  }

  // `JSON.parse<T>` of the body; throws `IoError | JsonError`.
  async json<T>(): Promise<T> {
    return JSON.parse<T>(await this.text());
  }

  async bytes(): Promise<u8[]> {
    return velt_rt_http_fetch_resp_bytes(this.handle);
  }

  // Drop hook: releases the runtime response.
  [Symbol.dispose]() {
    if (this.handle != 0) {
      velt_rt_http_fetch_resp_drop(this.handle);
      this.handle = 0;
    }
  }
}

// `http://` and `https://` (TLS through rustls with Mozilla's root certificates plus `ca`;
// HTTP/2 when the server offers it). Resolves once the whole response body has been received.
export async function fetch(url: string, opts: FetchOptions = {}): Promise<FetchResponse> {
  const method = opts.method ?? "GET";
  const body = opts.body ?? "";
  const flat: string[] = [];
  const extra = opts.headers;
  if (extra != null) {
    for (const [name, value] of extra) {
      flat.push(name);
      flat.push(value);
    }
  }
  // The runtime reads the headers straight out of `flat`'s buffer (a borrow of `flat[0]` is a
  // pointer to it); with no headers it reads nothing, so any string can stand in.
  const n = (flat.length / 2) as u64;
  const ca = opts.ca ?? "";
  const r =
    n > 0
      ? await velt_rt_http_fetch_ca(method, url, flat[0], n, body, ca)
      : await velt_rt_http_fetch_ca(method, url, method, 0, body, ca);
  return new FetchResponse(unwrapIo(r));
}
