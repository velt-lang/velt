// std/http/server: an HTTP/1.1 server written in Velt on std/net (docs/std/http_server.md).
//
// One task per connection. The connection reads into a buffer of its own; each request is parsed
// in place there (http/server/parse.vlt) and handed to the handler with a response writer whose
// bytes go into one buffer per connection: every response to the requests one read brought
// (pipelining) leaves in one write. The fixed parts of a response head are encoded once per
// connection and the `Date` value once per second; text goes into the buffer without a copy in
// between. Nothing on the request path is module state (#1487).

import { IoError } from "velt:io";
import { listen, listenTls, TcpListener, TcpStream, TlsListenOptions } from "velt:net";
import { AbortController, AbortSignal } from "velt:task";
import { delay } from "velt:timers";
import { BadRequest, BODY_CHUNKED, BODY_LENGTH, Parser } from "velt:http/server/parse";
import { HttpRequest } from "velt:http/server/request";
import { HttpResponse, reason } from "velt:http/server/response";

export { BodyTooLarge, HttpRequest } from "velt:http/server/request";
export { EventStream, HttpResponse, HttpStream } from "velt:http/server/response";

const DEFAULT_HOST = "127.0.0.1";
/// A request head (request line and headers) larger than this is refused (431), as Node's
/// `maxHeaderSize`.
const MAX_HEAD: number = 16384;
/// A request with more headers than this is refused (431).
const MAX_HEADERS: number = 100;
/// A request body larger than this is refused (413).
const MAX_BODY: number = 8388608;

export struct HttpServeOptions {
  port: number;
  host?: string;
  /** The largest request head accepted, in bytes (431 beyond it). Default 16 KiB, as Node's. */
  maxHeadSize?: number;
  /** The most headers a request may have (431 beyond them). Default 100. */
  maxHeaders?: number;
  /** The largest request body accepted, in bytes (413 beyond it). Default 8 MiB. */
  maxBodySize?: number;
  /**
   * Milliseconds a connection may wait for its next request (or the rest of one) before it is
   * closed. Default 5000, as Node's `keepAliveTimeout`.
   */
  idleTimeout?: number;
  /** Serve HTTPS: the certificate chain and key (PEM text), as `listenTls` takes them. */
  tls?: TlsListenOptions;
  /**
   * Milliseconds a request's head may take to arrive in full, from its first byte (408 after,
   * however steadily it trickles in). Default 60000, as Node's `headersTimeout`.
   */
  headersTimeout?: number;
  /**
   * Milliseconds a request's body may take to arrive, from its head (408 after). Default
   * 300000, as Node's `requestTimeout`.
   */
  requestTimeout?: number;
}

/** A running server. */
export class HttpServer {
  /** The real port (useful after `port: 0`). */
  port: number = 0;
  private listener: TcpListener;
  private stop: AbortController;

  constructor(listener: TcpListener, stop: AbortController) {
    this.listener = listener;
    this.port = listener.port;
    this.stop = stop;
  }

  /**
   * Stops accepting connections and closes the idle ones; a connection in the middle of a
   * request answers it, then closes. Idempotent.
   */
  close() {
    this.listener.close();
    this.stop.abort();
  }
}

/**
 * Binds `host:port` (default host 127.0.0.1; port 0 picks a free port) and serves `handler` in
 * the background: an `async` handler answers each request through `res` (`res.send(...)`). A
 * handler that throws, or returns without sending, gets a 500 or an empty 200.
 */
export async function serve<E>(
  opts: HttpServeOptions,
  handler: (req: HttpRequest, res: HttpResponse) => Promise<void, E> throws E,
): Promise<HttpServer> {
  const addr = `${opts.host ?? DEFAULT_HOST}:${opts.port}`;
  const tls = opts.tls;
  const listener = tls != null ? await listenTls(addr, tls) : await listen(addr);
  const maxHead = (opts.maxHeadSize ?? MAX_HEAD) as i64;
  const maxBody = (opts.maxBodySize ?? MAX_BODY) as i64;
  const maxHeaders = (opts.maxHeaders ?? MAX_HEADERS) as i64;
  const idle = (opts.idleTimeout ?? IDLE_MS) as i64;
  const limits = Limits {
    headMs: (opts.headersTimeout ?? HEADERS_MS) as i64,
    requestMs: (opts.requestTimeout ?? REQUEST_MS) as i64,
    maxHeaders: maxHeaders,
  };
  const stop = new AbortController();
  const stopped = stop.signal;
  const accepting = listener;
  spawn(async () => {
    // Only `close()` ends the loop. Another failure (out of file descriptors, a connection reset
    // before it was accepted) is waited out, 5 ms doubling up to 1 s, as Go's net/http does.
    let backoff: i64 = 0;
    while (!stopped.aborted) {
      try {
        const conn = await accepting.accept();
        backoff = 0;
        spawn(connection(conn, handler, maxHead, maxBody, idle, limits, stopped));
      } catch (e) {
        if (stopped.aborted || (e instanceof IoError && e.code == "EBADF")) {
          break;
        }
        backoff = backoff == 0 ? 5 : backoff >= 500 ? 1000 : backoff * 2;
        await delay(backoff);
      }
    }
  });
  return new HttpServer(listener, stop);
}

/// How long a connection waits for its next request by default (Node's `keepAliveTimeout`).
const IDLE_MS: number = 5000;
/// How long a request's head and body may take by default (Node's `headersTimeout`,
/// `requestTimeout`).
const HEADERS_MS: number = 60000;
const REQUEST_MS: number = 300000;

/// The time limits of a request.
struct Limits {
  headMs: i64;
  requestMs: i64;
  maxHeaders: i64;
}

/// Waits until `conn` may have input: true, or false once `stopped` is aborted or `idle`
/// milliseconds passed (the connection then closes).
async function more(conn: TcpStream, stopped: AbortSignal, idle: i64): Promise<bool> {
  return !stopped.aborted && (await conn.readableWithin(idle as number, stopped));
}

async function connection<E>(
  conn: TcpStream,
  handler: (req: HttpRequest, res: HttpResponse) => Promise<void, E> throws E,
  maxHead: i64,
  maxBody: i64,
  idle: i64,
  limits: Limits,
  stopped: AbortSignal,
): Promise<void> {
  const parser = new Parser(maxHead, maxBody, limits.maxHeaders);
  const req = new HttpRequest(parser, conn, idle, limits.requestMs);
  const res = new HttpResponse(conn, stopped);
  let open = true;
  let rejected = false;
  // When the head being read began to arrive (`Date.now()`), or -1 between requests.
  let headStart: i64 = -1;
  try {
    while (open) {
      const n = parser.readFrom(conn);
      if (n == null) {
        break;
      }
      if (n == 0) {
        // The idle timeout, but no later than the head's deadline.
        let wait = idle;
        if (headStart >= 0) {
          const left = headStart + limits.headMs - Date.now();
          wait = left < wait ? left : wait;
        }
        if (wait <= 0 || !(await more(conn, stopped, wait))) {
          if (headStart >= 0 && Date.now() >= headStart + limits.headMs && !stopped.aborted) {
            res.begin(false, true);
            res.status(408);
            res.send(reason(408));
            await res.flush();
            rejected = true;
          }
          break;
        }
        continue;
      }
      // One clock read per batch: the Date header and the time limits.
      const now = res.tick();
      if (headStart < 0) {
        headStart = now;
      }
      try {
        while (open && parser.next(req.head)) {
          // The next head, if any, starts arriving now.
          headStart = -1;
          req.begin(now);
          res.begin(req.head.keepAlive, req.head.http11, req.isMethod("HEAD"));
          // A body still to come: the responses before it go out first, so a client waiting
          // for them (or for `100 Continue` after them) sends it.
          if (
            res.length > 0 &&
            (req.head.bodyMode == BODY_LENGTH || req.head.bodyMode == BODY_CHUNKED)
          ) {
            await res.flush();
          }
          let failed = false;
          try {
            await handler(req, res);
          } catch (e) {
            failed = true;
            if (req.bodyTooLarge() || req.timedOut() || req.bodyMalformed()) {
              // The client's fault, not the handler's: answered, not logged. The rest of the
              // body cannot be found, so the connection closes after it.
              if (!res.sent()) {
                const code = req.bodyTooLarge() ? 413 : req.timedOut() ? 408 : 400;
                res.closeAfter();
                res.status(code);
                res.send(reason(code));
              }
            } else {
              if (!res.sent()) {
                res.status(500);
                res.send("Internal Server Error");
              }
              console.error("request handler failed:", e);
            }
          }
          if (res.upgraded()) {
            // The connection is the handler's now (also if it failed after switching).
            return;
          }
          if (!res.sent()) {
            res.send("");
          }
          // A streamed body the handler left open is ended; one it failed in cannot be.
          let finished = !(failed && !res.reusable());
          // The usual request has neither: no async step for them.
          if (finished && (res.streamOpen() || !req.bodyRead())) {
            try {
              await res.endStream();
              finished = await req.finish();
            } catch (e) {
              finished = false;
            }
          }
          // A body too large to skip: the client may still be sending it.
          rejected = rejected || !finished;
          open = finished && res.reusable() && !stopped.aborted;
        }
        // Part of the next head is here already: its time runs from now.
        if (headStart < 0 && parser.available() > 0) {
          headStart = now;
        }
      } catch (e) {
        if (e instanceof BadRequest) {
          res.begin(false, true);
          res.status(e.status);
          res.send(reason(e.status));
          rejected = true;
        }
        open = false;
      }
      await res.flush();
    }
    if (rejected) {
      await linger(conn);
    }
  } catch (e) {
    // The client went away.
  }
  // The end of the responses: a TLS connection says so (close_notify), so a client reading to
  // the end does not see it cut short.
  try {
    conn.shutdown();
  } catch (e) {
    // Already gone.
  }
  conn.close();
}

/// The most a rejected request's remaining input is read for, before the connection closes.
const LINGER_BYTES: number = 1048576;
const LINGER_MS: i64 = 2000;

/// After an error response to input that was not read (a head or body too large): ends the
/// sending side and reads what the client still sends (up to `LINGER_BYTES`, for `LINGER_MS`),
/// so closing with unread input does not reset the connection before the client read the
/// response (as nginx's and Kestrel's lingering close).
async function linger(conn: TcpStream) {
  conn.shutdown();
  const until = Date.now() + LINGER_MS;
  let left = LINGER_BYTES;
  const scratch: u8[] = Buffer.alloc(16384);
  while (left > 0 && Date.now() < until) {
    const n = conn.tryRead(scratch);
    if (n == null) {
      return;
    }
    if (n == 0) {
      const wait = until - Date.now();
      if (wait <= 0) {
        return;
      }
      if (!(await conn.readableWithin(wait as number))) {
        return;
      }
      continue;
    }
    left -= n;
  }
}
