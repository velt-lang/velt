// std/http/stream: streamed response bodies, for a handler's `Response` whose body is a
// `BodyStream` (rt_abi_async.md §14.17). Internal to std/http.
//
// `pump` turns a runtime response's body into a stream and starts copying the `BodyStream`
// into it as a promise of the handler's task (a stored promise starts at once and is not
// cancelled when dropped, docs/language.md §8), so it keeps running after the handler returned
// the response: hyper sends the status and headers, then every chunk as the stream yields it.
// `flush` waits while the client is behind (backpressure); once the client has gone away, the
// copy stops and leaves the `for await`, which closes the stream's source (an async generator's
// `finally` blocks run).

import { BodyStream } from "velt:fetch/body";

declare function velt_rt_http_resp_stream_open(r: u64): u64;
declare function velt_rt_http_resp_stream_write_bytes(w: u64, data: u8[]): bool;
declare async function velt_rt_http_resp_stream_flush(w: u64): Promise<bool>;
declare async function velt_rt_http_resp_stream_close(w: u64): Promise<bool>;
declare function velt_rt_http_resp_stream_abort(w: u64);

// Copies `body` into the stream `w` (a runtime writer key) chunk by chunk, then ends it:
// normally when `body` ends, with an abort (the client sees a cut-off response) when reading it
// fails, after printing the error to stderr like a failing handler's.
async function produce(body: BodyStream, w: u64): Promise<void> {
  try {
    for await (const chunk of body) {
      // False once the client has gone away: stop reading the stream.
      if (!velt_rt_http_resp_stream_write_bytes(w, chunk)) {
        break;
      }
      if (!(await velt_rt_http_resp_stream_flush(w))) {
        break;
      }
    }
  } catch (e) {
    console.error("response stream failed:", e);
    velt_rt_http_resp_stream_abort(w);
    return;
  }
  // Releases the writer too (also when the client has gone away).
  await velt_rt_http_resp_stream_close(w);
}

// Makes runtime response `r`'s body a stream and starts copying `body` into it.
export function pump(r: u64, body: BodyStream) {
  const running = produce(body, velt_rt_http_resp_stream_open(r));
}
