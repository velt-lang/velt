// std/http/server/parse: HTTP/1.1 request heads parsed in place (internal to std/http/server).
//
// A connection reads into one buffer of its own (`Parser`); a request's head is ranges of that
// buffer (`Head`), valid until the connection reads the next one, so nothing is copied or
// allocated per request unless the handler asks for a string. The body is not waited for: the
// request's reader (http/server/request.vlt) reads it as the handler asks. The end of a head is
// found 16 bytes at a time (`velt:simd`: lanes equal to LF), and the headers the server acts on
// are recognised by their length and one vector compare, letters folded to lowercase. Every
// header's ranges are kept (four numbers each) for `header(name)`.
//
// The byte strings the parser compares with are made per connection: module-level constants
// that are not literals are module state, behind one process-wide lock (#1487).

import { utf8Encode } from "velt:encoding";
import { TcpStream } from "velt:net";
import { u8x16, mask8x16 } from "velt:simd";

const CR: u8 = 13;
const LF: u8 = 10;
const SP: u8 = 32;
const TAB: u8 = 9;
const COLON: u8 = 58;
/// Room past the data, so a 16-byte load at any byte of it stays inside the buffer.
const SLACK: i64 = 16;
/// The buffer a connection starts with; it grows for a request that does not fit.
const INITIAL: i64 = 16384;
/// Read at least this much at a time.
const MIN_READ: i64 = 4096;

/// Why input is not a request: the status the server answers with before it closes.
export class BadRequest {
  status: number;

  constructor(status: number) {
    this.status = status;
  }
}

/// How a request's body is framed (`Head.bodyMode`).
export const BODY_NONE: i64 = 0;
/// The whole body is in the buffer already: `bodyStart..bodyEnd`.
export const BODY_BUFFERED: i64 = 1;
/// `bodyLength` bytes follow the head, not all read yet.
export const BODY_LENGTH: i64 = 2;
/// `Transfer-Encoding: chunked`.
export const BODY_CHUNKED: i64 = 3;

/// A request's head, parsed in place: ranges of the connection's buffer (`buf`), valid until
/// the connection reads its next request.
export class Head {
  buf: u8[] = [];
  methodStart: i64 = 0;
  methodEnd: i64 = 0;
  targetStart: i64 = 0;
  targetEnd: i64 = 0;
  /// Where the path ends (`?` or the target's end).
  pathEnd: i64 = 0;
  /// The headers, four numbers each: name start, name end, value start, value end.
  heads: i64[] = [];
  /// The connection stays open after the response (HTTP/1.1 unless `Connection: close`).
  keepAlive: bool = true;
  /// `Expect: 100-continue` was sent.
  expectsContinue: bool = false;
  /// HTTP/1.1 (chunked responses can be sent).
  http11: bool = true;
  /// The body's framing (`BODY_*`), its range when buffered, its length when not all read.
  bodyMode: i64 = BODY_NONE;
  bodyStart: i64 = 0;
  bodyEnd: i64 = 0;
  bodyLength: i64 = 0;
}

/// The lowercase name `s` (at most 16 bytes) as a vector, for [`Parser`]'s compares.
function nameVector(s: string): u8x16 {
  const b: u8[] = Buffer.alloc(16);
  b.set(utf8Encode(s), 0);
  return u8x16.load(b, 0);
}

/// A connection's read buffer and the requests in it.
export class Parser {
  buf: u8[] = Buffer.alloc((INITIAL + SLACK) as usize);
  /// The first byte of the next request, and the bytes read.
  pos: i64 = 0;
  end: i64 = 0;
  /// The head's end was searched for up to here.
  private scanned: i64 = 0;
  /// The largest head and body accepted (431 and 413 past them).
  private maxHead: i64;
  private maxBody: i64;
  // The headers the server acts on, lowercase; vectors for one compare each.
  private lf: u8x16 = u8x16.splat(LF);
  private lower: u8x16 = u8x16.splat(32);
  private contentLength: u8x16 = nameVector("content-length");
  private connection: u8x16 = nameVector("connection");
  private transfer: u8x16 = nameVector("transfer-encodin");
  private expect: u8x16 = nameVector("expect");
  private close: u8x16 = nameVector("close");
  private keepAlive: u8x16 = nameVector("keep-alive");
  private continue_: u8x16 = nameVector("100-continue");

  constructor(maxHead: i64, maxBody: i64) {
    this.maxHead = maxHead;
    this.maxBody = maxBody;
  }

  /// Reads what `conn` has into the buffer: the bytes read, 0 when nothing has arrived yet,
  /// null at the end of the stream.
  readFrom(conn: TcpStream): number | null {
    if (this.pos == this.end) {
      this.pos = 0;
      this.end = 0;
      this.scanned = 0;
    }
    if (this.end + MIN_READ + SLACK > (this.buf.length as i64)) {
      this.room(MIN_READ);
    }
    const limit = (this.buf.length as i64) - SLACK;
    const n = conn.tryRead(this.buf, this.end as number, limit as number);
    if (n != null && n > 0) {
      this.end += n as i64;
    }
    return n;
  }

  /// Whether input is left that no request took yet (a pipelined request, or part of one).
  pending(): bool {
    return this.pos < this.end;
  }

  /// Room for `n` more bytes past the data: drops what was parsed, then grows by doubling.
  private room(n: i64) {
    if (this.pos > 0) {
      this.buf.copyWithin(0, this.pos, this.end);
      this.end -= this.pos;
      this.scanned = this.scanned > this.pos ? this.scanned - this.pos : 0;
      this.pos = 0;
    }
    if (this.end + n + SLACK > (this.buf.length as i64)) {
      let size = (this.buf.length as i64) * 2;
      while (size < this.end + n + SLACK) {
        size *= 2;
      }
      const grown: u8[] = Buffer.alloc(size as usize);
      grown.set(this.buf.slice(0, this.end), 0);
      this.buf = grown;
    }
  }

  /// Whether `buf[at..at + len)` is the lowercase name in `want` (letters in any case).
  private nameIs(at: i64, len: i64, want: u8x16): bool {
    const v = u8x16.load(this.buf, at as usize).or(this.lower);
    return v
      .eq(want)
      .or(mask8x16.prefix(len as usize).not())
      .all();
  }

  /// The index past the CR LF CR LF that ends the head starting at `start`, or -1.
  private headEnd(start: i64): i64 {
    const b = this.buf;
    let at = this.scanned > start ? this.scanned : start;
    while (at < this.end) {
      // 16 bytes without an LF are skipped at once.
      if (
        !u8x16
          .load(b, at as usize)
          .eq(this.lf)
          .any()
      ) {
        at += 16;
        continue;
      }
      const stop = at + 16 < this.end ? at + 16 : this.end;
      for (let i = at; i < stop; i++) {
        if (b[i] == LF && i - 3 >= start && b[i - 1] == CR && b[i - 2] == LF && b[i - 3] == CR) {
          return i + 1;
        }
      }
      at = stop;
    }
    // Searched up to the data's end; the last three bytes are searched again with more.
    this.scanned = this.end - 3 > start ? this.end - 3 : start;
    return -1;
  }

  /// The next request's head into `req`: true when there is one, false when more input is
  /// needed. The body is not waited for: a body already read is `BODY_BUFFERED`, else the
  /// request's reader reads it (`BODY_LENGTH`, `BODY_CHUNKED`). Throws `BadRequest` for input
  /// that is not a request.
  next(req: Head): bool {
    // Empty lines before a request are ignored (RFC 9112 §2.2).
    while (this.pos + 1 < this.end && this.buf[this.pos] == CR && this.buf[this.pos + 1] == LF) {
      this.pos += 2;
    }
    const headEnd = this.headEnd(this.pos);
    if (headEnd < 0) {
      if (this.end - this.pos > this.maxHead) {
        throw new BadRequest(431);
      }
      return false;
    }
    if (headEnd - this.pos > this.maxHead) {
      throw new BadRequest(431);
    }
    const b = this.buf;
    // The request line: METHOD SP target SP HTTP/1.x CR LF.
    let p = this.pos;
    req.buf = b;
    req.methodStart = p;
    while (b[p] != SP && b[p] != CR) {
      p++;
    }
    req.methodEnd = p;
    p++;
    req.targetStart = p;
    req.pathEnd = -1;
    while (b[p] != SP && b[p] != CR) {
      if (b[p] == 63 && req.pathEnd < 0) {
        req.pathEnd = p;
      }
      p++;
    }
    req.targetEnd = p;
    if (req.pathEnd < 0) {
      req.pathEnd = p;
    }
    if (req.methodEnd == req.methodStart || req.targetEnd == req.targetStart || b[p] != SP) {
      throw new BadRequest(400);
    }
    p++;
    // HTTP/1.1 keeps the connection open by default, HTTP/1.0 closes it.
    if (b[p] != 72 || b[p + 1] != 84 || b[p + 4] != 47 || b[p + 5] != 49 || b[p + 6] != 46) {
      throw new BadRequest(400);
    }
    req.keepAlive = b[p + 7] == 49;
    req.http11 = req.keepAlive;
    req.expectsContinue = false;
    p += 8;
    if (b[p] != CR || b[p + 1] != LF) {
      throw new BadRequest(400);
    }
    p += 2;
    req.heads.length = 0;
    let length: i64 = 0;
    let chunked = false;
    while (p < headEnd - 2) {
      const nameStart = p;
      while (b[p] != COLON && b[p] != CR) {
        p++;
      }
      // A header line needs a name and a colon; no space before the colon (RFC 9112 §5.1).
      if (b[p] != COLON || p == nameStart || b[p - 1] == SP || b[p - 1] == TAB) {
        throw new BadRequest(400);
      }
      const nameEnd = p;
      p++;
      while (b[p] == SP || b[p] == TAB) {
        p++;
      }
      const valueStart = p;
      while (b[p] != CR) {
        p++;
      }
      let valueEnd = p;
      while (valueEnd > valueStart && (b[valueEnd - 1] == SP || b[valueEnd - 1] == TAB)) {
        valueEnd--;
      }
      if (b[p + 1] != LF) {
        throw new BadRequest(400);
      }
      p += 2;
      req.heads.push(nameStart, nameEnd, valueStart, valueEnd);
      const len = nameEnd - nameStart;
      if (len == 14 && this.nameIs(nameStart, len, this.contentLength)) {
        length = this.number(valueStart, valueEnd, length);
      } else if (len == 10 && this.nameIs(nameStart, len, this.connection)) {
        const vl = valueEnd - valueStart;
        if (vl == 5 && this.nameIs(valueStart, vl, this.close)) {
          req.keepAlive = false;
        } else if (vl == 10 && this.nameIs(valueStart, vl, this.keepAlive)) {
          req.keepAlive = true;
        }
      } else if (
        len == 17 && this.nameIs(nameStart, 16, this.transfer) && (b[nameStart + 16] | 32) == 103
      ) {
        chunked = true;
      } else if (len == 6 && this.nameIs(nameStart, len, this.expect)) {
        const vl = valueEnd - valueStart;
        req.expectsContinue = vl == 12 && this.nameIs(valueStart, vl, this.continue_);
      }
    }
    if (chunked) {
      // RFC 9112 §6.3: chunked wins over Content-Length (which a proxy must not pass on).
      req.bodyMode = BODY_CHUNKED;
      this.pos = headEnd;
    } else if (length == 0) {
      req.bodyMode = BODY_NONE;
      this.pos = headEnd;
    } else if (this.end - headEnd >= length) {
      // Here already: the handler gets it without waiting.
      req.bodyMode = BODY_BUFFERED;
      req.bodyStart = headEnd;
      req.bodyEnd = headEnd + length;
      this.pos = headEnd + length;
    } else {
      req.bodyMode = BODY_LENGTH;
      req.bodyLength = length;
      this.pos = headEnd;
    }
    this.scanned = this.pos;
    return true;
  }

  /// The bytes read and not taken yet.
  available(): i64 {
    return this.end - this.pos;
  }

  /// The next `n` bytes read (`n <= available()`), copied, and taken.
  take(n: i64): u8[] {
    const out = this.buf.slice(this.pos, this.pos + n);
    this.pos += n;
    return out;
  }

  /// Drops the next `n` bytes read (`n <= available()`).
  skip(n: i64) {
    this.pos += n;
  }

  /// The index of the next LF in what was read, or -1.
  lineEnd(): i64 {
    for (let i = this.pos; i < this.end; i++) {
      if (this.buf[i] == LF) {
        return i;
      }
    }
    return -1;
  }

  /// The byte at index `i` of the buffer.
  byteAt(i: i64): u8 {
    return this.buf[i];
  }

  /// The largest body `body()` collects.
  maxBodySize(): i64 {
    return this.maxBody;
  }

  /// A Content-Length value: its digits only, the same as an earlier one if repeated.
  private number(start: i64, end: i64, before: i64): i64 {
    if (start == end) {
      throw new BadRequest(400);
    }
    let n: i64 = 0;
    for (let k = start; k < end; k++) {
      const d = (this.buf[k] as i64) - 48;
      if (d < 0 || d > 9) {
        throw new BadRequest(400);
      }
      if (n > this.maxBody) {
        throw new BadRequest(413);
      }
      n = n * 10 + d;
    }
    if (before != 0 && before != n) {
      throw new BadRequest(400);
    }
    return n;
  }
}
