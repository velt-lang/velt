// std/stdin: reading standard input (rt_abi_async.md §14.4), line by line or all at once, as
// text or bytes. Sync and async reads share one buffered stream; text is UTF-8 (invalid bytes
// become U+FFFD). A line already buffered costs no system call (and no hop to the blocking pool
// for `await readLine()`).

import { IoResult, unwrapIo } from "velt:io";

// The runtime's `LineRead`: a line, and whether input had ended instead.
struct LineRead {
  line: IoResult<string>;
  eof: bool;
}

declare async function velt_rt_stdin_read_line(): Promise<LineRead>;
declare function velt_rt_stdin_read_line_sync(): LineRead;
declare async function velt_rt_stdin_read_all(): Promise<IoResult<string>>;
declare function velt_rt_stdin_read_all_sync(): IoResult<string>;
declare async function velt_rt_stdin_read_all_bytes(): Promise<IoResult<u8[]>>;
declare function velt_rt_stdin_read_all_bytes_sync(): IoResult<u8[]>;

function lineOf(r: LineRead): string | null {
  if (r.eof) {
    return null;
  }
  return unwrapIo(r.line);
}

// The next line without its "\n" / "\r\n", or null at end of input.
export async function readLine(): Promise<string | null> {
  return lineOf(await velt_rt_stdin_read_line());
}

// `readLine` that blocks the calling thread.
export function readLineSync(): string | null {
  return lineOf(velt_rt_stdin_read_line_sync());
}

// Everything left on standard input.
export async function readAll(): Promise<string> {
  return unwrapIo(await velt_rt_stdin_read_all());
}

// `readAll` that blocks the calling thread.
export function readAllSync(): string {
  return unwrapIo(velt_rt_stdin_read_all_sync());
}

// Everything left on standard input, as raw bytes (the runtime's read buffer, not a copy).
export async function readAllBytes(): Promise<u8[]> {
  return unwrapIo(await velt_rt_stdin_read_all_bytes());
}

// `readAllBytes` that blocks the calling thread.
export function readAllBytesSync(): u8[] {
  return unwrapIo(velt_rt_stdin_read_all_bytes_sync());
}
