// velt/encoding (internal): a string's UTF-8 bytes, read in place: their number, one of them, the
// text of a range of them, and whether the string is ASCII.

import { velt_rt_str_byte_slice } from "velt/encoding/rt";
import { strByteAt, strByteLen, strLen } from "velt/lang/intrinsics";

/**
 * The number of bytes `s` keeps its text in: UTF-8, a lone surrogate as its three-byte form
 * (`Buffer.byteLength(s)` for well-formed text). O(1).
 */
export function utf8Length(s: string): usize {
  return strByteLen(s);
}

/** Byte `i` of `s`'s UTF-8 (as `utf8Length` counts them), read in place; a RangeError past it. */
export function utf8ByteAt(s: string, i: usize): u8 {
  if (i >= strByteLen(s)) {
    panic(`RangeError: byte ${i} is past the end of a string of ${strByteLen(s)}`);
  }
  return strByteAt(s, i as u64);
}

/**
 * The text of bytes `start` to `end` of `s`'s UTF-8 (as `utf8ByteAt` numbers them), shared with
 * `s` where `slice` would share it. A RangeError unless `start <= end <= utf8Length(s)` and both
 * are at the start of a character (or the end).
 */
export function utf8Substring(s: string, start: usize, end: usize): string {
  const n = strByteLen(s);
  if (start > end || end > n) {
    panic(`RangeError: bytes ${start} to ${end} are not inside a string of ${n}`);
  }
  if (!charStart(s, start, n) || !charStart(s, end, n)) {
    panic(`RangeError: bytes ${start} to ${end} split a character`);
  }
  return velt_rt_str_byte_slice(s, start as u64, end as u64);
}

// Whether byte `i` of `s` (`n` bytes) starts a character, or is its end.
function charStart(s: string, i: usize, n: usize): bool {
  return i == n || (strByteAt(s, i as u64) & 0xc0) != 0x80;
}

/** Whether every character of `s` is ASCII (so its bytes are its UTF-16 code units). O(1). */
export function isAscii(s: string): bool {
  return strLen(s) == strByteLen(s);
}
