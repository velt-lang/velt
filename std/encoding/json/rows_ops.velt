// velt/encoding/json (internal): the rows side of a `Reader` (reader.velt) over a native driver's
// rows: `RowsOps`, which `readerOverCursor` alone makes, answers each `Reader` method from the
// `RowsReader` (rows_reader.velt) when the reader's failure branch forwards it (rows_side.velt).
//
// A nested value (a JSON column) is read by the `Reader` itself: the first read of one turns it
// into a text reader over the column's JSON text (`rowsNested`), so the value is decoded at the
// text reader's speed, and the next key at depth 0 (the row's next column, the only call that can
// follow the value), which fails on the value's ended text, turns it back (`nestedKey`). A failure
// while it reads the value is reported as the rows reader reports one (`nestedMessage`), and a
// reset to a mark of the rows (tagged `ROWS_MARK`) goes back to the rows.

import { NONE, ROWS, Reader, STEP_MORE, UNKNOWN } from "velt/encoding/json/reader";
import {
  readerReadBool,
  readerReadI64,
  readerReadU64,
  shortPath,
} from "velt/encoding/json/reader_ops";
import { AT_VAL, RowsReader } from "velt/encoding/json/rows_reader";
import { ROWS_MARK, RowsSide } from "velt/encoding/json/rows_side";
import { CELL_JSON } from "velt/encoding/json/rows_cells";
import { OK } from "velt/encoding/json/scan";
import { strByteLen } from "velt/lang/intrinsics";
import {
  rowsReadBool,
  rowsReadF64,
  rowsReadI64,
  rowsReadNull,
  rowsReadString,
  rowsSkipUnknownValue,
  rowsSkipValue,
} from "velt/encoding/json/rows_reads";

/**
 * A reader over the rows of the native driver's row cursor at address `cursor` (velt/db's
 * `decodeRows`), with `FLAG_*` options: its `close` ends the rows state (the cursor stays the
 * driver's). velt/db hands it to the generated `parseJsonCursor`, so only a program that decodes
 * rows loads this module.
 */
export function readerOverCursor(cursor: u64, flags: u32, maxDepth: u32): Reader {
  const r = Reader.of("", flags, maxDepth);
  r.rows = new RowsOps(cursor, flags);
  r.failed = ROWS;
  return r;
}

/** The rows side of a `Reader` over a driver's rows (`Reader.overCursor`): the rows reader. */
export class RowsOps implements RowsSide {
  rows: RowsReader;

  /** The rows of the driver's cursor at address `cursor`, with `Reader` flags. */
  constructor(cursor: u64, flags: u32) {
    this.rows = new RowsReader(cursor, flags);
  }

  /** Ends the rows state over the cursor (the cursor stays the driver's). */
  close(): void {
    this.rows.close();
  }

  // Whether the rows reader of `r` is at a nested value (a JSON column), which it then starts
  // reading as text: `r` becomes a text reader over the column's JSON text.
  private enteredNested(r: Reader): bool {
    const rows = this.rows;
    if (rows.at != AT_VAL || rows.kind != CELL_JSON || rows.error != NONE) {
      return false;
    }
    rows.cells.jsonAt(rows.col);
    const src = rows.cells.text;
    r.src = src;
    r.len = strByteLen(src);
    r.pos = 0;
    r.code = OK;
    r.at = 0;
    r.depth = 0;
    r.afterOpen = false;
    r.ends = null;
    r.failed = NONE;
    r.rowsNested = true;
    return true;
  }

  // `r` back to reading the rows, past the nested value it read.
  private leftNested(r: Reader): void {
    r.failed = ROWS;
    r.rowsNested = false;
    this.rows.advance();
  }

  peek(r: Reader): u32 {
    return this.enteredNested(r) ? r.peek() : this.rows.peek();
  }

  /** Consumes `{` (123) or `[` (91). */
  open(r: Reader, bracket: u8): bool {
    if (this.enteredNested(r)) {
      return bracket == 123 ? r.openObject() : r.openArray();
    }
    return this.rows.open(bracket);
  }

  arrayNext(r: Reader): u8 {
    return this.rows.arrayNext();
  }

  /** The next key: a column's name, which counts as escaped (`keyDecoded`). */
  nextKey(r: Reader): u8 {
    const rows = this.rows;
    const step = rows.nextKey();
    const key = step == STEP_MORE ? rows.text : "";
    r.keyLen = strByteLen(key);
    r.keyEscaped = true;
    r.keyDecoded = key;
    return step;
  }

  /**
   * The row's next column, back on the rows, after `r` read a nested value: `Reader.nextKey` calls
   * this when it finds the value's text ended at depth 0, on its failure branch (so it costs a text
   * reader nothing).
   */
  nestedKey(r: Reader): u8 {
    this.leftNested(r);
    return this.nextKey(r);
  }

  /** A string value: `r.decoded` after true (counted as escaped). */
  readString(r: Reader): bool {
    if (this.enteredNested(r)) {
      return r.readString();
    }
    const rows = this.rows;
    const ok = rowsReadString(rows);
    r.escaped = true;
    r.decoded = ok ? rows.text : "";
    return ok;
  }

  /** A number value: `r.num` after true. */
  readF64(r: Reader): bool {
    if (this.enteredNested(r)) {
      return r.readF64();
    }
    const rows = this.rows;
    const ok = rowsReadF64(rows);
    r.num = rows.num;
    return ok;
  }

  /**
   * An integer: `r.int` after true. `unsigned`: one in `u64`'s range (a driver's rows give `i64`s,
   * so there one at least 0).
   */
  readI64(r: Reader, unsigned: bool): bool {
    if (this.enteredNested(r)) {
      return unsigned ? readerReadU64(r) : readerReadI64(r);
    }
    const rows = this.rows;
    const ok = rowsReadI64(rows) && (!unsigned || rows.int >= 0);
    r.int = rows.int;
    return ok;
  }

  /** `true` or `false`: `r.int` is 1 or 0 after true. */
  readBool(r: Reader): bool {
    if (this.enteredNested(r)) {
      return readerReadBool(r);
    }
    const rows = this.rows;
    const ok = rowsReadBool(rows);
    r.int = rows.flag ? 1 : 0;
    return ok;
  }

  readNull(r: Reader): bool {
    return this.enteredNested(r) ? r.readNull() : rowsReadNull(this.rows);
  }

  skip(r: Reader): bool {
    return rowsSkipValue(this.rows);
  }

  skipUnknown(r: Reader): bool {
    return rowsSkipUnknownValue(this.rows);
  }

  mark(r: Reader): u64 {
    return this.rows.mark() | ROWS_MARK;
  }

  /** Goes back to a mark of the rows, also from inside a nested value. */
  reset(r: Reader, mark: u64): void {
    r.failed = ROWS;
    r.rowsNested = false;
    this.rows.reset(mark & ~ROWS_MARK);
  }

  end(r: Reader): bool {
    return this.rows.end();
  }

  /** One value read whole: its JSON text in `r.rowsText` (`r.rowsValue`: it read). */
  value(r: Reader): void {
    const rows = this.rows;
    r.rowsValue = rows.value();
    r.rowsText = r.rowsValue ? rows.text : "";
  }

  message(r: Reader, expected: string, path: string): string {
    return this.rows.message(expected, path);
  }

  /**
   * The message of a failure while `r` read a nested value, as the rows reader gives one: a
   * rejected unknown key, or else a value of another kind (also for text that does not read).
   */
  nestedMessage(r: Reader, expected: string, path: string): string {
    if (r.failed == UNKNOWN) {
      return `unknown field at ${shortPath(path)}`;
    }
    return `expected ${expected} at ${shortPath(path)}`;
  }
}
