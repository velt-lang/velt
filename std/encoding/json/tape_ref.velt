// velt/encoding/json (internal): a task's handle to a frozen tape (#3098): what a parsed
// `JsonValue` holds. The tape is a `shared<Tape>` (tape.velt: frozen once parsed), so the values of
// one document on different tasks read the same tape. A `TapeRef` belongs to one task: the values
// a task takes from a document (`get`, `at`, `clone`) share its `TapeRef` with plain counts, and
// only a value crossing to another task copies it, which takes one more reference to the tape
// (atomic), released when the copy goes.
//
// Reads never touch the tape's count. A `shared` handle read from a field is retained for the
// statement (another owner of the object could replace it meanwhile), so each method here hands
// `this.tape` (or its arrays) straight to a reader of tape.velt, as an argument (`tape` is written
// only by the constructor, so passing it takes no reference), which reads its parameter in place.
// The readers every value read goes through take only the arrays, which makes them quiet: a call
// that lends a place reached through `this` to any other function retains `this` for the call.
//
// The hash index of the wide objects (over `INDEX_THRESHOLD` keys) a task searched is the
// `TapeRef`'s: at most one map per such object of the tape, each with one entry per key, so it
// never outgrows the document. It goes with the `TapeRef`, when the last of the task's values on
// that document goes, and holds nothing of the tape (key texts and positions): it never keeps a
// tape alive. A copy for another task takes the index made so far with it.

import {
  FIND_OTHER,
  FIND_WIDE,
  Tape,
  childIn,
  countIn,
  findIn,
  findOther,
  memberIn,
  tapeKey,
  tapeText,
  wordKind,
  wordNumber,
  wordRawCount,
  wordUnits,
} from "velt/encoding/json/tape";
import { tapeStringify, writeTape } from "velt/encoding/json/tape_write";
import { inline, noInline } from "velt/lang/intrinsics";

/** One task's reference to a frozen tape, with that task's hash index of its wide objects. */
export class TapeRef {
  tape: shared<Tape>;
  /** Object position to its key texts' value positions (a repeated key's last); made on first use. */
  index: TapeIndex | null = null;

  constructor(tape: shared<Tape>) {
    this.tape = tape;
  }

  @inline
  kind(v: u32): u64 {
    return wordKind(this.tape.words, v);
  }

  @inline
  number(v: u32): f64 {
    return wordNumber(this.tape.words, v);
  }

  @inline
  text(v: u32): string {
    return tapeText(this.tape, v);
  }

  @inline
  units(v: u32): i64 {
    return wordUnits(this.tape.words, v);
  }

  count(v: u32): i64 {
    return countIn(this.tape.words, this.tape.kids, v);
  }

  member(v: u32, i: i64): i64 {
    return memberIn(this.tape.words, this.tape.kids, v, i);
  }

  /** Element `i` of array `v`, or the value of member `i` of object `v`; -1 if there is none. */
  @inline
  child(v: u32, i: i64): i64 {
    return childIn(this.tape.words, this.tape.kids, v, i);
  }

  /** Appends value `v` as `JSON.stringify` writes it to the builder `out`. */
  write(out: string, v: u32): void {
    writeTape(this.tape, out, v);
  }

  /** Value `v`'s JSON text. */
  stringify(v: u32): string {
    return tapeStringify(this.tape, v);
  }

  /** Object `v`'s value for `name` (the last, if repeated), or -1 (also when `v` is no object). */
  @inline
  find(v: u32, name: string): i64 {
    const at = findIn(this.tape.words, this.tape.kids, this.tape.src, v, name);
    return at == FIND_OTHER ? this.findSlow(v, name) : at;
  }

  // `find` where `findIn` can't answer: a key repeated or with escapes, a long name, or an object
  // over `INDEX_THRESHOLD` keys, which goes through its hash index (made the first time).
  @noInline
  private findSlow(v: u32, name: string): i64 {
    const other = findOther(this.tape, v, name);
    if (other != FIND_WIDE) {
      return other;
    }
    let all = this.index;
    if (all == null) {
      all = new TapeIndex();
      this.index = all;
    }
    let ix = all.maps.get(v);
    if (ix == undefined) {
      const m = keyIndex(this.tape, v);
      all.maps.set(v, m);
      ix = m;
    }
    const at = ix.get(name);
    return at == undefined ? -1 : at as i64;
  }
}

// Object `v`'s key texts to their value positions, in order, so a repeated key ends at its last.
function keyIndex(t: shared<Tape>, v: u32): Map<string, u32> {
  const m = new Map<string, u32>();
  const n = wordRawCount(t.words, v) as usize;
  for (let i: usize = 0; i < n; i++) {
    const k = tapeKey(t, v, i);
    m.set(tapeText(t, k), k + 1);
  }
  return m;
}

// The hash indexes of a `TapeRef`: object position to its key texts' value positions.
class TapeIndex {
  maps: Map<u32, Map<string, u32>> = new Map<u32, Map<string, u32>>();
}
