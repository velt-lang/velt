// velt/encoding/json (internal): what `JsonValue` (std/prelude/json/json_value.velt) does through its
// public methods: decoding one with a reader, deep equality, making one, and walking one with a
// replacer or reviver (how deep that walk may go).

import { Reader } from "velt/encoding/json/reader";
import { parseTape, parseWith } from "velt/encoding/json/tape_parse";
import { Tape } from "velt/encoding/json/tape";
import { TapeError } from "velt/encoding/json/tape_error";
import { JSON } from "velt/prelude/json/json";
import { JsonValue } from "velt/prelude/json/json_value";
import { JsonReplacer } from "velt/prelude/json/layout";
import { readerValueLimit } from "velt/encoding/json/reader_ops";

declare function velt_rt_json_value_new_null(): u64;
declare function velt_rt_json_value_new_bool(b: bool): u64;
declare function velt_rt_json_value_new_number(n: f64): u64;
declare function velt_rt_json_value_new_string(s: string): u64;

/**
 * Reads one value with `r` (`JsonValue[JSON_FROM_READER]`: the decoders velt/encoding/json
 * generates call it, as the compiler's glue does): null when the reader failed.
 */
export function jsonValueFromReader(r: Reader): JsonValue | null {
  const limit = readerValueLimit(r);
  if (limit >= 0) {
    const t = parseWith(r, limit as u32, false);
    if (t instanceof TapeError) {
      r.valueFailed();
      return null;
    }
    return JsonValue.onTape(t as Tape, 0);
  }
  if (r.rowsValue) {
    return new JsonValue(r.lastHandle());
  }
  return null;
}

/**
 * `a` equal to `b` by its JSON content, as `util.isDeepStrictEqual` (`deepEqual`) and `toEqual`
 * compare the values `JSON.parse` makes in Node: an object's members in any order, numbers with
 * SameValueZero (`deep`: `Object.is`). The code velt/lang/equal generates calls it (through
 * `JsonValue`'s private `deepEquals`).
 */
export function jsonValueEquals(a: JsonValue, b: JsonValue, deep: bool): bool {
  if (a.isNull() || b.isNull()) {
    return a.isNull() && b.isNull();
  }
  if (a.isBool() || b.isBool()) {
    return a.asBool() == b.asBool();
  }
  if (a.isNumber() || b.isNumber()) {
    const x = a.asNumber();
    const y = b.asNumber();
    if (x == null || y == null) {
      return false;
    }
    return deep ? Object.is(x, y) : x == y || (x != x && y != y);
  }
  if (a.isString() || b.isString()) {
    return a.asString() == b.asString();
  }
  const n = a.len();
  if (a.isArray() != b.isArray() || n != b.len()) {
    return false;
  }
  if (a.isArray()) {
    for (let i: i64 = 0; i < n; i++) {
      const x = a.at(i);
      const y = b.at(i);
      if (x == null || y == null || !jsonValueEquals(x, y, deep)) {
        return false;
      }
    }
    return true;
  }
  for (const k of a.keys()) {
    const x = a.get(k);
    const y = b.get(k);
    if (x == null || y == null || !jsonValueEquals(x, y, deep)) {
      return false;
    }
  }
  return true;
}

/** `JsonValue.of(x)`: a string, number, boolean or null as a value. */
export function jsonValueOf(x: string | f64 | bool | null): JsonValue {
  if (x == null) {
    return new JsonValue(velt_rt_json_value_new_null());
  }
  if (typeof x === "string") {
    return new JsonValue(velt_rt_json_value_new_string(x));
  }
  if (typeof x === "number") {
    return new JsonValue(velt_rt_json_value_new_number(x));
  }
  return new JsonValue(velt_rt_json_value_new_bool(x));
}

/** `JsonValue.from(x)`: the JSON form of any value `JSON.stringify` accepts. */
export function jsonValueFrom<T>(x: T): JsonValue {
  const r = parseTape(JSON.stringify(x), 0);
  if (r instanceof TapeError) {
    panic(`JsonValue.from: ${r.message}`);
  }
  return JsonValue.onTape(r as Tape, 0);
}

/** `value.revive(reviver)` (see `JsonValue.revive`). */
export function jsonValueRevived(value: JsonValue, reviver: JsonReplacer): JsonValue {
  const out = jsonRevived("", value, reviver, 0);
  if (out == undefined) {
    throw new TypeError(
      "JsonValue.revive: the reviver returned undefined for the value itself (JSON.parse would return undefined; a JsonValue can't be undefined)",
    );
  }
  return out;
}

/**
 * How deep a replacer or reviver walks before a `RangeError`, as Node runs out of stack: each
 * level is a native call of these functions, so a deeper value (the parser allows any depth
 * with `maxDepth`) would overflow the native stack instead.
 */
export const JSON_CALLBACK_DEPTH: i64 = 4096;

export function jsonCallbackTooDeep(): RangeError {
  return new RangeError(
    `Maximum call stack size exceeded (a JSON replacer or reviver over values nested deeper than ${JSON_CALLBACK_DEPTH})`,
  );
}

/** `value.revive(reviver)`: its members revived first (in place of the value's own), then it. */
export function jsonRevived(
  key: string,
  value: JsonValue,
  reviver: JsonReplacer,
  depth: i64,
): JsonValue | undefined {
  if (depth > JSON_CALLBACK_DEPTH) {
    throw jsonCallbackTooDeep();
  }
  if (value.isArray()) {
    const out = JsonValue.array();
    const n = value.len();
    for (let i: i64 = 0; i < n; i++) {
      const e = jsonRevived(String(i), value.at(i)!, reviver, depth + 1);
      out.push(e ?? JsonValue.of(null));
    }
    return reviver(key, out);
  }
  if (value.isObject()) {
    const out = JsonValue.object();
    for (const k of value.keys()) {
      const e = jsonRevived(k, value.get(k)!, reviver, depth + 1);
      if (e != undefined) {
        out.set(k, e);
      }
    }
    return reviver(key, out);
  }
  return reviver(key, value);
}
