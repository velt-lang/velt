// velt/encoding/json (internal): a tree (tree.velt) from a tape value, and a tree's JSON text.
// Both walk iteratively, with the open containers on a stack of their own, so a value nested as
// deeply as the parser allowed never runs out of native stack.

import {
  JsonTree,
  TREE_ARRAY,
  TREE_BOOL,
  TREE_NULL,
  TREE_NUMBER,
  TREE_OBJECT,
  TREE_STRING,
} from "velt/encoding/json/tree";
import { T_ARRAY, T_FALSE, T_NULL, T_NUMBER, T_OBJECT, T_STRING, T_TRUE } from "velt/encoding/json/tape";
import { TapeRef } from "velt/encoding/json/tape_ref";
import { writeString } from "velt/encoding/json/writer";
import { writeF64 } from "velt/encoding/json/writer_number";

declare function velt_rt_strbuf_push_str(buf: string, s: string);
declare function velt_rt_strbuf_new(cap: u64, out: string);
declare function velt_rt_strbuf_finish(buf: string, out: string);

/** A tree of value `node` of tape `t` (what an edit of a parsed value starts from). */
export function treeOfTape(t: TapeRef, node: u32): JsonTree {
  const root = treeNode(t, node);
  // The containers being filled: their tape values and trees, and the next member's index.
  const values: u32[] = [];
  const trees: JsonTree[] = [];
  const next: i64[] = [];
  if (root.kind == TREE_ARRAY || root.kind == TREE_OBJECT) {
    values.push(node);
    trees.push(root);
    next.push(0);
  }
  while (values.length > 0) {
    const top = values.length - 1;
    const v = values[top];
    const i = next[top];
    if (i >= t.count(v)) {
      values.pop();
      trees.pop();
      next.pop();
      continue;
    }
    next[top] = i + 1;
    const parent = trees[top];
    let child: u32 = 0;
    if (parent.kind == TREE_ARRAY) {
      child = t.child(v, i) as u32;
      const c = treeNode(t, child);
      parent.items.push(c);
      openIfContainer(c, child, values, trees, next);
    } else {
      const k = t.member(v, i) as u32;
      child = k + 1;
      const c = treeNode(t, child);
      parent.obj!.insert(t.text(k), c);
      openIfContainer(c, child, values, trees, next);
    }
  }
  return root;
}

function openIfContainer(c: JsonTree, v: u32, values: u32[], trees: JsonTree[], next: i64[]): void {
  if (c.kind == TREE_ARRAY || c.kind == TREE_OBJECT) {
    values.push(v);
    trees.push(c);
    next.push(0);
  }
}

// The node of tape value `v` (a container comes empty).
function treeNode(t: TapeRef, v: u32): JsonTree {
  const k = t.kind(v);
  if (k == T_NULL) {
    return new JsonTree(TREE_NULL);
  }
  if (k == T_TRUE || k == T_FALSE) {
    return JsonTree.scalar(TREE_BOOL, k == T_TRUE ? 1 : 0);
  }
  if (k == T_NUMBER) {
    return JsonTree.scalar(TREE_NUMBER, t.number(v));
  }
  if (k == T_STRING) {
    return JsonTree.string(t.text(v));
  }
  if (k == T_ARRAY) {
    return new JsonTree(TREE_ARRAY);
  }
  return JsonTree.object();
}

/** `JSON.stringify` of a tree. */
export function treeStringify(tree: JsonTree): string {
  let buf = "";
  velt_rt_strbuf_new(64, buf);
  writeTree(buf, tree);
  let out = "";
  velt_rt_strbuf_finish(buf, out);
  return out;
}

/**
 * Appends a tree as `JSON.stringify` writes it to the builder `out` (members in order, numbers
 * JS-formatted, non-finite ones `null`).
 */
export function writeTree(out: string, tree: JsonTree): void {
  // The containers being written, and the next member (an object's: its raw position).
  const open: JsonTree[] = [];
  const next: usize[] = [];
  let pending: JsonTree | null = tree;
  while (true) {
    const v = pending;
    if (v != null) {
      pending = null;
      if (v.kind == TREE_ARRAY) {
        velt_rt_strbuf_push_str(out, "[");
        open.push(v);
        next.push(0);
      } else if (v.kind == TREE_OBJECT) {
        velt_rt_strbuf_push_str(out, "{");
        open.push(v);
        next.push(v.obj!.nextRaw(0));
      } else {
        writeScalar(out, v);
      }
    }
    if (open.length == 0) {
      return;
    }
    const top = open.length - 1;
    const c = open[top];
    const i = next[top];
    if (c.kind == TREE_ARRAY) {
      if (i >= c.items.length) {
        velt_rt_strbuf_push_str(out, "]");
        open.pop();
        next.pop();
        continue;
      }
      if (i > 0) {
        velt_rt_strbuf_push_str(out, ",");
      }
      next[top] = i + 1;
      pending = c.items[i];
      continue;
    }
    const o = c.obj!;
    if (i >= o.rawEnd()) {
      velt_rt_strbuf_push_str(out, "}");
      open.pop();
      next.pop();
      continue;
    }
    if (i > o.nextRaw(0)) {
      velt_rt_strbuf_push_str(out, ",");
    }
    next[top] = o.nextRaw(i + 1);
    const key = o.keyRaw(i);
    writeString(out, key);
    velt_rt_strbuf_push_str(out, ":");
    pending = o.valueRaw(i);
  }
}

// A null, boolean, number or string.
function writeScalar(out: string, v: JsonTree): void {
  if (v.kind == TREE_NULL) {
    velt_rt_strbuf_push_str(out, "null");
  } else if (v.kind == TREE_BOOL) {
    velt_rt_strbuf_push_str(out, v.num != 0 ? "true" : "false");
  } else if (v.kind == TREE_NUMBER) {
    writeF64(out, v.num);
  } else {
    writeString(out, v.text);
  }
}
