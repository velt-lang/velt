// velt/encoding/json (internal): what each `toJSON(key)` returned while a replacer's result was
// written (any.velt `writeJsonResult`), for the walk of that result through itself
// (any_replace.velt `replaceJsonResult`, when it holds a cycle): the walk takes them instead of
// calling them again, so each runs once, as in Node. The walk meets the members in the order they
// were written, leaving out the ones the replacer drops or replaces, so it reads them in order.

/** The `toJSON` results of one written replacer result, in the order they ran. */
export class JsonHookResults {
  // Made at the first `add`: most results have no `toJSON` in them.
  private ids: u64[] | null = null;
  private keys: string[] | null = null;
  private results: any[] | null = null;
  private next: i64 = 0;

  /** The value with identity `id` returned `result` from its `toJSON(key)`. */
  add(id: u64, key: string, result: any): void {
    if (this.ids == null) {
      this.ids = [id];
      this.keys = [key];
      this.results = [result];
      return;
    }
    this.ids!.push(id);
    this.keys!.push(key);
    this.results!.push(result);
  }

  /**
   * The position of what the value with identity `id` returned from its `toJSON(key)`, at or
   * after the last one taken (`result`), or -1 when it didn't run while the result was written.
   */
  find(id: u64, key: string): i64 {
    if (this.ids == null) {
      return -1;
    }
    const n = this.ids!.length as i64;
    for (let i = this.next; i < n; i++) {
      if (this.ids![i] == id && this.keys![i] == key) {
        this.next = i + 1;
        return i;
      }
    }
    return -1;
  }

  /** What the `toJSON` at position `i` (`find`) returned. */
  result(i: i64): any {
    return this.results![i];
  }
}
