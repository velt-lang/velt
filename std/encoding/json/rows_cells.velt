// velt/encoding/json (internal): the cells of a native driver's rows, as `RowsReader`
// (rows_reader.velt) reads them: from the driver's live row cursor, through velt/db's rows
// state (velt/db/rt.velt), or, once a decoder may read the rows again, from the rows left copied
// into Velt cells (a cursor cannot step back).
//
// The header (`single`, the column names) is the cursor's, in `velt_text::rows`' layout:
// `single: u8, columns: u16, (name_len: u32, name bytes)*`, little-endian, bit 31 of a length
// saying the name is ASCII.

import {
  velt_rt_rows_begin_named,
  velt_rt_rows_blob,
  velt_rt_rows_end,
  velt_rt_rows_kind,
  velt_rt_rows_next,
  velt_rt_rows_str,
} from "velt/db/rt";
import { utf8DecodeLossy } from "velt/encoding";

declare function velt_rt_rows_header(st: u64): u8[];
declare function velt_rt_rows_json(st: u64, col: u64, out: string): u8;
declare function velt_rt_rows_i64(st: u64, col: u64, out: CellI64): u8;
declare function velt_rt_rows_f64(st: u64, col: u64, out: CellF64): u8;
declare function velt_rt_rows_bool(st: u64, col: u64, out: CellU8): u8;

/** Cell kinds, numbered as `velt_rt_rows_kind` numbers them (velt/db's `CellKind`). */
export const CELL_NULL: u8 = 0;
export const CELL_BOOL: u8 = 1;
export const CELL_INT: u8 = 2;
export const CELL_FLOAT: u8 = 3;
export const CELL_TEXT: u8 = 4;
export const CELL_BLOB: u8 = 5;
export const CELL_JSON: u8 = 6;
/** No cell: past the rows a copy holds. */
export const CELL_NONE: u8 = 255;

/** A typed read of a cell: written (`OK`), null, or of another kind (velt_rt db_rows.rs). */
const OK: u8 = 1;

/** 2^63 as a float: integral floats in `[-2^63, 2^63)` are exact `i64`s. */
const I64_LIMIT: f64 = 9223372036854775808.0;

/** The rows of a driver's cursor, cell by cell. */
export class RowCells {
  /** The rows state over the cursor (0 once ended). */
  st: u64;
  single: bool = false;
  names: string[] = [];
  /** The rows copied out of the cursor (`copy`), cell after cell; null while it is read live. */
  copied: Cell[] | null = null;
  /** Live: whether the cursor is on a row not read yet: 1 yes, 0 no, -1 not asked since. */
  onRow: i32 = -1;
  /** Copied: the current row, and how many rows the copy holds. */
  row: usize = 0;
  rows: usize = 0;
  /** What the last `i64`, `f64` and `text` read. */
  int: i64 = 0;
  num: f64 = 0;
  text: string = "";

  /** The cells of the driver's cursor at address `cursor` (which the caller keeps until `end`). */
  constructor(cursor: u64) {
    this.st = velt_rt_rows_begin_named(cursor, "");
    const h = velt_rt_rows_header(this.st);
    // A header that does not read whole has no columns.
    if (h.length < 3) {
      return;
    }
    const count = (h[1] as usize) | ((h[2] as usize) << 8);
    const names: string[] = [];
    let at: usize = 3;
    for (let i: usize = 0; i < count; i++) {
      if (at + 4 > h.length) {
        return;
      }
      const raw =
        (h[at] as u32) |
        ((h[at + 1] as u32) << 8) |
        ((h[at + 2] as u32) << 16) |
        ((h[at + 3] as u32) << 24);
      const len = (raw & 0x7fffffff) as usize;
      if (at + 4 + len > h.length) {
        return;
      }
      names.push(utf8DecodeLossy(h.slice((at + 4) as i64, (at + 4 + len) as i64)));
      at += 4 + len;
    }
    this.single = h[0] != 0;
    this.names = names;
  }

  /** Ends the rows state (the cursor stays the driver's). */
  end(): void {
    if (this.st != 0) {
      velt_rt_rows_end(this.st);
      this.st = 0;
    }
  }

  columns(): usize {
    return this.names.length;
  }

  /** Whether another row follows (a live cursor steps to it, once). */
  rowAhead(): bool {
    if (this.copied != null) {
      return this.row < this.rows;
    }
    if (this.onRow < 0) {
      this.onRow = velt_rt_rows_next(this.st) != 0 ? 1 : 0;
    }
    return this.onRow == 1;
  }

  /** The row was read or skipped: a live cursor steps again when asked for the next. */
  rowDone(): void {
    if (this.copied != null) {
      this.row++;
    } else {
      this.onRow = -1;
    }
  }

  /** The kind of cell `col` of the current row (`CELL_*`; `CELL_NONE` past a copy's rows). */
  kind(col: usize): u8 {
    const c = this.copied;
    if (c != null) {
      return this.row < this.rows ? c[this.row * this.names.length + col].kind : CELL_NONE;
    }
    return velt_rt_rows_kind(this.st, col as u64);
  }

  /** A boolean cell's value. */
  bool(col: usize): bool {
    const c = this.copied;
    if (c != null) {
      return c[this.row * this.names.length + col].int != 0;
    }
    let out: CellU8 = { v: 0 };
    velt_rt_rows_bool(this.st, col as u64, out);
    return out.v != 0;
  }

  /** An integer cell, or a float one that is an integer exactly: `int` after true. */
  i64(col: usize): bool {
    const c = this.copied;
    if (c != null) {
      const cell = c[this.row * this.names.length + col];
      if (cell.kind == CELL_INT) {
        this.int = cell.int;
        return true;
      }
      const v = cell.num;
      if (cell.kind == CELL_FLOAT && v == Math.trunc(v) && v >= -I64_LIMIT && v < I64_LIMIT) {
        this.int = v as i64;
        return true;
      }
      return false;
    }
    let out: CellI64 = { v: 0 };
    const ok = velt_rt_rows_i64(this.st, col as u64, out) == OK;
    this.int = out.v;
    return ok;
  }

  /** A number cell: `num` after true. */
  f64(col: usize): bool {
    const c = this.copied;
    if (c != null) {
      const cell = c[this.row * this.names.length + col];
      if (cell.kind == CELL_INT) {
        this.num = cell.int as f64;
        return true;
      }
      this.num = cell.num;
      return cell.kind == CELL_FLOAT;
    }
    let out: CellF64 = { v: 0 };
    const ok = velt_rt_rows_f64(this.st, col as u64, out) == OK;
    this.num = out.v;
    return ok;
  }

  /** A text cell (`CELL_TEXT`; text that is not UTF-8 has U+FFFD): `text` after true. */
  textAt(col: usize): bool {
    const c = this.copied;
    if (c != null) {
      const cell = c[this.row * this.names.length + col];
      this.text = cell.text;
      return cell.kind == CELL_TEXT;
    }
    let out = "";
    const ok = velt_rt_rows_str(this.st, col as u64, out) == OK;
    this.text = out;
    return ok;
  }

  /** A nested value's JSON text (`CELL_JSON`): `text` after true. */
  jsonAt(col: usize): bool {
    const c = this.copied;
    if (c != null) {
      const cell = c[this.row * this.names.length + col];
      this.text = cell.text;
      return cell.kind == CELL_JSON;
    }
    let out = "";
    const ok = velt_rt_rows_json(this.st, col as u64, out) == OK;
    this.text = out;
    return ok;
  }

  /** A blob cell's bytes (empty for any other kind). */
  blob(col: usize): u8[] {
    const c = this.copied;
    if (c != null) {
      return c[this.row * this.names.length + col].bytes;
    }
    return velt_rt_rows_blob(this.st, col as u64);
  }

  /**
   * Copies the rows the live cursor has left and goes on over the copy (`onRow`, when known,
   * says whether the cursor is on a row already): a decoder that may read the rows again (a
   * union of whole results) reads the copy.
   */
  copy(): void {
    if (this.copied != null) {
      return;
    }
    const cells: Cell[] = [];
    const n = this.names.length;
    let on = this.onRow >= 0 ? this.onRow == 1 : velt_rt_rows_next(this.st) != 0;
    let rows: usize = 0;
    while (on) {
      for (let col: usize = 0; col < n; col++) {
        cells.push(this.cellAt(col));
      }
      rows++;
      on = !this.single && velt_rt_rows_next(this.st) != 0;
    }
    this.copied = cells;
    this.rows = rows;
    this.row = 0;
    this.onRow = -1;
  }

  // Cell `col` of the cursor's current row, copied.
  private cellAt(col: usize): Cell {
    const cell = new Cell(velt_rt_rows_kind(this.st, col as u64));
    if (cell.kind == CELL_BOOL) {
      cell.int = this.bool(col) ? 1 : 0;
    } else if (cell.kind == CELL_INT) {
      this.i64(col);
      cell.int = this.int;
    } else if (cell.kind == CELL_FLOAT) {
      this.f64(col);
      cell.num = this.num;
    } else if (cell.kind == CELL_TEXT) {
      this.textAt(col);
      cell.text = this.text;
    } else if (cell.kind == CELL_JSON) {
      this.jsonAt(col);
      cell.text = this.text;
    } else if (cell.kind == CELL_BLOB) {
      cell.bytes = velt_rt_rows_blob(this.st, col as u64);
    }
    return cell;
  }
}

/** A copied cell: its kind and value. */
class Cell {
  kind: u8;
  int: i64 = 0;
  num: f64 = 0;
  text: string = "";
  bytes: u8[] = [];

  constructor(kind: u8) {
    this.kind = kind;
  }
}

struct CellI64 {
  v: i64;
}

struct CellF64 {
  v: f64;
}

struct CellU8 {
  v: u8;
}
