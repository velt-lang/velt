// velt/encoding/json (internal): a parsed JSON document as one flat tape (#1660, part of #1655):
// what a `JsonValue` from `JSON.parseValue` reads. No allocation per value: two words per value in
// one array, numbers decoded once, strings left in the source until a reader asks for one (only
// strings with escapes are decoded while parsing), and each array's elements and each object's keys
// listed together in one array of positions, so `at(i)` is O(1).
//
// Frozen once parsed (#3098): the parser fills a `TapeBuilder` (tape_builder.velt: the words, the
// kids, `decoded`) on its own task, and only then makes the `Tape`, a struct (its fields
// never change), which `JsonValue` puts in a `shared(...)`: the box holds the struct itself, so a
// read reaches the arrays with one pointer step fewer than through an object. From then on every
// task reads it through that `shared<Tape>` (tape_ref.velt), with no writes and no count changes
// (sema refuses writes through a shared value; lowering reads it frozen), so the values of a
// document sent to other tasks share one tape instead of copying it. Anything a reader would add
// later belongs to the task, not the tape: the hash index of a wide object lives in the task's
// `TapeRef`. Editing a value (`set`, `push`, …) turns that value into the runtime's tree (prelude
// `JsonValue`), so it never shows through the tape.
//
// The readers are functions, not methods of the struct: a struct method is handed its own copy of
// the struct where it can't be read in place (a method call that isn't inlined, or a result that
// may refer into it), and a copy taken out of a `shared` box copies the arrays too. A parameter is
// read in place. The ones every value read goes through (`wordKind`, `childIn`, `findIn`, …) take
// the tape's arrays rather than the tape: they are then quiet (velt_vir lower/quiet.rs), so
// `TapeRef` lends them `this.tape.words` without retaining itself for the call; the others take
// the `shared<Tape>`.

import { inline, strByteAt, strByteLen, strLoadPartialU8x16 } from "velt/lang/intrinsics";

declare function velt_rt_str_byte_slice(s: string, start: u64, end: u64): string;
declare function velt_simd_u8x16_eq(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_mask8x16_all(m: mask8x16): bool;

/** Objects with more keys than this get a hash index (`TapeRef.find`), built on their first lookup. */
export const INDEX_THRESHOLD: usize = 16;
/**
 * What `findIn` returns when the object needs `findOther`: over `INDEX_THRESHOLD` keys, a key
 * repeated or with escapes, or a name over 16 bytes.
 */
export const FIND_OTHER: i64 = -2;
/** What `findOther` returns for an object over `INDEX_THRESHOLD` keys: look it up in the index. */
export const FIND_WIDE: i64 = -3;
/** Value kinds (the low byte of a value's first word). */
export const T_NULL: u64 = 1;
export const T_FALSE: u64 = 2;
export const T_TRUE: u64 = 3;
export const T_NUMBER: u64 = 4;
export const T_STRING: u64 = 5;
export const T_ARRAY: u64 = 6;
export const T_OBJECT: u64 = 7;

/**
 * A string's first word: bit 8 is set when it had escapes, and bits 32 and up hold its UTF-16
 * length. Its second word is `start | end << 32`, a byte range of the source, or of `decoded`
 * when it had escapes.
 */
export const ESCAPED: u64 = 0x100;
/**
 * An object's first word: bit 9 is set when a key is repeated (its value is the last one), bit
 * 10 when it has a member list (`Tape`), bit 11 when a key had escapes.
 */
export const REPEATED: u64 = 0x200;
export const ORDERED: u64 = 0x400;
export const ESCAPED_KEY: u64 = 0x800;

/**
 * A parsed document. Value `v`'s words are `words[2v]` (kind, and a container's member count
 * from bit 32) and `words[2v + 1]` (a number's bits, a string's byte range, a
 * container's first position in `kids`). An array's `kids` are its elements; an object's are its
 * key strings, each followed on the tape by its value (`key + 1`). Value 0 is the root.
 *
 * An object whose members are not its keys in order (index-like or repeated keys, flagged
 * `ORDERED`) has its member list in `kids` right after its keys: its length, then one key
 * position per distinct key, in JS order (a repeated key's is its last occurrence, whose value is
 * the one that counts, at the place of its first).
 *
 * Every lookup is O(1) but `findIn` in a small object (at most `INDEX_THRESHOLD` keys, compared
 * in place), so walking any value is linear in its size.
 */
export struct Tape {
  src: string;
  words: u64[];
  kids: u32[];
  /** The texts of the strings that had escapes, one after another (such a string's second word
   *  is its range here); empty when none had. */
  decoded: string;
}

/** Value `v`'s kind (`T_*`), from the tape's `words`. */
@inline
export function wordKind(words: u64[], v: u32): u64 {
  return words[2 * (v as usize)] & 0xff;
}

/** A number value's value, from the tape's `words`. */
@inline
export function wordNumber(words: u64[], v: u32): f64 {
  return f64.fromBits(words[2 * (v as usize) + 1]);
}

/** A string's UTF-16 length, from the tape's `words`. */
@inline
export function wordUnits(words: u64[], v: u32): i64 {
  return (words[2 * (v as usize)] >> 32) as i64;
}

/** A container's member count (an object's keys as written, repeats included), else 0. */
@inline
export function wordRawCount(words: u64[], v: u32): u32 {
  const w = words[2 * (v as usize)];
  const k = w & 0xff;
  return k == T_ARRAY || k == T_OBJECT ? (w >> 32) as u32 : 0;
}

/** The number of members: elements, an object's distinct keys (from the tape's `words`, `kids`). */
export function countIn(words: u64[], kids: u32[], v: u32): i64 {
  const w = words[2 * (v as usize)];
  if ((w & ORDERED) != 0) {
    // The member list's length follows the keys in `kids`.
    return kids[(words[2 * (v as usize) + 1] + (w >> 32)) as usize] as i64;
  }
  return wordRawCount(words, v) as i64;
}

/**
 * Member `i` of container `v` (an object's: the key's position, its value at `key + 1`), from the
 * tape's `words` and `kids`; -1 past the end.
 */
@inline
export function memberIn(words: u64[], kids: u32[], v: u32, i: i64): i64 {
  const w = words[2 * (v as usize)];
  const k = w & 0xff;
  if (k != T_ARRAY && k != T_OBJECT) {
    return -1;
  }
  const first = words[2 * (v as usize) + 1];
  if ((w & ORDERED) != 0) {
    return orderedMember(kids, (first + (w >> 32)) as usize, i);
  }
  if (i >= ((w >> 32) as i64)) {
    return -1;
  }
  return kids[(first + (i as u64)) as usize] as i64;
}

// Member `i` of the member list at `at` in `kids` (its length, then the list), or -1.
function orderedMember(kids: u32[], at: usize, i: i64): i64 {
  return i < (kids[at] as i64) ? (kids[at + 1 + (i as usize)] as i64) : -1;
}

/**
 * Element `i` of array `v`, or the value of member `i` of object `v` (from the tape's `words` and
 * `kids`); -1 if there is none.
 */
@inline
export function childIn(words: u64[], kids: u32[], v: u32, i: i64): i64 {
  const m = memberIn(words, kids, v, i);
  // An object's member is its key: the value follows it.
  return m < 0 || (words[2 * (v as usize)] & 0xff) == T_ARRAY ? m : m + 1;
}

/**
 * Object `v`'s value for `name` (from the tape's `words`, `kids` and `src`), or -1 (also when `v`
 * is no object); `FIND_OTHER` when `findOther` must look.
 */
@inline
export function findIn(words: u64[], kids: u32[], src: string, v: u32, name: string): i64 {
  const w = words[2 * (v as usize)];
  if ((w & 0xff) != T_OBJECT) {
    return -1;
  }
  const n = (w >> 32) as usize;
  const len = strByteLen(name);
  if (n > INDEX_THRESHOLD || len > 16 || (w & (REPEATED | ESCAPED_KEY)) != 0) {
    return FIND_OTHER;
  }
  // No key had escapes: each is a range of the source, compared to `name` with one vector
  // compare when the lengths match (both sides' bytes in the low lanes, zeros in the others;
  // `name`'s side loaded once).
  const first = words[2 * (v as usize) + 1] as usize;
  const nv = strLoadPartialU8x16(name, 0, len as u64);
  for (let i: usize = 0; i < n; i++) {
    const k = kids[first + i];
    const p = words[2 * (k as usize) + 1];
    if ((p >> 32) - (p & 0xffffffff) == len as u64) {
      const kv = strLoadPartialU8x16(src, p & 0xffffffff, len as u64);
      if (velt_simd_mask8x16_all(velt_simd_u8x16_eq(kv, nv))) {
        return (k + 1) as i64;
      }
    }
  }
  return -1;
}

/**
 * `findIn` of an object it answered `FIND_OTHER` for: in a small object, from the last key (a
 * repeated key's value is its last); `FIND_WIDE` for one over `INDEX_THRESHOLD` keys.
 */
export function findOther(t: shared<Tape>, v: u32, name: string): i64 {
  const n = wordRawCount(t.words, v) as usize;
  if (n > INDEX_THRESHOLD) {
    return FIND_WIDE;
  }
  const first = t.words[2 * (v as usize) + 1] as usize;
  for (let i = n; i > 0; i--) {
    const k = t.kids[first + i - 1];
    if (keyIs(t, k, name)) {
      return (k + 1) as i64;
    }
  }
  return -1;
}

// Whether key string `k` is `name`, compared in place.
function keyIs(t: shared<Tape>, k: u32, name: string): bool {
  const p = t.words[2 * (k as usize) + 1];
  if ((t.words[2 * (k as usize)] & ESCAPED) != 0) {
    return rangeIs(t.decoded, p, name);
  }
  return rangeIs(t.src, p, name);
}

// Whether the byte range `p` (`start | end << 32`) of `s` is `name`.
function rangeIs(s: string, p: u64, name: string): bool {
  const start = (p & 0xffffffff) as usize;
  const n = strByteLen(name);
  if ((p >> 32) as usize - start != n) {
    return false;
  }
  for (let i: usize = 0; i < n; i++) {
    if (strByteAt(s, (start + i) as u64) != strByteAt(name, i as u64)) {
      return false;
    }
  }
  return true;
}

/** A string value's (or key's) text. */
@inline
export function tapeText(t: shared<Tape>, v: u32): string {
  return wordText(t.src, t.decoded, t.words[2 * (v as usize)], t.words[2 * (v as usize) + 1]);
}

/** The text of the string whose words are `w` and `p`, from the tape's `src` and `decoded`. */
export function wordText(src: string, decoded: string, w: u64, p: u64): string {
  // A range between a string's quotes, or one decoded string: whole characters, no check needed.
  if ((w & ESCAPED) != 0) {
    return velt_rt_str_byte_slice(decoded, p & 0xffffffff, p >> 32);
  }
  return velt_rt_str_byte_slice(src, p & 0xffffffff, p >> 32);
}

/** Key `i` of object `v` (`i` below its `wordRawCount`), as written. */
@inline
export function tapeKey(t: shared<Tape>, v: u32, i: usize): u32 {
  return t.kids[(t.words[2 * (v as usize) + 1] as usize) + i];
}
