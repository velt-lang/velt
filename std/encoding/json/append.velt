// velt/encoding/json (internal): appending JSON text to a `StringBuilder`, for code that writes
// JSON itself: converters, and the code source generators write per type
// (docs/internals/design/source-generators.md). What they append is what `JSON.stringify`
// writes. They check nothing about the document's structure: the caller appends the punctuation
// and the keys (`out.append("{\"id\":")`), which a `StringBuilder` appends inline when they
// are literal text.

import { writeF64 } from "velt/encoding/json/writer_number";
import { writeString } from "velt/encoding/json/writer";
import { StringBuilder } from "velt/text/string_builder";
import { JSON_WRITE } from "velt/lang/hooks/keys";
import { JsonValue } from "velt/prelude/json/json_value";
import { pushU64 } from "velt/lang/number/integer";

/** Appends `s` as a JSON string: quoted, with `"`, `\`, control characters and lone surrogates escaped. */
export function appendJsonString(out: StringBuilder, s: string): void {
  writeString(out.buf, s);
}

/** Appends `x` as `JSON.stringify` writes a number (`null` for NaN and the infinities). */
export function appendJsonNumber(out: StringBuilder, x: f64): void {
  writeF64(out.buf, x);
}

/** Appends the decimal digits of an unsigned integer (every `u64`, unlike an `f64`). */
export function appendJsonUint(out: StringBuilder, n: u64): void {
  pushU64(out.buf, n);
}

/** Appends the JSON text of `v` (what `v.stringify()` returns), without making a string of it. */
export function appendJsonValue(out: StringBuilder, v: JsonValue): void {
  v[JSON_WRITE](out.buf);
}
