// velt/encoding/json (internal): the pull reader under the decoders `JSON.parse<T>` compiles for
// each type.
//
// The reader lexes its source on demand. The first failure is sticky: every later call fails
// too, and `message` turns it into the `JsonError` message. Commas and colons are handled by
// `nextKey` / `arrayNext`: the reader only needs to know whether the last token it consumed
// was an opening bracket.
//
// A driver's rows (std/db) are read by a `RowsReader` (rows_reader.velt): such a reader starts
// out failed (`ROWS`), so every method takes its failure branch, which forwards to the rows
// reader; reading text pays nothing for it.
//
// Port of the runtime's json/reader.rs and error.rs (#1668), with the same results and
// messages.

import { blankComments } from "velt/encoding/json/scan_escape";
import {
  EXPECTED_COLON,
  EXPECTED_COMMA_BRACE,
  EXPECTED_COMMA_BRACKET,
  EXPECTED_KEY,
  Scanner,
} from "velt/encoding/json/scan";
import { utf8Substring } from "velt/encoding";
import { inline, strByteLen } from "velt/lang/intrinsics";
import {
  readerDepthLeft,
  readerNumberStart,
  readerOpen,
  readerRangeIs,
  readerStep,
  readerSyntaxFailed,
  readerValueStart,
  readerWalk,
} from "velt/encoding/json/reader_steps";
import { RowsReader } from "velt/encoding/json/rows_reader";
import {
  rowsArrayNext,
  rowsF64,
  rowsMark,
  rowsNextKey,
  rowsNull,
  rowsOpen,
  rowsPeek,
  rowsSkip,
  rowsString,
} from "velt/encoding/json/rows_ops";

/** `peek` results. */
export const TOKEN_EOF: u32 = 0;
export const TOKEN_NULL: u32 = 1;
export const TOKEN_TRUE: u32 = 2;
export const TOKEN_FALSE: u32 = 3;
export const TOKEN_NUMBER: u32 = 4;
export const TOKEN_STRING: u32 = 5;
export const TOKEN_ARRAY_START: u32 = 6;
export const TOKEN_ARRAY_END: u32 = 7;
export const TOKEN_OBJECT_START: u32 = 8;
export const TOKEN_OBJECT_END: u32 = 9;
export const TOKEN_ERROR: u32 = 10;

/** `nextKey` / `arrayNext` results. */
export const STEP_END: u8 = 0;
export const STEP_MORE: u8 = 1;
export const STEP_ERROR: u8 = 2;

/** `Reader` flags (`JSON.parse` options). */
export const FLAG_REJECT_UNKNOWN: u32 = 1;
export const FLAG_NULL_NOT_ABSENT: u32 = 2;
/** JSONC: comments are whitespace; a comma may come before `]` and `}`. */
export const FLAG_COMMENTS: u32 = 16;
export const FLAG_TRAILING_COMMAS: u32 = 32;

/** Why the reader stopped (`failed`). */
export const NONE: u8 = 0;
/** Well-formed so far, but not the kind the decoder asked for. */
export const MISMATCH: u8 = 1;
/** An object key the target type does not have, with unknown keys rejected. */
export const UNKNOWN: u8 = 2;
export const SYNTAX: u8 = 3;
/** Reading a driver's rows: the rows reader `rows` answers. */
export const ROWS: u8 = 4;

/** Bits of a mark: position, open containers, `afterOpen`. */
export const MARK_DEPTH_BITS: u64 = 21;

/** Path segments kept at each end of a shortened path. */
export const PATH_KEEP: usize = 10;

/** The pull reader. Failing methods return false (0, `STEP_ERROR`). */
export class Reader extends Scanner {
  /** The last consumed token was `{` or `[` (so no comma comes before the next item). */
  afterOpen: bool = false;
  failed: u8 = NONE;
  rejectUnknown: bool;
  /** A JSON `null` for an optional field whose type has no `null` is an error, not absent. */
  nullNotAbsent: bool;
  /** The deepest nesting allowed, and the arrays and objects open now. */
  maxDepth: usize;
  depth: usize = 0;
  /** Where each array or object `skipLookahead` walked ends, by the offset of its bracket. */
  ends: Map<usize, usize> | null = null;
  /** The rows reader, when reading a driver's rows. */
  rows: RowsReader | null = null;
  /** The last number read. */
  num: f64 = 0;
  int: i64 = 0;
  /**
   * The value `valueLimit` read from a driver's rows: its JSON text. (A value read from text is
   * the tape `JsonValue[JSON_FROM_READER]` parses: no field of the reader holds a tape, so a
   * program that decodes no `JsonValue` does not carry the tape's drop and copy code.)
   */
  rowsText: string = "";
  /** `valueLimit` read a value from a driver's rows (`rowsText`). */
  rowsValue: bool = false;
  /**
   * The last key of `nextKey`: its raw bytes, or its text when it had escapes. Kept apart from
   * the last token, so that a decoder can still name the key after reading or skipping its value.
   */
  keyStart: usize = 0;
  keyEnd: usize = 0;
  keyEscaped: bool = false;
  keyDecoded: string = "";
  /** The last key's length in bytes (of `keyDecoded` if escaped, else of the raw bytes). */
  keyLen: usize = 0;

  /** A reader over JSON text, with `FLAG_*` options and a nesting limit (0: none). */
  constructor(src: string, flags: u32, maxDepth: u32) {
    super((flags & FLAG_COMMENTS) != 0 ? blankComments(src) : src);
    this.rejectUnknown = (flags & FLAG_REJECT_UNKNOWN) != 0;
    this.comments = (flags & FLAG_COMMENTS) != 0;
    this.trailingCommas = (flags & FLAG_TRAILING_COMMAS) != 0;
    this.nullNotAbsent = (flags & FLAG_NULL_NOT_ABSENT) != 0;
    this.maxDepth = maxDepth == 0 ? ~(0 as usize) : maxDepth as usize;
  }

  /** `new Reader(src, flags, maxDepth)`, for the decoders the compiler generates. */
  static of(src: string, flags: u32, maxDepth: u32): Reader {
    return new Reader(src, flags, maxDepth);
  }

  /**
   * A reader over the rows of the native driver's row cursor at address `cursor` (velt/db's
   * `decodeRows`), with `FLAG_*` options: `close` ends it (the cursor stays the driver's).
   */
  static overCursor(cursor: u64, flags: u32, maxDepth: u32): Reader {
    const r = new Reader("", flags, maxDepth);
    r.rows = new RowsReader(cursor, flags);
    r.failed = ROWS;
    return r;
  }

  /** Ends the rows reader, if any. */
  close() {
    const rows = this.rows;
    if (rows != null) {
      rows.close();
      this.rows = null;
    }
  }

  /** The last number `readF64` read. */
  lastF64(): f64 {
    return this.num;
  }

  /** The last integer `readI64` read, or 1 / 0 for the last `readBool`. */
  lastI64(): i64 {
    return this.int;
  }

  /** The JSON text of the last `valueLimit` from rows. */
  lastRowsText(): string {
    return this.rowsText;
  }

  /** May a JSON `null` stand for an absent optional field whose type has no `null`? */
  nullAbsent(): bool {
    return !this.nullNotAbsent;
  }

  /** The kind of the next value (`TOKEN_*`); consumes only whitespace. */
  peek(): u32 {
    return this.failed == ROWS ? rowsPeek(this) : readerPeek(this);
  }

  /** Consumes `{`. */
  openObject(): bool {
    return this.failed == ROWS ? rowsOpen(this, 123) : readerOpenObject(this);
  }

  /** Consumes `[`. */
  openArray(): bool {
    return this.failed == ROWS ? rowsOpen(this, 91) : readerOpenArray(this);
  }

  /**
   * The next key of an object and its `:`: `STEP_MORE` (the key is the string token, `text()`
   * or `keyIs`; its value follows), `STEP_END` after the closing `}`, or `STEP_ERROR`. A row
   * reader's key counts as escaped (`keyDecoded`).
   */
  nextKey(): u8 {
    return this.failed == ROWS ? rowsNextKey(this) : readerNextKey(this);
  }

  /** The last key, as a string. */
  key(): string {
    return this.keyEscaped ? this.keyDecoded : utf8Substring(this.src, this.keyStart, this.keyEnd);
  }

  /** The last string value (`readString`), as a string. */
  value(): string {
    return this.text();
  }

  /** The last key's length in bytes (decoders compare it with each field name's first). */
  keyLength(): u64 {
    return this.keyLen as u64;
  }

  /** Whether the last key is `name` (compared in place, without making a string). */
  keyIs(name: string): bool {
    if (this.keyEscaped) {
      return this.keyDecoded == name;
    }
    return readerRangeIs(this, this.keyStart, this.keyEnd, name);
  }

  /** Whether the last string value (`readString`) is `text`, compared in place. */
  textIs(text: string): bool {
    if (this.escaped) {
      return this.decoded == text;
    }
    return readerRangeIs(this, this.start, this.end, text);
  }

  /** `STEP_MORE` if another array element follows, `STEP_END` after the closing `]`. */
  arrayNext(): u8 {
    return this.failed == ROWS ? rowsArrayNext(this) : readerArrayNext(this);
  }

  /** A string value (decoded): `text()` after true. A row reader's counts as escaped. */
  readString(): bool {
    return this.failed == ROWS ? rowsString(this) : readerReadString(this);
  }

  /** A number value: `num` after true. */
  readF64(): bool {
    return this.failed == ROWS ? rowsF64(this) : readerReadF64(this);
  }

  /** `null`. */
  readNull(): bool {
    return this.failed == ROWS ? rowsNull(this) : readerReadNull(this);
  }

  /** Skips one complete value of any kind, checking it. */
  skipValue(): bool {
    return this.failed == ROWS ? rowsSkip(this) : readerSkipValue(this);
  }

  /** The current position, to come back to with `reset` (a decoder looking ahead). */
  mark(): u64 {
    return this.failed == ROWS ? rowsMark(this) : readerMark(this);
  }

  /** `parseWith` failed on the value `valueLimit` started: the reader fails as a syntax error. */
  valueFailed(): void {
    readerSyntaxFailed(this);
  }
}

// The text reader's side of each `Reader` method that a rows reader forwards (rows_ops.velt): what
// a rows reader's nested text reader calls, so that no call path leads from a `Reader` method back
// to itself (a method that can reach itself is not inlined).

/** `Reader.peek` of a text reader. */
@inline("always")
export function readerPeek(r: Reader): u32 {
  if (r.failed != NONE) {
    return TOKEN_ERROR;
  }
  const b = r.peekNonWs();
  if (b == 34) {
    return TOKEN_STRING;
  }
  if (b == 45 || (b >= 48 && b <= 57)) {
    return TOKEN_NUMBER;
  }
  if (b == 110) {
    return TOKEN_NULL;
  }
  if (b == 116) {
    return TOKEN_TRUE;
  }
  if (b == 102) {
    return TOKEN_FALSE;
  }
  if (b == 91) {
    return TOKEN_ARRAY_START;
  }
  if (b == 93) {
    return TOKEN_ARRAY_END;
  }
  if (b == 123) {
    return TOKEN_OBJECT_START;
  }
  if (b == 125) {
    return TOKEN_OBJECT_END;
  }
  return b < 0 ? TOKEN_EOF : TOKEN_ERROR;
}

/** `Reader.nextKey` of a text reader. */
@inline("always")
export function readerNextKey(r: Reader): u8 {
  if (r.failed != NONE) {
    return STEP_ERROR;
  }
  const step = readerStep(r, 125, EXPECTED_COMMA_BRACE);
  if (step != STEP_MORE) {
    return step;
  }
  if (r.peekNonWs() != 34) {
    r.fail(EXPECTED_KEY);
    readerSyntaxFailed(r);
    return STEP_ERROR;
  }
  if (!r.string(true)) {
    r.failed = SYNTAX;
    return STEP_ERROR;
  }
  r.keyStart = r.start;
  r.keyEnd = r.end;
  r.keyEscaped = r.escaped;
  r.keyLen = r.end - r.start;
  if (r.escaped) {
    r.keyDecoded = r.decoded;
    r.keyLen = strByteLen(r.decoded);
  }
  if (r.peekNonWs() != 58) {
    r.fail(EXPECTED_COLON);
    readerSyntaxFailed(r);
    return STEP_ERROR;
  }
  r.pos++;
  return STEP_MORE;
}

/** `Reader.openObject` of a text reader. */
@inline("always")
export function readerOpenObject(r: Reader): bool {
  return readerValueStart(r, 123, 123) && readerOpen(r);
}

/** `Reader.openArray` of a text reader. */
@inline("always")
export function readerOpenArray(r: Reader): bool {
  return readerValueStart(r, 91, 91) && readerOpen(r);
}

/** `Reader.arrayNext` of a text reader. */
@inline("always")
export function readerArrayNext(r: Reader): u8 {
  if (r.failed != NONE) {
    return STEP_ERROR;
  }
  return readerStep(r, 93, EXPECTED_COMMA_BRACKET);
}

/** `Reader.readString` of a text reader. */
@inline("always")
export function readerReadString(r: Reader): bool {
  if (!readerValueStart(r, 34, 34)) {
    return false;
  }
  if (!r.string(true)) {
    r.failed = SYNTAX;
    return false;
  }
  return true;
}

/** `Reader.readF64` of a text reader. */
@inline("always")
export function readerReadF64(r: Reader): bool {
  if (!readerNumberStart(r)) {
    return false;
  }
  r.num = r.numberValue();
  return true;
}

/** `Reader.readNull` of a text reader. */
@inline("always")
export function readerReadNull(r: Reader): bool {
  if (!readerValueStart(r, 110, 110)) {
    return false;
  }
  return (r.literal("null") || readerSyntaxFailed(r));
}

/** `Reader.skipValue` of a text reader. */
@inline("always")
export function readerSkipValue(r: Reader): bool {
  if (!readerValueStart(r, 0, 0)) {
    return false;
  }
  return (readerWalk(r, readerDepthLeft(r), false) || readerSyntaxFailed(r));
}

/** `Reader.mark` of a text reader. */
@inline("always")
export function readerMark(r: Reader): u64 {
  const max: u64 = (1 << MARK_DEPTH_BITS) - 1;
  const depth = r.depth as u64 < max ? r.depth as u64 : max;
  return ((r.pos as u64) << (MARK_DEPTH_BITS + 1)) | (depth << 1) | (r.afterOpen ? 1 : 0);
}
