// velt/encoding/json (internal): writing a tape value (tape.vlt) as JSON text: strings copied or
// re-escaped, numbers in their shortest form, into one byte buffer.

import { copyRun, nextEscape, writeString } from "velt/encoding/json/writer";
import { putDecimal, shortNumber } from "velt/encoding/json/writer_number";
import { arraySetLen, arrayWithCapacity, strByteLen } from "velt/lang/intrinsics";
import {
  ESCAPED,
  ORDERED,
  T_ARRAY,
  T_FALSE,
  T_NULL,
  T_NUMBER,
  T_OBJECT,
  T_STRING,
  T_TRUE,
  Tape,
} from "velt/encoding/json/tape";

declare function velt_rt_strbuf_finish(buf: string, out: string);
declare function velt_rt_strbuf_new(cap: u64, out: string);

declare function velt_rt_strbuf_push_u8s(out: string, bytes: u8[], len: u64, units: u64);

declare function velt_rt_bytes_put_f64(bytes: u8[], at: u64, v: f64): u64;

/**
 * `Tape.write`'s byte buffer: it goes to the builder once a round of the walk starts past
 * `OUT_CAP` bytes, and a round writes at most `OUT_ROOM` bytes (a number takes 32 for the
 * runtime's printer), but for strings, which check their own length.
 */
export const OUT_CAP: usize = 2048;

export const OUT_ROOM: usize = 64;

/** The innermost open container's flags in `Tape.write` (above its position). */
export const IS_OBJECT: u64 = 1 << 32;

export const IS_ORDERED: u64 = 1 << 33;

export const IS_OPEN: u64 = 1 << 34;

/** `putText`: the string needs escapes, or doesn't fit. */
export const NO_ROOM: usize = ~(0 as usize);

/**
 * String `w`, `p` (a tape string's words) quoted into `buf` at `o`, copied from `src`
 * (`srcLen` bytes); the position after it. `NO_ROOM` when it had escapes or needs some (only
 * non-ASCII text can, for a lone surrogate), or when it doesn't fit with a colon and the 15
 * bytes `copyRun` may write past its end.
 */
export function putText(buf: u8[], o: usize, src: string, srcLen: usize, w: u64, p: u64): usize {
  if ((w & ESCAPED) != 0) {
    return NO_ROOM;
  }
  const start = (p & 0xffffffff) as usize;
  const stop = (p >> 32) as usize;
  if (o + (stop - start) + 18 > OUT_CAP + OUT_ROOM) {
    return NO_ROOM;
  }
  if ((w >> 32) != ((stop - start) as u64) && nextEscape(src, start, stop) < stop) {
    return NO_ROOM;
  }
  buf[o] = 34;
  const at = copyRun(buf, o + 1, src, start, stop, srcLen);
  buf[at] = 34;
  return at + 1;
}

/**
 * The bytes beyond their UTF-16 units of string `w`, `p` written as `len` bytes into the
 * buffer (none when it went to the builder).
 */
export function textExtra(w: u64, p: u64, len: usize): u64 {
  if (len == 0) {
    return 0;
  }
  return ((p >> 32) - (p & 0xffffffff)) - (w >> 32);
}

/**
 * A number as `JSON.stringify` writes it, into `buf` at `o` (32 bytes of room); the position
 * after it. From its digits when it has at most 15, else by the runtime's general printer.
 */
export function putNumber(buf: u8[], o: usize, x: f64): usize {
  if (x != x || x == Infinity || x == -Infinity) {
    return putLiteral(buf, o, T_NULL);
  }
  const d = shortNumber(x);
  if (!d.ok) {
    // More than 15 digits, or out of the plain range: the general printer (not 0, which is an
    // integer).
    return velt_rt_bytes_put_f64(buf, o as u64, x) as usize;
  }
  return putDecimal(buf, o, d.neg, d.m, d.k);
}

/** `null`, `true` or `false` (kind `k`) into `buf` at `o`; the position after it. */
export function putLiteral(buf: u8[], o: usize, k: u64): usize {
  if (k == T_TRUE) {
    buf[o] = 116;
    buf[o + 1] = 114;
    buf[o + 2] = 117;
    buf[o + 3] = 101;
    return o + 4;
  }
  if (k == T_FALSE) {
    buf[o] = 102;
    buf[o + 1] = 97;
    buf[o + 2] = 108;
    buf[o + 3] = 115;
    buf[o + 4] = 101;
    return o + 5;
  }
  buf[o] = 110;
  buf[o + 1] = 117;
  buf[o + 2] = 108;
  buf[o + 3] = 108;
  return o + 4;
}

/**
 * Appends value `v` as compact JSON text (`JSON.stringify`) to the builder `out`. Every call
 * that takes `out` gets no argument that is itself a call (it would make a copy of `out`
 * first, and the text would go to the copy): such arguments are made into locals before.
 * Iterative, with the open containers on a stack of its own, so a value nested as deeply as
 * the parser allowed writes without running out of native stack. The text is gathered in a
 * byte array handed to the builder in chunks: punctuation, strings and numbers cost stores,
 * not a call each.
 */
export function writeTape(t: Tape, out: string, v: u32): void {
  const words = t.words;
  const kids = t.kids;
  const src = t.src;
  const srcLen = strByteLen(src);
  // The text so far: `n` bytes of `buf`, `extra` of them beyond their UTF-16 units (non-ASCII
  // text copied in). Each round of the loop starts at most `OUT_CAP` bytes in and writes at
  // most `OUT_ROOM` more, but for strings, which check their own length.
  const buf: u8[] = arrayWithCapacity(OUT_CAP + OUT_ROOM);
  arraySetLen(buf, OUT_CAP + OUT_ROOM);
  let n: usize = 0;
  let extra: u64 = 0;
  // The innermost open container: `info` (its position, `IS_OPEN`, `IS_OBJECT`,
  // `IS_ORDERED`; 0 while none is open), its next member `cur` and its end `end`: positions
  // in `kids`, or in its member list (`member`) when it is ordered. The containers around it
  // wait on `stack`, two words each (`cur | end << 32`, then `info`), the outermost first.
  let info: u64 = 0;
  let cur: u64 = 0;
  let end: u64 = 0;
  const stack: u64[] = [];
  let sp: usize = 0;
  // 1, or 0 right after a container opens: whether a comma goes before the next member.
  let comma: usize = 1;
  let at = v;
  while (true) {
    if (n > OUT_CAP) {
      const len = n as u64;
      const units = len - extra;
      velt_rt_strbuf_push_u8s(out, buf, len, units);
      n = 0;
      extra = 0;
    }
    // The second word first: its bounds check covers the first's.
    const p = words[2 * (at as usize) + 1];
    const w = words[2 * (at as usize)];
    const k = w & 0xff;
    if (k == T_NUMBER) {
      n = putNumber(buf, n, f64.fromBits(p));
    } else if (k == T_STRING) {
      let to = putText(buf, n, src, srcLen, w, p);
      if (to == NO_ROOM) {
        const len = n as u64;
        const units = len - extra;
        velt_rt_strbuf_push_u8s(out, buf, len, units);
        n = 0;
        extra = 0;
        to = tapeTextAfterFlush(t, out, buf, src, srcLen, w, p, at);
      }
      extra += textExtra(w, p, to - n);
      n = to;
    } else if (k >= T_ARRAY) {
      const object = k == T_OBJECT;
      const count = w >> 32;
      buf[n] = object ? 123 : 91;
      n++;
      if (count == 0) {
        buf[n] = object ? 125 : 93;
        n++;
      } else {
        if (info != 0) {
          if (sp == stack.length) {
            stack.push(0);
            stack.push(0);
          }
          stack[sp] = cur | (end << 32);
          stack[sp + 1] = info;
          sp += 2;
        }
        if ((w & ORDERED) != 0) {
          info = (at as u64) | IS_OPEN | IS_OBJECT | IS_ORDERED;
          cur = 0;
          end = t.count(at) as u64;
        } else {
          info = (at as u64) | IS_OPEN | (object ? IS_OBJECT : 0);
          cur = p;
          end = cur + count;
        }
        comma = 0;
      }
    } else {
      n = putLiteral(buf, n, k);
    }
    // An array's numbers in a row, each with its comma (none right after the bracket).
    if ((info & (IS_OBJECT | IS_ORDERED)) == 0) {
      while (cur < end) {
        const m = kids[cur as usize];
        const pm = words[2 * (m as usize) + 1];
        if ((words[2 * (m as usize)] & 0xff) != T_NUMBER) {
          break;
        }
        if (n > OUT_CAP) {
          const len = n as u64;
          const units = len - extra;
          velt_rt_strbuf_push_u8s(out, buf, len, units);
          n = 0;
          extra = 0;
        }
        buf[n] = 44;
        n = putNumber(buf, n + comma, f64.fromBits(pm));
        comma = 1;
        cur++;
      }
    }
    // Close the containers that are complete, then the next member.
    while (cur == end) {
      if (info == 0) {
        // The last container closed (or the value was no container): the rest of the text.
        const len = n as u64;
        const units = len - extra;
        if (len > 0) {
          velt_rt_strbuf_push_u8s(out, buf, len, units);
        }
        return;
      }
      buf[n] = (info & IS_OBJECT) != 0 ? 125 : 93;
      n++;
      if (n > OUT_CAP) {
        const len = n as u64;
        const units = len - extra;
        velt_rt_strbuf_push_u8s(out, buf, len, units);
        n = 0;
        extra = 0;
      }
      if (sp == 0) {
        info = 0;
        cur = 0;
        end = 0;
      } else {
        sp -= 2;
        const e = stack[sp];
        cur = e & 0xffffffff;
        end = e >> 32;
        info = stack[sp + 1];
      }
    }
    buf[n] = 44;
    n += comma;
    comma = 1;
    const c = (info & 0xffffffff) as u32;
    const m = (info & IS_ORDERED) != 0 ? t.member(c, cur as i64) as u32 : kids[cur as usize];
    cur++;
    if ((info & IS_OBJECT) != 0) {
      // The key, its colon, then its value next round.
      const kp = words[2 * (m as usize) + 1];
      const kw = words[2 * (m as usize)];
      let to = putText(buf, n, src, srcLen, kw, kp);
      if (to == NO_ROOM) {
        const len = n as u64;
        const units = len - extra;
        velt_rt_strbuf_push_u8s(out, buf, len, units);
        n = 0;
        extra = 0;
        to = tapeTextAfterFlush(t, out, buf, src, srcLen, kw, kp, m);
      }
      extra += textExtra(kw, kp, to - n);
      buf[to] = 58;
      n = to + 1;
      at = m + 1;
    } else {
      at = m;
    }
  }
}

/**
 * String `v` (words `w`, `p`) once `write`'s buffer `buf` is flushed: into `buf` from 0 when it
 * fits (the position after it), else straight to the builder with its escapes (0).
 */
export function tapeTextAfterFlush(
  t: Tape,
  out: string,
  buf: u8[],
  src: string,
  srcLen: usize,
  w: u64,
  p: u64,
  v: u32,
): usize {
  const to = putText(buf, 0, src, srcLen, w, p);
  if (to != NO_ROOM) {
    return to;
  }
  const s = t.text(v);
  writeString(out, s);
  return 0;
}

/** Value `v` as compact JSON text. */
export function tapeStringify(t: Tape, v: u32): string {
  let buf = "";
  velt_rt_strbuf_new(0, buf);
  writeTape(t, buf, v);
  let out = "";
  velt_rt_strbuf_finish(buf, out);
  return out;
}
