// velt/encoding/json (internal): byte-level JSON lexing (RFC 8259) for the pull reader, skipping
// and `JsonValue`. Strings without escapes are byte ranges of the source (no copy until a decoder
// asks for the text); only strings with escapes are decoded. Escapes decode to UTF-16 code units,
// so a lone surrogate escape stays a lone surrogate (joined with a half next to it, as string
// concatenation joins halves).
//
// Port of crates/velt_text/src/json_scan.rs (#1668): the same tokens, error details and error
// offsets.

import { detailText, scannerEscape } from "velt/encoding/json/scan_escape";
import { utf8Substring } from "velt/encoding";
import { strByteAt, strByteLen, strLoadU8x16 } from "velt/lang/intrinsics";
import { decimalValue } from "velt/lang/number/parse";

declare function velt_simd_u8x16_splat(x: u8): u8x16;
declare function velt_simd_u8x16_eq(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_lt(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_ge(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_mask8x16_or(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_and(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_any(m: mask8x16): bool;
declare function velt_simd_mask8x16_first(m: mask8x16): u64;
declare function velt_simd_mask8x16_bitmask(m: mask8x16): u64;

// Why a scan failed (`Scanner.code`; `detailText` gives the text, `Scanner.what`). A code, not
// the text: recording one is a store, where a string field is a release and a retain.
/** No failure. */
export const OK: u8 = 0;
/** Input that ends inside a value. */
export const UNEXPECTED_EOF: u8 = 1;
/** A byte that cannot start or continue the construct. */
export const UNEXPECTED_CHAR: u8 = 2;
export const INVALID_NUMBER: u8 = 3;
export const CONTROL_CHAR: u8 = 4;
export const INVALID_ESCAPE: u8 = 5;
export const INVALID_U_ESCAPE: u8 = 6;
/** More nested arrays and objects than a decoder's `maxDepth` allows. */
export const TOO_DEEP: u8 = 7;
export const EXPECTED_KEY: u8 = 8;
export const EXPECTED_COLON: u8 = 9;
export const EXPECTED_COMMA_BRACE: u8 = 10;
export const EXPECTED_COMMA_BRACKET: u8 = 11;
export const TRAILING: u8 = 12;

/** Bytes the scanner compares with. */
export const QUOTE: u8 = 34;
export const BACKSLASH: u8 = 92;
export const MINUS: u8 = 45;
export const PLUS: u8 = 43;
export const DOT: u8 = 46;
export const ZERO: u8 = 48;

/** A cursor over a JSON document. Failing methods return false and set `code` and `at`. */
export class Scanner {
  src: string;
  /** The source's length in bytes. */
  len: usize;
  pos: usize = 0;
  /** The UTF-16 length of the last string token's (decoded) contents. */
  units: usize = 0;
  /** The last string token decoded a lone surrogate escape (`"\ud800"`). */
  lone: bool = false;
  /** The last string token's raw contents: bytes `start` to `end`, between its quotes. */
  start: usize = 0;
  end: usize = 0;
  /** The last string token had escapes: its text is `decoded` (when decoding). */
  escaped: bool = false;
  decoded: string = "";
  /** The last number token had no fraction and no exponent. */
  integer: bool = false;
  /**
   * The last number token's digits, read while lexing it (so that a decoder's number is not
   * read twice): `digitsValue` is its digits as an integer (wrapped past 19 digits) and
   * `exponent` the power of ten that scales it, its sign is `negative`. `small`: an integer of
   * at most 15 digits (below 2^53, so exact as an `f64` too). `exact`: at most 19 digits and an
   * exponent of at most 5 digits, so `digitsValue` and `exponent` are the token's value.
   */
  small: bool = false;
  exact: bool = false;
  digitsValue: u64 = 0;
  exponent: i64 = 0;
  negative: bool = false;
  /** JSONC (`JSON.parse` options): the text had its comments blanked (`blankComments`); a
   *  comma may come before `]` and `}`. */
  comments: bool = false;
  trailingCommas: bool = false;
  /** The last error: its detail and byte offset. */
  code: u8 = OK;
  at: usize = 0;

  constructor(src: string) {
    this.src = src;
    this.len = strByteLen(src);
  }

  /** Skips whitespace; the next byte, not consumed, or -1 at the end. */
  peekNonWs(): i32 {
    // On a local, stored back once: with `this.pos` in the loop, LLVM still stores it per byte
    // here (the loop exits before the increment; #1669's alias tag covers loops that store on
    // every iteration). Measured 5-7% more instructions for the plain form.
    const len = this.len;
    let pos = this.pos;
    while (pos < len) {
      const b = strByteAt(this.src, pos as u64);
      if (b != 32 && b != 10 && b != 13 && b != 9) {
        this.pos = pos;
        return b as i32;
      }
      pos++;
    }
    this.pos = pos;
    return -1;
  }

  /**
   * The value of the number token just lexed: from the digits the scanner read when that is
   * exact (velt/lang/number/parse's `decimalValue`), else by the general parser.
   */
  numberValue(): f64 {
    const w = this.digitsValue;
    const neg = this.negative;
    if (this.small) {
      return neg ? -(w as f64) : w as f64;
    }
    if (this.exact) {
      if (w == 0) {
        return neg ? -0.0 : 0;
      }
      const r = decimalValue(w, this.exponent);
      if (r.ok) {
        return neg ? -r.value : r.value;
      }
    }
    return Number(utf8Substring(this.src, this.start, this.end));
  }

  /** The last error's text. */
  get what(): string {
    return detailText(this.code);
  }

  /** Fails with `code` at the current position, or `UNEXPECTED_EOF` past the end. */
  fail(code: u8): bool {
    this.code = this.pos >= this.len ? UNEXPECTED_EOF : code;
    this.at = this.pos;
    return false;
  }

  /** The current byte cannot appear here. */
  unexpected(): bool {
    return this.fail(UNEXPECTED_CHAR);
  }

  /** Consumes exactly `word` (`true`, `false`, `null`). */
  literal(word: string): bool {
    const n = strByteLen(word);
    for (let i: usize = 0; i < n; i++) {
      if (!this.byteIs(strByteAt(word, i as u64))) {
        return this.unexpected();
      }
      this.pos++;
    }
    return true;
  }

  /** Lexes a number at the current position (`-` or a digit): `start`..`end`, `integer`. */
  number(): bool {
    const start = this.pos;
    const len = this.len;
    let pos = start;
    const negative = pos < len && strByteAt(this.src, pos as u64) == MINUS;
    if (negative) {
      pos++;
    }
    // The digits accumulate into `w` (wrapping past 19 of them: `exact` is false then).
    const first = pos;
    let w: u64 = 0;
    if (pos < len && strByteAt(this.src, pos as u64) == ZERO) {
      pos++;
    } else {
      while (pos < len) {
        const d = strByteAt(this.src, pos as u64) - ZERO;
        if (d > 9) {
          break;
        }
        w = w * 10 + (d as u64);
        pos++;
      }
      if (pos == first) {
        this.pos = pos;
        return this.fail(INVALID_NUMBER);
      }
    }
    const whole = pos - first;
    let q: i64 = 0;
    let integer = true;
    if (pos < len && strByteAt(this.src, pos as u64) == DOT) {
      pos++;
      const fraction = pos;
      while (pos < len) {
        const d = strByteAt(this.src, pos as u64) - ZERO;
        if (d > 9) {
          break;
        }
        w = w * 10 + (d as u64);
        pos++;
      }
      if (pos == fraction) {
        this.pos = pos;
        return this.fail(INVALID_NUMBER);
      }
      q = -((pos - fraction) as i64);
      integer = false;
    }
    let exact = whole + ((-q) as usize) <= 19;
    if (pos < len) {
      const e = strByteAt(this.src, pos as u64);
      if (e == 101 || e == 69) {
        pos++;
        let eneg = false;
        if (pos < len) {
          const sign = strByteAt(this.src, pos as u64);
          if (sign == PLUS || sign == MINUS) {
            eneg = sign == MINUS;
            pos++;
          }
        }
        const digits = pos;
        let x: i64 = 0;
        while (pos < len) {
          const d = strByteAt(this.src, pos as u64) - ZERO;
          if (d > 9) {
            break;
          }
          x = x * 10 + (d as i64);
          pos++;
        }
        if (pos == digits) {
          this.pos = pos;
          return this.fail(INVALID_NUMBER);
        }
        // A longer exponent: the general parser.
        if (pos - digits > 5) {
          exact = false;
        }
        q += eneg ? -x : x;
        integer = false;
      }
    }
    this.pos = pos;
    this.start = start;
    this.end = pos;
    this.integer = integer;
    this.small = integer && whole <= 15;
    this.exact = exact;
    this.digitsValue = w;
    this.exponent = q;
    this.negative = negative;
    return true;
  }

  /**
   * Lexes the string whose opening quote is at the current position. Without `decode`, escapes
   * are checked but not decoded (`decoded` is then empty).
   */
  string(decode: bool): bool {
    this.pos++;
    const start = this.pos;
    let units: usize = 0;
    let out = "";
    this.escaped = false;
    this.lone = false;
    while (true) {
      const run = this.pos;
      // Up to the next quote, backslash or control character. ASCII runs take the first loop:
      // one compare finds both a control character and a non-ASCII byte (`b - 32` wraps below
      // 32). A run of non-ASCII bytes (a non-Latin word) adjusts the UTF-16 count in a loop of
      // its own: a continuation byte counts no unit, a four-byte lead two. On a local `pos`, as
      // in `peekNonWs`.
      const len = this.len;
      let pos = run;
      let adjust: isize = 0;
      // Sixteen bytes at a time (#1658): a block without a stop byte is all text; its UTF-16
      // count is 16, less one per continuation byte (0x80-0xBF), plus one per four-byte lead
      // (0xF0 and up). A block with a stop ends at its first one, counted the same way over
      // the bytes before it. The rest, and what follows an escape, goes byte by byte below.
      while (pos + 16 <= len) {
        const v = strLoadU8x16(this.src, pos as u64);
        const stop = velt_simd_mask8x16_or(
          velt_simd_mask8x16_or(
            velt_simd_u8x16_eq(v, velt_simd_u8x16_splat(QUOTE)),
            velt_simd_u8x16_eq(v, velt_simd_u8x16_splat(BACKSLASH)),
          ),
          velt_simd_u8x16_lt(v, velt_simd_u8x16_splat(32)),
        );
        const high = velt_simd_u8x16_ge(v, velt_simd_u8x16_splat(0x80));
        if (!velt_simd_mask8x16_any(stop)) {
          if (velt_simd_mask8x16_any(high)) {
            adjust += unitAdjust(v, high, 0xffff);
          }
          pos += 16;
          continue;
        }
        const i = velt_simd_mask8x16_first(stop);
        if (velt_simd_mask8x16_any(high)) {
          adjust += unitAdjust(v, high, (1 << i) - 1);
        }
        pos += i as usize;
        break;
      }
      while (true) {
        while (pos < len) {
          const b = strByteAt(this.src, pos as u64);
          if (b == QUOTE || b == BACKSLASH || b - 32 >= 96) {
            break;
          }
          pos++;
        }
        const ascii = pos;
        while (pos < len) {
          const b = strByteAt(this.src, pos as u64);
          if (b < 0x80) {
            break;
          }
          if (b < 0xc0) {
            adjust--;
          } else if (b >= 0xf0) {
            adjust++;
          }
          pos++;
        }
        if (pos == ascii) {
          break;
        }
      }
      this.pos = pos;
      units = ((units + pos - run) as isize + adjust) as usize;
      if (this.pos >= this.len) {
        return this.fail(UNEXPECTED_EOF);
      }
      const b = strByteAt(this.src, this.pos as u64);
      if (b == QUOTE) {
        this.start = start;
        this.end = this.pos;
        this.pos++;
        this.units = units;
        if (this.escaped && decode) {
          out += utf8Substring(this.src, run, this.end);
          this.decoded = out;
        }
        return true;
      }
      if (b != BACKSLASH) {
        return this.fail(CONTROL_CHAR);
      }
      if (decode) {
        out += utf8Substring(this.src, run, this.pos);
      }
      this.escaped = true;
      this.pos++;
      const n = scannerEscape(this, decode);
      if (n < 0) {
        return false;
      }
      if (decode) {
        out += this.decoded;
      }
      units += n as usize;
    }
    return false;
  }

  /** The text of the last string token (decoded when it had escapes). */
  text(): string {
    if (this.escaped) {
      return this.decoded;
    }
    return utf8Substring(this.src, this.start, this.end);
  }

  private byteIs(b: u8): bool {
    return this.pos < this.len && strByteAt(this.src, this.pos as u64) == b;
  }
}

// How the UTF-16 count of the lanes of `v` in `lanes` (a bitmask) differs from their byte
// count: one less per continuation byte, one more per four-byte lead. `high` marks bytes of
// 0x80 and up.
function unitAdjust(v: u8x16, high: mask8x16, lanes: u64): isize {
  const lead4 =
    velt_simd_mask8x16_bitmask(velt_simd_u8x16_ge(v, velt_simd_u8x16_splat(0xf0))) & lanes;
  const cont =
    velt_simd_mask8x16_bitmask(
      velt_simd_mask8x16_and(high, velt_simd_u8x16_lt(v, velt_simd_u8x16_splat(0xc0))),
    ) &
    lanes;
  return (lead4.countOnes() as isize) - (cont.countOnes() as isize);
}

/** The value of a hex digit, or -1. */
export function hexValue(b: u8): i64 {
  if (b - ZERO <= 9) {
    return (b - ZERO) as i64;
  }
  const lower = (b | 0x20) - 97;
  return lower <= 5 ? (lower + 10) as i64 : -1;
}
