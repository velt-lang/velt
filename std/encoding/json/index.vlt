// velt/encoding/json: the `json.Value` name for dynamic JSON values.
//
// `JSON`, `JsonError` and the value class itself are globals (std/prelude/json/json.vlt, loaded
// when a module names them: std/prelude/global/json.vlt), because `JSON.stringify`/`JSON.parse`
// are used without an import. The prelude class is named
// `JsonValue` so it does not take the common name `Value` in every module; importing `Value`
// from here gives the spelling of docs/std/json.md.

import { JsonValue } from "velt/prelude/json/json";

export type Value = JsonValue;

export { appendJsonNumber, appendJsonString, appendJsonUint } from "velt/encoding/json/append";
