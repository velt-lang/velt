// velt/encoding/json (internal): the walk of `JSON.stringify(value, replacer)`, as Node walks it
// (SerializeJSONProperty): for each key, the value's `toJSON(key)` first, then the replacer with
// what that returned, then the members of what the replacer returned. The replacer gets a value
// as `writeJsonRaw` writes it, before the `toJSON` of anything in it has run. While it returns
// the value it got, unedited, the walk goes on through the typed value (the code
// velt/encoding/json/generate/replace generates, any_replace.velt for dynamic values), so each
// member's `toJSON` runs at its own key; a value the replacer made is walked as JSON.

import { noInline } from "velt/lang/intrinsics";
import { beginVisit, endVisit } from "velt/reflect";
import { JsonValue } from "velt/prelude/json/json_value";
import { JsonReplacer } from "velt/prelude/json/layout";
import {
  JSON_CALLBACK_DEPTH,
  jsonCallbackTooDeep,
  pushRevived,
  setRevived,
} from "velt/encoding/json/value_ops";

// The depth of the value the replacer is called for (`jsonReplacerDepth`): where a walk the
// replacer's result needs starts (`jsonReplacerDepthNow`).
const JSON_REPLACER_DEPTH = new ThreadLocal<i64>(0);

// What a replacer declared with `any` returned, when it was walked through itself already
// (`jsonOfAny`, std/prelude/json/layout.velt): 1 from when that walk ended (`jsonResultWalked`)
// until the walk that called the replacer takes the result as it is (`jsonResultTaken`); 2 (a
// `TypeError`) or 3 (a `RangeError`) when that walk threw, until the walk takes the `null`
// returned instead and throws it (`jsonResultError`); otherwise 0.
const JSON_RESULT = new ThreadLocal<u64>(0);

/** The replacer's result about to be returned has been walked already (`jsonResultTaken`). */
export function jsonResultWalked(): void {
  JSON_RESULT.set(1);
}

/** The walk of the replacer's result threw (`range`: a `RangeError`, else a `TypeError`). */
export function jsonResultFailed(range: bool): void {
  JSON_RESULT.set(range ? 3 : 2);
}

/** Whether the replacer's result just taken was walked already (`jsonResultWalked`; once). */
function jsonResultTaken(): bool {
  if (JSON_RESULT.get() != 1) {
    return false;
  }
  JSON_RESULT.set(0);
  return true;
}

/**
 * What the walk of the replacer's result just taken threw (`jsonResultFailed`; once): 1 for a
 * `TypeError`, 2 for a `RangeError`, else 0.
 */
function jsonResultError(): u64 {
  const s = JSON_RESULT.get();
  if (s != 2 && s != 3) {
    return 0;
  }
  JSON_RESULT.set(0);
  return s - 1;
}

/**
 * The state above when `JSON.stringify(value, replacer)` starts, for `jsonResultRestore`: a call
 * made inside another one's walk leaves that walk's state as it was.
 */
export function jsonResultSave(): u64 {
  return JSON_RESULT.get();
}

/** Ends what `JSON.stringify(value, replacer)` did to the state above (`s`: `jsonResultSave`). */
export function jsonResultRestore(s: u64): void {
  JSON_RESULT.set(s);
}

/** Throws Node's stack overflow `RangeError` past the replacer walk's depth limit. */
export function jsonReplacerDepth(depth: i64): void {
  if (depth > JSON_CALLBACK_DEPTH) {
    throw jsonCallbackTooDeep();
  }
  JSON_REPLACER_DEPTH.set(depth);
}

/** The depth `jsonReplacerDepth` was last given: the replacer being called is at that depth. */
export function jsonReplacerDepthNow(): i64 {
  return JSON_REPLACER_DEPTH.get();
}

/**
 * Sets back the depth `jsonReplacerDepthNow` gives (`depth`: what it gave before a call of
 * `JSON.stringify(value, replacer)` made inside another one's walk).
 */
export function jsonReplacerDepthRestore(depth: i64): void {
  JSON_REPLACER_DEPTH.set(depth);
}

/**
 * Starts the walk through the members of the value with identity `id`, which the replacer kept:
 * Node's `TypeError` when that value is being walked or written already (it contains itself). A
 * value without an identity (0, a struct held by value) is not checked. Each start needs a
 * `jsonWalkLeave(id)`; after a throw the hook's caller ends what is left (`endVisitsTo`).
 */
export function jsonWalkEnter(id: u64): void throws TypeError {
  if (id != 0 && !beginVisit(id)) {
    throw new TypeError("Converting circular structure to JSON");
  }
}

/** Ends what `jsonWalkEnter(id)` started. */
export function jsonWalkLeave(id: u64): void {
  if (id != 0) {
    endVisit();
  }
}

/** The replacer's view of a value: `raw` when its parent's view holds it, else `text` read. */
export function jsonReplacerView(raw: JsonValue | null, text: string): JsonValue {
  if (raw != null) {
    return raw;
  }
  let view = JsonValue.of(null);
  try {
    // At any depth: `stringify` writes values nested deeper than the default limit too.
    view = JsonValue.parse(text, { maxDepth: 4294967295 });
  } catch (e) {
    // `text` is `writeJsonRaw`'s own output.
    panic(`ICE: JSON.stringify wrote text it cannot read back: ${e.message}`);
  }
  return view;
}

/** Did the replacer return `view`, the value it got, unedited? */
export function jsonReplacerKept(r: JsonValue, view: JsonValue): bool {
  return r.sameNode(view);
}

/** `value` under `key` replaced, then its members in turn (a value with no `toJSON` left). */
export function jsonReplaced(
  key: string,
  value: JsonValue,
  replacer: JsonReplacer,
  depth: i64,
): JsonValue | undefined {
  jsonReplacerDepth(depth);
  const r = replacer(key, value);
  if (r == undefined) {
    return undefined;
  }
  return jsonReplacedMembers(r, replacer, depth);
}

/**
 * Member `key` of the object `view`, plain data, replaced and set in `out` (left out when the
 * replacer returns `undefined`): one call per plain member of the generated walk.
 */
@noInline
export function jsonReplacedField(
  out: JsonValue,
  view: JsonValue,
  key: string,
  replacer: JsonReplacer,
  depth: i64,
): void {
  setRevived(out, key, jsonReplaced(key, view.get(key)!, replacer, depth));
}

/** A `null` under `key` replaced (`raw`: its view in its parent's, if that holds it). */
export function jsonReplacedNull(
  key: string,
  raw: JsonValue | null,
  replacer: JsonReplacer,
  depth: i64,
): JsonValue | undefined {
  const r = replacer(key, raw ?? JsonValue.of(null));
  if (r == undefined) {
    return undefined;
  }
  return jsonReplacedMembers(r, replacer, depth);
}

/**
 * `r`, the replacer's result at `depth`, with its members replaced in turn; as it is when that
 * was done already (what a replacer declared with `any` returned is walked through that value
 * itself, as Node walks it: `jsonResultTaken`, #3871); a `null` for one whose walk threw is that
 * error (`jsonResultError`).
 */
export function jsonReplacedMembers(r: JsonValue, replacer: JsonReplacer, depth: i64): JsonValue {
  if (r.isArray()) {
    if (jsonResultTaken()) {
      return r;
    }
    const out = JsonValue.array();
    const n = r.len();
    for (let i: i64 = 0; i < n; i++) {
      const e = jsonReplaced(String(i), r.at(i)!, replacer, depth + 1);
      pushRevived(out, e);
    }
    return out;
  }
  if (r.isObject()) {
    if (jsonResultTaken()) {
      return r;
    }
    const out = JsonValue.object();
    for (const k of r.keys()) {
      const e = jsonReplaced(k, r.get(k)!, replacer, depth + 1);
      setRevived(out, k, e);
    }
    return out;
  }
  if (r.isNull()) {
    const thrown = jsonResultError();
    if (thrown == 1) {
      throw new TypeError("Converting circular structure to JSON");
    }
    if (thrown == 2) {
      throw jsonCallbackTooDeep();
    }
  }
  return r;
}

/**
 * The text of `JSON.stringify(value, replacer)` for the replaced value: `undefined` for the
 * value itself throws a `TypeError` (JavaScript returns `undefined`; this returns a string).
 */
export function jsonReplacedText(out: JsonValue | undefined): string {
  if (out == undefined) {
    throw new TypeError(
      "JSON.stringify: the replacer returned undefined for the value itself (JavaScript would return undefined; Velt's JSON.stringify returns a string)",
    );
  }
  return out.stringify();
}
