// velt/encoding/json (internal): the members of a built or edited `JsonValue` object (tree.velt):
// insertion order, last value wins for a repeated key, access by position (`keyAt`, `valueAt`:
// O(1), O(log n) after deletes in the middle) and by key (O(1), hashed past `TREE_INDEX_AT`
// members), and O(1) amortized `remove` anywhere.
//
// Small objects keep their members dense (a delete moves at most 16). Large ones have a hash
// index (`index`) and delete by leaving a hole: a hole at the front or the back is skipped right
// away (positions stay O(1) for objects emptied from either end). With holes in the middle,
// positional access finds the `i`-th member in a Fenwick tree of the live slots
// (tree_positions.velt). When the holes outnumber the members the slots are compacted, so every
// delete costs O(1) amortized and the slots stay at most twice the member count.
//
// Members whose keys are array indexes (`"0"` to `"4294967294"`) come first, ascending, as in
// JavaScript. They live apart, sorted by index (`ints`): found by binary search, appended in
// O(1).
//
// A "raw position" walks every member in order without the Fenwick tree: the array-index members
// are `0 .. ints.length`, slot `s` is `ints.length + s` (`nextRaw` skips holes).

import { JsonTree } from "velt/encoding/json/tree";
import { TreePositions } from "velt/encoding/json/tree_positions";
import { TapeRef } from "velt/encoding/json/tape_ref";
import { arrayRemove, noInline, strByteAt, strByteLen } from "velt/lang/intrinsics";

/** Objects with more keys than this get a hash index. */
export const TREE_INDEX_AT: usize = 16;

/** The members of an object. */
export class TreeObject {
  /** The array-index members (made by the first one: most objects have none). */
  intm: IntMembers | null = null;
  /** The other members by slot; a deleted member's slot (only with an index) is a null value. */
  keys: string[] = [];
  vals: (JsonTree | null)[] = [];
  /** Slots before `head` are holes; `vals[head]` is live (or `head == vals.length`). */
  head: usize = 0;
  /** Holes at or after `head` (never the last slot). */
  holes: usize = 0;
  /**
   * The slot of every live key, in a large object or one with array-index members (`u32`: an
   * object holds fewer than 2^32 members, as on the tape).
   */
  index: Map<string, u32> | null = null;
  /** A `TREE_TAPE` node's tape and value on it (tree.velt; such a node has no members here). */
  tape: TapeRef | null = null;
  node: u32 = 0;
  /** Which slots are live, while `holes > 0`: made on demand, then kept until a compaction. */
  positions: TreePositions | null = null;

  /** The number of array-index members. */
  intCount(): usize {
    const m = this.intm;
    return m == null ? 0 : m.keys.length;
  }

  /** The number of members. */
  len(): usize {
    return this.intCount() + this.vals.length - this.head - this.holes;
  }

  /** A copy sharing the member values (what an edit of a shared object starts from). */
  copy(): TreeObject {
    const o = new TreeObject();
    const m = this.intm;
    if (m != null) {
      o.intm = new IntMembers(m.keys.slice(), m.vals.slice());
    }
    for (let s = this.head; s < this.vals.length; s++) {
      const v = this.vals[s];
      if (v != null) {
        o.keys.push(this.keys[s]);
        o.vals.push(v);
      }
    }
    if (this.index != null) {
      o.makeIndex();
    }
    return o;
  }

  /** The value of `key`, or null. */
  get(key: string): JsonTree | null {
    const n = arrayIndex(key);
    if (n >= 0) {
      const i = this.intPos(n as u32);
      return i >= 0 ? this.intm!.vals[i as usize] : null;
    }
    const s = this.find(key);
    return s < 0 ? null : this.vals[s as usize];
  }

  /** The raw position of the `i`-th member, or -1. */
  rawAt(i: usize): i64 {
    const ni = this.intCount();
    if (i < ni) {
      return i as i64;
    }
    const j = i - ni;
    let slot: i64 = -1;
    if (this.holes == 0) {
      slot = (this.head + j) as i64;
    } else {
      if (this.positions == null) {
        const live: bool[] = [];
        live.reserve(this.vals.length);
        for (let s: usize = 0; s < this.vals.length; s++) {
          live.push(this.vals[s] != null);
        }
        this.positions = new TreePositions(live);
      }
      slot = this.positions!.select(j);
    }
    if (slot < 0 || (slot as usize) >= this.vals.length) {
      return -1;
    }
    return (ni as i64) + slot;
  }

  /** The first raw position at or after `raw` that holds a member (`rawEnd()` if none). */
  nextRaw(raw: usize): usize {
    const ni = this.intCount();
    let r = raw;
    if (r < ni) {
      return r;
    }
    if (r < ni + this.head) {
      r = ni + this.head;
    }
    const end = ni + this.vals.length;
    while (r < end && this.vals[r - ni] == null) {
      r++;
    }
    return r;
  }

  /** Past the last raw position. */
  rawEnd(): usize {
    return this.intCount() + this.vals.length;
  }

  /** The key at raw position `raw` (a member's). */
  keyRaw(raw: usize): string {
    const ni = this.intCount();
    return raw < ni ? `${this.intm!.keys[raw]}` : this.keys[raw - ni];
  }

  /** The value at raw position `raw` (a member's). */
  valueRaw(raw: usize): JsonTree {
    const ni = this.intCount();
    return raw < ni ? this.intm!.vals[raw] : this.vals[raw - ni]!;
  }

  /** Sets `key` to `v` (an existing key keeps its position). */
  insert(key: string, v: JsonTree): void {
    const n = arrayIndex(key);
    if (n >= 0) {
      this.insertInt(n as u32, v);
      return;
    }
    const s = this.find(key);
    if (s >= 0) {
      this.vals[s as usize] = v;
      return;
    }
    const slot = this.vals.length;
    this.keys.push(key);
    this.vals.push(v);
    const ix = this.index;
    if (ix != null) {
      ix.set(key, slot as u32);
      const p = this.positions;
      if (p != null) {
        p.pushLive();
      }
    } else if (slot == TREE_INDEX_AT) {
      this.makeIndex();
    }
  }

  // Sets array-index member `n` to `v`.
  private insertInt(n: u32, v: JsonTree): void {
    if (this.index == null) {
      this.makeIndex();
    }
    const at = this.intPos(n);
    if (at >= 0) {
      this.intm!.vals[at as usize] = v;
      return;
    }
    // Where it goes: after every smaller index.
    const i = this.intInsertAt(n);
    if (this.intm == null) {
      this.intm = new IntMembers([], []);
    }
    const m = this.intm!;
    m.keys.push(n);
    m.vals.push(v);
    m.keys.rotateRight(i, m.keys.length);
    m.vals.rotateRight(i, m.vals.length);
  }

  /** Removes `key`; false if absent. */
  remove(key: string): bool {
    const n = arrayIndex(key);
    if (n >= 0) {
      const at = this.intPos(n as u32);
      if (at < 0) {
        return false;
      }
      const m = this.intm!;
      arrayRemove(m.keys, at as usize);
      arrayRemove(m.vals, at as usize);
      if (this.intCount() == 0 && this.vals.length - this.head - this.holes <= TREE_INDEX_AT) {
        this.compact();
      }
      return true;
    }
    const found = this.find(key);
    if (found < 0) {
      return false;
    }
    const slot = found as usize;
    const ix = this.index;
    if (ix == null) {
      arrayRemove(this.keys, slot);
      arrayRemove(this.vals, slot);
      return true;
    }
    ix.delete(key);
    this.vals[slot] = null;
    this.keys[slot] = "";
    const p = this.positions;
    if (p != null) {
      p.clear(slot);
    }
    if (slot == this.head) {
      this.head++;
      while (this.head < this.vals.length && this.vals[this.head] == null) {
        this.head++;
        this.holes--;
      }
    } else if (slot + 1 == this.vals.length) {
      this.keys.pop();
      this.vals.pop();
      while (this.vals.length > 0 && this.vals[this.vals.length - 1] == null) {
        this.keys.pop();
        this.vals.pop();
        this.holes--;
      }
      const q = this.positions;
      if (q != null) {
        q.truncate(this.vals.length);
      }
    } else {
      this.holes++;
    }
    const live = this.vals.length - this.head - this.holes;
    if (live <= TREE_INDEX_AT || this.head + this.holes > live) {
      this.compact();
    }
    return true;
  }

  // Drops the holes; keeps an index only for a large object or one with array-index members.
  private compact(): void {
    if (this.index == null) {
      return;
    }
    if (this.head > 0 || this.holes > 0) {
      const keys: string[] = [];
      const vals: (JsonTree | null)[] = [];
      for (let s = this.head; s < this.vals.length; s++) {
        const v = this.vals[s];
        if (v != null) {
          keys.push(this.keys[s]);
          vals.push(v);
        }
      }
      this.keys = keys;
      this.vals = vals;
    }
    this.head = 0;
    this.holes = 0;
    this.positions = null;
    this.index = null;
    if (this.vals.length > TREE_INDEX_AT || this.intCount() > 0) {
      this.makeIndex();
    }
  }

  // The index of the slots (dense: no holes).
  private makeIndex(): void {
    const ix = new Map<string, u32>();
    for (let s = this.head; s < this.vals.length; s++) {
      if (this.vals[s] != null) {
        ix.set(this.keys[s], s as u32);
      }
    }
    this.index = ix;
  }

  // The slot of `key` (not an array index), or -1.
  private find(key: string): i64 {
    const ix = this.index;
    if (ix != null) {
      const s = ix.get(key);
      return s == undefined ? -1 : (s as i64);
    }
    const n = this.keys.length;
    for (let s: usize = 0; s < n; s++) {
      if (this.keys[s] == key) {
        return s as i64;
      }
    }
    return -1;
  }

  // The position of array-index member `n`, or -1.
  private intPos(n: u32): i64 {
    const i = this.intInsertAt(n);
    return i < this.intCount() && this.intm!.keys[i] == n ? (i as i64) : -1;
  }

  // The first position whose index is at least `n`.
  private intInsertAt(n: u32): usize {
    let lo: usize = 0;
    let hi = this.intCount();
    if (hi > 0 && this.intm!.keys[hi - 1] < n) {
      return hi;
    }
    while (lo < hi) {
      const mid = lo + (hi - lo) / 2;
      if (this.intm!.keys[mid] < n) {
        lo = mid + 1;
      } else {
        hi = mid;
      }
    }
    return lo;
  }
}

/**
 * The array index `key` names (`"0"` to `"4294967294"`, no leading zero), as a JavaScript
 * object orders it first; -1 for any other key.
 */
export function arrayIndex(key: string): i64 {
  const len = strByteLen(key);
  if (len == 0) {
    return -1;
  }
  const first = strByteAt(key, 0);
  if (first < 48 || first > 57) {
    return -1;
  }
  return arrayIndexDigits(key, len);
}

@noInline
function arrayIndexDigits(key: string, len: usize): i64 {
  if ((strByteAt(key, 0) == 48 && len > 1) || len > 10) {
    return -1;
  }
  let n: i64 = 0;
  for (let i: usize = 0; i < len; i++) {
    const b = strByteAt(key, i as u64);
    if (b < 48 || b > 57) {
      return -1;
    }
    n = n * 10 + ((b - 48) as i64);
  }
  return n < 4294967295 ? n : -1;
}

/** An object's array-index members: their indexes, ascending, and values. */
class IntMembers {
  keys: u32[];
  vals: JsonTree[];

  constructor(keys: u32[], vals: JsonTree[]) {
    this.keys = keys;
    this.vals = vals;
  }
}
