// velt/encoding/json (internal): `JSON.stringify(value, replacer, space)` with an array replacer
// or an indent: the compact text the generated glue writes for `value`, laid out again as JS
// writes it. JS's output with a property list and a gap differs from the compact one only
// outside strings (objects keep just the listed keys, in the list's order; the gap adds line
// breaks and indentation, and `": "` after keys), so walking the compact text gives exactly JS's
// bytes.

import { Scanner } from "velt/encoding/json/scan";
import { utf8Substring } from "velt/encoding";
import { StringBuilder } from "velt/text/string_builder";
import { strByteAt, strByteLen } from "velt/lang/intrinsics";
import { writeString } from "velt/encoding/json/writer";

declare function velt_rt_strbuf_new(cap: u64, out: string);
declare function velt_rt_strbuf_finish(buf: string, out: string);

/**
 * The keys of a replacer array from its compact JSON text (`["a","b"]`), decoded, without
 * duplicates (as JS builds its property list); null if the text is not an array of strings.
 */
export function propertyList(text: string): string[] | null {
  const sc = new Scanner(text);
  const keys: string[] = [];
  if (sc.peekNonWs() != 91) {
    return null;
  }
  sc.pos++;
  if (sc.peekNonWs() == 93) {
    return keys;
  }
  while (true) {
    if (sc.peekNonWs() != 34 || !sc.string(true)) {
      return null;
    }
    const k = sc.text();
    if (!keys.includes(k)) {
      keys.push(k);
    }
    const b = sc.peekNonWs();
    if (b == 93) {
      return keys;
    }
    if (b != 44) {
      return null;
    }
    sc.pos++;
  }
}

/**
 * `text` (compact JSON, as `JSON.stringify` writes it) laid out again: only the members of
 * objects whose keys are in `keys` (in that order; null keeps every member in place), and, when
 * `pretty`, with line breaks, `indent` (JS's gap, which may be empty) per level and `": "` after
 * keys (not `pretty`: no whitespace). Text that is not one compact value (never what the glue
 * writes) comes back as it is.
 */
export function relayout(
  text: string,
  keys: string[] | null,
  pretty: bool,
  indent: string,
): string {
  const l = new Layout(text, keys, pretty, indent);
  const out = new StringBuilder(strByteLen(text) + strByteLen(text) / 2);
  l.value(out, 0);
  // Text that is not one compact value (never what the glue writes) comes back as it is.
  if (l.pos != l.len) {
    return text;
  }
  return out.take();
}

class Layout {
  src: string;
  len: usize;
  pos: usize = 0;
  /** Filtering: each listed key as the writer quotes it in the text (`"a"`), compared in place. */
  filter: bool;
  quoted: string[] = [];
  pretty: bool;
  indent: string;
  /**
   * The listed members found in the objects being laid out, 3 words each (the key's index in
   * `quoted`, where its value starts, where its quoted key starts), for every open object: an
   * object's are above the length the stack had when it began.
   */
  found: usize[] = [];

  constructor(src: string, keys: string[] | null, pretty: bool, indent: string) {
    this.src = src;
    this.len = strByteLen(src);
    this.filter = keys != null;
    if (keys != null) {
      for (const k of keys) {
        let b = "";
        velt_rt_strbuf_new(0, b);
        writeString(b, k);
        let q = "";
        velt_rt_strbuf_finish(b, q);
        this.quoted.push(q);
      }
    }
    this.pretty = pretty;
    this.indent = indent;
  }

  // The byte at `pos` (0 past the end).
  cur(): u8 {
    return this.pos < this.len ? strByteAt(this.src, this.pos as u64) : 0;
  }

  // A line break and the indentation of `depth` (nothing unless `pretty`).
  newline(out: StringBuilder, depth: i64): void {
    if (!this.pretty) {
      return;
    }
    out.append("\n");
    for (let i: i64 = 0; i < depth; i++) {
      out.append(this.indent);
    }
  }

  // Past the string token at `pos` (its opening quote).
  skipString(): void {
    this.pos++;
    while (this.pos < this.len) {
      const b = strByteAt(this.src, this.pos as u64);
      this.pos++;
      if (b == 92) {
        this.pos++;
      } else if (b == 34) {
        return;
      }
    }
  }

  value(out: StringBuilder, depth: i64): void {
    const b = this.cur();
    if (b == 123) {
      this.object(out, depth);
      return;
    }
    if (b == 91) {
      this.array(out, depth);
      return;
    }
    const start = this.pos;
    if (b == 34) {
      this.skipString();
    } else {
      // A number or a literal: up to the next structural byte.
      while (this.pos < this.len) {
        const c = strByteAt(this.src, this.pos as u64);
        if (c == 44 || c == 93 || c == 125 || c == 58) {
          break;
        }
        this.pos++;
      }
    }
    out.append(this.slice(start, this.pos));
  }

  // Bytes `start` to `end` of the text, cut at its end (a malformed text may run past it).
  slice(start: usize, end: usize): string {
    const e = end < this.len ? end : this.len;
    return utf8Substring(this.src, start < e ? start : e, e);
  }

  array(out: StringBuilder, depth: i64): void {
    this.pos++;
    if (this.cur() == 93) {
      this.pos++;
      out.append("[]");
      return;
    }
    out.append("[");
    while (true) {
      this.newline(out, depth + 1);
      this.value(out, depth + 1);
      if (this.cur() != 44) {
        break;
      }
      this.pos++;
      out.append(",");
    }
    this.pos++;
    this.newline(out, depth);
    out.append("]");
  }

  object(out: StringBuilder, depth: i64): void {
    if (!this.filter) {
      this.objectInPlace(out, depth);
      return;
    }
    // Find the listed members, then lay out their values in the list's order, each from where
    // it starts in the text.
    const base = this.found.length;
    this.pos++;
    if (this.cur() != 125) {
      while (true) {
        const keyStart = this.pos;
        this.skipString();
        const k = this.listed(keyStart, this.pos);
        this.pos++;
        if (k >= 0) {
          this.found.push(k as usize);
          this.found.push(this.pos);
          this.found.push(keyStart);
        }
        this.skipValue();
        if (this.cur() != 44) {
          break;
        }
        this.pos++;
      }
    }
    this.pos++;
    const end = this.pos;
    const top = this.found.length;
    let first = true;
    for (let k: usize = 0; k < this.quoted.length; k++) {
      for (let f = base; f < top; f += 3) {
        if (this.found[f] == k) {
          out.append(first ? "{" : ",");
          first = false;
          const keyStart = this.found[f + 2];
          this.pos = this.found[f + 1];
          this.newline(out, depth + 1);
          out.append(this.slice(keyStart, this.pos - 1));
          out.append(this.pretty ? ": " : ":");
          this.value(out, depth + 1);
          break;
        }
      }
    }
    this.found.truncate(base as i64);
    this.pos = end;
    if (first) {
      out.append("{}");
      return;
    }
    this.newline(out, depth);
    out.append("}");
  }

  // The index in `quoted` of the key written at bytes `start` to `end` (with its quotes), or -1.
  listed(start: usize, end: usize): i64 {
    const n = end - start;
    for (let k: usize = 0; k < this.quoted.length; k++) {
      const q = this.quoted[k];
      if (strByteLen(q) != n) {
        continue;
      }
      let same = true;
      for (let i: usize = 0; i < n && same; i++) {
        same = strByteAt(q, i as u64) == strByteAt(this.src, (start + i) as u64);
      }
      if (same) {
        return k as i64;
      }
    }
    return -1;
  }

  // Past the value at `pos`, laying out nothing (a member the list leaves out).
  skipValue(): void {
    let open = 0;
    while (this.pos < this.len) {
      const b = strByteAt(this.src, this.pos as u64);
      if (b == 34) {
        this.skipString();
      } else if (b == 123 || b == 91) {
        open++;
        this.pos++;
      } else if (b == 125 || b == 93) {
        if (open == 0) {
          return;
        }
        open--;
        this.pos++;
      } else if (b == 44 && open == 0) {
        return;
      } else {
        this.pos++;
      }
      if (open == 0 && (b == 34 || b == 125 || b == 93)) {
        return;
      }
    }
  }

  // An object with every member kept, written as it is read.
  objectInPlace(out: StringBuilder, depth: i64): void {
    this.pos++;
    if (this.cur() == 125) {
      this.pos++;
      out.append("{}");
      return;
    }
    out.append("{");
    while (true) {
      this.newline(out, depth + 1);
      const start = this.pos;
      this.skipString();
      out.append(this.slice(start, this.pos));
      this.pos++;
      out.append(this.pretty ? ": " : ":");
      this.value(out, depth + 1);
      if (this.cur() != 44) {
        break;
      }
      this.pos++;
      out.append(",");
    }
    this.pos++;
    this.newline(out, depth);
    out.append("}");
  }
}
