// velt/encoding/json (internal): a `JsonValue` built or edited in place (`JsonValue.object()`,
// `set`, `push`, ...; std/prelude/json/json_value.velt): a tree of nodes, where a parsed value is a
// position on a tape (tape.velt). Nodes are shared between values (a clone, a parent and the
// child `get` returned): a `JsonValue` edits its node in place only while it knows no other value
// reaches it, and copies it first otherwise (the copy shares the children), so an edit never shows
// through another value.

import { TreeObject } from "velt/encoding/json/tree_object";

/** Node kinds, as `JsonValue` numbers them. */
export const TREE_NULL: u32 = 1;
export const TREE_BOOL: u32 = 2;
export const TREE_NUMBER: u32 = 3;
export const TREE_STRING: u32 = 4;
export const TREE_ARRAY: u32 = 5;
export const TREE_OBJECT: u32 = 6;

/** One value of a tree. */
export class JsonTree {
  kind: u32;
  /** A number's value; a boolean's (1 is true). */
  num: f64 = 0;
  /** A string's text. */
  text: string = "";
  /** An array's elements. */
  items: JsonTree[] = [];
  /** An object's members. */
  obj: TreeObject | null = null;

  constructor(kind: u32) {
    this.kind = kind;
  }

  /** A number (or a boolean: `kind` `TREE_BOOL`, 1 for true). */
  static scalar(kind: u32, num: f64): JsonTree {
    const t = new JsonTree(kind);
    t.num = num;
    return t;
  }

  static string(text: string): JsonTree {
    const t = new JsonTree(TREE_STRING);
    t.text = text;
    return t;
  }

  static object(): JsonTree {
    const t = new JsonTree(TREE_OBJECT);
    t.obj = new TreeObject();
    return t;
  }

  /** A copy of this node sharing its children (what an edit of a shared node starts from). */
  copy(): JsonTree {
    const t = new JsonTree(this.kind);
    t.num = this.num;
    t.text = this.text;
    if (this.kind == TREE_ARRAY) {
      t.items = this.items.slice();
    }
    const o = this.obj;
    if (o != null) {
      t.obj = o.copy();
    }
    return t;
  }

  /** Array length, object member count, string length (UTF-16 code units); 0 otherwise. */
  len(): i64 {
    if (this.kind == TREE_ARRAY) {
      return this.items.length as i64;
    }
    if (this.kind == TREE_STRING) {
      return this.text.length as i64;
    }
    const o = this.obj;
    return o != null ? (o.len() as i64) : 0;
  }

  /** Array element `i` (or the i-th member value of an object), or null. */
  at(i: i64): JsonTree | null {
    if (i < 0) {
      return null;
    }
    if (this.kind == TREE_ARRAY) {
      return i < (this.items.length as i64) ? this.items[i as usize] : null;
    }
    const o = this.obj;
    if (o == null) {
      return null;
    }
    const raw = o.rawAt(i as usize);
    return raw < 0 ? null : o.valueRaw(raw as usize);
  }

  /** Object member `key`, or null. */
  get(key: string): JsonTree | null {
    const o = this.obj;
    return o != null ? o.get(key) : null;
  }

  /** The object's keys in order (empty for anything else). */
  keys(): string[] {
    const out: string[] = [];
    const o = this.obj;
    if (o == null) {
      return out;
    }
    out.reserve(o.len());
    const end = o.rawEnd();
    let r = o.nextRaw(0);
    while (r < end) {
      out.push(o.keyRaw(r));
      r = o.nextRaw(r + 1);
    }
    return out;
  }
}
