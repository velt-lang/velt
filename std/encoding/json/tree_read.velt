// velt/encoding/json (internal): the tree side of `JsonValue`'s readers
// (std/prelude/json/json_value.velt).

import { T_ARRAY } from "velt/encoding/json/tape";
import {
  JsonTree,
  TREE_ARRAY,
  TREE_BOOL,
  TREE_NUMBER,
  TREE_OBJECT,
  TREE_STRING,
  TREE_TAPE,
} from "velt/encoding/json/tree";
import { treeMember } from "velt/encoding/json/tree_text";
import { noInline } from "velt/lang/intrinsics";

// The tree side of `JsonValue`'s readers, out of line and given only the node: a parsed value (the
// tape side) is what loops read, and inlining the tree's lookups there would only grow them. A
// node left on a tape (`TREE_TAPE`) is read through the tape; its children come as nodes of it.
@noInline
export function treeGet(t: JsonTree, key: string): JsonTree | null {
  if (t.kind == TREE_TAPE) {
    const o = t.obj!;
    const tape = o.tape!;
    const v = tape.find(o.node, key);
    return v < 0 ? null : treeMember(tape, v as u32, o.links);
  }
  return t.get(key);
}

@noInline
export function treeAt(t: JsonTree, i: i64): JsonTree | null {
  if (t.kind == TREE_TAPE) {
    const o = t.obj!;
    const tape = o.tape!;
    const v = tape.child(o.node, i);
    return v < 0 ? null : treeMember(tape, v as u32, o.links);
  }
  return t.at(i);
}

@noInline
export function treeLen(t: JsonTree): i64 {
  if (t.kind == TREE_TAPE) {
    const o = t.obj!;
    return o.tape!.count(o.node);
  }
  return t.len();
}

@noInline
export function treeKeys(t: JsonTree): string[] {
  if (t.kind == TREE_TAPE) {
    const o = t.obj!;
    const tape = o.tape!;
    const out: string[] = [];
    const n = tape.count(o.node);
    for (let i: i64 = 0; i < n; i++) {
      out.push(tape.text(tape.member(o.node, i) as u32));
    }
    return out;
  }
  return t.keys();
}

// The scalar readers' tree side, out of line as the runtime's calls were: the tape side is what
// loops read, and an inlined tree side would grow every loop that reads a parsed value.

/** The node's kind (`TREE_*`; a node left on a tape answers for its container). */
@noInline
export function treeKind(t: JsonTree): u32 {
  if (t.kind == TREE_TAPE) {
    const o = t.obj!;
    return o.tape!.kind(o.node) == T_ARRAY ? TREE_ARRAY : TREE_OBJECT;
  }
  return t.kind;
}

/** The node's number, or null. */
@noInline
export function treeNumber(t: JsonTree): f64 | null {
  return t.kind == TREE_NUMBER ? t.num : null;
}

/** The node's boolean, or null. */
@noInline
export function treeBool(t: JsonTree): bool | null {
  return t.kind == TREE_BOOL ? t.num != 0 : null;
}

/** The node's string, or null. */
@noInline
export function treeString(t: JsonTree): string | null {
  return t.kind == TREE_STRING ? t.text : null;
}
