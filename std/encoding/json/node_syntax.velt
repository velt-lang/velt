// velt/encoding/json (internal): the message Node 22 (V8) gives `JSON.parse` for text that is not
// JSON, such as `Expected property name or '}' in JSON at position 1 (line 1 column 2)`.
//
// Only used once decoding has failed: `nodeSyntaxMessage` scans the whole text again the way
// V8's `JsonParser` does (positions, lines and columns count UTF-16 units, as in JS) and reports
// its first error. A typed decoder that stops at a value of the wrong type reports the syntax
// error further on instead, since `JSON.parse` in Node reads the whole text first. The nesting
// depth is not limited here (V8 has no limit).

import { noInline, strByteAt, strByteLen } from "velt/lang/intrinsics";

const PROP_NAME_OR_RBRACE = "Expected property name or '}' in JSON";
const COMMA_OR_RBRACK = "Expected ',' or ']' after array element in JSON";
const COMMA_OR_RBRACE = "Expected ',' or '}' after property value in JSON";
const COLON = "Expected ':' after property name in JSON";
const DOUBLE_QUOTED_NAME = "Expected double-quoted property name in JSON";
const TRAILING_TEXT = "Unexpected non-whitespace character after JSON";
const UNTERMINATED_STRING = "Unterminated string in JSON";
const BAD_ESCAPE = "Bad escaped character in JSON";
const BAD_CONTROL = "Bad control character in string literal in JSON";
const BAD_UNICODE = "Bad Unicode escape in JSON";
const NO_NUMBER_AFTER_MINUS = "No number after minus sign in JSON";
const UNTERMINATED_FRACTION = "Unterminated fractional number in JSON";
const EXPONENT_MISSING = "Exponent part is missing a number in JSON";

/** Context V8 shows on each side of an unexpected character in a long text. */
const CONTEXT: i64 = 10;
/** Texts shorter than this many units are quoted whole. */
const SHORT_TEXT: i64 = 21;

/** Past the end of the text (`NodeSyntax.cur`). */
const END: i64 = -1;

/**
 * Node's `SyntaxError` message for `src`, or null when it is valid JSON (it is not when a
 * decoder failed for another reason: a type mismatch, a depth limit).
 */
@noInline
export function nodeSyntaxMessage(src: string): string | null {
  const p = new NodeSyntax(utf16Units(src));
  if (p.document()) {
    return null;
  }
  return p.render(src);
}

// `src` as UTF-16 code units (a WTF-8 lone surrogate is one unit; a byte that starts no
// character is U+FFFD).
function utf16Units(src: string): u16[] {
  const n = strByteLen(src);
  const out: u16[] = [];
  out.reserve(n);
  let i: usize = 0;
  while (i < n) {
    const b = strByteAt(src, i as u64) as u32;
    if (b < 0x80) {
      out.push(b as u16);
      i++;
      continue;
    }
    let len: usize = 1;
    let c: u32 = 0xfffd;
    if (b >= 0xc0 && b <= 0xdf) {
      len = 2;
      c = b & 0x1f;
    } else if (b >= 0xe0 && b <= 0xef) {
      len = 3;
      c = b & 0x0f;
    } else if (b >= 0xf0 && b <= 0xf7) {
      len = 4;
      c = b & 0x07;
    }
    for (let k: usize = 1; k < len; k++) {
      const cont = i + k < n ? (strByteAt(src, (i + k) as u64) as u32) : 0x80;
      c = (c << 6) | (cont & 0x3f);
    }
    i += len;
    if (c >= 0x10000) {
      const d = c - 0x10000;
      out.push((0xd800 | (d >> 10)) as u16);
      out.push((0xdc00 | (d & 0x3ff)) as u16);
    } else {
      out.push(c as u16);
    }
  }
  return out;
}

function isHex(c: i64): bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102);
}

// V8's parser over the text's units. A failing method returns false with the position in `i`
// and V8's message in `msg` ("": the message is picked from the character at `i`).
class NodeSyntax {
  s: u16[];
  i: i64 = 0;
  msg: string = "";

  constructor(s: u16[]) {
    this.s = s;
  }

  // The unit at `i`, or `END`.
  cur(): i64 {
    return this.i < (this.s.length as i64) ? (this.s[this.i as usize] as i64) : END;
  }

  isDigit(): bool {
    const c = this.cur();
    return c >= 48 && c <= 57;
  }

  skipWs(): void {
    while (true) {
      const c = this.cur();
      if (c != 32 && c != 9 && c != 10 && c != 13) {
        return;
      }
      this.i++;
    }
  }

  fail(msg: string): bool {
    this.msg = msg;
    return false;
  }

  // Skips whitespace, then consumes `c` or fails with `msg`.
  expect(c: i64, msg: string): bool {
    this.skipWs();
    if (this.cur() != c) {
      return this.fail(msg);
    }
    this.i++;
    return true;
  }

  // A property name and its `:` (`msg` when the name is missing).
  key(msg: string): bool {
    return this.expect(34, msg) && this.string() && this.expect(58, COLON);
  }

  // One value surrounded by whitespace (V8's `ParseJsonValue`, iterative like it): whether the
  // text is JSON. `stack` holds the open containers, true for an object.
  document(): bool {
    const stack: bool[] = [];
    while (true) {
      // Produce a value; an opened container continues with its first element or key.
      this.skipWs();
      const c = this.cur();
      if (c == 34) {
        this.i++;
        if (!this.string()) {
          return false;
        }
      } else if (c == 45 || (c >= 48 && c <= 57)) {
        if (!this.number()) {
          return false;
        }
      } else if (c == 123) {
        this.i++;
        this.skipWs();
        if (this.cur() == 125) {
          this.i++;
        } else {
          stack.push(true);
          if (!this.key(PROP_NAME_OR_RBRACE)) {
            return false;
          }
          continue;
        }
      } else if (c == 91) {
        this.i++;
        this.skipWs();
        if (this.cur() == 93) {
          this.i++;
        } else {
          stack.push(false);
          continue;
        }
      } else if (c == 116) {
        if (!this.literal("true")) {
          return false;
        }
      } else if (c == 102) {
        if (!this.literal("false")) {
          return false;
        }
      } else if (c == 110) {
        if (!this.literal("null")) {
          return false;
        }
      } else {
        return this.fail("");
      }
      // The value is done: continue the container it is in.
      let more = false;
      while (!more) {
        this.skipWs();
        if (stack.length == 0) {
          return this.cur() == END || this.fail(TRAILING_TEXT);
        }
        const object = stack[stack.length - 1];
        if (this.cur() == 44) {
          this.i++;
          if (object && !this.key(DOUBLE_QUOTED_NAME)) {
            return false;
          }
          more = true;
        } else if (this.cur() != (object ? 125 : 93)) {
          return this.fail(object ? COMMA_OR_RBRACE : COMMA_OR_RBRACK);
        } else {
          this.i++;
          stack.pop();
        }
      }
    }
  }

  // The rest of a string after its opening quote.
  string(): bool {
    while (true) {
      const c = this.cur();
      if (c == END) {
        return this.fail(UNTERMINATED_STRING);
      }
      if (c == 34) {
        this.i++;
        return true;
      }
      if (c == 92) {
        this.i++;
        const e = this.cur();
        if (e == END) {
          return this.fail("");
        }
        if (
          e == 34 || e == 92 || e == 47 || e == 98 || e == 102 || e == 110 || e == 114 || e == 116
        ) {
          this.i++;
        } else if (e == 117) {
          this.i++;
          for (let k = 0; k < 4; k++) {
            if (!isHex(this.cur())) {
              return this.fail(BAD_UNICODE);
            }
            this.i++;
          }
        } else if (e >= 0x100) {
          // V8 names only a Latin-1 character as a bad escape.
          return this.fail("");
        } else {
          return this.fail(BAD_ESCAPE);
        }
      } else if (c < 0x20) {
        return this.fail(BAD_CONTROL);
      } else {
        this.i++;
      }
    }
  }

  digits(): void {
    while (this.isDigit()) {
      this.i++;
    }
  }

  number(): bool {
    if (this.cur() == 45) {
      this.i++;
    }
    if (this.cur() == 48) {
      this.i++;
      if (this.isDigit()) {
        return this.fail("");
      }
    } else {
      if (!this.isDigit()) {
        return this.fail(NO_NUMBER_AFTER_MINUS);
      }
      this.digits();
    }
    if (this.cur() == 46) {
      this.i++;
      if (!this.isDigit()) {
        return this.fail(UNTERMINATED_FRACTION);
      }
      this.digits();
    }
    if (this.cur() == 101 || this.cur() == 69) {
      this.i++;
      if (this.cur() == 43 || this.cur() == 45) {
        this.i++;
      }
      if (!this.isDigit()) {
        return this.fail(EXPONENT_MISSING);
      }
      this.digits();
    }
    return true;
  }

  // `true`, `false` or `null` (the first character already matched): the first character that
  // differs is unexpected.
  literal(word: string): bool {
    this.i++;
    for (let k: i64 = 1; k < (word.length as i64); k++) {
      if (this.cur() != word.charCodeAt(k)) {
        return this.fail("");
      }
      this.i++;
    }
    return true;
  }

  // The text of the V8 `SyntaxError` for the failure (`src` is the text the units are of).
  render(src: string): string {
    const pos = this.i;
    if (this.msg.length > 0) {
      return `${this.msg}${this.at()}`;
    }
    const c = this.cur();
    if (c == END) {
      return "Unexpected end of JSON input";
    }
    if (c == 45 || (c >= 48 && c <= 57)) {
      return `Unexpected number in JSON${this.at()}`;
    }
    if (c == 34) {
      return `Unexpected string in JSON${this.at()}`;
    }
    if (src == "[object Object]" || src == "undefined" || src == "Infinity" || src == "NaN") {
      return `"${src}" is not valid JSON`;
    }
    const token = String.fromCharCode(c as f64);
    const len = this.s.length as i64;
    if (len < SHORT_TEXT) {
      return `Unexpected token '${token}', "${src}" is not valid JSON`;
    }
    if (pos < CONTEXT) {
      return `Unexpected token '${token}', "${src.substring(0, pos + CONTEXT)}"... is not valid JSON`;
    }
    if (pos < len - CONTEXT) {
      const t = src.substring(pos - CONTEXT, pos + CONTEXT);
      return `Unexpected token '${token}', ..."${t}"... is not valid JSON`;
    }
    return `Unexpected token '${token}', ..."${src.substring(pos - CONTEXT)}" is not valid JSON`;
  }

  // ` at position P (line L column C)`: V8's line and column of the failure (both from 1;
  // `\r\n`, `\r` and `\n` end a line).
  at(): string {
    const pos = this.i;
    let line: i64 = 1;
    let lineStart: i64 = 0;
    let k: i64 = 0;
    while (k < pos) {
      const u = this.s[k as usize];
      if (u == 13 && k + 1 < pos && this.s[(k + 1) as usize] == 10) {
        k++;
      }
      const v = this.s[k as usize];
      if (v == 13 || v == 10) {
        line++;
        lineStart = k + 1;
      }
      k++;
    }
    return ` at position ${pos} (line ${line} column ${1 + pos - lineStart})`;
  }
}
