// velt/encoding (internal): lowercase hex encoding and decoding of either case, sixteen bytes at a
// time with SIMD vectors.

import { HEX_VALUES } from "velt/encoding/tables";
import { unfilled } from "velt/encoding/base64";
import { EncodingError } from "velt/encoding/errors";
import {
  velt_rt_bytes_from_str,
  velt_simd_mask8x16_all,
  velt_simd_mask8x16_or,
  velt_simd_u16x8_and,
  velt_simd_u16x8_narrow,
  velt_simd_u16x8_or,
  velt_simd_u16x8_shl,
  velt_simd_u16x8_shr,
  velt_simd_u16x8_splat,
  velt_simd_u8x16_add,
  velt_simd_u8x16_and,
  velt_simd_u8x16_as_u16x8,
  velt_simd_u8x16_gt,
  velt_simd_u8x16_le,
  velt_simd_u8x16_load,
  velt_simd_u8x16_or,
  velt_simd_u8x16_select,
  velt_simd_u8x16_shr,
  velt_simd_u8x16_splat,
  velt_simd_u8x16_store,
  velt_simd_u8x16_sub,
  velt_simd_u8x16_zip_high,
  velt_simd_u8x16_zip_low,
} from "velt/encoding/rt";
import { validToString } from "velt/encoding/utf8";

// Marks a byte that is not a digit in the decode tables.
const INVALID: u8 = 0xff;

/** Lowercase hex, two digits per byte. */
export function hexEncode(data: u8[]): string {
  const n = data.length;
  // Sized once and written by index: the SIMD stores and the loop after them write every byte.
  const out = unfilled(n * 2);
  let i: usize = 0;
  // Sixteen bytes per step: each half byte becomes its digit (`0` + n, or `a` - 10 + n past 9),
  // and the digits of the high and low halves are written in turn.
  const nine = velt_simd_u8x16_splat(9);
  const digit = velt_simd_u8x16_splat(48);
  const letter = velt_simd_u8x16_splat(87);
  while (i + 16 <= n) {
    const v = velt_simd_u8x16_load(data, i as u64);
    const high = hexDigits(velt_simd_u8x16_shr(v, 4), nine, digit, letter);
    const low = hexDigits(velt_simd_u8x16_and(v, velt_simd_u8x16_splat(15)), nine, digit, letter);
    velt_simd_u8x16_store(velt_simd_u8x16_zip_low(high, low), out, (i * 2) as u64);
    velt_simd_u8x16_store(velt_simd_u8x16_zip_high(high, low), out, (i * 2 + 16) as u64);
    i += 16;
  }
  while (i < n) {
    const high = data[i] >> 4;
    const low = data[i] & 15;
    out[i * 2] = high + (high > 9 ? 87 : 48);
    out[i * 2 + 1] = low + (low > 9 ? 87 : 48);
    i++;
  }
  return validToString(out);
}

// The hex digits of sixteen values below 16.
function hexDigits(v: u8x16, nine: u8x16, digit: u8x16, letter: u8x16): u8x16 {
  return velt_simd_u8x16_add(v, velt_simd_u8x16_select(velt_simd_u8x16_gt(v, nine), letter, digit));
}

/**
 * Decodes hex digits (either case). Throws `EncodingError` on odd length or a non-hex character.
 */
export function hexDecode(s: string): u8[] {
  if (s.length == 0) {
    return [];
  }
  const text = velt_rt_bytes_from_str(s);
  if (text.length % 2 != 0) {
    throw new EncodingError("Invalid hex: odd length");
  }
  const out = unfilled(text.length / 2);
  let i: usize = 0;
  // 32 digits per step. A vector with a character that is not a digit ends the steps: the
  // loop below finds which one it is.
  while (i + 32 <= text.length) {
    const first = hexPairs(velt_simd_u8x16_load(text, i as u64));
    const second = hexPairs(velt_simd_u8x16_load(text, (i + 16) as u64));
    if (!(first.ok && second.ok)) {
      break;
    }
    velt_simd_u8x16_store(velt_simd_u16x8_narrow(first.bytes, second.bytes), out, (i / 2) as u64);
    i += 32;
  }
  while (i < text.length) {
    const hi = HEX_VALUES[text[i] as usize];
    const lo = HEX_VALUES[text[i + 1] as usize];
    if (hi == INVALID || lo == INVALID) {
      throw new EncodingError(`Invalid hex character at offset ${hi == INVALID ? i : i + 1}`);
    }
    out[i / 2] = (hi << 4) | lo;
    i += 2;
  }
  return out;
}

// Sixteen hex digits as eight bytes, one per 16-bit lane, and whether all sixteen were digits.
type HexPairs = { bytes: u16x8; ok: bool };

function hexPairs(c: u8x16): HexPairs {
  // `0`..`9` are 0..9 after subtracting `0`; a letter of either case is 0..5 after setting
  // the lower-case bit and subtracting `a`. Anything else is past those ranges (wrapping).
  const digit = velt_simd_u8x16_sub(c, velt_simd_u8x16_splat(48));
  const isDigit = velt_simd_u8x16_le(digit, velt_simd_u8x16_splat(9));
  const letter = velt_simd_u8x16_sub(
    velt_simd_u8x16_or(c, velt_simd_u8x16_splat(0x20)),
    velt_simd_u8x16_splat(97),
  );
  const isLetter = velt_simd_u8x16_le(letter, velt_simd_u8x16_splat(5));
  const value = velt_simd_u8x16_select(
    isDigit,
    digit,
    velt_simd_u8x16_add(letter, velt_simd_u8x16_splat(10)),
  );
  // A pair of values as one 16-bit lane has the first digit's in its low byte.
  const pairs = velt_simd_u8x16_as_u16x8(value);
  const low = velt_simd_u16x8_and(pairs, velt_simd_u16x8_splat(0xff));
  const bytes = velt_simd_u16x8_or(velt_simd_u16x8_shl(low, 4), velt_simd_u16x8_shr(pairs, 8));
  return { bytes, ok: velt_simd_mask8x16_all(velt_simd_mask8x16_or(isDigit, isLetter)) };
}
