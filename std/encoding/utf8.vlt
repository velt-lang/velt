// std/encoding/utf8 (std-internal): UTF-8 validation in Velt, skipping ASCII sixteen and 64
// bytes at a time with SIMD vectors. `utf8Valid` (std/encoding) and the WebSocket reader's check
// of text that arrives in pieces (std/websocket/bytes) use it.

// The SIMD operations used below (`velt:simd`, std/simd/*.vlt, is the API; declared again here
// so that this module does not load it). `load` does not check its range.
declare function velt_simd_u8x16_splat(x: u8): u8x16;
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_or(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_u8x16_ge(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_mask8x16_any(m: mask8x16): bool;
declare function velt_simd_mask8x16_first(m: mask8x16): u64;

/**
 * How many of the bytes in [start, end) are well-formed UTF-8: all of them, fewer when they end
 * inside a character (more bytes may complete it), or -1 when they hold a sequence that no
 * continuation can make valid. Positions past the array's length count as its length.
 */
export function validPrefix(data: u8[], start: usize, end: usize): i64 {
  const stop = end < data.length ? end : data.length;
  if (start >= stop) {
    return 0;
  }
  const high = velt_simd_u8x16_splat(0x80);
  let i = start;
  while (i < stop) {
    if (data[i] < 0x80) {
      i = asciiEnd(data, i + 1, stop, high);
      continue;
    }
    const len = sequenceLength(data, i, stop);
    if (len < 0) {
      return -1;
    }
    if (len == 0) {
      return (i - start) as i64;
    }
    i += len as usize;
  }
  return (stop - start) as i64;
}

// The position of the first byte in [from, stop) that is not ASCII (`high`: sixteen 0x80), or
// `stop`. Most text is ASCII: 64 bytes per step with one test, then 16, then single bytes.
function asciiEnd(data: u8[], from: usize, stop: usize, high: u8x16): usize {
  let i = from;
  while (i + 64 <= stop) {
    const a = velt_simd_u8x16_or(
      velt_simd_u8x16_load(data, i as u64),
      velt_simd_u8x16_load(data, (i + 16) as u64),
    );
    const b = velt_simd_u8x16_or(
      velt_simd_u8x16_load(data, (i + 32) as u64),
      velt_simd_u8x16_load(data, (i + 48) as u64),
    );
    if (velt_simd_mask8x16_any(velt_simd_u8x16_ge(velt_simd_u8x16_or(a, b), high))) {
      break;
    }
    i += 64;
  }
  while (i + 16 <= stop) {
    const m = velt_simd_u8x16_ge(velt_simd_u8x16_load(data, i as u64), high);
    if (velt_simd_mask8x16_any(m)) {
      return i + (velt_simd_mask8x16_first(m) as usize);
    }
    i += 16;
  }
  while (i < stop && data[i] < 0x80) {
    i++;
  }
  return i;
}

// Length of the well-formed sequence starting at `i` (a byte that is not ASCII), 0 when `stop`
// cuts it off with the bytes before it valid, or -1 when it is invalid. Follows Unicode Table
// 3-7 (well-formed sequences): a byte is judged as soon as it is read, as `str::from_utf8` does.
function sequenceLength(data: u8[], i: usize, stop: usize): i64 {
  const b0 = data[i];
  let need: usize = 0;
  let lo: u8 = 0x80;
  let hi: u8 = 0xbf;
  if (b0 >= 0xc2 && b0 <= 0xdf) {
    need = 1;
  } else if (b0 >= 0xe0 && b0 <= 0xef) {
    need = 2;
    lo = b0 == 0xe0 ? 0xa0 : 0x80;
    hi = b0 == 0xed ? 0x9f : 0xbf;
  } else if (b0 >= 0xf0 && b0 <= 0xf4) {
    need = 3;
    lo = b0 == 0xf0 ? 0x90 : 0x80;
    hi = b0 == 0xf4 ? 0x8f : 0xbf;
  } else {
    return -1;
  }
  for (let k: usize = 1; k <= need; k++) {
    if (i + k >= stop) {
      return 0;
    }
    const b = data[i + k];
    if (b < lo || b > hi) {
      return -1;
    }
    lo = 0x80;
    hi = 0xbf;
  }
  return (need + 1) as i64;
}
