// velt/half (internal): `f16[]` and `bf16[]` widened to `f32[]`, exactly.
//
// Plain loops over the conversion that LLVM vectorizes: `fcvtl` on arm64, `vcvtph2ps` on x86
// with F16C (`--cpu x86-64-v3` or `native`), and a branch-free integer sequence in SSE4.1 lanes
// on a default (x86-64-v2) build, with no run-time F16C dispatch yet (#2241). bf16 is a shift
// (and a NaN's quiet bit) on every target.
//
// The `…Into` functions stay out of line (`noInline()`): inlined into a caller's loop, the x86
// integer sequence's ten constants compete with the caller's registers, and the loop gains a
// register copy per instruction or so (11.5 instructions a value on x86-64-v2 against 8.75).

import { arraySetLen, arrayWithCapacity, noInline } from "velt/lang/intrinsics";

/** Each element of `ws` as an `f32`: exact, NaN payloads kept (their quiet bit set). */
export function widenF16(ws: f16[]): f32[] {
  const n = ws.length;
  const out: f32[] = arrayWithCapacity(n);
  arraySetLen(out, n);
  for (let i: usize = 0; i < n; i++) {
    out[i] = ws[i] as f32;
  }
  return out;
}

/**
 * Writes each element of `ws` as an `f32` to `xs[at..at + ws.length)`, allocating nothing.
 * Panics with a RangeError when that range passes the end of `xs`.
 */
export function widenF16Into(ws: f16[], xs: f32[], at: usize = 0) {
  noInline();
  const n = ws.length;
  intoRange(n, xs.length, at, "widenF16Into");
  for (let i: usize = 0; i < n; i++) {
    xs[at + i] = ws[i] as f32;
  }
}

/** Each element of `ws` as an `f32`: exact (a bf16 is an f32's top half). */
export function widenBf16(ws: bf16[]): f32[] {
  const n = ws.length;
  const out: f32[] = arrayWithCapacity(n);
  arraySetLen(out, n);
  for (let i: usize = 0; i < n; i++) {
    out[i] = ws[i] as f32;
  }
  return out;
}

/** As `widenF16Into`, for `bf16`. */
export function widenBf16Into(ws: bf16[], xs: f32[], at: usize = 0) {
  noInline();
  const n = ws.length;
  intoRange(n, xs.length, at, "widenBf16Into");
  for (let i: usize = 0; i < n; i++) {
    xs[at + i] = ws[i] as f32;
  }
}

/** A RangeError unless `n` elements from `at` fit in `len` (the `…Into` functions' check). */
export function intoRange(n: usize, len: usize, at: usize, what: string) {
  if (at > len || n > len - at) {
    panic(`RangeError: ${what}: ${n} values from index ${at} pass the end (length ${len})`);
  }
}
