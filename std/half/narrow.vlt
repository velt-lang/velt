// velt/half (internal): `f32[]` narrowed to `f16[]` and `bf16[]`, each value rounded once.
//
// Plain loops over the conversion that LLVM vectorizes: `fcvtn` on arm64, `vcvtps2ph` on x86
// with F16C (`--cpu x86-64-v3` or `native`), and a branch-free integer sequence in SSE4.1 lanes
// on a default (x86-64-v2) build, with no run-time F16C dispatch yet (#2241). From an `f32` one
// rounding to nearest even is exact, so there is no rounding to odd here.

import { arraySetLen, arrayWithCapacity, noInline } from "velt/lang/intrinsics";
import { intoRange } from "velt/half/widen";

/**
 * Each element of `xs` rounded to the nearest `f16` (ties to even; overflow to ±Infinity), NaN
 * payloads kept as far as they fit.
 */
export function narrowF16(xs: f32[]): f16[] {
  const n = xs.length;
  const out: f16[] = arrayWithCapacity(n);
  arraySetLen(out, n);
  for (let i: usize = 0; i < n; i++) {
    out[i] = xs[i] as f16;
  }
  return out;
}

/**
 * Writes each element of `xs`, rounded to `f16`, to `ws[at..at + xs.length)`, allocating
 * nothing. Panics with a RangeError when that range passes the end of `ws`.
 */
export function narrowF16Into(xs: f32[], ws: f16[], at: usize = 0) {
  noInline();
  const n = xs.length;
  intoRange(n, ws.length, at, "narrowF16Into");
  for (let i: usize = 0; i < n; i++) {
    ws[at + i] = xs[i] as f16;
  }
}

/** Each element of `xs` rounded to the nearest `bf16` (ties to even), NaN payloads kept. */
export function narrowBf16(xs: f32[]): bf16[] {
  const n = xs.length;
  const out: bf16[] = arrayWithCapacity(n);
  arraySetLen(out, n);
  for (let i: usize = 0; i < n; i++) {
    out[i] = xs[i] as bf16;
  }
  return out;
}

/** As `narrowF16Into`, for `bf16`. */
export function narrowBf16Into(xs: f32[], ws: bf16[], at: usize = 0) {
  noInline();
  const n = xs.length;
  intoRange(n, ws.length, at, "narrowBf16Into");
  for (let i: usize = 0; i < n; i++) {
    ws[at + i] = xs[i] as bf16;
  }
}
