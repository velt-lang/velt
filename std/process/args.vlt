// velt/process (internal): the command-line arguments (`argv`, `args`).

import { velt_rt_process_args } from "velt/process/rt";
import { arrayRemove } from "velt/lang/intrinsics";

/** Every command-line argument, starting with the program path (like C's `argv`). */
export function argv(): string[] {
  return velt_rt_process_args();
}

/** The arguments after the program path. */
export function args(): string[] {
  let all = velt_rt_process_args();
  if (all.length > 0) {
    arrayRemove(all, 0);
  }
  return all;
}
