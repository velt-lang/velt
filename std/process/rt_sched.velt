// velt/process (internal): the runtime functions velt/process calls, in a build compiled with the
// executor in Velt (`VELT_SCHEDULER=std`, #2649 step 4): the `std-scheduler` variant of
// `#process-rt` (std/imports.velt), with the names and signatures of the default variant
// (std/process/rt.velt). Reading standard input runs std's synchronous read
// (std/process/stdin_buffer.velt) on the executor's blocking pool
// (std/lang/hooks/sched_blocking.velt), which has threads on every OS a native build targets, and
// shares the input buffer with `readLineSync` and the rest. `readLine` takes even a line already
// buffered on the pool's thread.

import { hookCall } from "velt/lang/intrinsics";
import { StdinRead, readAll, readLine } from "./stdin_buffer";

export { velt_rt_process_args } from "./rt";

/** Standard input's next line, read on the blocking pool. */
export async function stdinReadLine(): Promise<StdinRead> {
  return await hookCall<StdinRead>("sched_blocking_run", () => readLine());
}

/** Standard input's rest, read on the blocking pool (`asText`: as text, else as bytes). */
export async function stdinReadAll(asText: bool): Promise<StdinRead> {
  return await hookCall<StdinRead>("sched_blocking_run", () => readAll(asText));
}
