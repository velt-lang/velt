// velt/process (internal): where std/process/args.velt keeps the arguments once read, on the
// targets with a C library (`#env-sys`' native and WASI variants re-export these; the browser's,
// std/process/env_wasm.velt, keeps none). A list is one block of the C library's: the number of
// arguments, then per argument its length word for `velt_rt_strbuf_push_bytes` (the bytes, and
// as many UTF-16 units again when it is ASCII) and its UTF-8, padded to 8 bytes. A read makes
// each string with the runtime's builder from those bytes, which are known to be well-formed:
// no decoding again. The block's address goes in a static atomic of a number, which costs a
// program less to compile than an `Atomic<shared<string[]>>`, whose loads bring the epoch
// reclaimer in. A published block lives as long as the process, outside the leak counters (as
// the weak core's memory, std/lang/hooks/weak_mem.velt).

import { Ptr } from "velt/ffi/ptr";
import {
  addressLoad,
  addressStore,
  arrayWithCapacity,
  noInline,
  ptrFromAddress,
  strByteLen,
  strDataAddress,
  strLen,
} from "velt/lang/intrinsics";

declare function velt_rt_strbuf_new(cap: u64, out: string);
declare function velt_rt_strbuf_push_bytes(buf: string, bytes: Ptr<u8>, len: u64);
declare function velt_rt_strbuf_finish(buf: string, out: string);

declare c("c") function calloc$argv(n: usize, size: usize): Ptr<u8> | null;
declare c("c") function free$argv(p: Ptr<u8> | null): void;
declare c("c") function memcpy$argv(
  dst: Ptr<u8> | null,
  src: Ptr<u8> | null,
  n: usize,
): Ptr<u8> | null;

/** `n` rounded up to a multiple of 8. */
function padded(n: usize): usize {
  return (n + 7) & ~(7 as usize);
}

/**
 * `list` in a new block, its address; 0 when the C library has no memory for it, or an argument
 * is longer than a length word holds (4 GiB: no OS passes one).
 */
export function keepArgs(list: string[]): usize {
  let n: usize = 8;
  for (let i: usize = 0; i < list.length; i++) {
    const len = strByteLen(list[i]);
    if (len > 0xffffffff) {
      return 0;
    }
    n += 8 + padded(len);
  }
  // SAFETY: calloc has no precondition; the result is checked.
  const p = unsafe { calloc$argv(1, n) };
  if (p === null) {
    return 0;
  }
  const at = Ptr.addressOf(p);
  // SAFETY: the block holds `n` bytes: the count, then each argument's word and padded bytes.
  unsafe {
    addressStore<usize>(at, list.length);
  }
  let to = at + 8;
  for (let i: usize = 0; i < list.length; i++) {
    const s = list[i];
    const len = strByteLen(s);
    const units = strLen(s) == len ? len : 0;
    // SAFETY: inside the block, as above.
    unsafe {
      addressStore<u64>(to, (len as u64) | ((units as u64) << 32));
    }
    if (len > 0) {
      // SAFETY: `len` bytes at `s`'s data address (well-formed: decoded text), room for them.
      unsafe {
        memcpy$argv(Ptr.orNull<u8>(to + 8), Ptr.orNull<u8>(strDataAddress(s)), len);
      }
    }
    to += 8 + padded(len);
  }
  return at;
}

/** A fresh array of the arguments in the block at `at` (`keepArgs`). */
@noInline
export function unpackArgs(at: usize): string[] {
  // SAFETY: a block of `keepArgs`', never freed once published.
  const count = unsafe { addressLoad<usize>(at) };
  const out = arrayWithCapacity<string>(count);
  let from = at + 8;
  for (let i: usize = 0; i < count; i++) {
    // SAFETY: inside the block (its layout above).
    const word = unsafe { addressLoad<u64>(from) };
    const len = (word & 0xffffffff) as usize;
    let buf = "";
    velt_rt_strbuf_new(len as u64, buf);
    if (len > 0) {
      // SAFETY: the block's `len` bytes of well-formed UTF-8 after the word, only read.
      const bytes = unsafe { ptrFromAddress<u8>(from + 8) };
      velt_rt_strbuf_push_bytes(buf, bytes, word);
    }
    let s = "";
    velt_rt_strbuf_finish(buf, s);
    out.push(s);
    from += 8 + padded(len);
  }
  return out;
}

/** Gives back the block at `at`, which was never published. */
export function releaseArgs(at: usize): void {
  // SAFETY: a block of `keepArgs`' that nothing else holds.
  unsafe {
    free$argv(Ptr.orNull<u8>(at));
  }
}
