// velt/process (internal): the environment's variables on Linux (`#env-sys`' linux
// variant, std/imports.velt): std/process/env_posix.velt, with the table at the C library's
// `environ`.

import { Ptr } from "velt/ffi/ptr";
import { ARGV_C, hiddenVar, SCRIPT_C, withoutHidden } from "./env_hidden";
import * as posix from "./env_posix";

export { executablePath, osArgs } from "./args_linux";
export { keepArgs, keptArg, keptCount, releaseArgs } from "./args_keep";

/** C's `char **environ`: the table of "name=value" strings (NULL after `clearenv`). */
declare c("c") let environ: Ptr<void> | null;

/** The address of the table's first entry, or 0. */
function table(): usize {
  // SAFETY: reads the variable; env_posix holds its lock while the table is in use.
  const at = unsafe { environ };
  return at === null ? 0 : Ptr.addressOf(at);
}

/** The variable `name`, or undefined when it isn't set or is one velt passes (env_hidden.velt). */
export function getEnv(name: string): string | undefined {
  return hiddenVar(name, false) ? undefined : posix.getEnv(name);
}

/** The variable `name` as it is, the hidden ones included. */
export function getEnvRaw(name: string): string | undefined {
  return posix.getEnv(name);
}

/**
 * `VELT_ARGV` (`argv`) or `VELT_SCRIPT`, which velt passes (std/process/args_read.velt), read
 * while the caller holds the environment's lock (`lockEnv`).
 */
export function passedVar(argv: bool): string | undefined {
  return argv ? posix.getEnvHeld(ARGV_C) : posix.getEnvHeld(SCRIPT_C);
}

/** The environment's lock, for the arguments' first read (env_posix.velt `lockEnv`). */
export function lockEnv() {
  posix.lockEnv();
}

/** Gives back the lock `lockEnv` took. */
export function unlockEnv() {
  posix.unlockEnv();
}

export function setEnv(name: string, value: string) {
  posix.setEnv(name, value);
}

export function removeEnv(name: string) {
  posix.removeEnv(name);
}

/** Every variable as `[name, value, …]`, in the table's order. */
export function envPairs(): string[] {
  return withoutHidden(posix.envPairs(table), false);
}
