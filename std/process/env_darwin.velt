// velt/process (internal): the environment's variables on macOS (`#env-sys`' darwin
// variant, std/imports.velt): std/process/env_posix.velt, with the table that `_NSGetEnviron()`
// points at (`environ` itself is only an executable's, not a library's, on macOS).

import { Ptr } from "velt/ffi/ptr";
import { addressLoad } from "velt/lang/intrinsics";
import { ARGV_C, hiddenVar, SCRIPT_C, withoutHidden } from "./env_hidden";
import * as posix from "./env_posix";

export { executablePath, osArgs } from "./args_darwin";
export { keepArgs, releaseArgs, unpackArgs } from "./args_keep";

/** `char ***_NSGetEnviron(void)` (<crt_externs.h>): where `environ` is. */
declare c("c") function _NSGetEnviron(): Ptr<void>;

/** The address of the table's first entry, or 0. */
function table(): usize {
  // SAFETY: no precondition; it returns the address of the process' `environ`.
  const at = Ptr.addressOf(unsafe { _NSGetEnviron() });
  // SAFETY: `at` holds `environ`, read while env_posix holds its lock.
  return unsafe { addressLoad<usize>(at) };
}

/** The variable `name`, or undefined when it isn't set or is one velt passes (env_hidden.velt). */
export function getEnv(name: string): string | undefined {
  return hiddenVar(name, false) ? undefined : posix.getEnv(name);
}

/** The variable `name` as it is, the hidden ones included. */
export function getEnvRaw(name: string): string | undefined {
  return posix.getEnv(name);
}

/** `VELT_ARGV` (`argv`) or `VELT_SCRIPT`, which velt passes (std/process/args.velt). */
export function passedVar(argv: bool): string | undefined {
  return argv ? posix.getEnvC(ARGV_C) : posix.getEnvC(SCRIPT_C);
}

export function setEnv(name: string, value: string) {
  posix.setEnv(name, value);
}

export function removeEnv(name: string) {
  posix.removeEnv(name);
}

/** Every variable as `[name, value, …]`, in the table's order. */
export function envPairs(): string[] {
  return withoutHidden(posix.envPairs(table), false);
}
