// velt/process (internal): the process's environment: its variables (`envAll`, `setEnv`,
// `removeEnv`) and working directory (`cwd`, `chdir`).

import { unwrapIo } from "velt/native/result";
import { checkIo } from "velt/native/status";
import {
  velt_rt_env_all,
  velt_rt_env_remove,
  velt_rt_env_set,
  velt_rt_process_chdir,
  velt_rt_process_cwd,
} from "velt/process/rt";

/**
 * Every environment variable, as a snapshot (Node's `process.env` as an object): names in the
 * order the OS keeps them, which is Node's order too. On Windows names keep their case, and
 * lookups in the record are case-sensitive (`process.env.NAME` is not); the per-drive `=C:`
 * entries are left out, as in Node.
 */
export function envAll(): Record<string, string> {
  const pairs = velt_rt_env_all();
  const all: Record<string, string> = {};
  for (let i: usize = 0; i + 1 < pairs.length; i += 2) {
    all[pairs[i]] = pairs[i + 1];
  }
  return all;
}

/**
 * Not synchronized with concurrent `process.env` reads on other threads: set variables at startup.
 */
export function setEnv(name: string, value: string) {
  velt_rt_env_set(name, value);
}

/** Removes the environment variable `name` (see `setEnv`). */
export function removeEnv(name: string) {
  velt_rt_env_remove(name);
}

/** The current working directory (throws `IoError`). */
export function cwd(): string {
  return unwrapIo(velt_rt_process_cwd());
}

/** Changes the current working directory of the whole process (throws `IoError`). */
export function chdir(path: string) {
  checkIo(velt_rt_process_chdir(path));
}
