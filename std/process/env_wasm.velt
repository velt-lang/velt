// velt/process (internal): the environment's variables in a WebAssembly build (`#env-sys`' default
// variant, std/imports.velt): the WebAssembly runtime's, which reads WASI's environment (empty in
// the browser). The working directory is `#cwd-sys`' (std/process/cwd_wasm.velt).

import { ARGV_VAR, hiddenVar, SCRIPT_VAR, withoutHidden } from "./env_hidden";

declare function velt_rt_env_get(name: string, out: string): bool;
declare function velt_rt_env_set(name: string, value: string);
declare function velt_rt_env_remove(name: string);
declare function velt_rt_env_all(): string[];

/** The variable `name`, or undefined when it isn't set or is one velt passes (env_hidden.velt). */
export function getEnv(name: string): string | undefined {
  return hiddenVar(name, false) ? undefined : getEnvRaw(name);
}

/** `VELT_ARGV` (`argv`) or `VELT_SCRIPT`, which velt passes (std/process/args.velt). */
export function passedVar(argv: bool): string | undefined {
  return getEnvRaw(argv ? ARGV_VAR : SCRIPT_VAR);
}

/** The variable `name` as it is, the hidden ones included. */
export function getEnvRaw(name: string): string | undefined {
  let out = "";
  if (velt_rt_env_get(name, out)) {
    return out;
  }
  return undefined;
}

export function setEnv(name: string, value: string) {
  velt_rt_env_set(name, value);
}

export function removeEnv(name: string) {
  velt_rt_env_remove(name);
}

/** The arguments the program was started with: a JS host passes none. */
export function osArgs(): string[] {
  return [];
}

/** The running program's path: none under a JS host. */
export function executablePath(): string {
  return "";
}

/**
 * Where std/process/args.velt keeps the arguments once read: nowhere here (the JS host has no C
 * library, and its list, read at each call, is the same two empty strings).
 */
export function keepArgs(list: string[]): usize {
  return 0;
}

/** Never called here: `keepArgs` keeps nothing. */
export function unpackArgs(at: usize): string[] {
  return [];
}

/** Never called here, as `unpackArgs`. */
export function releaseArgs(at: usize): void {}

/** Every variable as `[name, value, …]`. */
export function envPairs(): string[] {
  return withoutHidden(velt_rt_env_all(), false);
}
