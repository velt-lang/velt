// velt/process (internal): standard input: `Stdin` (for its `isTTY`), `stdin`, and reading it by
// lines or whole, as text or bytes (`readLine`, `lines`, `readAll`, `readAllBytes` and their
// `*Sync` twins).

import { unwrapIo } from "velt/native/result";
import { IoError } from "velt/io/error";
import {
  lineOf,
  velt_rt_isatty,
  velt_rt_stdin_read_all,
  velt_rt_stdin_read_all_bytes,
  velt_rt_stdin_read_all_bytes_sync,
  velt_rt_stdin_read_all_sync,
  velt_rt_stdin_read_line,
  velt_rt_stdin_read_line_sync,
} from "velt/process/rt";

/** Standard input, for its `isTTY` (read it with `readLine`, `lines` or `readAll`). */
export struct Stdin {
  /** Whether standard input is a terminal (Node's `process.stdin.isTTY`). Cached. */
  get isTTY(): bool {
    return velt_rt_isatty(0);
  }
}

/** Standard input (for `stdin.isTTY`). */
export const stdin: Stdin = {};

/** The next line without its "\n" / "\r\n", or null at end of input. */
export async function readLine(): Promise<string | null> {
  return lineOf(await velt_rt_stdin_read_line());
}

/** The remaining lines, as `readLine` reads them: `for await (const line of lines())`. */
export async function* lines(): AsyncGenerator<string, IoError> {
  while (true) {
    const r = await velt_rt_stdin_read_line();
    if (r.eof) {
      return;
    }
    yield unwrapIo(r.line);
  }
}

/** `readLine` that blocks the calling thread. */
export function readLineSync(): string | null {
  return lineOf(velt_rt_stdin_read_line_sync());
}

/** Everything left on standard input. */
export async function readAll(): Promise<string> {
  return unwrapIo(await velt_rt_stdin_read_all());
}

/** `readAll` that blocks the calling thread. */
export function readAllSync(): string {
  return unwrapIo(velt_rt_stdin_read_all_sync());
}

/** Everything left on standard input, as raw bytes (the runtime's read buffer, not a copy). */
export async function readAllBytes(): Promise<u8[]> {
  return unwrapIo(await velt_rt_stdin_read_all_bytes());
}

/** `readAllBytes` that blocks the calling thread. */
export function readAllBytesSync(): u8[] {
  return unwrapIo(velt_rt_stdin_read_all_bytes_sync());
}
