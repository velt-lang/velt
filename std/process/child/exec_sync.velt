// velt/process/child (internal): `execSync`'s start where no other variant of `#exec-sync`
// (std/imports.velt) runs it (WebAssembly): the runtime's `velt_rt_child_output_sync`. macOS and
// Linux start the child in std (exec_sync_posix.velt), Windows has its own (exec_sync_win32.velt).

import { IoResult } from "velt/native/result";
import { CommandSpec } from "velt/process/child/spec";
import { RawOutput, velt_rt_child_output_sync } from "./rt";

/** Runs `spec` to completion with `input`, blocking the calling thread. */
export function outputSync(spec: CommandSpec, input: string): IoResult<RawOutput> {
  return velt_rt_child_output_sync(spec, input);
}
