// velt/process/child (internal): the list of handles a child on Windows inherits
// (`PROC_THREAD_ATTRIBUTE_HANDLE_LIST` in `STARTUPINFOEXW`, std/process/child/spawn_win32.velt):
// with it a child inherits exactly the handles named, not every inheritable handle of this
// program (such as another child's pipe end made inheritable at the same moment on another
// thread).

import { Out } from "velt/ffi/out";
import { Ptr } from "velt/ffi/ptr";
import * as m from "velt/lang/hooks/sched_mem";
import { lastError } from "velt/process/child/pipes_win32";

/** C's opaque attribute list of `STARTUPINFOEXW`. */
declare c type _PROC_THREAD_ATTRIBUTE_LIST;

declare c("c") function InitializeProcThreadAttributeList(
  list: Ptr<_PROC_THREAD_ATTRIBUTE_LIST> | null,
  count: u32,
  flags: u32,
  size: Out<u64>,
): i32;
declare c("c") function UpdateProcThreadAttribute(
  list: Ptr<_PROC_THREAD_ATTRIBUTE_LIST>,
  flags: u32,
  attribute: u64,
  value: Ptr<void>,
  size: u64,
  previous: Ptr<void> | null,
  returned: Ptr<u64> | null,
): i32;
declare c("c") function DeleteProcThreadAttributeList(list: Ptr<_PROC_THREAD_ATTRIBUTE_LIST>): void;
declare c("c") function SetLastError(e: u32): void;

const PROC_THREAD_ATTRIBUTE_HANDLE_LIST: u64 = 0x20002;

/**
 * A `PROC_THREAD_ATTRIBUTE_HANDLE_LIST` of the `count` handles at `at` (which stay alive while
 * it is used): its block (its size, then the list at 8), or 0 on failure (`GetLastError`).
 */
export function handleList(at: usize, count: usize): usize {
  const size = new Out<u64>(0);
  // SAFETY: asks only for the size of a list of one attribute (and fails, saying so).
  unsafe {
    InitializeProcThreadAttributeList(null, 1, 0, size);
  }
  const n = size.value as usize;
  if (n === 0) {
    return 0;
  }
  const block = m.zeroed(n + 8);
  m.st(block, n);
  const list = m.ptrTo<_PROC_THREAD_ATTRIBUTE_LIST>(block + 8);
  // SAFETY: `n` bytes at `block + 8`, as asked for.
  if (unsafe { InitializeProcThreadAttributeList(list, 1, 0, size) } === 0) {
    m.release(block, n + 8);
    return 0;
  }
  let set: i32 = 0;
  // SAFETY: an initialized list; `count` handles at `at`, which outlive the list.
  unsafe {
    set = UpdateProcThreadAttribute(
      list,
      0,
      PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
      m.ptrTo<void>(at),
      8 * (count as u64),
      null,
      null,
    );
  }
  if (set === 0) {
    const e = lastError();
    freeList(block);
    // The error the caller reads is the update's, not one the clean-up left.
    // SAFETY: no precondition.
    unsafe {
      SetLastError(e);
    }
    return 0;
  }
  return block;
}

/** Deletes and frees a `handleList` block. */
export function freeList(block: usize): void {
  // SAFETY: an initialized list, not used after.
  unsafe {
    DeleteProcThreadAttributeList(m.ptrTo<_PROC_THREAD_ATTRIBUTE_LIST>(block + 8));
  }
  m.release(block, m.ld(block) + 8);
}
