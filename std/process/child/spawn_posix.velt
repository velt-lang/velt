// velt/process/child (internal): starting a child process with `posix_spawn` (macOS and Linux),
// for the executor in Velt's child processes (std/process/child/child_sched.velt, #2649 step 4):
// the program looked up in the child's `PATH` as libuv does (spawn_lookup.velt), its arguments
// and environment as C arrays, its working directory, its standard streams (inherited, piped, or
// the null device) and SIGPIPE back at its default (the runtime ignores it, as Rust programs do).
// On Linux a file the OS can't execute (`ENOEXEC`: no `#!` line) runs through `/bin/sh`, as Node
// runs it there (`throughShell`, `#script-shell`); on macOS it fails with ENOEXEC, as in Node.
//
// Pipes are close-on-exec from the start where the OS can (`pipe2` on Linux); on macOS, which
// can't, every child is spawned with `POSIX_SPAWN_CLOEXEC_DEFAULT` and keeps only the descriptors
// its file actions name (`#reactor`'s `pipeCloexec`, `SPAWN_FLAGS`, `spawnInherit`), so a pipe of
// another child spawned at the same time never reaches it (that child would never see its stdin
// end). The parent's end of each pipe is non-blocking, for the reactor; the child's end becomes
// the child's descriptor 0, 1 or 2 through a `dup2` file action (which clears the flag on the
// copy).
//
// The opaque C types (`posix_spawnattr_t`, `posix_spawn_file_actions_t`, `sigset_t`) live in
// zeroed blocks larger than any of these OSes needs.

import { CString } from "velt/ffi/c_string";
import { Ptr } from "velt/ffi/ptr";
import { utf8Encode } from "velt/encoding/utf8";
import { addressLoad, addressStore } from "velt/lang/intrinsics";
import * as r from "#reactor";
import { addOpen } from "#spawn-open";
import { ENOEXEC, SCRIPT_SHELL, SHELL } from "#script-shell";
import * as m from "velt/lang/hooks/sched_mem";
import * as wk from "velt/lang/hooks/sched_wake";
import { CommandSpec } from "velt/process/child/spec";
import { candidates, environment, lines, pathOf } from "velt/process/child/spawn_lookup";

// The headers' types (`velt native headers --std` checks this file:
// crates/veltc/src/native/headers/std_check.rs); `posix_spawn_file_actions_addopen`, whose
// `mode_t` differs between macOS and Linux, is `#spawn-open`'s.
/** C's `posix_spawn_file_actions_t`, `posix_spawnattr_t` and `sigset_t`, in `OPAQUE` rooms. */
declare c type posix_spawn_file_actions_t;
declare c type posix_spawnattr_t;
declare c type sigset_t;

declare c("c") function posix_spawn_file_actions_init(
  fa: Ptr<posix_spawn_file_actions_t> | null,
): i32;
declare c("c") function posix_spawn_file_actions_destroy(
  fa: Ptr<posix_spawn_file_actions_t> | null,
): i32;
declare c("c") function posix_spawn_file_actions_adddup2(
  fa: Ptr<posix_spawn_file_actions_t> | null,
  fd: i32,
  to: i32,
): i32;
declare c("c") function posix_spawn_file_actions_addchdir_np(
  fa: Ptr<posix_spawn_file_actions_t> | null,
  path: CString,
): i32;
declare c("c") function posix_spawnattr_init(attr: Ptr<posix_spawnattr_t> | null): i32;
declare c("c") function posix_spawnattr_destroy(attr: Ptr<posix_spawnattr_t> | null): i32;
declare c("c") function posix_spawnattr_setflags(
  attr: Ptr<posix_spawnattr_t> | null,
  flags: i16,
): i32;
declare c("c") function posix_spawnattr_setsigdefault(
  attr: Ptr<posix_spawnattr_t> | null,
  set: Ptr<sigset_t> | null,
): i32;
declare c("c") function posix_spawnattr_setsigmask(
  attr: Ptr<posix_spawnattr_t> | null,
  set: Ptr<sigset_t> | null,
): i32;
declare c("c") function sigemptyset(set: Ptr<sigset_t> | null): i32;
declare c("c") function sigaddset(set: Ptr<sigset_t> | null, sig: i32): i32;
// `argv` and `envp`: NULL-terminated arrays of NUL-terminated strings (`char *const []`).
declare c("c") function posix_spawn(
  pid: Ptr<i32> | null,
  path: CString,
  fa: Ptr<posix_spawn_file_actions_t> | null,
  attr: Ptr<posix_spawnattr_t> | null,
  argv: Ptr<Ptr<u8>> | null,
  envp: Ptr<Ptr<u8>> | null,
): i32;
declare c("c") function close$child(fd: i32): i32;
/** The address of a byte array's elements (a copy of nothing returns its destination). */
declare c("c") function memset$bytes(dst: u8[], c: i32, n: usize): Ptr<u8>;

/** Room for any of these OSes' opaque spawn types and `sigset_t`. */
const OPAQUE: usize = 512;
const POSIX_SPAWN_SETSIGDEF: i16 = 4;
const POSIX_SPAWN_SETSIGMASK: i16 = 8;
const SIGPIPE: i32 = 13;
const O_RDWR: i32 = 2;
const ENOENT: i32 = 2;
const EACCES: i32 = 13;
const ENOTDIR: i32 = 20;
/** `EINVAL`: a string holding a NUL (as Rust refuses it). */
export const EINVAL: i32 = 22;

/** A started child: its process id and the parent's end of each piped stream (-1: none). */
export class Started {
  /** 0 when it did not start; `error` says why. */
  pid: i32 = 0;
  error: i32 = 0;
  stdin: i32 = -1;
  stdout: i32 = -1;
  stderr: i32 = -1;
}

/** The address of `bytes`' first byte. */
function bytesAt(bytes: u8[]): usize {
  // SAFETY: a copy of nothing; `bytes` is borrowed for the call.
  return Ptr.addressOf(unsafe { memset$bytes(bytes, 0, 0) });
}

/** `s` as a NUL-terminated copy in raw memory (released by `freeArray`), or 0 if it holds a NUL. */
function cCopy(s: string): usize {
  const bytes = utf8Encode(s);
  if (bytes.includes(0)) {
    return 0;
  }
  const n = bytes.length;
  const p = m.alloc(n + 1);
  if (n > 0) {
    m.copy(p, bytesAt(bytes), n);
  }
  // SAFETY: `p` has `n + 1` bytes.
  unsafe {
    addressStore<u8>(p + n, 0);
  }
  return p;
}

/** A NULL-terminated C array of copies of `items`, or 0 when one holds a NUL. */
function cArray(items: string[]): usize {
  const a = m.zeroed(8 * (items.length + 1));
  for (let i: usize = 0; i < items.length; i++) {
    const p = cCopy(items[i]);
    if (p === 0) {
      freeCopies(a);
      m.release(a, 8 * (items.length + 1));
      return 0;
    }
    m.st(a + 8 * i, p);
  }
  return a;
}

/** The copies in `a` up to its first NULL, freed: how many there were. */
function freeCopies(a: usize): usize {
  let i: usize = 0;
  while (m.ld(a + 8 * i) !== 0) {
    const p = m.ld(a + 8 * i);
    let n: usize = 0;
    // SAFETY: a `cCopy`, NUL-terminated.
    while (unsafe { addressLoad<u8>(p + n) } !== 0) {
      n++;
    }
    m.release(p, n + 1);
    i++;
  }
  return i;
}

/** Frees a `cArray`. */
function freeArray(a: usize): void {
  const n = freeCopies(a);
  m.release(a, 8 * (n + 1));
}

/** Closes `fd` if it is one (not -1). */
export function closeFd(fd: i32): void {
  if (fd >= 0) {
    // SAFETY: a descriptor this module opened, not used after.
    unsafe {
      close$child(fd);
    }
  }
}

/**
 * Spawns `SHELL` to run `file` (the program found, which gave `ENOEXEC`) with `args`, as
 * `execvp` does: argv `[SHELL, file, …args]`, the same file actions, attributes and environment.
 * 0 with the process id in `pid`, or the error.
 */
function throughShell(
  pid: Ptr<i32> | null,
  file: string,
  args: string[],
  fa: Ptr<posix_spawn_file_actions_t> | null,
  attr: Ptr<posix_spawnattr_t> | null,
  env: Ptr<Ptr<u8>> | null,
): i32 {
  const argv: string[] = [SHELL, file];
  for (const a of args) {
    argv.push(a);
  }
  const cArgv = cArray(argv);
  if (cArgv === 0) {
    return EINVAL;
  }
  let rc: i32 = EINVAL;
  try {
    const shell = new CString(SHELL);
    // SAFETY: as in `start`: initialized file actions and attributes, a NULL-terminated `envp`;
    // `cArgv` is a NULL-terminated array of NUL-terminated strings, freed after.
    unsafe {
      rc = posix_spawn(pid, shell, fa, attr, m.ptrTo<Ptr<u8>>(cArgv), env);
    }
  } catch (e) {
    // `SHELL` holds no NUL.
  }
  freeArray(cArgv);
  return rc;
}

/**
 * Makes a pipe for the child's descriptor `target` (0 reads, 1 and 2 write) with `fa`'s `dup2`:
 * the parent's end, or -1 with `errno` set.
 */
function pipeFor(fa: usize, target: i32): i32 {
  const fds = m.zeroed(16);
  if (r.pipeCloexec(fds) !== 0) {
    m.release(fds, 16);
    return -1;
  }
  const readEnd = m.ld32(fds) as i32;
  const writeEnd = m.ld32(fds + 4) as i32;
  m.release(fds, 16);
  const child = target === 0 ? readEnd : writeEnd;
  const parent = target === 0 ? writeEnd : readEnd;
  r.prepare(parent);
  // SAFETY: `fa` is an initialized file-actions object.
  unsafe {
    posix_spawn_file_actions_adddup2(m.ptrTo<posix_spawn_file_actions_t>(fa), child, target);
  }
  // The child's end is the parent's to close once the child started: kept in the actions block's
  // tail (`OPAQUE` bytes on, one word per descriptor).
  m.st32(fa + OPAQUE + 4 * (target as usize), child as u32);
  return parent;
}

/**
 * Starts `spec` with stdio modes `modes` (`stdin | stdout << 2 | stderr << 4`; 0 inherit, 1
 * pipe, 2 the null device): the child's process id and the parent's ends of its pipes, or the
 * errno it failed with.
 */
export function start(spec: CommandSpec, modes: u32): Started {
  const out = new Started();
  const env = environment(spec);
  const paths = candidates(spec.program, pathOf(env));
  if (((modes >> 2) & 3) === 0 || ((modes >> 4) & 3) === 0) {
    // The child's output comes after what this program printed before starting it.
    wk.handOffOutput();
  }
  const argv: string[] = [spec.program];
  for (const a of spec.args) {
    argv.push(a);
  }
  const cArgv = cArray(argv);
  // Always a copy, made under velt/process' environment lock (`envPairs`, std/process/
  // env_posix.velt): C's own `environ` may be reallocated by another worker's `setEnv` while
  // `posix_spawn` reads it.
  const cEnv = cArray(lines(env));
  const files: CString[] = [];
  let devNull: CString | null = null;
  let cwd: CString | null = null;
  try {
    devNull = new CString("/dev/null");
    for (const p of paths) {
      files.push(new CString(p));
    }
    if (spec.cwd != "") {
      cwd = new CString(spec.cwd);
    }
  } catch (e) {
    out.error = EINVAL;
  }
  // A NUL in any of them (the cwd too: without it the child would run in this directory).
  if (
    cArgv === 0 ||
    cEnv === 0 ||
    files.length < paths.length ||
    devNull == null ||
    (spec.cwd != "" && cwd == null)
  ) {
    if (cArgv !== 0) {
      freeArray(cArgv);
    }
    if (cEnv !== 0) {
      freeArray(cEnv);
    }
    out.error = EINVAL;
    return out;
  }
  const fa = m.zeroed(OPAQUE + 16);
  const attr = m.zeroed(OPAQUE);
  const set = m.zeroed(OPAQUE);
  // Each child end -1 until a pipe makes one.
  for (let i: usize = 0; i < 3; i++) {
    m.st32(fa + OPAQUE + 4 * i, 0xffffffff);
  }
  // SAFETY: zeroed blocks larger than each opaque type, initialized before use and destroyed
  // after; the paths are NUL-terminated; `cArgv` and `cEnv` are NULL-terminated arrays of
  // NUL-terminated strings.
  unsafe {
    posix_spawn_file_actions_init(m.ptrTo<posix_spawn_file_actions_t>(fa));
    posix_spawnattr_init(m.ptrTo<posix_spawnattr_t>(attr));
    sigemptyset(m.ptrTo<sigset_t>(set));
    posix_spawnattr_setsigmask(m.ptrTo<posix_spawnattr_t>(attr), m.ptrTo<sigset_t>(set));
    sigaddset(m.ptrTo<sigset_t>(set), SIGPIPE);
    posix_spawnattr_setsigdefault(m.ptrTo<posix_spawnattr_t>(attr), m.ptrTo<sigset_t>(set));
    posix_spawnattr_setflags(
      m.ptrTo<posix_spawnattr_t>(attr),
      POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK | r.SPAWN_FLAGS,
    );
  }
  let failed = false;
  for (let i: i32 = 0; i < 3; i++) {
    const mode = (modes >> (2 * (i as u32))) & 3;
    if (mode === 1) {
      const parent = pipeFor(fa, i);
      if (parent < 0) {
        out.error = r.errno();
        failed = true;
        break;
      }
      if (i === 0) {
        out.stdin = parent;
      } else if (i === 1) {
        out.stdout = parent;
      } else {
        out.stderr = parent;
      }
    } else if (mode === 2) {
      addOpen(fa, i, devNull!, O_RDWR, 0);
    } else {
      r.spawnInherit(fa, i);
    }
  }
  if (!failed && cwd != null) {
    // SAFETY: as above.
    unsafe {
      posix_spawn_file_actions_addchdir_np(m.ptrTo<posix_spawn_file_actions_t>(fa), cwd);
    }
  }
  if (!failed) {
    const pid = m.zeroed(16);
    const pidAt = m.ptrTo<i32>(pid);
    const faAt = m.ptrTo<posix_spawn_file_actions_t>(fa);
    const attrAt = m.ptrTo<posix_spawnattr_t>(attr);
    const argvAt = m.ptrTo<Ptr<u8>>(cArgv);
    const envAt = m.ptrTo<Ptr<u8>>(cEnv);
    // Each candidate in turn, as libuv: the next one after ENOENT, ENOTDIR or EACCES (a
    // directory of that name, a file that isn't executable), EACCES at the end if one gave it.
    // A relative candidate resolves in the child's working directory, after the chdir.
    let rc: i32 = ENOENT;
    let denied = false;
    // The candidate tried last.
    let at: usize = 0;
    for (const file of files) {
      // SAFETY: as above; `pid` has room for a `pid_t`.
      unsafe {
        rc = posix_spawn(pidAt, file, faAt, attrAt, argvAt, envAt);
      }
      if (rc === EACCES) {
        denied = true;
      }
      if (rc !== ENOENT && rc !== ENOTDIR && rc !== EACCES) {
        break;
      }
      at++;
    }
    if (rc === ENOEXEC && SCRIPT_SHELL) {
      // On Linux, an executable without a `#!` line or a binary format is a script for
      // `/bin/sh` (glibc's `execvp`, which Node follows there): `/bin/sh <file> <args…>`.
      rc = throughShell(pidAt, paths[at], spec.args, faAt, attrAt, envAt);
    }
    if (rc !== 0 && denied && (rc === ENOENT || rc === ENOTDIR)) {
      rc = EACCES;
    }
    if (rc === 0) {
      out.pid = m.ld32(pid) as i32;
    } else {
      out.error = rc;
    }
    m.release(pid, 16);
  }
  for (let i: usize = 0; i < 3; i++) {
    closeFd(m.ld32(fa + OPAQUE + 4 * i) as i32);
  }
  if (out.pid === 0) {
    closeFd(out.stdin);
    closeFd(out.stdout);
    closeFd(out.stderr);
    out.stdin = -1;
    out.stdout = -1;
    out.stderr = -1;
  }
  // SAFETY: initialized above, not used after.
  unsafe {
    posix_spawn_file_actions_destroy(m.ptrTo<posix_spawn_file_actions_t>(fa));
    posix_spawnattr_destroy(m.ptrTo<posix_spawnattr_t>(attr));
  }
  m.release(fa, OPAQUE + 16);
  m.release(attr, OPAQUE);
  m.release(set, OPAQUE);
  freeArray(cArgv);
  freeArray(cEnv);
  return out;
}
