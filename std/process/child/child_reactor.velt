// velt/process/child (internal): the child-process functions on the executor in Velt
// (`VELT_SCHEDULER=std`, #2649 step 4), with the names and signatures of the runtime's
// (std/process/child/rt.velt), instead of tokio's `process`. The `std-scheduler` variant of
// `#child-rt` (child_sched.velt) calls them by role (`hookCall`, velt_common `std_hooks.rs`), so
// a program loads this module, and the executor with it, only when live code starts or uses a
// child (#2882). Each passes to its OS's (`#child-os`): `posix_spawn` with the exit and the pipes
// on the reactor on macOS and Linux (std/process/child/child_posix.velt), `CreateProcessW` with
// the exit wait and the pipes on the blocking pool on Windows (std/process/child/
// child_win32.velt).

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { CommandSpec } from "velt/process/child/spec";
import * as os from "#child-os";
import { RawOutput } from "./rt";

export function velt_rt_child_spawn(spec: CommandSpec): IoResult<u64> {
  return os.velt_rt_child_spawn(spec);
}

export function velt_rt_child_pid(c: u64): u32 {
  return os.velt_rt_child_pid(c);
}

export function velt_rt_child_exit_code(c: u64): i64 {
  return os.velt_rt_child_exit_code(c);
}

export async function velt_rt_child_wait(c: u64): Promise<IoResult<i32>> {
  return await os.velt_rt_child_wait(c);
}

export function velt_rt_child_kill(c: u64, signal: i32): IoStatus {
  return os.velt_rt_child_kill(c, signal);
}

export function velt_rt_child_close(c: u64) {
  os.velt_rt_child_close(c);
}

export async function velt_rt_child_read(c: u64, which: u32, max: u64): Promise<IoResult<u8[]>> {
  return await os.velt_rt_child_read(c, which, max);
}

export async function velt_rt_child_read_string(
  c: u64,
  which: u32,
  max: u64,
): Promise<IoResult<string>> {
  return await os.velt_rt_child_read_string(c, which, max);
}

export async function velt_rt_child_write(c: u64, data: string): Promise<IoStatus> {
  return await os.velt_rt_child_write(c, data);
}

export async function velt_rt_child_close_stdin(c: u64): Promise<IoStatus> {
  return await os.velt_rt_child_close_stdin(c);
}

export async function velt_rt_child_output(
  spec: CommandSpec,
  input: string,
): Promise<IoResult<RawOutput>> {
  return await os.velt_rt_child_output(spec, input);
}
