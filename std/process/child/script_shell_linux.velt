// velt/process/child (internal): `#script-shell` on Linux, where Node (libuv through glibc's
// `execvp`) runs an executable without a `#!` line through `/bin/sh`. (musl's `execvp` doesn't,
// but Velt targets glibc only.)

/** Does a program that fails to start with ENOEXEC run again as `SHELL <file> <args…>`? */
export const SCRIPT_SHELL: bool = true;
/** `ENOEXEC` (8 on macOS and Linux): a file the OS can't execute. */
export const ENOEXEC: i32 = 8;
/** The shell that runs an executable without a `#!` line. */
export const SHELL = "/bin/sh";
