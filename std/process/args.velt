// velt/process (internal): the command-line arguments (`argv`, `args`), read once per process
// and kept by std/lang/hooks/process_argv.velt (the readers: std/process/args_read.velt); Node's
// `process.argv` is std/lang/hooks/process.velt's `processArgv`.

import { arrayRemove } from "velt/lang/intrinsics";
import { argList } from "velt/lang/hooks/process";

/** Every command-line argument, starting with the program path (like C's `argv`). */
export function argv(): string[] {
  return argList(false);
}

/** The arguments after the program path. */
export function args(): string[] {
  let all = argList(false);
  if (all.length > 0) {
    arrayRemove(all, 0);
  }
  return all;
}
