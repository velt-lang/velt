// velt/process (internal): the runtime functions velt/process calls (rt_abi_async.md §8) and the
// layouts they return.

import { StdinRead, readAll, readLine } from "./stdin_buffer";

export declare function velt_rt_process_args(): string[];

/** Standard input's next line, read on this thread (the async twin of std's `readLine`). */
export async function stdinReadLine(): Promise<StdinRead> {
  return readLine();
}

/** Standard input's rest, read on this thread (`asText`: as text, else as bytes). */
export async function stdinReadAll(asText: bool): Promise<StdinRead> {
  return readAll(asText);
}
