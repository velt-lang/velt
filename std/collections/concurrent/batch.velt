// velt/collections (internal): `ConcurrentMap.getManyInto`: many lookups at once, their descents
// interleaved.

import { ConcurrentMap } from "velt/collections/concurrent_map";
import {
  GROUP0,
  LEAF_BIT,
  LEAF_CAP,
  LEVEL_SHIFT,
  MAX_KEY,
  NODE,
  PAIRS,
  rangeError,
} from "velt/collections/concurrent/layout";
import { getWord } from "velt/collections/concurrent/ops";
import { isUnchanged, readVersion } from "velt/collections/concurrent/latch";
import { candidate, childWord } from "velt/collections/concurrent/search";

/**
 * Looks up `keys` (at most 64) together into `values`: where bit `i` of the result is set,
 * `values[i]` is the value of `keys[i]` (`values` grows to `keys.length` if shorter; its other
 * elements are unspecified). Unlike `BTreeMap.getMany`, which returns a new array, it fills the
 * caller's, so a loop of batches allocates nothing. Faster than one `get` per key when the map
 * is larger than the caches: the keys descend the tree in lockstep, and each prefetches its next
 * node while the others search theirs, so their cache misses overlap. For `u64` keys and values
 * only for now (other maps panic with a RangeError). Panics with a RangeError for more than 64
 * keys.
 */
export function getManyInto<K, V extends Frozen>(
  cm: ConcurrentMap<K, V>,
  keys: K[],
  values: V[],
): u64 {
  // The `u64` body, its elements converted where read and written (nothing at run time).
  if (typeIs<K, u64>()) {
    if (typeIs<V, u64>()) {
      if (keys.length > 64) {
        rangeError("getManyInto: at most 64 keys at once");
      }
      const n = keys.length;
      while (values.length < n) {
        values.push(asType<V>(0 as u64));
      }
      const all: u64 = n == 64 ? MAX_KEY : (1 << (n as u64)) - 1;
      // Per key: its node at `i`, the node's version at `n + i`, its next node at `2n + i`.
      const lanes: u64[] = [];
      lanes.reserve(3 * n);
      let failed: u64 = 0;
      const root = cm.root.load("acquire");
      const rb = root * NODE;
      let rv: u64 = 0;
      let levels: u64 = 0;
      if ((cm.w.length as u64) < NODE || rb > (cm.w.length as u64) - NODE) {
        failed = all;
      } else {
        rv = readVersion(cm, rb);
        levels = (cm.w[rb + 1].load("relaxed") >> LEVEL_SHIFT) & 255;
        if (cm.root.load("acquire") != root) {
          failed = all;
          levels = 0;
        }
      }
      // The key 2^64 - 1 is never held: its lane goes to `get`, which says so.
      for (let i = 0; i < n; i++) {
        if (asType<u64>(keys[i]) == MAX_KEY) {
          failed |= 1 << (i as u64);
        }
      }
      for (let i = 0; i < n; i++) {
        lanes.push(rb);
      }
      for (let i = 0; i < n; i++) {
        lanes.push(rv);
      }
      for (let i = 0; i < n; i++) {
        lanes.push(0);
      }
      for (let l: u64 = 0; l < levels; l++) {
        for (let i = 0; i < n; i++) {
          if (((failed >> (i as u64)) & 1) != 0) {
            continue;
          }
          const b = lanes[i];
          const c = cm.w[childWord(cm, b, asType<u64>(keys[i]))].load("relaxed");
          const cb = c * NODE;
          if (c >= cm.nodes || (cm.w.length as u64) < NODE || cb > (cm.w.length as u64) - NODE) {
            failed |= 1 << (i as u64);
            continue;
          }
          cm.w.prefetch(cb as usize);
          cm.w.prefetch((cb + GROUP0) as usize);
          lanes[2 * n + i] = cb;
        }
        // Validated in a second pass, once the prefetches have had time.
        for (let i = 0; i < n; i++) {
          if (((failed >> (i as u64)) & 1) != 0) {
            continue;
          }
          const cb = lanes[2 * n + i];
          const vc = readVersion(cm, cb);
          if (!isUnchanged(cm, lanes[i], lanes[n + i])) {
            failed |= 1 << (i as u64);
            continue;
          }
          lanes[i] = cb;
          lanes[n + i] = vc;
        }
      }
      // The leaves in two passes as well: each key's candidate slot and a prefetch of its pair,
      // then the pairs' loads and the checks.
      let slow: u64 = 0;
      for (let i = 0; i < n; i++) {
        if (((failed >> (i as u64)) & 1) != 0) {
          continue;
        }
        const b = lanes[i];
        const meta = cm.w[b + 1].load("relaxed");
        if ((meta & LEAF_BIT) == 0) {
          failed |= 1 << (i as u64);
          continue;
        }
        const cand = candidate(cm, b, asType<u64>(keys[i]));
        if (cand > LEAF_CAP) {
          slow |= 1 << (i as u64);
          continue;
        }
        const at = cand < LEAF_CAP ? b + PAIRS + 2 * cand : b + 1;
        cm.w.prefetch(at as usize);
        lanes[2 * n + i] = at;
      }
      let found: u64 = 0;
      for (let i = 0; i < n; i++) {
        if ((((failed | slow) >> (i as u64)) & 1) != 0) {
          continue;
        }
        const b = lanes[i];
        const at = lanes[2 * n + i];
        const key = cm.w[at].load("relaxed");
        const value = cm.w[at + 1].load("relaxed");
        if (!isUnchanged(cm, b, lanes[n + i])) {
          failed |= 1 << (i as u64);
          continue;
        }
        values[i] = asType<V>(value);
        found |= (at != b + 1 && key == asType<u64>(keys[i]) ? 1 : 0) << (i as u64);
      }
      // Keys a writer disturbed, or with a tag shared by two keys of their leaf: one by one.
      failed |= slow;
      while (failed != 0) {
        const i = failed.trailingZeros();
        failed &= failed - 1;
        const r = getWord(cm, asType<u64>(keys[i]), keys[i]);
        if (r != undefined) {
          values[i] = asType<V>(r);
          found |= 1 << (i as u64);
        }
      }
      return found;
    }
  }
  rangeError("getManyInto: for u64 keys and values only for now");
}
