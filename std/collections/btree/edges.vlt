// velt:collections/btree/edges: the smallest and the largest key of a `Pool`
// (velt:collections/btree/pool), internal.
//
// A node at the edge of the tree (the root, and the first and last node of each level) lacks a
// separator on one side, so the separators alone would give it no prefix: for keys that all
// share a long beginning (`user/…`, paths, URLs) its words would all be equal and every search
// would compare whole keys there. The smallest and the largest key stand in for the separators
// those nodes lack (`Pool.prefixFor`). That holds for keys between them, so every operation first
// places its key against them (`edgeOrder`): a lookup of a key outside answers at once, and an
// insert of one makes it the new smallest or largest first, giving the nodes along that edge
// their prefix again (`noteEdges`). A delete of the smallest or the largest leaves the edge
// prefixes as they are: a range that narrows keeps them true, if shorter than they could be.

import { F, Pool, Window } from "velt:collections/btree/pool";
import { slotAtRank } from "velt:collections/btree/leaf";

/**
 * Where `t` (window `win`) lies against the smallest and the largest key: -1 below the smallest,
 * 1 above the largest, 0 between them (or when the map is empty, or keys have no words: no prefix
 * to keep true). The windows settle it unless they tie.
 */
export function edgeOrder<K extends Comparable<K>, V>(p: Pool<K, V>, t: K, win: Window): i64 {
  if (!t.hasInlineKey() || p.minKey.length == 0) {
    return 0;
  }
  const [a, b] = win;
  if (a < p.minWindow[0]) {
    return -1;
  }
  if (a > p.maxWindow[0]) {
    return 1;
  }
  if (a == p.minWindow[0] || a == p.maxWindow[0]) {
    if (a == p.minWindow[0] && b <= p.minWindow[1] && t < p.minKey[0]) {
      return -1;
    }
    if (a == p.maxWindow[0] && b >= p.maxWindow[1] && p.maxKey[0] < t) {
      return 1;
    }
  }
  return 0;
}

/**
 * Before `key` goes in: makes it the smallest or the largest key when it is outside them (the
 * first key both), and gives the nodes along that edge their prefixes for the wider range.
 */
export function noteEdges<K extends Comparable<K>, V>(p: Pool<K, V>, key: K, win: Window) {
  if (p.minKey.length == 0) {
    p.minKey.push(key);
    p.maxKey.push(key);
    setWindows(p);
    return;
  }
  const at = edgeOrder(p, key, win);
  if (at < 0) {
    p.minKey[0] = key;
    setWindows(p);
    refreshEdge(p, false);
  } else if (at > 0) {
    p.maxKey[0] = key;
    setWindows(p);
    refreshEdge(p, true);
  }
}

/**
 * After a delete: the smallest and the largest key again from the edge leaves (the prefixes
 * stay, see above); none when the map is empty, whose leaf then has no prefix.
 */
export function afterRemove<K extends Comparable<K>, V>(p: Pool<K, V>) {
  if (p.size == 0) {
    p.minKey.truncate(0);
    p.maxKey.truncate(0);
    // The empty root leaf drops its prefix: the next key need not share it.
    if (p.inline()) {
      p.refreshLeafAt(p.root, 0);
    }
    return;
  }
  if (!p.fill[0].hasInlineKey()) {
    return;
  }
  const first = p.edgeLeaf(false);
  const last = p.edgeLeaf(true);
  p.minKey[0] = p.keyAt(slotAtRank(p, first, 0));
  p.maxKey[0] = p.keyAt(slotAtRank(p, last, p.leafCount(last) - 1));
  setWindows(p);
}

// The cached windows of the smallest and the largest key.
function setWindows<K extends Comparable<K>, V>(p: Pool<K, V>) {
  if (!p.fill[0].hasInlineKey()) {
    return;
  }
  const [a, b] = p.minKey[0].inlineWindow();
  p.minWindow[0] = a;
  p.minWindow[1] = b;
  const [c, d] = p.maxKey[0].inlineWindow();
  p.maxWindow[0] = c;
  p.maxWindow[1] = d;
}

// Gives the nodes along the left (or right) edge their words for the range the smallest (or
// largest) key now bounds: the path to the first (or last) leaf, recorded, each node refreshed.
function refreshEdge<K extends Comparable<K>, V>(p: Pool<K, V>, right: bool) {
  p.pathNodes.truncate(0);
  p.pathSlots.truncate(0);
  let node = p.root;
  for (let h = p.height; h > 0; h--) {
    const slot = right ? p.innerCount(node) : 0;
    p.pathNodes.push(node);
    p.pathSlots.push(slot);
    node = p.innerKids[(node as usize) * F + slot];
  }
  for (let d: usize = 0; d < (p.pathNodes.length as usize); d++) {
    p.refreshInner(p.pathNodes[d], p.fencesAt(d));
  }
  p.refreshLeaf(node, p.fencesAt(p.pathNodes.length as usize));
}

/** Whether `key` (window `win`) is the smallest or the largest key (windows first, then keys). */
export function isEdge<K extends Comparable<K>, V>(p: Pool<K, V>, key: K, win: Window): bool {
  if (!key.hasInlineKey() || p.minKey.length == 0) {
    return false;
  }
  const [a, b] = win;
  if (a == p.minWindow[0] && b == p.minWindow[1] && key.compareTo(p.minKey[0]) == 0) {
    return true;
  }
  return a == p.maxWindow[0] && b == p.maxWindow[1] && key.compareTo(p.maxKey[0]) == 0;
}
