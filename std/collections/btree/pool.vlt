// velt/collections (internal): the nodes of `BTreeMap` (velt/collections/btree_map), internal.
//
// A B+tree whose nodes live in flat pools, a struct of arrays, nodes linked by `u32` index:
// node `n`'s keys are slots `n * F .. n * F + F`. Leaves hold up to `CAP` entries and link to
// both neighbors; inner nodes hold up to `CAP` separators and `CAP + 1` children, every key of
// child `i` at least separator `i - 1` and below separator `i`. The leaf pools are in chunks of
// 256 leaves, so they grow without copying (and hold at most a chunk unused). A freed node goes on
// a free list. Leaf entries: velt/collections/btree/leaf; inserts: velt/collections/btree/insert;
// deletes: velt/collections/btree/remove; the smallest and largest key:
// velt/collections/btree/edges.
//
// A node's 32 `u16` words (`leafLines` / `innerLines`, 64 bytes, each in one cache line) are
// what a search reads first: slot `HEAD` holds the node's count and prefix, and the slots below
// it, for keys with an order-preserving encoding (velt/collections/btree/inline_key: numbers,
// `bool`, strings), two bytes of each key's encoding past the prefix all of the node's keys
// share (`prefixFor`); strings keep the next two in a second line next to it, a four-byte
// word in all. Vector compares count the words below the target's, which is its rank unless
// words tie with it; only those keys are compared in full. So a level of a lookup reads one line
// and one child index. Keys without an encoding are compared one by one.
//
// Unused key slots hold `fill[0]`, so that the pools stay arrays of plain `K`; value slots
// likewise (`vals`, with `valFill[0]`); unused word slots are `EMPTY`. A filler is the type's
// blank value (velt/mem `Blank`: `""`, a number), which owns no memory, or for a type without
// one a share of a live key or value. A deleted key or value is released: when a live
// filler's entry is deleted or its value replaced, a live entry from the middle of the tree
// gives new fillers (`refill`), a separator that is a deleted key that owns memory follows to
// the next key, and the last delete drops the pools (velt/collections/btree/remove).

import { Blank } from "velt/mem/blank";
import { needsDrop } from "velt/mem/needs_drop";
import { InlineKey } from "velt/collections/btree/inline_key";
import {
  countOf,
  EMPTY,
  emptyLine,
  fill,
  identityOrder,
  Line,
  Order,
  prefixOf,
  rankRange,
  rankRange2,
  withCount,
  withWord,
} from "velt/collections/btree/line";
import "velt/collections/btree/prefixes";
import "velt/collections/btree/slots";
import "velt/collections/btree/nodes";

/**
 * A node's range: the separators on either side of it, `null` at the edge of the tree. An
 * inline pair, so describing a range allocates nothing.
 */
export type Range<K> = [K | null, K | null];

/** Slots per node: words, keys and children. */
export const F: usize = 32;
/** The most keys a node holds: the last word slot is its header. */
export const CAP: usize = F - 1;
/** Leaves per chunk of the leaf pools (`leafKeys`, values, `leafLines`), as a shift and mask. */
export const LEAF_SHIFT: u32 = 8;
export const LEAF_MASK: u32 = 255;
/** Slots per chunk (`F` per leaf), as a shift and mask of a slot number. */
export const SLOT_SHIFT: usize = 13;
export const SLOT_MASK: usize = 8191;
/** No node: the ends of the leaf chain. */
export const NONE: u32 = 4294967295;
/** The longest node prefix looked for, in bytes. */
const MAX_PREFIX: usize = 2040;

export class Pool<K extends Comparable<K>, V> {
  /**
   * The leaves' keys, `F` slots a leaf, in chunks of 256 leaves (`LEAF_SHIFT`): slot `s` (`leaf * F +
   * i`) is `leafKeys[s >> SLOT_SHIFT][s & SLOT_MASK]`. A chunk grows only until it is full, so
   * the pools never copy their whole contents to grow, and hold at most one chunk unused.
   */
  leafKeys: K[][] = [];
  /**
   * The leaves' value slots, addressed like their keys, an unused slot holding a share of
   * `valFill[0]`, the first value stored (as unused key slots hold one of `fill[0]`): a removed
   * value is dropped when its slot gets the filler. Values that own nothing take their own size
   * per slot, objects a pointer.
   */
  vals: V[][] = [];
  valFill: V[] = [];
  /**
   * Each leaf's words and header (velt/collections/btree/line), 64 bytes: leaf `l`'s line is
   * `leafLines[l >> LEAF_SHIFT][(l & LEAF_MASK) << lineShift]`. Keys with wide words
   * (`InlineKey.inlineWide`) keep the next two bytes of each key past the word in a second line
   * right after it (`lineShift` 1), so a search loads both as one 128-byte block (arrays of whole
   * lines are 128-byte aligned): one cache line on CPUs with 128-byte lines, an adjacent pair
   * elsewhere.
   */
  leafLines: Line[][] = [];
  /** 1 when nodes keep two lines (wide words), else 0: set with the first key. */
  lineShift: usize = 0;
  /**
   * Each leaf's rank order (velt/collections/btree/line `Order`), chunked as the lines are. A
   * leaf's keys and values sit in physical slots in the order they came; `leafOrder` gives the
   * slot of each rank (velt/collections/btree/leaf).
   */
  leafOrder: Order[][] = [];
  /** 32 bytes for reading an order by rank (velt/collections/btree_map `ranks`). */
  orderScratch: u8[] = new Array<u8>(32).fill(0);
  /** More lines' words for editing (velt/collections/btree/leaf `moveRanks`). */
  scratch2: u16[] = new Array<u16>(32).fill(0);
  scratch3: u16[] = new Array<u16>(32).fill(0);
  scratch4: u16[] = new Array<u16>(32).fill(0);
  leafNext: u32[] = [];
  leafPrev: u32[] = [];
  innerKeys: K[] = [];
  /** Inner node `i`'s line is `innerLines[i << lineShift]`, a second as for leaves. */
  innerLines: Line[] = [];
  /** 32 words for editing a line (velt/collections/btree/line `spill` / `fill`). */
  scratch: u16[] = new Array<u16>(32).fill(0);
  innerKids: u32[] = [];
  freeLeaves: u32[] = [];
  freeInners: u32[] = [];
  fill: K[] = [];
  /**
   * The smallest and the largest key (one each, or none while empty), the separators the edges
   * of the tree lack (`prefixFor`), and the first 16 bytes of their encodings for a quick check
   * that a key lies between them (velt/collections/btree/edges).
   */
  minKey: K[] = [];
  /** The windows of a `getMany` batch (velt/collections/btree/leaf `descendMany`), two words each. */
  batchWindows: u64[] = new Array<u64>(32).fill(0);
  /** Two slots for `keySwap`'s (and `valSwap`'s) raw moves across chunks, empty between them. */
  maxKey: K[] = [];
  minWindow: u64[] = [0, 0];
  maxWindow: u64[] = [0, 0];
  root: u32 = 0;
  /** 0 while the root is a leaf. */
  height: u32 = 0;
  size: usize = 0;
  /** Counts changes to the set of keys: `forEach` seeks again when it moved. */
  edits: u64 = 0;
  /** The descent of the last `findLeaf`, root first: the inner nodes and the slot taken in each. */
  pathNodes: u32[] = [];
  pathSlots: usize[] = [];
  // Last, so that the fields every operation reads keep their places.
  /** The key of the entry a live filler is (`liveFill`), else empty. */
  fillOwner: K[] = [];

  // ─────────────── searching ───────────────

  /** How many keys of the node at `keys[base..]` (its words `line`) are at most `t`. */
  // The searches below compare words only for a target inside the node's range (between the
  // separators on either side of it), the only targets that share the node's prefix: the ones
  // a descent brings to the node.

  /** The child slot of inner `node` whose range holds `t`: its separators at most `t`. */
  innerSlot(node: u32, t: K, win: Window): usize {
    const i = (node as usize) << this.lineShift;
    const base = (node as usize) * F;
    let lo: usize = 0;
    let hi: usize = 0;
    if (t.hasInlineKey()) {
      // The word first, from the header alone, then the lines: nothing of them is live across
      // `quadIn`, which may call out, so they stay in registers.
      const pre = prefixOf(this.innerLines[i]) as usize;
      if (t.inlineWide()) {
        const q = quadIn(t, win, pre);
        const r = rankRange2(
          this.innerLines[i],
          this.innerLines[i + 1],
          countOf(this.innerLines[i]),
          (q >> 16) as u16,
          q as u16,
        );
        lo = r[0];
        hi = r[1];
      } else {
        const w = wordIn(t, win, pre);
        const r = rankRange(this.innerLines[i], countOf(this.innerLines[i]), w);
        lo = r[0];
        hi = r[1];
      }
      if (lo == hi) {
        return lo;
      }
    } else {
      hi = countOf(this.innerLines[i]);
    }
    // Ties (or keys without words): a binary search of the keys between.
    while (lo < hi) {
      const mid = lo + (hi - lo) / 2;
      // Keys with an encoding (no NaN among them) by `<`, one compare; others by `compareTo`,
      // which orders a float NaN.
      const k = this.innerKeys[base + mid];
      if (t.hasInlineKey() ? t < k : t.compareTo(k) < 0) {
        hi = mid;
      } else {
        lo = mid + 1;
      }
    }
    return lo;
  }

  // ─────────────── headers ───────────────

  /** How many entries `leaf` holds. */
  leafCount(leaf: u32): usize {
    return countOf(this.lineOf(leaf));
  }

  setLeafCount(leaf: u32, n: usize) {
    this.setLine(leaf, withCount(this.lineOf(leaf), n));
  }

  /** How many separators inner `node` holds. */
  innerCount(node: u32): usize {
    return countOf(this.innerLineOf(node));
  }

  setInnerCount(node: u32, n: usize) {
    this.setInnerLine(node, withCount(this.innerLineOf(node), n));
  }

  /**
   * The leaf whose range holds `t` (`win` its window), recording the descent in `pathNodes` /
   * `pathSlots`.
   */
  findLeaf(t: K, win: Window): u32 {
    this.pathNodes.truncate(0);
    this.pathSlots.truncate(0);
    let node = this.root;
    for (let h = this.height; h > 0; h--) {
      const slot = this.innerSlot(node, t, win);
      this.pathNodes.push(node);
      this.pathSlots.push(slot);
      node = this.innerKids[(node as usize) * F + slot];
    }
    return node;
  }

  /** The leaf whose range holds `t` (`win` its window), without recording the descent. */
  leafOf(t: K, win: Window): u32 {
    let node = this.root;
    for (let h = this.height; h > 0; h--) {
      node = this.innerKids[(node as usize) * F + this.innerSlot(node, t, win)];
    }
    return node;
  }

  /** The leftmost or rightmost leaf. */
  edgeLeaf(right: bool): u32 {
    let node = this.root;
    for (let h = this.height; h > 0; h--) {
      const slot = right ? this.innerCount(node) : 0;
      node = this.innerKids[(node as usize) * F + slot];
    }
    return node;
  }
}

/** The word of `k` in a node with prefix `pre`: the two bytes of its encoding past it. */
export function wordOf<T extends InlineKey>(k: T, pre: u32): u16 {
  return k.inlineWord(pre as usize);
}

/**
 * The first 16 bytes of `t`'s encoding (`inlineKey(0)`, `inlineKey(8)`), its "window": an
 * operation computes it once, and every node's word for `t` is a shift of it (`quadIn`), where
 * the prefix leaves it inside the 16 bytes. Zeros for keys without an encoding.
 */
export type Window = [u64, u64];

/** `t`'s window. */
export function windowOf<T extends InlineKey>(t: T): Window {
  if (!t.hasInlineKey()) {
    return [0, 0];
  }
  return t.inlineWindow();
}

/** Bytes `pre .. pre + 4` of `t`'s encoding (`inlineQuad`), from its window `win` up to byte 12. */
export function quadIn<T extends InlineKey>(t: T, win: Window, pre: usize): u32 {
  if (pre > 12) {
    return t.inlineQuad(pre);
  }
  const [hi, lo] = win;
  if (pre == 0) {
    return (hi >> 32) as u32;
  }
  if (pre < 8) {
    const s = (pre * 8) as u64;
    return (((hi << s) | (lo >> (64 - s))) >> 32) as u32;
  }
  return ((lo << (((pre - 8) * 8) as u64)) >> 32) as u32;
}

/** Bytes `pre .. pre + 2` of `t`'s encoding (`inlineWord`), from its window as `quadIn`. */
export function wordIn<T extends InlineKey>(t: T, win: Window, pre: usize): u16 {
  if (pre > 12) {
    return t.inlineWord(pre);
  }
  return (quadIn(t, win, pre) >> 16) as u16;
}

/** The second half of `k`'s wide word in a node with prefix `pre`: the two bytes after `wordOf`'s. */
export function wordOfB<T extends InlineKey>(k: T, pre: u32): u16 {
  return k.inlineWord((pre + 2) as usize);
}

/** The number of leading bytes the encodings of `a` and `b` share, at most 2040. */
export function commonPrefix<K extends InlineKey>(a: K, b: K): u32 {
  for (let off: usize = 0; off < MAX_PREFIX; off += 8) {
    const d = a.inlineKey(off) ^ b.inlineKey(off);
    if (d != 0) {
      // The equal leading bytes: leading zero bits of `d`, over 8.
      return (off + (d.leadingZeros() >> 3)) as u32;
    }
  }
  return MAX_PREFIX as u32;
}

/**
 * Moves `xs[from]` to `xs[to]`, whose value is about to be overwritten or is a filler: a swap,
 * so moving a string or an object costs no count changes.
 */
export function moveSlot<T>(xs: T[], to: usize, from: usize) {
  xs.swap(to, from);
}
