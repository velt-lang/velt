// velt:collections/btree/pool: the nodes of `BTreeMap` (velt:collections/btree_map), internal.
//
// A B+tree whose nodes live in flat pools, a struct of arrays, nodes linked by `u32` index:
// node `n`'s keys are slots `n * F .. n * F + F`. Leaves hold up to `CAP` entries and link to
// both neighbors; inner nodes hold up to `CAP` separators and `CAP + 1` children, every key of
// child `i` at least separator `i - 1` and below separator `i`. The leaf pools are in chunks of
// 256 leaves, so they grow without copying (and hold at most a chunk unused). A freed node goes on
// a free list. Leaf entries: velt:collections/btree/leaf; inserts: velt:collections/btree/insert;
// deletes: velt:collections/btree/remove; the smallest and largest key:
// velt:collections/btree/edges.
//
// A node's 32 `u16` words (`leafLines` / `innerLines`, 64 bytes, each in one cache line) are
// what a search reads first: slot `HEAD` holds the node's count and prefix, and the slots below
// it, for keys with an order-preserving encoding (velt:collections/btree/inline_key: numbers,
// `bool`, strings), two bytes of each key's encoding past the prefix all of the node's keys
// share (`prefixFor`); strings keep the next two in a second line (`leafLinesB`), a four-byte
// word in all. Vector compares count the words below the target's, which is its rank unless
// words tie with it; only those keys are compared in full. So a level of a lookup reads one line
// and one child index. Keys without an encoding are compared one by one.
//
// Unused key slots hold a share of `fill[0]`, the first key ever stored, so that the pools stay
// arrays of plain `K`; value slots of types that own nothing likewise (`valPlain`), others are
// `V | null`; unused word slots are `EMPTY`.

import { InlineKey } from "velt:collections/btree/inline_key";
import {
  EMPTY,
  Line,
  Order,
  identityOrder,
  countOf,
  emptyLine,
  fill,
  prefixOf,
  withCount,
  withWord,
  wordsAtMost,
  wordsAtMost2,
  wordsBelow,
  wordsBelow2,
} from "velt:collections/btree/line";

/**
 * A node's range: the separators on either side of it, `null` at the edge of the tree. An
 * inline pair, so describing a range allocates nothing.
 */
export type Range<K> = [K | null, K | null];

/** Slots per node: words, keys and children. */
export const F: usize = 32;
/** The most keys a node holds: the last word slot is its header. */
export const CAP: usize = F - 1;
/** Leaves per chunk of the leaf pools (`leafKeys`, values, `leafLines`), as a shift and mask. */
export const LEAF_SHIFT: u32 = 8;
export const LEAF_MASK: u32 = 255;
/** Slots per chunk (`F` per leaf), as a shift and mask of a slot number. */
export const SLOT_SHIFT: usize = 13;
export const SLOT_MASK: usize = 8191;
/** No node: the ends of the leaf chain. */
export const NONE: u32 = 4294967295;
/** The longest node prefix looked for, in bytes. */
const MAX_PREFIX: usize = 2040;

export class Pool<K extends Comparable<K>, V> {
  /**
   * The leaves' keys, `F` slots a leaf, in chunks of `CHUNK_LEAVES` leaves: slot `s` (`leaf * F +
   * i`) is `leafKeys[s >> SLOT_SHIFT][s & SLOT_MASK]`. A chunk grows only until it is full, so
   * the pools never copy their whole contents to grow, and hold at most one chunk unused.
   */
  leafKeys: K[][] = [];
  /**
   * The leaves' value slots, addressed like their keys. A value type that owns nothing (numbers,
   * `bool`, structs of them) keeps its values in `valPlain`, its own size per slot, an unused
   * slot holding `valFill[0]`, the first value stored: dropping such a value does nothing, so a
   * filler is never told from a value. Other value types keep `valOpt`, so a removed value is
   * dropped at once. Which one is a constant per instantiation (`plainVals`).
   */
  valPlain: V[][] = [];
  valOpt: (V | null)[][] = [];
  valFill: V[] = [];
  /** Each leaf's words and header, a cache line each (velt:collections/btree/line). */
  /** Leaf `l`'s line is `leafLines[l >> LEAF_SHIFT][l & LEAF_MASK]`. */
  leafLines: Line[][] = [];
  /**
   * For keys with wide words (`InlineKey.inlineWide`), the next two bytes of each key past the
   * word in `leafLines` / `innerLines`, chunked the same way; empty otherwise.
   */
  leafLinesB: Line[][] = [];
  /**
   * Each leaf's rank order (velt:collections/btree/line `Order`), chunked as the lines are. A
   * leaf's keys and values sit in physical slots in the order they came; `leafOrder` gives the
   * slot of each rank (velt:collections/btree/leaf).
   */
  leafOrder: Order[][] = [];
  /** 32 bytes for editing an order, and a second order and lines (velt:collections/btree/leaf). */
  orderScratch: u8[] = new Array<u8>(32).fill(0);
  orderScratch2: u8[] = new Array<u8>(32).fill(0);
  scratch2: u16[] = new Array<u16>(32).fill(0);
  scratch3: u16[] = new Array<u16>(32).fill(0);
  scratch4: u16[] = new Array<u16>(32).fill(0);
  leafNext: u32[] = [];
  leafPrev: u32[] = [];
  innerKeys: K[] = [];
  innerLines: Line[] = [];
  innerLinesB: Line[] = [];
  /** 32 words for editing a line (velt:collections/btree/line `spill` / `fill`). */
  scratch: u16[] = new Array<u16>(32).fill(0);
  innerKids: u32[] = [];
  freeLeaves: u32[] = [];
  freeInners: u32[] = [];
  fill: K[] = [];
  /**
   * The smallest and the largest key (one each, or none while empty), the separators the edges
   * of the tree lack (`prefixFor`), and the first 16 bytes of their encodings for a quick check
   * that a key lies between them (velt:collections/btree/edges).
   */
  minKey: K[] = [];
  maxKey: K[] = [];
  minWindow: u64[] = [0, 0];
  maxWindow: u64[] = [0, 0];
  root: u32 = 0;
  /** 0 while the root is a leaf. */
  height: u32 = 0;
  size: usize = 0;
  /** Counts changes to the set of keys: `forEach` seeks again when it moved. */
  edits: u64 = 0;
  /** The descent of the last `findLeaf`, root first: the inner nodes and the slot taken in each. */
  pathNodes: u32[] = [];
  pathSlots: usize[] = [];

  // ─────────────── searching ───────────────

  /** How many keys of the node at `keys[base..]` (its words `line`) are at most `t`. */
  countAtMost(keys: K[], line: Line, lineB: Line, base: usize, t: K): usize {
    const n = countOf(line);
    let lo: usize = 0;
    let hi = n;
    if (t.hasInlineKey()) {
      const pre = prefixOf(line);
      if (t.inlineWide()) {
        const q = t.inlineQuad(pre as usize);
        const w = (q >> 16) as u16;
        const wb = q as u16;
        lo = wordsBelow2(line, lineB, w, wb);
        hi = wordsAtMost2(line, lineB, n, w, wb);
      } else {
        const w = wordOf(t, pre);
        lo = wordsBelow(line, w);
        hi = wordsAtMost(line, n, w);
      }
    } else if (!__intrinsic_needs_drop(t)) {
      let c: usize = 0;
      for (let i: usize = 0; i < n; i++) {
        c += t < keys[base + i] ? 0 : 1;
      }
      return c;
    }
    while (lo < hi) {
      const mid = lo + (hi - lo) / 2;
      if (t < keys[base + mid]) {
        hi = mid;
      } else {
        lo = mid + 1;
      }
    }
    return lo;
  }

  // The searches below compare words only for a target inside the node's range (between the
  // separators on either side of it), the only targets that share the node's prefix: the ones
  // a descent brings to the node.

  /** The child slot of inner `node` whose range holds `t`: its separators at most `t`. */
  innerSlot(node: u32, t: K): usize {
    const i = node as usize;
    const line = this.innerLines[i];
    const lineB = t.inlineWide() ? this.innerLinesB[i] : line;
    return this.countAtMost(this.innerKeys, line, lineB, i * F, t);
  }

  // ─────────────── headers ───────────────

  /** How many entries `leaf` holds. */
  leafCount(leaf: u32): usize {
    return countOf(this.lineOf(leaf));
  }

  setLeafCount(leaf: u32, n: usize) {
    this.setLine(leaf, withCount(this.lineOf(leaf), n));
  }

  /** How many separators inner `node` holds. */
  innerCount(node: u32): usize {
    return countOf(this.innerLines[node as usize]);
  }

  setInnerCount(node: u32, n: usize) {
    this.innerLines[node as usize] = withCount(this.innerLines[node as usize], n);
  }

  /** The leaf whose range holds `t`, recording the descent in `pathNodes` / `pathSlots`. */
  findLeaf(t: K): u32 {
    __intrinsic_array_truncate(this.pathNodes, 0);
    __intrinsic_array_truncate(this.pathSlots, 0);
    let node = this.root;
    for (let h = this.height; h > 0; h--) {
      const slot = this.innerSlot(node, t);
      this.pathNodes.push(node);
      this.pathSlots.push(slot);
      node = this.innerKids[(node as usize) * F + slot];
    }
    return node;
  }

  /** The leaf whose range holds `t`, without recording the descent. */
  leafOf(t: K): u32 {
    let node = this.root;
    for (let h = this.height; h > 0; h--) {
      node = this.innerKids[(node as usize) * F + this.innerSlot(node, t)];
    }
    return node;
  }

  /** The leftmost or rightmost leaf. */
  edgeLeaf(right: bool): u32 {
    let node = this.root;
    for (let h = this.height; h > 0; h--) {
      const slot = right ? this.innerCount(node) : 0;
      node = this.innerKids[(node as usize) * F + slot];
    }
    return node;
  }

  // ─────────────── words and prefixes ───────────────

  /**
   * The prefix of a node with range `fences`: the common prefix of the separators on either side
   * of it, the smallest or the largest key standing in for one the tree's edge lacks. Every key
   * between them has it, and so does every key a search brings to the node: a search first
   * settles keys outside the smallest and the largest (velt:collections/btree/edges).
   */
  prefixFor(fences: Range<K>): u32 {
    const [low, high] = fences;
    if (this.minKey.length == 0) {
      return 0;
    }
    const lo = low != null ? low : this.minKey[0];
    const hi = high != null ? high : this.maxKey[0];
    return commonPrefix(lo, hi);
  }

  /** Do this map's keys have words (an `InlineKey` encoding)? Only after the first insert. */
  inline(): bool {
    return this.fill.length > 0 && this.fill[0].hasInlineKey();
  }

  /** Whether nodes keep wide words (`InlineKey.inlineWide`). Only after the first insert. */
  wide(): bool {
    return this.fill.length > 0 && this.fill[0].inlineWide();
  }

  /** Sets the word of slot `i` of `leaf` from its key. */
  leafWord(leaf: u32, i: usize) {
    const line = this.lineOf(leaf);
    const key = this.keyAt((leaf as usize) * F + i);
    const pre = prefixOf(line);
    this.setLine(leaf, withWord(line, i, wordOf(key, pre)));
    if (this.wide()) {
      this.setLineB(leaf, withWord(this.lineBOf(leaf), i, wordOfB(key, pre)));
    }
  }

  /** Sets the word of separator `i` of inner `node` from its key. */
  innerWord(node: u32, i: usize) {
    const n = node as usize;
    const line = this.innerLines[n];
    const pre = prefixOf(line);
    this.innerLines[n] = withWord(line, i, wordOf(this.innerKeys[n * F + i], pre));
    if (this.wide()) {
      const lineB = this.innerLinesB[n];
      this.innerLinesB[n] = withWord(lineB, i, wordOfB(this.innerKeys[n * F + i], pre));
    }
  }

  /** Gives `leaf` the prefix of its range `fences` and every key its word. */
  refreshLeaf(leaf: u32, fences: Range<K>) {
    if (!this.inline()) {
      return;
    }
    const n = this.leafCount(leaf);
    const c = (leaf >> LEAF_SHIFT) as usize;
    const base = ((leaf & LEAF_MASK) as usize) * F;
    const pre = this.prefixFor(fences);
    const line = wordsOf(this.leafKeys[c], base, n, pre, this.scratch, false);
    this.setLine(leaf, line);
    if (this.wide()) {
      const lineB = wordsOf(this.leafKeys[c], base, n, pre, this.scratch, true);
      this.setLineB(leaf, lineB);
    }
  }

  /** Gives inner `node` the prefix of its range `fences` and every separator its word. */
  refreshInner(node: u32, fences: Range<K>) {
    if (!this.inline()) {
      return;
    }
    const i = node as usize;
    const n = this.innerCount(node);
    const pre = this.prefixFor(fences);
    this.innerLines[i] = wordsOf(this.innerKeys, i * F, n, pre, this.scratch, false);
    if (this.wide()) {
      this.innerLinesB[i] = wordsOf(this.innerKeys, i * F, n, pre, this.scratch, true);
    }
  }

  /**
   * The range of the node at `depth` of the recorded path (0: the root; `pathNodes.length`: the
   * leaf): the separators on either side of it, `null` at the edge of the tree.
   */
  fencesAt(depth: usize): Range<K> {
    if (depth == 0) {
      return [null, null];
    }
    return this.childFences(depth - 1, this.pathSlots[depth - 1]);
  }

  /** The range of child `slot` of the path's inner node at `depth`. */
  childFences(depth: usize, slot: usize): Range<K> {
    const node = this.pathNodes[depth];
    const base = (node as usize) * F;
    const n = this.innerCount(node);
    if (slot > 0 && slot < n) {
      return [this.innerKeys[base + slot - 1], this.innerKeys[base + slot]];
    }
    const [up, upHigh] = this.fencesAt(depth);
    const low = slot > 0 ? this.innerKeys[base + slot - 1] : up;
    const high = slot < n ? this.innerKeys[base + slot] : upHigh;
    return [low, high];
  }

  // ─────────────── leaf slots ───────────────

  /** The key in slot `s` (`leaf * F + i`). */
  keyAt(s: usize): K {
    return this.leafKeys[s >> SLOT_SHIFT][s & SLOT_MASK];
  }

  /** `t.compareTo` the key in slot `s`, read in place (no share of it). */
  cmpKey(t: K, s: usize): i64 {
    return t.compareTo(this.leafKeys[s >> SLOT_SHIFT][s & SLOT_MASK]);
  }

  /** Stores `k` in slot `s`, dropping what it held. */
  setKey(s: usize, k: K) {
    this.leafKeys[s >> SLOT_SHIFT][s & SLOT_MASK] = k;
  }

  /** `leaf`'s line. */
  lineOf(leaf: u32): Line {
    return this.leafLines[(leaf >> LEAF_SHIFT) as usize][(leaf & LEAF_MASK) as usize];
  }

  setLine(leaf: u32, line: Line) {
    this.leafLines[(leaf >> LEAF_SHIFT) as usize][(leaf & LEAF_MASK) as usize] = line;
  }

  /** `leaf`'s second line (wide words only). */
  lineBOf(leaf: u32): Line {
    return this.leafLinesB[(leaf >> LEAF_SHIFT) as usize][(leaf & LEAF_MASK) as usize];
  }

  setLineB(leaf: u32, line: Line) {
    this.leafLinesB[(leaf >> LEAF_SHIFT) as usize][(leaf & LEAF_MASK) as usize] = line;
  }

  /** `leaf`'s rank order. */
  orderOf(leaf: u32): Order {
    return this.leafOrder[(leaf >> LEAF_SHIFT) as usize][(leaf & LEAF_MASK) as usize];
  }

  setOrder(leaf: u32, order: Order) {
    this.leafOrder[(leaf >> LEAF_SHIFT) as usize][(leaf & LEAF_MASK) as usize] = order;
  }

  /** Starts loading the cache line of key slot `s`. */
  keyPrefetch(s: usize) {
    __intrinsic_array_prefetch(this.leafKeys[s >> SLOT_SHIFT], s & SLOT_MASK);
  }

  /** Starts loading the line of `node`, an inner node when `inner`, else a leaf. */
  prefetchNode(node: u32, inner: bool) {
    if (inner) {
      __intrinsic_array_prefetch(this.innerLines, node as usize);
    } else {
      const c = (node >> LEAF_SHIFT) as usize;
      __intrinsic_array_prefetch(this.leafLines[c], (node & LEAF_MASK) as usize);
    }
  }

  /** `__intrinsic_array_rotate_right` of key slots `lo ..= hi` (of one leaf). */
  keyRotateRight(lo: usize, hi: usize) {
    const at = lo & SLOT_MASK;
    __intrinsic_array_rotate_right(this.leafKeys[lo >> SLOT_SHIFT], at, at + (hi - lo));
  }

  /** `__intrinsic_array_rotate_left` of key slots `lo ..= hi` (of one leaf). */
  keyRotateLeft(lo: usize, hi: usize) {
    const at = lo & SLOT_MASK;
    __intrinsic_array_rotate_left(this.leafKeys[lo >> SLOT_SHIFT], at, at + (hi - lo));
  }

  /**
   * Exchanges the keys of slots `a` and `b` (of two leaves, maybe in two chunks): a swap within
   * a chunk; across chunks, through a local, since one call may not change two chunks.
   */
  keySwap(a: usize, b: usize) {
    const ca = a >> SLOT_SHIFT;
    const cb = b >> SLOT_SHIFT;
    if (ca == cb) {
      __intrinsic_array_swap(this.leafKeys[ca], a & SLOT_MASK, b & SLOT_MASK);
      return;
    }
    const k = this.leafKeys[ca][a & SLOT_MASK];
    this.leafKeys[ca][a & SLOT_MASK] = this.leafKeys[cb][b & SLOT_MASK];
    this.leafKeys[cb][b & SLOT_MASK] = k;
  }

  /**
   * Whether values live in `valPlain` (a constant: `valFill[0]` only gives the type). The
   * value slots are chunked as the key slots are.
   */
  plainVals(): bool {
    return !__intrinsic_needs_drop(this.valFill[0]);
  }

  /** The value in slot `s`, shared as `Map.get` gives it. */
  valAt(s: usize): V {
    if (this.plainVals()) {
      return this.valPlain[s >> SLOT_SHIFT][s & SLOT_MASK];
    }
    return valueOf(this.valOpt[s >> SLOT_SHIFT][s & SLOT_MASK]);
  }

  /** Stores `v` in slot `s`, dropping what it held. */
  valSet(s: usize, v: V) {
    if (this.plainVals()) {
      this.valPlain[s >> SLOT_SHIFT][s & SLOT_MASK] = v;
    } else {
      this.valOpt[s >> SLOT_SHIFT][s & SLOT_MASK] = v;
    }
  }

  /** Makes slot `s` unused, dropping its value (a plain one stays: dropping it is nothing). */
  valClear(s: usize) {
    if (!this.plainVals()) {
      this.valOpt[s >> SLOT_SHIFT][s & SLOT_MASK] = null;
    }
  }

  valRotateRight(lo: usize, hi: usize) {
    const c = lo >> SLOT_SHIFT;
    const at = lo & SLOT_MASK;
    if (this.plainVals()) {
      __intrinsic_array_rotate_right(this.valPlain[c], at, at + (hi - lo));
    } else {
      __intrinsic_array_rotate_right(this.valOpt[c], at, at + (hi - lo));
    }
  }

  valRotateLeft(lo: usize, hi: usize) {
    const c = lo >> SLOT_SHIFT;
    const at = lo & SLOT_MASK;
    if (this.plainVals()) {
      __intrinsic_array_rotate_left(this.valPlain[c], at, at + (hi - lo));
    } else {
      __intrinsic_array_rotate_left(this.valOpt[c], at, at + (hi - lo));
    }
  }

  /** Exchanges the values of slots `a` and `b`, as `keySwap` does keys. */
  valSwap(a: usize, b: usize) {
    const ca = a >> SLOT_SHIFT;
    const cb = b >> SLOT_SHIFT;
    const ia = a & SLOT_MASK;
    const ib = b & SLOT_MASK;
    if (this.plainVals()) {
      if (ca == cb) {
        __intrinsic_array_swap(this.valPlain[ca], ia, ib);
        return;
      }
      const v = this.valPlain[ca][ia];
      this.valPlain[ca][ia] = this.valPlain[cb][ib];
      this.valPlain[cb][ib] = v;
      return;
    }
    if (ca == cb) {
      __intrinsic_array_swap(this.valOpt[ca], ia, ib);
      return;
    }
    const v = this.valOpt[ca][ia];
    this.valOpt[ca][ia] = this.valOpt[cb][ib];
    this.valOpt[cb][ib] = v;
  }

  valPrefetch(s: usize) {
    if (this.plainVals()) {
      __intrinsic_array_prefetch(this.valPlain[s >> SLOT_SHIFT], s & SLOT_MASK);
    } else {
      __intrinsic_array_prefetch(this.valOpt[s >> SLOT_SHIFT], s & SLOT_MASK);
    }
  }

  // ─────────────── nodes ───────────────

  newLeaf(): u32 {
    if (this.freeLeaves.length > 0) {
      return this.freeLeaves.pop()!;
    }
    const id = this.leafNext.length as u32;
    const c = (id >> LEAF_SHIFT) as usize;
    if (c == this.leafKeys.length) {
      this.leafKeys.push([]);
      this.leafLines.push([]);
      if (this.wide()) {
        this.leafLinesB.push([]);
      }
      this.leafOrder.push([]);
      if (this.plainVals()) {
        this.valPlain.push([]);
      } else {
        this.valOpt.push([]);
      }
    }
    for (let i: usize = 0; i < F; i++) {
      this.leafKeys[c].push(this.fill[0]);
    }
    if (this.plainVals()) {
      for (let i: usize = 0; i < F; i++) {
        this.valPlain[c].push(this.valFill[0]);
      }
    } else {
      for (let i: usize = 0; i < F; i++) {
        this.valOpt[c].push(null);
      }
    }
    this.leafLines[c].push(emptyLine());
    if (this.wide()) {
      this.leafLinesB[c].push(emptyLine());
    }
    this.leafOrder[c].push(identityOrder());
    this.leafNext.push(NONE);
    this.leafPrev.push(NONE);
    return id;
  }

  newInner(): u32 {
    if (this.freeInners.length > 0) {
      return this.freeInners.pop()!;
    }
    const id = this.innerLines.length as u32;
    for (let i: usize = 0; i < F; i++) {
      this.innerKeys.push(this.fill[0]);
      this.innerKids.push(0);
    }
    this.innerLines.push(emptyLine());
    if (this.wide()) {
      this.innerLinesB.push(emptyLine());
    }
    return id;
  }

  freeLeaf(leaf: u32) {
    const base = (leaf as usize) * F;
    for (let i: usize = 0; i < F; i++) {
      this.setKey(base + i, this.fill[0]);
      this.valClear(base + i);
    }
    this.setLine(leaf, emptyLine());
    if (this.wide()) {
      this.setLineB(leaf, emptyLine());
    }
    this.setOrder(leaf, identityOrder());
    this.freeLeaves.push(leaf);
  }

  freeInner(node: u32) {
    const base = (node as usize) * F;
    for (let i: usize = 0; i < F; i++) {
      this.innerKeys[base + i] = this.fill[0];
    }
    this.innerLines[node as usize] = emptyLine();
    if (this.wide()) {
      this.innerLinesB[node as usize] = emptyLine();
    }
    this.freeInners.push(node);
  }

  /** Drops every node; the next `insert` starts a new root. */
  clear() {
    __intrinsic_array_truncate(this.leafKeys, 0);
    __intrinsic_array_truncate(this.valPlain, 0);
    __intrinsic_array_truncate(this.valOpt, 0);
    __intrinsic_array_truncate(this.valFill, 0);
    __intrinsic_array_truncate(this.leafLines, 0);
    __intrinsic_array_truncate(this.leafLinesB, 0);
    __intrinsic_array_truncate(this.leafOrder, 0);
    __intrinsic_array_truncate(this.leafNext, 0);
    __intrinsic_array_truncate(this.leafPrev, 0);
    __intrinsic_array_truncate(this.innerKeys, 0);
    __intrinsic_array_truncate(this.innerLines, 0);
    __intrinsic_array_truncate(this.innerLinesB, 0);
    __intrinsic_array_truncate(this.innerKids, 0);
    __intrinsic_array_truncate(this.freeLeaves, 0);
    __intrinsic_array_truncate(this.freeInners, 0);
    __intrinsic_array_truncate(this.fill, 0);
    __intrinsic_array_truncate(this.minKey, 0);
    __intrinsic_array_truncate(this.maxKey, 0);
    this.root = 0;
    this.height = 0;
    this.size = 0;
    this.edits++;
  }
}

/** The word of `k` in a node with prefix `pre`: the two bytes of its encoding past it. */
export function wordOf<T extends InlineKey>(k: T, pre: u32): u16 {
  return k.inlineWord(pre as usize);
}

/** The second half of `k`'s wide word in a node with prefix `pre`: the two bytes after `wordOf`'s. */
export function wordOfB<T extends InlineKey>(k: T, pre: u32): u16 {
  return k.inlineWord((pre + 2) as usize);
}

// The line of a node whose `n` keys are at `keys[base..]` and whose prefix is `pre` (its second
// line, `second`, for wide words).
function wordsOf<K extends Comparable<K>>(
  keys: K[],
  base: usize,
  n: usize,
  pre: u32,
  scratch: u16[],
  second: bool,
): Line {
  for (let i: usize = 0; i < 31; i++) {
    scratch[i] =
      i >= n ? EMPTY : second ? wordOfB(keys[base + i], pre) : wordOf(keys[base + i], pre);
  }
  scratch[31] = ((pre as u16) << 5) | (n as u16);
  return fill(scratch);
}

// The number of leading bytes the encodings of `a` and `b` share, at most `MAX_PREFIX`.
function commonPrefix<K extends InlineKey>(a: K, b: K): u32 {
  for (let off: usize = 0; off < MAX_PREFIX; off += 8) {
    let d = a.inlineKey(off) ^ b.inlineKey(off);
    if (d != 0) {
      let bytes: usize = 0;
      while (d >> 56 == 0) {
        d = d << 8;
        bytes++;
      }
      return (off + bytes) as u32;
    }
  }
  return MAX_PREFIX as u32;
}

/**
 * Moves `xs[from]` to `xs[to]`, whose value is about to be overwritten or is a filler: a swap
 * for values that own something, so moving a string or an object costs no count changes.
 */
export function moveSlot<T>(xs: T[], to: usize, from: usize) {
  if (__intrinsic_needs_drop(xs[from])) {
    __intrinsic_array_swap(xs, to, from);
  } else {
    xs[to] = xs[from];
  }
}

// A value from a `valOpt` slot, shared. A slot of a live entry holds `null` only when `V` holds
// `null`.
function valueOf<V>(slot: V | null): V {
  if (slot != null) {
    return __intrinsic_share(slot);
  }
  if (__intrinsic_holds_null(__intrinsic_null_as<V>())) {
    return __intrinsic_null_as<V>();
  }
  panic("ICE: BTreeMap entry without a value");
}
