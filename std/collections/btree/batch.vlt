// velt/collections (internal): finding the leaves of many keys together (`BTreeMap.getMany`).

import { F, Pool, Window, windowOf } from "velt/collections/btree/pool";
import { leafCandidate, NO_SLOT } from "velt/collections/btree/leaf";

/**
 * Finds the leaves of `keys[start .. start + m]` together: level by level, each key's next node
 * is prefetched once its slot is known, so it loads while the others search theirs. Then each
 * key's candidate slot in its leaf (`leafCandidate`, `NO_SLOT` for none), with its key and value
 * prefetched. `leaves` and `slots` get one entry per key.
 */
export function descendMany<K extends Comparable<K>, V>(
  p: Pool<K, V>,
  keys: K[],
  start: usize,
  m: usize,
  leaves: u32[],
  slots: usize[],
) {
  leaves.truncate(0);
  slots.truncate(0);
  for (let j: usize = 0; j < m; j++) {
    leaves.push(p.root);
  }
  // Each key's window, once (`wins[2j]`, `wins[2j + 1]`).
  const wins = p.batchWindows;
  for (let j: usize = 0; j < m; j++) {
    const [a, b] = windowOf(keys[start + j]);
    wins[2 * j] = a;
    wins[2 * j + 1] = b;
  }
  for (let h = p.height; h > 0; h--) {
    for (let j: usize = 0; j < m; j++) {
      const node = leaves[j];
      const win: Window = [wins[2 * j], wins[2 * j + 1]];
      const child = p.innerKids[(node as usize) * F + p.innerSlot(node, keys[start + j], win)];
      leaves[j] = child;
      p.prefetchNode(child, h > 1);
    }
  }
  for (let j: usize = 0; j < m; j++) {
    const leaf = leaves[j];
    const s = leafCandidate(p, leaf, keys[start + j], [wins[2 * j], wins[2 * j + 1]]);
    slots.push(s);
    if (s != NO_SLOT) {
      p.keyPrefetch((leaf as usize) * F + s);
      p.valPrefetch((leaf as usize) * F + s);
    }
  }
}
