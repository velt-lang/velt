// std/collections/concurrent_map: `ConcurrentMap`, a map from `u64` or `string` keys to values
// that many threads read and write at once, through a `shared` value: a B+ tree with optimistic
// lock coupling (Leis et al., "The ART of Practical Synchronization"; bbtree's concurrent map
// uses the same protocol). Built only on public std APIs: `Atomic<u64>`, velt:simd
// (`loadOptimistic`), `Atomic.fence`, array `prefetch`.
//
// Every node is 128 words of one `Atomic<u64>[]` arena (allocated whole by `create`), addressed
// by index and never moved, so a reader that holds a stale index still reads a node and finds
// its version changed. Readers write nothing. A delete that empties a leaf unlinks it, with any
// inner nodes above it left with no other child, from the lowest ancestor that keeps a child,
// and puts them on a free list (`spare`) that `alloc` takes from first. A node's version only
// grows, through being freed and reused too, so a reader that read it before sees it changed.
//
// Node layout (words):
//   0: latch (bit 0 exclusive, then shared holders, the version from bit 21: velt:sync's
//      `VersionLatch` word)
//   1: meta: the number of keys | `LEAF_BIT` for a leaf | an inner node's level from bit 40
//   leaf:  16-bit tags (hashes) of the keys, 4 to a word, at 2..16, tag 0 for an empty slot; key
//          i at 16 + 2i, its value at 17 + 2i. Unsorted (a lookup only needs equality, a split
//          sorts): a key sits in its home slot (other bits of its hash) when that was free, else
//          in any free slot, so most lookups read the home pair without waiting for the tags.
//   inner: an index at 2..8 (key 8g + 7 for group g), then from word 16 groups of 16 words, one
//          cache line each: 8 keys, then the 8 children left of them (child 8g + j between keys
//          8g + j - 1 and 8g + j); unused key slots hold `MAX_KEY`. A level reads the index line
//          and one group line. Key i separates child i (keys below it) from child i + 1.
// A reader reads a node's words with relaxed loads (several at a time with `loadOptimistic`),
// then checks its version (`isUnchanged`), and starts over from the root when a writer changed
// it. A writer takes the node's latch at the version it read, so a node that changed since
// fails the take; a full node is split on the way down while its parent is held as well, so a
// parent always has room for the separator.
//
// String keys: the tree's key words are the strings' first 8 bytes in order (`inlineKey(0)`, so
// a < b gives word(a) <= word(b)), and the strings themselves sit beside the nodes, in `skeys`:
// a leaf's key in slot j at `node * SKEYS + j`, and the string of the separator left of a node
// in its parent at `node * SKEYS + FENCE` (the node's fence: separator i of an inner node is the
// fence of its child i + 1, so separators move between slots without their strings). Words that
// tie are told apart by the strings: an inner node's separators with the key's word that are
// greater than the key send it left of them (`backTies`, a binary search over the tied run), and
// a leaf slot whose tag and word match is the key's only if its string is (`sameKey`). Tags and
// home slots hash the whole string, so keys that share a prefix do not share tags. A reader reads
// the strings as it reads the words, optimistically: borrowed, inside the epoch section the
// compiler opens around the function that loads them, so one that a writer replaces meanwhile
// stays readable until the section ends, and the node's version check after says whether what it
// compared was the node's (a fence is read through the parent's child word, and changes only
// while the parent is held: set before its node is linked, cleared when the node is unlinked or
// becomes its parent's first child, whose fence is never read). A writer changes strings only
// while it holds their node (or before the node is linked), and moves as few as it can: each one
// replaced is retired to the epoch.

import { InlineKey } from "velt:collections/btree/inline_key";
import { utf8Length } from "velt:encoding";
import { u16x8, u64x2, u8x16 } from "velt:simd";

const NODE: u64 = 128;
const LEAF_CAP: u64 = 56;
const INNER_CAP: u64 = 55;
const TAGS: u64 = 2;
const TAG_WORDS: u64 = 14;
const PAIRS: u64 = 16;
const INDEX: u64 = 2;
const GROUPS: u64 = 6;
const GROUP0: u64 = 16;
const LEAF_BIT: u64 = 4294967296;
const LEN_MASK: u64 = 4294967295;
const LEVEL_SHIFT: u64 = 40;
const EXCLUSIVE: u64 = 1;
const SHARED_MASK: u64 = 2097150;
const VERSION_UNIT: u64 = 2097152;
const LANES: u64 = 0x0001000100010001;
const HIGHS: u64 = 0x8000800080008000;
/** The one key a map cannot hold: unused key slots of inner nodes hold it. */
const MAX_KEY: u64 = 18446744073709551615;
const NONE: u64 = 18446744073709551615;
/** `spare`: the top node's index + 1 (0 for none) in the low half, a count of changes above. */
const SPARE_TAG: u64 = 4294967296;
/** `tryAdd`'s answers: added (with the value before), the key is absent, or start over. */
const ADD_DONE: u64 = 0;
const ADD_ABSENT: u64 = 1;
const ADD_RETRY: u64 = 2;
/** `tryDelete`'s answers: the key is absent, removed, start over, or its leaf would empty. */
const DEL_ABSENT: u64 = 0;
const DEL_DONE: u64 = 1;
const DEL_RETRY: u64 = 2;
const DEL_LAST: u64 = 3;
/**
 * `skeys` entries per node: one per leaf slot, then the node's fence, the string of the
 * separator left of it in its parent.
 */
const SKEYS: u64 = 57;
const FENCE: u64 = 56;
/** Nodes per entry of capacity: a split leaf keeps 28 entries, plus the inner nodes above. */
const ENTRIES_PER_NODE: u64 = 27;

/**
 * A key's tag: 16 bits of its hash, never 0 (an empty lane). `k` is what `hashKey` gives: a
 * `u64` key itself, a string's hash.
 */
function tagOf(k: u64): u64 {
  return ((k * 0x9E3779B97F4A7C15) >> 48) | 1;
}

/** A key's home slot in a leaf: other bits of the hash than its tag's, scaled to the slots. */
function homeOf(k: u64): u64 {
  return ((((k * 0x9E3779B97F4A7C15) >> 16) & 4294967295) * LEAF_CAP) >> 32;
}

/**
 * What a key's tag and home slot are made from (`tagOf`, `homeOf`): a `u64` key itself, the
 * hash of a whole string (its word, the first 8 bytes, would give keys with a common prefix one
 * tag).
 */
function hashKey<K>(k: u64, key: K): u64 {
  if (typeIs<K, string>()) {
    return strHash(asType<string>(key));
  }
  return k;
}

/**
 * A hash of all of the bytes of `s`, 16 at a time (zero past its end, so the length is mixed in
 * too: `"a"` and `"a\0"` differ). Not seeded: keys an attacker picks to collide share tags, which
 * makes their leaf's lookups compare more strings, nothing worse.
 */
function strHash(s: string): u64 {
  const n = utf8Length(s);
  let h = (n as u64) ^ 0x243F6A8885A308D3;
  for (let i: usize = 0; i < n; i += 16) {
    const v = u8x16.loadString(s, i).asU64x2();
    h = (h ^ v.lane(0)) * 0x9E3779B97F4A7C15;
    h = (h ^ (h >> 32) ^ v.lane(1)) * 0xBF58476D1CE4E5B9;
    h ^= h >> 29;
  }
  return h;
}

/** Slot `home` if it is set in the mask `free`, else the lowest set (one is). */
function pick(free: u64, home: u64): u64 {
  return ((free >> home) & 1) != 0 ? home : free.trailingZeros() as u64;
}

/** Word of key `j` of an inner node, from its base. */
function keyAt(j: u64): u64 {
  return GROUP0 + ((j >> 3) << 4) + (j & 7);
}

/** Word of child `i` of an inner node, from its base. */
function childAt(i: u64): u64 {
  return GROUP0 + ((i >> 3) << 4) + 8 + (i & 7);
}

function rangeError(what: string): never {
  panic(`RangeError: ConcurrentMap.${what}`);
}

/** Whether a `shared<V>` is an atomic integer, which `add` and `set` change in place. */
function atomicShared<V>(): bool {
  return typeIs<V, i64>() || typeIs<V, u64>() || typeIs<V, isize>() || typeIs<V, usize>();
}

/** The tree word of `key`: a `u64` key itself, a string's first 8 bytes in order. */
function keyWord<K>(key: K): u64 {
  if (typeIs<K, u64>()) {
    return asType<u64>(key);
  }
  if (typeIs<K, string>()) {
    return asType<string>(key).inlineKey(0);
  }
  rangeError("keys other than u64 and string are not supported");
}

/** The order of strings `a` and `b` (-1, 0 or 1), read in place where they are kept. */
function strOrder(a: string, b: string): i64 {
  return a.compareTo(b);
}

/** Whether strings `a` and `b` are equal, read in place. */
function strSame(a: string, b: string): bool {
  return a == b;
}

/**
 * A map from `K` keys (`u64` or `string`; `u64` when not written) to `V` values (`u64` when not
 * written) for many threads at once: share it (`shared(ConcurrentMap.create(n))`) and call its
 * methods from any task. A value other than a `u64` is boxed once, and read in place by `read`;
 * a string key is kept once, beside its leaf. Lookups write no shared memory, so readers on many
 * cores never slow each other; writers take a latch per node. A lookup waits (spins) while a
 * writer holds its node, so it is not lock-free. Its keys are kept in key ranges, but a leaf's
 * are unsorted and leaves are not linked: there is no ordered walk, iteration or size yet
 * (#1688). Its room is fixed when it is created, and given back as leaves empty.
 */
export class ConcurrentMap<K = u64, V extends Frozen = u64> {
  /**
   * The values of a map whose `V` is not `u64`: one `shared<V>` per leaf slot (`node * LEAF_CAP +
   * slot`), read borrowed inside the reader's epoch section. A `u64` `V` sits in the pair's value
   * word instead, and this stays empty.
   */
  private vals: Atomic<shared<V> | null>[] = [];
  /**
   * The keys of a map whose `K` is `string`: one per leaf slot (`node * SKEYS + slot`), `null`
   * where it has none, then each node's fence (`node * SKEYS + FENCE`), the string of the
   * separator left of it, shared with the key it was copied from; read like `vals`. Empty for
   * `u64` keys.
   */
  private skeys: Atomic<shared<string> | null>[] = [];
  private w: Atomic<u64>[] = [];
  private root: Atomic<u64> = new Atomic<u64>(0);
  private next: Atomic<u64> = new Atomic<u64>(1);
  private spare: Atomic<u64> = new Atomic<u64>(0);
  private nodes: u64 = 0;

  /**
   * An empty map with room for at least `capacity` entries (its memory, about 40 bytes an
   * entry, and 17 more for string keys, is taken now; a string key's own copy when it is set).
   * A `set` that needs more room panics with a RangeError. A deleted
   * entry frees a slot in its leaf, and a leaf whose last entry is deleted is reused, so keys
   * that keep moving to new ranges (ids or timestamps that only grow, old ones deleted) fit for
   * as long as the entries present at once do. Leaves are not merged, though: entries spread
   * thinly over many leaves (most of a large map's keys deleted at random) can hold a node each
   * and need more room than their number. A `set` of a key the map holds can also need room,
   * when its leaf is full and splits first. Panics with a RangeError above 10^11 entries, and
   * for keys other than `u64` and `string`.
   */
  static create(capacity: usize): ConcurrentMap<K, V> {
    if (!typeIs<K, u64>()) {
      if (!typeIs<K, string>()) {
        rangeError("create: keys other than u64 and string are not supported");
      }
    }
    const m = new ConcurrentMap<K, V>();
    if ((capacity as u64) > 100000000000) {
      rangeError("create: at most 10^11 entries");
    }
    m.nodes = (capacity as u64) / ENTRIES_PER_NODE + 64;
    const words = m.nodes * NODE;
    m.w.reserve(words as usize);
    for (let i: u64 = 0; i < words; i++) {
      m.w.push(new Atomic<u64>(0));
    }
    m.w[1].store(LEAF_BIT, "relaxed");
    if (!typeIs<V, u64>()) {
      const slots = m.nodes * LEAF_CAP;
      m.vals.reserve(slots as usize);
      for (let i: u64 = 0; i < slots; i++) {
        m.vals.push(new Atomic<shared<V> | null>(null));
      }
    }
    if (typeIs<K, string>()) {
      const slots = m.nodes * SKEYS;
      m.skeys.reserve(slots as usize);
      for (let i: u64 = 0; i < slots; i++) {
        m.skeys.push(new Atomic<shared<string> | null>(null));
      }
    }
    return m;
  }

  /** The value of `key`, or `undefined` if the map has none (a boxed value is copied). */
  get(key: K): V | undefined {
    const k = keyWord(key);
    if (typeIs<V | undefined, u64 | undefined>()) {
      return asType<V | undefined>(this.getWord(k, key));
    }
    const s = this.findBoxed(k, key);
    if (s == null) {
      return undefined;
    }
    return s;
  }

  /**
   * Runs `f` on the value of `key` (the map's own, not a copy; for a 64-bit integer `V`, whose
   * `shared` is an atomic integer, a box of its own) and returns what it returns, or
   * `undefined` if the map has no `key`.
   */
  read<R, E>(key: K, f: (value: shared<V>) => R throws E): R | undefined throws E {
    const k = keyWord(key);
    if (typeIs<V, u64>()) {
      const w = this.getWord(k, key);
      return w == undefined ? undefined : f(shared(asType<V>(w)));
    }
    const s = this.findBoxed(k, key);
    if (s == null) {
      return undefined;
    }
    // A `shared` 64-bit integer is an atomic one (`add`, `set`): the callback gets a box of its
    // own, so it cannot change the map's value outside the leaf's latch.
    if (atomicShared<V>()) {
      const v: V = s;
      return f(shared(v));
    }
    return f(s);
  }

  /** Whether the map has `key`. */
  has(key: K): bool {
    const k = keyWord(key);
    if (typeIs<V, u64>()) {
      return this.getWord(k, key) != undefined;
    }
    return this.findBoxed(k, key) != null;
  }

  /**
   * Makes `value` the value of `key`, adding the key if the map has none (a value other than a
   * `u64` is boxed once, a string key copied once). Panics with a RangeError for the `u64` key
   * 2^64 - 1 (the one key a map cannot hold) and when the map is out of room.
   */
  set(key: K, value: V) {
    const k = keyWord(key);
    if (typeIs<V, u64>()) {
      this.setWord(k, key, asType<u64>(value));
      return;
    }
    if (k == MAX_KEY) {
      rangeError("set: the key 2^64 - 1 cannot be held");
    }
    const boxed = shared(value);
    while (!this.trySetBoxed(k, key, boxed)) {}
  }

  /**
   * Adds `delta` to the `u64` value of `key` (wrapping), atomically: the value before, or
   * `undefined` if the map has no `key`. Only for `u64` values.
   */
  add(key: K, delta: u64): u64 | undefined {
    if (typeIs<V, u64>()) {
      return this.addWord(keyWord(key), key, delta);
    }
    rangeError("add: only for u64 values");
  }

  /** Removes `key`; whether the map had it (a boxed value is dropped once no reader has it). */
  delete(key: K): bool {
    return this.deleteWord(keyWord(key), key);
  }

  /** `get` of a `u64` value; `key` (word `k`) breaks ties for string keys. */
  private getWord(k: u64, key: K): u64 | undefined {
    // The one key a map cannot hold (and inner nodes' padding: a descent for it would follow
    // a slot no separator covers).
    if (k == MAX_KEY) {
      return undefined;
    }
    restart: while (true) {
      const n = this.root.load("acquire");
      let b = n * NODE;
      // One check that the node's words are in the arena; the reads below follow from it.
      if ((this.w.length as u64) < NODE || b > (this.w.length as u64) - NODE) {
        continue restart;
      }
      let v = this.readVersion(b);
      if (this.root.load("acquire") != n) {
        continue restart;
      }
      let meta = this.w[b + 1].load("relaxed");
      // The tree's height, so the descent runs the same number of steps every time (a branch
      // predictor learns it; a leaf test at every level would miss once per lookup).
      const levels = (meta >> LEVEL_SHIFT) & 255;
      for (let l: u64 = 0; l < levels; l++) {
        const c = this.w[this.childFor(b, k, key)].load("relaxed");
        const cb = c * NODE;
        if (
          c >= this.nodes || (this.w.length as u64) < NODE || cb > (this.w.length as u64) - NODE
        ) {
          continue restart;
        }
        // The child's version first, then the parent's check: a child read while a writer
        // changed the parent fails that check.
        const vc = this.readVersion(cb);
        if (!this.isUnchanged(b, v)) {
          continue restart;
        }
        b = cb;
        v = vc;
        meta = this.w[b + 1].load("relaxed");
      }
      if ((meta & LEAF_BIT) == 0) {
        continue restart;
      }
      const i = this.findSlot(b, k, key);
      const found = i < LEAF_CAP;
      // Without the key, read the meta word (already in cache) instead of a pair.
      const value = this.w[found ? b + PAIRS + 1 + 2 * i : b + 1].load("relaxed");
      if (!this.isUnchanged(b, v)) {
        continue restart;
      }
      return found ? value : undefined;
    }
  }

  /** The boxed value of `key` (`V` other than `u64`), read as `getWord` reads a value word. */
  private findBoxed(k: u64, key: K): shared<V> | null {
    if (k == MAX_KEY) {
      return null;
    }
    restart: while (true) {
      const n = this.root.load("acquire");
      let node = n;
      let b = n * NODE;
      if ((this.w.length as u64) < NODE || b > (this.w.length as u64) - NODE) {
        continue restart;
      }
      let v = this.readVersion(b);
      if (this.root.load("acquire") != n) {
        continue restart;
      }
      let meta = this.w[b + 1].load("relaxed");
      const levels = (meta >> LEVEL_SHIFT) & 255;
      for (let l: u64 = 0; l < levels; l++) {
        const c = this.w[this.childFor(b, k, key)].load("relaxed");
        const cb = c * NODE;
        if (
          c >= this.nodes || (this.w.length as u64) < NODE || cb > (this.w.length as u64) - NODE
        ) {
          continue restart;
        }
        const vc = this.readVersion(cb);
        if (!this.isUnchanged(b, v)) {
          continue restart;
        }
        node = c;
        b = cb;
        v = vc;
        meta = this.w[b + 1].load("relaxed");
      }
      if ((meta & LEAF_BIT) == 0) {
        continue restart;
      }
      const i = this.findSlot(b, k, key);
      if (i >= LEAF_CAP) {
        if (!this.isUnchanged(b, v)) {
          continue restart;
        }
        return null;
      }
      // The reference stays valid while it is read (the epoch section around the load), even
      // if a writer replaces it; the version check then says whether it was `key`'s.
      const s = this.vals[node * LEAF_CAP + i].load("acquire");
      if (!this.isUnchanged(b, v)) {
        continue restart;
      }
      return s;
    }
  }

  /**
   * Makes `value` the value of `key`, adding the key if the map has none. Panics with a
   * RangeError for `key` 2^64 - 1 (the one key a map cannot hold) and when the map is out of
   * room.
   */
  private setWord(k: u64, key: K, value: u64) {
    if (k == MAX_KEY) {
      rangeError("set: the key 2^64 - 1 cannot be held");
    }
    while (!this.trySet(k, key, value)) {}
  }

  /**
   * Adds `delta` to the value of `key` (wrapping), atomically: the value before, or `undefined`
   * if the map has no `key` (nothing is added). Like `set`, it takes the key's leaf for the
   * moment of the change; lookups go on reading meanwhile.
   */
  private addWord(k: u64, key: K, delta: u64): u64 | undefined {
    if (k == MAX_KEY) {
      return undefined;
    }
    while (true) {
      const [state, before] = this.tryAdd(k, key, delta);
      if (state == ADD_DONE) {
        return before;
      }
      if (state == ADD_ABSENT) {
        return undefined;
      }
    }
  }

  /** Removes `key`; whether the map had it. */
  private deleteWord(k: u64, key: K): bool {
    if (k == MAX_KEY) {
      return false;
    }
    while (true) {
      let r = this.tryDelete(k, key);
      if (r == DEL_LAST) {
        r = this.tryDeleteLast(k, key);
      }
      if (r != DEL_RETRY) {
        return r == DEL_DONE;
      }
    }
  }

  /**
   * Looks up `keys` (at most 64) together into `values`: where bit `i` of the result is set,
   * `values[i]` is the value of `keys[i]` (`values` grows to `keys.length` if shorter; its other
   * elements are unspecified). Unlike `BTreeMap.getMany`, which returns a new array, it fills the
   * caller's, so a loop of batches allocates nothing. Faster than one `get` per key when the map
   * is larger than the caches: the keys descend the tree in lockstep, and each prefetches its next
   * node while the others search theirs, so their cache misses overlap. For `u64` keys and values
   * only for now (other maps panic with a RangeError). Panics with a RangeError for more than 64
   * keys.
   */
  getManyInto(keys: K[], values: V[]): u64 {
    // The `u64` body, its elements converted where read and written (nothing at run time).
    if (typeIs<K, u64>()) {
      if (typeIs<V, u64>()) {
        if (keys.length > 64) {
          rangeError("getManyInto: at most 64 keys at once");
        }
        const n = keys.length;
        while (values.length < n) {
          values.push(asType<V>(0 as u64));
        }
        const all: u64 = n == 64 ? MAX_KEY : (1 << (n as u64)) - 1;
        // Per key: its node at `i`, the node's version at `n + i`, its next node at `2n + i`.
        const lanes: u64[] = [];
        lanes.reserve(3 * n);
        let failed: u64 = 0;
        const root = this.root.load("acquire");
        const rb = root * NODE;
        let rv: u64 = 0;
        let levels: u64 = 0;
        if ((this.w.length as u64) < NODE || rb > (this.w.length as u64) - NODE) {
          failed = all;
        } else {
          rv = this.readVersion(rb);
          levels = (this.w[rb + 1].load("relaxed") >> LEVEL_SHIFT) & 255;
          if (this.root.load("acquire") != root) {
            failed = all;
            levels = 0;
          }
        }
        // The key 2^64 - 1 is never held: its lane goes to `get`, which says so.
        for (let i = 0; i < n; i++) {
          if (asType<u64>(keys[i]) == MAX_KEY) {
            failed |= 1 << (i as u64);
          }
        }
        for (let i = 0; i < n; i++) {
          lanes.push(rb);
        }
        for (let i = 0; i < n; i++) {
          lanes.push(rv);
        }
        for (let i = 0; i < n; i++) {
          lanes.push(0);
        }
        for (let l: u64 = 0; l < levels; l++) {
          for (let i = 0; i < n; i++) {
            if (((failed >> (i as u64)) & 1) != 0) {
              continue;
            }
            const b = lanes[i];
            const c = this.w[this.childWord(b, asType<u64>(keys[i]))].load("relaxed");
            const cb = c * NODE;
            if (
              c >= this.nodes || (this.w.length as u64) < NODE || cb > (this.w.length as u64) - NODE
            ) {
              failed |= 1 << (i as u64);
              continue;
            }
            this.w.prefetch(cb as usize);
            this.w.prefetch((cb + GROUP0) as usize);
            lanes[2 * n + i] = cb;
          }
          // Validated in a second pass, once the prefetches have had time.
          for (let i = 0; i < n; i++) {
            if (((failed >> (i as u64)) & 1) != 0) {
              continue;
            }
            const cb = lanes[2 * n + i];
            const vc = this.readVersion(cb);
            if (!this.isUnchanged(lanes[i], lanes[n + i])) {
              failed |= 1 << (i as u64);
              continue;
            }
            lanes[i] = cb;
            lanes[n + i] = vc;
          }
        }
        // The leaves in two passes as well: each key's candidate slot and a prefetch of its pair,
        // then the pairs' loads and the checks.
        let slow: u64 = 0;
        for (let i = 0; i < n; i++) {
          if (((failed >> (i as u64)) & 1) != 0) {
            continue;
          }
          const b = lanes[i];
          const meta = this.w[b + 1].load("relaxed");
          if ((meta & LEAF_BIT) == 0) {
            failed |= 1 << (i as u64);
            continue;
          }
          const cand = this.candidate(b, asType<u64>(keys[i]));
          if (cand > LEAF_CAP) {
            slow |= 1 << (i as u64);
            continue;
          }
          const at = cand < LEAF_CAP ? b + PAIRS + 2 * cand : b + 1;
          this.w.prefetch(at as usize);
          lanes[2 * n + i] = at;
        }
        let found: u64 = 0;
        for (let i = 0; i < n; i++) {
          if ((((failed | slow) >> (i as u64)) & 1) != 0) {
            continue;
          }
          const b = lanes[i];
          const at = lanes[2 * n + i];
          const key = this.w[at].load("relaxed");
          const value = this.w[at + 1].load("relaxed");
          if (!this.isUnchanged(b, lanes[n + i])) {
            failed |= 1 << (i as u64);
            continue;
          }
          values[i] = asType<V>(value);
          found |= (at != b + 1 && key == asType<u64>(keys[i]) ? 1 : 0) << (i as u64);
        }
        // Keys a writer disturbed, or with a tag shared by two keys of their leaf: one by one.
        failed |= slow;
        while (failed != 0) {
          const i = failed.trailingZeros();
          failed &= failed - 1;
          const r = this.getWord(asType<u64>(keys[i]), keys[i]);
          if (r != undefined) {
            values[i] = asType<V>(r);
            found |= 1 << (i as u64);
          }
        }
        return found;
      }
    }
    rangeError("getManyInto: for u64 keys and values only for now");
  }

  // --- latches ---------------------------------------------------------------------------

  private readVersion(n: u64): u64 {
    while (true) {
      const x = this.w[n].load("acquire");
      if ((x & EXCLUSIVE) == 0) {
        return x & ~SHARED_MASK;
      }
      Atomic.spinHint();
    }
  }

  private isUnchanged(n: u64, v: u64): bool {
    Atomic.fence("acquire");
    return (this.w[n].load("relaxed") & ~SHARED_MASK) == v;
  }

  private tryLockAt(n: u64, v: u64): bool {
    const ok = this.w[n].compareExchange(v, v | EXCLUSIVE, "acquire", "relaxed") == v;
    Atomic.fence("release");
    return ok;
  }

  private unlock(n: u64, v: u64) {
    this.w[n].store(v + VERSION_UNIT, "release");
  }

  // --- searches --------------------------------------------------------------------------

  /**
   * The word of the child of the inner node at `base` that holds `k`. Fixed counts, no branches,
   * two keys per vector compare: the 6 index words pick the group, then the group's 8 key slots
   * count the keys at most `k`. That count is at most 7 (the group's last key is the next index
   * word, above `k`, or `MAX_KEY`), so the child is in the group's own line.
   */
  private childWord(base: u64, k: u64): u64 {
    const key = u64x2.splat(k);
    const one = u64x2.splat(1);
    const zero = u64x2.splat(0);
    let below = zero;
    for (let j: u64 = 0; j < GROUPS; j += 2) {
      const le = u64x2.loadOptimistic(this.w, (base + INDEX + j) as usize).le(key);
      below = below.add(u64x2.select(le, one, zero));
    }
    const sum = below.sum();
    const g = sum < GROUPS ? sum : GROUPS;
    const at = base + GROUP0 + (g << 4);
    below = zero;
    for (let j: u64 = 0; j < 8; j += 2) {
      const le = u64x2.loadOptimistic(this.w, (at + j) as usize).le(key);
      below = below.add(u64x2.select(le, one, zero));
    }
    const c = below.sum();
    return at + 8 + (c < 7 ? c : 7);
  }

  /** The word of the child of the inner node at `base` that holds `key` (word `k`). */
  private childFor(base: u64, k: u64, key: K): u64 {
    if (typeIs<K, string>()) {
      return base + childAt(this.backTies(base, this.position(base, k), k, asType<string>(key)));
    }
    return this.childWord(base, k);
  }

  /** How many keys of the inner node at `base` are at most `k`: where `k` would go. */
  private position(base: u64, k: u64): u64 {
    // `childWord` is `base + GROUP0 + 16g + 8 + c`, with the count `c` at most 7.
    const w = this.childWord(base, k) - base - GROUP0;
    return (w >> 4) * 8 + (w & 15) - 8;
  }

  /**
   * How many separators of the inner node at `base` are at most the string `key` (word `k`),
   * from `at`, how many words are at most `k`: the separators before `at` whose word is `k` are
   * the last of those, and the ones greater than `key` go back.
   */
  private backTies(base: u64, at: u64, k: u64, key: string): u64 {
    // Most keys tie with no separator: no string read, so no epoch section (its own function's).
    if (at == 0 || this.w[base + keyAt(at - 1)].load("relaxed") != k) {
      return at;
    }
    return this.backTiesSlow(base, at, k, key);
  }

  /**
   * `backTies` where the separator before `at` ties with `k`: a binary search over the
   * separators before `at` (their words at most `k`), ordered by word and then string (as the
   * keys they separate), for the first greater than `key`. Only the separators whose word ties
   * have their strings read (each the fence of a child: its `skeys` line and the string), about
   * log2 of the run of ties.
   */
  private backTiesSlow(base: u64, at: u64, k: u64, key: string): u64 {
    let lo: u64 = 0;
    let hi = at;
    while (lo < hi) {
      const m = (lo + hi) >> 1;
      // A word other than `k` is below it.
      if (this.w[base + keyAt(m)].load("relaxed") != k) {
        lo = m + 1;
        continue;
      }
      // Separator m's string: the fence of child m + 1. Words that disagree, a child out of
      // range or a `null` fence only while a writer changes the node: any answer will do then,
      // the version check after fails.
      const c = this.w[base + childAt(m + 1)].load("relaxed");
      if (c >= this.nodes) {
        return m;
      }
      const s = this.skeys[c * SKEYS + FENCE].load("acquire");
      if (s == null) {
        return m;
      }
      if (strOrder(s, key) > 0) {
        hi = m;
      } else {
        lo = m + 1;
      }
    }
    return lo;
  }

  /** The slot of `key` (word `k`) in the leaf at `base`, or `LEAF_CAP`. */
  private findSlot(base: u64, k: u64, key: K): u64 {
    const cand = this.candidate(base, hashKey(k, key));
    if (cand > LEAF_CAP) {
      return this.findSlotSlow(base, k, key);
    }
    // Without a candidate, read the meta word (already in cache) instead of a pair: an
    // absent key costs no cache line beyond the tags.
    const at = cand < LEAF_CAP ? base + PAIRS + 2 * cand : base + 1;
    const word = this.w[at].load("relaxed");
    if (typeIs<K, string>()) {
      return cand < LEAF_CAP && word == k && this.sameKey(base, cand, asType<string>(key))
        ? cand
        : LEAF_CAP;
    }
    return cand < LEAF_CAP && word == k ? cand : LEAF_CAP;
  }

  /** Whether slot `slot` of the leaf at `base` holds the string `key` (its word matched). */
  private sameKey(base: u64, slot: u64, key: string): bool {
    const s = this.skeys[(base / NODE) * SKEYS + slot].load("acquire");
    return s != null && strSame(s, key);
  }

  /**
   * The one slot whose tag is `k`'s (`k` from `hashKey`), `LEAF_CAP` if none is, `LEAF_CAP + 1`
   * if several are (an empty slot's tag, 0, is no key's).
   */
  private candidate(base: u64, k: u64): u64 {
    const tag = u16x8.splat(tagOf(k) as u16);
    let hits: u64 = 0;
    for (let w: u64 = 0; w < TAG_WORDS; w += 2) {
      const tags = u64x2
        .loadOptimistic(this.w, (base + TAGS + w) as usize)
        .asU8x16()
        .asU16x8();
      hits |= tags.eq(tag).bitmask() << (w * 4);
    }
    if (hits.countOnes() > 1) {
      return LEAF_CAP + 1;
    }
    const cand = hits.trailingZeros() as u64;
    return cand < LEAF_CAP ? cand : LEAF_CAP;
  }

  /** `findSlot` for a key whose tag another key of the leaf shares. */
  private findSlotSlow(base: u64, k: u64, key: K): u64 {
    const pat = tagOf(hashKey(k, key)) * LANES;
    for (let w: u64 = 0; w < TAG_WORDS; w++) {
      const x = this.w[base + TAGS + w].load("relaxed") ^ pat;
      let hits = (x - LANES) & ~x & HIGHS;
      while (hits != 0) {
        const slot = w * 4 + ((hits.trailingZeros() as u64) >> 4);
        if (this.w[base + PAIRS + 2 * slot].load("relaxed") == k) {
          if (typeIs<K, string>()) {
            if (this.sameKey(base, slot, asType<string>(key))) {
              return slot;
            }
          } else {
            return slot;
          }
        }
        hits &= hits - 1;
      }
    }
    return LEAF_CAP;
  }

  /** The tag in slot `slot` of the leaf at `base`, 0 if the slot is empty. */
  private tagAt(base: u64, slot: u64): u64 {
    return (this.w[base + TAGS + (slot >> 2)].load("relaxed") >> ((slot & 3) * 16)) & 65535;
  }

  /** A free slot for a key (`k` from `hashKey`) in the leaf at `base` (held, not full). */
  private freeSlot(base: u64, k: u64): u64 {
    const zero = u16x8.splat(0);
    let empty: u64 = 0;
    for (let w: u64 = 0; w < TAG_WORDS; w += 2) {
      const tags = u64x2
        .loadOptimistic(this.w, (base + TAGS + w) as usize)
        .asU8x16()
        .asU16x8();
      empty |= tags.eq(zero).bitmask() << (w * 4);
    }
    return pick(empty, homeOf(k));
  }

  /** Puts `key` (word `k`) and `val` in a free slot of the leaf at `base` (held, not full). */
  private place(base: u64, k: u64, key: K, val: u64) {
    const h = hashKey(k, key);
    const slot = this.freeSlot(base, h);
    this.w[base + PAIRS + 2 * slot].store(k, "relaxed");
    this.w[base + PAIRS + 1 + 2 * slot].store(val, "relaxed");
    this.setTag(base, slot, h);
    if (typeIs<K, string>()) {
      this.skeys[(base / NODE) * SKEYS + slot].store(shared(asType<string>(key)), "release");
    }
  }

  // --- writes ----------------------------------------------------------------------------

  /** A node for a split: a spare one (its tags cleared) if any, else one never used. */
  private alloc(): u64 {
    while (true) {
      const s = this.spare.load("acquire");
      const top = s & LEN_MASK;
      if (top == 0) {
        break;
      }
      // The next spare, in the meta word; read stale if another thread took `top` meanwhile,
      // and then the exchange fails, as the count of changes moved on.
      const below = this.w[(top - 1) * NODE + 1].load("relaxed") & LEN_MASK;
      if (
        this.spare.compareExchange(
          s,
          ((s & ~LEN_MASK) + SPARE_TAG) | below,
          "acquire",
          "relaxed",
        ) ==
        s
      ) {
        const b = (top - 1) * NODE;
        for (let w: u64 = 0; w < TAG_WORDS; w++) {
          this.w[b + TAGS + w].store(0, "relaxed");
        }
        return top - 1;
      }
    }
    const n = this.next.add(1, "relaxed");
    if (n >= this.nodes) {
      rangeError("set: out of room (create the map with a larger capacity)");
    }
    return n;
  }

  /** One descent of `set` of `key` (word `k`); `false` to start over. */
  private trySet(k: u64, key: K, val: u64): bool {
    let n = this.root.load("acquire");
    let v = this.readVersion(n * NODE);
    if (this.root.load("acquire") != n) {
      return false;
    }
    let parent = NONE;
    let pv: u64 = 0;
    while (true) {
      const base = n * NODE;
      const meta = this.w[base + 1].load("relaxed");
      const leaf = (meta & LEAF_BIT) != 0;
      const len = meta & LEN_MASK;
      if (len >= (leaf ? LEAF_CAP : INNER_CAP)) {
        this.splitFull(n, v, meta, parent, pv);
        return false;
      }
      if (leaf) {
        if (!this.tryLockAt(base, v)) {
          return false;
        }
        const i = this.findSlot(base, k, key);
        if (i < LEAF_CAP) {
          this.w[base + PAIRS + 1 + 2 * i].store(val, "relaxed");
        } else {
          this.place(base, k, key, val);
          this.w[base + 1].store(meta + 1, "relaxed");
        }
        this.unlock(base, v);
        return true;
      }
      const next = this.descend(base, v, k, key);
      if (next == NONE) {
        return false;
      }
      parent = n;
      pv = v;
      n = next;
      v = this.readVersion(n * NODE);
      if (!this.isUnchanged(base, pv)) {
        return false;
      }
    }
  }

  /**
   * Splits full node `n` (at version `v`, its meta word `meta`), holding its parent (`NONE` for
   * the root) at version `pv` too; does nothing if either changed. The caller starts over.
   */
  private splitFull(n: u64, v: u64, meta: u64, parent: u64, pv: u64) {
    const base = n * NODE;
    const leaf = (meta & LEAF_BIT) != 0;
    if (parent != NONE && !this.tryLockAt(parent * NODE, pv)) {
      return;
    }
    if (!this.tryLockAt(base, v)) {
      if (parent != NONE) {
        this.unlock(parent * NODE, pv);
      }
      return;
    }
    if (parent == NONE && this.root.load("relaxed") != n) {
      this.unlock(base, v);
      return;
    }
    const right = this.alloc();
    // For string keys, the split sets `right`'s fence (the separator's string) before `right`
    // is linked.
    let sep: u64 = 0;
    if (typeIs<K, string>()) {
      sep = leaf ? this.splitLeafKeyed(n, right) : this.splitInnerKeyed(n, right);
    } else {
      sep = leaf ? this.splitLeaf(n, right) : this.splitInner(n, right);
    }
    if (parent == NONE) {
      const r = this.alloc();
      const rb = r * NODE;
      this.w[rb + keyAt(0)].store(sep, "relaxed");
      this.padKeys(rb, 1);
      this.w[rb + childAt(0)].store(n, "relaxed");
      this.w[rb + childAt(1)].store(right, "relaxed");
      const below = leaf ? 0 : (meta >> LEVEL_SHIFT) & 255;
      this.w[rb + 1].store(((below + 1) << LEVEL_SHIFT) | 1, "relaxed");
      this.reindex(rb, 1);
      this.root.store(r, "release");
    } else {
      this.insertSeparator(parent, sep, right);
      this.unlock(parent * NODE, pv);
    }
    this.unlock(base, v);
  }

  /** One descent of `set` of a boxed value (`trySet`'s, storing `boxed`); `false` to start over. */
  private trySetBoxed(k: u64, key: K, boxed: shared<V>): bool {
    let n = this.root.load("acquire");
    let v = this.readVersion(n * NODE);
    if (this.root.load("acquire") != n) {
      return false;
    }
    let parent = NONE;
    let pv: u64 = 0;
    while (true) {
      const base = n * NODE;
      const meta = this.w[base + 1].load("relaxed");
      const leaf = (meta & LEAF_BIT) != 0;
      if ((meta & LEN_MASK) >= (leaf ? LEAF_CAP : INNER_CAP)) {
        this.splitFull(n, v, meta, parent, pv);
        return false;
      }
      if (leaf) {
        if (!this.tryLockAt(base, v)) {
          return false;
        }
        let i = this.findSlot(base, k, key);
        if (i >= LEAF_CAP) {
          const h = hashKey(k, key);
          i = this.freeSlot(base, h);
          this.w[base + PAIRS + 2 * i].store(k, "relaxed");
          this.setTag(base, i, h);
          if (typeIs<K, string>()) {
            this.skeys[n * SKEYS + i].store(shared(asType<string>(key)), "release");
          }
          this.w[base + 1].store(meta + 1, "relaxed");
        }
        // Replacing a value retires the one before: freed once no reader has it.
        this.vals[n * LEAF_CAP + i].store(boxed, "release");
        this.unlock(base, v);
        return true;
      }
      const next = this.descend(base, v, k, key);
      if (next == NONE) {
        return false;
      }
      parent = n;
      pv = v;
      n = next;
      v = this.readVersion(n * NODE);
      if (!this.isUnchanged(base, pv)) {
        return false;
      }
    }
  }

  /** The child of the inner node at `base` (at version `v`) that holds `key`, or `NONE`. */
  private descend(base: u64, v: u64, k: u64, key: K): u64 {
    const c = this.w[this.childFor(base, k, key)].load("relaxed");
    if (!this.isUnchanged(base, v) || c >= this.nodes) {
      return NONE;
    }
    return c;
  }

  /**
   * One descent of `add`: `[ADD_DONE, value before]`, `[ADD_ABSENT, 0]` or `[ADD_RETRY, 0]`.
   * The descent is `get`'s; the leaf is then taken exclusively at the version read, as `set`
   * takes it, and the value changed in place.
   */
  private tryAdd(k: u64, key: K, delta: u64): [u64, u64] {
    const n = this.root.load("acquire");
    let b = n * NODE;
    if ((this.w.length as u64) < NODE || b > (this.w.length as u64) - NODE) {
      return [ADD_RETRY, 0];
    }
    let v = this.readVersion(b);
    if (this.root.load("acquire") != n) {
      return [ADD_RETRY, 0];
    }
    let meta = this.w[b + 1].load("relaxed");
    const levels = (meta >> LEVEL_SHIFT) & 255;
    if (levels == 0) {
      // The root is the leaf: take it at the version read.
      if ((meta & LEAF_BIT) == 0 || !this.tryLockAt(b, v)) {
        return [ADD_RETRY, 0];
      }
    } else {
      for (let l: u64 = 1; l < levels; l++) {
        const c = this.w[this.childFor(b, k, key)].load("relaxed");
        const cb = c * NODE;
        if (
          c >= this.nodes || (this.w.length as u64) < NODE || cb > (this.w.length as u64) - NODE
        ) {
          return [ADD_RETRY, 0];
        }
        const vc = this.readVersion(cb);
        if (!this.isUnchanged(b, v)) {
          return [ADD_RETRY, 0];
        }
        b = cb;
        v = vc;
      }
      const c = this.w[this.childFor(b, k, key)].load("relaxed");
      const cb = c * NODE;
      if (c >= this.nodes || (this.w.length as u64) < NODE || cb > (this.w.length as u64) - NODE) {
        return [ADD_RETRY, 0];
      }
      // The leaf: taken at once, its latch's line fetched for writing by this one
      // read-modify-write (a version read first would fetch it shared, the take again). It is
      // the right leaf if the parent did not change since it named it: a leaf's keys change
      // hands only in a split, which changes the parent.
      const old = this.w[cb].or(EXCLUSIVE, "acquire");
      if ((old & EXCLUSIVE) != 0) {
        return [ADD_RETRY, 0];
      }
      // As in `tryLockAt`: the latch is taken before any write to the leaf is seen (a reader
      // that sees the add taken back from another key's value sees the leaf changed).
      Atomic.fence("release");
      if (!this.isUnchanged(b, v)) {
        this.unlock(cb, old & ~SHARED_MASK);
        return [ADD_RETRY, 0];
      }
      b = cb;
      v = old & ~SHARED_MASK;
      meta = this.w[b + 1].load("relaxed");
    }
    if ((meta & LEAF_BIT) == 0) {
      this.unlock(b, v);
      return [ADD_RETRY, 0];
    }
    // Write first, to the home slot: its value word is the first access to its pair's line,
    // which then arrives ready for writing (a read first would fetch it shared, and the write
    // would have to fetch it again). The key, in the same line, is checked after; if it is not
    // there, the add is taken back while the leaf is still held, so no reader sees it.
    const h = homeOf(hashKey(k, key));
    const hat = b + PAIRS + 1 + 2 * h;
    const was = this.w[hat].add(delta, "relaxed");
    if (this.w[hat - 1].load("relaxed") == k && this.tagAt(b, h) != 0) {
      if (typeIs<K, string>()) {
        if (this.sameKey(b, h, asType<string>(key))) {
          this.unlock(b, v);
          return [ADD_DONE, was];
        }
      } else {
        this.unlock(b, v);
        return [ADD_DONE, was];
      }
    }
    this.w[hat].sub(delta, "relaxed");
    const i = this.findSlot(b, k, key);
    if (i >= LEAF_CAP) {
      this.unlock(b, v);
      return [ADD_ABSENT, 0];
    }
    const at = b + PAIRS + 1 + 2 * i;
    const before = this.w[at].add(delta, "relaxed");
    this.unlock(b, v);
    return [ADD_DONE, before];
  }

  /**
   * One descent of `delete`: `DEL_DONE`, `DEL_ABSENT`, `DEL_RETRY`, or `DEL_LAST` (nothing done)
   * when the key's leaf holds one key and has a parent: then `tryDeleteLast` unlinks it.
   */
  private tryDelete(k: u64, key: K): u64 {
    let n = this.root.load("acquire");
    let v = this.readVersion(n * NODE);
    if (this.root.load("acquire") != n) {
      return DEL_RETRY;
    }
    let depth: u64 = 0;
    while (true) {
      const base = n * NODE;
      const meta = this.w[base + 1].load("relaxed");
      if ((meta & LEAF_BIT) == 0) {
        const next = this.descend(base, v, k, key);
        if (next == NONE) {
          return DEL_RETRY;
        }
        n = next;
        const vc = this.readVersion(n * NODE);
        if (!this.isUnchanged(base, v)) {
          return DEL_RETRY;
        }
        v = vc;
        depth++;
        continue;
      }
      if (depth > 0 && (meta & LEN_MASK) == 1) {
        // Only for a key the leaf holds: `tryDeleteLast` takes the whole path and bumps every
        // version, which an absent key needs not cost concurrent readers.
        const i = this.findSlot(base, k, key);
        if (!this.isUnchanged(base, v)) {
          return DEL_RETRY;
        }
        return i < LEAF_CAP ? DEL_LAST : DEL_ABSENT;
      }
      return this.deleteIn(base, v, meta, k, key);
    }
  }

  /**
   * Deletes `key` (word `k`) from the leaf at `base`, taken at version `v` (its meta word read at
   * it).
   */
  private deleteIn(base: u64, v: u64, meta: u64, k: u64, key: K): u64 {
    if (!this.tryLockAt(base, v)) {
      return DEL_RETRY;
    }
    const i = this.findSlot(base, k, key);
    if (i >= LEAF_CAP) {
      this.unlock(base, v);
      return DEL_ABSENT;
    }
    this.clearTag(base, i);
    if (!typeIs<V, u64>()) {
      this.vals[(base / NODE) * LEAF_CAP + i].store(null, "release");
    }
    if (typeIs<K, string>()) {
      this.skeys[(base / NODE) * SKEYS + i].store(null, "release");
    }
    this.w[base + 1].store(meta - 1, "relaxed");
    this.unlock(base, v);
    return DEL_DONE;
  }

  /**
   * One descent of `delete` for a key whose leaf holds only it: the leaf, and the inner nodes
   * above it that have no other child, are unlinked from the lowest ancestor with another child
   * and put on the free list. Every node from that ancestor down is taken at the version read on
   * the way down, so none changed since. Without such an ancestor the leaf only empties.
   */
  private tryDeleteLast(k: u64, key: K): u64 {
    // Node, version pairs from the root down.
    const path: u64[] = [];
    let n = this.root.load("acquire");
    let v = this.readVersion(n * NODE);
    if (this.root.load("acquire") != n) {
      return DEL_RETRY;
    }
    // The lowest inner node seen with two children or more, as an index into `path`.
    let top = NONE;
    let meta: u64 = 0;
    while (true) {
      const base = n * NODE;
      meta = this.w[base + 1].load("relaxed");
      path.push(n);
      path.push(v);
      if ((meta & LEAF_BIT) != 0) {
        break;
      }
      if ((meta & LEN_MASK) > 0) {
        top = path.length as u64 - 2;
      }
      const next = this.descend(base, v, k, key);
      if (next == NONE) {
        return DEL_RETRY;
      }
      n = next;
      const vc = this.readVersion(n * NODE);
      if (!this.isUnchanged(base, v)) {
        return DEL_RETRY;
      }
      v = vc;
    }
    const leaf = n * NODE;
    if (top == NONE || (meta & LEN_MASK) != 1) {
      return this.deleteIn(leaf, v, meta, k, key);
    }
    const end = path.length as u64;
    for (let j = top; j < end; j += 2) {
      if (!this.tryLockAt(path[j] * NODE, path[j + 1])) {
        // Back out of those taken, in the order taken.
        for (let u = top; u < j; u += 2) {
          this.unlock(path[u] * NODE, path[u + 1]);
        }
        return DEL_RETRY;
      }
    }
    const i = this.findSlot(leaf, k, key);
    if (i < LEAF_CAP) {
      this.clearTag(leaf, i);
      if (!typeIs<V, u64>()) {
        this.vals[n * LEAF_CAP + i].store(null, "release");
      }
      if (typeIs<K, string>()) {
        this.skeys[n * SKEYS + i].store(null, "release");
      }
      this.w[leaf + 1].store(meta - 1, "relaxed");
      this.removeChild(path[top], k, key);
    }
    if (typeIs<K, string>()) {
      if (i < LEAF_CAP) {
        for (let j = top + 2; j < end; j += 2) {
          this.skeys[path[j] * SKEYS + FENCE].store(null, "release");
        }
      }
    }
    // Every node is unlocked with its version bumped, the freed ones too, before `release`. A
    // reused node is not locked or bumped again: its version is already newer than any a stale
    // holder read before the free. That keeps writers out of reused nodes: a `set` that stopped
    // at a freed leaf after validating its parent fails `tryLockAt` at the version it read, where
    // it would otherwise put its key into a leaf of another range (or an unlinked one). Readers
    // would be safe without it, since a freed node's range was empty.
    for (let j = top; j < end; j += 2) {
      this.unlock(path[j] * NODE, path[j + 1]);
    }
    if (i >= LEAF_CAP) {
      return DEL_ABSENT;
    }
    // Unlocked first: a reader that still reaches one waits while it is held.
    for (let j = top + 2; j < end; j += 2) {
      this.release(path[j]);
    }
    return DEL_DONE;
  }

  /**
   * Removes the child holding `key` (word `k`) from inner node `p` (held, with two children or
   * more), and one key next to it, so a neighbour takes over its (empty) range.
   */
  private removeChild(p: u64, k: u64, key: K) {
    const b = p * NODE;
    const meta = this.w[b + 1].load("relaxed");
    const len = meta & LEN_MASK;
    let i: u64 = 0;
    if (typeIs<K, string>()) {
      i = this.backTies(b, this.position(b, k), k, asType<string>(key));
    } else {
      i = this.position(b, k);
    }
    // Child i lies between keys i - 1 and i: the first child goes with the key after it, any
    // other with the key before it. (For string keys, separator i - 1's string goes with child
    // i, its fence, cleared as the child is freed.)
    const sep = i > 0 ? i - 1 : 0;
    if (typeIs<K, string>()) {
      // Separator 0 goes with child 0: its string is the fence of child 1, which becomes the
      // first child, whose fence is never read. Cleared (retired to the epoch: a reader of the
      // version before may still read it), so it keeps no deleted key's string alive.
      if (i == 0) {
        const c = this.w[b + childAt(1)].load("relaxed");
        if (c < this.nodes) {
          this.skeys[c * SKEYS + FENCE].store(null, "release");
        }
      }
    }
    for (let j = sep; j + 1 < len; j++) {
      this.w[b + keyAt(j)].store(this.w[b + keyAt(j + 1)].load("relaxed"), "relaxed");
    }
    this.w[b + keyAt(len - 1)].store(MAX_KEY, "relaxed");
    for (let j = i; j < len; j++) {
      this.w[b + childAt(j)].store(this.w[b + childAt(j + 1)].load("relaxed"), "relaxed");
    }
    this.w[b + 1].store(meta - 1, "relaxed");
    this.reindex(b, len - 1);
  }

  /** Pushes node `n`, unlinked and not held, on the free list. */
  private release(n: u64) {
    while (true) {
      const s = this.spare.load("relaxed");
      this.w[n * NODE + 1].store(s & LEN_MASK, "relaxed");
      if (
        this.spare.compareExchange(
          s,
          ((s & ~LEN_MASK) + SPARE_TAG) | (n + 1),
          "release",
          "relaxed",
        ) ==
        s
      ) {
        return;
      }
    }
  }

  /** Puts the tag of a key (`k` from `hashKey`) in lane `slot` of the leaf at `base` (held). */
  private setTag(base: u64, slot: u64, k: u64) {
    const at = base + TAGS + (slot >> 2);
    const sh = (slot & 3) * 16;
    const w = this.w[at].load("relaxed");
    this.w[at].store((w & ~(65535 << sh)) | (tagOf(k) << sh), "relaxed");
  }

  /** Empties lane `slot` of the leaf at `base` (held). */
  private clearTag(base: u64, slot: u64) {
    const at = base + TAGS + (slot >> 2);
    const sh = (slot & 3) * 16;
    this.w[at].store(this.w[at].load("relaxed") & ~(65535 << sh), "relaxed");
  }

  /** Fills the key slots of the inner node at `base` from slot `from` on with `MAX_KEY`. */
  private padKeys(base: u64, from: u64) {
    for (let j = from; j < 56; j++) {
      this.w[base + keyAt(j)].store(MAX_KEY, "relaxed");
    }
  }

  /** Rewrites the index of the inner node at `base` (held) from its `len` keys. */
  private reindex(base: u64, len: u64) {
    for (let g: u64 = 0; g < GROUPS; g++) {
      const at = g * 8 + 7;
      const key = at < len ? this.w[base + keyAt(at)].load("relaxed") : MAX_KEY;
      this.w[base + INDEX + g].store(key, "relaxed");
    }
  }

  /** Sorts full leaf `n` and moves its upper half to the empty node `r`; `r`'s least key. */
  private splitLeaf(n: u64, r: u64): u64 {
    const b = n * NODE;
    const rb = r * NODE;
    // Insertion sort of the full leaf's pairs, shifting elements in place (no `splice`).
    const keys: u64[] = [];
    const vals: u64[] = [];
    keys.reserve(LEAF_CAP as usize);
    vals.reserve(LEAF_CAP as usize);
    const boxed = !typeIs<V, u64>();
    for (let j: u64 = 0; j < LEAF_CAP; j++) {
      const k = this.w[b + PAIRS + 2 * j].load("relaxed");
      // A boxed value's word carries its slot through the sort, to move it after.
      const v = boxed ? j : this.w[b + PAIRS + 1 + 2 * j].load("relaxed");
      keys.push(k);
      vals.push(v);
      let at = j;
      while (at > 0 && keys[at - 1] > k) {
        keys[at] = keys[at - 1];
        vals[at] = vals[at - 1];
        at--;
      }
      keys[at] = k;
      vals[at] = v;
    }
    const keep = LEAF_CAP / 2;
    for (let w: u64 = 0; w < TAG_WORDS; w++) {
      this.w[b + TAGS + w].store(0, "relaxed");
    }
    // Each key to its home slot in its new leaf where it can (`r` is a new node: all empty).
    this.fill(b, keys, vals, 0, keep);
    this.fill(rb, keys, vals, keep, LEAF_CAP);
    if (boxed) {
      this.moveBoxed(n, r);
    }
    this.w[rb + 1].store(LEAF_BIT | (LEAF_CAP - keep), "relaxed");
    this.w[b + 1].store(LEAF_BIT | keep, "relaxed");
    return keys[keep];
  }

  /** Puts pairs `from` until `to` of `keys` and `vals` in the empty leaf at `base`. */
  private fill(base: u64, keys: u64[], vals: u64[], from: u64, to: u64) {
    let free: u64 = (1 << LEAF_CAP) - 1;
    for (let j = from; j < to; j++) {
      const k = keys[j];
      const slot = pick(free, homeOf(k));
      free &= ~(1 << slot);
      this.w[base + PAIRS + 2 * slot].store(k, "relaxed");
      this.w[base + PAIRS + 1 + 2 * slot].store(vals[j], "relaxed");
      this.setTag(base, slot, k);
    }
  }

  /**
   * Moves the boxed values of full leaf `n` (held) to the slots `splitLeaf` gave their keys in
   * `n` and `r`, whose value words name the slot of `n` each came from.
   */
  private moveBoxed(n: u64, r: u64) {
    const taken: (shared<V> | null)[] = [];
    taken.reserve(LEAF_CAP as usize);
    for (let j: u64 = 0; j < LEAF_CAP; j++) {
      taken.push(this.vals[n * LEAF_CAP + j].exchange(null, "acquire"));
    }
    for (let side: u64 = 0; side < 2; side++) {
      const node = side == 0 ? n : r;
      const base = node * NODE;
      for (let slot: u64 = 0; slot < LEAF_CAP; slot++) {
        if (this.tagAt(base, slot) != 0) {
          const from = this.w[base + PAIRS + 1 + 2 * slot].load("relaxed");
          this.vals[node * LEAF_CAP + slot].store(taken[from], "release");
        }
      }
    }
  }

  /** Moves the upper half of full inner node `n` to `r`; the middle key goes up. */
  private splitInner(n: u64, r: u64): u64 {
    const b = n * NODE;
    const rb = r * NODE;
    const keep = INNER_CAP / 2;
    const sep = this.w[b + keyAt(keep)].load("relaxed");
    const moved = INNER_CAP - keep - 1;
    for (let j: u64 = 0; j < moved; j++) {
      this.w[rb + keyAt(j)].store(this.w[b + keyAt(keep + 1 + j)].load("relaxed"), "relaxed");
    }
    for (let j: u64 = 0; j <= moved; j++) {
      this.w[rb + childAt(j)].store(this.w[b + childAt(keep + 1 + j)].load("relaxed"), "relaxed");
    }
    const level = this.w[b + 1].load("relaxed") & ~LEN_MASK;
    this.padKeys(rb, moved);
    this.w[rb + 1].store(level | moved, "relaxed");
    this.reindex(rb, moved);
    this.padKeys(b, keep);
    this.w[b + 1].store(level | keep, "relaxed");
    this.reindex(b, keep);
    return sep;
  }

  /**
   * Adds `sep` and the child `right` after it to inner node `p` (held, not full); for string
   * keys, `right`'s fence is the separator's string.
   */
  private insertSeparator(p: u64, sep: u64, right: u64) {
    const b = p * NODE;
    const meta = this.w[b + 1].load("relaxed");
    const len = meta & LEN_MASK;
    let i: u64 = 0;
    if (typeIs<K, string>()) {
      const s = this.skeys[right * SKEYS + FENCE].load("acquire");
      i = s == null ? this.position(b, sep) : this.backTies(b, this.position(b, sep), sep, s);
    } else {
      i = this.position(b, sep);
    }
    for (let j = len; j > i; j--) {
      this.w[b + keyAt(j)].store(this.w[b + keyAt(j - 1)].load("relaxed"), "relaxed");
      this.w[b + childAt(1 + j)].store(this.w[b + childAt(j)].load("relaxed"), "relaxed");
    }
    this.w[b + keyAt(i)].store(sep, "relaxed");
    this.w[b + childAt(1 + i)].store(right, "relaxed");
    this.w[b + 1].store(meta + 1, "relaxed");
    this.reindex(b, len + 1);
  }

  // --- string keys -----------------------------------------------------------------------

  /**
   * `splitLeaf` for string keys: moves the upper half of full leaf `n` (held), by word and then
   * string, to the empty node `r`, each key's string (and boxed value) with it, and makes `r`'s
   * least key its fence; the separator's word. The lower half stays in its slots: every string
   * moved is retired from its slot, so as few move as can.
   */
  private splitLeafKeyed(n: u64, r: u64): u64 {
    const b = n * NODE;
    const rb = r * NODE;
    // Insertion sort of the words, with their slots, as `splitLeaf`'s.
    const keys: u64[] = [];
    const slots: u64[] = [];
    keys.reserve(LEAF_CAP as usize);
    slots.reserve(LEAF_CAP as usize);
    for (let j: u64 = 0; j < LEAF_CAP; j++) {
      const k = this.w[b + PAIRS + 2 * j].load("relaxed");
      keys.push(k);
      slots.push(j);
      let at = j;
      while (at > 0 && keys[at - 1] > k) {
        keys[at] = keys[at - 1];
        slots[at] = slots[at - 1];
        at--;
      }
      keys[at] = k;
      slots[at] = j;
    }
    // Only the keys whose words tie with the middle one need their strings to choose the half.
    const keep = LEAF_CAP / 2;
    let lo = keep;
    while (lo > 0 && keys[lo - 1] == keys[keep]) {
      lo--;
    }
    let hi = keep + 1;
    while (hi < LEAF_CAP && keys[hi] == keys[keep]) {
      hi++;
    }
    if (hi - lo > 1) {
      this.sortTies(n, slots, lo, hi);
    }
    const boxed = !typeIs<V, u64>();
    let free: u64 = (1 << LEAF_CAP) - 1;
    for (let j = keep; j < LEAF_CAP; j++) {
      const from = slots[j];
      const s = this.skeys[n * SKEYS + from].exchange(null, "acquire");
      const h = s == null ? 0 : strHash(s);
      const slot = pick(free, homeOf(h));
      free &= ~(1 << slot);
      this.w[rb + PAIRS + 2 * slot].store(keys[j], "relaxed");
      this.w[rb + PAIRS + 1 + 2 * slot].store(
        this.w[b + PAIRS + 1 + 2 * from].load("relaxed"),
        "relaxed",
      );
      this.setTag(rb, slot, h);
      this.clearTag(b, from);
      if (j == keep) {
        this.skeys[r * SKEYS + FENCE].store(s, "release");
      }
      this.skeys[r * SKEYS + slot].store(s, "release");
      if (boxed) {
        this.vals[r * LEAF_CAP + slot].store(
          this.vals[n * LEAF_CAP + from].exchange(null, "acquire"),
          "release",
        );
      }
    }
    this.w[rb + 1].store(LEAF_BIT | (LEAF_CAP - keep), "relaxed");
    this.w[b + 1].store(LEAF_BIT | keep, "relaxed");
    return keys[keep];
  }

  /** Sorts `slots[lo..hi]`, slots of leaf `n` (held) whose words tie, by their strings. */
  private sortTies(n: u64, slots: u64[], lo: u64, hi: u64) {
    for (let j = lo + 1; j < hi; j++) {
      const x = slots[j];
      const sx = this.skeys[n * SKEYS + x].load("acquire");
      let at = j;
      while (at > lo) {
        const sy = this.skeys[n * SKEYS + slots[at - 1]].load("acquire");
        if (sx == null || sy == null || strOrder(sy, sx) <= 0) {
          break;
        }
        slots[at] = slots[at - 1];
        at--;
      }
      slots[at] = x;
    }
  }

  /**
   * `splitInner` for string keys: the middle separator, which goes up, is the fence of child
   * `keep + 1`, which becomes `r`'s first child, whose fence is never read: the string moves to
   * `r`'s fence (no copy, nothing retired; a reader of `n` that reads the child's fence `null`
   * meanwhile fails `n`'s version check).
   */
  private splitInnerKeyed(n: u64, r: u64): u64 {
    const c = this.w[n * NODE + childAt(INNER_CAP / 2 + 1)].load("relaxed");
    this.skeys[r * SKEYS + FENCE].store(
      this.skeys[c * SKEYS + FENCE].exchange(null, "acquire"),
      "release",
    );
    return this.splitInner(n, r);
  }
}
