// velt/collections (internal): `Set<T>`, an insertion-ordered hash set with JS `Set` semantics,
// plus the ES2025 set algebra (`union`, `intersection`, `difference`, `symmetricDifference`,
// `isSubsetOf`, `isSupersetOf`, `isDisjointFrom`).
//
// Built on the prelude `Map<T, bool>` (Robin Hood index over dense insertion-ordered entries),
// so elements compare as map keys do: numbers, bool and strings by value, objects (class
// instances, object types, arrays, interface and function values) by identity, as in JS, and
// tuples part by part. `add` takes ownership of the element; `values()` and the algebra results
// hold the stored elements (objects shared, as in JS); `forEach` borrows.

import { share } from "velt/lang/intrinsics";
import { adaptMismatch } from "velt/lang/hooks/adapt";
import { anyFnArg } from "velt/lang/hooks/any_methods";

/** An insertion-ordered set of unique values. */
export class Set<T> implements Iterable<T> {
  private items: Map<T, bool> = new Map<T, bool>();

  /**
   * A set holding each distinct element of `values` (like JS `new Set(values)`), in
   * first-occurrence order. Leaves `values` as it is; the set shares the elements, like JS.
   * Each element goes through `add`, so a subclass's own `add` sees every one, as in JS
   * (ECMA-262's "adder"; `Map`'s constructor calls `set` the same way).
   */
  constructor(values: T[] = []) {
    for (const v of values) {
      this.add(v);
    }
  }

  /** A set holding each distinct element of `xs` (shared), in first-occurrence order. */
  static from(xs: T[]): Set<T> {
    return new Set<T>(xs);
  }

  /** Number of elements. */
  get size(): usize {
    return this.items.size;
  }

  /**
   * Inserts `value`; a value already present keeps its position (the new copy is dropped).
   * Returns the set itself, as in JS (`s.add(1).add(2)`); a result nobody uses costs nothing.
   */
  add(value: T): this {
    this.items.set(value, true);
    return this;
  }

  /** Whether `value` is in the set. */
  has(value: T): bool {
    return this.items.has(value);
  }

  /** Removes `value`; returns whether it was present. */
  delete(value: T): bool {
    return this.items.delete(value);
  }

  /** Removes every element. */
  clear() {
    this.items.clear();
  }

  /** Whether the set has no elements. */
  isEmpty(): bool {
    return this.items.size == 0;
  }

  /** The elements in insertion order, objects shared as in JS (`for (const x of s.values())`). */
  values(): T[] {
    return this.items.keys();
  }

  /** The elements in insertion order, as `values()` (JS gives sets `keys` for `Map`'s sake). */
  keys(): T[] {
    return this.items.keys();
  }

  /** `[value, value]` for each element in insertion order (JS's `entries`, shaped as `Map`'s). */
  entries(): [T, T][] {
    const out: [T, T][] = [];
    for (const x of this.items.keys()) {
      out.push([share(x), share(x)]);
    }
    return out;
  }

  /**
   * An iterator over the elements when it is made, in insertion order. It reads the set itself,
   * never a subclass's `values`, as in JS.
   */
  [Symbol.iterator](): Iterator<T> {
    return new ArrayIterator<T>(this.items.keys());
  }

  /** Visits the elements in insertion order, borrowing them. */
  forEach<E>(f: (value: T) => void throws E) throws E {
    this.items.forEach((_present, key) => {
      f(key);
    });
  }

  // The set algebra follows ES2025: it reads this set's own elements, never a subclass's
  // members, and of `other` only `size` (once, first), `has` and `keys`, in the spec's order, so
  // a subclass sees the calls Node makes. The result is a plain `Set`.

  /** Elements of this set, then those of `other` not in it. */
  union(other: Set<T>): Set<T> {
    other.size;
    const out = new Set<T>(this.items.keys());
    for (const x of other.keys()) {
      out.items.set(share(x), true);
    }
    return out;
  }

  /**
   * Elements of this set that are also in `other`: in this set's order, asking `other.has`,
   * unless `other` is smaller, whose `keys` are then looked up here, in its order.
   */
  intersection(other: Set<T>): Set<T> {
    const out = new Set<T>();
    if (this.items.size <= other.size) {
      for (const x of this.items.keys()) {
        if (other.has(x)) {
          out.items.set(share(x), true);
        }
      }
    } else {
      for (const x of other.keys()) {
        if (this.items.has(x)) {
          out.items.set(share(x), true);
        }
      }
    }
    return out;
  }

  /** Elements of this set that are not in `other` (`other.has`, or its `keys` when smaller). */
  difference(other: Set<T>): Set<T> {
    if (this.items.size <= other.size) {
      const out = new Set<T>();
      for (const x of this.items.keys()) {
        if (!other.has(x)) {
          out.items.set(share(x), true);
        }
      }
      return out;
    }
    const out = new Set<T>(this.items.keys());
    for (const x of other.keys()) {
      out.items.delete(x);
    }
    return out;
  }

  /** Elements in exactly one of the two sets (this set's first, then `other`'s). */
  symmetricDifference(other: Set<T>): Set<T> {
    other.size;
    const out = new Set<T>(this.items.keys());
    for (const x of other.keys()) {
      if (this.items.has(x)) {
        out.items.delete(x);
      } else {
        out.items.set(share(x), true);
      }
    }
    return out;
  }

  /** Whether every element of this set is in `other` (asking `other.has` until one is not). */
  isSubsetOf(other: Set<T>): bool {
    if (this.items.size > other.size) {
      return false;
    }
    for (const x of this.items.keys()) {
      if (!other.has(x)) {
        return false;
      }
    }
    return true;
  }

  /** Whether every element of `other` is in this set (reading `other.keys` until one is not). */
  isSupersetOf(other: Set<T>): bool {
    if (this.items.size < other.size) {
      return false;
    }
    for (const x of other.keys()) {
      if (!this.items.has(x)) {
        return false;
      }
    }
    return true;
  }

  /** Whether the sets share no element (`other.has`, or its `keys` when smaller). */
  isDisjointFrom(other: Set<T>): bool {
    if (this.items.size <= other.size) {
      for (const x of this.items.keys()) {
        if (other.has(x)) {
          return false;
        }
      }
      return true;
    }
    for (const x of other.keys()) {
      if (this.items.has(x)) {
        return false;
      }
    }
    return true;
  }
}

/**
 * `s.forEach(f)` through `any`: `f(value, value, whole)` per element, in insertion order;
 * `whole` is `s` as an `any` of its own class (a class extending `Set`, with its own members).
 */
function anySet_forEach<T>(s: Set<T>, args: any[], whole: any): any {
  const f = anyFnArg(args, 0);
  s.forEach((x) => {
    const value: any = x;
    f(value, value, whole);
  });
  return undefined;
}

// The copy an interface adapter passes for a `Set<unknown>` parameter (std/lang/hooks).

/** A set of any type held by `v`, as a `Set<unknown>` of its elements. */
function unknownSetIn(v: unknown): Set<unknown> {
  if (!(v instanceof Set)) {
    adaptMismatch(v, "a Set<unknown>");
  }
  const a = v as any;
  const vs = a.values();
  const n = vs.length as number;
  const out = new Set<unknown>();
  for (let i = 0; i < n; i++) {
    out.add(vs[i]);
  }
  return out;
}

/** Writes the elements of `s` back into the set `v` holds (`unknownSetIn`). */
function unknownSetOut(v: unknown, s: Set<unknown>): void {
  const a = v as any;
  a.clear();
  for (const x of s) {
    a.add(x);
  }
}

/**
 * TypeScript's `ReadonlySet<T>`: a `Set<T>` that a variable or parameter declared with this
 * type may not change (`add`, `delete` and `clear` are errors through it).
 */
export type ReadonlySet<T> = Set<T>;
