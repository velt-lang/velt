// std/collections/btree_map: `BTreeMap<K, V>`, a map that keeps its keys in ascending order
// (`K extends Comparable<K>`: numbers, strings, bool, user types that implement `Comparable`).
//
// A B+tree of 32-slot nodes in flat pools (velt:collections/btree/pool): lookups, inserts and
// deletes are O(log n) and touch a few cache lines per level; ordered walks follow the linked
// leaves. Keys with an order-preserving encoding (`InlineKey`: numbers, `bool`, strings, and user
// types that implement it) are searched by two bytes of it per key, eight keys per compare. Values are shared as `Map` shares them (objects are not copied); keys are shared too.

import {
  F,
  NONE,
  Pool,
  SLOT_MASK,
  SLOT_SHIFT,
  valueOf,
  windowOf,
} from "velt:collections/btree/pool";
import { insert } from "velt:collections/btree/insert";
import { removeAt } from "velt:collections/btree/remove";
import { afterRemove, edgeOrder, isEdge } from "velt:collections/btree/edges";
import { NO_SLOT, descendMany, leafFind, leafRank, slotAtRank } from "velt:collections/btree/leaf";

export { InlineKey } from "velt:collections/btree/inline_key";

/** How many lookups of a `getMany` batch run interleaved. */
const BATCH: usize = 16;

/** A map ordered by key, as a B+tree. */
export class BTreeMap<K extends Comparable<K>, V> implements Iterable<[K, V]> {
  private p: Pool<K, V>;

  /** A map holding `entries` (a later entry replaces an earlier one with the same key). */
  constructor(entries: [K, V][] = []) {
    this.p = new Pool<K, V>();
    for (const [k, v] of entries) {
      insert(this.p, k, v);
    }
  }

  /** Number of entries. */
  get size(): usize {
    return this.p.size;
  }

  /** Whether the map is empty. */
  isEmpty(): bool {
    return this.p.size == 0;
  }

  /** Removes every entry. */
  clear() {
    this.p.clear();
  }

  /** Inserts or replaces the value for `key`. */
  set(key: K, value: V) {
    insert(this.p, key, value);
  }

  /** The value for `key` (shared, as `Map.get` returns it), or `undefined`. */
  get(key: K): V | undefined {
    if (this.p.size == 0) {
      return undefined;
    }
    const win = windowOf(key);
    const leaf = this.p.leafOf(key, win);
    const s = leafFind(this.p, leaf, key, win);
    if (s == NO_SLOT) {
      return undefined;
    }
    return this.p.valAt((leaf as usize) * F + s);
  }

  /**
   * The values for `keys`, in order (`undefined` for a key that is not present), as `get` gives
   * them. The lookups of a batch run interleaved, each one's next node loading while the others
   * search theirs, so in a map larger than the CPU's caches a batch costs a fraction of as many
   * `get`s.
   */
  getMany(keys: K[]): (V | undefined)[] {
    const out: (V | undefined)[] = __intrinsic_array_with_capacity(keys.length);
    if (this.p.size == 0) {
      for (let i: usize = 0; i < keys.length; i++) {
        out.push(undefined);
      }
      return out;
    }
    const leaves: u32[] = __intrinsic_array_with_capacity(BATCH);
    const slots: usize[] = __intrinsic_array_with_capacity(BATCH);
    for (let start: usize = 0; start < keys.length; start += BATCH) {
      const m = keys.length - start < BATCH ? keys.length - start : BATCH;
      descendMany(this.p, keys, start, m, leaves, slots);
      for (let j: usize = 0; j < m; j++) {
        const leaf = leaves[j];
        const key = keys[start + j];
        let s = slots[j];
        if (s != NO_SLOT && this.p.cmpKey(key, (leaf as usize) * F + s) != 0) {
          // Another key with the same word: look at all of them.
          s = leafFind(this.p, leaf, key, windowOf(key));
        }
        out.push(s == NO_SLOT ? undefined : this.p.valAt((leaf as usize) * F + s));
      }
    }
    return out;
  }

  /** Whether `key` is present. */
  has(key: K): bool {
    if (this.p.size == 0) {
      return false;
    }
    const win = windowOf(key);
    return leafFind(this.p, this.p.leafOf(key, win), key, win) != NO_SLOT;
  }

  /** Removes `key`; returns whether it was present. */
  delete(key: K): bool {
    if (this.p.size == 0) {
      return false;
    }
    const win = windowOf(key);
    const leaf = this.p.findLeaf(key, win);
    const s = leafFind(this.p, leaf, key, win);
    if (s == NO_SLOT) {
      return false;
    }
    const edge = isEdge(this.p, key, win);
    removeAt(this.p, leaf, s);
    if (edge || this.p.size == 0) {
      afterRemove(this.p);
    }
    return true;
  }

  /** The keys, ascending. */
  keys(): K[] {
    const out: K[] = __intrinsic_array_with_capacity(this.p.size);
    let leaf = this.firstLeaf();
    while (leaf != NONE) {
      const base = (leaf as usize) * F;
      const n = this.p.leafCount(leaf);
      const ranks = this.ranks(leaf);
      for (let i: usize = 0; i < n; i++) {
        out.push(this.p.keyAt(base + (ranks[i] as usize)));
      }
      leaf = this.p.leafNext[leaf as usize];
    }
    return out;
  }

  /** The values, in key order (shared). */
  values(): V[] {
    const out: V[] = __intrinsic_array_with_capacity(this.p.size);
    let leaf = this.firstLeaf();
    while (leaf != NONE) {
      const base = (leaf as usize) * F;
      const n = this.p.leafCount(leaf);
      const ranks = this.ranks(leaf);
      for (let i: usize = 0; i < n; i++) {
        out.push(this.p.valAt(base + (ranks[i] as usize)));
      }
      leaf = this.p.leafNext[leaf as usize];
    }
    return out;
  }

  /** The `[key, value]` pairs, in key order. */
  entries(): [K, V][] {
    const out: [K, V][] = __intrinsic_array_with_capacity(this.p.size);
    let leaf = this.firstLeaf();
    while (leaf != NONE) {
      this.pushEntries(out, leaf, 0, this.p.leafCount(leaf));
      leaf = this.p.leafNext[leaf as usize];
    }
    return out;
  }

  /** An iterator over the entries when it is made (`entries()`), in key order. */
  [Symbol.iterator](): Iterator<[K, V]> {
    return new ArrayIterator<[K, V]>(this.entries());
  }

  /**
   * Visits the entries in key order (JS argument order: value, key). When the callback changes
   * the map through another reference, the walk goes on from the first key after the one it
   * visited last: keys added past it are visited, keys deleted before their turn are not.
   */
  forEach<E>(f: (value: V, key: K) => void throws E) throws E {
    if (this.p.size == 0) {
      return;
    }
    // Per leaf: its count, its rank order as bytes, and the chunks of its keys and values, read
    // once; per entry a callback and a check that it left the map as it was.
    const ranks: u8[] = new Array<u8>(32).fill(0);
    let last = this.p.fill[0];
    let leaf = this.firstLeaf();
    let i: usize = 0;
    while (leaf != NONE) {
      // The next two leaves load while this one is walked: leaves are in no order in memory.
      const next = this.p.leafNext[leaf as usize];
      if (next != NONE) {
        const after = this.p.leafNext[next as usize];
        if (after != NONE) {
          this.p.prefetchLeaf(after);
        }
      }
      const n = this.p.leafCount(leaf);
      const order = this.p.orderOf(leaf);
      order[0].store(ranks, 0);
      order[1].store(ranks, 16);
      const base = (leaf as usize) * F;
      const c = base >> SLOT_SHIFT;
      const off = base & SLOT_MASK;
      const keys = this.p.leafKeys[c];
      const edits = this.p.edits;
      let changed = false;
      if (this.p.plainVals()) {
        const vals = this.p.valPlain[c];
        while (i < n) {
          const s = off + (ranks[i] as usize);
          const key = keys[s];
          f(vals[s], key);
          if (this.p.edits != edits) {
            last = key;
            changed = true;
            break;
          }
          i++;
        }
      } else {
        const vals = this.p.valOpt[c];
        while (i < n) {
          const s = off + (ranks[i] as usize);
          const key = keys[s];
          f(valueOf(vals[s]), key);
          if (this.p.edits != edits) {
            last = key;
            changed = true;
            break;
          }
          i++;
        }
      }
      if (!changed) {
        leaf = this.p.leafNext[leaf as usize];
        i = 0;
        continue;
      }
      // The keys changed: go on from the first key after the one visited last.
      if (this.p.size == 0) {
        return;
      }
      const edge = edgeOrder(this.p, last, windowOf(last));
      if (edge > 0) {
        return;
      }
      leaf = edge < 0 ? this.p.edgeLeaf(false) : this.p.leafOf(last, windowOf(last));
      i = edge < 0 ? 0 : leafRank(this.p, leaf, last, true);
    }
  }

  /** The smallest key, or `undefined` if empty. */
  first(): K | undefined {
    if (this.p.size == 0) {
      return undefined;
    }
    return this.p.keyAt(slotAtRank(this.p, this.firstLeaf(), 0));
  }

  /** The largest key, or `undefined` if empty. */
  last(): K | undefined {
    if (this.p.size == 0) {
      return undefined;
    }
    const leaf = this.p.edgeLeaf(true);
    return this.p.keyAt(slotAtRank(this.p, leaf, this.p.leafCount(leaf) - 1));
  }

  /** The largest key <= `key`, or `undefined`. */
  floorKey(key: K): K | undefined {
    if (this.p.size == 0) {
      return undefined;
    }
    const win = windowOf(key);
    const at = edgeOrder(this.p, key, win);
    if (at != 0) {
      return at < 0 ? undefined : this.last();
    }
    let leaf = this.p.leafOf(key, win);
    const i = leafRank(this.p, leaf, key, true);
    if (i > 0) {
      return this.p.keyAt(slotAtRank(this.p, leaf, i - 1));
    }
    leaf = this.p.leafPrev[leaf as usize];
    if (leaf == NONE) {
      return undefined;
    }
    return this.p.keyAt(slotAtRank(this.p, leaf, this.p.leafCount(leaf) - 1));
  }

  /** The smallest key >= `key`, or `undefined`. */
  ceilingKey(key: K): K | undefined {
    if (this.p.size == 0) {
      return undefined;
    }
    const win = windowOf(key);
    const at = edgeOrder(this.p, key, win);
    if (at != 0) {
      return at < 0 ? this.first() : undefined;
    }
    let leaf = this.p.leafOf(key, win);
    const n = this.p.leafCount(leaf);
    const i = leafRank(this.p, leaf, key, false);
    if (i < n) {
      return this.p.keyAt(slotAtRank(this.p, leaf, i));
    }
    leaf = this.p.leafNext[leaf as usize];
    if (leaf == NONE) {
      return undefined;
    }
    return this.p.keyAt(slotAtRank(this.p, leaf, 0));
  }

  /** The entries with `from <= key < to`, in key order. */
  range(from: K, to: K): [K, V][] {
    const out: [K, V][] = [];
    if (this.p.size == 0 || !(from < to)) {
      return out;
    }
    const win = windowOf(from);
    const at = edgeOrder(this.p, from, win);
    if (at > 0) {
      return out;
    }
    let leaf = at < 0 ? this.p.edgeLeaf(false) : this.p.leafOf(from, win);
    let i = at < 0 ? 0 : leafRank(this.p, leaf, from, false);
    while (leaf != NONE) {
      const n = this.p.leafCount(leaf);
      const end = this.endIn(leaf, n, to);
      this.pushEntries(out, leaf, i, end);
      if (end < n) {
        break;
      }
      leaf = this.p.leafNext[leaf as usize];
      i = 0;
    }
    return out;
  }

  // ─────────────── internals ───────────────

  // How many of `leaf`'s `n` keys are below `to`, which may lie past the leaf's range: a search
  // compares the words of keys only with a target inside the range (pool.vlt), so a target past
  // the last key or before the first one is settled by comparing with that key.
  private endIn(leaf: u32, n: usize, to: K): usize {
    if (n == 0 || this.p.keyAt(slotAtRank(this.p, leaf, n - 1)) < to) {
      return n;
    }
    if (!(this.p.keyAt(slotAtRank(this.p, leaf, 0)) < to)) {
      return 0;
    }
    return leafRank(this.p, leaf, to, false);
  }

  // `leaf`'s rank order as bytes (rank → physical slot), in the pool's scratch: valid until
  // the next change to the map.
  private ranks(leaf: u32): u8[] {
    const order = this.p.orderOf(leaf);
    order[0].store(this.p.orderScratch, 0);
    order[1].store(this.p.orderScratch, 16);
    return this.p.orderScratch;
  }

  private firstLeaf(): u32 {
    return this.p.size == 0 ? NONE : this.p.edgeLeaf(false);
  }

  private pushEntries(out: [K, V][], leaf: u32, from: usize, to: usize) {
    const base = (leaf as usize) * F;
    const ranks = this.ranks(leaf);
    for (let i = from; i < to; i++) {
      const at = base + (ranks[i] as usize);
      const pair: [K, V] = [this.p.keyAt(at), this.p.valAt(at)];
      out.push(pair);
    }
  }
}
