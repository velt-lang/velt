// std/collections/deque: `Deque<T>`, a double-ended queue on a growable ring buffer: O(1)
// amortized push and pop at both ends, O(1) indexing.
//
// Slots are `(T | null)[]` (empty slots are null) with a power-of-two capacity plus one spare
// slot at the end that is always null. An element can't be moved out of an array index, so
// taking one swaps it into the spare slot and `pop()`s it, then pushes a fresh null back (no
// reallocation: the array's buffer keeps its capacity). Growing appends nulls and swaps the
// wrapped-around prefix up behind the old end, so elements are never cloned or copied.
// Consequently `T` itself should not be a nullable type (`Deque<i64 | null>`): a stored null
// would read as an empty slot.

// First ring capacity once a deque receives its first element.
const INITIAL_CAPACITY: usize = 8;

/** A double-ended queue (ring buffer). */
export class Deque<T> {
  // `capacity` ring slots, then the spare null slot.
  private slots: (T | null)[] = [];
  // Ring index of the front element.
  private head: usize = 0;
  private count: usize = 0;

  /** A deque holding clones of `xs` in order (front = `xs[0]`). */
  static from(xs: T[]): Deque<T> {
    const d = new Deque<T>();
    for (let i: usize = 0; i < xs.length; i++) {
      d.pushBack(xs[i].clone());
    }
    return d;
  }

  /** Number of elements. */
  get length(): usize {
    return this.count;
  }

  /** Number of elements (same as `length`). */
  get size(): usize {
    return this.count;
  }

  /** Whether the deque has no elements. */
  isEmpty(): bool {
    return this.count == 0;
  }

  /** Appends `value` at the back. */
  pushBack(value: T) {
    this.reserveOne();
    this.slots[(this.head + this.count) & (this.capacity() - 1)] = value;
    this.count++;
  }

  /** Inserts `value` at the front. */
  pushFront(value: T) {
    this.reserveOne();
    this.head = (this.head + this.capacity() - 1) & (this.capacity() - 1);
    this.slots[this.head] = value;
    this.count++;
  }

  /** Removes and returns the back element, or null if empty. */
  popBack(): T | null {
    if (this.count == 0) {
      return null;
    }
    this.count--;
    return this.take((this.head + this.count) & (this.capacity() - 1));
  }

  /** Removes and returns the front element, or null if empty. */
  popFront(): T | null {
    if (this.count == 0) {
      return null;
    }
    const value = this.take(this.head);
    this.head = (this.head + 1) & (this.capacity() - 1);
    this.count--;
    return value;
  }

  /** A clone of the front element, or null if empty. */
  peekFront(): T | null {
    if (this.count == 0) {
      return null;
    }
    return this.slots[this.head].clone();
  }

  /** A clone of the back element, or null if empty. */
  peekBack(): T | null {
    if (this.count == 0) {
      return null;
    }
    return this.slots[(this.head + this.count - 1) & (this.capacity() - 1)].clone();
  }

  /**
   * A clone of the element `i` places from the front (negative `i` counts from the back, like
   * `Array.prototype.at`), or null if out of range.
   */
  at(i: i64): T | null {
    const n = this.count as i64;
    const k = i < 0 ? i + n : i;
    if (k < 0 || k >= n) {
      return null;
    }
    return this.slots[(this.head + (k as usize)) & (this.capacity() - 1)].clone();
  }

  /** Removes every element (keeps the buffer). */
  clear() {
    for (let i: usize = 0; i < this.slots.length; i++) {
      this.slots[i] = null;
    }
    this.head = 0;
    this.count = 0;
  }

  /** Clones of the elements, front to back. */
  toArray(): T[] {
    const out: T[] = __intrinsic_array_with_capacity(this.count);
    for (let i: usize = 0; i < this.count; i++) {
      pushClone(out, this.slots[(this.head + i) & (this.capacity() - 1)]);
    }
    return out;
  }

  /** Visits the elements front to back, borrowing them. */
  forEach<E>(f: (value: T) => void throws E) throws E {
    for (let i: usize = 0; i < this.count; i++) {
      visit(this.slots[(this.head + i) & (this.capacity() - 1)], f);
    }
  }

  // ─────────────── internals ───────────────

  private capacity(): usize {
    return this.slots.length == 0 ? 0 : this.slots.length - 1;
  }

  // Moves the element out of ring slot `s`, leaving null behind (see the module comment).
  private take(s: usize): T | null {
    const spare = this.slots.length - 1;
    __intrinsic_array_swap(this.slots, s, spare);
    const value = this.slots.pop();
    this.slots.push(null);
    // `pop()` on `(T | null)[]` is a nested option for a generic `T`; flatten it.
    return value ?? null;
  }

  // Makes room for one more element, doubling the ring when it is full.
  private reserveOne() {
    const cap = this.capacity();
    if (this.count < cap) {
      return;
    }
    if (cap == 0) {
      for (let i: usize = 0; i <= INITIAL_CAPACITY; i++) {
        this.slots.push(null);
      }
      return;
    }
    // Full ring: [head, cap) then [0, head). Double it and move [0, head) to [cap, cap + head),
    // which puts the elements in one run from `head`. Slot `cap` (the old spare) is null.
    for (let i: usize = 0; i < cap; i++) {
      this.slots.push(null);
    }
    for (let i: usize = 0; i < this.head; i++) {
      __intrinsic_array_swap(this.slots, i, cap + i);
    }
  }
}

function pushClone<T>(out: T[], slot: T | null) {
  if (slot != null) {
    out.push(slot.clone());
  }
}

function visit<T, E>(slot: T | null, f: (value: T) => void throws E) throws E {
  if (slot != null) {
    f(slot);
  }
}
