// velt/collections (internal): `Set<T>`, an insertion-ordered hash set with JS `Set` semantics,
// plus the ES2025 set algebra (`union`, `intersection`, `difference`, `symmetricDifference`,
// `isSubsetOf`, `isSupersetOf`, `isDisjointFrom`).
//
// Built on the prelude `Map<T, bool>` (Robin Hood index over dense insertion-ordered entries),
// so elements compare as map keys do: numbers, bool and strings by value, objects (class
// instances, object types, arrays, interface and function values) by identity, as in JS, and
// tuples part by part. `add` takes ownership of the element; `values()` and the algebra results
// hold the stored elements (objects shared, as in JS); `forEach` borrows.

/** An insertion-ordered set of unique values. */
export class Set<T> implements Iterable<T> {
  private items: Map<T, bool> = new Map<T, bool>();

  /**
   * A set holding each distinct element of `values` (like JS `new Set(values)`), in
   * first-occurrence order. Leaves `values` as it is; the set shares the elements, like JS.
   */
  constructor(values: T[] = []) {
    for (const v of values) {
      this.items.set(v, true);
    }
  }

  /** A set holding each distinct element of `xs` (shared), in first-occurrence order. */
  static from(xs: T[]): Set<T> {
    return new Set<T>(xs);
  }

  /** Number of elements. */
  get size(): usize {
    return this.items.size;
  }

  /** Inserts `value`; a value already present keeps its position (the new copy is dropped). */
  add(value: T) {
    this.items.set(value, true);
  }

  /** Whether `value` is in the set. */
  has(value: T): bool {
    return this.items.has(value);
  }

  /** Removes `value`; returns whether it was present. */
  delete(value: T): bool {
    return this.items.delete(value);
  }

  /** Removes every element. */
  clear() {
    this.items.clear();
  }

  /** Whether the set has no elements. */
  isEmpty(): bool {
    return this.items.size == 0;
  }

  /** The elements in insertion order, objects shared as in JS (`for (const x of s.values())`). */
  values(): T[] {
    return this.items.keys();
  }

  /** An iterator over the elements when it is made (`values()`), in insertion order. */
  [Symbol.iterator](): Iterator<T> {
    return new ArrayIterator<T>(this.values());
  }

  /** Visits the elements in insertion order, borrowing them. */
  forEach<E>(f: (value: T) => void throws E) throws E {
    this.items.forEach((_present, key) => {
      f(key);
    });
  }

  /** Elements of this set, then those of `other` not in it. */
  union(other: Set<T>): Set<T> {
    const out = new Set<T>(this.values());
    other.forEach((x) => {
      if (!out.has(x)) {
        out.add(__intrinsic_share(x));
      }
    });
    return out;
  }

  /** Elements of this set that are also in `other` (in this set's order). */
  intersection(other: Set<T>): Set<T> {
    const out = new Set<T>();
    this.forEach((x) => {
      if (other.has(x)) {
        out.add(__intrinsic_share(x));
      }
    });
    return out;
  }

  /** Elements of this set that are not in `other`. */
  difference(other: Set<T>): Set<T> {
    const out = new Set<T>();
    this.forEach((x) => {
      if (!other.has(x)) {
        out.add(__intrinsic_share(x));
      }
    });
    return out;
  }

  /** Elements in exactly one of the two sets (this set's first, then `other`'s). */
  symmetricDifference(other: Set<T>): Set<T> {
    const out = this.difference(other);
    other.forEach((x) => {
      if (!this.has(x)) {
        out.add(__intrinsic_share(x));
      }
    });
    return out;
  }

  /** Whether every element of this set is in `other`. */
  isSubsetOf(other: Set<T>): bool {
    if (this.size > other.size) {
      return false;
    }
    let all = true;
    this.forEach((x) => {
      all = all && other.has(x);
    });
    return all;
  }

  /** Whether every element of `other` is in this set. */
  isSupersetOf(other: Set<T>): bool {
    return other.isSubsetOf(this);
  }

  /** Whether the sets share no element. */
  isDisjointFrom(other: Set<T>): bool {
    let none = true;
    this.forEach((x) => {
      none = none && !other.has(x);
    });
    return none;
  }
}

/**
 * `s.forEach(f)` through `any`: `f(value, value, whole)` per element, in insertion order;
 * `whole` is `s` as an `any` of its own class (a class extending `Set`, with its own members).
 */
export function __anySet_forEach<T>(s: Set<T>, args: any[], whole: any): any {
  const f = __anyFnArg(args, 0);
  s.forEach((x) => {
    const value: any = x;
    f(value, value, whole);
  });
  return undefined;
}

// The copy an interface adapter passes for a `Set<unknown>` parameter (std/prelude/adapt.vlt).

/** A set of any type held by `v`, as a `Set<unknown>` of its elements. */
export function __unknownSetIn(v: unknown): Set<unknown> {
  if (!(v instanceof Set)) {
    __adaptMismatch(v, "a Set<unknown>");
  }
  const a = v as any;
  const vs = a.values();
  const n = vs.length as number;
  const out = new Set<unknown>();
  for (let i = 0; i < n; i++) {
    out.add(vs[i]);
  }
  return out;
}

/** Writes the elements of `s` back into the set `v` holds (`__unknownSetIn`). */
export function __unknownSetOut(v: unknown, s: Set<unknown>): void {
  const a = v as any;
  a.clear();
  for (const x of s) {
    a.add(x);
  }
}

/**
 * TypeScript's `ReadonlySet<T>`: a `Set<T>` that a variable or parameter declared with this
 * type may not change (`add`, `delete` and `clear` are errors through it).
 */
export type ReadonlySet<T> = Set<T>;
