// Prelude: classes as plain values (velt_sema `body/expr/ctor_objects.rs`, #926): the objects
// of classes and of kinds of values, and `x.constructor` of an `any`.

/**
 * The element type of the rest parameter of a class object's function type (velt_sema
 * `ctor_objects.rs`), which tells velt_vir how to print it (`format.rs`): `string` for the
 * objects `__classObject` makes, `boolean` for `__classObjectStatics`'s, `number` for the
 * `Number` kind's. Never made.
 */
export class __ClassMarker<T> {
  private kept: T | undefined = undefined;
}

/**
 * A call of a class's object without `new` (`x.constructor`, or a class read as a plain value):
 * Node's `TypeError`, `msg`.
 */
export function __classCall(msg: string): never {
  panic(msg);
}

/**
 * The object of a class (or a kind of values) that prints as `printed`, stopping with `msg`
 * when called. One closure for every class, so one type and one descriptor: velt_vir's
 * `format.rs` reads `printed`, its first capture.
 */
export function __classObject(
  printed: string,
  msg: string,
): (...m: __ClassMarker<string>[]) => any {
  return (...m: __ClassMarker<string>[]): any => __classCall(printed.length < 0 ? printed : msg);
}

/**
 * `__classObject` for a class with static fields or accessors, which Node prints after its name:
 * printing it stops with a `TypeError` saying it is not supported yet (`format.rs`).
 */
export function __classObjectStatics(
  printed: string,
  msg: string,
): (...m: __ClassMarker<boolean>[]) => any {
  return (...m: __ClassMarker<boolean>[]): any => __classCall(printed.length < 0 ? printed : msg);
}

/**
 * `v.constructor` of an `any` (or `object`) `v` that holds no class instance: its kind's object
 * (`o` for an object, `a` an array, `n` a number, `s` a string, `b` a boolean, `f` a function).
 */
export function __anyCtor(v: any, o: any, a: any, n: any, s: any, b: any, f: any): any {
  if (v === undefined || v === null) {
    panic(
      `TypeError: Cannot read properties of ${v === null ? "null" : "undefined"} (reading 'constructor')`,
    );
  }
  if (Array.isArray(v)) {
    return a;
  }
  const t = typeof v;
  if (t === "number") {
    return n;
  }
  if (t === "string") {
    return s;
  }
  if (t === "boolean") {
    return b;
  }
  if (t === "function") {
    return f;
  }
  if (t === "object") {
    // An own `constructor` property comes first, as in JavaScript.
    return __anyHasOwn(v, "constructor") ? v["constructor"] : o;
  }
  panic(`TypeError: \`constructor\` of a ${t} through \`any\` is not supported yet (#926)`);
}

/**
 * `r.constructor` of an `any` holding a record: its own `constructor` key's value, else `o`
 * (`Object`'s object), and `undefined` for one `Object.create(null)` made.
 */
export function __anyRecordCtor(r: any, o: any): any {
  if (Object.hasOwn(r, "constructor")) {
    // An own `constructor` key comes first, as in JavaScript.
    return r["constructor"];
  }
  if (__anyNullProto(r)) {
    return undefined;
  }
  return o;
}

/**
 * `v.constructor` of an `any` `v` without an own `constructor` property: sema writes the
 * dispatch over the program's classes (velt_sema `ctor_objects.rs`) into this body, once.
 */
export function __anyConstructor(v: any): any {
  return v.constructor;
}

/** Is the record `r` (held by an `any`) one `Object.create(null)` made, with no prototype? */
export function __anyNullProto(r: any): boolean {
  return !("__proto__" in r);
}

/** `v.constructor` of an instance of class `name` declared in a function. */
export function __anyCtorLocal(name: string): any {
  panic(
    `TypeError: \`constructor\` of an instance of \`${name}\`, a class declared in a function, is not supported yet (#926)`,
  );
}

/** `v.constructor` of an instance of standard library class `name`, which JavaScript doesn't name. */
export function __anyCtorUnsupported(name: string): any {
  panic(`TypeError: \`constructor\` of a ${name} through \`any\` is not supported yet (#926)`);
}
