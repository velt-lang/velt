// Prelude: `Record<K, V>` (docs/internals/design/record.md), a dictionary keyed by strings, a
// union of string literal types or a string enum (the TypeScript `Object` helpers over it are in
// object.velt).
//
// A record has no members of its own: `r.name` reads the key "name". Sema turns `r[k]`, `r.name`,
// `r[k] = v`, `delete r[k]` and object literals typed as a record into calls of the keyed
// methods below (`[RECORD_GET]` for string keys, `[RECORD_AT]` for literal keys, which are always present).
// Entries keep JavaScript's order: keys that are array indices (canonical `"0"` to
// `"4294967294"`) first, ascending, then the others in insertion order. A key that is an array
// index marks the record `unordered`; then the readers (`[RECORD_KEY_NAMES]`, `[RECORD_VALUES]`, `[RECORD_ENTRIES]`,
// and the JSON and formatting glue through `[RECORD_POSITIONS]`) sort the entries they read, without
// changing the record (they borrow it). A record without such keys pays one byte test per new
// key (`Map[MAP_NEWEST_KEY_DIGIT]`, then `arrayIndex` for a key that starts with a digit). JSON reads
// and writes a record as an object (a decoded record is checked for such keys once,
// `[RECORD_DECODED]`), and `console.log` shows it like one.

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

import {
  MAP_AT,
  MAP_IS_NULL_PROTO,
  MAP_LIVE_POSITIONS,
  MAP_MARK_NULL_PROTO,
  MAP_NEWEST_KEY_DIGIT,
} from "velt/lang/hooks/keys";
import { arrayIndex, objectPrototypeKey } from "velt/lang/hooks/record";
import { mapKeyNames } from "velt/lang/map/live";
import { mapCopyFrom } from "velt/lang/map/table";
import {
  RECORD_AT,
  RECORD_DECODED,
  RECORD_DEFINE_ACCESSOR,
  RECORD_DELETE,
  RECORD_ENTRIES,
  RECORD_ENTRIES_OF,
  RECORD_EXTEND,
  RECORD_EXTEND_FROM,
  RECORD_EXTEND_MAYBE,
  RECORD_FROM_MAP,
  RECORD_GET,
  RECORD_HAS,
  RECORD_IN_ANY,
  RECORD_IS_NULL_PROTO,
  RECORD_KEY_NAMES,
  RECORD_MARK_NULL_PROTO,
  RECORD_PERM,
  RECORD_POSITIONS,
  RECORD_PUT_SYM,
  RECORD_SET,
  RECORD_SIZE,
  RECORD_VALUES,
} from "velt/lang/hooks/keys";

// The rank of a key that is not an array index: after every index.
const NOT_INDEX: i64 = 4294967296;

/**
 * A dictionary from keys of type `K` to values of type `V`, like TypeScript's `Record<K, V>`:
 * `K` is `string`, a union of string literal types or a string enum. `r.name` and `r[k]` read
 * a key, `r[k] = v` sets it, `delete r[k]` removes it; entries keep JavaScript's order
 * (array-index keys first, ascending, then insertion order).
 */
export class Record<K, V> {
  // Field 0: the JSON and formatting glue read it directly, in the order `[RECORD_POSITIONS]` gives.
  private entries: Map<K, V> = new Map();
  // Field 1: a key that is an array index was added (or decoded), so the entries may not be in
  // JavaScript's order (`[RECORD_PERM]`).
  private unordered: bool = false;
  // Field 2: the symbol-keyed entries, a table of their own as in Node, made when the first
  // symbol key is written (`null` until then: the string-key methods never read it).
  private symbols: Map<symbol, V> | null = null;
  // Field 3: the accessors `Object.defineProperty` defined (`[RECORD_DEFINE_ACCESSOR]`), by key. They
  // are not enumerable, so `Object.keys`, `JSON.stringify`, spreads and `console.log` skip
  // them, as in Node. Only a program that defines accessors reads this field: sema calls the
  // `Keyed` methods there for every key (`hir::Program::record_accessors`).
  private accessors: Map<K | symbol, [(() => V) | null, ((value: V) => void) | null, bool]> | null =
    null;
  // The methods that read fields 2 and 3 are in std/lang/record/symbols.velt, which a
  // program loads only when it mentions symbols or property definitions.

  /** `r`'s string-keyed entries (the hook `recordEntriesOf`; static: in no `any` table). */
  static [RECORD_ENTRIES_OF]<RK, RV>(r: Record<RK, RV>): Map<RK, RV> {
    return r.entries;
  }

  /** `r[k]` / `r.name` of an open record: the value, or `undefined` (the compiler calls it). */
  [RECORD_GET](key: K): V | undefined {
    return this.entries.get(key);
  }

  /** The symbol key `key` set to `value` (a spread's copy; the table made by the first). */
  private [RECORD_PUT_SYM](key: symbol, value: V) {
    const t = this.symbols;
    if (t == null) {
      const made: Map<symbol, V> = new Map();
      made.set(key, value);
      this.symbols = made;
    } else {
      t.set(key, value);
    }
  }

  /** A literal-key record holds every key (sema checks literals; JSON checks documents). */
  [RECORD_AT](key: K): V {
    return this.entries[MAP_AT](key);
  }

  /** `r[k] = v` / `r.name = v` (the compiler calls it). */
  [RECORD_SET](key: K, value: V) {
    const n = this.entries.size;
    this.entries.set(key, value);
    if (this.entries.size != n && !this.unordered) {
      this.unordered = this.entries[MAP_NEWEST_KEY_DIGIT]() && arrayIndex(`${key}`) >= 0;
    }
  }

  /**
   * A record of the entries of `m`, in its order (a JSON object's members in document order:
   * the decoders velt/encoding/json generates make records with it), `unordered` when a key is
   * an array index (the hook `recordFromMap`, std/lang/hooks/record.velt).
   */
  static [RECORD_FROM_MAP]<RK, RV>(m: Map<RK, RV>): Record<RK, RV> {
    const r = new Record<RK, RV>();
    r.entries = m;
    r[RECORD_DECODED]();
    return r;
  }

  /** After JSON decoding (in document order): `unordered` when a key is an array index. */
  [RECORD_DECODED]() {
    for (const k of this.entries.keys()) {
      if (arrayIndex(`${k}`) >= 0) {
        this.unordered = true;
        return;
      }
    }
  }

  /**
   * The order of the live entries (indexes into `keys()` / `values()`) in JavaScript's order:
   * array indices first, ascending, then the other keys in insertion order (a stable sort).
   * Empty when the entries are in that order already.
   */
  [RECORD_PERM](): usize[] {
    if (!this.unordered) {
      return [];
    }
    const keys = this.entries.keys();
    const rank: i64[] = [];
    let sorted = true;
    let last: i64 = -1;
    let other = false;
    for (const k of keys) {
      const i = arrayIndex(`${k}`);
      if (i < 0) {
        other = true;
        rank.push(NOT_INDEX);
      } else {
        sorted = sorted && !other && i > last;
        last = i;
        rank.push(i);
      }
    }
    if (sorted) {
      return [];
    }
    const at: usize[] = [];
    for (let i: usize = 0; i < keys.length; i++) {
      at.push(i);
    }
    at.sort((a, b) => rank[a] - rank[b]);
    return at;
  }

  /**
   * The positions of the map's live entries in JavaScript's order (the JSON and formatting
   * glue walk them), or empty when that is insertion order.
   */
  [RECORD_POSITIONS](): usize[] {
    if (!this.unordered) {
      return [];
    }
    const at = this[RECORD_PERM]();
    if (at.length == 0) {
      return at;
    }
    const live = this.entries[MAP_LIVE_POSITIONS]();
    const out: usize[] = [];
    for (const i of at) {
      out.push(live[i]);
    }
    return out;
  }

  /** `delete r[k]`: `true`, as JavaScript's `delete` of an entry or of a missing key is. */
  [RECORD_DELETE](key: K): bool {
    this.entries.delete(key);
    return true;
  }

  /** Whether the record has the key `key` (the compiler calls it for `k in r`). */
  [RECORD_HAS](key: K): bool {
    return this.entries.has(key);
  }

  /**
   * `key in r` through `any`: the entry `key`, or a member every object inherits from
   * `Object.prototype` (none for a record made by `Object.create(null)`).
   */
  [RECORD_IN_ANY](key: K): bool {
    return this[RECORD_HAS](key) ||
      (!this[RECORD_IS_NULL_PROTO]() && objectPrototypeKey(String(key)));
  }

  /** `{ ...other }`: every entry of `other`, later entries replacing earlier ones. */
  [RECORD_EXTEND](other: Record<K, V>) {
    if (mapCopyFrom(this.entries, other.entries)) {
      // Into a record that never held a key: the same entries in the same order, so the same
      // keys are array indices.
      this.unordered = this.unordered || other.unordered;
    } else {
      for (const [k, v] of other[RECORD_ENTRIES]()) {
        this[RECORD_SET](k, v);
      }
    }
    // A spread copies the symbol keys too, as in Node.
    const t = other.symbols;
    if (t != null) {
      for (const [s, v] of t.entries()) {
        this[RECORD_PUT_SYM](s, v);
      }
    }
  }

  /** `{ ...other }` of a record that may be `null` or `undefined`: nothing when it is. */
  [RECORD_EXTEND_MAYBE](other: Record<K, V> | null | undefined) {
    if (other != null) {
      this[RECORD_EXTEND](other);
    }
  }

  /** `{ ...other }` of a record of another key or value type (`Record<string, string>` or
   *  `Record<"a" | "b", string>` into a `Record<string, any>`): each key converted by `key`,
   *  each value by `convert`; nothing when it is nothing. */
  [RECORD_EXTEND_FROM]<J, W>(
    other: Record<J, W> | null | undefined,
    key: (key: J) => K,
    convert: (value: W) => V,
  ) {
    if (other != null) {
      for (const [k, v] of other[RECORD_ENTRIES]()) {
        this[RECORD_SET](key(k), convert(v));
      }
      const t = other.symbols;
      if (t != null) {
        for (const [s, v] of t.entries()) {
          this[RECORD_PUT_SYM](s, convert(v));
        }
      }
    }
  }

  /** The number of keys. */
  [RECORD_SIZE](): usize {
    return this.entries.size;
  }

  /** `Object.create(null)`: this record has no prototype (marked in its map). */
  [RECORD_MARK_NULL_PROTO]() {
    this.entries[MAP_MARK_NULL_PROTO]();
  }

  /** Was this record made by `Object.create(null)`? */
  [RECORD_IS_NULL_PROTO](): bool {
    return this.entries[MAP_IS_NULL_PROTO]();
  }

  /**
   * `Object.keys(r)`: TypeScript lists an object's keys as strings, so a string enum key is
   * listed as its value.
   */
  [RECORD_KEY_NAMES](): string[] {
    if (!this.unordered) {
      return mapKeyNames(this.entries);
    }
    const at = this[RECORD_PERM]();
    if (at.length == 0) {
      return mapKeyNames(this.entries);
    }
    const keys = this.entries.keys();
    const out: string[] = [];
    for (const i of at) {
      out.push(`${keys[i]}`);
    }
    return out;
  }

  /** `Object.values(r)` (the compiler calls it). */
  [RECORD_VALUES](): V[] {
    const values = this.entries.values();
    if (!this.unordered) {
      return values;
    }
    const at = this[RECORD_PERM]();
    if (at.length == 0) {
      return values;
    }
    const out: V[] = [];
    for (const i of at) {
      out.push(values[i]);
    }
    return out;
  }

  /** `Object.entries(r)` (the compiler calls it). */
  [RECORD_ENTRIES](): [K, V][] {
    const entries = this.entries.entries();
    if (!this.unordered) {
      return entries;
    }
    const at = this[RECORD_PERM]();
    if (at.length == 0) {
      return entries;
    }
    const out: [K, V][] = [];
    for (const i of at) {
      out.push(entries[i]);
    }
    return out;
  }
}
