// Prelude: the operations on `any` that a proxy answers with its traps when the key is a
// symbol constant (`p[KEY]`, `KEY in p`, `delete p[KEY]`, `Object.hasOwn(p, KEY)`), and
// `new Proxy(target, handler)` with a handler typed `any` (issue #823; docs/reference/types.md
// "Proxy and Reflect").
//
// A symbol constant names a member of a typed value by its key name (U+FFFF and `Symbol(d)`,
// velt_sema's `symbols.rs`); sema passes both that name and the symbol itself, so a plain value
// is read by the name, as before, and a proxy's trap sees the symbol, as in JavaScript.

/** `o[KEY]` of an `any` `o` with a symbol constant `KEY` naming the member `name`. */
export function __anyGetSym(o: any, name: string, key: symbol): any {
  const recv: any = o;
  if (o instanceof Proxy) {
    return o.__get(key, recv);
  }
  return o[name];
}

/** `o[KEY] = v` of an `any` `o` with a symbol constant `KEY` naming the member `name`. */
export function __anySetSym(o: any, name: string, key: symbol, v: any): void {
  const recv: any = o;
  if (o instanceof Proxy) {
    if (!o.__set(key, v, recv)) {
      panic(`TypeError: 'set' on proxy: trap returned falsish for property '${String(key)}'`);
    }
    return;
  }
  o[name] = v;
}

/** `KEY in o` of an `any` `o` with a symbol constant `KEY` naming the member `name`. */
export function __anyHasSym(o: any, name: string, key: symbol): boolean {
  if (o instanceof Proxy) {
    return o.__has(key);
  }
  return name in o;
}

/** `delete o[KEY]` of an `any` `o` with a symbol constant `KEY` (strict code). */
export function __anyDeleteSym(o: any, name: string, key: symbol): boolean {
  if (o instanceof Proxy) {
    return o.__delete(key);
  }
  return __anyDelete(o, name);
}

/** `Object.hasOwn(o, KEY)` of an `any` `o` with a symbol constant `KEY`. */
export function __anyHasOwnSym(o: any, name: string, key: symbol): boolean {
  if (o instanceof Proxy) {
    return o.__hasOwn(key);
  }
  return __anyHasOwn(o, key);
}

/**
 * `new Proxy(target, handler)` with a handler typed `any`: a proxy whose traps call the
 * handler's own (`handler.get(target, key, receiver)`, ...), each one the handler has when the
 * proxy is made.
 */
export function __proxyNewAny(target: any, handler: any): any {
  if (
    target === null ||
    (typeof target !== "object" && typeof target !== "function") ||
    handler === null ||
    (typeof handler !== "object" && typeof handler !== "function")
  ) {
    panic("TypeError: Cannot create proxy with a non-object as target or handler");
  }
  const h: ProxyHandler<any> = {
    get: "get" in handler
      ? (t: any, k: string | symbol, r: any): any => handler.get(t, k, r)
      : undefined,
    set: "set" in handler
      ? (t: any, k: string | symbol, v: any, r: any): boolean =>
          handler.set(t, k, v, r) ? true : false
      : undefined,
    has: "has" in handler
      ? (t: any, k: string | symbol): boolean => (handler.has(t, k) ? true : false)
      : undefined,
    deleteProperty: "deleteProperty" in handler
      ? (t: any, k: string | symbol): boolean => (handler.deleteProperty(t, k) ? true : false)
      : undefined,
    ownKeys: "ownKeys" in handler ? (t: any): any => handler.ownKeys(t) : undefined,
    getOwnPropertyDescriptor: "getOwnPropertyDescriptor" in handler
      ? (t: any, k: string | symbol): PropertyDescriptor | undefined =>
          handler.getOwnPropertyDescriptor(t, k)
      : undefined,
    defineProperty: "defineProperty" in handler
      ? (t: any, k: string | symbol, d: PropertyDescriptor): boolean =>
          handler.defineProperty(t, k, d) ? true : false
      : undefined,
  };
  return new Proxy(target, h);
}

/**
 * `Object.prototype.hasOwnProperty` read as a value (`const hasOwn =
 * Object.prototype.hasOwnProperty`): `hasOwn.call(o, k)` is `Object.hasOwn(o, k)`.
 */
export class __HasOwnProperty {
  /** Whether `o` has the own property `key`. */
  call(o: any, key: string | symbol): boolean {
    return __anyHasOwn(o, key);
  }
}

/**
 * `Object.keys(x)` of a class instance or an object `x` in a program that makes proxies: the
 * keys a typed proxy's traps list (`ownKeys`, `getOwnPropertyDescriptor`), or `null` for a
 * plain value (its type's keys).
 */
export function __proxyKeys(o: any): string[] | null {
  if (o instanceof Proxy) {
    return o.__keys();
  }
  return null;
}

/**
 * `{ ...x }` of a class instance or an object `x` in a program that makes proxies: a typed
 * proxy's keys are what its traps list, which a value of a fixed shape cannot follow yet.
 */
export function __proxySpreadCheck(o: any): void {
  if (o instanceof Proxy) {
    panic("TypeError: spreading a proxy typed as a class or object type is not supported yet (#823)");
  }
}
