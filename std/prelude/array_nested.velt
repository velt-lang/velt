// Prelude: `flat` on arrays of arrays, `flatMap`, `reduce` without an initial value, and `join`
// on arrays of arrays and of nullable elements,
// like JS: inner arrays are written as `${x}` writes them (their elements joined with ",", at
// any depth, `null` as ""), and `null` elements join as "". These targets are more specific
// than `extend<T> Array<T>` (array.velt), so their `join` wins.

import { arraySwapNested, arrayWithCapacity, share } from "velt/lang/intrinsics";
import { ARRAY_REDUCE_FIRST, ARRAY_REDUCE_RIGHT_FIRST } from "velt/lang/hooks/keys";

extend<T> Array<T[]> {
  /**
   * Exchanges `this[a][i]` and `this[b][j]` (every index must be in range), also between two
   * inner arrays, where `[x, y] = [y, x]` would count and drop the elements it copies: their
   * bits change places, nothing is copied or dropped. For data kept in chunks (`T[][]`).
   */
  swapIn(a: usize, i: usize, b: usize, j: usize) {
    arraySwapNested(this, a, i, b, j);
  }

  /** The inner arrays' elements, one level deep (JS `flat()`; deeper levels are not supported). */
  flat(): T[] {
    let total: usize = 0;
    for (let i: usize = 0; i < this.length; i++) {
      total += this[i].length;
    }
    const out: T[] = arrayWithCapacity(total);
    for (let i: usize = 0; i < this.length; i++) {
      const inner = this[i];
      for (let j: usize = 0; j < inner.length; j++) {
        out.push(share(inner[j]));
      }
    }
    return out;
  }

  /**
   * Each inner array joined with "," (as `${x}` writes it) and the results with `sep`, like JS
   * when the innermost elements are strings, numbers, booleans or `null`.
   */
  join(sep: string = ","): string {
    let s = "";
    for (let i: usize = 0; i < this.length; i++) {
      if (i > 0) {
        s += sep;
      }
      s += `${this[i]}`;
    }
    return s;
  }
}

extend<T> Array<T | null> {
  /** `null` elements join as empty text, like JS; the others as `join` writes them. */
  join(sep: string = ","): string {
    let s = "";
    for (let i: usize = 0; i < this.length; i++) {
      if (i > 0) {
        s += sep;
      }
      // A one-element tuple is written as its element is written in an array: `null` as "".
      const one: [T | null] = [share(this[i])];
      s += `${one}`;
    }
    return s;
  }
}

extend<T> Array<T> {
  /**
   * Calls `f` on each element (with its index) and returns what it returns, one level deep: the
   * elements of an array, and any other value itself (`map` followed by `flat()`). The elements
   * visited are those below the length when the call starts that are still there, as in JS.
   * @throws what `f` throws.
   */
  flatMap<U, E>(f: (x: T, i: i64) => U | U[] throws E): U[] throws E {
    const out: U[] = [];
    const n = this.length;
    for (let i: usize = 0; i < n && i < this.length; i++) {
      const part = f(this[i], i as i64);
      if (Array.isArray(part)) {
        const parts = part as U[];
        for (let j: usize = 0; j < parts.length; j++) {
          out.push(share(parts[j]));
        }
      } else {
        out.push(part as U);
      }
    }
    return out;
  }

  /**
   * `reduce(f)` without an initial value (the compiler calls this for a `reduce` with one
   * argument): the first element is the accumulator, and `f` is called with each element after
   * it that is below the length when the call starts, as in JS. Throws JS's `TypeError` on an
   * empty array.
   * @throws what `f` throws, and a `TypeError` for an empty array.
   */
  [ARRAY_REDUCE_FIRST]<E>(f: (acc: T, x: T, i: i64) => T throws E): T throws E | TypeError {
    if (this.length === 0) {
      throw new TypeError("Reduce of empty array with no initial value");
    }
    let acc = share(this[0]);
    const n = this.length;
    for (let i: usize = 1; i < n && i < this.length; i++) {
      acc = f(acc, this[i], i as i64);
    }
    return acc;
  }

  /**
   * Calls `f` for each element from the last to the first, with the accumulated value, the
   * element and its index. The elements visited are those below the length when the call starts
   * that are still there, as in JS.
   * @returns the accumulated value: `init` for an empty array.
   * @throws what `f` throws.
   */
  reduceRight<A, E>(f: (acc: A, x: T, i: i64) => A throws E, init: A): A throws E {
    let acc = init;
    for (let i: i64 = this.length as i64 - 1; i >= 0; i--) {
      if ((i as usize) < this.length) {
        acc = f(acc, this[i as usize], i);
      }
    }
    return acc;
  }

  /**
   * `reduceRight(f)` without an initial value (the compiler calls this for a `reduceRight` with
   * one argument): the last element is the accumulator. Throws JS's `TypeError` on an empty array.
   * @throws what `f` throws, and a `TypeError` for an empty array.
   */
  [ARRAY_REDUCE_RIGHT_FIRST]<E>(f: (acc: T, x: T, i: i64) => T throws E): T throws E | TypeError {
    if (this.length === 0) {
      throw new TypeError("Reduce of empty array with no initial value");
    }
    let acc = share(this[this.length - 1]);
    for (let i: i64 = this.length as i64 - 2; i >= 0; i--) {
      if ((i as usize) < this.length) {
        acc = f(acc, this[i as usize], i);
      }
    }
    return acc;
  }
}
