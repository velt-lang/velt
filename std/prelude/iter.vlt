// Prelude: the iteration protocol (docs/reference/control-flow.md "for...of").
//
// `for (const x of src)` works on arrays, on `Map`s and other classes with `entries()`, and on
// any `Iterable<T, E>`: it calls `src[Symbol.iterator]()` once, then `next()` until a result
// is `done`, and calls the iterator's `return()` when the loop is left early (`break`,
// `return`, a thrown error). `E` is what `next()` throws (`never`: nothing); the loop throws
// it too. Velt has no `undefined`, so a finished result has no `value` (reading `r.value`
// without narrowing gives `T | null`).

export type IteratorResult<T> = { value: T; done: false } | { done: true };

export interface Iterator<T, E = never> {
  next(): IteratorResult<T> throws E;

  // Early exit: release what the iterator holds. Not called after `next()` reported `done`.
  // Returns a finished result, as in TS (`for...of` ignores it).
  return(): IteratorResult<T> {
    return { done: true };
  }
}

export interface Iterable<T, E = never> {
  [Symbol.iterator](): Iterator<T, E>;
}

export interface AsyncIterator<T, E = never> {
  next(): Promise<IteratorResult<T>, E>;

  async return(): Promise<IteratorResult<T>> {
    return { done: true };
  }
}

export interface AsyncIterable<T, E = never> {
  [Symbol.asyncIterator](): AsyncIterator<T, E>;
}

// An iterator that is also iterable: its `[Symbol.iterator]()` returns the iterator itself, so
// a loop can consume it (TS's `IterableIterator<T>`; generators are ones). Velt has no covariant
// returns, so `[Symbol.iterator]()` returns `Iterator<T, E>`, not `IterableIterator<T, E>`.
export interface IterableIterator<T, E = never> extends Iterator<T, E>, Iterable<T, E> {}

// TS's `IteratorObject<T>`, the type of the builtin iterators: the same contract as
// `IterableIterator<T>` (TS adds the iterator helpers, `map`, `filter` and so on, which Velt
// does not have yet).
export interface IteratorObject<T, E = never> extends Iterator<T, E>, Iterable<T, E> {}

// An async iterator that is also async iterable (TS's `AsyncIterableIterator<T>`; async
// generators are ones).
export interface AsyncIterableIterator<T, E = never> extends AsyncIterator<T, E>, AsyncIterable<T, E> {}

// Interface values don't convert to the interfaces they extend yet; these blocks make the
// iterable-iterator values `Iterable<T, E>` / `AsyncIterable<T, E>` values (TS allows passing
// one where an iterable is expected).
extend<T, E> IterableIterator<T, E> {
  [Symbol.iterator](): Iterator<T, E> {
    return this[Symbol.iterator]();
  }
}

extend<T, E> IteratorObject<T, E> {
  [Symbol.iterator](): Iterator<T, E> {
    return this[Symbol.iterator]();
  }
}

extend<T, E> AsyncIterableIterator<T, E> {
  [Symbol.asyncIterator](): AsyncIterator<T, E> {
    return this[Symbol.asyncIterator]();
  }
}

// Arrays, strings, `Map`s (and `Set`s, std/collections) are iterable: `[Symbol.iterator]()`
// returns one of the iterators below, and they convert to `Iterable<T>` values (an `extend`
// block defining `[Symbol.iterator](): Iterator<T, E>` makes its type an `Iterable<T, E>`).
// `for...of` over them keeps its own loops and does not call these.

extend<T> Array<T> {
  // A live view, like JS's array iterator: it reads the length at each step, so it sees
  // elements pushed while it runs.
  [Symbol.iterator](): Iterator<T> {
    return new ArrayIterator<T>(this);
  }
}

extend<K, V> Map<K, V> {
  // An iterator over the entries, as `for...of` over the map visits them: the entries when it
  // is made (`entries()`), in insertion order. JS's map iterator is a live view instead.
  [Symbol.iterator](): Iterator<[K, V]> {
    return new ArrayIterator<[K, V]>(this.entries());
  }
}

extend string {
  // The characters (code points), each as a string, like JS.
  [Symbol.iterator](): Iterator<string> {
    return new StringIterator(this);
  }
}

// The iterator of an array (TS's `ArrayIterator<T>`). It holds the array (another reference
// to it, not a copy) and reads each element when `next()` reaches it; once it reported `done`
// it stays done, as in JS.
export class ArrayIterator<T> implements IterableIterator<T>, IteratorObject<T> {
  private items: T[];
  private index: usize = 0;
  private finished: bool = false;

  constructor(items: T[]) {
    this.items = items;
  }

  next(): IteratorResult<T> {
    if (this.finished || this.index >= this.items.length) {
      this.finished = true;
      return { done: true };
    }
    const value = __intrinsic_share(this.items[this.index]);
    this.index++;
    return { value: value, done: false };
  }

  [Symbol.iterator](): Iterator<T> {
    return this;
  }
}

// The iterator of a string (TS's `StringIterator<string>`): one character (code point) per
// step, as a string.
export class StringIterator implements IterableIterator<string>, IteratorObject<string> {
  private text: string;
  private pos: i64 = 0;

  constructor(text: string) {
    this.text = text;
  }

  next(): IteratorResult<string> {
    if (this.pos >= (this.text.length as i64)) {
      return { done: true };
    }
    // A high surrogate followed by a low one is one character.
    let n: i64 = 1;
    const c = this.text.charCodeAt(this.pos);
    if (c >= 0xd800 && c < 0xdc00) {
      const d = this.text.charCodeAt(this.pos + 1);
      if (d >= 0xdc00 && d < 0xe000) {
        n = 2;
      }
    }
    const value = this.text.slice(this.pos, this.pos + n);
    this.pos += n;
    return { value: value, done: false };
  }

  [Symbol.iterator](): Iterator<string> {
    return this;
  }
}

// A generator (`function*`, docs/reference/functions.md "Generators"): what calling one creates.
// The body runs lazily, one `next()` at a time, up to its next `yield`. `return()` (or dropping
// the generator, or `using`) closes a generator suspended at a `yield`: its `finally` blocks run
// and its `using` values are disposed, as if the `yield` were a `return`. After it finished,
// threw, or was closed, `next()` reports `done` forever. `E` is what the body throws.
//
// The compiler creates these objects: the generator's state follows the `state` word.
export class Generator<T, E = never> implements Iterator<T, E>, Iterable<T, E>, IterableIterator<T, E>, IteratorObject<T, E> {
  #state: u64 = 0;

  next(): IteratorResult<T> throws E {
    if (__intrinsic_generator_resume(this)) {
      return { value: __intrinsic_generator_value(this), done: false };
    }
    return { done: true };
  }

  return(): IteratorResult<T> {
    __intrinsic_generator_return(this);
    return { done: true };
  }

  // A generator is its own iterator.
  [Symbol.iterator](): Iterator<T, E> {
    return this;
  }

  [Symbol.dispose](): void {
    __intrinsic_generator_return(this);
  }
}

// An async generator (`async function*`, docs/reference/functions.md "Async generators"): what
// calling one creates. Each `next()` runs the body up to its next `yield`, awaiting what the body
// awaits on the way; its promise rejects with what the body throws (`E`). `return()` closes a
// generator suspended at a `yield`: its `finally` blocks run (and may `await`) and its `using`
// / `await using` values are disposed, as if the `yield` were a `return`. Dropping it closes it
// too, without awaiting: cleanup that would `await` is then cancelled (drops only), like a
// cancelled async function. After it finished, threw, or was closed, `next()` reports `done`.
//
// Like JS, `next()` and `return()` calls are queued: a call made while another one is still
// running waits for its turn, so each promise settles with its own step, in call order. A call
// whose promise nobody awaits still takes its turn (its value is dropped).
//
// The compiler creates these objects: the generator's state follows the class's fields, and the
// queue fields start at zero.
export class AsyncGenerator<T, E = never> implements AsyncIterator<T, E>, AsyncIterable<T, E>, AsyncIterableIterator<T, E> {
  #state: u64 = 0;
  // The call queue (see `takeTurn`): whether a call is running, the runtime latch the running
  // call opens when it finishes if it started alone, and the latch the last call in line opens
  // (0: none).
  #running: u64 = 0;
  #head: u64 = 0;
  #tail: u64 = 0;

  async next(): Promise<IteratorResult<T>, E> {
    const mine = await this.takeTurn();
    try {
      if (await __intrinsic_async_generator_resume(this)) {
        return { value: __intrinsic_async_generator_value(this), done: false };
      }
      return { done: true };
    } finally {
      this.passTurn(mine);
    }
  }

  async return(): Promise<IteratorResult<T>> {
    const mine = await this.takeTurn();
    try {
      await __intrinsic_async_generator_return(this);
      return { done: true };
    } finally {
      this.passTurn(mine);
    }
  }

  // An async generator is its own iterator.
  [Symbol.asyncIterator](): AsyncIterator<T, E> {
    return this;
  }

  async [Symbol.asyncDispose](): Promise<void> {
    await this.return();
  }

  [Symbol.dispose](): void {
    // A pending call keeps the object alive, so no call is queued any more.
    __intrinsic_async_generator_dispose(this);
  }

  // Waits until the calls made before this one finished. Returns the latch this call opens
  // when it finishes, which the call after it waits on (0: it started alone; a call queueing
  // behind it creates `head` for it then). An uncontended call allocates nothing; each finished
  // call wakes only the next one.
  private async takeTurn(): Promise<u64> {
    if (this.#running == 0) {
      this.#running = 1;
      return 0;
    }
    let before = this.#tail;
    if (before == 0) {
      // Only the running call, which started alone, is ahead.
      if (this.#head == 0) {
        this.#head = velt_rt_latch_new();
      }
      before = this.#head;
    }
    const mine = velt_rt_latch_new();
    this.#tail = mine;
    await velt_rt_latch_wait(before);
    return mine;
  }

  // The call that got `mine` from `takeTurn` finished: wake the next one, if any. The latch
  // is released by the call that opens it (a waiting call holds its own reference).
  private passTurn(mine: u64) {
    if (mine == 0) {
      if (this.#head == 0) {
        this.#running = 0;
        return;
      }
      velt_rt_latch_open(this.#head);
      velt_rt_latch_free(this.#head);
      this.#head = 0;
      return;
    }
    if (this.#tail == mine) {
      // Nobody is in line behind this call.
      this.#tail = 0;
      this.#running = 0;
      velt_rt_latch_free(mine);
      return;
    }
    velt_rt_latch_open(mine);
    velt_rt_latch_free(mine);
  }
}

declare function velt_rt_latch_new(): u64;
declare function velt_rt_latch_free(latch: u64);
declare function velt_rt_latch_open(latch: u64);
declare async function velt_rt_latch_wait(latch: u64): Promise<void>;

// An object literal whose member is a `[Symbol.iterator]()` method (`{ *[Symbol.iterator]() {
// ... } }`, docs/reference/types.md): the method as a function, called by each loop.
export class __IterableObject<T, E = never> implements Iterable<T, E> {
  constructor(private iterator: () => Iterator<T, E>) {}

  [Symbol.iterator](): Iterator<T, E> {
    return this.iterator();
  }
}

// The async twin: `{ async *[Symbol.asyncIterator]() { ... } }`.
export class __AsyncIterableObject<T, E = never> implements AsyncIterable<T, E> {
  constructor(private iterator: () => AsyncIterator<T, E>) {}

  [Symbol.asyncIterator](): AsyncIterator<T, E> {
    return this.iterator();
  }
}
