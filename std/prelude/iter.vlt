// Prelude: the iteration protocol (https://veltlang.com/docs/reference/control-flow/ "for...of").
//
// `for (const x of src)` works on arrays, on `Map`s and other classes with `entries()`, and on
// any `Iterable<T, E>`: it calls `src[Symbol.iterator]()` once, then `next()` until a result
// is `done`, and calls the iterator's `return()` when the loop is left early (`break`,
// `return`, a thrown error). `E` is what `next()` throws (`never`: nothing); the loop throws
// it too. Velt has no `undefined`, so a finished result has no `value` (reading `r.value`
// without narrowing gives `T | null`).

import {
  generatorResume,
  generatorResumeWith,
  generatorReturn,
  generatorThrow,
  generatorValue,
} from "velt/lang/intrinsics";

/**
 * One step of an iterator: `{ value, done: false }` for the next value, `{ done: true }` once it
 * is finished (Velt has no `undefined`: a finished result has no `value`).
 */
export type IteratorResult<T> = { value: T; done: false } | { done: true };

/**
 * Produces values one at a time with `next()` (`E`: what `next()` throws). `for...of` gets one
 * from an `Iterable`.
 */
export interface Iterator<T, E = never> {
  /** The next value, or a `done` result once there are no more. */
  next(): IteratorResult<T> throws E;

  /**
   * Early exit: release what the iterator holds. Not called after `next()` reported `done`.
   * Returns a finished result, as in TS (`for...of` ignores it).
   */
  return(): IteratorResult<T> {
    return { done: true };
  }
}

/** What `for...of` loops over: a value that makes iterators (`E`: what they throw). */
export interface Iterable<T, E = never> {
  /** A new iterator over the values (`for...of` calls it once per loop). */
  [Symbol.iterator](): Iterator<T, E>;
}

/**
 * Produces values one at a time, asynchronously (`E`: what `next()` rejects with). `for await`
 * gets one from an `AsyncIterable`.
 */
export interface AsyncIterator<T, E = never> {
  /** The next value, or a `done` result once there are no more. */
  next(): Promise<IteratorResult<T>, E>;

  /**
   * Early exit: release what the iterator holds. Not called after `next()` reported `done`.
   * Returns a finished result, as in TS (`for await` ignores it).
   */
  async return(): Promise<IteratorResult<T>> {
    return { done: true };
  }
}

/** What `for await...of` loops over: a value that makes async iterators. */
export interface AsyncIterable<T, E = never> {
  /** A new async iterator over the values (`for await` calls it once per loop). */
  [Symbol.asyncIterator](): AsyncIterator<T, E>;
}

/**
 * An iterator that is also iterable: its `[Symbol.iterator]()` returns the iterator itself, so
 * a loop can consume it (TS's `IterableIterator<T>`; generators are ones). Velt has no covariant
 * returns, so `[Symbol.iterator]()` returns `Iterator<T, E>`, not `IterableIterator<T, E>`.
 */
export interface IterableIterator<T, E = never> extends Iterator<T, E>, Iterable<T, E> {}

/**
 * TS's `IteratorObject<T>`, the type of the builtin iterators: the same contract as
 * `IterableIterator<T>` (TS adds the iterator helpers, `map`, `filter` and so on, which Velt
 * does not have yet).
 */
export interface IteratorObject<T, E = never> extends Iterator<T, E>, Iterable<T, E> {}

/**
 * An async iterator that is also async iterable (TS's `AsyncIterableIterator<T>`; async
 * generators are ones).
 */
export interface AsyncIterableIterator<T, E = never> extends AsyncIterator<T, E>, AsyncIterable<T, E> {}

/**
 * Interface values don't convert to the interfaces they extend yet; these blocks make the
 * iterable-iterator values `Iterable<T, E>` / `AsyncIterable<T, E>` values (TS allows passing
 * one where an iterable is expected).
 */
extend<T, E> IterableIterator<T, E> {
  /** The iterator itself. */
  [Symbol.iterator](): Iterator<T, E> {
    return this[Symbol.iterator]();
  }
}

extend<T, E> IteratorObject<T, E> {
  /** The iterator itself. */
  [Symbol.iterator](): Iterator<T, E> {
    return this[Symbol.iterator]();
  }
}

extend<T, E> AsyncIterableIterator<T, E> {
  /** The async iterator itself. */
  [Symbol.asyncIterator](): AsyncIterator<T, E> {
    return this[Symbol.asyncIterator]();
  }
}

// Arrays, strings, `Map`s (and `Set`s, std/collections) are iterable: `[Symbol.iterator]()`
// returns one of the iterators below, and they convert to `Iterable<T>` values (an `extend`
// block defining `[Symbol.iterator](): Iterator<T, E>` makes its type an `Iterable<T, E>`).
// `for...of` over them keeps its own loops and does not call these.

extend<T> Array<T> {
  /**
   * A live view, like JS's array iterator: it reads the length at each step, so it sees
   * elements pushed while it runs.
   */
  [Symbol.iterator](): Iterator<T> {
    return new ArrayIterator<T>(this);
  }
}

extend<K, V> Map<K, V> {
  /**
   * An iterator over the entries, as `for...of` over the map visits them: the entries when it
   * is made (`entries()`), in insertion order. JS's map iterator is a live view instead.
   */
  [Symbol.iterator](): Iterator<[K, V]> {
    return new ArrayIterator<[K, V]>(this.entries());
  }
}

extend string {
  /** The characters (code points), each as a string, like JS. */
  [Symbol.iterator](): Iterator<string> {
    return new StringIterator(this);
  }
}

/**
 * A generator (`function*`, https://veltlang.com/docs/reference/functions/ "Generators"): what calling one creates.
 * The body runs lazily, one `next()` at a time, up to its next `yield`. `return()` (or dropping
 * the generator, or `using`) closes a generator suspended at a `yield`: its `finally` blocks run
 * and its `using` values are disposed, as if the `yield` were a `return`. After it finished,
 * threw, or was closed, `next()` reports `done` forever. `E` is what the body throws.
 *
 * The compiler creates these objects: the generator's state follows the class's fields.
 */
export class Generator<T, E = never, N = never> implements Iterator<T, E>, Iterable<T, E>, IterableIterator<T, E>, IteratorObject<T, E> {
  #state: u64 = 0;

  /** Runs the body up to its next `yield` and returns that value, or a `done` result. */
  next(): IteratorResult<T> throws E {
    if (generatorResume(this)) {
      return { value: generatorValue(this), done: false };
    }
    return { done: true };
  }

  // `next(value)` in a `Generator<T, E, N>` (the compiler calls this for it): like `next()`,
  // and the paused `yield` evaluates to `value` (the first call's value is ignored, as in JS).
  private nextWith(value: N): IteratorResult<T> throws E {
    if (generatorResumeWith(this, value)) {
      return { value: generatorValue(this), done: false };
    }
    return { done: true };
  }

  /**
   * Resumes the body with `e` thrown at the paused `yield`: a `try` around it catches it (and
   * the result is the body's next step), else the generator is closed (its `finally` blocks
   * run) and `throw()` throws `e`. A generator that has not started or is finished throws `e`
   * at once (and is done). `e` is an `any`, as in TypeScript.
   */
  throw(e: any): IteratorResult<T> throws E | any {
    const r = generatorThrow(this, e);
    if (r == 1) {
      return { value: generatorValue(this), done: false };
    }
    if (r == 0) {
      return { done: true };
    }
    throw e;
  }

  /**
   * Closes the generator: a body suspended at a `yield` runs its `finally` blocks and disposes
   * its `using` values. Returns a finished result.
   */
  return(): IteratorResult<T> {
    generatorReturn(this);
    return { done: true };
  }

  /** A generator is its own iterator. */
  [Symbol.iterator](): Iterator<T, E> {
    return this;
  }

  /** `using` support: closes the generator, like `return()`. */
  [Symbol.dispose](): void {
    generatorReturn(this);
  }
}

// A generator as one of a wider error type (`Generator<T, E>` where a `Generator<T, F>` is
// expected, `F` allowing every `E`): its results are laid out by the error type, so the compiler
// passes its values through a generator of the wider type, as it widens a promise; what it
// throws converts to `F`.
function* generatorWiden<T, E, F>(g: Generator<T, E>): Generator<T, F> {
  try {
    yield* g;
  } catch (e) {
    throw e as F;
  }
}
