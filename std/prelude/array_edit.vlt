// Prelude: the array methods that change an array in place or copy it changed (`splice`, `shift`,
// `unshift`, `reverse`, `with`, `toSpliced`, …), and `length`, `entries` and `join` (array.vlt
// has the others).

import {
  arrayPrefetch,
  arrayRemove,
  arrayReserve,
  arrayRotateLeft,
  arrayRotateRight,
  arraySwap,
  arrayTruncate,
  arrayWithCapacity,
  share,
} from "velt/lang/intrinsics";
import { arrayLength } from "velt/lang/hooks/array";
import { checkRange, clampPosition, reverseRange } from "velt/lang/array/range";

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

extend<T> Array<T> {
  /**
   * Exchanges elements `i` and `j` (each must be below the length): their bits change places,
   * nothing is copied or dropped.
   */
  swap(i: usize, j: usize) {
    arraySwap(this, i, j);
  }

  /**
   * Rotates the elements in `[start, end)` one place down: the one at `start` moves to `end - 1`
   * and the others one place towards `start`, by one memory move (what `splice` would do with
   * a removal and an insert). `end` must be at most the length, `start` at most `end`.
   */
  rotateLeft(start: usize, end: usize) {
    checkRange(start, end, this.length);
    if (end - start > 1) {
      arrayRotateLeft(this, start, end - 1);
    }
  }

  /** As `rotateLeft`, one place up: the element at `end - 1` moves to `start`. */
  rotateRight(start: usize, end: usize) {
    checkRange(start, end, this.length);
    if (end - start > 1) {
      arrayRotateRight(this, start, end - 1);
    }
  }

  /**
   * A hint that element `i` is read soon: the CPU starts loading it, so that the read does not
   * wait for memory (a hint only, it changes nothing; an index past the end does nothing).
   */
  prefetch(i: usize) {
    if (i < this.length) {
      arrayPrefetch(this, i);
    }
  }

  /** Makes room for `extra` more elements without growing again (the length stays). */
  reserve(extra: usize) {
    arrayReserve(this, extra);
  }

  /** Reverses in place (JS also returns the array; here the result is `void`, see `fill`). */
  reverse() {
    reverseRange(this, 0, this.length);
  }

  /**
   * Removes `deleteCount` elements from `start` (positions as in `slice`; omitted: the rest),
   * inserts `items` there, and returns the removed elements, like JS. O(length).
   */
  splice(start: i64, deleteCount: i64 = 9223372036854775807, ...items: T[]): T[] {
    const len = this.length;
    const lo = clampPosition(start, len);
    const room = (len - lo) as i64;
    const k: usize = deleteCount <= 0 ? 0 : (deleteCount < room ? deleteCount : room) as usize;
    const out: T[] = arrayWithCapacity(k);
    if (k > 0) {
      // [lo, len) holds the removed block X then the rest Y: reversing it gives rev(Y) rev(X),
      // reversing rev(Y) back gives Y rev(X), so the removed elements come off the end in order.
      reverseRange(this, lo, len);
      reverseRange(this, lo, len - k);
      for (let i: usize = 0; i < k; i++) {
        out.push(arrayRemove(this, this.length - 1));
      }
    }
    if (items.length > 0) {
      // The array is A Y; pushing the items gives A Y I, and the same two reversals of [lo, end)
      // turn Y I into I Y.
      const rest = this.length - lo;
      // Moved in, not shared: `items` is the call's own array (and may hold promises).
      const n = items.length;
      for (let i: usize = 0; i < n; i++) {
        this.push(arrayRemove(items, 0));
      }
      reverseRange(this, lo, this.length);
      reverseRange(this, lo, lo + n);
      reverseRange(this, lo + n, lo + n + rest);
    }
    return out;
  }

  /**
   * Removes and returns the first element, or `undefined` when the array is empty.
   * O(length): the other elements move down by one, as V8 does for large arrays. A queue that
   * takes from the front belongs in a `Deque` (velt/collections/deque), which does it in O(1).
   */
  shift(): T | undefined {
    if (this.length == 0) {
      return undefined;
    }
    return arrayRemove(this, 0);
  }

  /**
   * Inserts `items` at the front, in order, and returns the new length, like JS. O(length +
   * items): the items are pushed, then rotated to the front by three reversals.
   */
  unshift(...items: T[]): i64 {
    if (items.length > 0) {
      const old = this.length;
      for (const x of items) {
        this.push(share(x));
      }
      reverseRange(this, 0, this.length);
      reverseRange(this, 0, items.length);
      reverseRange(this, items.length, items.length + old);
    }
    return this.length as i64;
  }

  /**
   * Shortens the array to `length` elements, dropping the rest (JS `xs.length = n`); a longer
   * `length` leaves it unchanged. Panics on a negative `length`, like JS's RangeError.
   */
  truncate(length: i64) {
    if (length < 0) {
      panic(`RangeError: Invalid array length: ${length}`);
    }
    if ((length as u64) < (this.length as u64)) {
      arrayTruncate(this, length as usize);
    }
  }

  /**
   * The number of elements, for `xs.length -= k` and `xs.length--` (which set it through the
   * setter below); a plain read of `xs.length` compiles to the length itself.
   */
  get length(): number {
    return this.length as number;
  }

  /**
   * `xs.length = n`, as in JS: drops the elements from `n` on (`xs.length = 0` empties the
   * array). A length that is not a whole number from 0 to 2^52 - 1, the most elements a Velt
   * array holds (JS stops at 2^32 - 1), panics with `RangeError: Invalid array length`
   * (`arrayLength`). A larger `n` than the array's length panics too: JS would add empty
   * slots, which Velt has no value for (push the elements, or build the array with
   * `new Array<T>(n).fill(v)`).
   */
  set length(n: number) {
    const len = arrayLength(n);
    if (len > this.length) {
      panic(
        `cannot grow an array by setting its length (from ${this.length} to ${len}): JS would add empty slots, which Velt has no value for; push the elements instead`,
      );
    }
    arrayTruncate(this, len);
  }

  // ES2023 copying forms (`toReversed`, `toSpliced`, `with`; `toSorted` is in sort.vlt): a new
  // array, the receiver unchanged. Like `slice`, the new array holds the same elements (objects
  // are shared, as in JS); the arrays themselves are independent.

  /** The elements in reverse order. */
  toReversed(): T[] {
    const out: T[] = arrayWithCapacity(this.length);
    let i = this.length;
    while (i > 0) {
      i--;
      out.push(share(this[i]));
    }
    return out;
  }

  /**
   * `splice(start, deleteCount, ...items)` on a copy: the array with the elements removed and
   * `items` inserted.
   */
  toSpliced(start: i64, deleteCount: i64 = 9223372036854775807, ...items: T[]): T[] {
    const len = this.length;
    const lo = clampPosition(start, len);
    const room = (len - lo) as i64;
    const k: usize = deleteCount <= 0 ? 0 : (deleteCount < room ? deleteCount : room) as usize;
    const out: T[] = arrayWithCapacity(len - k + items.length);
    for (let i: usize = 0; i < lo; i++) {
      out.push(share(this[i]));
    }
    for (const x of items) {
      out.push(share(x));
    }
    for (let i = lo + k; i < len; i++) {
      out.push(share(this[i]));
    }
    return out;
  }

  /**
   * A copy with `value` at `index` (negative counts from the end). Panics like JS's RangeError
   * when `index` is out of range.
   */
  with(index: i64, value: T): T[] {
    const i = index < 0 ? index + (this.length as i64) : index;
    if (i < 0 || i >= (this.length as i64)) {
      panic(`RangeError: Invalid index : ${index}`);
    }
    const out = this.slice();
    out[i as usize] = value;
    return out;
  }

  /** Whether the array has no elements (`xs.length == 0`). */
  isEmpty(): bool {
    return this.length == 0;
  }

  /**
   * `[index, element]` pairs (see header). JS returns an iterator; an array
   * serves the same `for (const [i, x] of xs.entries())` loops.
   */
  entries(): [usize, T][] {
    const out: [usize, T][] = arrayWithCapacity(this.length);
    for (let i: usize = 0; i < this.length; i++) {
      out.push([i, share(this[i])]);
    }
    return out;
  }

  /**
   * `join` for element types without their own (string enums, literal unions, objects): each
   * element as JS's `String(x)` writes an array element (a class instance through its
   * `toString()`, `[object Object]` for another object, `[object Map]` for a map). A struct
   * with its own `toString()`, an `Error` or a `RegExp` element is a compile error: write
   * `xs.map((x) => x.toString()).join(sep)`. Strings, numbers and bools have exact ones
   * below; arrays of arrays and of nullable elements have JS's in array_nested.vlt.
   */
  join(sep: string = ","): string {
    let s = "";
    for (let i: usize = 0; i < this.length; i++) {
      if (i > 0) {
        s += sep;
      }
      // A one-element tuple is written as its element is written in an array (no allocation).
      const one: [T] = [share(this[i])];
      s += `${one}`;
    }
    return s;
  }

  /**
   * The elements joined with ",", each as JS's `String(x)` writes an array element: what
   * `${xs}` writes (`[1, [2, 3], null].toString()` is `"1,2,3,"`).
   */
  toString(): string {
    return `${this}`;
  }
}
