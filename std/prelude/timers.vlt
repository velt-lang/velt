// Prelude: the global timer functions of TypeScript and Node, `setTimeout`, `clearTimeout`,
// `setInterval` and `clearInterval`, and the `Timer` handle they return (docs/std/timers.md).
// `velt:timers` re-exports them next to `setImmediate`, `delay` and `Ticker`.
//
// A timer takes a callback returning the promise to run, like JS: `setTimeout(() => save(doc),
// 100)` or `setTimeout(async () => { ... }, 10)` (a promise can't be passed: promises start
// when created). The callback owns what it captures, so it outlives the frame that scheduled
// it. The task runs as its own spawned task on the multi-threaded runtime; an error it throws is
// uncaught (the process exits like on an unhandled rejection), so catch inside it.
// Timers are ordinary compiled Velt tasks built on `sleep`: no code pointer is cached anywhere,
// so `velt dev` hot reload needs no special handling.

// A timer's task writes its state (`PENDING` until it first runs, then `STARTED`); only `clear()`
// writes the stop flag, so a clear racing a run on another core is never overwritten.
const PENDING: i64 = 0;
const STARTED: i64 = 1;
// The stop flag.
const RUNNING: i64 = 0;
const STOPPED: i64 = 1;

// Handle of a pending `setTimeout` / `setImmediate` task or of a `setInterval` schedule.
export class Timer {
  private state: shared<i64>;
  private stop: shared<i64>;
  private repeats: bool;

  // Wraps the task's flags (use `setTimeout` or `setInterval` to create timers).
  constructor(state: shared<i64>, stop: shared<i64>, repeats: bool) {
    this.state = state;
    this.stop = stop;
    this.repeats = repeats;
  }

  // Cancels the task if it has not started yet, and an interval's future runs at any time (a
  // no-op on a timeout that started, like JS `clearTimeout`). Dropping the handle does not
  // cancel.
  clear() {
    if (this.repeats || this.state.get() == PENDING) {
      this.stop.set(STOPPED);
    }
  }

  // Whether `clear()` cancelled the task before it started (an interval: whether it was
  // cleared).
  get cleared(): bool {
    return this.stop.get() == STOPPED && (this.repeats || this.state.get() == PENDING);
  }

  // Whether the task has started (an interval: whether it ran at least once).
  get started(): bool {
    return this.state.get() == STARTED;
  }
}

// Calls `task` after at least `ms` milliseconds unless the returned timer is cleared first.
export function setTimeout(task: () => Promise<void>, ms: i64): Timer {
  const state = shared(PENDING);
  const stop = shared(RUNNING);
  spawn(fireOnce(ms, task, state.clone(), stop.clone()));
  return new Timer(state, stop, false);
}

// Cancels `t` if its task has not started (same as `t.clear()`).
export function clearTimeout(t: Timer) {
  t.clear();
}

// Calls `task` every `ms` milliseconds (at least 1) until the returned timer is cleared. Each
// run waits for the previous run's promise, then `ms` more.
export function setInterval(task: () => Promise<void>, ms: i64): Timer {
  const state = shared(PENDING);
  const stop = shared(RUNNING);
  spawn(fireEvery(ms < 1 ? 1 : ms, task, state.clone(), stop.clone()));
  return new Timer(state, stop, true);
}

// Stops the interval `t` (same as `t.clear()`; also cancels a timeout, like JS).
export function clearInterval(t: Timer) {
  t.clear();
}

async function fireOnce(
  ms: i64,
  task: () => Promise<void>,
  state: shared<i64>,
  stop: shared<i64>,
): Promise<void> {
  if (ms > 0) {
    await sleep(ms);
  } else {
    await yieldNow();
  }
  if (stop.get() == STOPPED) {
    return;
  }
  state.set(STARTED);
  await task();
}

async function fireEvery(
  ms: i64,
  task: () => Promise<void>,
  state: shared<i64>,
  stop: shared<i64>,
): Promise<void> {
  while (true) {
    await sleep(ms);
    if (stop.get() == STOPPED) {
      return;
    }
    state.set(STARTED);
    await task();
  }
}
