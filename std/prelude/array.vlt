    const lo = clampPosition(start, len);
    const room = (len - lo) as i64;
    const k: usize = deleteCount <= 0 ? 0 : (deleteCount < room ? deleteCount : room) as usize;
    const out: T[] = __intrinsic_array_with_capacity(len - k + items.length);
    for (let i: usize = 0; i < lo; i++) {
      out.push(__intrinsic_share(this[i]));
    }
