  /**
   * Adds all the elements of an array into a string, separated by the specified separator string.
   * Each element is converted with `toString()`, which writes numbers and booleans as JS does.
   * @param sep - A string used to separate one element of the array from the next in the
   * resulting string. If omitted, the array elements are separated with a comma.
   */
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

