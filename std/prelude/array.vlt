// Prelude: JS-style methods on every array `T[]` (implicitly imported into every module).
//
// Conventions (see std/README.md):
// - Callbacks are non-escaping function params; elements are passed to them as borrows, so
//   iterating never copies non-Copy elements. Like JS, they also get the element's index (a
//   callback may take fewer parameters: `xs.map((x) => …)`). A callback may throw: the method throws what its
//   callback throws (`E`, inferred per call; `never` when the callback cannot throw).
// - A callback may change the array through another reference (an alias, or an object holding
//   it). Lowering passes a share of the element instead of a borrow when the array is one
//   other references may reach (velt_vir stabilize.rs), so the argument stays valid when a
//   push moves the buffer or a `pop` drops the element. The methods visit the indices below
//   the length they started with, and stop at the length the callback leaves when it is
//   shorter: `forEach`, `filter`, `reduce`, `some` and `every` skip the missing indices as JS
//   does; JS's `find` family visits them with `undefined`, which a `T` cannot be; `map`, whose
//   JS result would have holes, panics. The loops compare the index with one bound `n`,
//   lowered after a callback shortened the array (when nothing else references the array,
//   the length cannot change and the check folds away).
// - Methods that return elements *out of* the array (`find`, `filter`, `slice`, `concat`) return
//   the elements themselves, like JS: objects are shared (another reference to the same object,
//   a count increment), numbers, bool and strings are copied.
// - Indices are `usize` internally; positions reported to users (`indexOf`, `findIndex`) are
//   `i64` with -1 for "absent", like JS.
// - Sorting (`sort()`, `sort(cmp)`) lives in sort.vlt. `clone()` (a deep copy) is compiler-provided.

extend<T> Array<T> {
  forEach<E>(f: (x: T, i: i64) => void throws E) throws E {
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      f(this[i], i as i64);
      if (this.length < n) {
        n = this.length;
      }
    }
  }

  map<U, E>(f: (x: T, i: i64) => U throws E): U[] throws E {
    const out: U[] = __intrinsic_array_with_capacity(this.length);
    const n = this.length;
    let end = n;
    for (let i: usize = 0; i < end; i++) {
      out.push(f(this[i], i as i64));
      if (this.length < end) {
        end = this.length;
      }
    }
    if (out.length < n) {
      // JS leaves holes for the missing elements, which a `U[]` cannot hold.
      panic("the array shrank while `map` ran");
    }
    return out;
  }

  filter<E>(keep: (x: T, i: i64) => bool throws E): T[] throws E {
    const out: T[] = [];
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      if (keep(this[i], i as i64) && i < this.length) {
        out.push(__intrinsic_share(this[i]));
      }
      if (this.length < n) {
        n = this.length;
      }
    }
    return out;
  }

  reduce<A, E>(f: (acc: A, x: T, i: i64) => A throws E, init: A): A throws E {
    let acc = init;
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      acc = f(acc, this[i], i as i64);
      if (this.length < n) {
        n = this.length;
      }
    }
    return acc;
  }

  // First element matching `pred` (see header), or null.
  find<E>(pred: (x: T, i: i64) => bool throws E): T | null throws E {
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      if (pred(this[i], i as i64) && i < this.length) {
        return __intrinsic_share(this[i]);
      }
      if (this.length < n) {
        n = this.length;
      }
    }
    return null;
  }

  // Index of the first element matching `pred`, or -1.
  findIndex<E>(pred: (x: T, i: i64) => bool throws E): i64 throws E {
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      if (pred(this[i], i as i64)) {
        return i as i64;
      }
      if (this.length < n) {
        n = this.length;
      }
    }
    return -1;
  }

  // Last element matching `pred` (see header), or null.
  findLast<E>(pred: (x: T, i: i64) => bool throws E): T | null throws E {
    const i = this.findLastIndex(pred);
    return i < 0 || i as usize >= this.length ? null : __intrinsic_share(this[i as usize]);
  }

  // Index of the last element matching `pred`, or -1.
  findLastIndex<E>(pred: (x: T, i: i64) => bool throws E): i64 throws E {
    let i = this.length;
    while (i > 0) {
      i--;
      if (i < this.length && pred(this[i], i as i64)) {
        return i as i64;
      }
    }
    return -1;
  }

  // The element at `index` (negative counts from the end; see header), or null when
  // out of range.
  at(index: i64): T | null {
    const i = index < 0 ? index + (this.length as i64) : index;
    if (i < 0 || i >= (this.length as i64)) {
      return null;
    }
    return __intrinsic_share(this[i as usize]);
  }

  // Sets the elements in [start, end) to `value` (positions as in `slice`). JS also returns
  // the array; here the result is `void`, like `reverse` and `sort`: returning the array would
  // share it, which makes every array of its type reference counted in the whole program.
  // `new Array<T>(n).fill(v)` still works (the compiler builds the array in one step).
  fill(value: T, start: i64 = 0, end: i64 = 9223372036854775807) {
    const hi = clampPosition(end, this.length);
    for (let i = clampPosition(start, this.length); i < hi; i++) {
      this[i] = __intrinsic_share(value);
    }
  }

  some<E>(pred: (x: T, i: i64) => bool throws E): bool throws E {
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      if (pred(this[i], i as i64)) {
        return true;
      }
      if (this.length < n) {
        n = this.length;
      }
    }
    return false;
  }

  every<E>(pred: (x: T, i: i64) => bool throws E): bool throws E {
    let n = this.length;
    for (let i: usize = 0; i < n; i++) {
      if (!pred(this[i], i as i64)) {
        return false;
      }
      if (this.length < n) {
        n = this.length;
      }
    }
    return true;
  }

  // Structural equality (`==`), so `NaN` is never found (JS `indexOf` semantics).
  indexOf(x: T): i64 {
    for (let i: usize = 0; i < this.length; i++) {
      if (this[i] == x) {
        return i as i64;
      }
    }
    return -1;
  }

  lastIndexOf(x: T): i64 {
    let i = this.length;
    while (i > 0) {
      i--;
      if (this[i] == x) {
        return i as i64;
      }
    }
    return -1;
  }

  includes(x: T): bool {
    return this.indexOf(x) >= 0;
  }

  // Clones of the elements in [start, end). JS semantics: negative positions count from the
  // end, out-of-range positions are clamped, and `end` defaults to the length.
  slice(start: i64 = 0, end: i64 = 9223372036854775807): T[] {
    const lo = clampPosition(start, this.length);
    const hi = clampPosition(end, this.length);
    if (hi <= lo) {
      return [];
    }
    const out: T[] = __intrinsic_array_with_capacity(hi - lo);
    for (let i = lo; i < hi; i++) {
      out.push(__intrinsic_share(this[i]));
    }
    return out;
  }

  // New array with this array's elements followed by `other`'s.
  concat(other: T[]): T[] {
    const out: T[] = __intrinsic_array_with_capacity(this.length + other.length);
    for (let i: usize = 0; i < this.length; i++) {
      out.push(__intrinsic_share(this[i]));
    }
    for (let i: usize = 0; i < other.length; i++) {
      out.push(__intrinsic_share(other[i]));
    }
    return out;
  }

  // Reverses in place (JS also returns the array; here the result is `void`, see `fill`).
  reverse() {
    reverseRange(this, 0, this.length);
  }

  // Removes `deleteCount` elements from `start` (positions as in `slice`; omitted: the rest),
  // inserts `items` there, and returns the removed elements, like JS. O(length).
  splice(start: i64, deleteCount: i64 = 9223372036854775807, ...items: T[]): T[] {
    const len = this.length;
    const lo = clampPosition(start, len);
    const room = (len - lo) as i64;
    const k: usize = deleteCount <= 0 ? 0 : (deleteCount < room ? deleteCount : room) as usize;
    const out: T[] = __intrinsic_array_with_capacity(k);
    if (k > 0) {
      // [lo, len) holds the removed block X then the rest Y: reversing it gives rev(Y) rev(X),
      // reversing rev(Y) back gives Y rev(X), so the removed elements come off the end in order.
      reverseRange(this, lo, len);
      reverseRange(this, lo, len - k);
      for (let i: usize = 0; i < k; i++) {
        out.push(__intrinsic_array_remove(this, this.length - 1));
      }
    }
    if (items.length > 0) {
      // The array is A Y; pushing the items gives A Y I, and the same two reversals of [lo, end)
      // turn Y I into I Y.
      const rest = this.length - lo;
      // Moved in, not shared: `items` is the call's own array (and may hold promises).
      const n = items.length;
      for (let i: usize = 0; i < n; i++) {
        this.push(__intrinsic_array_remove(items, 0));
      }
      reverseRange(this, lo, this.length);
      reverseRange(this, lo, lo + n);
      reverseRange(this, lo + n, lo + n + rest);
    }
    return out;
  }

  // Removes and returns the first element, or null when the array is empty (JS: undefined).
  // O(length): the other elements move down by one, as V8 does for large arrays. A queue that
  // takes from the front belongs in a `Deque` (velt:collections/deque), which does it in O(1).
  shift(): T | null {
    if (this.length == 0) {
      return null;
    }
    return __intrinsic_array_remove(this, 0);
  }

  // Inserts `items` at the front, in order, and returns the new length, like JS. O(length +
  // items): the items are pushed, then rotated to the front by three reversals.
  unshift(...items: T[]): i64 {
    if (items.length > 0) {
      const old = this.length;
      for (const x of items) {
        this.push(__intrinsic_share(x));
      }
      reverseRange(this, 0, this.length);
      reverseRange(this, 0, items.length);
      reverseRange(this, items.length, items.length + old);
    }
    return this.length as i64;
  }

  // Shortens the array to `length` elements, dropping the rest (JS `xs.length = n`); a longer
  // `length` leaves it unchanged. Panics on a negative `length`, like JS's RangeError.
  truncate(length: i64) {
    if (length < 0) {
      panic(`RangeError: Invalid array length: ${length}`);
    }
    if ((length as u64) < (this.length as u64)) {
      __intrinsic_array_truncate(this, length as usize);
    }
  }

  // ES2023 copying forms (`toReversed`, `toSpliced`, `with`; `toSorted` is in sort.vlt): a new
  // array, the receiver unchanged. Like `slice`, the new array holds the same elements (objects
  // are shared, as in JS); the arrays themselves are independent.

  // The elements in reverse order.
  toReversed(): T[] {
    const out: T[] = __intrinsic_array_with_capacity(this.length);
    let i = this.length;
    while (i > 0) {
      i--;
      out.push(__intrinsic_share(this[i]));
    }
    return out;
  }

  // `splice(start, deleteCount, ...items)` on a copy: the array with the elements removed and
  // `items` inserted.
  toSpliced(start: i64, deleteCount: i64 = 9223372036854775807, ...items: T[]): T[] {
    const len = this.length;
    const lo = clampPosition(start, len);
    const room = (len - lo) as i64;
    const k: usize = deleteCount <= 0 ? 0 : (deleteCount < room ? deleteCount : room) as usize;
    const out: T[] = __intrinsic_array_with_capacity(len - k + items.length);
    for (let i: usize = 0; i < lo; i++) {
      out.push(__intrinsic_share(this[i]));
    }
    for (const x of items) {
      out.push(__intrinsic_share(x));
    }
    for (let i = lo + k; i < len; i++) {
      out.push(__intrinsic_share(this[i]));
    }
    return out;
  }

  // A copy with `value` at `index` (negative counts from the end). Panics like JS's RangeError
  // when `index` is out of range.
  with(index: i64, value: T): T[] {
    const i = index < 0 ? index + (this.length as i64) : index;
    if (i < 0 || i >= (this.length as i64)) {
      panic(`RangeError: Invalid index : ${index}`);
    }
    const out = this.slice();
    out[i as usize] = value;
    return out;
  }

  isEmpty(): bool {
    return this.length == 0;
  }

  // `[index, element]` pairs (see header). JS returns an iterator; an array
  // serves the same `for (const [i, x] of xs.entries())` loops.
  entries(): [usize, T][] {
    const out: [usize, T][] = __intrinsic_array_with_capacity(this.length);
    for (let i: usize = 0; i < this.length; i++) {
      out.push([i, __intrinsic_share(this[i])]);
    }
    return out;
  }

  // `join` for element types without their own (string enums, literal unions, objects): each
  // element as a template literal shows it (`${x}`; for objects that is the `console.log`
  // form, where JS writes `[object Object]`). Strings, numbers and bools have exact ones below;
  // arrays of arrays and of nullable elements have JS's (one level deep) in array_nested.vlt.
  join(sep: string = ","): string {
    let s = "";
    for (let i: usize = 0; i < this.length; i++) {
      if (i > 0) {
        s += sep;
      }
      s += `${this[i]}`;
    }
    return s;
  }
}

declare function velt_rt_str_join(parts: string[], sep: string): string;

extend Array<string> {
  // Joins with `sep`: the runtime sums the lengths, then copies every piece once into a string
  // of exactly that size.
  join(sep: string = ","): string {
    return velt_rt_str_join(this, sep);
  }
}

// `join` on numbers and booleans: each element is converted like `String(x)` (the same text
// `console.log` prints), then joined as strings. One `extend` per element type, since a generic
// `T` has no `toString`.
extend Array<i8> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<i16> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<i32> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<i64> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<isize> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<u8> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<u16> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<u32> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<u64> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<usize> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<f32> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<f64> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

extend Array<bool> {
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

// JS relative position → index in [0, len].
function clampPosition(pos: i64, len: usize): usize {
  const n = len as i64;
  if (pos < 0) {
    const fromEnd = n + pos;
    return fromEnd < 0 ? 0 : fromEnd as usize;
  }
  return pos > n ? len : pos as usize;
}

// `new Array<T>(n).fill(v)` (the compiler rewrites it to this, `sema` `array_ctor`): `n` copies
// of `v` in one allocation.
export function __arrayFilled<T>(n: i64, v: T): T[] {
  const len: usize = n > 0 ? n as usize : 0;
  const out: T[] = __intrinsic_array_with_capacity(len);
  for (let i: usize = 0; i < len; i++) {
    out.push(__intrinsic_share(v));
  }
  return out;
}

// `Array.from({ length: n }, (_, i) => f(i))` (rewritten to this): `f(i)` for each index.
export function __arrayFromLength<U>(n: i64, f: (i: i64) => U): U[] {
  const out: U[] = __intrinsic_array_with_capacity(n > 0 ? n as usize : 0);
  for (let i = 0; i < n; i++) {
    out.push(f(i));
  }
  return out;
}

// Reverses `xs[lo..hi)` in place.
function reverseRange<T>(xs: T[], lo: usize, hi: usize) {
  if (hi - lo < 2) {
    return;
  }
  let i = lo;
  let j = hi - 1;
  while (i < j) {
    __intrinsic_array_swap(xs, i, j);
    i++;
    j--;
  }
}
