// Prelude: `process.memoryUsage()` (`processMemoryUsage`) and a program's own `process.exit(code)`
// (`processExit`), which the compiler turns into calls of this module's functions. The other
// members of the builtin `process` namespace that compile
// to calls are hooks (std/lang/hooks/process.velt); the rest of Node's `process` is in
// `velt/process` (https://veltlang.com/docs/std/process/).

import { memoryFigures } from "#memory-sys";
import { processEnv } from "velt/lang/hooks/process";
import { writeStrCold } from "velt/lang/hooks/stdout";

/**
 * What `process.memoryUsage()` returns, in bytes, with Node's field names:
 * - `rss`: the resident set size the OS reports.
 * - `heapUsed`: the memory the process itself holds as the OS counts it (the resident pages no
 *   file backs on Linux, the physical footprint on macOS, the private committed bytes on
 *   Windows; the linear memory's size on WebAssembly). Unlike Node's, it is not the live bytes
 *   after a collection: it grows with retained data and falls when the allocator gives pages
 *   back.
 * - `heapTotal`: the same as `heapUsed`. Velt's allocator keeps no reserve of its own apart
 *   from what the OS already counts there.
 * - `external` and `arrayBuffers`: 0. Velt keeps no memory outside its heap that Node would
 *   count there (no V8 heap, no off-heap `ArrayBuffer` store): arrays and buffers are in
 *   `heapUsed`.
 */
export type MemoryUsage = {
  rss: i64;
  heapTotal: i64;
  heapUsed: i64;
  external: i64;
  arrayBuffers: i64;
};

/** `process.memoryUsage()`: the process's memory use in bytes, now (one OS read). */
export function processMemoryUsage(): MemoryUsage {
  const figures = memoryFigures();
  return {
    rss: figures[0],
    heapTotal: figures[1],
    heapUsed: figures[1],
    external: 0,
    arrayBuffers: 0,
  };
}

/**
 * What the leak counters' report gets first when the program ends itself (`processExit`): the
 * checks that read the report give no leak verdict then (crates/veltc/tests/golden.rs
 * `leaked_blocks`, std/test/plan.velt `leakedBlocks`).
 */
const EXIT_NOTE = "rc stats: the program called process.exit: no leak verdict\n";

/**
 * `process.exit(code)` in a program's own code (std's own exits are the intrinsic): the frames
 * live then keep what they hold, as Node runs no cleanup there, so with the debug runtime's
 * counters on (`VELT_RC_STATS=1`) the report is told that its counts are no leak verdict.
 */
export function processExit(code: i32): never {
  if (processEnv("VELT_RC_STATS") === "1") {
    writeStrCold(2, EXIT_NOTE);
  }
  process.exit(code);
}
