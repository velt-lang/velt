// Prelude: `Promise.allSettled` and `Promise.any` (https://veltlang.com/docs/reference/async/). The compiler compiles
// `Promise.allSettled(ps)` and `Promise.any(ps)` to calls of `promiseAllSettled` / `promiseAny`.

import { firstFulfilled } from "velt/lang/intrinsics";
import { PromiseSlot, runExecutor, settlement, settlers } from "velt/lang/promise/settle";

/** How `Promise.allSettled` reports one promise (`E`: what the promise rejects with). */
export type PromiseSettledResult<T, E> =
  | { status: "fulfilled"; value: T }
  | { status: "rejected"; reason: E };

/** Thrown by `Promise.any` when no promise fulfills (JS: `AggregateError`). */
export class AggregateError extends Error {
  /** An error with the given `message`. */
  constructor(message: string) {
    super(message);
    this.name = "AggregateError";
  }
}

/**
 * `Promise.allSettled(ps)`: waits for every promise and reports each outcome, in order. The
 * promises already run concurrently (they started when created), so awaiting them one by one
 * settles when the last one does.
 */
export async function promiseAllSettled<T, E>(
  ps: Promise<T, E>[],
): Promise<PromiseSettledResult<T, E>[]> {
  const out: PromiseSettledResult<T, E>[] = [];
  if (ps.length == 0) {
    return out;
  }
  // The promises as they are at the call, as JS reads them: the caller may still hold the
  // array and change it while this waits (and JS leaves the array as it is).
  const snap = ps.slice();
  for (let i = 0; i < snap.length; i++) {
    try {
      out.push({ status: "fulfilled", value: await snap[i] });
    } catch (e) {
      out.push({ status: "rejected", reason: e });
    }
  }
  // Node settles in the callback it runs for the last promise: one microtask later.
  await velt_rt_microtask();
  return out;
}

/**
 * `Promise.any(ps)`: the first promise to fulfill; `AggregateError` when all of them reject
 * (or the array is empty).
 */
export async function promiseAny<T, E>(ps: Promise<T, E>[]): Promise<T> throws AggregateError {
  if (ps.length == 0) {
    throw new AggregateError("All promises were rejected");
  }
  // Node settles in the callback it runs for the deciding promise: one microtask later.
  try {
    const v = await firstFulfilled(ps);
    await velt_rt_microtask();
    return v;
  } catch (e) {
    await velt_rt_microtask();
    throw new AggregateError("All promises were rejected");
  }
}

/**
 * `new Promise<T, E>((resolve, reject) => ...)`: the compiler compiles the constructor to a call
 * of `promiseNew`. The executor runs at once and is released before anything waits, so
 * it can't keep the promise pending through a cycle; `resolve` and `reject` may be stored and
 * called later, from any task, and the first settlement wins. An error the executor throws
 * rejects the promise. A promise whose `resolve` and `reject` are all dropped without settling
 * never settles, like in JS: what awaits it waits until nothing else can happen, and the program
 * ends then.
 */
export function promiseNew<T, E>(
  executor: (resolve: (value: T) => void, reject: (reason: E) => void) => void throws E,
): Promise<T, E> {
  const slot = shared(new Mutex<PromiseSlot<T, E>>(new PromiseSlot<T, E>()));
  runExecutor<T, E>(executor, slot.clone());
  return settlement<T, E>(slot);
}

/** `new Promise<T>((resolve) => ...)`: an executor that only resolves. */
export function promiseNewResolveOnly<T>(
  executor: (resolve: (value: T) => void) => void,
): Promise<T> {
  return promiseNew<T, never>((resolve, reject) => executor(resolve));
}

/**
 * What `Promise.withResolvers<T, E>()` returns (ES2024): a pending promise and the functions
 * that settle it.
 */
export type PromiseWithResolvers<T, E> = {
  promise: Promise<T, E>;
  resolve: (value: T) => void;
  reject: (reason: E) => void;
};

/**
 * `Promise.withResolvers<T, E>()`: the compiler compiles it to a call of `promiseWithResolvers`.
 * `resolve` and `reject` behave like a `new Promise` executor's: they may be stored, sent over
 * a channel or moved into a spawned task and called there, and the first settlement wins. A
 * promise whose `resolve` and `reject` are all dropped without settling never settles.
 */
export function promiseWithResolvers<T, E>(): PromiseWithResolvers<T, E> {
  const slot = shared(new Mutex<PromiseSlot<T, E>>(new PromiseSlot<T, E>()));
  const s = settlers<T, E>(slot.clone());
  return { promise: settlement<T, E>(slot), resolve: s.resolve, reject: s.reject };
}

/**
 * `Promise.resolve(value)`: a promise fulfilled with `value`. The compiler compiles
 * `Promise.resolve(v)` to a call of `promiseResolve`, and `Promise.resolve()` to one of
 * `promiseResolveVoid` (a `Promise<void>`).
 */
export async function promiseResolve<T>(value: T): Promise<T> {
  return value;
}

/** `Promise.resolve()`: a fulfilled `Promise<void>`. */
export async function promiseResolveVoid(): Promise<void> {}

/**
 * `Promise.reject(reason)`: a promise rejected with `reason`. The compiler compiles it to a call
 * of `promiseReject`; `T` is the value type the promise would have had (the type argument of
 * `Promise.reject<T>(e)`, else the expected type, else `never`).
 */
export async function promiseReject<T, E>(reason: E): Promise<T> throws E {
  throw reason;
}

// `then`, `catch` and `finally` (https://veltlang.com/docs/reference/async/ "Callbacks"). The compiler compiles
// `p.then(f)` to `promiseThen(p, f)`, or to `promiseThenAsync` when `f` returns a promise (which
// is then awaited: flattened, like JS), and so on for the other forms. Each takes the promise,
// waits until it settles, then for its turn in the task's microtask queue, then runs the
// callback, so callbacks run in JS's order. A rejection without a handler passes through.

declare async function velt_rt_microtask(): Promise<void>;

/**
 * `queueMicrotask(f)`: runs `f` after the code that is running now and the callbacks queued
 * before it, before timers and I/O.
 */
export function queueMicrotask<E>(f: () => void throws E) {
  const p = runMicrotask(f);
}

// An error `f` throws is uncaught, as in Node: it ends the process at the throw.
async function runMicrotask<E>(f: () => void throws E): Promise<void> {
  await velt_rt_microtask();
  try {
    f();
  } catch (e) {
    uncaught(e);
  }
}

declare function velt_rt_uncaught_now();

// Reports `e` as uncaught and exits 1 at once, as Node does for an error a callback throws: the
// rejection of a promise nothing awaits, reported when it is dropped (velt_rt_uncaught_now).
function uncaught<E>(e: E) {
  velt_rt_uncaught_now();
  const p = rethrow(e);
}

// Rejects with `e`.
async function rethrow<E>(e: E): Promise<void, E> {
  throw e;
}

// How `p` settled, moved out (one step of the task: no tick of its own).
async function settledOf<T, E>(p: Promise<T, E>): Promise<PromiseSettledResult<T, E>> {
  try {
    return { status: "fulfilled", value: await p };
  } catch (e) {
    return { status: "rejected", reason: e };
  }
}

// A promise a callback returns is adopted like a JS thenable: one microtask before it is awaited
// (the job that calls its `then`) and one after it settles (that `then`'s callback), so the new
// promise settles when Node's would.
async function adopted<U, F>(q: Promise<U, F>): Promise<U> throws F {
  await velt_rt_microtask();
  const r = await settledOf<U, F>(q);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

// After `finally`'s callback: the value or reason passes on two microtasks later, as in Node
// (its callback's result is wrapped in a promise whose `then` gives the new promise a thenable).
async function finallySteps(): Promise<void> {
  await velt_rt_microtask();
  await velt_rt_microtask();
}

// What the new promise rejects with is a single type parameter in each function: the source's
// error type, a callback's (the compiler converts the source to it), or both when they are the
// same. Which function a call compiles to depends on whether the callback returns a promise
// and whether it can fail.

/** `p.then(f)`: `f` returns a value and does not throw. */
export async function promiseThen<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => U,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return f(r.value);
}

/** `p.then(f)`: `f` returns a value and throws what `p` rejects with. */
export async function promiseThenThrows<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => U throws E,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return f(r.value);
}

/** `p.then(f)`: `f` returns a promise that does not reject. */
export async function promiseThenAsync<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => Promise<U>,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return await adopted<U, never>(f(r.value));
}

/** `p.then(f)`: `f` returns a promise that rejects with what `p` rejects with. */
export async function promiseThenAsyncThrows<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => Promise<U, E>,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return await adopted<U, E>(f(r.value));
}

/** `p.then(f, g)` where `f` and `g` return values (`F`: what they throw). */
export async function promiseThenElse<T, E, U, F>(
  p: Promise<T, E>,
  f: (value: T) => U throws F,
  g: (reason: E) => U throws F,
): Promise<U> throws F {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return g(r.reason);
  }
  return f(r.value);
}

/** `p.then(f, g)` where `f` and `g` return promises. */
export async function promiseThenElseAsync<T, E, U, F>(
  p: Promise<T, E>,
  f: (value: T) => Promise<U, F>,
  g: (reason: E) => Promise<U, F>,
): Promise<U> throws F {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return await adopted<U, F>(g(r.reason));
  }
  return await adopted<U, F>(f(r.value));
}

/** `p.catch(g)` where `g` returns a value. */
export async function promiseCatch<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => T throws G,
): Promise<T> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return g(r.reason);
  }
  return r.value;
}

/**
 * `p.catch(g)` where `p` never fulfills (`Promise<never, E>`: `Promise.reject(e)`, a `then`
 * whose callback only throws): the new promise gives what `g` gives.
 */
export async function promiseCatchNever<E, U, G>(
  p: Promise<never, E>,
  g: (reason: E) => U throws G,
): Promise<U> throws G {
  const r = await settledOf<never, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return g(r.reason);
  }
  panic("ICE: a promise of `never` fulfilled");
}

/** `promiseCatchNever` where `g` returns a promise. */
export async function promiseCatchNeverAsync<E, U, G>(
  p: Promise<never, E>,
  g: (reason: E) => Promise<U, G>,
): Promise<U> throws G {
  const r = await settledOf<never, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return await adopted<U, G>(g(r.reason));
  }
  panic("ICE: a promise of `never` fulfilled");
}

/** `p.catch(g)` where `g` returns a promise. */
export async function promiseCatchAsync<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => Promise<T, G>,
): Promise<T> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return await adopted<T, G>(g(r.reason));
  }
  return r.value;
}

/**
 * `p.catch(g)` where `g` returns nothing (`() => {}`) and `p` gives a value: the new promise
 * gives `p`'s value, or `undefined` once `g` handled a rejection (TypeScript's `T | void`).
 */
export async function promiseCatchVoid<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => void throws G,
): Promise<T | undefined> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    g(r.reason);
    return undefined;
  }
  return r.value;
}

/** `p.catch(g)` where `g` returns a `Promise<void>` and `p` gives a value. */
export async function promiseCatchVoidAsync<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => Promise<void, G>,
): Promise<T | undefined> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    await adopted<void, G>(g(r.reason));
    return undefined;
  }
  return r.value;
}

/**
 * `p.finally(h)`: the value or reason passes through two microtasks after `h` returned, as in
 * Node (`h` does not throw).
 */
export async function promiseFinally<T, E, R>(p: Promise<T, E>, h: () => R): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const ignored = h();
  await finallySteps();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

/** `p.finally(h)` where `h` throws what `p` rejects with. */
export async function promiseFinallyThrows<T, E, R>(
  p: Promise<T, E>,
  h: () => R throws E,
): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const ignored = h();
  await finallySteps();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

/** `p.finally(h)` where `h` returns a promise (that does not reject): it settles first. */
export async function promiseFinallyAsync<T, E, R>(
  p: Promise<T, E>,
  h: () => Promise<R>,
): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const ignored = await h();
  await finallySteps();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

/**
 * `p.finally(h)` where `h` returns a promise rejecting with what `p` rejects with: a rejection
 * of `h`'s promise replaces the outcome, as in JS.
 */
export async function promiseFinallyAsyncThrows<T, E, R>(
  p: Promise<T, E>,
  h: () => Promise<R, E>,
): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const done = await settledOf<R, E>(h());
  await finallySteps();
  if (done.status == "rejected") {
    throw done.reason;
  }
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}
