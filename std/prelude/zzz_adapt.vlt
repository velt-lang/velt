// Prelude: the containers of interface adapters (issue #1153; docs/reference/types.md "Generic
// interfaces with `unknown` arguments").
//
// A `Handler<Map<unknown, unknown>, E>` converted to `Handler<unknown, unknown>` receives an
// `unknown` that may hold a map of any type (`Map<string, number>`), whose elements are stored
// unboxed. The adapter passes the method a copy holding the elements boxed (`…In`), and when the
// method returns writes the copy back into the map it was made from (`…Out`), so the caller's
// map sees every change. Each element written back converts to the map's own element types,
// checked as a conversion out of `any` is. The helpers for `Set<unknown>` are in
// std/collections/set.vlt, which a program naming `Set` loads.
//
// The file name sorts last, so the prelude modules before it keep their indexes. Its bodies
// use dynamic operations without making the program pay for them: sema counts a program as
// using `any` members only when it converts such a value (`body/expr/iface_adapt.rs`).

/** Stops with the `TypeError` of an argument `v` that is not the `want` a method expects. */
export function __adaptMismatch(v: unknown, want: string): never {
  let found = "an object";
  if (v === undefined) {
    found = "undefined";
  } else if (v === null) {
    found = "null";
  } else if (Array.isArray(v)) {
    found = "an array";
  } else if (typeof v !== "object") {
    found = `a ${typeof v}`;
  }
  panic(`TypeError: the value is not ${want} (it is ${found})`);
}

/** An array of any type held by `v`, as an `unknown[]` of its elements. */
export function __unknownArrayIn(v: unknown): unknown[] {
  if (!Array.isArray(v)) {
    __adaptMismatch(v, "an unknown[]");
  }
  const a = v as any;
  const out: unknown[] = [];
  const n = a.length as number;
  for (let i = 0; i < n; i++) {
    out.push(a[i]);
  }
  return out;
}

/** Writes the elements of `xs` back into the array `v` holds (`__unknownArrayIn`). */
export function __unknownArrayOut(v: unknown, xs: unknown[]): void {
  const a = v as any;
  const n = a.length as number;
  if (xs.length != n) {
    panic(
      "TypeError: changing the length of an array passed as `unknown[]` through an interface adapter is not supported yet (#1185)",
    );
  }
  for (let i = 0; i < n; i++) {
    a[i] = xs[i];
  }
}

/** A map of any type held by `v`, as a `Map<unknown, unknown>` of its entries. */
export function __unknownMapIn(v: unknown): Map<unknown, unknown> {
  if (!(v instanceof Map)) {
    __adaptMismatch(v, "a Map<unknown, unknown>");
  }
  const a = v as any;
  const ks = a.keys();
  const vs = a.values();
  const n = ks.length as number;
  const out = new Map<unknown, unknown>();
  for (let i = 0; i < n; i++) {
    out.set(ks[i], vs[i]);
  }
  return out;
}

/** Writes the entries of `m` back into the map `v` holds (`__unknownMapIn`). */
export function __unknownMapOut(v: unknown, m: Map<unknown, unknown>): void {
  const a = v as any;
  a.clear();
  for (const [k, x] of m) {
    a.set(k, x);
  }
}

/**
 * `{ ...o }` of an `any` (or `object`) `o` in an object literal: the record `r` the literal
 * builds gets every own enumerable key of the value `o` holds, in its order (`null` and
 * `undefined` have none, as in JavaScript).
 */
export function __spreadAny(r: Record<string, any>, o: any): void {
  if (o === null || o === undefined) {
    return;
  }
  for (const k of Object.keys(o)) {
    r.__set(k, __anyMember(o, k));
  }
}

/**
 * `Object.hasOwn(o, k)` of an `any` (or `object`) `o`: one of its own enumerable keys, or an
 * array's or string's `length` (a proxy's `getOwnPropertyDescriptor` trap: velt:proxy/ops).
 */
export function __anyHasOwn(o: any, key: string | symbol): boolean {
  if (typeof key !== "string") {
    // Symbol-keyed members are not among the keys `Object.keys` lists.
    return false;
  }
  const k = key as string;
  if ((Array.isArray(o) || typeof o === "string") && k === "length") {
    return true;
  }
  return Object.keys(o).includes(k);
}

/**
 * Member `k` (one of `Object.keys(o)`) of the value `o` holds: an array's or a string's by its
 * index.
 */
function __anyMember(o: any, k: string): any {
  if (Array.isArray(o)) {
    return o[Number(k)];
  }
  if (typeof o === "string") {
    return o[Number(k) as i64];
  }
  return o[k];
}

/** `Object.values(o)` of an `any` (or `object`) `o`. */
export function __anyValues(o: any): any[] {
  const out: any[] = [];
  for (const k of Object.keys(o)) {
    out.push(__anyMember(o, k));
  }
  return out;
}

/** `Object.entries(o)` of an `any` (or `object`) `o`. */
export function __anyEntries(o: any): [string, any][] {
  const out: [string, any][] = [];
  for (const k of Object.keys(o)) {
    out.push([k, __anyMember(o, k)]);
  }
  return out;
}

/**
 * `Object.getPrototypeOf(v)` of an `any` (or `object`) `v` that holds no class instance: an
 * array's or an object's; anything else is not supported yet.
 */
export function __anyPrototype(v: any): ObjectPrototype | null {
  if (v === null || v === undefined) {
    panic("TypeError: Cannot convert undefined or null to object");
  }
  if (Array.isArray(v)) {
    return Array.prototype;
  }
  if (typeof v === "object") {
    return Object.prototype;
  }
  panic(
    `TypeError: \`Object.getPrototypeOf\` of a ${typeof v} through \`any\` is not supported yet (#924)`,
  );
}

/** `Object.getPrototypeOf(r)` of an `any` holding a record: `null` for `Object.create(null)`'s. */
export function __anyRecordPrototype(r: any): ObjectPrototype | null {
  // A record made by `Object.create(null)` inherits nothing, `__proto__` included.
  if ("__proto__" in r) {
    return Object.prototype;
  }
  return null;
}

/** `Object.getPrototypeOf(v)` of an `any` holding an instance of class `name`, which Velt doesn't name. */
export function __anyPrototypeUnsupported(name: string): ObjectPrototype | null {
  panic(
    `TypeError: \`Object.getPrototypeOf\` of a ${name} through \`any\` is not supported yet (#924)`,
  );
}

/** `Object.prototype.toString.call(v)` of an `any` (or `object`) `v` that holds no class instance. */
export function __anyObjectTag(v: any): string {
  if (v === undefined) {
    return "[object Undefined]";
  }
  if (v === null) {
    return "[object Null]";
  }
  if (Array.isArray(v)) {
    return "[object Array]";
  }
  const t = typeof v;
  if (t === "number") {
    return "[object Number]";
  }
  if (t === "string") {
    return "[object String]";
  }
  if (t === "boolean") {
    return "[object Boolean]";
  }
  if (t === "function") {
    return "[object Function]";
  }
  if (t === "symbol") {
    return "[object Symbol]";
  }
  return "[object Object]";
}

/** `Object.prototype.toString.call(v)` of an `any` holding an instance of class `name`, whose tag Velt doesn't know. */
export function __anyTagUnsupported(name: string): string {
  panic(
    `TypeError: \`Object.prototype.toString.call\` of a ${name} through \`any\` is not supported yet (#924)`,
  );
}

/**
 * `String(v)` of an `any` (or `unknown`, `object`) `v`, and its text in a template literal:
 * JavaScript's `ToString(ToPrimitive(v, "string"))`. Sema writes the dispatch over the program's
 * classes into this body (once per program, any_text.rs): an instance of a class with a
 * `[Symbol.toPrimitive]` method is written as that returns for `"string"`, one with a
 * `toString()` as that returns (else as its `valueOf()` returns); any other value goes to
 * `__anyText`.
 *
 * `at` (and the `at` of the helpers below) is the `path:line:col` of the user's call site, which
 * these helpers' stops report (one instance each, velt_vir `track_caller.rs`).
 */
export function __anyString(v: any, at: string): string {
  return String(v);
}

/**
 * The text of an `any` (or `object`) `v` in a string `+` or `+=`: JavaScript's
 * `ToString(ToPrimitive(v, "default"))`. Sema writes the dispatch over the program's classes
 * into this body (once per program, any_text.rs): `[Symbol.toPrimitive]("default")`, else what
 * `valueOf()` returns when that is a primitive, else what `toString()` returns; any other value
 * goes to `__anyConcatPlain`.
 */
export function __anyConcatText(v: any, at: string): string {
  return String(v);
}

/**
 * `__anyConcatText` of a value that is no class instance with a `[Symbol.toPrimitive]`,
 * `valueOf()` or `toString()`: an object literal's own `valueOf` when it returns a primitive,
 * else `__anyText`.
 */
export function __anyConcatPlain(v: any, at: string): string {
  if (typeof v === "symbol") {
    panic(`TypeError: Cannot convert a Symbol value to a string at ${at}`);
  }
  if (typeof v === "object" && v !== null && !Array.isArray(v) && __anyOwnFn(v, "valueOf")) {
    const p = __anyPrimTry(v.valueOf(), at);
    if (p !== null) {
      return p;
    }
  }
  return __anyText(v, at);
}

/**
 * The text of what a `toString()`, `valueOf()` or `[Symbol.toPrimitive]` returned: an object
 * there is Node's `TypeError`, and so is a symbol (`ToString` of it).
 */
export function __anyPrimText(r: any, at: string): string {
  const t = typeof r;
  if ((t === "object" && r !== null) || t === "function") {
    panic(`TypeError: Cannot convert object to primitive value at ${at}`);
  }
  if (t === "symbol") {
    panic(`TypeError: Cannot convert a Symbol value to a string at ${at}`);
  }
  return __anyText(r, at);
}

/**
 * `__anyPrimText(r)` of a primitive `r`; `null` for an object, for which `ToPrimitive` goes on
 * to the next method (`toString()` after `valueOf()`, or the other way round).
 */
export function __anyPrimTry(r: any, at: string): string | null {
  const t = typeof r;
  if ((t === "object" && r !== null) || t === "function") {
    return null;
  }
  return __anyPrimText(r, at);
}

/**
 * `String(p)` of a proxy `p` through `any`: JavaScript reads `p[Symbol.toPrimitive]` and
 * `p.toString` through its `get` trap, which this does not run yet.
 */
export function __anyTextUnsupported(name: string, at: string): string {
  panic(`TypeError: the text of a ${name} through \`any\` is not supported yet (#924) at ${at}`);
}

/** Is `k` one of the own keys of the object `v`, holding a function? */
function __anyOwnFn(v: any, k: string): boolean {
  return Object.keys(v).includes(k) && typeof v[k] === "function";
}

/**
 * `String(v)` of an `any` (or `unknown`, `object`) `v` that holds no class instance with a
 * `[Symbol.toPrimitive]` or `toString()` (`__anyString` calls those): an array as JavaScript's
 * `Array.prototype.toString` writes it (`__anyJoin`), an object literal by its own `toString`
 * (else its own `valueOf` when `toString` returns an object), another object as
 * `Object.prototype.toString` does (`[object Object]`), a number with `ToString` (`-0` is `0`).
 */
export function __anyText(v: any, at: string): string {
  const t = typeof v;
  if (t === "number") {
    // `-0` is `0`; the number may be held at any width (a `size` read through `any`).
    return v === 0 ? "0" : __anyNumberText(v);
  }
  if (t === "string") {
    return v as string;
  }
  if (t === "boolean") {
    return (v as boolean) ? "true" : "false";
  }
  if (t === "symbol") {
    return String(v as symbol);
  }
  if (v === null) {
    return "null";
  }
  if (v === undefined) {
    return "undefined";
  }
  if (t === "function") {
    // JavaScript writes the function's source text, which a compiled function doesn't keep.
    panic(
      `TypeError: \`String\` of a function through \`any\` is not supported yet (#924) at ${at}`,
    );
  }
  if (Array.isArray(v)) {
    return __anyJoin(v, ",", at);
  }
  if (__anyOwnFn(v, "toString")) {
    const p = __anyPrimTry(v.toString(), at);
    if (p !== null) {
      return p;
    }
    if (__anyOwnFn(v, "valueOf")) {
      return __anyPrimText(v.valueOf(), at);
    }
    panic(`TypeError: Cannot convert object to primitive value at ${at}`);
  }
  return Object.prototype.toString.call(v);
}

/**
 * `xs.join(sep)` of an array (or tuple) of `any`, `unknown` or `object` values, and
 * `String(xs)`: each element as `String(x)` writes it, `null` and `undefined` as empty text, and
 * an array being joined already (one holding itself) as empty text, as in JavaScript.
 */
export function __anyJoin(v: any, sep: string, at: string): string {
  const seen: any[] = [];
  return __anyJoinSeen(v, sep, seen, at);
}

/**
 * `xs.join(sep)` of an `any` `xs` (issue #1462): an array held is written as `__anyJoin`
 * writes it, with `sep` as `String(sep)` writes it (`","` when it is `undefined`, as in
 * JavaScript); another value's own `join` is called.
 */
export function __anyJoinMethod(v: any, sep: any, at: string): any {
  if (Array.isArray(v)) {
    return __anyJoin(v, sep === undefined ? "," : __anyString(sep, at), at);
  }
  return v.join(sep);
}

/** `__anyJoin` with the arrays being joined around it in `seen`. */
function __anyJoinSeen(v: any, sep: string, seen: any[], at: string): string {
  seen.push(v);
  let out = "";
  let first = true;
  for (const x of v) {
    if (!first) {
      out += sep;
    }
    first = false;
    if (x === null || x === undefined) {
      continue;
    }
    if (Array.isArray(x)) {
      if (!seen.includes(x)) {
        out += __anyJoinSeen(x, ",", seen, at);
      }
      continue;
    }
    if (typeof x === "symbol") {
      // `join` converts each element with `ToString`, which throws for a symbol.
      panic(`TypeError: Cannot convert a Symbol value to a string at ${at}`);
    }
    out += String(x);
  }
  seen.pop();
  return out;
}

/** `String(v)` of an `any` holding a number other than zero, written as it is held. */
function __anyNumberText(v: any): string {
  return String(v);
}

/**
 * `v.constructor.name` of an `any` (or `object`) `v` that holds no class instance: the name of
 * its constructor in JavaScript.
 */
export function __anyCtorName(v: any): string {
  if (v === undefined || v === null) {
    panic(
      `TypeError: Cannot read properties of ${v === null ? "null" : "undefined"} (reading 'constructor')`,
    );
  }
  if (Array.isArray(v)) {
    return "Array";
  }
  const t = typeof v;
  if (t === "number") {
    return "Number";
  }
  if (t === "string") {
    return "String";
  }
  if (t === "boolean") {
    return "Boolean";
  }
  if (t === "symbol") {
    return "Symbol";
  }
  if (t === "bigint") {
    return "BigInt";
  }
  if (t === "function") {
    // `Function`, `AsyncFunction` or `GeneratorFunction`: a function value doesn't say which.
    panic("TypeError: `constructor` of a function through `any` is not supported yet (#926)");
  }
  return "Object";
}

/** `v.constructor.name` of an `any` holding an instance of class `name`, whose constructor Velt doesn't name. */
export function __anyCtorNameUnsupported(name: string): string {
  panic(`TypeError: \`constructor\` of a ${name} through \`any\` is not supported yet (#926)`);
}

/**
 * `delete o.k` / `delete o[k]` of an `any` (or `object`) `o` (strict code) that is not a proxy
 * (a proxy's `deleteProperty` trap: velt:proxy/ops): `__anyDeletePlain`, and Node's `TypeError`
 * when the property cannot go.
 */
export function __anyDelete(o: any, k: any): boolean {
  if (o === null || o === undefined) {
    panic("TypeError: Cannot convert undefined or null to object");
  }
  if (typeof o === "string") {
    // A string's characters and `length` are fixed; it has no other own properties.
    const key = typeof k === "string" ? (k as string) : `${k}`;
    const i = __arrayIndex(key) as number;
    if (key === "length" || (i >= 0 && i < (o.length as number))) {
      panic(`TypeError: Cannot delete property '${key}' of [object String]`);
    }
    return true;
  }
  if (typeof o !== "object" && typeof o !== "function") {
    // A number's or a boolean's properties are its prototype's.
    return true;
  }
  if (!__anyDeletePlain(o, k)) {
    // Strict code: only an array's `length` refuses.
    panic(`TypeError: Cannot delete property '${String(k)}' of [object Array]`);
  }
  return true;
}

/**
 * `delete o[key]` of a plain (not proxy) object `o` (`Reflect.deleteProperty`): a record's key
 * is removed and an optional field made absent; a key `o` does not have is `true` and an array's
 * `length` `false`. Other properties are fixed by their types, which Velt cannot remove yet.
 */
export function __anyDeletePlain(o: any, key: any): boolean {
  if (typeof key === "symbol") {
    panic(
      "TypeError: deleting a symbol-keyed property of this value through `any` is not supported yet (#823)",
    );
  }
  if (typeof key !== "string" && typeof key !== "number") {
    panic("TypeError: this property key is not supported through a proxy yet (#823)");
  }
  const k = typeof key === "string" ? (key as string) : `${key as number}`;
  // Velt's arrays have no holes: an element past the end is not there, and one inside would
  // leave a hole (Node keeps the length). An array method on a proxy deletes the last ones
  // before it writes the shorter length (velt:proxy/array).
  if (Array.isArray(o)) {
    const i = __arrayIndex(k) as number;
    if (i >= 0) {
      const n = o.length as number;
      if (i >= n) {
        return true;
      }
      panic(
        `TypeError: deleting element ${i} of an array of ${n} through \`any\` is not supported yet (#823): Velt's arrays have no holes`,
      );
    }
  }
  return __intrinsic_any_delete(o, k);
}

/**
 * `Object.prototype.hasOwnProperty` read as a value (`const hasOwn =
 * Object.prototype.hasOwnProperty`): `hasOwn.call(o, k)` is `Object.hasOwn(o, k)`.
 */
export class __HasOwnProperty {
  /** Whether `o` has the own property `key`. */
  call(o: any, key: string | symbol): boolean {
    return __anyHasOwn(o, key);
  }
}
