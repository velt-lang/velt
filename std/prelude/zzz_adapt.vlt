// Prelude: the containers of interface adapters (issue #1153; docs/reference/types.md "Generic
// interfaces with `unknown` arguments").
//
// A `Handler<Map<unknown, unknown>, E>` converted to `Handler<unknown, unknown>` receives an
// `unknown` that may hold a map of any type (`Map<string, number>`), whose elements are stored
// unboxed. The adapter passes the method a copy holding the elements boxed (`…In`), and when the
// method returns writes the copy back into the map it was made from (`…Out`), so the caller's
// map sees every change. Each element written back converts to the map's own element types,
// checked as a conversion out of `any` is. The helpers for `Set<unknown>` are in
// std/collections/set.vlt, which a program naming `Set` loads.
//
// The file name sorts last, so the prelude modules before it keep their indexes. Its bodies
// use dynamic operations without making the program pay for them: sema counts a program as
// using `any` members only when it converts such a value (`body/expr/iface_adapt.rs`).

/** Stops with the `TypeError` of an argument `v` that is not the `want` a method expects. */
export function __adaptMismatch(v: unknown, want: string): never {
  let found = "an object";
  if (v === undefined) {
    found = "undefined";
  } else if (v === null) {
    found = "null";
  } else if (Array.isArray(v)) {
    found = "an array";
  } else if (typeof v !== "object") {
    found = `a ${typeof v}`;
  }
  panic(`TypeError: the value is not ${want} (it is ${found})`);
}

/** An array of any type held by `v`, as an `unknown[]` of its elements. */
export function __unknownArrayIn(v: unknown): unknown[] {
  if (!Array.isArray(v)) {
    __adaptMismatch(v, "an unknown[]");
  }
  const a = v as any;
  const out: unknown[] = [];
  const n = a.length as number;
  for (let i = 0; i < n; i++) {
    out.push(a[i]);
  }
  return out;
}

/** Writes the elements of `xs` back into the array `v` holds (`__unknownArrayIn`). */
export function __unknownArrayOut(v: unknown, xs: unknown[]): void {
  const a = v as any;
  const n = a.length as number;
  if (xs.length != n) {
    panic(
      "TypeError: changing the length of an array passed as `unknown[]` through an interface adapter is not supported yet (#1185)",
    );
  }
  for (let i = 0; i < n; i++) {
    a[i] = xs[i];
  }
}

/** A map of any type held by `v`, as a `Map<unknown, unknown>` of its entries. */
export function __unknownMapIn(v: unknown): Map<unknown, unknown> {
  if (!(v instanceof Map)) {
    __adaptMismatch(v, "a Map<unknown, unknown>");
  }
  const a = v as any;
  const ks = a.keys();
  const vs = a.values();
  const n = ks.length as number;
  const out = new Map<unknown, unknown>();
  for (let i = 0; i < n; i++) {
    out.set(ks[i], vs[i]);
  }
  return out;
}

/** Writes the entries of `m` back into the map `v` holds (`__unknownMapIn`). */
export function __unknownMapOut(v: unknown, m: Map<unknown, unknown>): void {
  const a = v as any;
  a.clear();
  for (const [k, x] of m) {
    a.set(k, x);
  }
}

/**
 * `{ ...o }` of an `any` (or `object`) `o` in an object literal: the record `r` the literal
 * builds gets every own enumerable key of the value `o` holds, in its order (`null` and
 * `undefined` have none, as in JavaScript).
 */
export function __spreadAny(r: Record<string, any>, o: any): void {
  if (o === null || o === undefined) {
    return;
  }
  for (const k of Object.keys(o)) {
    r.__set(k, __anyMember(o, k));
  }
}

/**
 * `Object.hasOwn(o, k)` of an `any` (or `object`) `o`: one of its own enumerable keys, or an
 * array's or string's `length`.
 */
export function __anyHasOwn(o: any, k: string): boolean {
  if ((Array.isArray(o) || typeof o === "string") && k === "length") {
    return true;
  }
  return Object.keys(o).includes(k);
}

/** Member `k` (one of `Object.keys(o)`) of the value `o` holds: an array's by its index. */
function __anyMember(o: any, k: string): any {
  if (Array.isArray(o)) {
    return o[Number(k)];
  }
  return o[k];
}

/** `Object.values(o)` of an `any` (or `object`) `o`. */
export function __anyValues(o: any): any[] {
  const out: any[] = [];
  for (const k of Object.keys(o)) {
    out.push(__anyMember(o, k));
  }
  return out;
}

/** `Object.entries(o)` of an `any` (or `object`) `o`. */
export function __anyEntries(o: any): [string, any][] {
  const out: [string, any][] = [];
  for (const k of Object.keys(o)) {
    out.push([k, __anyMember(o, k)]);
  }
  return out;
}

/**
 * `Object.getPrototypeOf(v)` of an `any` (or `object`) `v` that holds no class instance: an
 * array's or an object's; anything else is not supported yet.
 */
export function __anyPrototype(v: any): ObjectPrototype | null {
  if (v === null || v === undefined) {
    panic("TypeError: Cannot convert undefined or null to object");
  }
  if (Array.isArray(v)) {
    return Array.prototype;
  }
  if (typeof v === "object") {
    return Object.prototype;
  }
  panic(`TypeError: \`Object.getPrototypeOf\` of a ${typeof v} through \`any\` is not supported yet (#924)`);
}

/** `Object.getPrototypeOf(r)` of an `any` holding a record: `null` for `Object.create(null)`'s. */
export function __anyRecordPrototype(r: any): ObjectPrototype | null {
  // A record made by `Object.create(null)` inherits nothing, `__proto__` included.
  if ("__proto__" in r) {
    return Object.prototype;
  }
  return null;
}

/** `Object.getPrototypeOf(v)` of an `any` holding an instance of class `name`, which Velt doesn't name. */
export function __anyPrototypeUnsupported(name: string): ObjectPrototype | null {
  panic(`TypeError: \`Object.getPrototypeOf\` of a ${name} through \`any\` is not supported yet (#924)`);
}

/** `Object.prototype.toString.call(v)` of an `any` (or `object`) `v` that holds no class instance. */
export function __anyObjectTag(v: any): string {
  if (v === undefined) {
    return "[object Undefined]";
  }
  if (v === null) {
    return "[object Null]";
  }
  if (Array.isArray(v)) {
    return "[object Array]";
  }
  const t = typeof v;
  if (t === "number") {
    return "[object Number]";
  }
  if (t === "string") {
    return "[object String]";
  }
  if (t === "boolean") {
    return "[object Boolean]";
  }
  if (t === "function") {
    return "[object Function]";
  }
  if (t === "symbol") {
    return "[object Symbol]";
  }
  return "[object Object]";
}

/** `Object.prototype.toString.call(v)` of an `any` holding an instance of class `name`, whose tag Velt doesn't know. */
export function __anyTagUnsupported(name: string): string {
  panic(`TypeError: \`Object.prototype.toString.call\` of a ${name} through \`any\` is not supported yet (#924)`);
}
