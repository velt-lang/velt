// Prelude: runtime assertions for tests and invariants. Failures panic (exit code 101).

/** Panics with `msg` (exit code 101) unless `cond` is true. */
export function assert(cond: bool, msg: string = "assertion failed") {
  if (!cond) {
    panic(msg);
  }
}

/**
 * Deep equality (`deepEqual`: contents, not identity). On failure prints both values to stderr,
 * then panics.
 */
export function assertEq<T>(left: T, right: T, msg: string = "assertEq failed") {
  if (!__intrinsic_eq(left, right)) {
    console.error("assertion `left == right` failed");
    console.error("  left:", left);
    console.error(" right:", right);
    panic(msg);
  }
}

/**
 * Deep (structural) equality, like Node's `util.isDeepStrictEqual`: arrays, structs and object
 * literals compare their contents, recursively; `Map` and `Record` their keys and values in any
 * key order; other class instances by identity. `==` compares every object by identity, like JS.
 */
export function deepEqual<T>(a: T, b: T): bool {
  return __intrinsic_eq(a, b);
}

/**
 * Calls `f` and returns the error it throws, so a test can check it
 * (`assertEq(assertThrows(() => parse("x")).message, "bad input")`); panics if `f` returns
 * normally.
 */
export function assertThrows<R, E>(f: () => R throws E, msg: string = "expected an error"): E {
  try {
    f();
  } catch (e) {
    return e;
  }
  panic(msg);
}

/**
 * `value satisfies T` (TypeScript): `value`, checked against `T` with `T` as its context, as an
 * annotated initializer is. The parser writes the operator as a call of this function.
 */
export function __satisfies<T>(value: T): T {
  return value;
}

/**
 * `get name() { … }` in an object literal: the parser writes the getter as an arrow passed to
 * this function. Sema reads it where the literal implements an interface (the getter runs on
 * each read); this body never runs.
 */
export function __object_get<T>(get: () => T): T {
  return get();
}

/**
 * `set name(v) { … }` in an object literal, written as a call of this function (see
 * `__object_get`).
 */
export function __object_set<T>(set: (value: T) => void): (value: T) => void {
  return set;
}
