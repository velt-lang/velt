// Prelude: the JS `Math` object as a class of static constants and methods on f64.
//
// Rounding and `sqrt`/`abs` map to single compiler intrinsics (one machine instruction on
// x86_64/aarch64). `min`/`max` follow JS exactly: NaN if either operand is NaN, and
// -0 < +0 (`Math.max(-0, 0)` is +0, `Math.min(0, -0)` is -0). The exponential, logarithmic,
// trigonometric and hyperbolic functions are those of velt/lang/math: fdlibm's, as in V8, so
// that a program prints the same digits as under Node.

import { abs, ceil, floor, round, sqrt, trunc } from "velt/lang/intrinsics";
import { cbrt } from "velt/lang/math/cbrt";
import { exp, expm1 } from "velt/lang/math/exp";
import { acosh, asinh, atanh, cosh, sinh, tanh } from "velt/lang/math/hyperbolic";
import { acos, asin, atan, atan2 } from "velt/lang/math/inverse_trig";
import { log, log10, log1p, log2 } from "velt/lang/math/log";
import { cos, sin, tan } from "velt/lang/math/trig";
import { nextF64 } from "velt/lang/random/wyrand";

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

/**
 * Basic mathematics functionality and constants, on numbers (`f64`). Integers up to 32 bits
 * convert implicitly; a 64-bit integer does not: write `x as number`.
 */
export class Math {
  /** Pi. This is the ratio of the circumference of a circle to its diameter. */
  static readonly PI: f64 = 3.141592653589793;
  /** The mathematical constant e. This is Euler's number, the base of natural logarithms. */
  static readonly E: f64 = 2.718281828459045;
  /** The natural logarithm of 2. */
  static readonly LN2: f64 = 0.6931471805599453;
  /** The natural logarithm of 10. */
  static readonly LN10: f64 = 2.302585092994046;
  /** The base-2 logarithm of e. */
  static readonly LOG2E: f64 = 1.4426950408889634;
  /** The base-10 logarithm of e. */
  static readonly LOG10E: f64 = 0.4342944819032518;
  /** The square root of 2. */
  static readonly SQRT2: f64 = 1.4142135623730951;
  /** The square root of 0.5, or, equivalently, one divided by the square root of 2. */
  static readonly SQRT1_2: f64 = 0.7071067811865476;

  /**
   * Returns the square root of a number.
   * @param x - A numeric expression.
   */
  static sqrt(x: f64): f64 {
    return sqrt(x);
  }

  /**
   * Returns the greatest integer less than or equal to its numeric argument.
   * @param x - A numeric expression.
   */
  static floor(x: f64): f64 {
    return floor(x);
  }

  /**
   * Returns the smallest integer greater than or equal to its numeric argument.
   * @param x - A numeric expression.
   */
  static ceil(x: f64): f64 {
    return ceil(x);
  }

  /** JS rounding: halves go toward +Infinity (`Math.round(-2.5)` is -2). */
  static round(x: f64): f64 {
    return round(x);
  }

  /**
   * Returns the integral part of a numeric expression, `x`, removing any fractional digits.
   * If `x` is already an integer, the result is `x`. `Math.trunc(a / b)` with two integer
   * operands is integer division instead, and its result is an integer.
   * @param x - A numeric expression.
   */
  static trunc(x: f64): f64 {
    return trunc(x);
  }

  /**
   * Returns the absolute value of a number (the value without regard to whether it is positive or
   * negative).
   * For example, the absolute value of -5 is the same as the absolute value of 5.
   * @param x - A numeric expression for which the absolute value is needed.
   */
  static abs(x: f64): f64 {
    return abs(x);
  }

  /** -1, 0 or 1 with the sign of `x`; keeps -0 and NaN as they are, like JS. */
  static sign(x: f64): f64 {
    if (x > 0.0) {
      return 1.0;
    }
    if (x < 0.0) {
      return -1.0;
    }
    return x;
  }

  /**
   * Any number of values, like JS (`Math.max()` is -Infinity). A call with 2 to 16 plain
   * arguments compiles to a balanced tree of `max2` calls (sema, `body/expr/math_minmax.rs`)
   * and never builds the rest array; this body runs for spread calls and the other counts.
   */
  static max(a: f64 = -Infinity, b: f64 = -Infinity, ...rest: f64[]): f64 {
    let m = max2(a, b);
    for (const x of rest) {
      m = max2(m, x);
    }
    return m;
  }

  /**
   * Returns the smaller of a set of supplied numeric expressions: any number of values, like JS
   * (`Math.min()` is Infinity). NaN if any value is NaN. Calls with 2 to 16 plain arguments
   * compile to a tree of `min2` calls, as for `max`.
   */
  static min(a: f64 = Infinity, b: f64 = Infinity, ...rest: f64[]): f64 {
    let m = min2(a, b);
    for (const x of rest) {
      m = min2(m, x);
    }
    return m;
  }

  /**
   * Uniform in [0, 1), like JS: the per-thread generator of `velt/random` (not for secrets; use
   * `velt/crypto`).
   */
  static random(): f64 {
    return nextF64();
  }

  /**
   * Returns the value of a base expression taken to a specified power.
   * @param base - The base value of the expression.
   * @param exponent - The exponent value of the expression.
   */
  static pow(base: f64, exponent: f64): f64 {
    return base ** exponent;
  }

  /**
   * Returns e (the base of natural logarithms) raised to a power.
   * @param x - A numeric expression representing the power of e.
   */
  static exp(x: f64): f64 {
    return exp(x);
  }

  /**
   * Returns the result of (e^x - 1), accurate for an `x` near 0 too, where `Math.exp(x) - 1`
   * loses digits.
   * @param x - A numeric expression.
   */
  static expm1(x: f64): f64 {
    return expm1(x);
  }

  /**
   * Returns the natural logarithm (base e) of a number: NaN for a negative one, -Infinity for 0.
   * @param x - A numeric expression.
   */
  static log(x: f64): f64 {
    return log(x);
  }

  /**
   * Returns the natural logarithm of 1 + x, accurate for an `x` near 0 too.
   * @param x - A numeric expression.
   */
  static log1p(x: f64): f64 {
    return log1p(x);
  }

  /**
   * Returns the base 2 logarithm of a number; exact for the powers of two.
   * @param x - A numeric expression.
   */
  static log2(x: f64): f64 {
    return log2(x);
  }

  /**
   * Returns the base 10 logarithm of a number.
   * @param x - A numeric expression.
   */
  static log10(x: f64): f64 {
    return log10(x);
  }

  /**
   * Returns the sine of a number.
   * @param x - A numeric expression that contains an angle measured in radians.
   */
  static sin(x: f64): f64 {
    return sin(x);
  }

  /**
   * Returns the cosine of a number.
   * @param x - A numeric expression that contains an angle measured in radians.
   */
  static cos(x: f64): f64 {
    return cos(x);
  }

  /**
   * Returns the tangent of a number.
   * @param x - A numeric expression that contains an angle measured in radians.
   */
  static tan(x: f64): f64 {
    return tan(x);
  }

  /**
   * Returns the arcsine of a number, in radians from -PI/2 to PI/2; NaN outside [-1, 1].
   * @param x - A numeric expression.
   */
  static asin(x: f64): f64 {
    return asin(x);
  }

  /**
   * Returns the arc cosine (or inverse cosine) of a number, in radians from 0 to PI; NaN outside
   * [-1, 1].
   * @param x - A numeric expression.
   */
  static acos(x: f64): f64 {
    return acos(x);
  }

  /**
   * Returns the arctangent of a number, in radians from -PI/2 to PI/2.
   * @param x - A numeric expression for which the arctangent is needed.
   */
  static atan(x: f64): f64 {
    return atan(x);
  }

  /**
   * Returns the angle (in radians) between the X axis and the line going through both the origin
   * and the given point, from -PI to PI.
   * @param y - A numeric expression representing the cartesian y-coordinate.
   * @param x - A numeric expression representing the cartesian x-coordinate.
   */
  static atan2(y: f64, x: f64): f64 {
    return atan2(y, x);
  }

  /**
   * Returns the hyperbolic sine of a number.
   * @param x - A numeric expression.
   */
  static sinh(x: f64): f64 {
    return sinh(x);
  }

  /**
   * Returns the hyperbolic cosine of a number.
   * @param x - A numeric expression.
   */
  static cosh(x: f64): f64 {
    return cosh(x);
  }

  /**
   * Returns the hyperbolic tangent of a number.
   * @param x - A numeric expression.
   */
  static tanh(x: f64): f64 {
    return tanh(x);
  }

  /**
   * Returns the inverse hyperbolic sine of a number.
   * @param x - A numeric expression.
   */
  static asinh(x: f64): f64 {
    return asinh(x);
  }

  /**
   * Returns the inverse hyperbolic cosine of a number; NaN below 1.
   * @param x - A numeric expression.
   */
  static acosh(x: f64): f64 {
    return acosh(x);
  }

  /**
   * Returns the inverse hyperbolic tangent of a number; NaN outside [-1, 1].
   * @param x - A numeric expression.
   */
  static atanh(x: f64): f64 {
    return atanh(x);
  }

  /**
   * Returns the cube root of a number.
   * @param x - A numeric expression.
   */
  static cbrt(x: f64): f64 {
    return cbrt(x);
  }

  /**
   * Returns the nearest single precision float representation of a number (ties to even;
   * ±Infinity past the `f32` range), as a number.
   * @param x - A numeric expression.
   */
  static fround(x: f64): f64 {
    return (x as f32) as f64;
  }

  /**
   * sqrt(a² + b² + c² + …) without overflow or underflow: operands far from 1 are scaled by an
   * exact power of two (2^±600) first, so ordinary inputs stay correctly rounded. Any number of
   * values, like JS; past four they are scaled by the largest one. Infinity wins over NaN, like
   * JS.
   */
  static hypot(a: f64 = 0.0, b: f64 = 0.0, c: f64 = 0.0, d: f64 = 0.0, ...rest: f64[]): f64 {
    if (rest.length > 0) {
      return hypotMany([a, b, c, d, ...rest]);
    }
    const x = abs(a);
    const y = abs(b);
    const z = abs(c);
    const w = abs(d);
    const inf = 1.0 / 0.0;
    if (x == inf || y == inf || z == inf || w == inf) {
      return inf;
    }
    const big = Math.max(Math.max(x, y), Math.max(z, w));
    if (big > 3.273390607896142e+150) {
      return hypotScaled(x, y, z, w, 2.409919865102884e-181) * 4.149515568880993e+180;
    }
    if (big < 3.054936363499605e-151) {
      return hypotScaled(x, y, z, w, 4.149515568880993e+180) * 2.409919865102884e-181;
    }
    return hypotScaled(x, y, z, w, 1.0);
  }

  /**
   * JS `Math.imul`: the low 32 bits of the product of ToInt32 of both operands. A call on
   * numbers compiles to one 32-bit multiply (sema `int32.rs`); this body serves function values.
   */
  static imul(a: f64, b: f64): i64 {
    return (velt_rt_math_to_int32(a) * velt_rt_math_to_int32(b)) as i64;
  }

  /** JS `Math.clz32`: leading zero bits of ToUint32 of `x` (32 for 0). */
  static clz32(x: f64): i64 {
    return velt_rt_math_clz32(velt_rt_math_to_int32(x)) as i64;
  }

  /**
   * High 64 bits of the 128-bit product `a * b`, for 64-bit limb arithmetic (the low bits are
   * `a * b`, which wraps). Not in JS; like C#'s `Math.BigMul` / Rust's widening multiply.
   */
  static umulh(a: u64, b: u64): u64 {
    return velt_rt_math_umulh(a, b);
  }
}

declare function velt_rt_math_umulh(a: u64, b: u64): u64;

function max2(a: f64, b: f64): f64 {
  if (a > b) {
    return a;
  }
  if (b > a) {
    return b;
  }
  // Equal or unordered. For zeros `a + b` is +0 unless both are -0; for NaN it is NaN.
  return a == b && a != 0.0 ? a : a + b;
}

function min2(a: f64, b: f64): f64 {
  if (a < b) {
    return a;
  }
  if (b < a) {
    return b;
  }
  // Mirror of `max2`: -(-a + -b) is -0 unless both are +0, and NaN for NaN.
  return a == b && a != 0.0 ? a : -(-a + -b);
}

// `Math.hypot` of more than four values: the squares of the values divided by the largest.
function hypotMany(xs: f64[]): f64 {
  const inf = 1.0 / 0.0;
  let big = 0.0;
  let nan = false;
  for (const x of xs) {
    const a = abs(x);
    if (a == inf) {
      return inf;
    }
    if (a != a) {
      nan = true;
    } else if (a > big) {
      big = a;
    }
  }
  if (nan) {
    return 0.0 / 0.0;
  }
  if (big == 0.0) {
    return 0.0;
  }
  let sum = 0.0;
  for (const x of xs) {
    const r = x / big;
    sum += r * r;
  }
  return big * sqrt(sum);
}

// sqrt of the sum of the squares of the scaled values; `scale` is a power of two, so the scaling
// itself is exact (and zero terms add nothing: two values give the two-value result exactly).
function hypotScaled(x: f64, y: f64, z: f64, w: f64, scale: f64): f64 {
  const sx = x * scale;
  const sy = y * scale;
  const sz = z * scale;
  const sw = w * scale;
  return sqrt(sx * sx + sy * sy + sz * sz + sw * sw);
}

// JS's ToInt32 (`x | 0`): truncated, modulo 2^32, in the signed 32-bit range; NaN and ±Infinity
// give 0. Bitwise operators on numbers call it (sema `int32.rs`), and the backends emit it inline.
declare function velt_rt_math_to_int32(x: f64): i32;
// Leading zero bits of a 32-bit value (`Math.clz32`), one instruction.
declare function velt_rt_math_clz32(x: i32): i32;
// JS's `(a + x) | 0` for an int32 number `a` (backends emit it inline).
declare function velt_rt_math_add_int32(a: i32, x: f64): i32;
