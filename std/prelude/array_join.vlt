// Prelude: `join` on arrays of strings, numbers and `bool` (array.vlt has the generic one): the
// runtime joins strings; the other element types are converted as JS converts them.

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

declare function velt_rt_str_join(parts: string[], sep: string): string;

extend Array<string> {
  /**
   * Joins with `sep`: the runtime sums the lengths, then copies every piece once into a string
   * of exactly that size.
   */
  join(sep: string = ","): string {
    return velt_rt_str_join(this, sep);
  }
}

/**
 * `join` on numbers and booleans: each element is converted like `String(x)` (the same text
 * `console.log` prints), then joined as strings. One `extend` per element type, since a generic
 * `T` has no `toString`.
 */
extend Array<i8> {
  /**
   * Adds all the elements of an array into a string, separated by the specified separator string.
   * Each element is converted with `toString()`, which writes numbers and booleans as JS does.
   * @param sep - A string used to separate one element of the array from the next in the
   * resulting string. If omitted, the array elements are separated with a comma.
   */
  join(sep: string = ","): string {
    return this.map((x) => x.toString()).join(sep);
  }
}

