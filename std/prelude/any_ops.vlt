// Prelude: operators on `any` values holding objects and functions (issue #924,
// docs/reference/types.md "any and unknown"). Sema converts primitives itself; an object goes
// through JavaScript's `ToPrimitive` here first (`__anyToPrimitive`), and the operator then
// runs on the primitive it gives.
//
// The file name sorts after the other prelude modules, so their indexes stay the same.

import { anyToPrimitive } from "velt/lang/intrinsics";

/**
 * JavaScript's `ToPrimitive(v, hint)` of an `any` holding an object or a function (`hint` is
 * `"string"`, `"default"` or `"number"`; a primitive is its own, which the callers keep, so
 * this only borrows `v`): an object's `[Symbol.toPrimitive](hint)`, else its
 * `valueOf()` and `toString()` (`toString()` first for `"string"`), the first primitive one
 * returns kept as it is (a number stays a number). A `Date` takes `"default"` as `"string"`. Sema
 * writes the dispatch over the program's classes into this body (any_prim.rs); other values go
 * to `__anyToPrimitivePlain`.
 */
export function __anyToPrimitive(v: any, hint: string, at: string): any {
  if (v instanceof Date) {
    if (hint === "number") {
      return (v as Date).getTime();
    }
    return (v as Date).toString();
  }
  return anyToPrimitive(v, hint, at);
}

/**
 * `ToPrimitive(v, hint)` of an object that is no class instance with a `[Symbol.toPrimitive]`,
 * `valueOf()` or `toString()`: an array as its `join`, an object literal by its own `valueOf` /
 * `toString` in the hint's order, another object as `Object.prototype.toString` writes it. A
 * function's `ToPrimitive` is its source text, which a compiled function doesn't keep: `NaN`
 * stands for it where only its number counts (`"number"`, and `==`, which `"default"` is for
 * here, because the text is never a number or a boolean).
 */
export function __anyToPrimitivePlain(v: any, hint: string, at: string): any {
  if (typeof v === "function") {
    if (hint === "string") {
      return __anyText(v, at);
    }
    return NaN;
  }
  if (Array.isArray(v)) {
    return __anyJoin(v, ",", at);
  }
  if (hint !== "string" && __anyOwnFn(v, "valueOf")) {
    const r: any = v.valueOf();
    if (!__anyHoldsObject(r)) {
      return r;
    }
  }
  if (__anyOwnFn(v, "toString")) {
    const r: any = v.toString();
    if (!__anyHoldsObject(r)) {
      return r;
    }
    if (hint === "string" && __anyOwnFn(v, "valueOf")) {
      return __anyPrimKeep(v.valueOf(), at);
    }
    panic(`TypeError: Cannot convert object to primitive value at ${at}`);
  }
  return __anyText(v, at);
}

/** What a `valueOf()`, `toString()` or `[Symbol.toPrimitive]` returned, which must be a primitive. */
export function __anyPrimKeep(r: any, at: string): any {
  if (__anyHoldsObject(r)) {
    panic(`TypeError: Cannot convert object to primitive value at ${at}`);
  }
  return r;
}

/** `r` when it is a primitive, else what `next` gives (the next method `ToPrimitive` tries). */
export function __anyPrimThen(r: any, next: () => any): any {
  if (__anyHoldsObject(r)) {
    return next();
  }
  return r;
}

/**
 * `ToNumber` of an object or a function an `any` holds, for an operator on it (`-`, `*`, `<`,
 * `+x`): `ToPrimitive` with hint `"number"`, then `ToNumber` (`[5]` is 5, `[]` 0, `{}` NaN, a
 * `Date` its time, an object its `valueOf()`).
 */
export function __anyObjectNumber(v: any, at: string): number {
  return +__anyToPrimitive(v, "number", at);
}

/**
 * `a + b` of dynamic values one of which holds a string, an object, a function or a symbol
 * (sema adds numbers itself): JavaScript's `+`. Each side's `ToPrimitive` (hint `"default"`) is
 * taken; when either is a string the two are concatenated as `String` writes them, else they
 * are added as numbers.
 */
export function __anyAdd(a: any, b: any, at: string): any {
  if (typeof a === "function" || typeof b === "function") {
    // The text of a function is its source, which a compiled function doesn't keep.
    __anyText(typeof a === "function" ? a : b, at);
  }
  const pa = __anyHoldsObject(a) ? __anyToPrimitive(a, "default", at) : a;
  const pb = __anyHoldsObject(b) ? __anyToPrimitive(b, "default", at) : b;
  if (typeof pa === "string" || typeof pb === "string") {
    return __anyPrimText(pa, at) + __anyPrimText(pb, at);
  }
  return +pa + +pb;
}

/**
 * `a < b` (`op` 0), `a > b` (1), `a <= b` (2) or `a >= b` (3) of dynamic values one of which
 * holds an object or a function: JavaScript's comparison after `ToPrimitive` with hint
 * `"number"`, so `[2] < 10` is true, `[2] < "10"` compares strings and an object with a
 * `valueOf()` compares by the number it returns.
 */
export function __anyRelational(a: any, b: any, op: i64, at: string): boolean {
  const pa = __anyHoldsObject(a) ? __anyToPrimitive(a, "number", at) : a;
  const pb = __anyHoldsObject(b) ? __anyToPrimitive(b, "number", at) : b;
  let lt = false;
  let gt = false;
  if (typeof pa === "string" && typeof pb === "string") {
    const x = pa as string;
    const y = pb as string;
    lt = x < y;
    gt = x > y;
  } else {
    const x: number = +pa;
    const y: number = +pb;
    if (x !== x || y !== y) {
      return false;
    }
    lt = x < y;
    gt = x > y;
  }
  return op === 0 ? lt : op === 1 ? gt : op === 2 ? !gt : !lt;
}

/**
 * `a == b` of an object and a boolean, number or string (velt_vir any_eq.rs): the object's
 * `ToPrimitive` (hint `"default"`) compared loosely with the other (`[] == 0`,
 * `[1, 2] == "1,2"`, an object by its `valueOf()`).
 */
export function __anyLooseEq(a: any, b: any, at: string): boolean {
  if (__anyHoldsObject(a)) {
    return __anyToPrimitive(a, "default", at) == b;
  }
  return a == __anyToPrimitive(b, "default", at);
}

/** Does `v` hold an object or a function? */
export function __anyHoldsObject(v: any): boolean {
  const t = typeof v;
  return (t === "object" && v !== null) || t === "function";
}
