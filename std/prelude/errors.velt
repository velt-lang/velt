// Prelude: `Error`, the base class of every error thrown by std (`IoError`, `JsonError`).
//
// A function's error type is the union of what it can throw, so a call that can fail in two ways
// (e.g. `Response.json()` of a fetch: I/O, then JSON decoding) throws `IoError | JsonError`, and
// `catch (e) { e.message }` works either way (every member has `message`). User error classes
// extend it too.

import { errorText } from "velt/lang/hooks/error";

/**
 * The base class of errors: what std throws (`IoError`, `JsonError`, …) and what error classes
 * of your own extend. Catch them with `try { … } catch (e) { e.message }`.
 */
export class Error {
  /** What went wrong, for people. */
  message: string;

  // `name`, kept out of what `console.log` and `JSON.stringify` show (as in Node, where it is
  // on the prototype unless assigned, and then shown by the stack's first line). The built-in
  // subclasses keep their own (`TypeError`'s "TypeError"): a constructor never assigns `name`
  // through the accessor, which a program's subclass may override (#3792).
  #name: string = "Error";

  // `stack` once assigned (`undefined` included); `null`, which no program can assign, until then.
  #stack: string | undefined | null = null;

  /** An error with the given `message`. */
  constructor(message: string = "") {
    this.message = message;
  }

  /**
   * The kind of error: `"Error"`, `"TypeError"`, …; a subclass may assign its own
   * (`this.name = "AppError"`). `String(e)` and an uncaught error's report start with it.
   */
  get name(): string {
    return this.#name;
  }

  /** Sets the name `String(e)` and an uncaught error's report start with. */
  set name(value: string) {
    this.#name = value;
  }

  /**
   * The error's stack as Node starts it: `toString()`'s text (with the `name` a subclass assigned
   * in its constructor), until one is assigned. Velt keeps no call frames, so the `    at …` lines
   * Node adds after it are not there. Reading it changes nothing, so it can sit beside the error
   * in one call (`console.error(e, e.stack)`): V8 writes the text on the first read and keeps it,
   * so a `name` or `message` changed after that read shows here, where Node keeps the old text.
   */
  get stack(): string | undefined {
    const assigned = this.#stack;
    if (assigned === null) {
      return errorText(this.name, this.message);
    }
    return assigned;
  }

  /** Replaces the stack, as assigning Node's own `stack` property does. */
  set stack(value: string | undefined) {
    this.#stack = value;
  }

  /** `"<name>: <message>"`, just the name without a message, or just the message without a name. */
  toString(): string {
    return errorText(this.name, this.message);
  }
}

/** A value is not of the expected type (thrown by the runtime in JavaScript). */
export class TypeError extends Error {
  // Its `name`, as on its prototype in JavaScript: set with the class's initializers (in
  // `Error`'s `#name`), never through the accessor a subclass may override.
  name = "TypeError";

  /** An error with the given `message`. */
  constructor(message: string = "") {
    super(message);
  }
}

/** A number is outside the range of allowed values. */
export class RangeError extends Error {
  // Its `name`, as on its prototype in JavaScript: set with the class's initializers (in
  // `Error`'s `#name`), never through the accessor a subclass may override.
  name = "RangeError";

  /** An error with the given `message`. */
  constructor(message: string = "") {
    super(message);
  }
}

/** Text could not be parsed. */
export class SyntaxError extends Error {
  // Its `name`, as on its prototype in JavaScript: set with the class's initializers (in
  // `Error`'s `#name`), never through the accessor a subclass may override.
  name = "SyntaxError";

  /** An error with the given `message`. */
  constructor(message: string = "") {
    super(message);
  }
}

/** A name that does not exist was referenced. */
export class ReferenceError extends Error {
  // Its `name`, as on its prototype in JavaScript: set with the class's initializers (in
  // `Error`'s `#name`), never through the accessor a subclass may override.
  name = "ReferenceError";

  /** An error with the given `message`. */
  constructor(message: string = "") {
    super(message);
  }
}

/** Kept for compatibility with JavaScript, which no longer throws it. */
export class EvalError extends Error {
  // Its `name`, as on its prototype in JavaScript: set with the class's initializers (in
  // `Error`'s `#name`), never through the accessor a subclass may override.
  name = "EvalError";

  /** An error with the given `message`. */
  constructor(message: string = "") {
    super(message);
  }
}

/** A URI-handling function was given a malformed URI. */
export class URIError extends Error {
  // Its `name`, as on its prototype in JavaScript: set with the class's initializers (in
  // `Error`'s `#name`), never through the accessor a subclass may override.
  name = "URIError";

  /** An error with the given `message`. */
  constructor(message: string = "") {
    super(message);
  }
}
