// Prelude: `Promise.allSettled` and `Promise.any` (docs/reference/async.md). The compiler compiles
// `Promise.allSettled(ps)` and `Promise.any(ps)` to calls of `promiseAllSettled` / `promiseAny`.

/** How `Promise.allSettled` reports one promise (`E`: what the promise rejects with). */
export type PromiseSettledResult<T, E> =
  | { status: "fulfilled"; value: T }
  | { status: "rejected"; reason: E };

/** Thrown by `Promise.any` when no promise fulfills (JS: `AggregateError`). */
export class AggregateError extends Error {
  /** An error with the given `message`. */
  constructor(message: string) {
    super(message);
  }
}

/**
 * `Promise.allSettled(ps)`: waits for every promise and reports each outcome, in order. The
 * promises already run concurrently (they started when created), so awaiting them one by one
 * settles when the last one does.
 */
export async function promiseAllSettled<T, E>(
  ps: Promise<T, E>[],
): Promise<PromiseSettledResult<T, E>[]> {
  const out: PromiseSettledResult<T, E>[] = [];
  if (ps.length == 0) {
    return out;
  }
  ps.reverse();
  while (true) {
    const p = ps.pop();
    if (p == null) {
      // Node settles in the callback it runs for the last promise: one microtask later.
      await velt_rt_microtask();
      return out;
    }
    try {
      out.push({ status: "fulfilled", value: await p });
    } catch (e) {
      out.push({ status: "rejected", reason: e });
    }
  }
}

/**
 * `Promise.any(ps)`: the first promise to fulfill; `AggregateError` when all of them reject
 * (or the array is empty).
 */
export async function promiseAny<T, E>(ps: Promise<T, E>[]): Promise<T> throws AggregateError {
  if (ps.length == 0) {
    throw new AggregateError("All promises were rejected");
  }
  // Node settles in the callback it runs for the deciding promise: one microtask later.
  try {
    const v = await __intrinsic_promise_any(ps);
    await velt_rt_microtask();
    return v;
  } catch (e) {
    await velt_rt_microtask();
    throw new AggregateError("All promises were rejected");
  }
}

declare function velt_rt_latch_new(): u64;
declare function velt_rt_latch_free(latch: u64);
declare function velt_rt_latch_open(latch: u64);
declare async function velt_rt_latch_wait(latch: u64): Promise<void>;
declare function velt_rt_task_id(): u64;

// What a `new Promise` settled with (`pending` until `resolve` or `reject` is called;
// `abandoned` when every `resolve` and `reject` was dropped without settling).
type Settlement<T, E> =
  | { status: "pending" }
  | { status: "abandoned" }
  | { status: "fulfilled"; value: T }
  | { status: "rejected"; reason: E };

// The state `resolve`, `reject` and the waiting promise share: the outcome (at most one element:
// an array, so the promise can move it out with `pop()`), and the runtime latch that wakes the
// promise once it is settled.
class PromiseSlot<T, E> {
  latch: u64;
  outcome: Settlement<T, E>[];

  constructor() {
    this.latch = velt_rt_latch_new();
    this.outcome = [];
  }

  // The first settlement wins; later calls of `resolve` or `reject` are ignored, like JS.
  // Returns the latch to open once the lock is released (0: already settled).
  settle(outcome: Settlement<T, E>): u64 {
    if (this.outcome.length == 0) {
      this.outcome.push(outcome);
      return this.latch;
    }
    return 0;
  }

  // The settlement, moved out (`pending` if there is none).
  takeOutcome(): Settlement<T, E> {
    return this.outcome.pop() ?? { status: "pending" };
  }

  // Drop hook: releases the latch.
  [Symbol.dispose]() {
    if (this.latch != 0) {
      velt_rt_latch_free(this.latch);
      this.latch = 0;
    }
  }
}

// Opens a latch `settle` returned (0: nothing to open).
function openLatch(latch: u64) {
  if (latch != 0) {
    velt_rt_latch_open(latch);
  }
}

// Held only by `resolve` and `reject`: when the last of them is dropped, a promise that was
// never settled is settled as abandoned instead of waiting forever.
class AbandonGuard<T, E> {
  slot: shared<Mutex<PromiseSlot<T, E>>>;

  constructor(slot: shared<Mutex<PromiseSlot<T, E>>>) {
    this.slot = slot;
  }

  [Symbol.dispose]() {
    openLatch(this.slot.with((s) => s.settle({ status: "abandoned" })));
  }
}

// A promise's `resolve` and `reject`: heap closures over its slot, so they may be stored,
// returned and moved to other tasks; both hold the guard. A value settled on the promise's own
// task is shared with the awaiter, like JS. One settled from another task crosses threads, so it
// is transferred like a `spawn` argument (moved if nothing else references it, copied if it is
// still shared): after the settling statement has finished with it (`fulfillLater`), so a value
// made just for the call moves (#263). A value that cannot reach a counted object (a number, a
// string) has nothing to transfer and settles at once, so the reply costs no extra step.
type Settlers<T, E> = { resolve: (value: T) => void; reject: (reason: E) => void };

function settlers<T, E>(slot: shared<Mutex<PromiseSlot<T, E>>>): Settlers<T, E> {
  const home = velt_rt_task_id();
  const guard = shared(new Mutex<AbandonGuard<T, E>>(new AbandonGuard<T, E>(slot.clone())));
  const forResolve = slot.clone();
  const forReject = slot.clone();
  const guardReject = guard.clone();
  const resolve = (value: T) => {
    const here = velt_rt_task_id();
    if (here == home || here == 0 || !__intrinsic_needs_transfer(value)) {
      const v = here == home ? value : __intrinsic_transfer(value);
      openLatch(
        guard.with((g) => forResolve.with((s) => s.settle({ status: "fulfilled", value: v }))),
      );
    } else {
      const later = fulfillLater<T, E>(forResolve.clone(), guard.clone(), value);
    }
  };
  const reject = (reason: E) => {
    const here = velt_rt_task_id();
    if (here == home || here == 0 || !__intrinsic_needs_transfer(reason)) {
      const r = here == home ? reason : __intrinsic_transfer(reason);
      openLatch(
        guardReject.with((g) => forReject.with((s) => s.settle({ status: "rejected", reason: r }))),
      );
    } else {
      const later = rejectLater<T, E>(forReject.clone(), guardReject.clone(), reason);
    }
  };
  return { resolve: resolve, reject: reject };
}

// Settle `slot` from a task other than the promise's own, once the settling task is done with
// the current step: a promise this task drives (kept unawaited, it still runs to completion)
// that resumes at the task's next poll, when the caller has released its own reference to a
// value made for the call. The transfer then moves what nothing else references.
async function fulfillLater<T, E>(
  slot: shared<Mutex<PromiseSlot<T, E>>>,
  guard: shared<Mutex<AbandonGuard<T, E>>>,
  value: T,
): Promise<void> {
  await yieldNow();
  const v = __intrinsic_transfer(value);
  openLatch(guard.with((g) => slot.with((s) => s.settle({ status: "fulfilled", value: v }))));
}

// `fulfillLater` for a rejection.
async function rejectLater<T, E>(
  slot: shared<Mutex<PromiseSlot<T, E>>>,
  guard: shared<Mutex<AbandonGuard<T, E>>>,
  reason: E,
): Promise<void> {
  await yieldNow();
  const r = __intrinsic_transfer(reason);
  openLatch(guard.with((g) => slot.with((s) => s.settle({ status: "rejected", reason: r }))));
}

// Run the executor with its `resolve` and `reject`. A function of its own, so that once it
// returns only what the executor kept still references the guard.
function runExecutor<T, E>(
  executor: (resolve: (value: T) => void, reject: (reason: E) => void) => void throws E,
  slot: shared<Mutex<PromiseSlot<T, E>>>,
) {
  const s = settlers<T, E>(slot.clone());
  try {
    executor(s.resolve, s.reject);
  } catch (e) {
    openLatch(slot.with((s) => s.settle({ status: "rejected", reason: e })));
  }
}

/**
 * `new Promise<T, E>((resolve, reject) => ...)`: the compiler compiles the constructor to a call
 * of `promiseNew`, with `site` (where the `new Promise` is) and `direct` (whether it is the
 * operand of an `await`). The executor runs at once and is released before anything waits, so
 * it can't keep the promise pending through a cycle; `resolve` and `reject` may be stored and
 * called later, from any task, and the first settlement wins. An error the executor throws
 * rejects the promise. A promise whose `resolve` and `reject` are all dropped without settling
 * never settles, like in JS; awaiting it directly is reported instead of waiting forever.
 */
export function promiseNew<T, E>(
  executor: (resolve: (value: T) => void, reject: (reason: E) => void) => void throws E,
  site: string = "",
  direct: bool = false,
): Promise<T, E> {
  const slot = shared(new Mutex<PromiseSlot<T, E>>(new PromiseSlot<T, E>()));
  runExecutor<T, E>(executor, slot.clone());
  return settlement<T, E>(slot, site, direct);
}

// The slot's settlement, moved out. A plain value comes out as `with`'s result. One that
// reaches an object is taken out through `taken` instead: `with`'s result is transferred as it
// leaves the lock (a copy where it is still shared), but a value settled on this promise's own
// task is the awaiter's same object (JS identity), and one settled from another task was
// transferred when it was settled.
function takeSettlement<T, E>(slot: shared<Mutex<PromiseSlot<T, E>>>): Settlement<T, E> {
  const probe = { status: "pending" } as Settlement<T, E>; // the whole type, not `pending`
  if (!__intrinsic_needs_transfer(probe)) {
    return slot.with((s) => s.takeOutcome());
  }
  const taken: Settlement<T, E>[] = [];
  slot.with((s) => {
    taken.push(s.takeOutcome());
  });
  return taken.pop() ?? probe;
}

// Waits for the slot to be settled (holding only the slot, not the executor).
async function settlement<T, E>(
  slot: shared<Mutex<PromiseSlot<T, E>>>,
  site: string,
  direct: bool,
): Promise<T> throws E {
  await velt_rt_latch_wait(slot.with((s) => s.latch));
  const outcome = takeSettlement<T, E>(slot);
  switch (outcome.status) {
    case "fulfilled":
      return outcome.value;
    case "rejected":
      throw outcome.reason;
    case "abandoned":
      if (direct) {
        console.error(
          `panic: awaiting a promise whose resolve and reject were dropped without settling (created at ${site})`,
        );
        process.exit(101);
      }
      // Never settles, like a JS promise nobody resolves.
      const never: Promise<T, E>[] = [];
      return await Promise.race(never);
    case "pending":
      panic("internal error: a settled promise lost its outcome");
  }
}

/** `new Promise<T>((resolve) => ...)`: an executor that only resolves. */
export function promiseNewResolveOnly<T>(
  executor: (resolve: (value: T) => void) => void,
  site: string = "",
  direct: bool = false,
): Promise<T> {
  return promiseNew<T, never>((resolve, reject) => executor(resolve), site, direct);
}

/**
 * What `Promise.withResolvers<T, E>()` returns (ES2024): a pending promise and the functions
 * that settle it.
 */
export type PromiseWithResolvers<T, E> = {
  promise: Promise<T, E>;
  resolve: (value: T) => void;
  reject: (reason: E) => void;
};

/**
 * `Promise.withResolvers<T, E>()`: the compiler compiles it to a call of `promiseWithResolvers`.
 * `resolve` and `reject` behave like a `new Promise` executor's: they may be stored, sent over
 * a channel or moved into a spawned task and called there, and the first settlement wins. A
 * promise whose `resolve` and `reject` are all dropped without settling never settles.
 */
export function promiseWithResolvers<T, E>(): PromiseWithResolvers<T, E> {
  const slot = shared(new Mutex<PromiseSlot<T, E>>(new PromiseSlot<T, E>()));
  const s = settlers<T, E>(slot.clone());
  return { promise: settlement<T, E>(slot, "", false), resolve: s.resolve, reject: s.reject };
}

/**
 * `Promise.resolve(value)`: a promise fulfilled with `value`. The compiler compiles
 * `Promise.resolve(v)` to a call of `promiseResolve`, and `Promise.resolve()` to one of
 * `promiseResolveVoid` (a `Promise<void>`).
 */
export async function promiseResolve<T>(value: T): Promise<T> {
  return value;
}

/** `Promise.resolve()`: a fulfilled `Promise<void>`. */
export async function promiseResolveVoid(): Promise<void> {}

/**
 * `Promise.reject(reason)`: a promise rejected with `reason`. The compiler compiles it to a call
 * of `promiseReject`; `T` is the value type the promise would have had (the type argument of
 * `Promise.reject<T>(e)`, else the expected type, else `never`).
 */
export async function promiseReject<T, E>(reason: E): Promise<T> throws E {
  throw reason;
}

// `then`, `catch` and `finally` (docs/reference/async.md "Callbacks"). The compiler compiles
// `p.then(f)` to `promiseThen(p, f)`, or to `promiseThenAsync` when `f` returns a promise (which
// is then awaited: flattened, like JS), and so on for the other forms. Each takes the promise,
// waits until it settles, then for its turn in the task's microtask queue, then runs the
// callback, so callbacks run in JS's order. A rejection without a handler passes through.

declare async function velt_rt_microtask(): Promise<void>;

/**
 * `queueMicrotask(f)`: runs `f` after the code that is running now and the callbacks queued
 * before it, before timers and I/O.
 */
export function queueMicrotask(f: () => void) {
  const p = runMicrotask(f);
}

async function runMicrotask(f: () => void): Promise<void> {
  await velt_rt_microtask();
  f();
}

// How `p` settled, moved out (one step of the task: no tick of its own).
async function settledOf<T, E>(p: Promise<T, E>): Promise<PromiseSettledResult<T, E>> {
  try {
    return { status: "fulfilled", value: await p };
  } catch (e) {
    return { status: "rejected", reason: e };
  }
}

// A promise a callback returns is adopted like a JS thenable: one microtask before it is awaited
// (the job that calls its `then`) and one after it settles (that `then`'s callback), so the new
// promise settles when Node's would.
async function adopted<U, F>(q: Promise<U, F>): Promise<U> throws F {
  await velt_rt_microtask();
  const r = await settledOf<U, F>(q);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

// After `finally`'s callback: the value or reason passes on two microtasks later, as in Node
// (its callback's result is wrapped in a promise whose `then` gives the new promise a thenable).
async function finallySteps(): Promise<void> {
  await velt_rt_microtask();
  await velt_rt_microtask();
}

// What the new promise rejects with is a single type parameter in each function: the source's
// error type, a callback's (the compiler converts the source to it), or both when they are the
// same. Which function a call compiles to depends on whether the callback returns a promise
// and whether it can fail.

/** `p.then(f)`: `f` returns a value and does not throw. */
export async function promiseThen<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => U,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return f(r.value);
}

/** `p.then(f)`: `f` returns a value and throws what `p` rejects with. */
export async function promiseThenThrows<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => U throws E,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return f(r.value);
}

/** `p.then(f)`: `f` returns a promise that does not reject. */
export async function promiseThenAsync<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => Promise<U>,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return await adopted<U, never>(f(r.value));
}

/** `p.then(f)`: `f` returns a promise that rejects with what `p` rejects with. */
export async function promiseThenAsyncThrows<T, E, U>(
  p: Promise<T, E>,
  f: (value: T) => Promise<U, E>,
): Promise<U> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return await adopted<U, E>(f(r.value));
}

/** `p.then(f, g)` where `f` and `g` return values (`F`: what they throw). */
export async function promiseThenElse<T, E, U, F>(
  p: Promise<T, E>,
  f: (value: T) => U throws F,
  g: (reason: E) => U throws F,
): Promise<U> throws F {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return g(r.reason);
  }
  return f(r.value);
}

/** `p.then(f, g)` where `f` and `g` return promises. */
export async function promiseThenElseAsync<T, E, U, F>(
  p: Promise<T, E>,
  f: (value: T) => Promise<U, F>,
  g: (reason: E) => Promise<U, F>,
): Promise<U> throws F {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return await adopted<U, F>(g(r.reason));
  }
  return await adopted<U, F>(f(r.value));
}

/** `p.catch(g)` where `g` returns a value. */
export async function promiseCatch<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => T throws G,
): Promise<T> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return g(r.reason);
  }
  return r.value;
}

/** `p.catch(g)` where `g` returns a promise. */
export async function promiseCatchAsync<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => Promise<T, G>,
): Promise<T> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    return await adopted<T, G>(g(r.reason));
  }
  return r.value;
}

/**
 * `p.catch(g)` where `g` returns nothing (`() => {}`) and `p` gives a value: the new promise
 * gives `p`'s value, or `undefined` once `g` handled a rejection (TypeScript's `T | void`).
 */
export async function promiseCatchVoid<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => void throws G,
): Promise<T | undefined> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    g(r.reason);
    return undefined;
  }
  return r.value;
}

/** `p.catch(g)` where `g` returns a `Promise<void>` and `p` gives a value. */
export async function promiseCatchVoidAsync<T, E, G>(
  p: Promise<T, E>,
  g: (reason: E) => Promise<void, G>,
): Promise<T | undefined> throws G {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  if (r.status == "rejected") {
    await adopted<void, G>(g(r.reason));
    return undefined;
  }
  return r.value;
}

/**
 * `p.finally(h)`: the value or reason passes through two microtasks after `h` returned, as in
 * Node (`h` does not throw).
 */
export async function promiseFinally<T, E, R>(p: Promise<T, E>, h: () => R): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const ignored = h();
  await finallySteps();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

/** `p.finally(h)` where `h` throws what `p` rejects with. */
export async function promiseFinallyThrows<T, E, R>(
  p: Promise<T, E>,
  h: () => R throws E,
): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const ignored = h();
  await finallySteps();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

/** `p.finally(h)` where `h` returns a promise (that does not reject): it settles first. */
export async function promiseFinallyAsync<T, E, R>(
  p: Promise<T, E>,
  h: () => Promise<R>,
): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const ignored = await h();
  await finallySteps();
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}

/**
 * `p.finally(h)` where `h` returns a promise rejecting with what `p` rejects with: a rejection
 * of `h`'s promise replaces the outcome, as in JS.
 */
export async function promiseFinallyAsyncThrows<T, E, R>(
  p: Promise<T, E>,
  h: () => Promise<R, E>,
): Promise<T> throws E {
  const r = await settledOf<T, E>(p);
  await velt_rt_microtask();
  const done = await settledOf<R, E>(h());
  await finallySteps();
  if (done.status == "rejected") {
    throw done.reason;
  }
  if (r.status == "rejected") {
    throw r.reason;
  }
  return r.value;
}
