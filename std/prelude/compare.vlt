// Prelude: the builtin ordering interface.
//
// `a.compareTo(b)` is < 0 when `a` sorts before `b`, > 0 when after, 0 when equivalent.
// A generic `T extends Comparable<T>` can use `<`, `<=`, `>`, `>=` (they call `compareTo`).
// Implemented here for every number type, `string` (bytewise) and `bool` (`false` first); an
// `extend` block defining `compareTo(other: X): i64` makes `X` Comparable, and classes and
// structs can declare `implements Comparable<X>`. Floats order NaN after every other value
// (and equal to itself), the total order `sort()` uses.

/**
 * A type with an order: `T extends Comparable<T>` lets generic code use `<`, `<=`, `>` and `>=`,
 * which call `compareTo`. Every number type, `string` and `bool` implement it; an `extend`
 * block or a class with `compareTo(other: X): i64` makes `X` one.
 */
export interface Comparable<T> {
  /** Negative when `this` sorts before `other`, positive when after, 0 when equivalent. */
  compareTo(other: T): i64;
}

extend i8 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: i8): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend i16 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: i16): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend i32 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: i32): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend i64 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: i64): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend isize {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: isize): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend u8 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: u8): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend u16 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: u16): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend u32 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: u32): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend u64 {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: u64): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend usize {
  /** -1, 0 or 1: whether `this` is less than, equal to or greater than `other`. */
  compareTo(other: usize): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend f32 {
  /**
   * -1, 0 or 1: whether `this` is less than, equal to or greater than `other`, with NaN after
   * every other value and equal to itself (the total order `sort()` uses).
   */
  compareTo(other: f32): i64 {
    if (this < other) {
      return -1;
    }
    if (this > other) {
      return 1;
    }
    // Equal, or at least one NaN: NaN goes last.
    const aNaN = this != this;
    const bNaN = other != other;
    return aNaN == bNaN ? 0 : aNaN ? 1 : -1;
  }
}

extend f64 {
  /**
   * -1, 0 or 1: whether `this` is less than, equal to or greater than `other`, with NaN after
   * every other value and equal to itself (the total order `sort()` uses).
   */
  compareTo(other: f64): i64 {
    if (this < other) {
      return -1;
    }
    if (this > other) {
      return 1;
    }
    // Equal, or at least one NaN: NaN goes last.
    const aNaN = this != this;
    const bNaN = other != other;
    return aNaN == bNaN ? 0 : aNaN ? 1 : -1;
  }
}

extend string {
  /** -1, 0 or 1: the bytewise (UTF-8, so code point) order of `this` and `other`. */
  compareTo(other: string): i64 {
    return this < other ? -1 : this > other ? 1 : 0;
  }
}

extend bool {
  /** -1, 0 or 1: the order of `this` and `other`, `false` first. */
  compareTo(other: bool): i64 {
    return this == other ? 0 : this ? 1 : -1;
  }
}
