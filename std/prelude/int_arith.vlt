extend u32 {
  /** `this + b`, or null when it leaves the range of `u32`. */
  checkedAdd(b: u32): u32 | null {
    const r = (this as i64) + (b as i64);
    if (r < (0 as i64) || r > (4294967295 as i64)) {
      return null;
    }
    return r as u32;
  }
  /** `this + b`, clamped to the range of `u32`. */
  saturatingAdd(b: u32): u32 {
    const r = (this as i64) + (b as i64);
    if (r < (0 as i64)) {
      return 0;
    }
    return r > (4294967295 as i64) ? 4294967295 : (r as u32);
  }
  /** `this + b` wrapped to `u32` (as `this + b` on `u32` is). */
  wrappingAdd(b: u32): u32 {
    return this + b;
  }
  /** `this - b`, or null when it leaves the range of `u32`. */
  checkedSub(b: u32): u32 | null {
    const r = (this as i64) - (b as i64);
    if (r < (0 as i64) || r > (4294967295 as i64)) {
      return null;
    }
    return r as u32;
  }
  /** `this - b`, clamped to the range of `u32`. */
  saturatingSub(b: u32): u32 {
    const r = (this as i64) - (b as i64);
    if (r < (0 as i64)) {
      return 0;
    }
    return r > (4294967295 as i64) ? 4294967295 : (r as u32);
  }
  /** `this - b` wrapped to `u32` (as `this - b` on `u32` is). */
  wrappingSub(b: u32): u32 {
    return this - b;
  }
  /** `this * b`, or null when it leaves the range of `u32`. */
  checkedMul(b: u32): u32 | null {
    const r = (this as u64) * (b as u64);
    if (r > (4294967295 as u64)) {
      return null;
    }
    return r as u32;
  }
  /** `this * b`, clamped to the range of `u32`. */
  saturatingMul(b: u32): u32 {
    const r = (this as u64) * (b as u64);
    return r > (4294967295 as u64) ? 4294967295 : (r as u32);
  }
  /** `this * b` wrapped to `u32` (as `this * b` on `u32` is). */
  wrappingMul(b: u32): u32 {
    return this * b;
  }
}

extend i32 {
  /** `this + b`, or null when it leaves the range of `i32`. */
  checkedAdd(b: i32): i32 | null {
    const r = (this as i64) + (b as i64);
    if (r < ((-2147483647 - 1) as i64) || r > (2147483647 as i64)) {
      return null;
    }
    return r as i32;
  }
  /** `this + b`, clamped to the range of `i32`. */
  saturatingAdd(b: i32): i32 {
    const r = (this as i64) + (b as i64);
    if (r < ((-2147483647 - 1) as i64)) {
      return (-2147483647 - 1);
    }
    return r > (2147483647 as i64) ? 2147483647 : (r as i32);
  }
  /** `this + b` wrapped to `i32` (as `this + b` on `i32` is). */
  wrappingAdd(b: i32): i32 {
    return this + b;
  }
  /** `this - b`, or null when it leaves the range of `i32`. */
  checkedSub(b: i32): i32 | null {
    const r = (this as i64) - (b as i64);
    if (r < ((-2147483647 - 1) as i64) || r > (2147483647 as i64)) {
      return null;
    }
    return r as i32;
  }
  /** `this - b`, clamped to the range of `i32`. */
  saturatingSub(b: i32): i32 {
    const r = (this as i64) - (b as i64);
    if (r < ((-2147483647 - 1) as i64)) {
      return (-2147483647 - 1);
    }
    return r > (2147483647 as i64) ? 2147483647 : (r as i32);
  }
  /** `this - b` wrapped to `i32` (as `this - b` on `i32` is). */
  wrappingSub(b: i32): i32 {
    return this - b;
  }
  /** `this * b`, or null when it leaves the range of `i32`. */
  checkedMul(b: i32): i32 | null {
    const r = (this as i64) * (b as i64);
    if (r < ((-2147483647 - 1) as i64) || r > (2147483647 as i64)) {
      return null;
    }
    return r as i32;
  }
  /** `this * b`, clamped to the range of `i32`. */
  saturatingMul(b: i32): i32 {
    const r = (this as i64) * (b as i64);
    if (r < ((-2147483647 - 1) as i64)) {
      return (-2147483647 - 1);
    }
    return r > (2147483647 as i64) ? 2147483647 : (r as i32);
  }
  /** `this * b` wrapped to `i32` (as `this * b` on `i32` is). */
  wrappingMul(b: i32): i32 {
    return this * b;
  }
}
