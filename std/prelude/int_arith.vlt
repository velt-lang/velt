// Prelude: checked, saturating and wrapping arithmetic on the integer types up to 32 bits, as
// Rust's `checked_add`, `saturating_add` and `wrapping_add` (#1981 step 6). `x.checkedAdd(y)` is
// null when the sum leaves the type's range, `x.saturatingAdd(y)` clamps it to the range, and
// `x.wrappingAdd(y)` wraps, which `x + y` on a declared integer type already does: it names the
// intent. Likewise `Sub` and `Mul`. The exact result is computed in 64 bits and checked against
// the range. The 64-bit types are in int_arith_wide.vlt.

extend u8 {
  /** `this + b`, or null when it leaves the range of `u8`. */
  checkedAdd(b: u8): u8 | null {
    const r = (this as i64) + (b as i64);
    if (r < (0 as i64) || r > (255 as i64)) {
      return null;
    }
    return r as u8;
  }
  /** `this + b`, clamped to the range of `u8`. */
  saturatingAdd(b: u8): u8 {
    const r = (this as i64) + (b as i64);
    if (r < (0 as i64)) {
      return 0;
    }
    return r > (255 as i64) ? 255 : (r as u8);
  }
  /** `this + b` wrapped to `u8` (as `this + b` on `u8` is). */
  wrappingAdd(b: u8): u8 {
    return this + b;
  }
  /** `this - b`, or null when it leaves the range of `u8`. */
  checkedSub(b: u8): u8 | null {
    const r = (this as i64) - (b as i64);
    if (r < (0 as i64) || r > (255 as i64)) {
      return null;
    }
    return r as u8;
  }
  /** `this - b`, clamped to the range of `u8`. */
  saturatingSub(b: u8): u8 {
    const r = (this as i64) - (b as i64);
    if (r < (0 as i64)) {
      return 0;
    }
    return r > (255 as i64) ? 255 : (r as u8);
  }
  /** `this - b` wrapped to `u8` (as `this - b` on `u8` is). */
  wrappingSub(b: u8): u8 {
    return this - b;
  }
  /** `this * b`, or null when it leaves the range of `u8`. */
  checkedMul(b: u8): u8 | null {
    const r = (this as u64) * (b as u64);
    if (r > (255 as u64)) {
      return null;
    }
    return r as u8;
  }
  /** `this * b`, clamped to the range of `u8`. */
  saturatingMul(b: u8): u8 {
    const r = (this as u64) * (b as u64);
    return r > (255 as u64) ? 255 : (r as u8);
  }
  /** `this * b` wrapped to `u8` (as `this * b` on `u8` is). */
  wrappingMul(b: u8): u8 {
    return this * b;
  }
}

extend i8 {
  /** `this + b`, or null when it leaves the range of `i8`. */
  checkedAdd(b: i8): i8 | null {
    const r = (this as i64) + (b as i64);
    if (r < ((-127 - 1) as i64) || r > (127 as i64)) {
      return null;
    }
    return r as i8;
  }
  /** `this + b`, clamped to the range of `i8`. */
  saturatingAdd(b: i8): i8 {
    const r = (this as i64) + (b as i64);
    if (r < ((-127 - 1) as i64)) {
      return (-127 - 1);
    }
    return r > (127 as i64) ? 127 : (r as i8);
  }
  /** `this + b` wrapped to `i8` (as `this + b` on `i8` is). */
  wrappingAdd(b: i8): i8 {
    return this + b;
  }
  /** `this - b`, or null when it leaves the range of `i8`. */
  checkedSub(b: i8): i8 | null {
    const r = (this as i64) - (b as i64);
    if (r < ((-127 - 1) as i64) || r > (127 as i64)) {
      return null;
    }
    return r as i8;
  }
  /** `this - b`, clamped to the range of `i8`. */
  saturatingSub(b: i8): i8 {
    const r = (this as i64) - (b as i64);
    if (r < ((-127 - 1) as i64)) {
      return (-127 - 1);
    }
    return r > (127 as i64) ? 127 : (r as i8);
  }
  /** `this - b` wrapped to `i8` (as `this - b` on `i8` is). */
  wrappingSub(b: i8): i8 {
    return this - b;
  }
  /** `this * b`, or null when it leaves the range of `i8`. */
  checkedMul(b: i8): i8 | null {
    const r = (this as i64) * (b as i64);
    if (r < ((-127 - 1) as i64) || r > (127 as i64)) {
      return null;
    }
    return r as i8;
  }
  /** `this * b`, clamped to the range of `i8`. */
  saturatingMul(b: i8): i8 {
    const r = (this as i64) * (b as i64);
    if (r < ((-127 - 1) as i64)) {
      return (-127 - 1);
    }
    return r > (127 as i64) ? 127 : (r as i8);
  }
  /** `this * b` wrapped to `i8` (as `this * b` on `i8` is). */
  wrappingMul(b: i8): i8 {
    return this * b;
  }
}

extend u16 {
  /** `this + b`, or null when it leaves the range of `u16`. */
  checkedAdd(b: u16): u16 | null {
    const r = (this as i64) + (b as i64);
    if (r < (0 as i64) || r > (65535 as i64)) {
      return null;
    }
    return r as u16;
  }
  /** `this + b`, clamped to the range of `u16`. */
  saturatingAdd(b: u16): u16 {
    const r = (this as i64) + (b as i64);
    if (r < (0 as i64)) {
      return 0;
    }
    return r > (65535 as i64) ? 65535 : (r as u16);
  }
  /** `this + b` wrapped to `u16` (as `this + b` on `u16` is). */
  wrappingAdd(b: u16): u16 {
    return this + b;
  }
  /** `this - b`, or null when it leaves the range of `u16`. */
  checkedSub(b: u16): u16 | null {
    const r = (this as i64) - (b as i64);
    if (r < (0 as i64) || r > (65535 as i64)) {
      return null;
    }
    return r as u16;
  }
  /** `this - b`, clamped to the range of `u16`. */
  saturatingSub(b: u16): u16 {
    const r = (this as i64) - (b as i64);
    if (r < (0 as i64)) {
      return 0;
    }
    return r > (65535 as i64) ? 65535 : (r as u16);
  }
  /** `this - b` wrapped to `u16` (as `this - b` on `u16` is). */
  wrappingSub(b: u16): u16 {
    return this - b;
  }
  /** `this * b`, or null when it leaves the range of `u16`. */
  checkedMul(b: u16): u16 | null {
    const r = (this as u64) * (b as u64);
    if (r > (65535 as u64)) {
      return null;
    }
    return r as u16;
  }
  /** `this * b`, clamped to the range of `u16`. */
  saturatingMul(b: u16): u16 {
    const r = (this as u64) * (b as u64);
    return r > (65535 as u64) ? 65535 : (r as u16);
  }
  /** `this * b` wrapped to `u16` (as `this * b` on `u16` is). */
  wrappingMul(b: u16): u16 {
    return this * b;
  }
}

extend i16 {
  /** `this + b`, or null when it leaves the range of `i16`. */
  checkedAdd(b: i16): i16 | null {
    const r = (this as i64) + (b as i64);
