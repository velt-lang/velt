// std/prelude/process: the members of the builtin `process` namespace that the compiler turns
// into calls: `process.stdout.write(s)` / `process.stderr.write(s)` (`__processWrite`),
// `process.env.NAME` / `process.env[name]` (`__processEnv`) and `process.memoryUsage()`
// (`processMemoryUsage`). The rest of Node's `process` is in `velt:process` (docs/std/process.md).

declare function velt_rt_write_str(stream: u32, s: string);
declare function velt_rt_env_get(name: string, out: string): bool;

/**
 * Writes `s` to standard output (`stream` 1) or standard error (2), without a newline, ordered
 * with `console.log` / `console.error`. Returns `true`, like Node's `write`.
 */
export function __processWrite(stream: u32, s: string): bool {
  velt_rt_write_str(stream, s);
  return true;
}

/** The value of environment variable `name`, or `undefined` if it is unset. */
export function __processEnv(name: string): string | undefined {
  let out = "";
  if (velt_rt_env_get(name, out)) {
    return out;
  }
  return undefined;
}

declare function velt_rt_memory_rss(): i64;
declare function velt_rt_memory_heap(): i64;

/**
 * What `process.memoryUsage()` returns, in bytes (Node's field names): `rss` is the resident set
 * size the OS reports, `heapUsed` the memory the allocator has committed for the heap.
 */
export type MemoryUsage = { rss: i64; heapUsed: i64 };

/** `process.memoryUsage()`: the process's memory use in bytes, now. */
export function processMemoryUsage(): MemoryUsage {
  return { rss: velt_rt_memory_rss(), heapUsed: velt_rt_memory_heap() };
}

declare function velt_rt_process_node_argv(): string[];

/**
 * Node's `process.argv`: `[runtime, script, ...args]` (the running executable, the script under
 * `velt run` / `velt dev` or the executable again, then the arguments).
 */
export function __processArgv(): string[] {
  return velt_rt_process_node_argv();
}

declare function velt_rt_tla_enter(site: string, depth: i64);
declare function velt_rt_tla_leave(depth: i64);

/**
 * Compiler-internal: a top-level `await` at `site` (`path:line:col`), inside the operands of
 * `depth` others, is about to wait. A program that ends there writes Node's warning and exits
 * with code 13.
 */
export function __topLevelAwaitEnter(site: string, depth: i64) {
  velt_rt_tla_enter(site, depth);
}

/** Compiler-internal: the top-level `await` entered at `depth` has its value. */
export function __topLevelAwaitLeave(depth: i64) {
  velt_rt_tla_leave(depth);
}
