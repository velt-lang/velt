extend Array<string> {
  /**
   * Sorts an array in place. Unlike JS, it returns nothing.
   * @param cmp - Function used to determine the order of the elements. It is expected to return
   * a negative value if the first argument is less than the second argument, zero if they're
   * equal, and a positive value otherwise; the sort is then stable. If omitted, the strings are
   * sorted in ascending UTF-16 code unit order, as in JS (not locale-aware; pass
   * `(a, b) => a.localeCompare(b)` for that).
   * @example
   * names.sort((a, b) => a.localeCompare(b));
   */
  sort(cmp: ((x: string, y: string) => number) | null = null) {
    if (cmp != null) {
      stableSort(this, cmp, (c) => c < 0.0);
      return;
    }
    pdqsort(this, (a, b) => a < b);
  }

  /** A sorted copy (ES2023); the receiver is unchanged. */
  toSorted(cmp: ((x: string, y: string) => number) | null = null): string[] {
    const out = this.slice();
    out.sort(cmp);
    return out;
  }
}

extend<T> Array<T> {
  /** Stable sort by `cmp` (JS `sort(compareFn)`; there is no default order for arbitrary `T`). */
  sort(cmp: (x: T, y: T) => number) {
    stableSort(this, cmp, (c) => c < 0.0);
  }

  /** A copy sorted by `cmp` (ES2023); the receiver is unchanged. */
  toSorted(cmp: (x: T, y: T) => number): T[] {
    const out = this.slice();
    out.sort(cmp);
    return out;
  }

  /**
   * `sort(cmp)` of an `any[]`, as the compiler calls it: reading an `any` may run a proxy's trap,
   * so `cmp` may throw. The sort moves elements through a scratch buffer and can't stop halfway:
   * the first error ends the comparing, and as in Node the array stays as it was.
   */
  sortDynamic<E>(cmp: (x: T, y: T) => number throws E) throws E {
    const before = this.slice();
    const caught: E[] = [];
    this.sort((a, b) => {
      if (caught.length > 0) {
        return 0;
      }
      try {
        return cmp(a, b);
      } catch (e) {
        caught.push(e);
        return 0;
      }
    });
    if (caught.length > 0) {
      for (let i = 0; i < before.length; i++) {
        this[i] = before[i];
      }
      throw caught[0];
    }
  }

  /**
   * `sort(cmp)` of an `any[]` whose comparator returns an `any`, as the compiler calls it: each
   * result converted to a number as Node converts it (`true` is 1, `"-1"` is -1, `NaN` is 0).
   */
  sortAnyResult<E>(cmp: (x: T, y: T) => any throws E) throws E {
    this.sortDynamic((a, b) => compareResult(cmp(a, b)));
  }

  /** `toSorted(cmp)` of an `any[]` whose comparator returns an `any`, as [`sortAnyResult`]. */
  toSortedAnyResult<E>(cmp: (x: T, y: T) => any throws E): T[] throws E {
    const out = this.slice();
    out.sortAnyResult(cmp);
    return out;
  }

  /** `toSorted(cmp)` of an `any[]`, as [`sortDynamic`]. */
  toSortedDynamic<E>(cmp: (x: T, y: T) => number throws E): T[] throws E {
    const out = this.slice();
    out.sortDynamic(cmp);
    return out;
  }
}

// ───────────────────────── elements that may be `undefined` ─────────────────────────

extend<T> Array<T | undefined> {
  /**
   * Stable sort by `cmp`, as in JS: an `undefined` element is never passed to `cmp`, and all
   * of them end up after the other elements.
   */
  sort(cmp: (x: T | undefined, y: T | undefined) => number) {
    stableSort(
      this,
      (x, y) =>
        (x === undefined ? (y === undefined ? 0.0 : 1.0) : y === undefined ? -1.0 : cmp(x, y)),
      (c) => c < 0.0,
    );
  }

  /** A copy sorted by `cmp` (ES2023), `undefined` elements last; the receiver is unchanged. */
  toSorted(cmp: (x: T | undefined, y: T | undefined) => number): (T | undefined)[] {
    const out = this.slice();
    out.sort(cmp);
    return out;
  }
}

/** A comparator's result as a number, as Node's sort takes it: `ToNumber`, with `NaN` as 0. */
function compareResult(r: any): number {
  const n = +r;
  return n === n ? n : 0;
}
