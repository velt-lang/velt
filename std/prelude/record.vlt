// Prelude: `Record<K, V>` (docs/internals/design/record.md), a dictionary keyed by strings, a
// union of string literal types or a string enum, and the TypeScript `Object` helpers over it.
//
// A record has no members of its own: `r.name` reads the key "name". Sema turns `r[k]`, `r.name`,
// `r[k] = v`, `delete r[k]` and object literals typed as a record into calls of the `__`
// methods below (`__get` for string keys, `__at` for literal keys, which are always present).
// Entries keep insertion order; JSON reads and writes a record as an object, and `console.log`
// shows it like one.

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

/**
 * A dictionary from keys of type `K` to values of type `V`, like TypeScript's `Record<K, V>`:
 * `K` is `string`, a union of string literal types or a string enum. `r.name` and `r[k]` read
 * a key, `r[k] = v` sets it, `delete r[k]` removes it; entries keep insertion order.
 */
export class Record<K, V> {
  // Field 0: the JSON and formatting glue read it directly.
  private entries: Map<K, V> = new Map();

  __get(key: K): V | null {
    return this.entries.get(key);
  }

  /** A literal-key record holds every key (sema checks literals; JSON checks documents). */
  __at(key: K): V {
    return this.entries.get(key).unwrap();
  }

  __set(key: K, value: V) {
    this.entries.set(key, value);
  }

  __delete(key: K): bool {
    return this.entries.delete(key);
  }

  __has(key: K): bool {
    return this.entries.has(key);
  }

  /** `{ ...other }`: every entry of `other`, later entries replacing earlier ones. */
  __extend(other: Record<K, V>) {
    for (const [k, v] of other.entries.entries()) {
      this.entries.set(k, v);
    }
  }

  __size(): usize {
    return this.entries.size;
  }

  /**
   * `Object.keys(r)`: TypeScript lists an object's keys as strings, so a string enum key is
   * listed as its value.
   */
  __keyNames(): string[] {
    const out: string[] = [];
    for (const k of this.entries.keys()) {
      out.push(`${k}`);
    }
    return out;
  }

  __values(): V[] {
    return this.entries.values();
  }

  __entries(): [K, V][] {
    return this.entries.entries();
  }
}

/**
 * TypeScript's `Object.keys` / `Object.values` / `Object.entries`, for records (insertion order).
 * Sema checks calls of them itself: `Object.keys` also lists the fields of any object
 * (crates/velt_sema/src/body/expr/object_keys.rs).
 */
export class Object {
  /**
   * Returns the keys of a record as strings (a string enum key as its value), in insertion order.
   * On other objects it lists their fields.
   * @param r - The record whose keys to list.
   */
  static keys<K, V>(r: Record<K, V>): string[] {
    return r.__keyNames();
  }

  /**
   * Returns an array of the values of a record, in insertion order.
   * @param r - The record whose values to list.
   */
  static values<K, V>(r: Record<K, V>): V[] {
    return r.__values();
  }

  /**
   * Returns an array of the `[key, value]` pairs of a record, in insertion order.
   * @param r - The record whose entries to list.
   */
  static entries<K, V>(r: Record<K, V>): [K, V][] {
    return r.__entries();
  }
}
