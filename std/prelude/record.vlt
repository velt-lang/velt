// Prelude: `Record<K, V>` (docs/internals/design/record.md), a dictionary keyed by strings, a
// union of string literal types or a string enum, and the TypeScript `Object` helpers over it.
//
// A record has no members of its own: `r.name` reads the key "name". Sema turns `r[k]`, `r.name`,
// `r[k] = v`, `delete r[k]` and object literals typed as a record into calls of the `__`
// methods below (`__get` for string keys, `__at` for literal keys, which are always present).
// Entries keep JavaScript's order: keys that are array indices (canonical `"0"` to
// `"4294967294"`) first, ascending, then the others in insertion order. A key that is an array
// index marks the record `unordered`; then the readers (`__keyNames`, `__values`, `__entries`,
// and the JSON and formatting glue through `__positions`) sort the entries they read, without
// changing the record (they borrow it). A record without such keys pays one byte test per new
// key (`Map.__newestKeyDigit`, then `arrayIndex` for a key that starts with a digit). JSON reads
// and writes a record as an object (a decoded record is checked for such keys once,
// `__decoded`), and `console.log` shows it like one.

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

// The rank of a key that is not an array index: after every index.
const NOT_INDEX: i64 = 4294967296;

// The array index `s` names (canonical decimal, 0 to 2^32 - 2), or -1.
function arrayIndex(s: string): i64 {
  const n = s.length as i64;
  if (n == 0 || n > 10 || (n > 1 && s.charCodeAt(0) == 48)) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: i64 = 0; i < n; i++) {
    const c = s.charCodeAt(i);
    if (c < 48 || c > 57) {
      return -1;
    }
    v = v * 10 + (c - 48);
  }
  return v <= 4294967294 ? v : -1;
}

/**
 * A dictionary from keys of type `K` to values of type `V`, like TypeScript's `Record<K, V>`:
 * `K` is `string`, a union of string literal types or a string enum. `r.name` and `r[k]` read
 * a key, `r[k] = v` sets it, `delete r[k]` removes it; entries keep JavaScript's order
 * (array-index keys first, ascending, then insertion order).
 */
export class Record<K, V> {
  // Field 0: the JSON and formatting glue read it directly, in the order `__positions` gives.
  private entries: Map<K, V> = new Map();
  // Field 1: a key that is an array index was added (or decoded), so the entries may not be in
  // JavaScript's order (`__perm`).
  private unordered: bool = false;
  // Field 2: the symbol-keyed entries, a table of their own as in Node, made when the first
  // symbol key is written (`null` until then: the string-key methods never read it).
  private symbols: Map<symbol, V> | null = null;
  // Field 3: the accessors `Object.defineProperty` defined (`__defineAccessor`), by key. They
  // are not enumerable, so `Object.keys`, `JSON.stringify`, spreads and `console.log` skip
  // them, as in Node. Only a program that defines accessors reads this field: sema calls the
  // `Keyed` methods there for every key (`hir::Program::record_accessors`).
  private accessors: Map<K | symbol, __RecordAccessor<V>> | null = null;

  /** The accessor `key` names, if `Object.defineProperty` defined one. */
  __accessor(key: K | symbol): __RecordAccessor<V> | undefined {
    const t = this.accessors;
    if (t == null) {
      return undefined;
    }
    return t.get(key);
  }

  /**
   * `Object.defineProperty(r, key, { get, set, configurable })`: the accessor replaces an entry
   * with the key. Defining again a property that is not configurable is Node's `TypeError`.
   */
  __defineAccessor(
    key: K | symbol,
    get: (() => V) | null,
    set: ((value: V) => void) | null,
    configurable: bool,
  ) {
    const old = this.__accessor(key);
    if (old != null && !old.configurable) {
      panic(`TypeError: Cannot redefine property: ${__recordKeyText(key)}`);
    }
    this.__deleteKeyed(key);
    const a = new __RecordAccessor<V>(get, set, configurable);
    const t = this.accessors;
    if (t == null) {
      const made: Map<K | symbol, __RecordAccessor<V>> = new Map();
      made.set(key, a);
      this.accessors = made;
    } else {
      t.set(key, a);
    }
  }

  /** `r[s]` with a symbol `s`: its entry in the symbol table. */
  __getSym(key: symbol): V | undefined {
    const t = this.symbols;
    if (t == null) {
      return undefined;
    }
    return t.get(key);
  }

  /** `r[s] = v` with a symbol `s`: the symbol table is made by the first write. */
  __setSym(key: symbol, value: V) {
    const t = this.symbols;
    if (t == null) {
      const made: Map<symbol, V> = new Map();
      made.set(key, value);
      this.symbols = made;
    } else {
      t.set(key, value);
    }
  }

  /** `delete r[s]` with a symbol `s`. */
  __deleteSym(key: symbol): bool {
    const t = this.symbols;
    return t != null && t.delete(key);
  }

  /** `s in r` / `Object.hasOwn(r, s)` with a symbol `s`. */
  __hasSym(key: symbol): bool {
    const t = this.symbols;
    return t != null && t.has(key);
  }

  /** `r[k]` with a `string | symbol` key. */
  __getKeyed(key: K | symbol): V | undefined {
    if (this.accessors != null) {
      const a = this.__accessor(key);
      if (a != null) {
        return a.read();
      }
    }
    if (typeof key === "symbol") {
      return this.__getSym(key as symbol);
    }
    return this.entries.get(key as K);
  }

  /** `r[k] = v` with a `string | symbol` key. */
  __setKeyed(key: K | symbol, value: V) {
    if (this.accessors != null) {
      const a = this.__accessor(key);
      if (a != null) {
        a.write(key, value);
        return;
      }
    }
    if (typeof key === "symbol") {
      this.__setSym(key as symbol, value);
    } else {
      this.__set(key as K, value);
    }
  }

  /** `delete r[k]` with a `string | symbol` key. */
  __deleteKeyed(key: K | symbol): bool {
    const t = this.accessors;
    if (t != null) {
      const a = t.get(key);
      if (a != null) {
        // A property that is not configurable stays: `delete` is Node's `TypeError` (strict
        // code).
        if (!a.configurable) {
          panic(`TypeError: Cannot delete property '${__recordKeyText(key)}' of #<Object>`);
        }
        return t.delete(key);
      }
    }
    if (typeof key === "symbol") {
      return this.__deleteSym(key as symbol);
    }
    return this.entries.delete(key as K);
  }

  /** `k in r` / `Object.hasOwn(r, k)` with a `string | symbol` key (own entries only). */
  __hasKeyed(key: K | symbol): bool {
    if (this.accessors != null && this.__accessor(key) != null) {
      return true;
    }
    if (typeof key === "symbol") {
      return this.__hasSym(key as symbol);
    }
    return this.entries.has(key as K);
  }

  /** `Object.getOwnPropertySymbols(r)`: the symbol keys, in insertion order. */
  __symbolKeys(): symbol[] {
    const t = this.symbols;
    if (t == null) {
      return [];
    }
    return t.keys();
  }

  /** `Object.getOwnPropertySymbols(r)`: the symbol keys, accessors' too. */
  __ownSymbols(): symbol[] {
    const out = this.__symbolKeys();
    const t = this.accessors;
    if (t != null) {
      for (const k of t.keys()) {
        if (typeof k === "symbol") {
          out.push(k as symbol);
        }
      }
    }
    return out;
  }

  /**
   * `Reflect.ownKeys(r)`: the string keys in `Object.keys` order (array indices first,
   * ascending, then insertion order), then the symbol keys in insertion order.
   */
  __ownKeys(): (string | symbol)[] {
    const out: (string | symbol)[] = [];
    for (const k of this.__keyNames()) {
      out.push(k);
    }
    const t = this.accessors;
    if (t != null) {
      for (const k of t.keys()) {
        if (typeof k !== "symbol") {
          out.push(`${k as K}`);
        }
      }
    }
    for (const s of this.__symbolKeys()) {
      out.push(s);
    }
    if (t != null) {
      for (const k of t.keys()) {
        if (typeof k === "symbol") {
          out.push(k as symbol);
        }
      }
    }
    return out;
  }

  /** Does this record hold a symbol key (`console.log` and spreads list the symbol table)? */
  __hasSymbols(): bool {
    const t = this.symbols;
    return t != null && t.size > 0;
  }

  /** The symbol-keyed entries, in insertion order. */
  __symbolEntries(): [symbol, V][] {
    const t = this.symbols;
    if (t == null) {
      return [];
    }
    return t.entries();
  }

  __get(key: K): V | undefined {
    return this.entries.get(key);
  }

  /** A literal-key record holds every key (sema checks literals; JSON checks documents). */
  __at(key: K): V {
    return this.entries.__at(key);
  }

  __set(key: K, value: V) {
    const n = this.entries.size;
    this.entries.set(key, value);
    if (this.entries.size != n && !this.unordered) {
      this.unordered = this.entries.__newestKeyDigit() && arrayIndex(`${key}`) >= 0;
    }
  }

  /** After JSON decoding (in document order): `unordered` when a key is an array index. */
  __decoded() {
    for (const k of this.entries.keys()) {
      if (arrayIndex(`${k}`) >= 0) {
        this.unordered = true;
        return;
      }
    }
  }

  /**
   * The order of the live entries (indexes into `keys()` / `values()`) in JavaScript's order:
   * array indices first, ascending, then the other keys in insertion order (a stable sort).
   * Empty when the entries are in that order already.
   */
  __perm(): usize[] {
    if (!this.unordered) {
      return [];
    }
    const keys = this.entries.keys();
    const rank: i64[] = [];
    let sorted = true;
    let last: i64 = -1;
    let other = false;
    for (const k of keys) {
      const i = arrayIndex(`${k}`);
      if (i < 0) {
        other = true;
        rank.push(NOT_INDEX);
      } else {
        sorted = sorted && !other && i > last;
        last = i;
        rank.push(i);
      }
    }
    if (sorted) {
      return [];
    }
    const at: usize[] = [];
    for (let i: usize = 0; i < keys.length; i++) {
      at.push(i);
    }
    at.sort((a, b) => rank[a] - rank[b]);
    return at;
  }

  /**
   * The positions of the map's live entries in JavaScript's order (the JSON and formatting
   * glue walk them), or empty when that is insertion order.
   */
  __positions(): usize[] {
    const at = this.__perm();
    if (at.length == 0) {
      return at;
    }
    const live = this.entries.__livePositions();
    const out: usize[] = [];
    for (const i of at) {
      out.push(live[i]);
    }
    return out;
  }

  __delete(key: K): bool {
    return this.entries.delete(key);
  }

  __has(key: K): bool {
    return this.entries.has(key);
  }

  /**
   * `key in r` through `any`: the entry `key`, or a member every object inherits from
   * `Object.prototype` (none for a record made by `Object.create(null)`).
   */
  __inAny(key: K): bool {
    return this.__has(key) || (!this.__isNullProto() && __objectPrototypeKey(String(key)));
  }

  /** `{ ...other }`: every entry of `other`, later entries replacing earlier ones. */
  __extend(other: Record<K, V>) {
    for (const [k, v] of other.__entries()) {
      this.__set(k, v);
    }
    // A spread copies the symbol keys too, as in Node.
    if (other.symbols != null) {
      for (const [s, v] of other.__symbolEntries()) {
        this.__setSym(s, v);
      }
    }
  }

  /** `{ ...other }` of a record that may be `null` or `undefined`: nothing when it is. */
  __extendMaybe(other: Record<K, V> | null | undefined) {
    if (other != null) {
      this.__extend(other);
    }
  }

  /** `{ ...other }` of a record of another key or value type (`Record<string, string>` or
   *  `Record<"a" | "b", string>` into a `Record<string, any>`): each key converted by `key`,
   *  each value by `convert`; nothing when it is nothing. */
  __extendFrom<J, W>(
    other: Record<J, W> | null | undefined,
    key: (key: J) => K,
    convert: (value: W) => V,
  ) {
    if (other != null) {
      for (const [k, v] of other.__entries()) {
        this.__set(key(k), convert(v));
      }
      for (const [s, v] of other.__symbolEntries()) {
        this.__setSym(s, convert(v));
      }
    }
  }

  __size(): usize {
    return this.entries.size;
  }

  /** `Object.create(null)`: this record has no prototype (marked in its map). */
  __markNullProto() {
    this.entries.__markNullProto();
  }

  /** Was this record made by `Object.create(null)`? */
  __isNullProto(): bool {
    return this.entries.__isNullProto();
  }

  /**
   * `Object.keys(r)`: TypeScript lists an object's keys as strings, so a string enum key is
   * listed as its value.
   */
  __keyNames(): string[] {
    const out: string[] = [];
    const keys = this.entries.keys();
    const at = this.__perm();
    if (at.length == 0) {
      for (const k of keys) {
        out.push(`${k}`);
      }
    } else {
      for (const i of at) {
        out.push(`${keys[i]}`);
      }
    }
    return out;
  }

  __values(): V[] {
    const values = this.entries.values();
    const at = this.__perm();
    if (at.length == 0) {
      return values;
    }
    const out: V[] = [];
    for (const i of at) {
      out.push(values[i]);
    }
    return out;
  }

  __entries(): [K, V][] {
    const entries = this.entries.entries();
    const at = this.__perm();
    if (at.length == 0) {
      return entries;
    }
    const out: [K, V][] = [];
    for (const i of at) {
      out.push(entries[i]);
    }
    return out;
  }
}

/** An accessor property of a record (`Object.defineProperty` with `get` / `set`). */
export class __RecordAccessor<V> {
  getter: (() => V) | null;
  setter: ((value: V) => void) | null;
  configurable: bool;

  constructor(getter: (() => V) | null, setter: ((value: V) => void) | null, configurable: bool) {
    this.getter = getter;
    this.setter = setter;
    this.configurable = configurable;
  }

  /** A read: the getter's value, `undefined` without one. */
  read(): V | undefined {
    const g = this.getter;
    if (g == null) {
      return undefined;
    }
    return g();
  }

  /** A write: the setter, or Node's `TypeError` (strict code) without one. */
  write<K>(key: K, value: V) {
    const s = this.setter;
    if (s == null) {
      panic(
        `TypeError: Cannot set property ${__recordKeyText(key)} of #<Object> which has only a getter`,
      );
    }
    s(value);
  }
}

/** A record key as Node's messages show it: a string as it is, a symbol as `Symbol(d)`. */
function __recordKeyText<K>(key: K): string {
  return String(key);
}

/**
 * TypeScript's `Object.keys` / `Object.values` / `Object.entries`, for records (JavaScript's
 * order: array-index keys first, ascending, then insertion order).
 * Sema checks calls of them itself: `Object.keys` also lists the fields of any object
 * (crates/velt_sema/src/body/expr/object_keys.rs).
 */
export class Object {
  /**
   * Returns the keys of a record as strings (a string enum key as its value): array-index keys
   * first, ascending, then the others in insertion order.
   * On other objects it lists their fields.
   * @param r - The record whose keys to list.
   */
  static keys<K, V>(r: Record<K, V>): string[] {
    return r.__keyNames();
  }

  /**
   * Returns an array of the values of a record, in key order (as `keys`). An object literal works
   * too, read as a `Record<string, V>`: `Object.values({ x: 1, y: 2 })` is `[1, 2]`.
   * @param r - The record whose values to list.
   */
  static values<K, V>(r: Record<K, V>): V[] {
    return r.__values();
  }

  /**
   * Returns an array of the `[key, value]` pairs of a record, in key order (as `keys`). An object
   * literal works too, read as a `Record<string, V>`.
   * @param r - The record whose entries to list.
   */
  static entries<K, V>(r: Record<K, V>): [K, V][] {
    return r.__entries();
  }

  /**
   * Returns an object made from `[key, value]` pairs, as a `Record<string, V>`: later pairs
   * replace earlier ones with the same key. Sema passes any other iterable (a `Map`, a
   * generator) through `Array.from` first.
   * @param entries - The `[key, value]` pairs.
   */
  static fromEntries<V>(entries: [string, V][]): Record<string, V> {
    const r: Record<string, V> = {};
    for (const [k, v] of entries) {
      r.__set(k, v);
    }
    return r;
  }
}

/**
 * A prototype object, as `Object.getPrototypeOf(v)` returns it and `Object.prototype` or
 * `C.prototype` names it. Velt objects have fixed layouts, so a prototype is compared (`===`
 * compares the prototypes they name: sema calls `__prototypeSame`), printed and converted to a
 * string or JSON as Node does, and nothing else. Sema writes each one's texts.
 */
export class ObjectPrototype {
  // Which prototype this is (`"Object"`, `"Map"`, `"class#12"`).
  private tag: string;
  // What `console.log` shows.
  private shown: string;
  // What `String(p)` gives.
  private text: string;
  // Whether `JSON.stringify` writes `[]` (`Array.prototype`) rather than `{}`.
  private array: bool;

  /**
   * A prototype (sema calls this for `Object.prototype`, `C.prototype` and
   * `Object.getPrototypeOf`).
   * @param tag - Which prototype it is.
   * @param shown - What `console.log` shows.
   * @param text - What `String(p)` gives.
   * @param array - Whether `JSON.stringify` writes `[]` rather than `{}`.
   */
  constructor(tag: string, shown: string, text: string, array: bool) {
    this.tag = tag;
    this.shown = shown;
    this.text = text;
    this.array = array;
  }

  __sameAs(other: ObjectPrototype): bool {
    return this.tag == other.tag;
  }

  /**
   * `k in p` for a key known only at run time: `Object.prototype`'s members; the members of
   * other prototypes are not listed yet.
   */
  __hasKey(key: string): bool {
    if (this.tag != "Object") {
      panic(
        "TypeError: `in` with a key known only at run time on this prototype is not supported yet (#924)",
      );
    }
    return __objectPrototypeKey(key);
  }

  __inspect(): string {
    return this.shown;
  }

  /** Returns what `String(p)` gives for this prototype in JavaScript (`"[object Object]"`). */
  toString(): string {
    return this.text;
  }

  /** Returns what `JSON.stringify` writes for this prototype: `[]` or `{}`. */
  toJSON(): string[] | Record<string, string> {
    if (this.array) {
      return [];
    }
    return {};
  }
}

/** `a === b` on prototypes (or `null`, a prototype-less object's). */
export function __prototypeSame(a: ObjectPrototype | null, b: ObjectPrototype | null): bool {
  if (a == null) {
    return b == null;
  }
  if (b == null) {
    return false;
  }
  return a.__sameAs(b);
}

/** `key in p` of a prototype `p` for a key known only at run time. */
export function __prototypeIn(key: string, p: ObjectPrototype): bool {
  return p.__hasKey(key);
}

/**
 * `k in r` for a key known only at run time: whether `key` names a member every object inherits
 * from `Object.prototype` (sema tests the record's own entries first).
 */
export function __objectPrototypeKey(key: string): bool {
  switch (key) {
    case "__defineGetter__":
    case "__defineSetter__":
    case "__lookupGetter__":
    case "__lookupSetter__":
    case "__proto__":
    case "constructor":
    case "hasOwnProperty":
    case "isPrototypeOf":
    case "propertyIsEnumerable":
    case "toLocaleString":
    case "toString":
    case "valueOf":
      return true;
    default:
      return false;
  }
}

/**
 * `k in r` with a `string | symbol` key (sema calls this): the record's own entry, or for a
 * string a member every object inherits from `Object.prototype`.
 */
export function __recordInKeyed<V>(key: string | symbol, r: Record<string, V>): bool {
  if (r.__hasKeyed(key)) {
    return true;
  }
  return typeof key === "string" && !r.__isNullProto() && __objectPrototypeKey(key);
}

/**
 * `k in r` for a key known only at run time (sema calls this): whether the record has the entry
 * `key`, or `key` names a member every object inherits from `Object.prototype`.
 */
export function __recordIn<V>(key: string, r: Record<string, V>): bool {
  return r.__has(key) || __objectPrototypeKey(key);
}

/**
 * `k in r` in a program that calls `Object.create(null)` (sema calls this instead of
 * `__recordIn` there): a record made by it inherits nothing from `Object.prototype`.
 */
export function __recordInMaybeNullProto<V>(key: string, r: Record<string, V>): bool {
  return r.__has(key) || (!r.__isNullProto() && __objectPrototypeKey(key));
}

/**
 * `{ [key]: value }` with a key known only at run time: the parser writes the property as a
 * spread of this call (a one-entry record). Where a `Record` is built, sema sets the entry
 * directly instead.
 */
export function __computed_key<V>(key: string, value: V): Record<string, V> {
  const r: Record<string, V> = {};
  r[key] = value;
  return r;
}

/** The array index `s` names (canonical decimal, 0 to 2^32 - 2), or -1. */
export function __arrayIndex(s: string): i64 {
  return arrayIndex(s);
}
