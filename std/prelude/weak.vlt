// Prelude: `WeakMap<K, V>` (`WeakSet<T>` and `WeakRef<T>` are in weak_set.vlt and weak_ref.vlt)
// (docs/std/prelude.md#weakmap-weakset-and-weakref), on velt_rt's weak-reference core
// (docs/internals/design/weak-refs.md, rt_abi.md "Weak references").
//
// A key (a `WeakSet` member, a `WeakRef` target) must be an object: a class instance, an object
// type or an array (sema checks it). The compiler counts its type and makes it, and every type
// reachable from a weak map's key and value types, weak-capable: their release tells a weakly
// held object apart and removes it from every map and `WeakRef` as it is freed. A map whose
// value refers back to its key (`raw -> proxy(raw)`) frees both once nothing else refers to
// either (the ephemeron rule).
//
// A map is created in the runtime on its first `set` (`#id` 0 until then): the intrinsic sees
// the key and value types there and passes their glue. Maps and refs are bound to the thread
// that made them: sema keeps them out of `spawn`, channels and `shared`.

import {
  weakMapDelete,
  weakMapGet,
  weakMapHas,
  weakMapSet,
  weakMapValue,
} from "velt/lang/intrinsics";

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

declare function velt_rt_weakmap_drop(m: u32);

/**
 * A map from objects to values that does not keep its keys alive: an entry goes away when its
 * key is freed. Keys are compared by identity. Not iterable and without `size`, as in JS.
 */
export class WeakMap<K, V> {
  #id: u32;

  /** An empty map. */
  constructor() {
    this.#id = 0;
  }

  /** The value stored for `key`, or `undefined` if it has none. */
  get(key: K): V | undefined {
    if (this.#id == 0) {
      return undefined;
    }
    const w = weakMapGet(this.#id, key);
    if (w == 0 && !weakMapHas(this.#id, key)) {
      return undefined;
    }
    return weakMapValue<V>(w);
  }

  /** Stores `value` for `key` (replacing a value stored before). */
  set(key: K, value: V): WeakMap<K, V> {
    this.#id = weakMapSet(this.#id, key, value);
    return this;
  }

  /** Whether `key` has an entry. */
  has(key: K): bool {
    return this.#id != 0 && weakMapHas(this.#id, key);
  }

  /** Removes `key`'s entry: true if there was one. */
  delete(key: K): bool {
    return this.#id != 0 && weakMapDelete(this.#id, key);
  }

  /** Drop hook: releases every value. */
  [Symbol.dispose]() {
    if (this.#id != 0) {
      velt_rt_weakmap_drop(this.#id);
      this.#id = 0;
    }
  }
}
