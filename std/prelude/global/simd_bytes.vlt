declare function velt_simd_i16x8_shl(v: i16x8, count: u32): i16x8;
declare function velt_simd_i16x8_shr(v: i16x8, count: u32): i16x8;
declare function velt_simd_i16x8_eq(a: i16x8, b: i16x8): mask16x8;
declare function velt_simd_i16x8_ne(a: i16x8, b: i16x8): mask16x8;
declare function velt_simd_i16x8_lt(a: i16x8, b: i16x8): mask16x8;
declare function velt_simd_i16x8_le(a: i16x8, b: i16x8): mask16x8;
declare function velt_simd_i16x8_gt(a: i16x8, b: i16x8): mask16x8;
declare function velt_simd_i16x8_ge(a: i16x8, b: i16x8): mask16x8;
declare function velt_simd_i16x8_zip_low(a: i16x8, b: i16x8): i16x8;
declare function velt_simd_i16x8_zip_high(a: i16x8, b: i16x8): i16x8;
declare function velt_simd_i16x8_widen_low(v: i16x8): i32x4;
declare function velt_simd_i16x8_widen_high(v: i16x8): i32x4;
declare function velt_simd_i16x8_narrow(a: i16x8, b: i16x8): i8x16;
declare function velt_simd_i16x8_as_u16x8(v: i16x8): u16x8;
declare function velt_simd_i16x8_as_u8x16(v: i16x8): u8x16;

extend i16x8 {
  /** A vector with every lane `x`. */
  static splat(x: i16): i16x8 {
    return velt_simd_i16x8_splat(x);
  }

  /**
   * The 8 elements of `from` starting at `at`. Panics with a RangeError unless all 8 are
   * inside the array.
   */
  static load(from: i16[], at: usize = 0): i16x8 {
    if (!i16x8.fits(from, at)) {
      panic("RangeError: i16x8.load: range is out of bounds");
    }
    return velt_simd_i16x8_load(from, at as u64);
  }

  /**
   * Whether the 8 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (i16x8.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: i16[], at: usize = 0): bool {
    return velt_simd_i16x8_fits(xs, at as u64);
  }

  /** Lane by lane, `a` where the mask is set and `b` elsewhere. */
  static select(m: mask16x8, a: i16x8, b: i16x8): i16x8 {
    return velt_simd_i16x8_select(m, a, b);
  }

  /**
   * Writes the 8 lanes to `to` starting at `at`. Panics with a RangeError unless all 8
   * elements are inside the array (it does not grow).
   */
  store(to: i16[], at: usize = 0) {
    if (!i16x8.fits(to, at)) {
      panic("RangeError: i16x8.store: range is out of bounds");
    }
    velt_simd_i16x8_store(this, to, at as u64);
  }

  /** Lane `index` (0 to 7; panics with a RangeError otherwise). */
  lane(index: usize): i16 {
    if (index >= 8) {
      panic("RangeError: i16x8.lane: index is out of range");
    }
    return velt_simd_i16x8_lane(this, index as u64);
  }

  /** This vector with lane `index` (0 to 7; panics with a RangeError otherwise) set to `x`. */
  withLane(index: usize, x: i16): i16x8 {
    if (index >= 8) {
      panic("RangeError: i16x8.withLane: index is out of range");
    }
    return velt_simd_i16x8_with_lane(this, index as u64, x);
  }

  /** Lane-wise sum, wrapping on overflow. */
  add(other: i16x8): i16x8 {
    return velt_simd_i16x8_add(this, other);
  }

  /** Lane-wise difference, wrapping on overflow. */
  sub(other: i16x8): i16x8 {
    return velt_simd_i16x8_sub(this, other);
  }

  /** Lane-wise product, wrapping on overflow. */
  mul(other: i16x8): i16x8 {
    return velt_simd_i16x8_mul(this, other);
  }

  /** The smaller of each pair of lanes. */
  min(other: i16x8): i16x8 {
    return velt_simd_i16x8_min(this, other);
  }

  /** The larger of each pair of lanes. */
  max(other: i16x8): i16x8 {
    return velt_simd_i16x8_max(this, other);
  }

  /** Lane-wise sum, clamped to the lane type's range instead of wrapping. */
  addSat(other: i16x8): i16x8 {
    return velt_simd_i16x8_add_sat(this, other);
  }

  /** Lane-wise difference, clamped to the lane type's range instead of wrapping. */
  subSat(other: i16x8): i16x8 {
    return velt_simd_i16x8_sub_sat(this, other);
  }

  /** Bitwise AND. */
  and(other: i16x8): i16x8 {
    return velt_simd_i16x8_and(this, other);
  }

  /** Bitwise OR. */
  or(other: i16x8): i16x8 {
    return velt_simd_i16x8_or(this, other);
  }

  /** Bitwise XOR. */
  xor(other: i16x8): i16x8 {
    return velt_simd_i16x8_xor(this, other);
  }

  /** Each lane negated (wrapping). */
  neg(): i16x8 {
    return velt_simd_i16x8_neg(this);
  }

  /** The absolute value of each lane (the smallest value stays itself). */
  abs(): i16x8 {
    return velt_simd_i16x8_abs(this);
  }

  /** Every bit flipped. */
  not(): i16x8 {
    return velt_simd_i16x8_not(this);
  }

  /** Each lane shifted left by `count` bits (taken modulo 16). */
  shl(count: u32): i16x8 {
    return velt_simd_i16x8_shl(this, count);
  }

  /** Each lane shifted right by `count` bits (taken modulo 16), keeping the sign. */
  shr(count: u32): i16x8 {
    return velt_simd_i16x8_shr(this, count);
  }

  /** The lanes where this vector equals `other`. */
  eq(other: i16x8): mask16x8 {
    return velt_simd_i16x8_eq(this, other);
  }

  /** The lanes where this vector differs from `other`. */
  ne(other: i16x8): mask16x8 {
    return velt_simd_i16x8_ne(this, other);
  }

  /** The lanes where this vector is less than `other`. */
  lt(other: i16x8): mask16x8 {
    return velt_simd_i16x8_lt(this, other);
  }

  /** The lanes where this vector is at most `other`. */
  le(other: i16x8): mask16x8 {
    return velt_simd_i16x8_le(this, other);
  }

  /** The lanes where this vector is greater than `other`. */
  gt(other: i16x8): mask16x8 {
    return velt_simd_i16x8_gt(this, other);
  }

  /** The lanes where this vector is at least `other`. */
  ge(other: i16x8): mask16x8 {
    return velt_simd_i16x8_ge(this, other);
  }

  /** The lanes of the low halves of this vector and `other` in turn: a0, b0, a1, b1, … */
  zipLow(other: i16x8): i16x8 {
    return velt_simd_i16x8_zip_low(this, other);
  }

  /** The lanes of the high halves of this vector and `other` in turn. */
  zipHigh(other: i16x8): i16x8 {
    return velt_simd_i16x8_zip_high(this, other);
  }

  /** The low 4 lanes, each as a `i32`. */
  widenLow(): i32x4 {
    return velt_simd_i16x8_widen_low(this);
  }

  /** The high 4 lanes, each as a `i32`. */
  widenHigh(): i32x4 {
    return velt_simd_i16x8_widen_high(this);
  }

  /**
   * The lanes of this vector, then of `other`, each as a `i8`, clamped to its range
   * instead of wrapping.
   */
  narrow(other: i16x8): i8x16 {
    return velt_simd_i16x8_narrow(this, other);
  }

  /** The same 128 bits as a `u16x8` (no conversion of values). */
  asU16x8(): u16x8 {
    return velt_simd_i16x8_as_u16x8(this);
  }

  /** The same 128 bits as a `u8x16` (no conversion of values). */
  asU8x16(): u8x16 {
    return velt_simd_i16x8_as_u8x16(this);
  }
}

