declare function velt_simd_u16x8_as_i16x8(v: u16x8): i16x8;
declare function velt_simd_u16x8_as_u8x16(v: u16x8): u8x16;

extend u16x8 {
  /** A vector with every lane `x`. */
  static splat(x: u16): u16x8 {
    return velt_simd_u16x8_splat(x);
  }

  /**
   * The 8 elements of `from` starting at `at`. Panics with a RangeError unless all 8 are
   * inside the array.
   */
  static load(from: u16[], at: usize = 0): u16x8 {
    if (!u16x8.fits(from, at)) {
      panic("RangeError: u16x8.load: range is out of bounds");
    }
    return velt_simd_u16x8_load(from, at as u64);
