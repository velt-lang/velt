  /**
   * Whether the 8 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (u16x8.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: u16[], at: usize = 0): bool {
    return velt_simd_u16x8_fits(xs, at as u64);
  }

  /** Lane by lane, `a` where the mask is set and `b` elsewhere. */
  static select(m: mask16x8, a: u16x8, b: u16x8): u16x8 {
    return velt_simd_u16x8_select(m, a, b);
  }

  /**
   * Writes the 8 lanes to `to` starting at `at`. Panics with a RangeError unless all 8
   * elements are inside the array (it does not grow).
   */
  store(to: u16[], at: usize = 0) {
    if (!u16x8.fits(to, at)) {
      panic("RangeError: u16x8.store: range is out of bounds");
    }
    velt_simd_u16x8_store(this, to, at as u64);
  }

  /** Lane `index` (0 to 7; panics with a RangeError otherwise). */
  lane(index: usize): u16 {
    if (index >= 8) {
      panic("RangeError: u16x8.lane: index is out of range");
    }
    return velt_simd_u16x8_lane(this, index as u64);
  }

  /** This vector with lane `index` (0 to 7; panics with a RangeError otherwise) set to `x`. */
  withLane(index: usize, x: u16): u16x8 {
    if (index >= 8) {
      panic("RangeError: u16x8.withLane: index is out of range");
    }
    return velt_simd_u16x8_with_lane(this, index as u64, x);
  }

  /** Lane-wise sum, wrapping on overflow. */
  add(other: u16x8): u16x8 {
    return velt_simd_u16x8_add(this, other);
  }

  /** Lane-wise difference, wrapping on overflow. */
  sub(other: u16x8): u16x8 {
    return velt_simd_u16x8_sub(this, other);
  }

  /** Lane-wise product, wrapping on overflow. */
  mul(other: u16x8): u16x8 {
    return velt_simd_u16x8_mul(this, other);
  }

  /** The smaller of each pair of lanes. */
  min(other: u16x8): u16x8 {
    return velt_simd_u16x8_min(this, other);
  }

  /** The larger of each pair of lanes. */
  max(other: u16x8): u16x8 {
