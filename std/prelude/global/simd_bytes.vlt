declare function velt_simd_u16x8_zip_high(a: u16x8, b: u16x8): u16x8;
declare function velt_simd_u16x8_widen_low(v: u16x8): u32x4;
declare function velt_simd_u16x8_widen_high(v: u16x8): u32x4;
