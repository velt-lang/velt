  /** The low 4 lanes, each as a `u32`. */
  widenLow(): u32x4 {
    return velt_simd_u16x8_widen_low(this);
  }

  /** The high 4 lanes, each as a `u32`. */
  widenHigh(): u32x4 {
    return velt_simd_u16x8_widen_high(this);
  }

  /**
   * The lanes of this vector, then of `other`, each as a `u8`, clamped to its range
