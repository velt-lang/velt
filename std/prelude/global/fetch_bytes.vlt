// Global, conditional (crates/veltc/src/loader/globals.rs): `bytes()` and `arrayBuffer()` of
// `Response` and `Request` (velt/net/http/fetch/typed), with the typed arrays they give, for a program
// that uses `Response` and reads bytes; other fetch and http programs don't load typed arrays.
// load when std/net/http/fetch/response uses: bytes arrayBuffer
import "velt/net/http/fetch/typed";
