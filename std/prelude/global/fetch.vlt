// Global (loaded when a module names one of these): Node's `fetch` API, the types its signatures
// use (TypeScript's DOM lib has them as globals too), and the cancellation it takes
// (https://veltlang.com/docs/std/net/http/, https://veltlang.com/docs/std/task/).
export {
  fetch,
  Headers,
  Request,
  Response,
  RequestInit,
  ResponseInit,
  HeadersInit,
  BodyInit,
  RequestRedirect,
} from "velt/net/http/fetch/fetch";
export { AbortController, AbortSignal } from "velt/task";
