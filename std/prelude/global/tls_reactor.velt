// Global, conditional (crates/velt_loader/src/globals): the TLS server in Velt on the reactor
// (std/net/tls/fd_server.velt) for a program whose TCP functions are std/net/tcp_sched.velt (every
// native program's) that names `listenTls`, or `cert`, the field every `listenTls` option has
// (http-server's `serve({ tls })`). Options filled elsewhere (a config file's JSON) reach
// `listenTls` only through a call that names it. Other programs don't load the server: they have
// no `listenTls` to serve (std/net/tls/fd_hook.velt's stubs).
// load when std/net/tcp_sched uses: cert listenTls
import "velt/net/tls/fd_server";
