// Global (loaded when a module names one of these): `JSON`, `JsonValue` and their types
// (https://veltlang.com/docs/std/encoding/json/). They sit on the JSON engine in Velt (the reader, the scanner, the writer
// and the number code they use), which a program that never names them should not read. With them
// comes the compiler's hook for `JSON.parse(text) as T` (std/lang/hooks/json.velt).
export { JSON } from "velt/prelude/json/json";
export { JsonError, JsonParseOptions } from "velt/prelude/json/json_error";
export { JsonReplacer } from "velt/prelude/json/layout";
export { JsonValue } from "velt/prelude/json/json_value";
import "velt/lang/hooks/json";
