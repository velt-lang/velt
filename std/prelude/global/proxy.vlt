// Global (loaded when a module names one of these): JavaScript's `Proxy` and `Reflect`
// (docs/reference/types.md "Proxy and Reflect"). With them comes velt/lang/hooks/proxy: the
// operations on `any` that sema calls instead of the hooks of velt/lang/hooks/any_object once a
// program has loaded `Proxy`, so a program that never names it neither checks nor runs a test
// for a proxy.
export { PropertyDescriptor, Proxy, ProxyHandler, Reflect } from "velt/lang/proxy";
import "velt/lang/hooks/proxy";
