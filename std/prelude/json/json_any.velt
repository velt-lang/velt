// Prelude (with `JSON`): `%j` in a `console.log` format string (#3662) of an `any`, or of a value
// the compiler sends here as one (a nullable, a `Map`, a type that can hold itself), as Node's
// `util.format` writes it: `JSON.stringify(v)`; `undefined` for what that gives `undefined` for;
// `[Circular]` for a value that holds itself (Node's `tryStringify`); and, for a value holding
// one std's JSON cannot write through `any` (a `Set`, a `Map`, a `RegExp`), the text Node writes
// (`{}` for those), from the value's runtime type (velt/lang/intrinsics reflection) instead of a
// panic.

import {
  anyReflectCount,
  anyReflectHook,
  anyReflectInfo,
  anyReflectName,
  anyReflectValue,
  identity,
} from "velt/lang/intrinsics";
import { JSON } from "./json";

/** `%j` of `value`. */
export function jsonAny(value: any): string {
  const t = typeof value;
  if (t === "undefined" || t === "symbol" || t === "function") {
    return "undefined";
  }
  const path: u64[] = [];
  const found = scan(value, "", path, false);
  if (found == CIRCULAR) {
    return "[Circular]";
  }
  if (found == PLAIN) {
    return JSON.stringify(value);
  }
  return write(value, "", false) ?? "undefined";
}

/** What `scan` found: data std's JSON writes through `any`, */
const PLAIN: i64 = 0;
/** a value std's JSON cannot write through `any` (written here), */
const OWN: i64 = 1;
/** or a value that holds itself. */
const CIRCULAR: i64 = 2;

/** The kind and name of what `v` holds (velt/reflect `typeOf`'s first and third fields). */
function kindOf(v: any): string {
  const info = anyReflectInfo(v);
  return info.slice(0, info.indexOf("|") as i64);
}

/** The class name of what `v` holds, without its type arguments. */
function nameOf(v: any): string {
  const parts = anyReflectInfo(v).split("|");
  const name = parts.length > 2 ? parts[2] : "";
  const angle = name.indexOf("<");
  return angle >= 0 ? name.slice(0, angle) : name;
}

/**
 * Is `kind` (with class name `name`) one std's JSON writes through `any`: a primitive, an array,
 * a tuple, a `shared` cell, a record or an object, a class or a struct but the built-ins with no
 * data of their own in JSON (Node writes `{}` for a `RegExp`, a `Promise`, a weak collection)?
 */
function known(kind: string, name: string): boolean {
  if (kind == "class") {
    return name != "RegExp" &&
      name != "Promise" &&
      name != "WeakMap" &&
      name != "WeakSet" &&
      name != "WeakRef";
  }
  return kind == "number" ||
    kind == "string" ||
    kind == "boolean" ||
    kind == "null" ||
    kind == "array" ||
    kind == "tuple" ||
    kind == "struct" ||
    kind == "object" ||
    kind == "record" ||
    kind == "shared" ||
    kind == "enum";
}

/** Is `kind` a container whose entries `scan` and `write` go through? */
function container(kind: string): boolean {
  return kind == "array" ||
    kind == "tuple" ||
    kind == "struct" ||
    kind == "object" ||
    kind == "record" ||
    kind == "shared" ||
    kind == "class";
}

/**
 * `PLAIN`, `OWN` or `CIRCULAR` for `v` under `key`, `path` the identities of the objects it is
 * inside (an object met again on the way is a cycle). A `toJSON()` is called once, as
 * `JSON.stringify` calls it, and its result scanned without calling it again (`hooked`); a
 * value with one is written here (`OWN`), so that it is called once there too.
 */
function scan(v: any, key: string, path: u64[], hooked: bool): i64 {
  const kind = kindOf(v);
  if (kind == "undefined" || kind == "symbol" || kind == "function") {
    return OWN;
  }
  if (!known(kind, nameOf(v))) {
    return OWN;
  }
  if (!container(kind)) {
    return PLAIN;
  }
  if (!hooked) {
    const own = anyReflectHook(v, key);
    if (typeof own !== "undefined") {
      const inner = scan(own, key, path, true);
      return inner > OWN ? inner : OWN;
    }
  }
  const id = identity(v);
  if (id != 0 && path.includes(id)) {
    return CIRCULAR;
  }
  path.push(id);
  let found: i64 = PLAIN;
  const n = anyReflectCount(v);
  for (let i: i64 = 0; i < n && found != CIRCULAR; i++) {
    const inner = scan(anyReflectValue(v, i), entryKey(v, kind, i), path, false);
    found = inner > found ? inner : found;
  }
  path.pop();
  return found;
}

/** The key of entry `i` of the container `v` of kind `kind`: its index in an array or tuple. */
function entryKey(v: any, kind: string, i: i64): string {
  return kind == "array" || kind == "tuple" ? `${i}` : anyReflectName(v, i);
}

/**
 * `v` as `JSON.stringify` writes it under `key`, a kind std's JSON cannot write through `any` as
 * `{}`; `null` for a value it leaves out (an `undefined`, a symbol, a function). `v` holds no
 * cycle (`scan`). Its `toJSON()` is called once, and the result written without calling it
 * again (`hooked`, Node's `SerializeJSONProperty`).
 */
function write(v: any, key: string, hooked: bool): string | null {
  const kind = kindOf(v);
  if (kind == "undefined" || kind == "symbol" || kind == "function") {
    return null;
  }
  if (!known(kind, nameOf(v))) {
    return "{}";
  }
  if (!container(kind)) {
    return JSON.stringify(v);
  }
  if (!hooked) {
    const own = anyReflectHook(v, key);
    if (typeof own !== "undefined") {
      return write(own, key, true);
    }
  }
  if (kind == "shared") {
    return write(anyReflectValue(v, 0), key, false);
  }
  const n = anyReflectCount(v);
  if (kind == "array" || kind == "tuple") {
    let out = "[";
    for (let i: i64 = 0; i < n; i++) {
      out += i > 0 ? "," : "";
      out += write(anyReflectValue(v, i), `${i}`, false) ?? "null";
    }
    return out + "]";
  }
  let out = "{";
  let first = true;
  for (let i: i64 = 0; i < n; i++) {
    const name = anyReflectName(v, i);
    const text = write(anyReflectValue(v, i), name, false);
    if (text != null) {
      out += first ? "" : ",";
      out += JSON.stringify(name) + ":" + text;
      first = false;
    }
  }
  return out + "}";
}
