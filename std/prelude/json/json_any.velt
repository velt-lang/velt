// Prelude (with `JSON`): `%j` in a `console.log` format string (#3662) of an `any`, or of a value
// the compiler sends here as one (a nullable, a `Map`, a type that can hold itself), as Node's
// `util.format` writes it: `JSON.stringify(v)`; `undefined` for what that gives `undefined` for;
// `[Circular]` for a value that holds itself (Node's `tryStringify`); and, for a value holding
// one std's JSON cannot write through `any` (a `Set`, a `Map`, a `RegExp`) or a `toJSON()`, the
// text Node writes (`{}` for those), from the value's runtime type (velt/lang/intrinsics
// reflection) instead of a panic. A `toJSON()` is called once, as `JSON.stringify` calls it.

import {
  anyReflectCount,
  anyReflectHook,
  anyReflectInfo,
  anyReflectName,
  anyReflectValue,
  identity,
} from "velt/lang/intrinsics";
import { JSON } from "./json";

/** `%j` of `value`. */
function jsonAny(value: any): string {
  const t = typeof value;
  if (t === "undefined" || t === "symbol" || t === "function") {
    return "undefined";
  }
  const path: u64[] = [];
  const found = scan(value, path);
  if (found == CIRCULAR) {
    return "[Circular]";
  }
  if (found == PLAIN) {
    return JSON.stringify(value);
  }
  const state = new Written();
  const text = write(value, "", false, path, state);
  return state.circular ? "[Circular]" : (text ?? "undefined");
}

/** What `scan` found: data std's JSON writes through `any`, */
const PLAIN: i64 = 0;
/** a value written here (a kind std's JSON cannot write through `any`, a `toJSON()`), */
const OWN: i64 = 1;
/** or a value that holds itself. */
const CIRCULAR: i64 = 2;

/** What `write` met: a value that holds itself (through what a `toJSON()` returned). */
class Written {
  circular: bool = false;
}

/** The fields of what `v` holds (`kind|repr|name|hooks`, velt/reflect `typeOf`). */
function fields(v: any): string[] {
  return anyReflectInfo(v).split("|");
}

/** The class name in `info` (`fields`), without its type arguments. */
function nameIn(info: string[]): string {
  const name = info.length > 2 ? info[2] : "";
  const angle = name.indexOf("<");
  return angle >= 0 ? name.slice(0, angle) : name;
}

/** Has the class instance whose runtime type is `info` a `toJSON()`? */
function hasToJson(info: string[]): boolean {
  return info.length > 3 && info[3].split(",").includes("toJSON");
}

/**
 * Is `kind` (with class name `name`) one std's JSON writes through `any`: a primitive, an array,
 * a tuple, a `shared` cell, a record or an object, a class or a struct but the built-ins with no
 * data of their own in JSON (Node writes `{}` for a `RegExp`, a `Promise`, a weak collection)?
 */
function known(kind: string, name: string): boolean {
  if (kind == "class") {
    return name != "RegExp" &&
      name != "Promise" &&
      name != "WeakMap" &&
      name != "WeakSet" &&
      name != "WeakRef";
  }
  return kind == "number" ||
    kind == "string" ||
    kind == "boolean" ||
    kind == "null" ||
    kind == "array" ||
    kind == "tuple" ||
    kind == "struct" ||
    kind == "object" ||
    kind == "record" ||
    kind == "shared" ||
    kind == "enum";
}

/** Is `kind` a container whose entries `scan` and `write` go through? */
function container(kind: string): boolean {
  return kind == "array" ||
    kind == "tuple" ||
    kind == "struct" ||
    kind == "object" ||
    kind == "record" ||
    kind == "shared" ||
    kind == "class";
}

/**
 * `PLAIN`, `OWN` or `CIRCULAR` for `v`, `path` the identities of the objects it is inside (an
 * object met again on the way is a cycle). A value with a `toJSON()` is `OWN` without calling it:
 * `write` calls it once, and finds a cycle through what it returns.
 */
function scan(v: any, path: u64[]): i64 {
  const info = fields(v);
  const kind = info[0];
  if (kind == "undefined" || kind == "symbol" || kind == "function") {
    return OWN;
  }
  if (!known(kind, nameIn(info))) {
    return OWN;
  }
  if (!container(kind)) {
    return PLAIN;
  }
  if (hasToJson(info)) {
    return OWN;
  }
  const id = identity(v);
  if (id != 0 && path.includes(id)) {
    return CIRCULAR;
  }
  path.push(id);
  let found: i64 = PLAIN;
  const n = anyReflectCount(v);
  for (let i: i64 = 0; i < n && found != CIRCULAR; i++) {
    const inner = scan(anyReflectValue(v, i), path);
    found = inner > found ? inner : found;
  }
  path.pop();
  return found;
}

/**
 * `v` as `JSON.stringify` writes it under `key`, a kind std's JSON cannot write through `any` as
 * `{}`; `null` for a value it leaves out (an `undefined`, a symbol, a function). Its `toJSON()`
 * is called once, and the result written without calling it again (`hooked`, Node's
 * `SerializeJSONProperty`); an object met again inside itself (`path`) sets `state.circular`.
 */
function write(v: any, key: string, hooked: bool, path: u64[], state: Written): string | null {
  const info = fields(v);
  const kind = info[0];
  if (kind == "undefined" || kind == "symbol" || kind == "function") {
    return null;
  }
  if (!known(kind, nameIn(info))) {
    return "{}";
  }
  if (!container(kind)) {
    return JSON.stringify(v);
  }
  if (!hooked && hasToJson(info)) {
    return write(anyReflectHook(v, key), key, true, path, state);
  }
  const id = identity(v);
  if (id != 0 && path.includes(id)) {
    state.circular = true;
    return "";
  }
  path.push(id);
  const text = entries(v, kind, path, state);
  path.pop();
  return text;
}

/** The entries of the container `v` of kind `kind`, as `write` writes them. */
function entries(v: any, kind: string, path: u64[], state: Written): string {
  if (kind == "shared") {
    return write(anyReflectValue(v, 0), "", false, path, state) ?? "null";
  }
  const n = anyReflectCount(v);
  if (kind == "array" || kind == "tuple") {
    let out = "[";
    for (let i: i64 = 0; i < n && !state.circular; i++) {
      out += i > 0 ? "," : "";
      out += write(anyReflectValue(v, i), `${i}`, false, path, state) ?? "null";
    }
    return out + "]";
  }
  let out = "{";
  let first = true;
  for (let i: i64 = 0; i < n && !state.circular; i++) {
    const name = anyReflectName(v, i);
    const text = write(anyReflectValue(v, i), name, false, path, state);
    if (text != null) {
      out += first ? "" : ",";
      out += JSON.stringify(name) + ":" + text;
      first = false;
    }
  }
  return out + "}";
}
