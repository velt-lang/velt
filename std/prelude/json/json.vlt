// Prelude, loaded on use: `JSON`, `JsonError` and `JsonValue` (rt_abi_async.md §12.3–12.5). A
// program loads this module when one of its modules names one of them (the global
// std/prelude/global/json.vlt) or imports a std module that uses them.
//
// `JSON.stringify<T>` / `JSON.parse<T>` are compile-time generated per type by the compiler
// intrinsics (a string builder for stringify, a pull-reader decoder for parse); parse failures
// throw a `SyntaxError` `JsonError` ("expected string at $.name"). The stringify glue writes a
// `JsonValue` (at any depth) with its private `__writeJson(b)`, decodes one with
// `__fromReader(r)`, and `console.log` prints one from the runtime tree `__runtimeHandle()`
// makes for it (freed after).
//
// `JSON.parseValue` gives a `JsonValue` for data of unknown shape: a position on a tape (one
// flat array per document, velt:json/tape), which its children share. A value built or edited
// here is a tree of reference-counted runtime nodes behind an opaque `u64` handle
// (rt_abi_async.md §3.2; 0 is the null handle, which a `JsonValue` holds for JSON null); an edit
// turns a tape value into such a tree first.
// Values have value semantics: `set`/`delete`/`push`/`setAt` copy a node another handle shares
// before changing it (copy-on-write), so an edit never shows through a clone, a parent or a
// child. Every `JsonValue` owns one reference to its tape or tree (`get`/`at`/`clone` return
// new ones; children stay valid after their parent is released); a tree's is released by the
// `[Symbol.dispose]()` drop hook. A value that contains a `JsonValue` has no automatic deep
// `clone()` (sema rejects it: the generated copy could not take a new reference).

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

// The pull reader under every `JSON.parse<T>` decoder (Velt code; the compiler's glue calls it).
import { Reader } from "velt:json/reader";
// What `JSON.stringify<T>` writes for numbers and strings (Velt code; the glue calls it).
import "velt:json/writer";
// `JSON.parseValue`'s documents: one flat tape each (Velt code).
import {
  parseTape,
  Tape,
  TapeError,
  T_NULL,
  T_FALSE,
  T_TRUE,
  T_NUMBER,
  T_STRING,
  T_ARRAY,
  T_OBJECT,
} from "velt:json/tape";

declare function velt_rt_strbuf_push_json_value(buf: string, h: u64);

declare function velt_rt_json_parse_value(src: string, out: JsonHandleSlot, err: string): bool;
declare function velt_rt_json_parse_value_with(
  src: string,
  maxDepth: u32,
  out: JsonHandleSlot,
  err: string,
): bool;
declare function velt_rt_json_value_kind(v: u64): u32;
declare function velt_rt_json_value_get(v: u64, key: string): u64;
declare function velt_rt_json_value_at(v: u64, i: u64): u64;
declare function velt_rt_json_value_key_at(v: u64, i: u64, out: string): bool;
declare function velt_rt_json_value_len(v: u64): u64;
declare function velt_rt_json_value_as_f64(v: u64): f64;
declare function velt_rt_json_value_as_bool(v: u64): bool;
declare function velt_rt_json_value_as_str(v: u64, out: string): bool;
declare function velt_rt_json_value_stringify(v: u64): string;
declare function velt_rt_json_value_clone(v: u64): u64;
declare function velt_rt_json_value_free(v: u64);
declare function velt_rt_json_value_new_null(): u64;
declare function velt_rt_json_value_new_bool(b: bool): u64;
declare function velt_rt_json_value_new_number(n: f64): u64;
declare function velt_rt_json_value_new_string(s: string): u64;
declare function velt_rt_json_value_new_array(): u64;
declare function velt_rt_json_value_new_object(): u64;
declare function velt_rt_json_value_set(slot: JsonHandleSlot, key: string, v: u64): bool;
declare function velt_rt_json_value_delete(slot: JsonHandleSlot, key: string): bool;
declare function velt_rt_json_value_push(slot: JsonHandleSlot, v: u64): bool;
declare function velt_rt_json_value_set_at(slot: JsonHandleSlot, i: u64, v: u64): bool;
declare function velt_rt_json_relayout(
  text: string,
  keys: string,
  flags: u8,
  indent: string,
): string;

// `velt_rt_json_value_kind` results.
const KIND_NULL: u32 = 1;
const KIND_BOOL: u32 = 2;
const KIND_NUMBER: u32 = 3;
const KIND_STRING: u32 = 4;
const KIND_ARRAY: u32 = 5;
const KIND_OBJECT: u32 = 6;

// The `const VeltJson** out` of `velt_rt_json_parse_value`: a struct so it is passed by pointer.
struct JsonHandleSlot {
  handle: u64;
}

/** Invalid JSON, or JSON that does not match the type asked for: a `SyntaxError`, as in JS. */
export class JsonError extends SyntaxError {
  /** An error with the given `message`, such as "expected string at $.name". */
  constructor(message: string) {
    super(message);
  }
}

/**
 * Options of `JSON.parse<T>(text, options)`; every field may be left out.
 * - `unknownKeys`: "reject" makes an object key the target type has no field for an error,
 *   `unknown field at $.key` (default "ignore": it is skipped).
 * - `maxDepth`: the deepest nesting of arrays and objects allowed (default 128, like serde_json:
 *   a typed decoder recurses per level, so a much higher limit can overflow the stack).
 * - `comments`: "skip" reads line (`//`) and block comments as whitespace (JSONC, as in
 *   `tsconfig.json`; default "error").
 * - `trailingCommas`: true accepts a comma before `]` and `}` (JSONC; default false).
 */
export type JsonParseOptions = {
  unknownKeys?: "ignore" | "reject";
  maxDepth?: i64;
  comments?: "error" | "skip";
  trailingCommas?: bool;
};

// The reader's flags for `options` on top of `base` (std/json/reader.vlt `FLAG_*`).
function jsonFlags(options: JsonParseOptions | null, base: i64): i64 {
  let flags = base;
  if (options == null) {
    return flags;
  }
  if (options.unknownKeys == "reject") {
    flags = flags | 1;
  }
  if (options.comments == "skip") {
    flags = flags | 16;
  }
  if (options.trailingCommas == true) {
    flags = flags | 32;
  }
  return flags;
}

// `maxDepth` when the options leave it out.
const DEFAULT_MAX_DEPTH: i64 = 128;

// The `max_depth` the runtime gets for `options` (throws `JsonError` when out of range).
function jsonMaxDepth(options: JsonParseOptions | null): i64 {
  if (options == null) {
    return DEFAULT_MAX_DEPTH;
  }
  const d = options.maxDepth;
  if (d == null) {
    return DEFAULT_MAX_DEPTH;
  }
  if (d < 1 || d > 4294967295) {
    throw new JsonError(`maxDepth must be between 1 and 4294967295, got ${d}`);
  }
  return d;
}

/**
 * Converts values to and from the JavaScript Object Notation (JSON) format. Unlike JS, it is
 * typed: `stringify` and `parse` are generated for the static type at compile time, `parse<T>`
 * checks the text against `T` and throws `JsonError` instead of returning `any`. There is no
 * `JSON.parse(text, reviver)` until #924; `JSON.parseValue(text).revive(reviver)` does what it
 * does. `stringify` takes JS's `replacer` (an array of
 * keys, `null`, or a `JsonReplacer` function) and its `space`. `parseValue` reads a document
 * of any shape.
 */
export class JSON {
  /**
   * JS `JSON.stringify`: no whitespace, fields in declaration order, null optional fields omitted.
   */
  static stringify<T>(value: T): string {
    return __intrinsic_json_stringify(value);
  }
  // `JSON.stringify(value, replacer, space)` is written by the compiler: the text above, laid
  // out again by `jsonRelayout` (below).

  /**
   * Decodes `text` into a `T` (throws `JsonError`); unknown object keys are skipped unless
   * `options.unknownKeys` is "reject".
   */
  static parse<T>(text: string, options: JsonParseOptions | null = null): T {
    return __intrinsic_json_parse<T>(text, jsonFlags(options, 0), jsonMaxDepth(options));
  }

  /**
   * `JSON.parse(text)` with its type from the context (`JSON.parse(text) as T`,
   * `const t: T = JSON.parse(text)`, TypeScript's forms; the compiler calls this for them):
   * `parse<T>`, except that a JSON `null` for an optional field whose type has no `null`
   * (`a?: string`) fails the decode, as a value of another type does (JavaScript would give the
   * field a `null` its type can't hold).
   */
  static __parseFromContext<T>(text: string, options: JsonParseOptions | null = null): T {
    return __intrinsic_json_parse<T>(text, jsonFlags(options, 2), jsonMaxDepth(options));
  }

  /**
   * Parses any JSON document (throws `JsonError`); the options are `maxDepth`, `comments` and
   * `trailingCommas`.
   */
  static parseValue(text: string, options: JsonParseOptions | null = null): JsonValue {
    return JsonValue.parse(text, options);
  }
}

/**
 * A JSON value of any shape, as `JSON.parseValue` returns it (`velt:json` calls it `Value`). It
 * has value semantics: an edit never shows through a clone, a parent or a child. Accessors on
 * the wrong kind return null / 0. `JSON.stringify` and `JSON.parse<T>` read and write it. Only
 * std makes one: the constructor is private, so no class can extend `JsonValue`.
 *
 * Two forms (#1660). A parsed value is a position on a tape (velt:json/tape): reading it makes
 * nothing, and its children share the tape. A value built or edited here (`object()`, `set`, …)
 * or read from a database driver is a tree of reference-counted runtime nodes behind `#handle`
 * (which stays the first field: compiled glue writes it); an edit turns a tape value into such
 * a tree first, so it never shows through the tape.
 */
export class JsonValue {
  #handle: u64;
  #tape: Tape | null;
  #node: u32;

  // A `JsonValue` owning the runtime handle `h`, or value `node` of tape `t`.
  private constructor(h: u64, t: Tape | null = null, node: u32 = 0) {
    this.#handle = h;
    this.#tape = t;
    this.#node = node;
  }

  // Value `node` of tape `t`.
  private static onTape(t: Tape, node: u32): JsonValue {
    return new JsonValue(0, t, node);
  }

  /** Parses any JSON document, like `JSON.parseValue` (throws `JsonError`). */
  static parse(text: string, options: JsonParseOptions | null = null): JsonValue {
    const depth = jsonMaxDepth(options) as u32;
    const r = parseTape(text, depth, jsonFlags(options, 0) as u32);
    if (r instanceof TapeError) {
      throw new JsonError(r.message);
    }
    return JsonValue.onTape(r as Tape, 0);
  }

  // A `JsonValue` owning `h`, or null for the runtime's null handle.
  private static wrap(h: u64): JsonValue | null {
    if (h == 0) {
      return null;
    }
    return new JsonValue(h);
  }

  /** An empty object, to fill with `set`. */
  static object(): JsonValue {
    return new JsonValue(velt_rt_json_value_new_object());
  }

  /** An empty array, to fill with `push`. */
  static array(): JsonValue {
    return new JsonValue(velt_rt_json_value_new_array());
  }

  /** A string, number, boolean or `null`. */
  static of(x: string | f64 | bool | null): JsonValue {
    if (x == null) {
      return new JsonValue(velt_rt_json_value_new_null());
    }
    if (typeof x === "string") {
      return new JsonValue(velt_rt_json_value_new_string(x));
    }
    if (typeof x === "number") {
      return new JsonValue(velt_rt_json_value_new_number(x));
    }
    return new JsonValue(velt_rt_json_value_new_bool(x));
  }

  /** The JSON form of any value `JSON.stringify` accepts. */
  static from<T>(x: T): JsonValue {
    const r = parseTape(JSON.stringify(x), 0);
    if (r instanceof TapeError) {
      panic(`JsonValue.from: ${r.message}`);
    }
    return JsonValue.onTape(r as Tape, 0);
  }

  /**
   * `JSON.parse(text, reviver)`'s second step, as JavaScript applies it: from the innermost
   * values out, `reviver(key, value)` gives each member's new value (`undefined`: the member is
   * deleted; an array element becomes `null`), and last the value itself, under the key `""`.
   * Returns the new value; this one is unchanged. `undefined` for the value itself throws a
   * `TypeError` (JavaScript returns `undefined`, which a `JsonValue` can't be). The reviver's
   * value parameter must be written `v: JsonValue` until #924.
   */
  revive(reviver: JsonReplacer): JsonValue {
    const out = jsonRevived("", this, reviver);
    if (out == undefined) {
      throw new TypeError(
        "JsonValue.revive: the reviver returned undefined for the value itself (JSON.parse would return undefined; a JsonValue can't be undefined)",
      );
    }
    return out;
  }

  /** Decodes this value into a `T`, like `JSON.parse<T>` (throws `JsonError`). */
  as<T>(options: JsonParseOptions | null = null): T {
    return JSON.parse<T>(this.stringify(), options);
  }

  // A tape value becomes a runtime tree (before an edit).
  private toTree() {
    const t = this.#tape;
    if (t == null) {
      return;
    }
    this.#handle = treeOf(t, this.#node);
    this.#tape = null;
  }

  /**
   * A runtime handle of its own to this value (for the compiler's glue and edits: the caller
   * frees it with `velt_rt_json_value_free`): another reference to the tree, or a tree made from
   * the tape.
   */
  private __runtimeHandle(): u64 {
    const t = this.#tape;
    if (t != null) {
      return treeOf(t, this.#node);
    }
    return velt_rt_json_value_clone(this.#handle);
  }

  /**
   * Reads one value with `r` (compiled glue: a `JsonValue` field being decoded): null when the
   * reader failed. Private: the glue calls it by name.
   */
  private static __fromReader(r: Reader): JsonValue | null {
    const t = r.readValue();
    if (t != null) {
      return JsonValue.onTape(t, 0);
    }
    if (r.rowsValue) {
      return new JsonValue(r.lastHandle());
    }
    return null;
  }

  /** Appends this value as `JSON.stringify` writes it to the builder `out` (compiled glue). */
  private __writeJson(out: string): void {
    const t = this.#tape;
    if (t != null) {
      const node = this.#node;
      t.write(out, node);
      return;
    }
    const h = this.#handle;
    velt_rt_strbuf_push_json_value(out, h);
  }

  /** Sets object member `key` (an existing key keeps its position); false if not an object. */
  set(key: string, value: JsonValue): bool {
    this.toTree();
    const h = value.__runtimeHandle();
    let slot = JsonHandleSlot { handle: this.#handle };
    const ok = velt_rt_json_value_set(slot, key, h);
    this.#handle = slot.handle;
    velt_rt_json_value_free(h);
    return ok;
  }

  /** Removes object member `key`; false if absent or not an object. */
  delete(key: string): bool {
    this.toTree();
    let slot = JsonHandleSlot { handle: this.#handle };
    const ok = velt_rt_json_value_delete(slot, key);
    this.#handle = slot.handle;
    return ok;
  }

  /** Appends to an array; false if not an array. */
  push(value: JsonValue): bool {
    this.toTree();
    const h = value.__runtimeHandle();
    let slot = JsonHandleSlot { handle: this.#handle };
    const ok = velt_rt_json_value_push(slot, h);
    this.#handle = slot.handle;
    velt_rt_json_value_free(h);
    return ok;
  }

  /** Replaces array element `i`; false if not an array or `i` is out of range. */
  setAt(i: i64, value: JsonValue): bool {
    if (i < 0) {
      return false;
    }
    this.toTree();
    const h = value.__runtimeHandle();
    let slot = JsonHandleSlot { handle: this.#handle };
    const ok = velt_rt_json_value_set_at(slot, i as u64, h);
    this.#handle = slot.handle;
    velt_rt_json_value_free(h);
    return ok;
  }

  /** Object member `key`, or null (not an object, or no such key). */
  get(key: string): JsonValue | null {
    const t = this.#tape;
    if (t != null) {
      const v = t.find(this.#node, key);
      return v < 0 ? null : JsonValue.onTape(t, v as u32);
    }
    return JsonValue.wrap(velt_rt_json_value_get(this.#handle, key));
  }

  /**
   * Whether this is an object with member `key`, even one whose value is `null` (a typed
   * `JSON.parse` sees an absent `T | null` field and an explicit `null` alike).
   */
  has(key: string): bool {
    const t = this.#tape;
    if (t != null) {
      return t.find(this.#node, key) >= 0;
    }
    return this.get(key) != null;
  }

  /** Array element `i` (or the i-th member value of an object), or null if out of range. */
  at(i: i64): JsonValue | null {
    if (i < 0) {
      return null;
    }
    const t = this.#tape;
    if (t != null) {
      const v = t.child(this.#node, i);
      return v < 0 ? null : JsonValue.onTape(t, v as u32);
    }
    return JsonValue.wrap(velt_rt_json_value_at(this.#handle, i as u64));
  }

  /** Array length, object member count, string length (UTF-16 code units); 0 otherwise. */
  len(): i64 {
    const t = this.#tape;
    if (t != null) {
      const k = t.kind(this.#node);
      if (k == T_STRING) {
        return t.units(this.#node);
      }
      return k == T_ARRAY || k == T_OBJECT ? t.count(this.#node) : 0;
    }
    return velt_rt_json_value_len(this.#handle) as i64;
  }

  // The kind as the runtime numbers them (`KIND_*`).
  private kind(): u32 {
    const t = this.#tape;
    if (t != null) {
      const k = t.kind(this.#node);
      if (k == T_NULL) {
        return KIND_NULL;
      }
      if (k == T_TRUE || k == T_FALSE) {
        return KIND_BOOL;
      }
      if (k == T_NUMBER) {
        return KIND_NUMBER;
      }
      if (k == T_STRING) {
        return KIND_STRING;
      }
      return k == T_ARRAY ? KIND_ARRAY : KIND_OBJECT;
    }
    return velt_rt_json_value_kind(this.#handle);
  }

  /** Whether this value is JSON `null`. */
  isNull(): bool {
    // The null handle (from the runtime) is JSON null too.
    return this.kind() <= KIND_NULL;
  }

  /** Whether this value is a boolean. */
  isBool(): bool {
    return this.kind() == KIND_BOOL;
  }

  /** Whether this value is a number. */
  isNumber(): bool {
    return this.kind() == KIND_NUMBER;
  }

  /** Whether this value is a string. */
  isString(): bool {
    return this.kind() == KIND_STRING;
  }

  /** Whether this value is an array. */
  isArray(): bool {
    return this.kind() == KIND_ARRAY;
  }

  /** Whether this value is an object. */
  isObject(): bool {
    return this.kind() == KIND_OBJECT;
  }

  /** The value if it is a number, else null. */
  asNumber(): f64 | null {
    const t = this.#tape;
    if (t != null) {
      return t.kind(this.#node) == T_NUMBER ? t.number(this.#node) : null;
    }
    if (!this.isNumber()) {
      return null;
    }
    return velt_rt_json_value_as_f64(this.#handle);
  }

  /** The value if it is a boolean, else null. */
  asBool(): bool | null {
    const t = this.#tape;
    if (t != null) {
      const k = t.kind(this.#node);
      return k == T_TRUE ? true : k == T_FALSE ? false : null;
    }
    if (!this.isBool()) {
      return null;
    }
    return velt_rt_json_value_as_bool(this.#handle);
  }

  /** The value if it is a string, else null. */
  asString(): string | null {
    const t = this.#tape;
    if (t != null) {
      return t.kind(this.#node) == T_STRING ? t.text(this.#node) : null;
    }
    let out = "";
    if (velt_rt_json_value_as_str(this.#handle, out)) {
      return out;
    }
    return null;
  }

  /**
   * Object keys in JavaScript's order, as `Object.keys` gives them: array-index keys such as
   * `"2"` first, ascending, then the others in document order (a repeated key once, at its
   * first place); empty for non-objects.
   */
  keys(): string[] {
    const out: string[] = [];
    const t = this.#tape;
    if (t != null) {
      if (t.kind(this.#node) != T_OBJECT) {
        return out;
      }
      const n = t.count(this.#node);
      for (let i: i64 = 0; i < n; i++) {
        out.push(t.text(t.member(this.#node, i) as u32));
      }
      return out;
    }
    if (!this.isObject()) {
      return out;
    }
    const n = velt_rt_json_value_len(this.#handle);
    for (let i: u64 = 0; i < n; i++) {
      let key = "";
      velt_rt_json_value_key_at(this.#handle, i, key);
      out.push(key);
    }
    return out;
  }

  /** Same as `JSON.stringify(this)`. */
  stringify(): string {
    const t = this.#tape;
    if (t != null) {
      return t.stringify(this.#node);
    }
    return velt_rt_json_value_stringify(this.#handle);
  }

  /** Another reference to the same value: O(1) (edits copy on write, so they stay apart). */
  clone(): JsonValue {
    const t = this.#tape;
    if (t != null) {
      return JsonValue.onTape(t, this.#node);
    }
    return new JsonValue(velt_rt_json_value_clone(this.#handle));
  }

  /** Drop hook: releases this reference (values taken with `get` or `at` stay valid). */
  [Symbol.dispose]() {
    if (this.#handle != 0) {
      velt_rt_json_value_free(this.#handle);
      this.#handle = 0;
    }
  }
}

// A runtime tree made from value `node` of tape `t` (its JSON text, parsed by the runtime).
function treeOf(t: Tape, node: u32): u64 {
  const text = t.stringify(node);
  let slot = JsonHandleSlot { handle: 0 };
  let err = "";
  if (!velt_rt_json_parse_value_with(text, 0, slot, err)) {
    panic(`ICE: a tape's JSON text did not parse: ${err}`);
  }
  return slot.handle;
}

// `JSON.stringify(value, replacer, space)` (the compiler calls these): `text` is
// `JSON.stringify(value)`; `keys` the replacer array's JSON text, applied when `filter`; `gap`
// the indent `jsonGapOfString` made of a string `space` (empty: no whitespace).
/**
 * A replacer function of `JSON.stringify(value, replacer, space)`: called with each key and the
 * JSON form of its value (the value passed itself under the key `""` first), it returns the
 * value to write there, or `undefined` to leave a member out (an array element is then `null`).
 */
export type JsonReplacer = (key: string, value: JsonValue) => JsonValue | undefined;

// `JSON.stringify(value, replacer)` (the compiler calls it): `text` is `JSON.stringify(value)`,
// which `replacer` rewrites as JavaScript applies it, from the top: its result for a key is
// what is written there, and the members of that result are replaced in turn. `undefined` for
// the value itself throws a `TypeError` (JavaScript returns `undefined`; this returns a string).
function jsonReplaceWith(text: string, replacer: JsonReplacer): string {
  let root = JsonValue.of(null);
  try {
    // At any depth: `stringify` writes values nested deeper than the default limit too.
    root = JsonValue.parse(text, { maxDepth: 4294967295 });
  } catch (e) {
    // `text` is `JSON.stringify`'s own output.
    panic(`ICE: JSON.stringify wrote text it cannot read back: ${e.message}`);
  }
  const out = jsonReplaced("", root, replacer);
  if (out == undefined) {
    throw new TypeError(
      "JSON.stringify: the replacer returned undefined for the value itself (JavaScript would return undefined; Velt's JSON.stringify returns a string)",
    );
  }
  return out.stringify();
}

function jsonReplaced(
  key: string,
  value: JsonValue,
  replacer: JsonReplacer,
): JsonValue | undefined {
  const r = replacer(key, value);
  if (r == undefined) {
    return undefined;
  }
  if (r.isArray()) {
    const out = JsonValue.array();
    const n = r.len();
    for (let i: i64 = 0; i < n; i++) {
      const e = jsonReplaced(String(i), r.at(i)!, replacer);
      out.push(e ?? JsonValue.of(null));
    }
    return out;
  }
  if (r.isObject()) {
    const out = JsonValue.object();
    for (const k of r.keys()) {
      const e = jsonReplaced(k, r.get(k)!, replacer);
      if (e != undefined) {
        out.set(k, e);
      }
    }
    return out;
  }
  return r;
}

// `value.revive(reviver)`: its members revived first (in place of the value's own), then it.
function jsonRevived(key: string, value: JsonValue, reviver: JsonReplacer): JsonValue | undefined {
  if (value.isArray()) {
    const out = JsonValue.array();
    const n = value.len();
    for (let i: i64 = 0; i < n; i++) {
      const e = jsonRevived(String(i), value.at(i)!, reviver);
      out.push(e ?? JsonValue.of(null));
    }
    return reviver(key, out);
  }
  if (value.isObject()) {
    const out = JsonValue.object();
    for (const k of value.keys()) {
      const e = jsonRevived(k, value.get(k)!, reviver);
      if (e != undefined) {
        out.set(k, e);
      }
    }
    return reviver(key, out);
  }
  return reviver(key, value);
}

function jsonRelayout(text: string, keys: string, filter: bool, gap: string): string {
  if (!filter && gap.length == 0) {
    return text;
  }
  return velt_rt_json_relayout(text, keys, jsonLayoutFlags(filter, gap.length > 0), gap);
}

// The same for a number `space`: as in V8, any `space > 0` breaks lines, so one below 1 gives
// line breaks with an empty indent.
function jsonRelayoutNumber(text: string, keys: string, filter: bool, space: f64): string {
  if (!(space > 0)) {
    return jsonRelayout(text, keys, filter, "");
  }
  return velt_rt_json_relayout(text, keys, jsonLayoutFlags(filter, true), jsonGapOfNumber(space));
}

// `velt_rt_json_relayout`'s flags: bit 0 filters by `keys`, bit 1 breaks lines.
function jsonLayoutFlags(filter: bool, pretty: bool): u8 {
  let flags: u8 = 0;
  if (filter) {
    flags = flags + 1;
  }
  if (pretty) {
    flags = flags + 2;
  }
  return flags;
}

// A replacer array of strings as the runtime reads it.
function jsonKeys(keys: string[]): string {
  return JSON.stringify(keys);
}

// A replacer array of numbers: JS lists each as `String(n)`.
function jsonNumberKeys(keys: f64[]): string {
  return JSON.stringify(keys.map((k) => `${k}`));
}

// JS's gap for a number `space`: `min(10, trunc(space))` spaces, empty below 1 (or for NaN).
function jsonGapOfNumber(space: f64): string {
  if (!(space >= 1)) {
    return "";
  }
  return " ".repeat(space >= 10 ? 10 : (space as i64));
}

// JS's gap for a string `space`: its first 10 code units.
function jsonGapOfString(space: string): string {
  return space.slice(0, 10);
}
