// Prelude, loaded on use: `JSON.stringify(value, replacer, space)` (the compiler calls these): `text`
// is `JSON.stringify(value)`; `keys` the replacer array's JSON text, applied when `filter`; `gap`
// the indent `jsonGapOfString` made of a string `space` (empty: no whitespace).

import { JSON } from "velt/prelude/json/json";
import { JsonValue } from "velt/prelude/json/json_value";
import { propertyList, relayout } from "velt/encoding/json/relayout";
import { hookCall } from "velt/lang/intrinsics";
import { StringBuilder } from "velt/text/string_builder";
import { holdsJsonValue, jsonPresent, writeJsonResult } from "velt/encoding/json/any";

// `JSON.stringify(value, replacer, space)` (the compiler calls these): `text` is
// `JSON.stringify(value)`; `keys` the replacer array's JSON text, applied when `filter`; `gap`
// the indent `jsonGapOfString` made of a string `space` (empty: no whitespace).
/**
 * A replacer function of `JSON.stringify(value, replacer, space)`: called with each key and the
 * JSON form of its value (the value passed itself under the key `""` first), it returns the
 * value to write there, or `undefined` to leave a member out (an array element is then `null`).
 * As in JavaScript, a value's `toJSON(key)` runs just before the replacer is called for its
 * key, so the replacer of a parent sees a member of a class with one as its fields (a `Date` as
 * its text: its `toJSON` is std's).
 */
export type JsonReplacer = (key: string, value: JsonValue) => JsonValue | undefined;

// `JSON.stringify(value, replacer)` (the compiler calls it): `value` walked as JavaScript walks
// it, `toJSON` and the replacer per key (velt/encoding/json/replace_ops.velt). `undefined` for
// the value itself throws a `TypeError` (JavaScript returns `undefined`; this returns a string).
// By role: only a program that passes a replacer function loads the walk (#3807).
function jsonStringifyReplaced<T>(value: T, replacer: JsonReplacer): string {
  return hookCall("json_stringify_replaced", value, replacer);
}

// A replacer function declared with `any` (`(key: string, value: any) => any`) as a
// `JsonReplacer` (the compiler calls it): what it returns is the JSON Node writes of it.
function jsonReplacerOfAny(f: (key: string, value: any) => any): JsonReplacer {
  return (key: string, value: JsonValue): JsonValue | undefined => jsonOfAny(f(key, value), key);
}

// What a replacer declared with `any` returned for `key`, as JSON: a `JsonValue` as it is;
// `undefined`, a function or a symbol left out, as Node leaves them; anything else as Node
// writes it, without its own `toJSON` (that ran before the replacer, if it was the value).
function jsonOfAny(r: any, key: string): JsonValue | undefined {
  if (!jsonPresent(r)) {
    return undefined;
  }
  if (holdsJsonValue(r)) {
    return r as JsonValue;
  }
  const w = new StringBuilder();
  writeJsonResult(w, r, key);
  let out = JsonValue.of(null);
  try {
    out = JsonValue.parse(w.take(), { maxDepth: 4294967295 });
  } catch (e) {
    panic(`ICE: JSON.stringify wrote text it cannot read back: ${e.message}`);
  }
  return out;
}

function jsonRelayout(text: string, keys: string, filter: bool, gap: string): string {
  // No keys (`""`, from `jsonAnyKeys`): the replacer filters nothing.
  const filtered = filter && keys.length > 0;
  if (!filtered && gap.length == 0) {
    return text;
  }
  return relayout(text, filtered ? propertyList(keys) : null, gap.length > 0, gap);
}

// The same for a number `space`: as in V8, any `space > 0` breaks lines, so one below 1 gives
// line breaks with an empty indent.
function jsonRelayoutNumber(text: string, keys: string, filter: bool, space: f64): string {
  if (!(space > 0)) {
    return jsonRelayout(text, keys, filter, "");
  }
  const filtered = filter && keys.length > 0;
  return relayout(text, filtered ? propertyList(keys) : null, true, jsonGapOfNumber(space));
}

// A replacer array of strings as `propertyList` reads it.
function jsonKeys(keys: string[]): string {
  return JSON.stringify(keys);
}

// A replacer array of numbers: JS lists each as `String(n)`.
function jsonNumberKeys(keys: f64[]): string {
  return JSON.stringify(keys.map((k) => `${k}`));
}

// A replacer only known at run time, or an array of mixed or other number types, as an `any`:
// Node's property list of an array (a string entry as it is, a number as `String(n)`, any other
// entry ignored), or `""` (no filter) for anything else that is not a function. A function
// behind an `any` can't be called as a replacer: a `TypeError`.
function jsonAnyKeys(replacer: any): string {
  if (typeof replacer == "function") {
    throw new TypeError(
      "JSON.stringify: a replacer function must be typed `JsonReplacer`, not passed as `any`",
    );
  }
  if (!Array.isArray(replacer)) {
    return "";
  }
  // Indexed through the `any`: an array of any element type.
  const keys: string[] = [];
  const n = replacer.length as f64;
  for (let i = 0; i < n; i++) {
    const k = replacer[i];
    if (typeof k == "string") {
      keys.push(k as string);
    } else if (typeof k == "number") {
      keys.push(String(k));
    }
  }
  return JSON.stringify(keys);
}

// JS's gap for a number `space`: `min(10, trunc(space))` spaces, empty below 1 (or for NaN).
function jsonGapOfNumber(space: f64): string {
  if (!(space >= 1)) {
    return "";
  }
  return " ".repeat(space >= 10 ? 10 : (space as i64));
}

// JS's gap for a string `space`: its first 10 code units.
function jsonGapOfString(space: string): string {
  return space.slice(0, 10);
}
