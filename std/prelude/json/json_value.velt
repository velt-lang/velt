// Prelude, loaded on use: `JsonValue`, a JSON value of unknown shape (std/prelude/json/json.velt:
// how it is held).

import { Reader } from "velt/encoding/json/reader";
import { jsonFlags, jsonMaxDepth } from "velt/encoding/json/options";
import { JSON_FROM_READER, JSON_INSPECT, JSON_WRITE } from "velt/lang/hooks/keys";
import { parseTape } from "velt/encoding/json/tape_parse";
import {
  T_ARRAY,
  T_FALSE,
  T_NULL,
  T_NUMBER,
  T_OBJECT,
  T_STRING,
  T_TRUE,
  Tape,
} from "velt/encoding/json/tape";
import { TapeError } from "velt/encoding/json/tape_error";
import { TapeRef } from "velt/encoding/json/tape_ref";
import { inline, isUnique } from "velt/lang/intrinsics";
import {
  jsonValueEquals,
  jsonValueFrom,
  jsonValueFromReader,
  jsonValueOf,
  jsonValueRevived,
} from "velt/encoding/json/value_ops";
import { JSON } from "velt/prelude/json/json";
import { JsonError, JsonParseOptions } from "velt/prelude/json/json_error";
import { JsonReplacer } from "velt/prelude/json/layout";
import {
  JsonTree,
  TREE_ARRAY,
  TREE_BOOL,
  TREE_NULL,
  TREE_NUMBER,
  TREE_OBJECT,
  TREE_STRING,
  TREE_MAX_HEIGHT,
  TREE_TAPE,
} from "velt/encoding/json/tree";
import { treeMember, treeOfTape, treeStringify, writeTree } from "velt/encoding/json/tree_text";
import { inspectJsonValue, jsonValueString } from "velt/encoding/json/value_inspect";
import { frozenTree } from "velt/encoding/json/tree_freeze";
import { treeAt, treeGet, treeKeys, treeLen, treeTapeKind } from "velt/encoding/json/tree_read";

/**
 * A JSON value of any shape, as `JSON.parseValue` returns it (`velt/encoding/json` calls it `Value`). It
 * has value semantics: an edit never shows through a clone, a parent or a child. Accessors on
 * the wrong kind return null / 0. `JSON.stringify` and `JSON.parse<T>` read and write it. Only
 * std makes one: the constructor is private, so no class can extend `JsonValue`.
 *
 * Two forms (#1660). A parsed value is a position on a tape (velt/encoding/json/tape): reading it makes
 * nothing, and its children share the tape. The tape is frozen and shared between tasks: a value
 * sent to another task reads the same tape there (velt/encoding/json/tape_ref, #3098). A value
 * built or edited here (`object()`, `set`, …) is a tree of nodes (velt/encoding/json/tree), which
 * values share; an edit turns a tape value into such a tree first, so it never shows through the
 * tape, and copies a node another reference reaches (`isUnique`) before it changes it.
 */
export class JsonValue {
  #tree: JsonTree | null;
  #tape: TapeRef | null = null;
  #node: u32 = 0;

  // A `JsonValue` of tree `t` (null for a tape value, which `onTape` fills in). Kept this small
  // so that every `new` of it is inlined (the optimizer can then keep a value that never leaves
  // its function out of the heap).
  private constructor(t: JsonTree | null) {
    this.#tree = t;
  }

  // Value `node` of tape `t`.
  @inline("always")
  private static onTape(t: TapeRef, node: u32): JsonValue {
    const v = new JsonValue(null);
    v.#tape = t;
    v.#node = node;
    return v;
  }

  // A value of node `t` (a child, which its parent reaches too), or null. A child left on a tape
  // (`TREE_TAPE`, always a container) is such a value's node too: the tree side's readers below
  // read through it.
  private static sharing(t: JsonTree | null): JsonValue | null {
    if (t == null) {
      return null;
    }
    return new JsonValue(t);
  }

  /** Parses any JSON document, like `JSON.parseValue` (throws `JsonError`). */
  static parse(text: string, options: JsonParseOptions | null = null): JsonValue {
    const depth = jsonMaxDepth(options) as u32;
    const r = parseTape(text, depth, jsonFlags(options, 0) as u32);
    if (r instanceof TapeError) {
      throw new JsonError(r.message);
    }
    return JsonValue.onTape(new TapeRef(shared(r as Tape)), 0);
  }

  /** An empty object, to fill with `set`. */
  static object(): JsonValue {
    return new JsonValue(JsonTree.object());
  }

  /** An empty array, to fill with `push`. */
  static array(): JsonValue {
    return new JsonValue(JsonTree.array());
  }

  /** A string, number, boolean or `null`. */
  static of(x: string | f64 | bool | null): JsonValue {
    return jsonValueOf(x);
  }

  /** The JSON form of any value `JSON.stringify` accepts. */
  static from<T>(x: T): JsonValue {
    return jsonValueFrom<T>(x);
  }

  /**
   * `JSON.parse(text, reviver)`'s second step, as JavaScript applies it: from the innermost
   * values out, `reviver(key, value)` gives each member's new value (`undefined`: the member is
   * deleted; an array element becomes `null`), and last the value itself, under the key `""`.
   * Returns the new value; this one is unchanged. `undefined` for the value itself throws a
   * `TypeError` (JavaScript returns `undefined`, which a `JsonValue` can't be). The reviver's
   * value parameter must be written `v: JsonValue` until #924.
   */
  revive(reviver: JsonReplacer): JsonValue {
    return jsonValueRevived(this, reviver);
  }

  /** Decodes this value into a `T`, like `JSON.parse<T>` (throws `JsonError`). */
  as<T>(options: JsonParseOptions | null = null): T {
    return JSON.parse<T>(this.stringify(), options);
  }

  // The tree to edit: a tape value's own tree (its containers left on the tape), or the node
  // copied first when another reference reaches it (a clone, a parent, a child; the copy shares
  // the children).
  private edited(): JsonTree {
    const t = this.#tape;
    if (t != null) {
      const tree = treeOfTape(t, this.#node, null);
      this.#tree = tree;
      this.#tape = null;
      return tree;
    }
    if (this.#tree!.kind == TREE_TAPE) {
      const tv = this.#tree!;
      const o = tv.obj!;
      this.#tree = treeOfTape(o.tape!, o.node, o.links);
      return this.#tree!;
    }
    if (!isUnique(this.#tree!)) {
      this.#tree = this.#tree!.copy();
    }
    return this.#tree!;
  }

  // The node of this value to store in another value (which then reaches it too): a parsed value
  // stays on its tape, and a tree as high as a tree may be is stored as a tape (tree.velt).
  private shareTree(): JsonTree {
    const t = this.#tape;
    if (t != null) {
      return treeMember(t, this.#node, null);
    }
    const tree = this.#tree!;
    if (tree.height >= TREE_MAX_HEIGHT) {
      return frozenTree(tree);
    }
    return tree;
  }

  /** Appends what `console.log` prints for this value to the builder `out` (lowering calls it). */
  [JSON_INSPECT](out: string, top: bool, depth: u32): void {
    inspectJsonValue(out, this, top, depth);
  }

  /**
   * Reads one value with `r` (a `JsonValue` being decoded: the decoders velt/encoding/json
   * generates call it, as the compiler's glue does): null when the reader failed.
   */
  static [JSON_FROM_READER](r: Reader): JsonValue | null {
    return jsonValueFromReader(r);
  }

  /** Appends this value as `JSON.stringify` writes it to the builder `out`. */
  [JSON_WRITE](out: string): void {
    const t = this.#tape;
    if (t != null) {
      const node = this.#node;
      t.write(out, node);
      return;
    }
    const tree = this.#tree!;
    writeTree(out, tree);
  }

  /** Sets object member `key` (an existing key keeps its position); false if not an object. */
  set(key: string, value: JsonValue): bool {
    if (!this.isObject()) {
      return false;
    }
    // The value's node first: `value` may be this value.
    const child = value.shareTree();
    const e = this.edited();
    e.holds(child);
    e.obj!.insert(key, child);
    return true;
  }

  /** Removes object member `key`; false if absent or not an object. */
  delete(key: string): bool {
    if (!this.has(key)) {
      return false;
    }
    return this.edited().obj!.remove(key);
  }

  /** Appends to an array; false if not an array. */
  push(value: JsonValue): bool {
    if (!this.isArray()) {
      return false;
    }
    const child = value.shareTree();
    const e = this.edited();
    e.holds(child);
    e.items!.push(child);
    return true;
  }

  /** Replaces array element `i`; false if not an array or `i` is out of range. */
  setAt(i: i64, value: JsonValue): bool {
    if (i < 0 || !this.isArray() || i >= this.len()) {
      return false;
    }
    const child = value.shareTree();
    const e = this.edited();
    e.holds(child);
    e.items![i as usize] = child;
    return true;
  }

  /** Object member `key`, or null (not an object, or no such key). */
  get(key: string): JsonValue | null {
    const t = this.#tape;
    if (t != null) {
      const v = t.find(this.#node, key);
      return v < 0 ? null : JsonValue.onTape(t, v as u32);
    }
    return JsonValue.sharing(treeGet(this.#tree!, key));
  }

  /**
   * Whether this is an object with member `key`, even one whose value is `null` (a typed
   * `JSON.parse` sees an absent `T | null` field and an explicit `null` alike).
   */
  has(key: string): bool {
    const t = this.#tape;
    if (t != null) {
      return t.find(this.#node, key) >= 0;
    }
    return treeGet(this.#tree!, key) != null;
  }

  /** Array element `i` (or the i-th member value of an object), or null if out of range. */
  at(i: i64): JsonValue | null {
    if (i < 0) {
      return null;
    }
    const t = this.#tape;
    if (t != null) {
      const v = t.child(this.#node, i);
      return v < 0 ? null : JsonValue.onTape(t, v as u32);
    }
    return JsonValue.sharing(treeAt(this.#tree!, i));
  }

  /** Array length, object member count, string length (UTF-16 code units); 0 otherwise. */
  len(): i64 {
    const t = this.#tape;
    if (t != null) {
      const k = t.kind(this.#node);
      if (k == T_STRING) {
        return t.units(this.#node);
      }
      return k == T_ARRAY || k == T_OBJECT ? t.count(this.#node) : 0;
    }
    return treeLen(this.#tree!);
  }

  // The kind as trees number them (`TREE_*`).
  private kind(): u32 {
    const t = this.#tape;
    if (t != null) {
      const k = t.kind(this.#node);
      if (k == T_NULL) {
        return TREE_NULL;
      }
      if (k == T_TRUE || k == T_FALSE) {
        return TREE_BOOL;
      }
      if (k == T_NUMBER) {
        return TREE_NUMBER;
      }
      if (k == T_STRING) {
        return TREE_STRING;
      }
      return k == T_ARRAY ? TREE_ARRAY : TREE_OBJECT;
    }
    const k = this.#tree!.kind;
    return k == TREE_TAPE ? treeTapeKind(this.#tree!) : k;
  }

  /** Whether this value is JSON `null`. */
  isNull(): bool {
    return this.kind() == TREE_NULL;
  }

  /** Whether this value is a boolean. */
  isBool(): bool {
    return this.kind() == TREE_BOOL;
  }

  /** Whether this value is a number. */
  isNumber(): bool {
    return this.kind() == TREE_NUMBER;
  }

  /** Whether this value is a string. */
  isString(): bool {
    return this.kind() == TREE_STRING;
  }

  /** Whether this value is an array. */
  isArray(): bool {
    return this.kind() == TREE_ARRAY;
  }

  /** Whether this value is an object. */
  isObject(): bool {
    return this.kind() == TREE_OBJECT;
  }

  /** The value if it is a number, else null. */
  asNumber(): f64 | null {
    const t = this.#tape;
    if (t != null) {
      return t.kind(this.#node) == T_NUMBER ? t.number(this.#node) : null;
    }
    const tree = this.#tree!;
    return tree.kind == TREE_NUMBER ? tree.num : null;
  }

  /** The value if it is a boolean, else null. */
  asBool(): bool | null {
    const t = this.#tape;
    if (t != null) {
      const k = t.kind(this.#node);
      return k == T_TRUE ? true : k == T_FALSE ? false : null;
    }
    const tree = this.#tree!;
    return tree.kind == TREE_BOOL ? tree.num != 0 : null;
  }

  /** The value if it is a string, else null. */
  asString(): string | null {
    const t = this.#tape;
    if (t != null) {
      return t.kind(this.#node) == T_STRING ? t.text(this.#node) : null;
    }
    const tree = this.#tree!;
    return tree.kind == TREE_STRING ? tree.text : null;
  }

  /**
   * Object keys in JavaScript's order, as `Object.keys` gives them: array-index keys such as
   * `"2"` first, ascending, then the others in document order (a repeated key once, at its
   * first place); empty for non-objects.
   */
  keys(): string[] {
    const t = this.#tape;
    if (t != null) {
      const out: string[] = [];
      if (t.kind(this.#node) != T_OBJECT) {
        return out;
      }
      const n = t.count(this.#node);
      for (let i: i64 = 0; i < n; i++) {
        out.push(t.text(t.member(this.#node, i) as u32));
      }
      return out;
    }
    return treeKeys(this.#tree!);
  }

  /**
   * Its JSON text, as `stringify()`: what `JSON.stringify` writes for a `JsonValue` that an
   * `any` holds (the text itself, not a JSON string of it).
   */
  toJSON(): string {
    return this.stringify();
  }

  /** `String(v)` of the parsed value, as JavaScript writes it: `1,2` for `[1, 2]`, `[object Object]`. */
  toString(): string {
    return jsonValueString(this);
  }

  /** Same as `JSON.stringify(this)`. */
  stringify(): string {
    const t = this.#tape;
    if (t != null) {
      return t.stringify(this.#node);
    }
    return treeStringify(this.#tree!);
  }

  // Equal to `other` by its JSON content, as `util.isDeepStrictEqual` (`deepEqual`) and `toEqual`
  // compare the values `JSON.parse` makes in Node: an object's members in any order, numbers
  // with SameValueZero (`deep`: `Object.is`). The code velt/lang/equal generates calls it.
  private deepEquals(other: JsonValue, deep: bool): bool {
    return jsonValueEquals(this, other, deep);
  }

  // Is `other` this same value of a parsed document, unedited (an edit makes a tree)? The walk of
  // `JSON.stringify(value, replacer)` goes on through the typed value while it is.
  private sameNode(other: JsonValue): bool {
    const t = this.#tape;
    const u = other.#tape;
    return t != null && u != null && t === u && this.#node == other.#node;
  }

  /** Another reference to the same value: O(1) (edits copy on write, so they stay apart). */
  clone(): JsonValue {
    const t = this.#tape;
    if (t != null) {
      return JsonValue.onTape(t, this.#node);
    }
    return new JsonValue(this.#tree);
  }
}
