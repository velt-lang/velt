// Prelude: `Mutex<T>` and `RwLock<T>` for `shared(new Mutex<T>(x))` (docs/reference/async.md),
// and `Atomic<T>` (docs/std/sync.md, docs/internals/design/atomics.md). The compiler turns every
// call of an `Atomic` method into the instruction with the ordering its call site names; the
// bodies here, `seqcst` whatever the ordering (only ever stronger), run only through a
// function value of a method.
//
// The compiler implements `new Mutex<T>(x)` (initializes the lock word) and `m.with((v) => ...)`
// (lock, run the callback on the value, unlock) on a `Mutex<T>` or `shared<Mutex<T>>`, and
// `new RwLock<T>(x)`, `rw.read(f)` and `rw.write(f)` the same way; these declarations only fix
// the layout they use: the runtime's 8-byte lock word, then the value (an `RwLock`'s 19 words,
// rt_abi_async.md §9.2). Neither is ever Copy
// (copying one would duplicate the lock). Their methods are the only way to reach the value.

// Lowering calls `pin` and `unpin` around a function that loads an `Atomic` of a `shared` value,
// and `retire` for each reference such an `Atomic` gives up (velt_vir `epoch_sections.rs`,
// `atomic_ref.rs`).
import { pin, unpin, retire } from "velt:sync/epoch";

/**
 * A lock around a value of type `T`, for sharing it between tasks and threads:
 * `shared(new Mutex<T>(x))`. `m.with((v) => …)` locks, runs the callback on the value, then
 * unlocks; it is the only way to reach the value.
 */
export struct Mutex<T> {
  private lock: u64;
  private value: T;
}

/**
 * A lock around a value of type `T` that many readers may hold at once:
 * `shared(new RwLock<T>(x))`. `rw.read((v) => …)` runs the callback on the value while other
 * readers may run theirs; the callback cannot change the value. `rw.write((v) => …)` runs it
 * alone, like `Mutex.with`. A writer that has waited a while holds new readers back, so writers
 * don't starve. A `read` callback cannot run `with` or `write`, or start a promise or task.
 */
export struct RwLock<T> {
  // The runtime's words (rt_abi_async.md §9.2): the underlying reader-writer lock, then (a
  // cache line on) the state readers read, with the value; padding after it keeps that line the
  // lock's own.
  private lock: u64;
  private line1: u64;
  private line2: u64;
  private line3: u64;
  private line4: u64;
  private line5: u64;
  private line6: u64;
  private line7: u64;
  private line8: u64;
  private line9: u64;
  private line10: u64;
  private line11: u64;
  private line12: u64;
  private line13: u64;
  private line14: u64;
  private line15: u64;
  private state: u64;
  private until: u64;
  private inhibit: u64;
  private value: T;
  private tail1: u64;
  private tail2: u64;
  private tail3: u64;
  private tail4: u64;
  private tail5: u64;
  private tail6: u64;
  private tail7: u64;
  private tail8: u64;
  private tail9: u64;
  private tail10: u64;
  private tail11: u64;
  private tail12: u64;
  private tail13: u64;
  private tail14: u64;
  private tail15: u64;
  private tail16: u64;
}

/**
 * A number, `bool` or `shared` value that threads read and change at once, without a lock:
 * `new Atomic<u64>(0)`
 * (docs/std/sync.md). It is stored in place, as a plain `T`, in the object or array that holds
 * it, and it is the one part of a `shared<T>` that changes: `s.hits.add(1)` changes the word in
 * the `shared` value every thread reads. Each method is one instruction (or a short loop where
 * the CPU has none). `T` is an integer type, `f64`, `f32` or `bool`; a float's `add`, `sub`,
 * `max` and `min` are compare-and-swap loops. `T` may also be `shared<U>` or `shared<U> | null`:
 * `load`, `store` and `exchange` then move references, and `compareExchange` compares identity
 * and returns whether it swapped (docs/std/sync.md). An `Atomic<string>` is the same, except that
 * `compareExchange` compares contents.
 *
 * Every method takes a memory ordering, `"seqcst"` when left out, as JavaScript's `Atomics`:
 * `"relaxed"` (only this word is atomic), `"acquire"` (later reads see what the thread that
 * released saw), `"release"`, `"acqrel"` (both) or `"seqcst"` (also one order of all `seqcst`
 * operations). It must be a string literal. An `Atomic` cannot be copied or shared, only used
 * where it is: `a.load()` reads it.
 */
export struct Atomic<T> {
  private v: T;

  /** The value. */
  load(order: "relaxed" | "acquire" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_load(this, 4);
  }

  /** Makes `v` the value. */
  store(v: T, order: "relaxed" | "release" | "seqcst" = "seqcst"): void {
    __intrinsic_atomic_store(this, v, 4);
  }

  /** Makes `v` the value; returns the previous one. */
  exchange(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 0, 4);
  }

  /**
   * Makes `v` the value if it is `expected`; returns the previous value, which is `expected`
   * when it did. `failure` is the ordering of the read when it did not (by default `order`
   * without its release part). On an `Atomic` of a `shared` value it compares identity (the same
   * reference), on an `Atomic<string>` contents, and returns whether it made `v` the value; when
   * it did not, `v` is dropped.
   */
  compareExchange(
    expected: T,
    v: T,
    order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst",
    failure: "relaxed" | "acquire" | "seqcst" = "seqcst",
  ): T {
    return __intrinsic_atomic_cas(this, expected, v, 4, 4);
  }

  /**
   * `compareExchange` that may fail even when the value is `expected` (call it in a loop), and
   * that is cheaper on CPUs without a compare-and-swap instruction; returns whether it made `v`
   * the value.
   */
  compareExchangeWeak(
    expected: T,
    v: T,
    order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst",
    failure: "relaxed" | "acquire" | "seqcst" = "seqcst",
  ): bool {
    return __intrinsic_atomic_cas_weak(this, expected, v, 4, 4);
  }

  /** Adds `v` (wrapping around at an integer type's bounds); returns the previous value. */
  add(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 1, 4);
  }

  /** Subtracts `v` (wrapping around at an integer type's bounds); returns the previous value. */
  sub(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 2, 4);
  }

  /** Bitwise and (logical, for `bool`) with `v`; returns the previous value. */
  and(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 3, 4);
  }

  /** Bitwise or (logical, for `bool`) with `v`; returns the previous value. */
  or(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 4, 4);
  }

  /** Bitwise exclusive or (logical, for `bool`) with `v`; returns the previous value. */
  xor(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 5, 4);
  }

  /**
   * Makes the value the larger of it and `v` (`Math.max` for a float); returns the previous
   * value. Numbers only.
   */
  max(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 6, 4);
  }

  /**
   * Makes the value the smaller of it and `v` (`Math.min` for a float); returns the previous
   * value. Numbers only.
   */
  min(v: T, order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): T {
    return __intrinsic_atomic_rmw(this, v, 7, 4);
  }

  /**
   * A fence: with `"acquire"`, later reads and writes of this thread stay after the reads before
   * it; with `"release"`, earlier ones stay before the writes after it; `"acqrel"` both;
   * `"seqcst"` also in the one order of all `seqcst` operations.
   */
  static fence(order: "acquire" | "release" | "acqrel" | "seqcst" = "seqcst"): void {
    __intrinsic_atomic_fence(4);
  }

  /**
   * A hint for a loop that waits for another thread to change a value: the CPU spends less
   * power and gives a sibling hardware thread its turn (`pause`, `isb`). It changes no memory.
   */
  static spinHint(): void {
    __intrinsic_atomic_spin_hint();
  }
}

/**
 * One value per thread, a number or `bool`: `const depth = new ThreadLocal<u32>(0)` at module
 * level (docs/std/sync.md). Each thread starts with the value given and changes its own with
 * `set`; `get` reads this thread's. A task moves to another thread only at an `await`, so it reads
 * its own writes until then. It is for code that keeps per-thread state, such as which reader
 * slot is this thread's: a value a task needs after an `await` belongs in a variable.
 *
 * Only a module `const` can hold one, made with a literal: `get` and `set` are called on that
 * constant.
 */
export struct ThreadLocal<T> {
  private init: T;

  /** This thread's value. */
  get(): T {
    return __intrinsic_thread_local_get(this);
  }

  /** Makes `v` this thread's value. */
  set(v: T): void {
    __intrinsic_thread_local_set(this, v);
  }
}

/**
 * The types an `Atomic` can hold: the integer types, `f32`, `f64`, `bool`, `string` and
 * `shared` values (and `shared<U> | null`); the compiler knows which, so no type declares it. A
 * type parameter bounded by it (`T extends AtomicValue`) may be an `Atomic`'s `T` in generic
 * code, checked where the generic is instantiated.
 */
export interface AtomicValue {}

/**
 * The types whose `shared` values are read in place, without a lock or a copy: what holds no
 * `Mutex`, weak reference, promise, function or interface value, and no class with subclasses
 * or a `clone()` of its own. The compiler knows which, so no type declares it (an `extends` or
 * `implements` of it is an error). With a type parameter bounded by it (`V extends Frozen`),
 * generic code reads a `shared<V>` as a `V`, checked where the generic is instantiated.
 */
export interface Frozen {}
