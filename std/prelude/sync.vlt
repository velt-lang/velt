// Prelude: `Mutex<T>` and `RwLock<T>` for `shared(new Mutex<T>(x))` (docs/reference/async.md).
//
// The compiler implements `new Mutex<T>(x)` (initializes the lock word) and `m.with((v) => ...)`
// (lock, run the callback on the value, unlock) on a `Mutex<T>` or `shared<Mutex<T>>`, and
// `new RwLock<T>(x)`, `rw.read(f)` and `rw.write(f)` the same way; these declarations only fix
// the layout they use: the runtime's 8-byte lock word, then the value (an `RwLock`'s 19 words,
// rt_abi_async.md §9.2). Neither is ever Copy
// (copying one would duplicate the lock). Their methods are the only way to reach the value.

/**
 * A lock around a value of type `T`, for sharing it between tasks and threads:
 * `shared(new Mutex<T>(x))`. `m.with((v) => …)` locks, runs the callback on the value, then
 * unlocks; it is the only way to reach the value.
 */
export struct Mutex<T> {
  private lock: u64;
  private value: T;
}

/**
 * A lock around a value of type `T` that many readers may hold at once:
 * `shared(new RwLock<T>(x))`. `rw.read((v) => …)` runs the callback on the value while other
 * readers may run theirs; the callback cannot change the value. `rw.write((v) => …)` runs it
 * alone, like `Mutex.with`. Waiting writers go first, so neither side starves.
 */
export struct RwLock<T> {
  // The runtime's words (rt_abi_async.md §9.2): the writers' mutex, then (a cache line on) the
  // state readers read, with the value; padding after it keeps that line the lock's own.
  private lock: u64;
  private line1: u64;
  private line2: u64;
  private line3: u64;
  private line4: u64;
  private line5: u64;
  private line6: u64;
  private line7: u64;
  private line8: u64;
  private line9: u64;
  private line10: u64;
  private line11: u64;
  private line12: u64;
  private line13: u64;
  private line14: u64;
  private line15: u64;
  private state: u64;
  private until: u64;
  private inhibit: u64;
  private value: T;
  private tail1: u64;
  private tail2: u64;
  private tail3: u64;
  private tail4: u64;
  private tail5: u64;
  private tail6: u64;
  private tail7: u64;
  private tail8: u64;
  private tail9: u64;
  private tail10: u64;
  private tail11: u64;
  private tail12: u64;
  private tail13: u64;
  private tail14: u64;
  private tail15: u64;
  private tail16: u64;
}
