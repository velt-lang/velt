// Prelude: `WeakRef<T>` (https://veltlang.com/docs/std/prelude/#weakmap-weakset-and-weakref), a reference that does not
// keep its target alive, on velt_rt's weak-reference core (docs/internals/design/weak-refs.md).

import { weakRefDeref, weakRefNew } from "velt/lang/intrinsics";

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

/**
 * A reference to an object that does not keep it alive. Velt frees an object as soon as its last
 * reference goes, so `deref()` returns `null` from then on (Node clears it at a later
 * garbage collection).
 */
export class WeakRef<T> {
  #id: u32;

  /** A reference to `target` that does not keep it alive. */
  constructor(target: T) {
    this.#id = weakRefNew(target);
  }

  /** The target, or `undefined` once it was freed. */
  deref(): T | undefined {
    return weakRefDeref<T>(this.#id) ?? undefined;
  }

  /** Drop hook: releases the slot. */
  [Symbol.dispose]() {
    if (this.#id != 0) {
      velt_rt_weakref_drop(this.#id);
      this.#id = 0;
    }
  }
}

declare function velt_rt_weakref_drop(r: u32);
