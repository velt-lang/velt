// Prelude: helper methods on `T | null`.
//
// The value-extracting helpers (`unwrap`, `unwrapOr`, `map`) move the payload out of the receiver,
// so they consume it: `x.unwrapOr(d)` gives up `x`. The usual receivers are temporaries
// (`find(xs, k).unwrapOr(0)`), where that is free. For Copy payloads the receiver stays usable.
// `isNull` only borrows.

extend<T> (T | null) {
  /** Whether the value is null (`x == null`); borrows it. */
  isNull(): bool {
    return this == null;
  }

  /** The value, or `fallback` when it is null (`x ?? fallback`); consumes the receiver. */
  unwrapOr(fallback: T): T {
    return this ?? fallback;
  }

  /** The value; panics on null. */
  unwrap(): T {
    if (this != null) {
      return this;
    }
    panic("called unwrap() on a null value");
  }

  /**
   * `f` applied to the value, or null when it is null (`x == null ? null : f(x)`); consumes the
   * receiver.
   * @throws what `f` throws.
   */
  map<U, E>(f: (x: T) => U throws E): U | null throws E {
    if (this != null) {
      return f(this);
    }
    return null;
  }
}
