// Prelude: JS string methods, `String.fromCharCode`, `String.fromCodePoint`, `parseInt`,
// `parseFloat`, `Number(s)` (runtime string functions, rt_abi_async.md §12.2).
//
// Positions and lengths count UTF-16 code units, as in JavaScript (`"😀".length` is 2): a
// position may fall between the two halves of a surrogate pair, and slicing there keeps the
// half as a lone surrogate (https://veltlang.com/docs/reference/types/ "Strings"). Positions are `i64` so negative
// arguments keep their JS meaning; "absent" is -1 (`indexOf`, `charCodeAt`) where JS would say
// -1 or NaN. Inputs are borrowed; every returned string is owned by the caller (a substring of a
// static string may itself be static, which is free to drop).

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

// `Number(s)` and `parseFloat(s)` are Velt code (#1658).
import { toNumber, parseFloatOf } from "velt/lang/number/parse";
import { parseIntOf } from "velt/lang/number/parse_int";
import {
  hookCall,
  inline,
  noInline,
  strAsciiWords,
  strBorrowedWords,
  strByteAt,
  strByteLen,
  strCharCodeAt,
  strWord0,
  strWord1,
  strWord2,
} from "velt/lang/intrinsics";

declare function velt_rt_str_byte_slice(s: string, start: u64, end: u64, units: u64): string;
declare function velt_rt_str_from_char_code(code: i64): string;

/**
 * The byte length of `s` when it is ASCII (its units are its bytes), else 0, from its words
 * read once (rt_abi.md "Strings"): an inline string is ASCII when byte 23's `0x40` bit is clear
 * (its length in the low five bits), any other when the two halves of `w1` (units, bytes) agree.
 */
@inline("always")
function asciiLen(s: string): u64 {
  const w2 = strWord2(s);
  if ((w2 as i64) < 0) {
    const tag = w2 >> 56;
    return (tag & 0x40) == 0 ? tag & 0x1f : 0;
  }
  const w1 = strWord1(s);
  const bytes = w1 & 0xffffffff;
  return w1 >> 32 == bytes ? bytes : 0;
}

/**
 * `s.slice(start, end)` (#2198). Compiled into the caller, with no call:
 * - the one-unit slice of an ASCII string (`start` in range, `end` the next unit): the inline
 *   string of its byte;
 * - any slice of a static ASCII string (a literal, or a view the runtime handed out as static):
 *   the static string of its sub-range, as the runtime would return it (#3469), so slicing one
 *   costs no call, no count and no copy.
 * Any other slice of an ASCII string (heap or inline) clamps its positions here and is one call
 * of the runtime's byte slice, given the piece's unit count. A string that is not ASCII (or is
 * empty) goes to std's translation of its positions (`sliceWide`, std/lang/string/positions.velt,
 * the `string_slice` hook, #2816), prebuilt: a program checks and compiles none of it where the
 * build cache or the toolchain holds its object.
 */
@inline("always")
function sliceOf(s: string, start: i64, end: i64): string {
  const n = asciiLen(s);
  if (start >= 0 && (start as u64) < n && end == start + 1) {
    return strAsciiWords(strByteAt(s, start as u64) as u64, 0, 0, 1);
  }
  // Static (`w2` 0) and ASCII (units equal bytes, not 0): the runtime's static branch of
  // `VeltStr::substring`, inline. Only `w2` is tested before the call, not `n`: a heap string
  // then pays one compare, and LLVM need not compute `n` for slices the test above rules out
  // (+5 % instructions on bench/typical/consume when the test read `n`).
  if (strWord2(s) == 0) {
    const w1 = strWord1(s);
    const len = w1 & 0xffffffff;
    if (w1 >> 32 == len && len != 0) {
      return staticAsciiSlice(strWord0(s), len, start, end);
    }
  }
  if (n != 0) {
    const a = relativePos(start, n);
    const b = relativePos(end, n);
    return a < b ? velt_rt_str_byte_slice(s, a, b, b - a) : strBorrowedWords(0, 0);
  }
  return hookCall("string_slice", s, start, end);
}

/**
 * The slice `[start, end)` of the static ASCII string of `n` bytes at `ptr`, as the runtime's
 * static branch of `VeltStr::substring` gives it: the static string of the clamped range, or
 * the empty string when it is empty.
 */
@inline("always")
function staticAsciiSlice(ptr: u64, n: u64, start: i64, end: i64): string {
  const a = relativePos(start, n);
  const b = relativePos(end, n);
  if (a >= b) {
    return strBorrowedWords(0, 0);
  }
  const len = b - a;
  return strBorrowedWords(ptr + a, (len << 32) | len);
}

/**
 * A JS relative position in a string of `n` units, as the runtime's `relative_index`: a negative
 * `i` counts from the end; the result is clamped to `[0, n]`. For a negative `i`, `n + i` cannot
 * overflow: `n` is not negative (and below 2^31), so the sum lies in `[i, n)`, even for
 * `i64::MIN` (what `-Infinity` converts to).
 */
@inline("always")
function relativePos(i: i64, n: u64): u64 {
  if (i < 0) {
    const k = (n as i64) + i;
    return k < 0 ? 0 : k as u64;
  }
  return (i as u64) < n ? i as u64 : n;
}

/**
 * The one-unit string of the UTF-16 code unit `code & 0xffff`: an ASCII one is its inline
 * string, with no call; another (a lone surrogate among them) is the runtime's.
 */
@inline("always")
function unitText(code: i64): string {
  const unit = code & 0xffff;
  return unit < 0x80 ? strAsciiWords(unit as u64, 0, 0, 1) : velt_rt_str_from_char_code(unit);
}

// `split` without a limit: the largest `ToUint32`.
const NO_LIMIT: number = 4294967295;

/** JS's `ToUint32` of `split`'s limit: nothing to do when none was given. */
@inline("always")
function splitLimit(limit: number): u32 {
  return limit == NO_LIMIT ? 0xffffffff : splitLimitOf(limit);
}

/** `ToUint32(limit)`: NaN and the infinities are 0, another number its integer part modulo 2^32. */
function splitLimitOf(limit: number): u32 {
  if (limit != limit || limit == Infinity || limit == -Infinity) {
    return 0;
  }
  const r = Math.trunc(limit) % 4294967296;
  return (r < 0 ? r + 4294967296 : r) as u32;
}

/**
 * `repeat`'s RangeError for the count `n`. A `number` count converts to the nearest `i64`, so
 * the infinities arrive as the largest and the smallest one.
 */
@noInline
function repeatError(n: i64): never {
  if (n == END) {
    panic("RangeError: Invalid count value: Infinity");
  }
  if (n == -END - 1) {
    panic("RangeError: Invalid count value: -Infinity");
  }
  if (n < 0) {
    panic(`RangeError: Invalid count value: ${n}`);
  }
  panic("RangeError: Invalid string length");
}

// "Omitted" end / from positions, as the runtime expects them.
const END: i64 = 9223372036854775807;
// The most bytes a string holds (velt_rt `str/heap.rs` `MAX_CAP`): a longer `repeat` is a RangeError.
const MAX_BYTES: i64 = 2147483647;

extend string {
  /** [start, end); negative positions count from the end; clamped; "" if start >= end. */
  slice(start: i64 = 0, end: i64 = END): string {
    return sliceOf(this, start, end);
  }

  /** Like `slice`, but negative positions are 0 and swapped bounds are reordered (JS rules). */
  substring(start: i64, end: i64 = END): string {
    const lo = start < 0 ? 0 : start;
    const hi = end < 0 ? 0 : end;
    return sliceOf(this, lo <= hi ? lo : hi, lo <= hi ? hi : lo);
  }

  /** First match at or after `from`, or -1. */
  indexOf(needle: string, from: i64 = 0): i64 {
    return hookCall("string_index_of", this, needle, from);
  }

  /** Last match starting at or before `from`, or -1. */
  lastIndexOf(needle: string, from: i64 = END): i64 {
    return hookCall("string_last_index_of", this, needle, from);
  }

  /**
   * Returns true if `needle` appears as a substring of this string at or after `position` (a
   * code-unit index, clamped to the string); otherwise, returns false.
   * @param needle - search string
   */
  includes(needle: string, position: i64 = 0): bool {
    return hookCall("string_includes", this, needle, position);
  }

  /**
   * Returns true if this string has `prefix` at `position` (a code-unit index, clamped to the
   * string). Otherwise returns false.
   */
  startsWith(prefix: string, position: i64 = 0): bool {
    if (position <= 0) {
      return hookCall("string_starts_with", this, prefix);
    }
    const len = this.length as i64;
    const start = position < len ? position : len;
    return this.slice(start, start + (prefix.length as i64)) == prefix;
  }

  /**
   * Returns true if the first `endPosition` code units of this string (all of it by default)
   * end with `suffix`. Otherwise returns false.
   */
  endsWith(suffix: string, endPosition: i64 = END): bool {
    const len = this.length as i64;
    if (endPosition >= len) {
      return hookCall("string_ends_with", this, suffix);
    }
    const end = endPosition > 0 ? endPosition : 0;
    const n = suffix.length as i64;
    return end >= n && this.slice(end - n, end) == suffix;
  }

  /**
   * JS semantics: "a,b,".split(",") is ["a", "b", ""]; split("") gives the code units (a
   * surrogate pair splits into its two halves). With a `limit`, at most that many pieces, the
   * first ones: `"a,b,c".split(",", 2)` is `["a", "b"]`. The limit is converted as JS's
   * `ToUint32`: 0 and NaN give `[]`, -1 is no limit.
   */
  split(sep: string, limit: number = NO_LIMIT): string[] {
    return hookCall("string_split", this, sep, splitLimit(limit));
  }

  /** Strips JS whitespace and line terminators. */
  trim(): string {
    return hookCall("string_trim", this);
  }

  /** Removes the leading white space and line terminator characters from a string. */
  trimStart(): string {
    return hookCall("string_trim_start", this);
  }

  /** Removes the trailing white space and line terminator characters from a string. */
  trimEnd(): string {
    return hookCall("string_trim_end", this);
  }

  /** Full Unicode case mapping, like JS ("ß".toUpperCase() is "SS"). */
  toUpperCase(): string {
    return hookCall("string_to_upper", this);
  }

  /**
   * Converts all the alphabetic characters in a string to lowercase: full Unicode case mapping,
   * like JS (a final `Σ` becomes `ς`).
   */
  toLowerCase(): string {
    return hookCall("string_to_lower", this);
  }

  /** First occurrence; `to` expands `$$`, `$&`, `` $` `` and `$'` like JS. */
  replace(from: string, to: string): string {
    return hookCall("string_replace", this, from, to);
  }

  /**
   * Replace all instances of a substring in a string. `from` is plain text; with a `RegExp`
   * (`s.replaceAll(/a/g, "b")`) the call is std/regex's (as for `replace`, `split`, `match`,
   * `matchAll` and `search`).
   * @param from - A string to search for.
   * @param to - A string containing the text to replace for every successful match of `from` in
   * this string; `$$`, `$&`, `` $` `` and `$'` are expanded like JS.
   */
  replaceAll(from: string, to: string): string {
    return hookCall("string_replace_all", this, from, to);
  }

  /**
   * `n` copies of this string. A RangeError panic, with JS's messages, for a negative or
   * infinite count ("Invalid count value") and for a result longer than a string can be
   * ("Invalid string length").
   */
  repeat(n: i64): string {
    const bytes = strByteLen(this) as i64;
    if (n < 0 || n == END || (bytes != 0 && n > MAX_BYTES / bytes)) {
      repeatError(n);
    }
    return hookCall("string_repeat", this, n);
  }

  /**
   * Pads to `target` code units with `fill` (the last partial fill is cut to the units missing,
   * between the halves of a pair if need be, as in JS).
   */
  padStart(target: i64, fill: string = " "): string {
    return hookCall("string_pad_start", this, target, fill);
  }

  /**
   * Pads the current string with a given string (possibly repeated) so that the resulting string
   * reaches a given length in UTF-16 code units, as in JS.
   * The padding is applied from the end (right) of the current string.
   * @param target - The length of the resulting string once the current string has been padded.
   * If this parameter is smaller than the current string's length, the current string will be
   * returned as it is.
   * @param fill - The string to pad the current string with.
   * If this string is too long, it will be truncated and the left-most part will be applied; the
   * cut may fall between the halves of a surrogate pair, as in JS. The default value for this
   * parameter is " " (U+0020).
   */
  padEnd(target: i64, fill: string = " "): string {
    return hookCall("string_pad_end", this, target, fill);
  }

  /**
   * The code unit at position `i` as a one-unit string (a surrogate pair gives one half), or ""
   * out of range, as JS's `charAt`. `s[i]` is the same. In range, the one-unit slice is that unit
   * (a lone half inside a pair). Compiled into the caller: in an ASCII string, the inline string of
   * the byte at `i`, the string's words read once (`asciiLen`); any other string calls std's
   * translation of the position.
   */
  charAt(i: i64 = 0): string {
    const n = asciiLen(this);
    if (i >= 0 && (i as u64) < n) {
      return strAsciiWords(strByteAt(this, i as u64) as u64, 0, 0, 1);
    }
    // Out of range in an ASCII string, or a string that is not ASCII (or is empty): std's
    // translation (`sliceWide`).
    return n != 0 || i < 0 || i == END ? "" : hookCall("string_slice", this, i, i + 1);
  }

  /**
   * Like `charAt`, but a negative `i` counts from the end, and past the end is `undefined`.
   */
  at(i: i64): string | undefined {
    const n = this.length as i64;
    const k = i < 0 ? i + n : i;
    if (k < 0 || k >= n) {
      return undefined;
    }
    return this.charAt(k);
  }

  /**
   * The UTF-16 code unit at `i` (the high or low surrogate of a pair), or -1 if out of range
   * (JS: NaN). Reads an ASCII string inline.
   */
  charCodeAt(i: i64 = 0): i64 {
    return strCharCodeAt(this, i);
  }

  /**
   * The code point at `i`: a surrogate pair's character when `i` is at its high surrogate,
   * otherwise the code unit there (a lone surrogate, or the low half of a pair). `undefined` if
   * `i` is out of range, as in JS.
   */
  codePointAt(i: i64 = 0): number | undefined {
    const high = strCharCodeAt(this, i);
    if (high < 0) {
      return undefined;
    }
    if (high >= 0xd800 && high < 0xdc00) {
      const low = strCharCodeAt(this, i + 1);
      if (low >= 0xdc00 && low < 0xe000) {
        return (0x10000 + ((high - 0xd800) << 10) + (low - 0xdc00)) as number;
      }
    }
    // Every code point is exact in a number.
    return high as number;
  }
}

/**
 * The static members of JS's `String` (`String.fromCharCode`, `String.fromCodePoint`). The
 * methods of strings are on `string` itself. `String(x)` converts any printable value as `${x}`
 * does (the compiler writes it).
 */
export class String {
  /**
   * JS `String.fromCharCode(...codes)`: the string of these UTF-16 code units (`ToUint16`
   * each: the code modulo 2^16, NaN and the infinities 0). A lone surrogate gives a string
   * holding that lone surrogate, and a high surrogate followed by a low one their character,
   * as in JS.
   */
  static fromCharCode(...codes: f64[]): string {
    if (codes.length == 1) {
      return unitText((codes[0] % 65536) as i64);
    }
    let s = "";
    for (const code of codes) {
      s += unitText((code % 65536) as i64);
    }
    return s;
  }

  /**
   * JS `String.fromCodePoint(...codePoints)`: the string of these code points (one or two
   * UTF-16 code units each). A RangeError panic for a code point that is not an integer from 0
   * to 0x10FFFF, as JS throws one. A lone surrogate's code point gives that lone surrogate.
   */
  static fromCodePoint(...codePoints: f64[]): string {
    let s = "";
    for (const cp of codePoints) {
      if (!(cp >= 0 && cp <= 0x10ffff) || Math.trunc(cp) != cp) {
        panic(`RangeError: Invalid code point ${cp}`);
      }
      const c = cp as i64;
      if (c < 0x10000) {
        s += unitText(c);
      } else {
        // The pair's halves join into one character.
        s += velt_rt_str_from_char_code(0xd800 + ((c - 0x10000) >> 10));
        s += velt_rt_str_from_char_code(0xdc00 + ((c - 0x10000) & 0x3ff));
      }
    }
    return s;
  }
}

/** Exact JS `parseInt`: `radix` 0 means "omitted" (base 10, or 16 after "0x"); NaN if no digits. */
export function parseInt(s: string, radix: i64 = 0): f64 {
  return parseIntOf(s, radix);
}

/** Exact JS `parseFloat`: the longest decimal prefix (incl. "Infinity"), else NaN. */
export function parseFloat(s: string): f64 {
  return parseFloatOf(s);
}

/**
 * Exact JS `Number(s)`: the whole trimmed string must be a number ("" is 0), else NaN. The
 * compiler converts a number or a boolean argument itself, as JS does.
 */
export function Number(s: string): f64 {
  return toNumber(s);
}
