// Prelude: JS string methods, `String.fromCharCode`, `parseInt`, `parseFloat`, `Number(s)`
// (runtime string functions, rt_abi_async.md §12.2).
//
// POC indexing model: positions and lengths are byte offsets (they agree with `s.length`); a
// position inside a multi-byte character moves back to its first byte, so results are always
// valid UTF-8. For ASCII text every method matches JS exactly. Positions are `i64` so negative
// arguments keep their JS meaning; "absent" is -1 (`indexOf`) where JS would say -1 or NaN.
// Inputs are borrowed; every returned string is owned by the caller (a substring of a static
// string may itself be static, which is free to drop).

declare function velt_rt_str_slice(s: string, start: i64, end: i64): string;
declare function velt_rt_str_index_of(s: string, needle: string, from: i64): i64;
declare function velt_rt_str_last_index_of(s: string, needle: string, from: i64): i64;
declare function velt_rt_str_includes(s: string, needle: string): bool;
declare function velt_rt_str_starts_with(s: string, affix: string): bool;
declare function velt_rt_str_ends_with(s: string, affix: string): bool;
declare function velt_rt_str_split(s: string, sep: string): string[];
declare function velt_rt_str_trim(s: string): string;
declare function velt_rt_str_trim_start(s: string): string;
declare function velt_rt_str_trim_end(s: string): string;
declare function velt_rt_str_to_upper(s: string): string;
declare function velt_rt_str_to_lower(s: string): string;
declare function velt_rt_str_replace(s: string, from: string, to: string): string;
declare function velt_rt_str_replace_all(s: string, from: string, to: string): string;
declare function velt_rt_str_repeat(s: string, n: i64, out: string): bool;
declare function velt_rt_str_pad_start(s: string, target: i64, fill: string): string;
declare function velt_rt_str_pad_end(s: string, target: i64, fill: string): string;
declare function velt_rt_str_from_char_code(code: i64): string;
declare function velt_rt_parse_int(s: string, radix: i64): f64;
declare function velt_rt_parse_float(s: string): f64;
declare function velt_rt_str_to_number(s: string): f64;

// "Omitted" end / from positions, as the runtime expects them.
const END: i64 = 9223372036854775807;

extend string {
  // [start, end); negative positions count from the end; clamped; "" if start >= end.
  slice(start: i64 = 0, end: i64 = END): string {
    return velt_rt_str_slice(this, start, end);
  }

  // Like `slice`, but negative positions are 0 and swapped bounds are reordered (JS rules).
  substring(start: i64, end: i64 = END): string {
    const lo = start < 0 ? 0 : start;
    const hi = end < 0 ? 0 : end;
    return lo <= hi ? velt_rt_str_slice(this, lo, hi) : velt_rt_str_slice(this, hi, lo);
  }

  // First match at or after `from`, or -1.
  indexOf(needle: string, from: i64 = 0): i64 {
    return velt_rt_str_index_of(this, needle, from);
  }

  // Last match starting at or before `from`, or -1.
  lastIndexOf(needle: string, from: i64 = END): i64 {
    return velt_rt_str_last_index_of(this, needle, from);
  }

  includes(needle: string): bool {
    return velt_rt_str_includes(this, needle);
  }

  startsWith(prefix: string): bool {
    return velt_rt_str_starts_with(this, prefix);
  }

  endsWith(suffix: string): bool {
    return velt_rt_str_ends_with(this, suffix);
  }

  // JS semantics: "a,b,".split(",") is ["a", "b", ""]; split("") gives the characters.
  split(sep: string): string[] {
    return velt_rt_str_split(this, sep);
  }

  // Strips JS whitespace and line terminators.
  trim(): string {
    return velt_rt_str_trim(this);
  }

  trimStart(): string {
    return velt_rt_str_trim_start(this);
  }

  trimEnd(): string {
    return velt_rt_str_trim_end(this);
  }

  // Full Unicode case mapping, like JS ("ß".toUpperCase() is "SS").
  toUpperCase(): string {
    return velt_rt_str_to_upper(this);
  }

  toLowerCase(): string {
    return velt_rt_str_to_lower(this);
  }

  // First occurrence; `to` expands `$$`, `$&`, `` $` `` and `$'` like JS.
  replace(from: string, to: string): string {
    return velt_rt_str_replace(this, from, to);
  }

  replaceAll(from: string, to: string): string {
    return velt_rt_str_replace_all(this, from, to);
  }

  // Panics like JS's RangeError if `n` is negative or the result would be too large.
  repeat(n: i64): string {
    let out = "";
    if (!velt_rt_str_repeat(this, n, out)) {
      panic(`RangeError: Invalid count value: ${n}`);
    }
    return out;
  }

  // Pads to `target` bytes with `fill` (the last partial fill is cut at a character boundary).
  padStart(target: i64, fill: string = " "): string {
    return velt_rt_str_pad_start(this, target, fill);
  }

  padEnd(target: i64, fill: string = " "): string {
    return velt_rt_str_pad_end(this, target, fill);
  }

  // The byte at `i` (POC: bytes, not UTF-16 units), or -1 if out of range (JS: NaN).
  charCodeAt(i: i64 = 0): i64 {
    return __intrinsic_str_char_code_at(this, i);
  }
}

export class String {
  // JS `String.fromCharCode(code)` for one code unit, UTF-8 encoded (lone surrogates: U+FFFD).
  static fromCharCode(code: i64): string {
    return velt_rt_str_from_char_code(code);
  }
}

// Exact JS `parseInt`: `radix` 0 means "omitted" (base 10, or 16 after "0x"); NaN if no digits.
export function parseInt(s: string, radix: i64 = 0): f64 {
  return velt_rt_parse_int(s, radix);
}

// Exact JS `parseFloat`: the longest decimal prefix (incl. "Infinity"), else NaN.
export function parseFloat(s: string): f64 {
  return velt_rt_parse_float(s);
}

// Exact JS `Number(s)`: the whole trimmed string must be a number ("" is 0), else NaN.
export function Number(s: string): f64 {
  return velt_rt_str_to_number(s);
}
