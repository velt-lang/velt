// Prelude: the built-in methods of strings, arrays, numbers and booleans called through `any`
// (issue #924, docs/reference/types.md "any and unknown"). A call `x.name(args)` on an `any`
// is one call through the descriptor of the value held (`AnyCall`); for a string it runs
// `__anyStr_<name>(s, args)`, for an array of `T` `__anyArr_<name><T>(a, args)`, for a number
// `__anyNum_<name>(n, args)` and for a boolean `__anyBool_<name>(b, args)` (velt_vir
// any_builtin.rs finds them by name). The arguments come as an `any[]` and are converted as
// JavaScript converts them (`ToString`, `ToIntegerOrInfinity`); the result goes back as an
// `any`. A name without a function here is a `TypeError` naming #924.
//
// The file name sorts after the other prelude modules, so their indexes stay the same.

/** Argument `k` of `args`, `undefined` when it was left out. */
function __anyArg(args: any[], k: i64): any {
  return k < (args.length as i64) ? args[k as usize] : undefined;
}

/** Argument `k` as JavaScript's `ToIntegerOrInfinity` makes it (`d` when left out or `undefined`). */
function __anyIntArg(args: any[], k: i64, d: i64): i64 {
  const v = __anyArg(args, k);
  if (v === undefined) {
    return d;
  }
  const n: number = +v;
  if (n !== n) {
    return 0;
  }
  if (n >= 9007199254740992) {
    return 9223372036854775807;
  }
  if (n <= -9007199254740992) {
    return -9223372036854775807;
  }
  return Math.trunc(n) as i64;
}

/** Argument `k` as JavaScript's `ToString` writes it (`"undefined"` when left out). */
function __anyStrArg(args: any[], k: i64): string {
  return __anyString(__anyArg(args, k), "");
}

/** The function argument `k` of an array method, or Node's `TypeError`. */
function __anyFnArg(args: any[], k: i64): any {
  const f = __anyArg(args, k);
  if (typeof f !== "function") {
    const t = typeof f;
    const what =
      f === undefined || f === null
        ? __anyText(f, "")
        : t === "object"
          ? "#<Object>"
          : t === "string" ? `${t} "${__anyText(f, "")}"` : `${t} ${__anyText(f, "")}`;
    panic(`TypeError: ${what} is not a function`);
  }
  return f;
}

// Strings.

export function __anyStr_trim(s: string, args: any[]): any {
  return s.trim();
}

export function __anyStr_trimStart(s: string, args: any[]): any {
  return s.trimStart();
}

export function __anyStr_trimEnd(s: string, args: any[]): any {
  return s.trimEnd();
}

export function __anyStr_toUpperCase(s: string, args: any[]): any {
  return s.toUpperCase();
}

export function __anyStr_toLowerCase(s: string, args: any[]): any {
  return s.toLowerCase();
}

export function __anyStr_toString(s: string, args: any[]): any {
  return s;
}

export function __anyStr_valueOf(s: string, args: any[]): any {
  return s;
}

export function __anyStr_slice(s: string, args: any[]): any {
  return s.slice(__anyIntArg(args, 0, 0), __anyIntArg(args, 1, 9223372036854775807));
}

export function __anyStr_substring(s: string, args: any[]): any {
  return s.substring(__anyIntArg(args, 0, 0), __anyIntArg(args, 1, 9223372036854775807));
}

export function __anyStr_indexOf(s: string, args: any[]): any {
  return s.indexOf(__anyStrArg(args, 0), __anyIntArg(args, 1, 0)) as number;
}

export function __anyStr_lastIndexOf(s: string, args: any[]): any {
  return s.lastIndexOf(__anyStrArg(args, 0), __anyIntArg(args, 1, 9223372036854775807)) as number;
}

export function __anyStr_includes(s: string, args: any[]): any {
  const from = __anyIntArg(args, 1, 0);
  return s.indexOf(__anyStrArg(args, 0), from < 0 ? 0 : from) >= 0;
}

export function __anyStr_startsWith(s: string, args: any[]): any {
  const from = __anyIntArg(args, 1, 0);
  return s.slice(from < 0 ? 0 : from).startsWith(__anyStrArg(args, 0));
}

export function __anyStr_endsWith(s: string, args: any[]): any {
  const end = __anyIntArg(args, 1, 9223372036854775807);
  return s.slice(0, end < 0 ? 0 : end).endsWith(__anyStrArg(args, 0));
}

export function __anyStr_split(s: string, args: any[]): any {
  // The limit is `ToUint32` (`-1` is 4294967295), converted before the separator.
  const limit = __anyArg(args, 1);
  const lim: number = limit === undefined ? 4294967295 : __anyUint32(+limit);
  if (lim === 0) {
    const none: string[] = [];
    return none;
  }
  if (__anyArg(args, 0) === undefined) {
    const whole: string[] = [s.slice(0)];
    return whole;
  }
  const parts = s.split(__anyStrArg(args, 0));
  if (lim < (parts.length as number)) {
    return parts.slice(0, lim as i64);
  }
  return parts;
}

/** JavaScript's `ToUint32` of the number `n`. */
function __anyUint32(n: number): number {
  if (n !== n || n === Infinity || n === -Infinity) {
    return 0;
  }
  const r = Math.trunc(n) % 4294967296;
  return r < 0 ? r + 4294967296 : r;
}

export function __anyStr_replace(s: string, args: any[]): any {
  return s.replace(__anyStrArg(args, 0), __anyStrArg(args, 1));
}

export function __anyStr_replaceAll(s: string, args: any[]): any {
  return s.replaceAll(__anyStrArg(args, 0), __anyStrArg(args, 1));
}

export function __anyStr_charAt(s: string, args: any[]): any {
  return s.charAt(__anyIntArg(args, 0, 0));
}

export function __anyStr_charCodeAt(s: string, args: any[]): any {
  const i = __anyIntArg(args, 0, 0);
  if (i < 0 || i >= (s.length as i64)) {
    return NaN;
  }
  return s.charCodeAt(i) as number;
}

export function __anyStr_codePointAt(s: string, args: any[]): any {
  return s.codePointAt(__anyIntArg(args, 0, 0));
}

export function __anyStr_at(s: string, args: any[]): any {
  return s.at(__anyIntArg(args, 0, 0));
}

export function __anyStr_repeat(s: string, args: any[]): any {
  const n = __anyIntArg(args, 0, 0);
  if (n < 0 || n === 9223372036854775807) {
    panic(`RangeError: Invalid count value: ${__anyText(__anyArg(args, 0), "")}`);
  }
  return s.repeat(n);
}

export function __anyStr_padStart(s: string, args: any[]): any {
  const fill = __anyArg(args, 1) === undefined ? " " : __anyStrArg(args, 1);
  return s.padStart(__anyIntArg(args, 0, 0), fill);
}

export function __anyStr_padEnd(s: string, args: any[]): any {
  const fill = __anyArg(args, 1) === undefined ? " " : __anyStrArg(args, 1);
  return s.padEnd(__anyIntArg(args, 0, 0), fill);
}

export function __anyStr_concat(s: string, args: any[]): any {
  let out = s;
  for (let k: i64 = 0; k < (args.length as i64); k++) {
    out += __anyStrArg(args, k);
  }
  return out;
}

export function __anyStr_localeCompare(s: string, args: any[]): any {
  return s.localeCompare(__anyStrArg(args, 0)) as number;
}

// Numbers and booleans.

export function __anyNum_toFixed(n: number, args: any[]): any {
  return n.toFixed(__anyIntArg(args, 0, 0));
}

export function __anyNum_toString(n: number, args: any[]): any {
  const radix = __anyArg(args, 0);
  if (radix === undefined) {
    return __anyText(n, "");
  }
  return n.toString(__anyIntArg(args, 0, 10) as number);
}

export function __anyNum_toPrecision(n: number, args: any[]): any {
  const p = __anyArg(args, 0);
  if (p === undefined) {
    return __anyText(n, "");
  }
  return n.toPrecision(+p);
}

export function __anyNum_valueOf(n: number, args: any[]): any {
  return n;
}

export function __anyBool_toString(b: boolean, args: any[]): any {
  return b ? "true" : "false";
}

export function __anyBool_valueOf(b: boolean, args: any[]): any {
  return b;
}

// Arrays: `T` is the element type of the array held; arguments are converted to it as
// `x as T` converts them (a value of another type is a `TypeError`), elements go to callbacks
// and back as `any`.

/** The position `i` (`ToIntegerOrInfinity`, negative from the end) clamped to `0..=n`. */
function __anyPos(i: i64, n: i64): i64 {
  if (i < 0) {
    return i + n < 0 ? 0 : i + n;
  }
  return i > n ? n : i;
}

export function __anyArr_push<T>(a: T[], args: any[]): any {
  for (let k: i64 = 0; k < (args.length as i64); k++) {
    a.push(args[k as usize] as T);
  }
  return a.length as number;
}

export function __anyArr_pop<T>(a: T[], args: any[]): any {
  return a.pop();
}

export function __anyArr_shift<T>(a: T[], args: any[]): any {
  return a.shift();
}

export function __anyArr_unshift<T>(a: T[], args: any[]): any {
  const items: T[] = [];
  for (let k: i64 = 0; k < (args.length as i64); k++) {
    items.push(args[k as usize] as T);
  }
  a.unshift(...items);
  return a.length as number;
}

export function __anyArr_splice<T>(a: T[], args: any[]): any {
  const n = a.length as i64;
  const start = __anyPos(__anyIntArg(args, 0, 0), n);
  let count =
    (args.length as i64) === 0
      ? 0
      : (args.length as i64) === 1 ? n - start : __anyIntArg(args, 1, 0);
  count = count < 0 ? 0 : count > n - start ? n - start : count;
  const items: T[] = [];
  for (let k: i64 = 2; k < (args.length as i64); k++) {
    items.push(args[k as usize] as T);
  }
  return a.splice(start, count, ...items);
}

export function __anyArr_slice<T>(a: T[], args: any[]): any {
  return a.slice(__anyIntArg(args, 0, 0), __anyIntArg(args, 1, 9223372036854775807));
}

export function __anyArr_at<T>(a: T[], args: any[]): any {
  return a.at(__anyIntArg(args, 0, 0));
}

export function __anyArr_reverse<T>(a: T[], args: any[]): any {
  a.reverse();
  return a;
}

export function __anyArr_sort<T>(a: T[], args: any[]): any {
  const f = __anyArg(args, 0);
  if (f === undefined) {
    a.sort((x: T, y: T): number => __anySortDefault(x, y));
    return a;
  }
  if (typeof f !== "function") {
    panic(
      `TypeError: The comparison function must be either a function or undefined: ${__anyText(f, "")}`,
    );
  }
  a.sort((x: T, y: T): number => {
    const ex: any = x;
    const ey: any = y;
    // `SortCompare` puts `undefined` last before it calls the comparator.
    if (ex === undefined || ey === undefined) {
      return __anySortDefault(ex, ey);
    }
    // The comparator's result is `ToNumber`ed; `NaN` counts as equal.
    const n: number = +f(ex, ey);
    return n !== n ? 0 : n;
  });
  return a;
}

/** `sort`'s default order: by `ToString`, `undefined` last. */
function __anySortDefault(x: any, y: any): number {
  if (x === undefined) {
    return y === undefined ? 0 : 1;
  }
  if (y === undefined) {
    return -1;
  }
  const sx = __anyString(x, "");
  const sy = __anyString(y, "");
  return sx < sy ? -1 : sx > sy ? 1 : 0;
}

export function __anyArr_concat<T>(a: T[], args: any[]): any {
  const out: any[] = [];
  for (let i: usize = 0; i < a.length; i++) {
    out.push(a[i]);
  }
  for (let k: i64 = 0; k < (args.length as i64); k++) {
    const x = args[k as usize];
    if (Array.isArray(x)) {
      for (const y of x) {
        out.push(y);
      }
    } else {
      out.push(x);
    }
  }
  return out;
}

export function __anyArr_indexOf<T>(a: T[], args: any[]): any {
  const x = __anyArg(args, 0);
  const n = a.length as i64;
  for (let i = __anyPos(__anyIntArg(args, 1, 0), n); i < n; i++) {
    const e: any = a[i as usize];
    if (e === x) {
      return i as number;
    }
  }
  return -1;
}

export function __anyArr_lastIndexOf<T>(a: T[], args: any[]): any {
  const x = __anyArg(args, 0);
  const n = a.length as i64;
  let i = (args.length as i64) > 1 ? __anyIntArg(args, 1, 0) : n - 1;
  i = i < 0 ? i + n : i >= n ? n - 1 : i;
  for (; i >= 0; i--) {
    const e: any = a[i as usize];
    if (e === x) {
      return i as number;
    }
  }
  return -1;
}

export function __anyArr_includes<T>(a: T[], args: any[]): any {
  const x = __anyArg(args, 0);
  const n = a.length as i64;
  for (let i = __anyPos(__anyIntArg(args, 1, 0), n); i < n; i++) {
    const e: any = a[i as usize];
    // SameValueZero: `NaN` is found.
    if (e === x || (e !== e && x !== x)) {
      return true;
    }
  }
  return false;
}

export function __anyArr_map<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  const out: any[] = [];
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    out.push(f(e, i as number, a));
  }
  return out;
}

export function __anyArr_forEach<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    f(e, i as number, a);
  }
  return undefined;
}

export function __anyArr_filter<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  const out: T[] = [];
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    if (f(e, i as number, a)) {
      out.push(a[i]);
    }
  }
  return out;
}

export function __anyArr_find<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    if (f(e, i as number, a)) {
      return e;
    }
  }
  return undefined;
}

export function __anyArr_findIndex<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    if (f(e, i as number, a)) {
      return i as number;
    }
  }
  return -1;
}

export function __anyArr_some<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    if (f(e, i as number, a)) {
      return true;
    }
  }
  return false;
}

export function __anyArr_every<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  for (let i: usize = 0; i < a.length; i++) {
    const e: any = a[i];
    if (!f(e, i as number, a)) {
      return false;
    }
  }
  return true;
}

export function __anyArr_reduce<T>(a: T[], args: any[]): any {
  const f = __anyFnArg(args, 0);
  let i: usize = 0;
  let acc: any = undefined;
  if ((args.length as i64) > 1) {
    acc = args[1];
  } else {
    if (a.length === 0) {
      panic("TypeError: Reduce of empty array with no initial value");
    }
    acc = a[0];
    i = 1;
  }
  for (; i < a.length; i++) {
    const e: any = a[i];
    acc = f(acc, e, i as number, a);
  }
  return acc;
}

export function __anyArr_toString<T>(a: T[], args: any[]): any {
  const v: any = a;
  return __anyJoin(v, ",", "");
}
