// velt/random (internal): the per-thread fast generator: floats in [0, 1) and integers in a range.

import { nextF64, nextU64 } from "velt/lang/random/wyrand";

/** A number in [0, 1) (53 random bits), like `Math.random()`. */
export function random(): f64 {
  return nextF64();
}

/** An integer in [min, max), uniformly distributed; `min` when `max <= min`. */
export function randomInt(min: i64, max: i64): i64 {
  if (max <= min) {
    return min;
  }
  // Lemire's multiply-shift, rejecting the biased low range. Unsigned, so the widest span fits.
  const base = min as u64;
  const span = (max as u64) - base;
  const zero: u64 = 0;
  const threshold = (zero - span) % span;
  while (true) {
    const r = nextU64();
    if (r * span >= threshold) {
      return (base + Math.umulh(r, span)) as i64;
    }
  }
}
