// std/crypto: SHA-256 and SHA-1 (FIPS 180-4), HMAC (RFC 2104), secure random bytes/integers
// and constant-time comparison.
//
// The hashes and HMACs run in the runtime, on the CPU's SHA instructions where it has them.
// Randomness comes from the OS generator through the runtime. SHA-1 is broken for collision
// resistance: use it only for legacy protocols (WebSocket handshakes, HMAC-SHA1 in TOTP, git
// object ids).

import { utf8Encode, hexEncode } from "velt:encoding";

// `(uint64_t n, VeltBytes* out)`: `n` bytes from the OS CSPRNG.
declare function velt_rt_random_bytes(n: u64): u8[];
// A uniformly random `u64` from the OS CSPRNG.
declare function velt_rt_random_u64(): u64;
// `(const VeltBytes* data, VeltBytes* out)`: the digest as a new buffer.
declare function velt_rt_sha256(data: u8[]): u8[];
declare function velt_rt_sha1(data: u8[]): u8[];
// `(const VeltBytes* key, const VeltBytes* data, VeltBytes* out)`: the MAC as a new buffer.
declare function velt_rt_hmac_sha256(key: u8[], data: u8[]): u8[];
declare function velt_rt_hmac_sha1(key: u8[], data: u8[]): u8[];

/** Thrown by `randomInt` for an empty or too large range, or a bound that is not a safe integer. */
export class CryptoError extends Error {
  constructor(message: string) {
    super(message);
  }
}

// ───────────────────────────── hashes ─────────────────────────────

/** SHA-256 digest (32 bytes) of `data`. */
export function sha256(data: u8[]): u8[] {
  return velt_rt_sha256(data);
}

/** Lowercase hex SHA-256 of the UTF-8 bytes of `s`. */
export function sha256Hex(s: string): string {
  return hexEncode(sha256(utf8Encode(s)));
}

/** SHA-1 digest (20 bytes) of `data`. Not collision resistant; see the module comment. */
export function sha1(data: u8[]): u8[] {
  return velt_rt_sha1(data);
}

/** Lowercase hex SHA-1 of the UTF-8 bytes of `s`. */
export function sha1Hex(s: string): string {
  return hexEncode(sha1(utf8Encode(s)));
}

// ───────────────────────────── HMAC ─────────────────────────────

/** HMAC-SHA256 (RFC 2104 / RFC 4231) of `data` under `key`. */
export function hmacSha256(key: u8[], data: u8[]): u8[] {
  return velt_rt_hmac_sha256(key, data);
}

/** HMAC-SHA1 (RFC 2104 / RFC 2202) of `data` under `key`. */
export function hmacSha1(key: u8[], data: u8[]): u8[] {
  return velt_rt_hmac_sha1(key, data);
}

// ───────────────────────── randomness, comparison ─────────────────────────

/** `n` cryptographically secure random bytes (OS generator). */
export function randomBytes(n: usize): u8[] {
  return velt_rt_random_bytes(n as u64);
}

// The largest integer a JS number holds exactly (`Number.MAX_SAFE_INTEGER`).
const MAX_SAFE_INTEGER: i64 = 9007199254740991;
// The largest `max - min` Node's `randomInt` accepts (2^48 - 1).
const RANDOM_INT_RANGE: i64 = 281474976710655;

/**
 * A uniformly distributed secure random integer in [min, max) (Node's `crypto.randomInt`);
 * rejection sampling avoids modulo bias. Throws `CryptoError`, with Node's messages, when `min`
 * or `max` is not a safe integer, `max <= min`, or `max - min` is 2^48 or more.
 */
export function randomInt(min: i64, max: i64): i64 {
  checkSafeInteger("min", min);
  checkSafeInteger("max", max);
  if (max <= min) {
    throw new CryptoError(
      `The value of "max" is out of range. It must be greater than the value of "min" (${min}). Received ${received(max)}`,
    );
  }
  if (max - min > RANDOM_INT_RANGE) {
    throw new CryptoError(
      `The value of "max - min" is out of range. It must be <= ${RANDOM_INT_RANGE}. Received ${received(max - min)}`,
    );
  }
  const range = (max - min) as u64;
  // 2^64 mod range: draws below it would make the low residues more likely.
  const reject = (0 - range) % range;
  while (true) {
    const r = velt_rt_random_u64();
    if (r >= reject) {
      return min + ((r % range) as i64);
    }
  }
}

// Node's check of a `randomInt` bound.
function checkSafeInteger(name: string, n: i64) {
  if (n < -MAX_SAFE_INTEGER || n > MAX_SAFE_INTEGER) {
    throw new CryptoError(
      `The "${name}" argument must be a safe integer. Received type number (${n})`,
    );
  }
}

// A number as Node's range errors write what they received: beyond 2^32, in groups of three
// digits separated by `_` (`1_000_000_000_000`).
function received(n: i64): string {
  const s = `${n}`;
  if (n >= -4294967296 && n <= 4294967296) {
    return s;
  }
  const start: i64 = n < 0 ? 1 : 0;
  let out = "";
  let i = s.length as i64;
  while (i >= start + 4) {
    out = `_${s.slice(i - 3, i)}${out}`;
    i -= 3;
  }
  return `${s.slice(0, i)}${out}`;
}

/**
 * Whether `a` and `b` are equal, in time that depends only on their lengths (not on where they
 * differ), for comparing MACs and tokens. Different lengths return false at once.
 */
export function timingSafeEqual(a: u8[], b: u8[]): bool {
  if (a.length != b.length) {
    return false;
  }
  let diff: u8 = 0;
  for (let i: usize = 0; i < a.length; i++) {
    diff = diff | (a[i] ^ b[i]);
  }
  return diff == 0;
}
