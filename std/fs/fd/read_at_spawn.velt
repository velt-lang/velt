// velt/fs (internal): the default variant of `#fs-read-at` (std/imports.velt), for the
// runtime's scheduler, which has no way to run Velt code on its blocking pool: the read is a
// task of its own, so it waits for the disk on another worker than the caller's (the runtime
// adds a thread while every worker is busy).

import { ReadChunk, readChunk } from "velt/fs/fd/read_chunk";

async function readTask(fd: i32, length: usize, position: i64): Promise<ReadChunk> {
  return readChunk(fd, length, position);
}

/** `readChunk` as a task of its own. */
export async function readChunkLater(fd: i32, length: usize, position: i64): Promise<ReadChunk> {
  return await spawn(readTask(fd, length, position));
}
