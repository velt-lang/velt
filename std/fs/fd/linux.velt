// velt/fs (internal): the `#fd-system` variant of Linux (std/imports.velt): posix.velt's safe
// functions, with Linux's `fcntl` commands, `fdatasync` and `struct stat` (glibc and musl agree
// on it per architecture).

import { arch } from "velt/os/machine";
import { linuxOpenDir, Stat } from "velt/fs/fd/system";
import {
  closeFd as posixCloseFd,
  fstatAt as posixFstatAt,
  statAt as posixStatAt,
  fsyncFd as posixFsyncFd,
  adviseMap as posixAdviseMap,
  fcntlLock as posixFcntlLock,
  lastError as posixLastError,
  mapRead as posixMapRead,
  openPath as posixOpenPath,
  readAddress as posixReadAddress,
  readInto as posixReadInto,
  truncateFd as posixTruncateFd,
  unlinkPath as posixUnlinkPath,
  writeAddress as posixWriteAddress,
  writeFrom as posixWriteFrom,
} from "velt/fs/fd/posix";
import { checkPath } from "velt/fs/fd/guards";
import {
  DirSystem,
  listPath as posixListPath,
  removeDir as posixRemoveDir,
  removeTree as posixRemoveTree,
} from "velt/fs/fd/dirs";

declare c("c", { errno: true }) function fdatasync(fd: i32): i32;
/** `mode_t` is 32 bits on Linux. */
declare c("c", { errno: true }) function mkdir(path: readonly u8[], mode: u32): i32;

/** Flushes the file's data and metadata to the disk: 0, or -1. */
export function syncAll(fd: i32): i32 {
  return posixFsyncFd(fd);
}

/** Flushes the file's data to the disk: 0, or -1. */
export function syncData(fd: i32): i32 {
  // SAFETY: an integer argument only.
  return unsafe { fdatasync(fd) };
}

/**
 * Takes (`mode` 1 shared, 2 exclusive) or gives back (0) a lock on the `len` bytes from `start`
 * of the file `fd` is open on, held by the open file (`F_OFD_SETLK`, 37), never waiting: 0, 1
 * when another holder has a conflicting lock, or -1 with the error for `lastError()`.
 * `struct flock` on x86-64 and arm64: `l_type` at 0 (`F_RDLCK` 0, `F_WRLCK` 1, `F_UNLCK` 2),
 * `l_whence` at 2, `l_start` at 8, `l_len` at 16, `l_pid` at 24.
 */
export function lockRange(fd: i32, mode: i32, start: i64, len: i64): i32 {
  const kind: i16 = mode == 1 ? 0 : mode == 2 ? 1 : 2;
  const rc = posixFcntlLock(fd, 37, kind, start, len, {
    kind: 0,
    whence: 2,
    start: 8,
    len: 16,
    size: 32,
  });
  if (rc == 0) {
    return 0;
  }
  // EAGAIN (11) or EACCES (13): the range is taken.
  const e = posixLastError();
  return e == 11 || e == 13 ? 1 : -1;
}

/**
 * `fstat(fd)`'s fields, or `null` (the error for `lastError()`): `st_mode` at 24 on x86-64 and 16
 * on arm64 (the generic layout), `st_size` at 48 and the times from 72 on both.
 */
export function fstatFd(fd: i32): Stat | null {
  if (arch() == "x64") {
    return posixFstatAt(fd, 24, false, 48, 88);
  }
  return posixFstatAt(fd, 16, false, 48, 88);
}

/** `stat(path)` (`follow`) or `lstat(path)`'s fields, at `fstatFd`'s offsets, or `null`. */
export function statPath(path: readonly u8[], follow: bool): Stat | null {
  if (arch() == "x64") {
    return posixStatAt(path, follow, 24, false, 48, 88);
  }
  return posixStatAt(path, follow, 16, false, 48, 88);
}

// The functions both POSIX variants share, from posix.velt (a variant defines what it exports:
// `velt check` compares the variants' own signatures).

/** The `errno` of the last failed call of these functions on this thread. */
export function lastError(): i32 {
  return posixLastError();
}

/** `open(path, oflag, mode)`: a descriptor, or -1. */
export function openPath(path: readonly u8[], oflag: i32, mode: u32): i32 {
  return posixOpenPath(path, oflag, mode);
}

/** `close(fd)`: 0, or -1. */
export function closeFd(fd: i32): i32 {
  return posixCloseFd(fd);
}

/** `unlink(path)`: 0, or -1. */
export function unlinkPath(path: readonly u8[]): i32 {
  return posixUnlinkPath(path);
}

/** `read` (`at < 0`) or `pread` at `at` into the bytes `start..end` of `bytes`, or -1. */
export function readInto(fd: i32, bytes: u8[], start: usize, end: usize, at: i64): isize {
  return posixReadInto(fd, bytes, start, end, at);
}

/** `write` (`at < 0`) or `pwrite` at `at` of the bytes `start..end` of `bytes`, or -1. */
export function writeFrom(fd: i32, bytes: readonly u8[], start: usize, end: usize, at: i64): isize {
  return posixWriteFrom(fd, bytes, start, end, at);
}

/** `ftruncate(fd, length)`: 0, or -1. */
export function truncateFd(fd: i32, length: i64): i32 {
  return posixTruncateFd(fd, length);
}

/** Maps the `len` bytes of `fd` from byte `offset` read-only: the address, or 0. */
export function mapRead(fd: i32, len: usize, offset: i64): usize {
  return posixMapRead(fd, len, offset);
}

/** `madvise` on part of a mapping of `mapRead`: 0, or -1. */
export function adviseMap(address: usize, len: usize, advice: i32): i32 {
  return posixAdviseMap(address, len, advice);
}

/** `read` or `pread` into the memory at `address`: the number read, or -1. Unsafe: as posix.velt's. */
export unsafe function readAddress(fd: i32, address: usize, len: usize, at: i64): isize {
  // SAFETY: the caller's statement, handed on.
  return unsafe { posixReadAddress(fd, address, len, at) };
}

/** `write` or `pwrite` of the memory at `address`: the number written, or -1. Unsafe: as posix.velt's. */
export unsafe function writeAddress(fd: i32, address: usize, len: usize, at: i64): isize {
  // SAFETY: the caller's statement, handed on.
  return unsafe { posixWriteAddress(fd, address, len, at) };
}

// Directories (std/fs/fd/dirs.velt), with Linux's `struct dirent`, `open` flags and `AT_`
// constants.

/**
 * Linux's `struct dirent` on a 64-bit target (glibc and musl agree): `d_type` at 18, `d_name` at
 * 19. The `open` flags are the architecture's (`linuxOpenDir`). `AT_FDCWD` -100,
 * `AT_REMOVEDIR` 0x200; `ELOOP` 40.
 */
function dirSystem(): DirSystem {
  return {
    typeAt: 18,
    nameAt: 19,
    openDir: linuxOpenDir(arch()),
    cwd: -100,
    removeDir: 0x200,
    loop: 40,
  };
}

/**
 * The entries of the directory at `path` into `names` and `types` (`d_type`, from `unknown` for
 * an entry that has none): 0, or the errno.
 */
export function listDir(
  path: readonly u8[],
  names: string[],
  types: u8[],
  unknown: ((child: readonly u8[]) => u8) | null,
): i32 {
  return posixListPath(path, dirSystem(), names, types, unknown);
}

/** `mkdir(path, mode)`: 0, or -1. */
export function makeDir(path: readonly u8[], mode: u32): i32 {
  checkPath("mkdir", path);
  // SAFETY: `path` ends with its only 0 byte (checked above); C keeps no pointer to it.
  return unsafe { mkdir(path, mode) };
}

/** `rmdir(path)`: 0, or -1. */
export function removeDir(path: readonly u8[]): i32 {
  return posixRemoveDir(path);
}

/** Removes the directory at `path` and everything in it, following no link: 0, or the errno. */
export function removeTree(path: readonly u8[]): i32 {
  const sys = dirSystem();
  if (sys.openDir == 0) {
    // No flags for this architecture: nothing is opened, so nothing is removed (ENOSYS).
    return 38;
  }
  return posixRemoveTree(sys.cwd, path, sys, true);
}
