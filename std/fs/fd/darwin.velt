// velt/fs (internal): the `#fd-system` variant of macOS (std/imports.velt): posix.velt's safe
// functions, with macOS's `fcntl` commands and `struct stat`. `fsync` is `F_FULLFSYNC` (to the
// disk itself), else `F_BARRIERFSYNC`, else `fsync`, as libuv does.

import { arch } from "velt/os/machine";
import { Stat } from "velt/fs/fd/system";
import {
  closeFd as posixCloseFd,
  fcntlInt as posixFcntlInt,
  fstatAt as posixFstatAt,
  statAt as posixStatAt,
  fsyncFd as posixFsyncFd,
  adviseMap as posixAdviseMap,
  lastError as posixLastError,
  mapRead as posixMapRead,
  openPath as posixOpenPath,
  readInto as posixReadInto,
  truncateFd as posixTruncateFd,
  unlinkPath as posixUnlinkPath,
  writeFrom as posixWriteFrom,
} from "velt/fs/fd/posix";
import { checkPath } from "velt/fs/fd/guards";
import {
  DirSystem,
  listPath as posixListPath,
  removeDir as posixRemoveDir,
  removeTree as posixRemoveTree,
} from "velt/fs/fd/dirs";

/** `mode_t` is 16 bits on macOS. */
declare c("c", { errno: true }) function mkdir(path: readonly u8[], mode: u16): i32;

/**
 * The `fcntl` commands whose argument is an `int` (or none): `F_GETFD`, `F_SETFD`, `F_GETFL`,
 * `F_SETFL`, `F_NOCACHE`, `F_FULLFSYNC`, `F_BARRIERFSYNC`.
 */
const INT_COMMANDS: i32[] = [1, 2, 3, 4, 48, 51, 85];
const F_FULLFSYNC: i32 = 51;
const F_BARRIERFSYNC: i32 = 85;

function fullSync(fd: i32): i32 {
  if (posixFcntlInt(fd, F_FULLFSYNC, 0, INT_COMMANDS) == 0) {
    return 0;
  }
  if (posixFcntlInt(fd, F_BARRIERFSYNC, 0, INT_COMMANDS) == 0) {
    return 0;
  }
  return posixFsyncFd(fd);
}

/** Flushes the file's data and metadata to the disk: 0, or -1. */
export function syncAll(fd: i32): i32 {
  return fullSync(fd);
}

/** Flushes the file's data to the disk: 0, or -1. */
export function syncData(fd: i32): i32 {
  return fullSync(fd);
}

/**
 * `fstat(fd)`'s fields, or `null` (the error for `lastError()`). On arm64 `fstat` fills the
 * 64-bit-inode `struct stat`; on x86-64 the symbol `fstat` is the 32-bit-inode one
 * (`fstat$INODE64` is the other), with `st_mode` at 8, the times from 24 and `st_size` at 72.
 */
export function fstatFd(fd: i32): Stat | null {
  if (arch() == "x64") {
    return posixFstatAt(fd, 8, true, 72, 40);
  }
  return posixFstatAt(fd, 4, true, 96, 48);
}

/**
 * `stat(path)` (`follow`) or `lstat(path)`'s fields, at `fstatFd`'s offsets (on x86-64 the
 * symbols `stat` and `lstat` are the 32-bit-inode ones too), or `null`.
 */
export function statPath(path: readonly u8[], follow: bool): Stat | null {
  if (arch() == "x64") {
    return posixStatAt(path, follow, 8, true, 72, 40);
  }
  return posixStatAt(path, follow, 4, true, 96, 48);
}

// The functions both POSIX variants share, from posix.velt (a variant defines what it exports:
// `velt check` compares the variants' own signatures).

/** The `errno` of the last failed call of these functions on this thread. */
export function lastError(): i32 {
  return posixLastError();
}

/** `open(path, oflag, mode)`: a descriptor, or -1. */
export function openPath(path: readonly u8[], oflag: i32, mode: u32): i32 {
  return posixOpenPath(path, oflag, mode);
}

/** `close(fd)`: 0, or -1. */
export function closeFd(fd: i32): i32 {
  return posixCloseFd(fd);
}

/** `unlink(path)`: 0, or -1. */
export function unlinkPath(path: readonly u8[]): i32 {
  return posixUnlinkPath(path);
}

/** `read` (`at < 0`) or `pread` at `at` into the bytes `start..end` of `bytes`, or -1. */
export function readInto(fd: i32, bytes: u8[], start: usize, end: usize, at: i64): isize {
  return posixReadInto(fd, bytes, start, end, at);
}

/** `write` (`at < 0`) or `pwrite` at `at` of the bytes `start..end` of `bytes`, or -1. */
export function writeFrom(fd: i32, bytes: readonly u8[], start: usize, end: usize, at: i64): isize {
  return posixWriteFrom(fd, bytes, start, end, at);
}

/** `ftruncate(fd, length)`: 0, or -1. */
export function truncateFd(fd: i32, length: i64): i32 {
  return posixTruncateFd(fd, length);
}

/** Maps the first `len` bytes of `fd` read-only: the address, or 0. */
export function mapRead(fd: i32, len: usize): usize {
  return posixMapRead(fd, len);
}

/** `madvise` on part of a mapping of `mapRead`: 0, or -1. */
export function adviseMap(address: usize, len: usize, advice: i32): i32 {
  return posixAdviseMap(address, len, advice);
}

// Directories (std/fs/fd/dirs.velt), with macOS's `struct dirent`, `open` flags and `AT_`
// constants.

/**
 * macOS's `struct dirent`: on arm64 `readdir` fills the 64-bit-inode one (`d_type` at 20,
 * `d_name` at 21); on x86-64 the symbols `opendir`, `fdopendir` and `readdir` are the
 * 32-bit-inode ones, as `fstat` is (`d_type` at 6, `d_name` at 8). `O_NOFOLLOW` 0x100,
 * `O_DIRECTORY` 0x100000, `O_CLOEXEC` 0x1000000; `AT_FDCWD` -2, `AT_REMOVEDIR` 0x80; `ELOOP` 62.
 */
function dirSystem(): DirSystem {
  const x64 = arch() == "x64";
  return {
    typeAt: x64 ? 6 : 20,
    nameAt: x64 ? 8 : 21,
    openDir: 0x1100100,
    cwd: -2,
    removeDir: 0x80,
    loop: 62,
  };
}

/** The entries of the directory at `path` into `names` and `types` (`d_type`): 0, or the errno. */
export function listDir(path: readonly u8[], names: u8[][], types: u8[]): i32 {
  return posixListPath(path, dirSystem(), names, types);
}

/** `mkdir(path, mode)`: 0, or -1. */
export function makeDir(path: readonly u8[], mode: u32): i32 {
  checkPath("mkdir", path);
  // SAFETY: `path` ends with its only 0 byte (checked above); C keeps no pointer to it.
  return unsafe { mkdir(path, mode as u16) };
}

/** `rmdir(path)`: 0, or -1. */
export function removeDir(path: readonly u8[]): i32 {
  return posixRemoveDir(path);
}

/** Removes the directory at `path` and everything in it, following no link: 0, or the errno. */
export function removeTree(path: readonly u8[]): i32 {
  const sys = dirSystem();
  return posixRemoveTree(sys.cwd, path, sys, true);
}
