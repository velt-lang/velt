// velt/fs (internal): what the C library's file-descriptor functions share across targets: the
// fields of `struct stat` `fstatSync` reads, `EINTR` and the platform check. The functions
// themselves are the `#fd-system` variant of the target (std/imports.velt): posix.velt's
// `declare c("c")` declarations behind darwin.velt's and linux.velt's safe wrappers, or
// unsupported.velt where the C library has no such functions.

import { platform } from "velt/os/machine";

/** The fields of `struct stat` `fstatSync` reads (the `#fd-system` variant reads them per target). */
export struct Stat {
  st_mode: u32;
  st_size: i64;
  st_mtime: i64;
  st_mtime_nsec: i64;
}

/** `EINTR`: a signal interrupted the call, which is then made again. */
export const EINTR: i32 = 4;

/** Whether the program runs on macOS, whose `open` flags and errno numbers differ from Linux's. */
export function isMac(): bool {
  return platform() == "darwin";
}
