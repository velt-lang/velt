// velt/fs (internal): the `#fd-system` variant of the targets whose C library has no POSIX file
// descriptors in std yet (Windows, WebAssembly; std/imports.velt): the same functions as
// darwin.velt's and linux.velt's, each failing with `ENOSYS`, which Node's API throws as an
// `IoError`.

import { Stat } from "velt/fs/fd/system";

/** Linux's `ENOSYS`, which velt/fs/errors names: the function is not implemented. */
const ENOSYS: i32 = 38;

export function lastError(): i32 {
  return ENOSYS;
}

export function openPath(path: readonly u8[], oflag: i32, mode: u32): i32 {
  return -1;
}

export function closeFd(fd: i32): i32 {
  return -1;
}

export function unlinkPath(path: readonly u8[]): i32 {
  return -1;
}

export function readInto(fd: i32, bytes: u8[], start: usize, end: usize, at: i64): isize {
  return -1;
}

export function writeFrom(fd: i32, bytes: readonly u8[], start: usize, end: usize, at: i64): isize {
  return -1;
}

export function lockRange(fd: i32, mode: i32, start: i64, len: i64): i32 {
  return -1;
}

export function syncAll(fd: i32): i32 {
  return -1;
}

export function syncData(fd: i32): i32 {
  return -1;
}

export function truncateFd(fd: i32, length: i64): i32 {
  return -1;
}

export function fstatFd(fd: i32): Stat | null {
  return null;
}

export function statPath(path: readonly u8[], follow: bool): Stat | null {
  return null;
}

export function listDir(
  path: readonly u8[],
  names: string[],
  types: u8[],
  unknown: ((child: readonly u8[]) => u8) | null,
): i32 {
  return ENOSYS;
}

export function makeDir(path: readonly u8[], mode: u32): i32 {
  return -1;
}

export function removeDir(path: readonly u8[]): i32 {
  return -1;
}

export function removeTree(path: readonly u8[]): i32 {
  return ENOSYS;
}

export function mapRead(fd: i32, len: usize, offset: i64): usize {
  return 0;
}

export function adviseMap(address: usize, len: usize, advice: i32): i32 {
  return -1;
}

/** Fails (ENOSYS), touching nothing. Unsafe: only so that it has the variants' signature. */
export unsafe function readAddress(fd: i32, address: usize, len: usize, at: i64): isize {
  return -1;
}

/** Fails (ENOSYS), touching nothing. Unsafe: only so that it has the variants' signature. */
export unsafe function writeAddress(fd: i32, address: usize, len: usize, at: i64): isize {
  return -1;
}
