// velt/fs (internal): reading and writing arrays of numbers through a file descriptor without
// a copy (`readNumbersSync`, `writeNumbersSync`): the array's own bytes are the buffer the
// system call gets.

import { arrayAsBytes } from "velt/lang/intrinsics";
import { EINTR } from "velt/fs/fd/system";
import { lastError, readInto, writeFrom } from "#fd-system";
import { descriptor, integer, MAX_SAFE } from "velt/fs/fd/args";
import { osError } from "velt/fs/errors";

/**
 * Reads values into `into` from the open file `fd`: `count` of them from index `start` on (by
 * default the rest of the array), their bytes as they are in the file (little-endian on every
 * target), at byte `position`, or at the file's own position (which then advances) when
 * `position` is left out or `null`. Nothing is copied: the array's memory is what the system
 * fills. It reads until it has them all or the file ends, and returns how many whole values it
 * read; the bytes of a last, partial value are in the array but not counted.
 *
 *     const row: f32[] = new Array<f32>(128).fill(0);
 *     readNumbersSync(fd, row, 16 + r * 512);
 *
 * `RangeError` for a `start`, `count` or `position` that is not a whole number in range;
 * `IoError` when a read fails.
 */
export function readNumbersSync<T extends Numeric>(
  fd: number,
  into: T[],
  position: number | null = null,
  start: number = 0,
  count?: number,
): number {
  const f = descriptor(fd);
  const total = into.length as i64;
  const from = integer("start", start, 0, total as number);
  const n =
    count === undefined ? total - from : integer("count", count, 0, (total - from) as number);
  let at: i64 = position == null ? -1 : integer("position", position, 0, MAX_SAFE);
  if (n == 0) {
    return 0;
  }
  // SAFETY: `bytes` is `into`'s memory, and `into` is not used again before `bytes` is last
  // used; the system writes only inside it (`readInto` clamps the range to the array), and any
  // bytes are a value of a number type.
  const bytes = unsafe { arrayAsBytes(into) };
  const size = (bytes.length as i64) / total;
  const first = from * size;
  const end = (from + n) * size;
  let b = first;
  while (b < end) {
    const got = readInto(f, bytes, b as usize, end as usize, at);
    if (got < 0) {
      const e = lastError();
      if (e != EINTR) {
        throw osError(e, "read");
      }
      continue;
    }
    if (got == 0) {
      break;
    }
    b += got as i64;
    if (at >= 0) {
      at += got as i64;
    }
  }
  return ((b - first) / size) as number;
}

/**
 * Writes values of `from` to the open file `fd`: `count` of them from index `start` on (by
 * default the rest of the array), as their bytes (little-endian on every target), at byte
 * `position`, or at the file's own position when `position` is left out or `null`. Nothing is
 * copied. It writes until all are written and returns how many values that is.
 *
 * `RangeError` and `IoError` as `readNumbersSync`.
 */
export function writeNumbersSync<T extends Numeric>(
  fd: number,
  from: T[],
  position: number | null = null,
  start: number = 0,
  count?: number,
): number {
  const f = descriptor(fd);
  const total = from.length as i64;
  const first = integer("start", start, 0, total as number);
  const n =
    count === undefined ? total - first : integer("count", count, 0, (total - first) as number);
  let at: i64 = position == null ? -1 : integer("position", position, 0, MAX_SAFE);
  if (n == 0) {
    return 0;
  }
  // SAFETY: `bytes` is `from`'s memory, and `from` is not used again before `bytes` is last
  // used; the system only reads it.
  const bytes = unsafe { arrayAsBytes(from) };
  const size = (bytes.length as i64) / total;
  const end = (first + n) * size;
  let b = first * size;
  while (b < end) {
    const put = writeFrom(f, bytes, b as usize, end as usize, at);
    if (put < 0) {
      const e = lastError();
      if (e != EINTR) {
        throw osError(e, "write");
      }
      continue;
    }
    b += put as i64;
    if (at >= 0) {
      at += put as i64;
    }
  }
  return n as number;
}
