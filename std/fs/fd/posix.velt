// velt/fs (internal): the C library's file-descriptor functions on macOS and Linux, declared with
// `declare c("c")` (checked against each target's headers: `velt native headers --std`), and the
// safe functions darwin.velt and linux.velt export over them. Each call of Node's API is one call
// of the C library. What makes each call sound is checked here, before the `unsafe` block that
// makes it: a path has exactly one 0 byte, its last, and `fcntl` gets only the commands whose
// argument is an `int` (guards.velt); a buffer's range is clamped to the array, and the length C
// gets is that range's.

import { CVarArgs } from "velt/ffi/c_var_args";
import { Ptr } from "velt/ffi/ptr";
import { addressLoad, addressStore } from "velt/lang/intrinsics";
import { keepOsError, lastOsError } from "velt/os/rt";
import { Stat } from "velt/fs/fd/system";
import { checkCommand, checkPath } from "velt/fs/fd/guards";

declare c("c", { errno: true }) function open(
  path: readonly u8[],
  oflag: i32,
  ...args: CVarArgs,
): i32;
declare c("c", { errno: true }) function close(fd: i32): i32;
declare c("c") function read(fd: i32, buf: u8[], nbyte: usize): isize;
declare c("c") function write(fd: i32, buf: readonly u8[], nbyte: usize): isize;
declare c("c") function pread(fd: i32, buf: u8[], nbyte: usize, offset: i64): isize;
declare c("c") function pwrite(fd: i32, buf: readonly u8[], nbyte: usize, offset: i64): isize;
declare c("c") function read$at(fd: i32, buf: Ptr<void>, nbyte: usize): isize;
declare c("c") function pread$at(fd: i32, buf: Ptr<void>, nbyte: usize, offset: i64): isize;
declare c("c") function write$at(fd: i32, buf: Ptr<void>, nbyte: usize): isize;
declare c("c") function pwrite$at(fd: i32, buf: Ptr<void>, nbyte: usize, offset: i64): isize;
declare c("c", { errno: true }) function fsync(fd: i32): i32;
declare c("c", { errno: true }) function fcntl(fd: i32, cmd: i32, ...args: CVarArgs): i32;
declare c("c", { errno: true }) function ftruncate(fd: i32, length: i64): i32;
declare c("c", { errno: true }) function fstat(fd: i32, st: Ptr<void>): i32;
declare c("c", { errno: true }) function stat(path: readonly u8[], st: Ptr<void>): i32;
declare c("c", { errno: true }) function lstat(path: readonly u8[], st: Ptr<void>): i32;
declare c("c", { errno: true }) function unlink(path: readonly u8[]): i32;
declare c("c", { errno: true }) function mmap(
  addr: Ptr<void> | null,
  len: usize,
  prot: i32,
  flags: i32,
  fd: i32,
  offset: i64,
): Ptr<void> | null;
declare c("c", { errno: true }) function madvise(addr: Ptr<void>, len: usize, advice: i32): i32;
declare c("c", { errno: true }) function munmap(addr: Ptr<void>, len: usize): i32;
declare c("c") function malloc(size: usize): Ptr<void> | null;
declare c("c") function free(p: Ptr<void> | null): void;

/** Room for `struct stat` on every target: 144 bytes on macOS and x86-64 Linux, 128 on arm64. */
const STAT_SIZE: usize = 144;

/** The `errno` of the last failed call of this module's functions on this thread. */
export function lastError(): i32 {
  return lastOsError();
}

/** `open(path, oflag, mode)`: a descriptor, or -1. */
export function openPath(path: readonly u8[], oflag: i32, mode: u32): i32 {
  checkPath("open", path);
  // SAFETY: `path` ends with its only 0 byte (checked above), so C reads it and nothing past it;
  // `open` keeps no pointer after it returns, and its third argument is `mode_t`, which a `u32`
  // passes after C's promotions.
  return unsafe { open(path, oflag, mode) };
}

/** `close(fd)`: 0, or -1. */
export function closeFd(fd: i32): i32 {
  // SAFETY: an integer argument only; closing a descriptor Velt code doesn't own is the
  // caller's error, not unsound for this program's memory.
  return unsafe { close(fd) };
}

/** `unlink(path)`: 0, or -1. */
export function unlinkPath(path: readonly u8[]): i32 {
  checkPath("unlink", path);
  // SAFETY: `path` ends with its only 0 byte (checked above); C keeps no pointer to it.
  return unsafe { unlink(path) };
}

/**
 * `read` (`at < 0`) or `pread` at `at` into the bytes `start..end` of `bytes`, that range clamped
 * to the array (as `subarray` clamps it; the callers have checked it against Node's rules
 * already): the number read, or -1 with the error for `lastError()`. Its C functions and
 * `writeFrom`'s are declared without `{ errno: true }`: `errno` is read only when a call fails
 * (`keepOsError`, out of line), not after every one, which keeps both small enough to inline into
 * `readSync` and `writeSync` and those into their callers, whose constant arguments then fold
 * into Node's checks.
 */
export function readInto(fd: i32, bytes: u8[], start: usize, end: usize, at: i64): isize {
  const len = bytes.length as usize;
  const e = end < len ? end : len;
  const b = start < e ? start : e;
  let r: isize;
  if (at < 0) {
    // SAFETY: `b..e` is inside `bytes` (clamped above) and C gets its length, so it writes only
    // those bytes; it keeps no pointer after it returns, and nothing else uses `bytes` during
    // the call.
    r = unsafe { read(fd, bytes.subarray(b, e), e - b) };
  } else {
    // SAFETY: as for `read` above.
    r = unsafe { pread(fd, bytes.subarray(b, e), e - b, at) };
  }
  if (r < 0) {
    keepOsError();
  }
  return r;
}

/**
 * `write` (`at < 0`) or `pwrite` at `at` of the bytes `start..end` of `bytes`, clamped as in
 * `readInto`: the number written, or -1 with the error for `lastError()`.
 */
export function writeFrom(fd: i32, bytes: readonly u8[], start: usize, end: usize, at: i64): isize {
  const len = bytes.length as usize;
  const e = end < len ? end : len;
  const b = start < e ? start : e;
  let r: isize;
  if (at < 0) {
    // SAFETY: `b..e` is inside `bytes` (clamped above) and C gets its length, so it reads only
    // those bytes, and keeps no pointer after it returns.
    r = unsafe { write(fd, bytes.subarray(b, e), e - b) };
  } else {
    // SAFETY: as for `write` above.
    r = unsafe { pwrite(fd, bytes.subarray(b, e), e - b, at) };
  }
  if (r < 0) {
    keepOsError();
  }
  return r;
}

/** `fsync(fd)`: 0, or -1. */
export function fsyncFd(fd: i32): i32 {
  // SAFETY: an integer argument only.
  return unsafe { fsync(fd) };
}

/** `ftruncate(fd, length)`: 0, or -1. */
export function truncateFd(fd: i32, length: i64): i32 {
  // SAFETY: integer arguments only.
  return unsafe { ftruncate(fd, length) };
}

/**
 * `fcntl(fd, cmd, arg)` for a command of `intCommands`, those whose argument is an `int` (or
 * none): 0 or more, or -1. Stops the program for any other command, which would read its
 * argument as a pointer (`F_GETLK`'s `struct flock *`).
 */
export function fcntlInt(fd: i32, cmd: i32, arg: i32, intCommands: i32[]): i32 {
  checkCommand("fcntl", cmd, intCommands);
  // SAFETY: `cmd` is one of the commands whose argument is an `int` (checked above), so C reads
  // `arg` as one and touches no memory through it.
  return unsafe { fcntl(fd, cmd, arg) };
}

/** Where a target's `struct flock` has its fields, and its size (all at most 32 bytes). */
export struct FlockLayout {
  kind: usize;
  whence: usize;
  start: usize;
  len: usize;
  size: usize;
}

/**
 * `fcntl(fd, cmd, &lock)` for a lock command `cmd` of the target (one that reads a
 * `struct flock *`: the caller's variant names its own, `F_OFD_SETLK` and its like), with a lock
 * of type `kind` on the `len` bytes from `start` of the file (`SEEK_SET`; a `len` of 0 is to
 * the end and beyond) and `l_pid` 0: 0, or -1 with the error for `lastError()`.
 */
export function fcntlLock(
  fd: i32,
  cmd: i32,
  kind: i16,
  start: i64,
  len: i64,
  at: FlockLayout,
): i32 {
  const inside =
    at.kind + 2 <= at.size &&
    at.whence + 2 <= at.size &&
    at.start + 8 <= at.size &&
    at.len + 8 <= at.size;
  if (at.size > 32 || !inside) {
    panic("fcntl: a field's offset is past the end of struct flock");
  }
  // SAFETY: malloc's result is checked before use and freed once below.
  const lock = unsafe { malloc(32) };
  if (lock === null) {
    panic("fcntl: out of memory");
  }
  const p = Ptr.addressOf(lock);
  // SAFETY: the block has 32 bytes, aligned for every field; the offsets are inside the
  // target's `struct flock` (checked above), which `fcntl` reads and, for these commands,
  // does not keep. Zeroed first: `l_pid` must be 0 for an open file description lock.
  unsafe {
    for (let i: usize = 0; i < 32; i += 8) {
      addressStore<u64>(p + i, 0);
    }
    addressStore<i16>(p + at.kind, kind);
    addressStore<i16>(p + at.whence, 0);
    addressStore<i64>(p + at.start, start);
    addressStore<i64>(p + at.len, len);
  }
  // SAFETY: `cmd` reads a `struct flock *` (the caller's statement), and `lock` is one.
  const rc = unsafe { fcntl(fd, cmd, lock) };
  // SAFETY: `lock` came from malloc and is freed once. (`free` is declared without `errno`,
  // so the error `fcntl` left stays for `lastError()`.)
  unsafe {
    free(lock);
  }
  return rc;
}

/**
 * `fstat(fd)` with the fields at these byte offsets of `struct stat`: the fields, or `null` with
 * the error for `lastError()`. `mode16`: `st_mode` is a 16-bit `mode_t` and `st_dev` a 32-bit
 * `dev_t` (macOS's); `ino32`: `st_ino` is a 32-bit inode at 4 (macOS x86-64's legacy
 * `struct stat`), else a 64-bit one at 8. `st_dev` is at 0 on every target.
 */
export function fstatAt(
  fd: i32,
  mode: usize,
  mode16: bool,
  size: usize,
  mtime: usize,
  ino32: bool,
): Stat | null {
  return statWith(fd, null, false, mode, mode16, size, mtime, ino32);
}

/**
 * `stat(path)` (`follow`) or `lstat(path)`, with the fields at these offsets as `fstatAt` reads
 * them: the fields, or `null` with the error for `lastError()`.
 */
export function statAt(
  path: readonly u8[],
  follow: bool,
  mode: usize,
  mode16: bool,
  size: usize,
  mtime: usize,
  ino32: bool,
): Stat | null {
  checkPath(follow ? "stat" : "lstat", path);
  return statWith(-1, path, follow, mode, mode16, size, mtime, ino32);
}

/** `fstat(fd)`, or with a `path` (checked by the caller) `stat` or `lstat` of it. */
function statWith(
  fd: i32,
  path: (readonly u8[]) | null,
  follow: bool,
  mode: usize,
  mode16: bool,
  size: usize,
  mtime: usize,
  ino32: bool,
): Stat | null {
  if (mode + 4 > STAT_SIZE || size + 8 > STAT_SIZE || mtime + 16 > STAT_SIZE) {
    panic("fstat: a field's offset is past the end of struct stat");
  }
  // SAFETY: malloc's result is checked before use and freed once below.
  const st = unsafe { malloc(STAT_SIZE) };
  if (st === null) {
    panic("fstat: out of memory");
  }
  let rc: i32 = 0;
  if (path === null) {
    // SAFETY: `st` points at STAT_SIZE bytes, as many as this target's `struct stat` or more,
    // which fstat fills; it keeps no pointer after it returns.
    rc = unsafe { fstat(fd, st) };
  } else if (follow) {
    // SAFETY: as fstat's; `path` ends with its only 0 byte (the caller checked it).
    rc = unsafe { stat(path, st) };
  } else {
    // SAFETY: as stat's.
    rc = unsafe { lstat(path, st) };
  }
  let out: Stat | null = null;
  if (rc == 0) {
    const at = Ptr.addressOf(st);
    // SAFETY: fstat wrote `struct stat` at `at`, and every offset is inside it (checked above);
    // malloc's memory is aligned for every field.
    unsafe {
      out = {
        st_dev: mode16 ? addressLoad<i32>(at) as u64 : addressLoad<u64>(at),
        st_ino: ino32 ? addressLoad<u32>(at + 4) as u64 : addressLoad<u64>(at + 8),
        st_mode: mode16 ? addressLoad<u16>(at + mode) as u32 : addressLoad<u32>(at + mode),
        st_size: addressLoad<i64>(at + size),
        st_mtime: addressLoad<i64>(at + mtime),
        st_mtime_nsec: addressLoad<i64>(at + mtime + 8),
      };
    }
  }
  // SAFETY: `st` came from malloc and is freed once; `out` holds copies of its fields.
  unsafe {
    free(st);
  }
  ;
  return out;
}

/**
 * `mmap` of the `len` bytes of `fd` from byte `offset` (a multiple of the page size),
 * read-only and shared with the file (`PROT_READ`, `MAP_SHARED`: 1 and 1 on macOS and Linux):
 * the mapping's address, or 0 with the error for `lastError()`.
 */
export function mapRead(fd: i32, len: usize, offset: i64): usize {
  // SAFETY: a new mapping at an address the system chooses changes no memory this program
  // uses; the arguments are integers.
  const p = unsafe { mmap(null, len, 1, 1, fd, offset) };
  const address = p === null ? 0 : Ptr.addressOf(p);
  // `MAP_FAILED` is `(void *) -1`.
  return address + 1 == 0 ? 0 : address;
}

/**
 * `munmap` of the whole mapping `mapRead(fd, len, …)` returned at `address`: 0, or -1. Unsafe:
 * nothing reads the mapping afterwards.
 */
export unsafe function unmapRead(address: usize, len: usize): i32 {
  // SAFETY: the caller's statement: the range is a mapping of its own that nothing uses.
  return unsafe { munmap(Ptr.at<void>(address), len) };
}

/**
 * `madvise(address, len, advice)` on part of a mapping `mapRead` returned: 0, or -1. The
 * advice is `MADV_NORMAL` 0, `MADV_RANDOM` 1, `MADV_SEQUENTIAL` 2, `MADV_WILLNEED` 3 or
 * `MADV_DONTNEED` 4, the same numbers on macOS and Linux.
 */
export function adviseMap(address: usize, len: usize, advice: i32): i32 {
  // SAFETY: `address..address + len` is inside a live mapping (the caller's, which
  // `MappedFile` checks) that is read-only and shared with its file: the first four advices
  // change how pages are read ahead, and `MADV_DONTNEED` lets go of pages that the next read
  // takes from the file again, so none changes what is read.
  return unsafe { madvise(Ptr.at<void>(address), len, advice) };
}

/**
 * `read` (`at < 0`) or `pread` at `at` of up to `len` bytes into the memory at `address`: the
 * number read, or -1 with the error for `lastError()`. Unsafe: `address` must be `len` writable
 * bytes that nothing else uses during the call (an array's own buffer, velt/fs's `readSync`).
 */
export unsafe function readAddress(fd: i32, address: usize, len: usize, at: i64): isize {
  let r: isize;
  if (at < 0) {
    // SAFETY: the caller's statement about `address` and `len`; C keeps no pointer.
    r = unsafe { read$at(fd, Ptr.at<void>(address), len) };
  } else {
    // SAFETY: as for `read` above.
    r = unsafe { pread$at(fd, Ptr.at<void>(address), len, at) };
  }
  if (r < 0) {
    keepOsError();
  }
  return r;
}

/**
 * `write` (`at < 0`) or `pwrite` at `at` of the `len` bytes at `address`: the number written,
 * or -1 with the error for `lastError()`. Unsafe: `address` must be `len` readable bytes that
 * nothing changes during the call.
 */
export unsafe function writeAddress(fd: i32, address: usize, len: usize, at: i64): isize {
  let r: isize;
  if (at < 0) {
    // SAFETY: the caller's statement about `address` and `len`; C keeps no pointer.
    r = unsafe { write$at(fd, Ptr.at<void>(address), len) };
  } else {
    // SAFETY: as for `write` above.
    r = unsafe { pwrite$at(fd, Ptr.at<void>(address), len, at) };
  }
  if (r < 0) {
    keepOsError();
  }
  return r;
}
