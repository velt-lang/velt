// velt/fs (internal): the arguments of the file-descriptor API as Node checks them, and the
// `RangeError`s and `TypeError`s with Node's messages for those it rejects.

import { utf8Encode } from "velt/encoding/utf8";

/** `Number.MAX_SAFE_INTEGER`: the largest offset, length or position Node accepts. */
export const MAX_SAFE: number = 9007199254740991;
/** The largest 32-bit signed integer: the largest file descriptor and `open` flags. */
export const MAX_INT32: number = 2147483647;

/** The value of an integer argument as Node checks it (`validateInteger`). */
export function integer(name: string, v: number, min: number, max: number): i64 {
  if (v >= min && v <= max && Math.floor(v) == v) {
    return v as i64;
  }
  throw outOfRange(name, v, min, max);
}

export function outOfRange(name: string, v: number, min: number, max: number): RangeError {
  const must = Math.floor(v) != v ? "an integer" : `>= ${min} && <= ${max}`;
  return new RangeError(
    `The value of "${name}" is out of range. It must be ${must}. Received ${v}`,
  );
}

export function descriptor(fd: number): i32 {
  return integer("fd", fd, 0, MAX_INT32) as i32;
}

/** `path` as a C string: its UTF-8 bytes and a 0 (Node's `TypeError` for a 0 inside it). */
export function cPath(path: string): u8[] {
  if (path.includes("\0")) {
    throw new TypeError(
      `The argument 'path' must be a string, Uint8Array, or URL without null bytes. Received '${path}'`,
    );
  }
  const c = utf8Encode(path);
  c.push(0);
  return c;
}

/**
 * The byte offset in a buffer of `size` bytes, as Node validates it: `null` or left out is 0
 * (Node's options default), else an integer in [0, size] for a write (a write may start at the
 * end) or [0, MAX_SAFE] for a read (`offset + length <= size` is checked afterwards).
 */
export function bufferOffset(size: usize, offset: number | null | undefined, read: bool): i64 {
  if (offset == null) {
    return 0;
  }
  const off = integer("offset", offset, 0, MAX_SAFE);
  if (!read && off > (size as i64)) {
    throw tooLarge("offset", size as i64, off);
  }
  return off;
}

/**
 * How many bytes of a `size`-byte buffer a `readSync` reads from `off`: left out is the rest
 * (Velt's typed API has no options object, so omitting `length` reads to the end); `null` is 0
 * (Node's `length |= 0` of `null`); a number is truncated to a 32-bit integer (`1.5` → 1,
 * `2**32` → 0, `2**32 + 3` → 3). Checked by `checkRead` after the zero-length and empty-buffer
 * cases, in Node's order.
 */
export function readLength(size: usize, off: i64, length: number | null | undefined): i64 {
  if (length === undefined) {
    const rest = (size as i64) - off;
    return rest > 0 ? rest : 0;
  }
  return length == null ? 0 : ((length | 0) as i64);
}

/** Node's `validateOffsetLengthRead`: the length is `>= 0` and fits `size - off`. */
export function checkRead(size: usize, off: i64, len: i64) {
  if (len < 0) {
    throw outOfRangeAtLeast("length", 0, len);
  }
  if (off + len > (size as i64)) {
    throw tooLarge("length", (size as i64) - off, len);
  }
}

/**
 * How many bytes of a `size`-byte buffer a `writeSync` writes from `off`: left out or `null` is
 * the rest (Node's `typeof length !== 'number'`); a number is used as it is (truncated), and
 * must fit `size - off`.
 */
export function writeLength(size: usize, off: i64, length: number | null | undefined): i64 {
  if (length == null) {
    const rest = (size as i64) - off;
    return rest > 0 ? rest : 0;
  }
  const len = length as i64;
  if (off + len > (size as i64)) {
    throw tooLarge("length", (size as i64) - off, len);
  }
  return len;
}

export function tooLarge(name: string, max: i64, v: i64): RangeError {
  return new RangeError(
    `The value of "${name}" is out of range. It must be <= ${max}. Received ${v}`,
  );
}

export function outOfRangeAtLeast(name: string, min: i64, v: i64): RangeError {
  return new RangeError(
    `The value of "${name}" is out of range. It must be >= ${min}. Received ${v}`,
  );
}

/**
 * A `readSync` position: left out, `null` or `undefined` is the file's own position, which the
 * read advances; otherwise the byte to start at, validated strictly (an integer in [-1,
 * MAX_SAFE]; `1.5` or `-2` is a `RangeError`, as Node's `validatePosition`).
 */
export function readPosition(p: number | null | undefined): i64 {
  if (p == null) {
    return -1;
  }
  return integer("position", p, -1, MAX_SAFE);
}

/**
 * A `writeSync` position: left out, `null` or `undefined`, or any value that is not a
 * non-negative integer within range (a negative, a fraction, too large), is the file's own
 * position (as Node's write binding uses -1 for those); otherwise the byte to write at.
 */
export function writePosition(p: number | null | undefined): i64 {
  if (p != null && p >= 0 && p <= MAX_SAFE && Math.floor(p) == p) {
    return p as i64;
  }
  return -1;
}
