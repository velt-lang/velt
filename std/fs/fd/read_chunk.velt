// velt/fs (internal): one positioned read into bytes of its own, as a value another thread can
// hand back: what `readAt` runs off the calling task's thread (`#fs-read-at`).

import { EINTR } from "velt/fs/fd/system";
import { lastError, readInto } from "#fd-system";

/** The bytes one read gave (fewer than asked for at the end of the file), or its `errno`. */
export type ReadChunk = { bytes: u8[]; error: i32 };

/**
 * Reads up to `length` bytes of `fd` at `position` (`pread`, retried after a signal), blocking
 * the calling thread.
 */
export function readChunk(fd: i32, length: usize, position: i64): ReadChunk {
  const bytes: u8[] = Buffer.alloc(length);
  while (true) {
    const n = readInto(fd, bytes, 0, length, position);
    if (n >= 0) {
      return { bytes: (n as usize) == length ? bytes : bytes.slice(0, n as i64), error: 0 };
    }
    const e = lastError();
    if (e != EINTR) {
      return { bytes: [], error: e };
    }
  }
}
