// velt/fs (internal): writing to a file descriptor (`writeSync`).

import { EINTR } from "velt/fs/fd/system";
import { lastError, writeAddress, writeFrom as writeBytes } from "#fd-system";
import { bufferOffset, descriptor, writeLength, writePosition } from "velt/fs/fd/args";
import { osError } from "velt/fs/errors";
import { utf8Encode } from "velt/encoding/utf8";
import { arrayByteLength, arrayReadAddress } from "velt/lang/intrinsics";
import { ArrayBufferView, BufferView } from "velt/lang/typed_array/buffer_view";
import { VIEW_SIZE } from "velt/lang/hooks/keys";

/**
 * Writes `length` bytes of `buffer` from byte `offset` on (Node's `fs.writeSync`): at
 * `position` in the file, or at the file's own position when `position` is left out, `null` or
 * not a valid byte offset (at its end for a file opened to append). Returns the number of bytes
 * written. `offset` defaults to 0 and `length` to the rest of the buffer. `buffer` is a `u8[]`
 * (Node's `Buffer`), an array of any other number type (`f32[]`, `u32[]`, …, written from its
 * own memory as its bytes), a typed array or a `DataView`; `offset`, `length` and the result
 * count bytes whatever the elements are, as in Node. A string is written as UTF-8, and its
 * third argument is then the position.
 */
export function writeSync<T extends Numeric = u8>(
  fd: number,
  buffer: T[] | ArrayBufferView | string,
  offset: number | null = null,
  length?: number | null,
  position?: number | null,
): number {
  const f = descriptor(fd);
  if (typeof buffer == "string") {
    // All of the string's bytes; its third argument is the position.
    const b = utf8Encode(buffer);
    return writeLoop(f, b, 0, b.length as usize, writePosition(offset));
  }
  // An array of numbers counts in bytes, as a view does: its own memory is what is written.
  const size =
    buffer instanceof BufferView ? buffer.len * buffer[VIEW_SIZE]() : arrayByteLength(buffer);
  const off = bufferOffset(size, offset, false);
  const len = writeLength(size, off, length);
  const at = writePosition(position);
  if (buffer instanceof BufferView) {
    const base = buffer.off;
    return writeLoop(f, buffer.buf.bytes, base + (off as usize), base + ((off + len) as usize), at);
  }
  // SAFETY: the address is `buffer`'s memory, which stays where it is: nothing grows or drops
  // `buffer` before `writeMemory` returns. `writeLength` kept `off..off + len` inside its
  // `size` bytes, which the system only reads.
  const address = unsafe { arrayReadAddress(buffer) } + (off as usize);
  // SAFETY: as above.
  return unsafe { writeMemory(f, address, len as usize, at) };
}

// `write` / `pwrite` of the bytes `start..end` of `bytes`, again when a signal interrupted it.
function writeLoop(f: i32, bytes: u8[], start: usize, end: usize, at: i64): number {
  while (true) {
    const n = writeBytes(f, bytes, start, end, at);
    if (n >= 0) {
      return n as number;
    }
    const e = lastError();
    if (e != EINTR) {
      throw osError(e, "write");
    }
  }
}

/**
 * `write` / `pwrite` of the `len` bytes at `address`, again when a signal interrupted it.
 * Unsafe: `address` must be `len` readable bytes that nothing changes or frees during the call.
 */
unsafe function writeMemory(f: i32, address: usize, len: usize, at: i64): number {
  while (true) {
    // SAFETY: the caller's statement about `address` and `len`.
    const n = unsafe { writeAddress(f, address, len, at) };
    if (n >= 0) {
      return n as number;
    }
    const e = lastError();
    if (e != EINTR) {
      throw osError(e, "write");
    }
  }
}
