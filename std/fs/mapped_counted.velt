// velt/fs (internal): the arrays of `MappedFile`'s counted methods (`countedU32s`, …), one
// function per number type: each holds the mapping's owner, one of the holds its `MappedFile`
// reserved for it (mapped_file.velt `countedAt`), so the mapping stays while the array does.

import { copyOf } from "velt/fs/mapped_part";
import { addressArrayOwned, addressAtomicRmw } from "velt/lang/intrinsics";

/**
 * How many holds of the owner a `MappedFile` reserves for counted views at a time: when they are
 * handed out, it reserves as many again.
 */
export const RESERVE: u64 = 65536;

/** Reserves `n` more holds of `owner` for counted views, all at once. */
export function reserveHolds(owner: usize, n: u64) {
  // SAFETY: the caller holds `owner` (through its `MappedFile`'s `bytes`), so the block is there.
  unsafe {
    addressAtomicRmw<u64>(owner + 8, "add", n, "relaxed");
  }
}

/**
 * Gives back the `n` reserved holds of `owner` that no counted view took, when their `MappedFile`
 * is dropped. Its `bytes` still holds `owner`, so this is never the last hold.
 */
export function giveBackHolds(owner: usize, n: u64) {
  // SAFETY: as `reserveHolds`; the holds given back were reserved by `reserveHolds`.
  unsafe {
    addressAtomicRmw<u64>(owner + 8, "sub", n, "acqrel");
  }
}

/**
 * The `count` `i8` at `at` (from `countedAt`) in an array holding `owner`; a copy from byte
 * `byteOffset` of `bytes` when `at` is 0 (no values, or no mapping).
 */
export function viewI8(
  at: usize,
  owner: usize,
  bytes: shared<u8[]>,
  byteOffset: number,
  count: number,
): shared<i8[]> {
  if (at == 0) {
    return shared(copyOf<i8>(bytes, byteOffset as usize, count as usize));
  }
  // SAFETY: `countedAt` checked that the values are inside the mapping and aligned for `i8`,
  // and took the hold of `owner` this array keeps; it leaves as `shared`.
  const xs: i8[] = unsafe { addressArrayOwned<i8>(at, count as usize, owner) };
  return shared(xs);
}

