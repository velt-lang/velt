// velt/fs (internal): `Stats`, a file's metadata, as Node's `fs.Stats`.

/**
 * File metadata, as Node's `fs.Stats`: from `stat` (which follows symlinks) or `lstat` (which
 * describes a symlink itself). The field order is the runtime's `VeltStat` layout
 * `{ u64 size; f64 mtime_ms; u8 is_file; u8 is_dir; u8 is_symlink }`, so results are used without
 * conversion.
 */
export struct Stats {
  /** Size in bytes (of a symlink from `lstat`: the length of its target path). */
  size: u64;
  /** Last modification, in milliseconds since the Unix epoch (0 if unavailable). */
  mtimeMs: f64;
  private file: bool;
  private dir: bool;
  private symlink: bool;

  /** True for a regular file. */
  isFile(): bool {
    return this.file;
  }

  /** True for a directory. */
  isDirectory(): bool {
    return this.dir;
  }

  /** True for a symbolic link: only ever from `lstat`, since `stat` follows links. */
  isSymbolicLink(): bool {
    return this.symlink;
  }
}
