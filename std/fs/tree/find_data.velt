// velt/fs (internal): reading Windows' find data (`WIN32_FIND_DATAW`, which
// `FindFirstFileExW` and `FindNextFileW` fill; std/fs/tree/win32.velt): an entry's name, as
// text, and its kind. A block of 592 bytes, read as `u16` units: the attributes are units 0-1,
// the reparse tag (`dwReserved0`) units 18-19, and the name starts at unit 22 (260 units,
// NUL-terminated).

import { addressLoad } from "velt/lang/intrinsics";

const NAME_AT: usize = 22;
const NAME_END: usize = 282;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x10;
const FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x400;
const IO_REPARSE_TAG_SYMLINK: u32 = 0xa000000c;
const IO_REPARSE_TAG_MOUNT_POINT: u32 = 0xa0000003;

/** `Dirent`'s kinds (std/fs/dirent.velt). */
const FILE: u8 = 1;
const DIR: u8 = 2;
const LINK: u8 = 3;

/**
 * The `u16` at unit `i` of the find data at `at`. Unsafe: `at` must be the address of a block of
 * FIND_DATA_BYTES bytes (the one `read` allocates) and `i` a unit inside it.
 */
unsafe function unit(at: usize, i: usize): u32 {
  return addressLoad<u16>(at + 2 * i) as u32;
}

/** Whether the name of the find data at `at` is `.` or `..`. Unsafe: as `unit`. */
export unsafe function isDots(at: usize): bool {
  if (unit(at, NAME_AT) !== 46) {
    return false;
  }
  const second = unit(at, NAME_AT + 1);
  return second === 0 || (second === 46 && unit(at, NAME_AT + 2) === 0);
}

/**
 * The name of the find data at `at` as text (a lone surrogate reads as U+FFFD). Unsafe: as
 * `unit`.
 */
export unsafe function nameOf(at: usize): string {
  const bytes: u8[] = [];
  let i = NAME_AT;
  while (i < NAME_END) {
    const u = unit(at, i);
    if (u === 0) {
      break;
    }
    i++;
    if (u < 0x80) {
      bytes.push(u as u8);
    } else if (u < 0x800) {
      bytes.push((0xc0 | (u >> 6)) as u8);
      bytes.push((0x80 | (u & 0x3f)) as u8);
    } else if (u >= 0xd800 && u < 0xe000) {
      const low: u32 = i < NAME_END ? unit(at, i) : 0;
      if (u < 0xdc00 && low >= 0xdc00 && low < 0xe000) {
        i++;
        const cp = 0x10000 + ((u - 0xd800) << 10) + (low - 0xdc00);
        bytes.push((0xf0 | (cp >> 18)) as u8);
        bytes.push((0x80 | ((cp >> 12) & 0x3f)) as u8);
        bytes.push((0x80 | ((cp >> 6) & 0x3f)) as u8);
        bytes.push((0x80 | (cp & 0x3f)) as u8);
      } else {
        // A lone surrogate: U+FFFD.
        bytes.push(0xef);
        bytes.push(0xbf);
        bytes.push(0xbd);
      }
    } else {
      bytes.push((0xe0 | (u >> 12)) as u8);
      bytes.push((0x80 | ((u >> 6) & 0x3f)) as u8);
      bytes.push((0x80 | (u & 0x3f)) as u8);
    }
  }
  return bytes.utf8Slice();
}

/** The kind of the entry the find data at `at` describes. Unsafe: as `unit`. */
export unsafe function kindOf(at: usize): u8 {
  const attributes = unit(at, 0) | (unit(at, 1) << 16);
  if ((attributes & FILE_ATTRIBUTE_REPARSE_POINT) !== 0) {
    const tag = unit(at, 18) | (unit(at, 19) << 16);
    if (tag === IO_REPARSE_TAG_SYMLINK || tag === IO_REPARSE_TAG_MOUNT_POINT) {
      return LINK;
    }
  }
  return (attributes & FILE_ATTRIBUTE_DIRECTORY) !== 0 ? DIR : FILE;
}
