// velt/fs (internal): listing, making and removing directories on macOS and Linux (the default
// variant of `#fs-tree`, std/imports.velt), over the C library's directory functions
// (`#fd-system`). The errors are Node's (`ENOENT: no such file or directory, scandir 'x'`). Each
// function takes the path as C bytes (checked on the caller's thread) and as the text its error
// names, and returns a `Done`, so it can run on the executor's blocking pool.
//
// A listing is sorted by name, by code point (Node lists in the system's order; a sorted listing
// is the same on every system and run). An entry's type comes with the listing (`d_type`); only
// an entry whose file system reports none costs an `lstat`.

import {
  lastError,
  listDir,
  makeDir,
  removeDir,
  removeTree,
  statPath,
  unlinkPath,
} from "#fd-system";
import { Dirent } from "velt/fs/dirent";
import { osError } from "velt/fs/errors";
import { byCodePoint } from "velt/fs/tree/order";
import { Done } from "velt/fs/whole/done";
import { pdqsort } from "velt/lang/sort/pdq";

const ENOENT: i32 = 2;
/** `st_mode`'s type bits, and a directory's and a link's. */
const S_IFMT: u32 = 0o170000;
const S_IFDIR: u32 = 0o040000;
const S_IFLNK: u32 = 0o120000;
const S_IFREG: u32 = 0o100000;

/** `d_type` of a file, a directory and a link, and one for anything else (a FIFO's). */
const DT_REG: u8 = 8;
const DT_DIR: u8 = 4;
const DT_LNK: u8 = 10;
const DT_OTHER: u8 = 1;

/** `Dirent`'s kinds (std/fs/dirent.velt). */
const OTHER: u8 = 0;
const FILE: u8 = 1;
const DIR: u8 = 2;
const LINK: u8 = 3;

/** The names in the directory at `c`, sorted. */
export function list(c: readonly u8[], path: string): Done<string[]> {
  const names: string[] = [];
  const types: u8[] = [];
  const e = listDir(c, names, types, null);
  if (e != 0) {
    return { value: null, error: osError(e, "scandir", path) };
  }
  pdqsort(names, (a, b) => byCodePoint(a, b));
  return { value: names, error: null };
}

/** The `d_type` of what is at `child`, from `lstat` (its entry's `d_type` said nothing). */
function typeByStat(child: readonly u8[]): u8 {
  const st = statPath(child, false);
  if (st === null) {
    return DT_OTHER;
  }
  const kind = st.st_mode & S_IFMT;
  return kind == S_IFREG ? DT_REG : kind == S_IFDIR ? DT_DIR : kind == S_IFLNK ? DT_LNK : DT_OTHER;
}

/** The entries of the directory at `c` with their types, sorted by name. */
export function listTyped(c: readonly u8[], path: string): Done<Dirent[]> {
  const names: string[] = [];
  const types: u8[] = [];
  const e = listDir(c, names, types, (child) => typeByStat(child));
  if (e != 0) {
    return { value: null, error: osError(e, "scandir", path) };
  }
  const out: Dirent[] = [];
  for (let i: usize = 0; i < names.length; i++) {
    const t = types[i];
    out.push({
      name: names[i],
      kind: t == DT_REG ? FILE : t == DT_DIR ? DIR : t == DT_LNK ? LINK : OTHER,
    });
  }
  pdqsort(out, (a, b) => byCodePoint(a.name, b.name));
  return { value: out, error: null };
}

/** `mkdir(c)`: 0, or its errno. */
function makeOne(c: readonly u8[]): i32 {
  return makeDir(c, 0o777) == 0 ? 0 : lastError();
}

/** Whether a directory is at `c` (following links). */
function isDir(c: readonly u8[]): bool {
  const st = statPath(c, true);
  return st !== null && (st.st_mode & S_IFMT) == S_IFDIR;
}

/**
 * The parent of the path `c` as C bytes: `a/b` of `a/b/c` and of `a/b//c/`, `/` of `/a`, the
 * empty path of `a`; `null` for `/` and the empty path, which have none.
 */
function parentOf(c: readonly u8[]): u8[] | null {
  let end = c.length - 1;
  while (end > 0 && c[end - 1] == 47) {
    end--;
  }
  if (end == 0) {
    return null;
  }
  let start = end;
  while (start > 0 && c[start - 1] != 47) {
    start--;
  }
  let cut = start;
  while (cut > 0 && c[cut - 1] == 47) {
    cut--;
  }
  if (cut == 0 && start > 0) {
    cut = 1;
  }
  const out: u8[] = c.slice(0, cut as i64);
  out.push(0);
  return out;
}

/**
 * Makes the directory at `c` and its missing parents: 0, or the errno of what failed. A
 * directory already there is not an error, whoever made it (another thread making the same tree).
 */
function makeAll(c: readonly u8[]): i32 {
  if (c.length <= 1) {
    // The empty path: the parent of a relative name, which is there.
    return 0;
  }
  const first = makeOne(c);
  if (first == 0) {
    return 0;
  }
  if (first != ENOENT) {
    return isDir(c) ? 0 : first;
  }
  const parent = parentOf(c);
  if (parent === null) {
    return first;
  }
  const above = makeAll(parent);
  if (above != 0) {
    return above;
  }
  const again = makeOne(c);
  return again == 0 || isDir(c) ? 0 : again;
}

/** Makes the directory at `c`, with `recursive` its missing parents too. */
export function make(c: readonly u8[], path: string, recursive: bool): Done<bool> {
  // The empty path names nothing to make (`makeAll` takes it for a relative name's parent).
  const e = c.length <= 1 ? ENOENT : recursive ? makeAll(c) : makeOne(c);
  if (e != 0) {
    return { value: null, error: osError(e, "mkdir", path) };
  }
  return { value: true, error: null };
}

/**
 * Removes what is at `c`: a file, a link (never what it points to) or an empty directory, with
 * `recursive` a directory and everything in it. The error names the call that failed: `lstat`
 * for a path that is not there.
 */
export function removeAt(c: readonly u8[], path: string, recursive: bool): Done<bool> {
  const st = statPath(c, false);
  if (st === null) {
    return { value: null, error: osError(lastError(), "lstat", path) };
  }
  if ((st.st_mode & S_IFMT) != S_IFDIR) {
    if (unlinkPath(c) != 0) {
      return { value: null, error: osError(lastError(), "unlink", path) };
    }
  } else if (recursive) {
    const e = removeTree(c);
    if (e != 0) {
      return { value: null, error: osError(e, "rm", path) };
    }
  } else if (removeDir(c) != 0) {
    return { value: null, error: osError(lastError(), "rmdir", path) };
  }
  return { value: true, error: null };
}
