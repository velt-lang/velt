// velt/fs (tests): `MappedFile`: the mapping reads as the file's bytes, alone and from other
// tasks, and its float ranges are checked.
import {
  closeSync,
  MappedFile,
  openSync,
  readFileSync,
  rmSync,
  unlinkSync,
  writeFileSync,
  writeSync,
} from "velt/fs";
import { platform, tmpdir } from "velt/os";
import { u8x16 } from "velt/simd";
import { describe, expect, it } from "velt/test";

const POSIX = platform() == "darwin" || platform() == "linux";

function write(name: string, bytes: u8[]): string {
  const path = `${tmpdir()}/velt-mapped-${Date.now()}-${Math.floor(Math.random() * 1e9)}-${name}`;
  const fd = openSync(path, "w");
  if (bytes.length > 0) {
    writeSync(fd, bytes, 0, bytes.length as number, 0);
  }
  closeSync(fd);
  return path;
}

function pattern(n: number): u8[] {
  const bytes: u8[] = Buffer.alloc(n as usize);
  for (let i = 0; i < n; i++) {
    bytes[i] = (i % 251) as u8;
  }
  return bytes;
}

async function total(bytes: shared<u8[]>, from: i64, to: i64): Promise<i64> {
  let s: i64 = 0;
  for (let i = from; i < to; i++) {
    s += bytes[i] as i64;
  }
  return s;
}

describe("MappedFile", () => {
  it("reads the file's bytes without owning them", () => {
    if (!POSIX) {
      return;
    }
    const data = pattern(70000);
    const path = write("bytes", data);
    const m = MappedFile.open(path);
    expect(m.length).toBe(70000);
    expect(m.bytes[0]).toBe(0);
    expect(m.bytes[69999]).toBe(data[69999]);
    expect(u8x16.load(m.bytes, 65536).lane(3)).toBe(data[65539]);
    m.advise("sequential");
    m.advise("willneed", 4096, 100);
    // A copy is an array of its own.
    const copy: u8[] = [...m.bytes];
    copy[0] = 9;
    expect(m.bytes[0]).toBe(0);
    expect(copy.length).toBe(70000);
    unlinkSync(path);
  });

  it("is read by other tasks without a copy", async () => {
    if (!POSIX) {
      return;
    }
    const data = pattern(50000);
    const path = write("tasks", data);
    const m = MappedFile.open(path);
    const parts = await Promise.all([
      spawn(total(m.bytes, 0, 20000)),
      spawn(total(m.bytes, 20000, 50000)),
    ]);
    let want: i64 = 0;
    for (const b of data) {
      want += b as i64;
    }
    expect(parts[0] + parts[1]).toBe(want);
    unlinkSync(path);
  });

  it("gives a range of floats, checked", () => {
    if (!POSIX) {
      return;
    }
    const data: u8[] = Buffer.alloc(24);
    // 1.5 and -2 as little-endian f32 at bytes 8 and 12.
    data.set([0, 0, 0xc0, 0x3f, 0, 0, 0, 0xc0], 8);
    const path = write("floats", data);
    const m = MappedFile.open(path);
    const xs = m.f32s(8, 2);
    expect(xs.length).toBe(2);
    expect(xs[0]).toBe(1.5);
    expect(xs[1]).toBe(-2);
    expect(m.f32s(24, 0).length).toBe(0);
    expect(() => m.f32s(2, 1)).toThrow("f32s(2, 1): byte 2 of the file is not a multiple of 4");
    expect(() => m.f32s(20, 2)).toThrow("not a range of 4-byte floats");
    expect(() => m.f32s(-4, 1)).toThrow("not a range of 4-byte floats");
    expect(() => m.advise("random", 0, 25)).toThrow("is not inside the 24 mapped bytes");
    expect(() => m.advise("random", 0, -5)).toThrow("is not inside the 24 mapped bytes");
    expect(() => m.advise("random", 8, 17)).toThrow("is not inside the 24 mapped bytes");
    m.advise("random", 8);
    m.advise("willneed", 24, 0);
    unlinkSync(path);
  });

  it("gives a range as every number type, aligned for it", () => {
    if (!POSIX) {
      return;
    }
    const data: u8[] = Buffer.alloc(32);
    data.set([1, 2, 3, 4, 5, 6, 7, 8], 0);
    data.fill(0xff, 8, 16);
    data.set([0, 0, 0, 0, 0, 0, 0xf8, 0x3f], 16); // 1.5 as f64
    data.set([0, 0, 0, 0xc0], 24); // -2 as f32
    data.set([0, 0x3c], 28); // 1 as f16
    data.set([0x80, 0x3f], 30); // 1 as bf16
    const path = write("types", data);
    const m = MappedFile.open(path);
    expect(m.i8s(1, 1)[0] == 2 && m.i8s(8, 2)[1] == -1).toBe(true);
    expect(m.u16s(0, 1)[0] == 0x0201 && m.i16s(8, 1)[0] == -1).toBe(true);
    expect(m.u32s(0, 2)[1] == 0x08070605 && m.i32s(8, 1)[0] == -1).toBe(true);
    expect(m.u64s(0, 1)[0] == 0x0807060504030201 && m.i64s(8, 1)[0] == -1).toBe(true);
    expect(m.f64s(16, 1)[0]).toBe(1.5);
    expect(m.f32s(24, 1)[0]).toBe(-2);
    expect((m.f16s(28, 1)[0] as f32) == 1 && (m.bf16s(30, 1)[0] as f32) == 1).toBe(true);
    expect(m.u64s(0, 4).length).toBe(4);
    expect(m.i8s(32, 0).length + m.u64s(32, 0).length).toBe(0);
    expect(() => m.u16s(1, 1)).toThrow("u16s(1, 1): byte 1 of the file is not a multiple of 2");
    expect(() => m.u64s(4, 1)).toThrow("u64s(4, 1): byte 4 of the file is not a multiple of 8");
    expect(() => m.f64s(28, 1)).toThrow("not a range of 8-byte floats inside the 32 mapped bytes");
    expect(() => m.i8s(31, 2)).toThrow("i8s(31, 2) is not a range of 1-byte integers");
    expect(() => m.i32s(0, 9)).toThrow("i32s(0, 9) is not a range of 4-byte integers");
    expect(() => m.bf16s(0.5, 1)).toThrow("not a range of 2-byte floats");
    unlinkSync(path);
  });

  it("maps a part of a file, from any byte", () => {
    if (!POSIX) {
      return;
    }
    const data = pattern(200000);
    const path = write("part", data);
    // A start inside the first page, one past 64 KiB, and one on a 64 KiB boundary.
    const starts: number[] = [12, 70001, 131072];
    for (const offset of starts) {
      const part = MappedFile.open(path, { offset, length: 5000 });
      expect(part.length).toBe(5000);
      let same = true;
      for (let i = 0; i < 5000; i++) {
        same = same && part.bytes[i] == data[offset + i];
      }
      expect(same).toBe(true);
    }
    // To the end of the file when `length` is left out; no bytes at the very end.
    const tail = MappedFile.open(path, { offset: 199990 });
    expect(tail.length).toBe(10);
    expect(tail.bytes[9]).toBe(data[199999]);
    expect(MappedFile.open(path, { offset: 200000 }).length).toBe(0);
    expect(MappedFile.open(path, { length: 7 }).length).toBe(7);
    expect(() => MappedFile.open(path, { offset: 199990, length: 11 })).toThrow(
      "MappedFile.open: offset 199990, length 11 is not inside the 200000 bytes of",
    );
    expect(() => MappedFile.open(path, { offset: -1 })).toThrow(
      "MappedFile.open: offset -1, length 200001 is not inside",
    );
    expect(() => MappedFile.open(path, { offset: 1.5 })).toThrow(
      "MappedFile.open: offset 1.5, length",
    );
    expect(() => MappedFile.open(path, { offset: 200001 })).toThrow(
      "MappedFile.open: offset 200001, length -1 is not inside",
    );
    unlinkSync(path);
  });

  it("gives typed views of a part where the file aligns them", () => {
    if (!POSIX) {
      return;
    }
    const data = pattern(100000);
    const path = write("part-views", data);
    const whole = MappedFile.open(path);
    // The part starts 12 bytes into the file: a u32 at a multiple of 4 from it is aligned.
    const part = MappedFile.open(path, { offset: 70012, length: 4000 });
    const a = part.u32s(8, 3);
    const b = whole.u32s(70020, 3);
    expect([a[0], a[1], a[2]]).toEqual([b[0], b[1], b[2]]);
    // A part that starts at an odd byte: its u32 values sit at 3, 7, … from its start.
    const odd = MappedFile.open(path, { offset: 70001, length: 4000 });
    expect(odd.u32s(3, 1)[0]).toBe(whole.u32s(70004, 1)[0]);
    expect(() => odd.u32s(0, 1)).toThrow(
      "u32s(0, 1): byte 70001 of the file is not a multiple of 4",
    );
    expect(() => odd.u32s(4, 1)).toThrow(
      "u32s(4, 1): byte 70005 of the file is not a multiple of 4",
    );
    expect(odd.i8s(0, 1)[0] as number).toBe(whole.i8s(70001, 1)[0] as number);
    unlinkSync(path);
  });

  it("gives pages back and reads them again", () => {
    if (!POSIX) {
      return;
    }
    const data = pattern(300000);
    const path = write("dontneed", data);
    const part = MappedFile.open(path, { offset: 70001, length: 200000 });
    let before: i64 = 0;
    for (let i = 0; i < 200000; i++) {
      before += part.bytes[i] as i64;
    }
    part.advise("dontneed");
    part.advise("dontneed", 100, 70000);
    part.advise("willneed", 199999, 1);
    let after: i64 = 0;
    for (let i = 0; i < 200000; i++) {
      after += part.bytes[i] as i64;
    }
    expect(after).toBe(before);
    expect(() => part.advise("dontneed", 0, 200001)).toThrow("advise: 0..200001 is not inside");
    unlinkSync(path);
  });

  it("gives back the pages of the range it is told, and no others", () => {
    if (platform() != "linux") {
      return;
    }
    const length = 32 * 1024 * 1024;
    const name = `resident-${Date.now()}-${Math.floor(Math.random() * 1e9)}`;
    const path = write(name, pattern(70001 + length));
    // The mapping's own resident memory in KiB, from its entry in /proc/self/smaps (found by
    // the file's name), which walks the page tables. The process's total would also count what
    // the test allocates and what the system takes back from other memory under load.
    const resident = (): number => {
      const text = readFileSync("/proc/self/smaps");
      const entry = text.indexOf(name);
      const at = entry < 0 ? -1 : text.indexOf("Rss:", entry);
      const kb = at < 0 ? NaN : parseInt(text.slice(at + 4, text.indexOf("kB", at)).trim());
      // No entry or no number is a failure of the test, not "nothing resident".
      if (Number.isNaN(kb)) {
        throw new Error(`no Rss of ${name} in /proc/self/smaps`);
      }
      return kb;
    };
    const part = MappedFile.open(path, { offset: 70001, length });
    let sum: i64 = 0;
    for (let i = 0; i < length; i += 1024) {
      sum += part.bytes[i] as i64;
    }
    const touched = resident();
    part.advise("dontneed", 0, length / 2);
    const half = resident();
    part.advise("dontneed");
    const none = resident();
    expect(sum > 0).toBe(true);
    // What `advise` promises whatever the machine is doing: memory only goes, and after the
    // whole part is given back next to nothing of it is resident (the system may keep up to
    // a huge page at an end).
    expect(half <= touched).toBe(true);
    expect(none <= half).toBe(true);
    expect(none <= 4096).toBe(true);
    // With every touched page still resident (a machine short of memory takes some back by
    // itself), the first half's pages went with the first advice and the rest stayed.
    if (touched > (length / 1024) * 0.9) {
      expect(half < touched * 0.7 && half > touched * 0.3).toBe(true);
    }
    unlinkSync(path);
  });

  it("maps an empty file as no bytes, and reports a missing one", () => {
    if (!POSIX) {
      return;
    }
    const path = write("empty", []);
    const m = MappedFile.open(path);
    expect(m.length).toBe(0);
    m.advise("normal");
    unlinkSync(path);
    expect(() => MappedFile.open(path)).toThrow("ENOENT");
  });

  it("refuses what is not a regular file, by Node's codes", () => {
    if (!POSIX) {
      return;
    }
    expect(() => MappedFile.open(tmpdir())).toThrow(
      "EISDIR: illegal operation on a directory, mmap",
    );
    // A device reports a size of 0 whatever it holds: an error, not an empty mapping.
    expect(() => MappedFile.open("/dev/zero")).toThrow(
      "EINVAL: invalid argument, mmap '/dev/zero'",
    );
  });

  it("maps a /proc file as no bytes: it is a regular file of size 0", () => {
    if (platform() != "linux") {
      return;
    }
    expect(MappedFile.open("/proc/self/status").length).toBe(0);
  });

  it("close gives the file up; arrays handed out before stay readable", () => {
    const path = `${tmpdir()}/velt-mapped-${Date.now()}-${Math.floor(Math.random() * 1e9)}-close`;
    writeFileSync(path, "0123456789abcdef");
    const m = MappedFile.open(path);
    const bytes = m.bytes;
    const words = m.u32s(4, 2);
    expect(m.closed).toBe(false);
    expect(m.getUint32(4)).toBe(0x34353637);
    m.close();
    m.close();
    expect(m.closed).toBe(true);
    expect(m.length).toBe(16);
    expect(() => m.bytes).toThrow("bytes: the MappedFile is closed");
    expect(() => m.u16s(0, 1)).toThrow("u16s: the MappedFile is closed");
    expect(() => m.advise("normal")).toThrow("advise: the MappedFile is closed");
    expect(() => m.getUint8(0)).toThrow("get: the MappedFile is closed");
    expect(() => m.getUint32(4, true)).toThrow("get: the MappedFile is closed");
    expect(bytes[15]).toBe(102);
    expect(words[1]).toBe(0x62613938);
  });

  it("gives the mapping back with the last array over it, not before", () => {
    if (platform() != "linux") {
      return;
    }
    const name = `velt-mapped-${Date.now()}-${Math.floor(Math.random() * 1e9)}-maps`;
    const path = `${tmpdir()}/${name}`;
    writeFileSync(path, "0123456789abcdef");
    const mapped = () => readFileSync("/proc/self/maps").includes(name);
    expect(mapped()).toBe(false);
    {
      using m = MappedFile.open(path);
      expect(mapped()).toBe(true);
      expect(m.bytes[0]).toBe(48);
    }
    expect(mapped()).toBe(false);
    let kept: shared<u16[]> | null = null;
    {
      const m = MappedFile.open(path);
      kept = m.u16s(2, 2);
      m.close();
    }
    expect(mapped()).toBe(true);
    expect(kept![0]).toBe(0x3332);
    kept = null;
    expect(mapped()).toBe(false);
    // Dropped without `close`: closed all the same.
    openAndDrop(path);
    expect(mapped()).toBe(false);
  });

  it("opens a file more often than the system has mappings, when each is closed", () => {
    if (!POSIX) {
      return;
    }
    const path = `${tmpdir()}/velt-mapped-${Date.now()}-${Math.floor(Math.random() * 1e9)}-many`;
    writeFileSync(path, "0123456789abcdef");
    let sum = 0;
    // Linux allows about 65,530 mappings by default.
    for (let i = 0; i < 70000; i++) {
      using m = MappedFile.open(path);
      sum += m.bytes[i % 16];
    }
    expect(sum > 0).toBe(true);
  });

  // The tests above write their files through the fd API, which Windows does not have: these
  // write text, so they run there too.
  it("maps a text file, whole and in part, on every system", () => {
    const path = `${tmpdir()}/velt-mapped-${Date.now()}-${Math.floor(Math.random() * 1e9)}-text`;
    writeFileSync(path, "0123456789abcdef");
    const m = MappedFile.open(path);
    expect(m.length).toBe(16);
    expect(m.bytes[10]).toBe(97);
    expect(m.u32s(4, 1)[0]).toBe(0x37363534);
    expect(m.u16s(14, 1)[0]).toBe(0x6665);
    m.advise("willneed");
    m.advise("dontneed", 0, 16);
    expect(m.bytes[15]).toBe(102);
    const part = MappedFile.open(path, { offset: 8, length: 6 });
    expect(part.length).toBe(6);
    expect(part.bytes[0]).toBe(56);
    expect(part.u32s(0, 1)[0]).toBe(0x62613938);
    expect(() => part.u32s(2, 1)).toThrow("not a multiple of 4");
    expect(() => MappedFile.open(path, { offset: 10, length: 7 })).toThrow(
      "is not inside the 16 bytes",
    );
    expect(MappedFile.open(path, { offset: 16 }).length).toBe(0);
    try {
      rmSync(path);
    } catch (e) {
      // Windows may refuse to remove a file that is mapped.
    }
  });

  // Windows starts a view at a multiple of 64 KiB in the file, the other systems at a page.
  it("maps parts that start around and past 64 KiB on every system", () => {
    const path = `${tmpdir()}/velt-mapped-${Date.now()}-${Math.floor(Math.random() * 1e9)}-long`;
    let text = "";
    for (let i = 0; i < 200000; i++) {
      text += String.fromCharCode(32 + (i % 95));
    }
    writeFileSync(path, text);
    for (const offset of [65535, 65536, 65537, 70001, 131071, 131072, 199000]) {
      const part = MappedFile.open(path, { offset, length: 1000 });
      expect(part.length).toBe(1000);
      for (let i = 0; i < 1000; i++) {
        if (part.bytes[i] != 32 + ((offset + i) % 95)) {
          throw new Error(`byte ${i} of the part at ${offset} is ${part.bytes[i]}`);
        }
      }
    }
    // A typed view inside a part that starts at an odd byte: 70004 is a multiple of 4.
    const odd = MappedFile.open(path, { offset: 70001, length: 1000 });
    const at = (k: number): number => 32 + ((70004 + k) % 95);
    expect(odd.u32s(3, 1)[0] as number).toBe(
      at(0) + at(1) * 256 + at(2) * 65536 + at(3) * 16777216,
    );
    expect(() => odd.u32s(0, 1)).toThrow("not a multiple of 4");
    try {
      rmSync(path);
    } catch (e) {
      // Windows may refuse to remove a file that is mapped.
    }
  });

  it("reports a missing file and a directory by Node's codes on every system", () => {
    expect(() => MappedFile.open(`${tmpdir()}/velt-mapped-no-such-file`)).toThrow("ENOENT");
    expect(() => MappedFile.open(tmpdir())).toThrow("EISDIR");
  });
});

function openAndDrop(path: string) {
  const m = MappedFile.open(path);
  expect(m.bytes.length).toBe(16);
}
