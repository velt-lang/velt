// velt/fs (internal): the `#mapped-source` variant of WebAssembly, which has no `mmap`
// (std/imports.velt): a `MappedFile` reads the file into memory of its own when it is opened
// and offers the same arrays, so a program that uses one runs there too. The whole file is
// read, also for a part of it (the target has no positioned read in std), and the part is
// what is kept; a typed method's array is a copy of its range.

import { osError } from "velt/fs/errors";
import { readFileBytesSync } from "velt/fs/files";
import { statSync } from "velt/fs/metadata";
import { MapOptions, Mapping, outsideFile, partOf } from "velt/fs/mapped_part";

/** Reads the part of the file at `path` that `options` names (`MappedFile.open`). */
export function mapFile(path: string, options: MapOptions | undefined): Mapping {
  // What is not a regular file is refused as over a mapping, before the read (which fails for
  // a directory with an error of its own). A path that cannot be described is left to the
  // read, whose error is the one a mapping's `open` gives (`ENOENT` for a missing file).
  const kind = kindOf(path);
  if (kind != 0) {
    throw osError(kind, "mmap", path);
  }
  const whole = readFileBytesSync(path);
  const size = whole.length as number;
  const part = partOf(size, options);
  if (part == null) {
    throw outsideFile(path, size, options);
  }
  if (part.length == 0) {
    return { address: 0, from: 0, bytes: shared([]), owner: 0 };
  }
  const bytes =
    part.length == size
      ? whole
      : whole.slice(part.offset as i64, (part.offset + part.length) as i64);
  // The typed methods ask only whether there are bytes (an address of 0 is none): they copy
  // from `bytes` by index (`COPIES`), so no address is kept and none is ever read.
  return { address: 1, from: part.offset as usize, bytes: shared(bytes), owner: 0 };
}

/** 0 for a regular file or a path `stat` fails for, else the error of mapping it: EISDIR, EINVAL. */
function kindOf(path: string): i32 {
  try {
    const st = statSync(path);
    return st.isFile() ? 0 : st.isDirectory() ? 21 : 22;
  } catch (e) {
    return 0;
  }
}

/** Advice has nothing to act on: the bytes are in memory. Always 0. */
export function adviseMapping(address: usize, len: usize, advice: i32): i32 {
  return 0;
}

/**
 * Whether a typed method's array is a copy of its range (`copyOf`): there is no mapping,
 * and an array over an address has no tie to the memory it reads.
 */
export const COPIES: bool = true;
