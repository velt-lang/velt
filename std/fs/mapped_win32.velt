// velt/fs (internal): the `#mapped-source` variant of Windows (std/imports.velt): a
// `MappedFile` is a view of a file mapping (`CreateFileMappingW`, `MapViewOfFile`), and its
// arrays are that memory, as over `mmap`. A view starts at a multiple of the allocation
// granularity (64 KiB) in the file, which is where mapped_posix.velt starts its mappings too.
// The view keeps the mapping and the file, so both handles are closed once it is made. Windows
// refuses to cut a file short while a view of it exists, so there is no bus error here.

import { Ptr } from "velt/ffi/ptr";
import { osError } from "velt/fs/errors";
import { MapOptions, Mapping, outsideFile, partOf } from "velt/fs/mapped_part";
import { winPath } from "velt/fs/whole/win_path";
import { addressArray } from "velt/lang/intrinsics";
import { errnoOfWin32 } from "velt/os/win_error";

/** C's `SECURITY_ATTRIBUTES`: never passed. */
declare c type _SECURITY_ATTRIBUTES;

declare c("c") function CreateFileW(
  name: readonly u16[],
  access: u32,
  share: u32,
  security: Ptr<_SECURITY_ATTRIBUTES> | null,
  disposition: u32,
  flags: u32,
  template: Ptr<void> | null,
): Ptr<void> | null;
declare c("c") function GetFileAttributesW(name: readonly u16[]): u32;
declare c("c") function GetFileType(handle: Ptr<void>): u32;
declare c("c") function GetFileSizeEx(handle: Ptr<void>, size: i64[]): i32;
declare c("c") function CreateFileMappingW(
  file: Ptr<void>,
  security: Ptr<_SECURITY_ATTRIBUTES> | null,
  protect: u32,
  sizeHigh: u32,
  sizeLow: u32,
  name: Ptr<u16> | null,
): Ptr<void> | null;
declare c("c") function MapViewOfFile(
  mapping: Ptr<void>,
  access: u32,
  offsetHigh: u32,
  offsetLow: u32,
  bytes: usize,
): Ptr<void> | null;
declare c("c") function CloseHandle(handle: Ptr<void>): i32;
declare c("c") function GetLastError(): u32;

const INVALID_HANDLE: usize = 0xffffffffffffffff;
const GENERIC_READ: u32 = 0x80000000;
/** FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, as std/fs/whole/win32.velt opens. */
const SHARE_ALL: u32 = 7;
const OPEN_EXISTING: u32 = 3;
const FILE_ATTRIBUTE_NORMAL: u32 = 0x80;
const FILE_TYPE_DISK: u32 = 1;
const PAGE_READONLY: u32 = 2;
const FILE_MAP_READ: u32 = 4;
const ERROR_FILE_NOT_FOUND: u32 = 2;
const ERROR_ACCESS_DENIED: u32 = 5;
/** Linux's numbers, which `osError` reads on Windows. */
const EISDIR: i32 = 21;
const EINVAL: i32 = 22;

function lastWin32(): u32 {
  // SAFETY: GetLastError has no precondition.
  return unsafe { GetLastError() };
}

/** Whether `w` names a directory (for "access denied" on opening it). */
function isDirectory(w: readonly u16[]): bool {
  // SAFETY: `w` is NUL-terminated.
  const a = unsafe { GetFileAttributesW(w) };
  return a !== 0xffffffff && (a & 0x10) !== 0; // not INVALID_FILE_ATTRIBUTES; DIRECTORY
}

function close(h: Ptr<void>) {
  // SAFETY: a handle this module opened, closed once.
  unsafe {
    CloseHandle(h);
  }
}

/** Maps the part of the file at `path` that `options` names (`MappedFile.open`). */
export function mapFile(path: string, options: MapOptions | undefined): Mapping {
  const w = winPath(path);
  if (w === null) {
    throw osError(errnoOfWin32(ERROR_FILE_NOT_FOUND), "open", path);
  }
  let opened: Ptr<void> | null = null;
  // SAFETY: `w` is NUL-terminated; no security attributes and no template.
  unsafe {
    opened = CreateFileW(
      w,
      GENERIC_READ,
      SHARE_ALL,
      null,
      OPEN_EXISTING,
      FILE_ATTRIBUTE_NORMAL,
      null,
    );
  }
  // INVALID_HANDLE_VALUE is what a failed open returns.
  if (opened === null || Ptr.addressOf(opened) === INVALID_HANDLE) {
    const code = lastWin32();
    // A directory refuses to open as a file with "access denied".
    if (code === ERROR_ACCESS_DENIED && isDirectory(w)) {
      throw osError(EISDIR, "mmap", path);
    }
    throw osError(errnoOfWin32(code), "open", path);
  }
  const file: Ptr<void> = opened;
  // Only a file on a disk has bytes to map (not a console, a pipe or a device).
  // SAFETY: `file` is an open handle.
  if (unsafe { GetFileType(file) } !== FILE_TYPE_DISK) {
    close(file);
    throw osError(EINVAL, "mmap", path);
  }
  const sized: i64[] = [0];
  // SAFETY: `sized` holds the 8 bytes the call writes.
  if (unsafe { GetFileSizeEx(file, sized) } === 0) {
    const code = lastWin32();
    close(file);
    throw osError(errnoOfWin32(code), "fstat", path);
  }
  const size = sized[0] as number;
  const part = partOf(size, options);
  if (part == null) {
    close(file);
    throw outsideFile(path, size, options);
  }
  if (part.length == 0) {
    // No bytes: nothing to map (a mapping of an empty file is refused).
    close(file);
    return { address: 0, from: 0, bytes: shared([]) };
  }
  // A mapping object of the whole file as it is now, read-only.
  // SAFETY: `file` is open for reading; no security attributes, no name, the file's size.
  const mapping = unsafe { CreateFileMappingW(file, null, PAGE_READONLY, 0, 0, null) };
  if (mapping === null) {
    const code = lastWin32();
    close(file);
    throw osError(errnoOfWin32(code), "mmap", path);
  }
  // A view starts at a multiple of the allocation granularity, 64 KiB.
  const lead = part.offset % 65536;
  const start = (part.offset - lead) as u64;
  const len = part.length as usize;
  const high = (start >> 32) as u32;
  const low = (start & 0xffffffff) as u32;
  let view: Ptr<void> | null = null;
  // SAFETY: `start` is a multiple of 64 KiB and `start + lead + len` is inside the file.
  unsafe {
    view = MapViewOfFile(mapping, FILE_MAP_READ, high, low, (lead as usize) + len);
  }
  const code = view === null ? lastWin32() : 0;
  // The view keeps the mapping object, which keeps the file: neither handle is needed.
  close(mapping);
  close(file);
  if (view === null) {
    throw osError(errnoOfWin32(code), "mmap", path);
  }
  const address = Ptr.addressOf(view) + (lead as usize);
  // SAFETY: `address` is `len` readable bytes of a view that is never unmapped, and the
  // array is only ever read: it leaves this function as a `shared<u8[]>`.
  const bytes: u8[] = unsafe { addressArray<u8>(address, len) };
  return { address, from: part.offset as usize, bytes: shared(bytes) };
}

/** Advice is a hint, and Windows is given none: always 0. */
export function adviseMapping(address: usize, len: usize, advice: i32): i32 {
  return 0;
}

/**
 * Whether a typed method's array is a copy of its range (`copyOf`): the arrays are over the
 * view, which is never unmapped.
 */
export const COPIES: bool = false;
