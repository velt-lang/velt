// velt/fs (internal): what a file writer released with its file still open leaves
// (std/fs/stream_table.velt): its buffer to write, then its file to close.

/**
 * What the end of a turn leaves: a closed or released stream's file (0: nothing to do) and the
 * bytes still to write to it, and the waiting operations to wake (the next one, which has the
 * turn now; all of them when the stream is gone), once the table's lock is let go.
 */
export struct StreamLeft {
  os: u64;
  bytes: u8[];
  wake: (() => void)[];
}
