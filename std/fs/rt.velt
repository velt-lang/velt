// velt/fs (internal): the runtime functions velt/fs calls (docs/internals/contracts/rt_abi_async.md
// §5 and §14.7) and the layouts they return.
//
// Extern conventions (the lowering ABI of `declare function`, rt_abi_async.md §3.1): `string`/
// struct params are passed as `const T*`; a struct result becomes a trailing out-pointer and the
// runtime function returns nothing. Paths and data are borrowed by the runtime and copied at the
// call, so the wrappers never copy.

import { IoResult, unwrapIo } from "velt/native/result";
import { IoStatus, checkIo } from "velt/native/status";
import { Dirent } from "velt/fs/dirent";
import { Stats } from "velt/fs/stats";
import { checkPathArg } from "velt/fs/path_arg";

declare async function velt_rt_fs_read_file_bytes(path: string): Promise<IoResult<u8[]>>;
declare async function velt_rt_fs_write_file(path: string, data: string): Promise<IoStatus>;
declare async function velt_rt_fs_append_file(path: string, data: string): Promise<IoStatus>;
declare async function velt_rt_fs_read_dir(path: string): Promise<IoResult<string[]>>;
declare async function velt_rt_fs_read_dir_typed(path: string): Promise<IoResult<DirentList>>;
declare async function velt_rt_fs_stat(path: string): Promise<IoResult<Stats>>;
declare async function velt_rt_fs_lstat(path: string): Promise<IoResult<Stats>>;
declare async function velt_rt_fs_readlink(path: string): Promise<IoResult<string>>;
declare async function velt_rt_fs_realpath(path: string): Promise<IoResult<string>>;
declare async function velt_rt_fs_symlink(target: string, path: string): Promise<IoStatus>;
declare async function velt_rt_fs_mkdir(path: string, recursive: bool): Promise<IoStatus>;
declare async function velt_rt_fs_remove(path: string, recursive: bool): Promise<IoStatus>;
declare async function velt_rt_fs_rename(from: string, to: string): Promise<IoStatus>;
declare async function velt_rt_fs_copy_file(from: string, to: string): Promise<IoStatus>;
declare async function velt_rt_fs_exists(path: string): Promise<bool>;
declare function velt_rt_fs_read_file_bytes_sync(path: string): IoResult<u8[]>;
declare function velt_rt_fs_write_file_sync(path: string, data: string): IoStatus;
declare function velt_rt_fs_append_file_sync(path: string, data: string): IoStatus;
declare function velt_rt_fs_read_dir_sync(path: string): IoResult<string[]>;
declare function velt_rt_fs_read_dir_typed_sync(path: string): IoResult<DirentList>;
declare function velt_rt_fs_stat_sync(path: string): IoResult<Stats>;
declare function velt_rt_fs_lstat_sync(path: string): IoResult<Stats>;
declare function velt_rt_fs_readlink_sync(path: string): IoResult<string>;
declare function velt_rt_fs_realpath_sync(path: string): IoResult<string>;
declare function velt_rt_fs_symlink_sync(target: string, path: string): IoStatus;
declare function velt_rt_fs_mkdir_sync(path: string, recursive: bool): IoStatus;
declare function velt_rt_fs_remove_sync(path: string, recursive: bool): IoStatus;
declare function velt_rt_fs_rename_sync(from: string, to: string): IoStatus;
declare function velt_rt_fs_copy_file_sync(from: string, to: string): IoStatus;
declare function velt_rt_fs_exists_sync(path: string): bool;

export declare async function velt_rt_fs_open_read(path: string): Promise<IoResult<u64>>;
export declare async function velt_rt_fs_open_read_range(
  path: string,
  start: u64,
  end: u64,
): Promise<IoResult<u64>>;
export declare function velt_rt_fs_reader_opened_stats(r: u64): IoResult<Stats>;
export declare async function velt_rt_fs_reader_read(r: u64, max: u64): Promise<IoResult<u8[]>>;
export declare async function velt_rt_fs_reader_read_string(
  r: u64,
  max: u64,
): Promise<IoResult<string>>;
export declare async function velt_rt_fs_reader_read_line(r: u64): Promise<LineRead>;
export declare function velt_rt_fs_reader_close(r: u64);
export declare async function velt_rt_fs_open_write(
  path: string,
  append: bool,
): Promise<IoResult<u64>>;
export declare async function velt_rt_fs_writer_write(w: u64, data: string): Promise<IoStatus>;
export declare async function velt_rt_fs_writer_write_bytes(w: u64, data: u8[]): Promise<IoStatus>;
export declare async function velt_rt_fs_writer_flush(w: u64): Promise<IoStatus>;
export declare async function velt_rt_fs_writer_close(w: u64): Promise<IoStatus>;
export declare function velt_rt_fs_writer_free(w: u64);

// The runtime's `VeltDirents`: sorted names and, at the same index, each one's kind (0 other,
// 1 file, 2 directory, 3 symlink).
struct DirentList {
  names: string[];
  kinds: u8[];
}

// The runtime's `LineRead` (§14.4).
struct LineRead {
  line: IoResult<string>;
  eof: bool;
}

/** The entries of a runtime listing, each with its type. */
function dirents(list: DirentList): Dirent[] {
  const out: Dirent[] = [];
  for (let i = 0; i < list.names.length; i++) {
    out.push({ name: list.names[i], kind: list.kinds[i] });
  }
  return out;
}

// Whole files, as std/fs/rt_sched.velt names them for native builds: velt_rt_wasm's functions.
// Text is read as bytes and decoded here, an invalid sequence as U+FFFD (as Node decodes).

export function readTextSync(path: string): string {
  checkPathArg(path);
  return unwrapIo(velt_rt_fs_read_file_bytes_sync(path)).utf8Slice();
}

export async function readText(path: string): Promise<string> {
  checkPathArg(path);
  return unwrapIo(await velt_rt_fs_read_file_bytes(path)).utf8Slice();
}

export function readBytesSync(path: string): u8[] {
  checkPathArg(path);
  return unwrapIo(velt_rt_fs_read_file_bytes_sync(path));
}

export async function readBytes(path: string): Promise<u8[]> {
  checkPathArg(path);
  return unwrapIo(await velt_rt_fs_read_file_bytes(path));
}

/** Writes `data` (truncating, or `append`ing), creating the file if missing. */
export function writeSync(path: string, data: string, append: bool) {
  checkPathArg(path);
  checkIo(
    append ? velt_rt_fs_append_file_sync(path, data) : velt_rt_fs_write_file_sync(path, data),
  );
}

export async function write(path: string, data: string, append: bool): Promise<void> {
  checkPathArg(path);
  checkIo(
    append ? await velt_rt_fs_append_file(path, data) : await velt_rt_fs_write_file(path, data),
  );
}

/** `stat` (`follow`) or `lstat`. */
export function statSync(path: string, follow: bool): Stats {
  checkPathArg(path);
  return unwrapIo(follow ? velt_rt_fs_stat_sync(path) : velt_rt_fs_lstat_sync(path));
}

export async function stat(path: string, follow: bool): Promise<Stats> {
  checkPathArg(path);
  return unwrapIo(follow ? await velt_rt_fs_stat(path) : await velt_rt_fs_lstat(path));
}

// Directories, as std/fs/rt_sched.velt names them for native builds: velt_rt_wasm's functions.

export function readDirSync(path: string): string[] {
  checkPathArg(path);
  return unwrapIo(velt_rt_fs_read_dir_sync(path));
}

export async function readDir(path: string): Promise<string[]> {
  checkPathArg(path);
  return unwrapIo(await velt_rt_fs_read_dir(path));
}

export function readDirEntriesSync(path: string): Dirent[] {
  checkPathArg(path);
  return dirents(unwrapIo(velt_rt_fs_read_dir_typed_sync(path)));
}

export async function readDirEntries(path: string): Promise<Dirent[]> {
  checkPathArg(path);
  return dirents(unwrapIo(await velt_rt_fs_read_dir_typed(path)));
}

export function mkdirSync(path: string, recursive: bool) {
  checkPathArg(path);
  checkIo(velt_rt_fs_mkdir_sync(path, recursive));
}

export async function mkdir(path: string, recursive: bool): Promise<void> {
  checkPathArg(path);
  checkIo(await velt_rt_fs_mkdir(path, recursive));
}

export function removeSync(path: string, recursive: bool) {
  checkPathArg(path);
  checkIo(velt_rt_fs_remove_sync(path, recursive));
}

export async function remove(path: string, recursive: bool): Promise<void> {
  checkPathArg(path);
  checkIo(await velt_rt_fs_remove(path, recursive));
}

export function existsSync(path: string): bool {
  return velt_rt_fs_exists_sync(path);
}

export async function exists(path: string): Promise<bool> {
  return await velt_rt_fs_exists(path);
}

// Renaming, linking and copying, as std/fs/rt_sched.velt names them for native builds:
// velt_rt_wasm's functions. The callers have checked the paths.

export function renameSync(from: string, to: string) {
  checkIo(velt_rt_fs_rename_sync(from, to));
}

export async function rename(from: string, to: string): Promise<void> {
  checkIo(await velt_rt_fs_rename(from, to));
}

export function copyFileSync(from: string, to: string) {
  checkIo(velt_rt_fs_copy_file_sync(from, to));
}

export async function copyFile(from: string, to: string): Promise<void> {
  checkIo(await velt_rt_fs_copy_file(from, to));
}

export function symlinkSync(target: string, path: string) {
  checkIo(velt_rt_fs_symlink_sync(target, path));
}

export async function symlink(target: string, path: string): Promise<void> {
  checkIo(await velt_rt_fs_symlink(target, path));
}

export function readlinkSync(path: string): string {
  return unwrapIo(velt_rt_fs_readlink_sync(path));
}

export async function readlink(path: string): Promise<string> {
  return unwrapIo(await velt_rt_fs_readlink(path));
}

export function realpathSync(path: string): string {
  return unwrapIo(velt_rt_fs_realpath_sync(path));
}

export async function realpath(path: string): Promise<string> {
  return unwrapIo(await velt_rt_fs_realpath(path));
}
