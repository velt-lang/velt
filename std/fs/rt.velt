// velt/fs (internal): the parts of a WebAssembly build's velt/fs that run on the calling task,
// which std/fs/rt_wasi.velt (`#fs-rt` on WebAssembly, std/imports.velt) re-exports with its async
// forms: the runtime's sync calls for whole files and directories
// (docs/internals/contracts/rt_abi_async.md §5) and the layouts they return, Velt code for
// renaming, linking and copying (`#fs-paths`: wasi-libc's calls under WASI, `ENOTSUP` under a JS
// host), and file streams, which fail with `ENOTSUP` (stream_none.velt). A native build uses
// rt_sched.velt.
//
// Extern conventions (the lowering ABI of `declare function`, rt_abi_async.md §3.1): `string`/
// struct params are passed as `const T*`; a struct result becomes a trailing out-pointer and the
// runtime function returns nothing. Paths and data are borrowed by the runtime and copied at the
// call, so the wrappers never copy.

import { IoResult, unwrapIo } from "velt/native/result";
import { IoStatus, checkIo } from "velt/native/status";
import { Dirent } from "velt/fs/dirent";
import { Stats } from "velt/fs/stats";
import { checkPathArg } from "velt/fs/path_arg";
import { utf8Encode } from "velt/encoding/utf8";
import { take } from "velt/fs/whole/done";
import { copyAt, readlinkAt, realpathAt, renameAt, symlinkAt } from "#fs-paths";
import {
  DirentList,
  dirents,
  velt_rt_fs_append_file_sync,
  velt_rt_fs_exists_sync,
  velt_rt_fs_lstat_sync,
  velt_rt_fs_mkdir_sync,
  velt_rt_fs_read_dir_sync,
  velt_rt_fs_read_dir_typed_sync,
  velt_rt_fs_read_file_bytes_sync,
  velt_rt_fs_remove_sync,
  velt_rt_fs_stat_sync,
  velt_rt_fs_write_file_sync,
} from "./rt_sync";

// File streams: none on WebAssembly (`ENOTSUP`).
export {
  velt_rt_fs_open_read,
  velt_rt_fs_open_read_range,
  velt_rt_fs_open_write,
  velt_rt_fs_reader_close,
  velt_rt_fs_reader_opened_stats,
  velt_rt_fs_reader_read,
  velt_rt_fs_writer_close,
  velt_rt_fs_writer_flush,
  velt_rt_fs_writer_free,
  velt_rt_fs_writer_write,
  velt_rt_fs_writer_write_bytes,
} from "./stream_none";

// Whole files, as std/fs/rt_sched.velt names them for native builds: velt_rt_wasm's functions.
// Text is read as bytes and decoded here, an invalid sequence as U+FFFD (as Node decodes).

export function readTextSync(path: string): string {
  checkPathArg(path);
  return unwrapIo(velt_rt_fs_read_file_bytes_sync(path)).utf8Slice();
}

export function readBytesSync(path: string): u8[] {
  checkPathArg(path);
  return unwrapIo(velt_rt_fs_read_file_bytes_sync(path));
}

/** Writes `data` (truncating, or `append`ing), creating the file if missing. */
export function writeSync(path: string, data: string, append: bool) {
  checkPathArg(path);
  checkIo(
    append ? velt_rt_fs_append_file_sync(path, data) : velt_rt_fs_write_file_sync(path, data),
  );
}

/** `stat` (`follow`) or `lstat`. */
export function statSync(path: string, follow: bool): Stats {
  checkPathArg(path);
  return unwrapIo(follow ? velt_rt_fs_stat_sync(path) : velt_rt_fs_lstat_sync(path));
}

// Directories, as std/fs/rt_sched.velt names them for native builds: velt_rt_wasm's functions.

export function readDirSync(path: string): string[] {
  checkPathArg(path);
  return unwrapIo(velt_rt_fs_read_dir_sync(path));
}

export function readDirEntriesSync(path: string): Dirent[] {
  checkPathArg(path);
  return dirents(unwrapIo(velt_rt_fs_read_dir_typed_sync(path)));
}

export function mkdirSync(path: string, recursive: bool) {
  checkPathArg(path);
  checkIo(velt_rt_fs_mkdir_sync(path, recursive));
}

export function removeSync(path: string, recursive: bool) {
  checkPathArg(path);
  checkIo(velt_rt_fs_remove_sync(path, recursive));
}

export function existsSync(path: string): bool {
  return velt_rt_fs_exists_sync(path);
}

// Renaming, linking and copying, as std/fs/rt_sched.velt names them for native builds: Velt code
// over wasi-libc under WASI, failing with `ENOTSUP` under a JS host (`#fs-paths`). An async form
// runs the sync code on the calling task (WebAssembly has no blocking pool). The callers
// (velt/fs/entries.velt, metadata.velt) have checked the paths with Node's argument names.

/** `path` as `#fs-paths` takes it: its UTF-8 and a 0 (the caller has checked it holds no 0). */
function bytesOf(path: string): u8[] {
  const c = utf8Encode(path);
  c.push(0);
  return c;
}

export function renameSync(from: string, to: string) {
  take(renameAt(bytesOf(from), from, bytesOf(to), to));
}

export async function rename(from: string, to: string): Promise<void> {
  renameSync(from, to);
}

/** `mode`: copy_mode.velt's bits, checked by the caller. */
export function copyFileSync(from: string, to: string, mode: u32) {
  take(copyAt(bytesOf(from), from, bytesOf(to), to, mode));
}

export async function copyFile(from: string, to: string, mode: u32): Promise<void> {
  copyFileSync(from, to, mode);
}

export function symlinkSync(target: string, path: string) {
  take(symlinkAt(bytesOf(target), target, bytesOf(path), path));
}

export async function symlink(target: string, path: string): Promise<void> {
  symlinkSync(target, path);
}

export function readlinkSync(path: string): string {
  return take(readlinkAt(bytesOf(path), path));
}

export async function readlink(path: string): Promise<string> {
  return readlinkSync(path);
}

export function realpathSync(path: string): string {
  return take(realpathAt(bytesOf(path), path));
}

export async function realpath(path: string): Promise<string> {
  return realpathSync(path);
}
