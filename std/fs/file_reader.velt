// velt/fs (internal): `FileReader`, a file open for reading in chunks or lines.

import { IoError } from "velt/io/error";
import { unwrapIo } from "velt/native/result";
import { Stats } from "velt/fs/stats";
import {
  velt_rt_fs_reader_close,
  velt_rt_fs_reader_read,
  velt_rt_fs_reader_read_line,
  velt_rt_fs_reader_read_string,
  velt_rt_fs_reader_opened_stats,
} from "velt/fs/rt";

/** A file open for reading. */
export struct FileReader {
  private handle: u64;

  /** The next 1..max bytes; empty at end of file (`max` 0 = up to 64 KiB). */
  async read(max: u64 = 0): Promise<u8[]> {
    return unwrapIo(await velt_rt_fs_reader_read(this.handle, max));
  }

  /**
   * The next chunk as UTF-8 text ("" at end of file); a character split between chunks is
   * completed by the next call.
   */
  async readString(max: u64 = 0): Promise<string> {
    return unwrapIo(await velt_rt_fs_reader_read_string(this.handle, max));
  }

  /** The next line without "\n" / "\r\n", or null at end of file. Don't mix with `readString`. */
  async readLine(): Promise<string | null> {
    const r = await velt_rt_fs_reader_read_line(this.handle);
    if (r.eof) {
      return null;
    }
    return unwrapIo(r.line);
  }

  /**
   * The remaining lines, as `readLine` reads them: `for await (const line of r.lines())`.
   * Leaving the loop early keeps the reader open at the next line.
   */
  async *lines(): AsyncGenerator<string, IoError> {
    while (true) {
      const r = await velt_rt_fs_reader_read_line(this.handle);
      if (r.eof) {
        return;
      }
      yield unwrapIo(r.line);
    }
  }

  /**
   * The file's metadata when it was opened (taken with the open, so this costs no I/O): the
   * size and modification time of the file this reader reads, even if its path was renamed,
   * replaced or removed since. `size` is the whole file's, whatever range `openRead` was given;
   * a file that grows after the open isn't seen to (`stat(path)` reads it now).
   */
  openedStats(): Stats {
    return unwrapIo(velt_rt_fs_reader_opened_stats(this.handle));
  }

  /** Closes the file (reads in flight finish first). */
  close() {
    velt_rt_fs_reader_close(this.handle);
  }
}
