// velt/fs (internal): the `#fs-paths` variant of Linux (std/imports.velt): posix.velt's renaming,
// linking and copying, with Linux's `fchmod` (a 32-bit `mode_t`) and its data copy:
// `copy_file_range`, which the kernel does without the bytes passing through the program (and
// clones on a file system that can), and where it can't (another file system on an older
// kernel, one it doesn't support), posix.velt's read and write loop, as libuv's `sendfile`
// emulation does.

import { Done } from "velt/fs/whole/done";
import {
  CLONED,
  copyLoop,
  copyWith,
  NOT_CLONED,
  readlinkAt as posixReadlink,
  realpathAt as posixRealpath,
  renameAt as posixRename,
  symlinkAt as posixSymlink,
} from "velt/fs/paths/posix";
import { EINTR } from "velt/fs/fd/system";
import { Ptr } from "velt/ffi/ptr";
import { CVarArgs } from "velt/ffi/c_var_args";
import { lastOsError } from "velt/os/rt";
import { ARCH } from "#os-arch";

/** `mode_t` is 32 bits on Linux. */
declare c("c", { errno: true }) function fchmod(fd: i32, mode: u32): i32;
declare c("c", { errno: true }) function copy_file_range(
  fdIn: i32,
  offIn: Ptr<i64> | null,
  fdOut: i32,
  offOut: Ptr<i64> | null,
  len: usize,
  flags: u32,
): isize;

// The clone is the `ioctl` system call, made through `syscall`: glibc declares `ioctl`'s request
// an `unsigned long`, musl an `int`, while both declare `syscall` alike. `syscall` is variadic:
// each call passes the arguments its system call reads, as C's `...`.
declare c("c", { errno: true }) function syscall$paths(n: i64, ...args: CVarArgs): i64;

/** `_IOW(0x94, 9, int)`, the same on every Linux architecture. */
const FICLONE: i64 = 0x40049409;

/** The `ioctl` system call's number on this architecture. */
function ioctlNumber(): i64 {
  return ARCH === "arm64" ? 29 : 16;
}

/** `copy_file_range`'s errors that mean "not between these files": the loop copies instead. */
const EPERM: i32 = 1;
const EXDEV: i32 = 18;
const EINVAL: i32 = 22;
const ENOSYS: i32 = 38;
const EOPNOTSUPP: i32 = 95;
/** The most `copy_file_range` is asked for at once. */
const CHUNK: usize = 1 << 30;

/** Renames `cf` (`from`) to `ct` (`to`), replacing a file there. */
export function renameAt(
  cf: readonly u8[],
  from: string,
  ct: readonly u8[],
  to: string,
): Done<bool> {
  return posixRename(cf, from, ct, to);
}

/** Makes a link at `cp` (`path`) to `target` (`ct`, stored as it is). */
export function symlinkAt(
  ct: readonly u8[],
  target: string,
  cp: readonly u8[],
  path: string,
): Done<bool> {
  return posixSymlink(ct, target, cp, path);
}

/** The target stored in the link at `c`. */
export function readlinkAt(c: readonly u8[], path: string): Done<string> {
  return posixReadlink(c, path);
}

/** The absolute path of `c` with every link, `.` and `..` resolved. */
export function realpathAt(c: readonly u8[], path: string): Done<string> {
  return posixRealpath(c, path);
}

/**
 * Copies the file `cf` (`from`) to `ct` (`to`), replacing a file there unless `mode` has
 * `COPYFILE_EXCL`. A `FICLONE` bit clones with the `FICLONE` ioctl, as libuv does: where it
 * fails, `COPYFILE_FICLONE` copies and `COPYFILE_FICLONE_FORCE` fails with its errno
 * (`EOPNOTSUPP` on a file system without clones, `EXDEV` across two).
 */
export function copyAt(
  cf: readonly u8[],
  from: string,
  ct: readonly u8[],
  to: string,
  mode: u32,
): Done<bool> {
  return copyWith(cf, from, ct, to, mode, {
    chmod: (fd, perm) => {
      // SAFETY: `fd` is the destination `copyWith` opened and still holds.
      return unsafe { fchmod(fd, perm) };
    },
    cloneFile: (src, dst, force) => {
      // SAFETY: both are descriptors `copyWith` holds; `FICLONE` reads the source's descriptor
      // from its third argument and keeps nothing.
      const r = unsafe { syscall$paths(ioctlNumber(), dst as i64, FICLONE, src as i64) };
      if (r == 0) {
        return CLONED;
      }
      return force ? lastOsError() : NOT_CLONED;
    },
    data: (src, dst, mode, size) => copyData(src, dst, size),
  });
}

/** Copies `size` bytes of `src` to `dst`, from both files' positions: 0, or the errno. */
function copyData(src: i32, dst: i32, size: i64): i32 {
  let left = size;
  while (left > 0) {
    const want: usize = left < (CHUNK as i64) ? left as usize : CHUNK;
    // SAFETY: `src` and `dst` are open descriptors `copyWith` holds; with no offsets C moves
    // the files' own positions, and it keeps no pointer.
    const n = unsafe { copy_file_range(src, null, dst, null, want, 0) };
    if (n > 0) {
      left -= n as i64;
      continue;
    }
    if (n == 0) {
      // The source ended early (it shrank), or, before any byte, a file system that reports 0
      // across file systems (some kernels from 5.3 to 5.18): the loop tries.
      return left == size ? copyLoop(src, dst, left) : 0;
    }
    const e = lastOsError();
    if (e == EINTR) {
      continue;
    }
    // Not possible between these two files: the loop copies the rest (from where the kernel
    // stopped, since it moved the positions). After a part was copied only `EXDEV` and
    // `EINVAL` (a kernel that changed its mind) mean that; anything else is the copy's error.
    const unsupported = e == EXDEV || e == EINVAL || e == ENOSYS || e == EOPNOTSUPP || e == EPERM;
    if (!unsupported || (left != size && e != EXDEV && e != EINVAL)) {
      return e;
    }
    return copyLoop(src, dst, left);
  }
  return 0;
}
