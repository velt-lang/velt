// velt/fs (internal): `fs.constants` on Linux and WebAssembly (`#fs-constants`, std/imports.velt):
// Node's keys, in Node's order, with Node's values, as Node 22.23.5 gives them on Linux arm64
// (`JSON.stringify(fs.constants)`, in the pull request that added it, #3561). `O_DIRECTORY`,
// `O_NOFOLLOW` and `O_DIRECT` differ on x86-64, whose values are its kernel's.

import { ARCH } from "#os-arch";
import { INSPECT } from "velt/lang/hooks/keys";

/** `fs.constants`: the keys Node's has on this OS. */
export struct FsConstants {
  readonly UV_FS_SYMLINK_DIR: number;
  readonly UV_FS_SYMLINK_JUNCTION: number;
  readonly O_RDONLY: number;
  readonly O_WRONLY: number;
  readonly O_RDWR: number;
  readonly UV_DIRENT_UNKNOWN: number;
  readonly UV_DIRENT_FILE: number;
  readonly UV_DIRENT_DIR: number;
  readonly UV_DIRENT_LINK: number;
  readonly UV_DIRENT_FIFO: number;
  readonly UV_DIRENT_SOCKET: number;
  readonly UV_DIRENT_CHAR: number;
  readonly UV_DIRENT_BLOCK: number;
  readonly S_IFMT: number;
  readonly S_IFREG: number;
  readonly S_IFDIR: number;
  readonly S_IFCHR: number;
  readonly S_IFBLK: number;
  readonly S_IFIFO: number;
  readonly S_IFLNK: number;
  readonly S_IFSOCK: number;
  readonly O_CREAT: number;
  readonly O_EXCL: number;
  readonly UV_FS_O_FILEMAP: number;
  readonly O_NOCTTY: number;
  readonly O_TRUNC: number;
  readonly O_APPEND: number;
  readonly O_DIRECTORY: number;
  readonly O_NOATIME: number;
  readonly O_NOFOLLOW: number;
  readonly O_SYNC: number;
  readonly O_DSYNC: number;
  readonly O_DIRECT: number;
  readonly O_NONBLOCK: number;
  readonly S_IRWXU: number;
  readonly S_IRUSR: number;
  readonly S_IWUSR: number;
  readonly S_IXUSR: number;
  readonly S_IRWXG: number;
  readonly S_IRGRP: number;
  readonly S_IWGRP: number;
  readonly S_IXGRP: number;
  readonly S_IRWXO: number;
  readonly S_IROTH: number;
  readonly S_IWOTH: number;
  readonly S_IXOTH: number;
  readonly F_OK: number;
  readonly R_OK: number;
  readonly W_OK: number;
  readonly X_OK: number;
  readonly UV_FS_COPYFILE_EXCL: number;
  readonly COPYFILE_EXCL: number;
  readonly UV_FS_COPYFILE_FICLONE: number;
  readonly COPYFILE_FICLONE: number;
  readonly UV_FS_COPYFILE_FICLONE_FORCE: number;
  readonly COPYFILE_FICLONE_FORCE: number;

  /** How `console.log` shows it, as Node does (`[Object: null prototype] { … }`). */
  [INSPECT](): string {
    const fields = [
      `UV_FS_SYMLINK_DIR: ${this.UV_FS_SYMLINK_DIR}`,
      `UV_FS_SYMLINK_JUNCTION: ${this.UV_FS_SYMLINK_JUNCTION}`,
      `O_RDONLY: ${this.O_RDONLY}`,
      `O_WRONLY: ${this.O_WRONLY}`,
      `O_RDWR: ${this.O_RDWR}`,
      `UV_DIRENT_UNKNOWN: ${this.UV_DIRENT_UNKNOWN}`,
      `UV_DIRENT_FILE: ${this.UV_DIRENT_FILE}`,
      `UV_DIRENT_DIR: ${this.UV_DIRENT_DIR}`,
      `UV_DIRENT_LINK: ${this.UV_DIRENT_LINK}`,
      `UV_DIRENT_FIFO: ${this.UV_DIRENT_FIFO}`,
      `UV_DIRENT_SOCKET: ${this.UV_DIRENT_SOCKET}`,
      `UV_DIRENT_CHAR: ${this.UV_DIRENT_CHAR}`,
      `UV_DIRENT_BLOCK: ${this.UV_DIRENT_BLOCK}`,
      `S_IFMT: ${this.S_IFMT}`,
      `S_IFREG: ${this.S_IFREG}`,
      `S_IFDIR: ${this.S_IFDIR}`,
      `S_IFCHR: ${this.S_IFCHR}`,
      `S_IFBLK: ${this.S_IFBLK}`,
      `S_IFIFO: ${this.S_IFIFO}`,
      `S_IFLNK: ${this.S_IFLNK}`,
      `S_IFSOCK: ${this.S_IFSOCK}`,
      `O_CREAT: ${this.O_CREAT}`,
      `O_EXCL: ${this.O_EXCL}`,
      `UV_FS_O_FILEMAP: ${this.UV_FS_O_FILEMAP}`,
      `O_NOCTTY: ${this.O_NOCTTY}`,
      `O_TRUNC: ${this.O_TRUNC}`,
      `O_APPEND: ${this.O_APPEND}`,
      `O_DIRECTORY: ${this.O_DIRECTORY}`,
      `O_NOATIME: ${this.O_NOATIME}`,
      `O_NOFOLLOW: ${this.O_NOFOLLOW}`,
      `O_SYNC: ${this.O_SYNC}`,
      `O_DSYNC: ${this.O_DSYNC}`,
      `O_DIRECT: ${this.O_DIRECT}`,
      `O_NONBLOCK: ${this.O_NONBLOCK}`,
      `S_IRWXU: ${this.S_IRWXU}`,
      `S_IRUSR: ${this.S_IRUSR}`,
      `S_IWUSR: ${this.S_IWUSR}`,
      `S_IXUSR: ${this.S_IXUSR}`,
      `S_IRWXG: ${this.S_IRWXG}`,
      `S_IRGRP: ${this.S_IRGRP}`,
      `S_IWGRP: ${this.S_IWGRP}`,
      `S_IXGRP: ${this.S_IXGRP}`,
      `S_IRWXO: ${this.S_IRWXO}`,
      `S_IROTH: ${this.S_IROTH}`,
      `S_IWOTH: ${this.S_IWOTH}`,
      `S_IXOTH: ${this.S_IXOTH}`,
      `F_OK: ${this.F_OK}`,
      `R_OK: ${this.R_OK}`,
      `W_OK: ${this.W_OK}`,
      `X_OK: ${this.X_OK}`,
      `UV_FS_COPYFILE_EXCL: ${this.UV_FS_COPYFILE_EXCL}`,
      `COPYFILE_EXCL: ${this.COPYFILE_EXCL}`,
      `UV_FS_COPYFILE_FICLONE: ${this.UV_FS_COPYFILE_FICLONE}`,
      `COPYFILE_FICLONE: ${this.COPYFILE_FICLONE}`,
      `UV_FS_COPYFILE_FICLONE_FORCE: ${this.UV_FS_COPYFILE_FICLONE_FORCE}`,
      `COPYFILE_FICLONE_FORCE: ${this.COPYFILE_FICLONE_FORCE}`,
    ];
    return `[Object: null prototype] {\n  ${fields.join(",\n  ")}\n}`;
  }
}

/** Node's `fs.constants`. */
export const constants: FsConstants = {
  UV_FS_SYMLINK_DIR: 1,
  UV_FS_SYMLINK_JUNCTION: 2,
  O_RDONLY: 0,
  O_WRONLY: 1,
  O_RDWR: 2,
  UV_DIRENT_UNKNOWN: 0,
  UV_DIRENT_FILE: 1,
  UV_DIRENT_DIR: 2,
  UV_DIRENT_LINK: 3,
  UV_DIRENT_FIFO: 4,
  UV_DIRENT_SOCKET: 5,
  UV_DIRENT_CHAR: 6,
  UV_DIRENT_BLOCK: 7,
  S_IFMT: 61440,
  S_IFREG: 32768,
  S_IFDIR: 16384,
  S_IFCHR: 8192,
  S_IFBLK: 24576,
  S_IFIFO: 4096,
  S_IFLNK: 40960,
  S_IFSOCK: 49152,
  O_CREAT: 64,
  O_EXCL: 128,
  UV_FS_O_FILEMAP: 0,
  O_NOCTTY: 256,
  O_TRUNC: 512,
  O_APPEND: 1024,
  O_DIRECTORY: ARCH == "x64" ? 65536 : 16384,
  O_NOATIME: 262144,
  O_NOFOLLOW: ARCH == "x64" ? 131072 : 32768,
  O_SYNC: 1052672,
  O_DSYNC: 4096,
  O_DIRECT: ARCH == "x64" ? 16384 : 65536,
  O_NONBLOCK: 2048,
  S_IRWXU: 448,
  S_IRUSR: 256,
  S_IWUSR: 128,
  S_IXUSR: 64,
  S_IRWXG: 56,
  S_IRGRP: 32,
  S_IWGRP: 16,
  S_IXGRP: 8,
  S_IRWXO: 7,
  S_IROTH: 4,
  S_IWOTH: 2,
  S_IXOTH: 1,
  F_OK: 0,
  R_OK: 4,
  W_OK: 2,
  X_OK: 1,
  UV_FS_COPYFILE_EXCL: 1,
  COPYFILE_EXCL: 1,
  UV_FS_COPYFILE_FICLONE: 2,
  COPYFILE_FICLONE: 2,
  UV_FS_COPYFILE_FICLONE_FORCE: 4,
  COPYFILE_FICLONE_FORCE: 4,
};
