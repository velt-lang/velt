export async function velt_rt_fs_read_dir(path: string): Promise<IoResult<string[]>> {
  if (!hookCall("sched_blocking_supported")) {
    return await rt.velt_rt_fs_read_dir(path);
  }
  return await hookCall<IoResult<string[]>>(
    "sched_blocking_run",
    () => rt.velt_rt_fs_read_dir_sync(path),
  );
}

export async function velt_rt_fs_read_dir_typed(path: string): Promise<IoResult<DirentList>> {
  if (!hookCall("sched_blocking_supported")) {
    const r = await rt.velt_rt_fs_read_dir_typed(path);
    const list: DirentList = { names: r.value.names, kinds: r.value.kinds };
    return { code: r.code, message: r.message, value: list };
  }
  return await hookCall<IoResult<DirentList>>(
    "sched_blocking_run",
    () => velt_rt_fs_read_dir_typed_sync(path),
  );
}

