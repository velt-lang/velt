// velt/fs (internal): the runtime functions velt/fs calls, in a build compiled with the executor
// in Velt (`VELT_SCHEDULER=std`, #2649 step 4): the `std-scheduler` variant of `#fs-rt`
// (std/imports.velt), with the names and signatures of the runtime's (std/fs/rt.velt).
//
// Reading, writing and appending whole files, `stat`, `lstat` and `exists` are Velt code
// (`#fs-whole`: the C library on macOS and Linux, Win32 on Windows), and so are listing, making
// and removing directories (`#fs-tree`) and renaming, linking and copying (`#fs-paths`), their
// async forms on the executor's blocking pool (std/lang/hooks/sched_blocking.velt), which has
// threads on every OS a native build targets (WebAssembly builds use std/fs/rt.velt and
// velt_rt_wasm's). File streams
// (`openRead`, `openWrite` and their
// readers and writers) keep the runtime's leaves: they have no synchronous twin to run on the
// pool (a gap until streams are Velt code over file descriptors, std/fs/fd).

import { Dirent } from "velt/fs/dirent";
import { Stats } from "velt/fs/stats";
import { hookCall } from "velt/lang/intrinsics";
import * as rt from "./rt";
import { checkPathArg } from "velt/fs/path_arg";
import {
  cBytes,
  existsAt,
  readBytes as wholeBytes,
  readText as wholeText,
  statOf,
  writeText,
} from "#fs-whole";
import { Done, take } from "velt/fs/whole/done";
import { list, listTyped, make, removeAt } from "#fs-tree";
import { copyAt, readlinkAt, realpathAt, renameAt, symlinkAt } from "#fs-paths";

export {
  velt_rt_fs_open_read,
  velt_rt_fs_open_read_range,
  velt_rt_fs_open_write,
  velt_rt_fs_reader_close,
  velt_rt_fs_reader_opened_stats,
  velt_rt_fs_reader_read,
  velt_rt_fs_writer_close,
  velt_rt_fs_writer_flush,
  velt_rt_fs_writer_write,
  velt_rt_fs_writer_free,
  velt_rt_fs_writer_write_bytes,
} from "./rt";

// Whole files: Velt code over the C library or Win32 (`#fs-whole`), the async forms on the
// blocking pool. The path is checked on the calling thread, so the work on the pool only
// returns: a 0 in it is Node's `ERR_INVALID_ARG_VALUE` (velt/fs/path_arg.velt), thrown here and
// nowhere before for these functions (std/fs/rt.velt checks the same for WebAssembly builds).

/** `path` as C bytes (its UTF-8 and a 0); Node's `ERR_INVALID_ARG_VALUE` if it holds a 0. */
function cOf(path: string): u8[] {
  checkPathArg(path);
  return bytesOf(path);
}

/** `path` as `#fs-whole` takes it (the caller has checked it holds no 0). */
function bytesOf(path: string): u8[] {
  return cBytes(path);
}

export function readTextSync(path: string): string {
  return take(wholeText(cOf(path), path));
}

export async function readText(path: string): Promise<string> {
  const c = cOf(path);
  return take(await hookCall<Done<string>>("sched_blocking_run", () => wholeText(c, path)));
}

export function readBytesSync(path: string): u8[] {
  return take(wholeBytes(cOf(path), path));
}

export async function readBytes(path: string): Promise<u8[]> {
  const c = cOf(path);
  return take(await hookCall<Done<u8[]>>("sched_blocking_run", () => wholeBytes(c, path)));
}

/** Writes `data` (truncating, or `append`ing), creating the file if missing. */
export function writeSync(path: string, data: string, append: bool) {
  take(writeText(cOf(path), path, data, append));
}

export async function write(path: string, data: string, append: bool): Promise<void> {
  const c = cOf(path);
  take(await hookCall<Done<bool>>("sched_blocking_run", () => writeText(c, path, data, append)));
}

/** `stat` (`follow`) or `lstat`. */
export function statSync(path: string, follow: bool): Stats {
  return take(statOf(cOf(path), path, follow));
}

export async function stat(path: string, follow: bool): Promise<Stats> {
  const c = cOf(path);
  return take(await hookCall<Done<Stats>>("sched_blocking_run", () => statOf(c, path, follow)));
}

// Directories: Velt code over the C library or Win32 (`#fs-tree`), as the whole files above.

/** The names in the directory `path`, sorted. */
export function readDirSync(path: string): string[] {
  return take(list(cOf(path), path));
}

export async function readDir(path: string): Promise<string[]> {
  const c = cOf(path);
  return take(await hookCall<Done<string[]>>("sched_blocking_run", () => list(c, path)));
}

/** The entries of the directory `path` with their types, sorted by name. */
export function readDirEntriesSync(path: string): Dirent[] {
  return take(listTyped(cOf(path), path));
}

export async function readDirEntries(path: string): Promise<Dirent[]> {
  const c = cOf(path);
  return take(await hookCall<Done<Dirent[]>>("sched_blocking_run", () => listTyped(c, path)));
}

/** Makes the directory `path`, with `recursive` its missing parents too. */
export function mkdirSync(path: string, recursive: bool) {
  take(make(cOf(path), path, recursive));
}

export async function mkdir(path: string, recursive: bool): Promise<void> {
  const c = cOf(path);
  take(await hookCall<Done<bool>>("sched_blocking_run", () => make(c, path, recursive)));
}

/** Removes a file, a link or an empty directory, with `recursive` a directory and its contents. */
export function removeSync(path: string, recursive: bool) {
  take(removeAt(cOf(path), path, recursive));
}

export async function remove(path: string, recursive: bool): Promise<void> {
  const c = cOf(path);
  take(await hookCall<Done<bool>>("sched_blocking_run", () => removeAt(c, path, recursive)));
}

/** Whether anything is at `path` (Node's `existsSync`: false, not an error, for a 0 in it). */
export function existsSync(path: string): bool {
  return !path.includes("\0") && existsAt(bytesOf(path), path);
}

export async function exists(path: string): Promise<bool> {
  if (path.includes("\0")) {
    return false;
  }
  const c = bytesOf(path);
  return await hookCall<bool>("sched_blocking_run", () => existsAt(c, path));
}

// Renaming, linking and copying: Velt code over the C library or Win32 (`#fs-paths`). The
// callers (velt/fs/entries.velt, metadata.velt) have checked the paths with Node's argument names.

export function renameSync(from: string, to: string) {
  take(renameAt(bytesOf(from), from, bytesOf(to), to));
}

export async function rename(from: string, to: string): Promise<void> {
  const cf = bytesOf(from);
  const ct = bytesOf(to);
  take(await hookCall<Done<bool>>("sched_blocking_run", () => renameAt(cf, from, ct, to)));
}

export function copyFileSync(from: string, to: string) {
  take(copyAt(bytesOf(from), from, bytesOf(to), to));
}

export async function copyFile(from: string, to: string): Promise<void> {
  const cf = bytesOf(from);
  const ct = bytesOf(to);
  take(await hookCall<Done<bool>>("sched_blocking_run", () => copyAt(cf, from, ct, to)));
}

export function symlinkSync(target: string, path: string) {
  take(symlinkAt(bytesOf(target), target, bytesOf(path), path));
}

export async function symlink(target: string, path: string): Promise<void> {
  const ct = bytesOf(target);
  const cp = bytesOf(path);
  take(await hookCall<Done<bool>>("sched_blocking_run", () => symlinkAt(ct, target, cp, path)));
}

export function readlinkSync(path: string): string {
  return take(readlinkAt(bytesOf(path), path));
}

export async function readlink(path: string): Promise<string> {
  const c = bytesOf(path);
  return take(await hookCall<Done<string>>("sched_blocking_run", () => readlinkAt(c, path)));
}

export function realpathSync(path: string): string {
  return take(realpathAt(bytesOf(path), path));
}

export async function realpath(path: string): Promise<string> {
  const c = bytesOf(path);
  return take(await hookCall<Done<string>>("sched_blocking_run", () => realpathAt(c, path)));
}
