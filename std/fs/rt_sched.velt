// velt/fs (internal): the runtime functions velt/fs calls, in a build compiled with the executor
// in Velt (`VELT_SCHEDULER=std`, #2649 step 4): the `std-scheduler` variant of `#fs-rt`
// (std/imports.velt), with the names and signatures of the runtime's (std/fs/rt.velt).
//
// A whole-file operation (read, write, append, list, stat, link, make, remove, rename, copy,
// exists) runs the runtime's synchronous twin on the executor's blocking pool (std/lang/hooks/
// sched_blocking.velt) instead of the runtime's leaf on tokio's blocking threads; on an OS where
// the pool has no threads, the runtime's leaf. File streams (`openRead`, `openWrite` and their
// readers and writers) keep the runtime's leaves: they have no synchronous twin to run on the
// pool (a gap until streams are Velt code over file descriptors, std/fs/fd).

import { IoResult } from "velt/native/result";
import { IoStatus } from "velt/native/status";
import { Dirent } from "velt/fs/dirent";
import { Stats } from "velt/fs/stats";
import { hookCall } from "velt/lang/intrinsics";
import * as rt from "./rt";

// The runtime's `VeltDirents`, as std/fs/rt.velt declares it (its structs stay that file's own):
// sorted names and, at the same index, each one's kind (0 other, 1 file, 2 directory, 3 symlink).
struct DirentList {
  names: string[];
  kinds: u8[];
}

export declare function velt_rt_fs_read_dir_typed_sync(path: string): IoResult<DirentList>;

/** The entries of a runtime listing, each with its type. */
export function dirents(list: DirentList): Dirent[] {
  const out: Dirent[] = [];
  for (let i = 0; i < list.names.length; i++) {
    out.push({ name: list.names[i], kind: list.kinds[i] });
  }
  return out;
}

export {
  velt_rt_fs_append_file_sync,
  velt_rt_fs_copy_file_sync,
  velt_rt_fs_exists_sync,
  velt_rt_fs_lstat_sync,
  velt_rt_fs_mkdir_sync,
  velt_rt_fs_open_read,
  velt_rt_fs_open_read_range,
  velt_rt_fs_open_write,
  velt_rt_fs_read_dir_sync,
  velt_rt_fs_read_file_bytes_sync,
  velt_rt_fs_read_file_sync,
  velt_rt_fs_reader_close,
  velt_rt_fs_reader_opened_stats,
  velt_rt_fs_reader_read,
  velt_rt_fs_reader_read_line,
  velt_rt_fs_reader_read_string,
  velt_rt_fs_readlink_sync,
  velt_rt_fs_realpath_sync,
  velt_rt_fs_remove_sync,
  velt_rt_fs_rename_sync,
  velt_rt_fs_stat_sync,
  velt_rt_fs_symlink_sync,
  velt_rt_fs_write_file_sync,
  velt_rt_fs_writer_close,
  velt_rt_fs_writer_flush,
  velt_rt_fs_writer_write,
  velt_rt_fs_writer_free,
  velt_rt_fs_writer_write_bytes,
} from "./rt";

export async function velt_rt_fs_read_file(path: string): Promise<IoResult<string>> {
  if (!hookCall("sched_blocking_supported")) {
    return await rt.velt_rt_fs_read_file(path);
  }
  return await hookCall<IoResult<string>>(
    "sched_blocking_run",
    () => rt.velt_rt_fs_read_file_sync(path),
  );
}

export async function velt_rt_fs_read_file_bytes(path: string): Promise<IoResult<u8[]>> {
  if (!hookCall("sched_blocking_supported")) {
    return await rt.velt_rt_fs_read_file_bytes(path);
