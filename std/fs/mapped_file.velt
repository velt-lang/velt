// velt/fs (internal): `MappedFile`, a file's contents as memory (`mmap`): the system reads a
// page from the disk when it is first touched and may drop it again when memory is short, so
// a program works on files larger than memory without reading or copying them.

import { addressArrayOwned } from "velt/lang/intrinsics";
import { adviseMapping, COPIES, mapFile } from "#mapped-source";
import { osError } from "velt/fs/errors";
import { copyOf, heldAgain, MapOptions, Mapping } from "velt/fs/mapped_part";

/** How a range of a `MappedFile` will be read (`advise`). */
export type MapAdvice = "normal" | "random" | "sequential" | "willneed" | "dontneed";

/**
 * A file mapped into memory, read-only. `bytes` is the file (or the part of it that was
 * asked for) as a `shared<u8[]>`: it is
 * read like any byte array (indexing, `subarray`, the SIMD loads) and can be handed to every
 * task without a copy; `f32s`, `i8s`, `u32s` and the other typed methods give a range of it as
 * an array of that number type. Nothing is read when the
 * file is opened; a page comes from the disk when it is first touched (WebAssembly differs:
 * below).
 *
 * The arrays keep the mapping: it is given back to the system when the `MappedFile` is closed
 * (`close()`, `using`, or dropped) and every array it handed out is gone, never earlier, so an
 * array stays valid however long it is kept. A mapping costs address space, not memory, and a
 * system allows a limited number at a time (about 65,000 on Linux by default, then `ENOMEM`):
 * a program that opens many files closes them and lets their arrays go.
 *
 * On Windows a mapped file cannot be removed, renamed over or cut short by anyone until its
 * mapping is given back, and `advise` does nothing (it is a hint).
 *
 * WebAssembly has no mapping: there `open` reads the whole file into memory, also when a part
 * is asked for, and keeps the part; `bytes` is that memory, each typed method gives a copy of
 * its range, and `advise` does nothing. The same program runs; opening costs the time and
 * memory of the whole file, and later changes to the file are not seen.
 *
 * Changing the file's bytes while it is mapped changes what the arrays read. Cutting the file
 * short ends the program with a bus-error signal when a cut page is read, without a message,
 * and output it had buffered may be lost: map files nothing else writes.
 */
export class MappedFile {
  // The mapped bytes, until `close`.
  private held: shared<u8[]> | null;
  // Where `bytes` starts in memory and in the file. A mapping starts at a page of the file,
  // the multiple of 64 KiB before `from` (`lead()` bytes before `bytes`).
  private readonly address: usize;
  private readonly from: usize;
  // The mapping's owner block, which every array over it holds (mapped_part.velt); 0 for none.
  private readonly owner: usize;
  private readonly size: number;

  private constructor(m: Mapping) {
    this.address = m.address;
    this.from = m.from;
    this.owner = m.owner;
    this.size = m.bytes.length as number;
    this.held = m.bytes;
  }

  /** The mapped bytes. An `Error` once the `MappedFile` is closed. */
  get bytes(): shared<u8[]> {
    return this.open("bytes");
  }

  // The mapped bytes for the member `what`, which needs the file open.
  private open(what: string): shared<u8[]> {
    const held = this.held;
    if (held === null) {
      throw new Error(`${what}: the MappedFile is closed`);
    }
    return held;
  }

  /** Whether `close` was called. */
  get closed(): bool {
    return this.held === null;
  }

  /**
   * Gives up the file: `bytes`, the typed methods and `advise` throw from now on. The arrays
   * already handed out stay valid, and the mapping is given back to the system when the last
   * of them is gone (at once, if none is kept). Closing again does nothing. A `MappedFile`
   * that is dropped without `close` is closed; `using m = MappedFile.open(path)` closes it at
   * the end of its block.
   */
  close() {
    this.held = null;
  }

  [Symbol.dispose]() {
    this.close();
  }

  // How many bytes of the mapping lie before `bytes`.
  private lead(): usize {
    return this.from % 65536;
  }

  /**
   * Maps the file at `path`: all of it, or with `options` the `length` bytes from byte
   * `offset` (to the end of the file when `length` is left out), which costs address space
   * for that part only. `RangeError` when that range is not inside the file. A typed view
   * (`f32s`, `u32s`, …) of a part needs its values at a multiple of their size in the file,
   * as it does for a whole file.
   *
   * An `IoError` when the file cannot be opened or mapped: `EISDIR` for a
   * directory, `EINVAL` for anything else that is not a regular file (a device, a pipe).
   * A pipe blocks in `open` until it has a writer, as it does for `readFileSync`.
   *
   * A file of /proc or /sys is a regular file that reports a size of 0 whatever it holds, so it
   * maps as no bytes, without an error: read those with `readFileSync`.
   */
  static open(path: string, options?: MapOptions): MappedFile {
    return new MappedFile(mapFile(path, options));
  }

  /** The number of mapped bytes: the file's size when it was mapped, or the part's. */
  get length(): number {
    return this.size;
  }

  // The address of the `count` values of `width` bytes from byte `byteOffset` (0 for no
  // values), for the method `what`: inside the mapped bytes and aligned for the type, else a
  // `RangeError`. The mapping starts at a page, so an address in it is aligned when its place
  // in the file is.
  private range(
    what: string,
    noun: string,
    byteOffset: number,
    count: number,
    width: number,
  ): usize {
    this.open(what);
    const size = this.size;
    if (
      !Number.isInteger(byteOffset) ||
      !Number.isInteger(count) ||
      byteOffset < 0 ||
      count < 0 ||
      byteOffset + count * width > size
    ) {
      throw new RangeError(
        `${what}(${byteOffset}, ${count}) is not a range of ${width}-byte ${noun} inside the ${size} mapped bytes`,
      );
    }
    // Whole numbers from here on: the place in the file, and whether it is aligned.
    const at = this.from + (byteOffset as usize);
    if (at % (width as usize) != 0) {
      throw new RangeError(
        `${what}(${byteOffset}, ${count}): byte ${at} of the file is not a multiple of ${width}`,
      );
    }
    return count == 0 ? 0 : this.address + (byteOffset as usize);
  }

  /**
   * The `count` `i8` from byte `byteOffset`, as an array over the mapping (no copy; a copy on WebAssembly).
   * `RangeError` when the range is not inside the file.
   */
  i8s(byteOffset: number, count: number): shared<i8[]> {
    const at = this.range("i8s", "integers", byteOffset, count, 1);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `i8`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: i8[] =
      COPIES
        ? copyOf<i8>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<i8>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `u16` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 2 in the file (`byteOffset` plus the part's `offset`).
   */
  u16s(byteOffset: number, count: number): shared<u16[]> {
    const at = this.range("u16s", "integers", byteOffset, count, 2);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `u16`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: u16[] =
      COPIES
        ? copyOf<u16>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<u16>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `i16` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 2 in the file (`byteOffset` plus the part's `offset`).
   */
  i16s(byteOffset: number, count: number): shared<i16[]> {
    const at = this.range("i16s", "integers", byteOffset, count, 2);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `i16`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: i16[] =
      COPIES
        ? copyOf<i16>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<i16>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `u32` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 4 in the file (`byteOffset` plus the part's `offset`).
   */
  u32s(byteOffset: number, count: number): shared<u32[]> {
    const at = this.range("u32s", "integers", byteOffset, count, 4);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `u32`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: u32[] =
      COPIES
        ? copyOf<u32>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<u32>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `i32` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 4 in the file (`byteOffset` plus the part's `offset`).
   */
  i32s(byteOffset: number, count: number): shared<i32[]> {
    const at = this.range("i32s", "integers", byteOffset, count, 4);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `i32`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: i32[] =
      COPIES
        ? copyOf<i32>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<i32>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `u64` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 8 in the file (`byteOffset` plus the part's `offset`).
   */
  u64s(byteOffset: number, count: number): shared<u64[]> {
    const at = this.range("u64s", "integers", byteOffset, count, 8);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `u64`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: u64[] =
      COPIES
        ? copyOf<u64>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<u64>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `i64` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 8 in the file (`byteOffset` plus the part's `offset`).
   */
  i64s(byteOffset: number, count: number): shared<i64[]> {
    const at = this.range("i64s", "integers", byteOffset, count, 8);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `i64`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: i64[] =
      COPIES
        ? copyOf<i64>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<i64>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `f16` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 2 in the file (`byteOffset` plus the part's `offset`).
   */
  f16s(byteOffset: number, count: number): shared<f16[]> {
    const at = this.range("f16s", "floats", byteOffset, count, 2);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `f16`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: f16[] =
      COPIES
        ? copyOf<f16>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<f16>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `bf16` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 2 in the file (`byteOffset` plus the part's `offset`).
   */
  bf16s(byteOffset: number, count: number): shared<bf16[]> {
    const at = this.range("bf16s", "floats", byteOffset, count, 2);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `bf16`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: bf16[] =
      COPIES
        ? copyOf<bf16>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<bf16>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `f32` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 4 in the file (`byteOffset` plus the part's `offset`).
   */
  f32s(byteOffset: number, count: number): shared<f32[]> {
    const at = this.range("f32s", "floats", byteOffset, count, 4);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `f32`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: f32[] =
      COPIES
        ? copyOf<f32>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<f32>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * The `count` little-endian `f64` from byte `byteOffset`, as an array over the mapping (no
   * copy; a copy on WebAssembly). `RangeError` when the range is not inside the mapped bytes, or its first
   * byte is not at a multiple of 8 in the file (`byteOffset` plus the part's `offset`).
   */
  f64s(byteOffset: number, count: number): shared<f64[]> {
    const at = this.range("f64s", "floats", byteOffset, count, 8);
    if (at == 0) {
      return shared([]);
    }
    // SAFETY: `range` checked that the values are inside the mapping and aligned for `f64`
    // (the mapping is page-aligned); the array holds the mapping's owner, so the mapping stays
    // while it does, and it leaves as `shared`.
    // Where there is no mapping (`COPIES`) no address is read: the values are copied.
    const xs: f64[] =
      COPIES
        ? copyOf<f64>(this.bytes, byteOffset as usize, count as usize)
        : unsafe { addressArrayOwned<f64>(at, count as usize, heldAgain(this.owner)) };
    return shared(xs);
  }

  /**
   * Tells the system how the `length` bytes from `byteOffset` (all the mapped bytes by default)
   * will be read: `"sequential"` reads ahead more, `"random"` not at all, `"willneed"` starts
   * reading them now, `"normal"` is the default. `"dontneed"` gives their memory back now
   * rather than when the system runs short: the next read of them comes from the file again.
   * A hint: it never changes what is read. It works on whole pages (huge ones where the system
   * maps the file with them), so it may reach past either end of the range. `RangeError` when
   * the range is not inside the mapped bytes; an `IoError` if the system refuses the advice.
   */
  advise(advice: MapAdvice, byteOffset: number = 0, length?: number) {
    this.open("advise");
    const size = this.size;
    const len = length === undefined ? size - byteOffset : length;
    if (
      !Number.isInteger(byteOffset) ||
      !Number.isInteger(len) ||
      byteOffset < 0 ||
      len < 0 ||
      byteOffset + len > size
    ) {
      throw new RangeError(
        `advise: ${byteOffset}..${byteOffset + len} is not inside the ${size} mapped bytes`,
      );
    }
    if (len == 0 || COPIES) {
      // Nothing to advise, or no mapping to give the advice for.
      return;
    }
    // `madvise` takes whole pages from a page's start: round the start down to a multiple of
    // 64 KiB from the mapping's start, which is a page's start for every page size in use (4,
    // 16 and 64 KiB).
    const lead = this.lead() as number;
    const at = lead + byteOffset;
    const start = at - (at % 65536);
    const code: i32 =
      advice == "random"
        ? 1
        : advice == "sequential" ? 2 : advice == "willneed" ? 3 : advice == "dontneed" ? 4 : 0;
    const base = this.address - this.lead();
    const e = adviseMapping(base + (start as usize), (at - start + len) as usize, code);
    if (e != 0) {
      throw osError(e, "madvise");
    }
  }
}
