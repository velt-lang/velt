// velt/fs (internal): Node's check of a path argument. A path holding a 0 byte is an error
// before any system call, as Node's `ERR_INVALID_ARG_VALUE`: an `IoError` whose `code` is that,
// whose `name` is `TypeError`, and whose message names the argument
// (`path`, or `oldPath`, `newPath`, `src`, `dest`, `target`) and shows the string as Node's
// `util.inspect` does: in single quotes (double ones when it holds `'` and no `"`, backticks
// when it holds both and no backtick), with the quote, `\`, control characters and lone
// surrogates escaped. Node's is a `TypeError`; here it is an `IoError` (as velt/fs/rm.velt's
// `ERR_FS_EISDIR` is), so that every velt/fs function keeps throwing `IoError` alone and code
// that reads `e.code` after a call keeps compiling. The one difference: `e instanceof
// TypeError` is false.

import { IoError } from "velt/io/error";
import { noInline } from "velt/lang/intrinsics";

/** Throws Node's `ERR_INVALID_ARG_VALUE` when `path`, the argument `name`, holds a 0. */
export function checkPathArg(path: string, name: string = "path") {
  if (path.includes("\0")) {
    throw nulInPath(path, name);
  }
}

@noInline
function nulInPath(path: string, name: string): IoError {
  const e = new IoError(
    "ERR_INVALID_ARG_VALUE",
    `The argument '${name}' must be a string, Uint8Array, or URL without null bytes. Received ${inspectText(path)}`,
  );
  e.name = "TypeError";
  return e;
}

const HEX = "0123456789ABCDEF";

/** `u` (under 0x100) as `\xNN`, the digits upper case, as Node writes it. */
function hexEscape(u: i64): string {
  return `\\x${HEX.charAt(u >> 4)}${HEX.charAt(u & 15)}`;
}

/** A lone surrogate as `\uNNNN`, the digits lower case, as Node writes it. */
function surrogateEscape(u: i64): string {
  return `\\u${u.toString(16)}`;
}

/** `s` quoted and escaped as Node's `util.inspect` shows a string. */
export function inspectText(s: string): string {
  const single = s.includes("'");
  const double = s.includes('"');
  const quote = !single ? "'" : !double ? '"' : !s.includes("`") ? "`" : "'";
  const q = quote.charCodeAt(0) as i64;
  let out = quote;
  const n = s.length as i64;
  for (let i: i64 = 0; i < n; i++) {
    const u = s.charCodeAt(i) as i64;
    if (u == q || u == 92) {
      out += `\\${String.fromCharCode(u as f64)}`;
    } else if (u == 8) {
      out += "\\b";
    } else if (u == 9) {
      out += "\\t";
    } else if (u == 10) {
      out += "\\n";
    } else if (u == 12) {
      out += "\\f";
    } else if (u == 13) {
      out += "\\r";
    } else if (u < 0x20 || (u >= 0x7f && u < 0xa0)) {
      out += hexEscape(u);
    } else if (u >= 0xd800 && u < 0xdc00) {
      const next = i + 1 < n ? s.charCodeAt(i + 1) as i64 : 0;
      if (next >= 0xdc00 && next < 0xe000) {
        out += String.fromCharCode(u as f64, next as f64);
        i++;
      } else {
        out += surrogateEscape(u);
      }
    } else if (u >= 0xdc00 && u < 0xe000) {
      out += surrogateEscape(u);
    } else {
      out += String.fromCharCode(u as f64);
    }
  }
  return out + quote;
}
