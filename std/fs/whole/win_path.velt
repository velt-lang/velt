// velt/fs (internal): a path as Win32's wide-path functions take it (std/fs/whole/win32.velt,
// std/fs/tree/win32.velt). A path whose absolute form has 248 units or more, counting its NUL
// (`CreateDirectoryW`'s limit), is given in that form with the `\\?\` prefix, as Rust's std
// does, so that it is not cut at MAX_PATH. The limit is the absolute path's: a short relative
// path under a long working directory needs the prefix too, so only an absolute path is
// judged by its own length.

import { Out } from "velt/ffi/out";
import { wideOf } from "velt/ffi/wide";
import { arraySetLen, arrayWithCapacity } from "velt/lang/intrinsics";

declare c("c") function GetFullPathNameW(
  name: readonly u16[],
  room: u32,
  out: u16[],
  file: Out<Ptr<u16> | null>,
): u32;

/** The length, with its NUL, from which a path needs the `\\?\` prefix. */
const LEGACY_MAX_PATH: usize = 248;

/** Whether the code unit `u` separates a path's parts. */
function isSep(u: u16): bool {
  return u === 92 || u === 47;
}

/** Whether the wide path `w` (with its NUL) is absolute: `X:`, `X:\…`, or two separators first. */
function isAbsolute(w: readonly u16[]): bool {
  if (w.length >= 3 && w[1] === 58 && !isSep(w[0]) && (w[2] === 0 || isSep(w[2]))) {
    return true;
  }
  return w.length >= 2 && isSep(w[0]) && isSep(w[1]);
}

/**
 * `path` as a NUL-terminated wide path, `\\?\`-prefixed when its absolute form is long; null for
 * a 0 inside it.
 */
export function winPath(path: string): u16[] | null {
  const w = wideOf(path);
  if (w === null || w.length === 1 || path.startsWith("\\\\?\\") || path.startsWith("\\\\.\\")) {
    return w;
  }
  if (w.length < LEGACY_MAX_PATH && isAbsolute(w)) {
    return w;
  }
  let room: u32 = 512;
  while (true) {
    const full = arrayWithCapacity<u16>(room as usize);
    arraySetLen(full, room as usize);
    // SAFETY: `w` is NUL-terminated and `full` holds `room` units, the count passed.
    const got = unsafe { GetFullPathNameW(w, room, full, new Out<Ptr<u16> | null>(null)) };
    if (got === 0) {
      return w;
    }
    if (got < room) {
      if ((got as usize) + 1 < LEGACY_MAX_PATH) {
        // The absolute path is short: Win32 resolves the path as it was given.
        return w;
      }
      arraySetLen(full, got as usize);
      // Already `\\?\` or `\\.\` (a long `//?/x` normalises to it): as it is, with its NUL.
      const verbatim = got > 3 && full[0] === 92 && full[1] === 92 && full[3] === 92;
      if (verbatim && (full[2] === 63 || full[2] === 46)) {
        full.push(0);
        return full;
      }
      // `\\server\share\x` is `\\?\UNC\server\share\x`; `C:\x` is `\\?\C:\x`.
      const unc = got > 2 && full[0] === 92 && full[1] === 92;
      const prefix = unc ? "\\\\?\\UNC" : "\\\\?\\";
      const out = wideOf(prefix);
      if (out === null) {
        return w;
      }
      out.pop();
      for (let i: usize = unc ? 1 : 0; i < (got as usize); i++) {
        out.push(full[i]);
      }
      out.push(0);
      return out;
    }
    room = got;
  }
}
