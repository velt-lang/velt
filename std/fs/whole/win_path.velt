// velt/fs (internal): a path as Win32's wide-path functions take it (std/fs/whole/win32.velt,
// std/fs/tree/win32.velt, std/fs/paths/win32.velt, std/fs/mapped_win32.velt), and the error
// that names it. As Node does, every path is resolved and given with the `\\?\` prefix
// (velt/fs/whole/win_resolve): Windows then takes the name as it is (`a.txt.` is not `a.txt`,
// `NUL` is a file in the directory, not the device), a path is not cut at MAX_PATH, and
// separators after a path name what is before them (`dir\file\` is the file). Errors name the
// path the same way, absolute and without the prefix, as Node's do.

import { wideOf } from "velt/ffi/wide";
import { osError } from "velt/fs/errors";
import {
  Dirs,
  NOT_PLAIN,
  PLAIN_ABSOLUTE,
  namespaced,
  plainKind,
  plainNamespaced,
  resolveWin32,
  shownPath,
} from "velt/fs/whole/win_resolve";
import { IoError } from "velt/io/error";
import { cwd } from "velt/process/cwd_win32";
import { driveDir } from "velt/process/full_path_win32";

/** The process' working directories. */
function dirs(): Dirs {
  return new Dirs(() => workingDir(), (device) => driveDir(device) ?? undefined);
}

/**
 * The working directory, or "" when Windows can't give it: a relative path then goes to Windows
 * as it is, which fails there or resolves it itself.
 */
function workingDir(): string {
  try {
    return cwd();
  } catch (e) {
    return "";
  }
}

/** `path` as a NUL-terminated wide path, the way Node gives it to Windows; null for a 0 in it. */
export function winPath(path: string): u16[] | null {
  return wideOf(namespacedPath(path));
}

/**
 * `path` as Node gives it to Windows (`namespaced`), joined without resolving when it is plain
 * (most are: `plainKind`), which costs a fraction of resolving.
 */
export function namespacedPath(path: string): string {
  const kind = plainKind(path);
  if (kind !== NOT_PLAIN) {
    const plain = plainNamespaced(path, kind, kind === PLAIN_ABSOLUTE ? "" : workingDir());
    if (plain !== null) {
      return plain;
    }
  }
  return namespaced(path, dirs());
}

/** `path` made absolute, as Node's `path.win32.resolve(path)` does. */
export function resolved(path: string): string {
  return resolveWin32(path, dirs());
}

/** `path` as Node's errors name it on Windows: absolute, without the `\\?\` prefix. */
export function shown(path: string): string {
  return shownPath(path, dirs());
}

/**
 * The `IoError` for the errno `e` of `syscall` on `path` (and to `dest`), naming the paths as
 * Node does on Windows (`ENOENT: no such file or directory, open 'C:\work\a.txt'`).
 */
export function winError(
  e: i32,
  syscall: string,
  path: string | null = null,
  dest: string | null = null,
): IoError {
  return osError(
    e,
    syscall,
    path === null ? null : shown(path),
    dest === null ? null : shown(dest),
  );
}
