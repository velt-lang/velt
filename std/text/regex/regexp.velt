// velt/text (internal): JavaScript's regular expressions, compiled and matched by std itself
// (velt/text/regex: parse_pattern, compiler, backtrack, pike). Matching takes time linear in
// the subject, whatever the pattern (no catastrophic backtracking); in exchange lookaround and
// back references are not supported (compiling them throws `RegExpError`).
//
// Offsets are UTF-16 code units, like every Velt string position (`slice`, `indexOf`).
// `\d \w \b` are ASCII-only as in JS; `i m s u` flags work as in JS; `g` makes `replace` replace
// every match and `y` (sticky) makes `test`/`exec` match only at the start position. Called
// without a start (`exec(s)`), a `g` or `y` regex starts at `lastIndex` and updates it, as in JS;
// `exec(s, from)` takes the start explicitly and leaves `lastIndex` alone.
//
// The string methods that take a regex (`s.replace(re, …)`, `match`, `matchAll`, `search`,
// `split`, `replaceAll`) are the functions of velt/text/regex/string_methods, loaded with this
// file: the compiler calls them when the first argument is a `RegExp` (velt_sema's
// `regex_args`), and they call this class's methods keyed by velt/text/regex/keys.
//
// A `RegExp`'s program never changes once compiled, and `lastIndex` is an `Atomic` in a shared
// object of the regex's own, so no method needs a receiver it may change.
//
// An object of a class that extends `RegExp` may have an `exec` of its own, which JavaScript's
// methods call: where `isExactClass(this)` is false they take the steps of exec_calls.velt.

import { Pattern } from "velt/text/regex/pattern";
import { compileRegExp } from "velt/text/regex/regexp_compile";
import { foundByExec, replaceFound, splitting } from "velt/text/regex/exec_calls";
import { find, findAll } from "velt/text/regex/find";
import { CURSOR, MATCH, MATCH_ALL, REPLACE_CALLING, SEARCH, SPLIT } from "velt/text/regex/keys";
import { past, positionOf, textOf } from "velt/text/regex/offsets";
import { matchOf } from "velt/text/regex/match_of";
import { Program } from "velt/text/regex/program";
import { RegExpMatch } from "velt/text/regex/regexp_match";
import { own } from "velt/lang/intrinsics/decorators";
import { INSPECT } from "velt/lang/hooks/keys";
import { flagsText, sourceText } from "velt/text/regex/source_text";
import { escapePattern, replaceMatches, splitMatches } from "velt/text/regex/replace";
import { lookExec, lookTest, YES } from "velt/text/regex/quick";
import { Cursor, cursorCopy, keepTables, memoryOf } from "velt/text/regex/cursor";
import { Search } from "velt/text/regex/search";
// The string methods that take a regex (compiler hooks).
import "velt/text/regex/string_methods";
import { arrayWithCapacity, isExactClass, noInline, strByteLen } from "velt/lang/intrinsics";

/** A compiled regular expression: `new RegExp("(\\d+)-(\\d+)", "g")`. */
export class RegExp implements Pattern {
  /**
   * The pattern as a regex literal writes it, as in JavaScript: `new RegExp("a/b").source` is
   * `a\/b`, and the empty pattern's is `(?:)` (velt/text/regex/source_text).
   */
  readonly source: string;
  /** The flags in JavaScript's order (`dgimsuvy`): `new RegExp("a", "ig").flags` is `gi`. */
  readonly flags: string;
  /** `g`: `replace` replaces every match. */
  readonly global: bool;
  /** `y`: `test`/`exec` only match starting exactly at the start position. */
  readonly sticky: bool;
  // The program never changes once compiled: copies of the regex share it, from any thread
  // (`shared`: an atomic count, read in place). The searches only read it, and the automatons
  // they make are given it, not keeping it (dfa.velt), so reading it costs no copy (#3883).
  #prog: shared<Program>;
  #names: string[];
  #cursor: shared<Cursor>;
  /** The pattern as given, which `new RegExp(re, flags)` compiles again. */
  #pattern: string;

  /**
   * Throws `RegExpError` for an invalid pattern or flags. Given a regex, as in JavaScript: its
   * pattern, with `flags` if given, else its own (then sharing its program, as copies do), and a
   * `lastIndex` of 0. The group names are copied: a few strings, which a `shared` would cost
   * more to make for every regex.
   */
  constructor(pattern: string | RegExp, flags?: string) {
    if (typeof pattern === "string") {
      const f = flags ?? "";
      const names: string[] = [];
      this.#prog = shared(compileRegExp(pattern, f, names));
      this.#names = names;
      this.#pattern = pattern.clone();
      this.source = sourceText(pattern);
      this.flags = flagsText(f);
      this.#cursor = shared(new Cursor());
    } else if (flags === undefined) {
      // Read into a local first: a deep copy runs this on one regex from several threads at once
      // (`clone`), and passing a field of `pattern` to a call would count `pattern` up and down,
      // which is not atomic (std/shared_fn_regex_counted).
      const cursor = pattern.#cursor;
      this.#prog = pattern.#prog;
      this.#names = pattern.#names.clone();
      this.#pattern = pattern.#pattern;
      this.source = pattern.source;
      this.flags = pattern.flags;
      this.#cursor = cursorCopy(cursor);
    } else {
      const names: string[] = [];
      this.#prog = shared(compileRegExp(pattern.#pattern, flags, names));
      this.#names = names;
      this.#pattern = pattern.#pattern;
      this.source = pattern.source;
      this.flags = flagsText(flags);
      this.#cursor = shared(new Cursor());
    }
    this.global = this.flags.includes("g");
    this.sticky = this.flags.includes("y");
  }

  /**
   * Whether `s` matches (anywhere at or after position `from`; exactly at `from` when sticky).
   * Without `from`, a `g` or `y` regex starts at `lastIndex` and updates it, like `exec`.
   * Called, not inlined: the search inlined into a caller's loop made the caller's other code
   * slower (its registers spilled).
   */
  @noInline
  test(s: string, from?: usize): bool {
    if (!isExactClass(this)) {
      // As JS's `test` calls `exec(s)`: `from` only when given, so an override's own default
      // for it applies.
      return (from == null ? this.exec(s) : this.exec(s, from)) != null;
    }
    if (from == null && (this.global || this.sticky)) {
      return this.exec(s) != null;
    }
    const start = from ?? 0;
    if (start > s.length) {
      return false;
    }
    const prog = this.#prog;
    const sticky = this.sticky;
    const at = lookTest(prog, this.#cursor, s, positionOf(s, start, prog.units), sticky);
    if (at < 0) {
      return at == YES;
    }
    const m = this.memory(0);
    const found = find(prog, m, s, at as usize, sticky);
    this.keep(m);
    return found;
  }

  /**
   * The first match at or after position `from` (exactly at `from` when sticky), or null.
   * Without `from`, a `g` or `y` regex starts at `lastIndex` and sets it past the match, or to 0
   * when there is none (JS `exec`); other regexes start at 0.
   */
  exec(s: string, from?: usize): RegExpMatch | null {
    if (!isExactClass(this)) {
      return from == null ? this.execOwn(s) : this.execOwn(s, from);
    }
    if (from != null || !(this.global || this.sticky)) {
      return this.execAt(s, from ?? 0);
    }
    const start = this.lastIndex as usize;
    const m = start > s.length ? null : this.execAt(s, start);
    this.#cursor.at.store(m == null ? 0 : m.end);
    return m;
  }

  /** Every non-overlapping match, in order (JS `s.matchAll(re)`, whatever the flags). */
  matchAll(s: string): RegExpMatch[] {
    const prog = this.#prog;
    const stride = 2 * (prog.groups as usize) + 2;
    const m = this.memory(stride);
    findAll(prog, m, s);
    this.keep(m);
    const out: RegExpMatch[] = arrayWithCapacity(m.found.length / stride);
    for (let at: usize = 0; at < m.found.length; at += stride) {
      out.push(matchOf(this.#names, s, m.found, at));
    }
    return out;
  }

  /** The text of every match (JS `s.match(re)` with the `g` flag); empty if none. */
  matches(s: string): string[] {
    const prog = this.#prog;
    const m = this.memory(2);
    findAll(prog, m, s);
    this.keep(m);
    const out: string[] = arrayWithCapacity(m.found.length / 2);
    for (let at: usize = 0; at < m.found.length; at += 2) {
      out.push(textOf(s, m.found[at] as usize, m.found[at + 1] as usize));
    }
    return out;
  }

  /**
   * JS `s.replace(re, replacement)`: every match with the `g` flag, else the first.
   * `replacement` expands `$&`, `$1`…`$99`, `$<name>`, `` $` ``, `$'` and `$$`. A sticky regex
   * matches only at `lastIndex` (with `g`: from 0, each match where the previous one ended), and
   * `lastIndex` changes as in JS.
   */
  replace(s: string, replacement: string): string {
    if (!isExactClass(this)) {
      return replaceFound(s, foundByExec(this, s), (m, s) => m.substitute(s, replacement));
    }
    if (this.global) {
      this.#cursor.at.store(0);
    }
    if (!this.sticky) {
      return replaceMatches(this.#prog, this.#names, s, replacement, this.global);
    }
    let out = "";
    let last: number = 0;
    for (const m of this.replaced(s)) {
      out += s.slice(last as i64, m.index as i64);
      out += m.substitute(s, replacement);
      last = m.end;
    }
    out += s.slice(last as i64);
    return out;
  }

  /** Replaces every match, whatever the flags (JS `replaceAll`). */
  replaceAll(s: string, replacement: string): string {
    return replaceMatches(this.#prog, this.#names, s, replacement, true);
  }

  /**
   * Replaces matches (every one with `g`, else the first) with `f(match)`; the matches are the
   * ones `replace` replaces.
   */
  replaceWith<E>(s: string, f: (m: RegExpMatch) => string throws E): string {
    if (!isExactClass(this)) {
      return replaceFound(s, foundByExec(this, s), (m, _s) => f(m));
    }
    let out = "";
    let last: number = 0;
    for (const m of this.replaced(s)) {
      out += s.slice(last as i64, m.index as i64);
      out += f(m);
      last = m.end;
    }
    out += s.slice(last as i64);
    return out;
  }

  /** `replaceWith` for `s.replace(re, (match, ...groups) => …)`: `f` gets the subject too. */
  [REPLACE_CALLING]<E>(s: string, f: (m: RegExpMatch, s: string) => string throws E): string {
    if (!isExactClass(this)) {
      return replaceFound(s, foundByExec(this, s), f);
    }
    let out = "";
    let last: number = 0;
    for (const m of this.replaced(s)) {
      out += s.slice(last as i64, m.index as i64);
      out += f(m, s);
      last = m.end;
    }
    out += s.slice(last as i64);
    return out;
  }

  /** JS `s.match(re)`: every match's text with `g` (null if none), else `exec`'s groups. */
  [MATCH](s: string): string[] | null {
    if (!this.global) {
      const m = this.exec(s);
      if (m == null) {
        return null;
      }
      const out: string[] = arrayWithCapacity(m.captures.length + 1);
      out.push(m.value.clone());
      for (const c of m.captures) {
        out.push(c ?? "");
      }
      return out;
    }
    this.#cursor.at.store(0);
    const found = this.sticky ? this.stickyTexts(s) : this.matches(s);
    return found.length == 0 ? null : found;
  }

  /** JS `s.matchAll(re)` (a `g` regex): every match from `lastIndex` on, which stays as is. */
  [MATCH_ALL](s: string): RegExpMatch[] {
    if (!this.global) {
      panic("TypeError: String.prototype.matchAll called with a non-global RegExp argument");
    }
    if (this.lastIndex == 0 && !this.sticky) {
      return this.matchAll(s);
    }
    const saved = this.lastIndex;
    const out: RegExpMatch[] = [];
    while (true) {
      const m = this.exec(s);
      if (m == null) {
        break;
      }
      if (m.end == m.index) {
        this.#cursor.at.store(past(s, m.end, this.#prog.units));
      }
      out.push(m);
    }
    this.#cursor.at.store(saved);
    return out;
  }

  /** JS `s.search(re)`: where the first match from 0 starts, or -1; `lastIndex` stays. */
  [SEARCH](s: string): i64 {
    const m = this.execAt(s, 0);
    return m == null ? -1 : m.index as i64;
  }

  /** JS `s.split(re, limit)`: no limit when null, `[]` for 0. */
  [SPLIT](s: string, limit: number | null | undefined): string[] {
    const n = limit == null ? -1 : limit as i64;
    return n == 0 ? [] : splitMatches(this.#prog, s, n > 0 ? n as usize : 0);
  }

  /** JS `s.split(re, limit)`: captured groups are included in the result; `limit` 0 = none. */
  split(s: string, limit: usize = 0): string[] {
    return splitMatches(this.#prog, s, limit);
  }

  /**
   * Where `exec(s)` and `test(s)` of a `g` or `y` regex start, set past each match (0 after a
   * failed one); `s.replace`, `s.match` and `s.matchAll` read and set it as in JS. An `Atomic`,
   * so the methods that update it don't need a mutable receiver. It is the regex's own data
   * property, as in JavaScript: a subclass's `lastIndex` accessors are never reached.
   */
  @own()
  get lastIndex(): number {
    return this.#cursor.at.load();
  }

  /**
   * Any value may be written, as in JavaScript (through `any`: `a.lastIndex = "3"`). It is kept
   * as a number (`Number(value)`), as `exec` reads it (JavaScript keeps the value as written,
   * and converts it at each `exec`, #3883).
   */
  set lastIndex(value: unknown) {
    this.#cursor.at.store(typeof value === "number" ? value : Number(value));
  }

  /** The cursor: its `lastIndex` is the regex's own, whatever a subclass declares. */
  [CURSOR](): shared<Cursor> {
    return this.#cursor;
  }

  /** The regex as a literal writes it: `/a\/b/gi`, as in JavaScript. */
  toString(): string {
    return `/${this.source}/${this.flags}`;
  }

  /** How `console.log` shows the regex, as Node does: `/a/g`, a subclass's as `Sub /a/g`. */
  [INSPECT](): string {
    if (isExactClass(this)) {
      return this.toString();
    }
    const o: object = this;
    return `${o.constructor.name} ${this.toString()}`;
  }

  /** Number of capture groups (not counting the whole match). */
  get groupCount(): usize {
    return this.#prog.groups as usize;
  }

  /** `s` with every regex metacharacter escaped, for building patterns from text. */
  static escape(s: string): string {
    return escapePattern(s);
  }

  /**
   * An independent copy, as JavaScript's structured clone makes one (`new RegExp(re)`): the same
   * program, with a `lastIndex` of its own, 0. Every deep copy of a regex runs it
   * (`structuredClone`, a copy for another task or a `shared(...)` call, #3883), so no copy
   * moves the original's `lastIndex`. It changes no count of the original's but atomic ones
   * (its program's `shared`, strings).
   */
  clone(): RegExp {
    try {
      return new RegExp(this);
    } catch (e) {
      panic(`ICE: RegExp.clone: a copy that shares the program threw: ${e.message}`);
    }
  }

  /** A search with `slots` capture slots, as the next call of this regex. */
  private memory(slots: usize): Search {
    return memoryOf(this.#cursor, this.#prog, slots);
  }

  /** Keeps the tables of `m`'s automatons for the next calls. */
  private keep(m: Search): void {
    keepTables(this.#cursor, m);
  }

  /** Called, not inlined, as `test`. */
  @noInline
  private execAt(s: string, from: usize): RegExpMatch | null {
    const prog = this.#prog;
    if (from > s.length) {
      return null;
    }
    const stride = 2 * (prog.groups as usize) + 2;
    const sticky = this.sticky;
    // The slots of a search off the kept tables (quick.velt), when the program has one.
    const fill = prog.quick && !sticky ? stride : 0;
    const slots: i64[] = arrayWithCapacity(fill);
    for (let k: usize = 0; k < fill; k++) {
      slots.push(-1);
    }
    const at = lookExec(prog, this.#cursor, s, positionOf(s, from, prog.units), sticky, slots);
    if (at < 0) {
      return at == YES ? matchOf(this.#names, s, slots, 0) : null;
    }
    const m = this.memory(stride);
    const found = find(prog, m, s, at as usize, sticky);
    this.keep(m);
    return found ? matchOf(this.#names, s, m.slots, 0) : null;
  }

  // The built-in `exec` of an object of a subclass: as `exec`, and for the regex a `split` is
  // running on (exec_calls.velt) exactly at `lastIndex`, as its sticky copy does in JavaScript.
  private execOwn(s: string, from?: usize): RegExpMatch | null {
    const split = from == null && splitting(this);
    if (!split && (from != null || !(this.global || this.sticky))) {
      return this.execAt(s, from ?? 0);
    }
    const start = this.#cursor.at.load() as usize;
    const m = start > s.length ? null : split ? this.execStuck(s, start) : this.execAt(s, start);
    this.#cursor.at.store(m == null ? 0 : m.end);
    return m;
  }

  // `execAt` as a sticky regex: the match that starts exactly at `from`.
  private execStuck(s: string, from: usize): RegExpMatch | null {
    const prog = this.#prog;
    const m = this.memory(2 * (prog.groups as usize) + 2);
    const found = find(prog, m, s, positionOf(s, from, prog.units), true);
    this.keep(m);
    return found ? matchOf(this.#names, s, m.slots, 0) : null;
  }

  // The matches `replace` replaces, setting `lastIndex` as JS does.
  private replaced(s: string): RegExpMatch[] {
    if (this.global) {
      this.#cursor.at.store(0);
      return this.sticky ? this.stickyMatches(s) : this.matchAll(s);
    }
    const out: RegExpMatch[] = [];
    const m = this.exec(s);
    if (m != null) {
      out.push(m);
    }
    return out;
  }

  // A sticky `g` regex's matches: from 0, each one where the previous one ended.
  private stickyMatches(s: string): RegExpMatch[] {
    const out: RegExpMatch[] = [];
    let at: usize = 0;
    while (at <= s.length) {
      const m = this.execAt(s, at);
      if (m == null) {
        break;
      }
      at = (m.end == m.index ? past(s, m.end, this.#prog.units) : m.end) as usize;
      out.push(m);
    }
    return out;
  }

  private stickyTexts(s: string): string[] {
    const out: string[] = [];
    for (const m of this.stickyMatches(s)) {
      out.push(m.value.clone());
    }
    return out;
  }
}
