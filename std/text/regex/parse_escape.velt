// velt/text (internal): the escapes and the character classes of a pattern (`\n`, `\x41`,
// `\u{1F600}`, `\d`, `\p{L}`, `[a-z]`), as JavaScript reads them: Annex B's leniency without the
// `u` flag (`\q` is `q`, `\x1` is `x1`, `\8` is `8`, `\101` is octal), and its errors with it.

import { CharSet } from "velt/text/regex/char_set";
import { escapeSet, finish, maxChar } from "velt/text/regex/classes";
import { ASSERT, AT_NOT_WORD, AT_WORD, CHAR, EMPTY, Node, setNode } from "velt/text/regex/node";
import { groupName, hex, unicodeEscape } from "velt/text/regex/parse_name";
import { Parser } from "velt/text/regex/parser";
import { propertySet } from "velt/text/regex/unicode_props";

/** The properties of strings, which the `v` flag has and the engine does not match: their
 * names, `,` around each. */
const STRING_PROPERTIES: string =
  ",Basic_Emoji,Emoji_Keycap_Sequence,RGI_Emoji_Modifier_Sequence,RGI_Emoji_Flag_Sequence,RGI_Emoji_Tag_Sequence,RGI_Emoji_ZWJ_Sequence,RGI_Emoji,";

/** What `classAtom` and `charEscape` return for a set, left in the parser's `set`. */
export const A_SET: i64 = -1;

function isDigit(c: i64): bool {
  return c >= 0x30 && c <= 0x39;
}

function isLetter(c: i64): bool {
  const l = c | 0x20;
  return l >= 0x61 && l <= 0x7a;
}

/** Annex B's octal escape, whose first digit is next: at most three digits, at most `\377`. */
function octal(p: Parser): i64 {
  let v: i64 = 0;
  for (let k = 0; k < 3; k++) {
    const c = p.peek();
    if (c < 0x30 || c > 0x37 || v * 8 + c - 0x30 > 255) {
      break;
    }
    v = v * 8 + c - 0x30;
    p.at++;
  }
  return v;
}

/** `\p{…}` or `\P{…}` after its letter `e`, into the parser's `set`; `inClass` for one inside
 * `[…]`. */
function property(p: Parser, e: i64, inClass: bool): void {
  let name = "";
  let value = "";
  let k: usize = 1;
  let inValue = false;
  let closed = false;
  while (p.peek() == 0x7b && p.peekAt(k) >= 0 && !closed) {
    const c = p.peekAt(k);
    k++;
    if (c == 0x7d) {
      closed = true;
    } else if (c == 0x3d && !inValue) {
      inValue = true;
    } else if (inValue) {
      value += String.fromCodePoint(c as f64);
    } else {
      name += String.fromCodePoint(c as f64);
    }
  }
  if (closed && p.sets && e == 0x70 && !inValue && STRING_PROPERTIES.includes("," + name + ",")) {
    // A set of strings: not matched (refused at the end), and an error in a negated class
    // (parse_class_set.velt).
    p.strings = true;
    p.at += k;
    refuse(p, "Properties of strings are not supported");
    p.set = new CharSet();
    return;
  }
  const set = closed ? propertySet(name, value, inValue) : null;
  if (set == null) {
    p.fail(inClass ? "Invalid property name in character class" : "Invalid property name");
  }
  p.at += k;
  // With the `u` flag `\P{…}` is the complement first, and what matches a member of that
  // whatever the case second (`/\P{Lu}/iu` matches `A`, as `a` is no upper case letter). With
  // the `v` flag the set is closed over case first and the complement taken then
  // (`/\P{Lu}/iv` matches neither `A` nor `a`).
  set.normalize();
  if (p.sets) {
    finish(p, set, e == 0x50);
  } else {
    if (e == 0x50) {
      set.negate(maxChar(p));
    }
    finish(p, set, false);
  }
  p.set = set;
}

/** The character of the escape whose letter `c` was just read, or `A_SET` for a class escape;
 * `inClass` for one inside `[…]`. Not `\b`, `\B`, `\k` or a decimal escape outside a class. */
function charEscape(p: Parser, c: i64, inClass: bool): i64 {
  const lower = c | 0x20;
  if (isLetter(c) && (lower == 0x64 || lower == 0x73 || lower == 0x77)) {
    p.set = escapeSet(p, c);
    return A_SET;
  }
  if (lower == 0x70 && p.unicode) {
    property(p, c, inClass);
    return A_SET;
  }
  if (c == 0x66) {
    return 0x0c;
  }
  if (c == 0x6e) {
    return 0x0a;
  }
  if (c == 0x72) {
    return 0x0d;
  }
  if (c == 0x74) {
    return 0x09;
  }
  if (c == 0x76) {
    return 0x0b;
  }
  if (c == 0x63) {
    return control(p, inClass);
  }
  if (c == 0x78 || c == 0x75) {
    const v = c == 0x78 ? hex(p, 2) : unicodeEscape(p, p.unicode);
    if (v < 0 && p.unicode) {
      p.fail(c == 0x78 ? "Invalid escape" : "Invalid Unicode escape");
    }
    return v < 0 ? c : v;
  }
  if (isDigit(c)) {
    return digitEscape(p, c, inClass);
  }
  if (p.unicode && !isSyntax(c) && !(inClass && (c == 0x2d || (p.sets && isSetPunctuator(c))))) {
    p.fail("Invalid escape");
  }
  return c;
}

/** May `\` + `c` stand for `c` in a class with the `v` flag (one of ``& - ! # % , : ; < = > @ ` ~``)? */
function isSetPunctuator(c: i64): bool {
  return c == 0x26 ||
    c == 0x2d ||
    c == 0x21 ||
    c == 0x23 ||
    c == 0x25 ||
    c == 0x2c ||
    (c >= 0x3a && c <= 0x3e) ||
    c == 0x40 ||
    c == 0x60 ||
    c == 0x7e;
}

/** May `\` + `c` stand for `c` with the `u` flag (a syntax character, or `/`)? */
function isSyntax(c: i64): bool {
  return c == 0x24 ||
    (c >= 0x28 && c <= 0x2b) ||
    c == 0x2e ||
    c == 0x2f ||
    c == 0x3f ||
    (c >= 0x5b && c <= 0x5e) ||
    (c >= 0x7b && c <= 0x7d);
}

/** `\c` after its `c`: a control letter (in a class also a digit or `_`, without the `u`
 * flag); else, without the flag, the backslash itself, the `c` being read again. */
function control(p: Parser, inClass: bool): i64 {
  const l = p.peek();
  if (isLetter(l) || (inClass && !p.unicode && (isDigit(l) || l == 0x5f))) {
    p.at++;
    return l % 32;
  }
  if (p.unicode) {
    p.fail("Invalid Unicode escape");
  }
  p.at--;
  return 0x5c;
}

/** An escaped digit `c` that is no back reference: `\0`, or without the `u` flag an octal
 * escape or the digit `8` or `9` itself. */
function digitEscape(p: Parser, c: i64, inClass: bool): i64 {
  if (c == 0x30 && !isDigit(p.peek())) {
    return 0;
  }
  if (p.unicode) {
    p.fail(
      inClass ? "Invalid class escape" : c == 0x30 ? "Invalid decimal escape" : "Invalid escape",
    );
  }
  if (c >= 0x38) {
    return c;
  }
  p.at--;
  return octal(p);
}

/** A node matching the character `c`: the set of its case variants with the `i` flag. */
export function charNode(p: Parser, c: i64): Node {
  if (p.ignoreCase) {
    const s = new CharSet();
    s.add(c as u32, c as u32);
    finish(p, s, false);
    if (s.count(2) > 1) {
      return setNode(s);
    }
  }
  return new Node(CHAR, c as u32);
}

/** The atom of an escape outside a class, after its backslash. */
export function atomEscape(p: Parser): Node {
  const c = p.peek();
  if (c < 0) {
    p.fail("\\ at end of pattern");
  }
  p.at++;
  if (c == 0x62 || c == 0x42) {
    const folded: u32 = p.unicode && p.ignoreCase ? 2 : 0;
    return new Node(ASSERT, (c == 0x62 ? AT_WORD : AT_NOT_WORD) + folded);
  }
  if (c == 0x6b && (p.unicode || p.hasNames)) {
    // A named back reference: its name is read as a group's is, and looked up at the end.
    if (!p.eat(0x3c)) {
      p.fail("Invalid named reference");
    }
    const name = groupName(p);
    p.references.push(name);
    return refuse(p, "Back references are not supported");
  }
  if (c >= 0x31 && c <= 0x39) {
    let k: usize = 0;
    let n: i64 = c - 0x30;
    while (isDigit(p.peekAt(k)) && n <= 0xffff) {
      n = n * 10 + p.peekAt(k) - 0x30;
      k++;
    }
    if (n <= (p.totalGroups as i64)) {
      p.at += k;
      return refuse(p, "Back references are not supported");
    }
  }
  const v = charEscape(p, c, false);
  return v == A_SET ? setNode(p.set) : charNode(p, v);
}

/** Notes that the pattern has something the engine does not match (`why`), and stands for it
 * with a node that matches nothing: the pattern is read on, and refused at its end. */
export function refuse(p: Parser, why: string): Node {
  if (p.refused == "") {
    p.refused = why;
  }
  return new Node(EMPTY);
}

/** With the `v` flag, a class member that starts with `c`, just read: an error when it is one
 * of the characters that flag reserves in a class, as in JavaScript. */
function setSyntax(p: Parser, c: i64): void {
  const next = p.peek();
  // An operator where an operand should be (the class's own `&&` and `--` are read by
  // parse_class_set.velt).
  if (c == 0x26 && next == c) {
    p.fail("Invalid set operation in character class");
  }
  // `!! ## $$ %% ** ++ ,, .. :: ;; << == >> ?? @@ ^^ `` ~~` are reserved.
  const doubled =
    (
      c >= 0x21 &&
      c <= 0x2e &&
      c != 0x22 &&
      c != 0x26 &&
      c != 0x27 &&
      c != 0x28 &&
      c != 0x29 &&
      c != 0x2d
    ) ||
    (c >= 0x3a && c <= 0x40) ||
    c == 0x5e ||
    c == 0x60 ||
    c == 0x7e;
  if (doubled && next == c) {
    p.fail("Invalid set operation in character class");
  }
  if (c == 0x28 || c == 0x29 || c == 0x7b || c == 0x7d || c == 0x2f || c == 0x7c || c == 0x2d) {
    p.fail("Invalid character in character class");
  }
}

/** One member of a class, after its `[`: a character, or `A_SET` for a class escape. */
export function classAtom(p: Parser): i64 {
  const c = p.peek();
  p.at++;
  if (p.sets) {
    setSyntax(p, c);
  }
  if (c != 0x5c) {
    return c;
  }
  const e = p.peek();
  if (e < 0) {
    p.fail("\\ at end of pattern");
  }
  p.at++;
  if (e == 0x62) {
    return 0x08;
  }
  if (isDigit(e) && !p.unicode && e < 0x38) {
    p.at--;
    return octal(p);
  }
  return charEscape(p, e, true);
}

/** The class after its `[`, up to and including its `]`, without the `v` flag (with it:
 * parse_class_set.velt). */
export function parseClass(p: Parser): Node {
  const negated = p.eat(0x5e);
  const set = new CharSet();
  while (!p.eat(0x5d)) {
    if (p.done()) {
      p.fail("Unterminated character class");
    }
    const a = classAtom(p);
    if (a == A_SET) {
      set.addSet(p.set);
    }
    if (p.peek() != 0x2d || p.peekAt(1) == 0x5d || p.peekAt(1) < 0) {
      if (a != A_SET) {
        set.add(a as u32, a as u32);
      }
      continue;
    }
    p.at++;
    const b = classAtom(p);
    if (a != A_SET && b != A_SET) {
      if (a > b) {
        p.fail("Range out of order in character class");
      }
      set.add(a as u32, b as u32);
      continue;
    }
    // Annex B: a class escape at either end makes the `-` a member (`[\d-z]`).
    if (p.unicode) {
      p.fail("Invalid character class");
    }
    set.add(0x2d, 0x2d);
    if (a != A_SET) {
      set.add(a as u32, a as u32);
    }
    if (b == A_SET) {
      set.addSet(p.set);
    } else {
      set.add(b as u32, b as u32);
    }
  }
  finish(p, set, negated);
  return setNode(set);
}
