// velt/text (internal): the characters of a subject as a regular expression matches them, read
// from its WTF-8 where it is.
//
// With the `u` flag a character is a code point. Without it a character is a UTF-16 code unit,
// and a pair, which a string stores as one 4-byte sequence, is two: the high surrogate at the
// sequence's first byte, one byte long, and the low surrogate at its second byte, three bytes
// long. So the position between the halves of a pair is the offset of the sequence's second
// byte, and a pattern like `/./` or `/[\uD800-\uDBFF]/` matches half a pair, as in JavaScript,
// with no copy of the subject. A position is otherwise always the offset of a sequence's start.
//
// With the `u` flag the position between the halves of a pair exists too, as in V8, whose
// search tries every code unit: no character is there, but an assertion or an empty pattern can
// match (`/\B/u` matches inside `"😀"`).

import { addressLoad, inline } from "velt/lang/intrinsics";
import {
  AT_END,
  AT_LINE_END,
  AT_LINE_START,
  AT_START,
  AT_WORD,
  AT_WORD_FOLDED,
} from "velt/text/regex/node";

/** What `charAt` gives where a pattern finds no character. */
export const NO_CHAR: u32 = 0xffffff;

/** Byte `i` of the text at `base`: the data address of a string that is alive, and an offset
 * inside its bytes, as every caller in the matchers passes (a position before the subject's
 * length, or a byte of a character that starts before it). */
@inline("always")
export function byteAt(base: usize, i: usize): u32 {
  // SAFETY: by this function's contract, `base + i` is a byte of a live string.
  return unsafe { addressLoad<u8>(base + i) } as u32;
}

/** The class of the byte at address `at`, from the table of classes at `kinds`: `at` is a byte
 * of a live subject before its end, and `kinds` a program's `asciiClass`. */
@inline("always")
export function kindAt(kinds: usize, at: usize): usize {
  // SAFETY: `at` is a byte of a live subject (the caller's contract), and `asciiClass` has 256
  // entries (classify.velt), one for every value of that byte.
  return unsafe { addressLoad<u8>(kinds + (unsafe { addressLoad<u8>(at) } as usize)) } as usize;
}

/** The character at byte `i` of the text at `base` with its length in bytes: `c | length <<
 * 24`. With `units` the characters are code units (module comment). */
export function charAt(base: usize, i: usize, units: bool): u32 {
  const b = byteAt(base, i);
  if (b < 0x80) {
    return b | (1 << 24);
  }
  if (b < 0xc0) {
    // The low half of a pair: the last ten bits of its code point. A pattern that matches code
    // points finds no character there.
    if (!units) {
      return NO_CHAR | (3 << 24);
    }
    return 0xdc00 | ((byteAt(base, i + 1) & 0x0f) << 6) | (byteAt(base, i + 2) & 0x3f) | (3 << 24);
  }
  if (b < 0xe0) {
    return ((b & 0x1f) << 6) | (byteAt(base, i + 1) & 0x3f) | (2 << 24);
  }
  if (b < 0xf0) {
    return ((b & 0x0f) << 12) |
      ((byteAt(base, i + 1) & 0x3f) << 6) |
      (byteAt(base, i + 2) & 0x3f) |
      (3 << 24);
  }
  const top =
    ((b & 0x07) << 18) | ((byteAt(base, i + 1) & 0x3f) << 12) | ((byteAt(base, i + 2) & 0x3f) << 6);
  if (units) {
    return (0xd800 + ((top - 0x10000) >> 10)) | (1 << 24);
  }
  return top | (byteAt(base, i + 3) & 0x3f) | (4 << 24);
}

/** The position before the position at byte `i` (not 0) of the text at `base`. */
export function before(base: usize, i: usize, units: bool): usize {
  let p = i - 1;
  while ((byteAt(base, p) & 0xc0) == 0x80) {
    p--;
  }
  // Past a pair whose halves are characters of their own, the one before is its low half.
  return units && i - p == 4 ? p + 1 : p;
}

/** Is the byte `b` an ASCII word character (`\w`)? */
@inline("always")
export function isWordByte(b: u32): bool {
  const l = b | 0x20;
  return (l >= 0x61 && l <= 0x7a) || (b >= 0x30 && b <= 0x39) || b == 0x5f;
}

/** Is a line terminator (`\n`, `\r`, U+2028, U+2029) right before byte `i`, which is not 0? */
function afterLineEnd(base: usize, i: usize): bool {
  const b = byteAt(base, i - 1);
  if (b == 0x0a || b == 0x0d) {
    return true;
  }
  return (b == 0xa8 || b == 0xa9) &&
    i >= 3 &&
    byteAt(base, i - 2) == 0x80 &&
    byteAt(base, i - 3) == 0xe2;
}

/** Is a line terminator at byte `i`, which is before `len`? */
function beforeLineEnd(base: usize, i: usize, len: usize): bool {
  const b = byteAt(base, i);
  if (b == 0x0a || b == 0x0d) {
    return true;
  }
  return b == 0xe2 &&
    i + 2 < len &&
    byteAt(base, i + 1) == 0x80 &&
    (byteAt(base, i + 2) | 1) == 0xa9;
}

/** Does the assertion `kind` (an `AT_…`) hold at byte `i` of the `len` bytes at `base`? */
export function holds(kind: u32, base: usize, i: usize, len: usize): bool {
  if (kind == AT_START) {
    return i == 0;
  }
  if (kind == AT_END) {
    return i == len;
  }
  if (kind == AT_LINE_START) {
    return i == 0 || afterLineEnd(base, i);
  }
  if (kind == AT_LINE_END) {
    return i == len || beforeLineEnd(base, i, len);
  }
  if (kind >= AT_WORD_FOLDED) {
    const before = wordBefore(base, i);
    const after = i < len && (isWordByte(byteAt(base, i)) || foldedWordAt(base, i, len));
    return (before != after) == (kind == AT_WORD_FOLDED);
  }
  const before = i > 0 && isWordByte(byteAt(base, i - 1));
  const after = i < len && isWordByte(byteAt(base, i));
  return (before != after) == (kind == AT_WORD);
}

/** Is `ſ` (U+017F) or the Kelvin sign (U+212A) at byte `i`, before `len`? */
function foldedWordAt(base: usize, i: usize, len: usize): bool {
  const b = byteAt(base, i);
  if (b == 0xc5) {
    return i + 1 < len && byteAt(base, i + 1) == 0xbf;
  }
  return b == 0xe2 && i + 2 < len && byteAt(base, i + 1) == 0x84 && byteAt(base, i + 2) == 0xaa;
}

/** Is a word character, `ſ` or the Kelvin sign right before byte `i`? */
function wordBefore(base: usize, i: usize): bool {
  if (i == 0) {
    return false;
  }
  const b = byteAt(base, i - 1);
  if (isWordByte(b)) {
    return true;
  }
  if (b == 0xbf) {
    return i >= 2 && byteAt(base, i - 2) == 0xc5;
  }
  return b == 0xaa && i >= 3 && byteAt(base, i - 2) == 0x84 && byteAt(base, i - 3) == 0xe2;
}
