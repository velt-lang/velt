// velt/text (internal): JavaScript's `replace` and `split` with a regular expression, over the
// matches of a program (find.velt).

import { arrayTruncate, strByteAt, strByteLen } from "velt/lang/intrinsics";
import { after, find } from "velt/text/regex/find";
import { textOf } from "velt/text/regex/offsets";
import { Program } from "velt/text/regex/program";
import { velt_rt_str_byte_slice } from "velt/text/regex/rt";
import { Search } from "velt/text/regex/search";

/** Where the search after the match `start..end` of a subject of `len` bytes goes on: at its
 * end, or one character further after an empty match; past `len` when the subject is done. */
export function following(prog: Program, s: string, len: usize, start: usize, end: usize): usize {
  if (end > start) {
    return end;
  }
  return end >= len ? len + 1 : after(s, end, prog.units);
}

/** The text of capture group `g` of the match in `slots`, `""` when it did not take part. */
function group(s: string, slots: i64[], g: usize): string {
  return slots[2 * g] < 0 ? "" : textOf(s, slots[2 * g] as usize, slots[2 * g + 1] as usize);
}

/** `$n` or `$nn` at the digit at byte `at` of `replacement`: appends the group's text to `out`
 * and returns how many digits name it, two when that group exists; 0 when no group does (the
 * `$` is then text). */
function numbered(s: string, slots: i64[], replacement: string, at: usize, out: string[]): usize {
  const groups = slots.length / 2 - 1;
  const d1 = (strByteAt(replacement, at as u64) - 0x30) as usize;
  let two: usize = 0;
  if (at + 1 < strByteLen(replacement)) {
    const c = strByteAt(replacement, (at + 1) as u64);
    two = c >= 0x30 && c <= 0x39 ? d1 * 10 + ((c - 0x30) as usize) : 0;
  }
  if (two >= 1 && two <= groups) {
    out.push(group(s, slots, two));
    return 2;
  }
  if (d1 >= 1 && d1 <= groups) {
    out.push(group(s, slots, d1));
    return 1;
  }
  return 0;
}

/** `replacement` for the match of `s` in `slots`, with `$$ $& $\` $' $n $nn $<name>` expanded
 * as JavaScript's `GetSubstitution` does; `names` are the names of groups 1.. (`""`: none). */
export function substitution(s: string, slots: i64[], names: string[], replacement: string): string {
  const n = strByteLen(replacement);
  const parts: string[] = [];
  let from: usize = 0;
  let i: usize = 0;
  while (i + 1 < n) {
    if (strByteAt(replacement, i as u64) != 0x24) {
      i++;
      continue;
    }
    const c = strByteAt(replacement, (i + 1) as u64);
    let used: usize = 0;
    const before = parts.length;
    parts.push(velt_rt_str_byte_slice(replacement, from as u64, i as u64));
    if (c == 0x24) {
      parts.push("$");
      used = 2;
    } else if (c == 0x26) {
      parts.push(textOf(s, slots[0] as usize, slots[1] as usize));
      used = 2;
    } else if (c == 0x60) {
      parts.push(textOf(s, 0, slots[0] as usize));
      used = 2;
    } else if (c == 0x27) {
      parts.push(textOf(s, slots[1] as usize, strByteLen(s)));
      used = 2;
    } else if (c >= 0x30 && c <= 0x39) {
      const digits = numbered(s, slots, replacement, i + 1, parts);
      used = digits == 0 ? 0 : digits + 1;
    } else if (c == 0x3c && names.some((name) => name != "")) {
      const close = replacement.indexOf(">", (i + 2) as i64);
      if (close >= 0) {
        const g = names.indexOf(replacement.slice((i + 2) as i64, close)) + 1;
        parts.push(g > 0 ? group(s, slots, g as usize) : "");
        used = close as usize + 1 - i;
      }
    }
    if (used == 0) {
      arrayTruncate(parts, before);
      i++;
    } else {
      i += used;
      from = i;
    }
  }
  parts.push(velt_rt_str_byte_slice(replacement, from as u64, n as u64));
  return parts.join("");
}

/** `s` with the first match of `prog` (every match when `all`) replaced by `replacement`,
 * expanded as `substitution` does. */
export function replaceMatches(prog: Program, names: string[], s: string, replacement: string, all: bool): string {
  const plain = !replacement.includes("$");
  const m = new Search(prog, plain ? 2 : 2 * (prog.groups as usize) + 2);
  const len = strByteLen(s);
  let out = "";
  let last: usize = 0;
  let pos: usize = 0;
  let found = false;
  while (pos <= len && find(prog, m, s, pos, false)) {
    const start = m.slots[0] as usize;
    const end = m.slots[1] as usize;
    found = true;
    out += textOf(s, last, start);
    out += plain ? replacement : substitution(s, m.slots, names, replacement);
    last = end;
    if (!all) {
      break;
    }
    pos = following(prog, s, len, start, end);
  }
  if (!found) {
    return s;
  }
  out += textOf(s, last, len);
  return out;
}

/** JavaScript's `s.split(re, limit)`: the pieces between the matches of `prog`, each followed
 * by the match's groups (`""` for one that did not take part); at most `limit` strings (0: any
 * number). An empty match where the last piece ended, or at the end, splits nothing. */
export function splitMatches(prog: Program, s: string, limit: usize): string[] {
  const m = new Search(prog, 2 * (prog.groups as usize) + 2);
  const len = strByteLen(s);
  const parts: string[] = [];
  if (len == 0) {
    if (!find(prog, m, s, 0, false)) {
      parts.push("");
    }
    return parts;
  }
  let last: usize = 0;
  let pos: usize = 0;
  while (pos < len && find(prog, m, s, pos, false)) {
    const start = m.slots[0] as usize;
    const end = m.slots[1] as usize;
    if (start >= len) {
      break;
    }
    if (end == last) {
      pos = after(s, start, prog.units);
      continue;
    }
    parts.push(textOf(s, last, start));
    for (let g: usize = 1; g <= (prog.groups as usize); g++) {
      parts.push(group(s, m.slots, g));
    }
    if (limit != 0 && parts.length >= limit) {
      arrayTruncate(parts, limit);
      return parts;
    }
    last = end;
    pos = end;
  }
  parts.push(textOf(s, last, len));
  return parts;
}

/** `s` with every character that means something in a pattern escaped with a backslash. */
export function escapePattern(s: string): string {
  let out = "";
  let from: usize = 0;
  const n = strByteLen(s);
  for (let i: usize = 0; i < n; i++) {
    const c = strByteAt(s, i as u64);
    const meta = (c >= 0x23 && c <= 0x2e && c != 0x25 && c != 0x27 && c != 0x2c) || c == 0x3f ||
      (c >= 0x5b && c <= 0x5e) || (c >= 0x7b && c <= 0x7e);
    if (meta) {
      out += velt_rt_str_byte_slice(s, from as u64, i as u64);
      out += "\\";
      from = i;
    }
  }
  if (from == 0 && out == "") {
    return s;
  }
  out += velt_rt_str_byte_slice(s, from as u64, n as u64);
  return out;
}
