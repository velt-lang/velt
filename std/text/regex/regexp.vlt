// velt/text (internal): JavaScript-flavoured regular expressions over the runtime's Rust `regex`
// engine (rt_abi_async.md §14). Matching is linear-time (no catastrophic backtracking); in exchange
// lookaround and backreferences are not supported (compiling them throws `RegExpError`).
//
// Offsets are UTF-16 code units, like every Velt string position (`slice`, `indexOf`).
// `\d \w \b` are ASCII-only as in JS; `i m s` flags work as in JS; `g` makes `replace` replace
// every match and `y` (sticky) makes `test`/`exec` match only at the start position. Called
// without a start (`exec(s)`), a `g` or `y` regex starts at `lastIndex` and updates it, as in JS;
// `exec(s, from)` takes the start explicitly and leaves `lastIndex` alone.
//
// The string methods that take a regex (`s.replace(re, …)`, `match`, `matchAll`, `search`,
// `split`, `replaceAll`) are the functions of velt/text/regex/string_methods, loaded with this
// file: the compiler calls them when the first argument is a `RegExp` (velt_sema's
// `regex_args`), and they call this class's methods keyed by velt/text/regex/keys.
//
// A `RegExp` owns a runtime handle (released by `[Symbol.dispose]()`); the compiled program is
// immutable and can be used from any task.

import { Pattern } from "velt/text/regex/pattern";
import { RegExpError } from "velt/text/regex/errors";
import { MATCH, MATCH_ALL, REPLACE_CALLING, SEARCH, SPLIT } from "velt/text/regex/keys";
import { RegExpMatch } from "velt/text/regex/regexp_match";
import {
  velt_rt_regex_escape,
  velt_rt_regex_exec,
  velt_rt_regex_exec_all,
  velt_rt_regex_free,
  velt_rt_regex_group_count,
  velt_rt_regex_group_names,
  velt_rt_regex_last_index,
  velt_rt_regex_new,
  velt_rt_regex_replace,
  velt_rt_regex_set_last_index,
  velt_rt_regex_split,
  velt_rt_regex_test,
} from "velt/text/regex/rt";
// The string methods that take a regex (compiler hooks).
import "velt/text/regex/string_methods";
import { arrayWithCapacity } from "velt/lang/intrinsics";

/** A compiled regular expression: `new RegExp("(\\d+)-(\\d+)", "g")`. */
export class RegExp implements Pattern {
  /** The pattern text as given. */
  readonly source: string;
  /** The flags as given. */
  readonly flags: string;
  /** `g`: `replace` replaces every match. */
  readonly global: bool;
  /** `y`: `test`/`exec` only match starting exactly at the start position. */
  readonly sticky: bool;
  #handle: u64;
  #names: string[];

  /** Throws `RegExpError` for an invalid pattern or flags. */
  constructor(pattern: string, flags: string = "") {
    const r = velt_rt_regex_new(pattern, flags);
    if (r.code != 0) {
      throw new RegExpError(r.message);
    }
    this.#handle = r.value;
    this.source = pattern.clone();
    this.flags = flags.clone();
    this.global = flags.includes("g");
    this.sticky = flags.includes("y");
    this.#names = velt_rt_regex_group_names(this.#handle);
  }

  /**
   * Whether `s` matches (anywhere at or after position `from`; exactly at `from` when sticky).
   * Without `from`, a `g` or `y` regex starts at `lastIndex` and updates it, like `exec`.
   */
  test(s: string, from?: usize): bool {
    if (from == null && (this.global || this.sticky)) {
      return this.exec(s) != null;
    }
    const start = from ?? 0;
    if (this.sticky) {
      return this.execAt(s, start) != null;
    }
    return velt_rt_regex_test(this.#handle, s, start as u64);
  }

  /**
   * The first match at or after position `from` (exactly at `from` when sticky), or null.
   * Without `from`, a `g` or `y` regex starts at `lastIndex` and sets it past the match, or to 0
   * when there is none (JS `exec`); other regexes start at 0.
   */
  exec(s: string, from?: usize): RegExpMatch | null {
    if (from != null || !(this.global || this.sticky)) {
      return this.execAt(s, from ?? 0);
    }
    const start = this.lastIndex as usize;
    const m = start > s.length ? null : this.execAt(s, start);
    velt_rt_regex_set_last_index(this.#handle, m == null ? 0 : m.end);
    return m;
  }

  /** Every non-overlapping match, in order (JS `s.matchAll(re)`, whatever the flags). */
  matchAll(s: string): RegExpMatch[] {
    const offsets = velt_rt_regex_exec_all(this.#handle, s);
    const stride = 2 * (this.#names.length + 1);
    const n = offsets.length / stride;
    const out: RegExpMatch[] = arrayWithCapacity(n);
    for (let i: usize = 0; i < n; i++) {
      out.push(this.matchAt(s, offsets, i * stride));
    }
    return out;
  }

  /** The text of every match (JS `s.match(re)` with the `g` flag); empty if none. */
  matches(s: string): string[] {
    const offsets = velt_rt_regex_exec_all(this.#handle, s);
    const stride = 2 * (this.#names.length + 1);
    const out: string[] = arrayWithCapacity(offsets.length / stride);
    for (let i: usize = 0; i < offsets.length; i += stride) {
      out.push(s.slice(offsets[i], offsets[i + 1]));
    }
    return out;
  }

  /**
   * JS `s.replace(re, replacement)`: every match with the `g` flag, else the first.
   * `replacement` expands `$&`, `$1`…`$99`, `$<name>`, `` $` ``, `$'` and `$$`. A sticky regex
   * matches only at `lastIndex` (with `g`: from 0, each match where the previous one ended), and
   * `lastIndex` changes as in JS.
   */
  replace(s: string, replacement: string): string {
    if (this.global) {
      velt_rt_regex_set_last_index(this.#handle, 0);
    }
    if (!this.sticky) {
      return velt_rt_regex_replace(this.#handle, s, replacement, this.global);
    }
    let out = "";
    let last: number = 0;
    for (const m of this.replaced(s)) {
      out += s.slice(last as i64, m.index as i64);
      out += m.substitute(s, replacement);
      last = m.end;
    }
    out += s.slice(last as i64);
    return out;
  }

  /** Replaces every match, whatever the flags (JS `replaceAll`). */
  replaceAll(s: string, replacement: string): string {
    return velt_rt_regex_replace(this.#handle, s, replacement, true);
  }

  /**
   * Replaces matches (every one with `g`, else the first) with `f(match)`; the matches are the
   * ones `replace` replaces.
   */
  replaceWith<E>(s: string, f: (m: RegExpMatch) => string throws E): string throws E {
    let out = "";
    let last: number = 0;
    for (const m of this.replaced(s)) {
      out += s.slice(last as i64, m.index as i64);
      out += f(m);
      last = m.end;
    }
    out += s.slice(last as i64);
    return out;
  }

  /** `replaceWith` for `s.replace(re, (match, ...groups) => …)`: `f` gets the subject too. */
  [REPLACE_CALLING]<E>(
    s: string,
    f: (m: RegExpMatch, s: string) => string throws E,
  ): string throws E {
    let out = "";
    let last: number = 0;
    for (const m of this.replaced(s)) {
      out += s.slice(last as i64, m.index as i64);
      out += f(m, s);
      last = m.end;
    }
    out += s.slice(last as i64);
    return out;
  }

  /** JS `s.match(re)`: every match's text with `g` (null if none), else `exec`'s groups. */
  [MATCH](s: string): string[] | null {
    if (!this.global) {
      const m = this.exec(s);
      if (m == null) {
        return null;
      }
      const out: string[] = arrayWithCapacity(m.captures.length + 1);
      out.push(m.value.clone());
      for (const c of m.captures) {
        out.push(c ?? "");
      }
      return out;
    }
    velt_rt_regex_set_last_index(this.#handle, 0);
    const found = this.sticky ? this.stickyTexts(s) : this.matches(s);
    return found.length == 0 ? null : found;
  }

  /** JS `s.matchAll(re)` (a `g` regex): every match from `lastIndex` on, which stays as is. */
  [MATCH_ALL](s: string): RegExpMatch[] {
    if (!this.global) {
      panic("TypeError: String.prototype.matchAll called with a non-global RegExp argument");
    }
    if (this.lastIndex == 0 && !this.sticky) {
      return this.matchAll(s);
    }
    const saved = this.lastIndex;
    const out: RegExpMatch[] = [];
    while (true) {
      const m = this.exec(s);
      if (m == null) {
        break;
      }
      if (m.end == m.index) {
        velt_rt_regex_set_last_index(this.#handle, (m.end + 1) as number);
      }
      out.push(m);
    }
    velt_rt_regex_set_last_index(this.#handle, saved);
    return out;
  }

  /** JS `s.search(re)`: where the first match from 0 starts, or -1; `lastIndex` stays. */
  [SEARCH](s: string): i64 {
    const m = this.execAt(s, 0);
    return m == null ? -1 : m.index as i64;
  }

  /** JS `s.split(re, limit)`: no limit when null, `[]` for 0. */
  [SPLIT](s: string, limit: number | null | undefined): string[] {
    if (limit == null) {
      return this.split(s);
    }
    const n = limit as i64;
    if (n == 0) {
      return [];
    }
    return this.split(s, n > 0 ? n as usize : 0);
  }

  /** JS `s.split(re, limit)`: captured groups are included in the result; `limit` 0 = none. */
  split(s: string, limit: usize = 0): string[] {
    return velt_rt_regex_split(this.#handle, s, limit as u64);
  }

  /**
   * Where `exec(s)` and `test(s)` of a `g` or `y` regex start, set past each match (0 after a
   * failed one); `s.replace`, `s.match` and `s.matchAll` read and set it as in JS. Kept by the
   * runtime, so the methods that update it don't need a mutable receiver.
   */
  get lastIndex(): number {
    return velt_rt_regex_last_index(this.#handle);
  }

  set lastIndex(value: number) {
    velt_rt_regex_set_last_index(this.#handle, value);
  }

  /** Number of capture groups (not counting the whole match). */
  get groupCount(): usize {
    return (velt_rt_regex_group_count(this.#handle) - 1) as usize;
  }

  /** `s` with every regex metacharacter escaped, for building patterns from text. */
  static escape(s: string): string {
    return velt_rt_regex_escape(s);
  }

  /**
   * An independent copy (compiles the pattern again). It cannot throw: the pattern compiled
   * once already. So a deep copy for another task (`spawn`, a channel) can call it.
   */
  clone(): RegExp {
    try {
      return new RegExp(this.source, this.flags);
    } catch (e) {
      panic(`ICE: RegExp.clone: the pattern no longer compiles: ${e.message}`);
    }
  }

  /** Drop hook: releases the compiled program. */
  [Symbol.dispose]() {
    if (this.#handle != 0) {
      velt_rt_regex_free(this.#handle);
      this.#handle = 0;
    }
  }

  private execAt(s: string, from: usize): RegExpMatch | null {
    let offsets: i64[] = [];
    if (!velt_rt_regex_exec(this.#handle, s, from as u64, offsets)) {
      return null;
    }
    if (this.sticky && offsets[0] != from as i64) {
      return null;
    }
    return this.matchAt(s, offsets, 0);
  }

  // The matches `replace` replaces, setting `lastIndex` as JS does.
  private replaced(s: string): RegExpMatch[] {
    if (this.global) {
      velt_rt_regex_set_last_index(this.#handle, 0);
      return this.sticky ? this.stickyMatches(s) : this.matchAll(s);
    }
    const out: RegExpMatch[] = [];
    const m = this.exec(s);
    if (m != null) {
      out.push(m);
    }
    return out;
  }

  // A sticky `g` regex's matches: from 0, each one where the previous one ended.
  private stickyMatches(s: string): RegExpMatch[] {
    const out: RegExpMatch[] = [];
    let at: usize = 0;
    while (at <= s.length) {
      const m = this.execAt(s, at);
      if (m == null) {
        break;
      }
      at = (m.end == m.index ? m.end + 1 : m.end) as usize;
      out.push(m);
    }
    return out;
  }

  private stickyTexts(s: string): string[] {
    const out: string[] = [];
    for (const m of this.stickyMatches(s)) {
      out.push(m.value.clone());
    }
    return out;
  }

  // Builds the match whose offsets start at `offsets[at]`.
  private matchAt(s: string, offsets: i64[], at: usize): RegExpMatch {
    const n = this.#names.length;
    const captures: (string | null)[] = arrayWithCapacity(n);
    for (let g: usize = 1; g <= n; g++) {
      const start = offsets[at + 2 * g];
      if (start < 0) {
        captures.push(null);
      } else {
        captures.push(s.slice(start, offsets[at + 2 * g + 1]));
      }
    }
    return new RegExpMatch(
      offsets[at] as number,
      offsets[at + 1] as number,
      s.slice(offsets[at], offsets[at + 1]),
      captures,
      this.#names.clone(),
    );
  }
}
