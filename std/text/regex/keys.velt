// velt/text (internal): the keys of `RegExp`'s methods that are no API of it: symbols programs
// never see. The string methods that take a regex call its well-known symbols' methods
// (`[Symbol.split]`, …) as JavaScript's do; only a replacer function, which the compiler adapts,
// comes here.

import { Symbol } from "velt/lang/symbol";

/** `s.replace(re, f)` with a replacer the compiler adapted. */
export const REPLACE_CALLING = Symbol("replaceCalling");
/** The regex's cursor, which holds its own `lastIndex` (exec_calls.velt). */
export const CURSOR = Symbol("cursor");
