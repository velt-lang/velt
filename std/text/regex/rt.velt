// velt/text (internal): the runtime functions the regular expressions call: a string's bytes
// as a string, and the string builder (std/text/string_builder.velt says how one is passed).

/** The text of bytes `start..end` of `s`, both at the start of a character or the end. */
export declare function velt_rt_str_byte_slice(s: string, start: u64, end: u64): string;

/** Makes `out` an empty builder with room for `cap` bytes. */
export declare function velt_rt_strbuf_new(cap: u64, out: string);

/** Appends `s` to the builder `buf`. */
export declare function velt_rt_strbuf_push_str(buf: string, s: string);

/** Appends the first `len` bytes of `bytes` to the builder `buf`: whole characters, `units`
 * UTF-16 code units of them (`len` when they are ASCII; all ones when not known). */
export declare function velt_rt_strbuf_push_u8s(buf: string, bytes: u8[], len: u64, units: u64);

/** Moves the text of the builder `buf` to `out`. */
export declare function velt_rt_strbuf_finish(buf: string, out: string);
