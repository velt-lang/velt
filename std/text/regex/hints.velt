// velt/text (internal): what the backtracker knows at a split before it takes it: the ASCII
// characters each way can start with. A way that cannot start with the next character leads
// nowhere, so the split need not remember it, and a pattern whose ways never start alike
// (`(a|b)*c`, `([^,]*,)*x`) is matched without going back.

import {
  OP_CHAR,
  OP_CLASS,
  OP_CLEAR,
  OP_JUMP,
  OP_MASK,
  OP_SAVE,
  OP_SPAN,
  OP_SPLIT,
  Program,
} from "velt/text/regex/program";

/** The most instructions a program has hints for, and the most one way is followed through. */
const MAX_INSTRUCTIONS: usize = 4096;
const MAX_FOLLOW: usize = 32;

/** Adds to `out` (two words of bits) the ASCII characters the program can read first from
 * instruction `from` on; false when that is not known: it may match, assert or mark before it
 * reads, or the way is long. */
function firsts(prog: Program, from: usize, out: u64[]): bool {
  const code = prog.code;
  const seen: usize[] = [];
  const todo: usize[] = [from];
  while (todo.length > 0) {
    const pc = todo.pop() ?? 0;
    if (seen.includes(pc)) {
      continue;
    }
    if (seen.length >= MAX_FOLLOW) {
      return false;
    }
    seen.push(pc);
    const op = code[3 * pc] & OP_MASK;
    const a = code[3 * pc + 1];
    if (op == OP_CHAR) {
      if (a < 128) {
        out[(a >> 6) as usize] |= (1 as u64) << ((a & 63) as u64);
      }
    } else if (op == OP_CLASS || op == OP_SPAN) {
      out[0] |= prog.ascii[2 * a];
      out[1] |= prog.ascii[2 * a + 1];
      if (op == OP_SPAN) {
        todo.push(pc + 1);
      }
    } else if (op == OP_SPLIT || op == OP_JUMP) {
      todo.push(a as usize);
      if (op == OP_SPLIT) {
        todo.push(code[3 * pc + 2] as usize);
      }
    } else if (op == OP_SAVE || op == OP_CLEAR) {
      todo.push(pc + 1);
    } else {
      return false;
    }
  }
  return true;
}

/** Gives every split of `prog` its hint, when the program is not too large. */
export function hint(prog: Program): void {
  const code = prog.code;
  if (code.length > 3 * MAX_INSTRUCTIONS) {
    return;
  }
  for (let i: usize = 0; i < code.length; i += 3) {
    prog.hintAt.push(0);
    if ((code[i] & OP_MASK) != OP_SPLIT) {
      continue;
    }
    const one: u64[] = [0, 0];
    const other: u64[] = [0, 0];
    if (firsts(prog, code[i + 1] as usize, one) && firsts(prog, code[i + 2] as usize, other)) {
      prog.hintAt[i / 3] = (prog.hints.length / 128 + 1) as u32;
      for (let c: u64 = 0; c < 128; c++) {
        const first = (one[(c >> 6) as usize] >> (c & 63)) & 1;
        const second = (other[(c >> 6) as usize] >> (c & 63)) & 1;
        prog.hints.push((first + 2 * second) as u8);
      }
    }
  }
}
