// velt/text (internal): `Parser`, the state of parsing one pattern: its characters, the
// position in them, the flags, and the groups seen. The grammar is parse_pattern.velt and
// parse_escape.velt.
//
// The pattern is read as JavaScript reads it: code points with the `u` (or `v`) flag, UTF-16
// code units without, so a supplementary character of a pattern without the flag is its two
// surrogates (`/😀+/` repeats the low one).

import { strByteAt, strByteLen } from "velt/lang/intrinsics";
import { CharSet } from "velt/text/regex/char_set";
import { RegExpError } from "velt/text/regex/errors";

/** The parse of one pattern in progress. */
export class Parser {
  /** The pattern's characters. */
  chars: u32[] = [];
  /** The index in `chars` of the next character. */
  at: usize = 0;
  readonly source: string;
  readonly flags: string;
  readonly unicode: bool;
  /** The `v` flag: classes have set syntax. */
  readonly sets: bool;
  readonly ignoreCase: bool;
  readonly multiline: bool;
  readonly dotAll: bool;
  /** Capture groups opened so far. */
  groups: u32 = 0;
  /** Capture groups in the whole pattern, and whether one has a name. */
  totalGroups: u32 = 0;
  hasNames: bool = false;
  /** The name of each group opened so far (`""`: none). */
  names: string[] = [];
  /** How deep in groups the parse is: a pattern nested too deep is refused, not recursed into. */
  depth: u32 = 0;
  /** The bounds of the `{n,m}` that `braces` (parse_pattern.velt) read last. */
  min: u32 = 0;
  max: u32 = 0;
  /** The set an escape or a class member stood for, when it was no single character. */
  set: CharSet = new CharSet();

  constructor(source: string, flags: string) {
    this.source = source;
    this.flags = flags;
    this.unicode = flags.includes("u") || flags.includes("v");
    this.sets = flags.includes("v");
    this.ignoreCase = flags.includes("i");
    this.multiline = flags.includes("m");
    this.dotAll = flags.includes("s");
    this.decode();
    this.countGroups();
  }

  /** Fills `chars` from the pattern's WTF-8. */
  private decode(): void {
    const s = this.source;
    const n = strByteLen(s);
    let i: usize = 0;
    while (i < n) {
      const b = strByteAt(s, i as u64) as u32;
      if (b < 0x80) {
        this.chars.push(b);
        i += 1;
      } else if (b < 0xe0) {
        this.chars.push(((b & 0x1f) << 6) | (((strByteAt(s, (i + 1) as u64) as u32) & 0x3f)));
        i += 2;
      } else if (b < 0xf0) {
        const c1 = ((strByteAt(s, (i + 1) as u64) as u32) & 0x3f);
        const c2 = ((strByteAt(s, (i + 2) as u64) as u32) & 0x3f);
        this.chars.push(((b & 0x0f) << 12) | (c1 << 6) | c2);
        i += 3;
      } else {
        const c1 = ((strByteAt(s, (i + 1) as u64) as u32) & 0x3f);
        const c2 = ((strByteAt(s, (i + 2) as u64) as u32) & 0x3f);
        const c3 = ((strByteAt(s, (i + 3) as u64) as u32) & 0x3f);
        const cp = ((b & 0x07) << 18) | (c1 << 12) | (c2 << 6) | c3;
        if (this.unicode) {
          this.chars.push(cp);
        } else {
          this.chars.push(0xd800 + ((cp - 0x10000) >> 10));
          this.chars.push(0xdc00 + ((cp - 0x10000) & 0x3ff));
        }
        i += 4;
      }
    }
  }

  /** Counts the pattern's capture groups, which decide what `\1` and `\k` mean before the
   * groups after them are parsed. */
  private countGroups(): void {
    const c = this.chars;
    let inClass = false;
    for (let i: usize = 0; i < c.length; i++) {
      const ch = c[i];
      if (ch == 0x5c) {
        i++;
      } else if (inClass) {
        inClass = ch != 0x5d;
      } else if (ch == 0x5b) {
        inClass = true;
      } else if (ch == 0x28) {
        if (i + 1 >= c.length || c[i + 1] != 0x3f) {
          this.totalGroups++;
        } else if (i + 3 < c.length && c[i + 2] == 0x3c && c[i + 3] != 0x3d && c[i + 3] != 0x21) {
          this.totalGroups++;
          this.hasNames = true;
        }
      }
    }
  }

  /** Is the whole pattern read? */
  done(): bool {
    return this.at >= this.chars.length;
  }

  /** The next character, or -1 at the end. */
  peek(): i64 {
    return this.at < this.chars.length ? this.chars[this.at] as i64 : -1;
  }

  /** The character `k` after the next one, or -1 past the end. */
  peekAt(k: usize): i64 {
    return this.at + k < this.chars.length ? this.chars[this.at + k] as i64 : -1;
  }

  /** Reads the next character if it is `c`. */
  eat(c: i64): bool {
    if (this.peek() == c) {
      this.at++;
      return true;
    }
    return false;
  }

  /** Stops with JavaScript's `SyntaxError` text for this pattern. */
  fail(why: string): never {
    throw new RegExpError(`Invalid regular expression: /${this.source}/${this.flags}: ${why}`);
  }
}
