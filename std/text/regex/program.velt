// velt/text (internal): `Program`, a compiled regular expression: the instructions the matchers
// run (backtrack.velt for a short subject, pike.velt for a long one), and what the search
// knows about every match before it runs them (prefilter.velt).
//
// An instruction is three words of `code`: its operation and two operands. Every instruction
// that consumes text consumes one character: a code point with the `u` flag, a UTF-16 code unit
// without (decode.velt). Control flows to the next instruction unless the operation says
// otherwise.

import { CharSet } from "velt/text/regex/char_set";

/** The pattern matched: the search is over. */
export const OP_MATCH: u32 = 0;
/** The character `a`. (`b`, of this and of `OP_SAVE`: when the next instruction is a jump,
 * where it goes, plus one.) */
export const OP_CHAR: u32 = 1;
/** A character of set `a`. */
export const OP_CLASS: u32 = 2;
/** Continue at `a`; if that does not lead to a match, at `b`. */
export const OP_SPLIT: u32 = 3;
/** Continue at `a`. */
export const OP_JUMP: u32 = 4;
/** Capture slot `a` is here. */
export const OP_SAVE: u32 = 5;
/** The assertion `a` (an `AT_…` of node.velt) holds here. */
export const OP_ASSERT: u32 = 6;
/** Capture slots `a..b` are unset: a group's captures do not outlive an iteration of the
 * quantifier around it. */
export const OP_CLEAR: u32 = 7;
/** Nothing matches here (`[]`). */
export const OP_FAIL: u32 = 8;
/** An optional iteration of a quantifier, whose mark is `a`, may start here. */
export const OP_ENTER: u32 = 9;
/** An iteration of the quantifier whose mark is `a` ends here: not where it started, as an
 * iteration past the least number must match something (JavaScript's RepeatMatcher). The
 * matchers ask whether an iteration could start here, not where this one did: when one could,
 * what follows the quantifier from here has been tried, or will be, without this iteration. */
export const OP_NONEMPTY: u32 = 10;

/** No way to skip: a match may start anywhere. */
export const SCAN_NONE: u32 = 0;
/** By `grams`. */
export const SCAN_GRAMS: u32 = 1;
/** By `first`. */
export const SCAN_FIRST: u32 = 2;

/** As many characters of set `a` as there are (a greedy `[…]*`); `b` is 1 when what follows
 * can start with none of them, so that giving one back never helps. */
export const OP_SPAN: u32 = 11;

/** Set in the operation of an instruction that a jump or a split leads to, and of every
 * `OP_SPAN`: the states the backtracker remembers. */
export const JOIN: u32 = 0x100;
/** The operation without its flags. */
export const OP_MASK: u32 = 0xff;

/** A compiled pattern. */
export class Program {
  /** The instructions: `op, a, b` each. */
  code: u32[] = [];
  /** The sets of the `OP_CLASS` instructions. */
  sets: CharSet[] = [];
  /** Per set, its members below 128 as two words of bits. */
  ascii: u64[] = [];
  /** The number of the join instructions before each instruction: what numbers a join's row
   * in the backtracker's table of visited states. */
  joins: u32 = 0;
  /** How many marks `OP_ENTER` and `OP_NONEMPTY` use. */
  marks: u32 = 0;
  /** No loop's body can match nothing and nothing is marked: backtracking without a memory
   * of the states it has been in finds the same match (backtrack.velt). */
  plain: bool = true;
  /** Capture groups, not counting the whole match. */
  groups: u32 = 0;
  /** Characters are UTF-16 code units (no `u` flag): a pair of the subject is two. */
  units: bool = false;
  /** Every match starts at the start of the subject (`^` without the `m` flag). */
  anchored: bool = false;
  /** The strings the pattern matches, in the order it prefers them, when `exact`: it matches
   * nothing else and captures nothing (`cat|dog`, `gr[ae]y`). Else the strings every match
   * starts with, or none. */
  literals: string[] = [];
  exact: bool = false;
  /** Of an `exact` program: per literal, the mask of the first eight bytes it has, then those
   * bytes as a word (the first byte lowest). */
  litWord: u64[] = [];
  /** Of an `exact` program: each literal's length in bytes. */
  litBytes: usize[] = [];
  /** How the search finds where a match may start (prefilter.velt): `SCAN_…`. */
  scan: u32 = 0;
  /** `SCAN_GRAMS`: every match has one of the byte tuples of `grams` (`gramSize` bytes each;
   * one, two or four tuples) at the offsets `gramAt` from its start, and is at least `minBytes`
   * long. */
  grams: u8[] = [];
  gramAt: usize[] = [];
  gramSize: usize = 0;
  minBytes: usize = 0;
  /** Per offset, what the scan ORs into the subject's byte before comparing: 0x20 where the
   * tuples' letters stand for both cases (literals.velt `foldGrams`), else 0. */
  gramFold: u8[] = [];
  /** Some offset of `gramFold` is 0x20. */
  gramFolded: bool = false;
  /** `SCAN_FIRST`: the first byte of every match, as four words of bits. */
  first: u64[] = [0, 0, 0, 0];

  /** The program has no assertion and few enough kinds of characters for the automaton
   * (dfa.velt), whose tables these are: where each class of characters that the program
   * cannot tell apart starts, in order, and the class of each ASCII character. */
  automaton: bool = false;
  classStarts: u32[] = [];
  asciiClass: u8[] = [];
  /** The program that reads a match backwards, when `automaton`. */
  backward: Program | null = null;
  /** An ASCII byte every match has, or -1 (required.velt). */
  required: i64 = -1;
  /** The program has `$` (without the `m` flag), the one assertion an automaton runs: a match
   * read off between the automaton's ends is read with the whole subject after it. */
  atEnd: bool = false;
  /** Every match ends where the subject does (required.velt `endsAtEnd`): a search finds its
   * start with the backward automaton alone, from the subject's end. */
  endsAtEnd: bool = false;
  /** Every match ends with `required` and has it nowhere else (required.velt `suffixByte`): a
   * search reads back from each of the subject's `required` bytes for where a match starts. */
  suffix: bool = false;
  /** `endsAtEnd` or `suffix`, and not anchored: a call may search by the backward
   * automaton's kept tables alone (quick.velt). */
  quick: bool = false;
  /** Every choice is made by the next character and no span gives back: a place is matched in
   * one pass (one_pass.velt). */
  onePass: bool = false;

  /** Per instruction, which hint a split has, plus one (0: none), and the hints: 128 bytes
   * each, per ASCII character whether the split's first way can start with it (1), its second
   * way (2), both (3) or neither (0) (hints.velt). Empty for a large program. */
  hintAt: u32[] = [];
  hints: u8[] = [];

  /** Instructions. */
  get length(): usize {
    return this.code.length / 3;
  }

  /** Is the character `c` in set `set`? */
  has(set: u32, c: u32): bool {
    return c < 0x80 ? this.hasAscii(set, c) : this.sets[set].contains(c);
  }

  /** Is the ASCII character `c` in set `set`? */
  hasAscii(set: u32, c: u32): bool {
    return ((this.ascii[2 * (set as usize) + ((c >> 6) as usize)] >> ((c & 63) as u64)) & 1) != 0;
  }
}
