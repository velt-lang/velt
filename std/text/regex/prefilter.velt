// velt/text (internal): where a match may start, found without running the program: by the
// bytes every match has at fixed offsets ("grams": sixteen positions a step with SIMD compares),
// or by its first byte. What to look for is the program's (literals.velt).

import { inline, strByteAt, strByteLen, strLoadU8x16 } from "velt/lang/intrinsics";
import { findByte } from "velt/lang/string/byte_scan";
import { Program, SCAN_FIRST, SCAN_GRAMS } from "velt/text/regex/program";
import { ALL, ANY, FIRST, hit, LITERAL_SHIFT, POSITION } from "velt/text/regex/scan_hit";
import { Search } from "velt/text/regex/search";
import { wideAvx2 } from "velt/text/regex/wide_avx2";
import { Avx2 } from "velt/arch/x86/avx2";

declare function velt_simd_u8x16_splat(x: u8): u8x16;
declare function velt_simd_u8x16_eq(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_or(a: u8x16, b: u8x16): u8x16;
declare function velt_simd_mask8x16_and(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_or(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_bitmask(m: mask8x16): u64;

/** The grams' scan, sixteen positions a step, for tuples of `size` bytes, `count` of them (1,
 * 2 or 4), with letters folded (`gramFold`) or not: all three are constants where this is
 * called, so each call is a loop of its own. The
 * first hit at or after `from`, or, when the steps found none, `-2 - i` for the byte `i` they
 * stopped at. */
@inline("always")
function wide(
  prog: Program,
  m: Search | null,
  s: string,
  from: usize,
  len: usize,
  size: usize,
  count: usize,
  folded: bool,
  mode: u32,
): i64 {
  const g = prog.grams;
  const o0 = prog.gramAt[0];
  const o1 = size > 1 ? prog.gramAt[1] : 0;
  const o2 = size > 2 ? prog.gramAt[2] : 0;
  const o3 = size > 3 ? prog.gramAt[3] : 0;
  const reach = (size > 3 ? o3 : size > 2 ? o2 : size > 1 ? o1 : o0) + 16;
  // What makes a letter of either case compare equal to the lower case one (0 elsewhere).
  const fold = prog.gramFold;
  const f0 = velt_simd_u8x16_splat(fold[0]);
  const f1 = velt_simd_u8x16_splat(size > 1 ? fold[1] : 0);
  const f2 = velt_simd_u8x16_splat(size > 2 ? fold[2] : 0);
  const f3 = velt_simd_u8x16_splat(size > 3 ? fold[3] : 0);
  const a0 = velt_simd_u8x16_splat(g[0]);
  const a1 = velt_simd_u8x16_splat(size > 1 ? g[1] : 0);
  const a2 = velt_simd_u8x16_splat(size > 2 ? g[2] : 0);
  const a3 = velt_simd_u8x16_splat(size > 3 ? g[3] : 0);
  const b0 = velt_simd_u8x16_splat(count > 1 ? g[size] : 0);
  const b1 = velt_simd_u8x16_splat(count > 1 && size > 1 ? g[size + 1] : 0);
  const b2 = velt_simd_u8x16_splat(count > 1 && size > 2 ? g[size + 2] : 0);
  const b3 = velt_simd_u8x16_splat(count > 1 && size > 3 ? g[size + 3] : 0);
  const c0 = velt_simd_u8x16_splat(count > 2 ? g[2 * size] : 0);
  const c1 = velt_simd_u8x16_splat(count > 2 && size > 1 ? g[2 * size + 1] : 0);
  const c2 = velt_simd_u8x16_splat(count > 2 && size > 2 ? g[2 * size + 2] : 0);
  const c3 = velt_simd_u8x16_splat(count > 2 && size > 3 ? g[2 * size + 3] : 0);
  const d0 = velt_simd_u8x16_splat(count > 2 ? g[3 * size] : 0);
  const d1 = velt_simd_u8x16_splat(count > 2 && size > 1 ? g[3 * size + 1] : 0);
  const d2 = velt_simd_u8x16_splat(count > 2 && size > 2 ? g[3 * size + 2] : 0);
  const d3 = velt_simd_u8x16_splat(count > 2 && size > 3 ? g[3 * size + 3] : 0);
  let i = from;
  // The last byte a step can start at, when there is one.
  const steps = len >= reach;
  const stop = steps ? len - reach : 0;
  while (true) {
    // The steps call nothing, so what they read of `s` and of the program stays in registers.
    let bits: u64 = 0;
    while (steps && i <= stop) {
      const v0 =
        folded
          ? velt_simd_u8x16_or(strLoadU8x16(s, (i + o0) as u64), f0)
          : strLoadU8x16(s, (i + o0) as u64);
      let ma = velt_simd_u8x16_eq(v0, a0);
      let mb = velt_simd_u8x16_eq(v0, b0);
      let mc = velt_simd_u8x16_eq(v0, c0);
      let md = velt_simd_u8x16_eq(v0, d0);
      if (size > 1) {
        const v1 =
          folded
            ? velt_simd_u8x16_or(strLoadU8x16(s, (i + o1) as u64), f1)
            : strLoadU8x16(s, (i + o1) as u64);
        ma = velt_simd_mask8x16_and(ma, velt_simd_u8x16_eq(v1, a1));
        mb = velt_simd_mask8x16_and(mb, velt_simd_u8x16_eq(v1, b1));
        mc = velt_simd_mask8x16_and(mc, velt_simd_u8x16_eq(v1, c1));
        md = velt_simd_mask8x16_and(md, velt_simd_u8x16_eq(v1, d1));
      }
      if (size > 2) {
        const v2 =
          folded
            ? velt_simd_u8x16_or(strLoadU8x16(s, (i + o2) as u64), f2)
            : strLoadU8x16(s, (i + o2) as u64);
        ma = velt_simd_mask8x16_and(ma, velt_simd_u8x16_eq(v2, a2));
        mb = velt_simd_mask8x16_and(mb, velt_simd_u8x16_eq(v2, b2));
        mc = velt_simd_mask8x16_and(mc, velt_simd_u8x16_eq(v2, c2));
        md = velt_simd_mask8x16_and(md, velt_simd_u8x16_eq(v2, d2));
      }
      if (size > 3) {
        const v3 =
          folded
            ? velt_simd_u8x16_or(strLoadU8x16(s, (i + o3) as u64), f3)
            : strLoadU8x16(s, (i + o3) as u64);
        ma = velt_simd_mask8x16_and(ma, velt_simd_u8x16_eq(v3, a3));
        mb = velt_simd_mask8x16_and(mb, velt_simd_u8x16_eq(v3, b3));
        mc = velt_simd_mask8x16_and(mc, velt_simd_u8x16_eq(v3, c3));
        md = velt_simd_mask8x16_and(md, velt_simd_u8x16_eq(v3, d3));
      }
      if (count > 1) {
        ma = velt_simd_mask8x16_or(ma, mb);
      }
      if (count > 2) {
        ma = velt_simd_mask8x16_or(ma, velt_simd_mask8x16_or(mc, md));
      }
      bits = velt_simd_mask8x16_bitmask(ma);
      if (bits != 0) {
        break;
      }
      i += 16;
    }
    if (bits == 0) {
      return -2 - (i as i64);
    }
    while (bits != 0) {
      const found = hit(prog, m, s, i + (bits.trailingZeros() as usize), len, mode);
      if (found >= 0) {
        return found;
      }
      bits &= bits - 1;
    }
    i += 16;
  }
}

/** `wide` for the program's tuples, as the loop for their size and number, folded or not. */
function wideScan(
  prog: Program,
  m: Search | null,
  s: string,
  from: usize,
  len: usize,
  mode: u32,
): i64 {
  // With AVX2, thirty-two positions a step, where one step fits: it looks at every place a match
  // may start at, which leaves `gramScan` nothing more to do. (The tuples' offsets are inside
  // the shortest match, `minBytes`.)
  if (from + 31 + prog.minBytes <= len && Avx2.isSupported()) {
    return wideAvx2(prog, m, s, from, len, mode);
  }
  return prog.gramFolded
    ? wideSized(prog, m, s, from, len, true, mode)
    : wideSized(prog, m, s, from, len, false, mode);
}

@inline("always")
function wideSized(
  prog: Program,
  m: Search | null,
  s: string,
  from: usize,
  len: usize,
  folded: bool,
  mode: u32,
): i64 {
  const size = prog.gramSize;
  const count = prog.grams.length / size;
  if (size == 1) {
    return count == 1
      ? wide(prog, m, s, from, len, 1, 1, folded, mode)
      : count == 2
        ? wide(prog, m, s, from, len, 1, 2, folded, mode)
        : wide(prog, m, s, from, len, 1, 4, folded, mode);
  }
  if (size == 2) {
    return count == 1
      ? wide(prog, m, s, from, len, 2, 1, folded, mode)
      : count == 2
        ? wide(prog, m, s, from, len, 2, 2, folded, mode)
        : wide(prog, m, s, from, len, 2, 4, folded, mode);
  }
  if (size == 3) {
    return count == 1
      ? wide(prog, m, s, from, len, 3, 1, folded, mode)
      : count == 2
        ? wide(prog, m, s, from, len, 3, 2, folded, mode)
        : wide(prog, m, s, from, len, 3, 4, folded, mode);
  }
  return count == 1
    ? wide(prog, m, s, from, len, 4, 1, folded, mode)
    : count == 2
      ? wide(prog, m, s, from, len, 4, 2, folded, mode)
      : wide(prog, m, s, from, len, 4, 4, folded, mode);
}

/** Is one of the grams of `prog` at byte `i` of `s`? */
function gramHere(prog: Program, s: string, i: usize): bool {
  const size = prog.gramSize;
  for (let t: usize = 0; t < prog.grams.length; t += size) {
    let same = true;
    for (let j: usize = 0; j < size && same; j++) {
      same = (strByteAt(s, (i + prog.gramAt[j]) as u64) | prog.gramFold[j]) == prog.grams[t + j];
    }
    if (same) {
      return true;
    }
  }
  return false;
}

/** The scan by the grams of `prog` of the `len` bytes of `s` from `from` on, in mode `mode`:
 * the first result of `hit` that is not -1, or -1. */
function gramScan(
  prog: Program,
  m: Search | null,
  s: string,
  from: usize,
  len: usize,
  mode: u32,
): i64 {
  if (len < prog.minBytes) {
    return -1;
  }
  if (mode != ANY && m != null) {
    m.floor = from;
  }
  let found = wideScan(prog, m, s, from, len, mode);
  if (found >= 0) {
    return found;
  }
  // The last positions, which sixteen bytes do not fit after: one more step, over the last
  // sixteen it fits at (what it finds before where the steps stopped, they found already),
  // and a byte loop only where no step fits at all.
  const last = len - prog.minBytes;
  const reach = prog.gramAt[prog.gramSize - 1] + 16;
  const stopped = (-2 - found) as usize;
  // Only when the steps read up to there: before `from` nothing is looked at.
  if (len >= reach && from <= len - reach && stopped <= last) {
    found = wideScan(prog, m, s, len - reach, len, mode);
    if (found >= 0) {
      // A place the tuples fit at may be too near the end for a match (`valu` of `value\d+`).
      return mode == ANY && (found as usize) > last ? -1 : found;
    }
  }
  for (let i = (-2 - found) as usize; i <= last; i++) {
    if (mode != ANY || gramHere(prog, s, i)) {
      const here = hit(prog, m, s, i, len, mode);
      if (here >= 0) {
        return here;
      }
    }
  }
  return -1;
}

/** The first byte at or after `from` that is a first byte of `prog`'s matches, or -1. */
function firstScan(prog: Program, s: string, from: usize, len: usize): i64 {
  const first = prog.first;
  for (let i = from; i < len; i++) {
    const b = strByteAt(s, i as u64) as u32;
    if (((first[(b >> 6) as usize] >> ((b & 63) as u64)) & 1) != 0) {
      return i as i64;
    }
  }
  return -1;
}

/** The first byte at or after `from` where a match of `prog` in the `len` bytes of `s` may
 * start, or -1 when none can (`m`: the search's, or none for a look before one is made). `from` is a position (decode.velt), and so is the result. */
export function candidate(
  prog: Program,
  m: Search | null,
  s: string,
  from: usize,
  len: usize,
): i64 {
  if (prog.scan == SCAN_GRAMS) {
    // One byte to look for: std's own search for one, which is short when the byte is near
    // (not a letter of either case: the wide scan folds it).
    if (prog.grams.length == 1 && prog.gramFold[0] == 0) {
      return findByte(s, prog.grams[0], from, len);
    }
    return gramScan(prog, m, s, from, len, ANY);
  }
  if (prog.scan == SCAN_FIRST) {
    return firstScan(prog, s, from, len);
  }
  return from as i64;
}

/** The first match of an `exact` program at or after byte `from` of `s`: its start, or -1 for
 * none; `literalEnd` gives its end. */
export function literalFind(prog: Program, m: Search, s: string, from: usize, len: usize): i64 {
  return gramScan(prog, m, s, from, len, FIRST);
}

/** Every match of an `exact` program in the `len` bytes of `s`, one after the end of the one
 * before: their starts and ends are added to `m.found`. */
export function literalAll(prog: Program, m: Search, s: string, len: usize): void {
  gramScan(prog, m, s, 0, len, ALL);
}

/** The end of the match `found`, a result of `literalFind` that is not -1. */
@inline("always")
export function literalEnd(prog: Program, found: i64): usize {
  return ((found & POSITION) as usize) +
    strByteLen(prog.literals[(found >> LITERAL_SHIFT) as usize]);
}

/** The start of the match `found`, a result of `literalFind` that is not -1. */
@inline("always")
export function literalStart(found: i64): usize {
  return (found & POSITION) as usize;
}
