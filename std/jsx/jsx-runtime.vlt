// std/jsx/jsx-runtime: the JSX provider module of std/jsx (docs/contracts/jsx.md). A module
// with JSX imports it implicitly, as the namespace `JSX` for types; generated code calls the
// factories. Includes the SSR precompile exports, so static markup compiles to constant strings.

export { Element, RenderError } from "velt:jsx/node";
export type { Child, AttrValue, Style, Text } from "velt:jsx/node";
export type { IntrinsicElements, ElementChildrenAttribute } from "velt:jsx/intrinsic";
export {
  jsx,
  Fragment,
  jsxComponent,
  jsxAsyncComponent,
  jsxTemplate,
  jsxTemplateString,
  jsxList,
  jsxEscape,
  jsxAttr,
} from "velt:jsx/factory";
export { jsxVoidElements } from "velt:jsx/void_elements";
