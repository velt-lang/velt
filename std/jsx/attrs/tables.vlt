// std/jsx/attrs/tables: attribute types of table cells and columns
// (each is `HtmlAttrs`, the global attributes from attrs/global.vlt, `&` its own; public as
// `velt:jsx/attrs`).

import type { HtmlAttrs } from "velt:jsx/attrs/global";

// `<col>` and `<colgroup>`.
export type ColAttrs = HtmlAttrs & { span?: string | i64 | f64 };

// `<td>`.
export type TdAttrs = HtmlAttrs & {
  colspan?: string | i64 | f64;
  rowspan?: string | i64 | f64;
  headers?: string;
};

// `<th>`.
export type ThAttrs = HtmlAttrs & {
  colspan?: string | i64 | f64;
  rowspan?: string | i64 | f64;
  headers?: string;
  scope?: string;
  abbr?: string;
};
