// std/jsx/attrs/forms: attribute types of forms, buttons and inputs
// (each is `HtmlAttrs`, the global attributes from attrs/global.vlt, `&` its own; public as
// `velt:jsx/attrs`).

import type { HtmlAttrs } from "velt:jsx/attrs/global";

/** `<button>`. */
export type ButtonAttrs = HtmlAttrs & {
  command?: string;
  commandfor?: string;
  disabled?: bool;
  form?: string;
  formaction?: string;
  formenctype?: string;
  formmethod?: string;
  formnovalidate?: bool;
  formtarget?: string;
  name?: string;
  popovertarget?: string;
  popovertargetaction?: string;
  type?: string;
  value?: string | i64 | f64;
};

/** `<fieldset>`. */
export type FieldsetAttrs = HtmlAttrs & { disabled?: bool; form?: string; name?: string };

/** `<form>` (`accept-charset` is written as is: hyphenated names are not checked). */
export type FormAttrs = HtmlAttrs & {
  action?: string;
  autocomplete?: string;
  enctype?: string;
  method?: string;
  name?: string;
  novalidate?: bool;
  rel?: string;
  target?: string;
};

/** `<input>`. */
export type InputAttrs = HtmlAttrs & {
  accept?: string;
  alpha?: bool;
  alt?: string;
  autocomplete?: string;
  checked?: bool;
  colorspace?: string;
  dirname?: string;
  disabled?: bool;
  form?: string;
  formaction?: string;
  formenctype?: string;
  formmethod?: string;
  formnovalidate?: bool;
  formtarget?: string;
  height?: string | i64 | f64;
  list?: string;
  max?: string | i64 | f64;
  maxlength?: string | i64 | f64;
  min?: string | i64 | f64;
  minlength?: string | i64 | f64;
  multiple?: bool;
  name?: string;
  pattern?: string;
  placeholder?: string;
  popovertarget?: string;
  popovertargetaction?: string;
  readonly?: bool;
  required?: bool;
  size?: string | i64 | f64;
  src?: string;
  step?: string | i64 | f64;
  type?: string;
  value?: string | i64 | f64;
  width?: string | i64 | f64;
};
