// std/jsx/attrs/text: attribute types of quotations, edits, lists, dates and disclosure widgets
// (internal; the global attributes are repeated from attrs/global.vlt, see there).

// `<blockquote>` and `<q>`.
export type QuoteAttrs = {
  accesskey?: string;
  autocapitalize?: string;
  autocorrect?: string;
  autofocus?: bool;
  class?: string;
  contenteditable?: bool | string;
  dir?: string;
  draggable?: string;
  enterkeyhint?: string;
  exportparts?: string;
  hidden?: bool | string;
  id?: string;
  inert?: bool;
  inputmode?: string;
  is?: string;
  itemid?: string;
  itemprop?: string;
  itemref?: string;
  itemscope?: bool;
  itemtype?: string;
  lang?: string;
  nonce?: string;
  part?: string;
  popover?: bool | string;
  role?: string;
  slot?: string;
  spellcheck?: string;
  style?: string;
  tabindex?: string | i64 | f64;
  title?: string;
  translate?: string;
  writingsuggestions?: string;
  cite?: string;
};

