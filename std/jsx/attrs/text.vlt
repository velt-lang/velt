// std/jsx/attrs/text: attribute types of quotations, edits, lists, dates and disclosure widgets
// (each is `HtmlAttrs`, the global attributes from attrs/global.vlt, `&` its own; public as
// `velt:jsx/attrs`).

import type { HtmlAttrs } from "velt:jsx/attrs/global";

// `<blockquote>` and `<q>`.
export type QuoteAttrs = HtmlAttrs & {
  cite?: string;
};

// `<del>` and `<ins>`.
export type EditAttrs = HtmlAttrs & {
  cite?: string;
  datetime?: string;
};

// `<data>`.
export type DataAttrs = HtmlAttrs & {
  value?: string | i64 | f64;
};

// `<time>`.
export type TimeAttrs = HtmlAttrs & {
  datetime?: string;
};

// `<li>`.
export type LiAttrs = HtmlAttrs & {
  value?: string | i64 | f64;
};

// `<ol>`.
export type OlAttrs = HtmlAttrs & {
  reversed?: bool;
  start?: string | i64 | f64;
  type?: string;
};

// `<details>`.
export type DetailsAttrs = HtmlAttrs & {
  open?: bool;
  name?: string;
};

// `<dialog>`.
export type DialogAttrs = HtmlAttrs & {
  open?: bool;
  closedby?: string;
};
