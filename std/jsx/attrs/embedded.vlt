// std/jsx/attrs/embedded: attribute types of embedded content, image maps, slots and templates
// (each is `HtmlAttrs`, the global attributes from attrs/global.vlt, `&` its own; public as
// `velt:jsx/attrs`).

import type { HtmlAttrs } from "velt:jsx/attrs/global";

// `<iframe>`.
export type IframeAttrs = HtmlAttrs & {
  src?: string;
  srcdoc?: string;
  name?: string;
  sandbox?: string;
  allow?: string;
  allowfullscreen?: bool;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
  referrerpolicy?: string;
  loading?: string;
};

// `<embed>`.
export type EmbedAttrs = HtmlAttrs & {
  src?: string;
  type?: string;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
};

// `<object>`.
export type ObjectAttrs = HtmlAttrs & {
  data?: string;
  type?: string;
  name?: string;
  form?: string;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
};

// `<map>`.
export type MapAttrs = HtmlAttrs & {
  name?: string;
};

// `<slot>`.
export type SlotAttrs = HtmlAttrs & {
  name?: string;
};

// `<template>`.
export type TemplateAttrs = HtmlAttrs & {
  shadowrootmode?: string;
  shadowrootdelegatesfocus?: bool;
  shadowrootclonable?: bool;
  shadowrootserializable?: bool;
};
