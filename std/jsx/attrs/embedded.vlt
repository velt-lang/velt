// std/jsx/attrs/embedded: attribute types of embedded content, image maps, slots and templates
// (internal; the global attributes are repeated from attrs/global.vlt, see there).

/** `<iframe>`. */
export type IframeAttrs = {
  accesskey?: string;
  autocapitalize?: string;
  autocorrect?: string;
  autofocus?: bool;
  class?: string;
  contenteditable?: bool | string;
  dir?: string;
  draggable?: string;
  enterkeyhint?: string;
  exportparts?: string;
  hidden?: bool | string;
  id?: string;
  inert?: bool;
  inputmode?: string;
  is?: string;
  itemid?: string;
  itemprop?: string;
  itemref?: string;
  itemscope?: bool;
  itemtype?: string;
  lang?: string;
  nonce?: string;
  part?: string;
  popover?: bool | string;
  role?: string;
  slot?: string;
  spellcheck?: string;
  style?: string;
  tabindex?: string | i64 | f64;
  title?: string;
  translate?: string;
  writingsuggestions?: string;
  src?: string;
  srcdoc?: string;
  name?: string;
  sandbox?: string;
  allow?: string;
  allowfullscreen?: bool;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
  referrerpolicy?: string;
  loading?: string;
};

