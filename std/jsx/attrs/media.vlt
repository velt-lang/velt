// std/jsx/attrs/media: attribute types of images, audio and video
// (each is `HtmlAttrs`, the global attributes from attrs/global.vlt, `&` its own; public as
// `velt:jsx/attrs`).

import type { HtmlAttrs } from "velt:jsx/attrs/global";

// `<audio>`.
export type AudioAttrs = HtmlAttrs & {
  src?: string;
  crossorigin?: string;
  preload?: string;
  autoplay?: bool;
  loop?: bool;
  muted?: bool;
  controls?: bool;
};

// `<video>`.
export type VideoAttrs = HtmlAttrs & {
  src?: string;
  crossorigin?: string;
  preload?: string;
  autoplay?: bool;
  loop?: bool;
  muted?: bool;
  controls?: bool;
  poster?: string;
  playsinline?: bool;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
  disablepictureinpicture?: bool;
  disableremoteplayback?: bool;
};

// `<img>`.
export type ImgAttrs = HtmlAttrs & {
  alt?: string;
  src?: string;
  srcset?: string;
  sizes?: string;
  crossorigin?: string;
  usemap?: string;
  ismap?: bool;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
  referrerpolicy?: string;
  decoding?: string;
  loading?: string;
  fetchpriority?: string;
};

// `<source>`.
export type SourceAttrs = HtmlAttrs & {
  type?: string;
  media?: string;
  src?: string;
  srcset?: string;
  sizes?: string;
  width?: string | i64 | f64;
  height?: string | i64 | f64;
};

// `<track>`.
export type TrackAttrs = HtmlAttrs & {
  default?: bool;
  kind?: string;
  label?: string;
  src?: string;
  srclang?: string;
};

// `<canvas>`.
export type CanvasAttrs = HtmlAttrs & {
  width?: string | i64 | f64;
  height?: string | i64 | f64;
};
