// std/jsx/attrs/links: attribute types of hyperlinks, document metadata and scripts
// (each is `HtmlAttrs`, the global attributes from attrs/global.vlt, `&` its own; public as
// `velt:jsx/attrs`).

import type { HtmlAttrs } from "velt:jsx/attrs/global";

/** `<a>`. */
export type AnchorAttrs = HtmlAttrs & {
  href?: string;
  target?: string;
  download?: bool | string;
  ping?: string;
  rel?: string;
  hreflang?: string;
  type?: string;
  referrerpolicy?: string;
};

/** `<area>`. */
export type AreaAttrs = HtmlAttrs & {
  alt?: string;
  coords?: string;
  shape?: string;
  href?: string;
  target?: string;
  download?: bool | string;
  ping?: string;
  rel?: string;
  referrerpolicy?: string;
};

/** `<base>`. */
export type BaseAttrs = HtmlAttrs & { href?: string; target?: string };

/** `<link>`. */
export type LinkAttrs = HtmlAttrs & {
  href?: string;
  crossorigin?: string;
  rel?: string;
  as?: string;
  media?: string;
  hreflang?: string;
  type?: string;
  sizes?: string;
  imagesrcset?: string;
  imagesizes?: string;
  referrerpolicy?: string;
  integrity?: string;
  blocking?: string;
  color?: string;
  disabled?: bool;
  fetchpriority?: string;
};

/** `<meta>` (`http-equiv` is written as is: hyphenated names are not checked). */
export type MetaAttrs = HtmlAttrs & {
  name?: string;
  content?: string;
  charset?: string;
  media?: string;
};

/** `<script>`. */
export type ScriptAttrs = HtmlAttrs & {
  src?: string;
  type?: string;
  nomodule?: bool;
  async?: bool;
  defer?: bool;
  crossorigin?: string;
  integrity?: string;
  referrerpolicy?: string;
  blocking?: string;
  fetchpriority?: string;
};

/** `<style>`. */
export type StyleAttrs = HtmlAttrs & { media?: string; blocking?: string };
