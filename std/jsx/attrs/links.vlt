// std/jsx/attrs/links: attribute types of hyperlinks, document metadata and scripts
// (internal; the global attributes are repeated from attrs/global.vlt, see there).

/** `<a>`. */
export type AnchorAttrs = {
  accesskey?: string;
  autocapitalize?: string;
  autocorrect?: string;
  autofocus?: bool;
  class?: string;
  contenteditable?: bool | string;
  dir?: string;
  draggable?: string;
  enterkeyhint?: string;
  exportparts?: string;
  hidden?: bool | string;
  id?: string;
  inert?: bool;
  inputmode?: string;
  is?: string;
  itemid?: string;
  itemprop?: string;
  itemref?: string;
  itemscope?: bool;
  itemtype?: string;
  lang?: string;
  nonce?: string;
  part?: string;
  popover?: bool | string;
  role?: string;
  slot?: string;
  spellcheck?: string;
  style?: string;
  tabindex?: string | i64 | f64;
  title?: string;
  translate?: string;
  writingsuggestions?: string;
  href?: string;
  target?: string;
  download?: bool | string;
  ping?: string;
  rel?: string;
  hreflang?: string;
  type?: string;
  referrerpolicy?: string;
};

