// velt/jsx (internal): the functions compiled JSX calls (docs/internals/contracts/jsx.md "Required
// exports" and "SSR precompile"), plus `raw`. Internal: std/jsx/jsx-runtime re-exports them.
//
// Every factory renders what it can at once (node.vlt): text is escaped into the new node's strings
// and child nodes become its slots, and a child that still waits for an async component is kept as
// a part, with the markup after it collected in a following complete part.

import { escapeText, renderAttr } from "velt/jsx/escape";
import { isVoidElement } from "velt/jsx/void_elements";
import { appendChildren, appendHtml, formatNumber } from "velt/jsx/append";
import { Deferred } from "velt/jsx/deferred";
import { RenderError } from "velt/jsx/errors";
import { AttrValue, Child, Element, Text } from "velt/jsx/node";
import { childrenText, isNodeChild, nodeOfChild, templateOf } from "velt/jsx/template";

/**
 * An intrinsic element `<tag names[i]=values[i]…>children</tag>`. `names` are compile-time
 * attribute names; children of a void element (`<br>`) are dropped. `key` is not rendered.
 */
export function jsx(
  tag: string,
  names: string[],
  values: AttrValue[],
  children: Child[],
  key: string | null,
): Element {
  let open = `<${tag}`;
  for (let i: usize = 0; i < names.length; i++) {
    open += renderAttr(names[i], values[i]);
  }
  open += ">";
  if (isVoidElement(tag)) {
    return new Element(open);
  }
  const inner = childrenText(children);
  if (inner != null) {
    return new Element(`${open}${inner}</${tag}>`);
  }
  const done = templateOf(open, children, tag);
  if (done != null) {
    return done;
  }
  const node = new Element(open);
  appendChildren(node, children);
  appendHtml(node, `</${tag}>`);
  return node;
}

/** `<>children</>`: the children's markup, nothing around it. */
export function Fragment(children: Child[], key: string | null): Element {
  if (children.length == 1 && isNodeChild(children[0])) {
    // `{list}` (`Fragment([v], null)` from the compiler): the node is the child itself, or keeps
    // the array as its slots.
    const only = children.pop();
    if (only != null) {
      return nodeOfChild(only);
    }
  }
  const inner = childrenText(children);
  if (inner != null) {
    return new Element(inner);
  }
  const done = templateOf("", children, "");
  if (done != null) {
    return done;
  }
  const node = new Element("");
  appendChildren(node, children);
  return node;
}

/**
 * `<Card …/>`: std/jsx has no context to set up, so it calls the component at once. What the
 * component throws does not propagate from here: the node then fails when it is rendered, with
 * a `RenderError` naming the component, like an async component's rejection. `name`
 * (`"<module path>#<Name>"`) is for providers that emit hydration markers; std/jsx renders none.
 */
export function jsxComponent<P, E>(
  component: (props: P) => Element throws E,
  props: P,
  key: string | null,
  name: string,
): Element {
  try {
    return component(props);
  } catch (e) {
    const rest = new Deferred();
    rest.failure = new RenderError(name, `Component ${name} failed: ${e}`);
    const node = new Element("");
    node.rest = rest;
    return node;
  }
}

/**
 * `<Posts …/>` for an async component: calls it now, so siblings load concurrently, and keeps
 * its promise in the node; rendering awaits it in document order, and a rejection surfaces then
 * as a `RenderError` naming the component.
 */
export function jsxAsyncComponent<P, E>(
  component: (props: P) => Promise<Element, E>,
  props: P,
  key: string | null,
  name: string,
): Element {
  const rest = new Deferred();
  rest.pending.push(settle(component(props), name));
  const node = new Element("");
  node.rest = rest;
  return node;
}

// The component's promise with its error turned into a `RenderError` (Element cannot carry a
// generic error type).
async function settle<E>(p: Promise<Element, E>, name: string): Promise<Element, RenderError> {
  try {
    return await p;
  } catch (e) {
    throw new RenderError(name, `Component ${name} failed: ${e}`);
  }
}

/**
 * A dynamic text child of a template, escaped: numbers render like `${n}`, `true`, `false` and
 * `null` render nothing. The compiler folds the result into the template's strings.
 */
export function jsxEscape(value: Text): string {
  if (value == null || typeof value === "boolean") {
    return "";
  }
  if (typeof value === "string") {
    return escapeText(value);
  }
  return formatNumber(value);
}

/**
 * `jsxEscape` of a `string` child: the compiler calls it when the child's type is `string`, so
 * the text is escaped without going through the `Text` union.
 */
export function jsxEscapeString(value: string): string {
  return escapeText(value);
}

/**
 * A dynamic attribute of a template: ` name="value"`, ` name` or nothing (folded into the
 * template's strings like `jsxEscape`).
 */
export function jsxAttr(name: string, value: AttrValue): string {
  return renderAttr(name, value);
}

/**
 * `html` inserted as it is, without escaping: the only way to emit markup from a string. Never
 * pass it text from users.
 */
export function raw(html: string): Element {
  return new Element(html);
}
