// std/jsx/escape: HTML escaping of text and attributes (docs/contracts/jsx.md "Escaping").
//
// Text and attribute values escape `&`, `<`, `>`, `"` and `'` as react-dom does: like std/html
// `escapeHtml`, but `'` is `&#x27;` (`velt_rt_jsx_escape`, one pass in the runtime). The
// compiler escapes static text and attributes of precompiled templates the same way, and leaves
// those with a `'` to `jsxEscape`/`jsxAttr`, so both lowerings render the same bytes.

import type { AttrValue } from "velt:jsx/node";
import { renderStyle } from "velt:jsx/style";

// `(const VeltStr* s, VeltStr* out)`: `s` with `& < > " '` replaced by entities (`'`: `&#x27;`).
declare function velt_rt_jsx_escape(s: string): string;

/**
 * `s` with `&`, `<`, `>`, `"` and `'` replaced by `&amp;`, `&lt;`, `&gt;`, `&quot;` and
 * `&#x27;`, as react-dom writes them.
 */
export function escapeText(s: string): string {
  return velt_rt_jsx_escape(s);
}

/**
 * One attribute as it appears in a start tag: ` name="escaped value"`, ` name` for `true`, and
 * nothing for `false` and `null`.
 */
export function renderAttr(name: string, value: AttrValue): string {
  if (value == null) {
    return "";
  }
  if (typeof value === "string") {
    return ` ${name}="${escapeText(value)}"`;
  }
  if (typeof value === "boolean") {
    return value ? ` ${name}` : "";
  }
  if (typeof value === "object") {
    return ` ${name}="${escapeText(renderStyle(value))}"`;
  }
  return ` ${name}="${value}"`;
}
