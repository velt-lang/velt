// velt/native (internal): the `IoError` of a failed runtime or native-package result.

import { IoError } from "velt/io/error";
import { velt_rt_err_code_name } from "velt/native/rt";

/** Builds the `IoError` for a failed result; takes ownership of the runtime's message. */
export function ioError(code: i32, message: string): IoError {
  return new IoError(velt_rt_err_code_name(code), message);
}
