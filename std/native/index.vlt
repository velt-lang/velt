// velt/native: what the Velt side of a native package (docs/book/native-packages.md) binds its
// Rust functions with: `IoResult<T>` and `IoStatus`, the C layouts a native function returns,
// and `unwrapIo` / `checkIo`, which turn a failed one into an `IoError`.

export { IoResult, unwrapIo } from "velt/native/result";
export { checkIo, IoStatus } from "velt/native/status";
export { ioError } from "velt/native/error";
