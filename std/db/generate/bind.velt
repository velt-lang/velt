// velt/db (internal): the generators of `bindValues<P>` and `writeValues<P, S>` (generated.velt), run
// at compile time (docs/internals/design/source-generators.md): a statement's parameters handed
// value by value to a native driver's parameter sink (`velt_rt_param_*`, velt/db/rt) or to a
// `ParamSink`, as their JSON text would bind: an array or tuple its values in order, an object each member's name and value, a
// lone value itself (a `u8[]` member or element a blob). Only types whose JSON text binds plainly
// are handed over (numbers, booleans, strings, `T | null` of those, `u8[]` inside an array or an
// object, and objects of such fields); for any other the function returns false having done
// nothing, and the driver binds the JSON text, so the result never differs.

import { InstanceRequest, Model, Output, Type } from "velt/generate";
import { hiddenKey, member } from "velt/encoding/json/generate/facts";
import { isJsonValue } from "velt/encoding/json/generate/read_value";
import { isBlob } from "velt/db/generate/columns";

/** A number, a boolean, a string, or `T | null` of one. */
function scalar(model: Model, t: Type): bool {
  const plain = (x: Type): bool => x.kind == "number" || x.kind == "string" || x.kind == "boolean";
  if (t.kind == "option") {
    // `undefined` is left out of an object's JSON (a missing name): JSON binds that.
    return t.literal == "null" && plain(model.type(t.args[0]));
  }
  return plain(t);
}

/**
 * An object, struct or class written as its plain fields: each a scalar or a blob, none
 * optional (`a?: T`, left out when absent) and none a function; keys never written (`#x`,
 * symbols) are left out.
 */
function plainObject(model: Model, t: Type): bool {
  if (!(t.kind == "object" || t.kind == "struct" || t.kind == "class")) {
    return false;
  }
  if (t.dynamic || t.hasProperties || isJsonValue(t)) {
    return false;
  }
  for (const m of t.methods) {
    if (m.name == "toJSON") {
      return false;
    }
  }
  for (const f of t.fields) {
    if (hiddenKey(f)) {
      continue;
    }
    const ft = model.type(f.type);
    if (
      f.optional ||
      f.isGetter ||
      f.stdPrivate ||
      f.via >= 0 ||
      !(scalar(model, ft) || isBlob(model, ft))
    ) {
      return false;
    }
  }
  return true;
}

/** Whether parameters of type `t` are handed over value by value. */
function bindable(model: Model, t: Type): bool {
  if (t.kind == "array") {
    const e = model.type(t.args[0]);
    return scalar(model, e) || isBlob(model, e);
  }
  if (t.kind == "tuple") {
    for (const a of t.args) {
      const e = model.type(a);
      if (!(scalar(model, e) || isBlob(model, e))) {
        return false;
      }
    }
    return true;
  }
  if (t.kind == "object" || t.kind == "struct" || t.kind == "class") {
    return plainObject(model, t);
  }
  return scalar(model, t);
}

/** Where the generated code hands the values: a native driver's sink, or a `ParamSink`. */
interface Target {
  /** The statement that hands over one value (`args`: its text, empty for none). */
  call(kind: string, args: string): string;
}

class NativeSink implements Target {
  call(kind: string, args: string): string {
    return args.length == 0
      ? `velt_rt_param_${kind}(sink);`
      : `velt_rt_param_${kind}(sink, ${args});`;
  }
}

/** The `ParamSink` methods, named for what they take (the native functions by their types). */
class VeltSink implements Target {
  call(kind: string, args: string): string {
    const method =
      kind == "i64"
        ? "int"
        : kind == "u64"
          ? "uint"
          : kind == "f64" ? "float" : kind == "str" ? "text" : kind == "bytes" ? "blob" : kind;
    return `sink.${method}(${args});`;
  }
}

/** Writes the code that hands the value `v` of type `t` to the sink: a scalar or a blob. */
function bindMember(out: Output, model: Model, to: Target, t: Type, v: string): void {
  if (isBlob(model, t)) {
    out.line(to.call("bytes", v));
    return;
  }
  bindValue(out, model, to, t, v);
}

/** Writes the code that hands the scalar `v` of type `t` to the sink. */
function bindValue(out: Output, model: Model, to: Target, t: Type, v: string): void {
  if (t.kind == "option") {
    const x = out.fresh("x");
    out.line(`const ${x} = ${v};`);
    out.line(`if (${x} == null) { ${to.call("null", "")} } else {`);
    bindValue(out, model, to, model.type(t.args[0]), x);
    out.line(`}`);
  } else if (t.kind == "number" && (t.repr == "f64" || t.repr == "f32")) {
    out.line(to.call("f64", `${v} as f64`));
  } else if (t.kind == "number" && t.repr.startsWith("u")) {
    out.line(to.call("u64", `${v} as u64`));
  } else if (t.kind == "number") {
    out.line(to.call("i64", `${v} as i64`));
  } else if (t.kind == "boolean") {
    out.line(to.call("bool", v));
  } else {
    out.line(to.call("str", v));
  }
}

/** The generator of `bindValues<P>(sink: u64, params: P): bool`. */
export function bindValues(req: InstanceRequest, out: Output): void {
  generate(req, out, new NativeSink());
}

/** The generator of `writeValues<P, S>(sink: S, params: P): bool`. */
export function writeValues(req: InstanceRequest, out: Output): void {
  generate(req, out, new VeltSink());
}

function generate(req: InstanceRequest, out: Output, to: Target): void {
  const model = req.model;
  const t = model.type(req.args[0]);
  const [sink, params] = [req.params[0], req.params[1]];
  if (!bindable(model, t)) {
    out.line(`return false;`);
    return;
  }
  if (sink != "sink") {
    out.line(`const sink = ${sink};`);
  }
  if (t.kind == "array") {
    const e = model.type(t.args[0]);
    out.line(`for (const x of ${params}) {`);
    bindMember(out, model, to, e, "x");
    out.line(`}`);
  } else if (t.kind == "tuple") {
    for (let i: i64 = 0; i < (t.args.length as i64); i++) {
      bindMember(out, model, to, model.type(t.args[i]), `${params}[${i}]`);
    }
  } else if (t.kind == "object" || t.kind == "struct" || t.kind == "class") {
    out.line(to.call("object", ""));
    for (const f of t.fields) {
      if (hiddenKey(f)) {
        continue;
      }
      out.line(to.call("name", out.literal(f.name)));
      bindMember(out, model, to, model.type(f.type), member(out, params, f.name));
    }
  } else {
    bindValue(out, model, to, t, params);
  }
  out.line(`return true;`);
}
