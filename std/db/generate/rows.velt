// velt/db (internal): the generator of `readRowsByColumn<T, S>` and `readRowByColumn<T, S>`
// (generated.velt), run at compile time (docs/internals/design/source-generators.md): the rows of
// a `RowSource` `S` read column by column into a `T` of plain fields, through the source's own
// methods (columns.velt). For any other `T` they return `null` without reading, and velt/db reads
// the rows through their JSON text instead.

import { InstanceRequest, Output } from "velt/generate";
import { beginRows, plainRow, readRow, RowsFrom } from "velt/db/generate/columns";

/** The generator of `readRowsByColumn<T, S>(src: S): T[] | null throws Error`. */
export function readRowsByColumn(req: InstanceRequest, out: Output): void {
  const model = req.model;
  const id = req.args[0];
  if (!plainRow(model, id)) {
    out.line(`return null;`);
    return;
  }
  const from = new RowsFrom(false, req.params[0]);
  beginRows(out, model, id, from, "");
  out.line(`const out: ${out.typeName(id)}[] = [];`);
  out.line(`let row: i64 = 0;`);
  out.line(`while (${from.name}.next()) {`);
  readRow(out, model, id, from, "row", "x");
  out.line(`out.push(x);`);
  out.line(`row++;`);
  out.line(`}`);
  out.line(`return out;`);
}

/** The generator of `readRowByColumn<T, S>(src: S): T | null throws Error`. */
export function readRowByColumn(req: InstanceRequest, out: Output): void {
  const model = req.model;
  const id = req.args[0];
  if (!plainRow(model, id)) {
    out.line(`return null;`);
    return;
  }
  const from = new RowsFrom(false, req.params[0]);
  beginRows(out, model, id, from, "");
  readRow(out, model, id, from, "-1", "x");
  out.line(`return x;`);
}
