// velt/db (internal): what the code generated for velt/db calls besides a `RowSource`'s own
// methods: the error of a row that does not fit.

import { JsonError } from "velt/prelude/json/json_error";
import { shortPath } from "velt/encoding/json/reader_ops";

/**
 * The `JsonError` of a row that does not fit, with `JSON.parse`'s message: `expected
 * <expected> at $[row].field` (`row` -1: the single row, `$`; `field` empty: the row itself).
 */
export function rowMismatch(expected: string, row: i64, field: string): JsonError {
  const at = row >= 0 ? `$[${row}]` : "$";
  const path = field.length > 0 ? `${at}.${field}` : at;
  return new JsonError(`expected ${expected} at ${shortPath(path)}`);
}
