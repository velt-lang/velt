// velt/db (internal): the functions velt/db's readers and binder call whose bodies are generated
// per type at compile time (docs/internals/design/source-generators.md) by velt/db/generate:
// rows of a `RowSource` read by column (rows.vlt, columns.vlt), and a statement's parameters
// handed to a native driver's sink value by value (bind.vlt). The code they generate calls what
// is imported here.

import { CellKind } from "velt/db/row_source";
import {
  rowMismatch,
  velt_rt_param_bool,
  velt_rt_param_bytes,
  velt_rt_param_f64,
  velt_rt_param_i64,
  velt_rt_param_name,
  velt_rt_param_null,
  velt_rt_param_object,
  velt_rt_param_str,
  velt_rt_param_u64,
} from "velt/db/rt";

// 1 and the integer in `out` (passed by pointer) when `v` is one exactly, else 0.
declare function velt_rt_rows_exact_i64(v: f64, out: RowsI64): u8;

struct RowsI64 {
  v: i64;
}

/**
 * Every remaining row of `src` as a `T`, read by column when `T` is an object, struct or class
 * of plain fields (numbers, booleans, strings, `T | null` of those, `u8[]`); `null`, having read
 * nothing, for any other `T` (velt/db then reads the rows' JSON text). A row that does not fit
 * throws `JsonError`; what the source's methods throw passes through (an `Error`).
 */
export declare generated("velt/db/generate/rows") function readRowsByColumn<T, S>(
  src: S,
): T[] | null throws Error;

/** The current row of `src` (`next()` returned true), as `readRowsByColumn` reads each. */
export declare generated("velt/db/generate/rows") function readRowByColumn<T, S>(
  src: S,
): T | null throws Error;

/**
 * Hands `params` to a native driver's parameter sink (its address) value by value; false,
 * having done nothing, for a type whose JSON text the driver binds instead.
 */
export declare generated("velt/db/generate/bind") function bindValues<P>(
  sink: u64,
  params: P,
): bool;
