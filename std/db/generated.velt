// velt/db (internal): the functions velt/db's readers and binder call whose bodies are generated
// per type at compile time (docs/internals/design/source-generators.md) by velt/db/generate:
// rows of a `RowSource` read by column (rows.velt, columns.velt), and a statement's parameters
// handed to a `ParamSink` value by value (bind.velt). The code they generate calls what is
// imported here.

import { CellKind } from "velt/db/row_source";
import { rowMismatch } from "velt/db/rt";

// Whether `v` is an `i64` exactly (as the JSON reader takes `3.0` for an integer): an integral
// float in [-2^63, 2^63). NaN and the infinities are not.
function rowsExactI64(v: f64): bool {
  return v >= -9223372036854775808.0 && v < 9223372036854775808.0 && (v as i64) as f64 == v;
}

/**
 * Every remaining row of `src` as a `T`, read by column when `T` is an object, struct or class
 * of plain fields (numbers, booleans, strings, `T | null` of those, `u8[]`); `null`, having read
 * nothing, for any other `T` (velt/db then reads the rows' JSON text). A row that does not fit
 * throws `JsonError`; what the source's methods throw passes through (an `Error`).
 */
export declare generated("velt/db/generate/rows") function readRowsByColumn<T, S>(
  src: S,
): T[] | null throws Error;

/** The current row of `src` (`next()` returned true), as `readRowsByColumn` reads each. */
export declare generated("velt/db/generate/rows") function readRowByColumn<T, S>(
  src: S,
): T | null throws Error;

/**
 * Hands `params` to a `ParamSink` value by value; false, having done nothing, for a type that
 * can't be handed over that way. What the sink's methods throw passes through.
 */
export declare generated("velt/db/generate/bind") function writeValues<P, S>(
  sink: S,
  params: P,
): bool throws Error;
