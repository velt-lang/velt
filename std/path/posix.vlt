// velt/path (internal): POSIX path manipulation, pure string code.

// `/`
const SLASH: i64 = 47;

/** The path separator: always "/". */
export const sep = "/";

/** Whether `p` starts at the root (with "/"). */
export function isAbsolute(p: string): bool {
  return p.startsWith("/");
}

/**
 * Resolves "." and ".." segments and collapses repeated slashes; keeps a trailing slash.
 * "" becomes "."; ".." above the root of an absolute path is dropped.
 */
export function normalize(p: string): string {
  if (p.length == 0) {
    return ".";
  }
  const absolute = p.startsWith("/");
  const parts = p.split("/");
  const out: string[] = [];
  for (const part of parts) {
    if (part.length == 0 || part == ".") {
      continue;
    }
    if (part == "..") {
      if (out.length > 0 && out[out.length - 1] != "..") {
        out.pop();
        continue;
      }
      if (absolute) {
        continue;
      }
    }
    out.push(part);
  }
  let body = out.join("/");
  if (body.length == 0) {
    if (absolute) {
      return "/";
    }
    body = ".";
  }
  if (p.endsWith("/")) {
    body = `${body}/`;
  }
  return absolute ? `/${body}` : body;
}

/** Joins the non-empty parts with "/" and normalizes the result ("." if nothing is left). */
export function joinAll(parts: string[]): string {
  const nonEmpty = parts.filter((part) => part.length > 0);
  if (nonEmpty.length == 0) {
    return ".";
  }
  return normalize(nonEmpty.join("/"));
}

/** `join(a, b)`; use `joinAll` for more parts. */
export function join(a: string, b: string): string {
  return joinAll([a, b]);
}

/** Everything before the last segment ("." if there is none; trailing slashes are ignored). */
export function dirname(p: string): string {
  if (p.length == 0) {
    return ".";
  }
  const hasRoot = p.charCodeAt(0) == SLASH;
  let end: i64 = -1;
  let matchedSlash = true;
  for (let i = (p.length as i64) - 1; i >= 1; i--) {
    if (p.charCodeAt(i) == SLASH) {
      if (!matchedSlash) {
        end = i;
        break;
      }
    } else {
      matchedSlash = false;
    }
  }
  if (end == -1) {
    return hasRoot ? "/" : ".";
  }
  if (hasRoot && end == 1) {
    return "//";
  }
  return p.slice(0, end);
}

/**
 * The last segment (trailing slashes ignored), without `suffix` if it ends with it, as Node's
 * `path.posix.basename` has it: a path that is the suffix gives "", a segment that is the
 * suffix stays whole, and a suffix is matched against the segment's characters from its end
 * (Node's algorithm, quirks included: `basename("txt/", ".txt")` is "txt/").
 */
export function basename(p: string, suffix: string = ""): string {
  const n = p.length as i64;
  if (suffix.length > 0 && suffix.length <= p.length) {
    return basenameWithout(p, suffix);
  }
  let start: i64 = 0;
  let end: i64 = -1;
  let matchedSlash = true;
  let i = n - 1;
  while (i >= 0) {
    if (p.charCodeAt(i) == SLASH) {
      if (!matchedSlash) {
        start = i + 1;
        break;
      }
    } else if (end == -1) {
      matchedSlash = false;
      end = i + 1;
    }
    i--;
  }
  return end == -1 ? "" : p.slice(start, end);
}

/** `basename(p, suffix)` for a suffix no longer than `p` (Node's loop, step by step). */
function basenameWithout(p: string, suffix: string): string {
  if (p == suffix) {
    return "";
  }
  const n = p.length as i64;
  let start: i64 = 0;
  let end: i64 = -1;
  let matchedSlash = true;
  let extIdx = (suffix.length as i64) - 1;
  let firstNonSlashEnd: i64 = -1;
  let i = n - 1;
  while (i >= 0) {
    const code = p.charCodeAt(i);
    if (code == SLASH) {
      // A slash before the segment (not one of those at the end) ends it.
      if (!matchedSlash) {
        start = i + 1;
        break;
      }
    } else {
      if (firstNonSlashEnd == -1) {
        matchedSlash = false;
        firstNonSlashEnd = i + 1;
      }
      if (extIdx >= 0) {
        if (code == suffix.charCodeAt(extIdx)) {
          extIdx--;
          if (extIdx == -1) {
            end = i;
          }
        } else {
          // Not the suffix: the whole segment.
          extIdx = -1;
          end = firstNonSlashEnd;
        }
      }
    }
    i--;
  }
  if (start == end) {
    end = firstNonSlashEnd;
  } else if (end == -1) {
    end = n;
  }
  return p.slice(start, end);
}

/**
 * The extension of the last segment, from its last "." ("" if there is none, or if the only
 * dot starts the name, as in ".bashrc" or "..").
 */
export function extname(p: string): string {
  const base = basename(p);
  if (base == "..") {
    return "";
  }
  const dot = base.lastIndexOf(".");
  if (dot <= 0) {
    return "";
  }
  return base.slice(dot);
}
