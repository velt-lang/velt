// std/imports.velt: the standard library's conditional imports, as a package's `imports` field
// (https://veltlang.com/docs/reference/modules/ "Conditional imports"). A std module imports `#name`, and the build's
// conditions pick the file. Paths are relative to std/; each variant is an internal file of the
// module that imports it, and the variants of one name export the same API (`velt check --std`,
// `velt test` and the loader's tests compare them).

import type { Imports } from "velt/package";

export const imports: Imports = {
  // `fetch`'s transport: `send` and the `Fetched` response it resolves with. On JS hosts the
  // host's own `fetch`; elsewhere the Velt HTTP client over velt/net.
  "#http-transport": {
    js: "./net/http/fetch/client/transport/js.velt",
    default: "./net/http/fetch/client/transport/native.velt",
  },
  // The seed of `Math.random()`'s generator: WASI's random_get through wasi-libc, the JS host's
  // crypto.getRandomValues, or elsewhere the operating system's random numbers.
  "#random-seed": {
    wasi: "./lang/random/seed_wasi.velt",
    js: "./lang/random/seed_js.velt",
    default: "./lang/random/seed_native.velt",
  },
  // How a Velt panic under `catchUnwind` is raised and taken (docs/internals/design/unwinding.md):
  // with `_Unwind_RaiseException` where generated code catches it (the Itanium unwinder); on
  // Windows (structured exceptions, not built yet) and WebAssembly nothing is raised and no
  // unwinder function is named.
  "#unwind-raise": {
    win32: "./lang/hooks/unwind_none.velt",
    native: "./lang/hooks/unwind_itanium.velt",
    default: "./lang/hooks/unwind_none.velt",
  },
};
