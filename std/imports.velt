// std/imports.velt: the standard library's conditional imports, as a package's `imports` field
// (https://veltlang.com/docs/reference/modules/ "Conditional imports"). A std module imports `#name`, and the build's
// conditions pick the file. Paths are relative to std/; each variant is an internal file of the
// module that imports it, and the variants of one name export the same API (`velt check --std`,
// `velt test` and the loader's tests compare them).

import type { Imports } from "velt/package";

export const imports: Imports = {
  // `fetch`'s transport: `send` and the `Fetched` response it resolves with. On JS hosts the
  // host's own `fetch`; elsewhere the Velt HTTP client over velt/net.
  "#http-transport": {
    js: "./net/http/fetch/client/transport/js.velt",
    default: "./net/http/fetch/client/transport/native.velt",
  },
  // The seed of `Math.random()`'s generator: WASI's random_get through wasi-libc, the JS host's
  // crypto.getRandomValues, or elsewhere the operating system's random numbers.
  "#random-seed": {
    wasi: "./lang/random/seed_wasi.velt",
    js: "./lang/random/seed_js.velt",
    default: "./lang/random/seed_native.velt",
  },
  // Where the calling thread's C `errno` is (velt/ffi's `errno` and `setErrno`): each C library
  // gives its address through a function of its own; a target without one has none.
  "#errno-location": {
    darwin: "./ffi/errno_darwin.velt",
    linux: "./ffi/errno_linux.velt",
    win32: "./ffi/errno_windows.velt",
    default: "./ffi/errno_none.velt",
  },
  // How a Velt panic under `catchUnwind` is raised and taken (docs/internals/design/unwinding.md):
  // with `_Unwind_RaiseException` where generated code catches it (the Itanium unwinder); on
  // Windows (structured exceptions, not built yet) and WebAssembly nothing is raised and no
  // unwinder function is named.
  "#unwind-raise": {
    win32: "./lang/hooks/unwind_none.velt",
    native: "./lang/hooks/unwind_itanium.velt",
    default: "./lang/hooks/unwind_none.velt",
  },
  // The reactor of the executor in Velt (std/lang/hooks/sched_io.velt): what the worker waits in
  // while it has nothing to run (sockets' readiness and wakes from other threads): kqueue on
  // macOS, epoll and an eventfd on Linux, `\Device\Afd` polls over an I/O completion port on
  // Windows; elsewhere no sockets and a spinning wait.
  "#reactor": {
    darwin: "./lang/hooks/reactor_kqueue.velt",
    linux: "./lang/hooks/reactor_epoll.velt",
    win32: "./lang/hooks/reactor_afd.velt",
    default: "./lang/hooks/reactor_none.velt",
  },
  // The two OS calls the executor in Velt's core makes whatever its reactor (std/lang/hooks/
  // sched_mem.velt, sched_io_wait.velt): `sched_yield` and `clock_gettime`, or on Windows
  // `SwitchToThread` and the performance counter.
  "#sched-os": { win32: "./lang/hooks/os_win32.velt", default: "./lang/hooks/os_posix.velt" },
  // The layout of `sigaction` for the executor in Velt's signals (std/lang/hooks/
  // sched_signal.velt): per OS; elsewhere none.
  "#sched-signal": {
    darwin: "./lang/hooks/signal_darwin.velt",
    linux: "./lang/hooks/signal_linux.velt",
    default: "./lang/hooks/signal_none.velt",
  },
  // The threads of the executor in Velt's workers (std/lang/hooks/sched.velt): `pthread_create`
  // on macOS and Linux, `CreateThread` on Windows; elsewhere none (one worker).
  "#sched-thread": {
    darwin: "./lang/hooks/thread_posix.velt",
    linux: "./lang/hooks/thread_posix.velt",
    win32: "./lang/hooks/thread_win32.velt",
    default: "./lang/hooks/thread_none.velt",
  },
  // velt/net's TCP functions: the runtime's (std/net/rt.velt), or, compiled with the executor in
  // Velt (`VELT_SCHEDULER=std`, the `std-scheduler` condition), non-blocking sockets on its
  // reactor (std/net/tcp_sched.velt), which hands the runtime's handles (TLS, `fetch`'s pool) and
  // an OS without a reactor back to the runtime.
  "#net-sys": {
    darwin: "./net/sys_darwin.velt",
    linux: "./net/sys_linux.velt",
    win32: "./net/sys_win32.velt",
    default: "./net/sys_none.velt",
  },
  // velt/sync's channel (std/sync/channel_block.velt): how its waits read a poll's `cx` and a
  // waker's table, and the C functions of their heap futures, by the size of a pointer
  // (WebAssembly's take 4 bytes).
  "#sync-chan-word": {
    wasi: "./sync/channel_word_wasm.velt",
    js: "./sync/channel_word_wasm.velt",
    default: "./sync/channel_word.velt",
  },
  // velt/sync's hand-offs (std/sync/output.velt): what the thread printed, published through the
  // runtime's latch; nothing to publish on WebAssembly's one thread.
  "#sync-output": {
    wasi: "./sync/output_wasm.velt",
    js: "./sync/output_wasm.velt",
    default: "./sync/output.velt",
  },
  "#sync-chan-entry": {
    wasi: "./sync/channel_entry_wasm.velt",
    js: "./sync/channel_entry_wasm.velt",
    default: "./sync/channel_entry.velt",
  },
  "#net-tcp": { "std-scheduler": "./net/tcp_sched.velt", default: "./net/rt.velt" },
  // The C library's socket functions those sockets call (std/net/fd_socket.velt, fd_io.velt,
  // fd_addr.velt, std/lang/hooks/sched_io_write.velt), or Winsock's under the same names.
  "#net-calls": { win32: "./net/calls_win32.velt", default: "./net/calls_posix.velt" },
  // velt/net's UDP sockets and name lookups: the runtime's, or, compiled with the executor in
  // Velt, non-blocking UDP sockets on its reactor and `getaddrinfo` on its blocking pool.
  // On Windows UDP stays the runtime's under it too (#2649: its Winsock port is a follow-up).
  "#net-udp": {
    win32: "./net/udp/rt.velt",
    "std-scheduler": "./net/udp/udp_sched.velt",
    default: "./net/udp/rt.velt",
  },
  "#net-dns": { "std-scheduler": "./net/dns/rt_sched.velt", default: "./net/dns/rt.velt" },
  // velt/fs's and velt/process's runtime functions: the runtime's (std/fs/rt.velt, std/process/
  // rt.velt), or, compiled with the executor in Velt (`VELT_SCHEDULER=std`), the same names with
  // whole-file operations and standard input read on its blocking pool (std/lang/hooks/
  // sched_blocking.velt) instead of the runtime's leaves on tokio's blocking threads.
  "#fs-rt": { "std-scheduler": "./fs/rt_sched.velt", default: "./fs/rt.velt" },
  "#process-rt": { "std-scheduler": "./process/rt_sched.velt", default: "./process/rt.velt" },
  // velt/process/child's runtime functions: the runtime's (tokio's processes), or, compiled with
  // the executor in Velt, `posix_spawn` with the exit and the pipes on its reactor. On Windows
  // child processes stay the runtime's under it too (#2649: `CreateProcess` is a follow-up).
  "#child-rt": {
    win32: "./process/child/rt.velt",
    "std-scheduler": "./process/child/child_sched.velt",
    default: "./process/child/rt.velt",
  },
  // velt/task's `workerCount()` and `currentWorker()`: the runtime's executor's workers, or
  // under the executor in Velt (`VELT_SCHEDULER=std`) its own.
  // velt/task's `catchPanic` catch: the runtime's (velt_rt_catch_*), or under the executor in
  // Velt (`VELT_SCHEDULER=std`) its own, with `catchUnwind` (std/task/catch_sched.velt).
  "#task-catch": { "std-scheduler": "./task/catch_sched.velt", default: "./task/catch_rt.velt" },
  "#task-workers": {
    "std-scheduler": "./task/worker_index_sched.velt",
    default: "./task/worker_index.velt",
  },
};
