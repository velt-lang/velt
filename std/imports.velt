// std/imports.velt: the standard library's conditional imports, as a package's `imports` field
// (https://veltlang.com/docs/reference/modules/ "Conditional imports"). A std module imports `#name`, and the build's
// conditions pick the file. Paths are relative to std/; each variant is an internal file of the
// module that imports it, and the variants of one name export the same API (`velt check --std`,
// `velt test` and the loader's tests compare them).

import type { Imports } from "velt/package";

export const imports: Imports = {
  // `fetch`'s transport: `send` and the `Fetched` response it resolves with. On JS hosts the
  // host's own `fetch`; elsewhere the Velt HTTP client over velt/net.
  "#http-transport": {
    js: "./net/http/fetch/client/transport/js.velt",
    default: "./net/http/fetch/client/transport/native.velt",
  },
  // The operating system's random numbers (std/lang/random/os.velt: velt/crypto's, UUIDs' and the
  // seed of `Math.random()`'s generator): `getrandom` on Linux, `getentropy` on macOS,
  // `BCryptGenRandom` on Windows, WASI's random_get through wasi-libc, the JS host's
  // crypto.getRandomValues. No default: a target without one fails here, at compile time.
  "#os-random": {
    darwin: "./lang/random/os_darwin.velt",
    linux: "./lang/random/os_linux.velt",
    win32: "./lang/random/os_win32.velt",
    wasi: "./lang/random/os_wasi.velt",
    js: "./lang/random/os_js.velt",
  },
  // Where the calling thread's C `errno` is (velt/ffi's `errno` and `setErrno`): each C library
  // gives its address through a function of its own; a target without one has none.
  "#errno-location": {
    darwin: "./ffi/errno_darwin.velt",
    linux: "./ffi/errno_linux.velt",
    win32: "./ffi/errno_windows.velt",
    wasi: "./ffi/errno_wasi.velt",
    default: "./ffi/errno_none.velt",
  },
  // How a Velt panic under `catchUnwind` is raised and taken (docs/internals/design/unwinding.md):
  // with `_Unwind_RaiseException` where generated code catches it (the Itanium unwinder), with
  // `RaiseException` on Windows (structured exceptions); on WebAssembly nothing is raised and no
  // unwinder function is named.
  "#unwind-raise": {
    win32: "./lang/hooks/unwind_seh.velt",
    native: "./lang/hooks/unwind_itanium.velt",
    default: "./lang/hooks/unwind_none.velt",
  },
  // The reactor of the executor in Velt (std/lang/hooks/sched_io.velt): what the worker waits in
  // while it has nothing to run (sockets' readiness and wakes from other threads): kqueue on
  // macOS, epoll and an eventfd on Linux, `\Device\Afd` polls over an I/O completion port on
  // Windows; elsewhere no sockets and a spinning wait.
  "#reactor": {
    darwin: "./lang/hooks/reactor_kqueue.velt",
    linux: "./lang/hooks/reactor_epoll.velt",
    win32: "./lang/hooks/reactor_afd.velt",
    default: "./lang/hooks/reactor_none.velt",
  },
  // The two OS calls the executor in Velt's core makes whatever its reactor (std/lang/hooks/
  // sched_mem.velt, sched_io_wait.velt): `sched_yield` and `clock_gettime`, or on Windows
  // `SwitchToThread` and the performance counter.
  "#sched-os": { win32: "./lang/hooks/os_win32.velt", default: "./lang/hooks/os_posix.velt" },
  // The memory of the symbol records made at run time: `Symbol.for`'s one at a time
  // (std/lang/symbol/registry.velt) and `Symbol()`'s in 4 KiB chunks (record.velt). The C
  // library's where there is one, the compiled code's allocator (not zeroed) in the browser.
  "#symbol-record": {
    js: "./lang/symbol/record_mem_js.velt",
    default: "./lang/symbol/record_mem.velt",
  },
  // The clocks of `Date.now()` and `performance.now()` (std/lang/hooks/clock.velt): the C
  // library's `clock_gettime` on macOS and Linux, the performance counter and the precise system
  // time on Windows, WASI's `clock_time_get`, a JS host's own. No default: a target without one
  // fails here, at compile time.
  "#clock": {
    darwin: "./lang/hooks/clock_darwin.velt",
    linux: "./lang/hooks/clock_linux.velt",
    win32: "./lang/hooks/clock_win32.velt",
    wasi: "./lang/hooks/clock_wasi.velt",
    js: "./lang/hooks/clock_js.velt",
  },
  // The C library calls of the weak core (std/lang/hooks/weak_mem.velt), apart from the
  // executor's so a program without tasks loads none of it: memory, and `sched_yield` or on
  // Windows `SwitchToThread` while its lock is contended.
  "#weak-os": {
    win32: "./lang/hooks/weak_os_win32.velt",
    default: "./lang/hooks/weak_os_posix.velt",
  },
  // The layout of `sigaction` for the executor in Velt's signals (std/lang/hooks/
  // sched_signal.velt): per OS; elsewhere none.
  "#sched-signal": {
    darwin: "./lang/hooks/signal_darwin.velt",
    linux: "./lang/hooks/signal_linux.velt",
    default: "./lang/hooks/signal_none.velt",
  },
  // The line a bus error from a cut-short mapped file gets (std/fs/mapped_posix.velt): a signal
  // handler on macOS and Linux; elsewhere nothing (no mapping, and no C to link).
  "#mapped-fault": {
    darwin: "./fs/mapped_fault_posix.velt",
    linux: "./fs/mapped_fault_posix.velt",
    default: "./fs/mapped_fault_none.velt",
  },
  // The threads of the executor in Velt's workers (std/lang/hooks/sched.velt): `pthread_create`
  // on macOS and Linux, `CreateThread` on Windows; elsewhere none (one worker).
  "#sched-thread": {
    darwin: "./lang/hooks/thread_posix.velt",
    linux: "./lang/hooks/thread_posix.velt",
    win32: "./lang/hooks/thread_win32.velt",
    default: "./lang/hooks/thread_none.velt",
  },
  // What starting a child differs in between macOS and Linux (std/process/child/spawn_posix.velt,
  // which only those load): `posix_spawn_file_actions_addopen`'s `mode_t`, `poll`'s `nfds_t`,
  // `errno` and the pipes' calls, `PATH_MAX`, the default `PATH`, and Node's lookup rules.
  "#spawn-open": {
    darwin: "./process/child/spawn_open_darwin.velt",
    default: "./process/child/spawn_open_linux.velt",
  },
  // Whether a child that is a script without a `#!` line (ENOEXEC) runs through `/bin/sh`, as Node
  // runs it on Linux with glibc (its `execvp`; musl's has no such rule, and Velt has no musl
  // condition), not on macOS (libuv's `posix_spawn`): spawn_posix.velt, which starts the children
  // of `spawn`, `exec` and `execSync`.
  "#script-shell": {
    linux: "./process/child/script_shell_linux.velt",
    default: "./process/child/script_shell_none.velt",
  },
  // Whether `Promise.race`'s race settles a microtask after its deciding input, as Node does
  // (std/lang/promise/settle.velt, for `Promise.any`): the executor in Velt's does
  // (std/lang/hooks/sched_race.velt), the runtime's (WebAssembly) does not.
  "#promise-race-step": {
    "std-scheduler": "./lang/promise/race_step_sched.velt",
    default: "./lang/promise/race_step_rt.velt",
  },
  // velt/net's TCP functions: the runtime's (std/net/rt.velt), or, compiled with the executor in
  // Velt (`VELT_SCHEDULER=std`, the `std-scheduler` condition), non-blocking sockets on its
  // reactor (std/net/tcp_sched.velt), which hands the runtime's handles (TLS, `fetch`'s pool) and
  // an OS without a reactor back to the runtime.
  "#net-sys": {
    darwin: "./net/sys_darwin.velt",
    linux: "./net/sys_linux.velt",
    win32: "./net/sys_win32.velt",
    default: "./net/sys_none.velt",
  },
  // velt/sync's channel (std/sync/channel_block.velt): how its waits read a poll's `cx` and a
  // waker's table, and the C functions of their heap futures, by the size of a pointer
  // (WebAssembly's take 4 bytes).
  "#sync-chan-word": {
    wasi: "./sync/channel_word_wasm.velt",
    js: "./sync/channel_word_wasm.velt",
    default: "./sync/channel_word.velt",
  },
  // velt/sync's hand-offs (std/sync/output.velt): what the thread printed, published through the
  // runtime's latch; nothing to publish on WebAssembly's one thread.
  // velt/lang/bytes's raw moves and zeroing (std/lang/bytes/raw.velt): the C library's `memmove`
  // and `memset`, or a Velt loop on the JS host, which has no C library.
  "#bytes-move": { js: "./lang/bytes/move_js.velt", default: "./lang/bytes/move_c.velt" },
  // velt/lang/bytes's largest allocation (std/lang/bytes/raw.velt): a 32-bit target's on
  // WebAssembly, none natively.
  "#bytes-limit": {
    wasi: "./lang/bytes/limit_wasm.velt",
    js: "./lang/bytes/limit_wasm.velt",
    default: "./lang/bytes/limit_native.velt",
  },
  "#sync-output": {
    wasi: "./sync/output_wasm.velt",
    js: "./sync/output_wasm.velt",
    default: "./sync/output.velt",
  },
  "#sync-chan-entry": {
    wasi: "./sync/channel_entry_wasm.velt",
    js: "./sync/channel_entry_wasm.velt",
    default: "./sync/channel_entry.velt",
  },
  "#net-tcp": { "std-scheduler": "./net/tcp_sched.velt", default: "./net/rt.velt" },
  // The C library's socket functions those sockets call (std/net/fd_socket.velt, fd_io.velt,
  // fd_addr.velt, std/lang/hooks/sched_io_write.velt), or Winsock's under the same names.
  "#net-calls": { win32: "./net/calls_win32.velt", default: "./net/calls_posix.velt" },
  // `streamPair`'s two connected sockets (std/net/pair.velt): a `socketpair`, or on Windows,
  // which has none, a loopback connection.
  "#net-pair": { win32: "./net/pair_win32.velt", default: "./net/pair_posix.velt" },
  // `streamPair`'s ends (std/net/pair.velt): with the executor in Velt (every native build) those
  // sockets on its reactor; elsewhere (WebAssembly) none, a panic.
  "#net-pair-ends": { "std-scheduler": "./net/pair_sched.velt", default: "./net/pair_none.velt" },
  // velt/net's UDP sockets and name lookups: with the executor in Velt (every native build),
  // non-blocking UDP sockets on its reactor and `getaddrinfo` on its blocking pool; elsewhere
  // (WebAssembly) none, `ENOTSUP`.
  "#net-udp": { "std-scheduler": "./net/udp/udp_sched.velt", default: "./net/udp/rt.velt" },
  "#net-dns": { "std-scheduler": "./net/dns/rt_sched.velt", default: "./net/dns/rt.velt" },
  // velt/fs's and velt/process's runtime functions: the runtime's (std/fs/rt.velt, std/process/
  // rt.velt), or, compiled with the executor in Velt (`VELT_SCHEDULER=std`), the same names with
  // whole-file operations and standard input read on its blocking pool (std/lang/hooks/
  // sched_blocking.velt) instead of the runtime's leaves on tokio's blocking threads.
  "#fs-rt": { "std-scheduler": "./fs/rt_sched.velt", default: "./fs/rt.velt" },
  // `readAt`'s read off the calling task's thread: on the executor's blocking pool in a native
  // program; on the calling thread elsewhere, where there are no file descriptors to read.
  "#fs-read-at": {
    "std-scheduler": "./fs/fd/read_at_sched.velt",
    default: "./fs/fd/read_at_inline.velt",
  },
  "#process-rt": { "std-scheduler": "./process/rt_sched.velt", default: "./process/rt.velt" },
  // A thread lock on an 8-byte word (standard input's buffer): std's inline one on native
  // targets, the runtime's elsewhere (wasm's runtime keeps its own `Mutex` lock).
  "#thread-lock": { native: "./lang/hooks/mutex.velt", default: "./process/thread_lock_rt.velt" },
  // Reading standard input (std/process/stdin_buffer.velt's refills): `read` on fd 0 on macOS,
  // Linux and WASI (wasi-libc's), the console's or a pipe's own read on Windows, none under a JS
  // host.
  "#stdin-sys": {
    win32: "./process/stdin_win32.velt",
    native: "./process/stdin_posix.velt",
    wasi: "./process/stdin_posix.velt",
    default: "./process/stdin_none.velt",
  },
  // velt/process/child's runtime functions: the runtime's (std/process/child/rt.velt, which
  // WebAssembly can't run), or, compiled with the executor in Velt, its own (child_sched.velt),
  // which `#child-os` serves: `posix_spawn` with the exit and the pipes on its reactor, or on
  // Windows `CreateProcessW` with the exit wait and the pipes on its blocking pool.
  "#child-rt": {
    "std-scheduler": "./process/child/child_sched.velt",
    default: "./process/child/rt.velt",
  },
  "#child-os": {
    win32: "./process/child/child_win32.velt",
    default: "./process/child/child_posix.velt",
  },
  // `execSync`'s start: on macOS and Linux std's (`posix_spawn`, as `spawn` and `exec` start
  // theirs, and a `poll` loop on the pipes, without the executor); on Windows the runtime's,
  // after the program is found and checked as `exec` does it; elsewhere (WebAssembly) the
  // runtime's alone.
  "#exec-sync": {
    darwin: "./process/child/exec_sync_posix.velt",
    linux: "./process/child/exec_sync_posix.velt",
    win32: "./process/child/exec_sync_win32.velt",
    default: "./process/child/exec_sync.velt",
  },
  // `fetch`'s plain-TCP connections: under the executor in Velt (every native build) sockets on
  // its reactor, pooled in Velt (`https:` stays the runtime's); otherwise the runtime's.
  "#fetch-dial": {
    "std-scheduler": "./net/http/fetch/client/dial_sched.velt",
    default: "./net/http/fetch/client/dial_rt.velt",
  },
  // velt/task's `workerCount()` and `currentWorker()`: the runtime's executor's workers, or
  // under the executor in Velt (`VELT_SCHEDULER=std`) its own.
  // velt/task's `catchPanic` catch: the runtime's (velt_rt_catch_*), or under the executor in
  // Velt (`VELT_SCHEDULER=std`) its own, with `catchUnwind` (std/task/catch_sched.velt).
  "#task-catch": { "std-scheduler": "./task/catch_sched.velt", default: "./task/catch_rt.velt" },
  "#task-workers": {
    "std-scheduler": "./task/worker_index_sched.velt",
    default: "./task/worker_index.velt",
  },
  // The limb loops of `BigInt`'s magnitudes (std/math/nat_add.velt): on the limbs' addresses,
  // which the C library's `memset` gives; JS hosts have none, and index the arrays.
  "#nat-rows": { js: "./math/nat_rows_checked.velt", default: "./math/nat_rows_raw.velt" },
  // The limb loops of `Mont` (std/crypto/mont.velt, RSA's arithmetic): on the limbs' addresses
  // as `#nat-rows`, or on JS hosts on the arrays.
  "#mont-rows": { js: "./crypto/mont_rows_checked.velt", default: "./crypto/mont_rows_raw.velt" },
  // The C library's file-descriptor functions behind Node's fd API (`openSync`, `readSync`, ...):
  // `declare c("c")` on macOS and Linux, with their per-target `fcntl` commands and `struct
  // stat`; elsewhere each fails with ENOSYS.
  "#fd-system": {
    darwin: "./fs/fd/darwin.velt",
    linux: "./fs/fd/linux.velt",
    default: "./fs/fd/unsupported.velt",
  },
  // Whole files (`readFile`, `writeFile`, `appendFile`, `stat`, `lstat`, `exists`) in a native
  // build: the C library's file descriptors (`#fd-system`), or Win32's on Windows.
  "#fs-whole": { win32: "./fs/whole/win32.velt", default: "./fs/whole/posix.velt" },
  // The path `openRead` and `openWrite` hand the runtime, and their errors: Node's resolved
  // path on Windows (std/fs/whole/win_path.velt), the path as given elsewhere.
  "#fs-stream-path": { win32: "./fs/whole/win_stream_path.velt", default: "./fs/stream_path.velt" },
  // What a `MappedFile` is made of (velt/fs): a mapping of the file (`mmap` through
  // `#fd-system`, Win32's file mappings on Windows), the file read into memory on WebAssembly.
  "#mapped-source": {
    win32: "./fs/mapped_win32.velt",
    wasi: "./fs/mapped_buffer.velt",
    js: "./fs/mapped_buffer.velt",
    default: "./fs/mapped_posix.velt",
  },
  // Directories (`readDir`, `readDirEntries`, `mkdir`, `remove`) in a native build: the C
  // library's directory functions (`#fd-system`), or Win32's on Windows.
  "#fs-tree": { win32: "./fs/tree/win32.velt", default: "./fs/tree/posix.velt" },
  // Renaming, linking and copying (`rename`, `copyFile`, `symlink`, `readlink`, `realpath`): the
  // C library's on macOS and Linux (each with its own data copy), Win32's on Windows,
  // wasi-libc's under WASI, and none under a JS host (each fails with `ENOTSUP`).
  "#fs-paths": {
    win32: "./fs/paths/win32.velt",
    darwin: "./fs/paths/darwin.velt",
    wasi: "./fs/paths/wasi.velt",
    js: "./fs/paths/js.velt",
    default: "./fs/paths/linux.velt",
  },
  // `fs.constants`: Node's keys and values on each OS (std/fs/constants/), Linux's for any other
  // build (WebAssembly).
  "#fs-constants": {
    win32: "./fs/constants/win32.velt",
    darwin: "./fs/constants/darwin.velt",
    default: "./fs/constants/linux.velt",
  },
  // This process's id (`process.pid`): the C library's `getpid` on macOS and Linux, Win32's
  // `GetCurrentProcessId` on Windows, 1 elsewhere. Modules that import nothing: the hook module
  // of the builtin `process`, which every program loads, imports the variant.
  "#process-pid": {
    darwin: "./lang/hooks/pid_posix.velt",
    linux: "./lang/hooks/pid_posix.velt",
    win32: "./lang/hooks/pid_win32.velt",
    default: "./lang/hooks/pid_none.velt",
  },
  // velt/os's facts about the machine (`platform`, `availableParallelism`, `hostname`, `tmpdir`):
  // the C library's on macOS and Linux, Win32's and Winsock's on Windows; a WebAssembly build's
  // fixed answers elsewhere.
  "#os-sys": {
    darwin: "./os/sys_darwin.velt",
    linux: "./os/sys_linux.velt",
    win32: "./os/sys_win32.velt",
    default: "./os/sys_wasm.velt",
  },
  // The build's processor (`os.arch()`, and the Linux system-call numbers that differ by it).
  // No default: a native build for another processor fails here, at compile time, rather than
  // running with x64's or WebAssembly's answers.
  "#os-arch": {
    x64: "./os/arch_x64.velt",
    arm64: "./os/arch_arm64.velt",
    wasm: "./os/arch_wasm.velt",
  },
  // Whether every build for the processor has an FMA instruction (arm64), so `pow` uses its
  // copy with `fma` without a check (std/lang/math/pow.velt).
  "#math-fma": {
    arm64: "./lang/math/fma_arm64.velt",
    default: "./lang/math/fma_check_needed.velt",
  },
  // The arm64 features of this CPU (std/lang/cpu, read by `cpuStart` at start-up): the kernel's
  // capability words on Linux, sysctls on macOS, `IsProcessorFeaturePresent` on Windows; none
  // elsewhere, where std has no way to ask.
  // The start-up check of the CPU's features (std/lang/hooks/cpu.velt): CPUID on x86-64, the
  // operating system's answer on arm64 (`#cpu-arm`), nothing on WebAssembly.
  "#cpu-start": {
    x64: "./lang/cpu/start_x64.velt",
    arm64: "./lang/cpu/start_arm64.velt",
    wasm: "./lang/cpu/start_none.velt",
  },
  "#cpu-arm": {
    darwin: "./lang/cpu/arm_darwin.velt",
    linux: "./lang/cpu/arm_linux.velt",
    win32: "./lang/cpu/arm_win32.velt",
    default: "./lang/cpu/arm_none.velt",
  },
  // The environment's variables: the C library's on macOS and Linux (each with its own way to
  // `environ`), Win32's on Windows, the WebAssembly runtime's there. Nothing in them throws: the
  // executor reads variables.
  "#env-sys": {
    darwin: "./process/env_darwin.velt",
    linux: "./process/env_linux.velt",
    win32: "./process/env_win32.velt",
    default: "./process/env_wasm.velt",
  },
  // The working directory (`cwd`, `chdir`), apart from the variables: it throws `IoError`.
  "#cwd-sys": {
    win32: "./process/cwd_win32.velt",
    native: "./process/cwd_posix.velt",
    default: "./process/cwd_wasm.velt",
  },
  // Winsock for velt/os' `hostname()` on Windows, started once per process; nothing elsewhere.
  "#os-winsock": { win32: "./os/winsock_win32.velt", default: "./os/winsock_none.velt" },
  // `process.memoryUsage()`'s two figures (std/prelude/process.velt): `/proc/self/statm` on
  // Linux, `task_info` on macOS, kernel32's process counters on Windows, the WebAssembly
  // runtime's answer there.
  "#memory-sys": {
    darwin: "./process/memory_darwin.velt",
    linux: "./process/memory_linux.velt",
    win32: "./process/memory_win32.velt",
    default: "./process/memory_wasm.velt",
  },
  // Whether a file descriptor is a terminal: the C library's `isatty` on macOS and Linux, a
  // console handle on Windows, the WebAssembly runtime's answer there.
  "#tty": {
    win32: "./process/tty_win32.velt",
    native: "./process/tty_posix.velt",
    default: "./process/tty_wasm.velt",
  },
  // The local time zone's offset (`Date`'s local getters, `velt/time`'s `localParts()`): the C
  // library's `localtime_r` on macOS and Linux, Win32's time-zone functions on Windows, UTC on
  // WebAssembly.
  "#localtime": {
    win32: "./time/localtime_win32.velt",
    native: "./time/localtime_posix.velt",
    default: "./time/localtime_none.velt",
  },
  // The zone local time is in, by its id, for `Date`'s zone name (std/time/zone_name.velt):
  // `TZ` or `/etc/localtime`'s link on macOS and Linux, `TZ`'s fixed offsets or the system
  // zone's registry key on Windows, UTC on WebAssembly.
  "#zone-id": {
    win32: "./time/zone_id_win32.velt",
    native: "./time/zone_id_posix.velt",
    default: "./time/zone_id_none.velt",
  },
  // `O_CLOEXEC` for zone_id_posix.velt's `open`, which differs between macOS and Linux (without
  // velt/os, which a program printing a date need not load).
  "#zone-cloexec": {
    darwin: "./time/zone_cloexec_darwin.velt",
    default: "./time/zone_cloexec_linux.velt",
  },
};
