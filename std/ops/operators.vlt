// velt/ops (internal): the interfaces of the operator methods. Programs import them from
// `velt/ops`.
//
// `a + b` on a class, struct or vector calls its method `[Symbol.add](other)` (design
// operators.md). A type with the method implements the interface without an `implements`
// clause, so generic code bounded by one (`T extends Mul<T>`) can use the operator.
//
// Generated by scripts/gen-ops.py: change the script, not this file.

/** A type with `a + b` (addition) for a right operand of type `R`, giving an `O`. */
export interface Add<R, O = R> {
  /** `this + other`. */
  [Symbol.add](other: R): O;
}

/** A type with `a - b` (subtraction) for a right operand of type `R`, giving an `O`. */
export interface Sub<R, O = R> {
  /** `this - other`. */
  [Symbol.sub](other: R): O;
}

/** A type with `a * b` (multiplication) for a right operand of type `R`, giving an `O`. */
export interface Mul<R, O = R> {
  /** `this * other`. */
  [Symbol.mul](other: R): O;
}

/** A type with `a / b` (division) for a right operand of type `R`, giving an `O`. */
export interface Div<R, O = R> {
  /** `this / other`. */
  [Symbol.div](other: R): O;
}

/** A type with `a % b` (remainder) for a right operand of type `R`, giving an `O`. */
export interface Rem<R, O = R> {
  /** `this % other`. */
  [Symbol.rem](other: R): O;
}

/** A type with `a ** b` (exponentiation) for a right operand of type `R`, giving an `O`. */
export interface Pow<R, O = R> {
  /** `this ** other`. */
  [Symbol.pow](other: R): O;
}

/** A type with `a & b` (bitwise and) for a right operand of type `R`, giving an `O`. */
export interface BitAnd<R, O = R> {
  /** `this & other`. */
  [Symbol.bitAnd](other: R): O;
}

/** A type with `a | b` (bitwise or) for a right operand of type `R`, giving an `O`. */
export interface BitOr<R, O = R> {
  /** `this | other`. */
  [Symbol.bitOr](other: R): O;
}

/** A type with `a ^ b` (bitwise exclusive or) for a right operand of type `R`, giving an `O`. */
export interface BitXor<R, O = R> {
  /** `this ^ other`. */
  [Symbol.bitXor](other: R): O;
}

/** A type with `a << b` (left shift) for a right operand of type `R`, giving an `O`. */
export interface Shl<R, O = R> {
  /** `this << other`. */
  [Symbol.shl](other: R): O;
}

/** A type with `a >> b` (right shift) for a right operand of type `R`, giving an `O`. */
export interface Shr<R, O = R> {
  /** `this >> other`. */
  [Symbol.shr](other: R): O;
}

/** A type with `a >>> b` (unsigned right shift) for a right operand of type `R`, giving an `O`. */
export interface UShr<R, O = R> {
  /** `this >>> other`. */
  [Symbol.ushr](other: R): O;
}

/** A type with `-a` (negation), giving an `O`. */
export interface Neg<O> {
  /** `-this`. */
  [Symbol.neg](): O;
}

/** A type with `~a` (bitwise not), giving an `O`. */
export interface BitNot<O> {
  /** `~this`. */
  [Symbol.bitNot](): O;
}

/** A type with `a += b` that changes `a` in place, for a right operand of type `R`. */
export interface AddAssign<R> {
  /** `this += other`, changing `this`. */
  [Symbol.addAssign](other: R): void;
}

/** A type with `a -= b` that changes `a` in place, for a right operand of type `R`. */
export interface SubAssign<R> {
  /** `this -= other`, changing `this`. */
  [Symbol.subAssign](other: R): void;
}

/** A type with `a *= b` that changes `a` in place, for a right operand of type `R`. */
export interface MulAssign<R> {
  /** `this *= other`, changing `this`. */
  [Symbol.mulAssign](other: R): void;
}

/** A type with `a /= b` that changes `a` in place, for a right operand of type `R`. */
export interface DivAssign<R> {
  /** `this /= other`, changing `this`. */
  [Symbol.divAssign](other: R): void;
}

/** A type with `a %= b` that changes `a` in place, for a right operand of type `R`. */
export interface RemAssign<R> {
  /** `this %= other`, changing `this`. */
  [Symbol.remAssign](other: R): void;
}

/** A type with `a **= b` that changes `a` in place, for a right operand of type `R`. */
export interface PowAssign<R> {
  /** `this **= other`, changing `this`. */
  [Symbol.powAssign](other: R): void;
}

/** A type with `a &= b` that changes `a` in place, for a right operand of type `R`. */
export interface BitAndAssign<R> {
  /** `this &= other`, changing `this`. */
  [Symbol.bitAndAssign](other: R): void;
}

/** A type with `a |= b` that changes `a` in place, for a right operand of type `R`. */
export interface BitOrAssign<R> {
  /** `this |= other`, changing `this`. */
  [Symbol.bitOrAssign](other: R): void;
}

/** A type with `a ^= b` that changes `a` in place, for a right operand of type `R`. */
export interface BitXorAssign<R> {
  /** `this ^= other`, changing `this`. */
  [Symbol.bitXorAssign](other: R): void;
}

/** A type with `a <<= b` that changes `a` in place, for a right operand of type `R`. */
export interface ShlAssign<R> {
  /** `this <<= other`, changing `this`. */
  [Symbol.shlAssign](other: R): void;
}

/** A type with `a >>= b` that changes `a` in place, for a right operand of type `R`. */
export interface ShrAssign<R> {
  /** `this >>= other`, changing `this`. */
  [Symbol.shrAssign](other: R): void;
}

/** A type with `a >>>= b` that changes `a` in place, for a right operand of type `R`. */
export interface UShrAssign<R> {
  /** `this >>>= other`, changing `this`. */
  [Symbol.ushrAssign](other: R): void;
}

/** A type with `a[i]` for an index of type `K`, giving a `V`. */
export interface Index<K, V> {
  /** The element at `i`. */
  [Symbol.index](i: K): V;
}

/** A type with `a[i] = v` for an index of type `K` and a value of type `V`. */
export interface SetIndex<K, V> {
  /** Sets the element at `i` to `v`. */
  [Symbol.setIndex](i: K, v: V): void;
}

/**
 * The arithmetic of a number-like type: `+`, `-`, `*`, `/` and unary `-`, each giving a `T`.
 * Every number type, `velt/math`'s `BigInt` and the float vectors of `velt/simd` have it.
 */
export interface Arithmetic<T> extends Add<T>, Sub<T>, Mul<T>, Div<T>, Neg<T> {}
