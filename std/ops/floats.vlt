// velt/ops (internal): the operator methods of the float types and `string`, so that generic code bounded
// by `velt/ops`' interfaces runs on them. Each is the built-in operator itself, which
// generic code compiles to after inlining.
//
// Generated by scripts/gen-ops.py: change the script, not this file.

extend f32 {
  /** `this + other`. */
  [Symbol.add](other: f32): f32 {
    return this + other;
  }
  /** `this - other`. */
  [Symbol.sub](other: f32): f32 {
    return this - other;
  }
  /** `this * other`. */
  [Symbol.mul](other: f32): f32 {
    return this * other;
  }
  /** `this / other`. */
  [Symbol.div](other: f32): f32 {
    return this / other;
  }
  /** `this % other`. */
  [Symbol.rem](other: f32): f32 {
    return this % other;
  }
  /** `this ** other`. */
  [Symbol.pow](other: f32): f32 {
    return this ** other;
  }
  /** `-this`. */
  [Symbol.neg](): f32 {
    return -this;
  }
}

