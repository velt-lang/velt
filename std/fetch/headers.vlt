// std/fetch/headers: the WHATWG `Headers` class of `fetch` (docs/std/fetch.md), also the type
// of a server request's `headers` (std/http.vlt).
//
// One flat list, `[name, value, name, value, …]`, in insertion order: names are lowercased when
// they are added (header names are case-insensitive), values have surrounding whitespace
// removed. The list is the runtime's format too, so a fetched response's headers arrive as one
// array without being copied again. Lookups scan the list: a message has a handful of headers,
// for which a scan beats hashing. A server request's headers stay in the runtime until
// something needs all of them: `get` and `has` look one name up there. The headers of a
// response made here start with the `content-type` its body implies held as a number
// (`implied`), which a server hands to the runtime as it is; it becomes the list's first entry
// when something reads or changes `content-type` or needs the whole list. The first header
// added to an empty `Headers` is kept as it was given, outside the list (a new response
// usually gets one or two: `res.headers.set("server", "velt")` makes no list and lowercases
// nothing); a server hands it to the runtime that way, and anything else moves it into the
// list first.
//
// As in the standard, `get` joins repeated headers with ", " and iteration yields the names in
// sorted order with repeats joined, except `set-cookie`, whose values are yielded one by one
// (`getSetCookie()` returns them as an array). Unlike JavaScript, an invalid name or value is
// not rejected here: `fetch` rejects it with `IoError` "EINVAL" when it sends the request (a
// server answers 500). A fetched response's and a received request's headers are immutable, as
// in JS: changing them stops the program (`TypeError: immutable`), a programming error like an
// index out of bounds.

import { impliedType } from "velt:fetch/body";

// HTTP whitespace (tab, LF, CR, space) around `v` removed; other spaces (U+00A0, …) stay.
function trimHttp(v: string): string {
  const n = v.length as i64;
  // Most values have nothing to trim: two reads tell (HTTP whitespace is below 33).
  if (n == 0 || (v.charCodeAt(0) > 32 && v.charCodeAt(n - 1) > 32)) {
    return v;
  }
  let start: i64 = 0;
  let end: i64 = n;
  while (start < end && isHttpSpace(v.charCodeAt(start))) {
    start++;
  }
  while (end > start && isHttpSpace(v.charCodeAt(end - 1))) {
    end--;
  }
  return start == 0 && end == n ? v : v.slice(start, end);
}

function isHttpSpace(c: i64): bool {
  return c == 9 || c == 10 || c == 13 || c == 32;
}

// Whether `name` is `content-type`, in any case.
function isContentType(name: string): bool {
  return name.length == 12 && name.toLowerCase() == "content-type";
}

// Whether two header names are the same (names are case-insensitive).
function sameName(a: string, b: string): bool {
  return a.length == b.length && (a == b || a.toLowerCase() == b.toLowerCase());
}

declare function velt_rt_http_req_header(r: u64, name: string, out: string): bool;
declare function velt_rt_http_req_headers(r: u64): string[];

/** `Headers` or an object literal (`{ "content-type": "text/plain" }`). */
export type HeadersInit = Headers | Record<string, string>;

export class Headers {
  // `[name, value, …]`: lowercase names, trimmed values; with `one`, the entries after the
  // first. Null while there are none, so a new `Headers` allocates no list.
  private list: string[] | null = null;
  // The first entry, as it was given (name not lowercased, value not trimmed), while `one`: a
  // response's first header (`res.headers.set("server", …)` on a new response) is stored here,
  // without a list to allocate or a name to lowercase, and a server hands it to the runtime as
  // it is (the runtime lowercases names and trims values). Anything that needs more than that
  // moves it into the list first (`spill`).
  private name0: string = "";
  private value0: string = "";
  private one: bool = false;
  // A fetched response's or a server request's headers (std sets it): changing them is an error.
  private frozen: bool = false;
  // The server request (runtime key) whose headers the list does not hold yet; 0 once loaded.
  private req: u64 = 0;
  // The `content-type` a response's body implies (`impliedType`), not in the list yet; 0 when
  // there is none or it was moved there (std sets it).
  private implied: u32 = 0;

  constructor(init: HeadersInit | null = null) {
    if (init == null) {
      return;
    }
    if (init instanceof Headers) {
      this.list = init.items().clone();
      return;
    }
    for (const [name, value] of Object.entries(init)) {
      this.append(name, value);
    }
  }

  // Headers from a runtime list, taken as is (std only).
  private static adopt(list: string[]): Headers {
    const h = new Headers();
    h.list = list;
    return h;
  }

  // The immutable headers of the server request behind runtime key `req`, read from the
  // runtime when needed (std only).
  private static ofRequest(req: u64): Headers {
    const h = new Headers();
    h.req = req;
    h.frozen = true;
    return h;
  }

  // The flat list (std only: what `fetch` and the server hand to the runtime).
  private raw(): string[] {
    return this.items();
  }

  // What a server response hands to the runtime (std only): the first entry as given ("" when
  // there is none), the rest of the list (null for none), and the implied `content-type`'s
  // number (the runtime adds the type unless a header names one). A response's headers are
  // never a server request's, so there is nothing to load.
  private serverList(): [string, string, string[] | null, u32] {
    if (!this.one) {
      return ["", "", this.list, this.implied];
    }
    return [this.name0, this.value0, this.list, this.implied];
  }

  // `serverList` with every entry in the list (std only: a streamed response).
  private serverFlat(): [string[], u32] {
    this.spill();
    return [this.rest(), this.implied];
  }

  // The whole list: a server request's headers copied out of the runtime (once), the first
  // entry and the implied `content-type` moved in.
  private items(): string[] {
    if (this.req != 0) {
      this.list = velt_rt_http_req_headers(this.req);
      this.req = 0;
    }
    this.fill();
    return this.rest();
  }

  // The list, made if there is none (the first entry stays where it is).
  private rest(): string[] {
    const known = this.list;
    if (known != null) {
      return known;
    }
    const made: string[] = [];
    this.list = made;
    return made;
  }

  // Moves the first entry into the list (normalized).
  private spill() {
    if (!this.one) {
      return;
    }
    this.one = false;
    const list = [this.name0.toLowerCase(), trimHttp(this.value0)];
    this.name0 = "";
    this.value0 = "";
    this.prepend(list);
  }

  // Puts the first entry and the implied `content-type` into the list, the type first (where
  // it was set).
  private fill() {
    this.spill();
    const ct = impliedType(this.implied);
    this.implied = 0;
    if (ct != null) {
      this.prepend(["content-type", ct]);
    }
  }

  // Makes `head` followed by the list the list.
  private prepend(head: string[]) {
    const rest = this.list;
    if (rest != null) {
      for (const s of rest) {
        head.push(s);
      }
    }
    this.list = head;
  }

  // Whether the first entry is all there is to look at, and may be (or become) `name`
  // (non-empty) as given: the list is empty, and the implied type is not in question (`name`
  // is not `content-type`, no type is implied, or `set` replaces it).
  private alone(name: string, replaces: bool): bool {
    const list = this.list;
    if ((list != null && list.length != 0) || name.length == 0) {
      return false;
    }
    return replaces || this.implied == 0 || !isContentType(name);
  }

  /** Adds a value; a header that already has one gets another. */
  append(name: string, value: string) {
    this.change();
    if (!this.one && this.alone(name, false)) {
      this.name0 = name;
      this.value0 = value;
      this.one = true;
      return;
    }
    this.spill();
    const key = name.toLowerCase();
    if (key == "content-type") {
      this.fill();
    }
    const list = this.rest();
    list.push(key);
    list.push(trimHttp(value));
  }

  /** Replaces every value of `name` with `value`. */
  set(name: string, value: string) {
    this.change();
    if (this.alone(name, true) && (!this.one || sameName(this.name0, name))) {
      if (this.implied != 0 && isContentType(name)) {
        this.implied = 0;
      }
      this.name0 = name;
      this.value0 = value;
      this.one = true;
      return;
    }
    this.spill();
    const key = name.toLowerCase();
    if (key == "content-type") {
      this.implied = 0;
    }
    this.remove(key);
    const list = this.rest();
    list.push(key);
    list.push(trimHttp(value));
  }

  /** Removes every value of `name`. */
  delete(name: string) {
    this.change();
    this.spill();
    const key = name.toLowerCase();
    if (key == "content-type") {
      this.implied = 0;
    }
    this.remove(key);
  }

  /** The values of `name` joined with ", ", or null when there is none. */
  get(name: string): string | null {
    if (this.req != 0) {
      let out = "";
      return velt_rt_http_req_header(this.req, name, out) ? out : null;
    }
    if (this.one && this.alone(name, false)) {
      return sameName(this.name0, name) ? trimHttp(this.value0) : null;
    }
    const key = name.toLowerCase();
    if (key == "content-type") {
      this.fill();
    }
    this.spill();
    const list = this.list;
    if (list == null) {
      return null;
    }
    let out: string | null = null;
    for (let i: usize = 0; i < list.length; i += 2) {
      if (list[i] == key) {
        const v = list[i + 1].clone();
        out = out == null ? v : `${out}, ${v}`;
      }
    }
    return out;
  }

  /** Every `set-cookie` value, in order (they can't be joined with commas). */
  getSetCookie(): string[] {
    const list = this.items();
    const out: string[] = [];
    for (let i: usize = 0; i < list.length; i += 2) {
      if (list[i] == "set-cookie") {
        out.push(list[i + 1].clone());
      }
    }
    return out;
  }

  has(name: string): bool {
    if (this.req != 0) {
      let out = "";
      return velt_rt_http_req_header(this.req, name, out);
    }
    if (this.one && this.alone(name, false)) {
      return sameName(this.name0, name);
    }
    const key = name.toLowerCase();
    if (key == "content-type") {
      this.fill();
    }
    this.spill();
    const list = this.list;
    if (list == null) {
      return false;
    }
    for (let i: usize = 0; i < list.length; i += 2) {
      if (list[i] == key) {
        return true;
      }
    }
    return false;
  }

  // `[name, value]` pairs as iteration yields them: sorted by name, repeats joined.
  private sorted(): [string, string][] {
    const list = this.items();
    const names: string[] = [];
    for (let i: usize = 0; i < list.length; i += 2) {
      const n = list[i];
      if (n == "set-cookie" || !names.includes(n)) {
        names.push(n.clone());
      }
    }
    names.sort();
    const out: [string, string][] = [];
    let cookie: usize = 0;
    const cookies = this.getSetCookie();
    for (const n of names) {
      if (n == "set-cookie") {
        out.push([n, cookies[cookie].clone()]);
        cookie++;
      } else {
        out.push([n.clone(), this.get(n) ?? ""]);
      }
    }
    return out;
  }

  /** Calls `f(value, name)` for each entry, in iteration order. */
  forEach(f: (value: string, name: string) => void) {
    for (const [name, value] of this.sorted()) {
      f(value, name);
    }
  }

  *entries(): IterableIterator<[string, string]> {
    for (const e of this.sorted()) {
      yield e;
    }
  }

  *keys(): IterableIterator<string> {
    for (const [name, _] of this.sorted()) {
      yield name;
    }
  }

  *values(): IterableIterator<string> {
    for (const [_, value] of this.sorted()) {
      yield value;
    }
  }

  *[Symbol.iterator](): IterableIterator<[string, string]> {
    for (const e of this.sorted()) {
      yield e;
    }
  }

  /**
   * How `console.log` shows the headers, like Node: `Headers { 'content-type': 'text/plain' }`,
   * in insertion order with repeats joined (Node keeps the case a name was first added with;
   * Velt's names are lowercase).
   */
  __inspect(): Record<string, string> {
    // A body's implied `content-type` comes last, as in Node (`items` puts it first).
    const implied = this.implied != 0;
    const list = this.items();
    const out: Record<string, string> = {};
    for (let i: usize = implied ? 2 : 0; i < list.length; i += 2) {
      const n = list[i];
      if (out[n] == null) {
        out[n.clone()] = this.get(n) ?? "";
      }
    }
    if (implied && list.length >= 2) {
      out["content-type"] = list[1].clone();
    }
    return out;
  }

  private change() {
    if (this.frozen) {
      panic("TypeError: immutable");
    }
  }

  // Removes the entries named `key` (lowercase), keeping the order of the others; the first
  // entry is in the list.
  private remove(key: string) {
    const list = this.list;
    if (list == null) {
      return;
    }
    // Usually there is nothing to remove (`set` of a new name): look before moving anything.
    let first: usize = 0;
    while (first < list.length && list[first] != key) {
      first += 2;
    }
    if (first >= list.length) {
      return;
    }
    let w: usize = first;
    for (let i: usize = first; i < list.length; i += 2) {
      if (list[i] == key) {
        continue;
      }
      __intrinsic_array_swap(list, w, i);
      __intrinsic_array_swap(list, w + 1, i + 1);
      w += 2;
    }
    __intrinsic_array_truncate(list, w);
  }
}
