// std/fetch/tee (std-internal): one body read by two readers, for `Response.clone()` and
// `Request.clone()`: the source's chunks are pulled once, each handed to both readers (the
// second gets a copy, so neither can change the other's), as JS tees a body's stream. A chunk
// one reader has not read yet waits for it, so a reader that never reads keeps the rest of the
// body in memory, as in Node.

import { IoError } from "velt:io";
import { AbortError } from "velt:task";

/** The shared state of a teed body. */
class Tee {
  private source: AsyncIterator<u8[], IoError | AbortError>;
  /** The chunks each reader has not read yet, from `heads[side]` on. */
  private queues: u8[][][] = [[], []];
  private heads: i64[] = [0, 0];
  private ended: bool = false;
  private failure: IoError | AbortError | null = null;
  /** The pull from the source in progress: the other reader waits for it rather than pull too. */
  private pulling: Promise<void> | null = null;
  /** How many pulls have finished. */
  private pulled: i64 = 0;

  constructor(source: AsyncIterator<u8[], IoError | AbortError>) {
    this.source = source;
  }

  /** The next chunk for reader `side` (0 or 1); null at the end of the body. */
  async take(side: i64): Promise<u8[] | null, IoError | AbortError> {
    while (true) {
      const q = this.queues[side];
      const at = this.heads[side];
      if (at < (q.length as i64)) {
        const chunk = q[at];
        q[at] = [];
        this.heads[side] = at + 1;
        if (at + 1 == (q.length as i64)) {
          // Read up: the queue starts again.
          q.length = 0;
          this.heads[side] = 0;
        }
        return chunk;
      }
      const failure = this.failure;
      if (failure != null) {
        throw failure;
      }
      if (this.ended) {
        return null;
      }
      let p = this.pulling;
      if (p == null) {
        const done = this.pulled;
        p = this.pull();
        if (this.pulled == done) {
          // Still pulling (one that finished at once must not be waited for again).
          this.pulling = p;
        }
      }
      await p;
    }
  }

  /** Pulls one chunk from the source into both queues. */
  private async pull(): Promise<void> {
    try {
      const r = await this.source.next();
      if (r.done) {
        this.ended = true;
      } else {
        this.queues[1].push(r.value.slice());
        this.queues[0].push(r.value);
      }
    } catch (e) {
      this.failure = e;
    }
    this.pulling = null;
    this.pulled += 1;
  }
}

async function* reader(t: Tee, side: i64): AsyncGenerator<u8[], IoError | AbortError> {
  while (true) {
    const chunk = await t.take(side);
    if (chunk == null) {
      return;
    }
    yield chunk;
  }
}

/** Two readers of `chunks`, each of which gets every chunk. */
export function tee(
  chunks: AsyncIterator<u8[], IoError | AbortError>,
): [AsyncIterator<u8[], IoError | AbortError>, AsyncIterator<u8[], IoError | AbortError>] {
  const t = new Tee(chunks);
  return [reader(t, 0), reader(t, 1)];
}
