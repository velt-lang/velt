// std/fetch/response: the WHATWG `Response` (docs/std/fetch.md): what `fetch` resolves to, what
// a server handler returns (std/http.vlt), or a response built with `new Response(body, init)` /
// `Response.json(data)`.
//
// A fetched response holds a runtime response (`VeltFetchResp`, a registry key) whose head has
// arrived; its body is received by the first `text()`, `json()`, `bytes()` or `arrayBuffer()`,
// or chunk by chunk through `res.body` (a second read throws, as in JS). A compressed body
// (`content-encoding: gzip`, `deflate`, `br`) arrives decoded. The handle is released when the
// response is dropped, which closes the connection of a body nobody read. The status text, URL,
// `redirected` and headers are copied out of the runtime the first time they are read (most
// programs read none of them), and stay readable after the body was read. A built response
// makes no `Headers` until they are read: the `content-type` its body implies waits in
// `#implied`, and a server sends it from there.

import { IoError, IoResult, unwrapIo } from "velt:io";
import { AbortError, AbortSignal } from "velt:task";
import { utf8DecodeLossy, utf8Encode } from "velt:encoding";
import {
  BodyInit,
  BodyStream,
  JSON_TYPE,
  TEXT_TYPE,
  bodyParts,
  collect,
  impliedType,
} from "velt:fetch/body";
import { Headers, HeadersInit } from "velt:fetch/headers";

declare function velt_rt_http_fetch_resp_status(r: u64): u32;
declare function velt_rt_http_fetch_resp_status_text(r: u64): string;
declare function velt_rt_http_fetch_resp_url(r: u64): string;
declare function velt_rt_http_fetch_resp_redirected(r: u64): bool;
declare function velt_rt_http_fetch_resp_headers(r: u64): string[];
declare async function velt_rt_http_fetch_resp_text(r: u64): Promise<IoResult<string>>;
declare async function velt_rt_http_fetch_resp_bytes(r: u64): Promise<IoResult<u8[]>>;
declare async function velt_rt_http_fetch_resp_chunk(r: u64): Promise<IoResult<u8[]>>;
declare function velt_rt_http_fetch_resp_drop(r: u64);
declare function velt_rt_http_resp_drop(r: u64);
// A server response (std/http): the text body is taken (moved out, left empty), the bytes copied.
declare function velt_rt_http_resp_build(
  status: u32,
  reason: string,
  headers: string[],
  kind: u32,
  text: string,
  bytes: u8[],
  implied: u32,
): u64;

// `new Response(body, init)` and `Response.json(data, init)`: default status 200.
export struct ResponseInit {
  status?: i64;
  statusText?: string;
  headers?: HeadersInit;
}

// Where a response's body is (`Response.#source`); the first five are also the `kind` a server
// builds a response with (`velt_rt_http_resp_build`).
const NONE: i64 = 0;
const TEXT: i64 = 1;
const BYTES: i64 = 2;
const STREAM: i64 = 3;
// A fetched response's body, in the runtime.
const RUNTIME: i64 = 4;
// A server response the runtime built (a WebSocket upgrade's 101): `#handle` is its key.
const BUILT: i64 = 5;

export class Response {
  #code: i64 = 200;
  // Null until `headers` is first read.
  #fields: Headers | null = null;
  // The `content-type` the body implies (`impliedType`), until `headers` is first read.
  #implied: u32 = 0;
  // A fetched response's status text and URL: null until first read.
  #reason: string | null = "";
  // A fetched response's signal, URL and `redirected`: null for one made here.
  #remote: Remote | null = null;
  #used: bool = false;
  #source: i64 = 0;
  #str: string = "";
  #data: u8[] = [];
  #stream: BodyStream | null = null;
  #handle: u64 = 0;

  constructor(body: BodyInit | null = null, init?: ResponseInit) {
    if (init == null && typeof body == "string") {
      // Most responses: text and no options, so no parts and no status to check.
      this.#source = TEXT;
      this.#str = body;
      this.#implied = TEXT_TYPE;
      return;
    }
    if (body != null || init != null) {
      this.setUp(body, init, 0);
    }
  }

  // The constructor's work; `type` (if not 0) replaces the `content-type` the body implies.
  private setUp(body: BodyInit | null, init: ResponseInit | null, type: u32) {
    if (init != null) {
      this.init(init);
    }
    if (body == null) {
      return;
    }
    const status = this.#code;
    if (status == 204 || status == 205 || status == 304) {
      panic(`TypeError: Response constructor: Invalid response status code ${status}`);
    }
    let implied = type;
    if (typeof body == "string") {
      // Most bodies: no parts to make.
      this.#source = TEXT;
      this.#str = body;
      implied = type != 0 ? type : TEXT_TYPE;
    } else {
      const parts = bodyParts(body);
      this.#source = parts.kind as i64;
      this.#str = parts.text;
      this.#data = parts.bytes;
      this.#stream = parts.stream;
      implied = type != 0 ? type : parts.implied;
    }
    const fields = this.#fields;
    if (fields == null) {
      this.#implied = implied;
      return;
    }
    const ct = impliedType(implied);
    if (ct != null && !fields.has("content-type")) {
      fields.set("content-type", ct);
    }
  }

  // The status, status text and headers of `init`.
  private init(init: ResponseInit) {
    const status = init.status ?? 200;
    if (status < 200 || status > 599) {
      panic(`RangeError: init["status"] must be in the range of 200 to 599, inclusive.`);
    }
    this.#code = status;
    this.#reason = init.statusText ?? "";
    const given = init.headers;
    if (given != null) {
      this.#fields = new Headers(given);
    }
  }

  // The response behind runtime key `handle`, whose body aborts with `signal` (std only). The
  // response to a HEAD request has no body, whatever its headers say: `body` is null and
  // `text()` is "".
  private static adopt(handle: u64, signal: AbortSignal | null, head: bool): Response {
    const r = new Response();
    r.#code = velt_rt_http_fetch_resp_status(handle) as i64;
    r.#reason = null;
    r.#remote = new Remote(signal);
    r.#source = head ? NONE : RUNTIME;
    r.#handle = handle;
    return r;
  }

  // A server response with status `status` the runtime built, behind key `handle` (std only:
  // std/websocket's 101).
  private static built(handle: u64, status: i64): Response {
    const r = new Response();
    r.#code = status;
    r.#source = BUILT;
    r.#handle = handle;
    return r;
  }

  // A response whose body is `JSON.stringify(data)`, with `content-type: application/json`
  // unless `init` sets one.
  static json<T>(data: T, init?: ResponseInit): Response {
    const r = new Response();
    if (init == null) {
      r.#source = TEXT;
      r.#str = JSON.stringify(data);
      r.#implied = JSON_TYPE;
      return r;
    }
    r.setUp(JSON.stringify(data), init, JSON_TYPE);
    return r;
  }

  // A network error: status 0, type "error".
  static error(): Response {
    const r = new Response();
    r.#code = 0;
    return r;
  }

  // A redirect to `url` (`status` 301, 302, 303, 307 or 308).
  static redirect(url: string, status: i64 = 302): Response {
    if (status != 301 && status != 302 && status != 303 && status != 307 && status != 308) {
      panic(`RangeError: Invalid status code ${status}`);
    }
    const r = new Response(null, { status: status });
    r.headers.set("location", url);
    return r;
  }

  // The headers; a fetched response's are immutable.
  get headers(): Headers {
    const known = this.#fields;
    if (known != null) {
      return known;
    }
    let h = new Headers();
    if (this.#source == RUNTIME || (this.#handle != 0 && this.#source == NONE)) {
      h = Headers.adopt(velt_rt_http_fetch_resp_headers(this.#handle));
      h.frozen = true;
    }
    // `h` is empty: the implied type moves over as its number (std/fetch/headers.vlt).
    h.implied = this.#implied;
    this.#implied = 0;
    this.#fields = h;
    return h;
  }

  get status(): i64 {
    return this.#code;
  }

  // Whether the status is 200–299.
  get ok(): bool {
    return this.#code >= 200 && this.#code <= 299;
  }

  // The server's status message (`OK`, `Not Found`), "" if it sent none.
  get statusText(): string {
    const known = this.#reason;
    if (known != null) {
      return known;
    }
    const s = velt_rt_http_fetch_resp_status_text(this.#handle);
    this.#reason = s;
    return s;
  }

  // The URL the response came from, after redirects ("" for a constructed response).
  get url(): string {
    const remote = this.#remote;
    if (remote == null) {
      return "";
    }
    const known = remote.url;
    if (known != null) {
      return known;
    }
    const s = velt_rt_http_fetch_resp_url(this.#handle);
    remote.url = s;
    return s;
  }

  // Whether `fetch` followed a redirect to get it.
  get redirected(): bool {
    const remote = this.#remote;
    if (remote == null) {
      return false;
    }
    const known = remote.redirected;
    if (known != null) {
      return known;
    }
    const hops = velt_rt_http_fetch_resp_redirected(this.#handle);
    remote.redirected = hops;
    return hops;
  }

  // "basic" (fetched), "default" (constructed) or "error" (`Response.error()`).
  get type(): string {
    if (this.#code == 0) {
      return "error";
    }
    return this.#remote != null ? "basic" : "default";
  }

  // The body as it arrives: `for await (const chunk of res.body)` yields `u8[]` chunks (JS: a
  // `ReadableStream` of `Uint8Array`s). Null for a status that has no body (101, 103, 204, 205,
  // 304) and for a response made without one.
  get body(): BodyStream | null {
    const code = this.#code;
    const none = code == 101 || code == 103 || code == 204 || code == 205;
    if (none || code == 304 || this.#source == NONE || this.#source == BUILT) {
      return null;
    }
    return BodyStream.adopt(this.chunks());
  }

  // Whether the body has been read.
  get bodyUsed(): bool {
    return this.#used;
  }

  // The body as text (invalid UTF-8 becomes U+FFFD, as in JS).
  async text(): Promise<string, IoError | AbortError> {
    this.claim();
    if (this.#source == RUNTIME) {
      const r = await velt_rt_http_fetch_resp_text(this.#handle);
      this.check(r.code);
      return unwrapIo(r);
    }
    if (this.#source == TEXT) {
      return this.#str;
    }
    let d = this.#data;
    const s = this.#stream;
    if (this.#source == STREAM && s != null) {
      d = await collect(s);
    }
    // A leading byte order mark is not text, as in JS.
    const bom = d.length >= 3 && d[0] == 239 && d[1] == 187 && d[2] == 191;
    return utf8DecodeLossy(bom ? d.slice(3) : d);
  }

  // `JSON.parse<T>` of the body: the JSON is checked against `T` (`JsonError` if it doesn't
  // match). Velt has no `any`: name the type, `await res.json<User[]>()`, or annotate the
  // variable that receives it.
  async json<T>(): Promise<T, IoError | AbortError | JsonError> {
    return JSON.parse<T>(await this.text());
  }

  async bytes(): Promise<u8[], IoError | AbortError> {
    this.claim();
    if (this.#source == RUNTIME) {
      const r = await velt_rt_http_fetch_resp_bytes(this.#handle);
      this.check(r.code);
      return unwrapIo(r);
    }
    if (this.#source == TEXT) {
      return utf8Encode(this.#str);
    }
    const s = this.#stream;
    if (this.#source == STREAM && s != null) {
      return await collect(s);
    }
    return this.#data;
  }

  // The body's bytes (JS returns an `ArrayBuffer`; Velt's byte buffer is `u8[]`).
  async arrayBuffer(): Promise<u8[], IoError | AbortError> {
    return await this.bytes();
  }

  // The body's chunks, for `BodyStream` (std only); reading them uses the body up.
  private async *chunks(): AsyncIterator<u8[], IoError | AbortError> {
    this.claim();
    if (this.#source == RUNTIME) {
      while (true) {
        const r = await velt_rt_http_fetch_resp_chunk(this.#handle);
        this.check(r.code);
        const chunk = unwrapIo(r);
        if (chunk.length == 0) {
          return;
        }
        yield chunk;
      }
    }
    const s = this.#stream;
    if (this.#source == TEXT) {
      yield utf8Encode(this.#str);
    } else if (this.#source == STREAM && s != null) {
      for await (const chunk of s) {
        yield chunk;
      }
    } else if (this.#data.length > 0) {
      yield this.#data;
    }
  }

  // This response as a server response (std only: std/http returns it from the handler): its
  // runtime key, 0 if a header name or value is not valid HTTP. A response the runtime built
  // is given up as it is. A streamed body (a `BodyStream`, or a fetched response's body) is
  // left for std/http to copy into the response (`serverStream`).
  private toServer(): u64 {
    if (this.#source == BUILT) {
      const h = this.#handle;
      this.#handle = 0;
      return h;
    }
    let headers: string[] = [];
    let implied: u32 = 0;
    const fields = this.#fields;
    if (fields != null) {
      const [list, type] = fields.serverList();
      headers = list;
      implied = type;
    } else if (this.#source == RUNTIME) {
      headers = this.headers.raw();
    } else {
      implied = this.#implied;
    }
    let text = this.#str;
    return velt_rt_http_resp_build(
      this.#code as u32,
      this.#reason ?? "",
      headers,
      this.#source as u32,
      text,
      this.#data,
      implied,
    );
  }

  // The body std/http copies into a server response once `toServer` built it (std only): null
  // when the body is not streamed.
  private serverStream(): BodyStream | null {
    if (this.#source == RUNTIME) {
      return this.body;
    }
    return this.#stream;
  }

  // Marks the body read; throws if it was already. A response without a body can be read any
  // number of times, as in JS.
  private claim() throws IoError {
    if (this.#source == NONE || this.#source == BUILT) {
      return;
    }
    if (this.#used) {
      throw new IoError("EINVAL", "Body is unusable: Body has already been read");
    }
    this.#used = true;
  }

  // After a failed body read: the signal's `AbortError` if it was aborted.
  private check(code: i32) throws AbortError {
    const remote = this.#remote;
    const s = remote == null ? null : remote.signal;
    if (code != 0 && s != null) {
      s.throwIfAborted();
    }
  }

  // Drop hook: releases the runtime response.
  [Symbol.dispose]() {
    if (this.#handle != 0) {
      if (this.#source == BUILT) {
        velt_rt_http_resp_drop(this.#handle);
      } else {
        velt_rt_http_fetch_resp_drop(this.#handle);
      }
      this.#handle = 0;
    }
  }
}

// What only a fetched response has besides its runtime key: the signal that aborts its body,
// and its URL and `redirected` (null until first read).
class Remote {
  signal: AbortSignal | null;
  url: string | null = null;
  redirected: bool | null = null;

  constructor(signal: AbortSignal | null) {
    this.signal = signal;
  }
}
