// std/test: the test runner (docs/book/testing.md). `velt test` finds the test files, compiles
// them with a generated `main` that registers their tests here (`__file`, `__test`,
// `__testAsync`) and calls `__run`, and starts the program. Everything after that is this module:
//
// - Started by `velt test` (`$VELT_TEST_PLAN` names the plan, a JSON `Plan`), the program is the
//   runner: it starts a process per test file, from the program the plan names for the file,
//   several at once, and prints their reports in file order, then the summary; its exit code is
//   the run's.
// - Started for one file (`$VELT_TEST_FILE`, from the test `$VELT_TEST_FROM` on), it runs that
//   file's tests one after another and reports each in marker lines for the runner. A failed
//   test is an error it throws (a failed `assert` throws an `AssertionError`): it is caught and
//   reported, and the next test runs. When a test ends the process (a panic, `process.exit`),
//   the runner starts the file again from the test after it. After its last test the process
//   exits, whatever timers or servers a failed test left behind.
// - Started without either (a test program run by hand or under a debugger), it runs every file's
//   tests in this process and prints the report itself.

import { JSON } from "velt:prelude/json/json";
import { exec, ExecResult, spawn } from "velt:child_process";
import { readFileSync, writeFileSync } from "velt:fs";
import { __claim, Body, Case, collect, Step, Suite } from "velt:test/suite";

export { Expect, expect } from "velt:test/expect";
export {
  afterAll,
  afterEach,
  beforeAll,
  beforeEach,
  describe,
  it,
  Settles,
  test,
} from "velt:test/suite";

declare function velt_rt_clear_throw_loc(): void;
declare function velt_rt_flush(): void;

/** The tests of one test file: its `test_*` functions and what its top level registered. */
class TestFile {
  /** Its top-level suite, which the `test_*` functions are in too. */
  readonly root: Suite = new Suite("", null);
  /** Its `export function test_*`, in source order. */
  readonly functions: Case[] = [];
  /** What its top-level `describe`, `it` and hook calls queued. */
  readonly steps: Step[];

  constructor(steps: Step[]) {
    this.steps = steps;
  }

  /** Every test, collected (`velt:test/suite`): the `test_*` functions first. */
  tests(): Case[] {
    return collect(this.functions, this.root, this.steps);
  }
}

/** The test files of this program, in the order `__file` registered them. */
let files: TestFile[] = [];

/**
 * `__file(queued)`: the tests registered from now on are those of the next test file, and so
 * are the next `queued` registrations its top level made (`-1`: all that are left).
 */
export function __file(queued: i64) {
  files.push(new TestFile(__claim(queued)));
}

/** Registers a test function of the current file. */
export function __test(name: string, run: () => void throws unknown) {
  const f = current();
  f.functions.push(
    new Case(
      name,
      async (): Promise<void, unknown> => {
        run();
      },
      f.root,
      null,
    ),
  );
}

/** Registers an `async` test function of the current file; what its promise holds is not looked at. */
export function __testAsync<T>(name: string, run: () => Promise<T, unknown>) {
  const f = current();
  f.functions.push(
    new Case(
      name,
      async (): Promise<void, unknown> => {
        await run();
      },
      f.root,
      null,
    ),
  );
}

function current(): TestFile {
  if (files.length == 0) {
    files.push(new TestFile(__claim(-1)));
  }
  return files[files.length - 1];
}

/** What `velt test` hands the runner (`$VELT_TEST_PLAN`). */
struct Plan {
  /** How many files run at once. */
  workers: number;
  /** Whether stdout and stderr are terminals that take colors. */
  colorOut: bool;
  colorErr: bool;
  /** Tests that failed before anything ran (files that do not parse). */
  failed: number;
  /** `--filter`, and whether it names a test exactly (`--exact`): for the tests registered at run time. */
  filter: string | null;
  exact: bool;
  files: PlanFile[];
  /** Where to write how each file that ran went (`Ran[]`), for `velt test` to keep; `null`: nowhere. */
  results: string | null;
}

/** How a file's tests went, as `velt test` keeps it for a program that didn't change. */
struct Ran {
  /** The file's index in `Plan.files`. */
  index: number;
  lines: string[];
  passed: number;
  failed: number;
}

/** A test file of the run. */
struct PlanFile {
  /** As `running <path>` shows it. */
  path: string;
  /** Its absolute path, the test program's `process.argv[1]`. */
  script: string;
  /** The test program that holds its tests, `null` when it did not build. */
  exe: string | null;
  /** Its index among that program's files. */
  index: number;
  /** Its `test_*` functions (the process lists every test it runs, these and the others). */
  tests: string[];
  /** Whether its top level calls `describe`, `it`, `test` or a hook. */
  registers: bool;
  /** `test_*` functions that cannot run, with the reason. */
  skipped: Skipped[];
  /** How its tests went last time, when its program is the same and can't have changed its mind. */
  cached: Ran | null;
  /** Why its result isn't kept (`the network`): what its program reaches; `null` when it is. */
  uncacheable: string | null;
}

struct Skipped {
  name: string;
  reason: string;
}

/**
 * Prefix of the lines a test process writes for the runner: this, then the run's token
 * (`$VELT_TEST_MARK`), so a test printing something that looks like one isn't taken for it.
 */
const MARK = "::velt-test:";

/** What a test file printed, read back, and how its tests went. */
class Report {
  lines: string[] = [];
  passed: usize = 0;
  failed: usize = 0;
}

/** The entry of a test program: run as the runner, as one file's tests, or every file here. */
export async function __run() {
  const plan = process.env.VELT_TEST_PLAN;
  const file = process.env.VELT_TEST_FILE;
  if (file != null) {
    const from = Number(process.env.VELT_TEST_FROM ?? "0");
    const mark = `${MARK}${process.env.VELT_TEST_MARK ?? ""}:: `;
    const result = await runTests(files[Number(file) as usize], from as usize, mark);
    // Counting blocks (`VELT_RC_STATS=1`, debug runtime): `main` returns, so the runtime frees
    // the module state and reports what is left (`blocks=A/F`), which the runner checks. A test
    // that left a timer or a server running then keeps the process alive (a leak).
    if (process.env.VELT_RC_STATS == "1" && !result.teardownFailed) {
      return;
    }
    process.exit(result.teardownFailed ? 1 : 0);
  } else if (plan != null) {
    const ok = await runPlan(JSON.parse<Plan>(readFileSync(plan)));
    process.exit(ok ? 0 : 1);
  } else {
    let failed = false;
    for (const f of files) {
      const result = await runTests(f, 0, null);
      failed = failed || result.failed > 0 || result.teardownFailed;
    }
    process.exit(failed ? 1 : 0);
  }
}

/** How the tests of a file went in one process. */
struct Outcome {
  /** How many failed. */
  failed: usize;
  /** Whether an `afterAll` hook threw (reported where it ran). */
  teardownFailed: bool;
}

/**
 * Run the tests of `file` from `from` on, reporting each: in lines starting with `mark` for the
 * runner, after the list of every test of the file, else (`null`) as the runner shows them.
 */
async function runTests(file: TestFile, from: usize, mark: string | null): Promise<Outcome> {
  const filter = process.env.VELT_TEST_FILTER;
  const exact = process.env.VELT_TEST_EXACT == "1";
  const tests = file
    .tests()
    .filter((t) => filter == null || (exact ? t.name == filter : t.name.includes(filter)));
  if (mark != null) {
    // Collected (the `describe` callbacks ran): the list, then `start`. Stdout to the runner is
    // a pipe, so buffered: a crash (a stack overflow, a segfault) would lose what is still in
    // the buffer, so each marker is written out before what comes next runs.
    for (const t of tests) {
      console.log(`${mark}test ${escapeName(t.name)}`);
    }
    console.log(`${mark}start`);
    velt_rt_flush();
  }
  let failed: usize = 0;
  let teardownFailed = false;
  // The suites whose `beforeAll` hooks ran, outermost first.
  const entered: Suite[] = [];
  for (let i = from; i < tests.length; i++) {
    const t = tests[i];
    const chain = t.suite.chain();
    while (entered.length > 0 && !chain.includes(entered[entered.length - 1])) {
      teardownFailed = (await leave(entered.pop()!)) || teardownFailed;
    }
    for (const s of chain) {
      if (!entered.includes(s)) {
        entered.push(s);
        // An outer group whose `beforeAll` threw: this group's hooks don't run, as in Vitest.
        const outer = s.parent;
        if (outer != null && outer.setupError != null) {
          s.setupError = outer.setupError;
          s.blocked = true;
        } else {
          s.setupError = await attempt(s.beforeAll);
        }
      }
    }
    let error = t.error;
    for (const s of chain) {
      error = error ?? s.setupError;
    }
    if (error == null) {
      for (const s of chain) {
        error = error ?? (await attempt(s.beforeEach));
      }
      error = error ?? (await attempt([t.run]));
      for (const s of chain.toReversed()) {
        const after = await attempt(s.afterEach);
        error = error ?? after;
      }
    }
    report(t.name, error, mark);
    if (error != null) {
      failed++;
    }
  }
  while (entered.length > 0) {
    teardownFailed = (await leave(entered.pop()!)) || teardownFailed;
  }
  return { failed: failed, teardownFailed: teardownFailed };
}

/** Run `bodies` in order until one throws: its error, located; `null` if none does. */
async function attempt(bodies: Body[]): Promise<string | null> {
  for (const run of bodies) {
    // An error that is never thrown here (a rejection) has no location of its own.
    velt_rt_clear_throw_loc();
    try {
      await run();
    } catch (e) {
      // Where it was thrown, before anything else throws: after the whole message, on its last
      // line, as Vitest puts the location after a message of several lines.
      const at = __intrinsic_throw_loc();
      return `${__intrinsic_error_text(e)}${at}`;
    }
  }
  return null;
}

/** Run the `afterAll` hooks of `suite`, printing what one threw; whether one did. */
async function leave(suite: Suite): Promise<bool> {
  if (suite.blocked) {
    return false;
  }
  const error = await attempt(suite.afterAll);
  if (error == null) {
    return false;
  }
  const name = suite.name == "" ? "the file" : `\`${suite.name}\``;
  console.log(`afterAll of ${name} failed: ${error}`);
  return true;
}

/**
 * A test's name as the report lines carry it, on one line: a line break and a backslash escaped
 * (`\n`, `\\`), as a string literal writes them.
 */
function escapeName(name: string): string {
  return name.replaceAll("\\", "\\\\").replaceAll("\n", "\\n").replaceAll("\r", "\\r");
}

/** Report how the test `name` went: for the runner after `mark`, else as the runner shows it. */
function report(raw: string, error: string | null, mark: string | null) {
  const name = escapeName(raw);
  if (error == null) {
    console.log(mark != null ? `${mark}ok ${name}` : `ok ${name}`);
  } else if (mark != null) {
    console.log(`${mark}fail ${name}`);
    for (const line of error.split("\n")) {
      console.log(`${mark}| ${line}`);
    }
  } else {
    console.log(`FAILED ${name}`);
    for (const line of error.split("\n")) {
      console.log(`    ${line}`);
    }
  }
  velt_rt_flush();
}

/** Run every file of `plan`, `plan.workers` at once, printing each report in file order. */
async function runPlan(plan: Plan): Promise<bool> {
  const paint = new Paint(plan.colorOut, plan.colorErr);
  const reports: (Report | null)[] = plan.files.map((_) => null);
  const ran: Ran[] = [];
  let started: usize = 0;
  let printed: usize = 0;
  let passed: usize = 0;
  let failed = plan.failed as usize;
  const worker = async () => {
    while (started < plan.files.length) {
      const i = started;
      started++;
      const cached = plan.files[i].cached;
      if (cached != null) {
        const r = new Report();
        r.lines = cached.lines;
        r.passed = cached.passed as usize;
        r.failed = cached.failed as usize;
        reports[i] = r;
      } else {
        const r = await runFile(plan.files[i], plan, paint);
        ran.push({
          index: i as number,
          lines: r.lines,
          passed: r.passed as number,
          failed: r.failed as number,
        });
        reports[i] = r;
      }
      while (printed < reports.length && reports[printed] != null) {
        const f = plan.files[printed];
        const r = reports[printed]!;
        // With a filter, a file none of whose tests it selected says nothing.
        if (plan.filter != null && r.passed + r.failed == 0 && r.lines.length == 0) {
          printed++;
          continue;
        }
        const why = f.uncacheable;
        const note =
          f.cached != null
            ? " (cached)"
            : why != null ? ` (ran: not cacheable, it uses ${why})` : "";
        console.log(`running ${f.path}${note}`);
        for (const s of f.skipped) {
          console.error(
            `${paint.warning("warning:")} skipping \`${s.name}\` in ${f.path}: ${s.reason}`,
          );
        }
        for (const line of r.lines) {
          console.log(line);
        }
        passed += r.passed;
        failed += r.failed;
        printed++;
      }
    }
  };
  const workers: Promise<void>[] = [];
  const n = Math.max(1, Math.min(plan.workers, plan.files.length as number));
  for (let w = 0; w < n; w++) {
    workers.push(worker());
  }
  await Promise.all(workers);
  // Files that register their tests at run time list them only here (`velt test` says this
  // itself when no file does).
  const filter = plan.filter;
  if (filter != null && passed + failed == 0) {
    console.error(`no tests match \`${filter}\``);
  }
  const results = plan.results;
  if (results != null) {
    writeFileSync(results, JSON.stringify(ran));
  }
  const verdict = failed == 0 ? paint.good("ok") : paint.failed();
  console.log(`\ntest result: ${verdict}. ${passed} passed; ${failed} failed`);
  return failed == 0;
}

/** Run the tests of `f`, starting its program again after each test that ends the process. */
async function runFile(f: PlanFile, plan: Plan, paint: Paint): Promise<Report> {
  const report = new Report();
  const exe = f.exe;
  if (exe == null) {
    for (const t of f.tests) {
      report.lines.push(`${paint.failed()} ${t} (build failed)`);
    }
    if (f.registers) {
      report.lines.push(`${paint.failed()} ${f.path} (build failed)`);
    }
    report.failed = f.tests.length + (f.registers ? 1 : 0);
    return report;
  }
  const mark = `${MARK}${token()}:: `;
  const run = new FileRun(f, exe, plan, mark);
  let from: usize = 0;
  // Until a process lists the file's tests, there is one to start.
  while (from < (run.tests?.length ?? from + 1)) {
    from = await runFrom(run, from, report, paint);
  }
  return report;
}

/** What the processes running one file's tests share. */
class FileRun {
  readonly f: PlanFile;
  readonly exe: string;
  readonly plan: Plan;
  readonly mark: string;
  /** The file's tests, as its first process listed them; `null` before. */
  tests: string[] | null = null;

  constructor(f: PlanFile, exe: string, plan: Plan, mark: string) {
    this.f = f;
    this.exe = exe;
    this.plan = plan;
    this.mark = mark;
  }
}

/** A token no test is likely to print, different in each run. */
function token(): string {
  return Math.floor(Math.random() * 1e15).toString(36);
}

/** One process running the tests of the file from `from` on; returns where the next one starts. */
async function runFrom(run: FileRun, from: usize, report: Report, paint: Paint): Promise<usize> {
  const f = run.f;
  const mark = run.mark;
  const env = new Map<string, string>([
    ["VELT_SCRIPT", f.script],
    ["VELT_TEST_FILE", String(f.index)],
    ["VELT_TEST_FROM", String(from)],
    ["VELT_TEST_MARK", mark.slice(MARK.length as i64, (mark.length as i64) - 3)],
  ]);
  const filter = run.plan.filter;
  if (filter != null) {
    env.set("VELT_TEST_FILTER", filter);
    env.set("VELT_TEST_EXACT", run.plan.exact ? "1" : "0");
  }
  // Counting blocks, the process returns from `main` after its tests and waits for what is
  // still running, as Node does: one that is still running after `LEAK_WAIT` is ended.
  const counting = process.env.VELT_RC_STATS == "1";
  let r: ExecResult;
  let ended = false;
  try {
    if (counting) {
      const timed = await runTimed(run.exe, env, LEAK_WAIT);
      r = timed.result;
      ended = timed.ended;
    } else {
      r = await exec(run.exe, [], { env: env });
    }
  } catch (e) {
    const text = __intrinsic_error_text(e);
    report.lines.push(`${paint.error("error:")} cannot run \`${run.exe}\`: ${text}`);
    const left = (run.tests?.length ?? f.tests.length) - from;
    report.failed += left > 0 ? left : 1;
    run.tests = run.tests ?? [];
    return run.tests.length;
  }
  let next = from;
  let started = false;
  const listed: string[] = [];
  const lines = r.stdout.split("\n");
  if (lines.length > 0 && lines[lines.length - 1] == "") {
    lines.pop();
  }
  for (const line of lines) {
    // A test's output without a final newline runs into the marker after it.
    const at = line.indexOf(mark);
    if (at < 0) {
      report.lines.push(line);
      continue;
    }
    if (at > 0) {
      report.lines.push(line.slice(0, at));
    }
    const rest = line.slice(at + (mark.length as i64));
    const known = run.tests ?? listed;
    const name = next < known.length ? known[next] : null;
    if (rest == "start") {
      started = true;
    } else if (rest.startsWith("test ")) {
      listed.push(rest.slice(5));
    } else if (rest == `ok ${name}`) {
      report.lines.push(`${paint.good("ok")} ${name}`);
      report.passed++;
      next++;
    } else if (rest == `fail ${name}`) {
      report.lines.push(`${paint.failed()} ${name}`);
      report.failed++;
      next++;
    } else if (rest.startsWith("| ")) {
      report.lines.push(`    ${rest.slice(2)}`);
    }
  }
  if (!started) {
    // It ended before running a test: in a module's top-level code, or collecting the tests.
    report.lines.push(`${paint.failed()} ${f.path} (exit code ${r.code} before its tests ran)`);
    pushStderr(report, r.stderr);
    const left = (run.tests?.length ?? f.tests.length) - from;
    report.failed += left > 0 ? left : 1;
    run.tests = run.tests ?? [];
    return run.tests.length;
  }
  const tests = run.tests ?? listed;
  run.tests = tests;
  if (ended) {
    report.lines.push(
      `${paint.failed()} ${f.path} (still running ${LEAK_WAIT / 1000} s after its tests: a server, a connection or a timer left open)`,
    );
    report.failed++;
    return tests.length;
  }
  const leaked = counting ? leakedBlocks(r.stderr) : 0;
  if (leaked != null && leaked > 0) {
    report.lines.push(`${paint.failed()} ${f.path} (${leaked} blocks not freed)`);
    report.failed++;
  }
  if (next >= tests.length) {
    if (r.code != 0) {
      report.lines.push(
        `${paint.failed()} (test harness exited with code ${r.code} after all tests ran)`,
      );
      report.failed++;
    } else if (leaked == null) {
      // As the goldens' leak check: a file whose process reported no counts is not leak-free.
      report.lines.push(
        `${paint.failed()} ${f.path} (no block counts on its stderr; VELT_RC_STATS=1 counts blocks in debug builds)`,
      );
      report.failed++;
    }
    return tests.length;
  }
  // The process ended inside test `next`.
  report.lines.push(`${paint.failed()} ${tests[next]} (exit code ${r.code})`);
  pushStderr(report, r.stderr);
  report.failed++;
  return next + 1;
}

/** How long a test process counting blocks may keep running after its tests (ms). */
const LEAK_WAIT = 120000;

/** What `runTimed` ran: as `exec` returns it, and whether it was ended for taking too long. */
struct Timed {
  result: ExecResult;
  ended: bool;
}

/** Run `exe` with `env` to its end, as `exec` does, but end it after `limit` ms. */
async function runTimed(exe: string, env: Map<string, string>, limit: number): Promise<Timed> {
  const child = spawn(exe, [], { env: env, stdin: "ignore", stdout: "pipe", stderr: "pipe" });
  const ended = shared(0 as i64);
  const timer = setTimeout(
    () => {
      ended.set(1);
      child.kill("SIGKILL");
    },
    limit as i64,
  );
  const out = await Promise.all([drain(() => child.readStdout()), drain(() => child.readStderr())]);
  const code = await child.wait();
  clearTimeout(timer);
  child.close();
  return { result: new ExecResult(code as number, out[0], out[1]), ended: ended.get() == 1 };
}

/** Everything `read` gives until it gives `""` (the end of the output). */
async function drain(read: () => Promise<string, unknown>): Promise<string, unknown> {
  let all = "";
  while (true) {
    const chunk = await read();
    if (chunk == "") {
      return all;
    }
    all += chunk;
  }
}

/**
 * The blocks a test process allocated and didn't free, from the runtime's report on its stderr
 * (`rc stats: … blocks=A/F …`, `VELT_RC_STATS=1` with the debug runtime); `null` without one.
 */
function leakedBlocks(stderr: string): number | null {
  const at = stderr.lastIndexOf(" blocks=");
  if (at < 0 || !stderr.includes("rc stats:")) {
    return null;
  }
  const field = stderr.slice(at + 8).split(" ")[0];
  const counts = field.split("/");
  if (counts.length != 2) {
    return null;
  }
  const allocated = Number(counts[0]);
  const freed = Number(counts[1]);
  return Number.isNaN(allocated) || Number.isNaN(freed) ? null : allocated - freed;
}

function pushStderr(report: Report, stderr: string) {
  for (const line of stderr.split("\n")) {
    if (line != "") {
      report.lines.push(`    ${line}`);
    }
  }
}

/** `velt`'s ANSI colors (`veltc` `style`), when `velt test` found the stream takes them. */
class Paint {
  readonly out: bool;
  readonly err: bool;

  constructor(out: bool, err: bool) {
    this.out = out;
    this.err = err;
  }

  good(s: string): string {
    return this.out ? `\x1b[1;32m${s}\x1b[0m` : s;
  }

  failed(): string {
    return this.out ? "\x1b[1;31mFAILED\x1b[0m" : "FAILED";
  }

  error(s: string): string {
    return this.out ? `\x1b[1;31m${s}\x1b[0m` : s;
  }

  warning(s: string): string {
    return this.err ? `\x1b[1;33m${s}\x1b[0m` : s;
  }
}
