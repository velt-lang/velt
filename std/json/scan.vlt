// velt:json/scan — byte-level JSON lexing (RFC 8259) for the pull reader, skipping and
// `JsonValue`. Strings without escapes are byte ranges of the source (no copy until a decoder
// asks for the text); only strings with escapes are decoded. Escapes decode to UTF-16 code
// units, so a lone surrogate escape stays a lone surrogate (joined with a half next to it, as
// string concatenation joins halves).
//
// Port of crates/velt_text/src/json_scan.rs (#1668): the same tokens, error details and error
// offsets.

import { utf8Substring } from "velt:encoding";
import { decimalValue } from "velt:number/parse";

declare function velt_simd_u8x16_splat(x: u8): u8x16;
declare function velt_simd_u8x16_eq(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_lt(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_u8x16_ge(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_mask8x16_or(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_and(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_any(m: mask8x16): bool;
declare function velt_simd_mask8x16_first(m: mask8x16): u64;
declare function velt_simd_mask8x16_bitmask(m: mask8x16): u64;

// Why a scan failed (`Scanner.code`; `detailText` gives the text, `Scanner.what`). A code, not
// the text: recording one is a store, where a string field is a release and a retain.
/** No failure. */
export const OK: u8 = 0;
/** Input that ends inside a value. */
export const UNEXPECTED_EOF: u8 = 1;
/** A byte that cannot start or continue the construct. */
export const UNEXPECTED_CHAR: u8 = 2;
export const INVALID_NUMBER: u8 = 3;
export const CONTROL_CHAR: u8 = 4;
export const INVALID_ESCAPE: u8 = 5;
export const INVALID_U_ESCAPE: u8 = 6;
/** More nested arrays and objects than a decoder's `maxDepth` allows. */
export const TOO_DEEP: u8 = 7;
export const EXPECTED_KEY: u8 = 8;
export const EXPECTED_COLON: u8 = 9;
export const EXPECTED_COMMA_BRACE: u8 = 10;
export const EXPECTED_COMMA_BRACKET: u8 = 11;
export const TRAILING: u8 = 12;

/** The text of a failure `code`. */
export function detailText(code: u8): string {
  if (code == UNEXPECTED_EOF) {
    return "unexpected end of input";
  }
  if (code == UNEXPECTED_CHAR) {
    return "unexpected character";
  }
  if (code == INVALID_NUMBER) {
    return "invalid number";
  }
  if (code == CONTROL_CHAR) {
    return "control character in string";
  }
  if (code == INVALID_ESCAPE) {
    return "invalid escape";
  }
  if (code == INVALID_U_ESCAPE) {
    return "invalid \\u escape";
  }
  if (code == TOO_DEEP) {
    return "nested too deeply";
  }
  if (code == EXPECTED_KEY) {
    return "expected string key";
  }
  if (code == EXPECTED_COLON) {
    return "expected ':'";
  }
  if (code == EXPECTED_COMMA_BRACE) {
    return "expected ',' or '}'";
  }
  if (code == EXPECTED_COMMA_BRACKET) {
    return "expected ',' or ']'";
  }
  if (code == TRAILING) {
    return "unexpected trailing characters";
  }
  return "";
}

// Bytes the scanner compares with.
const QUOTE: u8 = 34;
const BACKSLASH: u8 = 92;
const MINUS: u8 = 45;
const PLUS: u8 = 43;
const DOT: u8 = 46;
const ZERO: u8 = 48;

/** A cursor over a JSON document. Failing methods return false and set `code` and `at`. */
export class Scanner {
  src: string;
  /** The source's length in bytes. */
  len: usize;
  pos: usize = 0;
  /** The UTF-16 length of the last string token's (decoded) contents. */
  units: usize = 0;
  /** The last string token decoded a lone surrogate escape (`"\ud800"`). */
  lone: bool = false;
  /** The last string token's raw contents: bytes `start` to `end`, between its quotes. */
  start: usize = 0;
  end: usize = 0;
  /** The last string token had escapes: its text is `decoded` (when decoding). */
  escaped: bool = false;
  decoded: string = "";
  /** The last number token had no fraction and no exponent. */
  integer: bool = false;
  /**
   * The last number token's digits, read while lexing it (so that a decoder's number is not
   * read twice): `digitsValue` is its digits as an integer (wrapped past 19 digits) and
   * `exponent` the power of ten that scales it, its sign is `negative`. `small`: an integer of
   * at most 15 digits (below 2^53, so exact as an `f64` too). `exact`: at most 19 digits and an
   * exponent of at most 5 digits, so `digitsValue` and `exponent` are the token's value.
   */
  small: bool = false;
  exact: bool = false;
  digitsValue: u64 = 0;
  exponent: i64 = 0;
  negative: bool = false;
  /** JSONC (`JSON.parse` options): the text had its comments blanked (`blankComments`); a
   *  comma may come before `]` and `}`. */
  comments: bool = false;
  trailingCommas: bool = false;
  /** The last error: its detail and byte offset. */
  code: u8 = OK;
  at: usize = 0;

  constructor(src: string) {
    this.src = src;
    this.len = __intrinsic_str_byte_len(src);
  }

  /** Skips whitespace; the next byte, not consumed, or -1 at the end. */
  peekNonWs(): i32 {
    // On a local, stored back once: with `this.pos` in the loop, LLVM still stores it per byte
    // here (the loop exits before the increment; #1669's alias tag covers loops that store on
    // every iteration). Measured 5-7% more instructions for the plain form.
    const len = this.len;
    let pos = this.pos;
    while (pos < len) {
      const b = __intrinsic_str_byte_at(this.src, pos as u64);
      if (b != 32 && b != 10 && b != 13 && b != 9) {
        this.pos = pos;
        return b as i32;
      }
      pos++;
    }
    this.pos = pos;
    return -1;
  }

  /**
   * The value of the number token just lexed: from the digits the scanner read when that is
   * exact (velt:number/parse's `decimalValue`), else by the general parser.
   */
  numberValue(): f64 {
    const w = this.digitsValue;
    const neg = this.negative;
    if (this.small) {
      return neg ? -(w as f64) : w as f64;
    }
    if (this.exact) {
      if (w == 0) {
        return neg ? -0.0 : 0;
      }
      const r = decimalValue(w, this.exponent);
      if (r.ok) {
        return neg ? -r.value : r.value;
      }
    }
    return Number(utf8Substring(this.src, this.start, this.end));
  }

  /** The last error's text. */
  get what(): string {
    return detailText(this.code);
  }

  /** Fails with `code` at the current position, or `UNEXPECTED_EOF` past the end. */
  fail(code: u8): bool {
    this.code = this.pos >= this.len ? UNEXPECTED_EOF : code;
    this.at = this.pos;
    return false;
  }

  /** The current byte cannot appear here. */
  unexpected(): bool {
    return this.fail(UNEXPECTED_CHAR);
  }

  /** Consumes exactly `word` (`true`, `false`, `null`). */
  literal(word: string): bool {
    const n = __intrinsic_str_byte_len(word);
    for (let i: usize = 0; i < n; i++) {
      if (!this.byteIs(__intrinsic_str_byte_at(word, i as u64))) {
        return this.unexpected();
      }
      this.pos++;
    }
    return true;
  }

  /** Lexes a number at the current position (`-` or a digit): `start`..`end`, `integer`. */
  number(): bool {
    const start = this.pos;
    const len = this.len;
    let pos = start;
    const negative = pos < len && __intrinsic_str_byte_at(this.src, pos as u64) == MINUS;
    if (negative) {
      pos++;
    }
    // The digits accumulate into `w` (wrapping past 19 of them: `exact` is false then).
    const first = pos;
    let w: u64 = 0;
    if (pos < len && __intrinsic_str_byte_at(this.src, pos as u64) == ZERO) {
      pos++;
    } else {
      while (pos < len) {
        const d = __intrinsic_str_byte_at(this.src, pos as u64) - ZERO;
        if (d > 9) {
          break;
        }
        w = w * 10 + (d as u64);
        pos++;
      }
      if (pos == first) {
        this.pos = pos;
        return this.fail(INVALID_NUMBER);
      }
    }
    const whole = pos - first;
    let q: i64 = 0;
    let integer = true;
    if (pos < len && __intrinsic_str_byte_at(this.src, pos as u64) == DOT) {
      pos++;
      const fraction = pos;
      while (pos < len) {
        const d = __intrinsic_str_byte_at(this.src, pos as u64) - ZERO;
        if (d > 9) {
          break;
        }
        w = w * 10 + (d as u64);
        pos++;
      }
      if (pos == fraction) {
        this.pos = pos;
        return this.fail(INVALID_NUMBER);
      }
      q = -((pos - fraction) as i64);
      integer = false;
    }
    let exact = whole + ((-q) as usize) <= 19;
    if (pos < len) {
      const e = __intrinsic_str_byte_at(this.src, pos as u64);
      if (e == 101 || e == 69) {
        pos++;
        let eneg = false;
        if (pos < len) {
          const sign = __intrinsic_str_byte_at(this.src, pos as u64);
          if (sign == PLUS || sign == MINUS) {
            eneg = sign == MINUS;
            pos++;
          }
        }
        const digits = pos;
        let x: i64 = 0;
        while (pos < len) {
          const d = __intrinsic_str_byte_at(this.src, pos as u64) - ZERO;
          if (d > 9) {
            break;
          }
          x = x * 10 + (d as i64);
          pos++;
        }
        if (pos == digits) {
          this.pos = pos;
          return this.fail(INVALID_NUMBER);
        }
        // A longer exponent: the general parser.
        if (pos - digits > 5) {
          exact = false;
        }
        q += eneg ? -x : x;
        integer = false;
      }
    }
    this.pos = pos;
    this.start = start;
    this.end = pos;
    this.integer = integer;
    this.small = integer && whole <= 15;
    this.exact = exact;
    this.digitsValue = w;
    this.exponent = q;
    this.negative = negative;
    return true;
  }

  /**
   * Lexes the string whose opening quote is at the current position. Without `decode`, escapes
   * are checked but not decoded (`decoded` is then empty).
   */
  string(decode: bool): bool {
    this.pos++;
    const start = this.pos;
    let units: usize = 0;
    let out = "";
    this.escaped = false;
    this.lone = false;
    while (true) {
      const run = this.pos;
      // Up to the next quote, backslash or control character. ASCII runs take the first loop:
      // one compare finds both a control character and a non-ASCII byte (`b - 32` wraps below
      // 32). A run of non-ASCII bytes (a non-Latin word) adjusts the UTF-16 count in a loop of
      // its own: a continuation byte counts no unit, a four-byte lead two. On a local `pos`, as
      // in `peekNonWs`.
      const len = this.len;
      let pos = run;
      let adjust: isize = 0;
      // Sixteen bytes at a time (#1658): a block without a stop byte is all text; its UTF-16
      // count is 16, less one per continuation byte (0x80-0xBF), plus one per four-byte lead
      // (0xF0 and up). A block with a stop ends at its first one, counted the same way over
      // the bytes before it. The rest, and what follows an escape, goes byte by byte below.
      while (pos + 16 <= len) {
        const v = __intrinsic_str_load_u8x16(this.src, pos as u64);
        const stop = velt_simd_mask8x16_or(
          velt_simd_mask8x16_or(
            velt_simd_u8x16_eq(v, velt_simd_u8x16_splat(QUOTE)),
            velt_simd_u8x16_eq(v, velt_simd_u8x16_splat(BACKSLASH)),
          ),
          velt_simd_u8x16_lt(v, velt_simd_u8x16_splat(32)),
        );
        const high = velt_simd_u8x16_ge(v, velt_simd_u8x16_splat(0x80));
        if (!velt_simd_mask8x16_any(stop)) {
          if (velt_simd_mask8x16_any(high)) {
            adjust += unitAdjust(v, high, 0xffff);
          }
          pos += 16;
          continue;
        }
        const i = velt_simd_mask8x16_first(stop);
        if (velt_simd_mask8x16_any(high)) {
          adjust += unitAdjust(v, high, (1 << i) - 1);
        }
        pos += i as usize;
        break;
      }
      while (true) {
        while (pos < len) {
          const b = __intrinsic_str_byte_at(this.src, pos as u64);
          if (b == QUOTE || b == BACKSLASH || b - 32 >= 96) {
            break;
          }
          pos++;
        }
        const ascii = pos;
        while (pos < len) {
          const b = __intrinsic_str_byte_at(this.src, pos as u64);
          if (b < 0x80) {
            break;
          }
          if (b < 0xc0) {
            adjust--;
          } else if (b >= 0xf0) {
            adjust++;
          }
          pos++;
        }
        if (pos == ascii) {
          break;
        }
      }
      this.pos = pos;
      units = ((units + pos - run) as isize + adjust) as usize;
      if (this.pos >= this.len) {
        return this.fail(UNEXPECTED_EOF);
      }
      const b = __intrinsic_str_byte_at(this.src, this.pos as u64);
      if (b == QUOTE) {
        this.start = start;
        this.end = this.pos;
        this.pos++;
        this.units = units;
        if (this.escaped && decode) {
          out += utf8Substring(this.src, run, this.end);
          this.decoded = out;
        }
        return true;
      }
      if (b != BACKSLASH) {
        return this.fail(CONTROL_CHAR);
      }
      if (decode) {
        out += utf8Substring(this.src, run, this.pos);
      }
      this.escaped = true;
      this.pos++;
      const n = this.escape(decode);
      if (n < 0) {
        return false;
      }
      if (decode) {
        out += this.decoded;
      }
      units += n as usize;
    }
    return false;
  }

  /** The text of the last string token (decoded when it had escapes). */
  text(): string {
    if (this.escaped) {
      return this.decoded;
    }
    return utf8Substring(this.src, this.start, this.end);
  }

  // One escape (the backslash consumed): its UTF-16 length, or -1. Decoding puts its text in
  // `decoded`.
  private escape(decode: bool): i32 {
    if (this.pos >= this.len) {
      this.fail(UNEXPECTED_EOF);
      return -1;
    }
    const c = __intrinsic_str_byte_at(this.src, this.pos as u64);
    let unit: u32 = 0;
    if (c == QUOTE || c == BACKSLASH || c == 47) {
      unit = c as u32;
    } else if (c == 98) {
      unit = 8;
    } else if (c == 102) {
      unit = 12;
    } else if (c == 110) {
      unit = 10;
    } else if (c == 114) {
      unit = 13;
    } else if (c == 116) {
      unit = 9;
    } else if (c == 117) {
      this.pos++;
      const cp = this.unicodeEscape();
      if (cp < 0) {
        return -1;
      }
      if (cp >= 0xd800 && cp < 0xe000) {
        this.lone = true;
      }
      if (decode) {
        this.decoded =
          cp < 0x10000
            ? String.fromCharCode(cp as number)
            : String.fromCharCode((0xd800 + ((cp - 0x10000) >> 10)) as number) +
              String.fromCharCode((0xdc00 + ((cp - 0x10000) & 0x3ff)) as number);
      }
      return cp >= 0x10000 ? 2 : 1;
    } else {
      this.fail(INVALID_ESCAPE);
      return -1;
    }
    this.pos++;
    if (decode) {
      this.decoded = String.fromCharCode(unit as number);
    }
    return 1;
  }

  // `XXXX` after `\u`, combined with a following `\uXXXX` low surrogate into the pair's code
  // point; a lone surrogate is kept. -1 on error.
  private unicodeEscape(): i64 {
    const unit = this.hex4();
    if (unit < 0xd800 || unit >= 0xdc00) {
      return unit;
    }
    if (
      this.pos + 1 < this.len &&
      __intrinsic_str_byte_at(this.src, this.pos as u64) == BACKSLASH &&
      __intrinsic_str_byte_at(this.src, (this.pos + 1) as u64) == 117
    ) {
      const save = this.pos;
      this.pos += 2;
      const low = this.hex4();
      if (low < 0) {
        return -1;
      }
      if (low >= 0xdc00 && low < 0xe000) {
        return 0x10000 + ((unit - 0xd800) << 10) + (low - 0xdc00);
      }
      // Not a pair: the second escape is decoded on its own.
      this.pos = save;
    }
    return unit;
  }

  private hex4(): i64 {
    let v: i64 = 0;
    for (let i = 0; i < 4; i++) {
      const d =
        this.pos < this.len ? hexValue(__intrinsic_str_byte_at(this.src, this.pos as u64)) : -1;
      if (d < 0) {
        this.fail(INVALID_U_ESCAPE);
        return -1;
      }
      v = v * 16 + d;
      this.pos++;
    }
    return v;
  }

  private byteIs(b: u8): bool {
    return this.pos < this.len && __intrinsic_str_byte_at(this.src, this.pos as u64) == b;
  }
}

// How the UTF-16 count of the lanes of `v` in `lanes` (a bitmask) differs from their byte
// count: one less per continuation byte, one more per four-byte lead. `high` marks bytes of
// 0x80 and up.
function unitAdjust(v: u8x16, high: mask8x16, lanes: u64): isize {
  const lead4 =
    velt_simd_mask8x16_bitmask(velt_simd_u8x16_ge(v, velt_simd_u8x16_splat(0xf0))) & lanes;
  const cont =
    velt_simd_mask8x16_bitmask(
      velt_simd_mask8x16_and(high, velt_simd_u8x16_lt(v, velt_simd_u8x16_splat(0xc0))),
    ) &
    lanes;
  return (lead4.countOnes() as isize) - (cont.countOnes() as isize);
}

// The value of a hex digit, or -1.
function hexValue(b: u8): i64 {
  if (b - ZERO <= 9) {
    return (b - ZERO) as i64;
  }
  const lower = (b | 0x20) - 97;
  return lower <= 5 ? (lower + 10) as i64 : -1;
}

/** The value of the number token `start`..`end` of `src` (correctly rounded, like `JSON.parse`). */
export function numberF64(src: string, start: usize, end: usize, integer: bool): f64 {
  let i = start;
  const neg = __intrinsic_str_byte_at(src, i as u64) == MINUS;
  if (neg) {
    i++;
  }
  if (integer && end - i <= 15) {
    // Exact: below 2^53.
    let v: u64 = 0;
    while (i < end) {
      v = v * 10 + ((__intrinsic_str_byte_at(src, i as u64) - ZERO) as u64);
      i++;
    }
    return neg ? -(v as f64) : v as f64;
  }
  // One pass over the digits, then velt:number/parse's `decimalValue` (exact arithmetic when
  // it is exact, else Eisel-Lemire); more than 19 digits or an undecided rounding take the
  // general parser.
  const sig = significand(src, start, end);
  if (sig.ok) {
    if (sig.w == 0) {
      return neg ? -0.0 : 0;
    }
    const r = decimalValue(sig.w, sig.q);
    if (r.ok) {
      return neg ? -r.value : r.value;
    }
  }
  return Number(utf8Substring(src, start, end));
}

// A number token's significant digits as an integer `w` (at most 19 of them: `ok` is false for
// more) and its decimal exponent `q`: the value is `w * 10^q`.
struct Significand {
  ok: bool;
  w: u64;
  q: i64;
}

function significand(src: string, start: usize, end: usize): Significand {
  let i = start;
  if (__intrinsic_str_byte_at(src, i as u64) == MINUS) {
    i++;
  }
  let w: u64 = 0;
  let digits = 0;
  let q: i64 = 0;
  let fraction = false;
  while (i < end) {
    const b = __intrinsic_str_byte_at(src, i as u64);
    if (b == DOT) {
      fraction = true;
      i++;
      continue;
    }
    if (b - ZERO > 9) {
      break;
    }
    if (w != 0 || b != ZERO) {
      digits++;
      if (digits > 19) {
        return Significand { ok: false, w: 0, q: 0 };
      }
      w = w * 10 + ((b - ZERO) as u64);
    }
    if (fraction) {
      q--;
    }
    i++;
  }
  if (i < end) {
    // `e` or `E`, a sign, digits (a long exponent: the general parser).
    i++;
    let eneg = false;
    const s = __intrinsic_str_byte_at(src, i as u64);
    if (s == MINUS || s == PLUS) {
      eneg = s == MINUS;
      i++;
    }
    if (end - i > 5) {
      return Significand { ok: false, w: 0, q: 0 };
    }
    let e: i64 = 0;
    while (i < end) {
      e = e * 10 + ((__intrinsic_str_byte_at(src, i as u64) - ZERO) as i64);
      i++;
    }
    q += eneg ? -e : e;
  }
  return Significand { ok: true, w, q };
}

/** The number token as an exact `u64`, or null if it is not an integer in `[0, 2^64)`. */
export function numberU64(src: string, start: usize, end: usize, integer: bool): u64 | null {
  if (!integer) {
    const x = exactInteger(src, start, end);
    // `-0.0` and `-0e5` are 0; any other negative is out of range.
    return x.ok && (!x.neg || x.mag == 0) ? x.mag : null;
  }
  let i = start;
  const neg = __intrinsic_str_byte_at(src, i as u64) == MINUS;
  if (neg) {
    i++;
  }
  const max: u64 = 18446744073709551615;
  let acc: u64 = 0;
  while (i < end) {
    const d = (__intrinsic_str_byte_at(src, i as u64) - ZERO) as u64;
    if (acc > (max - d) / 10) {
      return null;
    }
    acc = acc * 10 + d;
    i++;
  }
  // `-0` is 0; any other negative is out of range.
  return neg && acc != 0 ? null : acc;
}

/** A number token's exact integer value: its sign and magnitude, or `ok` false. */
struct ExactInteger {
  ok: bool;
  neg: bool;
  mag: u64;
}

// The exact value of a number token with a fraction or an exponent, if it is an integer below
// 2^64 (`1.0`, `9007199254740993e0`, `18446744073709551615.000`, `25e-1` is not one): its
// digits read into a `u64` (a zero that no longer fits only scales it; any other digit that
// doesn't fit means more significant digits than 2^64 holds), the exponent applied, trailing
// zeros dropped, then an overflow-checked scale by the power of ten left.
function exactInteger(src: string, start: usize, end: usize): ExactInteger {
  const none = ExactInteger { ok: false, neg: false, mag: 0 };
  const max: u64 = 18446744073709551615;
  let i = start;
  const neg = __intrinsic_str_byte_at(src, i as u64) == MINUS;
  if (neg) {
    i++;
  }
  let w: u64 = 0;
  let q: i64 = 0;
  let fraction = false;
  while (i < end) {
    const b = __intrinsic_str_byte_at(src, i as u64);
    if (b == DOT) {
      fraction = true;
      i++;
      continue;
    }
    if (b - ZERO > 9) {
      break;
    }
    const d = (b - ZERO) as u64;
    if (w > (max - d) / 10) {
      if (d != 0) {
        return none;
      }
      // A zero that doesn't fit: the value is w * 10 at this place.
      if (!fraction) {
        q++;
      }
    } else {
      w = w * 10 + d;
      if (fraction) {
        q--;
      }
    }
    i++;
  }
  if (i < end) {
    // The exponent: `e` or `E`, an optional sign, digits (the scanner checked the token).
    i++;
    let eneg = false;
    const sign = __intrinsic_str_byte_at(src, i as u64);
    if (sign == MINUS || sign == PLUS) {
      eneg = sign == MINUS;
      i++;
    }
    let e: i64 = 0;
    while (i < end) {
      // Past 10^6 the result is 0, too large, or not an integer whatever the digits.
      if (e < 1000000) {
        e = e * 10 + ((__intrinsic_str_byte_at(src, i as u64) - ZERO) as i64);
      }
      i++;
    }
    q += eneg ? -e : e;
  }
  if (w == 0) {
    return ExactInteger { ok: true, neg: neg, mag: 0 };
  }
  while (q < 0 && w % 10 == 0) {
    w = w / 10;
    q++;
  }
  if (q < 0) {
    return none;
  }
  while (q > 0) {
    if (w > max / 10) {
      return none;
    }
    w = w * 10;
    q--;
  }
  return ExactInteger { ok: true, neg: neg, mag: w };
}

/** The number token as an exact `i64`, or null if it is not an integer in range. */
export function numberI64(src: string, start: usize, end: usize, integer: bool): i64 | null {
  if (!integer) {
    const x = exactInteger(src, start, end);
    const limit: u64 = 9223372036854775808;
    if (!x.ok || x.mag > limit || (x.mag == limit && !x.neg)) {
      return null;
    }
    if (x.mag == limit) {
      return -9223372036854775807 - 1;
    }
    return x.neg ? -(x.mag as i64) : x.mag as i64;
  }
  let i = start;
  const neg = __intrinsic_str_byte_at(src, i as u64) == MINUS;
  if (neg) {
    i++;
  }
  // Accumulated negatively, so that i64's minimum fits.
  let acc: i64 = 0;
  const min: i64 = -9223372036854775807 - 1;
  while (i < end) {
    const d = (__intrinsic_str_byte_at(src, i as u64) - ZERO) as i64;
    if (acc < (min + d) / 10) {
      return null;
    }
    acc = acc * 10 - d;
    i++;
  }
  if (neg) {
    return acc;
  }
  return acc == min ? null : -acc;
}

/**
 * JSONC: `src` with its line (`// …`) and block (`/* … *\/`) comments outside strings turned
 * into spaces (newlines kept), so every byte keeps its offset and the scanner never meets a
 * comment: strict JSON pays nothing for JSONC. An unclosed `/*` and a `/` that starts no comment
 * stay, so the scan fails at that byte, as it did when the scanner skipped comments itself.
 */
export function blankComments(src: string): string {
  const n = __intrinsic_str_byte_len(src);
  let i: usize = 0;
  let from: usize = 0;
  let out = "";
  while (i < n) {
    const b = __intrinsic_str_byte_at(src, i as u64);
    if (b == QUOTE) {
      // A string: skip to its closing quote, past escapes.
      i++;
      while (i < n) {
        const c = __intrinsic_str_byte_at(src, i as u64);
        if (c == BACKSLASH) {
          i += 2;
          continue;
        }
        i++;
        if (c == QUOTE) {
          break;
        }
      }
      continue;
    }
    if (b != 47 || i + 1 >= n) {
      i++;
      continue;
    }
    const next = __intrinsic_str_byte_at(src, (i + 1) as u64);
    let end = i;
    if (next == 47) {
      end = i + 2;
      while (end < n && __intrinsic_str_byte_at(src, end as u64) != 10) {
        end++;
      }
    } else if (next == 42) {
      let j = i + 2;
      while (
        j + 1 < n &&
        !(
          __intrinsic_str_byte_at(src, j as u64) == 42 &&
          __intrinsic_str_byte_at(src, (j + 1) as u64) == 47
        )
      ) {
        j++;
      }
      if (j + 1 >= n) {
        // Unclosed: left for the scan to fail at.
        break;
      }
      end = j + 2;
    } else {
      i++;
      continue;
    }
    out += utf8Substring(src, from, i);
    for (let k = i; k < end; k++) {
      out += __intrinsic_str_byte_at(src, k as u64) == 10 ? "\n" : " ";
    }
    i = end;
    from = end;
  }
  if (from == 0) {
    return src;
  }
  return out + utf8Substring(src, from, n);
}
