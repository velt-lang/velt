// std/url: WHATWG-style `URL` and `URLSearchParams`, plus JS's `encodeURIComponent` family.
//
// Parsing follows the WHATWG URL Standard for the inputs people write (std/url/record.vlt):
// special schemes (http https ws wss ftp file) get lowercased hosts, dropped default ports,
// `\` as a path separator and dot-segment removal; other schemes keep opaque hosts and paths.
// Components are percent-encoded with the spec's encode sets. Known gaps: no IDNA/punycode
// (a non-ASCII host is invalid), IPv6 literals are validated loosely and not compressed
// (`[0:0::1]` stays as written), and `file:` URLs have no Windows drive-letter quirks.
//
// Mutation: `searchParams` returns a copy; to change the query, edit the copy and assign it
// back (`const p = u.searchParams; p.set("a", "1"); u.searchParams = p;`). Setters follow JS:
// invalid values are ignored, except `href`, which throws like JS. Like the WHATWG setters, the
// ones that run the URL parser drop tabs and newlines from the value first.

import {
  UrlRecord,
  parseUrl,
  parsePath,
  serialize,
  isSpecial,
  defaultPort,
  removeTabNewline,
  setFileHost,
} from "velt:url/record";
import { parseHost } from "velt:url/host";
import {
  FRAGMENT,
  QUERY,
  SPECIAL_QUERY,
  USERINFO,
  FORM,
  encodeSet,
  encodeUri,
  decodeUri,
  decodeLenient,
} from "velt:url/encode";

// Thrown for invalid URLs (`Invalid URL: <input>`) and malformed escapes (`URI malformed`).
export class UrlError extends Error {}

// A parsed absolute URL (JS `URL`).
export class URL {
  private rec: UrlRecord;

  // Parses `input`, resolved against `base` when it is relative; throws `UrlError`.
  constructor(input: string, base: string | null = null) {
    this.rec = parseOrThrow(input, base);
  }

  // Like the constructor, but null instead of throwing (JS `URL.parse`).
  static parse(input: string, base: string | null = null): URL | null {
    try {
      return new URL(input, base);
    } catch (e) {
      return null;
    }
  }

  // Whether `new URL(input, base)` would succeed.
  static canParse(input: string, base: string | null = null): bool {
    return URL.parse(input, base) != null;
  }

  // The whole URL; assigning reparses it (throws `UrlError` if invalid).
  get href(): string {
    return serialize(this.rec);
  }

  set href(v: string) {
    this.rec = parseOrThrow(v, null);
  }

  // The scheme with its colon, e.g. `https:`.
  get protocol(): string {
    return `${this.rec.scheme}:`;
  }

  // Switches between schemes of the same kind (special or not), like JS.
  set protocol(value: string) {
    const v = removeTabNewline(value);
    const colon = v.indexOf(":");
    const scheme = (colon >= 0 ? v.slice(0, colon) : v.clone()).toLowerCase();
    if (!validScheme(scheme) || isSpecial(scheme) != isSpecial(this.rec.scheme)) {
      return;
    }
    if (this.rec.port == defaultPort(scheme)) {
      this.rec.port = "";
    }
    this.rec.scheme = scheme;
  }

  // Percent-encoded user name ("" if none).
  get username(): string {
    return this.rec.username.clone();
  }

  set username(v: string) {
    if (this.canHaveCredentials()) {
      this.rec.username = encodeSet(v, USERINFO);
    }
  }

  // Percent-encoded password ("" if none).
  get password(): string {
    return this.rec.password.clone();
  }

  set password(v: string) {
    if (this.canHaveCredentials()) {
      this.rec.password = encodeSet(v, USERINFO);
    }
  }

  // `hostname:port`, or just the hostname when the port is absent or the scheme's default.
  get host(): string {
    if (this.rec.port.length > 0) {
      return `${this.rec.host}:${this.rec.port}`;
    }
    return this.rec.host.clone();
  }

  // Takes the host (and a port after `:`) up to the first `/`, `?` or `#`; ignored when the
  // host is invalid or empty, and an empty port keeps the current one.
  set host(v: string) {
    if (this.rec.opaque) {
      return;
    }
    const text = hostInput(v, isSpecial(this.rec.scheme));
    if (this.rec.scheme == "file") {
      setFileHost(this.rec, text);
      return;
    }
    const colon = portColon(text);
    if (colon < 0) {
      this.applyHost(text);
      return;
    }
    if (colon == 0 || !this.applyHost(text.slice(0, colon))) {
      return;
    }
    const port = text.slice(colon + 1);
    if (port.length > 0) {
      this.port = port;
    }
  }

  // The host without the port (lowercased for special schemes; IPv6 keeps its brackets).
  get hostname(): string {
    return this.rec.host.clone();
  }

  // Like `host`, but a value with a port (`h:8`) is ignored.
  set hostname(v: string) {
    if (this.rec.opaque) {
      return;
    }
    const text = hostInput(v, isSpecial(this.rec.scheme));
    if (this.rec.scheme == "file") {
      setFileHost(this.rec, text);
    } else if (portColon(text) < 0) {
      this.applyHost(text);
    }
  }

  // The port as written ("" when absent or the scheme's default, e.g. 443 for https).
  get port(): string {
    return this.rec.port.clone();
  }

  // Takes the leading digits of `v` ("" clears the port); ignored when out of range.
  set port(value: string) {
    if (!this.canHaveCredentials()) {
      return;
    }
    const v = removeTabNewline(value);
    let n: i64 = 0;
    let digits: i64 = 0;
    while (digits < (v.length as i64) && v.charCodeAt(digits) >= 48 && v.charCodeAt(digits) <= 57) {
      n = n * 10 + v.charCodeAt(digits) - 48;
      digits++;
      if (n > 65535) {
        return;
      }
    }
    if (digits == 0) {
      if (v.length == 0) {
        this.rec.port = "";
      }
      return;
    }
    const port = `${n}`;
    this.rec.port = port == defaultPort(this.rec.scheme) ? "" : port;
  }

  // The path, e.g. `/a/b` (percent-encoded; for `mailto:x` it is `x`).
  get pathname(): string {
    return this.rec.path.clone();
  }

  set pathname(v: string) {
    if (!this.rec.opaque) {
      this.rec.path = parsePath(removeTabNewline(v), [], isSpecial(this.rec.scheme));
    }
  }

  // `?` + the query, or "" when the query is absent or empty.
  get search(): string {
    return this.rec.query.length == 0 ? "" : `?${this.rec.query}`;
  }

  set search(v: string) {
    this.rec.hasQuery = v.length > 0;
    const set = isSpecial(this.rec.scheme) ? SPECIAL_QUERY : QUERY;
    this.rec.query = encodeSet(removeTabNewline(v.startsWith("?") ? v.slice(1) : v.clone()), set);
  }

  // `#` + the fragment, or "" when it is absent or empty.
  get hash(): string {
    return this.rec.fragment.length == 0 ? "" : `#${this.rec.fragment}`;
  }

  set hash(v: string) {
    this.rec.hasFragment = v.length > 0;
    this.rec.fragment = encodeSet(
      removeTabNewline(v.startsWith("#") ? v.slice(1) : v.clone()),
      FRAGMENT,
    );
  }

  // `scheme://host[:port]` for http(s), ws(s) and ftp; "null" for other schemes (JS).
  get origin(): string {
    if (!isSpecial(this.rec.scheme) || this.rec.scheme == "file") {
      return "null";
    }
    return `${this.rec.scheme}://${this.host}`;
  }

  // A copy of the parsed query (see the header for how to write it back).
  get searchParams(): URLSearchParams {
    return new URLSearchParams(this.rec.query);
  }

  // Replaces the query with `p` serialized (no query if `p` is empty).
  set searchParams(p: URLSearchParams) {
    this.rec.query = p.toString();
    this.rec.hasQuery = this.rec.query.length > 0;
  }

  // Same as `href`.
  toString(): string {
    return this.href;
  }

  // Same as `href` (JS `toJSON`).
  toJSON(): string {
    return this.href;
  }

  // Sets the (non-file) host from `text`, which has no port; false (URL unchanged) if it is
  // invalid, or empty where WHATWG does not allow that: for special schemes, and when the URL
  // has credentials or a port.
  private applyHost(text: string): bool {
    const special = isSpecial(this.rec.scheme);
    if (text.length == 0 && (special || userinfoOrPort(this.rec))) {
      return false;
    }
    const host = parseHost(text, special);
    if (host == null) {
      return false;
    }
    this.rec.hasHost = true;
    this.rec.host = host;
    return true;
  }

  private canHaveCredentials(): bool {
    return this.rec.host.length > 0 && this.rec.scheme != "file";
  }
}

function parseOrThrow(input: string, base: string | null): UrlRecord {
  let baseRec: UrlRecord | null = null;
  if (base != null) {
    baseRec = parseUrl(base, null);
    if (baseRec == null) {
      throw new UrlError(`Invalid base URL: ${base}`);
    }
  }
  const rec = parseUrl(input, baseRec);
  if (rec == null) {
    throw new UrlError(`Invalid URL: ${input}`);
  }
  return rec;
}

// A host setter's value: tabs and newlines removed, cut at the first `/`, `?` or `#` (or `\`
// for special schemes).
function hostInput(v: string, special: bool): string {
  const s = removeTabNewline(v);
  for (let i: i64 = 0; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    if (c == 47 || c == 63 || c == 35 || (special && c == 92)) {
      return s.slice(0, i);
    }
  }
  return s;
}

// Index of the `:` before a port (outside an IPv6 literal's brackets), or -1.
function portColon(text: string): i64 {
  return text.indexOf(":", text.startsWith("[") ? text.indexOf("]") : 0);
}

function userinfoOrPort(r: UrlRecord): bool {
  return r.username.length > 0 || r.password.length > 0 || r.port.length > 0;
}

function validScheme(s: string): bool {
  if (s.length == 0) {
    return false;
  }
  for (let i: i64 = 0; i < (s.length as i64); i++) {
    const c = s.charCodeAt(i);
    const letter = c >= 97 && c <= 122;
    const other = (c >= 48 && c <= 57) || c == 43 || c == 45 || c == 46;
    if (!letter && (i == 0 || !other)) {
      return false;
    }
  }
  return true;
}

// An ordered list of name/value pairs in `application/x-www-form-urlencoded` form (JS
// `URLSearchParams`). Names may repeat; order is kept.
export class URLSearchParams {
  private names: string[] = [];
  private vals: string[] = [];

  // Parses a query string (a leading `?` is skipped; `+` means space; bad escapes stay literal).
  constructor(init: string = "") {
    const start: i64 = init.startsWith("?") ? 1 : 0;
    for (const part of init.slice(start).split("&")) {
      if (part.length == 0) {
        continue;
      }
      const eq = part.indexOf("=");
      if (eq < 0) {
        this.append(decodeLenient(part, true), "");
      } else {
        this.append(
          decodeLenient(part.slice(0, eq), true),
          decodeLenient(part.slice(eq + 1), true),
        );
      }
    }
  }

  // Number of pairs.
  get size(): usize {
    return this.names.length;
  }

  // The first value for `name`, or null.
  get(name: string): string | null {
    for (let i: usize = 0; i < this.names.length; i++) {
      if (this.names[i] == name) {
        return this.vals[i].clone();
      }
    }
    return null;
  }

  // Every value for `name`, in order.
  getAll(name: string): string[] {
    const out: string[] = [];
    for (let i: usize = 0; i < this.names.length; i++) {
      if (this.names[i] == name) {
        out.push(this.vals[i].clone());
      }
    }
    return out;
  }

  // Whether a pair named `name` (with value `value`, if given) exists.
  has(name: string, value: string | null = null): bool {
    for (let i: usize = 0; i < this.names.length; i++) {
      if (this.names[i] == name && (value == null || this.vals[i] == value)) {
        return true;
      }
    }
    return false;
  }

  // Adds a pair at the end.
  append(name: string, value: string) {
    this.names.push(name);
    this.vals.push(value);
  }

  // Sets the first pair named `name` to `value` and removes the others (appends if none).
  set(name: string, value: string) {
    let found = false;
    let w: usize = 0;
    for (let i: usize = 0; i < this.names.length; i++) {
      if (this.names[i] == name) {
        if (found) {
          continue;
        }
        found = true;
        this.vals[i] = value.clone();
      }
      __intrinsic_array_swap(this.names, w, i);
      __intrinsic_array_swap(this.vals, w, i);
      w++;
    }
    __intrinsic_array_truncate(this.names, w);
    __intrinsic_array_truncate(this.vals, w);
    if (!found) {
      this.append(name, value);
    }
  }

  // Removes every pair named `name` (with value `value`, if given).
  delete(name: string, value: string | null = null) {
    let w: usize = 0;
    for (let i: usize = 0; i < this.names.length; i++) {
      if (this.names[i] == name && (value == null || this.vals[i] == value)) {
        continue;
      }
      __intrinsic_array_swap(this.names, w, i);
      __intrinsic_array_swap(this.vals, w, i);
      w++;
    }
    __intrinsic_array_truncate(this.names, w);
    __intrinsic_array_truncate(this.vals, w);
  }

  // Stable sort by name (bytewise, which matches JS's UTF-16 order for ASCII names).
  sort() {
    const pairs = this.entries();
    pairs.sort((a, b) => a[0].compareTo(b[0]) as number);
    this.names = pairs.map((p) => p[0].clone());
    this.vals = pairs.map((p) => p[1].clone());
  }

  // The names, in order (repeats included).
  keys(): string[] {
    return this.names.clone();
  }

  // The values, in order.
  values(): string[] {
    return this.vals.clone();
  }

  // `[name, value]` pairs, in order.
  entries(): [string, string][] {
    const out: [string, string][] = [];
    for (let i: usize = 0; i < this.names.length; i++) {
      out.push([this.names[i].clone(), this.vals[i].clone()]);
    }
    return out;
  }

  // `a=1&b=x+y` (form encoding: space as `+`, everything but `*-._` and alphanumerics escaped).
  toString(): string {
    const parts: string[] = [];
    for (let i: usize = 0; i < this.names.length; i++) {
      parts.push(`${encodeSet(this.names[i], FORM)}=${encodeSet(this.vals[i], FORM)}`);
    }
    return parts.join("&");
  }
}

// JS `encodeURIComponent`: escapes everything except alphanumerics and `-_.!~*'()`; throws
// `UrlError("URI malformed")` on a lone surrogate, as JS throws `URIError`.
export function encodeURIComponent(s: string): string {
  const out = encodeUri(s, false);
  if (out == null) {
    throw new UrlError("URI malformed");
  }
  return out;
}

// JS `encodeURI`: like `encodeURIComponent`, but keeps `;,/?:@&=+$#`.
export function encodeURI(s: string): string {
  const out = encodeUri(s, true);
  if (out == null) {
    throw new UrlError("URI malformed");
  }
  return out;
}

// JS `decodeURIComponent`; throws `UrlError("URI malformed")` on a bad escape or invalid UTF-8.
export function decodeURIComponent(s: string): string {
  const out = decodeUri(s, false);
  if (out == null) {
    throw new UrlError("URI malformed");
  }
  return out;
}

// JS `decodeURI`: like `decodeURIComponent`, but escapes of `;/?:@&=+$,#` stay escaped.
export function decodeURI(s: string): string {
  const out = decodeUri(s, true);
  if (out == null) {
    throw new UrlError("URI malformed");
  }
  return out;
}
