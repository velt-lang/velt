// velt/task (internal): running a function and catching the Velt panic that unwinds out of it
// (docs/internals/design/unwinding.md), for the executor's catch at a started promise and for
// `catchPanic`.

import { stateDrop } from "velt/lang/intrinsics";
import { catchUnwind, catchUnwindAt } from "velt/lang/intrinsics/unwind";
import {
  caughtPanic,
  catchesPanics,
  enterCatch,
  leaveCatch,
  takePanic,
} from "velt/lang/hooks/unwind";

declare function velt_rt_xfer_suspend(): u32;
declare function velt_rt_xfer_resume(depth: u32): void;
declare function velt_rt_xfer_end(): void;

/**
 * Whether `catchVeltPanic` catches here: false where generated code doesn't catch (WebAssembly,
 * Windows for now, the `velt dev` JIT), where a panic in `f` ends the process.
 */
export function canCatchPanics(): bool {
  return catchesPanics();
}

/**
 * Calls `f`; returns null when it returns, or the panic's message when a Velt panic unwound out
 * of it (the message is printed to stderr when it happens, as an uncaught one is). What `f` was
 * doing is abandoned, not undone: the frames it unwound drop what they owned (their cleanup
 * pads), but a half-made change stays half made and a lock they held stays held. Any other
 * exception passes through. Where generated code doesn't catch (WebAssembly, Windows for now, the
 * `velt dev` JIT), `f` is called plainly and a panic in it ends the process as any other does.
 */
export function catchVeltPanic(f: () => void): string | null {
  // SAFETY: the exception object is taken once, below.
  const e = unsafe { catchPanicRaw(f) };
  if (e == 0) {
    return null;
  }
  // SAFETY: `e` is the exception `catchPanicRaw` returned, taken here once.
  return unsafe { takePanic(e) };
}

/**
 * `catchVeltPanic`, with the exception object itself in place of the message: 0 when `f`
 * returned. Unsafe: the caller owns the object (`panicText` reads its message, `takePanic` reads
 * and frees it).
 */
export unsafe function catchPanicRaw(f: () => void): usize {
  if (!enterCatch()) {
    f();
    return 0;
  }
  // SAFETY: the exception object goes to the caller, who owns it.
  const e = unsafe { catchUnwind(f) };
  leaveCatch();
  if (e != 0) {
    caughtPanic();
    caught();
  }
  return e;
}

/**
 * `catchPanicRaw` of the function at address `code` (an `fnAddress` taking one pointer-sized
 * number) called with `arg`, with no function value to call through. Unsafe: as
 * `catchPanicRaw`, and `code` must be such an address.
 */
export unsafe function catchPanicAt(code: usize, arg: usize): usize {
  if (!enterCatch()) {
    // SAFETY: the caller's statement: `code` takes one pointer-sized number, returns nothing.
    unsafe {
      stateDrop(code, arg);
    }
    return 0;
  }
  // SAFETY: the exception object goes to the caller, who owns it.
  const e = unsafe { catchUnwindAt(code, arg) };
  leaveCatch();
  if (e != 0) {
    caughtPanic();
    caught();
  }
  return e;
}

/**
 * After a caught panic: the state the panicked code left open on this thread is closed, as the
 * runtime's own catch does (`velt_rt::panic::catch`).
 */
function caught() {
  // A panic inside a transfer (a value going to `spawn` that can't, a copy that failed) left its
  // depth up: every later transfer of this thread would nest in it. `f` runs as user code, where
  // the depth is 0 (a transfer suspends around the user code it calls), so close what is open:
  // `suspend` reads the depth (and sets the open transfer aside), `resume` takes it back, and each
  // `end` closes one level; the last clears its copies and releases the references it deferred,
  // which belonged to the transfer, not to the abandoned frames.
  const depth = velt_rt_xfer_suspend();
  if (depth > 0) {
    velt_rt_xfer_resume(depth);
    for (let i: u32 = 0; i < depth; i++) {
      velt_rt_xfer_end();
    }
  }
}
