// velt/task (internal): `AbortSignal`, whether and why an operation was aborted. A signal's
// runtime object is owned by a `shared` cell (atomic, so `spawn` shares it rather than copying
// it) and released once, at the cell's last reference.

import { AbortError, DEFAULT_REASON } from "velt/task/errors";
import {
  velt_rt_signal_abort,
  velt_rt_signal_aborted,
  velt_rt_signal_any,
  velt_rt_signal_free,
  velt_rt_signal_new,
  velt_rt_signal_reason,
  velt_rt_signal_wait,
} from "velt/task/rt";
import { TIMEOUT_MARK, arm, timeoutMs } from "velt/task/signal_timeout";
import { TimeoutError } from "velt/task/timeout";
import { INSPECT } from "velt/lang/hooks/keys";

// The message of the reason a timeout's signal gets, as in Node.
const TIMEOUT_MESSAGE: string = "The operation was aborted due to timeout";

/**
 * The first byte of a runtime abort message meaning "the reason is an `AbortError` with the rest
 * as its message" (std only): a plain `abort()` and a `TaskScope`'s aborts use it, so that their
 * reason is told apart from a string given to `abort(reason)`, which is that string (an
 * `AbortSignal.any` reads its first aborting source's message). A user's reason that starts with
 * a mark byte is escaped (`ESCAPE`), so none is read as a mark; one equal to `PLAIN_ABORT` itself
 * is taken as a plain `abort()` (`abortAs`).
 */
export const ABORT_ERROR: string = "\u0000";

/**
 * The first byte of the runtime abort message of a user's reason that starts with a mark byte
 * (`ABORT_ERROR`, signal_timeout.velt `TIMEOUT_MARK`, or this one): the reason follows unchanged.
 * Reasons are strings for now; the marks go once they are objects (#3014).
 */
const ESCAPE: string = "\u0002";

// The runtime abort message of a user's `reason` (`ESCAPE`).
function escaped(reason: string): string {
  if (
    reason.startsWith(ABORT_ERROR) || reason.startsWith(TIMEOUT_MARK) || reason.startsWith(ESCAPE)
  ) {
    return ESCAPE + reason;
  }
  return reason;
}

/** The message of a plain `abort()`: Node's `AbortError` (std only). */
export const PLAIN_ABORT: string = "\u0000This operation was aborted";

// A signal's reason once there is one: allocated only then, so a signal never given or asked
// its reason costs what it did before.
class Kept {
  reason: any;

  constructor(reason: any) {
    this.reason = reason;
  }
}

// Owns one runtime signal (not exported: only this module makes signals). Lives in a `shared`
// cell, so it is released exactly once, when the last signal or controller using it goes away.
// It also keeps the signal's reason once there is one, so that every task reads the same value
// (a value read out of the cell is a copy: one object across reads is #3011).
class SignalObj {
  private handle: u64;
  private held: Kept | null = null;

  constructor(handle: u64) {
    this.handle = handle;
  }

  raw(): u64 {
    return this.handle;
  }

  /** The reason kept so far, if any. */
  kept(): Kept | null {
    return this.held;
  }

  /** Keeps `reason` unless one is kept already: then the one kept, else null. */
  keep(reason: any): Kept | null {
    if (this.held !== null) {
      return this.held;
    }
    this.held = new Kept(reason);
    return null;
  }

  [Symbol.dispose]() {
    if (this.handle != 0) {
      velt_rt_signal_free(this.handle);
      this.handle = 0;
    }
  }
}

type SignalCell = shared<Mutex<SignalObj>>;

export function signalCell(handle: u64): SignalCell {
  return shared(new Mutex<SignalObj>(new SignalObj(handle)));
}

// `message` without its `ABORT_ERROR` mark, if it has one.
function withoutMark(message: string): string {
  return message.startsWith(ABORT_ERROR) ? message.slice(1) : message;
}

/** The receiving half: tells work that it should stop. */
export class AbortSignal {
  // Keeps the runtime signal alive; `h` is its handle, valid as long as `cell` is.
  #cell: SignalCell;
  #h: u64;
  // Made by `AbortSignal.any`: its reason is the first aborted source's (`anyReason`).
  #any: bool = false;
  // A timer may abort it: an `AbortSignal.timeout`, or an `AbortSignal.any` of one.
  #timed: bool = false;
  // An `AbortSignal.timeout`'s delay (its reason's `ms`), else -1.
  #delay: i64 = -1;

  /**
   * Made by `AbortController`, `taskScope` and the static constructors (`SignalCell` is
   * internal).
   */
  constructor(cell: SignalCell) {
    this.#h = cell.with((s) => s.raw());
    this.#cell = cell;
  }

  private handle(): u64 {
    return this.#h;
  }

  // The signal behind a runtime signal handle the caller owns (std only: the runtime's own
  // signals, such as the dev-mode stop request std/net/http/server/dev.velt joins).
  private static adopt(handle: u64): AbortSignal {
    return new AbortSignal(signalCell(handle));
  }

  /** Whether `abort()` was called (or the timeout elapsed). */
  get aborted(): bool {
    return velt_rt_signal_aborted(this.handle());
  }

  /**
   * Why the signal was aborted (`undefined` while it is not), as in Node: the string passed to
   * `abort(reason)` (a string only, for now: #3014), else a `DOMException` named `AbortError` ("This
   * operation was aborted", or the scope's message for a `TaskScope`), or `TimeoutError` for an
   * `AbortSignal.timeout`. An `AbortSignal.any` has its first aborted source's reason. Each
   * read gives an equal copy (Node gives one object, `===`: #3011).
   */
  get reason(): any {
    if (!this.aborted) {
      return undefined;
    }
    const kept = this.#cell.with((s) => s.kept());
    if (kept !== null) {
      return kept.reason;
    }
    // Not kept: made from what the runtime knows, the same value on every read (so nothing is
    // stored, and a signal never given a reason costs what it did before).
    if (this.#any) {
      return this.anyReason();
    }
    // An `AbortSignal.timeout`'s: only its timer aborts it.
    if (this.#delay >= 0) {
      return new TimeoutError(this.#delay, TIMEOUT_MESSAGE);
    }
    // A runtime signal's own message (one std did not abort) is an `AbortError` too.
    return new AbortError(withoutMark(velt_rt_signal_reason(this.handle())));
  }

  // Keeps the reason of the source among `signals` with handle `h` (aborted already) as this
  // `AbortSignal.any`'s: only then, so a wait on sources none of which is aborted allocates
  // nothing for it.
  private keepFirst(signals: AbortSignal[], h: u64) {
    for (const s of signals) {
      if (s.handle() == h) {
        const r = s.reason;
        this.#cell.with((c) => c.keep(r));
        return;
      }
    }
  }

  // The reason of the source that aborted this `AbortSignal.any` first, as Node keeps it, read
  // from the message the runtime aborted it with, the only record of which source that was: a
  // timeout's (signal_timeout.velt `TIMEOUT_MARK`, with its delay) is a `TimeoutError`, the
  // default a marked one (`ABORT_ERROR`: `abort()`, a scope) an `AbortError`, any other the string
  // `abort(reason)` gave (`ESCAPE`d when it starts with a mark byte; reasons are strings, so that
  // is exact: other values are #3014). Carrying the delay beside the message instead would take a
  // runtime function of its own. Nothing else about the sources is stored: an array field costs
  // allocations on every `any`, an h2 stream's wait among them (only timed sources are kept).
  private anyReason(): any {
    const first = velt_rt_signal_reason(this.handle());
    if (first.startsWith(ESCAPE)) {
      return first.slice(1);
    }
    const ms = timeoutMs(first);
    if (ms >= 0) {
      return new TimeoutError(ms, TIMEOUT_MESSAGE);
    }
    if (first.startsWith(ABORT_ERROR)) {
      return new AbortError(withoutMark(first));
    }
    return first;
  }

  /**
   * Throws the signal's reason if it is aborted, as Node does (a copy of it: #3011).
   * A reason that is not an `AbortError` is thrown as an `AbortError` whose `cause` it is (#3005).
   */
  throwIfAborted() throws AbortError {
    if (this.aborted) {
      const r = this.reason;
      if (r instanceof AbortError) {
        throw r;
      }
      // Not an `AbortError` (a `TimeoutError` is one): the string `abort(reason)` gave.
      throw AbortError.of(typeof r === "string" ? r : DEFAULT_REASON);
    }
  }

  // Aborts the signal with Node's `AbortError` (std only: `abort()` without a reason). Nothing
  // is kept: the reason is made when it is read.
  private abortPlain() {
    if (!this.aborted) {
      velt_rt_signal_abort(this.handle(), PLAIN_ABORT);
    }
  }

  // Aborts the signal with `reason`, `PLAIN_ABORT` for none (std only: `AbortController.abort`
  // and `AbortSignal.abort`).
  private abortAs(reason: string) {
    if (reason == PLAIN_ABORT) {
      this.abortPlain();
    } else {
      this.abortWith(reason);
    }
  }

  // Aborts the signal with `reason`, unless it is aborted already (std only: `abort(reason)`).
  private abortWith(reason: string) {
    if (this.aborted) {
      return;
    }
    // Kept first, so a task the abort wakes reads it.
    this.#cell.with((s) => s.keep(reason));
    velt_rt_signal_abort(this.handle(), escaped(reason));
  }

  /**
   * Resolves once the signal is aborted (never, if it never is). Race it directly against
   * work: `Promise.race([work(), signal.whenAborted()])`. Waiting for a signal a timer aborts
   * (`AbortSignal.timeout`, or an `AbortSignal.any` of one) keeps the process alive, like waiting
   * for a timer (Node unrefs that timer, but then nothing awaiting the signal would run); a signal
   * only `abort()` can abort leaves that to whoever may call it.
   */
  whenAborted(): Promise<void> {
    return velt_rt_signal_wait(this.handle(), this.#timed);
  }

  /**
   * A signal that aborts by itself after `ms` milliseconds, with a `TimeoutError` ("The
   * operation was aborted due to timeout") as its reason.
   */
  static timeout(ms: i64): AbortSignal {
    // A negative delay is none (Node throws a `RangeError`).
    const delay = ms < 0 ? 0 : ms;
    const s = new AbortSignal(signalCell(velt_rt_signal_new()));
    arm(s.handle(), delay);
    s.#timed = true;
    s.#delay = delay;
    return s;
  }

  /**
   * A signal that aborts as soon as any of `signals` does, with its reason. It keeps those
   * signals alive until then.
   */
  static any(signals: AbortSignal[]): AbortSignal {
    const handles: u64[] = [];
    // The first source aborted already, in their order: its reason is the new signal's (as Node).
    let first: u64 = 0;
    let timed = false;
    for (const s of signals) {
      if (first == 0 && velt_rt_signal_aborted(s.handle())) {
        first = s.handle();
      }
      timed = timed || s.#timed;
      handles.push(s.handle());
    }
    const any = new AbortSignal(signalCell(velt_rt_signal_any(handles)));
    any.#any = true;
    any.#timed = timed;
    if (first != 0) {
      any.keepFirst(signals, first);
    }
    return any;
  }

  /** A signal aborted already, with `reason` (Node's `AbortError` without one). */
  static abort(reason: string = PLAIN_ABORT): AbortSignal {
    const s = new AbortSignal(signalCell(velt_rt_signal_new()));
    s.abortAs(reason);
    return s;
  }

  /** How `console.log` shows the signal, like Node: `AbortSignal { aborted: false }`. */
  [INSPECT]() {
    return { aborted: this.aborted };
  }
}
