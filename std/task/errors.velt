// velt/task (internal): `AbortError`, what an aborted signal throws.

import { DOMException } from "velt/lang/dom_exception";

export const DEFAULT_REASON: string = "This operation was aborted";

/**
 * Thrown by `throwIfAborted()` and by work given an aborted signal: Node's `DOMException` named
 * `AbortError` (`code` 20), with the signal's reason as its message ("This operation was
 * aborted" for `abort()`). A signal aborted with a reason that is not an `AbortError` throws one
 * whose `cause` is that reason (#3005: Node throws the value itself).
 *
 * A reason is a string (`abort(reason: string)`; other values are #3014), and so is the cause:
 * an error holding a value of any type could hold an object that holds the error, which would
 * make every `Error` in a program cycle-capable (docs/internals/design/cycles.md, #3119).
 */
export class AbortError extends DOMException {
  #cause: string | undefined = undefined;

  constructor(message: string = DEFAULT_REASON, name: string = "AbortError") {
    super(message, name);
  }

  /** The reason the signal was aborted with, when it is not an `AbortError` (else `undefined`). */
  get cause(): string | undefined {
    return this.#cause;
  }

  /** An `AbortError` for a signal aborted with `reason`, which it keeps as `cause`. */
  static of(reason: string): AbortError {
    const e = new AbortError(reason);
    e.#cause = reason;
    return e;
  }
}
