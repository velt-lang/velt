// velt/task (internal): `catchPanic`'s catch (std/task/panic.velt), the runtime's: the default
// variant of `#task-catch` (under `VELT_SCHEDULER=std`, the executor in Velt's: catch_sched.velt).

import {
  velt_rt_catch_arm,
  velt_rt_catch_free,
  velt_rt_catch_message,
  velt_rt_catch_settled,
  velt_rt_catch_take,
} from "velt/task/rt";

/** The next promise started on this thread catches panics. */
export function arm(): void {
  velt_rt_catch_arm();
}

/** The promise that took the arming, as a handle (0: none did); disarms. */
export function take(): u64 {
  return velt_rt_catch_take();
}

/** Waits until promise `h` finished, without claiming its result: true when it panicked. */
export function settled(h: u64): Promise<bool> {
  return velt_rt_catch_settled(h);
}

/** The panic message of promise `h`. */
export function message(h: u64): string {
  return velt_rt_catch_message(h);
}

/** Releases handle `h`. */
export function free(h: u64): void {
  velt_rt_catch_free(h);
}
