// velt/task (internal): `catchPanic`'s catch (std/task/panic.velt), the runtime's: the default
// variant of `#task-catch`, which only WebAssembly builds use (velt_rt_wasm's catch; native builds
// use the executor in Velt's, catch_sched.velt).

declare function velt_rt_catch_arm();
declare function velt_rt_catch_take(): u64;
declare async function velt_rt_catch_settled(h: u64): Promise<bool>;
declare function velt_rt_catch_message(h: u64): string;
declare function velt_rt_catch_free(h: u64);

/**
 * `take`'s answer when no promise took the arming, which the runtime's catch doesn't tell: its
 * `take` gives 0 then, so `catchPanic` awaits the body's promise unguarded, as it always has
 * here (this executor is being retired, #2196).
 */
export const NONE: u64 = 1;

/** While `catchPanic` calls its body: nothing here (the runtime keeps its own catch). */
export function bodyCatching(on: bool): void {}

/** The next promise started on this thread catches panics. Returns 0 (the runtime keeps its own). */
export function arm(): u64 {
  velt_rt_catch_arm();
  return 0;
}

/** The promise that took the arming, as a handle (0: none did); disarms. `outer`: `arm`'s result. */
export function take(outer: u64): u64 {
  return velt_rt_catch_take();
}

/** Waits until promise `h` finished, without claiming its result: true when it panicked. */
export function settled(h: u64): Promise<bool> {
  return velt_rt_catch_settled(h);
}

/** The panic message of promise `h`. */
export function message(h: u64): string {
  return velt_rt_catch_message(h);
}

/** Releases handle `h`. */
export function free(h: u64): void {
  velt_rt_catch_free(h);
}
