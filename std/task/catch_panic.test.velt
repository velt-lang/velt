// velt/task (tests): what `catchPanic` leaves behind under the executor in Velt
// (std/task/catch_sched.velt, docs/internals/design/unwinding.md). A panicked promise's
// exception comes from C's `malloc`, which the block counters do not see, so the leak checks of
// the goldens cannot tell whether it is freed: these count the exceptions themselves.
import { describe, expect, it } from "velt/test";
import { livePanics, unwoundFramesDrop } from "velt/lang/hooks/unwind";
import { catchPanic, PanicError } from "velt/task";
import { canCatchPanics } from "velt/task/unwind";

async function boom(i: number): Promise<number> {
  await yieldNow();
  panic("boom " + i);
  return 1;
}

// Starts the promise, does other work, then awaits it: the panic is raised again here.
async function later(i: number): Promise<number> {
  const p = boom(i);
  await yieldNow();
  await yieldNow();
  return await p;
}

// Nobody awaits the promise that panicked.
async function unawaited(i: number): Promise<number> {
  const p = boom(i);
  await yieldNow();
  await yieldNow();
  await yieldNow();
  return i;
}

async function caught(run: () => Promise<number>): Promise<bool> {
  try {
    await catchPanic(run);
    return false;
  } catch (e) {
    return e instanceof PanicError;
  }
}

describe("catchPanic", () => {
  it("frees the exception of each panicked promise with the promise", async () => {
    // Where unwound frames drop nothing (no cleanup pads: Windows, #2979), a panicked function
    // still holds the promises it started, and they hold their exceptions.
    if (!canCatchPanics() || !unwoundFramesDrop()) {
      return;
    }
    const before = livePanics();
    let panics = 0;
    for (let i = 0; i < 20; i++) {
      if (await caught(() => boom(i))) {
        panics++;
      }
      if (await caught(() => later(i))) {
        panics++;
      }
      expect(await catchPanic(() => unawaited(i))).toBe(i);
    }
    expect(panics).toBe(40);
    // Each promise that panicked is gone by now, and its exception with it.
    expect(livePanics()).toBe(before);
  });

  it("still catches around a catchPanic in its body's first run", async () => {
    if (!canCatchPanics()) {
      return;
    }
    const inner = async (): Promise<number> => {
      await yieldNow();
      return 1;
    };
    const outer = async (): Promise<number> => {
      const r = await catchPanic(inner);
      await yieldNow();
      panic("outer " + r);
      return r;
    };
    let message = "not caught";
    try {
      await catchPanic(outer);
    } catch (e) {
      message = e instanceof PanicError ? e.message : "another error";
    }
    expect(message.startsWith("outer 1")).toBe(true);
  });
});
