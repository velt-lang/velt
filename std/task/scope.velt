// velt/task (internal): task scopes (`taskScope`, `TaskScope`): structured concurrency, the
// tasks spawned in a scope end with it.

import { DEFAULT_REASON } from "velt/task/errors";
import { TaskGroup } from "velt/task/group";
import { signalAbort, signalFree, signalNew, signalRetain } from "./signal_sched";
import { ABORT_ERROR, AbortSignal, signalCell } from "velt/task/signal";
import { spawnHandled } from "velt/lang/intrinsics";

/**
 * `taskScope`'s options. `cancelOnError`: abort `scope.signal` when the body or a child fails
 * (default true).
 */
export type ScopeOptions = { cancelOnError?: bool };

// Owns a reference to a scope's signal, released once, at the last reference. A scope that never
// ended normally (the runtime dropped its task) closes its group and aborts its signal then, so
// no child starts any more and its children stop.
class GroupObj {
  private group: shared<TaskGroup>;
  private sig: u64;
  private ended: bool = false;

  constructor(group: shared<TaskGroup>, sig: u64) {
    this.group = group;
    this.sig = sig;
  }

  signal(): u64 {
    return this.sig;
  }

  // The scope finished (its group's wait closed the group: later `spawn`s fail).
  end() {
    this.ended = true;
  }

  [Symbol.dispose]() {
    if (!this.ended) {
      signalAbort(this.sig, "\u0000the task scope was cancelled");
      this.group.close();
    }
    signalFree(this.sig);
  }
}

// The first error of a scope (its body's or a child's) in time; children add theirs from other
// tasks, so it lives in a `shared` cell and holds copies.
type FirstError<E> = shared<Mutex<E[]>>;

function recordFirst<E>(errors: FirstError<E>, e: E) {
  errors.with((es) => {
    if (es.length == 0) {
      es.push(e.clone());
    }
  });
}

/**
 * A running `taskScope`: spawns its child tasks and carries the signal that cancels them. `E`
 * is the error type of the scope, its body and its children.
 */
export class TaskScope<E> {
  // Releases the signal at its last reference; `g` is the group, shared with the children.
  #group: shared<Mutex<GroupObj>>;
  #g: shared<TaskGroup>;
  #sig: AbortSignal;
  // The scope's underlying signal (alive as long as `group`); each child retains its own.
  #sigH: u64;
  #errors: FirstError<E>;
  #cancelOnError: bool;

  /** Made by `taskScope` (`GroupObj` is internal). */
  constructor(
    group: shared<Mutex<GroupObj>>,
    sig: AbortSignal,
    errors: FirstError<E>,
    g: shared<TaskGroup>,
    cancelOnError: bool,
  ) {
    this.#g = g;
    this.#sigH = group.with((o) => o.signal());
    this.#group = group;
    this.#sig = sig;
    this.#errors = errors;
    this.#cancelOnError = cancelOnError;
  }

  /**
   * The scope's signal: aborted when the body or a child fails (with `cancelOnError`), on
   * `cancel()`, and when the scope's task is cancelled. Pass it to the children so they stop
   * cooperatively.
   */
  get signal(): AbortSignal {
    return this.#sig;
  }

  /**
   * Adds `p` as a child task of the scope (`spawn(p)`; a call starts on this task, as any
   * promise value); the scope waits for it. A promise that cannot fail (`Promise<T>`) is
   * accepted too.
   */
  spawn<T>(p: Promise<T, E>): Promise<T, E> {
    if (!this.#g.enter()) {
      panic("scope.spawn after its taskScope ended");
    }
    // Only plain values and shared cells go to the child (its own signal reference), so
    // `scope.spawn(work(scope.signal))` doesn't hand the task anything reachable from `scope`.
    const sig = signalRetain(this.#sigH);
    // The scope fails with the child's error, so a handle nobody awaits drops it quietly.
    return spawnHandled(scopeChild<T, E>(this.#g, sig, this.#errors, this.#cancelOnError, p));
  }

  /** Aborts the scope's signal. */
  cancel(reason: string = DEFAULT_REASON) {
    // Marked: the reason is an `AbortError` with this message, also through an `AbortSignal.any`.
    signalAbort(this.#sigH, ABORT_ERROR + reason);
  }
}

// Leaves a child's group and releases its signal reference when the child ends, also when its
// task is dropped unfinished.
class ChildGuard {
  private group: shared<TaskGroup>;
  private sig: u64;

  constructor(group: shared<TaskGroup>, sig: u64) {
    this.group = group;
    this.sig = sig;
  }

  [Symbol.dispose]() {
    signalFree(this.sig);
    this.group.leave();
  }
}

// A scope's child: `signal` is the child's own reference to the scope's signal.
async function scopeChild<T, E>(
  group: shared<TaskGroup>,
  signal: u64,
  errors: FirstError<E>,
  cancelOnError: bool,
  p: Promise<T, E>,
): Promise<T> throws E {
  using guard = new ChildGuard(group, signal);
  try {
    return await p;
  } catch (e) {
    recordFirst<E>(errors, e);
    if (cancelOnError) {
      signalAbort(signal, "\u0000a task in the scope failed");
    }
    throw e;
  }
}

/**
 * Structured concurrency: runs `body` with a `TaskScope` and settles only once the body and
 * every task it spawned with `scope.spawn` have finished, so no child outlives the scope. The
 * scope fails with the first error in time, of the body or of any child (even one nobody
 * awaited, or whose error the body caught), and otherwise returns the body's result. With
 * `cancelOnError` (the default), that first error aborts `scope.signal`, so the other children
 * can stop; their `AbortError`s come later and don't replace it.
 */
export async function taskScope<T, E>(
  body: (scope: TaskScope<E>) => Promise<T> throws E,
  options: ScopeOptions = {},
): Promise<T> throws E {
  const cancelOnError = options.cancelOnError ?? true;
  const cell = signalCell(signalNew());
  const h = cell.with((s) => s.raw());
  const g = shared(new TaskGroup());
  const group = shared(new Mutex<GroupObj>(new GroupObj(g, signalRetain(h))));
  const errors: FirstError<E> = shared(new Mutex<E[]>([]));
  const scope = new TaskScope<E>(group, new AbortSignal(cell), errors, g, cancelOnError);
  const result: T[] = [];
  try {
    result.push(await body(scope));
  } catch (e) {
    recordFirst<E>(errors, e);
    if (cancelOnError) {
      signalAbort(h, "\u0000the task scope failed");
    }
  }
  // The last child closes the channel (also before this receive starts).
  const idle = g.startWait();
  if (idle != null) {
    await idle.receive();
  }
  group.with((o) => o.end());
  const first = errors.with((es) => es.pop());
  if (first != null) {
    throw first;
  }
  return result[0];
}
