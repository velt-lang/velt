// velt/task (internal): `AbortController`, which aborts its signal.

import { velt_rt_signal_new } from "velt/task/rt";
import { AbortSignal, signalCell } from "velt/task/signal";
import { INSPECT } from "velt/lang/hooks/keys";

/** The sending half: `abort()` aborts its `signal`. */
export class AbortController {
  #sig: AbortSignal;

  constructor() {
    this.#sig = new AbortSignal(signalCell(velt_rt_signal_new()));
  }

  /** The controller's signal (the same object every time, like JS). */
  get signal(): AbortSignal {
    return this.#sig;
  }

  /**
   * Aborts the signal with `reason` (a no-op if it already is): `signal.reason` is that value,
   * or Node's `AbortError` ("This operation was aborted") without one.
   */
  abort(reason: any = undefined) {
    this.#sig.abortWith(reason);
  }

  /** How `console.log` shows the controller, like Node: its signal. */
  [INSPECT]() {
    return { signal: this.#sig };
  }
}
