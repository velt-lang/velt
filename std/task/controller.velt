// velt/task (internal): `AbortController`, which aborts its signal.

import { signalNew } from "./signal_sched";
import { AbortSignal, PLAIN_ABORT, signalCell } from "velt/task/signal";
import { INSPECT } from "velt/lang/hooks/keys";

/** The sending half: `abort()` aborts its `signal`. */
export class AbortController {
  #sig: AbortSignal;

  constructor() {
    this.#sig = new AbortSignal(signalCell(signalNew()));
  }

  /** The controller's signal (the same object every time, like JS). */
  get signal(): AbortSignal {
    return this.#sig;
  }

  /**
   * Aborts the signal with `reason` (a no-op if it already is): `signal.reason` is that string,
   * or Node's `AbortError` ("This operation was aborted") without one. (A string, as before:
   * any value is #3014, which needs weak references to shared values.)
   */
  abort(reason: string = PLAIN_ABORT) {
    this.#sig.abortAs(reason);
  }

  /** How `console.log` shows the controller, like Node: its signal. */
  [INSPECT]() {
    return { signal: this.#sig };
  }
}
