// velt/task (internal): `catchPanic`'s catch (std/task/panic.velt) under the executor in Velt
// (`VELT_SCHEDULER=std`, the `std-scheduler` variant of `#task-catch`;
// docs/internals/design/unwinding.md "The executor in Velt"). No runtime catch: generated code
// catches Velt's exception with `catchUnwind`.
//
// - `arm` raises the low bit of this worker's `E_CATCHING`; the next promise started takes it and
//   catches (`E_GUARDED` gets it), and so does every promise started, and every task spawned,
//   while a catching poll runs (sched_node.velt `start`, sched.velt `schedSpawn`).
// - The executor polls only those through `caughtPoll` (its address at worker 0's
//   `E_CATCH_POLL`): a panic there makes the promise (the task's root) panicked, its exception
//   (the message) kept; whoever awaits it (joins it) gets the panic raised again (`again`, at
//   `E_CATCH_AGAIN`), so a panic travels through `await`s as through calls until a catching poll
//   takes it, or ends the process (exit 101) where none runs.
// - `settled` waits for the guarded promise without claiming its result, through a header in its
//   node (nothing allocated).
//
// Where generated code doesn't catch (`canCatchPanics()` false: Windows on arm64, the
// `velt dev` JIT; WebAssembly never runs this executor), `caughtPoll`
// is a plain poll and a panic ends the process as an uncaught one does.

import { fnAddress, promiseAt, statePoll } from "velt/lang/intrinsics";
import { freePanic, panicText, raiseAgain } from "velt/lang/hooks/unwind";
import * as m from "velt/lang/hooks/sched_mem";
import * as node from "velt/lang/hooks/sched_node";
import * as aw from "velt/lang/hooks/sched_node_await";
import * as nc from "velt/lang/hooks/sched_node_catch";
import * as ml from "velt/lang/hooks/sched_module";
import * as t from "velt/lang/hooks/sched_task";
import { catchPanicAt } from "./unwind";

/** `take`'s answer when no promise took the arming (no handle: nodes are aligned addresses). */
export const NONE: u64 = 1;

/**
 * While `catchPanic` calls its body (`on`, then off again): every promise started and every task
 * spawned there catches, as in a catching poll (`caughtPoll`), so one that wraps the guarded
 * promise (a `Promise<any>`'s conversion) catches the panic it raises again too.
 */
export function bodyCatching(on: bool): void {
  const e = t.exec();
  const c = m.ld(e + nc.E_CATCHING);
  m.st(e + nc.E_CATCHING, on ? c + 2 : c - 2);
}

/**
 * The next promise started on this worker catches panics. Returns what `take` gets back: the
 * promise guarded for a `catchPanic` this one runs inside of. A `catchPanic` called in the first
 * run of another's body finds that one's promise in `E_GUARDED`, not taken yet (its `take` comes
 * after the run), and must leave it there when it is done.
 */
export function arm(): u64 {
  const g = t.main();
  if (m.ld(g + nc.E_CATCH_POLL) === 0) {
    m.st(g + nc.E_CATCH_AGAIN, fnAddress(again));
    m.st(g + nc.E_CATCH_POLL, fnAddress(caughtPoll));
  }
  const e = t.exec();
  const outer = m.ld(e + nc.E_GUARDED);
  m.st(e + nc.E_CATCHING, m.ld(e + nc.E_CATCHING) | 1);
  m.st(e + nc.E_GUARDED, 0);
  return outer as u64;
}

/**
 * The promise that took the arming, as a handle; disarms. 0: it already finished without a
 * panic, as a handler that never waits does (then `catchPanic` just takes its result). `NONE`:
 * no promise took it, or the one that did is shared, as when the body returns a promise held as
 * `Promise<any>` or a spawned task's handle (then `catchPanic` guards a promise of its own that
 * awaits the result). The
 * handle's node gets its settled future (`settled`). `outer`: what `arm` returned.
 */
export function take(outer: u64): u64 {
  const e = t.exec();
  m.st(e + nc.E_CATCHING, m.ld(e + nc.E_CATCHING) & ~1);
  const f = m.ld(e + nc.E_GUARDED);
  // The enclosing `catchPanic`'s promise again, for its own `take` (`arm`).
  m.st(e + nc.E_GUARDED, outer as usize);
  if (f === 0) {
    return NONE;
  }
  if (nc.finishedWell(f)) {
    nc.releasePromise(f);
    return 0;
  }
  if (m.ld(f) !== fnAddress(node.nodePoll)) {
    // Shared (a `Promise<any>`'s conversion holds it: sharing gives its handle the holders'
    // poll, sched_share.velt `schedShare`): its finish settles the hub, which wakes the holders,
    // not the awaiter `settled` would wait as, and a hub on another task waits as that awaiter
    // itself. So `catchPanic` guards a promise of its own that awaits the body's (#3223).
    nc.releasePromise(f);
    return NONE;
  }
  const s = node.nodeOf(f) + nc.N_SETTLE;
  m.st(s, fnAddress(settledPoll));
  m.st(s + 8, fnAddress(settledDrop));
  return f as u64;
}

/**
 * Waits until promise `h` finished, without claiming its result: true when it panicked. The
 * future is a header inside `h`'s node (sched_node_catch.velt `N_SETTLE`, written by `take`), so
 * nothing is allocated; `h`'s handle keeps the node alive while it is awaited.
 */
export function settled(h: u64): Promise<bool> {
  // SAFETY: a heap future's header (poll, drop) with its result in the word after, inside the
  // node, which outlives the promise: `catchPanic` frees `h` only after it is dropped.
  return unsafe { promiseAt<bool>(node.nodeOf(h as usize) + nc.N_SETTLE) };
}

/** The panic message of promise `h` (it panicked). */
export function message(h: u64): string {
  // SAFETY: the exception of a panicked promise, kept for as long as the node lives, and the
  // handle holds a reference to it.
  return unsafe { panicText(nc.panicOf(h as usize)) };
}

/** Releases handle `h`. */
export function free(h: u64): void {
  if (h !== 0) {
    nc.releasePromise(h as usize);
  }
}

/**
 * `settled`'s poll: its result (a `bool`) at +16, the promise's node at `f - N_SETTLE`. A
 * promise that drives itself (`drivesItself`: the guarded promise after its first run, which
 * waits) is not adopted, only awaited: an adoption would poll a state that waits for its wake,
 * and come back pending. Its own run polls it on that wake, and its finish wakes this poll.
 */
function settledPoll(f: usize, cx: usize): u32 {
  const p = f - nc.N_SETTLE + node.N_HEAD;
  if (nc.drivesItself(p)) {
    return aw.awaitNode(node.nodeOf(p), cx);
  }
  if (node.nodeSettled(p, cx) === 0) {
    return 0;
  }
  m.st(f + 16, nc.isPanicked(p) ? 1 : 0);
  return 1;
}

/** `settled`'s drop: the node is the handle's, freed by `free`. */
function settledDrop(f: usize): void {}

/**
 * The executor's catching poll on worker `e`: polls the state at `a + 8` with its poll at `a`
 * and `cx` through `catchUnwindAt`; 0 pending, 1 ready, 2 panicked with the exception stored at
 * `a + 16`. What the poll left on this worker (the catching depth, an adoption under way, the
 * module lock a `with` callback took: sched_module.velt `restore`) is restored then. `a` is the
 * worker's `E_CATCH_ARGS`, so the worker is found without a lookup, and the polled function
 * (`pollArgs`) is called at its address with `a`: no closure, no function value.
 */
function caughtPoll(a: usize, cx: usize): u32 {
  const e = a - nc.E_CATCH_ARGS;
  const catching = m.ld(e + nc.E_CATCHING);
  const adopting = m.ld(e + t.E_ADOPTING);
  const guarded = m.ld(e + nc.E_GUARDED);
  const holds = ml.holds();
  m.st(e + nc.E_CATCHING, catching + 2);
  m.st(a + 16, cx);
  // SAFETY: `pollArgs` takes one number; the exception object is kept by the panicked promise
  // (its message) and freed with its node.
  const x = unsafe { catchPanicAt(fnAddress(pollArgs), a) };
  m.st(e + nc.E_CATCHING, catching);
  if (x !== 0) {
    m.st(e + t.E_ADOPTING, adopting);
    // A `catchPanic` in the poll that panicked between its `arm` and its `take` never put the
    // promise guarded for the enclosing one back: it is what it was before the poll.
    m.st(e + nc.E_GUARDED, guarded);
    ml.restore(holds);
    m.st(a + 16, x);
    return 2;
  }
  return m.ld(a + 16) as u32;
}

/**
 * `caughtPoll`'s call under the catch: the poll, state and `cx` at `a` (this worker's
 * `E_CATCH_ARGS`), the result written over the `cx`. A catching poll nested in it (an adoption)
 * writes the same words, but only after this one read them and before it writes its result.
 */
function pollArgs(a: usize): void {
  // SAFETY: `caughtPoll`'s arguments: a state, its poll, and the context of its task.
  const r = unsafe { statePoll(m.ld(a), m.ld(a + 8), m.ld(a + 16)) };
  m.st(a + 16, r as usize);
}

/**
 * The panic held by exception `x`: raised again where a panicked promise is awaited (`free` 0:
 * never returns), or freed when that promise's node is (`free` 1).
 */
function again(x: usize, free: usize): u32 {
  if (free !== 0) {
    // SAFETY: the exception of a panicked promise whose node is being freed: nothing reads it
    // after.
    unsafe {
      freePanic(x);
    }
    return 0;
  }
  // SAFETY: the exception of a panicked promise or task, alive while its node or task is.
  raiseAgain(unsafe { panicText(x) });
}
