    return velt_simd_u32x4_lane(this, 0) +
      velt_simd_u32x4_lane(this, 1) +
      velt_simd_u32x4_lane(this, 2) +
      velt_simd_u32x4_lane(this, 3);
  }

  /** The lanes of the low halves of this vector and `other` in turn: a0, b0, a1, b1, … */
  zipLow(other: u32x4): u32x4 {
    return velt_simd_u32x4_zip_low(this, other);
  }

  /** The lanes of the high halves of this vector and `other` in turn. */
  zipHigh(other: u32x4): u32x4 {
    return velt_simd_u32x4_zip_high(this, other);
  }

  /** The low 2 lanes, each as a `u64`. */
  widenLow(): u64x2 {
    return velt_simd_u32x4_widen_low(this);
  }

  /** The high 2 lanes, each as a `u64`. */
  widenHigh(): u64x2 {
    return velt_simd_u32x4_widen_high(this);
  }

  /**
   * The lanes of this vector, then of `other`, each as a `u16`, clamped to its range
   * instead of wrapping.
   */
  narrow(other: u32x4): u16x8 {
    return velt_simd_u32x4_narrow(this, other);
  }

  /** Each lane as an `f32`, rounded to the nearest one. */
  toF32x4(): f32x4 {
    return velt_simd_u32x4_to_f32x4(this);
  }

  /** The same 128 bits as a `i32x4` (no conversion of values). */
  asI32x4(): i32x4 {
    return velt_simd_u32x4_as_i32x4(this);
  }

  /** The same 128 bits as a `f32x4` (no conversion of values). */
  asF32x4(): f32x4 {
    return velt_simd_u32x4_as_f32x4(this);
  }

  /** The same 128 bits as a `u8x16` (no conversion of values). */
  asU8x16(): u8x16 {
    return velt_simd_u32x4_as_u8x16(this);
  }
}

declare function velt_simd_i64x2_fits(xs: i64[], at: u64): bool;
declare function velt_simd_i64x2_splat(x: i64): i64x2;
declare function velt_simd_i64x2_index(): i64x2;
declare function velt_simd_i64x2_load(from: i64[], at: u64): i64x2;
declare function velt_simd_i64x2_store(v: i64x2, to: i64[], at: u64);
declare function velt_simd_i64x2_load_partial(from: i64[], at: u64, count: u64): i64x2;
declare function velt_simd_i64x2_store_partial(v: i64x2, to: i64[], at: u64, count: u64);
declare function velt_simd_i64x2_lane(v: i64x2, index: u64): i64;
declare function velt_simd_i64x2_with_lane(v: i64x2, index: u64, x: i64): i64x2;
declare function velt_simd_i64x2_select(m: mask64x2, a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_add(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_sub(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_mul(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_and(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_or(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_xor(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_neg(v: i64x2): i64x2;
declare function velt_simd_i64x2_not(v: i64x2): i64x2;
declare function velt_simd_i64x2_shl(v: i64x2, count: u32): i64x2;
declare function velt_simd_i64x2_shr(v: i64x2, count: u32): i64x2;
declare function velt_simd_i64x2_eq(a: i64x2, b: i64x2): mask64x2;
declare function velt_simd_i64x2_ne(a: i64x2, b: i64x2): mask64x2;
declare function velt_simd_i64x2_lt(a: i64x2, b: i64x2): mask64x2;
declare function velt_simd_i64x2_le(a: i64x2, b: i64x2): mask64x2;
declare function velt_simd_i64x2_gt(a: i64x2, b: i64x2): mask64x2;
declare function velt_simd_i64x2_ge(a: i64x2, b: i64x2): mask64x2;
declare function velt_simd_i64x2_zip_low(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_zip_high(a: i64x2, b: i64x2): i64x2;
declare function velt_simd_i64x2_as_u64x2(v: i64x2): u64x2;
declare function velt_simd_i64x2_as_f64x2(v: i64x2): f64x2;
declare function velt_simd_i64x2_as_u8x16(v: i64x2): u8x16;

extend i64x2 {
  /** A vector with every lane `x`. */
  static splat(x: i64): i64x2 {
    return velt_simd_i64x2_splat(x);
  }

  /**
   * The 2 elements of `from` starting at `at`. Panics with a RangeError unless all 2 are
   * inside the array.
   */
  static load(from: i64[], at: usize = 0): i64x2 {
    if (!i64x2.fits(from, at)) {
      panic("RangeError: i64x2.load: range is out of bounds");
    }
    return velt_simd_i64x2_load(from, at as u64);
  }

  /**
   * Whether the 2 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (i64x2.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: i64[], at: usize = 0): bool {
    return velt_simd_i64x2_fits(xs, at as u64);
  }

  /** The vector whose lanes are their own indices: 0, 1, 2, … */
  static index(): i64x2 {
    return velt_simd_i64x2_index();
  }

  /**
   * The elements of `from` starting at `at` that exist, up to 2, in the low lanes; the other
   * lanes are 0. For the last elements of an array, after the steps that take 2 at a time.
   * `at` may be the length (no element left); past it, panics with a RangeError.
   */
  static loadPartial(from: i64[], at: usize = 0): i64x2 {
    if (i64x2.fits(from, at)) {
      return velt_simd_i64x2_load(from, at as u64);
    }
    if (at > from.length) {
      panic("RangeError: i64x2.loadPartial: position is out of range");
    }
    return velt_simd_i64x2_load_partial(from, at as u64, (from.length - at) as u64);
  }

  /** Lane by lane, `a` where the mask is set and `b` elsewhere. */
  static select(m: mask64x2, a: i64x2, b: i64x2): i64x2 {
    return velt_simd_i64x2_select(m, a, b);
  }

  /**
   * Writes the 2 lanes to `to` starting at `at`. Panics with a RangeError unless all 2
   * elements are inside the array (it does not grow).
   */
  store(to: i64[], at: usize = 0) {
    if (!i64x2.fits(to, at)) {
      panic("RangeError: i64x2.store: range is out of bounds");
    }
    velt_simd_i64x2_store(this, to, at as u64);
  }

  /**
   * Writes the low lanes to the elements of `to` starting at `at` that exist, up to 2 (the
   * array does not grow): what `loadPartial` read, back. `at` may be the length (nothing is
   * written); past it, panics with a RangeError.
   */
  storePartial(to: i64[], at: usize = 0) {
    if (i64x2.fits(to, at)) {
      velt_simd_i64x2_store(this, to, at as u64);
      return;
    }
    if (at > to.length) {
      panic("RangeError: i64x2.storePartial: position is out of range");
    }
    velt_simd_i64x2_store_partial(this, to, at as u64, (to.length - at) as u64);
  }

  /** Lane `index` (0 to 1; panics with a RangeError otherwise). */
  lane(index: usize): i64 {
    if (index >= 2) {
      panic("RangeError: i64x2.lane: index is out of range");
    }
    return velt_simd_i64x2_lane(this, index as u64);
  }

  /** This vector with lane `index` (0 to 1; panics with a RangeError otherwise) set to `x`. */
  withLane(index: usize, x: i64): i64x2 {
    if (index >= 2) {
      panic("RangeError: i64x2.withLane: index is out of range");
    }
    return velt_simd_i64x2_with_lane(this, index as u64, x);
  }

  /** Lane-wise sum, wrapping on overflow. */
  add(other: i64x2): i64x2 {
    return velt_simd_i64x2_add(this, other);
  }

  /** Lane-wise difference, wrapping on overflow. */
  sub(other: i64x2): i64x2 {
    return velt_simd_i64x2_sub(this, other);
  }

  /** Lane-wise product, wrapping on overflow. */
  mul(other: i64x2): i64x2 {
    return velt_simd_i64x2_mul(this, other);
  }

  /** Bitwise AND. */
  and(other: i64x2): i64x2 {
    return velt_simd_i64x2_and(this, other);
  }

  /** Bitwise OR. */
  or(other: i64x2): i64x2 {
    return velt_simd_i64x2_or(this, other);
  }

  /** Bitwise XOR. */
  xor(other: i64x2): i64x2 {
    return velt_simd_i64x2_xor(this, other);
  }

  /** Each lane negated (wrapping). */
  neg(): i64x2 {
    return velt_simd_i64x2_neg(this);
  }

  /** Every bit flipped. */
  not(): i64x2 {
    return velt_simd_i64x2_not(this);
  }

  /** Each lane shifted left by `count` bits (taken modulo 64). */
  shl(count: u32): i64x2 {
    return velt_simd_i64x2_shl(this, count);
  }

  /** Each lane shifted right by `count` bits (taken modulo 64), keeping the sign. */
  shr(count: u32): i64x2 {
    return velt_simd_i64x2_shr(this, count);
  }

  /** The lanes where this vector equals `other`. */
  eq(other: i64x2): mask64x2 {
    return velt_simd_i64x2_eq(this, other);
  }

  /** The lanes where this vector differs from `other`. */
  ne(other: i64x2): mask64x2 {
    return velt_simd_i64x2_ne(this, other);
  }

  /** The lanes where this vector is less than `other`. */
  lt(other: i64x2): mask64x2 {
    return velt_simd_i64x2_lt(this, other);
  }

  /** The lanes where this vector is at most `other`. */
  le(other: i64x2): mask64x2 {
    return velt_simd_i64x2_le(this, other);
  }

  /** The lanes where this vector is greater than `other`. */
  gt(other: i64x2): mask64x2 {
    return velt_simd_i64x2_gt(this, other);
  }

  /** The lanes where this vector is at least `other`. */
  ge(other: i64x2): mask64x2 {
    return velt_simd_i64x2_ge(this, other);
  }

  /** The sum of the lanes, wrapping on overflow. */
  sum(): i64 {
    return velt_simd_i64x2_lane(this, 0) + velt_simd_i64x2_lane(this, 1);
  }

  /** The lanes of the low halves of this vector and `other` in turn: a0, b0, a1, b1, … */
  zipLow(other: i64x2): i64x2 {
    return velt_simd_i64x2_zip_low(this, other);
  }

  /** The lanes of the high halves of this vector and `other` in turn. */
  zipHigh(other: i64x2): i64x2 {
    return velt_simd_i64x2_zip_high(this, other);
  }

  /** The same 128 bits as a `u64x2` (no conversion of values). */
  asU64x2(): u64x2 {
    return velt_simd_i64x2_as_u64x2(this);
  }

  /** The same 128 bits as a `f64x2` (no conversion of values). */
  asF64x2(): f64x2 {
    return velt_simd_i64x2_as_f64x2(this);
  }

  /** The same 128 bits as a `u8x16` (no conversion of values). */
  asU8x16(): u8x16 {
    return velt_simd_i64x2_as_u8x16(this);
  }
}

