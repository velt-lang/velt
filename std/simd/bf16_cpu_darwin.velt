// velt/simd (internal): whether the CPU has Arm's bf16 instructions, on macOS (`#simd-bf16`'s
// darwin variant, std/imports.velt): the `hw.optional.arm.FEAT_BF16` sysctl (1 from an M2 on,
// absent on an Intel Mac). Called on arm64 only (std/simd/bf16_check.velt).

import { Out } from "velt/ffi/out";
import { Ptr } from "velt/ffi/ptr";

// The name as its bytes: a `CString` would bring its TypeError, and what throws, into every
// program that has a `bf16x8`.
declare c("c") function sysctlbyname(
  name: readonly u8[],
  old: i32[],
  oldLen: Out<usize>,
  newValue: Ptr<void> | null,
  newLen: usize,
): i32;

/** "hw.optional.arm.FEAT_BF16" and its NUL. */
const NAME: readonly u8[] = [
  104,
  119,
  46,
  111,
  112,
  116,
  105,
  111,
  110,
  97,
  108,
  46,
  97,
  114,
  109,
  46,
  70,
  69,
  65,
  84,
  95,
  66,
  70,
  49,
  54,
  0,
];

export function cpuHasBf16(): bool {
  const value: i32[] = [0];
  const len = new Out<usize>(4);
  // SAFETY: a NUL-terminated name; room for one `int`, which `len` says; no new value.
  const r = unsafe { sysctlbyname(NAME, value, len, null, 0) };
  return r === 0 && len.value === 4 && value[0] === 1;
}
