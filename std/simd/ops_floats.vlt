// velt/simd (internal): the operators of the vectors of float lanes. Programs import the types from
// `velt/simd`.
//
// `a + b` on vectors is the lane operation `a.add(b)` is, and so on (design operators.md):
// each operator method below calls the same operation, which the compiler emits inline. A
// scalar operand is splatted (`v * 2` is `v * f32x4.splat(2)`; a variable must have the lane
// type). Comparisons stay methods (`a.lt(b)`): they give a mask, and `==` gives a `bool`.
//
// Generated by scripts/gen-simd-ops.py: change the script, not this file.

declare function velt_simd_f32x4_add(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_sub(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_mul(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_div(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_neg(v: f32x4): f32x4;
declare function velt_simd_f32x4_lane(v: f32x4, index: u64): f32;
declare function velt_simd_f64x2_add(a: f64x2, b: f64x2): f64x2;
declare function velt_simd_f64x2_sub(a: f64x2, b: f64x2): f64x2;
declare function velt_simd_f64x2_mul(a: f64x2, b: f64x2): f64x2;
declare function velt_simd_f64x2_div(a: f64x2, b: f64x2): f64x2;
declare function velt_simd_f64x2_neg(v: f64x2): f64x2;
declare function velt_simd_f64x2_lane(v: f64x2, index: u64): f64;

extend f32x4 {
  /** `this + other`: the lane-wise sum. */
  [Symbol.add](other: f32x4): f32x4 {
    return velt_simd_f32x4_add(this, other);
  }

  /** `this - other`: the lane-wise difference. */
  [Symbol.sub](other: f32x4): f32x4 {
    return velt_simd_f32x4_sub(this, other);
  }

  /** `this * other`: the lane-wise product. */
  [Symbol.mul](other: f32x4): f32x4 {
    return velt_simd_f32x4_mul(this, other);
  }

  /** `this / other`: the lane-wise quotient. */
  [Symbol.div](other: f32x4): f32x4 {
    return velt_simd_f32x4_div(this, other);
  }

  /** `-this`: each lane negated. */
  [Symbol.neg](): f32x4 {
    return velt_simd_f32x4_neg(this);
  }

  /** `this[index]`: lane `index` (0 to 3; panics with a RangeError otherwise). */
  [Symbol.index](index: usize): f32 {
    if (index >= 4) {
      panic("RangeError: f32x4[index]: index is out of range");
    }
    return velt_simd_f32x4_lane(this, index as u64);
  }
}

extend f64x2 {
  /** `this + other`: the lane-wise sum. */
  [Symbol.add](other: f64x2): f64x2 {
    return velt_simd_f64x2_add(this, other);
  }

  /** `this - other`: the lane-wise difference. */
  [Symbol.sub](other: f64x2): f64x2 {
    return velt_simd_f64x2_sub(this, other);
  }

  /** `this * other`: the lane-wise product. */
  [Symbol.mul](other: f64x2): f64x2 {
    return velt_simd_f64x2_mul(this, other);
  }

  /** `this / other`: the lane-wise quotient. */
  [Symbol.div](other: f64x2): f64x2 {
    return velt_simd_f64x2_div(this, other);
  }

  /** `-this`: each lane negated. */
  [Symbol.neg](): f64x2 {
    return velt_simd_f64x2_neg(this);
  }

  /** `this[index]`: lane `index` (0 to 1; panics with a RangeError otherwise). */
  [Symbol.index](index: usize): f64 {
    if (index >= 2) {
      panic("RangeError: f64x2[index]: index is out of range");
    }
    return velt_simd_f64x2_lane(this, index as u64);
  }
}
