// velt/simd (internal): `f16x8`, eight `f16` lanes. `widenLow` and `widenHigh` give `f32x4`,
// `f16x8.narrow` takes them back, and `dotAdd` multiplies two of them into an `f32x4` accumulator.
// Its lane arithmetic rounds to `f16` as `f32x4`'s rounds to `f32`, to the same bits on every CPU
// but for which NaN a NaN is: one instruction where the CPU has FP16 (every Apple arm64 CPU, and
// `--cpu` where the CPU has it), and otherwise computed in `f32`, which rounds the same. Its
// operators are in ops_floats.velt. The `velt_simd_*` functions below have no runtime
// implementation, the compiler emits them inline (rt_abi.md "SIMD").

export type f16x8 = f16x8;

declare function velt_simd_f16x8_fits(xs: f16[], at: u64): bool;
declare function velt_simd_f16x8_splat(x: f16): f16x8;
declare function velt_simd_f16x8_load(from: f16[], at: u64): f16x8;
declare function velt_simd_f16x8_store(v: f16x8, to: f16[], at: u64);
declare function velt_simd_f16x8_load_partial(from: f16[], at: u64, count: u64): f16x8;
declare function velt_simd_f16x8_store_partial(v: f16x8, to: f16[], at: u64, count: u64);
declare function velt_simd_f16x8_lane(v: f16x8, index: u64): f16;
declare function velt_simd_f16x8_with_lane(v: f16x8, index: u64, x: f16): f16x8;
declare function velt_simd_f16x8_as_u16x8(v: f16x8): u16x8;
declare function velt_simd_u16x8_as_f16x8(v: u16x8): f16x8;
declare function velt_simd_f16x8_widen_low(v: f16x8): f32x4;
declare function velt_simd_f16x8_widen_high(v: f16x8): f32x4;
declare function velt_simd_f32x4_narrow_f16x8(lo: f32x4, hi: f32x4): f16x8;
declare function velt_simd_f32x4_dot_add_f16x8(acc: f32x4, a: f16x8, b: f16x8): f32x4;
declare function velt_simd_f16x8_select(m: mask16x8, a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_add(a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_sub(a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_mul(a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_div(a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_min(a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_max(a: f16x8, b: f16x8): f16x8;
declare function velt_simd_f16x8_neg(v: f16x8): f16x8;
declare function velt_simd_f16x8_abs(v: f16x8): f16x8;
declare function velt_simd_f16x8_sqrt(v: f16x8): f16x8;
declare function velt_simd_f16x8_eq(a: f16x8, b: f16x8): mask16x8;
declare function velt_simd_f16x8_ne(a: f16x8, b: f16x8): mask16x8;
declare function velt_simd_f16x8_lt(a: f16x8, b: f16x8): mask16x8;
declare function velt_simd_f16x8_le(a: f16x8, b: f16x8): mask16x8;
declare function velt_simd_f16x8_gt(a: f16x8, b: f16x8): mask16x8;
declare function velt_simd_f16x8_ge(a: f16x8, b: f16x8): mask16x8;

extend f16x8 {
  /** A vector with every lane `x`. */
  static splat(x: f16): f16x8 {
    return velt_simd_f16x8_splat(x);
  }

  /**
   * The 8 elements of `from` starting at `at`. Panics with a RangeError unless all 8 are
   * inside the array.
   */
  static load(from: f16[], at: usize = 0): f16x8 {
    if (!f16x8.fits(from, at)) {
      panic("RangeError: f16x8.load: range is out of bounds");
    }
    return velt_simd_f16x8_load(from, at as u64);
  }

  /**
   * Whether the 8 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (f16x8.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: f16[], at: usize = 0): bool {
    return velt_simd_f16x8_fits(xs, at as u64);
  }

  /**
   * The elements of `from` starting at `at` that exist, up to 8, in the low lanes; the other
   * lanes are 0. For the last elements of an array, after the steps that take 8 at a time.
   * `at` may be the length (no element left); past it, panics with a RangeError.
   */
  static loadPartial(from: f16[], at: usize = 0): f16x8 {
    if (f16x8.fits(from, at)) {
      return velt_simd_f16x8_load(from, at as u64);
    }
    if (at > from.length) {
      panic("RangeError: f16x8.loadPartial: position is out of range");
    }
    return velt_simd_f16x8_load_partial(from, at as u64, (from.length - at) as u64);
  }

  /**
   * Writes the 8 lanes to `to` starting at `at`. Panics with a RangeError unless all 8
   * elements are inside the array (it does not grow).
   */
  store(to: f16[], at: usize = 0) {
    if (!f16x8.fits(to, at)) {
      panic("RangeError: f16x8.store: range is out of bounds");
    }
    velt_simd_f16x8_store(this, to, at as u64);
  }

  /**
   * Writes the low lanes to the elements of `to` starting at `at` that exist, up to 8 (the
   * array does not grow): what `loadPartial` read, back. `at` may be the length (nothing is
   * written); past it, panics with a RangeError.
   */
  storePartial(to: f16[], at: usize = 0) {
    if (f16x8.fits(to, at)) {
      velt_simd_f16x8_store(this, to, at as u64);
      return;
    }
    if (at > to.length) {
      panic("RangeError: f16x8.storePartial: position is out of range");
    }
    velt_simd_f16x8_store_partial(this, to, at as u64, (to.length - at) as u64);
  }

  /** Lane `index` (0 to 7; panics with a RangeError otherwise). */
  lane(index: usize): f16 {
    if (index >= 8) {
      panic("RangeError: f16x8.lane: index is out of range");
    }
    return velt_simd_f16x8_lane(this, index as u64);
  }

  /** This vector with lane `index` (0 to 7; panics with a RangeError otherwise) set to `x`. */
  withLane(index: usize, x: f16): f16x8 {
    if (index >= 8) {
      panic("RangeError: f16x8.withLane: index is out of range");
    }
    return velt_simd_f16x8_with_lane(this, index as u64, x);
  }

  /** Lane-wise sum. */
  add(other: f16x8): f16x8 {
    return velt_simd_f16x8_add(this, other);
  }

  /** Lane-wise difference. */
  sub(other: f16x8): f16x8 {
    return velt_simd_f16x8_sub(this, other);
  }

  /** Lane-wise product. */
  mul(other: f16x8): f16x8 {
    return velt_simd_f16x8_mul(this, other);
  }

  /** Lane-wise quotient. */
  div(other: f16x8): f16x8 {
    return velt_simd_f16x8_div(this, other);
  }

  /** The smaller of each pair of lanes (as `Math.min` and `Math.max`: NaN if either is). */
  min(other: f16x8): f16x8 {
    return velt_simd_f16x8_min(this, other);
  }

  /** The larger of each pair of lanes (as `Math.min` and `Math.max`: NaN if either is). */
  max(other: f16x8): f16x8 {
    return velt_simd_f16x8_max(this, other);
  }

  /** Each lane negated. */
  neg(): f16x8 {
    return velt_simd_f16x8_neg(this);
  }

  /** The absolute value of each lane. */
  abs(): f16x8 {
    return velt_simd_f16x8_abs(this);
  }

  /** The square root of each lane. */
  sqrt(): f16x8 {
    return velt_simd_f16x8_sqrt(this);
  }

  /** The lanes where this vector equals `other` (a NaN lane equals nothing). */
  eq(other: f16x8): mask16x8 {
    return velt_simd_f16x8_eq(this, other);
  }

  /** The lanes where this vector differs from `other` (a NaN lane differs from everything). */
  ne(other: f16x8): mask16x8 {
    return velt_simd_f16x8_ne(this, other);
  }

  /** The lanes where this vector is less than `other`. */
  lt(other: f16x8): mask16x8 {
    return velt_simd_f16x8_lt(this, other);
  }

  /** The lanes where this vector is at most `other`. */
  le(other: f16x8): mask16x8 {
    return velt_simd_f16x8_le(this, other);
  }

  /** The lanes where this vector is greater than `other`. */
  gt(other: f16x8): mask16x8 {
    return velt_simd_f16x8_gt(this, other);
  }

  /** The lanes where this vector is at least `other`. */
  ge(other: f16x8): mask16x8 {
    return velt_simd_f16x8_ge(this, other);
  }

  /** `a` in the lanes where `m` is set, `b` in the others. */
  static select(m: mask16x8, a: f16x8, b: f16x8): f16x8 {
    return velt_simd_f16x8_select(m, a, b);
  }

  /** The sum of the lanes, added in lane order, each addition rounded to `f16`. */
  sum(): f16 {
    let total = velt_simd_f16x8_lane(this, 0);
    total += velt_simd_f16x8_lane(this, 1);
    total += velt_simd_f16x8_lane(this, 2);
    total += velt_simd_f16x8_lane(this, 3);
    total += velt_simd_f16x8_lane(this, 4);
    total += velt_simd_f16x8_lane(this, 5);
    total += velt_simd_f16x8_lane(this, 6);
    total += velt_simd_f16x8_lane(this, 7);
    return total;
  }

  /** The same bits as a `u16x8`: no conversion. */
  asU16x8(): u16x8 {
    return velt_simd_f16x8_as_u16x8(this);
  }

  /** The same bits as a `f16x8`: no conversion. */
  static fromU16x8(bits: u16x8): f16x8 {
    return velt_simd_u16x8_as_f16x8(bits);
  }

  /** Lanes 0 to 3 as `f32`, exactly. A NaN keeps its payload, with its quiet bit set. */
  widenLow(): f32x4 {
    return velt_simd_f16x8_widen_low(this);
  }

  /** Lanes 4 to 7 as `f32`, exactly. A NaN keeps its payload, with its quiet bit set. */
  widenHigh(): f32x4 {
    return velt_simd_f16x8_widen_high(this);
  }

  /**
   * The lanes of `lo`, then of `hi`, each rounded once to the nearest `f16` (ties to even) (past the
   * largest, ±Infinity). A NaN
   * keeps the top bits of its payload, with its quiet bit set.
   */
  static narrow(lo: f32x4, hi: f32x4): f16x8 {
    return velt_simd_f32x4_narrow_f16x8(lo, hi);
  }

  /**
   * `acc` plus the products of this and `b`, in `f32`, as `a.mulAdd(b, c)` is `a * b + c`: lane
   * `k` is `fma(this[k + 4], b[k + 4], fma(this[k], b[k], acc[k]))`, in that order, so each lane
   * takes lanes `k` and `k + 4` (not adjacent ones) and rounds twice. Each product is exact in
   * `f32` and every number comes out the same on every CPU: Arm's `fmlal` and `fmlal2`
   * (every Apple arm64 CPU, and `--cpu` where the CPU has FEAT_FHM), and elsewhere the widened
   * lanes and two fused additions (one library call per lane on a CPU with no FMA, as
   * `f32x4.mulAdd`). A lane with one NaN among its operands gives that NaN, and a signalling one
   * may or may not come out quiet (an optimizer can drop a step that adds nothing, as it can in
   * `f32x4.mulAdd`); with several, or from an invalid operation (`Infinity * 0`), a NaN, which
   * one depends on the CPU and the build.
   */
  dotAdd(b: f16x8, acc: f32x4): f32x4 {
    return velt_simd_f32x4_dot_add_f16x8(acc, this, b);
  }
}
