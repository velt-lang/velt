// velt/simd (internal): 128-bit SIMD, masks. Programs import the types from `velt/simd`.
//
// A vector is a value like a number: sixteen `u8` lanes in a `u8x16`, four `f32` in an
// `f32x4`. Every method is one instruction, or a few, on x86-64 (SSE2), arm64 (NEON) and
// WebAssembly (`simd128`), the same in debug and release builds; the `velt_simd_*` functions
// below have no runtime implementation, the compiler emits them inline (rt_abi.md "SIMD").
// Comparisons give a mask (`mask8x16`), which `any()`, `first()`, `bitmask()` and `select`
// consume. In std the type names are built in; each `export type` below gives a module that
// imports one the built-in type.
//
// Generated by scripts/gen-simd-api.py: change the script, not this file.

export type mask8x16 = mask8x16;
export type mask16x8 = mask16x8;
export type mask32x4 = mask32x4;
export type mask64x2 = mask64x2;

declare function velt_simd_u8x16_index(): u8x16;
declare function velt_simd_u8x16_splat(x: u8): u8x16;
declare function velt_simd_u8x16_lt(a: u8x16, b: u8x16): mask8x16;
declare function velt_simd_mask8x16_any(m: mask8x16): bool;
declare function velt_simd_mask8x16_all(m: mask8x16): bool;
declare function velt_simd_mask8x16_bitmask(m: mask8x16): u64;
declare function velt_simd_mask8x16_first(m: mask8x16): u64;
declare function velt_simd_mask8x16_count(m: mask8x16): u64;
declare function velt_simd_mask8x16_and(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_or(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_xor(a: mask8x16, b: mask8x16): mask8x16;
declare function velt_simd_mask8x16_not(m: mask8x16): mask8x16;

extend mask8x16 {
  /**
   * The mask with its first `count` lanes set (all 16 from 16 up): the lanes `loadPartial`
   * filled when `count` elements were left.
   */
  static prefix(count: usize): mask8x16 {
    const lanes = count < 16 ? count : 16;
    return velt_simd_u8x16_lt(velt_simd_u8x16_index(), velt_simd_u8x16_splat(lanes as u8));
  }

  /** Whether some lane is set. */
  any(): bool {
    return velt_simd_mask8x16_any(this);
  }

  /** Whether every lane is set. */
  all(): bool {
    return velt_simd_mask8x16_all(this);
  }

  /** The lanes as bits: bit `i` is lane `i`. */
  bitmask(): u64 {
    return velt_simd_mask8x16_bitmask(this);
  }

  /** The index of the first set lane, or 16 when none is. */
  first(): usize {
    return velt_simd_mask8x16_first(this) as usize;
  }

  /** The number of set lanes. */
  count(): usize {
    return velt_simd_mask8x16_count(this) as usize;
  }

  /** The lanes set in both masks. */
  and(other: mask8x16): mask8x16 {
    return velt_simd_mask8x16_and(this, other);
  }

  /** The lanes set in either mask. */
  or(other: mask8x16): mask8x16 {
    return velt_simd_mask8x16_or(this, other);
  }

  /** The lanes set in exactly one of the masks. */
  xor(other: mask8x16): mask8x16 {
    return velt_simd_mask8x16_xor(this, other);
  }

  /** The lanes that are not set. */
  not(): mask8x16 {
    return velt_simd_mask8x16_not(this);
  }
}

