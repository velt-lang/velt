// velt:simd/floats: 128-bit SIMD, float lanes. Programs import the types from `velt:simd`.
//
// A vector is a value like a number: sixteen `u8` lanes in a `u8x16`, four `f32` in an
// `f32x4`. Every method is one instruction, or a few, on x86-64 (SSE2), arm64 (NEON) and
// WebAssembly (`simd128`), the same in debug and release builds; the `velt_simd_*` functions
// below have no runtime implementation, the compiler emits them inline (rt_abi.md "SIMD").
// Comparisons give a mask (`mask8x16`), which `any()`, `first()`, `bitmask()` and `select`
// consume. In std the type names are built in; each `export type` below gives a module that
// imports one the built-in type.
//
// Generated by scripts/gen-simd-api.py: change the script, not this file.

export type f32x4 = f32x4;
export type f64x2 = f64x2;

declare function velt_simd_f32x4_fits(xs: f32[], at: u64): bool;
declare function velt_simd_f32x4_splat(x: f32): f32x4;
declare function velt_simd_f32x4_index(): f32x4;
declare function velt_simd_f32x4_load(from: f32[], at: u64): f32x4;
declare function velt_simd_f32x4_store(v: f32x4, to: f32[], at: u64);
declare function velt_simd_f32x4_lane(v: f32x4, index: u64): f32;
declare function velt_simd_f32x4_with_lane(v: f32x4, index: u64, x: f32): f32x4;
declare function velt_simd_f32x4_select(m: mask32x4, a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_add(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_sub(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_mul(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_div(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_min(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_max(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_neg(v: f32x4): f32x4;
declare function velt_simd_f32x4_abs(v: f32x4): f32x4;
declare function velt_simd_f32x4_sqrt(v: f32x4): f32x4;
declare function velt_simd_f32x4_eq(a: f32x4, b: f32x4): mask32x4;
declare function velt_simd_f32x4_ne(a: f32x4, b: f32x4): mask32x4;
declare function velt_simd_f32x4_lt(a: f32x4, b: f32x4): mask32x4;
declare function velt_simd_f32x4_le(a: f32x4, b: f32x4): mask32x4;
declare function velt_simd_f32x4_gt(a: f32x4, b: f32x4): mask32x4;
declare function velt_simd_f32x4_ge(a: f32x4, b: f32x4): mask32x4;
declare function velt_simd_f32x4_zip_low(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_zip_high(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_to_i32x4(v: f32x4): i32x4;
declare function velt_simd_f32x4_to_u32x4(v: f32x4): u32x4;
declare function velt_simd_f32x4_as_i32x4(v: f32x4): i32x4;
declare function velt_simd_f32x4_as_u32x4(v: f32x4): u32x4;
declare function velt_simd_f32x4_as_u8x16(v: f32x4): u8x16;

extend f32x4 {
  /** A vector with every lane `x`. */
  static splat(x: f32): f32x4 {
    return velt_simd_f32x4_splat(x);
  }

  /**
   * The 4 elements of `from` starting at `at`. Panics with a RangeError unless all 4 are
   * inside the array.
   */
  static load(from: f32[], at: usize = 0): f32x4 {
    if (!f32x4.fits(from, at)) {
      panic("RangeError: f32x4.load: range is out of bounds");
    }
    return velt_simd_f32x4_load(from, at as u64);
  }

  /**
   * Whether the 4 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (f32x4.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: f32[], at: usize = 0): bool {
    return velt_simd_f32x4_fits(xs, at as u64);
  }

  /** The vector whose lanes are their own indices: 0, 1, 2, … */
  static index(): f32x4 {
    return velt_simd_f32x4_index();
  }

  /**
   * The elements of `from` starting at `at` that exist, up to 4, in the low lanes; the other
   * lanes are 0. For the last elements of an array, after the steps that take 4 at a time.
   */
  static loadPartial(from: f32[], at: usize = 0): f32x4 {
    if (f32x4.fits(from, at)) {
      return velt_simd_f32x4_load(from, at as u64);
    }
    let v = velt_simd_f32x4_splat(0);
    if (at < from.length) {
      const left = from.length - at;
      for (let k: usize = 0; k < left; k++) {
        v = velt_simd_f32x4_with_lane(v, k as u64, from[at + k]);
      }
    }
    return v;
  }

  /** Lane by lane, `a` where the mask is set and `b` elsewhere. */
  static select(m: mask32x4, a: f32x4, b: f32x4): f32x4 {
    return velt_simd_f32x4_select(m, a, b);
  }

  /**
   * Writes the 4 lanes to `to` starting at `at`. Panics with a RangeError unless all 4
   * elements are inside the array (it does not grow).
   */
  store(to: f32[], at: usize = 0) {
    if (!f32x4.fits(to, at)) {
      panic("RangeError: f32x4.store: range is out of bounds");
    }
    velt_simd_f32x4_store(this, to, at as u64);
  }

  /**
   * Writes the low lanes to the elements of `to` starting at `at` that exist, up to 4 (the
   * array does not grow): what `loadPartial` read, back.
   */
  storePartial(to: f32[], at: usize = 0) {
    if (f32x4.fits(to, at)) {
      velt_simd_f32x4_store(this, to, at as u64);
    } else if (at < to.length) {
      const left = to.length - at;
      for (let k: usize = 0; k < left; k++) {
        to[at + k] = velt_simd_f32x4_lane(this, k as u64);
      }
    }
  }

  /** Lane `index` (0 to 3; panics with a RangeError otherwise). */
  lane(index: usize): f32 {
    if (index >= 4) {
      panic("RangeError: f32x4.lane: index is out of range");
    }
    return velt_simd_f32x4_lane(this, index as u64);
  }

  /** This vector with lane `index` (0 to 3; panics with a RangeError otherwise) set to `x`. */
  withLane(index: usize, x: f32): f32x4 {
    if (index >= 4) {
      panic("RangeError: f32x4.withLane: index is out of range");
    }
    return velt_simd_f32x4_with_lane(this, index as u64, x);
  }

  /** Lane-wise sum. */
  add(other: f32x4): f32x4 {
    return velt_simd_f32x4_add(this, other);
  }

  /** Lane-wise difference. */
  sub(other: f32x4): f32x4 {
    return velt_simd_f32x4_sub(this, other);
  }

  /** Lane-wise product. */
  mul(other: f32x4): f32x4 {
    return velt_simd_f32x4_mul(this, other);
  }

  /** Lane-wise quotient. */
  div(other: f32x4): f32x4 {
    return velt_simd_f32x4_div(this, other);
  }

  /** The smaller of each pair of lanes (as `Math.min` and `Math.max`: NaN if either is). */
  min(other: f32x4): f32x4 {
    return velt_simd_f32x4_min(this, other);
  }

  /** The larger of each pair of lanes (as `Math.min` and `Math.max`: NaN if either is). */
  max(other: f32x4): f32x4 {
    return velt_simd_f32x4_max(this, other);
  }

  /** Each lane negated. */
  neg(): f32x4 {
    return velt_simd_f32x4_neg(this);
  }

  /** The absolute value of each lane. */
  abs(): f32x4 {
    return velt_simd_f32x4_abs(this);
  }

  /** The square root of each lane. */
  sqrt(): f32x4 {
    return velt_simd_f32x4_sqrt(this);
  }

  /** The lanes where this vector equals `other` (a NaN lane equals nothing). */
  eq(other: f32x4): mask32x4 {
    return velt_simd_f32x4_eq(this, other);
  }

  /** The lanes where this vector differs from `other` (a NaN lane differs from everything). */
  ne(other: f32x4): mask32x4 {
    return velt_simd_f32x4_ne(this, other);
  }

  /** The lanes where this vector is less than `other`. */
  lt(other: f32x4): mask32x4 {
    return velt_simd_f32x4_lt(this, other);
  }

  /** The lanes where this vector is at most `other`. */
  le(other: f32x4): mask32x4 {
    return velt_simd_f32x4_le(this, other);
  }

  /** The lanes where this vector is greater than `other`. */
  gt(other: f32x4): mask32x4 {
    return velt_simd_f32x4_gt(this, other);
  }

  /** The lanes where this vector is at least `other`. */
  ge(other: f32x4): mask32x4 {
    return velt_simd_f32x4_ge(this, other);
  }

  /** The sum of the lanes (added in lane order). */
  sum(): f32 {
    return velt_simd_f32x4_lane(this, 0) +
      velt_simd_f32x4_lane(this, 1) +
      velt_simd_f32x4_lane(this, 2) +
      velt_simd_f32x4_lane(this, 3);
  }

  /** The lanes of the low halves of this vector and `other` in turn: a0, b0, a1, b1, … */
  zipLow(other: f32x4): f32x4 {
    return velt_simd_f32x4_zip_low(this, other);
  }

  /** The lanes of the high halves of this vector and `other` in turn. */
  zipHigh(other: f32x4): f32x4 {
    return velt_simd_f32x4_zip_high(this, other);
  }

  /** Each lane as an `i32`: truncated toward zero, clamped to its range, NaN as 0. */
  toI32x4(): i32x4 {
    return velt_simd_f32x4_to_i32x4(this);
  }

  /** Each lane as a `u32`: truncated toward zero, clamped to its range, NaN as 0. */
  toU32x4(): u32x4 {
    return velt_simd_f32x4_to_u32x4(this);
  }

  /** The same 128 bits as a `i32x4` (no conversion of values). */
  asI32x4(): i32x4 {
    return velt_simd_f32x4_as_i32x4(this);
  }

  /** The same 128 bits as a `u32x4` (no conversion of values). */
  asU32x4(): u32x4 {
    return velt_simd_f32x4_as_u32x4(this);
  }

  /** The same 128 bits as a `u8x16` (no conversion of values). */
  asU8x16(): u8x16 {
    return velt_simd_f32x4_as_u8x16(this);
  }
}

