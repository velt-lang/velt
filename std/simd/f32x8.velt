// velt/simd (internal): `f32x8`, eight `f32` lanes (#3140): two `f32x4` halves that a CPU with
// 256-bit registers computes as one vector (AVX: one `ymm` instruction where `f32x4` takes two
// `xmm` ones) and every other CPU as the two halves, so a kernel written with it is as fast as
// the `f32x4` one on arm64 and uses the wider registers on x86 with `--cpu x86-64-v3`. Each lane
// is what `f32x4` gives for the same lane of the matching half, on every CPU. The
// `velt_simd_f32x8_*` functions below have no runtime implementation, the compiler emits them
// inline (rt_abi.md "SIMD"); they take the vector by address.

declare function velt_simd_f32x8_splat(x: f32): f32x8;
declare function velt_simd_f32x8_load(from: f32[], at: u64): f32x8;
declare function velt_simd_f32x8_store(v: f32x8, to: f32[], at: u64);
declare function velt_simd_f32x8_add(a: f32x8, b: f32x8): f32x8;
declare function velt_simd_f32x8_sub(a: f32x8, b: f32x8): f32x8;
declare function velt_simd_f32x8_mul(a: f32x8, b: f32x8): f32x8;
declare function velt_simd_f32x8_div(a: f32x8, b: f32x8): f32x8;
declare function velt_simd_f32x8_mul_add(a: f32x8, b: f32x8, c: f32x8): f32x8;
declare function velt_simd_f32x8_mul_add_fast(a: f32x8, b: f32x8, c: f32x8): f32x8;
declare function velt_simd_f32x8_min(a: f32x8, b: f32x8): f32x8;
declare function velt_simd_f32x8_max(a: f32x8, b: f32x8): f32x8;
declare function velt_simd_f32x8_neg(v: f32x8): f32x8;
declare function velt_simd_f32x8_abs(v: f32x8): f32x8;
declare function velt_simd_f32x8_sqrt(v: f32x8): f32x8;
declare function velt_simd_f32x4_add(a: f32x4, b: f32x4): f32x4;
declare function velt_simd_f32x4_lane(v: f32x4, index: u64): f32;

/**
 * Eight `f32` lanes: lanes 0 to 3 are its low half and 4 to 7 its high half, each an `f32x4`
 * (`low()`, `high()`, `f32x8.join`). Every operation works lane by lane and gives, in each
 * lane, exactly what the `f32x4` operation gives.
 */
export struct f32x8 {
  private lo: f32x4;
  private hi: f32x4;

  /** A vector with every lane `x`. */
  static splat(x: f32): f32x8 {
    return velt_simd_f32x8_splat(x);
  }

  /** The vector whose lanes 0 to 3 are `lo`'s and 4 to 7 `hi`'s. */
  static join(lo: f32x4, hi: f32x4): f32x8 {
    return { lo, hi };
  }

  /**
   * Whether the 8 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (f32x8.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: f32[], at: usize = 0): bool {
    const n = xs.length;
    return at <= n && n - at >= 8;
  }

  /**
   * The 8 elements of `from` starting at `at`. Panics with a RangeError unless all 8 are
   * inside the array.
   */
  static load(from: f32[], at: usize = 0): f32x8 {
    if (!f32x8.fits(from, at)) {
      panic("RangeError: f32x8.load: range is out of bounds");
    }
    return velt_simd_f32x8_load(from, at as u64);
  }

  /**
   * Writes the 8 lanes to `to` starting at `at`. Panics with a RangeError unless all 8
   * elements are inside the array (it does not grow).
   */
  store(to: f32[], at: usize = 0) {
    if (!f32x8.fits(to, at)) {
      panic("RangeError: f32x8.store: range is out of bounds");
    }
    velt_simd_f32x8_store(this, to, at as u64);
  }

  /** Lanes 0 to 3. */
  low(): f32x4 {
    return this.lo;
  }

  /** Lanes 4 to 7. */
  high(): f32x4 {
    return this.hi;
  }

  /** Lane `index` (0 to 7; panics with a RangeError otherwise). */
  lane(index: usize): f32 {
    if (index >= 8) {
      panic("RangeError: f32x8.lane: index is out of range");
    }
    if (index < 4) {
      return velt_simd_f32x4_lane(this.lo, index as u64);
    }
    return velt_simd_f32x4_lane(this.hi, (index - 4) as u64);
  }

  /** Lane-wise sum. */
  add(other: f32x8): f32x8 {
    return velt_simd_f32x8_add(this, other);
  }

  /** Lane-wise difference. */
  sub(other: f32x8): f32x8 {
    return velt_simd_f32x8_sub(this, other);
  }

  /** Lane-wise product. */
  mul(other: f32x8): f32x8 {
    return velt_simd_f32x8_mul(this, other);
  }

  /** Lane-wise quotient. */
  div(other: f32x8): f32x8 {
    return velt_simd_f32x8_div(this, other);
  }

  /**
   * `this * b + c` lane-wise with one rounding (fused multiply-add): the exact product added,
   * the same bits on every CPU. One instruction where the CPU has FMA (arm64; x86 with
   * `--cpu x86-64-v3` or later); elsewhere a library call per lane, so prefer
   * `mulAddFast` where the last bit may vary.
   */
  mulAdd(b: f32x8, c: f32x8): f32x8 {
    return velt_simd_f32x8_mul_add(this, b, c);
  }

  /**
   * `this * b + c` lane-wise, fused where the CPU does that fastest and as a multiply and an add
   * elsewhere: always fast, but the last bit may differ between CPUs. `mulAdd` is exact.
   */
  mulAddFast(b: f32x8, c: f32x8): f32x8 {
    return velt_simd_f32x8_mul_add_fast(this, b, c);
  }

  /** Lane-wise minimum, as `Math.min`: NaN if either lane is NaN, and -0 below +0. */
  min(other: f32x8): f32x8 {
    return velt_simd_f32x8_min(this, other);
  }

  /** Lane-wise maximum, as `Math.max`: NaN if either lane is NaN, and -0 below +0. */
  max(other: f32x8): f32x8 {
    return velt_simd_f32x8_max(this, other);
  }

  /** Each lane negated. */
  neg(): f32x8 {
    return velt_simd_f32x8_neg(this);
  }

  /** Each lane's absolute value. */
  abs(): f32x8 {
    return velt_simd_f32x8_abs(this);
  }

  /** Each lane's square root. */
  sqrt(): f32x8 {
    return velt_simd_f32x8_sqrt(this);
  }

  /**
   * The sum of the lanes: the two halves added lane by lane, then those four sums added in
   * lane order (`low().add(high()).sum()`), the same number on every CPU.
   */
  sum(): f32 {
    const s = velt_simd_f32x4_add(this.lo, this.hi);
    return velt_simd_f32x4_lane(s, 0) +
      velt_simd_f32x4_lane(s, 1) +
      velt_simd_f32x4_lane(s, 2) +
      velt_simd_f32x4_lane(s, 3);
  }
}
