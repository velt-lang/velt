// velt/simd (internal): whether the CPU has Arm's bf16 instructions, on Linux (`#simd-bf16`'s
// linux variant, std/imports.velt): the kernel's second word of hardware capabilities. Called on
// arm64 only (std/simd/bf16_check.velt).

declare c("c") function getauxval(kind: u64): u64;

/** `AT_HWCAP2`, the auxiliary vector's second capability word. */
const AT_HWCAP2: u64 = 26;
/** `HWCAP2_BF16` of arm64's `asm/hwcap.h`: FEAT_BF16. */
const HWCAP2_BF16: u64 = 1 << 14;

export function cpuHasBf16(): bool {
  // SAFETY: reads the process's auxiliary vector; an entry that is not there reads as 0.
  const caps = unsafe { getauxval(AT_HWCAP2) };
  return (caps & HWCAP2_BF16) != 0;
}
