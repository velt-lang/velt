// velt/simd (internal): whether the CPU has Arm's bf16 instructions (FEAT_BF16), the check of
// `bf16x8.hasBf16Arm()` and of `targetFeature("bf16-arm")` (#3129): velt/half's `dotBf16Fast` is
// the CPU's `bfdot` where it is true, in a build for any arm64 CPU.
//
// It is false off arm64, on WebAssembly, in debug (Cranelift) builds, and with
// `VELT_SIMD_DISABLE=clmul`: the runtime's carry-less flag guards it, so that it folds to false
// elsewhere and that variable turns it off without std parsing it. FEAT_BF16 does not imply
// FEAT_PMULL: a CPU with bf16 and no carry-less multiplication (the known ones all have both)
// gets "no" here, and the slower path. The runtime keeps no flag for bf16 itself (#2241): the
// answer comes from the operating system (`#simd-bf16`, std/imports.velt), read once and kept in
// `DETECTED`.

import { noInline } from "velt/lang/intrinsics";
import { cpuHasBf16 } from "#simd-bf16";

// The runtime's carry-less flag: false on every other architecture, on wasm and in debug builds.
declare function velt_simd_has_clmul_arm(): bool;

// What this CPU has, once computed: bit 0 set (computed), bit 1 bf16. A static atomic; threads
// that race to compute it store the same value.
const DETECTED = new Atomic<u32>(0);

// The first check: asks, and keeps the answer. Out of line: it runs once.
@noInline
function first(): bool {
  const has = cpuHasBf16();
  DETECTED.store(has ? 3 : 1, "relaxed");
  return has;
}

/** Whether this arm64 CPU has FEAT_BF16, asked at run time (false where the carry-less flag is). */
export function detectedBf16Arm(): bool {
  if (!velt_simd_has_clmul_arm()) {
    return false;
  }
  // The answer "yes" first: one load and one test where the CPU has it.
  const found = DETECTED.load("relaxed");
  if ((found & 2) != 0) {
    return true;
  }
  return found == 0 && first();
}
