// velt/simd (internal): `bf16x8`, eight `bf16` lanes: a storage type like `bf16`, for moving 16-bit weights
// into and out of `f32x4` arithmetic. It has no arithmetic of its own: `widenLow` and `widenHigh`
// give `f32x4`, and `bf16x8.narrow` takes them back. The `velt_simd_*` functions below have no runtime implementation, the
// compiler emits them inline (rt_abi.md "SIMD").

export type bf16x8 = bf16x8;

declare function velt_simd_bf16x8_fits(xs: bf16[], at: u64): bool;
declare function velt_simd_bf16x8_splat(x: bf16): bf16x8;
declare function velt_simd_bf16x8_load(from: bf16[], at: u64): bf16x8;
declare function velt_simd_bf16x8_store(v: bf16x8, to: bf16[], at: u64);
declare function velt_simd_bf16x8_load_partial(from: bf16[], at: u64, count: u64): bf16x8;
declare function velt_simd_bf16x8_store_partial(v: bf16x8, to: bf16[], at: u64, count: u64);
declare function velt_simd_bf16x8_lane(v: bf16x8, index: u64): bf16;
declare function velt_simd_bf16x8_with_lane(v: bf16x8, index: u64, x: bf16): bf16x8;
declare function velt_simd_bf16x8_as_u16x8(v: bf16x8): u16x8;
declare function velt_simd_u16x8_as_bf16x8(v: u16x8): bf16x8;
declare function velt_simd_bf16x8_widen_low(v: bf16x8): f32x4;
declare function velt_simd_bf16x8_widen_high(v: bf16x8): f32x4;
declare function velt_simd_f32x4_narrow_bf16x8(lo: f32x4, hi: f32x4): bf16x8;

extend bf16x8 {
  /** A vector with every lane `x`. */
  static splat(x: bf16): bf16x8 {
    return velt_simd_bf16x8_splat(x);
  }

  /**
   * The 8 elements of `from` starting at `at`. Panics with a RangeError unless all 8 are
   * inside the array.
   */
  static load(from: bf16[], at: usize = 0): bf16x8 {
    if (!bf16x8.fits(from, at)) {
      panic("RangeError: bf16x8.load: range is out of bounds");
    }
    return velt_simd_bf16x8_load(from, at as u64);
  }

  /**
   * Whether the 8 elements of `xs` starting at `at` are inside the array: what `load` and
   * `store` check. As the condition of the loop that calls them (`while (bf16x8.fits(xs, i))`),
   * it leaves them nothing to check.
   */
  static fits(xs: bf16[], at: usize = 0): bool {
    return velt_simd_bf16x8_fits(xs, at as u64);
  }

  /**
   * The elements of `from` starting at `at` that exist, up to 8, in the low lanes; the other
   * lanes are 0. For the last elements of an array, after the steps that take 8 at a time.
   * `at` may be the length (no element left); past it, panics with a RangeError.
   */
  static loadPartial(from: bf16[], at: usize = 0): bf16x8 {
    if (bf16x8.fits(from, at)) {
      return velt_simd_bf16x8_load(from, at as u64);
    }
    if (at > from.length) {
      panic("RangeError: bf16x8.loadPartial: position is out of range");
    }
    return velt_simd_bf16x8_load_partial(from, at as u64, (from.length - at) as u64);
  }

  /**
   * Writes the 8 lanes to `to` starting at `at`. Panics with a RangeError unless all 8
   * elements are inside the array (it does not grow).
   */
  store(to: bf16[], at: usize = 0) {
    if (!bf16x8.fits(to, at)) {
      panic("RangeError: bf16x8.store: range is out of bounds");
    }
    velt_simd_bf16x8_store(this, to, at as u64);
  }

  /**
   * Writes the low lanes to the elements of `to` starting at `at` that exist, up to 8 (the
   * array does not grow): what `loadPartial` read, back. `at` may be the length (nothing is
   * written); past it, panics with a RangeError.
   */
  storePartial(to: bf16[], at: usize = 0) {
    if (bf16x8.fits(to, at)) {
      velt_simd_bf16x8_store(this, to, at as u64);
      return;
    }
    if (at > to.length) {
      panic("RangeError: bf16x8.storePartial: position is out of range");
    }
    velt_simd_bf16x8_store_partial(this, to, at as u64, (to.length - at) as u64);
  }

  /** Lane `index` (0 to 7; panics with a RangeError otherwise). */
  lane(index: usize): bf16 {
    if (index >= 8) {
      panic("RangeError: bf16x8.lane: index is out of range");
    }
    return velt_simd_bf16x8_lane(this, index as u64);
  }

  /** This vector with lane `index` (0 to 7; panics with a RangeError otherwise) set to `x`. */
  withLane(index: usize, x: bf16): bf16x8 {
    if (index >= 8) {
      panic("RangeError: bf16x8.withLane: index is out of range");
    }
    return velt_simd_bf16x8_with_lane(this, index as u64, x);
  }

  /** The same bits as a `u16x8`: no conversion. */
  asU16x8(): u16x8 {
    return velt_simd_bf16x8_as_u16x8(this);
  }

  /** The same bits as a `bf16x8`: no conversion. */
  static fromU16x8(bits: u16x8): bf16x8 {
    return velt_simd_u16x8_as_bf16x8(bits);
  }

  /** Lanes 0 to 3 as `f32`, exactly. A NaN keeps its payload, with its quiet bit set. */
  widenLow(): f32x4 {
    return velt_simd_bf16x8_widen_low(this);
  }

  /** Lanes 4 to 7 as `f32`, exactly. A NaN keeps its payload, with its quiet bit set. */
  widenHigh(): f32x4 {
    return velt_simd_bf16x8_widen_high(this);
  }

  /**
   * The lanes of `lo`, then of `hi`, each rounded once to the nearest `bf16` (ties to even). A NaN
   * keeps the top bits of its payload, with its quiet bit set.
   */
  static narrow(lo: f32x4, hi: f32x4): bf16x8 {
    return velt_simd_f32x4_narrow_bf16x8(lo, hi);
  }
}
