extend i8x16 {
  /** `this + other`: the lane-wise sum, wrapping on overflow. */
  [Symbol.add](other: i8x16): i8x16 {
    return velt_simd_i8x16_add(this, other);
  }

  /** `this - other`: the lane-wise difference, wrapping on overflow. */
  [Symbol.sub](other: i8x16): i8x16 {
    return velt_simd_i8x16_sub(this, other);
  }

  /** `this & other`: bitwise AND. */
  [Symbol.bitAnd](other: i8x16): i8x16 {
    return velt_simd_i8x16_and(this, other);
  }

  /** `this | other`: bitwise OR. */
  [Symbol.bitOr](other: i8x16): i8x16 {
    return velt_simd_i8x16_or(this, other);
  }

  /** `this ^ other`: bitwise XOR. */
  [Symbol.bitXor](other: i8x16): i8x16 {
    return velt_simd_i8x16_xor(this, other);
  }

  /** `-this`: each lane negated (wrapping). */
  [Symbol.neg](): i8x16 {
    return velt_simd_i8x16_neg(this);
  }

  /** `~this`: every bit flipped. */
  [Symbol.bitNot](): i8x16 {
    return velt_simd_i8x16_not(this);
  }

  /** `this << count`: each lane shifted left by `count` bits (taken modulo 8). */
  [Symbol.shl](count: u32): i8x16 {
    return velt_simd_i8x16_shl(this, count);
  }

  /**
   * `this >> count`: each lane shifted right by `count` bits (taken modulo 8),
   * keeping the sign.
   */
  [Symbol.shr](count: u32): i8x16 {
    return velt_simd_i8x16_shr(this, count);
  }

  /** `this >>> count`: each lane shifted right by `count` bits (taken modulo 8), filling with zeros. */
  [Symbol.ushr](count: u32): i8x16 {
    return velt_simd_u8x16_as_i8x16(velt_simd_u8x16_shr(velt_simd_i8x16_as_u8x16(this), count));
  }

  /** `this[index]`: lane `index` (0 to 15; panics with a RangeError otherwise). */
  [Symbol.index](index: usize): i8 {
    if (index >= 16) {
      panic("RangeError: i8x16[index]: index is out of range");
    }
    return velt_simd_i8x16_lane(this, index as u64);
  }
}

