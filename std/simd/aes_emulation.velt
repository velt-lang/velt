// velt/simd (internal): the exact emulation of the CPU's AES round instructions
// (std/simd/aes.velt), from FIPS-197's SubBytes, ShiftRows and MixColumns and their inverses, for a
// CPU without them. Table-free: the S-box is the Boyar-Peralta circuit of std/crypto, the inverse
// S-box that circuit between two affine maps, and the products in MixColumns shifts, masks and
// XORs. Nothing indexes memory, branches, loops or multiplies by the data, so the work is the same
// for every input.

import { interleaveIn, interleaveOut, ortho, sbox } from "velt/crypto/aes_bitslice";

// The bit planes of `v` (word i holds bit i of every byte), as `sbox` takes them.
function planes(v: u8x16): u64[] {
  const w = v.asU32x4();
  const q: u64[] = [0, 0, 0, 0, 0, 0, 0, 0];
  interleaveIn(q, 0, w.lane(0), w.lane(1), w.lane(2), w.lane(3));
  ortho(q);
  return q;
}

// The inverse of `planes`.
function fromPlanes(q: u64[]): u8x16 {
  ortho(q);
  return u32x4
    .splat(interleaveOut(q[0], q[4], 0))
    .withLane(1, interleaveOut(q[0], q[4], 1))
    .withLane(2, interleaveOut(q[0], q[4], 2))
    .withLane(3, interleaveOut(q[0], q[4], 3))
    .asU8x16();
}

// The inverse of the affine map A at the end of the S-box (FIPS-197 5.3.2) on bit planes:
// XOR 0x63, then bit i is bits i + 2, i + 5 and i + 7 of that.
function inverseAffine(q: u64[]) {
  const q0 = ~q[0];
  const q1 = ~q[1];
  const q2 = q[2];
  const q3 = q[3];
  const q4 = q[4];
  const q5 = ~q[5];
  const q6 = ~q[6];
  const q7 = q[7];
  q[0] = q2 ^ q5 ^ q7;
  q[1] = q3 ^ q6 ^ q0;
  q[2] = q4 ^ q7 ^ q1;
  q[3] = q5 ^ q0 ^ q2;
  q[4] = q6 ^ q1 ^ q3;
  q[5] = q7 ^ q2 ^ q4;
  q[6] = q0 ^ q3 ^ q5;
  q[7] = q1 ^ q4 ^ q6;
}

/** SubBytes alone. */
export function subBytes(v: u8x16): u8x16 {
  const q = planes(v);
  sbox(q);
  return fromPlanes(q);
}

// InvSubBytes: the S-box is A after inversion, so A^-1, the S-box, A^-1 is inversion after A^-1.
function invSubBytes(v: u8x16): u8x16 {
  const q = planes(v);
  inverseAffine(q);
  sbox(q);
  inverseAffine(q);
  return fromPlanes(q);
}

/** ShiftRows then SubBytes (they commute). */
export function subShift(v: u8x16): u8x16 {
  return subBytes(u8x16.shuffle(v, v, 0, 5, 10, 15, 4, 9, 14, 3, 8, 13, 2, 7, 12, 1, 6, 11));
}

/** InvShiftRows then InvSubBytes. */
export function invSubShift(v: u8x16): u8x16 {
  return invSubBytes(u8x16.shuffle(v, v, 0, 13, 10, 7, 4, 1, 14, 11, 8, 5, 2, 15, 12, 9, 6, 3));
}

// Each byte times 2 in GF(2^8) modulo x^8 + x^4 + x^3 + x + 1: the carry out of each byte, moved
// to its bit 0, XORed back in at 0x1b's four bits.
function xtime(x: u32x4): u32x4 {
  const carry = x.shr(7).and(u32x4.splat(0x01010101));
  return x
    .shl(1)
    .and(u32x4.splat(0xfefefefe))
    .xor(carry)
    .xor(carry.shl(1))
    .xor(carry.shl(3))
    .xor(carry.shl(4));
}

// Each column's bytes moved down by `bits` (8, 16 or 24), the low ones around to the top.
function rotate(x: u32x4, bits: u32): u32x4 {
  return x.shr(bits).or(x.shl(32 - bits));
}

// Each column times the circulant matrix with first row 2 3 1 1.
function mix(x: u32x4): u32x4 {
  const r1 = rotate(x, 8);
  return xtime(x.xor(r1)).xor(r1).xor(rotate(x, 16)).xor(rotate(x, 24));
}

/** MixColumns. */
export function mixColumns(v: u8x16): u8x16 {
  return mix(v.asU32x4()).asU8x16();
}

/** InvMixColumns: 14 11 13 9 is 2 3 1 1 times 5 0 4 0, each column plus 4 times itself and its opposite. */
export function invMixColumns(v: u8x16): u8x16 {
  const x = v.asU32x4();
  return mix(x.xor(xtime(xtime(x.xor(rotate(x, 16)))))).asU8x16();
}
