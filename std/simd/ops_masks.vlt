declare function velt_simd_mask8x16_not(m: mask8x16): mask8x16;

extend mask8x16 {
  /** `this & other`: the lanes set in both masks. */
  [Symbol.bitAnd](other: mask8x16): mask8x16 {
    return velt_simd_mask8x16_and(this, other);
  }

  /** `this | other`: the lanes set in either mask. */
  [Symbol.bitOr](other: mask8x16): mask8x16 {
    return velt_simd_mask8x16_or(this, other);
  }

  /** `this ^ other`: the lanes set in exactly one of the masks. */
  [Symbol.bitXor](other: mask8x16): mask8x16 {
    return velt_simd_mask8x16_xor(this, other);
  }

  /** `~this`: the lanes that are not set. */
  [Symbol.bitNot](): mask8x16 {
    return velt_simd_mask8x16_not(this);
  }
}

