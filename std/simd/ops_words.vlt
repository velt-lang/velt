extend i32x4 {
  /** `this + other`: the lane-wise sum, wrapping on overflow. */
  [Symbol.add](other: i32x4): i32x4 {
    return velt_simd_i32x4_add(this, other);
  }

  /** `this - other`: the lane-wise difference, wrapping on overflow. */
  [Symbol.sub](other: i32x4): i32x4 {
    return velt_simd_i32x4_sub(this, other);
  }

  /** `this * other`: the lane-wise product, wrapping on overflow. */
  [Symbol.mul](other: i32x4): i32x4 {
    return velt_simd_i32x4_mul(this, other);
  }

  /** `this & other`: bitwise AND. */
  [Symbol.bitAnd](other: i32x4): i32x4 {
    return velt_simd_i32x4_and(this, other);
  }

  /** `this | other`: bitwise OR. */
  [Symbol.bitOr](other: i32x4): i32x4 {
    return velt_simd_i32x4_or(this, other);
  }

  /** `this ^ other`: bitwise XOR. */
  [Symbol.bitXor](other: i32x4): i32x4 {
    return velt_simd_i32x4_xor(this, other);
  }

  /** `-this`: each lane negated (wrapping). */
  [Symbol.neg](): i32x4 {
    return velt_simd_i32x4_neg(this);
  }

  /** `~this`: every bit flipped. */
  [Symbol.bitNot](): i32x4 {
    return velt_simd_i32x4_not(this);
  }

  /** `this << count`: each lane shifted left by `count` bits (taken modulo 32). */
  [Symbol.shl](count: u32): i32x4 {
    return velt_simd_i32x4_shl(this, count);
  }

  /**
   * `this >> count`: each lane shifted right by `count` bits (taken modulo 32),
   * keeping the sign.
   */
  [Symbol.shr](count: u32): i32x4 {
    return velt_simd_i32x4_shr(this, count);
  }

  /** `this >>> count`: each lane shifted right by `count` bits (taken modulo 32), filling with zeros. */
  [Symbol.ushr](count: u32): i32x4 {
    return velt_simd_u32x4_as_i32x4(velt_simd_u32x4_shr(velt_simd_i32x4_as_u32x4(this), count));
  }

  /** `this[index]`: lane `index` (0 to 3; panics with a RangeError otherwise). */
  [Symbol.index](index: usize): i32 {
    if (index >= 4) {
      panic("RangeError: i32x4[index]: index is out of range");
    }
    return velt_simd_i32x4_lane(this, index as u64);
  }
}

