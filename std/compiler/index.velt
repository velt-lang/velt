// velt/compiler: decorators that tell the compiler how to compile a function, for std, packages
// and programs alike (docs/internals/design/package-machine-code.md).
//
//   import { align, inline, noInline, repr, targetFeature } from "velt/compiler";
//
//   export struct Fixed {
//     readonly raw: i64;
//     @inline [Symbol.add](o: Fixed): Fixed { return { raw: this.raw + o.raw }; }
//   }
//
// `@inline` offers a function's body to its callers and asks the inliner to prefer it, as Rust's
// `#[inline]`; `@inline("always")` inlines every call in release builds whatever its size (not on
// a recursive function); `@noInline` keeps every call a call. None applies to a generator or an
// async function.
//
// `@targetFeature("clmul-x86")` compiles a function for a CPU extension. Every call of it must sit
// behind velt/arch's check of that extension (an `if`, not `?:`), or in a function gated on
// features that cover it:
//
//   @targetFeature("clmul-x86")
//   function mulX86(a: u64x2, b: u64x2): u64x2 { return a.clmulLow(b); }
//
//   if (Pclmulqdq.isSupported()) {
//     c = mulX86(a, b);
//   } else {
//     c = mulPortable(a, b);
//   }
//
// `@repr("transparent")` passes a struct of one field exactly as that field, to C too, and
// `@align(64)` aligns a struct's values (and pads its size) to 64 bytes:
//
//   @repr("transparent")
//   export struct Meters { readonly m: f64; }
//   declare c("geo") function distance(a: Meters, b: Meters): Meters; // C: double (double, double)
//
//   @align(64)
//   struct Counter { n: u64; } // one cache line per element of a `Counter[]`

/** How calls of a function are inlined: `@inline` (`"hint"`) or `@inline("always")`. */
export { inline } from "velt/lang/intrinsics/decorators";
/** Calls of a function stay calls. */
export { noInline } from "velt/lang/intrinsics/decorators";
/**
 * The function is compiled for CPU features; every call sits behind velt/arch's checks of them
 * (`if (Sha.isSupported()) { … }`) or in a function gated on features that cover them.
 */
export { targetFeature } from "velt/lang/intrinsics/decorators";
/** A struct of one field is passed exactly as that field, in registers and to C. */
export { repr } from "velt/lang/intrinsics/decorators";
/** A struct's values are aligned to `bytes`, and its size is a multiple of it. */
export { align } from "velt/lang/intrinsics/decorators";
