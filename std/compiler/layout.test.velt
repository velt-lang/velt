// velt/compiler (tests): white-box tests, run by `velt test std/`.
//
// The layout decorators (docs/internals/design/package-machine-code.md §5): a
// `@repr("transparent")` struct crosses to C as its one field, both ways, and an `@align(n)`
// struct's values keep their fields in arrays, in other structs and in sets (the layouts
// themselves: crates/veltc/tests/layout_decorators.rs).
import { describe, expect, it } from "velt/test";
import { Ptr } from "velt/ffi/ptr";
import { align, repr } from "velt/lang/intrinsics/decorators";
import { Set } from "velt/collections/set";
import { readBytes } from "velt/ffi/read";

@repr("transparent")
struct Meters {
  readonly m: f64;
}

@repr("transparent")
struct Ratio {
  readonly r: f32;
}

@repr("transparent")
struct Count {
  readonly n: i64;
}

/** A transparent struct of a transparent struct crosses as the innermost field. */
@repr("transparent")
struct Distance {
  readonly meters: Meters;
}

/** Generic, so it nests to any depth: `Wrap<Wrap<…<Meters>…>>` still crosses as a `double`. */
@repr("transparent")
struct Wrap<T> {
  readonly v: T;
}

@repr("transparent")
struct Block {
  readonly p: Ptr<u8>;
}

declare c("c") function sqrt(x: Meters): Meters;
declare c("c") function cbrtf(x: Ratio): Ratio;
declare c("c") function llabs(x: Count): Count;
declare c("c") function sqrt$twice(x: Distance): Distance;
declare c("c") function sqrt$deep(
  x: Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Meters>>>>>>>>>>>>>>>>>>>>,
): Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Meters>>>>>>>>>>>>>>>>>>>>;
declare c("c") function malloc(n: usize): Block;
declare c("c") function memset(p: Block, c: i32, n: usize): Block;
declare c("c") function free(p: Block): void;

@align(64)
struct Line {
  readonly n: u64;
}

/** An aligned struct inside another: the outer one takes its alignment. */
struct Tagged {
  readonly tag: u8;
  readonly line: Line;
}

/** `@align` never lowers the natural alignment. */
@align(2)
struct Word {
  readonly w: u64;
}

describe("@repr(\"transparent\")", () => {
  it("passes a struct of one number to C as the number", () => {
    // SAFETY: `sqrt` takes any double.
    const root = unsafe { sqrt({ m: 2.25 }) };
    // SAFETY: `cbrtf` takes any float.
    const cube = unsafe { cbrtf({ r: 27 }) };
    // SAFETY: `llabs` takes any value but LLONG_MIN.
    const abs = unsafe { llabs({ n: -42 }) };
    expect(root.m).toBe(1.5);
    expect(cube.r).toBe(3);
    expect(abs.n).toBe(42);
  });

  it("passes a transparent struct of a transparent struct as the innermost field", () => {
    // SAFETY: `sqrt` takes any double.
    const d = unsafe { sqrt$twice({ meters: { m: 6.25 } }) };
    expect(d.meters.m).toBe(2.5);
  });

  it("passes twenty transparent structs nested as the innermost field", () => {
    const x: Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Wrap<Meters>>>>>>>>>>>>>>>>>>>> = {
      v: {
        v: {
          v: {
            v: {
              v: {
                v: {
                  v: {
                    v: {
                      v: {
                        v: {
                          v: {
                            v: { v: { v: { v: { v: { v: { v: { v: { v: { m: 2.25 } } } } } } } } },
                          },
                        },
                      },
                    },
                  },
                },
              },
            },
          },
        },
      },
    };
    // SAFETY: `sqrt` takes any double.
    const d = unsafe { sqrt$deep(x) };
    expect(d.v.v.v.v.v.v.v.v.v.v.v.v.v.v.v.v.v.v.v.v.m).toBe(1.5);
  });

  it("passes a struct of a pointer as the pointer", () => {
    // SAFETY: `malloc` returns 16 bytes or NULL.
    const b = unsafe { malloc(16) };
    // SAFETY: the block from `malloc` has 16 bytes (the test passes only if it isn't NULL).
    const same = unsafe { memset(b, 7, 16) };
    expect(Ptr.addressOf(same.p)).toBe(Ptr.addressOf(b.p));
    // SAFETY: the block came from `malloc` and is freed once.
    unsafe {
      free(b);
    }
  });
});

describe("a transparent pointer argument", () => {
  it("is read before the later arguments run", () => {
    // SAFETY: `malloc` returns 4 bytes or NULL.
    const one = unsafe { malloc(4) };
    // SAFETY: as above.
    const two = unsafe { malloc(4) };
    // SAFETY: each block has 4 bytes.
    unsafe {
      memset(one, 0, 4);
      memset(two, 0, 4);
    }
    let b = one;
    // SAFETY: `b` is one of the two blocks, which have 4 bytes each.
    unsafe {
      memset(
        b,
        ((): i32 => {
          b = two;
          return 9;
        })(),
        4,
      );
    }
    // SAFETY: each block has 4 bytes, written above.
    const first = unsafe { readBytes(one.p, 4) };
    // SAFETY: as above.
    const second = unsafe { readBytes(two.p, 4) };
    expect(first.join(",")).toBe("9,9,9,9");
    expect(second.join(",")).toBe("0,0,0,0");
    // SAFETY: both blocks came from `malloc` and are freed once.
    unsafe {
      free(one);
      free(two);
    }
  });
});

describe("@align(n)", () => {
  it("keeps each element of an array of aligned structs", () => {
    const xs: Line[] = [{ n: 1 }, { n: 2 }, { n: 3 }];
    xs.push({ n: 4 });
    let sum: u64 = 0;
    for (const x of xs) {
      sum += x.n;
    }
    expect(sum).toBe(10);
    expect(xs[3].n).toBe(4);
  });

  it("keeps the fields of a struct holding an aligned one", () => {
    const ts: Tagged[] = [
      { tag: 1, line: { n: 5 } },
      { tag: 2, line: { n: 6 } },
    ];
    expect(ts[1].line.n + (ts[1].tag as u64)).toBe(8);
    expect(ts[0].tag).toBe(1);
  });

  it("never lowers the natural alignment", () => {
    const ws: Word[] = [{ w: 1 }, { w: 2 }];
    expect(ws[0].w + ws[1].w).toBe(3);
  });

  it("compares and hashes by the fields, not the padding", () => {
    const a: Line = { n: 9 };
    const b: Line = { n: 9 };
    expect(a === b).toBe(true);
    const seen = new Set<Line>([a, b, { n: 10 }]);
    expect(seen.size).toBe(2);
  });
});
