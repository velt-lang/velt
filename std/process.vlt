// std/process: command-line arguments, setting environment variables, working directory and exit
// (rt_abi_async.md §8), byte writes to standard output (`stdout.write`) and whether the standard
// streams are terminals (`stdout.isTTY`, `isatty(fd)`). Reading variables
// (`process.env.NAME`) and writing strings (`process.stdout.write(s)`) are on the builtin
// `process`, with no import (std/prelude/process.vlt). Strings are UTF-8 (the runtime uses the
// wide APIs on Windows).

import { IoResult, IoStatus, unwrapIo, checkIo } from "velt:io";

declare function velt_rt_process_args(): string[];
declare function velt_rt_env_set(name: string, value: string);
declare function velt_rt_env_remove(name: string);
declare function velt_rt_env_all(): string[];
declare function velt_rt_process_cwd(): IoResult<string>;
declare function velt_rt_process_chdir(path: string): IoStatus;
declare function velt_rt_stdout_write_bytes(bytes: u8[]);
declare function velt_rt_isatty(fd: i32): bool;

/**
 * Standard output as a synchronous byte sink (for strings, `process.stdout.write(s)` needs no
 * import). Writes are ordered with `console.log` and buffered the same way; a large array
 * (64 KiB or more) goes straight to the OS from the caller's buffer, without a copy. Portable: no
 * `/dev/stdout` needed.
 */
export struct Stdout {
  /** Writes raw bytes (the array stays the caller's, ready to be refilled). */
  write(bytes: u8[]) {
    velt_rt_stdout_write_bytes(bytes);
  }

  /**
   * Whether standard output is a terminal (Node's `process.stdout.isTTY`): false when it is
   * redirected to a file or a pipe, so a CLI can leave out colours. Asked once, then cached.
   */
  get isTTY(): bool {
    return velt_rt_isatty(1);
  }
}

export const stdout: Stdout = {};

/** Standard error, for its `isTTY` (write strings to it with `process.stderr.write(s)`). */
export struct Stderr {
  /** Whether standard error is a terminal (Node's `process.stderr.isTTY`). Cached. */
  get isTTY(): bool {
    return velt_rt_isatty(2);
  }
}

export const stderr: Stderr = {};

/** Standard input, for its `isTTY` (read it with `velt:stdin`). */
export struct Stdin {
  /** Whether standard input is a terminal (Node's `process.stdin.isTTY`). Cached. */
  get isTTY(): bool {
    return velt_rt_isatty(0);
  }
}

export const stdin: Stdin = {};

/**
 * Whether file descriptor `fd` is open and refers to a terminal (Node's `tty.isatty(fd)`): 0 is
 * standard input, 1 standard output, 2 standard error. On Windows only those three can be
 * terminals.
 */
export function isatty(fd: i32): bool {
  return velt_rt_isatty(fd);
}

/** Every command-line argument, starting with the program path (like C's `argv`). */
export function argv(): string[] {
  return velt_rt_process_args();
}

/** The arguments after the program path. */
export function args(): string[] {
  let all = velt_rt_process_args();
  if (all.length > 0) {
    __intrinsic_array_remove(all, 0);
  }
  return all;
}

/**
 * Every environment variable, as a snapshot (Node's `process.env` as an object): names in the
 * order the OS keeps them, which is Node's order too. On Windows names keep their case, and
 * lookups in the record are case-sensitive (`process.env.NAME` is not); the per-drive `=C:`
 * entries are left out, as in Node.
 */
export function envAll(): Record<string, string> {
  const pairs = velt_rt_env_all();
  const all: Record<string, string> = {};
  for (let i: usize = 0; i + 1 < pairs.length; i += 2) {
    all[pairs[i]] = pairs[i + 1];
  }
  return all;
}

/**
 * Not synchronized with concurrent `process.env` reads on other threads: set variables at startup.
 */
export function setEnv(name: string, value: string) {
  velt_rt_env_set(name, value);
}

export function removeEnv(name: string) {
  velt_rt_env_remove(name);
}

/** The current working directory (throws `IoError`). */
export function cwd(): string {
  return unwrapIo(velt_rt_process_cwd());
}

/** Changes the current working directory of the whole process (throws `IoError`). */
export function chdir(path: string) {
  checkIo(velt_rt_process_chdir(path));
}

/** Flushes stdout/stderr and ends the process with `code` (same as `process.exit`). */
export function exit(code: i32) {
  process.exit(code);
}
