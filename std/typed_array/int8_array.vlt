// velt:typed_array/int8_array: `Int8Array` (ES2024 §23.2), a view of a byte range of an `ArrayBuffer`
// (std/typed_array/buffer.vlt) as 8-bit signed integers. Programs use the global.
//
// Elements read as numbers and are converted when written, as in JS (`ToUint8`: 300 is 44,
// `-1` is 255; `Uint8ClampedArray` clamps; `Float32Array` rounds to `f32`). `xs[i]` reads
// element `i` (std's `__index`, which sema calls for `xs[i]`: crates/velt_sema/src/body/expr/
// indexers.rs) and panics out of range like an array index (JS reads `undefined`); `xs[i] = v`
// writes it and does nothing out of range, as in JS. `subarray` shares the buffer, `slice`
// copies.
//
// Generated by scripts/gen-typed-arrays.py: change the script, not this file.

import { ArrayBuffer, relative, toIndex, toInteger, toUint8 } from "velt:typed_array/buffer";
import { ascending, elementsOf, layout, localeNumber, TypedArray } from "velt:typed_array/base";

/**
 * An array of 8-bit signed integers in an `ArrayBuffer` (JS `Int8Array`): `new Int8Array(n)` (`n` zeros),
 * `new Int8Array([1, 2])` (a copy, converted), `new Int8Array(buffer, byteOffset, length)` (a view of
 * `buffer`, sharing it), or a copy of another typed array.
 */
export class Int8Array extends TypedArray implements Iterable<number> {
  /** The size of an element in bytes. */
  static readonly BYTES_PER_ELEMENT: number = 1;

  /**
   * `n` zero elements; a copy of an array's or typed array's elements, converted; or a view of
   * `buffer` from `byteOffset` (a multiple of 1), of `length` elements or up to its end.
   * `RangeError` as in JS for a negative length or a range outside the buffer.
   */
  constructor(
    arg: number | ArrayBuffer | number[] | TypedArray = 0,
    byteOffset: number = 0,
    length?: number,
  ) {
    const l = layout(arg, byteOffset, length, 1, 0, "Int8Array");
    super(l.buf, l.off, l.len);
    const xs = l.values;
    if (xs != null) {
      for (let i: usize = 0; i < l.len; i++) {
        this.put(i, xs[i]);
      }
    }
  }

  // A view of `n` elements of `buf` from byte `off` (in range: no `RangeError`).
  private static view(buf: ArrayBuffer, off: usize, n: usize): Int8Array {
    try {
      return new Int8Array(buf, off as number, n as number);
    } catch (e) {
      panic(`ICE: Int8Array.view: ${e.message}`);
    }
  }

  // `n` zero elements (no `RangeError`).
  private static zeros(n: usize): Int8Array {
    return Int8Array.view(ArrayBuffer.adopt(Buffer.alloc(n * 1)), 0, n);
  }

  // Element `i` (in the view's range).
  private get(i: usize): number {
    // `this.buf.bytes` read in place: a local holding it would count a reference per access.
    const o = this.off + i * 1;
    return (this.buf.bytes[o] as i8);
  }

  // Writes element `i` (in the view's range).
  private put(i: usize, v: number) {
    const o = this.off + i * 1;
    const x = toUint8(v);
    this.buf.bytes[o] = x;
  }

  // The bytes of the elements, copied.
  private bytesCopy(): u8[] {
    const start = this.off as i64;
    return this.buf.bytes.slice(start, start + ((this.len * 1) as i64));
  }

  override __get(i: usize): number {
    return this.get(i);
  }

  override __put(i: usize, v: number) {
    this.put(i, v);
  }

  override __kind(): u32 {
    return 0;
  }

  override __emptyText(): string {
    return "Int8Array(0) []";
  }

  override __size(): usize {
    return 1;
  }

  // The number of elements, below 2^52 (`layout` rejects longer views): the mask says so to
  // the compiler, which then counts an index up to it in integers. Those the view still
  // reaches when its buffer's bytes are a `u8[]` (a `u8[]`'s `subarray`) that became shorter
  // than the view: the bytes past the array's end are gone. A loop up to `length` then has the
  // test `xs[i]` makes, so the compiler drops it there.
  private count(): number {
    // Without a branch (a loop test whose condition spans blocks would not bound the loop's
    // counter for the compiler): `n - off` wraps when the array ends before the view starts,
    // and is then taken 0 times; `len - (len - avail) * short` is the smaller of the two.
    const n = this.buf.bytes.length as usize;
    const avail = ((n - this.off) * ((this.off <= n) as usize)) / 1;
    const short = (avail < this.len) as usize;
    return ((this.len - (this.len - avail) * short) & 0xfffffffffffff) as number;
  }

  /** `xs[i]`: element `i`; panics out of range, like an array index (JS reads `undefined`). */
  __index(i: number): number {
    // One test per branch, so the compiler knows `i` is a whole number from 0 below 2^52 where
    // it converts it (no position computed from it can wrap).
    if (!(i >= 0)) {
      this.outOfBounds(i);
    }
    if (!(i < 4503599627370496)) {
      this.outOfBounds(i);
    }
    if (i != Math.trunc(i)) {
      this.outOfBounds(i);
    }
    // Inside the view and inside its buffer's bytes (`count`), in one test.
    const o = this.off + (i as usize);
    const end = this.off + this.len;
    const n = this.buf.bytes.length as usize;
    if (!(o < (end < n ? end : n))) {
      this.outOfBounds(i);
    }
    return (this.buf.bytes[o] as i8);
  }

  // `xs[i]` outside the array (cold).
  private outOfBounds(i: number): never {
    panic(`index out of bounds: the len is ${this.count()} but the index is ${i}`);
  }

  /**
   * `xs[i] = v`: writes element `i`, converted; nothing out of range, as in JS (nor past the
   * end of a `u8[]` that became shorter than its `subarray`: `length`).
   */
  __setIndex(i: number, v: number) {
    if (i >= 0 && i < this.count() && i == Math.trunc(i)) {
      // Inside the view and inside its buffer's bytes (`count`).
      const o = this.off + (i as usize) * 1;
      const x = toUint8(v);
      this.buf.bytes[o] = x;
    }
  }

  /** The buffer the elements are in. */
  override get buffer(): ArrayBuffer {
    return this.buf;
  }

  /** Where the first element is in `buffer`, in bytes. */
  override get byteOffset(): number {
    return this.off as number;
  }

  /** The size of the elements in bytes: `length * BYTES_PER_ELEMENT`. */
  override get byteLength(): number {
    return this.count() * 1;
  }

  /** The number of elements. */
  get length(): number {
    return this.count();
  }

  /** Element `i`, counting from the end when negative; `undefined` out of range. */
  at(position: number): number | undefined {
    const index = toInteger(position);
    const i = index < 0 ? index + (this.len as i64) : index;
    if (i < 0 || (i as usize) >= this.len) {
      return undefined;
    }
    return this.get(i as usize);
  }

  /** Copies the elements in [start, end) to position `target` (overlap is fine); returns this array. */
  copyWithin(target: number, start: number = 0, end: number = Infinity): Int8Array {
    const to = relative(toInteger(target), this.len);
    const from = relative(toInteger(start), this.len);
    const stop = relative(toInteger(end), this.len);
    if (stop > from) {
      let count = stop - from;
      if (count > this.len - to) {
        count = this.len - to;
      }
      const o = this.off as i64;
      this.buf.bytes.copyWithin(
        o + ((to * 1) as i64),
        o + ((from * 1) as i64),
        o + (((from + count) * 1) as i64),
      );
    }
    return this;
  }

  /** `[index, element]` pairs (JS returns an iterator). */
  entries(): [number, number][] {
    const out: [number, number][] = [];
    for (let i: usize = 0; i < this.len; i++) {
      out.push([i as number, this.get(i)]);
    }
    return out;
  }

  /** The indexes, 0 to `length - 1` (JS returns an iterator). */
  keys(): number[] {
    const out: number[] = [];
    for (let i: usize = 0; i < this.len; i++) {
      out.push(i as number);
    }
    return out;
  }

  /** The elements as numbers (JS returns an iterator). */
  values(): number[] {
    const out: number[] = [];
    for (let i: usize = 0; i < this.len; i++) {
      out.push(this.get(i));
    }
    return out;
  }

  /** Whether `pred` holds for every element. */
  every<E>(pred: (x: number, i: number) => bool throws E): bool throws E {
    for (let i: usize = 0; i < this.len; i++) {
      if (!pred(this.get(i), i as number)) {
        return false;
      }
    }
    return true;
  }

  /** Whether `pred` holds for some element. */
  some<E>(pred: (x: number, i: number) => bool throws E): bool throws E {
    for (let i: usize = 0; i < this.len; i++) {
      if (pred(this.get(i), i as number)) {
        return true;
      }
    }
    return false;
  }

  /** Sets the elements in [start, end) to `value`, converted; returns this array. */
  fill(value: number, start: number = 0, end: number = Infinity): Int8Array {
    const from = relative(toInteger(start), this.len);
    const stop = relative(toInteger(end), this.len);
    if (1 == 1 && stop > from) {
      // One converted byte, set with memset.
      this.put(from, value);
      const o = this.off as i64;
      this.buf.bytes.fill(this.buf.bytes[this.off + from], o + (from as i64), o + (stop as i64));
      return this;
    }
    for (let i = from; i < stop; i++) {
      this.put(i, value);
    }
    return this;
  }

  /** A new array of the elements `keep` holds for. */
  filter<E>(keep: (x: number, i: number) => bool throws E): Int8Array throws E {
    const kept: number[] = [];
    for (let i: usize = 0; i < this.len; i++) {
      const x = this.get(i);
      if (keep(x, i as number)) {
        kept.push(x);
      }
    }
    return Int8Array.ofArray(kept);
  }

  /** The first element `pred` holds for, or `undefined`. */
  find<E>(pred: (x: number, i: number) => bool throws E): number | undefined throws E {
    for (let i: usize = 0; i < this.len; i++) {
      const x = this.get(i);
      if (pred(x, i as number)) {
        return x;
      }
    }
    return undefined;
  }

  /** The index of the first element `pred` holds for, or -1. */
  findIndex<E>(pred: (x: number, i: number) => bool throws E): number throws E {
    for (let i: usize = 0; i < this.len; i++) {
      if (pred(this.get(i), i as number)) {
        return i as number;
      }
    }
    return -1;
  }

  /** The last element `pred` holds for, or `undefined`. */
  findLast<E>(pred: (x: number, i: number) => bool throws E): number | undefined throws E {
    let i = this.len;
    while (i > 0) {
      i--;
      const x = this.get(i);
      if (pred(x, i as number)) {
        return x;
      }
    }
    return undefined;
  }

  /** The index of the last element `pred` holds for, or -1. */
  findLastIndex<E>(pred: (x: number, i: number) => bool throws E): number throws E {
    let i = this.len;
    while (i > 0) {
      i--;
      if (pred(this.get(i), i as number)) {
        return i as number;
      }
    }
    return -1;
  }

  /** Calls `f` with each element and its index. */
  forEach<E>(f: (x: number, i: number) => void throws E) throws E {
    for (let i: usize = 0; i < this.len; i++) {
      f(this.get(i), i as number);
    }
  }

  /** Whether an element is `x` (NaN finds NaN, as JS's `includes`), from position `from`. */
  includes(x: number, from: number = 0): bool {
    for (let i = relative(toInteger(from), this.len); i < this.len; i++) {
      const y = this.get(i);
      if (y == x || (x != x && y != y)) {
        return true;
      }
    }
    return false;
  }

  /** The first index at or after `from` holding `x` (`===`: NaN is never found), or -1. */
  indexOf(x: number, from: number = 0): number {
    for (let i = relative(toInteger(from), this.len); i < this.len; i++) {
      if (this.get(i) == x) {
        return i as number;
      }
    }
    return -1;
  }

  /** The last index at or before `from` holding `x` (`===`), or -1. */
  lastIndexOf(x: number, position: number = Infinity): number {
    const from = toInteger(position);
    if (this.len == 0) {
      return -1;
    }
    let i: i64 = from < 0 ? from + (this.len as i64) : from;
    if (i >= (this.len as i64)) {
      i = (this.len as i64) - 1;
    }
    while (i >= 0) {
      if (this.get(i as usize) == x) {
        return i as number;
      }
      i--;
    }
    return -1;
  }

  /** The elements as text, `sep` between them (`String(x)` of each: `-0` is `0`). */
  join(sep: string = ","): string {
    let s = "";
    for (let i: usize = 0; i < this.len; i++) {
      if (i > 0) {
        s += sep;
      }
      s += `${this.get(i)}`;
    }
    return s;
  }

  /** A new array of `f`'s results, converted. */
  map<E>(f: (x: number, i: number) => number throws E): Int8Array throws E {
    const out = Int8Array.zeros(this.len);
    for (let i: usize = 0; i < this.len; i++) {
      out.put(i, f(this.get(i), i as number));
    }
    return out;
  }

  /** Folds the elements from the first, starting with `init`. */
  reduce<A, E>(f: (acc: A, x: number, i: number) => A throws E, init: A): A throws E {
    let acc = init;
    for (let i: usize = 0; i < this.len; i++) {
      acc = f(acc, this.get(i), i as number);
    }
    return acc;
  }

  /** Folds the elements from the last, starting with `init`. */
  reduceRight<A, E>(f: (acc: A, x: number, i: number) => A throws E, init: A): A throws E {
    let acc = init;
    let i = this.len;
    while (i > 0) {
      i--;
      acc = f(acc, this.get(i), i as number);
    }
    return acc;
  }

  /** Reverses the elements in place; returns this array. */
  reverse(): Int8Array {
    if (this.len == 0) {
      return this;
    }
    let i: usize = 0;
    let j = this.len - 1;
    while (i < j) {
      const x = this.get(i);
      this.put(i, this.get(j));
      this.put(j, x);
      i++;
      j--;
    }
    return this;
  }

  /**
   * Writes the elements of `src` (an array or a typed array of any kind, converted) from
   * position `offset`; `RangeError` when they don't fit. A source sharing this array's buffer
   * is read before anything is written, as in JS.
   */
  set(src: number[] | TypedArray, offset: number = 0) {
    const at = toIndex(offset);
    const n = src instanceof TypedArray ? src.len : src.length as usize;
    if (at < 0 || (at as usize) + n > this.len) {
      throw new RangeError("offset is out of bounds");
    }
    const start = at as usize;
    if (src instanceof Int8Array) {
      // The same kind: the bytes, with memmove (or a copy of them from another buffer).
      const to = this.off + start * 1;
      if (src.buf === this.buf) {
        const o = src.off as i64;
        this.buf.bytes.copyWithin(to as i64, o, o + ((n * 1) as i64));
      } else if (src.off == 0 && src.len * 1 == (src.buf.bytes.length as usize)) {
        this.buf.bytes.set(src.buf.bytes, to);
      } else {
        this.buf.bytes.set(src.bytesCopy(), to);
      }
      return;
    }
    const xs = elementsOf(src);
    for (let i: usize = 0; i < n; i++) {
      this.put(start + i, xs[i]);
    }
  }

  /** A new array with a copy of the elements in [start, end) (negative counts from the end). */
  slice(start: number = 0, end: number = Infinity): Int8Array {
    // Of the elements left (`length`): the array under a `u8[]`'s view may have shrunk.
    const len = this.count() as usize;
    const from = relative(toInteger(start), len);
    const stop = relative(toInteger(end), len);
    const n = stop > from ? stop - from : 0;
    const o = (this.off + from * 1) as i64;
    const bytes = this.buf.bytes.slice(o, o + ((n * 1) as i64));
    return Int8Array.view(ArrayBuffer.adopt(bytes), 0, n);
  }

  /**
   * Sorts the elements in place; returns this array. Numeric order by default (`-0` before `0`,
   * NaN last), or `cmp`'s (negative: `a` first), keeping equal elements in order.
   */
  sort(cmp: ((a: number, b: number) => number) | null = null): Int8Array {
    const xs = this.values();
    if (cmp == null) {
      xs.sort(ascending);
    } else {
      xs.sort(cmp);
    }
    for (let i: usize = 0; i < this.len; i++) {
      this.put(i, xs[i]);
    }
    return this;
  }

  /**
   * A view of the elements in [begin, end) (negative counts from the end) sharing this array's
   * buffer: writes through either are seen by both.
   */
  subarray(begin: number = 0, end: number = Infinity): Int8Array {
    // Of the elements left (`length`), as `slice`.
    const len = this.count() as usize;
    const from = relative(toInteger(begin), len);
    const stop = relative(toInteger(end), len);
    const n = stop > from ? stop - from : 0;
    const at = this.off + from * 1;
    if (at > (this.buf.bytes.length as usize)) {
      // Not even the view's start is left: an empty view with a buffer of its own.
      return Int8Array.zeros(0);
    }
    return Int8Array.view(this.buf, at, n);
  }

  /** The elements as Node's default locale (en-US) writes them, joined by `,`. */
  toLocaleString(): string {
    let s = "";
    for (let i: usize = 0; i < this.len; i++) {
      if (i > 0) {
        s += ",";
      }
      s += localeNumber(this.get(i));
    }
    return s;
  }

  /** A reversed copy (ES2023); this array is unchanged. */
  toReversed(): Int8Array {
    return this.slice().reverse();
  }

  /** A sorted copy (ES2023, the order of `sort`); this array is unchanged. */
  toSorted(cmp: ((a: number, b: number) => number) | null = null): Int8Array {
    return this.slice().sort(cmp);
  }

  /** The elements joined by `,` (what `String(xs)` and `${xs}` give). */
  toString(): string {
    return this.join(",");
  }

  /** A copy with element `index` (negative counts from the end) set to `value`; `RangeError` out of range. */
  with(position: number, value: number): Int8Array {
    // Of the elements left (`length`), as `slice`, which makes the copy.
    const len = this.count() as usize;
    const index = toInteger(position);
    const i = index < 0 ? index + (len as i64) : index;
    if (i < 0 || (i as usize) >= len) {
      throw new RangeError("Invalid typed array index");
    }
    const out = this.slice();
    out.put(i as usize, value);
    return out;
  }

  /** The elements in order: `for (const x of xs)`, `[...xs]`. */
  *[Symbol.iterator](): Iterator<number> {
    for (let i: usize = 0; i < this.len; i++) {
      yield this.get(i);
    }
  }

  /** A new array of the elements of `src` (or `map`'s results for them), converted. */
  static from<E>(
    src: Iterable<number, E>,
    map: ((x: number, i: number) => number) | null = null,
  ): Int8Array throws E {
    const xs: number[] = [];
    let i = 0;
    for (const x of src) {
      xs.push(map == null ? x : map(x, i));
      i++;
    }
    return Int8Array.ofArray(xs);
  }

  /** A new array of `items`, converted. */
  static of(...items: number[]): Int8Array {
    return Int8Array.ofArray(items);
  }

  // A new array of the numbers `xs`, converted.
  private static ofArray(xs: number[]): Int8Array {
    const out = Int8Array.zeros(xs.length as usize);
    for (let i: usize = 0; i < (xs.length as usize); i++) {
      out.put(i, xs[i]);
    }
    return out;
  }

  /** `JSON.stringify` writes a typed array as an object of its elements, as in JS: `{"0":1,"1":2}`. */
  toJSON(): Record<string, number> {
    const out: Record<string, number> = {};
    for (let i: usize = 0; i < this.len; i++) {
      out[`${i}`] = this.get(i);
    }
    return out;
  }

  /** How `console.log` shows the array, like Node: `Int8Array(2) [ 1, 2 ]`. */
  __inspect(): number[] {
    return this.values();
  }
}
