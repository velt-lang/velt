      i++;
    }
    return Int16Array.ofArray(xs);
  }

  /** A new array of `items`, converted. */
  static of(...items: number[]): Int16Array {
    return Int16Array.ofArray(items);
  }

  // A new array of the numbers `xs`, converted.
  private static ofArray(xs: number[]): Int16Array {
    const out = Int16Array.zeros(xs.length as usize);
    for (let i: usize = 0; i < xs.length as usize; i++) {
      out.put(i, xs[i]);
    }
    return out;
  }

  /** `JSON.stringify` writes a typed array as an object of its elements, as in JS: `{"0":1,"1":2}`. */
  toJSON(): Record<string, number> {
    const out: Record<string, number> = {};
    for (let i: usize = 0; i < this.len; i++) {
      out[`${i}`] = this.get(i);
    }
    return out;
  }

  /** How `console.log` shows the array, like Node: `Int16Array(2) [ 1, 2 ]`. */
  __inspect(): number[] {
    return this.values();
  }
}

/**
 * An array of 16-bit unsigned integers in an `ArrayBuffer` (JS `Uint16Array`): `new Uint16Array(n)` (`n` zeros),
 * `new Uint16Array([1, 2])` (a copy, converted), `new Uint16Array(buffer, byteOffset, length)` (a view of
 * `buffer`, sharing it), or a copy of another typed array.
 */
export class Uint16Array extends TypedArray {
  /** The size of an element in bytes. */
  static readonly BYTES_PER_ELEMENT: usize = 2;

  /**
   * `n` zero elements; a copy of an array's or typed array's elements, converted; or a view of
   * `buffer` from `byteOffset` (a multiple of 2), of `length` elements or up to its end.
   * `RangeError` as in JS for a negative length or a range outside the buffer.
   */
  constructor(
    arg: number | ArrayBuffer | number[] | TypedArray = 0,
    byteOffset: number = 0,
    length?: number,
  ) {
    const l = layout(arg, byteOffset, length, 2, 4, "Uint16Array");
    super(l.buf, l.off, l.len);
    const xs = l.values;
    if (xs != null) {
