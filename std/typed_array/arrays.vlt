  slice(start: i64 = 0, end: i64 = END): Int16Array {
    const from = relative(start, this.len);
    const stop = relative(end, this.len);
    const n = stop > from ? stop - from : 0;
    const o = (this.off + from * 2) as i64;
    const bytes = this.buf.bytes.slice(o, o + ((n * 2) as i64));
