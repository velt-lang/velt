  /** Folds the elements from the last, starting with `init`. */
  reduceRight<A, E>(f: (acc: A, x: number, i: i64) => A throws E, init: A): A throws E {
    let acc = init;
    let i = this.len;
    while (i > 0) {
      i--;
      acc = f(acc, this.get(i), i as i64);
    }
    return acc;
  }

  /** Reverses the elements in place; returns this array. */
  reverse(): Float32Array {
    if (this.len == 0) {
      return this;
    }
    let i: usize = 0;
    let j = this.len - 1;
    while (i < j) {
      const x = this.get(i);
      this.put(i, this.get(j));
      this.put(j, x);
      i++;
      j--;
    }
    return this;
  }

  /**
   * Writes the elements of `src` (an array or a typed array of any kind, converted) from
   * position `offset`; `RangeError` when they don't fit. A source sharing this array's buffer
   * is read before anything is written, as in JS.
   */
  set(src: number[] | TypedArray, offset: number = 0) {
    const at = toIndex(offset);
    const n = src instanceof TypedArray ? src.len : src.length as usize;
    if (at < 0 || (at as usize) + n > this.len) {
      throw new RangeError("offset is out of bounds");
    }
    const start = at as usize;
    if (src instanceof Float32Array) {
      // The same kind: the bytes, with memmove (or a copy of them from another buffer).
      const to = this.off + start * 4;
      if (src.buf === this.buf) {
        const o = src.off as i64;
        this.buf.bytes.copyWithin(to as i64, o, o + ((n * 4) as i64));
      } else if (src.off == 0 && src.len * 4 == src.buf.bytes.length as usize) {
        this.buf.bytes.set(src.buf.bytes, to);
      } else {
        this.buf.bytes.set(src.bytesCopy(), to);
      }
      return;
    }
    const xs = elementsOf(src);
    for (let i: usize = 0; i < n; i++) {
      this.put(start + i, xs[i]);
    }
  }

  /** A new array with a copy of the elements in [start, end) (negative counts from the end). */
  slice(start: i64 = 0, end: i64 = END): Float32Array {
    const from = relative(start, this.len);
    const stop = relative(end, this.len);
    const n = stop > from ? stop - from : 0;
    const o = (this.off + from * 4) as i64;
    const bytes = this.buf.bytes.slice(o, o + ((n * 4) as i64));
    return Float32Array.view(ArrayBuffer.adopt(bytes), 0, n);
  }

  /**
   * Sorts the elements in place; returns this array. Numeric order by default (`-0` before `0`,
   * NaN last), or `cmp`'s (negative: `a` first), keeping equal elements in order.
   */
  sort(cmp: ((a: number, b: number) => number) | null = null): Float32Array {
    const xs = this.values();
    if (cmp == null) {
      xs.sort(ascending);
    } else {
      xs.sort(cmp);
    }
    for (let i: usize = 0; i < this.len; i++) {
      this.put(i, xs[i]);
    }
    return this;
  }

  /**
   * A view of the elements in [begin, end) (negative counts from the end) sharing this array's
   * buffer: writes through either are seen by both.
   */
  subarray(begin: i64 = 0, end: i64 = END): Float32Array {
    const from = relative(begin, this.len);
    const stop = relative(end, this.len);
    const n = stop > from ? stop - from : 0;
    return Float32Array.view(this.buf, this.off + from * 4, n);
  }

  /** The elements as Node's default locale (en-US) writes them, joined by `,`. */
  toLocaleString(): string {
    let s = "";
    for (let i: usize = 0; i < this.len; i++) {
      if (i > 0) {
        s += ",";
      }
      s += localeNumber(this.get(i));
    }
    return s;
  }

  /** A reversed copy (ES2023); this array is unchanged. */
  toReversed(): Float32Array {
    return this.slice().reverse();
  }

  /** A sorted copy (ES2023, the order of `sort`); this array is unchanged. */
  toSorted(cmp: ((a: number, b: number) => number) | null = null): Float32Array {
    return this.slice().sort(cmp);
  }

  /** The elements joined by `,` (what `String(xs)` and `${xs}` give). */
  toString(): string {
    return this.join(",");
  }

  /** A copy with element `index` (negative counts from the end) set to `value`; `RangeError` out of range. */
  with(index: i64, value: number): Float32Array {
    const i = index < 0 ? index + (this.len as i64) : index;
    if (i < 0 || (i as usize) >= this.len) {
      throw new RangeError("Invalid typed array index");
    }
    const out = this.slice();
    out.put(i as usize, value);
    return out;
  }

  /** The elements in order: `for (const x of xs)`, `[...xs]`. */
  *[Symbol.iterator](): Iterator<number> {
    for (let i: usize = 0; i < this.len; i++) {
      yield this.get(i);
    }
  }

  /** A new array of the elements of `src` (or `map`'s results for them), converted. */
  static from<E>(
    src: Iterable<number, E>,
    map: ((x: number, i: i64) => number) | null = null,
  ): Float32Array throws E {
    const xs: number[] = [];
    let i: i64 = 0;
    for (const x of src) {
      xs.push(map == null ? x : map(x, i));
      i++;
    }
    return Float32Array.ofArray(xs);
  }

  /** A new array of `items`, converted. */
  static of(...items: number[]): Float32Array {
    return Float32Array.ofArray(items);
  }

  // A new array of the numbers `xs`, converted.
  private static ofArray(xs: number[]): Float32Array {
    const out = Float32Array.zeros(xs.length as usize);
    for (let i: usize = 0; i < xs.length as usize; i++) {
      out.put(i, xs[i]);
    }
    return out;
  }

  /** `JSON.stringify` writes a typed array as an object of its elements, as in JS: `{"0":1,"1":2}`. */
  toJSON(): Record<string, number> {
    const out: Record<string, number> = {};
    for (let i: usize = 0; i < this.len; i++) {
      out[`${i}`] = this.get(i);
    }
    return out;
  }

  /** How `console.log` shows the array, like Node: `Float32Array(2) [ 1, 2 ]`. */
  __inspect(): number[] {
    return this.values();
  }
}

/**
 * An array of 64-bit floats (numbers) in an `ArrayBuffer` (JS `Float64Array`): `new Float64Array(n)` (`n` zeros),
 * `new Float64Array([1, 2])` (a copy, converted), `new Float64Array(buffer, byteOffset, length)` (a view of
 * `buffer`, sharing it), or a copy of another typed array.
 */
export class Float64Array extends TypedArray {
  /** The size of an element in bytes. */
  static readonly BYTES_PER_ELEMENT: usize = 8;

  /**
   * `n` zero elements; a copy of an array's or typed array's elements, converted; or a view of
   * `buffer` from `byteOffset` (a multiple of 8), of `length` elements or up to its end.
   * `RangeError` as in JS for a negative length or a range outside the buffer.
   */
  constructor(
    arg: number | ArrayBuffer | number[] | TypedArray = 0,
    byteOffset: number = 0,
    length?: number,
  ) {
    const l = layout(arg, byteOffset, length, 8, 8, "Float64Array");
    super(l.buf, l.off, l.len);
    const xs = l.values;
    if (xs != null) {
      for (let i: usize = 0; i < l.len; i++) {
        this.put(i, xs[i]);
      }
    }
  }

  // A view of `n` elements of `buf` from byte `off` (in range: no `RangeError`).
  private static view(buf: ArrayBuffer, off: usize, n: usize): Float64Array {
    try {
      return new Float64Array(buf, off as number, n as number);
    } catch (e) {
      panic(`ICE: Float64Array.view: ${e.message}`);
    }
  }

  // `n` zero elements (no `RangeError`).
  private static zeros(n: usize): Float64Array {
    return Float64Array.view(ArrayBuffer.adopt(Buffer.alloc(n * 8)), 0, n);
  }

  // Element `i` (in range).
  private get(i: usize): number {
    const b = this.buf.bytes;
    const o = this.off + i * 8;
    return f64FromBits(load64(b, o));
  }

  // Writes element `i` (in range).
  private put(i: usize, v: number) {
    const b = this.buf.bytes;
    const o = this.off + i * 8;
    store64(b, o, f64Bits(v));
  }

  // The bytes of the elements, copied.
  private bytesCopy(): u8[] {
    const start = this.off as i64;
    return this.buf.bytes.slice(start, start + ((this.len * 8) as i64));
  }

  override __get(i: usize): number {
    return this.get(i);
  }

  override __put(i: usize, v: number) {
    this.put(i, v);
  }

  override __kind(): u32 {
    return 8;
  }

  override __size(): usize {
    return 8;
  }

  /** `xs[i]`: element `i`; panics out of range, like an array index (JS reads `undefined`). */
  __index(i: i64): number {
    if (i < 0 || (i as usize) >= this.len) {
      panic(`index out of bounds: the len is ${this.len} but the index is ${i}`);
    }
    return this.get(i as usize);
  }

  /** `xs[i] = v`: writes element `i`, converted; nothing out of range, as in JS. */
  __setIndex(i: i64, v: number) {
    if (i >= 0 && (i as usize) < this.len) {
      this.put(i as usize, v);
    }
  }

  /** The buffer the elements are in. */
  get buffer(): ArrayBuffer {
    return this.buf;
  }

  /** Where the first element is in `buffer`, in bytes. */
  get byteOffset(): usize {
    return this.off;
  }

  /** The size of the elements in bytes: `length * BYTES_PER_ELEMENT`. */
  get byteLength(): usize {
    return this.len * 8;
  }

  /** The number of elements. */
  get length(): usize {
    return this.len;
  }

  /** Element `i`, counting from the end when negative; null out of range (JS: `undefined`). */
  at(index: i64): number | null {
    const i = index < 0 ? index + (this.len as i64) : index;
    if (i < 0 || (i as usize) >= this.len) {
      return null;
    }
    return this.get(i as usize);
  }

  /** Copies the elements in [start, end) to position `target` (overlap is fine); returns this array. */
  copyWithin(target: i64, start: i64 = 0, end: i64 = END): Float64Array {
    const to = relative(target, this.len);
    const from = relative(start, this.len);
    const stop = relative(end, this.len);
    if (stop > from) {
      let count = stop - from;
      if (count > this.len - to) {
        count = this.len - to;
      }
      const o = this.off as i64;
      this.buf.bytes.copyWithin(
        o + ((to * 8) as i64),
        o + ((from * 8) as i64),
        o + (((from + count) * 8) as i64),
      );
    }
    return this;
  }

  /** `[index, element]` pairs (JS returns an iterator). */
  entries(): [usize, number][] {
    const out: [usize, number][] = [];
    for (let i: usize = 0; i < this.len; i++) {
      out.push([i, this.get(i)]);
    }
    return out;
  }

  /** The indexes, 0 to `length - 1` (JS returns an iterator). */
  keys(): usize[] {
    const out: usize[] = [];
    for (let i: usize = 0; i < this.len; i++) {
      out.push(i);
    }
    return out;
  }

  /** The elements as numbers (JS returns an iterator). */
  values(): number[] {
    const out: number[] = [];
    for (let i: usize = 0; i < this.len; i++) {
      out.push(this.get(i));
    }
    return out;
  }

  /** Whether `pred` holds for every element. */
  every<E>(pred: (x: number, i: i64) => bool throws E): bool throws E {
    for (let i: usize = 0; i < this.len; i++) {
      if (!pred(this.get(i), i as i64)) {
        return false;
      }
    }
    return true;
  }

  /** Whether `pred` holds for some element. */
  some<E>(pred: (x: number, i: i64) => bool throws E): bool throws E {
    for (let i: usize = 0; i < this.len; i++) {
      if (pred(this.get(i), i as i64)) {
        return true;
      }
    }
    return false;
  }

  /** Sets the elements in [start, end) to `value`, converted; returns this array. */
  fill(value: number, start: i64 = 0, end: i64 = END): Float64Array {
    const from = relative(start, this.len);
    const stop = relative(end, this.len);
    if (8 == 1 && stop > from) {
      // One converted byte, set with memset.
      this.put(from, value);
      const o = this.off as i64;
      this.buf.bytes.fill(this.buf.bytes[this.off + from], o + (from as i64), o + (stop as i64));
      return this;
    }
    for (let i = from; i < stop; i++) {
      this.put(i, value);
    }
    return this;
  }

  /** A new array of the elements `keep` holds for. */
  filter<E>(keep: (x: number, i: i64) => bool throws E): Float64Array throws E {
    const kept: number[] = [];
    for (let i: usize = 0; i < this.len; i++) {
      const x = this.get(i);
      if (keep(x, i as i64)) {
        kept.push(x);
      }
    }
    return Float64Array.ofArray(kept);
  }

  /** The first element `pred` holds for, or null (JS: `undefined`). */
  find<E>(pred: (x: number, i: i64) => bool throws E): number | null throws E {
    for (let i: usize = 0; i < this.len; i++) {
      const x = this.get(i);
      if (pred(x, i as i64)) {
        return x;
      }
    }
    return null;
  }

  /** The index of the first element `pred` holds for, or -1. */
  findIndex<E>(pred: (x: number, i: i64) => bool throws E): i64 throws E {
    for (let i: usize = 0; i < this.len; i++) {
      if (pred(this.get(i), i as i64)) {
        return i as i64;
      }
    }
    return -1;
  }

  /** The last element `pred` holds for, or null (JS: `undefined`). */
  findLast<E>(pred: (x: number, i: i64) => bool throws E): number | null throws E {
    let i = this.len;
    while (i > 0) {
      i--;
      const x = this.get(i);
      if (pred(x, i as i64)) {
        return x;
      }
    }
    return null;
  }

  /** The index of the last element `pred` holds for, or -1. */
  findLastIndex<E>(pred: (x: number, i: i64) => bool throws E): i64 throws E {
    let i = this.len;
    while (i > 0) {
      i--;
      if (pred(this.get(i), i as i64)) {
        return i as i64;
      }
    }
    return -1;
  }

  /** Calls `f` with each element and its index. */
  forEach<E>(f: (x: number, i: i64) => void throws E) throws E {
    for (let i: usize = 0; i < this.len; i++) {
      f(this.get(i), i as i64);
    }
  }

  /** Whether an element is `x` (NaN finds NaN, as JS's `includes`), from position `from`. */
  includes(x: number, from: i64 = 0): bool {
    for (let i = relative(from, this.len); i < this.len; i++) {
      const y = this.get(i);
      if (y == x || (x != x && y != y)) {
        return true;
      }
    }
    return false;
  }

  /** The first index at or after `from` holding `x` (`===`: NaN is never found), or -1. */
  indexOf(x: number, from: i64 = 0): i64 {
    for (let i = relative(from, this.len); i < this.len; i++) {
      if (this.get(i) == x) {
        return i as i64;
      }
    }
    return -1;
  }

  /** The last index at or before `from` holding `x` (`===`), or -1. */
  lastIndexOf(x: number, from: i64 = END): i64 {
    if (this.len == 0) {
      return -1;
    }
    let i: i64 = from < 0 ? from + (this.len as i64) : from;
    if (i >= (this.len as i64)) {
      i = (this.len as i64) - 1;
    }
    while (i >= 0) {
      if (this.get(i as usize) == x) {
        return i;
      }
      i--;
    }
    return -1;
  }

  /** The elements as text, `sep` between them (`String(x)` of each: `-0` is `0`). */
  join(sep: string = ","): string {
    let s = "";
    for (let i: usize = 0; i < this.len; i++) {
      if (i > 0) {
        s += sep;
      }
      s += `${this.get(i)}`;
    }
    return s;
  }

  /** A new array of `f`'s results, converted. */
  map<E>(f: (x: number, i: i64) => number throws E): Float64Array throws E {
    const out = Float64Array.zeros(this.len);
    for (let i: usize = 0; i < this.len; i++) {
      out.put(i, f(this.get(i), i as i64));
    }
    return out;
  }

  /** Folds the elements from the first, starting with `init`. */
  reduce<A, E>(f: (acc: A, x: number, i: i64) => A throws E, init: A): A throws E {
    let acc = init;
    for (let i: usize = 0; i < this.len; i++) {
      acc = f(acc, this.get(i), i as i64);
    }
    return acc;
  }

  /** Folds the elements from the last, starting with `init`. */
  reduceRight<A, E>(f: (acc: A, x: number, i: i64) => A throws E, init: A): A throws E {
    let acc = init;
    let i = this.len;
    while (i > 0) {
      i--;
      acc = f(acc, this.get(i), i as i64);
    }
    return acc;
  }

  /** Reverses the elements in place; returns this array. */
  reverse(): Float64Array {
    if (this.len == 0) {
      return this;
    }
    let i: usize = 0;
    let j = this.len - 1;
    while (i < j) {
      const x = this.get(i);
      this.put(i, this.get(j));
      this.put(j, x);
      i++;
      j--;
    }
    return this;
  }

  /**
   * Writes the elements of `src` (an array or a typed array of any kind, converted) from
   * position `offset`; `RangeError` when they don't fit. A source sharing this array's buffer
   * is read before anything is written, as in JS.
   */
  set(src: number[] | TypedArray, offset: number = 0) {
    const at = toIndex(offset);
    const n = src instanceof TypedArray ? src.len : src.length as usize;
    if (at < 0 || (at as usize) + n > this.len) {
      throw new RangeError("offset is out of bounds");
    }
    const start = at as usize;
    if (src instanceof Float64Array) {
      // The same kind: the bytes, with memmove (or a copy of them from another buffer).
      const to = this.off + start * 8;
      if (src.buf === this.buf) {
        const o = src.off as i64;
        this.buf.bytes.copyWithin(to as i64, o, o + ((n * 8) as i64));
      } else if (src.off == 0 && src.len * 8 == src.buf.bytes.length as usize) {
        this.buf.bytes.set(src.buf.bytes, to);
      } else {
        this.buf.bytes.set(src.bytesCopy(), to);
      }
      return;
    }
    const xs = elementsOf(src);
    for (let i: usize = 0; i < n; i++) {
      this.put(start + i, xs[i]);
    }
  }

  /** A new array with a copy of the elements in [start, end) (negative counts from the end). */
  slice(start: i64 = 0, end: i64 = END): Float64Array {
    const from = relative(start, this.len);
    const stop = relative(end, this.len);
    const n = stop > from ? stop - from : 0;
    const o = (this.off + from * 8) as i64;
    const bytes = this.buf.bytes.slice(o, o + ((n * 8) as i64));
    return Float64Array.view(ArrayBuffer.adopt(bytes), 0, n);
  }

  /**
   * Sorts the elements in place; returns this array. Numeric order by default (`-0` before `0`,
   * NaN last), or `cmp`'s (negative: `a` first), keeping equal elements in order.
   */
  sort(cmp: ((a: number, b: number) => number) | null = null): Float64Array {
    const xs = this.values();
    if (cmp == null) {
      xs.sort(ascending);
    } else {
      xs.sort(cmp);
    }
    for (let i: usize = 0; i < this.len; i++) {
      this.put(i, xs[i]);
    }
    return this;
  }

  /**
   * A view of the elements in [begin, end) (negative counts from the end) sharing this array's
   * buffer: writes through either are seen by both.
   */
  subarray(begin: i64 = 0, end: i64 = END): Float64Array {
    const from = relative(begin, this.len);
    const stop = relative(end, this.len);
    const n = stop > from ? stop - from : 0;
    return Float64Array.view(this.buf, this.off + from * 8, n);
  }

  /** The elements as Node's default locale (en-US) writes them, joined by `,`. */
  toLocaleString(): string {
    let s = "";
    for (let i: usize = 0; i < this.len; i++) {
      if (i > 0) {
        s += ",";
      }
      s += localeNumber(this.get(i));
    }
    return s;
  }

  /** A reversed copy (ES2023); this array is unchanged. */
  toReversed(): Float64Array {
    return this.slice().reverse();
  }

  /** A sorted copy (ES2023, the order of `sort`); this array is unchanged. */
  toSorted(cmp: ((a: number, b: number) => number) | null = null): Float64Array {
    return this.slice().sort(cmp);
  }

  /** The elements joined by `,` (what `String(xs)` and `${xs}` give). */
  toString(): string {
    return this.join(",");
  }

  /** A copy with element `index` (negative counts from the end) set to `value`; `RangeError` out of range. */
  with(index: i64, value: number): Float64Array {
    const i = index < 0 ? index + (this.len as i64) : index;
    if (i < 0 || (i as usize) >= this.len) {
      throw new RangeError("Invalid typed array index");
    }
    const out = this.slice();
    out.put(i as usize, value);
    return out;
  }

  /** The elements in order: `for (const x of xs)`, `[...xs]`. */
  *[Symbol.iterator](): Iterator<number> {
    for (let i: usize = 0; i < this.len; i++) {
      yield this.get(i);
    }
  }

  /** A new array of the elements of `src` (or `map`'s results for them), converted. */
  static from<E>(
    src: Iterable<number, E>,
    map: ((x: number, i: i64) => number) | null = null,
  ): Float64Array throws E {
    const xs: number[] = [];
    let i: i64 = 0;
    for (const x of src) {
      xs.push(map == null ? x : map(x, i));
      i++;
    }
    return Float64Array.ofArray(xs);
  }

  /** A new array of `items`, converted. */
  static of(...items: number[]): Float64Array {
    return Float64Array.ofArray(items);
  }

  // A new array of the numbers `xs`, converted.
  private static ofArray(xs: number[]): Float64Array {
    const out = Float64Array.zeros(xs.length as usize);
    for (let i: usize = 0; i < xs.length as usize; i++) {
      out.put(i, xs[i]);
    }
    return out;
  }

  /** `JSON.stringify` writes a typed array as an object of its elements, as in JS: `{"0":1,"1":2}`. */
  toJSON(): Record<string, number> {
    const out: Record<string, number> = {};
    for (let i: usize = 0; i < this.len; i++) {
      out[`${i}`] = this.get(i);
    }
    return out;
  }

  /** How `console.log` shows the array, like Node: `Float64Array(2) [ 1, 2 ]`. */
  __inspect(): number[] {
    return this.values();
  }
}
