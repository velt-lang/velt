  }

  /** How `console.log` shows the array, like Node: `Uint16Array(2) [ 1, 2 ]`. */
  __inspect(): number[] {
    return this.values();
  }
}

/**
 * An array of 32-bit signed integers in an `ArrayBuffer` (JS `Int32Array`): `new Int32Array(n)` (`n` zeros),
