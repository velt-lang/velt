        s += sep;
      }
      s += `${this.get(i)}`;
    }
    return s;
  }

  /** A new array of `f`'s results, converted. */
  map<E>(f: (x: number, i: i64) => number throws E): Int16Array throws E {
    const out = Int16Array.zeros(this.len);
    for (let i: usize = 0; i < this.len; i++) {
      out.put(i, f(this.get(i), i as i64));
    }
    return out;
