// velt:typed_array/arrays: the typed arrays (ES2024 §23.2): `Uint8Array`, `Float64Array` and the
// other seven, each a view of a byte range of an `ArrayBuffer` (std/typed_array/buffer.vlt).
// Programs use the globals (velt:typed_array).
//
// Elements read as numbers and are converted when written, as in JS (`ToUint8`: 300 is 44,
// `-1` is 255; `Uint8ClampedArray` clamps; `Float32Array` rounds to `f32`). `xs[i]` reads
// element `i` (std's `__index`, which sema calls for `xs[i]`: crates/velt_sema/src/body/expr/
// indexers.rs) and panics out of range like an array index (JS reads `undefined`); `xs[i] = v`
// writes it and does nothing out of range, as in JS. `subarray` shares the buffer, `slice`
// copies.
//
// Generated by scripts/gen-typed-arrays.py: change the script, not this file.

import {
  ArrayBuffer,
  f32Bits,
  f32FromBits,
  f64Bits,
  f64FromBits,
  load16,
  load32,
  load64,
  relative,
  store16,
  store32,
  store64,
  toIndex,
  toUint32,
  toUint8,
  toUint8Clamp,
} from "velt:typed_array/buffer";

const END: i64 = 9223372036854775807;

/**
 * What every typed array is (std only: JS's `%TypedArray%`): the buffer, the range of it the
 * elements take, and element access by number for copies between kinds.
 */
export class TypedArray {
  // The buffer, the offset of the first element in it (bytes), and the element count.
  private buf: ArrayBuffer;
  private off: usize;
  private len: usize;

  constructor(buf: ArrayBuffer, off: usize, len: usize) {
    this.buf = buf;
    this.off = off;
    this.len = len;
  }

  /** Element `i` (in range) as a number; each kind overrides it. */
  __get(i: usize): number {
    panic("ICE: TypedArray.__get");
  }

  /** Writes element `i` (in range); each kind overrides it. */
  __put(i: usize, v: number) {
    panic("ICE: TypedArray.__put");
  }

  /** Which of the nine kinds it is (its position in `KINDS` of the generator); each overrides it. */
  __kind(): u32 {
    panic("ICE: TypedArray.__kind");
  }

  /** The size of an element in bytes; each kind overrides it. */
  __size(): usize {
    panic("ICE: TypedArray.__size");
  }
}

/** Where a new typed array's elements are, and the values to write there (null: none). */
struct Layout {
  buf: ArrayBuffer;
  off: usize;
  len: usize;
  values: number[] | null;
}

/**
 * The layout of `new C(arg, byteOffset, length)` for kind `kind` of `size`-byte elements named
 * `name`: `RangeError`s as in JS (V8's messages).
 */
function layout(
  arg: number | ArrayBuffer | number[] | TypedArray,
  byteOffset: number,
  length: number | null,
  size: usize,
  kind: u32,
  name: string,
): Layout {
  if (typeof arg == "number") {
    const n = toIndex(arg);
    if (n < 0) {
      throw new RangeError(`Invalid typed array length: ${arg}`);
    }
    return {
      buf: new ArrayBuffer((n as number) * (size as number)),
      off: 0,
      len: n as usize,
      values: null,
    };
  }
  if (arg instanceof ArrayBuffer) {
    const off = toIndex(byteOffset);
    if (off < 0) {
      throw new RangeError(`Start offset ${byteOffset} is outside the bounds of the buffer`);
    }
    const start = off as usize;
    if (start % size != 0) {
      throw new RangeError(`start offset of ${name} should be a multiple of ${size}`);
    }
    const total = arg.byteLength;
    if (length == null) {
      if (total % size != 0) {
        throw new RangeError(`byte length of ${name} should be a multiple of ${size}`);
      }
      if (start > total) {
        throw new RangeError(`Start offset ${start} is outside the bounds of the buffer`);
      }
      return { buf: arg, off: start, len: (total - start) / size, values: null };
    }
    const n = toIndex(length);
    if (n < 0 || start + (n as usize) * size > total) {
      throw new RangeError(`Invalid typed array length: ${length}`);
    }
    return { buf: arg, off: start, len: n as usize, values: null };
  }
  if (arg instanceof TypedArray && arg.__kind() == kind) {
    // The same kind: the bytes, copied.
    const o = arg.off as i64;
    const bytes = arg.buf.bytes.slice(o, o + ((arg.len * size) as i64));
    return { buf: ArrayBuffer.adopt(bytes), off: 0, len: arg.len, values: null };
  }
  const xs = elementsOf(arg);
  const n = xs.length as usize;
  return { buf: new ArrayBuffer((n * size) as number), off: 0, len: n, values: xs };
}

/** Any element, of any kind, as a number (std only). */
function elementsOf(src: number[] | TypedArray): number[] {
  if (src instanceof TypedArray) {
    const out: number[] = [];
    for (let i: usize = 0; i < src.len; i++) {
      out.push(src.__get(i));
    }
    return out;
  }
  return src;
}

/** The order of a typed array's default `sort()`: numeric, `-0` before `+0`, NaN last. */
function ascending(a: number, b: number): number {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  if (a != a) {
    return b != b ? 0 : 1;
  }
  if (b != b) {
    return -1;
  }
  if (a == 0 && b == 0) {
    const na = 1 / a < 0;
    const nb = 1 / b < 0;
    return na == nb ? 0 : na ? -1 : 1;
  }
  return 0;
}

/** `x.toLocaleString()` in Node's default locale (en-US): grouped digits, at most 3 decimals. */
function localeNumber(x: number): string {
  if (x != x) {
    return "NaN";
  }
  if (x == Infinity) {
    return "∞";
  }
  if (x == -Infinity) {
    return "-∞";
  }
  let s = x.toFixed(3);
  // Trailing zeros of the decimals, then the point, go.
  while (s.endsWith("0")) {
    s = s.slice(0, -1);
  }
  if (s.endsWith(".")) {
    s = s.slice(0, -1);
  }
  const neg = s.startsWith("-");
  if (neg) {
    s = s.slice(1);
  }
  const dot = s.indexOf(".");
  const int = dot < 0 ? s : s.slice(0, dot);
  const frac = dot < 0 ? "" : s.slice(dot);
  let grouped = "";
  const digits = int.length as i64;
  for (let i: i64 = 0; i < digits; i++) {
    if (i > 0 && (digits - i) % 3 == 0) {
      grouped += ",";
    }
    grouped += int[i];
  }
  const sign = neg || (x == 0 && 1 / x < 0) ? "-" : "";
  return `${sign}${grouped}${frac}`;
}

/**
 * An array of 8-bit signed integers in an `ArrayBuffer` (JS `Int8Array`): `new Int8Array(n)` (`n` zeros),
 * `new Int8Array([1, 2])` (a copy, converted), `new Int8Array(buffer, byteOffset, length)` (a view of
 * `buffer`, sharing it), or a copy of another typed array.
 */
export class Int8Array extends TypedArray {
  /** The size of an element in bytes. */
  static readonly BYTES_PER_ELEMENT: usize = 1;

  /**
   * `n` zero elements; a copy of an array's or typed array's elements, converted; or a view of
   * `buffer` from `byteOffset` (a multiple of 1), of `length` elements or up to its end.
   * `RangeError` as in JS for a negative length or a range outside the buffer.
   */
  constructor(
    arg: number | ArrayBuffer | number[] | TypedArray = 0,
    byteOffset: number = 0,
    length?: number,
  ) {
    const l = layout(arg, byteOffset, length, 1, 0, "Int8Array");
    super(l.buf, l.off, l.len);
    const xs = l.values;
    if (xs != null) {
      for (let i: usize = 0; i < l.len; i++) {
        this.put(i, xs[i]);
      }
    }
  }

  // A view of `n` elements of `buf` from byte `off` (in range: no `RangeError`).
  private static view(buf: ArrayBuffer, off: usize, n: usize): Int8Array {
    try {
      return new Int8Array(buf, off as number, n as number);
    } catch (e) {
      panic(`ICE: Int8Array.view: ${e.message}`);
    }
  }

  // `n` zero elements (no `RangeError`).
  private static zeros(n: usize): Int8Array {
    return Int8Array.view(ArrayBuffer.adopt(Buffer.alloc(n * 1)), 0, n);
  }

  // Element `i` (in range).
  private get(i: usize): number {
    const b = this.buf.bytes;
    const o = this.off + i * 1;
    return (b[o] as i8);
  }

  // Writes element `i` (in range).
  private put(i: usize, v: number) {
    const b = this.buf.bytes;
    const o = this.off + i * 1;
    b[o] = toUint8(v);
  }

  // The bytes of the elements, copied.
  private bytesCopy(): u8[] {
    const start = this.off as i64;
    return this.buf.bytes.slice(start, start + ((this.len * 1) as i64));
  }

  override __get(i: usize): number {
    return this.get(i);
  }

  override __put(i: usize, v: number) {
    this.put(i, v);
  }

  override __kind(): u32 {
    return 0;
  }

  override __size(): usize {
    return 1;
  }

  /** `xs[i]`: element `i`; panics out of range, like an array index (JS reads `undefined`). */
  __index(i: i64): number {
