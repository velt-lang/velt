  constructor(
    arg: number | ArrayBuffer | number[] | TypedArray = 0,
    byteOffset: number = 0,
    length?: number,
  ) {
    const l = layout(arg, byteOffset, length, 4, 5, "Int32Array");
    super(l.buf, l.off, l.len);
    const xs = l.values;
