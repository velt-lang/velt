// velt/simd's externs for the 128-bit parts (its `asU8x16`, `load` and `store` call them).
declare function velt_simd_u8x16_fits(xs: u8[], at: u64): bool;
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_store(v: u8x16, to: u8[], at: u64);
declare function velt_simd_i8x16_as_u8x16(v: i8x16): u8x16;
declare function velt_simd_u8x16_as_i8x16(v: u8x16): i8x16;
declare function velt_simd_i8x16_fits(xs: i8[], at: u64): bool;
declare function velt_simd_i8x16_load(from: i8[], at: u64): i8x16;
declare function velt_simd_i8x16_store(v: i8x16, to: i8[], at: u64);
declare function velt_simd_u16x8_as_u8x16(v: u16x8): u8x16;
declare function velt_simd_u8x16_as_u16x8(v: u8x16): u16x8;
declare function velt_simd_u16x8_fits(xs: u16[], at: u64): bool;
declare function velt_simd_u16x8_load(from: u16[], at: u64): u16x8;
declare function velt_simd_u16x8_store(v: u16x8, to: u16[], at: u64);
