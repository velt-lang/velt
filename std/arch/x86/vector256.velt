// velt/arch/x86 (internal): `Vector256<T>`, 256 bits of lanes `T` (#3222 step 5,
// docs/internals/design/package-machine-code.md §4), generated from velt_vir's table
// (crates/velt_vir/src/arch/render.rs) by `cargo xtask gen-arch`: edit the generator.
//
// Building one, taking it apart, loading and storing it is plain code that runs on any
// CPU; velt/arch/x86's AVX2 and AVX-512 methods take it as one register, behind their
// class's check.

/**
 * 256 bits of lanes `T`: the bytes of its 128-bit parts (`lo`, `hi`), low lanes first.
 */
export struct Vector256<T> {
  readonly lo: u8x16;
  readonly hi: u8x16;

  /** The same 256 bits as lanes of type `U`. */
  reinterpret<U>(): Vector256<U> {
    return { lo: this.lo, hi: this.hi };
  }

  /** The vector of `lo`'s lanes (0 to 15) and `hi`'s (16 to 31). */
  static fromU8x16(lo: u8x16, hi: u8x16): Vector256<u8> {
    return { lo: lo, hi: hi };
  }

  /** The 32 lanes of `from` from `at` on. */
  static loadU8(from: u8[], at: usize = 0): Vector256<u8> {
    if (!velt_simd_u8x16_fits(from, at as u64) || !velt_simd_u8x16_fits(from, (at + 16) as u64)) {
      panic("RangeError: u8x16.load: range is out of bounds");
    }
    const lo = velt_simd_u8x16_load(from, at as u64);
    return Vector256.fromU8x16(lo, velt_simd_u8x16_load(from, (at + 16) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 15) and `hi`'s (16 to 31). */
  static fromI8x16(lo: i8x16, hi: i8x16): Vector256<i8> {
    return { lo: velt_simd_i8x16_as_u8x16(lo), hi: velt_simd_i8x16_as_u8x16(hi) };
  }

  /** The 32 lanes of `from` from `at` on. */
  static loadI8(from: i8[], at: usize = 0): Vector256<i8> {
    if (!velt_simd_i8x16_fits(from, at as u64) || !velt_simd_i8x16_fits(from, (at + 16) as u64)) {
      panic("RangeError: i8x16.load: range is out of bounds");
    }
    const lo = velt_simd_i8x16_load(from, at as u64);
    return Vector256.fromI8x16(lo, velt_simd_i8x16_load(from, (at + 16) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 7) and `hi`'s (8 to 15). */
  static fromU16x8(lo: u16x8, hi: u16x8): Vector256<u16> {
    return { lo: velt_simd_u16x8_as_u8x16(lo), hi: velt_simd_u16x8_as_u8x16(hi) };
  }

  /** The 16 lanes of `from` from `at` on. */
  static loadU16(from: u16[], at: usize = 0): Vector256<u16> {
    if (!velt_simd_u16x8_fits(from, at as u64) || !velt_simd_u16x8_fits(from, (at + 8) as u64)) {
      panic("RangeError: u16x8.load: range is out of bounds");
    }
    const lo = velt_simd_u16x8_load(from, at as u64);
    return Vector256.fromU16x8(lo, velt_simd_u16x8_load(from, (at + 8) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 7) and `hi`'s (8 to 15). */
  static fromI16x8(lo: i16x8, hi: i16x8): Vector256<i16> {
    return { lo: velt_simd_i16x8_as_u8x16(lo), hi: velt_simd_i16x8_as_u8x16(hi) };
  }

  /** The 16 lanes of `from` from `at` on. */
  static loadI16(from: i16[], at: usize = 0): Vector256<i16> {
    if (!velt_simd_i16x8_fits(from, at as u64) || !velt_simd_i16x8_fits(from, (at + 8) as u64)) {
      panic("RangeError: i16x8.load: range is out of bounds");
    }
    const lo = velt_simd_i16x8_load(from, at as u64);
    return Vector256.fromI16x8(lo, velt_simd_i16x8_load(from, (at + 8) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 3) and `hi`'s (4 to 7). */
  static fromU32x4(lo: u32x4, hi: u32x4): Vector256<u32> {
    return { lo: velt_simd_u32x4_as_u8x16(lo), hi: velt_simd_u32x4_as_u8x16(hi) };
  }

  /** The 8 lanes of `from` from `at` on. */
  static loadU32(from: u32[], at: usize = 0): Vector256<u32> {
    if (!velt_simd_u32x4_fits(from, at as u64) || !velt_simd_u32x4_fits(from, (at + 4) as u64)) {
      panic("RangeError: u32x4.load: range is out of bounds");
    }
    const lo = velt_simd_u32x4_load(from, at as u64);
    return Vector256.fromU32x4(lo, velt_simd_u32x4_load(from, (at + 4) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 3) and `hi`'s (4 to 7). */
  static fromI32x4(lo: i32x4, hi: i32x4): Vector256<i32> {
    return { lo: velt_simd_i32x4_as_u8x16(lo), hi: velt_simd_i32x4_as_u8x16(hi) };
  }

  /** The 8 lanes of `from` from `at` on. */
  static loadI32(from: i32[], at: usize = 0): Vector256<i32> {
    if (!velt_simd_i32x4_fits(from, at as u64) || !velt_simd_i32x4_fits(from, (at + 4) as u64)) {
      panic("RangeError: i32x4.load: range is out of bounds");
    }
    const lo = velt_simd_i32x4_load(from, at as u64);
    return Vector256.fromI32x4(lo, velt_simd_i32x4_load(from, (at + 4) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 1) and `hi`'s (2 to 3). */
  static fromU64x2(lo: u64x2, hi: u64x2): Vector256<u64> {
    return { lo: velt_simd_u64x2_as_u8x16(lo), hi: velt_simd_u64x2_as_u8x16(hi) };
  }

  /** The 4 lanes of `from` from `at` on. */
  static loadU64(from: u64[], at: usize = 0): Vector256<u64> {
    if (!velt_simd_u64x2_fits(from, at as u64) || !velt_simd_u64x2_fits(from, (at + 2) as u64)) {
      panic("RangeError: u64x2.load: range is out of bounds");
    }
    const lo = velt_simd_u64x2_load(from, at as u64);
    return Vector256.fromU64x2(lo, velt_simd_u64x2_load(from, (at + 2) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 1) and `hi`'s (2 to 3). */
  static fromI64x2(lo: i64x2, hi: i64x2): Vector256<i64> {
    return { lo: velt_simd_i64x2_as_u8x16(lo), hi: velt_simd_i64x2_as_u8x16(hi) };
  }

  /** The 4 lanes of `from` from `at` on. */
  static loadI64(from: i64[], at: usize = 0): Vector256<i64> {
    if (!velt_simd_i64x2_fits(from, at as u64) || !velt_simd_i64x2_fits(from, (at + 2) as u64)) {
      panic("RangeError: i64x2.load: range is out of bounds");
    }
    const lo = velt_simd_i64x2_load(from, at as u64);
    return Vector256.fromI64x2(lo, velt_simd_i64x2_load(from, (at + 2) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 3) and `hi`'s (4 to 7). */
  static fromF32x4(lo: f32x4, hi: f32x4): Vector256<f32> {
    return { lo: velt_simd_f32x4_as_u8x16(lo), hi: velt_simd_f32x4_as_u8x16(hi) };
  }

  /** The 8 lanes of `from` from `at` on. */
  static loadF32(from: f32[], at: usize = 0): Vector256<f32> {
    if (!velt_simd_f32x4_fits(from, at as u64) || !velt_simd_f32x4_fits(from, (at + 4) as u64)) {
      panic("RangeError: f32x4.load: range is out of bounds");
    }
    const lo = velt_simd_f32x4_load(from, at as u64);
    return Vector256.fromF32x4(lo, velt_simd_f32x4_load(from, (at + 4) as u64));
  }

  /** The vector of `lo`'s lanes (0 to 1) and `hi`'s (2 to 3). */
  static fromF64x2(lo: f64x2, hi: f64x2): Vector256<f64> {
    return { lo: velt_simd_f64x2_as_u8x16(lo), hi: velt_simd_f64x2_as_u8x16(hi) };
  }

  /** The 4 lanes of `from` from `at` on. */
  static loadF64(from: f64[], at: usize = 0): Vector256<f64> {
    if (!velt_simd_f64x2_fits(from, at as u64) || !velt_simd_f64x2_fits(from, (at + 2) as u64)) {
      panic("RangeError: f64x2.load: range is out of bounds");
    }
    const lo = velt_simd_f64x2_load(from, at as u64);
    return Vector256.fromF64x2(lo, velt_simd_f64x2_load(from, (at + 2) as u64));
  }
}

extend Vector256<u8> {
  /** Lanes 0 to 15. */
  lower(): u8x16 {
    return this.lo;
  }

  /** Lanes 16 to 31. */
  upper(): u8x16 {
    return this.hi;
  }

  /** Stores its 32 lanes in `to` from `at` on. */
  store(to: u8[], at: usize = 0) {
    if (!velt_simd_u8x16_fits(to, at as u64)) {
      panic("RangeError: u8x16.store: range is out of bounds");
    }
    velt_simd_u8x16_store(this.lower(), to, at as u64);
    if (!velt_simd_u8x16_fits(to, (at + 16) as u64)) {
      panic("RangeError: u8x16.store: range is out of bounds");
    }
    velt_simd_u8x16_store(this.upper(), to, (at + 16) as u64);
  }
}

