declare function velt_simd_i16x8_load(from: i16[], at: u64): i16x8;
declare function velt_simd_i16x8_store(v: i16x8, to: i16[], at: u64);
declare function velt_simd_u32x4_as_u8x16(v: u32x4): u8x16;
declare function velt_simd_u8x16_as_u32x4(v: u8x16): u32x4;
declare function velt_simd_u32x4_fits(xs: u32[], at: u64): bool;
