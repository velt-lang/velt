// velt/arch/x86 (internal): `Avx512CD`, the check of `avx512cd-x86` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { AVX512CD_X86 } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("avx512cd-x86")`) and what such code calls.
declare function velt_simd_has_avx512cd_x86(): bool;
// Whether this build runs x86-64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_x86(): bool;

/** AVX-512 conflict detection. The check of `@targetFeature("avx512cd-x86")`. */
export class Avx512CD {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=AVX512CD`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_avx512cd_x86() || (velt_simd_on_x86() && cpuHas(AVX512CD_X86));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * The number of zero bits above the highest bit set in each lane (32 for 0).
   *
   * `_mm512_lzcnt_epi32` (`vplzcntd`). Runs only where the CPU has it: call it behind
   * `Avx512CD.isSupported()`, or in a function gated on `avx512cd-x86`.
   */
  static leadingZeroCountU32(value: Vector512<u32>): Vector512<u32> {
    return velt_arch_avx512cd_leading_zero_count_u32(value);
  }
}

import { Vector512 } from "velt/arch/x86/vector512";

declare function velt_arch_avx512cd_leading_zero_count_u32(value: Vector512<u32>): Vector512<u32>;
