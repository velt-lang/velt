// velt/arch/x86 (internal): `Popcnt`, the check of `popcnt-x86` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { POPCNT_X86 } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("popcnt-x86")`) and what such code calls.
declare function velt_simd_has_popcnt_x86(): bool;
// Whether this build runs x86-64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_x86(): bool;

/** POPCNT. The check of `@targetFeature("popcnt-x86")`. */
export class Popcnt {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=POPCNT`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_popcnt_x86() || (velt_simd_on_x86() && cpuHas(POPCNT_X86));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * The number of bits set in `value`.
   *
   * `_mm_popcnt_u32` (`popcnt`). Runs only where the CPU has it: call it behind
   * `Popcnt.isSupported()`, or in a function gated on `popcnt-x86`.
   */
  static popCountU32(value: u32): u32 {
    return velt_arch_popcnt_pop_count_u32(value);
  }

  /**
   * The number of bits set in `value`.
   *
   * `_mm_popcnt_u64` (`popcnt`). Runs only where the CPU has it: call it behind
   * `Popcnt.isSupported()`, or in a function gated on `popcnt-x86`.
   */
  static popCountU64(value: u64): u64 {
    return velt_arch_popcnt_pop_count_u64(value);
  }
}

declare function velt_arch_popcnt_pop_count_u32(value: u32): u32;
declare function velt_arch_popcnt_pop_count_u64(value: u64): u64;
