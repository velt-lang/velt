// velt/arch/x86 (internal): `Sse42`, the check of `sse4.2-x86` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { SSE4_2_X86 } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("sse4.2-x86")`) and what such code calls.
declare function velt_simd_has_sse4_2_x86(): bool;
// Whether this build runs x86-64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_x86(): bool;

/** SSE4.2 (with CRC32 and the string instructions). The check of `@targetFeature("sse4.2-x86")`. */
export class Sse42 {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=SSE4.2`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_sse4_2_x86() || (velt_simd_on_x86() && cpuHas(SSE4_2_X86));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * The CRC-32C of `crc` extended by the byte `data` (the bits reflected, no final inversion).
   *
   * `_mm_crc32_u8` (`crc32b`). Runs only where the CPU has it: call it behind
   * `Sse42.isSupported()`, or in a function gated on `sse4.2-x86`.
   */
  static crc32U8(crc: u32, data: u8): u32 {
    return velt_arch_sse42_crc32_u8(crc, data);
  }

  /**
   * The CRC-32C of `crc` extended by the two bytes of `data`, low byte first.
   *
   * `_mm_crc32_u16` (`crc32w`). Runs only where the CPU has it: call it behind
   * `Sse42.isSupported()`, or in a function gated on `sse4.2-x86`.
   */
  static crc32U16(crc: u32, data: u16): u32 {
    return velt_arch_sse42_crc32_u16(crc, data);
  }

  /**
   * The CRC-32C of `crc` extended by the four bytes of `data`, low byte first.
   *
   * `_mm_crc32_u32` (`crc32l`). Runs only where the CPU has it: call it behind
   * `Sse42.isSupported()`, or in a function gated on `sse4.2-x86`.
   */
  static crc32U32(crc: u32, data: u32): u32 {
    return velt_arch_sse42_crc32_u32(crc, data);
  }

  /**
   * The CRC-32C of `crc` (its low 32 bits) extended by the eight bytes of `data`, low byte first.
   *
   * `_mm_crc32_u64` (`crc32q`). Runs only where the CPU has it: call it behind
   * `Sse42.isSupported()`, or in a function gated on `sse4.2-x86`.
   */
  static crc32U64(crc: u64, data: u64): u64 {
    return velt_arch_sse42_crc32_u64(crc, data);
  }
}

declare function velt_arch_sse42_crc32_u8(crc: u32, data: u8): u32;
declare function velt_arch_sse42_crc32_u16(crc: u32, data: u16): u32;
declare function velt_arch_sse42_crc32_u32(crc: u32, data: u32): u32;
declare function velt_arch_sse42_crc32_u64(crc: u64, data: u64): u64;
