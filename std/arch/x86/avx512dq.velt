// velt/arch/x86 (internal): `Avx512DQ`, the check of `avx512dq-x86` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { AVX512DQ_X86 } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("avx512dq-x86")`) and what such code calls.
declare function velt_simd_has_avx512dq_x86(): bool;
// Whether this build runs x86-64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_x86(): bool;

/** AVX-512 doubleword and quadword instructions. The check of `@targetFeature("avx512dq-x86")`. */
export class Avx512DQ {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=AVX512DQ`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_avx512dq_x86() || (velt_simd_on_x86() && cpuHas(AVX512DQ_X86));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * The low 64 bits of each product of `left`'s and `right`'s lanes.
   *
   * `_mm512_mullo_epi64` (`vpmullq`). Runs only where the CPU has it: call it behind
   * `Avx512DQ.isSupported()`, or in a function gated on `avx512dq-x86`.
   */
  static multiplyLowU64(left: Vector512<u64>, right: Vector512<u64>): Vector512<u64> {
    return velt_arch_avx512dq_multiply_low_u64(left, right);
  }
}

import { Vector512 } from "velt/arch/x86/vector512";

declare function velt_arch_avx512dq_multiply_low_u64(
  left: Vector512<u64>,
  right: Vector512<u64>,
): Vector512<u64>;
