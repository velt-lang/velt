// velt/arch/x86 (internal): `Avx512Vbmi`, the check of `avx512vbmi-x86` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { AVX512VBMI_X86 } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("avx512vbmi-x86")`) and what such code calls.
declare function velt_simd_has_avx512vbmi_x86(): bool;
// Whether this build runs x86-64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_x86(): bool;

/** AVX-512 vector byte manipulation. The check of `@targetFeature("avx512vbmi-x86")`. */
export class Avx512Vbmi {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=AVX512VBMI`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_avx512vbmi_x86() || (velt_simd_on_x86() && cpuHas(AVX512VBMI_X86));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * Byte `i` is byte `indices[i] & 63` of `value`.
   *
   * `_mm512_permutexvar_epi8` (`vpermb`). Runs only where the CPU has it: call it behind
   * `Avx512Vbmi.isSupported()`, or in a function gated on `avx512vbmi-x86`. Its operands are in the
   * opposite order to `_mm512_permutexvar_epi8`'s, which takes the indices first.
   */
  static permuteVarU8(value: Vector512<u8>, indices: Vector512<u8>): Vector512<u8> {
    return velt_arch_avx512vbmi_permute_var_u8(value, indices);
  }
}

import { Vector512 } from "velt/arch/x86/vector512";

declare function velt_arch_avx512vbmi_permute_var_u8(
  value: Vector512<u8>,
  indices: Vector512<u8>,
): Vector512<u8>;
