// velt/arch/arm (internal): `Pmull`, the check of `clmul-arm` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { CLMUL_ARM } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("clmul-arm")`) and what such code calls.
declare function velt_simd_has_clmul_arm(): bool;
// Whether this build runs arm64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_arm(): bool;

/** The ARMv8 64-bit polynomial multiplication (FEAT_PMULL, LLVM's `aes`). The check of `@targetFeature("clmul-arm")`. */
export class Pmull {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=PMULL`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_clmul_arm() || (velt_simd_on_arm() && cpuHas(CLMUL_ARM));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * The 128-bit carry-less product of lane 0 of `left` and lane 0 of `right`.
   *
   * `vmull_p64` (`pmull`). Runs only where the CPU has it: call it behind `Pmull.isSupported()`, or
   * in a function gated on `clmul-arm`.
   */
  static polynomialMultiplyWideningLower(left: u64x2, right: u64x2): u64x2 {
    return velt_arch_pmull_polynomial_multiply_widening_lower(left, right);
  }

  /**
   * The 128-bit carry-less product of lane 1 of `left` and lane 1 of `right`.
   *
   * `vmull_high_p64` (`pmull2`). Runs only where the CPU has it: call it behind
   * `Pmull.isSupported()`, or in a function gated on `clmul-arm`.
   */
  static polynomialMultiplyWideningUpper(left: u64x2, right: u64x2): u64x2 {
    return velt_arch_pmull_polynomial_multiply_widening_upper(left, right);
  }
}

declare function velt_arch_pmull_polynomial_multiply_widening_lower(
  left: u64x2,
  right: u64x2,
): u64x2;
declare function velt_arch_pmull_polynomial_multiply_widening_upper(
  left: u64x2,
  right: u64x2,
): u64x2;
