// velt/arch/arm (internal): `Dp`, the check of `dotprod-arm` (docs/internals/design/package-machine-code.md §2).

import { cpuHas } from "velt/lang/cpu/word";
import { DOTPROD_ARM } from "velt/lang/cpu/masks";

// True only where the build guarantees the feature: code built for a CPU that has it (`--cpu`),
// or gated on it (`@targetFeature("dotprod-arm")`) and what such code calls.
declare function velt_simd_has_dotprod_arm(): bool;
// Whether this build runs arm64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_arm(): bool;

/** The Armv8.2 dot products (FEAT_DotProd). The check of `@targetFeature("dotprod-arm")`. */
export class Dp {
  /**
   * Whether this CPU has it: true at compile time where the build guarantees it (`--cpu`, or in
   * a function gated on it), otherwise the CPU's answer, read once at start-up. False on another
   * architecture, on WebAssembly, in debug (Cranelift) builds, and with `VELT_CPU_DISABLE=DOTPROD`.
   * Check once, outside a hot loop: it is a load of the start-up word wherever the build doesn't
   * decide it.
   */
  static isSupported(): bool {
    return velt_simd_has_dotprod_arm() || (velt_simd_on_arm() && cpuHas(DOTPROD_ARM));
  }

  // The instructions, generated from velt_vir's table (crates/velt_vir/src/arch) by
  // `cargo xtask gen-arch`: edit the table, not these.

  /**
   * Lane `i` of `addend` plus the products of bytes `4i` to `4i + 3` of `left` and `right`.
   *
   * `vdotq_u32` (`udot`). Runs only where the CPU has it: call it behind `Dp.isSupported()`, or in
   * a function gated on `dotprod-arm`.
   */
  static dotProductU8(addend: u32x4, left: u8x16, right: u8x16): u32x4 {
    return velt_arch_dp_dot_product_u8(addend, left, right);
  }

  /**
   * Lane `i` of `addend` plus the products of bytes `4i` to `4i + 3` of `left` and `right`.
   *
   * `vdotq_s32` (`sdot`). Runs only where the CPU has it: call it behind `Dp.isSupported()`, or in
   * a function gated on `dotprod-arm`.
   */
  static dotProductI8(addend: i32x4, left: i8x16, right: i8x16): i32x4 {
    return velt_arch_dp_dot_product_i8(addend, left, right);
  }
}

declare function velt_arch_dp_dot_product_u8(addend: u32x4, left: u8x16, right: u8x16): u32x4;
declare function velt_arch_dp_dot_product_i8(addend: i32x4, left: i8x16, right: i8x16): i32x4;
