// std/proxy/array: the array methods called on a proxy of an array (`push`, `pop`, `shift`,
// `unshift`, `splice`, `map`, `filter`, `forEach`, `some`, `every`, `find`, `includes`,
// `indexOf`, `join`, `slice`, `reverse`, `sort`; issue #823, docs/reference/types.md "Proxy and
// Reflect").
//
// `p.push(x)` on a proxy reads `push` through the `get` trap. When the trap forwards to an array
// (`Reflect.get(target, key, receiver)`), the method it reads is an `__ArrayMethod`, and the call
// runs the method's generic algorithm from the ECMAScript specification with the proxy as `this`
// (`Proxy.__arrayCall`, which velt_vir's proxy call slot calls): every read of `length` or of an
// element, every write, `in` test and delete goes through the traps, in Node's order.

import { Proxy } from "velt:proxy";

/**
 * An array method read through a proxy (`Reflect.get(array, "push")`), or `constructor`
 * (`Array`): calling it on a proxy runs the method on the proxy. `typeof` and `console.log`
 * show it as the function it stands for (velt_vir's `is_array_method`); called any other way,
 * it is not supported yet.
 */
export class __ArrayMethod {
  name: string;

  constructor(name: string) {
    this.name = name;
  }
}

/** The `__ArrayMethod`s read so far, one per name, so that a method read twice is the same. */
let arrayMethods: __ArrayMethod[] = [];

/** The `__ArrayMethod` named `name`. */
export function __arrayMethod(name: string): __ArrayMethod {
  for (const m of arrayMethods) {
    if (m.name === name) {
      return m;
    }
  }
  const m = new __ArrayMethod(name);
  arrayMethods.push(m);
  return m;
}

/** Is `key` an array method a proxy runs generically (`__ArrayMethod`)? */
export function __proxyArrayMethod(key: string): boolean {
  return key === "push" ||
    key === "pop" ||
    key === "shift" ||
    key === "unshift" ||
    key === "splice" ||
    key === "map" ||
    key === "filter" ||
    key === "forEach" ||
    key === "some" ||
    key === "every" ||
    key === "find" ||
    key === "includes" ||
    key === "indexOf" ||
    key === "join" ||
    key === "slice" ||
    key === "reverse" ||
    key === "sort";
}

/**
 * How many array methods are running on proxies (`__proxyArrayCall`), and the holes they made
 * in arrays: the elements of `holeArrays[i]` from `holeStarts[i]` up to `holeEnds[i]` are not
 * there (Node's holes). `pop`, `shift` and `splice` delete the last elements before they write
 * the shorter length, and `unshift` and `splice` write elements past the end before they fill
 * the gap; Velt's arrays have no holes, so the elements stay (a gap is filled with the value
 * written past it) and `Reflect` skips them until the method fills them or cuts them off.
 */
let arrayCalls = 0;
let holeArrays: any[] = [];
let holeStarts: number[] = [];
let holeEnds: number[] = [];

/** The position of `a` in `holeArrays`, or -1. */
function holeAt(a: any): number {
  const n = holeArrays.length as number;
  for (let i = 0; i < n; i++) {
    if (holeArrays[i] === a) {
      return i;
    }
  }
  return -1;
}

/** The holes of `a` as `[start, end)` (an empty range when it has none). */
function holesOf(a: any): [number, number] {
  const at = holeAt(a);
  if (at < 0) {
    return [0, 0];
  }
  // A shorter length (written through `any` too) cuts holes off.
  const end = Math.min(holeEnds[at], a.length as number);
  return holeStarts[at] < end ? [holeStarts[at], end] : [0, 0];
}

/** Records the holes of `a` as `[start, end)`. */
function setHoles(a: any, start: number, end: number): void {
  const at = holeAt(a);
  if (at >= 0) {
    holeStarts[at] = start;
    holeEnds[at] = end;
    return;
  }
  if (start < end) {
    holeArrays.push(a);
    holeStarts.push(start);
    holeEnds.push(end);
  }
}

/** Is element `i` of the array `a` a hole an array method on a proxy made? */
export function __arrayHole(a: any, i: number): boolean {
  const [s, e] = holesOf(a);
  return i >= s && i < e;
}

/**
 * `Reflect.deleteProperty(a, i)` of an array `a` and an index `i`: an element past the end or
 * a hole is not there; the last one (or the one before the holes at the end) goes while an
 * array method runs on a proxy. Any other element would leave a hole, which Velt's arrays
 * cannot have yet.
 */
export function __arrayDeleteIndex(a: any, i: number): boolean {
  const n = a.length as number;
  const [s, e] = holesOf(a);
  if (i >= n || (i >= s && i < e)) {
    return true;
  }
  const top = e == n && s < e ? s : n;
  if (i == top - 1 && (s == e || e == n) && arrayCalls > 0) {
    setHoles(a, i, n);
    return true;
  }
  panic(
    `TypeError: deleting element ${i} of an array of ${n} through \`any\` is not supported yet (#823): Velt's arrays have no holes`,
  );
}

/**
 * `Reflect.set(a, i, v)` of an array `a` and an index `i`: a hole at either end of the holes is
 * filled; an element past the end is appended, and inside an array method on a proxy one past
 * that leaves a gap of holes (filled with `v` until the method writes them). Anything else
 * would leave a hole, which Velt's arrays cannot have yet.
 */
export function __arraySetIndex(a: any, i: number, v: any): void {
  const n = a.length as number;
  const [s, e] = holesOf(a);
  if (i >= s && i < e) {
    if (i == s) {
      setHoles(a, s + 1, e);
    } else if (i == e - 1) {
      setHoles(a, s, e - 1);
    } else {
      panic(
        `TypeError: writing element ${i} between the holes ${s} to ${e - 1} of an array is not supported yet (#823): Velt's arrays have no holes`,
      );
    }
  } else if (i > n) {
    if (arrayCalls == 0 || s < e) {
      panic(
        `TypeError: writing element ${i} past the end of an array of ${n} through \`any\` is not supported yet (#924): Velt's arrays have no holes`,
      );
    }
    setHoles(a, n, i);
    while ((a.length as number) < i) {
      a[a.length] = v;
    }
  }
  a[i] = v;
}

/** The keys of the array `a` that `Reflect.ownKeys` lists: its elements but holes. */
export function __arrayOwnKeys(a: any): (string | symbol)[] {
  const n = a.length as number;
  const out: (string | symbol)[] = [];
  for (let i = 0; i < n; i++) {
    if (!__arrayHole(a, i)) {
      out.push(`${i}`);
    }
  }
  out.push("length");
  return out;
}

/** JavaScript's `ToIntegerOrInfinity` of an argument (a number; anything else is 0). */
function arrayInt(v: any): number {
  if (typeof v !== "number") {
    return 0;
  }
  const n = v as number;
  if (n !== n) {
    return 0;
  }
  return n < 0 ? -Math.floor(-n) : Math.floor(n);
}

/** `Set(O, key, v, true)` through the proxy `p`: a trap answering `false` is Node's `TypeError`. */
function arraySet(p: Proxy, o: any, key: string, v: any): void {
  if (!p.__set(key, v, o)) {
    panic(`TypeError: 'set' on proxy: trap returned falsish for property '${key}'`);
  }
}

/** Moves element `from` to `to` (`has`, then `get` and `set`, or `deleteProperty`). */
function arrayMove(p: Proxy, o: any, from: number, to: number): void {
  const f = `${from}`;
  const t = `${to}`;
  if (p.__has(f)) {
    arraySet(p, o, t, p.__get(f, o));
  } else {
    p.__delete(t);
  }
}

/**
 * `Array.prototype[name].apply(o, args)` for the proxy `p` of an array, `o` its receiver: each
 * method is the steps of `splice` that its own algorithm takes in the same order.
 */
export function __proxyArrayCall(p: Proxy, name: string, args: any[], o: any): any {
  arrayCalls++;
  // A trap cannot throw yet (#1326), so the method runs to its end here.
  const r = proxyArrayCall(p, name, args, o);
  arrayCalls--;
  if (arrayCalls == 0) {
    // Holes a method's traps left (a delete without the shorter length after it, a write past
    // the end without the gap's).
    let left: [number, number] = [0, 0];
    for (const a of holeArrays) {
      const h = holesOf(a);
      if (h[0] < h[1]) {
        left = h;
      }
    }
    holeArrays = [];
    holeStarts = [];
    holeEnds = [];
    if (left[0] < left[1]) {
      panic(
        `TypeError: an array method on a proxy left holes at ${left[0]} to ${left[1] - 1} (#823): Velt's arrays have no holes`,
      );
    }
  }
  return r;
}

function proxyArrayCall(p: Proxy, name: string, args: any[], o: any): any {
  const n = arrayInt(p.__get("length", o));
  const len = n < 0 ? 0 : n;
  const none: any[] = [];
  if (name === "push") {
    proxySplice(p, o, len, len, 0, args, 0, false);
    return len + (args.length as number);
  }
  if (name === "unshift") {
    proxySplice(p, o, len, 0, 0, args, 0, false);
    return len + (args.length as number);
  }
  if (name === "pop" || name === "shift") {
    const at = name === "pop" && len > 0 ? len - 1 : 0;
    const removed = proxySplice(p, o, len, at, len > 0 ? 1 : 0, none, 0, false);
    return len > 0 ? removed[0] : undefined;
  }
  if (name === "Array") {
    panic(
      "TypeError: calling an array's `constructor` through a proxy is not supported yet (#823)",
    );
  }
  if (name !== "splice") {
    return proxyArrayRead(p, name, args, o, len);
  }
  const argc = args.length as number;
  const rel = argc > 0 ? arrayInt(args[0]) : 0;
  const start = rel < 0 ? Math.max(len + rel, 0) : Math.min(rel, len);
  let count = argc == 1 ? len - start : 0;
  if (argc > 1) {
    count = Math.min(Math.max(arrayInt(args[1]), 0), len - start);
  }
  return proxySplice(p, o, len, start, count, args, 2, true);
}

/**
 * Removes `count` elements at `start` from the proxy `p` (length `len`) and inserts
 * `items[from..]` there, through the traps; the removed elements. `splice` reads the
 * constructor (ArraySpeciesCreate) and tests each removed element with `has` first.
 */
function proxySplice(
  p: Proxy,
  o: any,
  len: number,
  start: number,
  count: number,
  items: any[],
  from: number,
  splice: boolean,
): any[] {
  const n = (items.length as number) > from ? (items.length as number) - from : 0;
  if (splice) {
    p.__get("constructor", o);
  }
  const removed: any[] = [];
  for (let k = 0; k < count; k++) {
    const key = `${start + k}`;
    removed.push(!splice || p.__has(key) ? p.__get(key, o) : undefined);
  }
  if (n < count) {
    for (let k = start; k < len - count; k++) {
      arrayMove(p, o, k + count, k + n);
    }
    for (let k = len; k > len - count + n; k--) {
      p.__delete(`${k - 1}`);
    }
  }
  for (let k = len - count; k > start && n > count; k--) {
    arrayMove(p, o, k + count - 1, k + n - 1);
  }
  for (let i = 0; i < n; i++) {
    arraySet(p, o, `${start + i}`, items[i + from]);
  }
  arraySet(p, o, "length", len - count + n);
  return removed;
}

/** Argument `i` of a call, or `undefined`. */
function arrayArg(args: any[], i: i64): any {
  return (args.length as i64) > i ? args[i] : undefined;
}

/** The position a relative index `v` (an argument; `undefined`: `dflt`) names in `0..len`. */
function arrayRel(v: any, len: number, dflt: number): number {
  if (v === undefined) {
    return dflt;
  }
  const rel = arrayInt(v);
  return rel < 0 ? Math.max(len + rel, 0) : Math.min(rel, len);
}

/** A callback argument, or Node's `TypeError`. */
function arrayCallback(f: any): any {
  if (typeof f !== "function") {
    panic(`TypeError: ${String(f)} is not a function`);
  }
  return f;
}

/**
 * The other methods of `__proxyArrayMethod` on the proxy `p` (length `len`), each the steps of
 * its algorithm in the specification: `map`, `filter`, `forEach`, `some`, `every` and `find`
 * call the callback with the element, its index and the proxy (`thisArg` is not passed on);
 * `map`, `filter` and `slice` read `constructor` (ArraySpeciesCreate) and give a new array.
 */
function proxyArrayRead(p: Proxy, name: string, args: any[], o: any, len: number): any {
  const a0 = arrayArg(args, 0);
  if (name === "find") {
    const f = arrayCallback(a0);
    for (let k = 0; k < len; k++) {
      const v = p.__get(`${k}`, o);
      if (f(v, k, o) ? true : false) {
        return v;
      }
    }
    return undefined;
  }
  if (name === "includes" || name === "indexOf") {
    const found = name === "includes" ? true : false;
    const none: any = name === "includes" ? false : -1;
    if (len == 0) {
      return none;
    }
    const from = arrayArg(args, 1);
    if (arrayInt(from) >= len) {
      return none;
    }
    for (let k = arrayRel(from, len, 0); k < len; k++) {
      const key = `${k}`;
      if (name === "includes") {
        const v = p.__get(key, o);
        if (v === a0 || (v !== v && a0 !== a0)) {
          return found;
        }
      } else if (p.__has(key) && p.__get(key, o) === a0) {
        return k;
      }
    }
    return none;
  }
  if (name === "join") {
    const sep = a0 === undefined ? "," : String(a0);
    let out = "";
    for (let k = 0; k < len; k++) {
      const v = p.__get(`${k}`, o);
      out += (k > 0 ? sep : "") + (v === undefined || v === null ? "" : String(v));
    }
    return out;
  }
  if (name === "reverse") {
    proxyReverse(p, o, len);
    return o;
  }
  if (name === "sort") {
    return proxySort(p, o, len, a0);
  }
  const out: any[] = [];
  let from = 0;
  let to = len;
  if (name === "slice") {
    from = arrayRel(a0, len, 0);
    to = Math.max(arrayRel(arrayArg(args, 1), len, len), from);
  }
  const f = name === "slice" ? undefined : arrayCallback(a0);
  if (name === "map" || name === "filter" || name === "slice") {
    p.__get("constructor", o);
  }
  for (let k = from; k < to; k++) {
    const key = `${k}`;
    if (!p.__has(key)) {
      continue;
    }
    const v = p.__get(key, o);
    if (name === "slice") {
      out.push(v);
      continue;
    }
    const r = f(v, k, o);
    if (name === "map") {
      out.push(r);
    } else if (name === "filter" && (r ? true : false)) {
      out.push(v);
    } else if (name === "some" && (r ? true : false)) {
      return true;
    } else if (name === "every" && !(r ? true : false)) {
      return false;
    }
  }
  if (name === "some" || name === "every") {
    return name === "every";
  }
  if (name === "forEach") {
    return undefined;
  }
  return out;
}

/** `reverse` of the proxy `p`: each pair of elements from the ends, through the traps. */
function proxyReverse(p: Proxy, o: any, len: number): void {
  const middle = Math.floor(len / 2);
  for (let lower = 0; lower < middle; lower++) {
    const lk = `${lower}`;
    const uk = `${len - lower - 1}`;
    const lowerExists = p.__has(lk);
    const lowerValue = lowerExists ? p.__get(lk, o) : undefined;
    const upperExists = p.__has(uk);
    const upperValue = upperExists ? p.__get(uk, o) : undefined;
    if (upperExists) {
      arraySet(p, o, lk, upperValue);
    } else if (lowerExists) {
      p.__delete(lk);
    }
    if (lowerExists) {
      arraySet(p, o, uk, lowerValue);
    } else if (upperExists) {
      p.__delete(uk);
    }
  }
}

/**
 * `sort` of the proxy `p`: reads the elements it has, sorts them (`undefined` last; by the
 * comparison function, else by their strings), writes them back and deletes the rest.
 */
function proxySort(p: Proxy, o: any, len: number, cmp: any): any {
  if (cmp !== undefined && typeof cmp !== "function") {
    panic("TypeError: The comparison function must be either a function or undefined");
  }
  const items: any[] = [];
  let undefs = 0;
  for (let k = 0; k < len; k++) {
    const key = `${k}`;
    if (p.__has(key)) {
      const v = p.__get(key, o);
      if (v === undefined) {
        undefs++;
      } else {
        items.push(v);
      }
    }
  }
  items.sort((a: any, b: any): number => {
    if (cmp === undefined) {
      const x = String(a);
      const y = String(b);
      return x < y ? -1 : x > y ? 1 : 0;
    }
    const r = cmp(a, b);
    return typeof r === "number" ? (r as number) : 0;
  });
  const n = items.length as number;
  for (let j = 0; j < n; j++) {
    arraySet(p, o, `${j}`, items[j]);
  }
  for (let j = n; j < n + undefs; j++) {
    arraySet(p, o, `${j}`, undefined);
  }
  for (let j = n + undefs; j < len; j++) {
    p.__delete(`${j}`);
  }
  return o;
}
