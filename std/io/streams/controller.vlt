// velt/io (internal): `ReadableStreamDefaultController`, where a stream's state lives: the
// queue of chunks, the pending reads, and the flags of the spec's algorithms.

import {
  CancelCallback,
  CancelReason,
  PullCallback,
  ReadableStreamReadResult,
  UnderlyingSource,
} from "velt/io/streams/types";
import { INSPECT } from "velt/lang/hooks/keys";

/** The states of a stream. */
export const READABLE: u8 = 0;

export const CLOSED: u8 = 1;

const ERRORED: u8 = 2;

// A read waiting for a chunk: how to settle it.
struct Request<R> {
  resolve: (value: ReadableStreamReadResult<R>) => void;
  reject: (reason: unknown) => void;
}

// A wait for the stream to close (`reader.closed`).
struct CloseWait {
  resolve: (value: void) => void;
  reject: (reason: unknown) => void;
}

/** `TypeError: Invalid state: <what>`, Node's message for a stream used in a wrong state. */
export function invalidState(what: string): TypeError {
  return new TypeError(`Invalid state: ${what}`);
}

/**
 * The handle a source gets to its stream: `enqueue(chunk)`, `close()`, `error(e)` and
 * `desiredSize` (how many more chunks the queue wants). Streams make it; JS has no public
 * constructor either.
 */
export class ReadableStreamDefaultController<R> {
  // The source's `pull` and `cancel`, dropped once the stream is closed or errored (the spec's
  // ClearAlgorithms), so a source whose callbacks hold the controller is freed with the stream.
  // `start` is not kept at all.
  private pullFn: PullCallback<R> | null;
  private cancelFn: CancelCallback | null;
  // The chunks not read yet: `queue[head..]`.
  private queue: R[] = [];
  private head: usize = 0;
  private hwm: number;
  private state: u8 = READABLE;
  private stored: unknown = null;
  private started: bool = false;
  private pulling: bool = false;
  private pullAgain: bool = false;
  private closeRequested: bool = false;
  // Whether a reader holds the stream.
  private locked: bool = false;
  // Reads waiting for a chunk, oldest first.
  private requests: Request<R>[] = [];
  private closeWaits: CloseWait[] = [];
  // `ReadableStream.from`'s source: the iterator pulled from instead of `source.pull`.
  private iter: AsyncIterator<R, Error> | null = null;
  // A body of `fetch`, `Response` or `Request`: shown as a byte stream, as Node shows one.
  private bytes: bool = false;

  private constructor(source: UnderlyingSource<R>, hwm: number) {
    this.pullFn = source.pull ?? null;
    this.cancelFn = source.cancel ?? null;
    this.hwm = hwm;
  }

  /**
   * How many more chunks the queue wants: the high-water mark minus the chunks queued, 0 once
   * closed, null once errored.
   */
  get desiredSize(): number | null {
    if (this.state == ERRORED) {
      return null;
    }
    if (this.state == CLOSED) {
      return 0;
    }
    return this.hwm - (this.queued() as number);
  }

  /** Adds `chunk` to the stream: the oldest waiting read gets it, or it is queued. */
  enqueue(chunk: R) {
    if (this.closeRequested || this.state != READABLE) {
      throw invalidState("Controller is already closed");
    }
    if (this.requests.length > 0) {
      const r = this.requests.shift();
      if (r != null) {
        r.resolve({ value: chunk, done: false });
      }
    } else {
      this.queue.push(chunk);
    }
    this.callPullIfNeeded();
  }

  /** Closes the stream: reads get the queued chunks, then `done`. */
  close() {
    if (this.closeRequested || this.state != READABLE) {
      throw invalidState("Controller is already closed");
    }
    this.closeRequested = true;
    if (this.queued() == 0) {
      this.finishClose();
    }
  }

  /** Errors the stream with `e`: queued chunks are dropped and reads reject with `e`. */
  error(e: unknown) {
    if (this.state == READABLE) {
      this.fail(e);
    }
  }

  /** How `console.log` shows the controller, as Node does. */
  [INSPECT](): string {
    return "ReadableStreamDefaultController {}";
  }

  // ─── the stream's side (std only) ───

  // A new stream's state: runs `start`, then pulls a microtask after it settles. A `start` that
  // throws makes the constructor throw, as in JS.
  private static make<R>(
    source: UnderlyingSource<R>,
    hwm: number,
  ): ReadableStreamDefaultController<R> throws unknown {
    const c = new ReadableStreamDefaultController<R>(source, hwm);
    const start = source.start;
    if (start == null) {
      queueMicrotask(() => c.begun());
      return c;
    }
    const p = start(c);
    if (p == null) {
      queueMicrotask(() => c.begun());
    } else {
      p.then(() => c.begun(), (e) => c.error(e));
    }
    return c;
  }

  private begun() {
    this.started = true;
    this.callPullIfNeeded();
  }

  private queued(): usize {
    return this.queue.length as usize - this.head;
  }

  // The oldest queued chunk (there is one).
  private dequeue(): R {
    const chunk = this.queue[this.head];
    this.head++;
    if (this.head == this.queue.length as usize) {
      this.queue.truncate(0);
      this.head = 0;
    } else if (this.head >= 32 && this.head * 2 >= this.queue.length as usize) {
      this.queue.splice(0, this.head as i64);
      this.head = 0;
    }
    return chunk;
  }

  private shouldCallPull(): bool {
    if (this.state != READABLE || this.closeRequested || !this.started) {
      return false;
    }
    if (this.locked && this.requests.length > 0) {
      return true;
    }
    return this.hwm - (this.queued() as number) > 0;
  }

  // The spec's `ReadableStreamDefaultControllerCallPullIfNeeded`.
  private callPullIfNeeded() {
    if (!this.shouldCallPull()) {
      return;
    }
    if (this.pulling) {
      this.pullAgain = true;
      return;
    }
    this.pulling = true;
    const it = this.iter;
    if (it != null) {
      this.pullFrom(it).then(() => this.pulled(), (e) => this.fail(e));
      return;
    }
    const pull = this.pullFn;
    if (pull == null) {
      queueMicrotask(() => this.pulled());
      return;
    }
    try {
      const p = pull(this);
      if (p == null) {
        queueMicrotask(() => this.pulled());
      } else {
        p.then(() => this.pulled(), (e) => this.fail(e));
      }
    } catch (e) {
      queueMicrotask(() => this.fail(e));
    }
  }

  // One step of `ReadableStream.from`: the iterator's next value, or the end.
  private async pullFrom(it: AsyncIterator<R, Error>): Promise<void> throws Error {
    const r = await it.next();
    if (this.state != READABLE || this.closeRequested) {
      return;
    }
    if (r.done) {
      this.close();
    } else {
      this.enqueue(r.value);
    }
  }

  private pulled() {
    this.pulling = false;
    if (this.pullAgain) {
      this.pullAgain = false;
      this.callPullIfNeeded();
    }
  }

  // The spec's ClearAlgorithms: the source's callbacks are not called again.
  private clearCallbacks() {
    this.pullFn = null;
    this.cancelFn = null;
    this.iter = null;
  }

  private finishClose() {
    this.state = CLOSED;
    this.clearCallbacks();
    const requests = this.requests;
    this.requests = [];
    for (const r of requests) {
      r.resolve({ done: true });
    }
    const waits = this.closeWaits;
    this.closeWaits = [];
    for (const w of waits) {
      w.resolve();
    }
  }

  private fail(e: unknown) {
    if (this.state != READABLE) {
      return;
    }
    this.state = ERRORED;
    this.stored = e;
    this.clearCallbacks();
    this.queue = [];
    this.head = 0;
    const requests = this.requests;
    this.requests = [];
    for (const r of requests) {
      r.reject(e);
    }
    const waits = this.closeWaits;
    this.closeWaits = [];
    for (const w of waits) {
      w.reject(e);
    }
  }

  // `reader.read()`, done at once as in JS (a queued chunk is taken, a pull started); the
  // promise settles with the chunk, or when one arrives.
  private read(): Promise<ReadableStreamReadResult<R>, unknown> {
    // The field itself, not a copy in a local: such a copy is freed too early (#1140).
    if (this.state == ERRORED) {
      return Promise.reject<ReadableStreamReadResult<R>>(this.stored);
    }
    if (this.queued() > 0) {
      const chunk = this.dequeue();
      if (this.closeRequested && this.queued() == 0) {
        this.finishClose();
      } else {
        this.callPullIfNeeded();
      }
      return Promise.resolve<ReadableStreamReadResult<R>>({ value: chunk, done: false });
    }
    if (this.state == CLOSED) {
      return Promise.resolve<ReadableStreamReadResult<R>>({ done: true });
    }
    const {
      promise,
      resolve,
      reject,
    } = Promise.withResolvers<ReadableStreamReadResult<R>, unknown>();
    this.requests.push({ resolve: resolve, reject: reject });
    this.callPullIfNeeded();
    return promise;
  }

  // Rejects the waiting reads and `reader.closed`: their reader released the stream.
  private release() {
    this.locked = false;
    const requests = this.requests;
    this.requests = [];
    for (const r of requests) {
      r.reject(invalidState("Releasing reader"));
    }
    const waits = this.closeWaits;
    this.closeWaits = [];
    for (const w of waits) {
      w.reject(invalidState("Reader released"));
    }
  }

  // `reader.closed`: settles when the stream closes or errors.
  private closed(): Promise<void, unknown> {
    if (this.state == ERRORED) {
      return Promise.reject<void>(this.stored);
    }
    if (this.state == CLOSED) {
      return Promise.resolve();
    }
    const { promise, resolve, reject } = Promise.withResolvers<void, unknown>();
    this.closeWaits.push({ resolve: resolve, reject: reject });
    return promise;
  }

  // The spec's `ReadableStreamCancel`, done at once as in JS: the stream closes, its queue is
  // dropped and the source's `cancel` is called; the promise settles when that has finished.
  private cancel(reason: CancelReason): Promise<void, unknown> {
    if (this.state == ERRORED) {
      return Promise.reject<void>(this.stored);
    }
    if (this.state == CLOSED) {
      return Promise.resolve();
    }
    this.queue = [];
    this.head = 0;
    const it = this.iter;
    const cancel = this.cancelFn;
    this.finishClose();
    if (it != null) {
      return finished(it.return());
    }
    if (cancel == null) {
      return Promise.resolve();
    }
    try {
      const p = cancel(reason);
      if (p != null) {
        return p;
      }
    } catch (e) {
      return Promise.reject<void>(e);
    }
    return Promise.resolve();
  }
}

// Waits for `p`, dropping its result.
async function finished<T>(p: Promise<T>): Promise<void> {
  await p;
}
