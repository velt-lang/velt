// velt/io/streams/byte_source (std-internal): `ByteSource`, the base class of the bodies a fetch body
// (`BodyInit`, std/net/http/fetch/body.vlt) takes besides text and bytes: `ReadableStream<R>`, `Blob` (and
// `File`) and `FormData`. `BodyInit` names this class rather than each of them, so a program that
// uses `Response` without them loads neither velt/io/streams/streams, the typed arrays nor the form code
// (#1129). It depends on nothing a body does not already load.

import { IoError } from "velt/io/error";
import { AbortError } from "velt/task";

/** Something a body can be made of: a stream, a blob, form data (std only). */
export class ByteSource {
  /**
   * The chunks as bytes, read as the body is: a `ReadableStream`'s, each of which must be a
   * `Uint8Array` as Node requires (an `IoError` "EINVAL" otherwise).
   */
  __byteChunks(): AsyncIterator<u8[], IoError | AbortError> {
    return none();
  }

  /** The whole body when it is known when the request or response is made (a blob, a form). */
  __wholeBody(): u8[] | null {
    return null;
  }

  /** The `content-type` the body implies ("" for none): a blob's type, a form's boundary. */
  __type(): string {
    return "";
  }
}

async function* none(): AsyncGenerator<u8[], IoError | AbortError> {}
