// velt/io (internal): `settled`, how a stream's controller (controller.velt) waits for its source's
// promises: `p.then(ok, err)` written out (std/prelude/promise.velt `promiseThenElse`), in an
// async function rather than as closures over the controller, which made every closure of those
// types and the controller cycle-capable (docs/internals/design/cycles.md, #3119).

import { ReadableStreamDefaultController } from "velt/io/streams/controller";

declare async function velt_rt_microtask(): Promise<void>;

/**
 * Runs `c`'s step after `p` settles: `begun` or `error` for `start`'s promise, `pulled` or `fail`
 * for `pull`'s or a `ReadableStream.from` step's, a microtask's turn after `p` settles, as `then`
 * does. A source's promise is `adopt`ed as Node adopts it (`new Promise((r) => r(p))`): a turn
 * before it attaches and one more after the reaction, so the stream keeps Node's order against
 * other microtasks (#3643).
 */
export async function settled<R>(
  c: ReadableStreamDefaultController<R>,
  p: Promise<void, unknown>,
  start: bool,
  adopt: bool,
) {
  if (adopt) {
    await velt_rt_microtask();
  }
  try {
    await p;
  } catch (e) {
    await turns(adopt);
    if (start) {
      c.error(e);
    } else {
      c.fail(e);
    }
    return;
  }
  await turns(adopt);
  if (start) {
    c.begun();
  } else {
    c.pulled();
  }
}

/**
 * `p`, adopted as Node adopts the promise a source's `cancel` gives (`new Promise((r) => r(p))`):
 * it settles a turn before `p` is attached to and two turns after `p` settles, the hops `settled`
 * takes for an adopted promise, so `cancel`'s promise keeps Node's order (#3695). An async
 * function, not callbacks, for the reason `settled` is one.
 */
export async function adopted(p: Promise<void, unknown>): Promise<void> throws unknown {
  await velt_rt_microtask();
  try {
    await p;
  } catch (e) {
    await turns(true);
    throw e;
  }
  await turns(true);
}

// The turns after a settled promise's reaction: one, or two for an adopted promise.
async function turns(adopt: bool) {
  await velt_rt_microtask();
  if (adopt) {
    await velt_rt_microtask();
  }
}
