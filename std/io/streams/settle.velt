// velt/io (internal): how a stream's controller waits for its source's promises (#3643,
// #3695), as Node's streams settle them, and the error of a stream used in a wrong state.

// Waits for `p`, dropping its result.
export async function finished<T>(p: Promise<T>): Promise<void> {
  await p;
}

/**
 * `p` (a source's `start` or `pull` result) adopted as Node adopts it (`new Promise((r) =>
 * r(p))`): a job queued now attaches to `p`, and `ok` or `bad` runs a microtask after `p`'s
 * reaction. So a stream's pulls and reads keep Node's order against other microtasks (#3643):
 * three microtasks after a `p` that has settled by the return, two after one that settles later.
 */
export function adopted(p: Promise<void, unknown>, ok: () => void, bad: (e: unknown) => void) {
  queueMicrotask(() => p.then(() => queueMicrotask(ok), (e) => queueMicrotask(() => bad(e))));
}

/** `TypeError: Invalid state: <what>`, Node's message for a stream used in a wrong state. */
export function invalidState(what: string): TypeError {
  return new TypeError(`Invalid state: ${what}`);
}
