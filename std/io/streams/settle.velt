// velt/io (internal): how a stream's controller (controller.velt) waits for its source's promises
// (#3643, #3695), as Node's streams settle them, and the error of a stream used in a wrong state.
// `settled` is `p.then(ok, err)` written out (std/prelude/promise.velt `promiseThenElse`), in an
// async function rather than as closures over the controller, which made every closure of those
// types and the controller cycle-capable (docs/internals/design/cycles.md, #3119).

import { ReadableStreamDefaultController } from "velt/io/streams/controller";

declare async function velt_rt_microtask(): Promise<void>;

/** Waits for `p`, dropping its result. */
export async function finished<T>(p: Promise<T>): Promise<void> {
  await p;
}

/**
 * Runs `c`'s step after `p` settles: `begun` or `error` for `start`'s promise, `pulled` or `fail`
 * for `pull`'s or a `ReadableStream.from` step's, a microtask's turn after `p` settles, as `then`
 * does. A source's promise is `adopt`ed as Node adopts it (`new Promise((r) => r(p))`): a turn
 * before it attaches and one more after the reaction, so the stream keeps Node's order against
 * other microtasks (#3643).
 */
export async function settled<R>(
  c: ReadableStreamDefaultController<R>,
  p: Promise<void, unknown>,
  start: bool,
  adopt: bool,
) {
  if (adopt) {
    await velt_rt_microtask();
  }
  try {
    await p;
  } catch (e) {
    await turns(adopt);
    if (start) {
      c.error(e);
    } else {
      c.fail(e);
    }
    return;
  }
  await turns(adopt);
  if (start) {
    c.begun();
  } else {
    c.pulled();
  }
}

// The turns after a settled promise's reaction: one, or two for an adopted promise.
async function turns(adopt: bool) {
  await velt_rt_microtask();
  if (adopt) {
    await velt_rt_microtask();
  }
}

/**
 * `p` (a source's `cancel` result) adopted as Node adopts it (`new Promise((r) => r(p))`): a job
 * queued now attaches to `p`, and `ok` or `bad` runs a microtask after `p`'s reaction (#3695).
 */
export function adopted(p: Promise<void, unknown>, ok: () => void, bad: (e: unknown) => void) {
  queueMicrotask(() => p.then(() => queueMicrotask(ok), (e) => queueMicrotask(() => bad(e))));
}

/** `TypeError: Invalid state: <what>`, Node's message for a stream used in a wrong state. */
export function invalidState(what: string): TypeError {
  return new TypeError(`Invalid state: ${what}`);
}
