// velt/io (internal): WHATWG streams (https://streams.spec.whatwg.org) as in Node 22:
// `ReadableStream` with its default controller and reader. They are globals (https://veltlang.com/docs/std/io/streams/).
//
// A stream's state lives in its controller (`ReadableStreamDefaultController`): the queue of
// chunks, the pending reads, and the flags of the spec's algorithms (`started`, `pulling`,
// `pullAgain`, `closeRequested`). Nothing points back from the controller to the stream or a
// reader, so a stream is freed with its last reference (Velt counts references; a cycle would
// never be freed). The one exception is a `for await` read still waiting: its callbacks in the
// controller hold the iterator until the read settles or the stream closes, errors or is
// cancelled. The source's callbacks run in the spec's order: `start` in the constructor,
// `pull` once `start` has settled (a microtask later) and again while the queue is below its
// high-water mark or a read is waiting, never two at once; a read takes a queued chunk at once.

import { IoError } from "velt/io/error";
import { AbortError } from "velt/task/errors";
import { BYTE_CHUNKS, ByteSource } from "velt/io/streams/byte_source";
import { Uint8Array } from "velt/lang/typed_array/uint8_array";
import { CLOSED, READABLE, ReadableStreamDefaultController } from "velt/io/streams/controller";
import { ReadableStreamDefaultReader } from "velt/io/streams/reader";
import { invalidState } from "velt/io/streams/settle";
import { CancelReason, QueuingStrategy, Reason, UnderlyingSource } from "velt/io/streams/types";
import { INSPECT } from "velt/lang/hooks/keys";

// For the globals' module (std/prelude/global/streams.velt), which imports them from here.

/**
 * A stream of chunks (JS `ReadableStream`): made from a source (`new ReadableStream({ start,
 * pull, cancel })`) or an async iterable (`ReadableStream.from`), and read with a reader
 * (`getReader()`), with `for await`, or as a `Response` body.
 */
export class ReadableStream<R> extends ByteSource {
  private ctl: ReadableStreamDefaultController<R>;

  /**
   * A stream reading from `source`; `strategy.highWaterMark` is how many chunks it queues ahead
   * of the reads (default 1).
   */
  constructor(source: UnderlyingSource<R> = {}, strategy: QueuingStrategy = {}) throws unknown {
    super();
    const hwm = strategy.highWaterMark ?? 1;
    if (!(hwm >= 0)) {
      throw new RangeError(`The property 'strategy.highWaterMark' is invalid. Received ${hwm}`);
    }
    this.ctl = ReadableStreamDefaultController.make<R>(source, hwm);
  }

  /** A stream of the values `src` yields (an async generator, any async iterable). */
  static from<T, E>(src: AsyncIterable<T, E>): ReadableStream<T> {
    const s = new ReadableStream<T>({}, { highWaterMark: 0 });
    s.ctl.iter = relay(src);
    return s;
  }

  // A stream of the chunks of `chunks`, pulled only when read (std only: the `body` of
  // `Response` and `Request`); `used`: the body was read already, so the stream is closed and
  // locked, as in JS.
  private static body<T>(chunks: AsyncIterator<T, Error>, used: bool): ReadableStream<T> {
    const s = new ReadableStream<T>({}, { highWaterMark: 0 });
    s.ctl.bytes = true;
    if (used) {
      s.ctl.finishClose();
      s.ctl.locked = true;
    } else {
      s.ctl.iter = chunks;
    }
    return s;
  }

  /** Whether a reader holds the stream (`getReader()` until `releaseLock()`). */
  get locked(): bool {
    return this.ctl.locked;
  }

  /**
   * Cancels the stream: queued chunks are dropped, the source's `cancel(reason)` runs, and
   * reads get `done`. Rejects with a `TypeError` while a reader holds the stream (cancel
   * through the reader then).
   */
  cancel(reason: CancelReason = null): Promise<void, unknown> {
    if (this.ctl.locked) {
      return Promise.reject<void>(invalidState("ReadableStream is locked"));
    }
    return this.ctl.cancel(reason);
  }

  /** A reader that holds the stream; a `TypeError` when another one does. */
  getReader(): ReadableStreamDefaultReader<R> {
    return new ReadableStreamDefaultReader<R>(this);
  }

  /** `for await (const chunk of stream)`: reads to the end; leaving the loop early cancels the stream. */
  [Symbol.asyncIterator](): AsyncIterator<R, Reason> {
    return new StreamIterator<R>(this.getReader(), this.ctl);
  }

  /**
   * The chunks as a body's bytes (std only: `new Response(stream)`, a request body): each one
   * must be a `Uint8Array` (copied, as a body's bytes are), else the read fails as Node's does.
   */
  [BYTE_CHUNKS](): AsyncIterator<u8[], IoError | AbortError> {
    return new BodyBytes<R>(this);
  }

  /** How `console.log` shows the stream, as Node does. */
  [INSPECT](): string {
    const state =
      this.ctl.state == READABLE ? "readable" : this.ctl.state == CLOSED ? "closed" : "errored";
    return `ReadableStream { locked: ${this.ctl.locked}, state: '${state}', supportsBYOB: ${this.ctl.bytes} }`;
  }
}

// `for await` over a stream, in the steps of Node's iterator (#3711). A `next()` that comes
// while the last one's promise is the current one runs after it has settled, and gives its read's
// promise adopted; a read's result clears the current promise, so the `next()` after it reads at
// once. `return()` cancels, lets the stream go at once, then waits for the cancel (#3717).
class StreamIterator<R> implements AsyncIterator<R, Reason> {
  private reader: ReadableStreamDefaultReader<R>;
  private ctl: ReadableStreamDefaultController<R>;
  private current: Promise<IteratorResult<R>, unknown> | null = null;
  private started: bool = false;
  private done: bool = false;

  constructor(reader: ReadableStreamDefaultReader<R>, ctl: ReadableStreamDefaultController<R>) {
    this.reader = reader;
    this.ctl = ctl;
  }

  next(): Promise<IteratorResult<R>, Reason> {
    if (!this.started) {
      // The first read waits a microtask, as in Node.
      this.current = Promise.resolve<IteratorResult<R>>({ done: true });
      this.started = true;
    }
    const cur = this.current;
    let p: Promise<IteratorResult<R>, unknown>;
    if (cur != null) {
      // Node's `current.then(nextSteps)`: the read runs in the reaction, and its promise is
      // adopted as JS adopts a promise a reaction returns, attached a microtask later.
      p = cur.then((r) => this.nextSteps(), (e) => this.nextSteps());
    } else {
      p = this.nextSteps();
    }
    this.current = p;
    return p;
  }

  // One read, as the spec's read request: its result clears the current promise.
  private nextSteps(): Promise<IteratorResult<R>, unknown> {
    if (this.done) {
      return Promise.resolve<IteratorResult<R>>({ done: true });
    }
    const ctl = this.ctl;
    if (ctl.state == READABLE && ctl.queued() > 0) {
      // A queued chunk answers the read at once, as `readSteps` would, without its callbacks.
      this.current = null;
      return Promise.resolve<IteratorResult<R>>({ value: ctl.take(), done: false });
    }
    const { promise, resolve, reject } = Promise.withResolvers<IteratorResult<R>, unknown>();
    this.ctl.readSteps(
      (r) => {
        this.current = null;
        if (r.done) {
          // The loop has ended: the stream is released, as in JS.
          this.done = true;
          this.reader.releaseLock();
        }
        resolve(r as IteratorResult<R>);
      },
      (e) => {
        this.current = null;
        this.done = true;
        this.reader.releaseLock();
        reject(e);
      },
    );
    return promise;
  }

  return(): Promise<IteratorResult<R>> {
    this.started = true;
    // Node's `current.then(returnSteps)`: after a `next()` still waiting, so its read is
    // answered first; the return is the current promise from then on.
    const cur = this.current;
    let q: Promise<IteratorResult<R>>;
    if (cur != null) {
      q = cur.then((r) => this.returnSteps(), (e) => this.returnSteps());
    } else {
      q = this.returnSteps();
    }
    this.current = q;
    return q;
  }

  // Leaving the loop: the stream is cancelled, let go at once, then the cancel is waited for.
  // Node's `returnSteps` awaits the cancel in an async function; as one `then` it takes Node's
  // turns, where the async form let the code after the loop run a turn early (#3741).
  private returnSteps(): Promise<IteratorResult<R>> {
    if (this.done) {
      return Promise.resolve<IteratorResult<R>>({ done: true });
    }
    this.done = true;
    const cancelled = this.reader.cancel(null);
    this.reader.releaseLock();
    return cancelled.then(
      () => ({ done: true }) as IteratorResult<R>,
      (e) => ({ done: true }) as IteratorResult<R>,
    );
  }
}

// `src`'s values; an error it throws reaches the stream as an `Error` with its text.
async function* relay<T, E>(src: AsyncIterable<T, E>): AsyncGenerator<T, Error> {
  try {
    for await (const x of src) {
      yield x;
    }
  } catch (e) {
    throw new Error(`${e}`);
  }
}

// The chunks of `stream`, read once the body is, as bytes: a `Uint8Array` chunk's range is
// copied, anything else fails as Node fails it; a stream another reader holds, or an error the
// stream gives, reaches the body's reader as an `IoError`. When the body's reader stops early
// (a client gone, a `for await` left), the stream is cancelled, so its source's `cancel` runs,
// as when a JS `Response` body is cancelled.
class BodyBytes<R> implements AsyncIterator<u8[], IoError | AbortError> {
  private stream: ReadableStream<R>;
  private reader: ReadableStreamDefaultReader<R> | null = null;
  private ended: bool = false;

  constructor(stream: ReadableStream<R>) {
    this.stream = stream;
  }

  async next(): Promise<IteratorResult<u8[]>, IoError | AbortError> {
    if (this.ended) {
      return { done: true };
    }
    const reader = this.reader ?? this.open();
    let r: IteratorResult<R>;
    try {
      r = await reader.read();
    } catch (e) {
      this.ended = true;
      throw new IoError("EIO", `${e}`);
    }
    if (r.done) {
      this.ended = true;
      return { done: true };
    }
    const chunk: unknown = r.value;
    if (!(chunk instanceof Uint8Array)) {
      this.ended = true;
      throw new IoError("EINVAL", "Received non-Uint8Array chunk");
    }
    const at = chunk.off as i64;
    return { value: chunk.buf.bytes.slice(at, at + (chunk.len as i64)), done: false };
  }

  private open(): ReadableStreamDefaultReader<R> throws IoError {
    try {
      const reader = this.stream.getReader();
      this.reader = reader;
      return reader;
    } catch (e) {
      this.ended = true;
      throw new IoError("EINVAL", e.message);
    }
  }

  // Also while a `next` waits: a read waiting ends with the cancel.
  async return(): Promise<IteratorResult<u8[]>> {
    if (!this.ended) {
      this.ended = true;
      try {
        const reader = this.reader ?? this.stream.getReader();
        await reader.cancel(null);
      } catch (e) {
        // The body's reader has gone: there is no one to tell.
      }
    }
    return { done: true };
  }
}
