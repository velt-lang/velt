// velt/generate (internal): a type of the model a generator reads (`Type`).

import { EnumMember } from "velt/generate/enum_member";
import { Field } from "velt/generate/field";
import { Method } from "velt/generate/method";

/** One type of the model: what a generator may know about it. */
export class Type {
  id: i64 = 0;
  /**
   * `number`, `boolean`, `string`, `void`, `never`, `symbol`, `literal`, `enum`, `array`,
   * `tuple`, `option`, `union`, `object`, `class`, `struct`, `interface`, `map`, `record`,
   * `set`, `shared`, `date`, `function` (also a function with properties), `generator`, `any`,
   * `unknown`, `promise` or `opaque`.
   */
  kind: string = "";
  /** As messages show it (`User`, `number[]`). */
  display: string = "";
  /** `<module path>::<name>` of a declared type, else "". */
  qualifiedName: string = "";
  /** How generated code writes the type ("" when it cannot be named). */
  spelling: string = "";
  /** `f64`, `i32`, … for numbers. */
  repr: string = "";
  /**
   * Element (`array`, `set`), payload (`option`, `promise`, `shared`), key and value (`map`,
   * `record`), tuple elements or type arguments, by kind.
   */
  args: i64[] = [];
  /** The members of a union, in order. */
  arms: i64[] = [];
  /** Fields of objects, classes and structs, inherited ones first. */
  fields: Field[] = [];
  /** A class's base class (-1: none) and the classes of the program that extend it. */
  base: i64 = -1;
  subclasses: i64[] = [];
  /** Members of an enum. */
  members: EnumMember[] = [];
  /**
   * The value of a literal type as JavaScript source (`"a"`, `1`, `true`); a string is also its
   * JSON text. For an `option`: what it holds when empty (`null`, `undefined` or `null | undefined`).
   */
  literal: string = "";
  /** The methods std's operations call by name (`toJSON`, `toString`, `__inspect`). */
  methods: Method[] = [];
  /**
   * Whether a value of this type may be a typed `Proxy` standing for it (a class or object type
   * in a program that uses `Proxy`): only then does a generator need a path for proxies.
   */
  mayBeProxy: bool = false;
  /** A `function` with properties (`Object.assign(f, { … })`). */
  hasProperties: bool = false;
  /** A class used as a value (`typeof C`: its constructor and statics). */
  classValue: bool = false;
  /**
   * A dynamic type: `any`, `unknown`, and also `object` and `Function` (kind `interface`), whose
   * values say at run time what they hold.
   */
  dynamic: bool = false;
  /**
   * For a std type, or a type of a package with a native library, whose structure the model
   * does not show (`opaque`, `set`): the private field that keeps its state (a runtime
   * handle), else "".
   */
  privateField: string = "";
  /**
   * A struct's or class's constructor when it is not public (`private`, `protected`), else "":
   * code that builds a value without running the constructor (`__construct`) bypasses it.
   */
  ctorAccess: string = "";
  /** Where it is declared, for `Output.error` (-1: nowhere). */
  at: i64 = -1;
}
