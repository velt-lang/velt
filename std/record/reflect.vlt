// velt:record/reflect: what `Reflect` and `Object.getOwnPropertyDescriptor` do to a record's
// symbol keys and accessors (velt:record/symbols). `Reflect`, given a record as an `any`, calls
// the `__anyRec_` functions through `any` (velt_vir `any_builtin.rs`), which reach the record's
// own methods at its value type. Loaded by std/prelude/global/record_reflect.vlt.

import "velt:record/symbols";

/**
 * A property's attributes as `Object.getOwnPropertyDescriptor` gives them for a record (the
 * fields of `PropertyDescriptor`, in the order Node prints them): a data property has `value`
 * and `writable`, an accessor property `get` and `set`.
 */
export type __RecordDescriptor = {
  value?: any;
  writable?: boolean;
  get?: any;
  set?: any;
  enumerable?: boolean;
  configurable?: boolean;
};

extend<K, V> Record<K, V> {
  /** `Object.getOwnPropertyDescriptor(r, key)`: the property `key`, or `undefined`. */
  __descriptor(key: K | symbol): __RecordDescriptor | undefined {
    const a = this.__accessor(key);
    if (a != null) {
      const g = a[0];
      const s = a[1];
      const get: any = g == null ? undefined : g;
      const set: any = s == null ? undefined : s;
      return { get: get, set: set, enumerable: false, configurable: a[2] };
    }
    if (!this.__hasKeyed(key)) {
      return undefined;
    }
    const v: any = this.__getKeyed(key);
    return { value: v, writable: true, enumerable: true, configurable: true };
  }
}

/** `Reflect.get(r, s)` of a record with a symbol `s`. */
export function __anyRec___symGet<V>(r: Record<string, V>, args: any[]): any {
  return r.__getSym(args[0] as symbol);
}

/** `Reflect.set(r, s, v)` of a record with a symbol `s`. */
export function __anyRec___symSet<V>(r: Record<string, V>, args: any[]): any {
  r.__setSym(args[0] as symbol, args[1] as V);
  return true;
}

/** `Reflect.has(r, s)` of a record with a symbol `s`. */
export function __anyRec___symHas<V>(r: Record<string, V>, args: any[]): any {
  return r.__hasSym(args[0] as symbol);
}

/** `Reflect.deleteProperty(r, s)` of a record with a symbol `s`. */
export function __anyRec___symDelete<V>(r: Record<string, V>, args: any[]): any {
  return r.__deleteSym(args[0] as symbol);
}

/** `Reflect.ownKeys(r)` of a record: its string keys, then its symbol keys. */
export function __anyRec___ownKeys<V>(r: Record<string, V>, args: any[]): any {
  return r.__ownKeys();
}

/** `Reflect.getOwnPropertyDescriptor(r, k)` of a record. */
export function __anyRec___descriptor<V>(r: Record<string, V>, args: any[]): any {
  const k = args[0];
  if (typeof k === "symbol") {
    return r.__descriptor(k as symbol);
  }
  return r.__descriptor(`${k}`);
}
