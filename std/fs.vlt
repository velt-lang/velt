// std/fs: file system access over the runtime (docs/internals/contracts/rt_abi_async.md §5).
//
// Every operation has an async form (runs on the runtime's blocking pool) and a `*Sync` form
// (blocks the calling thread). Failures throw `IoError` (from "velt:io") with a Node-style `code`.
// Paths and data are borrowed by the runtime and copied at the call, so the wrappers never copy.
//
// Extern conventions (the lowering ABI of `declare function`, rt_abi_async.md §3.1): `string`/
// struct params are passed as `const T*`; a struct result becomes a trailing out-pointer and the
// runtime function returns nothing.

import { IoResult, IoStatus, unwrapIo, checkIo } from "velt:io";

declare async function velt_rt_fs_read_file(path: string): Promise<IoResult<string>>;
declare async function velt_rt_fs_read_file_bytes(path: string): Promise<IoResult<u8[]>>;
declare async function velt_rt_fs_write_file(path: string, data: string): Promise<IoStatus>;
declare async function velt_rt_fs_append_file(path: string, data: string): Promise<IoStatus>;
declare async function velt_rt_fs_read_dir(path: string): Promise<IoResult<string[]>>;
declare async function velt_rt_fs_stat(path: string): Promise<IoResult<Stats>>;
declare async function velt_rt_fs_mkdir(path: string, recursive: bool): Promise<IoStatus>;
declare async function velt_rt_fs_remove(path: string, recursive: bool): Promise<IoStatus>;
declare async function velt_rt_fs_rename(from: string, to: string): Promise<IoStatus>;
declare async function velt_rt_fs_copy_file(from: string, to: string): Promise<IoStatus>;
declare async function velt_rt_fs_exists(path: string): Promise<bool>;

declare function velt_rt_fs_read_file_sync(path: string): IoResult<string>;
declare function velt_rt_fs_read_file_bytes_sync(path: string): IoResult<u8[]>;
declare function velt_rt_fs_write_file_sync(path: string, data: string): IoStatus;
declare function velt_rt_fs_append_file_sync(path: string, data: string): IoStatus;
declare function velt_rt_fs_read_dir_sync(path: string): IoResult<string[]>;
declare function velt_rt_fs_stat_sync(path: string): IoResult<Stats>;
declare function velt_rt_fs_mkdir_sync(path: string, recursive: bool): IoStatus;
declare function velt_rt_fs_remove_sync(path: string, recursive: bool): IoStatus;
declare function velt_rt_fs_rename_sync(from: string, to: string): IoStatus;
declare function velt_rt_fs_copy_file_sync(from: string, to: string): IoStatus;
declare function velt_rt_fs_exists_sync(path: string): bool;

/**
 * File metadata (follows symlinks). The field order is the runtime's `VeltStat` layout
 * `{ u64 size; f64 mtime_ms; u8 is_file; u8 is_dir }`, so results are used without conversion.
 */
export struct Stats {
  size: u64;
  mtimeMs: f64;
  isFile: bool;
  isDir: bool;
}

export struct MkdirOptions {
  /** Create missing parents; an existing directory is then not an error. */
  recursive?: bool;
}

export struct RemoveOptions {
  /** Remove a directory and everything in it (otherwise only files, symlinks, empty dirs). */
  recursive?: bool;
}

/** Reads a UTF-8 text file (`EILSEQ` if it is not valid UTF-8). */
export async function readFile(path: string): Promise<string> {
  return unwrapIo(await velt_rt_fs_read_file(path));
}

export async function readFileBytes(path: string): Promise<u8[]> {
  return unwrapIo(await velt_rt_fs_read_file_bytes(path));
}

/** Creates or truncates the file. */
export async function writeFile(path: string, data: string): Promise<void> {
  checkIo(await velt_rt_fs_write_file(path, data));
}

/** Appends, creating the file if needed. */
export async function appendFile(path: string, data: string): Promise<void> {
  checkIo(await velt_rt_fs_append_file(path, data));
}

/** Entry names (not paths), sorted. */
export async function readDir(path: string): Promise<string[]> {
  return unwrapIo(await velt_rt_fs_read_dir(path));
}

export async function stat(path: string): Promise<Stats> {
  return unwrapIo(await velt_rt_fs_stat(path));
}

export async function mkdir(path: string, opts: MkdirOptions = {}): Promise<void> {
  checkIo(await velt_rt_fs_mkdir(path, opts.recursive ?? false));
}

export async function remove(path: string, opts: RemoveOptions = {}): Promise<void> {
  checkIo(await velt_rt_fs_remove(path, opts.recursive ?? false));
}

export async function rename(from: string, to: string): Promise<void> {
  checkIo(await velt_rt_fs_rename(from, to));
}

export async function copyFile(from: string, to: string): Promise<void> {
  checkIo(await velt_rt_fs_copy_file(from, to));
}

/** Never throws: any failure to reach `path` reads as `false`. */
export async function exists(path: string): Promise<bool> {
  return await velt_rt_fs_exists(path);
}

export function readFileSync(path: string): string {
  return unwrapIo(velt_rt_fs_read_file_sync(path));
}

export function readFileBytesSync(path: string): u8[] {
  return unwrapIo(velt_rt_fs_read_file_bytes_sync(path));
}

export function writeFileSync(path: string, data: string) {
  checkIo(velt_rt_fs_write_file_sync(path, data));
}

export function appendFileSync(path: string, data: string) {
  checkIo(velt_rt_fs_append_file_sync(path, data));
}

export function readDirSync(path: string): string[] {
  return unwrapIo(velt_rt_fs_read_dir_sync(path));
}

export function statSync(path: string): Stats {
  return unwrapIo(velt_rt_fs_stat_sync(path));
}

export function mkdirSync(path: string, opts: MkdirOptions = {}) {
  checkIo(velt_rt_fs_mkdir_sync(path, opts.recursive ?? false));
}

export function removeSync(path: string, opts: RemoveOptions = {}) {
  checkIo(velt_rt_fs_remove_sync(path, opts.recursive ?? false));
}

export function renameSync(from: string, to: string) {
  checkIo(velt_rt_fs_rename_sync(from, to));
}

export function copyFileSync(from: string, to: string) {
  checkIo(velt_rt_fs_copy_file_sync(from, to));
}

export function existsSync(path: string): bool {
  return velt_rt_fs_exists_sync(path);
}
