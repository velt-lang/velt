// velt/os (internal): the names of Arm's processor parts, for `cpus()` on arm64 Linux, whose
// /proc/cpuinfo gives a "CPU part" number and no model name (cpus_linux.velt). The table is
// libuv's (src/unix/linux.c), so a model reads as it does in Node's `os.cpus()`.

/**
 * Each part number as /proc/cpuinfo writes it, "=", its name and ";" (one string: a module
 * constant can't be an array of strings).
 */
const PARTS: string =
  "0x811=ARM810;0x920=ARM920;0x922=ARM922;0x926=ARM926;0x940=ARM940;0x946=ARM946;" +
  "0x966=ARM966;0xa20=ARM1020;0xa22=ARM1022;0xa26=ARM1026;0xb02=ARM11 MPCore;" +
  "0xb36=ARM1136;0xb56=ARM1156;0xb76=ARM1176;0xc05=Cortex-A5;0xc07=Cortex-A7;" +
  "0xc08=Cortex-A8;0xc09=Cortex-A9;0xc0d=Cortex-A17;0xc0f=Cortex-A15;" +
  "0xc0e=Cortex-A17;0xc14=Cortex-R4;0xc15=Cortex-R5;0xc17=Cortex-R7;" +
  "0xc18=Cortex-R8;0xc20=Cortex-M0;0xc21=Cortex-M1;0xc23=Cortex-M3;0xc24=Cortex-M4;" +
  "0xc27=Cortex-M7;0xc60=Cortex-M0+;0xd01=Cortex-A32;0xd03=Cortex-A53;" +
  "0xd04=Cortex-A35;0xd05=Cortex-A55;0xd06=Cortex-A65;0xd07=Cortex-A57;" +
  "0xd08=Cortex-A72;0xd09=Cortex-A73;0xd0a=Cortex-A75;0xd0b=Cortex-A76;" +
  "0xd0c=Neoverse-N1;0xd0d=Cortex-A77;0xd0e=Cortex-A76AE;0xd13=Cortex-R52;" +
  "0xd20=Cortex-M23;0xd21=Cortex-M33;0xd41=Cortex-A78;0xd42=Cortex-A78AE;" +
  "0xd4a=Neoverse-E1;0xd4b=Cortex-A78C;";

/** The name of the part /proc/cpuinfo calls `part` ("0xd0c" is "Neoverse-N1"), or "unknown". */
export function armPartName(part: string): string {
  const key = `${part}=`;
  let at = PARTS.indexOf(key);
  // A key starts the table or follows a ";".
  while (at > 0 && PARTS.charCodeAt(at - 1) !== 59) {
    at = PARTS.indexOf(key, at + 1);
  }
  if (part.length === 0 || at < 0) {
    return "unknown";
  }
  const from = at + (key.length as i64);
  return PARTS.slice(from, PARTS.indexOf(";", from));
}
