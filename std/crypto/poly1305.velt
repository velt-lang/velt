// velt/crypto (internal): the Poly1305 one-time authenticator (RFC 8439 §2.5) in base 2^64: the
// accumulator is two 64-bit limbs and a small third, each block four 64x64-bit products (`*` and
// `Math.umulh`, one instruction each) and a partial reduction by 2^130 = 5. Constant time: carries
// are comparisons turned into 0 or 1, and the final reduction mod 2^130 - 5 selects with a mask,
// never a branch on the accumulator or the key.

import { CryptoError } from "velt/crypto/errors";
import { u64x2 } from "velt/simd";

// Unchecked: `updatePadded` and `finishInto` check the ranges.
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_load_partial(from: u8[], at: u64, count: u64): u8x16;
declare function velt_simd_u8x16_store(v: u8x16, to: u8[], at: u64);

// The carry out of `sum = a + b` (wrapping): 1 when it wrapped.
function carry(sum: u64, b: u64): u64 {
  return (sum < b) as u64;
}

/**
 * A running Poly1305 MAC: `reset` with a key, `updatePadded` pieces, then `finishInto`;
 * reusable. The limbs are plain fields, so a run of blocks keeps them in registers.
 */
export class Poly1305 {
  // r (clamped) in two limbs, s1 = r1 + r1 / 4 (r1 * 5/4: r1's multiples of 2^130 folded back),
  // h the accumulator (h2 a few bits), pad the key's s half.
  private r0: u64;
  private r1: u64;
  private s1: u64;
  private h0: u64;
  private h1: u64;
  private h2: u64;
  private pad0: u64;
  private pad1: u64;

  /** A MAC under the one-time `key` (32 bytes: r, then s); throws `CryptoError` for another length. */
  constructor(key: u8[]) {
    this.r0 = 0;
    this.r1 = 0;
    this.s1 = 0;
    this.h0 = 0;
    this.h1 = 0;
    this.h2 = 0;
    this.pad0 = 0;
    this.pad1 = 0;
    this.reset(key);
  }

  /** Starts a new MAC under the one-time 32-byte `key`. */
  reset(key: u8[]) {
    if (key.length != 32) {
      throw new CryptoError(`Poly1305 key must be 32 bytes, got ${key.length}`);
    }
    const r = velt_simd_u8x16_load(key, 0).asU64x2();
    const s = velt_simd_u8x16_load(key, 16).asU64x2();
    this.r0 = r.lane(0) & 0x0ffffffc0fffffff;
    this.r1 = r.lane(1) & 0x0ffffffc0ffffffc;
    this.s1 = this.r1 + (this.r1 >> 2);
    this.pad0 = s.lane(0);
    this.pad1 = s.lane(1);
    this.h0 = 0;
    this.h1 = 0;
    this.h2 = 0;
  }

  // The 16-byte blocks at `m[start..end]`, the last one zero-padded, each with the 2^128 marker.
  // h stays below 2^130 + a little: h2 is at most 4 after each block.
  private blocks(m: u8[], start: usize, end: usize) {
    const r0 = this.r0;
    const r1 = this.r1;
    const s1 = this.s1;
    let h0 = this.h0;
    let h1 = this.h1;
    let h2 = this.h2;
    let off = start;
    while (off < end) {
      const left = end - off;
      const w = (
        left >= 16
          ? velt_simd_u8x16_load(m, off as u64)
          : velt_simd_u8x16_load_partial(m, off as u64, left as u64)
      ).asU64x2();
      // h += m + 2^128.
      const m0 = w.lane(0);
      const m1 = w.lane(1);
      h0 += m0;
      let c = carry(h0, m0);
      h1 += c;
      let c1 = carry(h1, c);
      h1 += m1;
      c1 += carry(h1, m1);
      h2 += c1 + 1;
      // d = h * r, with the parts at 2^130 and above folded back times 5 (s1, and below).
      let d0 = h0 * r0;
      let d0h = Math.umulh(h0, r0);
      let x = h1 * s1;
      d0 += x;
      d0h += Math.umulh(h1, s1) + carry(d0, x);
      let d1 = h0 * r1;
      let d1h = Math.umulh(h0, r1);
      x = h1 * r0;
      d1 += x;
      d1h += Math.umulh(h1, r0) + carry(d1, x);
      x = h2 * s1;
      d1 += x;
      d1h += carry(d1, x);
      h2 = h2 * r0;
      h0 = d0;
      d1 += d0h;
      d1h += carry(d1, d0h);
      h1 = d1;
      h2 += d1h;
      // The bits at 2^130 and above, times 5, back into the bottom.
      c = (h2 >> 2) + (h2 & ~(3 as u64));
      h2 &= 3;
      h0 += c;
      c = carry(h0, c);
      h1 += c;
      h2 += carry(h1, c);
      off += left < 16 ? left : 16;
    }
    this.h0 = h0;
    this.h1 = h1;
    this.h2 = h2;
  }

  /** Absorbs `m[start..end]`, zero-padded to whole 16-byte blocks (as the AEAD's padding). */
  updatePadded(m: u8[], start: usize, end: usize) {
    if (start > end || end > m.length) {
      throw new CryptoError(`Poly1305 range ${start}..${end} is outside 0..${m.length}`);
    }
    this.blocks(m, start, end);
  }

  /** The 16-byte tag (h fully reduced mod 2^130 - 5, plus s, mod 2^128) into `out[at..at + 16]`. */
  finishInto(out: u8[], at: usize) {
    if (at > out.length || out.length - at < 16) {
      throw new CryptoError(`Poly1305 tag at ${at} does not fit in ${out.length} bytes`);
    }
    const h0 = this.h0;
    const h1 = this.h1;
    // g = h + 5: it reaches 2^130 exactly when h >= p = 2^130 - 5, and then h mod p is g's low bits.
    const g0 = h0 + 5;
    let c = carry(g0, 5);
    const g1 = h1 + c;
    c = carry(g1, c);
    const g2 = this.h2 + c;
    // All ones when g reached 2^130 (bit 130 set).
    const mask = (0 as u64) - (g2 >> 2);
    const keep = ~mask;
    let t0 = (h0 & keep) | (g0 & mask);
    let t1 = (h1 & keep) | (g1 & mask);
    t0 += this.pad0;
    c = carry(t0, this.pad0);
    t1 += this.pad1 + c;
    const tag = u64x2.splat(t0).withLane(1, t1).asU8x16();
    velt_simd_u8x16_store(tag, out, at as u64);
  }
}
