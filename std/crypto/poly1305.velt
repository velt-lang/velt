// velt/crypto (internal): the Poly1305 one-time authenticator (RFC 8439 §2.5), with the
// accumulator in two 64-bit limbs and a few bits (h0 + 2^64 h1 + 2^128 h2) and r in two limbs:
// each block is four 64x64-bit products (`*` and `Math.umulh`) summed with branch-free carries
// (`(s < a) as u64`), the limbs in locals for the whole run of blocks. Constant time: no branch
// or index depends on the accumulator, the key or the message; the final reduction mod
// 2^130 - 5 selects with a mask.

import { CryptoError } from "velt/crypto/errors";

// Declared directly: `velt/simd` is the API, and loading all of it costs a program that only needs
// this file's AEAD a fifth more compile time. The loads are unchecked: `blocks` checks the range,
// `reset` the key's length.
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_as_u64x2(v: u8x16): u64x2;
declare function velt_simd_u64x2_lane(v: u64x2, index: u64): u64;
// The last partial block (`count` under 16) and the tag, unchecked: the callers check the ranges.
declare function velt_simd_u8x16_load_partial(from: u8[], at: u64, count: u64): u8x16;
declare function velt_simd_u8x16_store(v: u8x16, to: u8[], at: u64);
declare function velt_simd_u64x2_splat(x: u64): u64x2;
declare function velt_simd_u64x2_with_lane(v: u64x2, index: u64, x: u64): u64x2;
declare function velt_simd_u64x2_as_u8x16(v: u64x2): u8x16;

// r's clamp (RFC 8439 §2.5.1) on its two little-endian 64-bit halves.
const CLAMP0: u64 = 0x0ffffffc0fffffff;
const CLAMP1: u64 = 0x0ffffffc0ffffffc;
const NOT3: u64 = 0xfffffffffffffffc;

/**
 * A running Poly1305 MAC: `reset` with a key, `updatePadded` pieces, then `finishInto`;
 * reusable.
 */
export class Poly1305 {
  // r, the accumulator h and the key's s half (`pad`) as plain fields: no bounds checks, and a
  // MAC object with fewer parts.
  private r0: u64;
  private r1: u64;
  private h0: u64;
  private h1: u64;
  private h2: u64;
  private pad0: u64;
  private pad1: u64;
  private tail: u8[];

  /** A MAC under the one-time `key` (32 bytes: r, then s); throws `CryptoError` for another length. */
  constructor(key: u8[]) {
    this.r0 = 0;
    this.r1 = 0;
    this.h0 = 0;
    this.h1 = 0;
    this.h2 = 0;
    this.pad0 = 0;
    this.pad1 = 0;
    this.tail = Buffer.alloc(16);
    this.reset(key);
  }

  /** Starts a new MAC under the one-time 32-byte `key`. */
  reset(key: u8[]) {
    if (key.length != 32) {
      throw new CryptoError(`Poly1305 key must be 32 bytes, got ${key.length}`);
    }
    const r = velt_simd_u8x16_as_u64x2(velt_simd_u8x16_load(key, 0));
    const s = velt_simd_u8x16_as_u64x2(velt_simd_u8x16_load(key, 16));
    this.r0 = velt_simd_u64x2_lane(r, 0) & CLAMP0;
    this.r1 = velt_simd_u64x2_lane(r, 1) & CLAMP1;
    this.pad0 = velt_simd_u64x2_lane(s, 0);
    this.pad1 = velt_simd_u64x2_lane(s, 1);
    this.h0 = 0;
    this.h1 = 0;
    this.h2 = 0;
  }

  // The 16-byte blocks of `m[start..end]` (a whole number of them), each with the 2^128 marker.
  private blocks(m: u8[], start: usize, end: usize) {
    if (end > m.length) {
      throw new CryptoError(`Poly1305 range is out of bounds: end ${end}, length ${m.length}`);
    }
    const r0 = this.r0;
    const r1 = this.r1;
    // r1's low two bits are clear, so 2^128 r1 = 5 r1 / 4 (mod 2^130 - 5) is r1 + r1 / 4.
    const s1 = r1 + (r1 >> 2);
    let h0 = this.h0;
    let h1 = this.h1;
    let h2 = this.h2;
    let off = start;
    while (off < end) {
      const w = velt_simd_u8x16_as_u64x2(velt_simd_u8x16_load(m, off as u64));
      // h += the block, 2^128 included.
      const m0 = velt_simd_u64x2_lane(w, 0);
      const m1 = velt_simd_u64x2_lane(w, 1);
      h0 = h0 + m0;
      const c0 = (h0 < m0) as u64;
      const t1 = h1 + m1;
      const c1 = (t1 < m1) as u64;
      h1 = t1 + c0;
      h2 = h2 + c1 + ((h1 < c0) as u64) + 1;
      // h *= r, as d0 + 2^64 d1 + 2^128 d2 with 2^128 folded in by s1 (h2 is a few bits).
      const a = h0 * r0;
      const b = h1 * s1;
      const d0 = a + b;
      const d0h = Math.umulh(h0, r0) + Math.umulh(h1, s1) + ((d0 < a) as u64);
      const e = h0 * r1;
      const f = h1 * r0;
      const g = h2 * s1;
      const ef = e + f;
      const efg = ef + g;
      const d1 = efg + d0h;
      const d1h =
        Math.umulh(h0, r1) +
        Math.umulh(h1, r0) +
        ((ef < e) as u64) +
        ((efg < g) as u64) +
        ((d1 < d0h) as u64);
      const d2 = h2 * r0 + d1h;
      // The bits from 2^130 up, times 5 (2^130 = 5), back into the bottom.
      const c = (d2 >> 2) + (d2 & NOT3);
      h0 = d0 + c;
      const k0 = (h0 < c) as u64;
      h1 = d1 + k0;
      h2 = (d2 & 3) + ((h1 < k0) as u64);
      off += 16;
    }
    this.h0 = h0;
    this.h1 = h1;
    this.h2 = h2;
  }

  /** Absorbs `m[start..end]`, zero-padded to whole 16-byte blocks (as the AEAD's padding). */
  updatePadded(m: u8[], start: usize, end: usize) {
    const full = start + ((end - start) & ~(15 as usize));
    this.blocks(m, start, full);
    if (full < end) {
      // The last bytes, zero-padded, in one partial load (`blocks` checked `full`, this `end`).
      if (end > m.length) {
        throw new CryptoError(`Poly1305 range is out of bounds: end ${end}, length ${m.length}`);
      }
      const last = this.tail;
      velt_simd_u8x16_store(
        velt_simd_u8x16_load_partial(m, full as u64, (end - full) as u64),
        last,
        0,
      );
      this.blocks(last, 0, 16);
    }
  }

  /** The 16-byte tag (h fully reduced mod 2^130 - 5, plus s, mod 2^128) into `out[at..at + 16]`. */
  finishInto(out: u8[], at: usize) {
    let h0 = this.h0;
    let h1 = this.h1;
    const h2 = this.h2;
    // g = h + 5: it reaches 2^130 exactly when h >= p, and then h - p is g's low 128 bits.
    const g0 = h0 + 5;
    const c0 = (g0 < 5) as u64;
    const g1 = h1 + c0;
    const g2 = h2 + ((g1 < c0) as u64);
    const mask = 0 - (g2 >> 2);
    h0 = (h0 & ~mask) | (g0 & mask);
    h1 = (h1 & ~mask) | (g1 & mask);
    const f0 = h0 + this.pad0;
    const f1 = h1 + this.pad1 + ((f0 < h0) as u64);
    if (at > out.length || out.length - at < 16) {
      throw new CryptoError(`Poly1305 tag at ${at} does not fit in ${out.length} bytes`);
    }
    const tag = velt_simd_u64x2_with_lane(velt_simd_u64x2_splat(f0), 1, f1);
    velt_simd_u8x16_store(velt_simd_u64x2_as_u8x16(tag), out, at as u64);
  }
}
