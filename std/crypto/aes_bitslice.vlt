// velt/crypto (internal): bitsliced AES (BearSSL's `aes_ct64` layout, by Thomas Pornin): four
// blocks spread over eight `u64` words, word i holding bit i of every byte. The S-box is the
// Boyar-Peralta circuit (boolean gates on whole words), so nothing indexes a table and the
// time never depends on the key or the data. `velt/simd` has no AES instructions yet (#2392).

/** Swaps the bits of `q[i]` selected by `lo` with those of `q[j]` selected by `lo << s`. */
function swapBits(q: u64[], i: usize, j: usize, lo: u64, s: u64) {
  const a = q[i];
  const b = q[j];
  q[i] = (a & lo) | ((b & lo) << s);
  q[j] = ((a >> s) & lo) | (b & (lo << s));
}

/** The bit transposition between "four interleaved blocks" and "bit planes" (its own inverse). */
export function ortho(q: u64[]) {
  const m1: u64 = 0x5555555555555555;
  const m2: u64 = 0x3333333333333333;
  const m4: u64 = 0x0f0f0f0f0f0f0f0f;
  swapBits(q, 0, 1, m1, 1);
  swapBits(q, 2, 3, m1, 1);
  swapBits(q, 4, 5, m1, 1);
  swapBits(q, 6, 7, m1, 1);
  swapBits(q, 0, 2, m2, 2);
  swapBits(q, 1, 3, m2, 2);
  swapBits(q, 4, 6, m2, 2);
  swapBits(q, 5, 7, m2, 2);
  swapBits(q, 0, 4, m4, 4);
  swapBits(q, 1, 5, m4, 4);
  swapBits(q, 2, 6, m4, 4);
  swapBits(q, 3, 7, m4, 4);
}

// Spreads the 16 bits of each 32-bit half apart so another word's bytes can sit in between.
function spread(x: u64): u64 {
  let y = x | (x << 16);
  y &= 0x0000ffff0000ffff;
  y |= y << 8;
  return y & 0x00ff00ff00ff00ff;
}

/** Block `w` (four little-endian words) into `q[i]` and `q[i + 4]`, interleaved. */
export function interleaveIn(q: u64[], i: usize, w0: u32, w1: u32, w2: u32, w3: u32) {
  const x0 = spread(w0 as u64);
  const x1 = spread(w1 as u64);
  const x2 = spread(w2 as u64);
  const x3 = spread(w3 as u64);
  q[i] = x0 | (x2 << 8);
  q[i + 4] = x1 | (x3 << 8);
}

// The inverse of `spread`.
function gather(x: u64): u32 {
  let y = x & 0x00ff00ff00ff00ff;
  y |= y >> 8;
  y &= 0x0000ffff0000ffff;
  return (y as u32) | ((y >> 16) as u32);
}

/** Word `k` (0..3, little-endian) of the block in `q0` / `q1`, as `interleaveIn` put it. */
export function interleaveOut(q0: u64, q1: u64, k: usize): u32 {
  if (k == 0) {
    return gather(q0);
  }
  if (k == 1) {
    return gather(q1);
  }
  if (k == 2) {
    return gather(q0 >> 8);
  }
  return gather(q1 >> 8);
}

/** The AES S-box on all 32 bytes at once: Boyar and Peralta's 113-gate circuit. */
export function sbox(q: u64[]) {
  const x0 = q[7];
  const x1 = q[6];
  const x2 = q[5];
  const x3 = q[4];
  const x4 = q[3];
  const x5 = q[2];
  const x6 = q[1];
  const x7 = q[0];
  // Top linear transformation.
  const y14 = x3 ^ x5;
  const y13 = x0 ^ x6;
  const y9 = x0 ^ x3;
  const y8 = x0 ^ x5;
  const t0 = x1 ^ x2;
  const y1 = t0 ^ x7;
  const y4 = y1 ^ x3;
  const y12 = y13 ^ y14;
  const y2 = y1 ^ x0;
  const y5 = y1 ^ x6;
  const y3 = y5 ^ y8;
  const t1 = x4 ^ y12;
  const y15 = t1 ^ x5;
  const y20 = t1 ^ x1;
  const y6 = y15 ^ x7;
  const y10 = y15 ^ t0;
  const y11 = y20 ^ y9;
  const y7 = x7 ^ y11;
  const y17 = y10 ^ y11;
  const y19 = y10 ^ y8;
  const y16 = t0 ^ y11;
  const y21 = y13 ^ y16;
  const y18 = x0 ^ y16;
  // Non-linear section.
  const t2 = y12 & y15;
  const t3 = y3 & y6;
  const t4 = t3 ^ t2;
  const t5 = y4 & x7;
  const t6 = t5 ^ t2;
  const t7 = y13 & y16;
  const t8 = y5 & y1;
  const t9 = t8 ^ t7;
  const t10 = y2 & y7;
  const t11 = t10 ^ t7;
  const t12 = y9 & y11;
  const t13 = y14 & y17;
  const t14 = t13 ^ t12;
  const t15 = y8 & y10;
  const t16 = t15 ^ t12;
  const t17 = t4 ^ t14;
  const t18 = t6 ^ t16;
  const t19 = t9 ^ t14;
  const t20 = t11 ^ t16;
  const t21 = t17 ^ y20;
  const t22 = t18 ^ y19;
  const t23 = t19 ^ y21;
  const t24 = t20 ^ y18;
  const t25 = t21 ^ t22;
  const t26 = t21 & t23;
  const t27 = t24 ^ t26;
  const t28 = t25 & t27;
  const t29 = t28 ^ t22;
  const t30 = t23 ^ t24;
  const t31 = t22 ^ t26;
  const t32 = t31 & t30;
  const t33 = t32 ^ t24;
  const t34 = t23 ^ t33;
  const t35 = t27 ^ t33;
  const t36 = t24 & t35;
  const t37 = t36 ^ t34;
  const t38 = t27 ^ t36;
  const t39 = t29 & t38;
  const t40 = t25 ^ t39;
  const t41 = t40 ^ t37;
  const t42 = t29 ^ t33;
  const t43 = t29 ^ t40;
  const t44 = t33 ^ t37;
  const t45 = t42 ^ t41;
  const z0 = t44 & y15;
  const z1 = t37 & y6;
  const z2 = t33 & x7;
  const z3 = t43 & y16;
  const z4 = t40 & y1;
  const z5 = t29 & y7;
  const z6 = t42 & y11;
  const z7 = t45 & y17;
  const z8 = t41 & y10;
  const z9 = t44 & y12;
  const z10 = t37 & y3;
  const z11 = t33 & y4;
  const z12 = t43 & y13;
  const z13 = t40 & y5;
  const z14 = t29 & y2;
  const z15 = t42 & y9;
  const z16 = t45 & y14;
  const z17 = t41 & y8;
  // Bottom linear transformation.
  const t46 = z15 ^ z16;
  const t47 = z10 ^ z11;
  const t48 = z5 ^ z13;
  const t49 = z9 ^ z10;
  const t50 = z2 ^ z12;
  const t51 = z2 ^ z5;
  const t52 = z7 ^ z8;
  const t53 = z0 ^ z3;
  const t54 = z6 ^ z7;
  const t55 = z16 ^ z17;
  const t56 = z12 ^ t48;
  const t57 = t50 ^ t53;
  const t58 = z4 ^ t46;
  const t59 = z3 ^ t54;
  const t60 = t46 ^ t57;
  const t61 = z14 ^ t57;
  const t62 = t52 ^ t58;
  const t63 = t49 ^ t58;
  const t64 = z4 ^ t59;
  const t65 = t61 ^ t62;
  const t66 = z1 ^ t63;
  const s0 = t59 ^ t63;
  const s6 = t56 ^ ~t62;
  const s7 = t48 ^ ~t60;
  const t67 = t64 ^ t65;
  const s3 = t53 ^ t66;
  const s4 = t51 ^ t66;
  const s5 = t47 ^ t65;
  const s1 = t64 ^ ~s3;
  const s2 = t55 ^ ~t67;
  q[7] = s0;
  q[6] = s1;
  q[5] = s2;
  q[4] = s3;
  q[3] = s4;
  q[2] = s5;
  q[1] = s6;
  q[0] = s7;
}

/** ShiftRows on all four blocks: a fixed permutation of the bits of each plane. */
export function shiftRows(q: u64[]) {
  for (let i: usize = 0; i < 8; i++) {
    const x = q[i];
    q[i] =
      (x & 0x000000000000ffff) |
      ((x & 0x00000000fff00000) >> 4) |
      ((x & 0x00000000000f0000) << 12) |
      ((x & 0x0000ff0000000000) >> 8) |
      ((x & 0x000000ff00000000) << 8) |
      ((x & 0xf000000000000000) >> 12) |
      ((x & 0x0fff000000000000) << 4);
  }
}

function rot32(x: u64): u64 {
  return (x << 32) | (x >> 32);
}

function rot16(x: u64): u64 {
  return (x >> 16) | (x << 48);
}

/** MixColumns on all four blocks (multiplication by x is a shift of planes plus 0x1b's taps). */
export function mixColumns(q: u64[]) {
  const q0 = q[0];
  const q1 = q[1];
  const q2 = q[2];
  const q3 = q[3];
  const q4 = q[4];
  const q5 = q[5];
  const q6 = q[6];
  const q7 = q[7];
  const r0 = rot16(q0);
  const r1 = rot16(q1);
  const r2 = rot16(q2);
  const r3 = rot16(q3);
  const r4 = rot16(q4);
  const r5 = rot16(q5);
  const r6 = rot16(q6);
  const r7 = rot16(q7);
  q[0] = q7 ^ r7 ^ r0 ^ rot32(q0 ^ r0);
  q[1] = q0 ^ r0 ^ q7 ^ r7 ^ r1 ^ rot32(q1 ^ r1);
  q[2] = q1 ^ r1 ^ r2 ^ rot32(q2 ^ r2);
  q[3] = q2 ^ r2 ^ q7 ^ r7 ^ r3 ^ rot32(q3 ^ r3);
  q[4] = q3 ^ r3 ^ q7 ^ r7 ^ r4 ^ rot32(q4 ^ r4);
  q[5] = q4 ^ r4 ^ r5 ^ rot32(q5 ^ r5);
  q[6] = q5 ^ r5 ^ r6 ^ rot32(q6 ^ r6);
  q[7] = q6 ^ r6 ^ r7 ^ rot32(q7 ^ r7);
}
