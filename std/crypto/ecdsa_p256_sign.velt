// velt/crypto (internal): ECDSA signing on P-256 (SEC 1 §4.1.3, FIPS 186-5) with the nonce of
// RFC 6979 (deterministic, HMAC-SHA256), for a TLS server's CertificateVerify (#2392 step 4).
// Constant time in the private key and the nonce: the nonce comes from HMAC, R = kG is
// `p256PublicKey`'s fixed-window multiplication, and the arithmetic mod n is `ScalarP256`'s masked
// Montgomery products and additions with an inversion over the public exponent n - 2. Only the
// digest and the signature are public, and the loop that retries a nonce out of range (with odds
// of about 2^-32) branches on public facts.

import { CryptoError } from "velt/crypto/errors";
import { hmacSha256 } from "velt/crypto/hmac";
import { p256PublicKey, p256ScalarOk } from "velt/crypto/p256";
import { ScalarP256 } from "velt/crypto/scalar_p256";

// The group order n, big-endian bytes.
const N: u8[] = [
  0xff,
  0xff,
  0xff,
  0xff,
  0x00,
  0x00,
  0x00,
  0x00,
  0xff,
  0xff,
  0xff,
  0xff,
  0xff,
  0xff,
  0xff,
  0xff,
  0xbc,
  0xe6,
  0xfa,
  0xad,
  0xa7,
  0x17,
  0x9e,
  0x84,
  0xf3,
  0xb9,
  0xca,
  0xc2,
  0xfc,
  0x63,
  0x25,
  0x51,
];

// Scalar registers.
const S_E: usize = 0;
const S_R: usize = 1;
const S_D: usize = 2;
const S_K: usize = 3;
const S_TMP: usize = 4;

/**
 * The P-256 ECDSA signature (DER, RFC 3279's ECDSA-Sig-Value) of `digest` (a SHA-256 hash: its
 * leftmost 256 bits are used) by the private key `privateKey` (32 big-endian bytes in
 * [1, n - 1]). The nonce is RFC 6979's, so the same key and digest give the same signature.
 * Throws `CryptoError` for a bad key.
 */
export function p256Sign(privateKey: u8[], digest: u8[]): u8[] {
  if (!p256ScalarOk(privateKey)) {
    throw new CryptoError("P-256 needs a 32-byte private key between 1 and n - 1");
  }
  const h = digestOctets(digest);
  const s = new ScalarP256(5);
  s.decode(S_E, h, 0, 32, S_TMP);
  s.decode(S_D, privateKey, 0, 32, S_TMP);
  // RFC 6979 §3.2 b..g.
  let v = Buffer.alloc(32);
  for (let i: usize = 0; i < 32; i++) {
    v[i] = 1;
  }
  let k = Buffer.alloc(32);
  k = hmacSha256(k, joined(v, 0, privateKey, h));
  v = hmacSha256(k, v);
  k = hmacSha256(k, joined(v, 1, privateKey, h));
  v = hmacSha256(k, v);
  while (true) {
    // §3.2 h: qlen = hlen = 256, so one HMAC gives a candidate.
    v = hmacSha256(k, v);
    if (p256ScalarOk(v)) {
      const sig = signWith(s, v);
      if (sig.length > 0) {
        return sig;
      }
    }
    const next: u8[] = v.slice();
    next.push(0);
    k = hmacSha256(k, next);
    v = hmacSha256(k, v);
  }
}

// The signature with the nonce `nonce` (valid: 0 < nonce < n), or [] when r or s is zero.
function signWith(s: ScalarP256, nonce: u8[]): u8[] {
  const point = p256PublicKey(nonce);
  // r = x(kG) mod n (x is below p < 2n, and decode reduces once).
  s.decode(S_R, point, 1, 32, S_TMP);
  if (s.isZero(S_R)) {
    return [];
  }
  // s = (e + r d) / k.
  s.decode(S_K, nonce, 0, 32, S_TMP);
  s.invert(S_TMP, S_K);
  s.mul(S_K, S_R, S_D);
  s.add(S_K, S_K, S_E);
  s.mul(S_K, S_K, S_TMP);
  if (s.isZero(S_K)) {
    return [];
  }
  return derSignature(s.limbs(S_R, S_TMP), s.limbs(S_K, S_TMP));
}

// bits2octets(digest) (RFC 6979 §2.3.4): its leftmost 256 bits as a number mod n, 32 bytes.
// The digest is public.
function digestOctets(digest: u8[]): u8[] {
  const h = Buffer.alloc(32);
  const len = digest.length < 32 ? digest.length : 32;
  for (let i: usize = 0; i < len; i++) {
    h[32 - len + i] = digest[i];
  }
  let below = false;
  for (let i: usize = 0; i < 32; i++) {
    if (h[i] != N[i]) {
      below = h[i] < N[i];
      break;
    }
  }
  if (!below) {
    let borrow: i32 = 0;
    for (let i: usize = 0; i < 32; i++) {
      const j = 31 - i;
      const d = (h[j] as i32) - (N[j] as i32) - borrow;
      borrow = d < 0 ? 1 : 0;
      h[j] = (d & 0xff) as u8;
    }
  }
  return h;
}

// V || sep || x || h, the input of RFC 6979's K updates.
function joined(v: u8[], sep: u8, x: u8[], h: u8[]): u8[] {
  const out = Buffer.alloc(97);
  for (let i: usize = 0; i < 32; i++) {
    out[i] = v[i];
    out[33 + i] = x[i];
    out[65 + i] = h[i];
  }
  out[32] = sep;
  return out;
}

// The DER SEQUENCE of the INTEGERs r and s, given as little-endian 64-bit limbs.
function derSignature(r: u64[], s: u64[]): u8[] {
  const ri = derInteger(r);
  const si = derInteger(s);
  const out: u8[] = [0x30, (ri.length + si.length) as u8];
  for (const b of ri) {
    out.push(b);
  }
  for (const b of si) {
    out.push(b);
  }
  return out;
}

// A minimal positive DER INTEGER of the little-endian limbs `x` (not zero).
function derInteger(x: u64[]): u8[] {
  const be = Buffer.alloc(32);
  for (let i: usize = 0; i < 32; i++) {
    const limb = x[3 - (i >> 3)];
    be[i] = ((limb >> ((56 - 8 * (i & 7)) as u64)) & 0xff) as u8;
  }
  let start: usize = 0;
  while (start < 31 && be[start] == 0) {
    start++;
  }
  const out: u8[] = [0x02, 0];
  if ((be[start] & 0x80) != 0) {
    out.push(0);
  }
  for (let i = start; i < 32; i++) {
    out.push(be[i]);
  }
  out[1] = (out.length - 2) as u8;
  return out;
}
