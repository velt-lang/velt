// velt/crypto (internal): what both AEADs do with their tags and buffers: compare a computed
// tag with the one in a buffer in constant time, and copy data into a buffer with room for it.

/** Whether `tag[0..16]` equals `buf[at..at + 16]`, in time independent of where they differ. */
export function tagMatches(tag: u8[], buf: u8[], at: usize): bool {
  let diff: u8 = 0;
  for (let i: usize = 0; i < 16; i++) {
    diff |= tag[i] ^ buf[at + i];
  }
  return diff == 0;
}

/** `data` followed by `extra` bytes of room (zeros), for in-place sealing of a copy. */
export function withRoom(data: u8[], extra: usize): u8[] {
  const out = Buffer.alloc(data.length + extra);
  for (let i: usize = 0; i < data.length; i++) {
    out[i] = data[i];
  }
  return out;
}
