    ],
  ];
}

describe("p384Sign", () => {
  it("gives RFC 6979's signatures for SHA-384", () => {
    const key = hexDecode(KEY);
    expect(hexEncode(p384PublicKey(key))).toBe(PUBLIC);
    expect(hexEncode(p384Sign(key, sha384(utf8Encode("sample"))))).toBe(SAMPLE_SIG);
    expect(hexEncode(p384Sign(key, sha384(utf8Encode("test"))))).toBe(TEST_SIG);
  });

  it("gives the signatures computed independently, which verify", () => {
    for (const c of computed()) {
      const key = hexDecode(c[0]);
      const digest = c[1] == "-" ? [] : hexDecode(c[1]);
      const sig = p384Sign(key, digest);
      expect(hexEncode(sig)).toBe(c[2]);
      expect(p384Verify(p384PublicKey(key), digest, sig)).toBe(true);
    }
  });

  it("signs what p384Verify accepts, and nothing else verifies", () => {
    for (let i = 0; i < 6; i++) {
      const key = p384PrivateKey();
      const digest = sha384(utf8Encode(`message ${i}`));
      const sig = p384Sign(key, digest);
      expect(p384Verify(p384PublicKey(key), digest, sig)).toBe(true);
      const other = sha384(utf8Encode(`message ${i + 1}`));
      expect(p384Verify(p384PublicKey(key), other, sig)).toBe(false);
      expect(p384Verify(p384PublicKey(p384PrivateKey()), digest, sig)).toBe(false);
    }
  });

  it("uses the leftmost 384 bits of a longer digest", () => {
    const key = hexDecode(KEY);
    const digest = sha384(utf8Encode("sample"));
    const longer = digest.concat([1, 2, 3, 4]);
    expect(hexEncode(p384Sign(key, longer))).toBe(SAMPLE_SIG);
  });

  it("refuses a key out of range", () => {
    const n =
      "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973";
    for (const k of ["00".repeat(48), n, "ff".repeat(48), "01".repeat(47), "01".repeat(49), ""]) {
      expect(() => p384Sign(hexDecode(k), Buffer.alloc(48))).toThrow(
        "P-384 needs a 48-byte private key between 1 and n - 1",
      );
    }
  });
});
