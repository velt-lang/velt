// velt/crypto (tests): the probe of scripts/ct-counts.py for Ed25519 signing, which no program
// can import: the public key and a signature for the 32-byte seed in the file $VELT_CT_SECRET
// names (a fixed seed without it, so that this also runs with the other tests). The seed is
// read as bytes and nothing here branches on it.
import { ed25519PublicKey, ed25519Sign } from "velt/crypto/ed25519_sign";
import { x25519PublicKey } from "velt/crypto/x25519";
import { readFileBytesSync } from "velt/fs";
import { describe, expect, it } from "velt/test";

describe("the Ed25519 probe", () => {
  it("signs with the seed it is given", () => {
    const path = process.env.VELT_CT_SECRET;
    let seed = Buffer.alloc(32);
    if (path != null) {
      seed = readFileBytesSync(path);
    }
    const message = Buffer.alloc(37);
    const pub = ed25519PublicKey(seed);
    const signature = ed25519Sign(seed, pub, message);
    // X25519's public key shares the multiplication: in one program with the signer, as here.
    const other = x25519PublicKey(seed);
    // The end of what ct-counts.py counts (scripts/ct-shim.c).
    const stop = process.env.VELT_CT_STOP;
    if (stop != null) {
      readFileBytesSync(stop);
    }
    // Nothing is done with the results that depends on their value: memcheck, with the seed
    // marked undefined, would report it (scripts/ct-counts.py --memcheck).
    expect(signature.length + pub.length + other.length).toBe(128);
  });
});
