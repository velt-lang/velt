// velt/crypto (internal): secure random bytes and integers from the OS generator.

import { CryptoError } from "velt/crypto/errors";
import { velt_rt_random_bytes, velt_rt_random_u64 } from "velt/crypto/rt";
import { received } from "velt/lang/bytes/text";

/** `n` cryptographically secure random bytes (OS generator). */
export function randomBytes(n: usize): u8[] {
  return velt_rt_random_bytes(n as u64);
}

// The largest integer a JS number holds exactly (`Number.MAX_SAFE_INTEGER`).
const MAX_SAFE_INTEGER: i64 = 9007199254740991;

// The largest `max - min` Node's `randomInt` accepts (2^48 - 1).
const RANDOM_INT_RANGE: i64 = 281474976710655;

/**
 * A uniformly distributed secure random integer in [min, max) (Node's `crypto.randomInt`);
 * rejection sampling avoids modulo bias. Throws `CryptoError`, with Node's messages, when `min`
 * or `max` is not a safe integer, `max <= min`, or `max - min` is 2^48 or more.
 */
export function randomInt(min: i64, max: i64): i64 {
  checkSafeInteger("min", min);
  checkSafeInteger("max", max);
  if (max <= min) {
    throw new CryptoError(
      `The value of "max" is out of range. It must be greater than the value of "min" (${min}). Received ${received(max as number)}`,
    );
  }
  if (max - min > RANDOM_INT_RANGE) {
    throw new CryptoError(
      `The value of "max - min" is out of range. It must be <= ${RANDOM_INT_RANGE}. Received ${received((max - min) as number)}`,
    );
  }
  const range = (max - min) as u64;
  // 2^64 mod range: draws below it would make the low residues more likely.
  const reject = (0 - range) % range;
  while (true) {
    const r = velt_rt_random_u64();
    if (r >= reject) {
      return min + ((r % range) as i64);
    }
  }
}

// Node's check of a `randomInt` bound.
function checkSafeInteger(name: string, n: i64) {
  if (n < -MAX_SAFE_INTEGER || n > MAX_SAFE_INTEGER) {
    throw new CryptoError(
      `The "${name}" argument must be a safe integer. Received type number (${n})`,
    );
  }
}
