// velt/crypto (internal): ChaCha20's keystream XORed into data four blocks at a time, one block
// per lane of a `u32x4` (the vertical layout: vector i holds word i of the four blocks), with
// the state words in vectors for the whole run. Constant time as the scalar rounds are: adds,
// XORs and rotations by constants, with branches on the data's length only.

import { u32x4, u8x16 } from "velt/simd";

declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_store(v: u8x16, to: u8[], at: u64);

/**
 * XORs `buf[start..end]` in place with the keystream of `state` from block `counter` on
 * (encryption and decryption are the same operation); `x` is 16 words of scratch. Four blocks
 * at a time, turned into the blocks' bytes by 4x4 transposes.
 */
export function chachaXorInPlace(
  state: u32[],
  x: u32[],
  counter: u32,
  buf: u8[],
  start: usize,
  end: usize,
) {
  const s0 = u32x4.splat(state[0]);
  const s1 = u32x4.splat(state[1]);
  const s2 = u32x4.splat(state[2]);
  const s3 = u32x4.splat(state[3]);
  const s4 = u32x4.splat(state[4]);
  const s5 = u32x4.splat(state[5]);
  const s6 = u32x4.splat(state[6]);
  const s7 = u32x4.splat(state[7]);
  const s8 = u32x4.splat(state[8]);
  const s9 = u32x4.splat(state[9]);
  const s10 = u32x4.splat(state[10]);
  const s11 = u32x4.splat(state[11]);
  const s13 = u32x4.splat(state[13]);
  const s14 = u32x4.splat(state[14]);
  const s15 = u32x4.splat(state[15]);
  let block = counter;
  let off = start;
  while (off < end) {
    const s12 = u32x4.splat(block) + u32x4.index();
    let x0 = s0;
    let x1 = s1;
    let x2 = s2;
    let x3 = s3;
    let x4 = s4;
    let x5 = s5;
    let x6 = s6;
    let x7 = s7;
    let x8 = s8;
    let x9 = s9;
    let x10 = s10;
    let x11 = s11;
    let x12 = s12;
    let x13 = s13;
    let x14 = s14;
    let x15 = s15;
    for (let r = 0; r < 10; r++) {
      // The column round: quarter rounds on (0, 4, 8, 12), (1, 5, 9, 13), …, a step at a time.
      x0 = x0 + x4;
      x1 = x1 + x5;
      x2 = x2 + x6;
      x3 = x3 + x7;
      x12 = rotl16(x12 ^ x0);
      x13 = rotl16(x13 ^ x1);
      x14 = rotl16(x14 ^ x2);
      x15 = rotl16(x15 ^ x3);
      x8 = x8 + x12;
      x9 = x9 + x13;
      x10 = x10 + x14;
      x11 = x11 + x15;
      x4 = rotl(x4 ^ x8, 12);
      x5 = rotl(x5 ^ x9, 12);
      x6 = rotl(x6 ^ x10, 12);
      x7 = rotl(x7 ^ x11, 12);
      x0 = x0 + x4;
      x1 = x1 + x5;
      x2 = x2 + x6;
      x3 = x3 + x7;
      x12 = rotl(x12 ^ x0, 8);
      x13 = rotl(x13 ^ x1, 8);
      x14 = rotl(x14 ^ x2, 8);
      x15 = rotl(x15 ^ x3, 8);
      x8 = x8 + x12;
      x9 = x9 + x13;
      x10 = x10 + x14;
      x11 = x11 + x15;
      x4 = rotl(x4 ^ x8, 7);
      x5 = rotl(x5 ^ x9, 7);
      x6 = rotl(x6 ^ x10, 7);
      x7 = rotl(x7 ^ x11, 7);
      // The diagonal round: (0, 5, 10, 15), (1, 6, 11, 12), (2, 7, 8, 13), (3, 4, 9, 14).
      x0 = x0 + x5;
      x1 = x1 + x6;
      x2 = x2 + x7;
      x3 = x3 + x4;
      x15 = rotl16(x15 ^ x0);
      x12 = rotl16(x12 ^ x1);
      x13 = rotl16(x13 ^ x2);
      x14 = rotl16(x14 ^ x3);
      x10 = x10 + x15;
      x11 = x11 + x12;
      x8 = x8 + x13;
      x9 = x9 + x14;
      x5 = rotl(x5 ^ x10, 12);
      x6 = rotl(x6 ^ x11, 12);
      x7 = rotl(x7 ^ x8, 12);
      x4 = rotl(x4 ^ x9, 12);
      x0 = x0 + x5;
      x1 = x1 + x6;
      x2 = x2 + x7;
      x3 = x3 + x4;
      x15 = rotl(x15 ^ x0, 8);
      x12 = rotl(x12 ^ x1, 8);
      x13 = rotl(x13 ^ x2, 8);
      x14 = rotl(x14 ^ x3, 8);
      x10 = x10 + x15;
      x11 = x11 + x12;
      x8 = x8 + x13;
      x9 = x9 + x14;
      x5 = rotl(x5 ^ x10, 7);
      x6 = rotl(x6 ^ x11, 7);
      x7 = rotl(x7 ^ x8, 7);
      x4 = rotl(x4 ^ x9, 7);
    }
    x0 = x0 + s0;
    x1 = x1 + s1;
    x2 = x2 + s2;
    x3 = x3 + s3;
    x4 = x4 + s4;
    x5 = x5 + s5;
    x6 = x6 + s6;
    x7 = x7 + s7;
    x8 = x8 + s8;
    x9 = x9 + s9;
    x10 = x10 + s10;
    x11 = x11 + s11;
    x12 = x12 + s12;
    x13 = x13 + s13;
    x14 = x14 + s14;
    x15 = x15 + s15;
    // Block j is lane j of every vector: row j of the transpose of each group of four.
    if (end - off >= 256 && u8x16.fits(buf, off + 240)) {
      // A whole chunk, inside `buf` by the one check.
      xorAt(buf, off, row0(x0, x1, x2, x3));
      xorAt(buf, off + 16, row0(x4, x5, x6, x7));
      xorAt(buf, off + 32, row0(x8, x9, x10, x11));
      xorAt(buf, off + 48, row0(x12, x13, x14, x15));
      xorAt(buf, off + 64, row1(x0, x1, x2, x3));
      xorAt(buf, off + 80, row1(x4, x5, x6, x7));
      xorAt(buf, off + 96, row1(x8, x9, x10, x11));
      xorAt(buf, off + 112, row1(x12, x13, x14, x15));
      xorAt(buf, off + 128, row2(x0, x1, x2, x3));
      xorAt(buf, off + 144, row2(x4, x5, x6, x7));
      xorAt(buf, off + 160, row2(x8, x9, x10, x11));
      xorAt(buf, off + 176, row2(x12, x13, x14, x15));
      xorAt(buf, off + 192, row3(x0, x1, x2, x3));
      xorAt(buf, off + 208, row3(x4, x5, x6, x7));
      xorAt(buf, off + 224, row3(x8, x9, x10, x11));
      xorAt(buf, off + 240, row3(x12, x13, x14, x15));
    } else {
      xorBlock(
        buf,
        off,
        end,
        x,
        row0(x0, x1, x2, x3),
        row0(x4, x5, x6, x7),
        row0(x8, x9, x10, x11),
        row0(x12, x13, x14, x15),
      );
      if (end - off > 64) {
        xorBlock(
          buf,
          off + 64,
          end,
          x,
          row1(x0, x1, x2, x3),
          row1(x4, x5, x6, x7),
          row1(x8, x9, x10, x11),
          row1(x12, x13, x14, x15),
        );
      }
      if (end - off > 128) {
        xorBlock(
          buf,
          off + 128,
          end,
          x,
          row2(x0, x1, x2, x3),
          row2(x4, x5, x6, x7),
          row2(x8, x9, x10, x11),
          row2(x12, x13, x14, x15),
        );
      }
      if (end - off > 192) {
        xorBlock(
          buf,
          off + 192,
          end,
          x,
          row3(x0, x1, x2, x3),
          row3(x4, x5, x6, x7),
          row3(x8, x9, x10, x11),
          row3(x12, x13, x14, x15),
        );
      }
    }
    block = block + 4;
    off += 256;
  }
}

// `buf[at..at + 16] ^= v`, unchecked: the caller checked the range.
function xorAt(buf: u8[], at: usize, v: u8x16) {
  velt_simd_u8x16_store(velt_simd_u8x16_load(buf, at as u64).xor(v), buf, at as u64);
}

// `buf[at..at + 16] ^= v`, checked.
function xorChecked(buf: u8[], at: usize, v: u8x16) {
  u8x16.load(buf, at).xor(v).store(buf, at);
}

function rotl(v: u32x4, n: u32): u32x4 {
  return (v << n) | (v >> (32 - n));
}

function rotl16(v: u32x4): u32x4 {
  return (v << 16) | (v >> 16);
}

// The 64-bit halves of `a` and `b`: the low ones (`zipLow`) or the high ones.
function low64(a: u32x4, b: u32x4): u8x16 {
  return a.asU8x16().asU64x2().zipLow(b.asU8x16().asU64x2()).asU8x16();
}

function high64(a: u32x4, b: u32x4): u8x16 {
  return a.asU8x16().asU64x2().zipHigh(b.asU8x16().asU64x2()).asU8x16();
}

// Row j of the transpose of the 4x4 words a, b, c, d (as rows): lane j of each, in turn. The
// zips the four rows share are computed once after inlining.
function row0(a: u32x4, b: u32x4, c: u32x4, d: u32x4): u8x16 {
  return low64(a.zipLow(b), c.zipLow(d));
}

function row1(a: u32x4, b: u32x4, c: u32x4, d: u32x4): u8x16 {
  return high64(a.zipLow(b), c.zipLow(d));
}

function row2(a: u32x4, b: u32x4, c: u32x4, d: u32x4): u8x16 {
  return low64(a.zipHigh(b), c.zipHigh(d));
}

function row3(a: u32x4, b: u32x4, c: u32x4, d: u32x4): u8x16 {
  return high64(a.zipHigh(b), c.zipHigh(d));
}

// XORs the keystream block a | b | c | d into `buf[at..]` up to `end` (`at < end`): whole
// vectors for a full block, through the scratch words `x` for the last, partial one.
function xorBlock(
  buf: u8[],
  at: usize,
  end: usize,
  x: u32[],
  a: u8x16,
  b: u8x16,
  c: u8x16,
  d: u8x16,
) {
  if (end - at >= 64) {
    xorChecked(buf, at, a);
    xorChecked(buf, at + 16, b);
    xorChecked(buf, at + 32, c);
    xorChecked(buf, at + 48, d);
    return;
  }
  a.asU32x4().store(x, 0);
  b.asU32x4().store(x, 4);
  c.asU32x4().store(x, 8);
  d.asU32x4().store(x, 12);
  for (let i: usize = 0; i < end - at; i++) {
    buf[at + i] ^= ((x[i >> 2] >>> (8 * ((i & 3) as u32))) & 0xff) as u8;
  }
}
