// The modulus n, a base, an exponent and base^exponent mod n, big-endian: random moduli of 2048,
// 3072 and 4096 bits, moduli just under and just above a power of two, the bases 0, 1 and n - 1,
// an exponent with every bit set, and 65537.
function powers(): string[][] {
  return [
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "",
      "",
    ],
    [
      "",
      "",
      "010001",
      "",
    ],
  ];
}

// Register 0 = register 0 to the power `e` (big-endian, not zero), left to right; registers 1
// and 2 are scratch. The result is not in the Montgomery domain.
function power(m: Mont, e: u8[]) {
  m.enter(1, 0);
  let started = false;
  for (const byte of e) {
    for (let bit = 7; bit >= 0; bit--) {
      const set = ((byte >> (bit as u8)) & 1) == 1;
      if (started) {
        m.mul(2, 2, 2);
        if (set) {
          m.mul(2, 2, 1);
        }
      } else if (set) {
        m.copy(2, 1);
        started = true;
      }
    }
  }
  // A product with 1 leaves the domain.
  const one = Buffer.alloc(1);
  one[0] = 1;
  m.load(0, one, 0, 1);
  m.mul(0, 2, 0);
}

describe("Mont", () => {
  it("multiplies as Python does", () => {
    for (const c of products()) {
      const n = hexDecode(c[0]);
      const m = new Mont(n, 0, n.length, 3);
      const a = hexDecode(c[1]);
      const b = hexDecode(c[2]);
      expect(m.load(0, a, 0, a.length)).toBe(true);
      expect(m.load(1, b, 0, b.length)).toBe(true);
      // a R * b / R, then the same with both in the domain and one product by 1 to leave it.
      m.enter(2, 0);
      m.mul(2, 2, 1);
      expect(`${c[0]} ${hexEncode(m.bytes(2, n.length))}`).toBe(`${c[0]} ${c[3]}`);
      m.enter(0, 0);
      m.enter(1, 1);
      m.copy(2, 1);
      m.mul(0, 0, 2);
      const one = Buffer.alloc(1);
      one[0] = 1;
      m.load(1, one, 0, 1);
      m.mul(0, 0, 1);
      expect(`${c[0]} ${hexEncode(m.bytes(0, n.length))}`).toBe(`${c[0]} ${c[3]}`);
    }
  });

  it("raises to powers as Python does, at RSA's widths", () => {
    for (const c of powers()) {
      const n = hexDecode(c[0]);
      const m = new Mont(n, 0, n.length, 3);
      const base = hexDecode(c[1]);
      expect(m.load(0, base, 0, base.length)).toBe(true);
      power(m, hexDecode(c[2]));
      const tag = c[0].slice(0, 16);
      expect(`${tag} ${hexEncode(m.bytes(0, n.length))}`).toBe(`${tag} ${c[3]}`);
    }
  });

  it("counts the modulus's limbs and bits", () => {
    const m = new Mont(hexDecode("01ffff"), 1, 2, 1);
    expect(m.k).toBe(1);
    expect(m.bits).toBe(16);
    const wide = new Mont(hexDecode("0100000000000000000000000000000001"), 0, 17, 1);
    expect(wide.k).toBe(3);
    expect(wide.bits).toBe(129);
  });

  it("says whether a loaded number is below the modulus", () => {
    const n = hexDecode("fffffffffffffffffffffffffffffffd");
    const m = new Mont(n, 0, 16, 1);
    expect(m.load(0, hexDecode("fffffffffffffffffffffffffffffffc"), 0, 16)).toBe(true);
    expect(m.load(0, n, 0, 16)).toBe(false);
    expect(m.load(0, hexDecode("fffffffffffffffffffffffffffffffe"), 0, 16)).toBe(false);
    expect(m.load(0, hexDecode("fffffffffffffffeffffffffffffffff"), 0, 16)).toBe(true);
    expect(m.load(0, [], 0, 0)).toBe(true);
    expect(hexEncode(m.bytes(0, 16))).toBe("00000000000000000000000000000000");
  });

  it("writes a number in as many bytes as asked, the low ones", () => {
    const m = new Mont(hexDecode("fffffffffffffffffffffffffffffffd"), 0, 16, 1);
    m.load(0, hexDecode("0102030405060708090a"), 0, 10);
    expect(hexEncode(m.bytes(0, 16))).toBe("0000000000000102030405060708090a");
    expect(hexEncode(m.bytes(0, 3))).toBe("08090a");
  });
});
