// velt/crypto: SHA-256, SHA-384, SHA-512 and SHA-1 (FIPS 180-4), HMAC (RFC 2104), HKDF (RFC
// 5869), X25519 (RFC 7748), ECDH and ECDSA verification on P-256 (SEC 1), the
// ChaCha20-Poly1305 (RFC 8439) and AES-GCM (NIST SP 800-38D) AEADs, secure random
// bytes/integers and constant-time comparison.
//
// The hashes are Velt: where the CPU has SHA instructions (`velt/simd`, #1330: ARMv8 SHA2, x86
// SHA-NI with SSSE3 and SSE4.1) whole blocks go through functions gated on them, which run the
// bare instructions; elsewhere (other CPUs, WebAssembly, debug builds, `VELT_SIMD_DISABLE=sha` in
// code that checks at run time)
// through portable rounds over `u32` words (integer arithmetic wraps, `>>>` is a logical shift).
// Randomness comes from the OS generator through the runtime. SHA-1 is broken for collision
// resistance: use it only for legacy protocols (WebSocket handshakes, HMAC-SHA1 in TOTP, git
// object ids).
// X25519, P-256, the AEADs and HKDF are what TLS 1.3 needs (#2392); code that handles secrets runs in
// constant time (no branch or table index depends on a key, a nonce or the data): AES is
// bitsliced, GHASH uses the carry-less multiply instruction or a constant-time integer one.
// https://veltlang.com/docs/std/crypto/.

export { Aead } from "velt/crypto/aead";
export { AesGcm } from "velt/crypto/aes_gcm";
export { ChaCha20Poly1305 } from "velt/crypto/chacha20_poly1305";
export { timingSafeEqual } from "velt/crypto/compare";
export { CryptoError } from "velt/crypto/errors";
export { hkdfExpandSha256, hkdfExtractSha256, hkdfSha256 } from "velt/crypto/hkdf";
export { hmacSha1, hmacSha256 } from "velt/crypto/hmac";
export { p256Verify } from "velt/crypto/ecdsa_p256";
export { p256Ecdh, p256PrivateKey, p256PublicKey } from "velt/crypto/p256";
export { randomBytes, randomInt } from "velt/crypto/random";
export { sha1, sha1Hex } from "velt/crypto/sha1";
export { sha256, sha256Hex } from "velt/crypto/sha256";
export { sha384, sha384Hex, sha512, sha512Hex } from "velt/crypto/sha512";
export { x25519, x25519PublicKey } from "velt/crypto/x25519";
