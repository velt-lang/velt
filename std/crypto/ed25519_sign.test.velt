    ];
    for (const c of cases) {
      const x: u64[] = [];
      for (let i: usize = 0; i < 8; i++) {
        x.push(word(c[0], 7 - i));
      }
      const r = reduceWide(x);
      let got = "";
      for (let i: usize = 0; i < 4; i++) {
        got += r[3 - i].toString(16).padStart(16, "0");
      }
      expect(`${c[0]} ${got}`).toBe(`${c[0]} ${c[1]}`);
    }
  });

  it("refuses keys of the wrong length", () => {
    const seed = randomBytes(32);
    const pub = ed25519PublicKey(seed);
    expect(() => ed25519PublicKey(randomBytes(31))).toThrow("Ed25519 needs a 32-byte private key");
    expect(() => ed25519PublicKey(randomBytes(33))).toThrow("Ed25519 needs a 32-byte private key");
    expect(() => ed25519PublicKey([])).toThrow("Ed25519 needs a 32-byte private key");
    const lengths: usize[] = [0, 31, 33, 64];
    for (const n of lengths) {
      expect(() => ed25519Sign(randomBytes(n), pub, [])).toThrow(
        "Ed25519 needs a 32-byte private key",
      );
      expect(() => ed25519Sign(seed, randomBytes(n), [])).toThrow("and its 32-byte public key");
    }
  });
});
