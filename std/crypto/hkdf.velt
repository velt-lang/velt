// velt/crypto (internal): HKDF (RFC 5869) over HMAC-SHA256 and HMAC-SHA384: extract a
// pseudorandom key from input keying material, expand it into output keying material (TLS 1.3's
// key schedule).

import { CryptoError } from "velt/crypto/errors";
import { hmacSha256, hmacSha384 } from "velt/crypto/hmac";
import { arrayWithCapacity } from "velt/lang/intrinsics";

/**
 * HKDF-Extract with SHA-256: the 32-byte pseudorandom key HMAC(`salt`, `ikm`). An empty salt
 * acts as 32 zero bytes, as the RFC says (HMAC zero-pads its key either way).
 */
export function hkdfExtractSha256(salt: u8[], ikm: u8[]): u8[] {
  return hmacSha256(salt, ikm);
}

/**
 * HKDF-Expand with SHA-256: `length` bytes of output keying material from the pseudorandom key
 * `prk` and the context `info`. Throws `CryptoError` past 255 * 32 = 8160 bytes.
 */
export function hkdfExpandSha256(prk: u8[], info: u8[], length: usize): u8[] {
  checkLength(length, 32);
  const out: u8[] = arrayWithCapacity(length);
  let t: u8[] = [];
  let counter: u8 = 1;
  while (out.length < length) {
    t = hmacSha256(prk, blockInput(t, info, counter));
    take(out, t, length);
    counter = counter + 1;
  }
  return out;
}

/** HKDF with SHA-256 (RFC 5869): Expand(Extract(`salt`, `ikm`), `info`, `length`). */
export function hkdfSha256(ikm: u8[], salt: u8[], info: u8[], length: usize): u8[] {
  return hkdfExpandSha256(hkdfExtractSha256(salt, ikm), info, length);
}

/**
 * HKDF-Extract with SHA-384: the 48-byte pseudorandom key HMAC(`salt`, `ikm`). An empty salt
 * acts as 48 zero bytes.
 */
export function hkdfExtractSha384(salt: u8[], ikm: u8[]): u8[] {
  return hmacSha384(salt, ikm);
}

/**
 * HKDF-Expand with SHA-384: `length` bytes of output keying material from the pseudorandom key
 * `prk` and the context `info`. Throws `CryptoError` past 255 * 48 = 12240 bytes.
 */
export function hkdfExpandSha384(prk: u8[], info: u8[], length: usize): u8[] {
  checkLength(length, 48);
  const out: u8[] = arrayWithCapacity(length);
  let t: u8[] = [];
  let counter: u8 = 1;
  while (out.length < length) {
    t = hmacSha384(prk, blockInput(t, info, counter));
    take(out, t, length);
    counter = counter + 1;
  }
  return out;
}

/** HKDF with SHA-384 (RFC 5869): Expand(Extract(`salt`, `ikm`), `info`, `length`). */
export function hkdfSha384(ikm: u8[], salt: u8[], info: u8[], length: usize): u8[] {
  return hkdfExpandSha384(hkdfExtractSha384(salt, ikm), info, length);
}

// At most 255 blocks of a hash of `hashLen` bytes.
function checkLength(length: usize, hashLen: usize) {
  if (length > 255 * hashLen) {
    throw new CryptoError(
      `HKDF-SHA${hashLen * 8} output is at most ${255 * hashLen} bytes, asked for ${length}`,
    );
  }
}

// T(i-1) | info | i: what block i's HMAC hashes.
function blockInput(t: u8[], info: u8[], counter: u8): u8[] {
  const input: u8[] = arrayWithCapacity(t.length + info.length + 1);
  for (let i: usize = 0; i < t.length; i++) {
    input.push(t[i]);
  }
  for (let i: usize = 0; i < info.length; i++) {
    input.push(info[i]);
  }
  input.push(counter);
  return input;
}

// Appends the bytes of `t` to `out` until it holds `length`.
function take(out: u8[], t: u8[], length: usize) {
  for (let i: usize = 0; i < t.length && out.length < length; i++) {
    out.push(t[i]);
  }
}
