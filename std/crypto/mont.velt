// velt/crypto (internal): `Mont`, arithmetic mod an odd number n of any width (RSA moduli, 2048
// to 8192 bits) in 64-bit limbs, little-endian, in the Montgomery domain (x stands for
// x * R mod n, R = 2^(64 k) for k limbs). A product interleaves the multiplication and the
// reduction in one pass over the limbs (FIOS): each limb product is a 128-bit value from `*`
// and `Math.umulh`, carries are `(s < a) as u64`, and the final subtraction of n is masked, so a
// product's time depends only on the width.
//
// Values live in registers (an array of k limbs each), named by number, like `FeP256`'s: a
// product works in a scratch array and stores its result once, so `mul(a, a, b)` works in place
// (#2403). Every result is fully reduced (below n).

import { noInline } from "velt/lang/intrinsics";

// `t + a * b + c` as 128 bits (it cannot overflow).
function mac(t: u64, a: u64, b: u64, c: u64): [u64, u64] {
  const lo = a * b;
  const s = lo + t;
  const s2 = s + c;
  return [s2, Math.umulh(a, b) + ((s < lo) as u64) + ((s2 < c) as u64)];
}

/** Registers of numbers mod an odd n. */
// All ones for `bit` 1, 0 for 0. Out of line, as field_p256.velt's `isZero`: a caller that sees
// the mask is one comparison lets LLVM make the masked subtraction a branch on it, and whether a
// product needs its last subtraction depends on the operands (with RSA's private exponent, the
// leak the timing attacks on Montgomery multiplication use). scripts/ct-counts.py's rsa_sign
// probe checks the machine code: the instructions executed must not vary with the key.
@noInline
function maskOf(bit: u64): u64 {
  return 0 - bit;
}

export class Mont {
  /** The number of limbs of n. */
  k: usize;
  /** The number of bits of n. */
  bits: usize;
  private n: u64[];
  // -n^-1 mod 2^64.
  private ninv: u64;
  // Register 0 holds R^2 mod n; the caller's register d is register d + 1 here.
  private r: u64[][];
  // A product before its last subtraction: k + 1 limbs.
  private t: u64[];

  /**
   * `regs` registers, each zero, mod the number whose big-endian bytes are `n[at..at + len]`:
   * odd, with a non-zero first byte (the caller checks both).
   */
  constructor(n: u8[], at: usize, len: usize, regs: usize) {
    const k = (len + 7) >> 3;
    this.k = k;
    this.n = [];
    this.r = [];
    this.t = [];
    for (let i: usize = 0; i < k; i++) {
      this.n.push(0);
    }
    for (let i: usize = 0; i < len; i++) {
      const j = len - 1 - i;
      this.n[j >> 3] |= (n[at + i] as u64) << ((8 * (j & 7)) as u64);
    }
    for (let i: usize = 0; i <= regs; i++) {
      const reg: u64[] = [];
      for (let j: usize = 0; j < k; j++) {
        reg.push(0);
      }
      this.r.push(reg);
    }
    for (let i: usize = 0; i <= k; i++) {
      this.t.push(0);
    }
    let top = this.n[k - 1];
    let bits = 64 * (k - 1);
    while (top != 0) {
      bits += 1;
      top = top >> 1;
    }
    this.bits = bits;
    // Newton's iteration doubles the correct low bits of n^-1 mod 2^64: n0 is its own inverse
    // mod 8, so five rounds give 96.
    const n0 = this.n[0];
    let x = n0;
    for (let i = 0; i < 5; i++) {
      x = x * (2 - n0 * x);
    }
    this.ninv = 0 - x;
    // R^2 mod n: 2^(bits - 1) is below n; doubled up to R it is R mod n, k more doublings make
    // 2^k R, and six squarings 2^(64 k) R (a square of 2^a R is 2^(2 a) R).
    this.r[0][(bits - 1) >> 6] = (1 as u64) << (((bits - 1) & 63) as u64);
    for (let i = bits - 1; i < 64 * k + k; i++) {
      this.double();
    }
    for (let i = 0; i < 6; i++) {
      this.product(0, 0, 0);
    }
  }

  // Register 0 = 2 * register 0 mod n.
  private double() {
    const r = this.r[0];
    const t = this.t;
    const k = this.k;
    let carry: u64 = 0;
    for (let i: usize = 0; i < k; i++) {
      const x = r[i];
      t[i] = (x << 1) | carry;
      carry = x >> 63;
    }
    t[k] = carry;
    this.store(0);
  }

  // Register `d` (counted from 0) = `t` (below 2n), minus n when that is not negative.
  private store(d: usize) {
    const r = this.r[d];
    const t = this.t;
    const n = this.n;
    const k = this.k;
    let borrow: u64 = 0;
    for (let i: usize = 0; i < k; i++) {
      const a = t[i];
      const b = n[i];
      const d = a - b;
      borrow = ((a < b) as u64) | ((d < borrow) as u64);
    }
    // t - n is negative when the subtraction borrows past t's carry limb.
    const sub = maskOf(1 ^ (borrow & (1 ^ t[k])));
    borrow = 0;
    for (let i: usize = 0; i < k; i++) {
      const a = t[i];
      const b = n[i] & sub;
      const x = a - b;
      r[i] = x - borrow;
      borrow = ((a < b) as u64) | ((x < borrow) as u64);
    }
  }

  // Register `d` = the Montgomery product of registers `ia` and `ib` (all counted from 0).
  private product(d: usize, ia: usize, ib: usize) {
    const a = this.r[ia];
    const b = this.r[ib];
    const t = this.t;
    const n = this.n;
    const k = this.k;
    const ninv = this.ninv;
    const n0 = n[0];
    // Always false: said once so that the loops' bounds checks go.
    if (t.length != k + 1 || n.length != k || a.length != k || b.length != k) {
      return;
    }
    for (let i: usize = 0; i <= k; i++) {
      t[i] = 0;
    }
    for (let i: usize = 0; i < k; i++) {
      const ai = a[i];
      // t = (t + ai b + m n) / 2^64, with m making the low limb zero.
      let [lo, c1] = mac(t[0], ai, b[0], 0);
      const m = lo * ninv;
      let [_, c2] = mac(lo, m, n0, 0);
      for (let j: usize = 1; j < k; j++) {
        [lo, c1] = mac(t[j], ai, b[j], c1);
        [lo, c2] = mac(lo, m, n[j], c2);
        t[j - 1] = lo;
      }
      const s = t[k] + c1;
      const s2 = s + c2;
      t[k - 1] = s2;
      t[k] = ((s < c1) as u64) + ((s2 < c2) as u64);
    }
    this.store(d);
  }

  /** `d = a * b / R` mod n (the Montgomery product); `d` may be `a` or `b`. */
  mul(d: usize, a: usize, b: usize) {
    this.product(d + 1, a + 1, b + 1);
  }

  /** `d = a * R` mod n: `a` into the Montgomery domain; `d` may be `a`. */
  enter(d: usize, a: usize) {
    this.product(d + 1, a + 1, 0);
  }

  /** `d = a + b` mod n (`a` and `b` below n); `d` may be `a` or `b`. Masked, like a product. */
  add(d: usize, a: usize, b: usize) {
    const x = this.r[a + 1];
    const y = this.r[b + 1];
    const t = this.t;
    const k = this.k;
    let carry: u64 = 0;
    for (let i: usize = 0; i < k; i++) {
      const s = x[i] + y[i];
      const s2 = s + carry;
      carry = ((s < x[i]) as u64) | ((s2 < s) as u64);
      t[i] = s2;
    }
    t[k] = carry;
    this.store(d + 1);
  }

  /** `d = a - b` mod n (`a` and `b` below n); `d` may be `a` or `b`. Masked, like a product. */
  sub(d: usize, a: usize, b: usize) {
    const x = this.r[a + 1];
    const y = this.r[b + 1];
    const r = this.r[d + 1];
    const t = this.t;
    const n = this.n;
    const k = this.k;
    let borrow: u64 = 0;
    for (let i: usize = 0; i < k; i++) {
      const u = x[i] - y[i];
      t[i] = u - borrow;
      borrow = ((x[i] < y[i]) as u64) | ((u < borrow) as u64);
    }
    // Negative: add n back.
    const back = maskOf(borrow);
    let carry: u64 = 0;
    for (let i: usize = 0; i < k; i++) {
      const m = n[i] & back;
      const s = t[i] + m;
      const s2 = s + carry;
      carry = ((s < m) as u64) | ((s2 < s) as u64);
      r[i] = s2;
    }
  }

  /**
   * Register `d` = register `first + index`, one of the `count` registers from `first`, read
   * by a masked scan of all of them: nothing branches on or is indexed by `index`, which may
   * be secret. `d` is none of them.
   */
  pick(d: usize, first: usize, count: usize, index: u64) {
    const r = this.r[d + 1];
    const k = this.k;
    for (let j: usize = 0; j < k; j++) {
      r[j] = 0;
    }
    for (let i: usize = 0; i < count; i++) {
      const x = (i as u64) ^ index;
      // All ones when x is 0 (x is far below 2^63, so x - 1 wraps only for 0).
      const mask = maskOf((x - 1) >> 63);
      const from = this.r[first + i + 1];
      for (let j: usize = 0; j < k; j++) {
        r[j] |= from[j] & mask;
      }
    }
  }

  /** Register `d` = register `a`. */
  copy(d: usize, a: usize) {
    const from = this.r[a + 1];
    const to = this.r[d + 1];
    for (let i: usize = 0; i < this.k; i++) {
      to[i] = from[i];
    }
  }

  /**
   * Register `d` = the big-endian bytes `b[at..at + len]` (at most 8 `k`), as they are.
   * Returns whether the number is below n; when it is not, the register is not a valid operand.
   */
  load(d: usize, b: u8[], at: usize, len: usize): bool {
    const r = this.r[d + 1];
    const n = this.n;
    const k = this.k;
    for (let i: usize = 0; i < k; i++) {
      r[i] = 0;
    }
    for (let i: usize = 0; i < len; i++) {
      const j = len - 1 - i;
      r[j >> 3] |= (b[at + i] as u64) << ((8 * (j & 7)) as u64);
    }
    let borrow: u64 = 0;
    for (let i: usize = 0; i < k; i++) {
      const a = r[i];
      const m = n[i];
      const x = a - m;
      borrow = ((a < m) as u64) | ((x < borrow) as u64);
    }
    return borrow == 1;
  }

  /** Register `a` as `len` big-endian bytes (`len` at most 8 `k`; higher bytes are dropped). */
  bytes(a: usize, len: usize): u8[] {
    const r = this.r[a + 1];
    const out = Buffer.alloc(len);
    for (let i: usize = 0; i < len; i++) {
      const j = len - 1 - i;
      out[i] = ((r[j >> 3] >> ((8 * (j & 7)) as u64)) & 0xff) as u8;
    }
    return out;
  }
}
