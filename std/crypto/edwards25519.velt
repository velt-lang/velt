// velt/crypto (internal): the twisted Edwards curve of Ed25519, -x^2 + y^2 = 1 + d x^2 y^2 over
// `Fe25519`, for signature verification: points in extended coordinates (X : Y : Z : T),
// x = X/Z, y = Y/Z, T = XY/Z, with the complete addition add-2008-hwcd-3 and the doubling
// dbl-2008-hwcd. Variable time, for public points only: decompression branches on the roots.

import { Fe25519 } from "velt/crypto/field25519";

// Little-endian 64-bit words: the curve's d and a square root of -1.
const D: u64[] = [0x75eb4dca135978a3, 0x00700a4d4141d8ab, 0x8cc740797779e898, 0x52036cee2b6ffe73];
const SQRT_M1: u64[] = [
  0xc4ee1b274a0ea0b0,
  0x2f431806ad2fe478,
  0x2b4d00993dfbd7a7,
  0x2b8324804fc1df0b,
];

// The odd multiples B, 3B, .., 15B of the base point: x, y and 2 d x y of each, four
// little-endian words apiece (x of B is the even root of its y = 4/5).
const BASE_ODD: u64[] = [
  0xc9562d608f25d51a,
  0x692cc7609525a7b2,
  0xc0a4e231fdd6dc5c,
  0x216936d3cd6e53fe,
