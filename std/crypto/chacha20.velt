// velt/crypto (internal): the ChaCha20 stream cipher (RFC 8439 §2.3-2.4): add-rotate-xor on
// `u32` words, constant time by construction (no branches or indexes on the key or the data). It works in
// place on the caller's buffer, with the state and the block in the caller's scratch words, so
// encrypting a record allocates nothing.

/** Little-endian `u32` at `off` of `b`. */
export function load32le(b: u8[], off: usize): u32 {
  return (
    (b[off] as u32) |
    ((b[off + 1] as u32) << 8) |
    ((b[off + 2] as u32) << 16) |
    ((b[off + 3] as u32) << 24)
  );
}

/** `x` little-endian into `b[off..off + 4]`. */
export function store32le(b: u8[], off: usize, x: u32) {
  b[off] = (x & 0xff) as u8;
  b[off + 1] = ((x >>> 8) & 0xff) as u8;
  b[off + 2] = ((x >>> 16) & 0xff) as u8;
  b[off + 3] = (x >>> 24) as u8;
}

/**
 * The state for `key` (32 bytes): "expand 32-byte k", the key words, then the block counter
 * (word 12) and the nonce (words 13-15), both zero until `chachaSetNonce`.
 */
export function chachaState(key: u8[]): u32[] {
  const s: u32[] = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574];
  for (let i: usize = 0; i < 8; i++) {
    s.push(load32le(key, 4 * i));
  }
  for (let i = 0; i < 4; i++) {
    s.push(0);
  }
  return s;
}

/** Sets the nonce words of `state` to the 12-byte `nonce`. */
export function chachaSetNonce(state: u32[], nonce: u8[]) {
  for (let i: usize = 0; i < 3; i++) {
    state[13 + i] = load32le(nonce, 4 * i);
  }
}

function quarter(x: u32[], a: usize, b: usize, c: usize, d: usize) {
  x[a] = x[a] + x[b];
  x[d] = (x[d] ^ x[a]).rotateLeft(16);
  x[c] = x[c] + x[d];
  x[b] = (x[b] ^ x[c]).rotateLeft(12);
  x[a] = x[a] + x[b];
  x[d] = (x[d] ^ x[a]).rotateLeft(8);
  x[c] = x[c] + x[d];
  x[b] = (x[b] ^ x[c]).rotateLeft(7);
}

/** The 64-byte keystream block of `state` (its counter in word 12) into `x` (16 words). */
export function chachaBlock(state: u32[], x: u32[]) {
  for (let i: usize = 0; i < 16; i++) {
    x[i] = state[i];
  }
  for (let r = 0; r < 10; r++) {
    quarter(x, 0, 4, 8, 12);
    quarter(x, 1, 5, 9, 13);
    quarter(x, 2, 6, 10, 14);
    quarter(x, 3, 7, 11, 15);
    quarter(x, 0, 5, 10, 15);
    quarter(x, 1, 6, 11, 12);
    quarter(x, 2, 7, 8, 13);
    quarter(x, 3, 4, 9, 14);
  }
  for (let i: usize = 0; i < 16; i++) {
    x[i] = x[i] + state[i];
  }
}

/**
 * XORs `buf[start..end]` in place with the keystream of `state` from block `counter` on
 * (encryption and decryption are the same operation); `x` is 16 words of scratch.
 */
export function chachaXorInPlace(
  state: u32[],
  x: u32[],
  counter: u32,
  buf: u8[],
  start: usize,
  end: usize,
) {
  let block = counter;
  let off = start;
  while (end - off >= 64) {
    state[12] = block;
    chachaBlock(state, x);
    for (let i: usize = 0; i < 16; i++) {
      store32le(buf, off + 4 * i, load32le(buf, off + 4 * i) ^ x[i]);
    }
    block = block + 1;
    off += 64;
  }
  if (off < end) {
    state[12] = block;
    chachaBlock(state, x);
    for (let i: usize = 0; i < end - off; i++) {
      buf[off + i] ^= ((x[i >> 2] >>> (8 * ((i & 3) as u32))) & 0xff) as u8;
    }
  }
}

/** The one-time Poly1305 key (the first 32 bytes of block 0, RFC 8439 §2.6) into `out[0..32]`. */
export function chachaPolyKey(state: u32[], x: u32[], out: u8[]) {
  state[12] = 0;
  chachaBlock(state, x);
  for (let i: usize = 0; i < 8; i++) {
    store32le(out, 4 * i, x[i]);
  }
}
