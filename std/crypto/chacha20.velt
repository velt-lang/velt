// velt/crypto (internal): the ChaCha20 stream cipher (RFC 8439 §2.3-2.4): add-rotate-xor on
// `u32` words, constant time by construction (no branches or indexes on the key or the data).
// A block's four rows are four `u32x4` vectors (velt/simd: NEON, SSE, WebAssembly SIMD), so a
// round's four quarter rounds run as one, and the diagonal rounds rotate rows into columns with
// lane shuffles. It works in place on the caller's buffer, with the state the caller keeps, so
// encrypting a record allocates nothing.

import { u32x4, u8x16 } from "velt/simd";

// Unchecked: the callers check the ranges (the AEAD's `check*Range`).
declare function velt_simd_u8x16_load(from: u8[], at: u64): u8x16;
declare function velt_simd_u8x16_store(v: u8x16, to: u8[], at: u64);
declare function velt_simd_u8x16_load_partial(from: u8[], at: u64, count: u64): u8x16;
declare function velt_simd_u8x16_store_partial(v: u8x16, to: u8[], at: u64, count: u64);

/** Little-endian `u32` at `off` of `b`. */
export function load32le(b: u8[], off: usize): u32 {
  return (
    (b[off] as u32) |
    ((b[off + 1] as u32) << 8) |
    ((b[off + 2] as u32) << 16) |
    ((b[off + 3] as u32) << 24)
  );
}

/** `x` little-endian into `b[off..off + 4]`. */
export function store32le(b: u8[], off: usize, x: u32) {
  b[off] = (x & 0xff) as u8;
  b[off + 1] = ((x >>> 8) & 0xff) as u8;
  b[off + 2] = ((x >>> 16) & 0xff) as u8;
  b[off + 3] = (x >>> 24) as u8;
}

/**
 * The state for `key` (32 bytes): "expand 32-byte k", the key words, then the block counter
 * (word 12) and the nonce (words 13-15), both zero until `chachaSetNonce`.
 */
export function chachaState(key: u8[]): u32[] {
  const s: u32[] = [0x61707865, 0x3320646e, 0x79622d32, 0x6b206574];
  for (let i: usize = 0; i < 8; i++) {
    s.push(load32le(key, 4 * i));
  }
  for (let i = 0; i < 4; i++) {
    s.push(0);
  }
  return s;
}

/** Sets the nonce words of `state` to the 12-byte `nonce`. */
export function chachaSetNonce(state: u32[], nonce: u8[]) {
  for (let i: usize = 0; i < 3; i++) {
    state[13 + i] = load32le(nonce, 4 * i);
  }
}

// Each lane rotated left by 16 and by 8: whole bytes, so a byte shuffle.
function rot16(x: u32x4): u32x4 {
  const b = x.asU8x16();
  return u8x16.shuffle(b, b, 2, 3, 0, 1, 6, 7, 4, 5, 10, 11, 8, 9, 14, 15, 12, 13).asU32x4();
}

function rot8(x: u32x4): u32x4 {
  const b = x.asU8x16();
  return u8x16.shuffle(b, b, 3, 0, 1, 2, 7, 4, 5, 6, 11, 8, 9, 10, 15, 12, 13, 14).asU32x4();
}

function rot12(x: u32x4): u32x4 {
  return x.shl(12).or(x.shr(20));
}

function rot7(x: u32x4): u32x4 {
  return x.shl(7).or(x.shr(25));
}

// A block's rows after the 20 rounds and the final addition.
struct Rows {
  a: u32x4;
  b: u32x4;
  c: u32x4;
  d: u32x4;
}

// The keystream block of the rows `a` (the constants), `b`, `c` (the key) and `d` (counter and
// nonce): ten double rounds, a column round then a diagonal one, each four quarter rounds at
// once.
function block(a0: u32x4, b0: u32x4, c0: u32x4, d0: u32x4): Rows {
  let a = a0;
  let b = b0;
  let c = c0;
  let d = d0;
  for (let r = 0; r < 10; r++) {
    a = a.add(b);
    d = rot16(d.xor(a));
    c = c.add(d);
    b = rot12(b.xor(c));
    a = a.add(b);
    d = rot8(d.xor(a));
    c = c.add(d);
    b = rot7(b.xor(c));
    // The diagonals into columns: row i rotated left by i lanes.
    b = u32x4.shuffle(b, b, 1, 2, 3, 0);
    c = u32x4.shuffle(c, c, 2, 3, 0, 1);
    d = u32x4.shuffle(d, d, 3, 0, 1, 2);
    a = a.add(b);
    d = rot16(d.xor(a));
    c = c.add(d);
    b = rot12(b.xor(c));
    a = a.add(b);
    d = rot8(d.xor(a));
    c = c.add(d);
    b = rot7(b.xor(c));
    b = u32x4.shuffle(b, b, 3, 0, 1, 2);
    c = u32x4.shuffle(c, c, 2, 3, 0, 1);
    d = u32x4.shuffle(d, d, 1, 2, 3, 0);
  }
  return { a: a.add(a0), b: b.add(b0), c: c.add(c0), d: d.add(d0) };
}

// `v`'s first `n` bytes (at most 16) XORed into `buf[at..at + n]`.
function xorInto(buf: u8[], at: usize, n: usize, v: u32x4) {
  if (n >= 16) {
    const x = velt_simd_u8x16_load(buf, at as u64).xor(v.asU8x16());
    velt_simd_u8x16_store(x, buf, at as u64);
  } else if (n > 0) {
    const x = velt_simd_u8x16_load_partial(buf, at as u64, n as u64).xor(v.asU8x16());
    velt_simd_u8x16_store_partial(x, buf, at as u64, n as u64);
  }
}

/**
 * XORs `buf[start..end]` in place with the keystream of `state` from block `counter` on
 * (encryption and decryption are the same operation). The range must be inside `buf`.
 */
export function chachaXorInPlace(state: u32[], counter: u32, buf: u8[], start: usize, end: usize) {
  const a = u32x4.load(state, 0);
  const b = u32x4.load(state, 4);
  const c = u32x4.load(state, 8);
  let d = u32x4.load(state, 12).withLane(0, counter);
  const one = u32x4.splat(0).withLane(0, 1);
  let off = start;
  while (off < end) {
    const x = block(a, b, c, d);
    const n = end - off;
    xorInto(buf, off, n, x.a);
    xorInto(buf, off + 16, n > 16 ? n - 16 : 0, x.b);
    xorInto(buf, off + 32, n > 32 ? n - 32 : 0, x.c);
    xorInto(buf, off + 48, n > 48 ? n - 48 : 0, x.d);
    d = d.add(one);
    off += n < 64 ? n : 64;
  }
}

/** The one-time Poly1305 key (the first 32 bytes of block 0, RFC 8439 §2.6) into `out[0..32]`. */
export function chachaPolyKey(state: u32[], out: u8[]) {
  const d = u32x4.load(state, 12).withLane(0, 0);
  const x = block(u32x4.load(state, 0), u32x4.load(state, 4), u32x4.load(state, 8), d);
  x.a.asU8x16().store(out, 0);
  x.b.asU8x16().store(out, 16);
}
