// The signer of key `k`, with `change` put in place of its part `at` when not "".
function signer(k: string[], at: usize = 0, change: string = ""): RsaSigner {
  const parts: u8[][] = [];
  for (let i: usize = 0; i < 7; i++) {
    parts.push(hexDecode(i == at && change != "" ? change : k[i]));
  }
  return new RsaSigner(parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], parts[6]);
}

describe("RsaSigner", () => {
  it("signs PKCS#1 v1.5 as OpenSSL does, and PSS as computed by hand", () => {
    const all = keys();
    const signers: RsaSigner[] = [];
    for (const k of all) {
      signers.push(signer(k));
    }
    for (const s of signatures()) {
      const i = parseInt(s[0]) as usize;
      const key = signers[i];
      const pub = hexDecode(all[i][7]);
      const digest = hexDecode(s[1]);
      const pkcs1 = key.signPkcs1(digest);
      expect(hexEncode(pkcs1)).toBe(s[2]);
      expect(rsaPkcs1Verify(pub, digest, pkcs1)).toBe(true);
      const pss = key.signPss(digest, hexDecode(s[3]));
      expect(hexEncode(pss)).toBe(s[4]);
      expect(rsaPssVerify(pub, digest, pss)).toBe(true);
    }
  });

  it("signs PSS with a new salt each time, and each verifies", () => {
    const k = keys()[0];
    const key = signer(k);
    const pub = hexDecode(k[7]);
    expect(key.size).toBe(256);
    const digest = sha256(utf8Encode("hello"));
    const a = key.signPss(digest);
    const b = key.signPss(digest);
    expect(a.length).toBe(256);
    expect(hexEncode(a) == hexEncode(b)).toBe(false);
    expect(rsaPssVerify(pub, digest, a)).toBe(true);
    expect(rsaPssVerify(pub, digest, b)).toBe(true);
    expect(rsaPssVerify(pub, sha256(utf8Encode("other")), a)).toBe(false);
    // PKCS#1 v1.5 is the same every time, whatever the blinding.
    expect(hexEncode(key.signPkcs1(digest))).toBe(hexEncode(key.signPkcs1(digest)));
  });

  it("refuses to return a signature when the key's numbers do not belong together", () => {
    const all = keys();
    const k = all[0];
    const digest = sha256(utf8Encode("hello"));
    const wrong = "do not belong together";
    // Another key's dP, dQ, qInv and q of the same sizes, and p and q the other way round.
    expect(() => signer(k, 4, all[3][4]).signPkcs1(digest)).toThrow(wrong);
    expect(() => signer(k, 5, all[3][5]).signPkcs1(digest)).toThrow(wrong);
    expect(() => signer(k, 6, all[3][6]).signPkcs1(digest)).toThrow(wrong);
    expect(() => signer(k, 3, all[3][3]).signPss(digest)).toThrow(wrong);
    expect(() => signer(k, 2, k[3]).signPkcs1(digest)).toThrow(wrong);
    expect(() => signer(k, 1, "03").signPkcs1(digest)).toThrow(wrong);
  });

  it("refuses numbers that are not a key's, and digests that are no SHA-2 hash", () => {
    const k = keys()[0];
    const shape = "not an RSA private key of 2048 to 8192 bits";
    expect(() => signer(k, 0, "00" + k[0])).toThrow(shape);
    expect(() => signer(k, 0, k[0].slice(2))).toThrow(shape);
    expect(() => signer(k, 0, k[0].slice(0, 510) + "02")).toThrow(shape);
    expect(() => signer(k, 1, "010000")).toThrow(shape);
    expect(() => signer(k, 1, "01")).toThrow(shape);
    expect(() => signer(k, 1, "020000000001")).toThrow(shape);
    expect(() => signer(k, 2, k[2] + "0101")).toThrow(shape);
    expect(() => signer(k, 2, k[2].slice(0, 254) + "02")).toThrow(shape);
    expect(() => signer(k, 4, k[4] + "01")).toThrow(shape);
    expect(() => signer(k, 6, k[6] + "01")).toThrow(shape);
    const key = signer(k);
    const digests = "RSA signs a SHA-256, SHA-384 or SHA-512 digest";
    expect(() => key.signPkcs1(Buffer.alloc(20))).toThrow(digests);
    expect(() => key.signPss(Buffer.alloc(33))).toThrow(digests);
    expect(() => key.signPkcs1([])).toThrow(digests);
    // A salt that leaves no room in the encoded message (2048 bits, SHA-256: 222 bytes fit).
    expect(key.signPss(Buffer.alloc(32), Buffer.alloc(222)).length).toBe(256);
    expect(() => key.signPss(Buffer.alloc(32), Buffer.alloc(223))).toThrow(
      "the PSS salt is too long for the key",
    );
    expect(() => key.signPss(Buffer.alloc(32), Buffer.alloc(5000))).toThrow(
      "the PSS salt is too long for the key",
    );
  });
});
