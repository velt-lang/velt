// velt:sync: building blocks for lock-free code on the prelude's `Atomic<T>`
// (docs/std/sync.md, docs/internals/design/atomics.md): `Backoff`, for a loop that waits for
// another thread, and `VersionLatch`, the latch word of optimistic lock coupling, which a
// concurrent tree keeps in every node (bbtree's `NodeLatch`). Both are plain Velt on the
// public `Atomic` API: any package can write its own.

declare function velt_rt_thread_yield(): void;

/**
 * Waiting for another thread in a loop, twice as long each round: `snooze()` spins
 * `2^round` CPU spin hints up to `2^SPIN_ROUNDS`, then yields the thread to the OS each round.
 * Start a fresh one for each wait: `const b = Backoff.create(); while (!ready()) b.snooze();`.
 * It waits for another thread, never for a task: whatever it waits for must be taken and let go
 * between two `await`s (use a `Mutex` or a channel to wait for a task).
 */
export struct Backoff {
  private round: u32;

  /** A backoff that has not waited yet. */
  static create(): Backoff {
    return { round: 0 };
  }

  /** Spins for this round, and makes the next one twice as long, up to `2^SPIN_ROUNDS`. */
  spin(): void {
    const n: u32 = 1 << this.round;
    for (let i: u32 = 0; i < n; i++) {
      Atomic.spinHint();
    }
    if (this.round < SPIN_ROUNDS) {
      this.round++;
    }
  }

  /** `spin()`, then, once the spins are as long as they get, also yields the thread. */
  snooze(): void {
    if (this.round < SPIN_ROUNDS) {
      this.spin();
    } else {
      velt_rt_thread_yield();
    }
  }

  /** Whether spinning stopped growing: a loop that waits longer should block instead. */
  get completed(): bool {
    return this.round >= SPIN_ROUNDS;
  }
}

/** Rounds of `Backoff` that spin before it yields: 2^10 spin hints is a few microseconds. */
export const SPIN_ROUNDS: u32 = 10;

const EXCLUSIVE: u64 = 1;
const SHARED_UNIT: u64 = 2;
/** Up to 2^20 - 1 shared holders at once. */
const SHARED_MASK: u64 = 2097150;
/**
 * 43 bits of version: a node read optimistically would have to change 2^43 times while one
 * reader reads it for a check to pass wrongly.
 */
const VERSION_UNIT: u64 = 2097152;

/**
 * A node's latch word for optimistic lock coupling (bbtree's `NodeLatch`), 8 bytes, kept in
 * place in a node or an array (`VersionLatch[]`). From the low bit: an exclusive bit, a count of
 * shared holders, and a version that only grows.
 *
 * - **Optimistically:** a reader takes `readVersion()`, reads the node while writers may change
 *   it, then checks `isUnchanged(v)`; if that fails it reads again. A reader writes nothing.
 * - **Exclusively:** a writer takes the node at the version it read with `tryLockAt(v)` (never
 *   waiting; start over when it fails), or with `lockExclusive()`, and lets go with
 *   `unlockExclusive(v)`, which moves it to the next version so readers see it changed.
 * - **Shared:** `lockShared()` / `unlockShared()` keep writers out without changing the version.
 *
 * Values read optimistically may be torn until `isUnchanged` says otherwise. Hold the latch only
 * between `await`s: its waits spin, so a task holding it across an `await` can hang the others.
 */
export struct VersionLatch {
  private word: Atomic<u64>;

  /** An unheld latch at version 0. */
  static create(): VersionLatch {
    return { word: new Atomic<u64>(0) };
  }

  /** The version, to read the node optimistically, once no thread holds it exclusively. */
  readVersion(): u64 {
    const w = this.word.load("acquire");
    if ((w & EXCLUSIVE) == 0) {
      return w & ~SHARED_MASK;
    }
    const b = Backoff.create();
    while (true) {
      b.spin();
      const w = this.word.load("acquire");
      if ((w & EXCLUSIVE) == 0) {
        return w & ~SHARED_MASK;
      }
    }
  }

  /** The version if no thread holds the node exclusively now, else `null`, without waiting. */
  tryReadVersion(): u64 | null {
    const w = this.word.load("acquire");
    return (w & EXCLUSIVE) == 0 ? w & ~SHARED_MASK : null;
  }

  /**
   * Whether the node is still at `version`: nothing took it exclusively since, so what this
   * thread read of it since `readVersion()` is what it held. Call it after the reads.
   */
  isUnchanged(version: u64): bool {
    Atomic.fence("acquire");
    return (this.word.load("relaxed") & ~SHARED_MASK) == version;
  }

  /**
   * Takes the node exclusively if it is still at `version` with no shared holder; `false` at
   * once otherwise. Let go with `unlockExclusive(version)`.
   */
  tryLockAt(version: u64): bool {
    const locked = this.word.compareExchange(version, version | EXCLUSIVE, "acquire") == version;
    // A reader that sees a write made under the latch sees the latch taken when it checks its
    // version: this fence pairs with `isUnchanged`'s.
    Atomic.fence("release");
    return locked;
  }

  /** Takes the node exclusively if no thread holds it at all; its version, or `null`. */
  tryLockExclusive(): u64 | null {
    const w = this.word.load("relaxed");
    if ((w & (EXCLUSIVE | SHARED_MASK)) == 0 && this.tryLockAt(w)) {
      return w;
    }
    return null;
  }

  /** Takes the node exclusively once no thread holds it; returns the version to let go at. */
  lockExclusive(): u64 {
    const b = Backoff.create();
    while (true) {
      const w = this.word.load("relaxed");
      if ((w & (EXCLUSIVE | SHARED_MASK)) == 0 && this.tryLockAt(w)) {
        return w;
      }
      b.snooze();
    }
  }

  /** Lets go of the node, held exclusively since `version`, and moves it to the next version. */
  unlockExclusive(version: u64): void {
    this.word.store(version + VERSION_UNIT, "release");
  }

  /** Takes the node shared once no thread holds it exclusively. */
  lockShared(): void {
    const b = Backoff.create();
    while (true) {
      const w = this.word.load("relaxed");
      if ((w & EXCLUSIVE) == 0 && this.word.compareExchangeWeak(w, w + SHARED_UNIT, "acquire")) {
        return;
      }
      b.snooze();
    }
  }

  /** Lets go of the node, held shared. */
  unlockShared(): void {
    this.word.sub(SHARED_UNIT, "release");
  }
}
