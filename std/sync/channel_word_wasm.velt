// velt/sync (internal): the channel's view of a poll's `cx` and of a waker's table
// (rt_abi_async.md §1) on WebAssembly, where a pointer takes 4 bytes: the waker is `cx`'s second
// word, and the table's entries (clone, wake, wake_by_ref, drop) are 4 bytes apart. Elsewhere
// std/imports.velt picks channel_word.velt.

import { addressCall, addressLoad, inline, stateDrop } from "velt/lang/intrinsics";

/** The waker header of the poll whose `cx` is at `cx`, borrowed for the poll. */
@inline
export function wakerOf(cx: usize): usize {
  // SAFETY: `cx` is a poll's context: its await word, then its waker.
  return unsafe { addressLoad<u32>(cx + 4) } as usize;
}

/** Entry `i` of waker `w`'s table. */
@inline
function entry(w: usize, i: usize): usize {
  // SAFETY: `w` is a waker header: its first word is its table of four functions.
  const table = unsafe { addressLoad<u32>(w) } as usize;
  // SAFETY: as above.
  return unsafe { addressLoad<u32>(table + i * 4) } as usize;
}

/** One more reference to waker `w`. */
export function wakerClone(w: usize): usize {
  // SAFETY: entry 0 is `clone`, which takes the header and returns one.
  return unsafe { addressCall(entry(w, 0), w) };
}

/** Wakes waker `w`, giving its reference back. */
export function wakeOwned(w: usize): void {
  // SAFETY: entry 1 is `wake`, which takes the header.
  unsafe {
    stateDrop(entry(w, 1), w);
  }
}

/** Gives waker `w`'s reference back. */
export function wakerDrop(w: usize): void {
  // SAFETY: entry 3 is `drop`, which takes the header.
  unsafe {
    stateDrop(entry(w, 3), w);
  }
}
