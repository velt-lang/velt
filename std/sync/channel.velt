// velt/sync (internal): `Channel<T>`, a typed queue between tasks (https://veltlang.com/docs/std/sync/channel/). Any number
// of tasks may send and receive through copies of one channel. A bounded channel makes `send`
// wait while it is full (backpressure); an unbounded one never waits. `close()` ends the stream:
// sends fail from then on, and receivers get what is queued, then `null`.
//
// A sent value crosses to the receiver's task like a `spawn` argument: it moves when the sender
// no longer uses it, and is deep-copied otherwise (objects are never shared between tasks).
//
// `Channel<T>` is a handle struct, like `TcpStream` (https://veltlang.com/docs/std/ "Handles"): copies share
// one channel, so pass it to producers and consumers (also `spawn`ed tasks) freely. Values still
// queued when the last copy is dropped are dropped with it.
//
// Written in Velt (#2649): the items sit in a ring in raw memory under a spin lock, and waiting
// tasks in two lines (channel_block.velt): a send or receive that can go on now takes the lock
// once and allocates nothing; one that waits joins its line through a heap future that is its
// place there (constant time to join and to leave). A receive takes its item when it is called
// (as a JS promise starts): only an empty channel makes it wait.

import { ChannelClosed } from "velt/sync/errors";
import { ChanCore } from "velt/sync/channel_core";
import {
  bounded,
  closeBlock,
  count,
  hasRoom,
  isClosed,
  lock,
  popAt,
  publishOutput,
  pushAt,
  RECV,
  SEND,
  unlock,
  hasWaiter,
  wakeFirst,
} from "velt/sync/channel_block";
import { newCell } from "velt/sync/channel_wait";
import { wakeOwned } from "#sync-chan-word";
import { dropAddress, pollAddress } from "#sync-chan-entry";
import { promiseAt, slotStore, slotTake, slotTransfer } from "velt/lang/intrinsics";

/**
 * A channel of `T` values. `channel<T>()` is unbounded; `channel<T>(capacity)` holds at most
 * `capacity` values (at least 1).
 */
export struct Channel<T> implements AsyncIterable<T> {
  /** Its block (channel_block.velt), read on every call: `core` keeps it alive. */
  private handle: usize;
  private core: shared<ChanCore<T>>;

  /**
   * Queues `value`, waiting while a bounded channel is full. Throws `ChannelClosed` (and drops
   * `value`) if the channel is closed, also while waiting.
   */
  async send(value: T): Promise<void> throws ChannelClosed {
    // Made the receiver's before the lock: a deep copy never runs while others spin on it.
    const v = slotTransfer<T>(value);
    // A receiver on another worker may take the item at once (and print): this task's lines go
    // first (#249). A send that waits has its lines published when its poll ends.
    publishOutput(this.handle);
    while (true) {
      const b = this.handle;
      lock(b);
      if (isClosed(b)) {
        unlock(b);
        throw new ChannelClosed();
      }
      if (hasRoom(b)) {
        put<T>(b, v);
        return;
      }
      unlock(b);
      await wait(b, SEND);
    }
  }

  /**
   * Queues `value` if the channel has room now, without waiting: true if it was queued, false
   * (and `value` dropped) if a bounded channel is full or the channel is closed. Synchronous, so
   * it may be called inside `Mutex.with`.
   */
  trySend(value: T): bool {
    const v = slotTransfer<T>(value);
    const b = this.handle;
    publishOutput(b);
    lock(b);
    if (isClosed(b) || !hasRoom(b)) {
      unlock(b);
      return false;
    }
    put<T>(b, v);
    return true;
  }

  /** The oldest value, waiting for one; `null` once the channel is closed and empty. */
  async receive(): Promise<T | null> {
    let published = false;
    while (true) {
      const b = this.handle;
      lock(b);
      if (count(b) !== 0) {
        if (!published && hasWaiter(b, SEND)) {
          // The room it frees lets a waiting sender go on at once: this task's lines go first.
          // Only then: a receive that wakes nobody hands nothing to another task (and the
          // publish, a call into the runtime, would cost every receive of a bounded channel).
          unlock(b);
          publishOutput(b);
          published = true;
          continue;
        }
        return take<T>(b);
      }
      if (isClosed(b)) {
        unlock(b);
        return null;
      }
      unlock(b);
      await wait(b, RECV);
    }
  }

  /** The oldest value if one is queued, else `null` (never waits). */
  tryReceive(): T | null {
    const b = this.handle;
    lock(b);
    if (count(b) === 0) {
      unlock(b);
      return null;
    }
    if (hasWaiter(b, SEND)) {
      // As in `receive`: published before the room is visible, then looked at again.
      unlock(b);
      publishOutput(b);
      lock(b);
      if (count(b) === 0) {
        unlock(b);
        return null;
      }
    }
    return take<T>(b);
  }

  /**
   * `for await (const v of ch)`: receives until the channel is closed and drained. Leaving the
   * loop early does not close the channel (other tasks may receive from it).
   */
  async *[Symbol.asyncIterator](): AsyncIterator<T> {
    while (true) {
      const v = await this.receive();
      if (v == null) {
        return;
      }
      yield v;
    }
  }

  /**
   * Closes the channel (closing twice does nothing). Pending and later sends throw
   * `ChannelClosed`; receivers drain what is queued, then get `null`.
   */
  close() {
    closeBlock(this.handle);
  }

  /** Whether the channel is closed. */
  get closed(): bool {
    return isClosed(this.handle);
  }

  /** Number of queued values. */
  get length(): i64 {
    return count(this.handle) as i64;
  }
}

/**
 * Queues `value` (from `slotTransfer`) in block `b` (locked, with room), wakes the first waiting
 * receive, unlocks.
 */
function put<T>(b: usize, value: T): void {
  // SAFETY: the lock is held and the ring has room: the new slot holds nothing; `value` was
  // transferred.
  unsafe {
    slotStore<T>(pushAt(b), value);
  }
  const w = wakeFirst(b, RECV);
  unlock(b);
  if (w !== 0) {
    wakeOwned(w);
  }
}

/** The oldest value of block `b` (locked, not empty); wakes the first waiting send, unlocks. */
function take<T>(b: usize): T {
  // SAFETY: the lock is held and an item is queued: taken once (it left the ring).
  const v = unsafe { slotTake<T>(popAt(b)) };
  const w = bounded(b) ? wakeFirst(b, SEND) : 0;
  unlock(b);
  if (w !== 0) {
    wakeOwned(w);
  }
  return v;
}

/** A wait in block `b`'s line of `kind` until what it waits for is there. */
function wait(b: usize, kind: usize): Promise<void> {
  // SAFETY: `newCell` makes a heap future of this block, given up to the promise.
  return unsafe { promiseAt<void>(newCell(b, kind, pollAddress(), dropAddress())) };
}

/** The block of `ch` (channel_block.velt), for std's tests of its waits. */
export function blockOf<T>(ch: Channel<T>): usize {
  return ch.handle;
}

/**
 * A new channel of `T` values: unbounded with `capacity` 0, else holding at most `capacity`
 * values. Panics if `capacity` is negative.
 */
export function channel<T>(capacity: i64 = 0): Channel<T> {
  if (capacity < 0) {
    panic(`channel capacity must not be negative, got ${capacity}`);
  }
  const core = shared(new ChanCore<T>(capacity as usize));
  return { handle: core.block, core: core };
}
