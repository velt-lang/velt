// velt/sync (internal): `HandOff<T>`, a one-shot hand-off of one value to one waiting task
// (#2649; what a pool hands an idle connection to its next waiter with). The waiter parks in
// `wait()`; the giver's `give(item)` stores the item and wakes exactly that waiter: a
// compare-and-swap, a store and its waker's wake (on the executor in Velt, a queue push), with no
// handle table. The rules:
// - A waiter that leaves before it is given anything (its `park()` dropped, a timeout) leaves in
//   constant time: a later `give` gets its item back.
// - A waiter dropped after its item was given (woken, not yet resumed) leaves the item behind:
//   `takeBack()` returns it, once. So a granted item comes back exactly once.
// - A given item nobody took yet stays while a `wait()` may still take it: the waiter resumes
//   with it even when the hand-off was dropped meanwhile. Once neither the hand-off nor a
//   `wait()` is left, the item is dropped.
// - `end()` is terminal: the waiter resumes with null, and a later `give` gets its item back. A
//   hand-off dropped while its waiter waits ends it the same way.
// - The item crosses to the waiter's task as a channel send's value does: moved when the giver
//   held the only reference, else copied; a resource the giver still shares stops the program
//   (#2613, std/lang/intrinsics/slot.velt).
//
// Its block in raw memory, shared by the hand-off and every wait on it (each holds a count, so a
// wait outliving the hand-off reads live memory): the count, the state word, the waker word and
// the waiter's waker (an AtomicWaker: a registering poll and a waking giver on two threads never
// both touch it), the count of `wait()`s and whether the hand-off is gone, then the item. Givers
// race only through the state word: a giver claims the item (EMPTY or WAITING → FILLING) before it
// writes it. An item nobody took is dropped by whichever of the hand-off and the `wait()`s goes
// last (`dropLeft`; both are generic, so they know the item's type: a park future is not, and
// never drops one); the one that drops it takes it with a compare-and-swap first. Share one
// hand-off between giver and waiter as a `shared` value: its fields never change, only the
// block does.

import {
  atomicSpinHint,
  fnAddress,
  promiseAt,
  slotPut,
  slotSize,
  slotTake,
} from "velt/lang/intrinsics";
import * as m from "velt/lang/hooks/sched_mem";

const EMPTY: u32 = 0;
const WAITING: u32 = 1;
const GIVEN: u32 = 2;
const TAKEN: u32 = 3;
const LEFT: u32 = 4;
const ENDED: u32 = 5;
const RETURNED: u32 = 6;
const FILLING: u32 = 7;

// The waker word's bits: a poll is storing its waker; a giver is taking it to wake it.
const REGISTERING: u32 = 1;
const WAKING: u32 = 2;

const B_REFS: usize = 0;
const B_STATE: usize = 8;
const B_WAKE: usize = 12;
const B_WAKER: usize = 16;
const B_WAITS: usize = 24;
const B_GONE: usize = 28;
const B_ITEM: usize = 32;

/** One value handed from a giver to one waiting task, once. */
export class HandOff<T> {
  private readonly block: usize;

  constructor() {
    const n = slotSize<T>();
    const b = m.zeroed(B_ITEM + (n === 0 ? 16 : n));
    m.st(b + B_REFS, 1);
    this.block = b;
  }

  /**
   * A wait for the item, which completes once it is given or the hand-off ends; `claim()` then
   * takes the item. This is a runtime wait: dropping it before it completes (a `Promise.race`
   * loser, a cancelled task) leaves in constant time, and a later `give` gets its item back.
   */
  park(): Promise<void> {
    // SAFETY: `parkFuture` makes a heap future of this block, given up to the promise.
    return unsafe { promiseAt<void>(parkFuture(this.block)) };
  }

  /** The item given (once), or null when none was given (the hand-off ended, or it was taken). */
  claim(): T | null {
    return claimFrom<T>(this.block);
  }

  /**
   * `park()` then `claim()`. The promise holds the block, not the hand-off (a hand-off shared
   * with the giver is not copied into it); as an async function it keeps waiting when it is
   * abandoned started: use `park()` where a waiter may leave.
   */
  wait(): Promise<T | null> {
    m.inc(this.block + B_REFS);
    addWaits(this.block, 1);
    return waitOn<T>(this.block);
  }

  /**
   * Gives `item` to the waiter, waking it: null when it got it, or the item back when the waiter
   * left or the hand-off ended (or was given to already).
   */
  give(item: T): T | null {
    const b = this.block;
    let s = m.load32(b + B_STATE);
    while (true) {
      if (s !== EMPTY && s !== WAITING) {
        return item;
      }
      const was = m.cas32(b + B_STATE, s, FILLING);
      if (was === s) {
        break;
      }
      s = was;
    }
    // SAFETY: this giver claimed the item (FILLING): nobody else writes or takes it until GIVEN.
    unsafe {
      slotPut<T>(b + B_ITEM, item);
    }
    m.store32(b + B_STATE, GIVEN);
    wakeWaiter(b);
    return null;
  }

  /** Ends the hand-off: the waiter resumes with null; later gives get their item back. */
  end(): void {
    endBlock(this.block);
  }

  /** The item a waiter left behind after it was given (dropped before it resumed), once. */
  takeBack(): T | null {
    if (m.cas32(this.block + B_STATE, RETURNED, TAKEN) !== RETURNED) {
      return null;
    }
    // SAFETY: the item is in the block (it was RETURNED), taken once (TAKEN now).
    return unsafe { slotTake<T>(this.block + B_ITEM) };
  }

  [Symbol.dispose]() {
    const b = this.block;
    // A waiter still waiting resumes with null.
    endBlock(b);
    // Gone, then the `wait()`s counted: a `wait()` leaving at the same time sees one or the other
    // (both sequentially consistent), and the compare-and-swap in `dropLeft` picks one dropper.
    m.store32(b + B_GONE, 1);
    if (m.load32(b + B_WAITS) === 0) {
      dropLeft<T>(b, false);
    }
    release(b);
  }
}

/**
 * The item left in block `b` (given and not taken, or left behind by a dropped waiter): with
 * `keep`, a given one is left behind for `takeBack` (as a park dropped after its give leaves it);
 * else it is dropped, now that nobody can take it (the hand-off is gone and no `wait()` is left).
 */
function dropLeft<T>(b: usize, keep: bool): void {
  const s = m.load32(b + B_STATE);
  if (keep) {
    if (s === GIVEN) {
      m.cas32(b + B_STATE, GIVEN, RETURNED);
    }
    return;
  }
  if ((s === GIVEN || s === RETURNED) && m.cas32(b + B_STATE, s, TAKEN) === s) {
    // SAFETY: an item nobody took, taken once (TAKEN now); dropped at the end of this block.
    const item = unsafe { slotTake<T>(b + B_ITEM) };
  }
}

/** Adds `d` to block `b`'s count of `wait()`s: the count before. */
function addWaits(b: usize, d: u32): u32 {
  let n = m.load32(b + B_WAITS);
  while (true) {
    const was = m.cas32(b + B_WAITS, n, n + d);
    if (was === n) {
      return n;
    }
    n = was;
  }
}

/** A `wait()`'s count of block `b`, given back when the wait ends or is dropped. */
class WaitCount<T> {
  private readonly b: usize;

  constructor(b: usize) {
    this.b = b;
  }

  [Symbol.dispose]() {
    const b = this.b;
    // The last `wait()` after the hand-off went drops an item still there: it is nobody's now.
    // A wait that took its item (or got none) finds nothing to do.
    const last = addWaits(b, ~0 as u32) === 1;
    dropLeft<T>(b, !(last && m.load32(b + B_GONE) !== 0));
    release(b);
  }
}

/** `HandOff.wait` on block `b`, which holds a count for it (given back even when dropped). */
async function waitOn<T>(b: usize): Promise<T | null> {
  using count = new WaitCount<T>(b);
  // SAFETY: `parkFuture` makes a heap future of this block, given up to the promise.
  await unsafe { promiseAt<void>(parkFuture(b)) };
  return claimFrom<T>(b);
}

/** `HandOff.claim` on block `b`. */
function claimFrom<T>(b: usize): T | null {
  if (m.cas32(b + B_STATE, GIVEN, TAKEN) !== GIVEN) {
    return null;
  }
  // SAFETY: the item is in the block (state was GIVEN), taken once (it is TAKEN now).
  return unsafe { slotTake<T>(b + B_ITEM) };
}

/** The state of block `b` once no giver is between claiming and writing the item. */
function settled(b: usize): u32 {
  let s = m.load32(b + B_STATE);
  while (s === FILLING) {
    atomicSpinHint();
    s = m.load32(b + B_STATE);
  }
  return s;
}

/** Ends block `b` (EMPTY or WAITING → ENDED), waking its waiter. */
function endBlock(b: usize): void {
  let s = settled(b);
  while (s === EMPTY || s === WAITING) {
    const was = m.cas32(b + B_STATE, s, ENDED);
    if (was === s) {
      wakeWaiter(b);
      return;
    }
    s = was === FILLING ? settled(b) : was;
  }
}

/** Gives back one count of block `b`: the last frees it (any item left was taken or dropped). */
function release(b: usize): void {
  if (m.dec(b + B_REFS) === 1) {
    const w = m.ld(b + B_WAKER);
    if (w !== 0) {
      m.wakerDrop(w);
    }
    m.release(b);
  }
}

// ---- The waiter's waker: an AtomicWaker. ----

/** Stores waker `w` (a poll's) as the one a give wakes; wakes it at once if a give is waking. */
function register(b: usize, w: usize): void {
  if (m.cas32(b + B_WAKE, 0, REGISTERING) !== 0) {
    // A giver is waking the stored waker: this poll's runs again too.
    m.wakeByRef(w);
    return;
  }
  const old = m.ld(b + B_WAKER);
  if (old !== w) {
    m.st(b + B_WAKER, m.wakerClone(w));
    if (old !== 0) {
      m.wakerDrop(old);
    }
  }
  if (m.cas32(b + B_WAKE, REGISTERING, 0) !== REGISTERING) {
    // A giver came while this poll stored it: the wake is this poll's to do.
    const k = m.swap(b + B_WAKER, 0);
    m.store32(b + B_WAKE, 0);
    if (k !== 0) {
      m.wakeOwned(k);
    }
  }
}

/** Wakes the waiter of block `b`, giving its waker's count back (a registering poll does it). */
function wakeWaiter(b: usize): void {
  if (m.or32(b + B_WAKE, WAKING) === 0) {
    const k = m.swap(b + B_WAKER, 0);
    m.and32(b + B_WAKE, ~WAKING);
    if (k !== 0) {
      m.wakeOwned(k);
    }
  }
}

// The park future: a heap future (rt_abi_async.md §1; its header, then the block, then whether
// it saw the end of the wait) with no result, holding a count of the block. Its poll and drop are
// C functions (`fnAddress`, a stand-in for `exportedAddress`, #2203 step 5).

const F_BLOCK: usize = 16;
const F_DONE: usize = 24;

function parkFuture(b: usize): usize {
  m.inc(b + B_REFS);
  const f = m.alloc(32);
  m.st(f, fnAddress(parkPoll));
  m.st(f + 8, fnAddress(parkDrop));
  m.st(f + F_BLOCK, b);
  m.st(f + F_DONE, 0);
  return f;
}

function parkPoll(f: usize, cx: usize): u32 {
  const b = m.ld(f + F_BLOCK);
  const w = m.ld(cx + 8);
  let s = m.load32(b + B_STATE);
  if (s === EMPTY) {
    // Store the waker before saying WAITING: a give after the CAS finds it.
    register(b, w);
    s = m.cas32(b + B_STATE, EMPTY, WAITING);
    if (s === EMPTY) {
      return 0;
    }
  }
  if (s === WAITING || s === FILLING) {
    // Polled again (by another task's waker, or the same): the newest waker resumes it; a give
    // being written wakes it.
    register(b, w);
    s = m.load32(b + B_STATE);
    if (s === WAITING || s === FILLING) {
      return 0;
    }
  }
  // Given, ended, taken, left or returned: nothing more to wait for.
  m.st(f + F_DONE, 1);
  return 1;
}

function parkDrop(f: usize): void {
  const b = m.ld(f + F_BLOCK);
  if (m.ld(f + F_DONE) === 0) {
    // Dropped while waiting: leave, or leave the item given meanwhile behind.
    let s = settled(b);
    if (s === WAITING && m.cas32(b + B_STATE, WAITING, LEFT) !== WAITING) {
      s = settled(b);
    }
    if (s === GIVEN) {
      m.cas32(b + B_STATE, GIVEN, RETURNED);
    }
  }
  m.release(f);
  release(b);
}
