// velt/sync (internal): the C functions of a channel wait's heap future (rt_abi_async.md §1:
// `uint32_t poll(void* f, void* cx)` and `void drop(void* f)`) where a pointer takes 8 bytes, and
// their addresses (`fnAddress`, a stand-in for `exportedAddress`, #2203 step 5). std/imports.velt
// picks channel_entry_wasm.velt on WebAssembly, whose pointers take 4.

import { fnAddress } from "velt/lang/intrinsics";
import { dropCell, pollCell } from "velt/sync/channel_wait";

function poll(f: usize, cx: usize): u32 {
  return pollCell(f, cx);
}

function drop(f: usize): void {
  dropCell(f);
}

/** The address of a wait's poll. */
export function pollAddress(): usize {
  return fnAddress(poll);
}

/** The address of a wait's drop. */
export function dropAddress(): usize {
  return fnAddress(drop);
}
