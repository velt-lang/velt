// velt/sync/epoch: epoch-based reclamation (Fraser's scheme, as crossbeam-epoch has it) for the
// values an `Atomic` of a `shared` value replaces (docs/internals/design/atomics.md
// "Reclamation"). Plain Velt on `Atomic`, `ThreadLocal` and `Mutex`.
//
// A thread reads such values inside a *section* (`pin()` … `unpin()`), which announces the
// global epoch it saw in its slot. A replaced value is *retired* with the epoch of its retiring:
// kept until every thread that was in a section then has left it. The global epoch moves on
// only when every thread in a section has seen the current one, so a value retired at epoch `g`
// is unreachable once the epoch is `g + 2` steps on, and is dropped then.

/** A slot's state while its thread is in a section: the epoch it saw, with this bit set. */
const ACTIVE: u64 = 1;
/** The epoch moves in steps of 2 (bit 0 is `ACTIVE`). */
const STEP: u64 = 2;
/** Slots per chunk. */
const CHUNK: u64 = 64;
/**
 * Words between two slots' states: each on a 128-byte line of its own, so threads entering
 * sections do not write one line.
 */
const PAD: u64 = 16;
/** A thread tries to move the epoch on once per this many retirements. */
const EVERY: u64 = 64;

/** The global epoch. */
const EPOCH = new Atomic<u64>(0);
/** The slots handed out: threads `0..REGISTERED` have one each. */
const REGISTERED = new Atomic<u64>(0);
/** The first chunk of slots; each links the next. Chunks are never freed. */
const FIRST = new Atomic<shared<Chunk> | null>(null);
/** This thread's slot number + 1 (0: none yet). */
const MINE = new ThreadLocal<u64>(0);
/** The sections this thread is in (`pin` nests). */
const DEPTH = new ThreadLocal<u64>(0);
/** Retirements on this thread since it last tried to move the epoch on. */
const SINCE = new ThreadLocal<u64>(0);
/** Values dropped so far, on every thread. */
const DROPPED = new Atomic<u64>(0);

/** A retired value of any type: dropping it drops the value. */
interface Retired {}

class Held<T> implements Retired {
  value: shared<T>;

  constructor(value: shared<T>) {
    this.value = value;
  }
}

/** A slot's retired values, with the epoch each was retired at. */
class Garbage {
  items: Retired[] = [];
  epochs: u64[] = [];
}

/**
 * `CHUNK` slots: their states (`PAD` words apart) and their retired values, a list made by the
 * slot's thread at its first `retire` (a thread that only reads makes none).
 */
class Chunk {
  states: Atomic<u64>[] = [];
  garbage: Atomic<shared<Mutex<Garbage>> | null>[] = [];
  next: Atomic<shared<Chunk> | null> = new Atomic<shared<Chunk> | null>(null);

  constructor() {
    for (let i: u64 = 0; i < CHUNK * PAD; i++) {
      this.states.push(new Atomic<u64>(0));
    }
    for (let i: u64 = 0; i < CHUNK; i++) {
      this.garbage.push(new Atomic<shared<Mutex<Garbage>> | null>(null));
    }
  }
}

/**
 * Enters a section: until the matching `unpin()`, no value retired from now on is dropped, and
 * neither is one retired before that this thread can still reach. Sections nest.
 */
export function pin(): void {
  const depth = DEPTH.get();
  DEPTH.set(depth + 1);
  if (depth != 0) {
    return;
  }
  let mine = MINE.get();
  if (mine == 0) {
    mine = register();
  }
  const e = EPOCH.load("relaxed");
  setState(mine - 1, e | ACTIVE);
  // Orders the announcement before every read in the section (pairs with `tryAdvance`'s).
  Atomic.fence("seqcst");
}

/** Leaves the section the last `pin()` entered. */
export function unpin(): void {
  const depth = DEPTH.get();
  if (depth == 0) {
    panic("velt/sync/epoch: unpin() without a matching pin() on this thread");
  }
  DEPTH.set(depth - 1);
  if (depth == 1) {
    setState(MINE.get() - 1, 0);
  }
}

/**
 * Drops `value` once no thread can still be reading it: every thread in a section now has left
 * it. Call it for a value just taken out of where other threads find it.
 */
export function retire<T>(value: shared<T>): void {
  let mine = MINE.get();
  if (mine == 0) {
    mine = register();
  }
  // Pairs with `pin`'s fence (crossbeam's `push_bag`): the epoch read here is at least the one
  // current when the value was unlinked, so no reader that could still reach it outlives it.
  Atomic.fence("seqcst");
  const at = EPOCH.load("relaxed");
  makeGarbage(mine - 1);
  withGarbage(mine - 1, (g: Garbage) => {
    g.items.push(new Held<T>(value));
    g.epochs.push(at);
    return 0;
  });
  const since = SINCE.get() + 1;
  if (since < EVERY) {
    SINCE.set(since);
    return;
  }
  SINCE.set(0);
  collect();
}

/**
 * Moves the epoch on if every thread in a section has seen the current one, then drops every
 * value retired 2 epochs or more before, on every thread's list. Returns how many it dropped.
 */
export function collect(): u64 {
  const g = tryAdvance();
  const n = REGISTERED.load("acquire");
  let dropped: u64 = 0;
  for (let i: u64 = 0; i < n; i++) {
    dropped += withGarbage(i, (gar: Garbage) => sweep(gar, g));
  }
  if (dropped != 0) {
    DROPPED.add(dropped, "relaxed");
  }
  return dropped;
}

/** The values dropped so far, on every thread (by `collect`, and by `retire`'s own collects). */
export function dropped(): u64 {
  return DROPPED.load("relaxed");
}

/** The values retired on every thread and not dropped yet. */
export function outstanding(): u64 {
  const n = REGISTERED.load("acquire");
  let total: u64 = 0;
  for (let i: u64 = 0; i < n; i++) {
    total += withGarbage(i, (g: Garbage) => g.items.length as u64);
  }
  return total;
}

/** The values retired on this thread and not dropped yet. */
export function pending(): u64 {
  const mine = MINE.get();
  if (mine == 0) {
    return 0;
  }
  return withGarbage(mine - 1, (g: Garbage) => g.items.length as u64);
}

/** Drops the values of `g` retired at least 2 epochs before `epoch`; how many. */
function sweep(g: Garbage, epoch: u64): u64 {
  let dropped: u64 = 0;
  let i = 0;
  while (i < g.items.length) {
    if (g.epochs[i] + 2 * STEP <= epoch) {
      // Moves the last one into slot `i`, dropping the retired value there.
      const last = g.items.pop()!;
      const lastAt = g.epochs.pop()!;
      if (i < g.items.length) {
        g.items[i] = last;
        g.epochs[i] = lastAt;
      }
      dropped++;
    } else {
      i++;
    }
  }
  return dropped;
}

/** The global epoch, moved on one step if every thread in a section has seen it. */
function tryAdvance(): u64 {
  const g = EPOCH.load("relaxed");
  // Pairs with `pin`'s fence: a thread whose announcement this misses reads after it.
  Atomic.fence("seqcst");
  const n = REGISTERED.load("acquire");
  for (let i: u64 = 0; i < n; i++) {
    const s = getState(i);
    if ((s & ACTIVE) != 0 && (s & ~ACTIVE) != g) {
      return g;
    }
  }
  if (EPOCH.compareExchange(g, g + STEP, "acqrel") == g) {
    return g + STEP;
  }
  return EPOCH.load("acquire");
}

/** Hands this thread a slot; its number + 1. */
function register(): u64 {
  const i = REGISTERED.add(1);
  const first = firstChunk();
  if (first != null) {
    reachChunk(first, i / CHUNK);
  }
  MINE.set(i + 1);
  return i + 1;
}

/** The first chunk, made by the first thread to need it. */
function firstChunk(): shared<Chunk> | null {
  if (FIRST.load("acquire") == null) {
    FIRST.compareExchange(null, shared(new Chunk()), "acqrel");
  }
  return FIRST.load("acquire");
}

/** Makes sure chunk `k` after `c` exists. */
function reachChunk(c: shared<Chunk>, k: u64): void {
  if (k == 0) {
    return;
  }
  if (c.next.load("acquire") == null) {
    c.next.compareExchange(null, shared(new Chunk()), "acqrel");
  }
  const next = c.next.load("acquire");
  if (next != null) {
    reachChunk(next, k - 1);
  }
}

function setState(slot: u64, v: u64): void {
  const first = FIRST.load("acquire");
  if (first == null) {
    return;
  }
  if (slot < CHUNK) {
    first.states[slot * PAD].store(v, "release");
    return;
  }
  setStateIn(first, slot / CHUNK, slot % CHUNK, v);
}

function setStateIn(c: shared<Chunk>, k: u64, j: u64, v: u64): void {
  if (k == 0) {
    c.states[j * PAD].store(v, "release");
    return;
  }
  const next = c.next.load("acquire");
  if (next != null) {
    setStateIn(next, k - 1, j, v);
  }
}

function getState(slot: u64): u64 {
  const first = FIRST.load("acquire");
  return first == null ? 0 : getStateIn(first, slot / CHUNK, slot % CHUNK);
}

function getStateIn(c: shared<Chunk>, k: u64, j: u64): u64 {
  if (k == 0) {
    return c.states[j * PAD].load("acquire");
  }
  const next = c.next.load("acquire");
  return next == null ? 0 : getStateIn(next, k - 1, j);
}

/** Makes slot `slot`'s list of retired values, if its thread has none yet. */
function makeGarbage(slot: u64): void {
  const first = FIRST.load("acquire");
  if (first != null) {
    makeGarbageIn(first, slot / CHUNK, slot % CHUNK);
  }
}

function makeGarbageIn(c: shared<Chunk>, k: u64, j: u64): void {
  if (k == 0) {
    // Only the slot's own thread sets it, once: the word is never replaced.
    if (c.garbage[j].load("acquire") == null) {
      c.garbage[j].store(shared(new Mutex(new Garbage())), "release");
    }
    return;
  }
  const next = c.next.load("acquire");
  if (next != null) {
    makeGarbageIn(next, k - 1, j);
  }
}

/** Runs `f` on slot `slot`'s retired values, under their lock (0 when it has none). */
function withGarbage(slot: u64, f: (g: Garbage) => u64): u64 {
  const first = FIRST.load("acquire");
  return first == null ? 0 : garbageIn(first, slot / CHUNK, slot % CHUNK, f);
}

function garbageIn(c: shared<Chunk>, k: u64, j: u64, f: (g: Garbage) => u64): u64 {
  if (k == 0) {
    const g = c.garbage[j].load("acquire");
    return g == null ? 0 : g.with(f);
  }
  const next = c.next.load("acquire");
  return next == null ? 0 : garbageIn(next, k - 1, j, f);
}
