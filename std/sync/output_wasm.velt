// velt/sync (internal): output.velt on WebAssembly, whose runtime runs every task on one thread
// and has one output buffer: a line is always written out before what another task prints after
// it, so there is nothing to publish (and the JS host has no C functions to publish it with).
// std/imports.velt picks this file on `wasi` and `js`.

/** Nothing to publish. */
export function publishOutput(): void {}
