// std/regex/pattern: what a `RegExp` is to code that only takes one, without the regex engine.
// `RegExp` implements `Pattern`, so a parameter typed `string | Pattern` takes a regex literal
// (`/x/i`), and a module that declares one compiles std/regex only when its program has a regex:
// velt:test's `toMatch` and `toThrow` do this (docs/std/regex.md).

/** A regular expression as a value to test strings with: `RegExp` implements it. */
export interface Pattern {
  /** The pattern text as given. */
  readonly source: string;
  /** The flags as given. */
  readonly flags: string;
  /** Whether `s` matches (as `RegExp`'s `test`). */
  test(s: string, from?: usize): bool;
}
