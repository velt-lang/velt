// velt/time (internal): the local time zone's offset on Windows (`#localtime`'s win32 variant,
// std/imports.velt). `TZ` when it names UTC or a fixed offset (std/time/tz_fixed.velt), else the
// system time zone (`GetDynamicTimeZoneInformation`), applied to the instant with
// `SystemTimeToTzSpecificLocalTimeEx`, which follows the zone's per-year daylight-saving rules.
// The zone is read once per process, as the C library keeps `TZ` on macOS and Linux. The offset
// is the difference between the local and the UTC wall-clock time.

import { Ptr } from "velt/ffi/ptr";
import { wideText } from "velt/ffi/wide";
import { addressLoad, addressStore } from "velt/lang/intrinsics";
import { processEnv } from "velt/lang/hooks/process";
import { fixedOffset } from "./tz_fixed";

/**
 * Win32's `DYNAMIC_TIME_ZONE_INFORMATION` (432 bytes), `SYSTEMTIME` (16) and `FILETIME` (8). Each
 * has two names here, as its header has: a parameter the function reads is written
 * `const SYSTEMTIME *`, by the typedef's name, and one it fills is `LPSYSTEMTIME`, a pointer
 * typedef whose pointee is the struct by its tag (`_SYSTEMTIME`). The header check
 * (`velt native headers --std`) takes each parameter by the name its header gives it.
 */
declare c type DYNAMIC_TIME_ZONE_INFORMATION;
declare c type _TIME_DYNAMIC_ZONE_INFORMATION;
declare c type SYSTEMTIME;
declare c type _SYSTEMTIME;
declare c type FILETIME;
declare c type _FILETIME;

declare c("c") function GetDynamicTimeZoneInformation(
  info: Ptr<_TIME_DYNAMIC_ZONE_INFORMATION> | null,
): u32;
declare c("c") function SystemTimeToTzSpecificLocalTimeEx(
  zone: Ptr<DYNAMIC_TIME_ZONE_INFORMATION> | null,
  utc: Ptr<SYSTEMTIME> | null,
  local: Ptr<_SYSTEMTIME> | null,
): i32;
declare c("c") function EnumDynamicTimeZoneInformation(
  index: u32,
  info: Ptr<_TIME_DYNAMIC_ZONE_INFORMATION> | null,
): u32;
declare c("c") function FileTimeToSystemTime(
  time: Ptr<FILETIME> | null,
  system: Ptr<_SYSTEMTIME> | null,
): i32;
declare c("c") function SystemTimeToFileTime(
  system: Ptr<SYSTEMTIME> | null,
  time: Ptr<_FILETIME> | null,
): i32;
declare c("c") function calloc$time(n: usize, size: usize): Ptr<u8> | null;
declare c("c") function free$time(p: Ptr<u8> | null): void;

/** `sizeof(DYNAMIC_TIME_ZONE_INFORMATION)`. */
const ZONE_BYTES: usize = 432;

/** Where `Bias` and `StandardBias` (minutes west of UTC, `LONG`s) are in it. */
const ZONE_BIAS: usize = 0;
const ZONE_STANDARD_BIAS: usize = 84;

/** Where `TimeZoneKeyName` (128 `WCHAR`s, the zone's registry key) is in it. */
const ZONE_KEY_NAME: usize = 172;
const ZONE_KEY_UNITS: usize = 128;

/** `GetDynamicTimeZoneInformation`'s failure result. */
const TIME_ZONE_ID_INVALID: u32 = 0xffffffff;

/** Seconds from 1601-01-01 (the `FILETIME` epoch) to 1970-01-01. */
const EPOCH_DIFF_SECS: i64 = 11644473600;

/** The largest seconds since 1601 whose 100 ns ticks fit a `FILETIME` Windows converts (2^63). */
const MAX_FILETIME_SECS: i64 = 922337203685;

// The process' zone, read once: KIND 0 not read yet, 1 a fixed offset (FIXED, seconds east of
// UTC), 2 the system zone (its information at ZONE, from the C library: it lives as long as the
// process), 3 none (Windows can't report one: local time is UTC). Writers set FIXED or ZONE
// before KIND.
const KIND = new Atomic<u8>(0);
const FIXED = new Atomic<i32>(0);
const ZONE = new Atomic<u64>(0);

/** Reads the zone into KIND, FIXED and ZONE; a thread that loses the race keeps the winner's. */
function readZone(): u8 {
  const tz = processEnv("TZ");
  const fixed = tz === undefined ? null : fixedOffset(tz);
  if (fixed !== null) {
    FIXED.store(fixed, "relaxed");
    KIND.store(1, "release");
    return 1;
  }
  // SAFETY: calloc has no precondition; its result is checked.
  const block = unsafe { calloc$time(1, ZONE_BYTES) };
  if (block === null) {
    KIND.store(3, "release");
    return 3;
  }
  const at = Ptr.addressOf(block);
  // SAFETY: `at` holds a zeroed DYNAMIC_TIME_ZONE_INFORMATION, which the call fills.
  const id =
    unsafe { GetDynamicTimeZoneInformation(Ptr.orNull<_TIME_DYNAMIC_ZONE_INFORMATION>(at)) };
  if (id === TIME_ZONE_ID_INVALID) {
    // SAFETY: the block calloc gave above, which nothing else has seen.
    unsafe {
      free$time(block);
    }
    KIND.store(3, "release");
    return 3;
  }
  if (ZONE.compareExchange(0, at as u64, "acqrel", "acquire") !== 0) {
    // Another thread stored its copy first: keep that one.
    // SAFETY: as above; this one was never published.
    unsafe {
      free$time(block);
    }
  }
  KIND.store(2, "release");
  return 2;
}

/**
 * This thread's buffer for the conversion (0 before its first use): the UTC FILETIME at 0, the
 * UTC SYSTEMTIME at 8, the local SYSTEMTIME at 24 and the local FILETIME at 40. From the C
 * library and kept for the thread's life, so a `Date` getter allocates nothing.
 */
const BUFFER = new ThreadLocal<u64>(0);

/** This thread's buffer, made on first use; 0 when the C library has no memory. */
function buffer(): usize {
  let p = BUFFER.get() as usize;
  if (p === 0) {
    // SAFETY: calloc has no precondition; its result is checked.
    const block = unsafe { calloc$time(1, 48) };
    if (block === null) {
      return 0;
    }
    p = Ptr.addressOf(block);
    BUFFER.set(p as u64);
  }
  return p;
}

/** The offset, in seconds, at `unixSecs` of the zone whose information is at `zone`. */
function offsetIn(zone: usize, unixSecs: i64): i32 {
  // SAFETY: `zone` holds a zone's information (the process' own, or `offsetInZone`'s block),
  // live during the call.
  const bias = unsafe { addressLoad<i32>(zone + ZONE_BIAS) };
  // SAFETY: as above.
  const standardBias = unsafe { addressLoad<i32>(zone + ZONE_STANDARD_BIAS) };
  const standard = -(bias + standardBias) * 60;
  const since1601 = unixSecs + EPOCH_DIFF_SECS;
  if (since1601 < 0 || since1601 > MAX_FILETIME_SECS) {
    return standard;
  }
  const utcTicks = since1601 * 10000000;
  const p = buffer();
  if (p === 0) {
    return standard;
  }
  // SAFETY: inside the buffer; a FILETIME is its 64-bit tick count, little-endian.
  unsafe {
    addressStore<i64>(p, utcTicks);
  }
  // This thread's buffer holds a FILETIME at 0 and 40 and a SYSTEMTIME at 8 and 24. Each call
  // gets a struct it reads by its typedef's name and one it fills by its tag, so the UTC and the
  // local SYSTEMTIME are each pointed at under both.
  // SAFETY: the UTC FILETIME, at the buffer's start.
  const utcTime = unsafe { Ptr.orNull<FILETIME>(p) };
  // SAFETY: the UTC SYSTEMTIME, at 8, for the call that fills it.
  const utcOut = unsafe { Ptr.orNull<_SYSTEMTIME>(p + 8) };
  // SAFETY: the same struct, for the call that reads it.
  const utc = unsafe { Ptr.orNull<SYSTEMTIME>(p + 8) };
  // SAFETY: the local SYSTEMTIME, at 24, for the call that fills it.
  const localOut = unsafe { Ptr.orNull<_SYSTEMTIME>(p + 24) };
  // SAFETY: the same struct, for the call that reads it.
  const local = unsafe { Ptr.orNull<SYSTEMTIME>(p + 24) };
  // SAFETY: the local FILETIME, at 40.
  const localTime = unsafe { Ptr.orNull<_FILETIME>(p + 40) };
  // SAFETY: the zone's DYNAMIC_TIME_ZONE_INFORMATION, which the call reads.
  const info = unsafe { Ptr.orNull<DYNAMIC_TIME_ZONE_INFORMATION>(zone) };
  // SAFETY: each pointer is its own struct in the buffer (or the zone's), as above; only this
  // call uses the buffer.
  let ok = unsafe { FileTimeToSystemTime(utcTime, utcOut) } !== 0;
  if (ok) {
    // SAFETY: as above.
    ok = unsafe { SystemTimeToTzSpecificLocalTimeEx(info, utc, localOut) } !== 0;
  }
  if (ok) {
    // SAFETY: as above.
    ok = unsafe { SystemTimeToFileTime(local, localTime) } !== 0;
  }
  // SAFETY: inside the buffer, which SystemTimeToFileTime filled when `ok`.
  const localTicks = ok ? unsafe { addressLoad<i64>(p + 40) } : 0;
  return ok ? ((localTicks - utcTicks) / 10000000) as i32 : standard;
}

/**
 * Seconds added to UTC to get local time at `epochMs` (milliseconds since the Unix epoch);
 * outside `SYSTEMTIME`'s range (before 1601, after 30827) the zone's standard offset.
 */
export function localOffsetSeconds(epochMs: i64): i32 {
  // Rounded down to the second, before the epoch too (no overflow near the i64 limits).
  const secs: i64 = epochMs / 1000 - (epochMs % 1000 < 0 ? 1 : 0);
  let kind = KIND.load("acquire");
  if (kind === 0) {
    kind = readZone();
  }
  if (kind === 1) {
    return FIXED.load("relaxed");
  }
  if (kind === 2) {
    return offsetIn(ZONE.load("acquire") as usize, secs);
  }
  return 0;
}

/**
 * For std/time/localtime.test.velt: the offset, in seconds, of the installed zone whose registry
 * key is `key` ("W. Europe Standard Time") at `unixSecs`, whatever the machine's own zone; null
 * when no such zone is installed.
 */
export function offsetInZone(key: string, unixSecs: i64): i32 | null {
  // SAFETY: calloc has no precondition; its result is checked.
  const block = unsafe { calloc$time(1, ZONE_BYTES) };
  if (block === null) {
    return null;
  }
  const at = Ptr.addressOf(block);
  let found = false;
  let index: u32 = 0;
  while (!found) {
    // SAFETY: `at` is a DYNAMIC_TIME_ZONE_INFORMATION's room, which each call overwrites.
    const info = unsafe { Ptr.orNull<_TIME_DYNAMIC_ZONE_INFORMATION>(at) };
    // SAFETY: as above; a non-zero result (ERROR_NO_MORE_ITEMS) ends the enumeration.
    if (unsafe { EnumDynamicTimeZoneInformation(index, info) } !== 0) {
      break;
    }
    const units: u16[] = [];
    for (let i: usize = 0; i < ZONE_KEY_UNITS; i++) {
      // SAFETY: inside the block, whose key name the call filled.
      units.push(unsafe { addressLoad<u16>(at + ZONE_KEY_NAME + 2 * i) });
    }
    found = wideText(units) === key;
    index += 1;
  }
  const offset = found ? offsetIn(at, unixSecs) : null;
  // SAFETY: the block calloc gave above, which nothing else has seen.
  unsafe {
    free$time(block);
  }
  return offset;
}
