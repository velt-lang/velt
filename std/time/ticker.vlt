// velt/time (internal): `Ticker`, a pull-based, drift-free interval (like Go's `time.Ticker` /
// tokio's `interval`): `const t = new Ticker(100); while (await t.tick()) { ... }`, or
// `for await (const n of t)`.

import { AbortController } from "velt/task/controller";
import { AbortSignal } from "velt/task/signal";
import { TickerStop } from "velt/time/ticker_stop";

/**
 * A drift-free periodic schedule: tick `k` is due `k * periodMs` after construction (measured
 * with `performance.now()`), independent of how long the loop body takes. Missed ticks are
 * skipped, not burst: a `tick()` that is already late resolves at once, and the next one is
 * the first schedule point after that. A stop wakes a pending tick at once: its sleep races the
 * stop signal (velt/task), and the losing sleep is cancelled.
 */
export class Ticker implements AsyncIterable<i64> {
  private periodMs: f64;
  private nextDue: f64;
  private control: AbortController = new AbortController();

  /** A ticker whose first tick is due `periodMs` (>= 1) from now. */
  constructor(periodMs: i64) {
    this.periodMs = (periodMs < 1 ? 1 : periodMs) as f64;
    this.nextDue = performance.now() + this.periodMs;
  }

  /** Resolves when the next tick is due: true, or false once the ticker is stopped. */
  tick(): Promise<bool> {
    const now = performance.now();
    const due = this.nextDue;
    let next = due + this.periodMs;
    if (next <= now) {
      next = due + Math.ceil((now - due) / this.periodMs) * this.periodMs;
      if (next <= now) {
        next = next + this.periodMs;
      }
    }
    this.nextDue = next;
    const waitMs = due > now ? Math.ceil(due - now) as i64 : 0;
    return waitTick(waitMs, this.control.signal);
  }

  /**
   * `for await (const n of ticker)`: each tick as `tick()` waits for it, numbered from 1,
   * until the ticker is stopped. Leaving the loop early does not stop the ticker.
   */
  async *[Symbol.asyncIterator](): AsyncIterator<i64> {
    let n = 0;
    while (await this.tick()) {
      n++;
      yield n;
    }
  }

  /** Stops the ticker (see `TickerStop.stop`). */
  stop() {
    this.control.abort("ticker stopped");
  }

  /** A handle that stops this ticker from another task. */
  stopper(): TickerStop {
    return new TickerStop(this.control);
  }
}

// Sleeps until the tick is due unless `stopped` is aborted first: the race drops the losing
// runtime wait (the timer or the signal wait), so nothing is left behind to keep the program
// alive.
async function waitTick(ms: i64, stopped: AbortSignal): Promise<bool> {
  if (stopped.aborted) {
    return false;
  }
  if (ms > 0) {
    await Promise.race([sleep(ms), stopped.whenAborted()]);
  }
  return !stopped.aborted;
}
