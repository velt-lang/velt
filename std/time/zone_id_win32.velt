// velt/time (internal): the zone id of local time on Windows (`#zone-id`'s win32 variant,
// std/imports.velt), for `Date`'s zone name (zone_name.velt). Local time follows `TZ` only where
// it names UTC or a fixed offset (tz_fixed.velt, as localtime_win32.velt reads it); otherwise it
// is the system zone, whose registry key (`GetDynamicTimeZoneInformation`'s `TimeZoneKeyName`,
// "W. Europe Standard Time") maps to an IANA id through CLDR's windowsZones
// (zone_names_windows_table.velt).
//
// Known gap: ICU picks the windowsZones mapping for the user's region (`GetUserGeoID` and
// `GetGeoInfoW(GEO_ISO2)`) and falls back to territory 001; this always takes 001, which names
// another zone where the region's differs (Peru, Ecuador and Panama under "SA Pacific Standard
// Time", 001's America/Bogota), and so can print another name than Node there.

import { Ptr } from "velt/ffi/ptr";
import { wideText } from "velt/ffi/wide";
import { addressLoad } from "velt/lang/intrinsics";
import { fixedOffset } from "./tz_fixed";
import { WINDOWS_IDS, WINDOWS_KEYS } from "./zone_names_windows_table";

/** Win32's `DYNAMIC_TIME_ZONE_INFORMATION` (localtime_win32.velt says why two names). */
declare c type _TIME_DYNAMIC_ZONE_INFORMATION;

declare c("c") function GetDynamicTimeZoneInformation$zone(
  info: Ptr<_TIME_DYNAMIC_ZONE_INFORMATION> | null,
): u32;
declare c("c") function calloc$zone(n: usize, size: usize): Ptr<u8> | null;
declare c("c") function free$zone(p: Ptr<u8> | null): void;

/** `sizeof(DYNAMIC_TIME_ZONE_INFORMATION)`. */
const ZONE_BYTES: usize = 432;

/** Where `TimeZoneKeyName` (128 `WCHAR`s) is in it. */
const ZONE_KEY_NAME: usize = 172;
const ZONE_KEY_UNITS: usize = 128;

/** `GetDynamicTimeZoneInformation`'s failure result. */
const TIME_ZONE_ID_INVALID: u32 = 0xffffffff;

/** Whether local time follows `tz`: when it names UTC or a fixed offset. */
export function tzHonoured(tz: string): bool {
  return fixedOffset(tz) !== null;
}

/** Whether local time reads `TZ` only once per process: yes, localtime_win32.velt does. */
export function tzReadOnce(): bool {
  return true;
}

/** The system zone's IANA id, or null when Windows reports none or CLDR doesn't map its key. */
export function systemZoneId(): string | null {
  // SAFETY: calloc has no precondition; its result is checked.
  const block = unsafe { calloc$zone(1, ZONE_BYTES) };
  if (block === null) {
    return null;
  }
  const at = Ptr.addressOf(block);
  // SAFETY: `at` holds a zeroed DYNAMIC_TIME_ZONE_INFORMATION, which the call fills.
  const id = unsafe { GetDynamicTimeZoneInformation$zone(Ptr.orNull(at)) };
  const units: u16[] = [];
  for (let i: usize = 0; id !== TIME_ZONE_ID_INVALID && i < ZONE_KEY_UNITS; i++) {
    // SAFETY: inside the block, whose key name the call filled.
    units.push(unsafe { addressLoad<u16>(at + ZONE_KEY_NAME + 2 * i) });
  }
  // SAFETY: the block calloc gave above, which nothing else has seen.
  unsafe {
    free$zone(block);
  }
  const key = wideText(units);
  return key.length == 0 || key.includes("\n") ? null : ianaId(key);
}

/** The IANA id CLDR maps Windows key `key` to, or null. */
function ianaId(key: string): string | null {
  const at = WINDOWS_KEYS.indexOf(`\n${key}\n`);
  if (at < 0) {
    return null;
  }
  // The key's line: how many keys end before it; the id is on the same line of WINDOWS_IDS.
  let line: i64 = 0;
  for (let i: i64 = 0; i < at; i++) {
    if (WINDOWS_KEYS.charCodeAt(i) == 10) {
      line += 1;
    }
  }
  let start: i64 = 0;
  for (let k: i64 = 0; k <= line; k++) {
    start = WINDOWS_IDS.indexOf("\n", start) + 1;
  }
  return WINDOWS_IDS.slice(start, WINDOWS_IDS.indexOf("\n", start));
}
