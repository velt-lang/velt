// velt/mem (internal): `Blank`, the value a container keeps in the slots it does not use, and its
// implementations for every type and for `string`.

import { needsDrop } from "velt/mem/needs_drop";

/**
 * A value that owns no memory, for a container to keep in the slots it does not use (an array
 * of plain `T` has no holes), so that a value it removes is released at once: `""` for a
 * string. Every type has it: one whose values own no memory (`needsDrop` is false) is its own
 * blank, and one without a blank value gives the value itself (`hasBlank()` is false), which a
 * container then replaces when that value goes. A type implements `Blank` to give one.
 */
export interface Blank<T> {
  /** Whether `blank()` owns no memory (the same for every value of the type). */
  hasBlank(): bool;
  /** A value that owns no memory when `hasBlank()`; else this value. */
  blank(): T;
}

extend<T> T implements Blank<T> {
  hasBlank(): bool {
    return !needsDrop(this);
  }
  blank(): T {
    return this;
  }
}

extend string implements Blank<string> {
  hasBlank(): bool {
    return true;
  }
  blank(): string {
    return "";
  }
}
