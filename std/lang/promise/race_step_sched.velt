// velt/lang/promise (internal): `#promise-race-step` under the executor in Velt
// (std/lang/hooks/sched_race.velt), whose race settles a microtask after the input that decides
// it, as Node settles a combinator in the reaction it queues on that input.

/** Does the race take Node's reaction step itself (`Promise.any`, std/prelude/promise.velt)? */
export function raceTakesStep(): bool {
  return true;
}

/** Do `Promise.allSettled`'s waits on its promises settle in their reactions, as Node's do, so
 * that it can attach to all of them at the call (std/prelude/promise.velt)? The executor in
 * Velt settles an awaiter in the turn its promise settles (std/lang/hooks/sched_latch.velt). */
export function settledAtCall(): bool {
  return true;
}
