// velt/lang/symbol (internal): the memory of a symbol record the registry makes at run time
// (registry.velt) in the browser, which has no C library: from the allocator compiled code uses
// (`#symbol-record`, std/imports.velt; record_mem.velt elsewhere). The wasm runtime never
// releases the registry, so its records are not freed either.

import { rawAlloc } from "velt/lang/intrinsics";

/** `n` bytes, aligned to 8, never freed (the registry writes every one of them). */
export function recordMemory(n: usize): usize {
  return rawAlloc(n);
}
