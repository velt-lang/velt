// velt/lang/bytes (internal): white-box tests of raw.velt (#2196), run by `velt test std/`: the
// byte-array allocation and copies that were the runtime's `velt_rt_bytes_*`, with the edge
// cases of the Rust tests they replace (relative indices past 32 bits, `set` that does not fit,
// overlapping copies within one array).
import { describe, expect, it } from "velt/test";
import {
  bytesCopy,
  bytesCopyWithin,
  bytesSet,
  bytesSlice,
  bytesUninit,
  bytesZeroed,
  relative,
} from "velt/lang/bytes/raw";

function text(b: u8[]): string {
  return b.utf8Slice();
}

describe("relative", () => {
  it("counts negative positions from the end and clamps, past 32 bits too", () => {
    const cases: i64[][] = [
      [0, 0],
      [3, 3],
      [99, 10],
      [-3, 7],
      [-99, 0],
      [1 << 32, 10],
      [-(1 << 32), 0],
      [(1 << 32) + 3, 10],
      [-(1 << 32) - 3, 0],
      [9223372036854775807, 10],
      [-9223372036854775807 - 1, 0],
    ];
    for (const c of cases) {
      expect(relative(c[0], 10) as i64).toBe(c[1]);
    }
  });
});

describe("allocation", () => {
  it("makes zeroed and unset arrays of the length asked for", () => {
    const z = bytesZeroed(3);
    expect(z.length).toBe(3);
    expect(z[0] + z[1] + z[2]).toBe(0);
    expect(bytesZeroed(0).length).toBe(0);
    expect(bytesUninit(5).length).toBe(5);
    expect(bytesUninit(0).length).toBe(0);
    const big = bytesZeroed(1 << 20);
    let sum: u64 = 0;
    for (const b of big) {
      sum += b as u64;
    }
    expect(sum).toBe(0);
  });
});

describe("set and copyWithin", () => {
  it("copies when it fits and leaves the array alone when not", () => {
    const d = Buffer.from("......");
    const src = Buffer.from("ab");
    expect(bytesSet(d, src, 4)).toBe(true);
    expect(bytesSet(d, src, 5)).toBe(false);
    expect(text(d)).toBe("....ab");
    bytesCopyWithin(d, 0, 4, 6);
    expect(text(d)).toBe("ab..ab");
    bytesCopyWithin(d, 1, 0, -2);
    expect(text(d)).toBe("aab..b");
  });

  it("copies within one array when the ranges overlap", () => {
    const d = Buffer.from("abcdefgh");
    bytesCopyWithin(d, 2, 0, 6);
    expect(text(d)).toBe("ababcdef");
    const e = Buffer.from("abcdefgh");
    bytesCopyWithin(e, 0, 2, 8);
    expect(text(e)).toBe("cdefghgh");
  });
});

describe("copy", () => {
  it("copies as many bytes as fit, Node's way", () => {
    const src = Buffer.from("hello");
    const dst = Buffer.from("........");
    expect(bytesCopy(dst, src, 5, 0, 99)).toBe(3);
    expect(text(dst)).toBe(".....hel");
    expect(bytesCopy(dst, src, 0, 1, 3)).toBe(2);
    expect(text(dst)).toBe("el...hel");
    expect(bytesCopy(dst, src, 8, 0, 5)).toBe(0);
    expect(bytesCopy(dst, src, 0, 5, 5)).toBe(0);
    expect(bytesCopy(dst, src, -1, 0, 5)).toBe(-1);
    expect(bytesCopy(dst, src, 0, 6, 9)).toBe(-1);
    expect(bytesCopy(dst, src, 1 << 32, 0, 5)).toBe(0);
  });
});

describe("slice", () => {
  it("copies a range with relative indices", () => {
    const b = Buffer.from("hello world");
    expect(text(bytesSlice(b, 6, 99))).toBe("world");
    expect(text(bytesSlice(b, -5, -3))).toBe("wo");
    expect(bytesSlice(b, 4, 2).length).toBe(0);
    const s = bytesSlice(b, 0, 5);
    s[0] = 72u8;
    expect(text(b)).toBe("hello world");
  });
});
