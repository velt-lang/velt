// velt/lang/equal/generate (internal): what the generator of `equalByContent` and
// `equalByFields` (index.vlt) reads off the model: how fields are read, which types can hold
// themselves, how the members of a union of several number types compare.

import { Model, Output, Type, Field } from "velt/generate";

/** Is `name` written as `v.name` (an identifier), not `v["name"]`? */
function isIdentifier(name: string): bool {
  const n = name.length as i64;
  if (n == 0) {
    return false;
  }
  for (let i: i64 = 0; i < n; i++) {
    const c = name.charCodeAt(i);
    const letter = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36;
    if (!letter && !(i > 0 && c >= 48 && c <= 57)) {
      return false;
    }
  }
  return true;
}

/** The expression reading field `f` of the value `v` (of model type `t`). */
export function member(out: Output, model: Model, f: Field, v: string): string {
  // A field an extension adds to the type's objects is read through the extension's type.
  const holder = f.via >= 0 ? `(${v} as ${model.type(f.via).spelling})` : v;
  return isIdentifier(f.name) ? `${holder}.${f.name}` : `${holder}[${out.literal(f.name)}]`;
}

/**
 * Is the field out of reach of generated code: an ES private field (`#x`, private to its class
 * as in JavaScript) or a symbol key?
 */
export function unreadable(f: Field): bool {
  return (
    f.isEsPrivate ||
    f.name.startsWith("#") ||
    (f.name.startsWith("[Symbol.") && f.name.endsWith("]")) ||
    f.name.startsWith("\u{ffff}")
  );
}

/** Is `t` compared by its fields (`deep`: as `toEqual` compares, which looks into classes)? */
export function byFields(t: Type, deep: bool): bool {
  return t.kind == "object" || t.kind == "struct" || (deep && t.kind == "class");
}

/** The types whose values a comparison of a `t` compares by content. */
function parts(model: Model, t: Type, deep: bool): i64[] {
  const k = t.kind;
  if (k == "object" || k == "struct" || (deep && k == "class")) {
    const out: i64[] = [];
    for (const f of t.fields) {
      if (!unreadable(f)) {
        out.push(f.type);
      }
    }
    if (deep) {
      for (const s of t.subclasses) {
        out.push(s);
      }
    }
    return out;
  }
  if (k == "union") {
    return t.arms;
  }
  if (k == "array" || k == "tuple" || k == "option" || k == "map") {
    return t.args;
  }
  if (k == "record" || (deep && k == "set")) {
    return t.args;
  }
  return [];
}

/**
 * Can a value of type `t` hold another value of its own type through the parts the comparison
 * follows? Only such values can hold themselves, so only they are compared under the cycle
 * guard.
 */
export function canHoldItself(model: Model, t: Type, deep: bool): bool {
  const seen: i64[] = [];
  const work: i64[] = parts(model, t, deep).slice();
  while (work.length > 0) {
    const id = work.pop()!;
    if (id == t.id) {
      return true;
    }
    if (!seen.includes(id)) {
      seen.push(id);
      for (const p of parts(model, model.type(id), deep)) {
        work.push(p);
      }
    }
  }
  return false;
}

/** Is class `s` class `c` or one that extends it? */
export function extendsClass(model: Model, s: i64, c: i64): bool {
  let at = s;
  while (at >= 0) {
    if (at == c) {
      return true;
    }
    at = model.type(at).base;
  }
  return false;
}

/**
 * How a number member of a union holds its number: `f` (a float), `i` (a signed integer), `u`
 * (an unsigned one), or "" for a member that is no number. A numeric literal type is a member
 * holding its constant.
 */
export function numberClass(t: Type): string {
  if (t.kind == "number") {
    if (t.repr.startsWith("f")) {
      return "f";
    }
    return t.repr.startsWith("u") ? "u" : "i";
  }
  if (t.kind == "literal") {
    const s = t.literal;
    if (s.length == 0 || s.startsWith("\"") || s == "true" || s == "false") {
      return "";
    }
    for (let i: i64 = 0; i < (s.length as i64); i++) {
      const c = s.charCodeAt(i);
      if (!(c == 45 || (c >= 48 && c <= 57))) {
        return "f";
      }
    }
    return "i";
  }
  return "";
}

/**
 * Whether two values of number members of a union, `x` (class `cx`) and `y` (class `cy`),
 * hold the same number, exactly (`deep`: telling `-0` from `0`).
 */
export function numbersEqual(cx: string, x: string, cy: string, y: string, deep: bool): string {
  const d = deep ? "true" : "false";
  if (cx == "f" && cy == "f") {
    return `floatEqual(${x} as f64, ${y} as f64, ${d})`;
  }
  if (cx == "f") {
    return numbersEqual(cy, y, cx, x, deep);
  }
  if (cy == "f") {
    return cx == "i"
      ? `intFloatEqual(${x} as i64, ${y} as f64, ${d})`
      : `uintFloatEqual(${x} as u64, ${y} as f64, ${d})`;
  }
  if (cx == cy) {
    const r = cx == "i" ? "i64" : "u64";
    return `(${x} as ${r}) == (${y} as ${r})`;
  }
  return cx == "i"
    ? `intUintEqual(${x} as i64, ${y} as u64)`
    : `intUintEqual(${y} as i64, ${x} as u64)`;
}

/**
 * Whether optional field `name` is present in both `a` and `b` or in neither: a field left out
 * differs from one set to `undefined` (`"a" in x`), in `util.isDeepStrictEqual` and here in
 * `toEqual` too (Vitest's ignores `undefined` members).
 */
export function presence(out: Output, name: string, a: string, b: string): string {
  const key = out.literal(name);
  return `((${key} in ${a}) == (${key} in ${b}))`;
}
