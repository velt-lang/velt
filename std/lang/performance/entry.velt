// velt/lang/performance (internal): `PerformanceEntry`, what the timeline holds.

/**
 * An entry of the performance timeline (Node's perf_hooks): a mark, a measure or a resource
 * timing, which `entryType` names, at `startTime` milliseconds after the time origin
 * (`performance.timeOrigin`) and lasting `duration` milliseconds.
 */
export class PerformanceEntry {
  /** The name given to `performance.mark` or `performance.measure`. */
  readonly name: string;
  /** `"mark"`, `"measure"` or `"resource"`. */
  readonly entryType: string;
  /** Milliseconds after the time origin. */
  readonly startTime: number;
  /** Milliseconds (0 for a mark). */
  readonly duration: number;

  constructor(name: string, entryType: string, startTime: number, duration: number) {
    this.name = name;
    this.entryType = entryType;
    this.startTime = startTime;
    this.duration = duration;
  }

  /** The entry as `JSON.stringify` writes it: its four fields. */
  toJSON(): any {
    return {
      name: this.name,
      entryType: this.entryType,
      startTime: this.startTime,
      duration: this.duration,
    };
  }
}
