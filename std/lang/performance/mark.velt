// velt/lang/performance (internal): `PerformanceMark`, what `performance.mark` makes.

import { PerformanceEntry } from "./entry";
import { CodedTypeError } from "./errors";
import { perfNow } from "velt/lang/hooks/clock";

/** The options of `performance.mark`: the mark's `detail` and its time (default: now). */
export type PerformanceMarkOptions = { detail?: any; startTime?: number };

/**
 * A named point on the timeline (`performance.mark("loaded")`), with the `detail` given with it
 * (`null` when none was).
 */
export class PerformanceMark extends PerformanceEntry {
  /** What the options gave as `detail`, or `null`. */
  readonly detail: any;

  /**
   * A mark named `name` at `options.startTime` (default: now); a time below 0 throws Node's
   * `ERR_PERFORMANCE_INVALID_TIMESTAMP`. Made by `performance.mark`, which also records it.
   */
  constructor(name: string, options: PerformanceMarkOptions = {}) {
    const start = options.startTime ?? perfNow();
    if (start < 0) {
      throw new CodedTypeError(
        "ERR_PERFORMANCE_INVALID_TIMESTAMP",
        `${start} is not a valid timestamp`,
      );
    }
    super(name, "mark", start, 0);
    this.detail = options.detail ?? null;
  }

  /** The mark as `JSON.stringify` writes it, with its `detail`. */
  override toJSON(): any {
    return {
      name: this.name,
      entryType: this.entryType,
      startTime: this.startTime,
      duration: this.duration,
      detail: this.detail,
    };
  }
}
