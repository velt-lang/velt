// velt/lang/record (internal): what `Reflect` and `Object.getOwnPropertyDescriptor` do to a
// record's symbol keys and accessors (velt/lang/record/symbols). `Reflect`, given a record as an
// `any`, calls the `anyRec_` functions through `any` with the keys of std/lang/hooks/keys.vlt
// (`r[RECORD_SYM_GET](s)`: velt_vir `any_builtin.rs`), which reach the
// record's own methods at its value type. Loaded by std/prelude/global/record_reflect.vlt.

import "velt/lang/record/symbols";
import {
  RECORD_ACCESSOR,
  RECORD_DELETE_SYM,
  RECORD_DESCRIPTOR,
  RECORD_GET_KEYED,
  RECORD_GET_SYM,
  RECORD_HAS_KEYED,
  RECORD_HAS_SYM,
  RECORD_OWN_KEYS,
  RECORD_SET_SYM,
} from "velt/lang/hooks/keys";

/**
 * A property's attributes as `Object.getOwnPropertyDescriptor` gives them for a record (the
 * fields of `PropertyDescriptor`, in the order Node prints them): a data property has `value`
 * and `writable`, an accessor property `get` and `set`.
 */
export type RecordDescriptor = {
  value?: any;
  writable?: boolean;
  get?: any;
  set?: any;
  enumerable?: boolean;
  configurable?: boolean;
};

extend<K, V> Record<K, V> {
  /** `Object.getOwnPropertyDescriptor(r, key)`: the property `key`, or `undefined`. */
  [RECORD_DESCRIPTOR](key: K | symbol): RecordDescriptor | undefined {
    const a = this[RECORD_ACCESSOR](key);
    if (a != null) {
      const g = a[0];
      const s = a[1];
      const get: any = g == null ? undefined : g;
      const set: any = s == null ? undefined : s;
      return { get: get, set: set, enumerable: false, configurable: a[2] };
    }
    if (!this[RECORD_HAS_KEYED](key)) {
      return undefined;
    }
    const v: any = this[RECORD_GET_KEYED](key);
    return { value: v, writable: true, enumerable: true, configurable: true };
  }
}

/** `Reflect.get(r, s)` of a record with a symbol `s`. */
export function anyRec_symGet<V>(r: Record<string, V>, args: any[]): any {
  return r[RECORD_GET_SYM](args[0] as symbol);
}

/** `Reflect.set(r, s, v)` of a record with a symbol `s`. */
export function anyRec_symSet<V>(r: Record<string, V>, args: any[]): any {
  r[RECORD_SET_SYM](args[0] as symbol, args[1] as V);
  return true;
}

/** `Reflect.has(r, s)` of a record with a symbol `s`. */
export function anyRec_symHas<V>(r: Record<string, V>, args: any[]): any {
  return r[RECORD_HAS_SYM](args[0] as symbol);
}

/** `Reflect.deleteProperty(r, s)` of a record with a symbol `s`. */
export function anyRec_symDelete<V>(r: Record<string, V>, args: any[]): any {
  return r[RECORD_DELETE_SYM](args[0] as symbol);
}

/** `Reflect.ownKeys(r)` of a record: its string keys, then its symbol keys. */
export function anyRec_ownKeys<V>(r: Record<string, V>, args: any[]): any {
  return r[RECORD_OWN_KEYS]();
}

/** `Reflect.getOwnPropertyDescriptor(r, k)` of a record. */
export function anyRec_descriptor<V>(r: Record<string, V>, args: any[]): any {
  const k = args[0];
  if (typeof k === "symbol") {
    return r[RECORD_DESCRIPTOR](k as symbol);
  }
  return r[RECORD_DESCRIPTOR](`${k}`);
}
