// velt/lang/hooks (internal): the clocks of `#clock` on Windows: the performance counter
// (`QueryPerformanceCounter`, which Node's `performance.now()` and Rust's `Instant` read) and
// `GetSystemTimePreciseAsFileTime` for the wall clock (Rust's `SystemTime`), into this thread's
// buffer, so a read allocates nothing.

import { Ptr } from "velt/ffi/ptr";
import { addressLoad } from "velt/lang/intrinsics";

/** Win32's `LARGE_INTEGER` and `FILETIME` (both 8 bytes). */
declare c type LARGE_INTEGER;
declare c type FILETIME;

declare c("c") function QueryPerformanceCounter$clock(count: Ptr<LARGE_INTEGER>): i32;
declare c("c") function QueryPerformanceFrequency$clock(freq: Ptr<LARGE_INTEGER>): i32;
declare c("c") function GetSystemTimePreciseAsFileTime(time: Ptr<FILETIME>): void;
declare c("c") function calloc$clock(n: usize, size: usize): Ptr<u8> | null;

/** 100 ns ticks from 1601-01-01 (the `FILETIME` epoch) to 1970-01-01. */
const EPOCH_TICKS: i64 = 116444736000000000;

/** The performance counter's frequency (fixed at boot), once read; 0 until then. */
const FREQUENCY = new Atomic<u64>(0);

/** This thread's 8-byte buffer (0 before its first use): from the C library, kept for its life. */
const BUFFER = new ThreadLocal<u64>(0);

/** This thread's buffer, made on first use; 0 when the C library has no memory. */
function buffer(): usize {
  let p = BUFFER.get() as usize;
  if (p === 0) {
    // SAFETY: calloc has no precondition; its result is checked.
    const block = unsafe { calloc$clock(1, 8) };
    if (block === null) {
      return 0;
    }
    p = Ptr.addressOf(block);
    BUFFER.set(p as u64);
  }
  return p;
}

/** The performance counter in nanoseconds (0 when this thread has no buffer). */
export function monotonicNs(): u64 {
  const p = buffer();
  if (p === 0) {
    return 0;
  }
  let f = FREQUENCY.load("relaxed");
  if (f === 0) {
    // SAFETY: this thread's buffer holds a LARGE_INTEGER; the call succeeds on every Windows
    // since XP.
    unsafe {
      QueryPerformanceFrequency$clock(Ptr.at<LARGE_INTEGER>(p));
    }
    // SAFETY: inside the buffer, which the call filled.
    f = unsafe { addressLoad<u64>(p) };
    FREQUENCY.store(f, "relaxed");
  }
  // SAFETY: as above.
  unsafe {
    QueryPerformanceCounter$clock(Ptr.at<LARGE_INTEGER>(p));
  }
  // SAFETY: as above.
  const c = unsafe { addressLoad<u64>(p) };
  if (f === 0) {
    return 0;
  }
  // Whole seconds and the rest apart: `c * 10^9` overflows after half an hour at 10 MHz.
  return (c / f) * 1000000000 + ((c % f) * 1000000000) / f;
}

/** The wall clock in nanoseconds since the Unix epoch (0 when this thread has no buffer). */
export function realtimeNs(): i64 {
  const p = buffer();
  if (p === 0) {
    return 0;
  }
  // SAFETY: this thread's buffer holds a FILETIME, which only this call uses.
  unsafe {
    GetSystemTimePreciseAsFileTime(Ptr.at<FILETIME>(p));
  }
  // SAFETY: inside the buffer, which the call filled (the ticks, little-endian).
  const ticks = unsafe { addressLoad<i64>(p) };
  return (ticks - EPOCH_TICKS) * 100;
}
