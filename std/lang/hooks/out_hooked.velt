// velt/lang/hooks (internal): standard output and standard error on native targets (`#stdout-sys`'
// native variant, std/imports.velt): std's writer (out_native.velt), reached through its prebuilt
// entries by role (`hookCall`, velt_common `std_hooks/stdout_hooks.rs`). A build that links the
// writer's prebuilt object calls the object and neither loads nor compiles the writer
// (docs/internals/design/std-object.md "Prebuilt hook modules"); one that doesn't loads it as for
// any hook, and its code is inlined here.

import { arrayDataAddress, hookCall, inline } from "velt/lang/intrinsics";

@inline("always")
export function writeStr(stream: u32, s: string): void {
  hookCall("out_write_str", stream, s);
}

export function writeBool(stream: u32, v: bool): void {
  hookCall("out_write_str", stream, v ? "true" : "false");
}

@inline("always")
export function writeByte(stream: u32, c: u8): void {
  hookCall("out_write_byte", stream, c);
}

export function stdoutWriteBytes(bytes: u8[]): void {
  const n = bytes.length;
  // SAFETY: the caller's array, alive through the call; the writer only reads it.
  const p = unsafe { arrayDataAddress(bytes) };
  hookCall("out_write_bytes", p, n);
}

export function flushOutput(): void {
  hookCall("out_flush");
}

@inline("always")
export function publishOutput(): void {
  hookCall("out_publish");
}

export function threadEnd(): void {
  hookCall("out_thread_end");
}

export function flushIdle(): void {
  hookCall("out_flush_idle");
}

export function initOutput(): void {
  hookCall("out_init");
}

export function registerExitFlush(): void {
  hookCall("out_register_exit_flush");
}

export function flushForExit(): void {
  hookCall("out_flush_for_exit");
}
