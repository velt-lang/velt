// velt/lang/hooks (internal): the compiler's hooks for the builtin `process` namespace
// (std-layout.md §10b): `process.stdout.write(s)` / `process.stderr.write(s)` (`processWrite`),
// `process.env.NAME` / `process.env[name]` (`processEnv`), `process.argv` (`processArgv`, its
// list by role, `argList`) and the mark of a top-level `await` (`topLevelAwaitAt`). The rest of
// Node's `process` is in `velt/process` (https://veltlang.com/docs/std/process/). Also the mark
// of what this thread wrote to standard output (`stdoutWritten`), which `console.log` and every
// std writer of stdout set and velt/sync's hand-offs read (std/sync/output.velt, #2771).

import { processId } from "#process-pid";
import {
  addressLoad,
  addressStore,
  arrayWithCapacity,
  hookCall,
  inline,
  noInline,
} from "velt/lang/intrinsics";
import { getEnv, lockEnv, unlockEnv } from "#env-sys";

declare function velt_rt_write_str(stream: u32, s: string);

/**
 * Whether this thread wrote to standard output since a hand-off last published its output
 * (`clearStdoutWritten`): the runtime buffers stdout per thread. Set by every write of stdout from
 * compiled code: `console.log` (`stdoutWritten`, called by lowering), `process.stdout.write` and
 * `Stdout.write`; the runtime writes stdout for nobody else. True also when the runtime published
 * the buffer since (at the end of every poll): an extra publish, of nothing, is harmless.
 */
const STDOUT_WRITTEN = new ThreadLocal<bool>(false);

/**
 * On a lazy worker 0's thread, its `E_PANY` word (sched_task.velt), 0 elsewhere and once it is
 * shared: the first write after a publish marks it `PRINTED` (`PANY_PRINTED` there), and the look
 * after the poll publishes the output (sched_loop.velt `alone`, through `publishPrinted`, which
 * clears `STDOUT_WRITTEN`), which a lazy worker 0 does not do per poll (#2977). While it is set,
 * `STDOUT_WRITTEN` set means the word is marked (`setLazyWorker` marks it too), so later writes
 * only read `STDOUT_WRITTEN`. Only that thread writes the word: the mark is a plain load and
 * store. No executor module is imported here: a program that runs nothing on the executor loads
 * none of it.
 */
const LAZY_PANY = new ThreadLocal<usize>(0);

/** The bit of `E_PANY` a write sets (sched_task.velt `PANY_PRINTED`). */
export const PRINTED: usize = 8;

/** Marks that this thread wrote to standard output: before each write of it. */
@inline("always")
export function stdoutWritten(): void {
  if (!STDOUT_WRITTEN.get()) {
    firstWrite();
  }
}

/** `stdoutWritten` after a publish (or the first ever): the mark, and a lazy worker 0's word. */
@noInline
function firstWrite(): void {
  STDOUT_WRITTEN.set(true);
  const a = LAZY_PANY.get();
  if (a !== 0) {
    markLazy(a);
  }
}

/** A lazy worker 0's `E_PANY` word at `a` gets `PRINTED`. */
function markLazy(a: usize): void {
  // SAFETY: `a` is worker 0's `E_PANY` (`setLazyWorker`), its block lasting, this its thread.
  unsafe {
    addressStore<usize>(a, addressLoad<usize>(a) | PRINTED);
  }
}

/**
 * This thread is lazy worker 0, its `E_PANY` word at `a` (0: not any more): its writes to
 * standard output mark that word (`stdoutWritten`). Set by the worker itself.
 */
export function setLazyWorker(a: usize): void {
  LAZY_PANY.set(a);
  // Written since the last publish: the look after the next poll publishes that too.
  if (a !== 0 && STDOUT_WRITTEN.get()) {
    markLazy(a);
  }
}

/** Whether this thread wrote to standard output since a hand-off last published it (kept set). */
@inline("always")
export function stdoutWrittenSince(): bool {
  return STDOUT_WRITTEN.get();
}

/** Clears the mark: the hand-off that saw it publishes the output (std/sync/output.velt). */
@inline("always")
export function clearStdoutWritten(): void {
  STDOUT_WRITTEN.set(false);
}

/**
 * Writes `s` to standard output (`stream` 1) or standard error (2), without a newline, ordered
 * with `console.log` / `console.error`. Returns `true`, like Node's `write`.
 */
export function processWrite(stream: u32, s: string): bool {
  if (stream !== 2) {
    stdoutWritten();
  }
  velt_rt_write_str(stream, s);
  return true;
}

/** The value of environment variable `name`, or `undefined` if it is unset. */
export function processEnv(name: string): string | undefined {
  return getEnv(name);
}

/**
 * Node's `process.argv`: `[runtime, script, ...args]` (the running executable, the script under
 * `velt run` / `velt dev` or the executable again, then the arguments).
 */
export function processArgv(): string[] {
  return argList(true);
}

/**
 * A fresh array of the command-line arguments: Node's `process.argv` (`node`), else every
 * argument from the program path on (velt/process `argv`). By role, one argument at a time
 * (std/lang/hooks/process_argv.velt, which a native build may call in a prebuilt object): the
 * readers load only where live code reads the arguments. The environment's lock is held around
 * the calls, as their first read takes velt's variables from it (std/process/args_read.velt).
 */
@noInline
export function argList(node: bool): string[] {
  lockEnv();
  const n: u64 = hookCall("process_arg_count", node);
  const out = arrayWithCapacity<string>(n as usize);
  for (let i: u64 = 0; i < n; i++) {
    out.push(hookCall("process_arg_at", node, i));
  }
  unlockEnv();
  return out;
}

/** Node's `process.pid`: this process's id. */
export function processPid(): number {
  return processId() as number;
}

declare function velt_rt_tla_at(site: string);

/**
 * Compiler-internal: marks the top-level `await`s after it as at `site` (`path:line:col`, a
 * string literal). The compiler lowers a call to `velt_rt_tla_at(site)` where they suspend
 * instead of this call; a program that ends there writes Node's warning and exits with code 13.
 */
export function topLevelAwaitAt(site: string) {
  velt_rt_tla_at(site);
}
