// velt/lang/hooks (internal): the compiler's hooks for arrays (std-layout.md §10b): what
// `new Array(n).fill(v)` and `Array.from({ length: n }, f)` compile to (velt_sema
// `array_ctor.rs`), and the length check they share with the prelude's `length` setter.

import { arrayWithCapacity, share, trunc } from "velt/lang/intrinsics";

/**
 * An array length `n` as JS's `ArrayCreate` and `length` setter take it: a whole number from 0
 * up (else `RangeError: Invalid array length`, as in Node), and at most 2^52 - 1, the most
 * elements a Velt array holds (JS stops at 2^32 - 1; past it, the limit's `RangeError`).
 */
export function arrayLength(n: number): usize {
  if (!(n >= 0 && trunc(n) == n)) {
    panic("RangeError: Invalid array length");
  }
  if (n > 4503599627370495) {
    panic(
      "RangeError: Invalid array length: an array holds at most 2^52 - 1 elements, and its elements at most 2^52 - 1 bytes",
    );
  }
  return n as usize;
}

/**
 * `new Array<T>(n).fill(v)` (the compiler rewrites it to this, `sema` `array_ctor`): `n` copies
 * of `v` in one allocation. `n` is a length as `xs.length = n` takes it (`arrayLength`):
 * `new Array(-1)`, `new Array(1.5)` and `new Array(NaN)` are a `RangeError`, as in Node.
 */
export function arrayFilled<T>(n: number, v: T): T[] {
  const len = arrayLength(n);
  const out: T[] = arrayWithCapacity(len);
  for (let i: usize = 0; i < len; i++) {
    out.push(share(v));
  }
  return out;
}

/**
 * `new Array<T>(x).fill(v)` with an `x` that is no number (sema `array_ctor`): as in JS, an
 * array of the one element `x`, which `fill` replaces with `v`. Sema passes `x` (evaluated
 * first, then dropped) and `[v]`.
 */
export function arrayOne<X, U>(_x: X, a: U): U {
  return a;
}

/** `Array.from({ length: n }, (_, i) => f(i))`: `f(i)` for each index, throwing what `f` throws. */
export function arrayFromLength<U, E>(n: i64, f: (i: i64) => U throws E): U[] throws E {
  const out: U[] = arrayWithCapacity(n > 0 ? n as usize : 0);
  for (let i = 0; i < n; i++) {
    out.push(f(i));
  }
  return out;
}
