// velt/lang/hooks (internal): the compiler's hooks for records and prototypes (std-layout.md
// §10b): `k in r` for a key known only at run time (velt_sema `in_keys.rs`), `===` on
// prototypes, the array index a key names, which the prelude's `Record` orders its keys by, the
// record a JSON decoder makes of a map, and the map of a record's entries the generated
// comparisons compare.

import {
  PROTOTYPE_HAS_KEY,
  PROTOTYPE_SAME_AS,
  RECORD_ENTRIES_OF,
  RECORD_FROM_MAP,
  RECORD_HAS,
  RECORD_IS_NULL_PROTO,
} from "velt/lang/hooks/keys";

/** `a === b` on prototypes (or `null`, a prototype-less object's). */
export function prototypeSame(a: ObjectPrototype | null, b: ObjectPrototype | null): bool {
  if (a == null) {
    return b == null;
  }
  if (b == null) {
    return false;
  }
  return a[PROTOTYPE_SAME_AS](b);
}

/** `key in p` of a prototype `p` for a key known only at run time. */
export function prototypeIn(key: string, p: ObjectPrototype): bool {
  return p[PROTOTYPE_HAS_KEY](key);
}

/**
 * `k in r` for a key known only at run time: whether `key` names a member every object inherits
 * from `Object.prototype` (sema tests the record's own entries first).
 */
export function objectPrototypeKey(key: string): bool {
  switch (key) {
    case "__defineGetter__":
    case "__defineSetter__":
    case "__lookupGetter__":
    case "__lookupSetter__":
    case "__proto__":
    case "constructor":
    case "hasOwnProperty":
    case "isPrototypeOf":
    case "propertyIsEnumerable":
    case "toLocaleString":
    case "toString":
    case "valueOf":
      return true;
    default:
      return false;
  }
}

/**
 * `k in r` for a key known only at run time (sema calls this): whether the record has the entry
 * `key`, or `key` names a member every object inherits from `Object.prototype`.
 */
export function recordIn<V>(key: string, r: Record<string, V>): bool {
  return r[RECORD_HAS](key) || objectPrototypeKey(key);
}

/**
 * `k in r` in a program that calls `Object.create(null)` (sema calls this instead of
 * `recordIn` there): a record made by it inherits nothing from `Object.prototype`.
 */
export function recordInMaybeNullProto<V>(key: string, r: Record<string, V>): bool {
  return r[RECORD_HAS](key) || (!r[RECORD_IS_NULL_PROTO]() && objectPrototypeKey(key));
}

/** The array index `s` names (canonical decimal, 0 to 2^32 - 2), or -1. */
export function arrayIndex(s: string): i64 {
  const n = s.length as i64;
  if (n == 0 || n > 10 || (n > 1 && s.charCodeAt(0) == 48)) {
    return -1;
  }
  let v: i64 = 0;
  for (let i: i64 = 0; i < n; i++) {
    const c = s.charCodeAt(i);
    if (c < 48 || c > 57) {
      return -1;
    }
    v = v * 10 + (c - 48);
  }
  return v <= 4294967294 ? v : -1;
}

/**
 * A record of the entries of `m`, in its order (a JSON object's members in document order: the
 * decoders velt/encoding/json generates make records with it, std/encoding/json/generated.vlt).
 */
export function recordFromMap<K, V>(m: Map<K, V>): Record<K, V> {
  return Record[RECORD_FROM_MAP](m);
}

/**
 * The map of the string-keyed entries of `r`: what `deepEqual` and `toEqual` compare (the code
 * velt/lang/equal generates calls it, std/lang/equal/generated.vlt).
 */
export function recordEntriesOf<K, V>(r: Record<K, V>): Map<K, V> {
  return Record[RECORD_ENTRIES_OF](r);
}
