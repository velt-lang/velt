// velt/lang/hooks (internal): the I/O of the executor in Velt (#2649 step 2): the reactor
// (`#reactor`: kqueue on macOS, epoll on Linux) the worker waits in when it has nothing to run,
// and the sources registered with it, one per non-blocking descriptor velt/net opened
// (std/net/tcp_sched.velt).
//
// - The worker's idle wait is the reactor's (`park`): a wake from another thread (a Rust leaf
//   waking a task through its C waker, sched_task.velt `schedule`) is the reactor's own wake (an
//   `EVFILT_USER` trigger, an eventfd write), so one wait covers sockets and wakes. The wait
//   lasts until the next timer at most (`sleep`, Node's timers: sched_sleep.velt,
//   sched_order.velt; a read wait's deadline). A busy worker looks at the reactor without
//   waiting every 64 polls (`look`, from sched_run.velt `turn`).
// - A source is registered once, for both directions, edge-triggered: an event sets its
//   readiness bits and wakes its waiters; an operation that finds the socket not ready (EAGAIN)
//   clears the bit, so the next edge sets it again. Its waiters are heap futures
//   (sched_io_wait.velt), linked into the source while they wait, so any number of tasks can wait on one
//   socket and a dropped wait leaves in constant time. Completion sources are general: anything
//   that holds a source can `ready` it (C code included), as the reactor does for descriptors.
// - Handles: velt/net holds a source by a handle with the top bit set (the runtime's are
//   `generation << 32 | slot`, generations far below 2^31), its slot and generation in a table,
//   so a closed handle is EBADF, never freed memory (sched_io_table.velt).
// - Waits (sched_io_wait.velt) may have a deadline (`readableWithin`): the worker's wait then
//   lasts until the first one at most.
// - Deferred writes (`writeLater`) collect in the source's buffer and wait on the executor's due
//   list, sent at the end of each poll of a task and before the worker waits
//   (sched_io_write.velt).
//
// Workers (#2649 step 3): each worker has an I/O block of its own (its reactor, due list and
// waits); `io()` is this thread's. A source is registered with one worker's reactor (`S_IOB`) and
// follows the home worker of the task using it (#2370); the handle table is the process's, and
// a source has a lock that every operation on it and the delivery of its events hold once
// several threads run (sched_io_table.velt), since a task may run on a worker other than its
// home (a borrow, the slot for the task woken next) and several tasks may share a socket.

import { fnAddress, inline, noInline } from "velt/lang/intrinsics";
import * as r from "#reactor";
import * as m from "./sched_mem";
import * as tb from "./sched_io_table";
import * as wt from "./sched_io_wait";

/** Worker 0's I/O block (0 until the executor starts). */
const IO = new Atomic<u64>(0);
/** This thread's worker's I/O block (0: not a worker). */
const IO_HERE = new ThreadLocal<u64>(0);

/**
 * The I/O block: the reactor, the due list, the sources registered with the reactor (changed
 * atomically: a source that follows its task leaves from another thread), the address of the
 * executor's I/O tick (sched_task.velt `E_TICK`, set to 1 when a write is due), the waiters'
 * poll and drop.
 */
export const IO_REACTOR: usize = 0;
export const IO_DUE: usize = 8;
export const IO_LIVE: usize = 48;
export const IO_TICK_AT: usize = 56;
/** The polls of a busy worker between two looks at the reactor. */
export const TICKS: usize = 64;
export const IO_WAIT_POLL: usize = 64;
export const IO_WAIT_DROP: usize = 72;
export const IO_TIMERS: usize = 80;
/**
 * Waits linked into a source by this worker's thread, less those its thread unlinked (a wait may
 * be linked on one worker and woken on another): summed over the workers, pending I/O, which
 * keeps the process alive (sched_end.velt).
 */
export const IO_WAITING: usize = 88;
/**
 * The reactor's lock (its wait and the delivery of what it found; the stall monitor's turn for a
 * stalled worker only tries it), and the sources made due from another thread (the monitor's
 * turn: a stack the worker's `flushDue` takes).
 */
export const IO_RLOCK: usize = 96;
export const IO_RDUE: usize = 104;
const IO_SIZE: usize = 112;

/** A source's fields. */
export const S_FD: usize = 0;
export const S_READY: usize = 8;
export const S_FLAGS: usize = 12;
export const S_WAITERS: usize = 16;
export const S_BUF: usize = 24;
export const S_OFF: usize = 32;
export const S_LEN: usize = 40;
export const S_CAP: usize = 48;
export const S_QUEUED: usize = 56;
export const S_WRITTEN: usize = 64;
export const S_DUE_NEXT: usize = 72;
export const S_ERR: usize = 80;
/**
 * Whether its lock is taken (sched_io_table.velt `lock`): sources are shared, set as it is made,
 * kept when it is reset (the table's `share` comes before the first source).
 */
export const S_LOCKED: usize = 84;
export const S_CARRY: usize = 96;
export const S_CARRY_LEN: usize = 100;
/**
 * Its lock (sched_io_table.velt), its generation, the I/O block of the reactor it is registered
 * with, its slot in the handle table, the next free source.
 */
export const S_LOCK: usize = 104;
export const S_GEN: usize = 108;
export const S_IOB: usize = 112;
export const S_SLOT: usize = 120;
export const S_FREE: usize = 128;
/**
 * The task that uses it (sched_io_table.velt `follow`): 0 none yet, `SHARED` once a second task
 * did (a pooled connection), whose source stays where it is.
 */
export const S_TASK: usize = 136;
export const SHARED: usize = 1;
export const S_SIZE: usize = 144;

/** Readiness bits (the reactor's). */
export const READ: u32 = 1;
export const WRITE: u32 = 2;
export const HUP: u32 = 4;
export const ERR: u32 = 8;

/**
 * A source's flags: on the due list; shut down writing once the buffer is sent (and done so);
 * close the descriptor once the buffer is sent; aborted; a listener.
 */
export const F_DUE: u32 = 1;
export const F_SHUT: u32 = 2;
export const F_SHUT_DONE: u32 = 4;
export const F_CLOSING: u32 = 8;
export const F_ABORTED: u32 = 16;
export const F_LISTENER: u32 = 32;

/**
 * What a waiter waits for: readable, writable (a connect), its bytes written (`arg`: the count
 * of bytes queued in all that must have been sent), at most `arg` bytes still to send.
 */
export const K_READ: u32 = 0;
export const K_WRITE: u32 = 1;
export const K_WRITTEN: u32 = 2;
export const K_DRAINED: u32 = 3;

/**
 * This thread's worker's I/O block, made by the executor at its start; off the workers worker
 * 0's (0 before the executor starts, and on a JS host).
 */
@inline
export function io(): usize {
  const b = IO_HERE.get();
  if (b !== 0) {
    return b as usize;
  }
  return IO.load("relaxed") as usize;
}

/** Makes `b` this thread's I/O block (a worker thread's start). */
export function installHere(b: usize): void {
  IO_HERE.set(b as u64);
}

/**
 * Makes an I/O block: the reactor, an empty table; `tickAt` is the worker's I/O tick. The first
 * is worker 0's.
 */
export function open(tickAt: usize): usize {
  const b = m.lastingZeroed(IO_SIZE);
  m.st(b + IO_TICK_AT, tickAt);
  m.st(tickAt, TICKS);
  m.st(b + IO_REACTOR, r.open());
  m.st(b + IO_WAIT_POLL, fnAddress(wt.waitPoll));
  m.st(b + IO_WAIT_DROP, fnAddress(wt.waitDrop));
  if (IO.load("relaxed") === 0) {
    IO.store(b as u64, "release");
    IO_HERE.set(b as u64);
  }
  return b;
}

/** Do sockets run on the reactor (an OS with one, and it opened)? */
export function supported(): bool {
  const b = io();
  return r.SUPPORTED && b !== 0 && m.ld(b + IO_REACTOR) !== 0;
}

/** Wakes the worker waiting in `park` (from any thread). */
export function wake(b: usize): void {
  r.wake(m.ld(b + IO_REACTOR));
}

/**
 * The worker has nothing to run (its park word is up, sched_run.velt): waits for events or a
 * wake, until the first deadline of a wait or `timeoutMs` (the timers', -1: none) at most, and
 * delivers the events.
 */
@noInline
export function park(b: usize, timeoutMs: i64): void {
  if (m.ld(b + IO_REACTOR) === 0) {
    panic("the executor's reactor did not open: it has nothing to wait in");
  }
  let ms = wt.expire(b);
  if (timeoutMs >= 0 && (ms < 0 || timeoutMs < ms)) {
    ms = timeoutMs;
  }
  wait(b, ms);
  if (m.ld(b + IO_TIMERS) !== 0) {
    wt.expire(b);
  }
}

/** The events ready now and deadlines passed, delivered without waiting (a busy worker's look). */
export function look(b: usize): void {
  wait(b, 0);
  if (m.ld(b + IO_TIMERS) !== 0) {
    wt.expire(b);
  }
}

/** Waits up to `timeoutMs` (-1: no limit) and delivers the events. */
function wait(b: usize, timeoutMs: i64): void {
  const rb = m.ld(b + IO_REACTOR);
  if (rb === 0) {
    return;
  }
  const shared = tb.shared();
  if (shared) {
    m.spinLock(b + IO_RLOCK);
  }
  const n = r.wait(rb, timeoutMs);
  deliver(rb, n);
  if (shared) {
    m.store32(b + IO_RLOCK, 0);
  }
}

/** Delivers the `n` events the last wait of reactor `rb` found: whether one was the wake. */
function deliver(rb: usize, n: usize): bool {
  let woken = false;
  for (let i: usize = 0; i < n; i++) {
    const s = r.source(rb, i);
    if (s !== 0) {
      tb.lock(s);
      ready(s, r.bits(rb, i));
      tb.unlock(s);
    } else {
      woken = true;
    }
  }
  return woken;
}

/**
 * A turn of the reactor of I/O block `b` for its worker, stalled (the stall monitor's thread,
 * sched_monitor.velt): the events of its sockets, without waiting, unless the worker is in its
 * reactor itself. Its own wake is posted again: the worker, once it runs, must not sleep on with
 * the wake spent.
 */
export function turnFor(b: usize): void {
  const rb = m.ld(b + IO_REACTOR);
  if (rb === 0 || m.cas32(b + IO_RLOCK, 0, 1) !== 0) {
    return;
  }
  const woken = deliver(rb, r.wait(rb, 0));
  m.store32(b + IO_RLOCK, 0);
  if (woken) {
    r.wake(rb);
  }
}

/**
 * Source `s` (locked) became ready for `bits`: its waiters are woken; a writable one with bytes to send
 * goes on the due list, which the worker sends after the wait (sched_io_write.velt).
 */
export function ready(s: usize, bits: u32): void {
  m.st32(s + S_READY, m.ld32(s + S_READY) | bits);
  if ((bits & (WRITE | ERR | HUP)) !== 0 && m.ld(s + S_LEN) !== 0) {
    due(s);
  }
  wt.wakeAll(s);
}

/**
 * Puts source `s` (locked) on this worker's due list, once; from a thread with no reactor (the
 * stall monitor), on the due stack of the worker whose reactor has it.
 */
@inline
export function due(s: usize): void {
  const fl = m.ld32(s + S_FLAGS);
  if ((fl & F_DUE) === 0) {
    m.st32(s + S_FLAGS, fl | F_DUE);
    const b = io();
    if (m.ld(b + IO_REACTOR) === 0) {
      dueFrom(s);
      return;
    }
    m.st(s + S_DUE_NEXT, m.ld(b + IO_DUE));
    m.st(b + IO_DUE, s);
    // The poll's end looks at the I/O block (the tick's next count is 0).
    m.st(m.ld(b + IO_TICK_AT), 1);
  }
}

/** Has I/O block `b` sources due (on its list, or made due from another thread)? */
@inline
export function anyDue(b: usize): bool {
  return (m.ld(b + IO_DUE) | m.load(b + IO_RDUE)) !== 0;
}

@noInline
function dueFrom(s: usize): void {
  const b = m.ld(s + S_IOB);
  m.pushStack(b + IO_RDUE, s, S_DUE_NEXT);
  m.st(m.ld(b + IO_TICK_AT), 1);
}

/** An I/O block with no reactor, for a thread that only delivers events (the stall monitor). */
export function openBare(): usize {
  const b = m.lastingZeroed(IO_SIZE);
  installHere(b);
  return b;
}

/**
 * Registers descriptor `fd` with `flags`, ready for `ready` until an operation finds otherwise
 * (the first read or write of a connected socket tries at once), with this worker's reactor: its
 * source, or 0 with `errno` set (the reactor refused it, or the table is full).
 */
export function register(fd: i32, flags: u32, ready: u32): usize {
  const s = tb.take();
  if (s === 0) {
    return 0;
  }
  m.st(s + S_FD, fd as usize);
  m.st32(s + S_READY, ready);
  m.st32(s + S_FLAGS, flags);
  const b = io();
  m.st(s + S_IOB, b);
  const e = r.add(m.ld(b + IO_REACTOR), fd, s);
  if (e !== 0) {
    tb.bump(s);
    tb.unlock(s);
    tb.give(s);
    return 0;
  }
  m.inc(b + IO_LIVE);
  tb.unlock(s);
  return s;
}

/**
 * Frees source `s` (locked; its descriptor closed, nothing waiting, nothing to send): reset, its
 * handles dead, back to the table's free list (its lock stays the caller's to give back).
 */
export function free(s: usize): void {
  m.dec(m.ld(s + S_IOB) + IO_LIVE);
  wt.wakeAll(s);
  const buf = m.ld(s + S_BUF);
  if (buf !== 0) {
    m.release(buf, m.ld(s + S_CAP));
  }
  tb.bump(s);
  m.st(s + S_FD, 0);
  m.st32(s + S_READY, 0);
  m.st32(s + S_FLAGS, 0);
  m.st(s + S_BUF, 0);
  m.st(s + S_OFF, 0);
  m.st(s + S_LEN, 0);
  m.st(s + S_CAP, 0);
  m.st(s + S_QUEUED, 0);
  m.st(s + S_WRITTEN, 0);
  m.st(s + S_DUE_NEXT, 0);
  m.st32(s + S_ERR, 0);
  m.st32(s + S_CARRY, 0);
  m.st32(s + S_CARRY_LEN, 0);
  m.st(s + S_IOB, 0);
  m.st(s + S_TASK, 0);
  tb.give(s);
}

/** Clears readiness `bit` of `s`: an operation found the socket not ready (EAGAIN). */
@inline
export function notReady(s: usize, bit: u32): void {
  m.st32(s + S_READY, m.ld32(s + S_READY) & ~bit);
}

/** Wakes every waiter of `s`; each polls again and waits again when it must. */
