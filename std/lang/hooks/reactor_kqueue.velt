// velt/lang/hooks (internal): the executor's reactor on macOS (sched_io.velt, #2649 step 2):
// kqueue. A socket is registered once, for reading and writing, edge-triggered (`EV_CLEAR`), with
// its source (sched_io.velt) as the event's `udata`; the worker's idle wait is a `kevent` wait,
// and a wake from another thread triggers an `EVFILT_USER` event (ident 0, `udata` 0).
//
// Also the few OS calls a non-blocking socket needs whose details differ per OS: `errno`, making
// a descriptor non-blocking and close-on-exec, keeping a write to a closed peer from raising
// SIGPIPE. `fcntl` is variadic and `declare c` has no `CVarArgs` yet (docs/internals/design/
// c-ffi.md): it is the compiler's system function, which passes the argument where each
// architecture reads it.
//
// Pointers are `Ptr`s and integers the C types', as in a program's own declarations of these
// symbols: one C symbol has one signature in a program. Addresses become `Ptr`s with `m.ptr`.

import { Ptr } from "velt/ffi/ptr";
import * as m from "./sched_mem";

/** Does this OS have the reactor? (The default variant has not: sockets stay the runtime's.) */
export const SUPPORTED: bool = true;

export const EAGAIN: i32 = 35;
export const EINPROGRESS: i32 = 36;
export const EINTR: i32 = 4;
/** `CLOCK_MONOTONIC`. */
export const MONOTONIC: i32 = 6;
/** `send`'s flags: none (SIGPIPE is off per socket, `SO_NOSIGPIPE`). */
export const SEND_FLAGS: i32 = 0;
/** `socket`'s extra type flags: none on macOS (`prepare` sets them). */
export const SOCKET_FLAGS: i32 = 0;
/** `sysconf`'s name of the online cores (`_SC_NPROCESSORS_ONLN`; 0: none). */
export const SC_NPROCESSORS_ONLN: i32 = 58;

// Readiness bits of an event (sched_io.velt).
const READ: u32 = 1;
const WRITE: u32 = 2;
const HUP: u32 = 4;
const ERR: u32 = 8;

const EVFILT_READ: i16 = -1;
const EVFILT_WRITE: i16 = -2;
const EVFILT_USER: i16 = -10;
const EV_ADD: u16 = 0x1;
const EV_DELETE: u16 = 0x2;
const EV_CLEAR: u16 = 0x20;
const EV_ERROR: u16 = 0x4000;
const EV_EOF: u16 = 0x8000;
const NOTE_TRIGGER: u32 = 0x01000000;
const EVFILT_PROC: i16 = -5;
const EV_ONESHOT: u16 = 0x10;
const NOTE_EXIT: u32 = 0x80000000;
/** `ESRCH`: no such process (it exited and was reaped already, or never was). */
const ESRCH: i32 = 3;

const F_SETFD: i32 = 2;
const F_SETFL: i32 = 4;
const FD_CLOEXEC: i32 = 1;
const O_NONBLOCK: i32 = 4;
const SOL_SOCKET: i32 = 0xffff;
const SO_NOSIGPIPE: i32 = 0x1022;

/** Events one wait takes at most. */
const MAX_EVENTS: usize = 64;
/** A `struct kevent`: ident, filter i16, flags u16, fflags u32, data, udata. */
const EV: usize = 32;

// The reactor's block: the kqueue, the events of the last wait, a timespec, a change record.
const R_KQ: usize = 0;
const R_TS: usize = 8;
const R_CHANGE: usize = 24;
/** `wake`'s change record (a trigger of the user event), read only. */
const R_TRIGGER: usize = 56;
const R_EVENTS: usize = 88;
const R_SIZE: usize = 88 + 64 * 32;

declare c("c") function kqueue(): i32;
declare c("c") function kevent(
  kq: i32,
  changes: Ptr<u8>,
  nchanges: i32,
  events: Ptr<u8>,
  nevents: i32,
  timeout: Ptr<u8>,
): i32;
declare system function fcntl(fd: i32, cmd: i32, arg: i32): i32;
declare c("c") function setsockopt$io(
  fd: i32,
  level: i32,
  name: i32,
  value: Ptr<u8>,
  len: u32,
): i32;
// The signature the compiler calls it with for `lastOsError()` (velt_vir system/posix.rs): one
// C symbol has one signature in a program.
declare c("c") function __error(): Ptr<i32>;
declare c("c") function accept$io(fd: i32, addr: Ptr<u8>, len: Ptr<u8>): i32;
declare c("c") function close$io(fd: i32): i32;

/** The calling thread's `errno`. */
export function errno(): i32 {
  // SAFETY: `__error` returns the thread's errno slot.
  return m.ld32(Ptr.addressOf(unsafe { __error() })) as i32;
}

/** A new reactor: its block, or 0 when the OS refused a kqueue. */
export function open(): usize {
  // SAFETY: no precondition.
  const kq = unsafe { kqueue() };
  if (kq < 0) {
    return 0;
  }
  const r = m.lastingZeroed(R_SIZE);
  m.st(r + R_KQ, kq as usize);
  // The wake: a user event, cleared when a wait takes it.
  change(r, 0, EVFILT_USER, EV_ADD | EV_CLEAR, 0, 0);
  // SAFETY: one change record in the block; no events wanted.
  unsafe {
    kevent(kq, m.ptr(r + R_CHANGE), 1, m.ptr(0), 0, m.ptr(0));
  }
  m.st(r + R_TRIGGER, 0);
  m.st32(r + R_TRIGGER + 8, ((EVFILT_USER as u16) as u32));
  m.st32(r + R_TRIGGER + 12, NOTE_TRIGGER);
  m.st(r + R_TRIGGER + 16, 0);
  m.st(r + R_TRIGGER + 24, 0);
  return r;
}

/** Fills the block's change record. */
function change(r: usize, ident: usize, filter: i16, flags: u16, fflags: u32, udata: usize): void {
  const c = r + R_CHANGE;
  m.st(c, ident);
  m.st32(c + 8, ((filter as u16) as u32) | ((flags as u32) << 16));
  m.st32(c + 12, fflags);
  m.st(c + 16, 0);
  m.st(c + 24, udata);
}

/**
 * Registers `fd` for both directions, edge-triggered, with `source` its events' tag; 0 or errno.
 * From any thread (a source follows its task to another worker's reactor): the change records
 * are the caller's own.
 */
export function add(r: usize, fd: i32, source: usize): i32 {
  return changeBoth(r, fd, EV_ADD | EV_CLEAR, source);
}

/** Takes `fd` out of reactor `r` (from any thread): its events come to another reactor now. */
export function del(r: usize, fd: i32): void {
  changeBoth(r, fd, EV_DELETE, 0);
}

/** One change of both filters of `fd` with `flags`, in records of the caller's; 0 or errno. */
function changeBoth(r: usize, fd: i32, flags: u16, source: usize): i32 {
  const c = m.zeroed(2 * EV);
  m.st(c, fd as usize);
  m.st32(c + 8, ((EVFILT_READ as u16) as u32) | ((flags as u32) << 16));
  m.st(c + 24, source);
  m.copy(c + EV, c, EV);
  m.st32(c + EV + 8, ((EVFILT_WRITE as u16) as u32) | ((flags as u32) << 16));
  // SAFETY: two change records at `c`.
  const n = unsafe { kevent(m.ld(r + R_KQ) as i32, m.ptr(c), 2, m.ptr(0), 0, m.ptr(0)) };
  m.release(c, 2 * EV);
  return n < 0 ? errno() : 0;
}

/**
 * Waits for events, at most `timeoutMs` milliseconds (-1: until one comes, 0: only those ready):
 * how many the block holds now (`source`, `bits`).
 */
export function wait(r: usize, timeoutMs: i64): usize {
  let ts: usize = 0;
  if (timeoutMs >= 0) {
    ts = r + R_TS;
    m.st(ts, (timeoutMs / 1000) as usize);
    m.st(ts + 8, ((timeoutMs % 1000) * 1000000) as usize);
  }
  const kq = m.ld(r + R_KQ) as i32;
  const events = m.ptr(r + R_EVENTS);
  // SAFETY: the block has room for MAX_EVENTS events and the timespec.
  const n = unsafe { kevent(kq, m.ptr(0), 0, events, MAX_EVENTS as i32, m.ptr(ts)) };
  return n < 0 ? 0 : n as usize;
}

/** The source of event `i` of the last wait (0: the wake). */
export function source(r: usize, i: usize): usize {
  return m.ld(r + R_EVENTS + i * EV + 24);
}

/** The readiness bits of event `i` of the last wait. */
export function bits(r: usize, i: usize): u32 {
  const e = r + R_EVENTS + i * EV;
  const fw = m.ld32(e + 8);
  const filter = (fw & 0xffff) as u16;
  const flags = (fw >> 16) as u16;
  if (filter === (EVFILT_WRITE as u16)) {
    // The end of the write side (this side shut it down, or the peer reset): a send reports it.
    return WRITE;
  }
  let b: u32 = READ;
  if ((flags & EV_EOF) !== 0) {
    b = b | HUP;
  }
  if ((flags & EV_ERROR) !== 0) {
    b = b | ERR;
  }
  return b;
}

/**
 * Does `exitFd` give a descriptor to close? Not here: the exit is watched by process id
 * (`EVFILT_PROC`).
 */
export const EXIT_FD_OWNED: bool = false;

/** What `watchExit` watches for child `pid`: the process id itself (no descriptor). */
export function exitFd(pid: i32): i32 {
  return pid;
}

/**
 * Watches for the exit of the child `exit` names (`exitFd`'s: its process id), one event tagged `source` once it has
 * exited (a read with the end of input); 0, `ESRCH` when it has exited already, or errno.
 */
export function watchExit(r: usize, exit: i32, source: usize): i32 {
  const c = m.zeroed(EV);
  m.st(c, exit as usize);
  m.st32(c + 8, ((EVFILT_PROC as u16) as u32) | (((EV_ADD | EV_ONESHOT) as u32) << 16));
  m.st32(c + 12, NOTE_EXIT);
  m.st(c + 24, source);
  // SAFETY: one change record at `c`.
  const n = unsafe { kevent(m.ld(r + R_KQ) as i32, m.ptr(c), 1, m.ptr(0), 0, m.ptr(0)) };
  m.release(c, EV);
  if (n < 0) {
    return errno();
  }
  return 0;
}

/** `watchExit`'s answer for a child that has exited already. */
export const EXITED: i32 = ESRCH;

/**
 * `posix_spawnattr_setflags`' extra flags for a child process: `POSIX_SPAWN_CLOEXEC_DEFAULT`, so
 * the child gets only the descriptors its file actions name (macOS has no `pipe2`: a pipe made
 * by another thread at the same time may not be close-on-exec yet).
 */
export const SPAWN_FLAGS: i16 = 0x4000;

declare c("c") function pipe$io(fds: Ptr<u8>): i32;
declare c("c") function posix_spawn_file_actions_addinherit_np(fa: Ptr<u8>, fd: i32): i32;

/** A pipe at `fds` (read end, write end), both close-on-exec; 0, or -1 with `errno` set. */
export function pipeCloexec(fds: usize): i32 {
  // SAFETY: room for two descriptors.
  if (unsafe { pipe$io(m.ptr(fds)) } !== 0) {
    return -1;
  }
  fcntl(m.ld32(fds) as i32, F_SETFD, FD_CLOEXEC);
  fcntl(m.ld32(fds + 4) as i32, F_SETFD, FD_CLOEXEC);
  return 0;
}

/** Keeps descriptor `fd` the child's (`SPAWN_FLAGS` closes the others) in file actions `fa`. */
export function spawnInherit(fa: usize, fd: i32): void {
  // SAFETY: `fa` is an initialized file-actions object.
  unsafe {
    posix_spawn_file_actions_addinherit_np(m.ptr(fa), fd);
  }
}

/** Wakes the worker waiting in `wait` (from any thread). */
export function wake(r: usize): void {
  // The block's trigger record, which no one writes after `open` (no allocation: a thread may
  // wake a worker while the process ends).
  // SAFETY: one change record.
  unsafe {
    kevent(m.ld(r + R_KQ) as i32, m.ptr(r + R_TRIGGER), 1, m.ptr(0), 0, m.ptr(0));
  }
}

/** Accepts a connection of listener `fd`, non-blocking and close-on-exec: its fd, or -1. */
export function accept(fd: i32, addr: usize, len: usize): i32 {
  // SAFETY: `addr` holds the `socklen_t` at `len` bytes.
  const s = unsafe { accept$io(fd, m.ptr(addr), m.ptr(len)) };
  if (s >= 0 && prepare(s) !== 0) {
    // SAFETY: the descriptor accept returned, not used after.
    unsafe {
      close$io(s);
    }
    return -1;
  }
  return s;
}

/** Makes a new socket non-blocking, close-on-exec, and SIGPIPE-free; 0 or errno. */
export function prepare(fd: i32): i32 {
  if (fcntl(fd, F_SETFL, O_NONBLOCK) < 0 || fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
    return errno();
  }
  const one = m.alloc(16);
  m.st32(one, 1);
  // SAFETY: an int option, in `one`.
  unsafe {
    setsockopt$io(fd, SOL_SOCKET, SO_NOSIGPIPE, m.ptr(one), 4);
  }
  m.release(one, 16);
  return 0;
}

/** `UL_COMPARE_AND_WAIT | ULF_NO_ERRNO`: wait while the 32-bit word holds the value. */
const COMPARE_AND_WAIT: u32 = 0x01000001;

declare c("c") function __ulock_wait(op: u32, addr: Ptr<u8>, value: u64, timeoutUs: u32): i32;
declare c("c") function __ulock_wake(op: u32, addr: Ptr<u8>, wakeValue: u64): i32;

/**
 * Sleeps while the `u32` at `word` is `expected` (a lock's waiters: sched_module.velt); it may
 * return early, so the caller looks again.
 */
export function wordWait(word: usize, expected: u32): void {
  // SAFETY: `word` is an aligned word that lives as long as the process.
  unsafe {
    __ulock_wait(COMPARE_AND_WAIT, m.ptr(word), expected as u64, 0);
  }
}

/**
 * `wordWait` for at most `us` microseconds (the stall monitor's nap, cut short by a wake).
 */
export function wordWaitFor(word: usize, expected: u32, us: u32): void {
  // SAFETY: as `wordWait`.
  unsafe {
    __ulock_wait(COMPARE_AND_WAIT, m.ptr(word), expected as u64, us);
  }
}

/** Wakes one thread sleeping on the `u32` at `word`, if any. */
export function wordWake(word: usize): void {
  // SAFETY: as `wordWait`.
  unsafe {
    __ulock_wake(COMPARE_AND_WAIT, m.ptr(word), 0);
  }
}

declare c("c") function pthread_self(): usize;
declare c("c") function pthread_mach_thread_np(thread: usize): u32;
declare c("c") function thread_info(thread: u32, flavor: i32, info: Ptr<u8>, count: Ptr<u8>): i32;

/** `THREAD_BASIC_INFO` and its count of `int`s (user and system time, then six more). */
const THREAD_BASIC_INFO: i32 = 3;
const THREAD_BASIC_INFO_COUNT: u32 = 10;

/**
 * This thread's CPU-time clock (its Mach port), which `threadCpu` reads from any thread (the
 * stall monitor: a worker the OS took off its core is not stalled in a poll); 0 when there is
 * none.
 */
export function threadClock(): u64 {
  // SAFETY: the calling thread's own handle and port, valid while it runs.
  const port = unsafe { pthread_mach_thread_np(pthread_self()) };
  return port === 0 ? 0 : (port as u64) | 0x100000000;
}

/** The CPU time of the thread whose `threadClock` is `c` (nanoseconds; 0: unknown). */
export function threadCpu(c: u64): u64 {
  if (c === 0) {
    return 0;
  }
  // The monitor's own buffer (it reads the clock while the process may end).
  const info = m.scratch();
  for (let i: usize = 0; i < 48; i += 8) {
    m.st(info + i, 0);
  }
  m.st32(info + 40, THREAD_BASIC_INFO_COUNT);
  const port = (c & 0xffffffff) as u32;
  let rc: i32 = 0;
  // SAFETY: `info` has room for a `thread_basic_info` and its count after it.
  unsafe {
    rc = thread_info(port, THREAD_BASIC_INFO, m.ptr(info), m.ptr(info + 40));
  }
  let ns: u64 = 0;
  if (rc === 0) {
    const secs = (m.ld32(info) + m.ld32(info + 8)) as u64;
    const us = (m.ld32(info + 4) + m.ld32(info + 12)) as u64;
    ns = secs * 1000000000 + us * 1000;
  }
  return ns;
}

/** Does an operation that finds a socket not ready call `rearm`? No: events come by edge. */
export const REARMS: bool = false;

/** Nothing to ask again: the next edge reports the socket ready. */
export function rearm(r: usize, fd: i32, source: usize, bits: u32): void {}
