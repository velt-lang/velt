// velt/lang/hooks (internal): a spawned task's join handle in the executor in Velt (sched.velt,
// #2649): its poll and drop (a heap future's header in the task's block, `T_JOIN`, which C calls
// on any thread), its slot's lock (sched_make.velt `lockJoin`), and the end of the slot when the
// task's root is done (sched_run.velt `rootDone`) or panicked under a catch (`rootPanicked`,
// sched_node_catch.velt).

import { export as cExport } from "velt/ffi";
import { exportedAddress, fnAddress, inline, noInline, stateDrop } from "velt/lang/intrinsics";
import * as lk from "./sched_lock";
import * as m from "./sched_mem";
import * as mk from "./sched_make";
import * as nc from "./sched_node_catch";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

declare function velt_rt_flush(): void;
declare function velt_rt_exit(code: i32): never;

/**
 * `rootDone`'s join slot of task `k` while other threads may reach it: the operation of kind
 * `kind` (sched_lock.velt `kind`, which `rootDone` read; a lazy one ends there, in line).
 */
@noInline
export function joinDone(e: usize, k: usize, kind: u32): void {
  const s = mk.lockJoin(k, kind);
  const joiner = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, 0);
  mk.unlockJoin(k, s | t.J_DONE, kind);
  if (joiner !== 0) {
    // Behind the tasks queued already, not in the slot for the task to run next: a join of many
    // tasks (`Promise.all` of spawns) then polls once for the many that finished meanwhile.
    // A poll runs with no dispatch under way (a reactor turn's or timers' wakes poll nothing).
    m.st32(e + t.E_DISPATCH, t.D_OUTPUT);
    m.wakeOwned(joiner);
    m.st32(e + t.E_DISPATCH, 0);
  }
  if ((s & t.J_HANDLE) === 0) {
    dropResult(k);
  }
}

/** Drops task `k`'s result in its slot, which nobody claimed. */
export function dropResult(k: usize): void {
  const rdrop = m.ld(k + t.T_RESULT_DROP);
  if (rdrop !== 0 && (m.load32(k + t.T_JOIN_STATE) & nc.J_PANICKED) === 0) {
    dropWith(k, rdrop);
  }
}

/**
 * `dropResult` with drop glue `rdrop`. The caller holds a reference to `k` (the join handle's, or
 * the executor's while `k`'s root finishes) until the glue returns; a rejection the glue reports
 * ends the program instead, which gives that reference back first (sched_exit.velt).
 */
@noInline
function dropWith(k: usize, rdrop: usize): void {
  const e = t.here();
  let was: usize = 0;
  if (e !== 0) {
    was = m.ld(e + t.E_DROPPING);
    m.st(e + t.E_DROPPING, k);
  }
  // SAFETY: the slot holds the result, which `rdrop` is the drop glue of.
  unsafe {
    stateDrop(rdrop, k + t.T_SLOT);
  }
  if (e !== 0) {
    m.st(e + t.E_DROPPING, was);
  }
}

/**
 * A join handle's poll (C calls it through the handle's header, on any thread): ready once the
 * task's root is done, else its waker waits in the join slot.
 */
@cExport("std_sched_join_poll")
export function joinPoll(f: usize, cx: usize): u32 {
  if (lk.mode() === lk.LK_NONE) {
    return joinPollAs(f, cx, lk.LK_NONE);
  }
  return joinPollLocking(f, cx);
}

/**
 * A join handle's poll with one thread at the executor (sched_task.velt `E_SOLO`, sched_lock.velt
 * `LK_NONE`, which never changes): no lock, no test (`mk.task` gives a solo worker's tasks these).
 */
@cExport("std_sched_join_poll_solo")
export function joinPollSolo(f: usize, cx: usize): u32 {
  return joinPollAs(f, cx, lk.LK_NONE);
}

/** A join handle's drop with one thread at the executor (as `joinPollSolo`). */
@cExport("std_sched_join_drop_solo")
export function joinDropSolo(f: usize): void {
  joinDropAs(f, lk.LK_NONE);
}

/**
 * A join handle's poll for the tasks of a lazy worker 0 (sched_lock.velt `LK_LAZY`; `mk.task`
 * gives them these): the operation counted in line, without `joinPoll`'s test and call. Right in
 * every mode: once the monitor turned the locks on (`locksOn`), `kind` answers `LK_ON` and the
 * slot is locked, as `joinPoll`'s; after a relax (sched_relax.velt) it counts again.
 */
@cExport("std_sched_join_poll_lazy")
export function joinPollLazy(f: usize, cx: usize): u32 {
  return joinPollAs(f, cx, lk.kind());
}

/** A join handle's drop for the tasks of a lazy worker 0 (as `joinPollLazy`). */
@cExport("std_sched_join_drop_lazy")
export function joinDropLazy(f: usize): void {
  joinDropAs(f, lk.kind());
}

/**
 * A join handle's poll for a task a thread that isn't a worker spawned (sched_foreign.velt, #3085):
 * its slot always locks, in any lock mode.
 */
@cExport("std_sched_join_poll_foreign")
export function joinPollForeign(f: usize, cx: usize): u32 {
  return joinPollAs(f, cx, lk.LK_ON);
}

/** A join handle's drop for such a task (as `joinPollForeign`). */
@cExport("std_sched_join_drop_foreign")
export function joinDropForeign(f: usize): void {
  joinDropAs(f, lk.LK_ON);
}

/** Is `f` a spawned task's join handle (its header a task's `T_JOIN`)? */
export function isJoin(f: usize): bool {
  const poll = m.ld(f);
  // SAFETY: an `@export`ed function (only its address is read).
  const polls = unsafe { exportedAddress(joinPoll) };
  // SAFETY: as above.
  const solo = unsafe { exportedAddress(joinPollSolo) };
  // SAFETY: as above.
  const lazy = unsafe { exportedAddress(joinPollLazy) };
  // SAFETY: as above.
  const foreign = unsafe { exportedAddress(joinPollForeign) };
  return (
    poll === polls ||
    poll === solo ||
    poll === lazy ||
    poll === foreign ||
    poll === fnAddress(joinPanicked)
  );
}

/**
 * `rootDone`'s join slot of task `k` at a lazy worker 0 (sched_lock.velt `LK_LAZY`, the operation
 * of kind `kind` counted): no lock, in line; the joiner is woken behind the tasks queued already,
 * as `joinDone`'s.
 */
@inline
export function joinDoneLazy(e: usize, k: usize, kind: u32): void {
  const s = m.ld32(k + t.T_JOIN_STATE);
  const joiner = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, 0);
  m.st32(k + t.T_JOIN_STATE, (s | t.J_DONE) & ~t.J_LOCK);
  lk.done(kind);
  if (joiner !== 0) {
    m.st32(e + t.E_DISPATCH, t.D_OUTPUT);
    m.wakeOwned(joiner);
    m.st32(e + t.E_DISPATCH, 0);
  }
  if ((s & t.J_HANDLE) === 0) {
    dropResult(k);
  }
}

/** `joinPoll` while other threads may reach the slot (or a lazy worker 0 counts its operation). */
@noInline
function joinPollLocking(f: usize, cx: usize): u32 {
  return joinPollAs(f, cx, lk.kind());
}

/** `joinPoll`, the operation of kind `kind` (sched_lock.velt). */
@inline
function joinPollAs(f: usize, cx: usize, kind: u32): u32 {
  const k = f - t.T_JOIN;
  const s = mk.lockJoin(k, kind);
  if ((s & t.J_DONE) !== 0) {
    if ((s & nc.J_PANICKED) !== 0) {
      // Called through the header read before the root panicked. A joiner that read it just
      // before the switch polls again through the new one, `joinPanicked`, which raises the
      // panic: woken once for that. A caller that calls this poll again anyway kept it (the
      // runtime's shared-promise hub, velt_rt task/shared.rs, calls the poll it found when the
      // promise was shared): answering pending again would spin for ever, and this `@export`
      // frame can't unwind to a catch, so the panic ends the process as an uncaught one does
      // (its message was printed when it panicked).
      if ((s & nc.J_STALE) === 0) {
        mk.unlockJoin(k, s | nc.J_STALE, kind);
        m.wakeByRef(m.ld(cx + 8));
        return 0;
      }
      mk.unlockJoin(k, s | t.J_CLAIMED, kind);
      uncaught();
    }
    mk.unlockJoin(k, s | t.J_CLAIMED, kind);
    return 1;
  }
  const old = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, m.wakerClone(m.ld(cx + 8)));
  mk.unlockJoin(k, s, kind);
  if (old !== 0) {
    m.wakerDrop(old);
  }
  return 0;
}

/**
 * Task `k`'s root panicked with exception `x` (the message) under a catch (sched_run.velt
 * `pollRootCaught`): done with no result (nothing transferred, copied or dropped: the join word's
 * `J_PANICKED` says so), its state abandoned (the task is never freed: a leaf in it may still wake
 * it), `x` kept for a join, which raises the panic again; with nobody joining it, the panic ends
 * there. The same on a solo worker (`joinPollSolo`'s tasks) as with other threads.
 */
@noInline
export function rootPanicked(e: usize, k: usize, x: usize): void {
  m.st(k + t.T_POLL, x);
  m.inc(k + t.T_REFS);
  t.flags(k, t.ROOT_DONE | nc.T_PANICKED, 0);
  if (lk.mode() === lk.LK_ON) {
    // The slot ends at the poll's end, as a finished root's (`polledFlags`).
    m.or32(k + t.T_FLAGS, t.JOIN_DUE);
    return;
  }
  panickedEnd(e, k, kindFor(k));
}

/**
 * The kind of an operation on task `k`'s join slot: the lock mode's (sched_lock.velt `kind`), but
 * always locked for a task a thread that isn't a worker spawned (`J_FOREIGN`, sched_foreign.velt,
 * #3085), whose handle that thread may drop while the task ends on a worker.
 */
export function kindFor(k: usize): u32 {
  if ((m.ld32(k + t.T_JOIN_STATE) & t.J_FOREIGN) !== 0) {
    return lk.LK_ON;
  }
  return lk.kind();
}

/**
 * The join slot of task `k`, whose root panicked (`rootPanicked`), ends (an operation of kind
 * `kind`, sched_lock.velt): its joiner is woken.
 */
@noInline
export function panickedEnd(e: usize, k: usize, kind: u32): void {
  const s = mk.lockJoin(k, kind);
  // The join raises the panic from a poll that may unwind: `joinPoll`, `joinPollSolo` and
  // `joinPollLazy` are C's (`@export`), whose frames end any unwinding (rt_abi.md), so the
  // handle's header gets `joinPanicked`.
  m.st(k + t.T_JOIN, fnAddress(joinPanicked));
  const joiner = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, 0);
  mk.unlockJoin(k, s | t.J_DONE | nc.J_PANICKED, kind);
  if (joiner !== 0) {
    m.st32(e + t.E_DISPATCH, t.D_OUTPUT);
    m.wakeOwned(joiner);
    m.st32(e + t.E_DISPATCH, 0);
  }
}

/** Ends the process as an uncaught panic whose message was printed already. */
@noInline
function uncaught(): never {
  velt_rt_flush();
  velt_rt_exit(101);
}

/**
 * The poll of a join handle whose task's root panicked (`rootPanicked`): the panic, raised again
 * in the task joining it; never returns.
 */
export function joinPanicked(f: usize, cx: usize): u32 {
  const k = f - t.T_JOIN;
  const kind = kindFor(k);
  const s = mk.lockJoin(k, kind);
  mk.unlockJoin(k, s | t.J_CLAIMED, kind);
  nc.again(m.ld(k + t.T_POLL));
  return 1;
}

/** A join handle's drop (on any thread): detaches the task; drops a result it never claimed. */
@cExport("std_sched_join_drop")
export function joinDrop(f: usize): void {
  if (lk.mode() === lk.LK_NONE) {
    joinDropAs(f, lk.LK_NONE);
  } else {
    joinDropLocking(f);
  }
}

/** `joinDrop` while other threads may reach the slot (or a lazy worker 0 counts its operation). */
@noInline
function joinDropLocking(f: usize): void {
  joinDropAs(f, lk.kind());
}

/** `joinDrop`, the operation of kind `kind` (sched_lock.velt). */
@inline
function joinDropAs(f: usize, kind: u32): void {
  const k = f - t.T_JOIN;
  const s = mk.lockJoin(k, kind);
  const joiner = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, 0);
  mk.unlockJoin(k, s & ~t.J_HANDLE, kind);
  if (joiner !== 0) {
    m.wakerDrop(joiner);
  }
  if ((s & (t.J_DONE | t.J_CLAIMED)) === t.J_DONE) {
    if (keepDrop(k)) {
      return;
    }
    dropResult(k);
  }
  wk.release(k);
}

/**
 * The handle of task `k`, done, its result unclaimed, dropped during the poll of another task on
 * this worker: the result is dropped once that poll's microtasks are drained, with the rejections
 * nobody handled (sched_node_report.velt `report`, which calls `dropKept`), as Node reports a
 * rejection only after the synchronous code: the drop glue of a rejection reports it and ends the
 * program, which must not cut the poll short (#3027). Kept on the polled task's list, linked
 * through `T_JOINER` (the handle, gone now, was its last writer), with the handle's reference.
 * Whether it was kept.
 */
@noInline
function keepDrop(k: usize): bool {
  const e = t.here();
  if (e === 0 || m.ld(k + t.T_RESULT_DROP) === 0) {
    return false;
  }
  const cur = m.ld(e + t.E_CURRENT);
  if (cur === 0 || cur === k || (m.load32(k + t.T_JOIN_STATE) & nc.J_PANICKED) !== 0) {
    return false;
  }
  m.st(k + t.T_JOINER, m.ld(cur + t.T_UNHANDLED));
  m.st(cur + t.T_UNHANDLED, k | KEPT);
  return true;
}

/**
 * The tag of a task `keepDrop` kept on a task's list of rejections (`T_UNHANDLED`), whose other
 * entries are started promises' nodes (tasks and nodes are 8-byte aligned).
 */
export const KEPT: usize = 1;

/** Drops the result of task `k` that `keepDrop` kept, then the handle's reference to `k`. */
export function dropKept(k: usize): void {
  dropResult(k);
  wk.release(k);
}

/**
 * When `f` is a spawned task's join handle (its header is the task's `T_JOIN`): the task's
 * result nobody claims is dropped with `qdrop`, quietly (true).
 */
export function joinHandled(f: usize, qdrop: usize): bool {
  if (f === 0 || !isJoin(f)) {
    return false;
  }
  m.st(f - t.T_JOIN + t.T_RESULT_DROP, qdrop);
  return true;
}

/**
 * The end of task `k`'s poll on worker `e` (sched_run.velt `run`, its `mode`), after its
 * microtasks, with what the poll printed published: its poll as part of a batch ends
 * (sched_queue.velt `pushNext`); the join slot of a root that finished in it ends now
 * (sched_run.velt `rootDone`, flag `JOIN_DUE`). A joiner on another thread may resume as soon as
 * the slot says done, without a wake (its first poll of the handle), so the slot says it only
 * once the task's microtasks ran, as Node runs them before an awaiter's continuation, and their
 * output and the root's is published, ahead of what the joiner prints (#3020).
 */
@noInline
export function polledFlags(e: usize, k: usize, mode: u32): void {
  const fl = m.ld32(k + t.T_FLAGS);
  if ((fl & t.BATCHED) !== 0) {
    m.and32(k + t.T_FLAGS, ~t.BATCHED);
  }
  if ((fl & t.JOIN_DUE) !== 0) {
    m.and32(k + t.T_FLAGS, ~t.JOIN_DUE);
    if (mode === 0 || mode === t.M_LAZY) {
      // `run` published nothing for this poll (a worker out of the shared mode while the slots'
      // locks are on: rescued during the poll, or after a rescue was taken back).
      wk.publish(e);
    }
    if ((fl & nc.T_PANICKED) !== 0) {
      panickedEnd(e, k, kindFor(k));
    } else {
      joinDone(e, k, kindFor(k));
    }
  }
}
