// velt/lang/hooks (internal): module state under the executor in Velt's workers (sched.velt,
// #2649 step 3), as the runtime's module lock (velt_rt task/local/module_state.rs) keeps it: one
// process-wide lock, which a task takes on its first access of module state and keeps until the
// end of that poll, and at the start of every later poll (it is touched, flag `TOUCHED`); code
// outside a task (worker 0's synchronous `main` once the executor runs) keeps it until it hands
// over to the tasks. So a task's code between two `await`s runs alone with respect to every other
// task that uses module state, as in Node, on whichever worker it runs.
//
// The blocks are module_blocks.velt's, reached with the lock held (or before any worker runs):
// made by the thread that reaches one first, and dropped at a normal end with the debug counters
// on (`dropAtExit`), as the runtime's were (#2196 9c). They are reached by role (`hookCall`),
// never imported: module_blocks.velt is compiled once into an object of the build cache, which
// keeps its state (velt_common `std_hooks/prebuilt.rs` "State"), and a program that calls the
// object must not load a second copy. What the last call answered is kept here (`DESC`, `BLOCK`,
// `READY`), so an access of the block last reached is a few loads and no call, as it was when
// the blocks' own fast path was inlined here; a call is made for another block, or for a slot
// beyond the ones known to be initialized.
//
// Gap: a program giving a declared function properties through `any` takes the runtime's lock
// around a `Mutex` (`velt_rt_module_with`), and the runtime's function properties take it too
// (velt_rt fn_props.rs), which would wait for ever off worker 0: such a program's tasks stay on
// worker 0 (sched_spread.velt `stay`), until those move here too.

import { atomicAddress, hookCall, noInline } from "velt/lang/intrinsics";
import * as r from "#reactor";
import * as m from "./sched_mem";
import * as mh from "./mutex_held";
import * as t from "./sched_task";

/** The lock: 0 free, 1 held, 2 held with threads waiting. */
const LOCK = new Atomic<u32>(0);

/** How this thread holds the lock: not, for its task's poll, outside a task. */
const NOT_HELD: u32 = 0;
const IN_POLL: u32 = 1;
const OUTSIDE: u32 = 2;
const HELD = new ThreadLocal<u32>(0);

/**
 * The block last looked up, kept here so that an access is a few loads and no call: its
 * descriptor, its address, and how many of its slots are known to be initialized. The blocks
 * themselves and their table are module_blocks.velt's, behind a call (`hookCall`); this is what
 * that call last answered. Read and changed with the lock held, as the blocks are.
 */
const DESC = new Atomic<u64>(0);
const BLOCK = new Atomic<u64>(0);
const READY = new Atomic<u64>(0);

/** `velt_rt_module_state`: the block, to reach slot `slot` of the program's descriptor `desc`. */
export function state(desc: usize, slot: u64): usize {
  if (HELD.get() === NOT_HELD) {
    take(t.here());
  }
  if (DESC.load("acquire") as usize === desc && slot < READY.load("acquire")) {
    return BLOCK.load("relaxed") as usize;
  }
  return lookUp(desc, slot);
}

/**
 * Asks module_blocks.velt for the block of `desc` to reach slot `slot` (it makes the block on
 * first use, and a slot not initialized is its `ReferenceError`), and keeps the answer. The
 * slots are initialized in order (`ready`), so `slot` reached means every slot up to it may be.
 */
@noInline
function lookUp(desc: usize, slot: u64): usize {
  const p: usize = hookCall("module_state", desc, slot);
  const same = DESC.load("relaxed") as usize === desc && BLOCK.load("relaxed") as usize === p;
  if (!same || READY.load("relaxed") <= slot) {
    keep(desc, p, slot + 1);
  }
  return p;
}

/** Keeps block `p` of `desc`, its slots below `n` initialized, as the block last looked up. */
function keep(desc: usize, p: usize, n: u64): void {
  // The descriptor last: a reader that finds it finds its block and count.
  DESC.store(0, "relaxed");
  BLOCK.store(p as u64, "relaxed");
  READY.store(n, "relaxed");
  DESC.store(desc as u64, "release");
}

/** `velt_rt_module_block`: the block without the slot check (the root file's `main`). */
export function block(desc: usize): usize {
  if (HELD.get() === NOT_HELD) {
    take(t.here());
  }
  if (DESC.load("acquire") as usize === desc) {
    return BLOCK.load("relaxed") as usize;
  }
  const p: usize = hookCall("module_block", desc);
  // Which of its slots are initialized is not known from this: none, until one is reached.
  keep(desc, p, 0);
  return p;
}

/** `velt_rt_module_ready`: the slots of `state` below `n` are initialized. */
export function ready(state: usize, n: u64): void {
  hookCall("module_ready", state, n);
  if (BLOCK.load("relaxed") as usize === state && DESC.load("relaxed") !== 0) {
    READY.store(n, "relaxed");
  }
}

/**
 * The program ends normally with the debug counters on (sched.velt `schedFinish`): the blocks go
 * (module_blocks.velt `moduleDrop`). The lock stays held: a task still running waits instead of
 * reaching freed state.
 */
export function dropAtExit(): void {
  if (HELD.get() === NOT_HELD) {
    lock();
    HELD.set(OUTSIDE);
  }
  // Nothing is the block last looked up any more.
  DESC.store(0, "relaxed");
  READY.store(0, "relaxed");
  BLOCK.store(0, "relaxed");
  hookCall("module_drop");
}

/**
 * Takes the lock for worker `e`'s task being polled (touched from now on), or outside a task: on
 * a worker between polls, or on a thread no worker runs on (`e` 0: the program's start, whose
 * initializers may start the executor, until it hands over; a C library's thread, which waits
 * for the tasks as the runtime's lock made it).
 */
function take(e: usize): void {
  // Counted in a `velt dev` build only (mutex_held.velt): `USED` stays 0 in any other, which
  // reads no count.
  if (mh.USED.load("relaxed") !== 0 && mh.held() !== 0) {
    mutexHeld();
  }
  lock();
  if (e === 0) {
    HELD.set(OUTSIDE);
    return;
  }
  const k = m.ld(e + t.E_CURRENT);
  if (k !== 0) {
    t.flags(k, t.TOUCHED, 0);
    HELD.set(IN_POLL);
  } else {
    HELD.set(OUTSIDE);
  }
}

/**
 * About to wait for the module lock while this thread holds a `Mutex` (mutex_held.velt): that
 * could wait for a thread that holds the module lock and waits for the `Mutex`, for ever. Sema
 * refuses module state in a `with` callback, so only code `velt dev` swapped in gets here; it
 * stops, as the runtime's lock did (#3467).
 */
@noInline
function mutexHeld(): void {
  panic(
    "module state reached while a `Mutex` is held (in a `with` callback): this could wait for ever for a thread that holds module state and waits for that `Mutex`",
  );
}

/** Does this thread hold the module lock (for a task's poll, or outside a task)? */
export function held(): bool {
  return HELD.get() !== NOT_HELD;
}

/** A touched task's poll starts: the lock, unless this thread holds it. */
export function enter(): void {
  if (HELD.get() === NOT_HELD) {
    lock();
    HELD.set(IN_POLL);
  }
}

/** A touched task's poll ends: the lock it took goes. */
export function leave(): void {
  if (HELD.get() === IN_POLL) {
    HELD.set(NOT_HELD);
    unlock();
  }
}

/** Code outside a task hands over to the tasks: the lock it holds goes. */
export function handOver(): void {
  if (HELD.get() === OUTSIDE) {
    HELD.set(NOT_HELD);
    unlock();
  }
}

function lock(): void {
  const a = atomicAddress(LOCK);
  if (m.cas32(a, 0, 1) !== 0) {
    lockSlow(a);
  }
}

@noInline
function lockSlow(a: usize): void {
  while (true) {
    const s = m.load32(a);
    if (s === 0) {
      // Taken as contended: the unlock wakes one waiter, which takes it the same way.
      if (m.cas32(a, 0, 2) === 0) {
        return;
      }
    } else if (s === 2 || m.cas32(a, 1, 2) === 1) {
      r.wordWait(a, 2);
    }
  }
}

function unlock(): void {
  const a = atomicAddress(LOCK);
  let s = m.load32(a);
  while (true) {
    const was = m.cas32(a, s, 0);
    if (was === s) {
      break;
    }
    s = was;
  }
  if (s === 2) {
    r.wordWake(a);
  }
}
