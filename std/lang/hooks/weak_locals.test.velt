// velt/lang/hooks (tests): the slots of `weak` local variables, compiled as a program has them
// (velt_vir `weak_fields`, `Intrinsic::WeakRead`): every slot a variable takes is given back by
// its next assignment or the end of its scope, which the leak counters cannot see (the weak
// core's blocks are the C library's); run by `velt test std/`.
import { describe, expect, it } from "velt/test";
import { weakSlotsLive, weakTracked } from "velt/lang/hooks/weak";

class Node {
  name: string;
  constructor(name: string) {
    this.name = name;
  }
}

function nameOf(n: Node | null): string {
  return n === null ? "null" : n.name;
}

function* reading(n: Node): Generator<string> {
  const w: weak Node | null = n;
  yield nameOf(w);
  yield nameOf(w);
}

function earlyReturn(t: Node, out: boolean): string {
  {
    const w: weak Node | null = t;
    if (out) {
      return nameOf(w);
    }
  }
  return "end";
}

function throwing(t: Node): string {
  const w: weak Node | null = t;
  if (nameOf(w) === "t") {
    throw new Error("thrown");
  }
  return nameOf(w);
}

function finallyReturn(t: Node): string {
  try {
    const w: weak Node | null = t;
    try {
      return nameOf(w);
    } finally {
      const v: weak Node | null = t;
      nameOf(v);
    }
  } finally {
    nameOf(t);
  }
}

function* stepping(t: Node): Generator<string> {
  const w: weak Node | null = t;
  for (let i = 0; i < 3; i++) {
    yield nameOf(w);
  }
}

async function* asyncStepping(t: Node): AsyncGenerator<string> {
  const w: weak Node | null = t;
  yield nameOf(w);
  yield nameOf(w);
}

async function acrossAwaits(t: Node): Promise<string> {
  let w: weak Node | null = t;
  await Promise.resolve(0);
  const first = nameOf(w);
  w = null;
  await Promise.resolve(0);
  return first + nameOf(w);
}

describe("weak locals", () => {
  it("are given back by a generator dropped while it is suspended", () => {
    const before = weakSlotsLive();
    {
      const n = new Node("g");
      const g = reading(n);
      expect(g.next().value).toBe("g");
      // `n`'s record and the generator's variable hold the one slot.
      expect(weakSlotsLive()).toBe(before + 1);
    }
    // Freeing `n` let go of the record's hold, dropping `g` of the variable's.
    expect(weakSlotsLive()).toBe(before);
  });

  it("give back their slot at the end of their scope", () => {
    const before = weakSlotsLive();
    const records = weakTracked();
    {
      const a = new Node("a");
      const w: weak Node | null = a;
      expect(nameOf(w)).toBe("a");
      expect(weakSlotsLive()).toBe(before + 1);
    }
    expect(weakSlotsLive()).toBe(before);
    expect(weakTracked()).toBe(records);
  });

  it("give back the old slot when assigned", () => {
    const before = weakSlotsLive();
    const a = new Node("a");
    const b = new Node("b");
    let w: weak Node | null = a;
    w = b;
    expect(nameOf(w)).toBe("b");
    // `a` still holds its slot through its record, `b` has its own.
    expect(weakSlotsLive()).toBe(before + 2);
    w = null;
    expect(nameOf(w)).toBe("null");
    expect(weakSlotsLive()).toBe(before + 2);
  });

  it("read null once the target went, and free the slot with the last holder", () => {
    const before = weakSlotsLive();
    let w: weak Node | null = null;
    {
      const t = new Node("t");
      w = t;
      expect(nameOf(w)).toBe("t");
    }
    expect(nameOf(w)).toBe("null");
    // The record let go of the slot when `t` was freed; `w` still holds it.
    expect(weakSlotsLive()).toBe(before + 1);
    w = null;
    expect(weakSlotsLive()).toBe(before);
  });

  it("take a slot each time a loop declares one", () => {
    const before = weakSlotsLive();
    const nodes = [new Node("x"), new Node("y")];
    let names = "";
    for (const n of nodes) {
      const w: weak Node | null = n;
      names += nameOf(w);
    }
    expect(names).toBe("xy");
    // Each node's record keeps its slot until the node is freed; no variable holds one.
    expect(weakSlotsLive()).toBe(before + 2);
  });

  it("give back their slot on every way out of their scope", () => {
    const before = weakSlotsLive();
    {
      const t = new Node("t");
      for (let i = 0; i < 4; i++) {
        const w: weak Node | null = t;
        if (i === 1) {
          continue;
        }
        if (i === 2) {
          break;
        }
        nameOf(w);
      }
      outer: for (let i = 0; i < 2; i++) {
        for (let j = 0; j < 2; j++) {
          const w: weak Node | null = t;
          if (j === 1) {
            continue outer;
          }
          nameOf(w);
        }
      }
      expect(earlyReturn(t, true)).toBe("t");
      expect(earlyReturn(t, false)).toBe("end");
      let caught = "";
      try {
        throwing(t);
      } catch (e) {
        caught = "caught";
      }
      expect(caught).toBe("caught");
      expect(finallyReturn(t)).toBe("t");
      // `t`'s record holds the one slot; no variable kept a reference.
      expect(weakSlotsLive()).toBe(before + 1);
    }
    expect(weakSlotsLive()).toBe(before);
  });

  it("give back their slot with a generator that ran out or returned early", () => {
    const before = weakSlotsLive();
    {
      const t = new Node("t");
      let all = "";
      for (const x of stepping(t)) {
        all += x;
      }
      expect(all).toBe("ttt");
      for (const x of stepping(t)) {
        all += x;
        break;
      }
      const g = stepping(t);
      g.next();
      g.return();
      expect(all).toBe("tttt");
      expect(weakSlotsLive()).toBe(before + 1);
      // `t` lives to here, so its record holds the slot above.
      expect(t.name).toBe("t");
    }
    expect(weakSlotsLive()).toBe(before);
  });

  it("give back their slot in async functions and async generators", async () => {
    const before = weakSlotsLive();
    {
      const t = new Node("t");
      expect(await acrossAwaits(t)).toBe("tnull");
      let all = "";
      for await (const x of asyncStepping(t)) {
        all += x;
      }
      const g = asyncStepping(t);
      await g.next();
      await g.return();
      expect(all).toBe("tt");
      expect(weakSlotsLive()).toBe(before + 1);
      expect(t.name).toBe("t");
    }
    expect(weakSlotsLive()).toBe(before);
  });

  it("swap slots in every assignment form", () => {
    const before = weakSlotsLive();
    {
      const a = new Node("a");
      const b = new Node("b");
      let w: weak Node | null = a;
      let v: weak Node | null = null;
      w = w;
      v = w = b;
      w ??= a;
      v ||= a;
      w &&= a;
      expect(`${nameOf(w)} ${nameOf(v)}`).toBe("a b");
      // `a`'s and `b`'s records hold their slots.
      expect(weakSlotsLive()).toBe(before + 2);
    }
    expect(weakSlotsLive()).toBe(before);
  });
});
