// velt/lang/hooks (internal): a task's yield list under the executor in Velt (sched_yield.velt,
// #3241), in its yield block (`T_YIELDS`, made when the task first needs one): its yields
// waiting for their turn (the last of a circular list; flag `YIELDS`), in the order they were
// made (their numbers), which its next poll fires one at a time (sched_fire.velt `fireYields`).
// A yield joins it on the thread polling its task, and only that thread takes and fires it.

import { inline, noInline, stdUsed } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as node from "./sched_node";
import * as t from "./sched_task";

/**
 * A yield: a heap future's header (0, 0 for an awaited yield's record; `HELD`, 0 for a held one),
 * the next on its task's
 * list (the list is circular: the block's `B_LAST` is the last), the waker to wake at its turn
 * (0: none yet), its state, its task (a stored one's), and its stamp (`stamp`).
 */
export const Y_NEXT: usize = 16;
export const Y_WAKER: usize = 24;
export const Y_STATE: usize = 32;
export const Y_TASK: usize = 40;
export const Y_STAMP: usize = 48;
export const Y_SIZE: usize = 56;
/**
 * A yield's states: made (a stored one, on no list); waiting on the list; its turn came; dropped
 * while waiting (the list frees it at its turn); its turn is taking its waker (`fire`: whoever
 * holds it waits for `FIRED` before it frees it, which `fire` touches until then).
 */
export const NEW: usize = 0;
export const QUEUED: usize = 1;
export const FIRED: usize = 2;
export const DROPPED: usize = 3;
export const FIRING: usize = 4;
/**
 * A yield's waker when it is its own task's root's: no reference is held, as the task does not
 * end while its list holds the yield (sched_run.velt `runEnd`).
 */
export const ROOT: usize = 1;

/** A held record's first word (`held`), where a stored yield has its poll and a record 0. */
export const HELD: usize = 1;

/**
 * An awaited yield's token (sched_yield.velt `schedYield`, what its suspension keeps, #3687):
 * - `POLL` (0): its task's root yielded with no record, and it goes on once the poll it yielded in
 *   is over (`YIELDED`, which lasts exactly that poll), whatever cx asks (`pollReady`);
 * - `OFF` (1): made off the workers (no task);
 * - above 1: its held record (`held`), a block's address.
 */
export const POLL: usize = 0;
export const OFF: usize = 1;

/**
 * Token `POLL` asked with waker `w`, a started promise's (`isNode`) or a foreign one, on the thread
 * polling task `k` (0: none) (sched_yield.velt `otherReady`; a task's waker asks its state): 1 once
 * the poll it was made in is over (`YIELDED` of its task: the node's own, else `k`). Asked in that
 * poll (a detached child of an inline `Promise.all`, now a started promise of its own), it waits for
 * a turn of its own, since no record wakes `w` (the task's next poll resumes only its root): a
 * record on `k`'s list, its node flagged `YIELDING` (a second ask adds none), or, asked on another
 * task's thread, `w` woken to ask again. Asked after the root yielded again in a later poll, it
 * waits that turn too: one turn late, never early.
 */
@noInline
export function pollReady(k: usize, w: usize, isNode: bool): u32 {
  const x = isNode ? m.ld(w + node.N_TASK) : k;
  if (k === 0 || x === 0 || m.load32(x + t.T_STATE) !== t.YIELDED) {
    return 1;
  }
  if (x !== k) {
    m.wakeByRef(w);
    return 0;
  }
  if (isNode) {
    if ((m.load32(w + node.N_FLAGS) & node.YIELDING) !== 0) {
      // Its turn is on the list.
      return 0;
    }
    m.or32(w + node.N_FLAGS, node.YIELDING);
  }
  otherTurn(k, w);
  return 0;
}

/** `pollReady`'s turn for waker `w` of task `k`, behind the yields made so far. */
@noInline
function otherTurn(k: usize, w: usize): void {
  join(k, record(m.wakerClone(w), nextStamp(block(k))));
}

// A task's yield block: its list's last yield (0: none), its last stamp, and the stamp of the
// yield its root waits for with no record (flag `ROOT_ALONE`). A stamp is a yield's generation
// (the high 32 bits: one more in each poll after one that made stored yields, flag `FRESH`) and
// its number: stamps grow in the order yields are made.
export const B_LAST: usize = 0;
export const B_STAMP: usize = 8;
export const B_ROOT: usize = 16;
export const B_SIZE: usize = 24;
/** One generation in a stamp. */
export const GEN: usize = 4294967296;

/**
 * `T_YIELDS`' top bit, which no address has: the block is parked (`park`), its list empty. The root's yields take the
 * no-block fast path then (`active`), and whatever needs the block un-parks it (`block`), with
 * its stamps and generation as they were.
 */
export const PARKED: usize = 1 << 63;

/** Task `k`'s yield block, made now if it has none, un-parked if parked (on its thread). */
@inline("always")
export function block(k: usize): usize {
  const b = m.ld(k + t.T_YIELDS);
  return b - 1 < PARKED - 1 ? b : blockAgain(k, b);
}

/** `block` for a task with no block (`b` 0) or a parked one. */
@noInline
function blockAgain(k: usize, b: usize): usize {
  if (b === 0) {
    return makeBlock(k);
  }
  const u = b & ~PARKED;
  m.st(k + t.T_YIELDS, u);
  if (m.load32(k + t.T_STATE) === t.YIELDED && !t.has(k, t.ROOT_ALONE)) {
    // Its root yielded in this poll while the block was parked, when no stamp is made: its turn
    // comes before the yields made from now on, as with a block made now. A turn placed before
    // the block was parked (`ROOT_ALONE`, of this poll: sched_run.velt `runOther` clears an
    // earlier poll's) keeps its stamp.
    m.st(u + B_ROOT, m.ld(u + B_STAMP));
    t.flags(k, t.ROOT_ALONE, 0);
  }
  return u;
}

/** Task `k`'s yield block, parked or not (0: none), for what reads its stamps. */
@inline("always")
export function blockOf(k: usize): usize {
  return m.ld(k + t.T_YIELDS) & ~PARKED;
}

/** Task `k`'s yield block unless parked (0: none or parked). */
@inline("always")
export function active(k: usize): usize {
  const b = m.ld(k + t.T_YIELDS);
  return b < PARKED ? b : 0;
}

/**
 * Task `k`'s turns are over and its list is empty: its block is parked, so its root's next yields
 * take the no-block fast path (#3687: a root whose `Promise.all` children's yields made the block).
 * A turn its root placed in this poll (`ROOT_ALONE`, `B_ROOT`) stays, for `block`.
 */
@inline("always")
export function park(k: usize): void {
  const b = m.ld(k + t.T_YIELDS);
  if (b !== 0 && !t.has(k, t.YIELDS)) {
    m.st(k + t.T_YIELDS, b | PARKED);
  }
}

@noInline
function makeBlock(k: usize): usize {
  const b = m.alloc(B_SIZE);
  m.st(b + B_LAST, 0);
  m.st(b + B_STAMP, 0);
  m.st(b + B_ROOT, 0);
  m.st(k + t.T_YIELDS, b);
  if (m.load32(k + t.T_STATE) === t.YIELDED) {
    // Its root yielded in this poll, before any yield was made: its turn comes first (stamp 0).
    t.flags(k, t.ROOT_ALONE, 0);
  }
  return b;
}

/** Yield block `b`'s next stamp (on its task's thread). */
@inline("always")
export function nextStamp(b: usize): usize {
  const s = m.ld(b + B_STAMP) + 1;
  m.st(b + B_STAMP, s);
  return s;
}

/**
 * An awaited yield's record, stamped `stamp`, to wake `w` (a waker's clone, or `ROOT`) at its turn.
 */
export function record(w: usize, stamp: usize): usize {
  const r = m.alloc(Y_SIZE);
  m.st(r, 0);
  m.st(r + 8, 0);
  m.st(r + Y_WAKER, w);
  m.st(r + Y_STAMP, stamp);
  return r;
}

/**
 * A held yield's record (`HELD`): an awaited yield's that its suspension holds as its token
 * until a resume or its cancel takes it (sched_yield.velt `heldPoll`, `schedYieldDrop`, #3687).
 * Its turn wakes `w` (a waker's clone) and leaves it `FIRED`, not freed, as a stored yield's
 * does; it is task `k`'s, stamped `stamp`.
 */
export function held(w: usize, k: usize, stamp: usize): usize {
  const r = m.alloc(Y_SIZE);
  m.st(r, HELD);
  m.st(r + 8, 0);
  m.st(r + Y_WAKER, w);
  m.st(r + Y_TASK, k);
  m.st(r + Y_STAMP, stamp);
  return r;
}

/**
 * Yield `y` joins task `k`'s list (on the thread polling `k`) by its number: at the end, unless a
 * yield made after it joined first. The root's turn placed with no record (`ROOT_ALONE`) gets one
 * first, so the yields made after it come after it (a yield of the same number, made before the
 * root's, comes before it).
 */
export function join(k: usize, y: usize): void {
  const b = block(k);
  m.st(y + Y_STATE, QUEUED);
  let last = m.ld(b + B_LAST);
  if (last === 0 && t.has(k, t.ROOT_ALONE) && m.load32(k + t.T_STATE) === t.YIELDED) {
    t.flags(k, 0, t.ROOT_ALONE);
    last = record(ROOT, m.ld(b + B_ROOT));
    m.st(last + Y_STATE, QUEUED);
    m.st(last + Y_NEXT, last);
    m.st(b + B_LAST, last);
  }
  const seq = m.ld(y + Y_STAMP);
  if (last === 0) {
    m.st(y + Y_NEXT, y);
    m.st(b + B_LAST, y);
  } else if (m.ld(last + Y_STAMP) < seq) {
    m.st(y + Y_NEXT, m.ld(last + Y_NEXT));
    m.st(last + Y_NEXT, y);
    m.st(b + B_LAST, y);
  } else {
    // Made before the last: after the last one made before it (from the first).
    let p = last;
    while (m.ld(m.ld(p + Y_NEXT) + Y_STAMP) < seq) {
      p = m.ld(p + Y_NEXT);
    }
    m.st(y + Y_NEXT, m.ld(p + Y_NEXT));
    m.st(p + Y_NEXT, y);
  }
  // Its next poll fires them (sched_run.velt `runWoken`), and this one's end queues it again.
  t.flags(k, t.YIELDS | t.LOCALS, 0);
}

/**
 * Takes task `k`'s yields made so far, the first of them (0: none), linked through `next`: those
 * made from now on wait for the poll after.
 */
export function take(k: usize): usize {
  t.flags(k, 0, t.YIELDS);
  const b = blockOf(k);
  const last = b === 0 ? 0 : m.ld(b + B_LAST);
  if (last === 0) {
    return 0;
  }
  m.st(b + B_LAST, 0);
  const first = m.ld(last + Y_NEXT);
  m.st(last + Y_NEXT, 0);
  return first;
}

/** Has task `k` yields waiting for their turn? Never in a program that never yields. */
@inline("always")
export function waiting(k: usize): bool {
  // The list is not empty exactly while flag `YIELDS` is set (`join`, `take`).
  return stdUsed("yields") && t.has(k, t.YIELDS);
}

/** Has task `k` a yield block, to go with it? Never in a program that never yields. */
@inline("always")
export function hasBlock(k: usize): bool {
  return stdUsed("yields") && m.ld(k + t.T_YIELDS) !== 0;
}

/** Task `k`'s yield block goes with the task (its list is empty: the task ended). */
@noInline
export function freeBlock(k: usize): void {
  m.release(blockOf(k), B_SIZE);
}

/** The yield after `y` in a list `take` gave. */
@inline("always")
export function next(y: usize): usize {
  return m.ld(y + Y_NEXT);
}

/**
 * Yield `y`'s turn: the waker to resume (a clone the caller owns, or `ROOT`: its task's, with no
 * reference), 0 when nothing waits for it. An awaited yield's record is freed, and a dropped
 * stored one; a held one (`held`) is left `FIRED` for the resume that takes it.
 */
export function fire(y: usize): usize {
  if (m.ld(y) === 0) {
    const w = m.ld(y + Y_WAKER);
    m.release(y, Y_SIZE);
    if (w > ROOT && m.ld(w) === t.main() + t.E_NODE_VT) {
      m.and32(w + node.N_FLAGS, ~node.YIELDING);
    }
    return w;
  }
  // Dropped (for good: nothing else touches it), or dropped meanwhile (the CAS fails).
  if (m.load(y + Y_STATE) === DROPPED || m.cas(y + Y_STATE, QUEUED, FIRING) !== QUEUED) {
    m.release(y, Y_SIZE);
    return 0;
  }
  const w = m.swap(y + Y_WAKER, 0);
  if (m.ld(y) === HELD && w > ROOT && m.ld(w) === t.main() + t.E_NODE_VT) {
    m.and32(w + node.N_FLAGS, ~node.YIELDING);
  }
  // From here on, whoever holds it may free it.
  m.storeRelease(y + Y_STATE, FIRED);
  return w;
}

/**
 * A held record lets go of waker `w` (re-pointed, or dropped while it waits): a started promise
 * flagged `YIELDING` for it (sched_yield.velt `otherYield`, `heldPoll`) loses the flag, as its
 * turn would take it. A child of it that still waits flags it again when it is next asked, and an
 * owner that adopts it meanwhile changes no held record's turn.
 */
export function letGo(w: usize): void {
  if (w > ROOT && m.ld(w) === t.main() + t.E_NODE_VT) {
    m.and32(w + node.N_FLAGS, ~node.YIELDING);
  }
}

/**
 * Held record `f`'s resume, polled with waker `w`: 1 once its turn came (freed now), else 0,
 * with `w` waiting for that turn. A stored yield's protocol (`storedPoll`): polled with another
 * waker than it holds, on its task's thread, it holds that one instead; from another task, the
 * waker is swapped in, then a turn that came meanwhile is seen. `cur`: the task polled on this
 * thread (0: none).
 */
@noInline
export function heldPoll(f: usize, w: usize, cur: usize): u32 {
  if (m.load(f + Y_STATE) === FIRED) {
    m.release(f, Y_SIZE);
    return 1;
  }
  const k = m.ld(f + Y_TASK);
  if (k === cur && m.ld(w) === t.main() + t.E_NODE_VT) {
    // A started promise one of whose yields still waits: its owner doesn't adopt it meanwhile
    // (sched_node.velt `pollNode`), as `otherYield` flagged it. Another of its records' turn
    // cleared the flag, but this one's hasn't come (the children of an inline `Promise.all`).
    m.or32(w + node.N_FLAGS, node.YIELDING);
  }
  const want = w === k ? ROOT : w;
  const mine = m.load(f + Y_WAKER);
  if (mine === want) {
    return 0;
  }
  if (k === cur) {
    // On the thread its turn comes on: nothing else touches it now.
    m.st(f + Y_WAKER, want === ROOT ? ROOT : m.wakerClone(w));
    if (mine > ROOT) {
      letGo(mine);
      m.wakerDrop(mine);
    }
    return 0;
  }
  const old = m.swap(f + Y_WAKER, m.wakerClone(w));
  if (old > ROOT) {
    m.wakerDrop(old);
  }
  if (settled(f) === FIRED) {
    const again = m.swap(f + Y_WAKER, 0);
    if (again > ROOT) {
      m.wakerDrop(again);
    }
    m.release(f, Y_SIZE);
    return 1;
  }
  return 0;
}

/** Stored yield `f`'s state once its turn, if it is taking place, has taken its waker. */
export function settled(f: usize): usize {
  let s = m.load(f + Y_STATE);
  while (s === FIRING) {
    // A few steps on the owner's thread, with no wait.
    m.yieldCore();
    s = m.load(f + Y_STATE);
  }
  return s;
}
