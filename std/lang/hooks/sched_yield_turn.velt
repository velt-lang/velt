// velt/lang/hooks (internal): a task's yield turns that poll its root (sched_fire.velt
// `fireYields`, #3687): the root's turn placed with no record, and the held records of the
// root's whose turn is next, which go on in the turn before when nothing would run between.

import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as t from "./sched_task";
import * as ls from "./sched_yield_list";

/**
 * A poll of task `k` begins with its root's turn of the last poll placed (`ROOT_ALONE`) and only
 * the root's records listed after it (`join`): that turn comes before the yields made after it
 * (sched_run.velt `runOther`, sched_fire.velt `fireYields`). Its stamp is kept now, as a yield of
 * the root in this poll may place another.
 */
export function rootTurnNext(k: usize): void {
  const b = ls.blockOf(k);
  m.st(b + ls.B_RTURN, m.ld(b + ls.B_ROOT) + 1);
}

/**
 * The stamp of the root's turn this poll of task `k` has with no record (`rootTurnNext`), plus 1
 * (0: none). Asked once.
 */
export function rootTurn(k: usize): usize {
  const b = ls.blockOf(k);
  const s = m.ld(b + ls.B_RTURN);
  m.st(b + ls.B_RTURN, 0);
  return s;
}

/**
 * A turn of task `k` polls its root (sched_fire.velt `fireYields`): `nx` is the yield whose turn
 * comes next (0: none), and none of this turn's waiters went on yet (`taken`).
 */
export function turnNext(k: usize, nx: usize): void {
  const b = ls.blockOf(k);
  m.st(b + ls.B_NEXT, nx);
  m.st(b + ls.B_TAKEN, 0);
}

/** The turn's poll of task `k`'s root is over (`turnNext`). */
export function turnOver(k: usize): void {
  m.st(ls.blockOf(k) + ls.B_NEXT, 0);
}

/** A waiter of task `k`'s turn goes on now (a held record fired, or a token 0 after its poll). */
export function taken(k: usize): void {
  const b = ls.blockOf(k);
  if (b !== 0) {
    m.st(b + ls.B_TAKEN, 1);
  }
}

/**
 * Held record `f` of task `k`'s root, asked in a turn's poll of the root once that turn's waiter
 * went on: when its turn is the next one and nothing would run between the two turns (no wake of
 * the root, microtask, rejection to report or woken promise), it goes on now, as at its own turn, which
 * then only frees it (`ls.DROPPED`). The children of an inline `Promise.all` that yielded once each
 * then go on in one poll of the root, in the order they yielded, as their turns would run them.
 */
export function nextTurn(k: usize, f: usize): bool {
  const b = ls.blockOf(k);
  if (
    m.ld(b + ls.B_NEXT) !== f ||
    m.ld(b + ls.B_TAKEN) === 0 ||
    m.ld(f + ls.Y_WAKER) !== ls.ROOT ||
    // Woken meanwhile (a channel's send in this turn): the root goes on before the next turn.
    m.load32(k + t.T_STATE) === t.NOTIFIED ||
    micro.pending(k) ||
    m.ld(k + t.T_UNHANDLED) !== 0 ||
    m.load(k + t.T_WOKEN) !== 0
  ) {
    return false;
  }
  m.st(f + ls.Y_STATE, ls.DROPPED);
  m.st(b + ls.B_NEXT, m.ld(f + ls.Y_NEXT));
  return true;
}
