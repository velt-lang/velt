// velt/lang/hooks (internal): boxed and started promises in the executor in Velt (sched.velt,
// #2649; rt_abi_async.md §1.1): `velt_rt_fut_box`'s and `velt_rt_fut_start`'s jobs.
//
// A node is `[head (128)][VeltFut header (16)][state]`; the promise is the header's address, so
// the state's result (its offset 0) is the result slot at +16. The head: the node's waker table
// (a node is its own waker), its reference count (the owner's handle, the task driving it, a
// place among its task's woken nodes, each waker clone), its flags, its size in bytes (to free it
// with), the state's poll (once it finished: where it threw, sched_node_loc.velt, or a panicked
// node's exception, sched_node_catch.velt), the waker of whoever awaits it, the result's drop
// glue, the task driving it (a started node holds a reference to it, so a wake from another
// thread never touches a freed task), its link in that task's woken stack (other threads push on
// it), the `cx` its polls get (its task's await word, itself), its link in the list of woken
// nodes the task took to run (its own, so a node woken again while it waits there is pushed
// without breaking that list), the state's drop (a lazy node's; then a word sched_node_catch.velt
// uses), its link in the task's list of rejections nobody handled (its own too: a node woken
// while it ran from a microtask is still on the woken stack when it finishes there, and that
// stack must stay whole), the transfer glue (+112, sched_node_transfer.velt) and the hub of a
// shared node (+120, sched_share.velt).
//
// The flags change only through atomic or/and: a wake on another thread sets QUEUED while the
// worker sets and clears the others.
//
// A promise handed to another task is awaited or dropped by its owner on one worker while its
// task finishes it on another: sched_node_await.velt.
//
// A lazy node (boxed, not started) is polled by whoever awaits it with their `cx`. Started (from
// a poll of a task: outside one it stays lazy), it runs at once until it suspends, with the
// task's await word raised so its `await`s take their microtask step, and from then on its task
// drives it: a wake puts it among the task's woken nodes, which the task runs before its root
// (sched.velt `run`). Its owner only sees it finish. A task that starts nothing pays nothing.

import { inline, stateDrop, statePoll } from "velt/lang/intrinsics";
import * as bd from "./sched_budget";
import * as m from "./sched_mem";
import * as loc from "./sched_node_loc";
import * as micro from "./sched_micro";
import * as aw from "./sched_node_await";
import * as nc from "./sched_node_catch";
import * as rp from "./sched_node_report";
import * as sh from "./sched_share";
import * as t from "./sched_task";
import * as tr from "./sched_node_transfer";
import * as wk from "./sched_wake";

export const N_HEAD: usize = 128;
export const N_REFS: usize = 8;
export const N_FLAGS: usize = 16;
const N_BYTES: usize = 20;
export const N_POLL: usize = 24;
export const N_RESULT_DROP: usize = 40;
export const N_TASK: usize = 48;
export const N_NEXT: usize = 56;
export const N_CX: usize = 64;
export const N_TAKEN_NEXT: usize = 80;
/**
 * The lazy state's drop glue: read only before the start, so a started node lends it and the
 * word after it to sched_node_catch.velt (`N_SETTLE`).
 */
export const N_DROP: usize = 88;
export const N_UNHANDLED_NEXT: usize = 104;

/**
 * A node's flags: started; its state finished; its owner dropped the handle (the task drops the
 * result); among its task's woken nodes; it can reject; its owner took the result.
 */
export const STARTED: u32 = 1;
export const FINISHED: u32 = 2;
export const DETACHED: u32 = 4;
export const QUEUED: u32 = 8;
export const REJECTING: u32 = 16;
export const DELIVERED: u32 = 32;
/** Its state is being polled (by its task, or by an owner that adopted it). */
export const RUNNING: u32 = 64;
/**
 * Its polls catch a Velt panic (std/task/catch_sched.velt): `catchPanic`'s promise, and every
 * promise started while a catching poll runs. A panic makes it PANICKED: finished, its result
 * never written, read or dropped, its state never polled or dropped again, the node never freed
 * (a leaf in the abandoned state may still wake it); the exception, which holds the message, in
 * place of its poll; an owner awaiting it gets the panic raised again (`again`).
 */
export const CATCHES: u32 = 128;
export const PANICKED: u32 = 256;
/**
 * Its last poll was an owner's adoption under a catch (sched_node_catch.velt `adoptCaught`), not
 * its own run: its leaves hold the owner's waker. Read only for a catching node, whose run
 * (`runCaught`) clears it.
 */
export const ADOPTED: u32 = 512;

/** `velt_rt_fut_box`: a lazy node of the `size`-byte initial state at `state`. */
export function boxed(
  poll: usize,
  drop: usize,
  state: usize,
  size: u64,
  hdrPoll: usize,
  hdrDrop: usize,
): usize {
  const e = t.exec();
  const bytes = N_HEAD + 16 + (size as usize);
  const n = m.alloc(bytes);
  m.st(n, t.main() + t.E_NODE_VT);
  m.st(n + N_REFS, 1);
  m.st32(n + N_FLAGS, 0);
  m.st32(n + N_BYTES, bytes as u32);
  m.st(n + N_POLL, poll);
  m.st(n + N_DROP, drop);
  m.st(n + N_RESULT_DROP, 0);
  m.st(n + N_TASK, 0);
  m.st(n + N_NEXT, 0);
  m.st(n + aw.N_AWAITER, 0);
  m.st(n + N_CX, 0);
  m.st(n + N_CX + 8, n);
  m.st(n + N_TAKEN_NEXT, 0);
  m.st(n + N_UNHANDLED_NEXT, 0);
  const f = n + N_HEAD;
  m.st(f, hdrPoll);
  m.st(f + 8, hdrDrop);
  m.copy(f + 16, state, size as usize);
  return f;
}

/** The node of promise `f`. */
export function nodeOf(f: usize): usize {
  return f - N_HEAD;
}

/** A node's poll (C calls it through the promise's header). */
export function nodePoll(f: usize, cx: usize): u32 {
  return pollNode(f, cx, true);
}

/**
 * Polls promise `f` for an owner that waits for it to finish without claiming its result
 * (`catchPanic`, std/task/catch_sched.velt): 1 once it finished, panicked or not; a later
 * `nodePoll` delivers the result.
 */
export function nodeSettled(f: usize, cx: usize): u32 {
  return pollNode(f, cx, false);
}

/** `nodePoll` (`claim`: the owner takes the result, or the panic raised again) or `nodeSettled`. */
@inline
function pollNode(f: usize, cx: usize, claim: bool): u32 {
  const n = nodeOf(f);
  const fl = m.load32(n + N_FLAGS);
  if ((fl & STARTED) === 0) {
    if ((fl & FINISHED) !== 0) {
      return 1;
    }
    // SAFETY: a lazy node's state, polled by its owner with its own cx.
    const r = unsafe { statePoll(m.ld(n + N_POLL), f + 16, cx) };
    if (r === 1) {
      tr.finish(n, FINISHED);
    }
    return r;
  }
  if ((fl & FINISHED) !== 0) {
    if (!claim) {
      return 1;
    }
    if ((fl & PANICKED) !== 0) {
      nc.again(m.ld(n + N_POLL));
    }
    setFlags(n, DELIVERED);
    loc.claim(fl, n + N_POLL);
    return 1;
  }
  const task = m.ld(n + N_TASK);
  const e = t.exec();
  if (
    (fl & (RUNNING | QUEUED)) === 0 &&
    m.ld(e + t.E_ADOPTING) === 0 &&
    wk.taskOf(m.ld(cx + 8)) === task
  ) {
    if ((fl & CATCHES) !== 0 || m.ld(e + nc.E_CATCHING) >= 2) {
      // Adopted under a catch: its own poll catches, so a panic never unwinds through the
      // adoption's bookkeeping, and the node it abandons counts as finished.
      return nc.adoptCaught(e, task, n, cx, claim);
    }
    // Its owner is the task driving it (its root, or another promise of it): the owner polls
    // the state with its own cx ("adopts" it), so its leaves wake the owner directly and a
    // `resolve` queues the owner's step at once, as in Node. One level only: a chain of
    // promises each awaiting the one before it is not polled in one deep call.
    m.or32(n + N_FLAGS, RUNNING);
    m.st(e + t.E_ADOPTING, 1);
    // SAFETY: a started node's state, not being polled, polled now by its task's code.
    const r = unsafe { statePoll(m.ld(n + N_POLL), f + 16, cx) };
    m.st(e + t.E_ADOPTING, 0);
    m.and32(n + N_FLAGS, ~RUNNING);
    if (r === 1) {
      adoptedDone(task, n, claim ? FINISHED | DELIVERED : FINISHED);
      return 1;
    }
  }
  return aw.awaitNode(n, cx);
}

/**
 * Adopted node `n` of task `task` finished (flags `fl`): the task no longer drives it. Its owner,
 * which adopted it, runs on the task (`pollNode`), so nothing else touches its awaiter word.
 */
@inline
export function adoptedDone(task: usize, n: usize, fl: u32): void {
  tr.finish(n, fl);
  m.st(task + t.T_LOCALS, m.ld(task + t.T_LOCALS) - 1);
  const w = aw.takePlain(n);
  if (w !== 0) {
    m.wakerDrop(w);
  }
  // The task's reference.
  release(n);
}

/** A node's drop: a lazy one is cancelled; a started one keeps running, its result dropped. */
export function nodeDrop(f: usize): void {
  const n = nodeOf(f);
  const fl = m.load32(n + N_FLAGS);
  if ((fl & STARTED) === 0) {
    if ((fl & FINISHED) === 0) {
      // SAFETY: the lazy state's drop glue on its state, which has not finished.
      unsafe {
        stateDrop(m.ld(n + N_DROP), f + 16);
      }
    }
  } else if (!aw.ownSide(n)) {
    // The finish may run on another worker meanwhile (sched_node_await.velt): the one that comes
    // second drops the result. DELIVERED is the owner's own (this thread's).
    const prev = m.or32(n + N_FLAGS, DETACHED);
    if ((prev & (FINISHED | DELIVERED)) === FINISHED) {
      rp.dropResult(n);
    }
    const w = m.swap(n + aw.N_AWAITER, 0);
    if (w !== 0) {
      m.wakerDrop(w);
    }
    release(n);
    return;
  } else if ((fl & FINISHED) === 0) {
    setFlags(n, DETACHED);
  } else if ((fl & DELIVERED) === 0) {
    rp.dropResult(n);
  }
  const w = aw.takePlain(n);
  if (w !== 0) {
    m.wakerDrop(w);
  }
  release(n);
}

export function setFlags(n: usize, f: u32): void {
  m.or32(n + N_FLAGS, f);
}

/**
 * `velt_rt_fut_start`: promise `f` (a lazy node; anything else stays as it is) starts now on
 * task `task` (0 outside a task: it stays lazy), its result dropped with `rdrop` if nobody
 * claims it. Its first run is synchronous: the task's await word is raised meanwhile.
 */
export function start(
  task: usize,
  f: usize,
  rdrop: usize,
  rejecting: bool,
  hdrPoll: usize,
  catching: usize,
): void {
  if (task === 0 || m.ld(f) !== hdrPoll) {
    return;
  }
  const n = nodeOf(f);
  const fl = m.load32(n + N_FLAGS);
  if ((fl & (STARTED | FINISHED)) !== 0) {
    return;
  }
  if (catching !== 0) {
    nc.catchesFrom(n, catching);
  }
  m.or32(n + N_FLAGS, STARTED | (rejecting ? REJECTING : 0));
  m.st(n + N_RESULT_DROP, rdrop);
  // The node's reference to its task, given back when the node is freed.
  m.inc(task + t.T_REFS);
  m.st(n + N_TASK, task);
  m.st(n + N_CX, task + t.T_WORD);
  // The task's reference.
  m.inc(n + N_REFS);
  t.bump(task + t.T_LOCALS, 1);
  t.flags(task, t.LOCALS, 0);
  m.st32(task + t.T_WORD, m.ld32(task + t.T_WORD) + 1);
  run(task, n, false);
  m.st32(task + t.T_WORD, m.ld32(task + t.T_WORD) - 1);
}

/**
 * Has node promise `f` settled with its result still in its slot (`velt_rt_fut_peek`)? A panicked
 * node is finished with nothing in its slot (sched_node_catch.velt `panicked`): not settled, as
 * with the runtime's `node::peek`.
 */
export function peek(f: usize): bool {
  return (m.load32(nodeOf(f) + N_FLAGS) & (FINISHED | DELIVERED | PANICKED)) === FINISHED;
}

/** Promise `f`, if it is a node, drops a result nobody claims with `qdrop` (a combinator's). */
export function handled(f: usize, qdrop: usize, hdrPoll: usize): void {
  if (f !== 0 && m.ld(f) === hdrPoll && (m.load32(nodeOf(f) + N_FLAGS) & PANICKED) === 0) {
    m.st(nodeOf(f) + N_RESULT_DROP, qdrop);
  }
}

/**
 * Polls started node `n` of task `task` once (it is not running). Only a node `taken` off the
 * task's woken stack (sched_node_woken.velt `takeWoken`) leaves QUEUED: one run from elsewhere
 * (a microtask, its start) may still be on the stack, and a wake must not push it there twice.
 */
export function run(task: usize, n: usize, taken: bool): void {
  if (taken) {
    m.and32(n + N_FLAGS, ~QUEUED);
  }
  const fl = m.load32(n + N_FLAGS);
  if ((fl & (FINISHED | RUNNING)) !== 0) {
    return;
  }
  // A woken node's turn is its own: its socket operations spend a budget of its own
  // (sched_budget.velt). A started promise's first run (`start`) spends its starter's, as the
  // runtime's coop has it, or an accept loop starting one per connection would never yield.
  if (taken) {
    bd.refill();
  }
  if ((fl & CATCHES) !== 0) {
    if (!nc.runCaught(n)) {
      return;
    }
  } else {
    setFlags(n, RUNNING);
    // SAFETY: a started node's state, polled only by its task, with its own cx.
    const r = unsafe { statePoll(m.ld(n + N_POLL), n + N_HEAD + 16, n + N_CX) };
    m.and32(n + N_FLAGS, ~RUNNING);
    if (r !== 1) {
      return;
    }
  }
  if ((m.load32(n + N_FLAGS) & REJECTING) !== 0) {
    // Its owner may claim the result on another worker: it keeps where it threw (the state's
    // poll is not needed any more), published before FINISHED.
    loc.keep(n + N_FLAGS, n + N_HEAD + 16, n + N_POLL);
  }
  // A handed-over node's transfer runs before FINISHED shows (sched_node_transfer.velt).
  tr.finished(n);
  // Its owner may drop or await it on another worker meanwhile (sched_node_await.velt): the old
  // flags say whether the drop came first, and the awaiter word is claimed as `finishAwaiter` says.
  const prev = m.or32(n + N_FLAGS, FINISHED);
  m.st(task + t.T_LOCALS, m.ld(task + t.T_LOCALS) - 1);
  if ((prev & DETACHED) !== 0) {
    rp.dropResult(n);
  } else if (!sh.settled(n, task)) {
    const w = aw.finishAwaiter(n, task);
    if (w !== 0) {
      if (wk.taskOf(w) === task) {
        // Its awaiter is the task's root or another promise it drives: its reaction is queued
        // now, as Node queues a promise's reactions when it settles, and that entry is its step.
        micro.enqueue(task, w, true);
      } else {
        m.wakeOwned(w);
      }
    }
  }
  release(n);
}

/** Is started node `w` (a waker header) among its task's woken nodes? */
export function queued(w: usize): bool {
  return (m.load32(w + N_FLAGS) & QUEUED) !== 0;
}

/** Is `w` a waker header of a started node of task `task`? */
export function ownNode(task: usize, w: usize): bool {
  return m.ld(w) === t.main() + t.E_NODE_VT && m.ld(w + N_TASK) === task;
}

/** Gives back one reference to node `n`: the last frees it. */
export function release(n: usize): void {
  if (m.dec(n + N_REFS) === 1) {
    const task = m.ld(n + N_TASK);
    m.release(n, m.ld32(n + N_BYTES) as usize);
    if (task !== 0) {
      wk.release(task);
    }
  }
}
