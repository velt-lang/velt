// velt/lang/hooks (internal): the owner of a started promise of the executor in Velt
// (sched_node.velt) waits for its finish, which its task may run on another worker.
//
// A promise handed to another task (a `spawn` argument) is awaited or dropped by its owner on
// one worker while its task finishes it on another (#2881, #2891). The two meet only in the
// flags and the awaiter word, as in the runtime's `finish` (velt_rt task/local/node/mod.rs):
// - The finish sets FINISHED with an atomic or, and the owner's drop sets DETACHED the same way:
//   whichever comes second sees the other's bit in the old word and drops the result (once).
// - The owner stores its waker with an atomic swap and then reads FINISHED again; the finish
//   sets FINISHED, then takes the waker with an atomic swap. Either the finish finds the waker
//   (and wakes it), or the owner finds FINISHED (and takes its waker back, or finds it gone,
//   taken by the finish, which wakes it). With a plain load and store, the owner could read the
//   flags before FINISHED was set and store its waker after the finish found the word empty: the
//   owner was never woken (a waiter of a `Promise.all` of spawns, and so `main`, waited for
//   ever: #2891).
// - The finish runs in a poll of the node's task, which one worker polls at a time. An owner on
//   that task (the common case: a task awaits a promise it made) runs on the same thread, as do
//   both with one worker and no rescue (sched_lock.velt `LK_NONE`, which never changes): then
//   the owner reads and writes the awaiter word and the flags as before, with no swap and no
//   second read (`ownSide`). The finish sees whose waker it takes: its task's own (the task
//   itself) is cleared with a plain store, as no other thread can store one while that owner
//   waits; an empty word needs no swap either, as an owner storing its waker after the finish
//   read it reads FINISHED again and wakes itself.

import { inline, noInline } from "velt/lang/intrinsics";
import * as lk from "./sched_lock";
import * as m from "./sched_mem";
import * as nd from "./sched_node";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/** The waker of whoever awaits a node (sched_node.velt's head). */
export const N_AWAITER: usize = 32;

/**
 * The owner waits for node `n`: its waker is woken when `n` finishes. The finish may run on
 * another worker meanwhile (module docs): a finish that came first is seen in the flags after the
 * waker is stored, and the waker is woken then (the owner polls again and finds it finished).
 */
export function awaitNode(n: usize, cx: usize): u32 {
  return awaitWith(n, m.ld(cx + 8));
}

/**
 * `awaitNode` with waker `cw` (cloned), not a cx's: a shared promise's hub on another task
 * (sched_share_away.velt) registers its first waiting holder's waker.
 */
@inline
export function awaitWith(n: usize, cw: usize): u32 {
  const w = m.wakerClone(cw);
  if (lk.mode() === lk.LK_NONE || wk.taskOf(cw) === m.ld(n + nd.N_TASK)) {
    // The owner runs on the node's task (module docs).
    const old = m.ld(n + N_AWAITER);
    m.st(n + N_AWAITER, w);
    if (old !== 0) {
      m.wakerDrop(old);
    }
    return 0;
  }
  const old = m.swap(n + N_AWAITER, w);
  if (old !== 0) {
    m.wakerDrop(old);
  }
  if ((m.load32(n + nd.N_FLAGS) & nd.FINISHED) !== 0) {
    finishedMeanwhile(n);
  }
  return 0;
}

/**
 * Takes node `n`'s awaiter (0 if none) for its finish on task `task`, nd.FINISHED set already: with
 * a swap only when the owner may run on another worker (module docs).
 */
@inline
export function finishAwaiter(n: usize, task: usize): usize {
  if (lk.mode() === lk.LK_NONE) {
    return takePlain(n);
  }
  const w = m.load(n + N_AWAITER);
  if (w === 0) {
    // An owner storing its waker now reads nd.FINISHED after it (`awaitNode`).
    return 0;
  }
  if (w === task) {
    // The task's root waits: it runs on this thread.
    m.st(n + N_AWAITER, 0);
    return w;
  }
  return m.swap(n + N_AWAITER, 0);
}

/** Takes node `n`'s awaiter (0 if none), which no other thread touches meanwhile. */
@inline
export function takePlain(n: usize): usize {
  const w = m.ld(n + N_AWAITER);
  if (w !== 0) {
    m.st(n + N_AWAITER, 0);
  }
  return w;
}

/**
 * Does the owner of started node `n` run on its task's thread, so that the finish never runs
 * meanwhile (module docs)?
 */
@inline
export function ownSide(n: usize): bool {
  if (lk.mode() === lk.LK_NONE) {
    return true;
  }
  const e = t.exec();
  return e !== 0 && m.ld(e + t.E_CURRENT) === m.ld(n + nd.N_TASK);
}

/**
 * Node `n` finished while its owner stored its waker (`awaitNode`): the waker taken back and
 * woken, unless the finish took it (and woke it) already.
 */
@noInline
function finishedMeanwhile(n: usize): void {
  const w = m.swap(n + N_AWAITER, 0);
  if (w !== 0) {
    m.wakeOwned(w);
  }
}
