// velt/lang/hooks (internal): `yieldNow()` under the executor in Velt (sched.velt): `await
// yieldNow()` (`schedYield`, and `schedYieldReady` when it resumes) and a stored one
// (`schedYieldFut`). In Node a yield is a macrotask, an immediate (#3241): yields resume in the
// order they were made, each after the microtasks queued before it, and the microtasks one queues
// run before the next yield's turn.
//
// A task's yields wait for their turn on its yield list (in its yield block, `T_YIELDS`; flag
// `YIELDS`), in the order they were made (their numbers), and its next poll fires them one at a
// time (sched_fire.velt `fireYields`): each wakes what waits for it and runs it, then the task's
// microtasks, the promises they woke and its root if it woke run before the next. On the list:
// - an awaited yield of a started promise or of a join's child: a record with a clone of its
//   waker (`ls.held`), which the yield's suspension holds as its token until its resume or its
//   cancel takes it: the resume goes on once that record's turn came, whatever cx polls it, and
//   a resume with another cx than the yield's (an owner that adopted the state, or a child that
//   was detached to run on its own) has the record wake that cx instead. So the children of an
//   inline `Promise.all`, which yield with their parent's cx, take their turns in the order they
//   yielded, as in Node (#3611, #3687). A started promise that yielded is flagged `YIELDING`
//   until a turn of its: its owner does not adopt it meanwhile (sched_node.velt `pollNode`).
// - a stored `yieldNow()` (a heap future, a leaf its waiter polls) that its task polled in the
//   poll that made it, for a waiter other than the root.
// A stored yield joins the list only then. Made in an earlier generation of its task (one more in
// each poll after one that made stored yields: flag `FRESH`), its turn has passed: it is ready.
// Polled by another task first, its turn is that task's, from that task's poll then.
// A root that yields turns `YIELDED`: queued again for its next poll. Each of its awaited
// yields takes a turn of its own (#3687): a record on the list, behind the yields made before
// it, which it goes on by, and the root is polled at that turn even if it yielded again meanwhile
// (sched_fire.velt `resume`). So the children of an inline `Promise.all` the root awaits, which
// yield with its cx, take their turns in the order they yielded. The fast path, the first yield
// of a poll in a task with no yield block in use (none, or one parked: sched_yield_list.velt
// `park`) or with nothing listed, has no record: it goes on in a later poll (`YIELDED`,
// which a poll's `RUNNING` ends), and flag `ROOT_ALONE` gives it a record first if yields made
// after it join the list in this poll.
// Off the workers (a C library's thread, no task current), a yield wakes at once, as before.
// Only a program that yields compiles the list's turns (`stdUsed("yields")`).

import { fnAddress, inline, noInline, noteStdUse } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as node from "./sched_node";
import * as ls from "./sched_yield_list";
import * as t from "./sched_task";

/** The task being polled on this thread (0: none, or off the workers). */
@inline("always")
function current(): usize {
  const e = t.here();
  return e === 0 ? 0 : m.ld(e + t.E_CURRENT);
}

/**
 * `await yieldNow()`: what polls with `cx` runs again at its turn, after the other ready tasks.
 * Its record on the task's list, the token its suspension holds until a resume or its cancel
 * takes it (`schedYieldReady`, `schedYieldDrop`; encoded as `ls.POLL` says). The root's yield,
 * the common one, inlines where it is awaited; the rest is out of line.
 */
@inline("always")
export function schedYield(cx: usize): usize {
  noteStdUse("yields");
  const w = m.ld(cx + 8);
  if (cx === w + t.T_CX) {
    return rootYield(w, 0);
  }
  return otherYield(w);
}

/**
 * `await yieldNow()` with waker `w` and a cx that is not a task's own (`schedYield`;
 * sched_task.velt `T_CX`): a task's waker in another cx (the runtime's, around a leaf) is still
 * its root's yield. Otherwise a record held by the yield (`ls.held`), on its task's list.
 */
@noInline
function otherYield(w: usize): usize {
  const vt = m.ld(w);
  if (vt === t.main() + t.E_VT) {
    return rootYield(w, 0);
  }
  const k = current();
  if (k === 0) {
    m.wakeByRef(w);
    return ls.OFF;
  }
  if (vt === t.main() + t.E_NODE_VT) {
    m.or32(w + node.N_FLAGS, node.YIELDING);
  }
  const r = ls.held(m.wakerClone(w), k, ls.nextStamp(ls.block(k)));
  ls.join(k, r);
  return r;
}

/**
 * The root of task `k` (running) yields: for yield `y` (stored), or an awaited one (0). Each
 * awaited yield takes a turn of its own: its record (the token its resume asks by, #3687), unless
 * it is the poll's first in a task with no yield block, which only marks the root `YIELDED` (0).
 * The children of an inline `Promise.all` the root awaits yield with its cx, and take their turns
 * in the order they yielded, as in Node. A stored yield shares the root's turn in this poll.
 */
@inline("always")
function rootYield(k: usize, y: usize): usize {
  // Polled again once this poll returns, at the back of the queue. While it runs, only a wake
  // changes its state, from RUNNING to NOTIFIED: a store, not a swap.
  const b = m.ld(k + t.T_YIELDS);
  if (y !== 0) {
    storedRootYield(k, y, ls.blockOf(k));
    return 0;
  }
  // Only this thread stores `YIELDED` (a wake stores `NOTIFIED`): a relaxed read.
  if (m.load32Relaxed(k + t.T_STATE) === t.YIELDED) {
    return rootYieldAgain(k);
  }
  m.store32(k + t.T_STATE, t.YIELDED);
  // A block that isn't parked (`ls.PARKED`, the top bit): one compare.
  if (b - 1 < ls.PARKED - 1) {
    if (t.has(k, t.YIELDS)) {
      return rootRecordFirst(k, b);
    }
    // Nothing listed: its stamp the last one made, so a yield made after it in this poll gives it
    // a record first (`ROOT_ALONE`, `ls.join`).
    m.st(b + ls.B_ROOT, m.ld(b + ls.B_STAMP));
    t.flags(k, t.ROOT_ALONE, 0);
  }
  // No record: it goes on once this poll is over, whatever cx asks then (`ls.POLL`).
  return ls.POLL;
}

/**
 * Another awaited root yield in this poll (a child of an inline `Promise.all` the root awaits):
 * the block made now if there is none, which gives the first its turn first (`ROOT_ALONE`), and a
 * record of its own behind it.
 */
@noInline
function rootYieldAgain(k: usize): usize {
  return rootRecord(k, ls.block(k));
}

/** The poll's first awaited root yield, behind yields already listed: a record of its own. */
@noInline
function rootRecordFirst(k: usize, b: usize): usize {
  // A mark left from an earlier poll would add a record for a turn that has passed.
  t.flags(k, 0, t.ROOT_ALONE);
  return rootRecord(k, b);
}

/** An awaited root yield's record on task `k`'s list (block `b`), behind the yields before it. */
function rootRecord(k: usize, b: usize): usize {
  const r = ls.held(ls.ROOT, k, ls.nextStamp(b));
  // A first yield of this poll with no record yet (`ROOT_ALONE`) gets one first.
  ls.join(k, r);
  return r;
}

/**
 * Stored yield `y` of task `k`'s root (block `b`, parked or not, 0: none): it shares the root's
 * turn in this poll.
 */
@noInline
function storedRootYield(k: usize, y: usize, b: usize): void {
  if (m.load32(k + t.T_STATE) === t.YIELDED) {
    return;
  }
  m.store32(k + t.T_STATE, t.YIELDED);
  if (b === 0) {
    return;
  }
  if (!t.has(k, t.YIELDS)) {
    // Its stamp, for a record if yields join after it.
    m.st(b + ls.B_ROOT, m.ld(y + ls.Y_STAMP));
    t.flags(k, t.ROOT_ALONE, 0);
    return;
  }
  // Its record goes on the list now (a mark left from an earlier poll would add a second),
  // behind the yields made before it.
  t.flags(k, 0, t.ROOT_ALONE);
  m.st(y + ls.Y_WAKER, ls.ROOT);
  ls.join(k, y);
}

/**
 * `await yieldNow()` resumes: 1 to go on, 0 to stay suspended. The poll that yielded may poll the
 * yield again for its microtasks (a microtask's entry resumes the root or runs a started promise
 * directly, and an inline `Promise.all` polls every child it has); a yield goes on only once its
 * own turn came:
 * - with a record (`record`, from `otherYield` or `rootRecord`): once the record's turn came, whatever cx polls it
 *   (`heldPoll`), which frees it then. The children of an inline `Promise.all` yield with their
 *   parent's cx, and a state may be polled with another cx than the one it yielded with (its
 *   owner adopted it, or it was detached to run on its own): its record wakes that cx then, so
 *   the turns come in the order the yields were made, as in Node (#3611, #3687);
 * - with no record (`ls.POLL`: the root's first yield in a poll, with no block in use or nothing
 *   listed): in a later poll (`YIELDED`, which a poll's `RUNNING` ends), whatever cx asks
 *   (`ls.pollReady`);
 * - off the workers (`ls.OFF`): once the promise ran from its task's woken stack (`ls.QUEUED`,
 *   sched_node.velt `run`), or at once with any other waker.
 */
@inline("always")
export function schedYieldReady(cx: usize, record: usize): u32 {
  const w = m.ld(cx + 8);
  if (cx === w + t.T_CX && record <= ls.OFF) {
    // The task's own cx with no record, the common one: `YIELDED` lasts exactly the poll it
    // yielded in, and no table is loaded.
    return m.load32(w + t.T_STATE) === t.YIELDED ? 0 : 1;
  }
  return otherReady(w, record);
}

/** `schedYieldReady` with waker `w` and `record`, but for the task's own cx with no record. */
@noInline
function otherReady(w: usize, record: usize): u32 {
  if (record > ls.OFF) {
    return ls.heldPoll(record, w, current());
  }
  const vt = m.ld(w);
  if (vt === t.main() + t.E_VT) {
    // A task's waker in another cx: its state, as with its own cx.
    return m.load32(w + t.T_STATE) === t.YIELDED ? 0 : 1;
  }
  if (record === ls.POLL) {
    return ls.pollReady(current(), w, vt === t.main() + t.E_NODE_VT);
  }
  if (
    vt === t.main() + t.E_NODE_VT &&
    (m.load32(w + node.N_FLAGS) & (node.QUEUED | node.YIELDING)) !== 0
  ) {
    return 0;
  }
  return 1;
}

/**
 * The cancel of a state suspended at `await yieldNow()`: its record (0: none) goes, as a stored
 * yield's drop does (`storedDrop`: one still waiting is freed by the list at its turn).
 */
export function schedYieldDrop(record: usize): void {
  if (record <= ls.OFF) {
    // No record: nothing to drop.
    return;
  }
  if (m.ld(record + ls.Y_TASK) === current()) {
    // On its task's thread, where its turn would take the waker: the node it flags lets go.
    ls.letGo(m.ld(record + ls.Y_WAKER));
  }
  storedDrop(record);
}

/**
 * A stored `yieldNow()` (`velt_rt_yield_now_fut`: kept, raced, joined or spawned instead of
 * awaited at once): a heap future of its task's generation, numbered, ready once its turn came.
 * Off the workers, a leaf whose first poll wakes what polls it and whose next poll is ready.
 */
export function schedYieldFut(): usize {
  noteStdUse("yields");
  const k = current();
  if (k === 0) {
    const f = m.alloc(24);
    m.st(f, fnAddress(yieldPoll));
    m.st(f + 8, fnAddress(yieldDrop));
    m.st(f + 16, 0);
    return f;
  }
  const f = m.alloc(ls.Y_SIZE);
  m.st(f, fnAddress(storedPoll));
  m.st(f + 8, fnAddress(storedDrop));
  m.st(f + ls.Y_WAKER, 0);
  m.st(f + ls.Y_STATE, ls.NEW);
  made(f, k);
  return f;
}

/** Stored yield `f` is task `k`'s, of its generation now, numbered (on `k`'s thread). */
@inline("always")
function made(f: usize, k: usize): void {
  m.st(f + ls.Y_TASK, k);
  m.st(f + ls.Y_STAMP, ls.nextStamp(ls.block(k)));
  t.flags(k, t.FRESH, 0);
}

function storedPoll(f: usize, cx: usize): u32 {
  const s = m.load(f + ls.Y_STATE);
  if (s === ls.FIRED) {
    return 1;
  }
  const w = m.ld(cx + 8);
  if (s === ls.NEW) {
    return pollNew(f, w);
  }
  const mine = m.load(f + ls.Y_WAKER);
  if (mine === w) {
    return 0;
  }
  const k = m.ld(f + ls.Y_TASK);
  if (k === current()) {
    // Polled in its task's poll, on the thread its turn comes on: nothing else touches it now.
    const want = w === k ? ls.ROOT : w;
    if (mine !== want) {
      m.st(f + ls.Y_WAKER, want === ls.ROOT ? ls.ROOT : m.wakerClone(w));
      if (mine > ls.ROOT) {
        m.wakerDrop(mine);
      }
    }
    return 0;
  }
  // Polled from another task (its owner handed it on): its waker swapped in, then a turn that
  // came meanwhile is seen.
  const old = m.swap(f + ls.Y_WAKER, m.wakerClone(w));
  if (old > ls.ROOT) {
    m.wakerDrop(old);
  }
  if (ls.settled(f) === ls.FIRED) {
    const again = m.swap(f + ls.Y_WAKER, 0);
    if (again > ls.ROOT) {
      m.wakerDrop(again);
    }
    return 1;
  }
  return 0;
}

function storedDrop(f: usize): void {
  const s = m.load(f + ls.Y_STATE);
  if (s === ls.NEW || s === ls.FIRED) {
    // On no list: nothing else touches it (a turn that fired it took its waker).
    m.release(f, ls.Y_SIZE);
    return;
  }
  if (m.ld(f + ls.Y_TASK) === current()) {
    // In its task's poll (`storedPoll`): plain loads and stores.
    const mine = m.ld(f + ls.Y_WAKER);
    if (mine > ls.ROOT) {
      m.wakerDrop(mine);
    }
    if (m.ld(f + ls.Y_STATE) === ls.QUEUED) {
      m.st(f + ls.Y_WAKER, 0);
      m.st(f + ls.Y_STATE, ls.DROPPED);
    } else {
      m.release(f, ls.Y_SIZE);
    }
    return;
  }
  const w = m.swap(f + ls.Y_WAKER, 0);
  if (w > ls.ROOT) {
    m.wakerDrop(w);
  }
  if (m.cas(f + ls.Y_STATE, ls.QUEUED, ls.DROPPED) === ls.QUEUED) {
    // Still on its task's list, which frees it at its turn.
    return;
  }
  ls.settled(f);
  m.release(f, ls.Y_SIZE);
}

/**
 * Stored yield `f`, on no list, polled with waker `w`: ready once its turn has passed; otherwise
 * it takes its turn in order, joining the list unless the root waits for it. Only the task
 * polling it touches it (its own task, or the one it was handed to, whose turn it becomes).
 */
function pollNew(f: usize, w: usize): u32 {
  let k = m.ld(f + ls.Y_TASK);
  // Its task's root is polled only in its task's poll: no need to ask which task runs here.
  const j = w === k ? k : current();
  if (j !== k) {
    if (j === 0) {
      // Off the workers: ready at its next poll.
      m.st(f + ls.Y_STATE, ls.FIRED);
      m.wakeByRef(w);
      return 0;
    }
    made(f, j);
    k = j;
  } else if (m.ld(f + ls.Y_STAMP) / ls.GEN !== m.ld(ls.blockOf(k) + ls.B_STAMP) / ls.GEN) {
    return 1;
  }
  if (w === k) {
    rootYield(k, f);
  } else {
    m.st(f + ls.Y_WAKER, m.wakerClone(w));
    ls.join(k, f);
  }
  return 0;
}

/**
 * A stored yield made off the workers: its word at +16 is 0 until it yields, then its record + 1
 * (`schedYield`, `ls.OFF` off the workers): a record when it is polled on a worker, which its drop
 * gives back if no resume took it.
 */
function yieldPoll(f: usize, cx: usize): u32 {
  const yielded = m.ld(f + 16);
  if (yielded !== 0) {
    const r = schedYieldReady(cx, yielded - 1);
    if (r !== 0) {
      m.st(f + 16, 1);
    }
    return r;
  }
  m.st(f + 16, schedYield(cx) + 1);
  return 0;
}

function yieldDrop(f: usize): void {
  const yielded = m.ld(f + 16);
  if (yielded > 1) {
    schedYieldDrop(yielded - 1);
  }
  m.release(f, 24);
}

/**
 * A poll of task `k`, whose flags were `fl`, begins: the stored yields the last one made had their
 * turn (a new generation). (A root that yielded goes on as the poll's `RUNNING` ends `YIELDED`.)
 */
@inline("always")
export function begin(k: usize, fl: u32): void {
  if ((fl & t.FRESH) !== 0) {
    t.flags(k, 0, t.FRESH);
    // A new generation: the next stamp is above every one made so far.
    const b = ls.blockOf(k);
    m.st(b + ls.B_STAMP, (m.ld(b + ls.B_STAMP) / ls.GEN + 1) * ls.GEN);
  }
}
