// velt/lang/hooks (internal): `yieldNow()` under the executor in Velt (sched.velt): `await
// yieldNow()` (`schedYield`, and `schedYieldReady` when it resumes) and a stored one
// (`schedYieldFut`). In Node a yield is a macrotask, an immediate (#3241): yields resume in the
// order they were made, each after the microtasks queued before it, and the microtasks one queues
// run before the next yield's turn.
//
// A task's yields wait for their turn on its yield list (`T_YIELDS`, flag `YIELDS`), in the order
// they came, and its next poll fires them one at a time (sched_fire.velt `fireYields`): each
// wakes what waits for it and runs it, then the task's microtasks, the promises they woke and its
// root if it woke run before the next. On the list:
// - a stored `yieldNow()`: its heap future, made on the list (a leaf the waiter polls);
// - an awaited yield of a started promise or of a join's child: a record with a clone of its
//   waker. A started promise that yielded is flagged `YIELDING` until its turn: its owner does not
//   adopt it meanwhile (sched_node.velt `pollNode`), and its yield does not go on.
// An awaited yield of the task's root needs no record while the list is empty: its state turns
// `NOTIFIED` and its next poll resumes it (flag `ROOT_YIELDED` holds it back if this poll polls the
// root again for its microtasks). With yields on the list, the root's waits on it too, behind them.
// Off the workers (a C library's thread, no task current), a yield wakes at once, as before.

import { fnAddress, inline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as node from "./sched_node";
import * as t from "./sched_task";

// A yield on its task's list: a heap future's header (0, 0 for an awaited yield's record), the
// next on the list (the list is circular: `T_YIELDS` is the last), the waker to wake at its turn
// (0: none yet), its state.
const Y_NEXT: usize = 16;
const Y_WAKER: usize = 24;
const Y_STATE: usize = 32;
const Y_SIZE: usize = 40;
// A stored yield's states: waiting on the list; its turn came; dropped while waiting (the list
// frees it at its turn).
const QUEUED: usize = 0;
const FIRED: usize = 1;
const DROPPED: usize = 2;

/** The task being polled on this thread (0: none, or off the workers). */
@inline("always")
function current(): usize {
  const e = t.here();
  return e === 0 ? 0 : m.ld(e + t.E_CURRENT);
}

/** `await yieldNow()`: what polls with `cx` runs again at its turn, after the other ready tasks. */
export function schedYield(cx: usize): void {
  const w = m.ld(cx + 8);
  const vt = m.ld(w);
  if (vt === t.main() + t.E_VT) {
    t.flags(w, t.ROOT_YIELDED, 0);
    if (m.ld(w + t.T_YIELDS) === 0) {
      // Running: polled again once this poll returns, at the back of the queue. While it runs,
      // only a wake changes its state, from RUNNING to NOTIFIED: a store, not a swap.
      m.store32(w + t.T_STATE, t.NOTIFIED);
      return;
    }
    // Behind the yields made before it.
    push(w, record(m.wakerClone(w)));
    return;
  }
  const k = current();
  if (k === 0) {
    m.wakeByRef(w);
    return;
  }
  if (vt === t.main() + t.E_NODE_VT) {
    m.or32(w + node.N_FLAGS, node.YIELDING);
  }
  push(k, record(m.wakerClone(w)));
}

/**
 * `await yieldNow()` resumes: 1 to go on, 0 to stay suspended. The poll that yielded may poll the
 * yield again for its microtasks (a microtask's entry resumes the root or runs a started promise
 * directly, and an inline `Promise.all` polls every child it has); a yield goes on only once its
 * wake had its turn:
 * - polled with its task's cx: in a later poll (`ROOT_YIELDED`, cleared as a poll begins; another
 *   yield of the root in this poll holds it back as well: one poll late at most, never early);
 * - polled with a started promise's: once its turn on the list came (`YIELDING`), or, off the
 *   workers, once the promise ran from its task's woken stack (`QUEUED`, sched_node.velt `run`);
 * - with any other waker (a join's child: only children that woke are polled): at once.
 */
@inline("always")
export function schedYieldReady(cx: usize): u32 {
  const w = m.ld(cx + 8);
  const vt = m.ld(w);
  if (vt === t.main() + t.E_VT) {
    return t.has(w, t.ROOT_YIELDED) ? 0 : 1;
  }
  if (
    vt === t.main() + t.E_NODE_VT &&
    (m.load32(w + node.N_FLAGS) & (node.QUEUED | node.YIELDING)) !== 0
  ) {
    return 0;
  }
  return 1;
}

/**
 * A stored `yieldNow()` (`velt_rt_yield_now_fut`: kept, raced, joined or spawned instead of
 * awaited at once): a heap future made on its task's yield list, ready once its turn came. Off
 * the workers, a leaf whose first poll wakes what polls it and whose next poll is ready.
 */
export function schedYieldFut(): usize {
  const k = current();
  if (k === 0) {
    const f = m.alloc(24);
    m.st(f, fnAddress(yieldPoll));
    m.st(f + 8, fnAddress(yieldDrop));
    m.st(f + 16, 0);
    return f;
  }
  const f = m.alloc(Y_SIZE);
  m.st(f, fnAddress(storedPoll));
  m.st(f + 8, fnAddress(storedDrop));
  m.st(f + Y_WAKER, 0);
  m.st(f + Y_STATE, QUEUED);
  push(k, f);
  return f;
}

function storedPoll(f: usize, cx: usize): u32 {
  if (m.load(f + Y_STATE) === FIRED) {
    return 1;
  }
  // Polled from any task (its owner may have handed it on): its waker swapped in, then a turn
  // that came meanwhile is seen.
  const w = m.ld(cx + 8);
  if (m.load(f + Y_WAKER) !== w) {
    const old = m.swap(f + Y_WAKER, m.wakerClone(w));
    if (old !== 0) {
      m.wakerDrop(old);
    }
  }
  if (m.load(f + Y_STATE) === FIRED) {
    const mine = m.swap(f + Y_WAKER, 0);
    if (mine !== 0) {
      m.wakerDrop(mine);
    }
    return 1;
  }
  return 0;
}

function storedDrop(f: usize): void {
  const w = m.swap(f + Y_WAKER, 0);
  if (w !== 0) {
    m.wakerDrop(w);
  }
  if (m.cas(f + Y_STATE, QUEUED, DROPPED) === QUEUED) {
    // Still on its task's list, which frees it at its turn.
    return;
  }
  m.release(f, Y_SIZE);
}

function yieldPoll(f: usize, cx: usize): u32 {
  if (m.ld(f + 16) !== 0) {
    return schedYieldReady(cx);
  }
  m.st(f + 16, 1);
  schedYield(cx);
  return 0;
}

function yieldDrop(f: usize): void {
  m.release(f, 24);
}

/** An awaited yield's record on its task's list, to wake `w` (a waker's clone) at its turn. */
function record(w: usize): usize {
  const r = m.alloc(Y_SIZE);
  m.st(r, 0);
  m.st(r + 8, 0);
  m.st(r + Y_WAKER, w);
  m.st(r + Y_STATE, QUEUED);
  return r;
}

/** Yield `y` joins the end of task `k`'s list (on the thread polling `k`). */
function push(k: usize, y: usize): void {
  const last = m.ld(k + t.T_YIELDS);
  if (last === 0) {
    m.st(y + Y_NEXT, y);
  } else {
    m.st(y + Y_NEXT, m.ld(last + Y_NEXT));
    m.st(last + Y_NEXT, y);
  }
  m.st(k + t.T_YIELDS, y);
  // Its next poll fires them (sched_run.velt `runWoken`), and this one's end queues it again.
  t.flags(k, t.YIELDS | t.LOCALS, 0);
}

/**
 * Takes task `k`'s yields made so far, the first of them (0: none), linked through `next`: those
 * made from now on wait for the poll after.
 */
export function take(k: usize): usize {
  t.flags(k, 0, t.YIELDS);
  const last = m.ld(k + t.T_YIELDS);
  if (last === 0) {
    return 0;
  }
  m.st(k + t.T_YIELDS, 0);
  const first = m.ld(last + Y_NEXT);
  m.st(last + Y_NEXT, 0);
  return first;
}

/** The yield after `y` in a list `take` gave. */
@inline("always")
export function next(y: usize): usize {
  return m.ld(y + Y_NEXT);
}

/**
 * Yield `y`'s turn: the waker to resume (a clone the caller owns), 0 when nothing waits for it.
 * An awaited yield's record is freed, and a dropped stored one.
 */
export function fire(y: usize): usize {
  if (m.ld(y) === 0) {
    const w = m.ld(y + Y_WAKER);
    m.release(y, Y_SIZE);
    if (m.ld(w) === t.main() + t.E_NODE_VT) {
      m.and32(w + node.N_FLAGS, ~node.YIELDING);
    }
    return w;
  }
  if (m.cas(y + Y_STATE, QUEUED, FIRED) !== QUEUED) {
    m.release(y, Y_SIZE);
    return 0;
  }
  return m.swap(y + Y_WAKER, 0);
}

/** A poll of task `k`, whose flags were `fl`, begins: the root's yield of the last one is over. */
@inline("always")
export function begin(k: usize, fl: u32): void {
  if ((fl & t.ROOT_YIELDED) !== 0) {
    t.flags(k, 0, t.ROOT_YIELDED);
  }
}
