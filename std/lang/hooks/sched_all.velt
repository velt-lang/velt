// velt/lang/hooks (internal): `Promise.all` over an array under the executor in Velt (sched.velt,
// #2649, #2944): `velt_rt_all`'s, `_with_drop`'s and `_or_reject`'s job (`schedAll`), a join
// that polls only the children that woke.
//
// A join is a heap future (rt_abi_async.md §1, a unit result) and its children's records, in one
// allocation. Lowering wraps it as it wrapped the runtime's (a boxed promise, which settles
// through its node), so the join only drives the children:
// - Each child is polled with a `cx` of its own: the awaiter's await word, and the child's record
//   as its waker (a table of the executor's, `E_ALL_VT`, like a task's or a started promise's).
//   A wake pushes the record on the join's ready stack once (`C_QUEUED`) and wakes the join's
//   awaiter. Children may be woken from any thread (a leaf of the runtime's), so nothing on the
//   wake path is a task-side operation (no `sched_lock.velt` lock): the stack is atomic, and a
//   wake reads the awaiter's waker counted in `J_WAKING`; the poll that replaces it, or the drop
//   that clears it, swaps it out and waits until no wake is reading before dropping the old one.
// - The first poll polls every child in array order, as Node subscribes in array order: an input
//   that settled already settles on that pass, so it wins over one that rejects later (#2857).
//   Later polls take the ready stack in wake order and poll only those, one batch a poll. Unlike
//   the runtime's join, it spends no cooperative budget: a pass over children that are ready
//   finishes in one poll, as Node runs their reactions in one turn of its microtask queue.
// - A finished child's result moves to its slot of the caller's buffer. With `reject` (promises
//   that can reject: `Result` slots, tag byte 0 when fulfilled), the first child that rejects
//   settles the join: its result moves to slot 0, the other finished results are dropped, and
//   the unfinished children are given up in array order (dropped: a started promise runs on, as
//   with the runtime's `give_up`).
// - Dropped before it completes, the join drops its unfinished children in array order and the
//   finished results (`rdrop`). Clones of the children's wakers keep the allocation alive: the
//   join's reference count holds one for the join and one per clone.
// Made on a thread that isn't a worker (a C library's, calling an exported function), it is the
// same join: only its awaiter polls it, on a worker (sched_foreign.velt).

import { export as cExport } from "velt/ffi";
import {
  addressLoad,
  fnAddress,
  futDrop,
  futPoll,
  inline,
  noInline,
  stateDrop,
} from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as t from "./sched_task";
import * as wk from "./sched_wake";
import * as workers from "./sched_workers";

/**
 * The join: its heap future's header (poll, drop; the unit result takes no room), then the
 * children's count, the result size, the results, the result drop (0: none), whether a rejection
 * settles it, the children left, whether the first pass ran, the ready stack, the awaiter's
 * waker, the reference count, the state, the wakes reading the awaiter's waker, the `cx` the
 * children are polled with (the awaiter's await word, the child's record), the allocation's size
 * in bytes (a race's holds its own future after the records), the ticket of the reaction step
 * of a join that settled on its first pass (`settleStep`; 0: none), then the children's records.
 */
export const J_N: usize = 16;
export const J_SIZE: usize = 24;
export const J_RESULTS: usize = 32;
export const J_RDROP: usize = 40;
export const J_REJECT: usize = 48;
export const J_LEFT: usize = 56;
export const J_STARTED: usize = 64;
export const J_READY: usize = 72;
export const J_WAKER: usize = 80;
export const J_REFS: usize = 88;
export const J_STATE: usize = 96;
export const J_WAKING: usize = 104;
export const J_CX: usize = 112;
export const J_BYTES: usize = 128;
export const J_TICKET: usize = 136;
export const J_KIDS: usize = 144;

/**
 * A child's record (its waker): the table, the join, the child's future (0 once it finished or was
 * given up), the ready stack's link, whether it is on that stack, whether its result is in its
 * slot (not handed to the awaiter yet).
 */
export const C_VT: usize = 0;
export const C_JOIN: usize = 8;
export const C_FUT: usize = 16;
export const C_NEXT: usize = 24;
export const C_QUEUED: usize = 32;
export const C_DONE: usize = 40;
export const C_SIZE: usize = 48;

/**
 * The join's states: running; complete (every result is the awaiter's, or the rejection in slot
 * 0 is); dropped.
 */
export const RUNNING: usize = 0;
export const COMPLETE: usize = 1;
export const DROPPED: usize = 2;

/**
 * `velt_rt_all*`'s job: a join over the `n` futures at `futs` (theirs now; the pointer array stays
 * the caller's), each result of `size` bytes moved to `results + i * size`; `rdrop` drops one
 * (0: nothing to drop); `reject`: the first rejection settles it.
 */
export function schedAll(
  futs: usize,
  count: u64,
  bytes: u64,
  results: usize,
  rdrop: usize,
  reject: bool,
): usize {
  const n = count as usize;
  const size = bytes as usize;
  const j = core(futs, n, J_KIDS + n * C_SIZE);
  m.st(j, fnAddress(joinPoll));
  m.st(j + 8, fnAddress(joinDrop));
  m.st(j + J_SIZE, size);
  m.st(j + J_RESULTS, results);
  m.st(j + J_RDROP, rdrop);
  m.st(j + J_REJECT, reject ? 1 : 0);
  return j;
}

/**
 * A join's fields and its `n` children's records (the futures at `futs`), in an allocation of
 * `bytes` (at least `J_KIDS + n * C_SIZE`): running, nothing ready, one reference (sched_race.velt
 * builds its race on it too).
 */
export function core(futs: usize, n: usize, bytes: usize): usize {
  const j = m.alloc(bytes);
  m.st(j + J_N, n);
  m.st(j + J_BYTES, bytes);
  m.st(j + J_SIZE, 0);
  m.st(j + J_RESULTS, 0);
  m.st(j + J_RDROP, 0);
  m.st(j + J_REJECT, 0);
  m.st(j + J_LEFT, n);
  m.st(j + J_STARTED, 0);
  m.st(j + J_READY, 0);
  m.st(j + J_WAKER, 0);
  m.st(j + J_REFS, 1);
  m.st(j + J_STATE, RUNNING);
  m.st(j + J_WAKING, 0);
  m.st(j + J_CX, 0);
  m.st(j + J_CX + 8, 0);
  m.st(j + J_TICKET, 0);
  // Worker 0's waker table (before the start, on a C library's thread: the pending block's).
  let g = t.main();
  if (g === 0) {
    g = workers.zeroBlock();
  }
  const vt = g + t.E_ALL_VT;
  for (let i: usize = 0; i < n; i++) {
    const c = kid(j, i);
    m.st(c + C_VT, vt);
    m.st(c + C_JOIN, j);
    m.st(c + C_FUT, m.ld(futs + 8 * i));
    m.st(c + C_NEXT, 0);
    m.st(c + C_QUEUED, 0);
    m.st(c + C_DONE, 0);
  }
  return j;
}

/** Child `i`'s record of join `j`. */
@inline("always")
export function kid(j: usize, i: usize): usize {
  return j + J_KIDS + i * C_SIZE;
}

/** The poll of join `j`: 1 once it settled. */
function joinPoll(j: usize, cx: usize): u32 {
  if (m.ld(j + J_STATE) !== RUNNING) {
    return settledPoll(j, cx);
  }
  register(j, m.ld(cx + 8));
  m.st(j + J_CX, m.ld(cx));
  if (m.ld(j + J_STARTED) === 0) {
    m.st(j + J_STARTED, 1);
    const n = m.ld(j + J_N);
    for (let i: usize = 0; i < n; i++) {
      if (pollKid(j, kid(j, i))) {
        return settleStep(j, cx);
      }
    }
  }
  // One batch a poll: a child woken during it (one that yields wakes itself) woke the awaiter
  // too, so it runs at the join's next poll, after the other tasks ready now.
  let c = reverse(m.takeStack(j + J_READY));
  while (c !== 0) {
    const next = m.ld(c + C_NEXT);
    // Off the stack before its poll: a wake during the poll queues it again.
    m.swap(c + C_QUEUED, 0);
    if (m.ld(c + C_FUT) !== 0 && pollKid(j, c)) {
      return 1;
    }
    c = next;
  }
  if (m.ld(j + J_LEFT) === 0) {
    m.st(j + J_STATE, COMPLETE);
    return 1;
  }
  return 0;
}

/**
 * Join `j` settled on its first pass, from inputs that had settled when it was made: Node runs
 * the reaction that settles the combinator as a microtask of its own (queued when it subscribes
 * to an input that settled already), so the join is ready one step later, at its turn in the
 * task's queue (0 while it waits; 1 off a task, or when nothing could run first). A join settled
 * by a child's wake took that step already: the wake queued the awaiter (`allWakeByRef`).
 */
export function settleStep(j: usize, cx: usize): u32 {
  const w = m.ld(cx + 8);
  const k = t.exec() === 0 ? 0 : wk.taskOf(w);
  // Nothing could run first while the task's await word is 0, as for an `await`'s step
  // (sched.velt `schedAwaitTick`).
  if (k === 0 || m.ld32(k + t.T_WORD) === 0) {
    return 1;
  }
  m.st(j + J_TICKET, micro.enqueue(k, m.wakerClone(w), false) as usize);
  return 0;
}

/** The poll of join `j` once it settled: 1, after its reaction step (`settleStep`) if it has one. */
export function settledPoll(j: usize, cx: usize): u32 {
  const ticket = m.ld(j + J_TICKET) as u64;
  if (ticket === 0) {
    return 1;
  }
  const w = m.ld(cx + 8);
  const k = t.exec() === 0 ? 0 : wk.taskOf(w);
  if (k === 0 || micro.reached(k, ticket, w)) {
    m.st(j + J_TICKET, 0);
    return 1;
  }
  return 0;
}

/** The ready stack from `c` (newest first), in wake order. */
export function reverse(c: usize): usize {
  let prev: usize = 0;
  while (c !== 0) {
    const next = m.ld(c + C_NEXT);
    m.st(c + C_NEXT, prev);
    prev = c;
    c = next;
  }
  return prev;
}

/** Polls child `c` of join `j`: whether the join settled (every child done, or a rejection). */
function pollKid(j: usize, c: usize): bool {
  const f = m.ld(c + C_FUT);
  m.st(j + J_CX + 8, c);
  // SAFETY: `f` is a live heap future the join owns, `j + J_CX` a `cx` of two words.
  const ready = unsafe { futPoll(f, j + J_CX) };
  if (ready !== 1) {
    return false;
  }
  const size = m.ld(j + J_SIZE);
  const i = (c - j - J_KIDS) / C_SIZE;
  const slot = m.ld(j + J_RESULTS) + i * size;
  if (size !== 0) {
    m.copy(slot, f + 16, size);
  }
  m.st(c + C_FUT, 0);
  // SAFETY: the join owns `f`, finished, its result moved out.
  unsafe {
    futDrop(f);
  }
  m.st(j + J_LEFT, m.ld(j + J_LEFT) - 1);
  // SAFETY: slot `i` holds the child's `Result`, its tag byte first.
  const rejected = size !== 0 && unsafe { addressLoad<u8>(slot) } !== 0;
  if (m.ld(j + J_REJECT) !== 0 && rejected) {
    rejectWith(j, i);
    return true;
  }
  m.st(c + C_DONE, 1);
  if (m.ld(j + J_LEFT) === 0) {
    m.st(j + J_STATE, COMPLETE);
    return true;
  }
  return false;
}

/**
 * Child `i` of join `j` rejected (its result in slot `i`): the result moves to slot 0, the other
 * unfinished children are given up in array order, the other finished results are dropped.
 */
@noInline
function rejectWith(j: usize, i: usize): void {
  const size = m.ld(j + J_SIZE);
  const results = m.ld(j + J_RESULTS);
  const rdrop = m.ld(j + J_RDROP);
  const n = m.ld(j + J_N);
  // As the runtime's join: the unfinished children are given up first, then the other finished
  // results are dropped.
  giveUpAll(j);
  for (let k: usize = 0; k < n; k++) {
    const c = kid(j, k);
    if (m.ld(c + C_DONE) !== 0) {
      m.st(c + C_DONE, 0);
      if (rdrop !== 0) {
        // SAFETY: slot `k` holds child `k`'s result, which nobody else owns.
        unsafe {
          stateDrop(rdrop, results + k * size);
        }
      }
    }
  }
  if (i !== 0) {
    m.copy(results, results + i * size, size);
  }
  m.st(j + J_STATE, COMPLETE);
}

/** The unfinished children of join `j`, given up (dropped) in array order. */
function giveUpAll(j: usize): void {
  const n = m.ld(j + J_N);
  for (let k: usize = 0; k < n; k++) {
    const c = kid(j, k);
    const f = m.ld(c + C_FUT);
    if (f !== 0) {
      m.st(c + C_FUT, 0);
      // SAFETY: the join owns `f`; a started promise runs on without its handle.
      unsafe {
        futDrop(f);
      }
    }
  }
}

/** The drop of join `j`: unfinished children and finished results go, then its reference. */
function joinDrop(j: usize): void {
  if (m.ld(j + J_STATE) === RUNNING) {
    giveUpAll(j);
    const rdrop = m.ld(j + J_RDROP);
    if (rdrop !== 0) {
      const size = m.ld(j + J_SIZE);
      const results = m.ld(j + J_RESULTS);
      const n = m.ld(j + J_N);
      for (let k: usize = 0; k < n; k++) {
        if (m.ld(kid(j, k) + C_DONE) !== 0) {
          // SAFETY: slot `k` holds child `k`'s result; the join was dropped before handing it on.
          unsafe {
            stateDrop(rdrop, results + k * size);
          }
        }
      }
    }
  }
  m.st(j + J_STATE, DROPPED);
  dropAwaiter(j, m.swap(j + J_WAKER, 0));
  release(j);
}

/** Join `j`'s awaiter is the one with waker `w` (borrowed): a clone kept, the old one dropped. */
export function register(j: usize, w: usize): void {
  if (m.ld(j + J_WAKER) === w) {
    // Only the poll changes it, so the old value is still its own.
    return;
  }
  dropAwaiter(j, m.swap(j + J_WAKER, m.wakerClone(w)));
}

/**
 * Drops waker `old`, swapped out of join `j`'s `J_WAKER`, once no wake reads it. A wake's
 * increment of `J_WAKING` and its load of the waker are sequentially consistent, as are this
 * swap and the load of the count below (Dekker's argument): either the wake read the new waker,
 * or it is counted here. Its decrement (acquire and release) comes after it used the waker, so
 * a count of 0 seen here means it is done with it. A wake is a few steps with no wait; the core
 * is given away meanwhile.
 */
export function dropAwaiter(j: usize, old: usize): void {
  if (old === 0) {
    return;
  }
  while (m.load(j + J_WAKING) !== 0) {
    m.yieldCore();
  }
  m.wakerDrop(old);
}

/** Gives a reference to join `j` back: the last frees it. */
export function release(j: usize): void {
  if (m.dec(j + J_REFS) === 1) {
    m.release(j, m.ld(j + J_BYTES));
  }
}

@cExport("std_sched_all_clone")
export function allClone(c: usize): usize {
  m.inc(m.ld(c + C_JOIN) + J_REFS);
  return c;
}

@cExport("std_sched_all_wake")
export function allWake(c: usize): void {
  if (wk.counting()) {
    // The program's end waits for wakes by value under way (sched_wake.velt `settleWakes`).
    wk.wakingStarts();
    allWakeByRef(c);
    allDrop(c);
    wk.wakingEnds();
    return;
  }
  allWakeByRef(c);
  allDrop(c);
}

/**
 * A child woke: on its join's ready stack once, and the join's awaiter woken. Woken by the task
 * that awaits the join, in its poll (an input settled by its code, or a promise it drives), the
 * awaiter is queued in that task's microtask queue instead: Node settles a combinator in the
 * reaction it queues on each input, a microtask, and the awaiter's own step follows (no credit,
 * unless the entry running now has a credit left).
 */
@cExport("std_sched_all_wake_by_ref")
export function allWakeByRef(c: usize): void {
  if (m.cas(c + C_QUEUED, 0, 1) !== 0) {
    return;
  }
  const j = m.ld(c + C_JOIN);
  m.pushStack(j + J_READY, c, C_NEXT);
  // Counted while it reads and wakes the awaiter's waker (`dropAwaiter`).
  m.incOrdered(j + J_WAKING);
  const w = m.load(j + J_WAKER);
  if (w !== 0) {
    const e = t.here();
    const k = e === 0 ? 0 : wk.taskOf(w);
    if (k !== 0 && m.ld(e + t.E_CURRENT) === k) {
      // A child that a credited entry ran (a promise settled by `resolve`, which Node queued
      // then) took the reaction's step already: the credit passes on to the awaiter's entry.
      micro.enqueue(k, m.wakerClone(w), micro.takeCredit(k));
    } else {
      m.wakeByRef(w);
    }
  }
  m.dec(j + J_WAKING);
}

@cExport("std_sched_all_drop")
export function allDrop(c: usize): void {
  release(m.ld(c + C_JOIN));
}
