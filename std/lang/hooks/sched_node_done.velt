// velt/lang/hooks (internal): a started promise that finished lets go of its task (#3498). A
// finished promise can never wake its task again, but its reference to the task went only when it
// was freed, so a task parked for ever while its frames still held one (awaited or not, shared
// with holders on the task or not) kept one reference more than the park counts for its listed
// promises (sched_task_lost.velt `counts`), and stayed to the end of the program. Now it gives
// that reference back when it finishes, as soon as nothing but its owner (or its hub) can reach
// it, and stores task 0: its free gives nothing back then (sched_node.velt `release`, as for a
// lazy node). Shared later, its hub takes it for another task's (`AWAY`, as task 0 is not the
// sharing task), which for a finished node only means its first holder's poll settles the hub at
// once (sched_share.velt `pollHolder`); the away watch, which reads the node's task, runs only
// for a waiter left on an unsettled hub, and there is none.
//
// The reference stays, as before, with a rejection (its report reads the task: sched_node_report
// .velt) or with a waker of the node still out: a wake racing the finish (sched_node_wake.velt
// `wakeAway`, after its flag test) pushes the node on the task and wakes the task, which that
// reference keeps alive.

import { noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as nd from "./sched_node";
import * as t from "./sched_task";

/**
 * Node `n` of task `task` finished, on the task's thread, before the task's own reference to it
 * goes (sched_node.velt `run`, `adoptedDone`): it lets go of the task when its count is `refs`,
 * its owner's (or hub's), the task's and those its caller holds for the run (the woken stack's,
 * a microtask entry's) only, and it is no rejection and not dropped (`DETACHED`).
 *
 * The count is read sequentially consistent (an acquire would do), and that read sees every
 * waker of `n`: a waker is made only by a poll of `n` with its own cx, on this thread, so its
 * increment comes before this load in this thread's order; a copy made on another thread is made
 * from a waker still held, so the count does not read `refs` while any is out, and the thread
 * whose drop brought it there gave it back with a release decrement and no longer touches the
 * node. A count read above `refs` keeps the reference, as before. The store of task 0 comes
 * before `release`'s decrement of the count, which orders it for a thread whose later decrement
 * frees the node (its owner's drop on another task): that free reads task 0 and gives nothing
 * back.
 */
@noInline
export function letGo(task: usize, n: usize, refs: usize): void {
  const fl = m.load32(n + nd.N_FLAGS);
  if (m.load(n + nd.N_REFS) === refs && (fl & (nd.REJECTING | nd.DETACHED)) === 0) {
    m.st(n + nd.N_TASK, 0);
    // Never the last: the executor holds the task while this thread polls it.
    m.dec(task + t.T_REFS);
  }
}
