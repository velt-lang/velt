// velt/lang/hooks (internal): the end of the root task of `main` under the executor in Velt
// (sched.velt, #2649): its root done (`mainDone`, from sched_run.velt `rootDone`) and the task
// done (`mainFinish`, from `finish`), the two steps worker 0 waits for before it may end the
// program (sched_task.velt `rootLeft`). Cold paths, once per program.

import { noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as mk from "./sched_make";
import * as micro from "./sched_micro";
import * as wn from "./sched_node_woken";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/** `rootDone` of the root of `main` (task `k`, its result in place). */
@noInline
export function mainDone(e: usize, k: usize): void {
  const g = m.ld(e + t.E_MAIN);
  if (e !== g) {
    // The root ran on another worker (the monitor moved it): what it printed is published before
    // worker 0 can see it done and end the process, which writes out what was published (stdout
    // is buffered per thread; a publish takes the runtime's output lock only when this thread
    // buffered anything).
    wk.publishPrinted(e);
  }
  // Worker 0 reads the flags from its loop (sched_task.velt `rootLeft`): counted live before it
  // can see the root done, and both flags at once (an atomic or, ordered after the count).
  if (m.ld(k + t.T_LOCALS) !== 0) {
    // Its started promises keep running after `main`.
    mk.liveUp(g, e);
    m.or32(k + t.T_FLAGS, t.ROOT_DONE | t.COUNTED);
  } else {
    m.or32(k + t.T_FLAGS, t.ROOT_DONE);
  }
  if (e !== g) {
    // The root ran on another worker (the monitor moved it): worker 0 waits for it.
    wk.unpark(g);
  }
}

/**
 * `finish` of the root task of `main` (task `k`), not counted live: worker 0 waits for the state
 * `DONE` (sched_task.velt `rootLeft`), holding a reference of its own, and may end the program as
 * soon as it sees it. So that state comes last, after everything else the task gives back: a
 * last poll on another worker (the monitor moved it) that set it first left its microtask queue
 * and the executor's reference to free while worker 0 ended the program, 2 blocks the count
 * reported unfreed now and then (#2887).
 */
@noInline
export function mainFinish(e: usize, k: usize): void {
  const g = m.ld(e + t.E_MAIN);
  // The promises left on its woken stack with a reference, as `finish` gives them back.
  wn.giveBackWoken(k);
  micro.free(k);
  // Never the last reference: worker 0's is held until it sees `DONE`.
  wk.release(k);
  // Worker 0 may give its reference back once it sees this, and `k` may be gone then: a wake
  // that pushed after the take above is given back by worker 0 (sched.velt `schedBlockOn`).
  m.store32(k + t.T_STATE, t.DONE);
  if (e !== g) {
    // Worker 0 may sleep, woken at the root's end (`mainDone`) before this.
    wk.unpark(g);
  }
}
