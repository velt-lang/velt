// velt/lang/hooks (internal): the compiler's hooks for a string's `==` and its hash as a `Map` or
// `Set` key (std-layout.md §10b), which lowering calls for every string comparison and key
// (`velt_vir` `lower/ops.rs` `str_eq`, `lower/glue/eq.rs` `hash_value`).
//
// Both stay calls in the optimizer (`@noInline`), which knows them by name: a repeated `Map` probe
// reuses the first one's hash, and a call of either reads only the strings it is handed
// (velt_opt `map_probe`). LLVM's code (velt_codegen_llvm `strings.rs`) writes their common cases
// inline instead of the call: `==` as a length test and one `memcmp`, the hash of an inline
// string of at most 8 bytes from its first word; a longer string's hash calls `strHash`.
//
// The hash: 8-byte little-endian words of the UTF-8, the last one zero-padded, each mixed in by a
// multiply, a xor and a rotation, then murmur3's `fmix64`. It uses a fixed seed, so hashes (and
// anything whose order depends on them) are the same in every run; it is not designed to resist
// hash-flooding by adversarial keys. `Map.getUtf8` hashes a key's bytes in an array with the same
// words (std/lang/map/utf8_key.velt), and LLVM's inline copy must agree bit for bit
// (str_key.test.velt pins the values).

import {
  addressLoad,
  inline,
  noInline,
  strByteLen,
  strDataAddress,
  strWord0,
  strWord2,
} from "velt/lang/intrinsics";

/** The hash's seed. */
const SEED: u64 = 0x243f6a8885a308d3;
/** The hash's multiplier. */
const K: u64 = 0x9e3779b97f4a7c15;
/** Bit 63 of a string's third word: an inline string (its text in the value itself). */
const INLINE: u64 = 0x8000000000000000;

/** `a == b` on strings: the same UTF-8 bytes (a length test, then the bytes). */
@noInline
export function strEquals(a: string, b: string): bool {
  const n = strByteLen(a);
  if (strByteLen(b) != n) {
    return false;
  }
  const pa = strDataAddress(a);
  const pb = strDataAddress(b);
  let i: usize = 0;
  while (i + 8 <= n) {
    // SAFETY: bytes `i` to `i + 7` of both, which have `n` bytes.
    if (unsafe { wordAt(pa + i) } != unsafe { wordAt(pb + i) }) {
      return false;
    }
    i += 8;
  }
  // SAFETY: the last `n - i` bytes of both.
  return i == n || unsafe { tailWord(pa + i, n - i) } == unsafe { tailWord(pb + i, n - i) };
}

/** The hash a string key is stored under. */
@noInline
export function strHash(s: string): u64 {
  const n = strByteLen(s);
  if ((strWord2(s) & INLINE) != 0 && n <= 8) {
    // An inline string's text starts its first word; the bytes after it are masked off.
    const h = SEED ^ ((n as u64) * K);
    if (n == 0) {
      return fmix64(h);
    }
    const word = strWord0(s) & (0xffffffffffffffff >> (64 - 8 * (n as u64)));
    return fmix64(mix(h, word));
  }
  // SAFETY: the `n` bytes of `s`, alive while it is.
  return unsafe { hashAt(strDataAddress(s), n) };
}

/**
 * The hash of the `n` bytes at `at`.
 *
 * Unsafe: the bytes `at` to `at + n` must be readable.
 */
// SAFETY: an unsafe function: its doc comment's `Unsafe:` paragraph says what callers guarantee.
export unsafe function hashAt(at: usize, n: usize): u64 {
  let h = SEED ^ ((n as u64) * K);
  let i: usize = 0;
  while (i + 8 <= n) {
    // SAFETY: bytes `i` to `i + 7` are inside the caller's `n`.
    h = mix(h, unsafe { wordAt(at + i) });
    i += 8;
  }
  if (i < n) {
    // SAFETY: the last `n - i` bytes.
    h = mix(h, unsafe { tailWord(at + i, n - i) });
  }
  return fmix64(h);
}

/** One word mixed into the hash. */
function mix(h: u64, word: u64): u64 {
  return ((h ^ word) * K).rotateLeft(29);
}

/** murmur3's 64-bit finalizer. */
function fmix64(x: u64): u64 {
  let h = x;
  h ^= h >> 33;
  h = h * 0xff51afd7ed558ccd;
  h ^= h >> 33;
  h = h * 0xc4ceb9fe1a85ec53;
  return h ^ (h >> 33);
}

/**
 * The 8 bytes at `at` as a little-endian word. Read a byte at a time, since `at` is any byte's
 * address and a wider load must be aligned (velt_codegen_llvm assumes it of every address);
 * LLVM joins the eight loads into one unaligned load where the target has one.
 *
 * Unsafe: the bytes `at` to `at + 8` must be readable.
 */
@inline("always")
// SAFETY: an unsafe function: its doc comment's `Unsafe:` paragraph says what callers guarantee.
export unsafe function wordAt(at: usize): u64 {
  // SAFETY: the caller's bytes.
  return unsafe { (addressLoad<u8>(at) as u64) |
    ((addressLoad<u8>(at + 1) as u64) << 8) |
    ((addressLoad<u8>(at + 2) as u64) << 16) |
    ((addressLoad<u8>(at + 3) as u64) << 24) |
    ((addressLoad<u8>(at + 4) as u64) << 32) |
    ((addressLoad<u8>(at + 5) as u64) << 40) |
    ((addressLoad<u8>(at + 6) as u64) << 48) |
    ((addressLoad<u8>(at + 7) as u64) << 56) };
}

/**
 * The `rest` bytes (0 to 7) at `at` as one little-endian word, zero above them, none read past
 * the end: 4, 2 and 1 bytes, each read a byte at a time as in `wordAt` (LLVM joins them).
 *
 * Unsafe: the bytes `at` to `at + rest` must be readable.
 */
@inline("always")
// SAFETY: an unsafe function: its doc comment's `Unsafe:` paragraph says what callers guarantee.
export unsafe function tailWord(at: usize, rest: usize): u64 {
  let word: u64 = 0;
  let shift: u64 = 0;
  let i = at;
  if ((rest & 4) != 0) {
    // SAFETY: the caller's bytes, which `rest` counts.
    const lo = unsafe { (addressLoad<u8>(i) as u64) | ((addressLoad<u8>(i + 1) as u64) << 8) };
    // SAFETY: as above.
    const hi = unsafe { (addressLoad<u8>(i + 2) as u64) | ((addressLoad<u8>(i + 3) as u64) << 8) };
    word = lo | (hi << 16);
    i += 4;
    shift = 32;
  }
  if ((rest & 2) != 0) {
    // SAFETY: as above.
    const pair = unsafe { (addressLoad<u8>(i) as u64) | ((addressLoad<u8>(i + 1) as u64) << 8) };
    word |= pair << shift;
    i += 2;
    shift += 16;
  }
  if ((rest & 1) != 0) {
    // SAFETY: as above.
    word |= (unsafe { addressLoad<u8>(i) } as u64) << shift;
  }
  return word;
}
