// velt/lang/hooks (internal): the compiler's hooks for strings (std-layout.md §10b).

import {
  arrayWithCapacity,
  strAsciiWords,
  strByteAt,
  strByteLen,
  strLen,
} from "velt/lang/intrinsics";

declare function velt_rt_str_byte_slice(s: string, start: u64, end: u64): string;

/**
 * The characters of `s` (code points, a surrogate pair as one string, a lone surrogate as one),
 * as JS's string iterator: what `for (const c of s)` iterates (velt_sema `loops.rs`). Each is a
 * range of the string's WTF-8 bytes from one lead byte to the next; an ASCII character is its
 * inline string, with no call.
 */
export function stringCodePoints(s: string): string[] {
  const n = strByteLen(s);
  const out: string[] = arrayWithCapacity(strLen(s));
  let i: usize = 0;
  while (i < n) {
    const b = strByteAt(s, i as u64);
    if (b < 0x80) {
      out.push(strAsciiWords(b as u64, 0, 0, 1));
      i++;
      continue;
    }
    const len: usize = b < 0xe0 ? 2 : b < 0xf0 ? 3 : 4;
    out.push(velt_rt_str_byte_slice(s, i as u64, (i + len) as u64));
    i += len;
  }
  return out;
}

