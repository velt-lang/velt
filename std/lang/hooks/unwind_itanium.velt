// velt/lang/hooks (internal): Velt's exception with the Itanium unwinder (`#unwind-raise` on macOS
// and Linux; docs/internals/design/unwinding.md). One allocation: the unwinder's header
// (`_Unwind_Exception`, 32 bytes on 64-bit targets: the class `VELTPANC`, no cleanup function,
// two words the unwinder owns), then the message, NUL-terminated. It is raised with
// `_Unwind_RaiseException` and caught by `catchUnwind` on the same thread, so whoever catches it
// frees it (`takePanic`).

import { ptrFromAddress } from "velt/lang/intrinsics/address";
import { Ptr, StrBytes, byteLength, readCString } from "velt/ffi";

declare c("c") function malloc(n: usize): Ptr<u8> | null;
declare c("c") function free(p: Ptr<u8> | null): void;
declare c("c") function memcpy(dst: Ptr<u8> | null, src: StrBytes, n: usize): Ptr<u8>;
declare c("c") function memset(p: Ptr<u8> | null, c: i32, n: usize): Ptr<u8>;
// `struct _Unwind_Exception *` in <unwind.h>: a `void *` for the header check (std's C
// declarations are checked against each target's headers, `velt native headers --std`).
declare c("c") function _Unwind_RaiseException(e: Ptr<void> | null): i32;
declare c("c") function abort(): void;
declare function velt_rt_exit(code: i32): never;

/** Ends the process at once (a panic during a cleanup): C's `abort`. */
export function abortProcess(): never {
  // SAFETY: `abort` takes nothing; it never returns.
  unsafe {
    abort();
  }
  velt_rt_exit(134);
}

/** Whether the frames a caught panic unwinds drop what they own: their cleanup pads (#2667). */
export function unwoundFramesDrop(): bool {
  return true;
}

/** The unwinder's header in front of Velt's payload (`velt_vir::eh::HEADER_SIZE`). */
const HEADER: usize = 32;

/**
 * The exceptions raised and not freed yet. They come from C's `malloc`, which the block counters
 * do not see: std's tests read this to check that each is freed (`livePanics`).
 */
const LIVE = new Atomic<u64>(0);

/** How many exceptions are raised and not freed yet. */
export function livePanics(): usize {
  return LIVE.load() as usize;
}

/** Raise Velt's exception with message `msg`; returns only if no frame claimed it. */
export function raise(msg: string): void {
  const n = byteLength(msg);
  // SAFETY: the allocation holds the header, the message and its NUL; every pointer below
  // stays inside it, and the unwinder owns it until the catch hands it back.
  unsafe {
    const e = malloc(HEADER + n + 1);
    if (e === null) {
      return;
    }
    LIVE.add(1);
    memset(e, 0, HEADER);
    memcpy(e, "VELTPANC", 8);
    const text = Ptr.orNull<u8>(Ptr.addressOf(e) + HEADER);
    memcpy(text, msg, n);
    memset(Ptr.orNull<u8>(Ptr.addressOf(e) + HEADER + n), 0, 1);
    _Unwind_RaiseException(Ptr.orNull<void>(Ptr.addressOf(e)));
    free(e);
    LIVE.sub(1);
  }
}

/**
 * The message of the exception object at `e` (from `catchUnwind`), which stays the caller's.
 * Unsafe: `e` must be a Velt exception that `catchUnwind` returned, not freed.
 */
export unsafe function panicText(e: usize): string {
  // SAFETY: the caller's statement: `raise` wrote the NUL-terminated message after the header,
  // at `e + HEADER`, never 0 as `e` isn't.
  return unsafe { readCString(ptrFromAddress<u8>(e + HEADER)) };
}

/**
 * The message of the exception object at `e` (from `catchUnwind`), which it frees. Unsafe: `e`
 * must be a Velt exception that `catchUnwind` returned, taken once.
 */
export unsafe function takePanic(e: usize): string {
  // SAFETY: the caller's statement: `raise` wrote the NUL-terminated message after the header,
  // at `e + HEADER`, never 0 as `e` isn't.
  const msg = unsafe { readCString(ptrFromAddress<u8>(e + HEADER)) };
  // SAFETY: the caller's statement.
  unsafe {
    freePanic(e);
  }
  return msg;
}

/**
 * Frees the exception object at `e` (from `catchUnwind`) without reading its message. Unsafe:
 * `e` must be a Velt exception that `catchUnwind` returned, freed once.
 */
export unsafe function freePanic(e: usize): void {
  // SAFETY: `raise` allocated it with malloc, and the caller frees it once.
  unsafe {
    free(Ptr.orNull<u8>(e));
  }
  LIVE.sub(1);
}
