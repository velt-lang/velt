// velt/lang/hooks (internal): a promise shared on its own task that nothing but its holders can
// reach any more (#3439; sched_share.velt, sched_task_lost.velt).
//
// A started node shared on its task (`HUB_HERE`) is run by that task, never by its holders: a
// holder of a started node only waits in the hub (sched_share_wait.velt). When a holder waits
// for it (sched_share.velt `pollHolder`, in a poll of the task) while it is suspended with the
// hub's reference and its task's only, no waker of it exists, so nothing can run it again: it is
// owner-only, as an adoption poll leaves an unshared one, and is listed on its task the same way
// (`list`), so the task's park can find it parked for ever. Every wait looks again: one that
// comes while the node still has a waker (a yield of its own) lists it at the next, after it.
// The hub's entries hold their wakers with a reference each; the task's own waker (its root's,
// `w === task`) is held without one while the node is listed (flag `UNCOUNTED` in the entry's
// waker word), as the yield list holds its root's (sched_yield_list.velt `ROOT`). Otherwise that
// clone is a reference the park counts, and a root awaiting the promise would look alive for
// ever. The task outlives every such entry wherever the holder lives: the hub is freed, its
// entries with it, before its node gives back its task's reference (sched_share_drop.velt
// `free`).
// Not listed: a node whose original is handed to another task and still held there (its node may
// be dropped there), a hub that settled, a node of `main`'s root task. A node leaves the list as
// any listed one does (it finishes, or is given up), and when a holder of it is handed to another
// task (`handedOver`); its entries take their references back then (`unlisted`).

import { inline, noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as nd from "./sched_node";
import * as lost from "./sched_node_lost";
import * as sh from "./sched_share";
import * as wt from "./sched_share_wait";
import * as t from "./sched_task";
import * as lt from "./sched_task_lost";
import * as wk from "./sched_wake";

/** An entry's waker word: its task's own waker, held without a reference (`list`). */
export const UNCOUNTED: usize = 1;

/** The waker of the entry at `at`, without its flag. */
@inline("always")
export function wakerOf(at: usize): usize {
  return m.ld(at + 8) & ~UNCOUNTED;
}

/** Gives back the waker of the entry at `at`: a reference, unless it holds none. */
@inline("always")
export function dropWaker(at: usize): void {
  const w = m.ld(at + 8);
  if ((w & UNCOUNTED) === 0) {
    m.wakerDrop(w);
  }
}

/** The entry at `at` of hub `h` waits with waker `w` (sched_share_wait.velt `wait`). */
@inline("always")
export function storeWaker(h: usize, at: usize, w: usize): void {
  const n = m.ld(h + sh.H_NODE);
  // Only a hub on its node's own task (`HUB_HERE`): an `AWAY` hub's node is another task's, and
  // its entries are read raw (sched_share_away.velt `watch`).
  const both = lt.LISTED | sh.HUB_HERE;
  if ((m.load32(n + nd.N_FLAGS) & both) === both && w === m.ld(n + nd.N_TASK)) {
    m.st(at + 8, w | UNCOUNTED);
    return;
  }
  m.st(at + 8, m.wakerClone(w));
}

/**
 * Lists node `n` of task `task` (a holder's wait, in a poll of `task`) when nothing but its
 * holders can reach it: started and shared here, suspended, not catching, the hub's reference and
 * its task's its only ones. Its task's own wakers in the hub give back their references then.
 */
@noInline
export function list(task: usize, n: usize): void {
  const fl = m.load32(n + nd.N_FLAGS);
  const is = nd.STARTED | sh.HUB_HERE;
  const busy =
    nd.FINISHED | nd.RUNNING | nd.QUEUED | nd.DETACHED | nd.CATCHES | nd.PANICKED | nd.ADOPTED;
  if ((fl & (is | busy | lt.LISTED)) !== is || m.load(n + nd.N_REFS) !== 2) {
    return;
  }
  if (m.ld(n + nd.N_TASK) !== task || t.has(task, t.ROOT)) {
    return;
  }
  const h = m.ld(n + sh.N_HUB);
  const hf = m.load32(h + sh.H_FLAGS);
  if ((hf & (sh.DONE | sh.AWAY)) !== 0 || (hf & (sh.ORIG_OUT | sh.ORIG_GONE)) === sh.ORIG_OUT) {
    return;
  }
  nd.setFlags(n, lt.LISTED);
  lt.list(task, n);
  const len = m.ld(h + sh.H_WLEN);
  for (let i: usize = 0; i < len; i++) {
    const at = wt.entry(h, i);
    const w = m.ld(at + 8);
    if (w === task) {
      m.st(at + 8, w | UNCOUNTED);
      // Not the last: the node holds one.
      wk.release(task);
    }
  }
}

/**
 * Listed node `n` of task `task` leaves the list (sched_task_lost.velt `unlist`, its flags `fl`
 * from before): while its hub is there, its task's own wakers in it take their references back.
 */
@noInline
export function unlisted(task: usize, n: usize, fl: u32): void {
  if ((fl & sh.HUB_HERE) === 0) {
    return;
  }
  const h = m.ld(n + sh.N_HUB);
  const len = m.ld(h + sh.H_WLEN);
  for (let i: usize = 0; i < len; i++) {
    const at = wt.entry(h, i);
    const w = m.ld(at + 8);
    if ((w & UNCOUNTED) !== 0) {
      m.st(at + 8, m.wakerClone(w & ~UNCOUNTED));
    }
  }
}

/**
 * A holder of the promise of hub `h` is handed to another task (sched_share_hand.velt
 * `handOver`), on the hub's task: its node leaves the list before the proxy is made.
 */
@inline("always")
export function handedOver(h: usize): void {
  const n = m.ld(h + sh.H_NODE);
  const fl = m.load32(n + nd.N_FLAGS);
  if ((fl & lt.LISTED) !== 0 && (fl & nd.FINISHED) === 0) {
    leave(n, fl);
  }
}

@noInline
function leave(n: usize, fl: u32): void {
  const task = m.ld(n + nd.N_TASK);
  const e = t.here();
  if (e === 0 || m.ld(e + t.E_CURRENT) !== task) {
    // Only through module state (sched_share_drop.velt `release`): the list is the task's own.
    // It stays listed, and its task gives it up when a drop elsewhere gives it back; linked (the
    // block counters on), it leaves the list here as such a drop does (sched_node_lost.velt).
    if ((fl & lt.NLINKED) !== 0 && lost.heldApart(task)) {
      lost.unlistAway(task, n, fl);
    }
    return;
  }
  m.and32(n + nd.N_FLAGS, ~(lt.LISTED | lt.NLINKED));
  lt.unlist(task, n, fl);
}

/**
 * The original of hub `h` was just handed over (sched_share_hand.velt `handOver`), its proxy made:
 * with the block counters on, its node must not be listed (another task may drop it now).
 */
@inline("always")
export function checkHanded(h: usize): void {
  if (wk.counting()) {
    const n = m.ld(h + sh.H_NODE);
    const fl = m.load32(n + nd.N_FLAGS);
    const out = (m.load32(h + sh.H_FLAGS) & sh.ORIG_OUT) !== 0;
    if (out && (fl & (lt.LISTED | nd.FINISHED)) === lt.LISTED) {
      panic("ICE: a shared promise is listed while its original is handed over");
    }
  }
}

/**
 * Listed node `n` of task `k` at its park, with the block counters on (sched_task_lost.velt
 * `checkListDead`): a shared one's hub holds the task's own wakers without references only.
 */
export function checkHub(k: usize, n: usize, fl: u32): void {
  if ((fl & sh.HUB_HERE) === 0) {
    return;
  }
  const h = m.ld(n + sh.N_HUB);
  const len = m.ld(h + sh.H_WLEN);
  for (let i: usize = 0; i < len; i++) {
    const w = m.ld(wt.entry(h, i) + 8);
    if (w === k || ((w & UNCOUNTED) !== 0 && (w & ~UNCOUNTED) !== k)) {
      panic("ICE: a listed shared promise's hub holds a waker its task's park did not count");
    }
  }
}
