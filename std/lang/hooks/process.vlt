// velt/lang/hooks (internal): the compiler's hooks for the builtin `process` namespace
// (std-layout.md §10b): `process.stdout.write(s)` / `process.stderr.write(s)` (`processWrite`),
// `process.env.NAME` / `process.env[name]` (`processEnv`), `process.argv` (`processArgv`) and
// the mark of a top-level `await` (`topLevelAwaitAt`). The rest of Node's `process` is in
// `velt/process` (docs/std/process.md).

declare function velt_rt_write_str(stream: u32, s: string);

declare function velt_rt_env_get(name: string, out: string): bool;

/**
 * Writes `s` to standard output (`stream` 1) or standard error (2), without a newline, ordered
 * with `console.log` / `console.error`. Returns `true`, like Node's `write`.
 */
export function processWrite(stream: u32, s: string): bool {
  velt_rt_write_str(stream, s);
  return true;
}

/** The value of environment variable `name`, or `undefined` if it is unset. */
export function processEnv(name: string): string | undefined {
  let out = "";
  if (velt_rt_env_get(name, out)) {
    return out;
  }
  return undefined;
}

declare function velt_rt_process_node_argv(): string[];

/**
 * Node's `process.argv`: `[runtime, script, ...args]` (the running executable, the script under
 * `velt run` / `velt dev` or the executable again, then the arguments).
 */
export function processArgv(): string[] {
  return velt_rt_process_node_argv();
}

declare function velt_rt_tla_at(site: string);

/**
 * Compiler-internal: marks the top-level `await`s after it as at `site` (`path:line:col`, a
 * string literal). The compiler lowers a call to `velt_rt_tla_at(site)` where they suspend
 * instead of this call; a program that ends there writes Node's warning and exits with code 13.
 */
export function topLevelAwaitAt(site: string) {
  velt_rt_tla_at(site);
}
