// velt/lang/hooks (internal): the blocks standard output's buffers live in
// (std/lang/hooks/stdout_buffer.velt): from the C library's allocator, a header of their length
// and their size (the room after the header), then the bytes. They live as long as their thread
// or the process, outside the leak counters.

import { Ptr } from "velt/ffi/ptr";
import { addressLoad, addressStore, inline } from "velt/lang/intrinsics";

declare c("c") function malloc$out(n: usize): Ptr<u8> | null;
declare c("c") function realloc$out(p: Ptr<u8> | null, n: usize): Ptr<u8> | null;
declare c("c") function free$out(p: Ptr<u8> | null): void;
declare c("c") function memcpy$out(
  dst: Ptr<u8> | null,
  src: Ptr<u8> | null,
  n: usize,
): Ptr<u8> | null;

/** A block's header: its length, then its size. */
export const HEADER: usize = 16;

/** The length of the block at `b`. */
@inline("always")
export function lenOf(b: usize): usize {
  // SAFETY: `b` is a block of this module: its header's first word.
  return unsafe { addressLoad<u64>(b) } as usize;
}

@inline("always")
export function setLen(b: usize, n: usize): void {
  // SAFETY: as `lenOf`.
  unsafe {
    addressStore<u64>(b, n as u64);
  }
}

/** The room after the header of the block at `b`. */
@inline("always")
export function sizeOf(b: usize): usize {
  // SAFETY: as `lenOf`: the header's second word.
  return unsafe { addressLoad<u64>(b + 8) } as usize;
}

/** A new block with room for `n` bytes, or 0 when the allocator has none. */
export function newBlock(n: usize): usize {
  // SAFETY: no precondition; the result is checked.
  const p = unsafe { malloc$out(HEADER + n) };
  if (p === null) {
    return 0;
  }
  const b = Ptr.addressOf(p);
  setLen(b, 0);
  // SAFETY: the fresh block's header.
  unsafe {
    addressStore<u64>(b + 8, n as u64);
  }
  return b;
}

/** The block at `b` with room for `need` bytes at least (moved, perhaps), or 0 if out of memory. */
export function grow(b: usize, need: usize): usize {
  let n = sizeOf(b) * 2;
  if (n < need) {
    n = need;
  }
  // SAFETY: `b` is this module's block, from `malloc$out`.
  const p = unsafe { realloc$out(Ptr.orNull<u8>(b), HEADER + n) };
  if (p === null) {
    return 0;
  }
  const moved = Ptr.addressOf(p);
  // SAFETY: the block's header.
  unsafe {
    addressStore<u64>(moved + 8, n as u64);
  }
  return moved;
}

/** Appends the `n` bytes at `p` to the block at `b`; returns the block (moved, perhaps) or 0. */
export function put(b: usize, p: usize, n: usize): usize {
  const len = lenOf(b);
  let to = b;
  if (len + n > sizeOf(b)) {
    to = grow(b, len + n);
    if (to === 0) {
      return 0;
    }
  }
  // SAFETY: the block has room for `len + n` bytes; `p` holds `n` (the caller's).
  unsafe {
    memcpy$out(Ptr.orNull<u8>(to + HEADER + len), Ptr.orNull<u8>(p), n);
  }
  setLen(to, len + n);
  return to;
}

/** Gives back the block at `b`. */
export function freeBlock(b: usize): void {
  // SAFETY: this module's block, given back once.
  unsafe {
    free$out(Ptr.orNull<u8>(b));
  }
}
