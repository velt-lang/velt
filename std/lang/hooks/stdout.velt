// velt/lang/hooks (internal): the compiler's hooks for standard output and standard error (#2196):
// `console.log` / `console.error` write through `writeStr`, `writeBool` and `writeByte` (velt_vir
// `console.rs`), and every exit Velt code reaches calls `flushForExit` first. std's own writers
// (`process.stdout.write`, `Stdout.write`, the number writers, panics' reports) call them too.
// The writer is `#stdout-sys`': the runtime's on every target for now (out_rt.velt).

import * as sys from "#stdout-sys";
import { inline, noInline } from "velt/lang/intrinsics";

/** Writes `s` to stdout (`stream` 1) or stderr (2). */
@inline("always")
export function writeStr(stream: u32, s: string): void {
  sys.writeStr(stream, s);
}

/** Writes `true` or `false`. */
export function writeBool(stream: u32, v: bool): void {
  sys.writeBool(stream, v);
}

/** Writes one byte (the space or newline after a `console.log` argument). */
@inline("always")
export function writeByte(stream: u32, c: u8): void {
  sys.writeByte(stream, c);
}

/** Writes `bytes` to stdout, in order with `console.log` (`Stdout.write`). */
export function stdoutWriteBytes(bytes: u8[]): void {
  sys.stdoutWriteBytes(bytes);
}

/** Writes everything stdout holds to the OS. */
export function flushOutput(): void {
  sys.flushOutput();
}

/** Makes this thread's output visible to other threads (the end of a poll, a hand-off). */
@inline("always")
export function publishOutput(): void {
  sys.publishOutput();
}

/** A thread that ends: what it printed is published, its buffer given back. */
export function threadEnd(): void {
  sys.threadEnd();
}

/** A worker about to wait for work: stdout's buffers go to the OS. */
export function flushIdle(): void {
  sys.flushIdle();
}

/** The program's start: asks once whether stdout is a terminal. */
export function initOutput(): void {
  sys.initOutput();
}

/**
 * The program's start outside the dev JIT: registers the flush with the C library's exit, for the
 * exits the runtime takes by itself.
 */
export function registerExitFlush(): void {
  sys.registerExitFlush();
}

/** The flush before the process ends (every exit Velt code reaches). */
export function flushForExit(): void {
  sys.flushForExit();
}

/**
 * `writeStr` out of line, for code that writes on its way out or once (the start-up check's
 * refusal, a panic's or the allocator's report, a statistics line): a call, not the writer
 * inlined at each such site. It calls the hook, which a prebuilt object calls in the program.
 */
@noInline
export function writeStrCold(stream: u32, s: string): void {
  writeStr(stream, s);
}
