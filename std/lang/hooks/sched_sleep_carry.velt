// velt/lang/hooks (internal): an anchored task offered to another worker takes its sleeps along
// (#3097). A sleep lives in the timer block of the worker that polled it, and only that worker
// touches the block (sched_sleep.velt), so the task was anchored there. An offer may move such a
// task when it has no sleep due (its due list is empty) and its worker's block has no fired sleep
// left unseen (`TM_UNSEEN` counts per block, and the poll that sees one may run elsewhere):
// - `carry`, on the offering worker: the pending sleeps of the offered tasks (the task a sleep's
//   waker wakes; one whose waker is not a task's stays, `owner`) leave the block, in one walk,
//   for a list in their task's `T_TIMERS`, in timer order, and such a task is marked `CARRIED`.
// - `adopt`, on the worker that polls it next (sched_run.velt `runWoken`), wherever the offer
//   went (a helper's steal, or a retired spare's hand-on to worker 0): they join its block.
// Each block is still touched by its own worker only, and the task's sleeps keep their order and
// numbers, so they fire as Node's timers do (in deadline order, created first on a tie).
// Tasks anchored for good (`FIXED`: an I/O wait with a deadline, an unref'd timer's look) stay.

import { inline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as sl from "./sched_sleep";
import * as st from "./sched_stats";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/** May worker `e`'s offer carry anchored tasks' sleeps now (no fired sleep left unseen)? */
export function canCarry(e: usize): bool {
  const b = m.ld(e + t.E_TIMERS);
  return b === 0 || m.ld(b + sl.TM_UNSEEN) === 0;
}

/**
 * Worker `e` offers the tasks of `chain` (linked through `T_NEXT`): the anchored ones
 * (`t.carryable`) take their pending sleeps along. One walk over the block, however many tasks.
 */
export function carry(e: usize, chain: usize): void {
  const b = m.ld(e + t.E_TIMERS);
  if (b === 0) {
    return;
  }
  let any = false;
  let k = chain;
  while (k !== 0) {
    if (t.has(k, t.ANCHORED)) {
      // Marks it for the walk; it keeps the flag only with sleeps to carry.
      t.flags(k, t.CARRIED, 0);
      any = true;
    }
    k = m.ld(k + t.T_NEXT);
  }
  if (!any) {
    return;
  }
  // From the last, so each task's list comes out first to last.
  let f = m.ld(b + sl.TM_LAST);
  while (f !== 0) {
    const prev = m.ld(f + sl.S_PREV);
    const o = owner(f);
    if (o !== 0) {
      sl.carried(b, f);
      m.st(f + sl.S_NEXT, m.ld(o + t.T_TIMERS));
      m.st(o + t.T_TIMERS, f);
    }
    f = prev;
  }
  k = chain;
  while (k !== 0) {
    if (t.has(k, t.CARRIED)) {
      if (m.ld(k + t.T_TIMERS) === 0) {
        t.flags(k, 0, t.CARRIED);
      } else {
        t.flags(k, t.LOCALS, 0);
      }
    }
    k = m.ld(k + t.T_NEXT);
  }
}

/**
 * The offered task pending sleep `f` goes with, or 0. Its expiry touches the task its waker wakes
 * (sched_sleep.velt `expire`: that task's due list and flags, from the expiring worker's thread),
 * so a sleep whose waker is a task's goes with that task alone: one handed on to another task
 * (polled again there) stays with the task that polls it now. A sleep whose waker is not a
 * task's (a combinator's) goes with no task: nothing keeps the task that polled it into the
 * block alive, so the sleep names none (sched_sleep.velt `sleepPoll`). It stays in this block,
 * its waker is woken from any thread when it expires, and a poll of it on another worker asks
 * this one for it, as for any handed-on sleep.
 */
function owner(f: usize): usize {
  const w = wk.taskOf(sl.waiter(f));
  return w !== 0 && t.has(w, t.CARRIED) ? w : 0;
}

/** Worker `e`, about to poll task `k` (flags `fl`): the sleeps it carries, if any, join its block. */
@inline("always")
export function adoptCarried(e: usize, k: usize, fl: u32): void {
  if ((fl & t.CARRIED) !== 0) {
    adopt(e, k);
  }
}

/**
 * Worker `e`, about to poll task `k`, takes the sleeps it carries into its timer block, and is
 * its home from now on: the sleeps' block and the task's home stay one worker (a spare whose
 * retirement was taken back polls a task `carryHome` homed on worker 0 already).
 */
export function adopt(e: usize, k: usize): void {
  t.flags(k, 0, t.CARRIED);
  m.st(k + t.T_HOME, e);
  let f = m.ld(k + t.T_TIMERS);
  m.st(k + t.T_TIMERS, 0);
  const b = sl.block(e);
  while (f !== 0) {
    const next = m.ld(f + sl.S_NEXT);
    // Numbers from the block it came from: this block's next sleeps come after them on a tie.
    const seq = m.ld(f + sl.S_SEQ);
    if (seq > m.ld(b + sl.TM_SEQ)) {
      m.st(b + sl.TM_SEQ, seq);
    }
    // No owner word: the one it had named the task that polled it first (sched_sleep.velt).
    m.storeRelaxed(f + sl.S_OWNER, 0);
    // Unordered: `insert` stores the state after it, released.
    m.storeRelaxed(f + sl.S_HOME, e);
    sl.insert(b, f);
    f = next;
  }
}

/**
 * Spare `e`, asked to retire while its timer block holds pending sleeps (#3117: a rescue moved a
 * task here, `main` too, and it sleeps): the sleeps go with their tasks to worker 0 (`g`), as an
 * offer's do (`carry`), so that the spare can retire. Whether they went: not when a sleep of the
 * block fired and is unseen, is due on a list or is past its deadline, nor when a sleep's task (its
 * waker's) may not move (pinned, anchored for good, a sleep of it due) or is not anchored here;
 * then nothing changed. Each task is woken on worker 0 once its sleeps are on it: that poll takes
 * them into worker 0's block (`adopt`), finds them pending and waits again. The tasks are this
 * spare's alone meanwhile: an anchored task runs only on its home, and its sleeps fire only from
 * this block.
 */
export function carryHome(e: usize, g: usize): bool {
  const b = m.ld(e + t.E_TIMERS);
  if (b === 0) {
    return true;
  }
  // A sleep past its deadline fires here first: carried, a later timer elsewhere could beat it.
  if (
    m.ld(b + sl.TM_UNSEEN) !== 0 || sl.due(b) || (sl.pending(b) && sl.nextDeadline(b) <= sl.clock())
  ) {
    return false;
  }
  // Every sleep's task may go: each marked once (counted), the marks taken back if one may not.
  let n: usize = 0;
  let f = m.ld(b + sl.TM_FIRST);
  while (f !== 0) {
    const o = wk.taskOf(sl.waiter(f));
    if (o === 0 || m.ld(o + t.T_HOME) !== e || !t.has(o, t.ANCHORED) || !t.carryable(o)) {
      unmark(b, f);
      return false;
    }
    if (!t.has(o, t.CARRIED)) {
      t.flags(o, t.CARRIED, 0);
      n++;
    }
    f = m.ld(f + sl.S_NEXT);
  }
  if (n === 0) {
    return true;
  }
  // From the last, so each task's list comes out first to last; each task noted at its first.
  const tasks = m.alloc(n * 8);
  let i: usize = 0;
  f = m.ld(b + sl.TM_LAST);
  while (f !== 0) {
    const prev = m.ld(f + sl.S_PREV);
    const o = wk.taskOf(sl.waiter(f));
    if (m.ld(o + t.T_TIMERS) === 0) {
      m.st(tasks + i * 8, o);
      i++;
    }
    // Carried, as an offer's (`carry`): a request for it waits until worker 0 adopts it.
    st.carried(sl.deadline(f));
    sl.carried(b, f);
    m.st(f + sl.S_NEXT, m.ld(o + t.T_TIMERS));
    m.st(o + t.T_TIMERS, f);
    f = prev;
  }
  for (let j: usize = 0; j < n; j++) {
    const o = m.ld(tasks + j * 8);
    t.flags(o, t.LOCALS, 0);
    m.st(o + t.T_HOME, g);
    // Idle: queued on worker 0's inbox. Queued here already: the spare's hand-on moves it.
    wk.wake(o);
  }
  m.release(tasks, n * 8);
  return true;
}

/** Takes back `carryHome`'s marks on the tasks of block `b`'s sleeps before `stop`. */
function unmark(b: usize, stop: usize): void {
  let f = m.ld(b + sl.TM_FIRST);
  while (f !== stop) {
    t.flags(wk.taskOf(sl.waiter(f)), 0, t.CARRIED);
    f = m.ld(f + sl.S_NEXT);
  }
}
