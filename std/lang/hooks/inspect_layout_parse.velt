// velt/lang/hooks (internal): reads the one-line text `console.log`'s printer wrote for a value
// back into its containers, so the layout (inspect_layout_render.velt) can break it across lines.
// The printer's text is regular: a container opens with `{ ` or `[ ` (after a prefix such as
// `Name `, `Map(2) ` or `<ref *1> `), separates entries with `, ` and closes with ` }` or ` ]`;
// strings are quoted with their quotes escaped, and other bracketed atoms (`[Circular *1]`,
// `[Function (anonymous)]`) have no space after `[`. Text a custom inspect wrote (an atom) is
// plain text, whatever it looks like.
//
// The pieces are byte ranges of the text, kept in flat arrays: a parsed value allocates its
// arrays and nothing per piece.

import { utf16Units } from "velt/lang/hooks/inspect_layout_width";
import { addressLoad, share, strByteAt, strDataAddress } from "velt/lang/intrinsics";

/** A piece printed as it is: keys, numbers, `: `, ` => `, atoms. */
export const SEG_TEXT: u8 = 0;
/** A quoted string value (Node splits a long one at its line breaks). */
export const SEG_STR: u8 = 1;
/** A nested container. */
export const SEG_NODE: u8 = 2;

/** How an entry ended: at the end of the text, at `, `, or at its container's close. */
const END_EOF: i64 = 0;
const END_COMMA: i64 = 1;
const END_CLOSE: i64 = 2;
const END_FAIL: i64 = -1;

/**
 * A value parsed from bytes `start..end` of `src`. An entry's pieces are a range of the `seg*`
 * arrays; a container's entries are a range of the `ent*` arrays.
 */
export class LayoutValue {
  src: string;
  /** Each piece: its kind (`SEG_*`), and its byte range, or for a node its index and 0. */
  segKind: u8[] = [];
  segA: u64[] = [];
  segB: u64[] = [];
  /** Each container: its prefix and opening brace (`<ref *1> Name {`). */
  nodeOpenStart: u64[] = [];
  nodeOpenEnd: u64[] = [];
  /** Node's `braces[0].length + base.length`: the opening text without the space of a base. */
  nodeOpenLen: u64[] = [];
  /** `}` or `]`; an array (`]`) may group short entries into columns. */
  nodeClose: u8[] = [];
  /** Its entries, as a range of the `ent*` arrays. */
  nodeEntStart: u64[] = [];
  nodeEntEnd: u64[] = [];
  /** Each entry's pieces, as a range of the `seg*` arrays. */
  entStart: u64[] = [];
  entEnd: u64[] = [];
  /** The top-level entry's pieces. */
  topStart: u64 = 0;
  topEnd: u64 = 0;
  /**
   * Is the text printable ASCII, where a byte is a UTF-16 unit and a column, with no line break?
   * Custom inspect text counts as not plain.
   */
  plain: bool = true;

  constructor(src: string) {
    this.src = src;
  }
}

/**
 * Parses bytes `start..end` of `src`, keeping each of `atoms` (pairs of byte offsets in `src`,
 * custom inspect text) as plain text; null if the text does not have the printer's shape (it is
 * then printed as it is).
 */
export function parseLayout(src: string, start: u64, end: u64, atoms: u64[]): LayoutValue | null {
  // The scanner reads the bytes through one address: `src`, this function's parameter, keeps
  // them there, unchanged, while the parser runs.
  const p = new Parser(share(src), strDataAddress(src), start, end, atoms);
  const top = p.entry(-1);
  if (top != END_EOF) {
    return null;
  }
  p.v.topStart = p.entryStart;
  p.v.topEnd = p.entryEnd;
  return p.v;
}

/**
 * The bytes below 0x80 the scanner stops at, as two masks (bit `b` for byte `b`, then bit `b - 64`):
 * ` ,:<'"\`{[()`, and the control characters, which (with the bytes past ASCII) make the text not
 * plain. Everything else is plain text.
 */
const SPECIAL_LOW: u64 = 0x14001385ffffffff;
const SPECIAL_HIGH: u64 = 0x8800000108000000;

/** Is `b` a byte the scanner stops at? */
function special(b: u8): bool {
  if (b >= 0x80) {
    return true;
  }
  const bit = b as u64;
  return ((bit < 64 ? SPECIAL_LOW >> bit : SPECIAL_HIGH >> (bit - 64)) & 1) != 0;
}

class Parser {
  v: LayoutValue;
  src: string;
  /** The address of `src`'s bytes, which the scanner reads. */
  data: usize;
  end: u64;
  atoms: u64[];
  i: u64;
  /** Pieces of the entries being read, innermost last. */
  pendKind: u8[] = [];
  pendA: u64[] = [];
  pendB: u64[] = [];
  /** Entries of the containers being read, innermost last. */
  pendEntStart: u64[] = [];
  pendEntEnd: u64[] = [];
  /** The pieces of the entry `entry` read last. */
  entryStart: u64 = 0;
  entryEnd: u64 = 0;

  constructor(src: string, data: usize, start: u64, end: u64, atoms: u64[]) {
    this.v = new LayoutValue(share(src));
    this.src = src;
    this.data = data;
    this.end = end;
    this.atoms = atoms;
    this.i = start;
  }

  /** Byte `k` of the text (below `end`). */
  byte(k: u64): u8 {
    // SAFETY: `data` is the address of the text's bytes, alive and unchanged while the parser
    // runs (`parseLayout`), and `k` is below its end.
    return unsafe { addressLoad<u8>(this.data + (k as usize)) };
  }

  /** Does the text at `k` start with `lit` (ASCII)? */
  startsWith(k: u64, lit: string): bool {
    const n = lit.length as u64;
    if (k + n > this.end) {
      return false;
    }
    for (let j: u64 = 0; j < n; j++) {
      if (this.byte(k + j) != strByteAt(lit, j)) {
        return false;
      }
    }
    return true;
  }

  /** The end of the atom holding byte `k`, or 0 if none does. */
  atomEndAt(k: u64): u64 {
    const a = this.atoms;
    for (let j: u64 = 0; j + 1 < (a.length as u64); j += 2) {
      if (a[j] <= k && k < a[j + 1]) {
        return a[j + 1];
      }
    }
    return 0;
  }

  pushPiece(kind: u8, a: u64, b: u64): void {
    this.pendKind.push(kind);
    this.pendA.push(a);
    this.pendB.push(b);
  }

  pushText(a: u64, b: u64): void {
    if (a < b) {
      this.pushPiece(SEG_TEXT, a, b);
    }
  }

  /**
   * One entry, up to `, ` or the closing ` }` / ` ]` of its container (`close`), or to the end of
   * the text for the top-level value (`close` -1). Its pieces end up at `entryStart..entryEnd`;
   * returns how it ended, `END_FAIL` if the text is not the printer's.
   */
  entry(close: i64): i64 {
    const base = this.pendKind.length as u64;
    // Where the pending text starts, and where the current value starts in it.
    let text = this.i;
    let value = this.i;
    let parens: u64 = 0;
    let how = END_FAIL;
    while (true) {
      while (this.i < this.end && !special(this.byte(this.i))) {
        this.i += 1;
      }
      const i = this.i;
      const atomEnd = this.atomEndAt(i);
      if (atomEnd != 0) {
        // Custom inspect text: plain text, whatever it looks like.
        this.i = atomEnd;
        this.v.plain = false;
        continue;
      }
      if (i >= this.end) {
        if (close >= 0 || parens > 0) {
          return END_FAIL;
        }
        how = END_EOF;
        break;
      }
      const c = this.byte(i);
      const next = (i + 1 < this.end ? this.byte(i + 1) : 0) as i64;
      const separates = parens == 0 && close >= 0;
      if (c == 0x20 && separates && next == close) {
        this.i += 2;
        how = END_CLOSE;
        break;
      } else if (c == 0x20 && this.startsWith(i, " => ")) {
        this.i += 4;
        value = this.i;
      } else if (c == 0x2c && separates && next == 0x20) {
        this.i += 2;
        how = END_COMMA;
        break;
      } else if (c == 0x3a && next == 0x20) {
        this.i += 2;
        value = this.i;
      } else if (c == 0x3c && this.startsWith(i, "<rejected> ")) {
        this.i += 11;
        value = this.i;
      } else if (c == 0x27 || c == 0x22 || c == 0x60) {
        if (!this.skipQuoted()) {
          return END_FAIL;
        }
        if (!this.startsWith(this.i, ": ")) {
          // A string value (a quoted key stays in the text).
          this.pushText(text, i);
          this.pushPiece(SEG_STR, i, this.i);
          text = this.i;
          value = this.i;
        }
      } else if ((c == 0x7b || c == 0x5b) && next == 0x20) {
        this.pushText(text, value);
        const node = this.container(value);
        if (node < 0) {
          return END_FAIL;
        }
        this.pushPiece(SEG_NODE, node as u64, 0);
        text = this.i;
        value = this.i;
      } else if (c == 0x5b && next != 0x5d) {
        if (!this.skipBracketed()) {
          return END_FAIL;
        }
      } else if (c == 0x28) {
        parens += 1;
        this.i += 1;
      } else if (c == 0x29) {
        if (parens == 0) {
          return END_FAIL;
        }
        parens -= 1;
        this.i += 1;
      } else {
        if (c < 0x20 || c >= 0x7f) {
          this.v.plain = false;
        }
        this.i += 1;
      }
    }
    const textEnd = how == END_EOF ? this.i : this.i - 2;
    this.pushText(text, textEnd);
    const n = this.pendKind.length as u64;
    if (n == base) {
      return END_FAIL;
    }
    const v = this.v;
    const start = v.segKind.length as u64;
    for (let k = base; k < n; k++) {
      v.segKind.push(this.pendKind[k]);
      v.segA.push(this.pendA[k]);
      v.segB.push(this.pendB[k]);
    }
    this.pendKind.truncate(base as i64);
    this.pendA.truncate(base as i64);
    this.pendB.truncate(base as i64);
    this.entryStart = start;
    this.entryEnd = v.segKind.length as u64;
    return how;
  }

  /** A container whose prefix starts at `open` and whose brace is at `this.i`; its index, or -1. */
  container(open: u64): i64 {
    const brace = this.byte(this.i);
    const openEnd = this.i + 1;
    this.i += 2;
    const close: u8 = brace == 0x7b ? 0x7d : 0x5d;
    const base = this.pendEntStart.length as u64;
    while (true) {
      const how = this.entry(close as i64);
      if (how == END_FAIL) {
        return -1;
      }
      this.pendEntStart.push(this.entryStart);
      this.pendEntEnd.push(this.entryEnd);
      if (how == END_CLOSE) {
        break;
      }
    }
    const v = this.v;
    const entStart = v.entStart.length as u64;
    const n = this.pendEntStart.length as u64;
    for (let k = base; k < n; k++) {
      v.entStart.push(this.pendEntStart[k]);
      v.entEnd.push(this.pendEntEnd[k]);
    }
    this.pendEntStart.truncate(base as i64);
    this.pendEntEnd.truncate(base as i64);
    // A custom inspect's `Name ` before the brace (`Headers {`): Node formats the object after it
    // by itself, where only the brace counts.
    const braceAt = openEnd - 1;
    let custom = false;
    const a = this.atoms;
    for (let j: u64 = 0; j + 1 < (a.length as u64); j += 2) {
      if (a[j + 1] == braceAt && a[j] >= open) {
        custom = true;
      }
    }
    let openLen: u64 = 1;
    if (!custom) {
      const hasBase: u64 = this.startsWith(open, "<ref *") ? 1 : 0;
      openLen = utf16Units(this.src, open, openEnd) - hasBase;
    }
    v.nodeOpenStart.push(open);
    v.nodeOpenEnd.push(openEnd);
    v.nodeOpenLen.push(openLen);
    v.nodeClose.push(close);
    v.nodeEntStart.push(entStart);
    v.nodeEntEnd.push(v.entStart.length as u64);
    return (v.nodeClose.length as i64) - 1;
  }

  /** Skips the quoted string at `this.i` (a backslash escapes the next byte); false if open. */
  skipQuoted(): bool {
    const quote = this.byte(this.i);
    let j = this.i + 1;
    while (true) {
      if (j >= this.end) {
        return false;
      }
      const c = this.byte(j);
      if (c == 0x5c) {
        j += 2;
      } else if (c == quote) {
        break;
      } else {
        if (c < 0x20 || c >= 0x7f) {
          this.v.plain = false;
        }
        j += 1;
      }
    }
    this.i = j + 1;
    return true;
  }

  /** Skips the bracketed atom at `this.i` (`[Circular *1]`), nested brackets included. */
  skipBracketed(): bool {
    let depth: u64 = 0;
    for (let j = this.i; j < this.end; j++) {
      const c = this.byte(j);
      if (c < 0x20 || c >= 0x7f) {
        this.v.plain = false;
      }
      if (c == 0x5b) {
        depth += 1;
      } else if (c == 0x5d) {
        depth -= 1;
        if (depth == 0) {
          this.i = j + 1;
          return true;
        }
      }
    }
    return false;
  }
}
