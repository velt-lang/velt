// velt/lang/hooks (internal): which timer comes next in Node's event loop, under the executor in
// Velt (sched_order.velt, #2649), as the runtime's velt_rt task/local/order_pass.rs: a timers pass
// reads the clock once and runs, list by list, every timer due by then; once none is left, the
// immediates created so far run (the check phase), and the next pass reads the clock again.
//
// `look` only looks (a timer whose time has not come yet starts no pass or check phase); `commit`
// moves the loop on, when a timer's turn comes. A pass meets lists due by its `now` whose next
// timer is not due: they get new places (`max(start + ms, now + 1)`, a new id), as Node's
// `listOnTimeout` gives them. What a look found is kept in the block (`P_*`), read by the caller.
//
// A timer whose task is in a poll on another worker (`busy`: running code that does not pause,
// or another of its callbacks) cannot run now and holds back no other timer: the look passes it
// over, as the runtime's skips a busy task's lists (order.rs `busy_elsewhere`), so a spawned
// task that spins does not stop every timer of the process; it runs once that poll has ended.
// The lists here are one per delay for the process, as Node's, where the runtime's are one per
// task and delay: the look passes over the busy task's timers in a list and may take a later one
// of another task from it, which the runtime's order would have run in its own list's turn.

import { inline, noInline } from "velt/lang/intrinsics";
import * as l from "./sched_order_list";
import * as m from "./sched_mem";
import * as sl from "./sched_sleep";
import * as t from "./sched_task";

/**
 * What the last look found: the timer that comes next (0: none), its phase (a pass with `now`
 * `P_VAL`, or the check phase running the immediates numbered up to `P_VAL`), the `now` it was
 * chosen in (and whether there is one), the list of the timer chosen, whether lists due by `now`
 * whose next timer is not were passed over, whether the clock was read for it, whether such lists
 * were passed over in the pass under way; the task of the step that looks (its timers are not
 * busy: `busy`).
 */
export const P_NEXT: usize = l.O_LOOK;
export const P_PHASE: usize = l.O_LOOK + 8;
export const P_VAL: usize = l.O_LOOK + 16;
export const P_NOW: usize = l.O_LOOK + 24;
export const P_NOW_SET: usize = l.O_LOOK + 32;
export const P_LIST: usize = l.O_LOOK + 40;
export const P_PARTLY: usize = l.O_LOOK + 48;
export const P_FRESH: usize = l.O_LOOK + 56;
export const P_IN_PASS: usize = l.O_LOOK + 64;
export const P_CUR: usize = l.O_LOOK + 72;

/** The phases. */
export const PASS: usize = 1;
export const CHECK: usize = 2;

/** The clock in whole milliseconds since the process started. */
function clockMs(): usize {
  return (sl.clock() / 1000000) as usize;
}

/**
 * The tasks a look found busy (`P_BUSY_N` of them, at most `l.BUSY_MAX`), after the block's
 * layout (sched_order_list.velt `makeOrder` allocates the room).
 */
export const P_BUSY_N: usize = sl.TM_SIZE;
const P_BUSY: usize = sl.TM_SIZE + 8;
/**
 * The look met a busy task more than it remembers: it chose nothing (sched_order.velt `choose`
 * looks again soon), as a task it took for not busy could have had its later timer pass an
 * earlier one.
 */
export const P_FULL: usize = l.O_WAITER + 8;

/**
 * Is the task of timer `h` of block `b` in a poll on another worker than the one that looks (the
 * poll of `P_CUR`)? Its state is the task's word (sched_task.velt), read without its lock: a poll
 * that just began may be seen either way, as by the runtime's. A task found busy stays busy for
 * the rest of the look, so a poll ending meanwhile never lets its later timer pass its earlier
 * one; and it is marked (`T_SKIPPED`), so that the end of that poll moves the order on
 * (sched_run.velt `timersAfter`): its timer may come next then, and no worker may look before.
 * A poll whose end has begun (`SK_ENDING`, the same word, so the mark and the end are ordered) is
 * not busy. `H_TASK` of a queued timer is a live task under the lock: every way out of the order
 * takes the timer out of its list before its task can be freed (sched_order.velt `leave`), and 0
 * is no task.
 */
@inline
export function busy(b: usize, h: usize): bool {
  // A timer that names no task (every timer with one worker: sched_order.velt `inserted`) costs
  // the look one load.
  const k = m.ld(h + l.H_TASK);
  return k !== 0 && busyTask(b, k);
}

/** `busy` for a timer of task `k`. */
@noInline
function busyTask(b: usize, k: usize): bool {
  if (k === m.ld(b + P_CUR)) {
    return false;
  }
  const n = m.ld(b + P_BUSY_N);
  for (let i: usize = 0; i < n; i++) {
    if (m.ld(b + P_BUSY + 8 * i) === k) {
      return true;
    }
  }
  const s = m.load32(k + t.T_STATE);
  if (s !== t.RUNNING && s !== t.NOTIFIED) {
    return false;
  }
  if ((m.cas32(k + t.T_SKIPPED, 0, t.SK_SKIPPED) & t.SK_ENDING) !== 0) {
    return false;
  }
  if (n < l.BUSY_MAX) {
    m.st(b + P_BUSY + 8 * n, k);
    m.st(b + P_BUSY_N, n + 1);
  } else {
    // Not remembered, it could be taken for not busy later in this look: nothing is chosen.
    m.st(b + P_FULL, 1);
  }
  return true;
}

/** The first immediate of block `b` numbered up to `limit` whose task is not busy, or 0. */
function immediateUpto(b: usize, limit: usize): usize {
  let h = m.ld(b + l.O_IMM + l.L_FIRST);
  while (h !== 0 && m.ld(h + l.H_SEQ) <= limit) {
    if (!busy(b, h)) {
      return h;
    }
    h = m.ld(h + l.H_NEXT);
  }
  return 0;
}

/**
 * The first timer due by `now` in the order of the lists, busy ones passed over (a list due by
 * then whose first timer is not is passed over: `P_PARTLY`), its list in `P_LIST`; 0 when none
 * is.
 */
function firstDue(b: usize, now: usize): usize {
  let x = m.ld(b + l.O_FIRST);
  while (x !== 0 && m.ld(x + l.L_EXPIRY) <= now) {
    const ms = m.ld(x + l.L_MS);
    let h = m.ld(x + l.L_FIRST);
    while (h !== 0) {
      if (busy(b, h)) {
        h = m.ld(h + l.H_NEXT);
        continue;
      }
      if (m.ld(h + l.H_START) + ms <= now) {
        m.st(b + P_LIST, x);
        return h;
      }
      if (h === m.ld(x + l.L_FIRST)) {
        m.st(b + P_PARTLY, 1);
      }
      break;
    }
    x = m.ld(x + l.L_NEXT);
  }
  return 0;
}

/**
 * When the loop must look again (whole milliseconds; 0: no timer waits): the earliest list's
 * expiry, or, for a list whose first timers are busy, its first other timer's due time, so that
 * a task that runs on without a pause keeps no worker looking.
 */
export function wakeAt(b: usize): usize {
  let best: usize = 0;
  let x = m.ld(b + l.O_FIRST);
  while (x !== 0) {
    const expiry = m.ld(x + l.L_EXPIRY);
    if (best !== 0 && expiry >= best) {
      break;
    }
    let h = m.ld(x + l.L_FIRST);
    while (h !== 0 && busy(b, h)) {
      h = m.ld(h + l.H_NEXT);
    }
    if (h !== 0) {
      const due = m.ld(h + l.H_START) + m.ld(x + l.L_MS);
      const at = due > expiry ? due : expiry;
      if (best === 0 || at < best) {
        best = at;
      }
    }
    x = m.ld(x + l.L_NEXT);
  }
  return best;
}

/** What comes next, without changing anything (into `P_*`). */
function peek(b: usize): void {
  m.st(b + P_NEXT, 0);
  m.st(b + P_PHASE, 0);
  m.st(b + P_NOW_SET, 0);
  m.st(b + P_LIST, 0);
  m.st(b + P_PARTLY, 0);
  m.st(b + P_IN_PASS, 0);
  let check = m.ld(b + l.O_CHECK_SET) !== 0;
  if (check) {
    const limit = m.ld(b + l.O_CHECK);
    const h = immediateUpto(b, limit);
    if (h !== 0) {
      m.st(b + P_NEXT, h);
      m.st(b + P_PHASE, CHECK);
      m.st(b + P_VAL, limit);
      m.st(b + P_FRESH, 0);
      return;
    }
    // The check phase is over once no immediate up to its limit is left (a busy task's keep it).
    const first = m.ld(b + l.O_IMM + l.L_FIRST);
    check = first !== 0 && m.ld(first + l.H_SEQ) <= limit;
  }
  let fresh = m.ld(b + l.O_PASS_SET) === 0;
  let now = fresh ? clockMs() : m.ld(b + l.O_PASS);
  m.st(b + P_FRESH, fresh ? 1 : 0);
  while (true) {
    const h = firstDue(b, now);
    const passed = !fresh && m.ld(b + P_PARTLY) !== 0;
    if (passed) {
      m.st(b + P_IN_PASS, 1);
    }
    if (h !== 0) {
      m.st(b + P_NEXT, h);
      m.st(b + P_PHASE, PASS);
      m.st(b + P_VAL, now);
      m.st(b + P_NOW, now);
      m.st(b + P_NOW_SET, 1);
      return;
    }
    // The pass is over: the immediates created so far run next.
    if (!check) {
      const i = immediateUpto(b, m.ld(b + l.O_SEQ));
      if (i !== 0) {
        m.st(b + P_NEXT, i);
        m.st(b + P_PHASE, CHECK);
        m.st(b + P_VAL, m.ld(b + l.O_SEQ));
        m.st(b + P_NOW, now);
        m.st(b + P_NOW_SET, 1);
        return;
      }
    }
    if (fresh) {
      m.st(b + P_NOW, now);
      m.st(b + P_NOW_SET, 1);
      return;
    }
    m.st(b + P_IN_PASS, m.ld(b + P_PARTLY));
    now = clockMs();
    fresh = true;
    m.st(b + P_FRESH, 1);
    m.st(b + P_PARTLY, 0);
  }
}

/**
 * What comes next (into `P_*`). When the pass under way met lists due by its `now` whose next
 * timer is not, they get their new places first (with the pass's own clock), and it looks again.
 */
export function look(b: usize): void {
  m.st(b + P_BUSY_N, 0);
  m.st(b + P_FULL, 0);
  peek(b);
  if (m.ld(b + P_IN_PASS) !== 0 && m.ld(b + l.O_PASS_SET) !== 0) {
    const now = m.ld(b + l.O_PASS);
    const sameNow = m.ld(b + P_NOW_SET) !== 0 && m.ld(b + P_NOW) === now;
    rekeyPassed(b, now, sameNow ? m.ld(b + P_LIST) : 0);
    peek(b);
  }
}

/**
 * The lists due by `now` (and before list `before`, 0: all) whose next timer is not get their
 * new places, in the order the pass meets them: `max(start + ms, now + 1)`, a new id; not a list
 * whose first timer is busy. Each moves past every list due by `now`, so the walk never meets it
 * again.
 */
function rekeyPassed(b: usize, now: usize, before: usize): void {
  let x = m.ld(b + l.O_FIRST);
  while (x !== 0 && m.ld(x + l.L_EXPIRY) <= now && (before === 0 || l.keyLess(x, before))) {
    const next = m.ld(x + l.L_NEXT);
    const h = m.ld(x + l.L_FIRST);
    const due = m.ld(h + l.H_START) + m.ld(x + l.L_MS);
    if (due > now && !busy(b, h)) {
      l.rekey(b, x, due > now + 1 ? due : now + 1);
    }
    x = next;
  }
}

/**
 * The loop woke and the last look chose nothing to run now: the lists it passed over get their
 * new places, as Node's pass gives them before it runs anything.
 */
export function loopWoke(b: usize): void {
  if (m.ld(b + P_FRESH) !== 0 && m.ld(b + P_PARTLY) !== 0 && m.ld(b + P_NOW_SET) !== 0) {
    rekeyPassed(b, m.ld(b + P_NOW), m.ld(b + P_LIST));
  }
}

/**
 * The timer the last look chose takes its turn: the loop moves on to its phase. The lists the
 * look passed over get their new places first.
 */
export function commit(b: usize): void {
  if (m.ld(b + P_NEXT) === 0) {
    return;
  }
  if (m.ld(b + P_PARTLY) !== 0 && m.ld(b + P_NOW_SET) !== 0) {
    rekeyPassed(b, m.ld(b + P_NOW), m.ld(b + P_LIST));
  }
  if (m.ld(b + P_PHASE) === PASS) {
    m.st(b + l.O_PASS, m.ld(b + P_VAL));
    m.st(b + l.O_PASS_SET, 1);
    m.st(b + l.O_CHECK_SET, 0);
  } else {
    m.st(b + l.O_PASS_SET, 0);
    m.st(b + l.O_CHECK, m.ld(b + P_VAL));
    m.st(b + l.O_CHECK_SET, 1);
  }
}
