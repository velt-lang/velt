// velt/lang/hooks (internal): the clocks of `#clock` under WASI: `clock_time_get` through
// wasi-libc's `__wasi_clock_time_get` (docs/internals/design/wasi-libc.md), into this thread's
// buffer. (wasi-libc's `clock_gettime` takes its clocks as pointers, not numbers.)

import { Ptr } from "velt/ffi/ptr";
import { addressLoad } from "velt/lang/intrinsics";

declare c("c") function __wasi_clock_time_get(id: u32, precision: u64, time: Ptr<u64>): u16;
declare c("c") function calloc$clock(n: usize, size: usize): Ptr<u8> | null;

/** WASI's clock ids. */
const REALTIME: u32 = 0;
const MONOTONIC: u32 = 1;

/** This thread's 8-byte buffer (0 before its first use): from the C library, kept for its life. */
const BUFFER = new ThreadLocal<u64>(0);

/** Clock `id` in nanoseconds; 0 when it can't be read. */
function clockNs(id: u32): u64 {
  let p = BUFFER.get() as usize;
  if (p === 0) {
    // SAFETY: calloc has no precondition; its result is checked.
    const block = unsafe { calloc$clock(1, 8) };
    if (block === null) {
      return 0;
    }
    p = Ptr.addressOf(block);
    BUFFER.set(p as u64);
  }
  // SAFETY: this thread's buffer holds the u64 the call writes; only this call uses it.
  const rc = unsafe { __wasi_clock_time_get(id, 1, Ptr.at<u64>(p)) };
  // SAFETY: inside the buffer, which the call filled when it returned 0.
  return rc === 0 ? unsafe { addressLoad<u64>(p) } : 0;
}

/** The monotonic clock in nanoseconds. */
export function monotonicNs(): u64 {
  return clockNs(MONOTONIC);
}

/** The wall clock in nanoseconds since the Unix epoch. */
export function realtimeNs(): i64 {
  return clockNs(REALTIME) as i64;
}
