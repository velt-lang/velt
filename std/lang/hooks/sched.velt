// velt/lang/hooks (internal): the executor in Velt (#2649 steps 3.1 and 3), its workers: worker 0
// is the thread that runs `main`, the others are threads it starts (`VELT_THREADS`, else the
// online cores; `#sched-thread`), each with its own queue, inbox and reactor. A task stays on its
// home worker (the spawning one, or the one `spawn(p, { worker })` pins it to). A program compiled with `VELT_SCHEDULER=std` runs here instead of on the
// runtime's executor: its root (`schedBlockOn`), its spawned tasks (`schedSpawn`), `await
// yieldNow()` (`schedYield`), boxed and started promises (`schedBox`, `schedStart`,
// sched_node.velt), the microtask steps of `await` and the prelude's microtasks (`schedAwaitTick`,
// `schedAwaitReady`, `schedMicrotask`, sched_micro.velt), the process lifetime (keep-alive
// references, a due `unref()`'d timer's question, the top-level `await` waiting: sched_end.velt),
// `sleep` (`schedSleep`, sched_sleep.velt) and Node's timer order (`schedTimer*`,
// sched_timers.velt); `schedFinish` drives the tasks still alive once `main` is done. The
// runtime's other leaves (channels, files, sockets) stay Rust: they wake a task through its C
// waker (rt_abi_async.md §1) from any thread, which queues it and unparks the worker. The
// layout of the executor and its tasks is in sched_task.velt.
//
// A poll of a task (`run`): the started promises woken since its last poll, then its root, then
// its microtasks; each piece only when the task has them (a flag, a list, a queue made on first
// use), so a task with no started promise and no queued microtask polls its root and nothing
// else.
//
// The waker tables and the join handle's header hold the addresses of C functions Velt exports
// (`@export`, `exportedAddress`, #2203 step 5), which C calls from any thread; a worker thread
// starts on one too.

import { Ptr } from "velt/ffi";
import { fnAddress, futDrop, inline, noInline } from "velt/lang/intrinsics";
import * as end from "./sched_end";
import * as io from "./sched_io";
import * as tb from "./sched_io_table";
import * as jn from "./sched_join";
import * as latch from "./sched_latch";
import * as loop from "./sched_loop";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as mod from "./sched_module";
import * as node from "./sched_node";
import * as nc from "./sched_node_catch";
import * as off from "./sched_off";
import { taskId } from "./sched_id";
import * as run from "./sched_run";
import * as sl from "./sched_sleep";
import * as sp from "./sched_spread";
import * as st from "./sched_stats";
import * as t from "./sched_task";
import * as tm from "./sched_timers";
import * as workers from "./sched_workers";
import * as mk from "./sched_make";
import * as wk from "./sched_wake";

/** The runtime's `velt_rt_uncaught_now`: the report shows where the callback threw. */
declare c("c") function velt_rt_uncaught_now$rt(): void;

/** The executor, started on first use (by the worker: `main`'s thread). */
@inline
function exec(): usize {
  return workers.started();
}

/**
 * `velt_main`'s root: runs it, and every task it wakes, until it is done. `stay` is 1 when tasks
 * must stay on their worker (sched_spread.velt `stay`): the program may give a declared function
 * properties through `any`, which the runtime keeps under its module lock, held by worker 0.
 */
export function schedBlockOn(poll: usize, state: usize, stay: u64): void {
  const e = exec();
  if (stay !== 0) {
    sp.stay(e);
  }
  // The executor's reference and this one: the root is read after it is done.
  const k = mk.task(e, poll, 0, 0, 0, 0, 2);
  m.st(k + t.T_JOIN_STATE, 0);
  m.st(k + t.T_TRANSFER, 0);
  m.st(k + t.T_ROOT, state);
  m.st32(k + t.T_FLAGS, t.ROOT);
  wk.push(e, k);
  // The synchronous code before is done: tasks may take the module lock.
  mod.handOver();
  // A park that finds nothing left to happen while it runs ends the program (sched_end.velt).
  m.st(e + t.E_ROOT, k);
  if (m.ld32(e + t.E_MODE) === 0 && m.ld(e + t.E_LAZY) === 0) {
    // The only thread at the executor: the root runs here.
    while (!t.rootLeft(k, false)) {
      loop.turnSolo(e);
    }
  } else {
    // The root may run on another worker (the monitor moves it from a stalled worker 0), which
    // wakes this one once it is done.
    while (!t.rootLeft(k, true)) {
      if (m.ld(e + t.E_LAZY) !== 0 && loop.alone(e)) {
        // Alone until the monitor finds this worker stalled (sched_loop.velt `adopt`), and again
        // once it takes that back (sched_relax.velt).
        while (!t.rootLeft(k, true)) {
          if (!loop.turnLazy(e)) {
            break;
          }
        }
        continue;
      }
      loop.turn(e);
    }
  }
  m.st(e + t.E_ROOT, 0);
  wk.release(k);
}

/**
 * Runs the tasks still alive once `main` is done, until none is or none can run again (a park
 * finds nothing left to happen: sched_end.velt); not after a `main` that returned an exit code
 * other than 0, which ends the program at once.
 */
export function schedFinish(code: i32): void {
  const e = t.exec();
  if (e === 0) {
    return;
  }
  if (code !== 0) {
    st.report();
    return;
  }
  mod.handOver();
  if (m.ld32(e + t.E_MODE) === 0 && m.ld(e + t.E_LAZY) === 0) {
    while (m.ld(e + t.E_LIVE) !== 0) {
      loop.turnSolo(e);
    }
  } else {
    while (mk.live(e) !== 0) {
      if (m.ld(e + t.E_LAZY) !== 0 && loop.alone(e)) {
        while (mk.live(e) !== 0) {
          if (!loop.turnLazy(e)) {
            break;
          }
        }
        continue;
      }
      loop.turn(e);
    }
  }
  // Streams dropped unclosed stay open to the end, as the runtime's: their buffers go now.
  tb.releaseBuffers();
  st.report();
}

/**
 * `spawn(f(...))`: a task from the initial state at `state` (`size` bytes, aligned to at most 8 as
 * every value the compiler lays out, which the task's block is; moved in), scheduled now; its join handle, a heap future whose slot gets `rsize` bytes. A
 * result the handle never claims is dropped with `rdrop` (0: nothing to drop).
 */
export function schedSpawn(
  poll: usize,
  drop: usize,
  state: usize,
  size: u64,
  align: u64,
  rsize: u64,
  rdrop: usize,
  transfer: usize,
): usize {
  if (align > 8) {
    panic("ICE: a task's state aligned to more than 8 bytes");
  }
  // This thread's worker block (0 off the workers), read once (`exec`, and the queueing).
  let w = t.here();
  let e = w;
  if (w === 0) {
    e = exec();
    w = t.here();
  }
  // The executor's reference and the handle's.
  const k = mk.task(e, poll, drop, rsize, rdrop, size, 2);
  m.st(k + t.T_TRANSFER, transfer);
  m.copy(m.ld(k + t.T_ROOT), state, size as usize);
  m.st(k + t.T_JOIN_STATE, t.J_HANDLE as usize);
  nc.spawned(e, k);
  mk.home(e, k);
  mk.liveUp(m.ld(e + t.E_MAIN), e);
  wk.scheduleNew(w, k);
  return k + t.T_JOIN;
}

/**
 * `spawn(p)` of heap future `f` (a stored promise, a join handle, a leaf): a task polling it,
 * scheduled now; its join handle, whose slot gets `rsize` bytes (dropped with `rdrop` when
 * nobody claims them). The task's state is `f` and `rsize`, then the root's result.
 */
export function schedSpawnFut(f: usize, rsize: u64, rdrop: usize): usize {
  // This thread's worker block (0 off the workers), read once (`exec`, and the queueing).
  let w = t.here();
  let e = w;
  if (w === 0) {
    e = exec();
    w = t.here();
  }
  const k = mk.task(e, fnAddress(run.futRootPoll), 0, rsize, rdrop, 16 + ((rsize + 15) & ~15), 2);
  const at = m.ld(k + t.T_ROOT);
  m.st(at, f);
  m.st(at + 8, rsize as usize);
  m.st(k + t.T_ROOT, at + 16);
  m.st(k + t.T_JOIN_STATE, t.J_HANDLE as usize);
  m.st(k + t.T_TRANSFER, 0);
  nc.spawned(e, k);
  mk.home(e, k);
  mk.liveUp(m.ld(e + t.E_MAIN), e);
  wk.scheduleNew(w, k);
  return k + t.T_JOIN;
}

/**
 * `velt_rt_spawn_target`: the next spawn from this worker is pinned to worker `worker`, where it
 * starts and stays (out of range: a panic with the runtime's message).
 */
export function schedPinned(worker: i64): void {
  const e = exec();
  const n = m.ld(m.ld(e + t.E_MAIN) + t.E_COUNT);
  if (worker < 0 || (worker as usize) >= n) {
    // The runtime's message.
    panic(
      `spawn: worker ${worker} is out of range (the runtime has ${n} worker${n === 1 ? "" : "s"})`,
    );
  }
  m.st(e + t.E_PIN, (worker as usize) + 1);
}

/** `workerCount()`: the workers running (fixed once the executor starts). */
export function schedWorkerCount(): u64 {
  return m.ld(m.ld(exec() + t.E_MAIN) + t.E_COUNT) as u64;
}

/**
 * `currentWorker()`: this thread's worker index (0 off the workers); a spare worker reports one
 * of the configured ones, so the index stays below `workerCount()` (#2371).
 */
export function schedCurrentWorker(): u64 {
  const w = t.here();
  if (w === 0) {
    return 0;
  }
  return (m.ld(w + t.E_INDEX) % m.ld(m.ld(w + t.E_MAIN) + t.E_COUNT)) as u64;
}

/** `await yieldNow()`: the task polled with `cx` runs again after the other ready tasks. */
export function schedYield(cx: usize): void {
  const w = m.ld(cx + 8);
  if (m.ld(w) === t.main() + t.E_VT) {
    // Running: polled again once this poll returns, at the back of the queue. While it runs,
    // only a wake changes its state, from RUNNING to NOTIFIED: a store, not a swap.
    m.store32(w + t.T_STATE, t.NOTIFIED);
    return;
  }
  m.wakeByRef(w);
}

/**
 * `velt_rt_fut_box`: a lazy boxed promise of the initial state at `state`; off the worker (a
 * pinned spawn's code), the runtime's, which its start and detach there start.
 */
export function schedBox(poll: usize, drop: usize, state: usize, size: u64, align: u64): usize {
  exec();
  if (!t.onWorker()) {
    return off.box(poll, drop, state, size, align);
  }
  return node.boxed(poll, drop, state, size, fnAddress(node.nodePoll), fnAddress(node.nodeDrop));
}

/** `velt_rt_task_id`: the id of the task being polled, 0 outside a task (sched_id.velt). */
export function schedTaskId(): u64 {
  return taskId();
}

/** `velt_rt_fut_start` (`rejecting`: `_start_rejecting`): promise `f` starts now. */
export function schedStart(f: usize, rdrop: usize, rejecting: bool): void {
  mk.refuseInRead();
  const e = t.exec();
  if (e === 0) {
    return;
  }
  if (!t.onWorker()) {
    off.start(f, rdrop, rejecting);
    return;
  }
  const c = m.ld(e + nc.E_CATCHING);
  node.start(m.ld(e + t.E_CURRENT), f, rdrop, rejecting, fnAddress(node.nodePoll), c);
}

/**
 * `velt_rt_fut_detach`: the owner gives up promise `f` without cancelling it: a lazy one starts
 * now (its result dropped quietly with `qdrop`), and keeps running; anything else is dropped.
 */
export function schedDetach(f: usize, qdrop: usize): void {
  const e = exec();
  if (!t.onWorker() && m.ld(f) !== fnAddress(node.nodePoll) && !jn.isJoin(f)) {
    // Off the worker: the runtime's box, or a leaf of its.
    off.detach(f, qdrop);
    return;
  }
  if (m.ld(f) !== fnAddress(node.nodePoll)) {
    // A spawned task's join handle: the task runs on, its rejection handled.
    jn.joinHandled(f, qdrop);
    // SAFETY: the caller owns `f`, a heap future, and gives it up.
    unsafe {
      futDrop(f);
    }
    return;
  }
  const c = m.ld(e + nc.E_CATCHING) & ~1;
  node.start(m.ld(e + t.E_CURRENT), f, qdrop, false, fnAddress(node.nodePoll), c);
  node.nodeDrop(f);
}

/**
 * `velt_rt_futs_handled`: the `n` promises at `futs` go to a combinator, which handles their
 * rejections: a started one's or a spawned task's result nobody claims is dropped with `qdrop`,
 * quietly.
 */
export function schedHandled(futs: usize, n: u64, qdrop: usize): void {
  if (!t.onWorker()) {
    off.handled(futs, n, qdrop);
  }
  const poll = fnAddress(node.nodePoll);
  for (let i: usize = 0; i < (n as usize); i++) {
    const f = m.ld(futs + 8 * i);
    if (!jn.joinHandled(f, qdrop)) {
      node.handled(f, qdrop, poll);
    }
  }
}

/** `velt_rt_await_tick`: the step of an `await` whose word is not 0; its ticket (0: go on). */
export function schedAwaitTick(cx: usize): u64 {
  if (t.exec() === 0) {
    return 0;
  }
  const w = m.ld(cx + 8);
  const k = wk.taskOf(w);
  if (k === 0 || micro.takeCredit(k) || m.ld32(k + t.T_WORD) === 0) {
    return 0;
  }
  return micro.enqueue(k, m.wakerClone(w), false);
}

/** `velt_rt_await_ready`: has the step's turn come (1)? If not, it resumes `cx`'s waker. */
export function schedAwaitReady(ticket: u64, cx: usize): u32 {
  const w = m.ld(cx + 8);
  const k = t.exec() === 0 ? 0 : wk.taskOf(w);
  if (k === 0 || micro.reached(k, ticket, w)) {
    return 1;
  }
  return 0;
}

/** `velt_rt_microtask`: a heap future that completes at its turn in the task's queue. */
export function schedMicrotask(): usize {
  return micro.future();
}

/** `velt_rt_keep_alive_acquire`: a ref'd timer keeps the process alive. */
export function schedKeepAliveAcquire(): void {
  exec();
  end.keepAcquire(t.main());
}

/** `velt_rt_keep_alive_release`: the reference `schedKeepAliveAcquire` took, given back. */
export function schedKeepAliveRelease(): void {
  exec();
  end.keepRelease(t.main());
}

/** `velt_rt_timer_unref_due`: a heap future, whether a due `unref()`'d timer's process ends. */
export function schedUnrefDue(): usize {
  exec();
  sp.anchor();
  return end.unrefDue();
}

/**
 * `velt_rt_sleep`: a heap future that completes `ms` milliseconds from now, in timer order; off
 * the worker (a pinned spawn's code), the runtime's.
 */
export function schedSleep(ms: i64): usize {
  if (!t.onWorker()) {
    return off.sleep(ms);
  }
  const e = exec();
  sp.anchor();
  return sl.sleep(e, ms);
}

/**
 * `velt_rt_timer_new`: a Node timer due `ms` milliseconds from now, queued; its handle (bit 0
 * set; off the worker, the runtime's handle, bit 0 clear).
 */
export function schedTimerNew(ms: i64): u64 {
  return tm.timerNew(ms);
}

/** `velt_rt_timer_turn`: a heap future that completes once timer `h`'s turn has come. */
export function schedTimerTurn(h: u64, gate: u64): usize {
  return tm.turn(h, gate);
}

/** `velt_rt_timer_again`: an interval's timer `h` queued again, `ms` after its last turn. */
export function schedTimerAgain(h: u64, ms: i64): void {
  tm.again(h, ms);
}

/** `velt_rt_timer_clear`: timer `h` leaves the order (`clearTimeout`). */
export function schedTimerClear(h: u64): void {
  tm.clear(h);
}

/** `velt_rt_timer_free`: timer `h` leaves the order and its handle is freed. */
export function schedTimerFree(h: u64): void {
  tm.free(h);
}

/**
 * `velt_rt_uncaught_now`: the next rejection nobody handles is an error a timer or microtask
 * callback threw, reported at once (sched_node.velt), not after the task's microtasks.
 */
export function schedUncaughtNow(): void {
  m.st(exec() + t.E_UNCAUGHT, 1);
  // SAFETY: the runtime's entry takes nothing; it records where the error was thrown.
  unsafe {
    velt_rt_uncaught_now$rt();
  }
}

/** `velt_rt_tla_at`: the top-level `await` at `site` suspends. */
export function schedTlaAt(site: string): void {
  exec();
  end.tlaAt(t.main(), site);
}

/** `velt_rt_module_state`: the module state block, to reach slot `slot` (sched_module.velt). */
export function schedModuleState(desc: usize, slot: u64): usize {
  return mod.state(desc, slot);
}

/** `velt_rt_module_block`: the module state block without the slot check (the root's `main`). */
export function schedModuleBlock(desc: usize): usize {
  return mod.block(desc);
}

/** `velt_rt_module_ready`: the block's slots below `n` are initialized. */
export function schedModuleReady(state: usize, n: u64): void {
  mod.ready(state, n);
}

/** `velt_rt_latch_new`: a closed latch. */
export function schedLatchNew(): u64 {
  return latch.latchNew();
}

/** `velt_rt_latch_free`: the handle's reference given back. */
export function schedLatchFree(l: u64): void {
  latch.latchFree(l);
}

/** `velt_rt_latch_open`: opens latch `l`, resuming its waiters. */
export function schedLatchOpen(l: u64): void {
  latch.latchOpen(l);
}

/** `velt_rt_latch_wait`: a heap future that completes once latch `l` is open. */
export function schedLatchWait(l: u64): usize {
  return latch.latchWait(l, fnAddress(latch.waitPoll), fnAddress(latch.waitDrop));
}
