// velt/lang/hooks (internal): the sleeps of a task that never runs again are given back when the
// program ends on an uncaught error with its counts on (sched_exit.velt), so the count of blocks
// left is the program's own. The sleeps themselves are sched_sleep.velt's.

import * as m from "./sched_mem";
import * as sl from "./sched_sleep";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/**
 * Task `k`, which never runs again (the program ends on an uncaught error: sched_exit.velt), gives
 * back its sleeps pending in block `b` (its worker's) and those due on its list: each leaves its
 * list, drops its waker and is freed. `k`'s state, which still points at them, is never polled
 * or dropped.
 */
export function forget(b: usize, k: usize): void {
  let p = m.ld(b + sl.TM_FIRST);
  while (p !== 0) {
    const next = m.ld(p + sl.S_NEXT);
    if (wk.taskOf(m.ld(p + sl.S_WAKER)) === k) {
      sl.unlinkPending(b, p);
      gone(p);
    }
    p = next;
  }
  let d = m.ld(k + t.T_TIMERS);
  while (d !== 0) {
    sl.unlinkDue(k, d);
    gone(d);
    d = m.ld(k + t.T_TIMERS);
  }
}

/** Sleep `f`, on no list: its waker dropped, freed. */
function gone(f: usize): void {
  const w = m.ld(f + sl.S_WAKER);
  if (w !== 0) {
    m.wakerDrop(w);
  }
  m.release(f, sl.S_SIZE);
}
