// velt/lang/hooks (internal): a started promise's waker table in the executor in Velt
// (sched_node.velt; rt_abi_async.md §1): C calls these, from any thread. A wake puts the node
// once among its task's woken nodes (holding a reference) and wakes the task.

import { export as cExport } from "velt/ffi";
import { inline, noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as lk from "./sched_lock";
import * as nd from "./sched_node";
import * as wn from "./sched_node_woken";
import * as t from "./sched_task";
import * as wa from "./sched_wake_away";
import * as wk from "./sched_wake";

@cExport("std_sched_node_clone")
export function nodeClone(w: usize): usize {
  m.inc(w + nd.N_REFS);
  return w;
}

@cExport("std_sched_node_wake")
export function nodeWake(w: usize): void {
  if (wk.counting()) {
    countedWake(w);
    return;
  }
  wakeGiving(w);
}

/** `nodeWake` with the block counters on: counted until the reference is back (sched_wake.velt). */
@noInline
function countedWake(w: usize): void {
  wk.wakingStarts();
  wakeGiving(w);
  wk.wakingEnds();
}

/**
 * Wakes node `n` and gives back the waker's reference. On the thread polling its task, in that
 * order: the node's poll comes after. From any other thread, with the locks on, the node may be
 * polled, and park with that reference still counted (so it is not counted owner-only), before a
 * release after the wake gives it back, and nothing polls it again (#3487): there the reference
 * goes to the task's woken nodes in place of a new one (`give`), and the task is woken as
 * sched_node_lost.velt `handBack` does, under a reference of its own that goes with the wake
 * (sched_wake_away.velt `wakeAway`).
 */
@inline("always")
function wakeGiving(n: usize): void {
  if (lk.mode() === lk.LK_ON) {
    const task = m.ld(n + nd.N_TASK);
    const e = t.here();
    if (!(e !== 0 && m.ld(e + t.E_CURRENT) === task)) {
      wakeAway(task, n);
      return;
    }
  }
  wake(n);
  nd.release(n);
}

@noInline
function wakeAway(task: usize, n: usize): void {
  const fl = m.load32(n + nd.N_FLAGS);
  if ((fl & nd.FINISHED) !== 0 || (fl & nd.STARTED) === 0) {
    // Nothing to wake, as `wake` finds.
    nd.release(n);
    return;
  }
  // The node holds a reference to its task, and this one to the node: the task is alive.
  m.inc(task + t.T_REFS);
  give(n);
  wa.wakeAway(task);
}

@cExport("std_sched_node_wake_by_ref")
export function nodeWakeByRef(w: usize): void {
  wake(w);
}

@cExport("std_sched_node_drop_ref")
export function nodeDropRef(w: usize): void {
  nd.release(w);
}

/**
 * Gives started node `n` to its task with the caller's reference: among its task's woken nodes,
 * the reference the stack's from then on (a node that is there already just loses it), finished
 * or not. The caller keeps the task alive meanwhile and wakes it (sched_node_lost.velt
 * `droppedAway`).
 */
export function give(n: usize): void {
  let fl = m.load32(n + nd.N_FLAGS);
  while (true) {
    if ((fl & nd.QUEUED) !== 0) {
      nd.release(n);
      return;
    }
    const was = m.cas32(n + nd.N_FLAGS, fl, fl | nd.QUEUED);
    if (was === fl) {
      break;
    }
    fl = was;
  }
  const task = m.ld(n + nd.N_TASK);
  m.pushStack(task + t.T_WOKEN, n, nd.N_NEXT);
  if (m.load32(task + t.T_STATE) === t.DONE) {
    // Pushed too late, as in `wake`.
    wn.giveBackWoken(task);
  }
}

/** Wakes node `n`: once among its task's woken nodes (holding a reference), its task woken. */
function wake(n: usize): void {
  let fl = m.load32(n + nd.N_FLAGS);
  while (true) {
    if ((fl & (nd.FINISHED | nd.QUEUED)) !== 0 || (fl & nd.STARTED) === 0) {
      return;
    }
    const was = m.cas32(n + nd.N_FLAGS, fl, fl | nd.QUEUED);
    if (was === fl) {
      break;
    }
    fl = was;
  }
  m.inc(n + nd.N_REFS);
  const task = m.ld(n + nd.N_TASK);
  m.pushStack(task + t.T_WOKEN, n, nd.N_NEXT);
  if (m.load32(task + t.T_STATE) === t.DONE) {
    // Pushed too late: the task ended meanwhile (sched_node_woken.velt `giveBackWoken`).
    wn.giveBackWoken(task);
    return;
  }
  const e = t.here();
  if (!(e !== 0 && m.ld(e + t.E_CURRENT) === task)) {
    wk.wake(task);
  }
}
