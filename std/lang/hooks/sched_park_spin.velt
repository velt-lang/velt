// velt/lang/hooks (internal): the executor's parking where the OS's wait on an address is not
// wired up yet (Windows' `WaitOnAddress`, #2649): the worker spins until the park word changes.

import { Ptr } from "velt/ffi";
import { atomicSpinHint, ptrAtomicLoad } from "velt/lang/intrinsics";

/** Spins while the `u32` at `word` is `expected`. */
export function parkWait(word: usize, expected: u32): void {
  // SAFETY: `word` is the executor's park word, an aligned u32 changed atomically.
  while (unsafe { ptrAtomicLoad(Ptr.at<u32>(word), "seqcst") } === expected) {
    atomicSpinHint();
  }
}

/** Nothing to do: the worker sees the word change. */
export function parkWake(word: usize): void {}
