// velt/lang/hooks (internal): `sleep` under the executor in Velt (sched.velt, #2649), and the
// worker's timer block, made on its first sleep: a worker that never sleeps has none. Node's timer
// order (sched_order.velt) has one block of the same layout for the process, and uses only the
// order's fields of it; a worker's block leaves them 0.
//
// A `sleep(ms)` is a heap future (rt_abi_async.md §1) due at its deadline, taken when it is
// created (nanoseconds of the clock `performance.now()` reads), and numbered then. It resumes in
// timer order, as the runtime's Rust timers it replaced and Node's: by deadline, then in
// the order the timers were created; never just because its deadline passed (#589), so the code
// after `await sleep(0)` runs after the synchronous code that started it.
// - Polled the first time, it joins the block's list of pending sleeps, sorted by (deadline,
//   number); most come in that order, so the place is found from the end.
// - When the worker looks (its park, or every I/O tick of a busy worker: `expire`), the sleeps
//   whose deadline passed move, in order, to their task's due list (a circular list whose first
//   entry is the task's `T_TIMERS`) and the task is woken with flag `TIMED` (and `LOCALS`). Its
//   next poll fires them one at a time, in order: each resumes its waiter at once (the root, or a
//   promise of the task) and the task's microtasks run before the next (sched_fire.velt
//   `fireDue`), as Node's timer phase runs them. A poll that fires the task's yields first moves
//   its sleeps due by then there (`dueNow`), as Node's timers phase comes before its check phase.
//   A waiter that polls several of them (`Promise.all` over sleeps) sees
//   only those fired so far ready, so they finish in timer order whoever polls them; and a due
//   sleep polled while it is first on its task's due list fires itself, once every sleep fired
//   before it was seen and no microtask is queued or running (the runtime's rule: no earlier
//   timer is still to be seen, so its turn has come), so a join polling it after its waiter's
//   other leaves sees it in the same poll.
// - A sleep polled by a waker that is not a task's (a Rust combinator) is fired by waking it.
// A pending sleep keeps the process alive (sched_end.velt `busy`).

import { fnAddress, inline, noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as nd from "./sched_node";
import * as mv from "./sched_sleep_move";
import * as rl from "./sched_sleep_rule";
import * as sp from "./sched_spread";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/**
 * The timer block's fields: the pending sleeps (first, last), the last sleep number, the sleeps
 * fired from a due list whose leaf has not seen it yet; after the order's fields, the sleeps on
 * due lists (a Node timer's turn waits for them: sched_order.velt `step`).
 */
export const TM_FIRST: usize = 0;
export const TM_LAST: usize = 8;
export const TM_SEQ: usize = 16;
export const TM_UNSEEN: usize = 24;
/** Node's timer order (sched_order.velt) owns the fields from here up to `TM_DUE`. */
export const TM_ORDER: usize = 32;
export const TM_DUE: usize = 288;
export const TM_SIZE: usize = 296;

/**
 * A sleep: its deadline (nanoseconds), number, waker, links (the pending list, or its task's due
 * list), state, and the task whose due list holds it.
 */
export const S_DEADLINE: usize = 16;
export const S_SEQ: usize = 24;
export const S_WAKER: usize = 32;
export const S_PREV: usize = 40;
export const S_NEXT: usize = 48;
export const S_STATE: usize = 56;
export const S_TASK: usize = 64;
/**
 * While it is pending: the await word (`T_WORD`) of the task that polled it into its worker's
 * timer block, what that task's contexts point at, if the waker it was registered with keeps
 * that task alive (`sleepPoll`); else 0. A word that is not 0 names a live task, never an
 * address a task made later was given.
 */
export const S_OWNER: usize = 72;
/**
 * The worker whose timer block holds it, once it was polled there (read from other threads:
 * sched_sleep_move.velt).
 */
export const S_HOME: usize = 80;
/** The hand-overs and the drop under way for it, on other workers' lists (sched_sleep_move.velt). */
export const S_ASKS: usize = 88;
export const S_SIZE: usize = 96;

/**
 * The bit in which the place of a task's own context in the task (`T_CX`) differs from the place
 * of a promise's in its node (`N_CX`): with it set, either offset is `T_CX` (`sleepPoll`).
 */
const OWN_BIT: usize = t.T_CX ^ nd.N_CX;

/**
 * A sleep's states: not polled yet; seen; pending; due (on its task's due list); fired (counted in
 * `TM_UNSEEN` until its leaf sees it); carried by an offered task (in its `T_TIMERS`,
 * sched_sleep_carry.velt); dropped while a hand-over was under way (sched_sleep_move.velt). The
 * two that are on no list come first: those above `SEEN` hold a place somewhere (`sleepDrop`).
 */
export const NEW: usize = 0;
export const SEEN: usize = 1;
export const PENDING: usize = 2;
export const DUE: usize = 3;
export const FIRED: usize = 4;
export const CARRIED: usize = 5;
export const GONE: usize = 6;

/** The clock timers count by: nanoseconds since the process started (`performance.now()`). */
export function clock(): u64 {
  return (performance.now() * 1000000.0) as u64;
}

/** Executor `e`'s timer block, made on first use. */
export function block(e: usize): usize {
  const b = m.ld(e + t.E_TIMERS);
  if (b !== 0) {
    return b;
  }
  return open(e);
}

@noInline
function open(e: usize): usize {
  const b = m.lastingZeroed(TM_SIZE);
  m.st(e + t.E_TIMERS, b);
  return b;
}

/** `velt_rt_sleep`: a sleep of `ms` milliseconds (negative: 0) from now, a heap future. */
export function sleep(e: usize, ms: i64): usize {
  const b = block(e);
  const f = m.alloc(S_SIZE);
  m.st(f, fnAddress(sleepPoll));
  m.st(f + 8, fnAddress(sleepDrop));
  const d = ms < 0 ? 0 : ms;
  m.st(f + S_DEADLINE, (clock() + (d as u64) * 1000000) as usize);
  const seq = m.ld(b + TM_SEQ) + 1;
  m.st(b + TM_SEQ, seq);
  m.st(f + S_SEQ, seq);
  m.st(f + S_WAKER, 0);
  m.st(f + S_STATE, NEW);
  // The links, `S_HOME` and `S_TASK` are written when a state that reads them begins: the links
  // and `S_HOME` with `PENDING` (`sleepPoll`, `insert`; `adopt`), `S_TASK` with `DUE` (`pushDue`).
  m.st(f + S_ASKS, 0);
  return f;
}

function sleepPoll(f: usize, cx: usize): u32 {
  // Loaded as shared: a worker that gave this sleep up stored its state last
  // (sched_sleep_move.velt `release`).
  const s = m.load(f + S_STATE);
  if (s <= SEEN) {
    if (s === SEEN) {
      return 1;
    }
  } else {
    // Polled before: is it in this worker's block? The task that polled it there is anchored
    // there with it; another task's poll (the promise was handed on) may run anywhere.
    if (s === FIRED) {
      // Seen by this poll, which registers nothing: all it needs is that this worker holds the
      // sleep (the worker is at hand, for `seenOn`), whichever task polls. The state first, then
      // the worker, as `here` reads them.
      const e = t.exec();
      if (m.load(f + S_HOME) !== e) {
        return mv.ask(f, m.ld(cx + 8));
      }
      seenOn(e, f);
      return 1;
    }
    if (s === DUE) {
      // Due for a task (`S_TASK`, the one its waker wakes: `expire`), which that waker keeps
      // alive until the sleep fires. So a poll whose context names that task (its first word
      // points at the polling task's `T_WORD`: a task's own context, a promise's, and a
      // combinator's, which passes its poller's on) is that task's and no other's: an address
      // compared here is never one a task made later was given (#3207). That task registered
      // its waker in a poll on the worker that holds the sleep and is anchored there. Any
      // other poll asks the worker.
      if (m.ld(cx) !== m.ld(f + S_TASK) + t.T_WORD && !here(f, s)) {
        return mv.ask(f, m.ld(cx + 8));
      }
      if (firesItself(t.exec(), f)) {
        unlinkDue(m.ld(f + S_TASK), f);
        m.storeRelease(f + S_STATE, SEEN);
        return 1;
      }
    } else if (m.ld(cx) !== m.loadRelaxed(f + S_OWNER) && !here(f, s)) {
      // Pending in another worker's block, or carried by an offered task: its worker gives it
      // up, and this task polls it again as a new one. The shortcut: a poll whose context
      // names the task the sleep keeps as its owner (`S_OWNER`, a live task: below) is that
      // task's, which is anchored to the worker that holds the sleep.
      return mv.ask(f, m.ld(cx + 8));
    }
  }
  const w = m.ld(cx + 8);
  const old = m.ld(f + S_WAKER);
  if (old !== w) {
    // The owner word, an address, may only name a task that cannot be freed while the sleep
    // names it, or a task made later at that address would pass for the owner on whatever
    // worker it runs (#3207). What keeps the polling task is the sleep's own waker when it
    // is that task's or a promise's of it, the waker of the context itself then (a context
    // sits inside the object its waker is: `T_CX`, `N_CX`): a clone of it is a reference. A
    // combinator's waker keeps no task, and neither does a waker registered later. Stored
    // before the clone's call, which then needs no context: the task is the one polling.
    // One compare for both: the two offsets differ in one bit (`OWN_BIT`).
    const own = s === NEW && ((cx - w) | OWN_BIT) === t.T_CX;
    m.storeRelaxed(f + S_OWNER, own ? m.ld(cx) : 0);
    m.st(f + S_WAKER, m.wakerClone(w));
    if (old !== 0) {
      m.wakerDrop(old);
    }
  }
  if (s === NEW) {
    // Pending in this worker's timer block: its task stays on this worker, unless an offer
    // carries it with its sleeps (sched_sleep_carry.velt).
    const e = t.exec();
    sp.anchorOn(e);
    // Unordered: `insert` stores the state after it, released.
    m.storeRelaxed(f + S_HOME, e);
    insert(block(e), f);
  }
  return 0;
}

function sleepDrop(f: usize): void {
  const s = m.load(f + S_STATE);
  const asks = m.load(f + S_ASKS);
  // The usual drop in one test: on no list (new or seen, the two states below `PENDING`)
  // and named by no request.
  if (((s >> 1) | asks) !== 0) {
    mv.dropHeld(f, s, asks);
    return;
  }
  const w = m.ld(f + S_WAKER);
  if (w !== 0) {
    m.wakerDrop(w);
  }
  m.release(f, S_SIZE);
}

/**
 * Sleep `f` (state `s`), polled before: is it in this worker's block? Then the task polling it
 * stays with it from now on, as the first that polled it did (anchored). No when another
 * worker's block holds it or an offered task carries it.
 */
@noInline
function here(f: usize, s: usize): bool {
  if (s === CARRIED || m.load(f + S_HOME) !== t.exec()) {
    return false;
  }
  sp.anchor();
  return true;
}

/** Fired sleep `f` was seen (polled ready, or dropped) on its worker `e`. */
@inline("always")
export function seenOn(e: usize, f: usize): void {
  const b = block(e);
  m.st(b + TM_UNSEEN, m.ld(b + TM_UNSEEN) - 1);
  m.storeRelease(f + S_STATE, SEEN);
}

/**
 * May due sleep `f` fire itself now? It is first on its task's due list, that task is being
 * polled, every sleep fired before it was seen, and no microtask is queued or running.
 */
function firesItself(e: usize, f: usize): bool {
  const k = m.ld(f + S_TASK);
  return (
    m.ld(k + t.T_TIMERS) === f &&
    m.ld(e + t.E_CURRENT) === k &&
    m.ld(block(e) + TM_UNSEEN) === 0 &&
    m.ld32(k + t.T_WORD) === 0 &&
    m.ld(e + t.E_JOB) === 0
  );
}

/** Does sleep `a` come before a sleep due at `d` numbered `seq`? */
@inline("always")
function before(a: usize, d: usize, seq: usize): bool {
  const ad = m.ld(a + S_DEADLINE);
  return ad < d || (ad === d && m.ld(a + S_SEQ) < seq);
}

/**
 * Puts sleep `f` among the pending ones of block `b`, in order (its place found from the end).
 *
 * The state is stored last, released: the registration this ends (`S_OWNER`, `S_HOME`, the
 * links) comes with it to a worker that reads the state with an acquiring load (`sleepPoll`,
 * `here`, `sleepDrop`, sched_sleep_move.velt `release`). The holder's later states, `DUE` and
 * `FIRED`, are stored unordered (relaxed), and a reader that loads one of them sees this
 * registration all the same: they are stored by the thread that released `PENDING`, to the same
 * word, after it, and both targets keep one thread's stores to one word in that order (x86-64
 * is TSO; arm64 orders a store after an earlier store to the same location from the same thread
 * and is other-multi-copy atomic), while no compiler moves a store above a release store to the
 * same word. The language's release sequences would not carry it (they continue only through
 * read-modify-writes); this is the reason it holds. So a reader that finds its own worker in
 * `S_HOME` while the state is `DUE` or `FIRED` reads this registration's home, never an older
 * one. `SEEN` stays released: a worker that reads it may free the sleep.
 */
export function insert(b: usize, f: usize): void {
  const d = m.ld(f + S_DEADLINE);
  const seq = m.ld(f + S_SEQ);
  let at = m.ld(b + TM_LAST);
  while (at !== 0 && !before(at, d, seq)) {
    at = m.ld(at + S_PREV);
  }
  // `f` goes after `at` (first when 0).
  const next = at === 0 ? m.ld(b + TM_FIRST) : m.ld(at + S_NEXT);
  m.st(f + S_PREV, at);
  m.st(f + S_NEXT, next);
  if (at === 0) {
    m.st(b + TM_FIRST, f);
  } else {
    m.st(at + S_NEXT, f);
  }
  if (next === 0) {
    m.st(b + TM_LAST, f);
  } else {
    m.st(next + S_PREV, f);
  }
  // Released, last (the doc comment above).
  m.storeRelease(f + S_STATE, PENDING);
}

/**
 * Takes pending sleep `f` out of block `b`. Its state is left as it was: the caller stores the
 * state it means (or frees the sleep). No state in between, since a task on another worker may
 * read it (`sleepPoll`), and a new sleep is one it may register (#3207).
 */
export function unlinkPending(b: usize, f: usize): void {
  const prev = m.ld(f + S_PREV);
  const next = m.ld(f + S_NEXT);
  if (prev === 0) {
    m.st(b + TM_FIRST, next);
  } else {
    m.st(prev + S_NEXT, next);
  }
  if (next === 0) {
    m.st(b + TM_LAST, prev);
  } else {
    m.st(next + S_PREV, prev);
  }
}

/** Appends sleep `f` to task `k`'s due list (circular: the first entry's `S_PREV` is the last). */
export function pushDue(k: usize, f: usize): void {
  const first = m.ld(k + t.T_TIMERS);
  if (first === 0) {
    m.st(f + S_PREV, f);
    m.st(f + S_NEXT, f);
    m.st(k + t.T_TIMERS, f);
  } else {
    const last = m.ld(first + S_PREV);
    m.st(f + S_PREV, last);
    m.st(f + S_NEXT, first);
    m.st(last + S_NEXT, f);
    m.st(first + S_PREV, f);
  }
  m.st(f + S_TASK, k);
  // Released: a poll on another worker that reads `DUE` reads this `S_TASK` (`sleepPoll`).
  m.storeRelease(f + S_STATE, DUE);
  const b = m.ld(t.exec() + t.E_TIMERS);
  m.st(b + TM_DUE, m.ld(b + TM_DUE) + 1);
}

/** Takes due sleep `f` off task `k`'s due list; its state is the caller's to store, as `unlinkPending`'s. */
export function unlinkDue(k: usize, f: usize): void {
  const next = m.ld(f + S_NEXT);
  if (next === f) {
    m.st(k + t.T_TIMERS, 0);
  } else {
    const prev = m.ld(f + S_PREV);
    m.st(prev + S_NEXT, next);
    m.st(next + S_PREV, prev);
    if (m.ld(k + t.T_TIMERS) === f) {
      m.st(k + t.T_TIMERS, next);
    }
  }
  const b = m.ld(t.exec() + t.E_TIMERS);
  m.st(b + TM_DUE, m.ld(b + TM_DUE) - 1);
}

/** The first sleep on task `k`'s due list, or 0. */
@inline("always")
export function firstDue(k: usize): usize {
  return m.ld(k + t.T_TIMERS);
}

/** The waker of due sleep `f` (borrowed). */
@inline("always")
export function waiter(f: usize): usize {
  return m.ld(f + S_WAKER);
}

/**
 * Fires sleep `f`, first on task `k`'s due list: its waker (the reference it held, which the
 * caller takes).
 */
export function fire(k: usize, f: usize): usize {
  unlinkDue(k, f);
  // Unordered: see `insert`.
  m.storeRelaxed(f + S_STATE, FIRED);
  const b = block(t.exec());
  m.st(b + TM_UNSEEN, m.ld(b + TM_UNSEEN) + 1);
  const w = m.ld(f + S_WAKER);
  m.st(f + S_WAKER, 0);
  return w;
}

/** Sleep `f` leaves its worker's block for an offered task's list (sched_sleep_carry.velt `carry`). */
export function carried(b: usize, f: usize): void {
  unlinkPending(b, f);
  m.storeRelease(f + S_STATE, CARRIED);
}

/** The deadline of sleep `f` (nanoseconds on `clock`). */
@inline("always")
export function deadline(f: usize): u64 {
  return m.ld(f + S_DEADLINE) as u64;
}

/** Are sleeps of block `b` on due lists, not fired yet? */
@inline("always")
export function due(b: usize): bool {
  return m.ld(b + TM_DUE) !== 0;
}

/** The deadline of block `b`'s first pending sleep (0: none). */
@inline("always")
export function nextDeadline(b: usize): u64 {
  const f = m.ld(b + TM_FIRST);
  return f === 0 ? 0 : m.ld(f + S_DEADLINE) as u64;
}

/** Are sleeps pending in block `b`? */
@inline("always")
export function pending(b: usize): bool {
  return m.ld(b + TM_FIRST) !== 0;
}

/**
 * The sleeps of block `b` whose deadline passed by `now` go to their tasks' due lists, in order,
 * and the tasks are woken (flag `TIMED`); the deadline of the first one left (0: none).
 */
export function expire(b: usize, now: u64): u64 {
  if (wk.counting()) {
    rl.checkExpiring(b, now);
  }
  let f = m.ld(b + TM_FIRST);
  while (f !== 0 && (m.ld(f + S_DEADLINE) as u64) <= now) {
    unlinkPending(b, f);
    const w = m.ld(f + S_WAKER);
    const k = wk.taskOf(w);
    if (k === 0) {
      // Polled by a waker that is not a task's: fired by waking it. The waker goes first: a
      // drop that sees `SEEN` frees the sleep and drops the waker it finds.
      m.st(f + S_WAKER, 0);
      m.storeRelease(f + S_STATE, SEEN);
      m.wakeOwned(w);
    } else {
      pushDue(k, f);
      // With `LOCALS`, so a poll checks one flag for both (sched_run.velt `run`).
      t.flags(k, t.TIMED | t.LOCALS, 0);
      wk.wake(k);
    }
    f = m.ld(b + TM_FIRST);
  }
  if (f === 0) {
    return 0;
  }
  return m.ld(f + S_DEADLINE) as u64;
}

/**
 * Worker `e`'s look at its sleeps alone (a program without Node's timers: sched_park.velt): those
 * due fire; the deadline of the first one left (0: none).
 */
export function expireOwn(e: usize): u64 {
  const b = m.ld(e + t.E_TIMERS);
  if (b === 0 || !pending(b)) {
    return 0;
  }
  return expire(b, clock());
}

/** The milliseconds from `now` until `at` (nanoseconds), rounded up; 0 once passed. */
export function millisUntil(at: u64, now: u64): i64 {
  if (at <= now) {
    return 0;
  }
  return (((at - now) + 999999) / 1000000) as i64;
}
