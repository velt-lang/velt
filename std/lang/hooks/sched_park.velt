// velt/lang/hooks (internal): a worker of the executor in Velt (sched.velt, #2649) parks in its
// reactor when it has nothing to run (sched_loop.velt `idle`): worker 0 decides the program's end
// there (sched_end.velt), and a spare asked to retire answers as it leaves (sched_relax.velt).

import { inline, noInline, stdUsed } from "velt/lang/intrinsics";
import * as end from "./sched_end";
import * as io from "./sched_io";
import * as w from "./sched_io_write";
import * as loop from "./sched_loop";
import * as m from "./sched_mem";
import * as mon from "./sched_monitor";
import * as order from "./sched_order";
import * as ow from "./sched_order_wait";
import * as q from "./sched_queue";
import * as rx from "./sched_relax";
import * as sl from "./sched_sleep";
import * as sp from "./sched_spread";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/**
 * May worker `e` (its park word up, nothing queued) sleep? Worker 0 decides the program's end
 * there (sched_end.velt `mayPark`); another worker wakes worker 0 if it sleeps, so that it looks
 * again with this one idle. Worker 0 does not sleep once the root task of `main` is left
 * (sched_task.velt `rootLeft`): the worker that ended it (sched_run.velt `mainDone`,
 * `mainFinish`) stores that, then wakes worker 0 only if its park word is up; read after the
 * word went up (both sequentially consistent, as the inbox and queue before), either that worker
 * sees the word and wakes worker 0, or worker 0 sees the root left here.
 */
function parkable(e: usize): bool {
  const g = m.ld(e + t.E_MAIN);
  // Idle: what its tasks printed reaches the OS before the worker sleeps, as the runtime's
  // workers do. A reader of a pipe waits for it, maybe for as long as the sleep (#2873).
  wk.handOffOutput();
  if (e === g) {
    const root = m.ld(e + t.E_ROOT);
    if (root !== 0 && t.rootLeft(root, true)) {
      return false;
    }
    return end.mayPark(e);
  }
  wk.unpark(g);
  return true;
}

/**
 * Sleeps in the reactor until a socket is ready, a task is woken from another thread or the next
 * timer is due; what is due is sent first, and what the wait made due (writable sockets with
 * bytes left) after it. Due timers fire before (when they make a task ready, the worker does not
 * wait) and after the wait. Not when nothing can happen any more (sched_end.velt `mayPark`: the
 * program ends). Out of line: the worker's step (`turn`) stays small enough to inline.
 */
@noInline
export function park(e: usize): void {
  const b = m.ld(e + t.E_IO);
  m.st32(e + t.E_DISPATCH, t.D_INPUT);
  if (io.anyDue(b)) {
    w.flushDue(b);
  }
  let timeout: i64 = -1;
  const timers = timersAny(e);
  if (timers) {
    timeout = timersNext(e);
    if (q.any(e)) {
      m.st32(e + t.E_DISPATCH, 0);
      tookWork(e);
      return;
    }
  }
  m.store32(e + t.E_PARK, 1);
  const mode = m.ld32(e + t.E_MODE);
  if (m.load(e + t.E_INBOX) !== 0 || q.any(e) || !parkable(e)) {
    m.store32(e + t.E_PARK, 0);
    m.st32(e + t.E_DISPATCH, 0);
    if (timers) {
      tookWork(e);
    }
    if ((mode & t.M_MONITOR) !== 0 || m.ld(e + t.E_LAZY) !== 0) {
      // The monitor may have seen every worker parked meanwhile and gone to sleep.
      mon.kick(m.ld(e + t.E_MAIN));
    }
    retiring(e);
    return;
  }
  if (stdUsed("nodeTimers")) {
    if (timers) {
      // With the park word up: the one worker that waits for Node's timers waits until then.
      timeout = ow.wait(e, timeout);
    }
  }
  let asleep: usize = 0;
  if ((mode & t.M_SPREAD) !== 0) {
    asleep = sp.now();
  }
  io.park(b, timeout, e + t.E_PARK, e + t.E_UNPARKS);
  m.store32(e + t.E_PARK, 0);
  if (timers) {
    woke(e);
  }
  if (m.ld(e + t.E_UNREF) !== 0 && e !== m.ld(e + t.E_MAIN)) {
    // Worker 0 found something that can still happen: due unref()'d timers ask again.
    end.wakeUnref(e);
  }
  if (io.anyDue(b)) {
    w.flushDue(b);
  }
  m.st32(e + t.E_DISPATCH, 0);
  loop.turned(e);
  if (mode !== 0) {
    const g = m.ld(e + t.E_MAIN);
    if ((mode & t.M_SPREAD) !== 0) {
      sp.slept(e, m.ld(e + t.E_NOW) - asleep);
    }
    // Asleep is not stalled: the monitor counts from now.
    m.st(e + t.E_PROGRESS, m.load(g + t.E_TICKS));
    if ((mode & t.M_MONITOR) !== 0) {
      mon.kick(g);
    }
  } else if (m.ld(e + t.E_LAZY) !== 0) {
    // A lazy worker 0 awake again: its polls need watching (sched_monitor.velt `lazyDuties`).
    mon.kick(e);
  }
  retiring(e);
}

/**
 * Has worker `e` timers to look at: sleeps, or Node's timer order? A program that never sets a
 * Node timer (`noteStdUse("nodeTimers")` in std/prelude/timers.velt) carries none of the order's
 * code: these and sched_run.velt are the executor's only ways into it, each behind
 * `stdUsed("nodeTimers")`, with the sleeps alone on the other path.
 */
@inline
export function timersAny(e: usize): bool {
  if (stdUsed("nodeTimers")) {
    return order.any(e);
  }
  return m.ld(e + t.E_TIMERS) !== 0;
}

/** A busy worker's look at its timers (`timersAny`): due sleeps fire, Node's loop moves on. */
export function timersTick(e: usize): void {
  if (stdUsed("nodeTimers")) {
    order.tick(e);
  } else {
    sl.expireOwn(e);
  }
}

/** `park`'s look at the timers before it waits: how long its sleeps let it wait (ms; -1: any). */
function timersNext(e: usize): i64 {
  if (stdUsed("nodeTimers")) {
    return order.next(e);
  }
  const b = m.ld(e + t.E_TIMERS);
  if (b === 0 || !sl.pending(b)) {
    return -1;
  }
  const now = sl.clock();
  const d = sl.expire(b, now);
  return d === 0 ? -1 : sl.millisUntil(d, now);
}

/** Worker `e` found tasks instead of parking: another worker waits for Node's timers. */
@inline
export function tookWork(e: usize): void {
  if (stdUsed("nodeTimers")) {
    ow.handOff(e);
  }
}

/**
 * Worker `e` woke from its park: due timers fire. The worker that waited for Node's timers passes
 * that on when it has tasks to run (`order.woke`): another may wait while it runs them.
 */
@inline
function woke(e: usize): void {
  if (stdUsed("nodeTimers")) {
    if (order.woke(e) && (m.load(e + t.E_INBOX) !== 0 || q.any(e))) {
      ow.handOff(e);
    }
  } else {
    sl.expireOwn(e);
  }
}

/**
 * Worker `e` leaves its park: a spare asked to retire, or retired, runs nothing from here until
 * the monitor wants it back (sched_relax.velt). Read after its park word went down, ordered.
 */
@inline
function retiring(e: usize): void {
  if ((m.load32(e + t.E_RETIRED) & t.R_AWAY) !== 0) {
    rx.retiredLook(e);
  }
}
