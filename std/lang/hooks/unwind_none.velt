// velt/lang/hooks (internal): where generated code doesn't catch Velt's exception (`#unwind-raise`
// on WebAssembly;
// docs/internals/design/unwinding.md). `catchUnwind` is a plain call there and `enterCatch` never
// counts a catch, so nothing is raised: a panic takes `velt_rt_panic`. No unwinder function is
// named, so the program links where `_Unwind_RaiseException` doesn't exist.

declare function velt_rt_exit(code: i32): never;

/** Never called (nothing unwinds here); ends the process. */
export function abortProcess(): never {
  velt_rt_exit(134);
}

/** Never called (no catch counts here); raises nothing. */
export function raise(msg: string): void {}

/**
 * Never called with an exception (`catchUnwind` returns 0 here).
 *
 * Unsafe: the same contract as the Itanium one, `e` must be an exception `catchUnwind` returned,
 * taken once.
 */
export unsafe function takePanic(e: usize): string {
  return "";
}

/**
 * Never called with an exception (`catchUnwind` returns 0 here).
 *
 * Unsafe: the same contract as the Itanium one, `e` must be an exception `catchUnwind` returned.
 */
export unsafe function panicText(e: usize): string {
  return "";
}
