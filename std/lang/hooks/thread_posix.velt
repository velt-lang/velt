// velt/lang/hooks (internal): the threads of the executor in Velt's workers (sched.velt, #2649
// step 3) on macOS and Linux: `pthread_create` on a C function Velt exports (`@export`, its
// address from `exportedAddress`), with the stack every thread that runs tasks has, and the
// number of online cores (`sysconf`), the default worker count.
//
// Pointers are `Ptr`s and integers the C types', as the headers declare them (`velt native
// headers --std` checks this file: crates/veltc/src/native/headers/std_check.rs). One C symbol
// has one signature in a program, so a program's own declarations of these symbols match.
// A thread that ends on its own is created detached (its attributes), so no `pthread_t` is read
// back or passed on (a pointer on macOS and musl, an integer on glibc): `pthread_create` only
// writes it to the room after `ATTR`.

import { Ptr } from "velt/ffi/ptr";
import * as r from "#reactor";
import * as m from "./sched_mem";

/** Can this OS start worker threads? (The default variant cannot: one worker.) */
export const SUPPORTED: bool = true;

/** A worker thread's stack: 8 MiB, as the runtime's task threads and the main thread have. */
const STACK: usize = 8388608;
/** Room for a `pthread_attr_t` (56 or 64 bytes on these OSes) and a `pthread_t`. */
const ATTR: usize = 128;

/** C's `pthread_attr_t` (its room is laid out here: `ATTR`). */
declare c type pthread_attr_t;

// `thread`: a `pthread_t *` (a pointer or an integer, as above); `start`: a function pointer
// (`Ptr<void>` until `CFunction`).
declare c("c") function pthread_create(
  thread: Ptr<void>,
  attr: Ptr<pthread_attr_t>,
  start: Ptr<void>,
  arg: Ptr<void> | null,
): i32;
declare c("c") function pthread_attr_init(attr: Ptr<pthread_attr_t>): i32;
declare c("c") function pthread_attr_setstacksize(attr: Ptr<pthread_attr_t>, size: usize): i32;
declare c("c") function pthread_attr_destroy(attr: Ptr<pthread_attr_t>): i32;
declare c("c") function pthread_attr_setdetachstate(attr: Ptr<pthread_attr_t>, state: i32): i32;
declare c("c") function sysconf(name: i32): i64;

/** The online cores (at least 1). */
export function cores(): usize {
  // SAFETY: `sysconf` takes a constant and returns a number.
  const n = unsafe { sysconf(r.SC_NPROCESSORS_ONLN) };
  return n < 1 ? 1 : n as usize;
}

/**
 * Starts a thread running C function `start` (an `@export`ed one: `void* f(void*)`) with `arg`;
 * whether it started. The thread is never joined: it runs until the process ends.
 */
export function start(start: usize, arg: usize): bool {
  return startThread(start, arg, false);
}

/**
 * As `start`, for a thread that ends on its own (a blocking pool's: its function returns): the
 * OS frees what it holds when it ends.
 */
export function startDetached(start: usize, arg: usize): bool {
  return startThread(start, arg, true);
}

function startThread(start: usize, arg: usize, detach: bool): bool {
  const a = m.zeroed(ATTR + 16);
  const attr = m.ptrTo<pthread_attr_t>(a);
  const t = m.ptrTo<void>(a + ATTR);
  // No thread starts without its stack size: tasks need the 8 MiB (a secondary thread's default
  // is 512 KiB on macOS), so a failed `pthread_attr_init` or `pthread_attr_setstacksize` is a
  // thread that could not start (the callers run without it). The attributes are destroyed only
  // once initialized; a failed destroy changes nothing for the thread started.
  // SAFETY: `a` is zeroed memory larger than a `pthread_attr_t` and a `pthread_t`; `start` is a
  // C function of the signature `pthread_create` calls; `arg` is passed through to it.
  let rc = unsafe { pthread_attr_init(attr) };
  if (rc === 0) {
    // SAFETY: as above; `attr` was initialized.
    unsafe {
      rc = pthread_attr_setstacksize(attr, STACK);
      if (rc === 0 && detach) {
        rc = pthread_attr_setdetachstate(attr, r.PTHREAD_CREATE_DETACHED);
      }
      if (rc === 0) {
        rc = pthread_create(t, attr, m.ptrTo<void>(start), m.ptrOrNull<void>(arg));
      }
      pthread_attr_destroy(attr);
    }
  }
  m.release(a, ATTR + 16);
  return rc === 0;
}
