// velt/lang/hooks (internal): the executor's parking on Linux (sched.velt, #2649): the worker
// sleeps in `futex(FUTEX_WAIT_PRIVATE)` on its park word, and a wake from another thread
// `FUTEX_WAKE_PRIVATE`s it. glibc has no futex function: `syscall` with the call's number, which
// differs per architecture (98 on arm64, 202 on x86-64).

import { velt_rt_os_arch } from "velt/os/rt";

const FUTEX_WAIT_PRIVATE: i64 = 128;
const FUTEX_WAKE_PRIVATE: i64 = 129;

/** The futex call's number, once known (0 before). */
const FUTEX = new Atomic<i64>(0);

declare c("c") function syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64): i64;

function futexNumber(): i64 {
  let n = FUTEX.load("relaxed");
  if (n === 0) {
    n = velt_rt_os_arch() === "arm64" ? 98 : 202;
    FUTEX.store(n, "relaxed");
  }
  return n;
}

/** Sleeps while the `u32` at `word` is `expected` (it may return early: the caller checks). */
export function parkWait(word: usize, expected: u32): void {
  const n = futexNumber();
  // SAFETY: `word` is the executor's park word, which lives as long as the process; no timeout.
  unsafe {
    syscall(n, word as i64, FUTEX_WAIT_PRIVATE, expected as i64, 0, 0, 0);
  }
}

/** Wakes the thread sleeping on the `u32` at `word`, if any. */
export function parkWake(word: usize): void {
  const n = futexNumber();
  // SAFETY: as `parkWait`.
  unsafe {
    syscall(n, word as i64, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0);
  }
}
