// velt/lang/hooks (internal): the test of prebuilt hook modules (velt_common
// `std_hooks/prebuilt.rs`): two hooks that take and return only numbers and strings, with an
// `u8[]` inside, whose layout a program's other code decides. No std code calls them; veltc's
// test `prebuilt_hooks.rs` does, by role, from a std of its own. Loaded only on demand
// (`ON_DEMAND_MODULES`).

import { arrayWithCapacity, strByteAt } from "velt/lang/intrinsics";

/** The first `digits` digits of `x`'s whole part (`|x|` below 2^53), from an `u8[]`. */
export function probeText(x: f64, digits: i64): string {
  let n = (x < 0 ? -x : x) as u64;
  const reversed: u8[] = arrayWithCapacity(20);
  while (n >= 10) {
    reversed.push((48 + n % 10) as u8);
    n = n / 10;
  }
  reversed.push((48 + n) as u8);
  let text = x < 0 ? "-" : "";
  let i = reversed.length;
  let left = digits;
  while (i > 0 && left > 0) {
    i--;
    left--;
    text += String.fromCharCode(reversed[i]);
  }
  return text;
}

/** The decimal digits of `s` from byte `start` to `end` (other bytes skipped), as a number. */
export function probeValue(s: string, start: usize, end: usize): f64 {
  const digits: u8[] = [];
  for (let i = start; i < end; i++) {
    const c = strByteAt(s, i as u64);
    if (c >= 48 && c <= 57) {
      digits.push(c - 48);
    }
  }
  let value: f64 = 0;
  for (const d of digits) {
    value = value * 10 + d;
  }
  return value;
}
