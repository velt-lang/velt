// velt/lang/hooks (tests): the ephemeron rule of the weak core (weak_trial.velt): an entry whose
// value holds its key strongly (`raw -> proxy`) is freed with its key and value once nothing
// outside refers to either, in whatever order the outside references go; on hand-built objects
// (weak_test_objects.velt), run by `velt test std/`.
import { describe, expect, it } from "velt/test";
import { weakMapLen } from "velt/lang/hooks/weak";
import { LIMIT } from "velt/lang/hooks/weak_graph";
import {
  count,
  finish,
  get,
  live,
  newObj,
  objMap,
  orders,
  plain,
  proxyOf,
  release,
  retain,
  set,
  setField,
} from "velt/lang/hooks/weak_test_objects";

/** Releases what `build` made in each order; whether everything was freed every time. */
function inEveryOrder(n: usize, build: (m: u32) => usize[]): bool {
  for (const order of orders(n)) {
    const before = live();
    const m = objMap();
    const refs = build(m);
    for (const i of order) {
      release(refs[i as number]);
    }
    if (weakMapLen(m) !== 0 || !finish([m]) || live() !== before) {
      return false;
    }
  }
  return true;
}

describe("the ephemeron rule", () => {
  it("frees a raw object and its proxy", () => {
    expect(inEveryOrder(2, (m) => {
      const raw = plain();
      const p = proxyOf(m, raw, 0);
      return [raw, p];
    })).toBe(true);
  });

  it("keeps the proxy while its key lives", () => {
    const m = objMap();
    const raw = plain();
    const p = proxyOf(m, raw, 0);
    const before = live();
    release(p);
    expect(live()).toBe(before); // the proxy lives while its key does
    const again = proxyOf(m, raw, 0);
    expect(again).toBe(p); // signal(raw) === signal(raw)
    release(again);
    release(raw);
    expect(live()).toBe(before - 2);
    expect(finish([m])).toBe(true);
  });

  it("keeps the key while its value lives", () => {
    const m = objMap();
    const raw = plain();
    const p = proxyOf(m, raw, 0);
    const before = live();
    release(raw);
    expect(live()).toBe(before);
    expect(get(m, raw)).toBe(p); // the entry stays while its key is reachable
    release(p);
    release(p);
    expect(live()).toBe(before - 2);
    expect(finish([m])).toBe(true);
  });

  it("frees a chain of entries", () => {
    // A -> B (B holds A), B -> C (C holds B): the outside may hold any of them.
    expect(inEveryOrder(3, (m) => {
      const a = plain();
      const b = newObj(retain(a), 0, 0);
      set(m, a, retain(b));
      const c = newObj(retain(b), 0, 0);
      set(m, b, retain(c));
      return [a, b, c];
    })).toBe(true);
  });

  it("keeps a whole chain while its end is held", () => {
    const m = objMap();
    const a = plain();
    const b = newObj(retain(a), 0, 0);
    set(m, a, retain(b));
    const c = newObj(retain(b), 0, 0);
    set(m, b, retain(c));
    release(a);
    release(b);
    expect(weakMapLen(m)).toBe(2);
    expect(get(m, a)).toBe(b);
    release(b);
    release(c);
    expect(weakMapLen(m)).toBe(0);
    expect(finish([m])).toBe(true);
  });

  it("frees nested reactive objects", () => {
    // raw1.child = raw2, and both have proxies in the same cache.
    expect(inEveryOrder(4, (m) => {
      const raw2 = plain();
      const raw1 = newObj(retain(raw2), 0, 0);
      const p1 = proxyOf(m, raw1, 0);
      const p2 = proxyOf(m, raw2, 0);
      return [raw1, raw2, p1, p2];
    })).toBe(true);
  });

  it("frees a handler that captures the target", () => {
    // proxy -> handler -> raw: the handler is on a path back to the key.
    expect(inEveryOrder(3, (m) => {
      const raw = plain();
      const handler = newObj(retain(raw), 0, 0);
      const p = proxyOf(m, raw, retain(handler));
      return [raw, handler, p];
    })).toBe(true);
  });

  it("leaves a handler shared outside the cycles alone", () => {
    const m = objMap();
    const handler = plain();
    for (let i = 0; i < 3; i++) {
      const raw = plain();
      const p = proxyOf(m, raw, retain(handler));
      release(raw);
      release(p);
    }
    expect(weakMapLen(m)).toBe(0);
    expect(count(handler)).toBe(1);
    release(handler);
    expect(finish([m])).toBe(true);
  });

  it("leaves the strong cycle of a key that holds its proxy", () => {
    // raw.self = proxy(raw): the entry goes once nothing outside refers to either, but raw and
    // the proxy still hold each other strongly: an ordinary strong cycle, until one side is
    // `weak` (#11).
    for (const order of orders(2)) {
      const m = objMap();
      const raw = plain();
      const p = proxyOf(m, raw, 0);
      setField(raw, 0, retain(p));
      const before = live();
      const refs = [raw, p];
      for (const i of order) {
        release(refs[i as number]);
      }
      expect(weakMapLen(m)).toBe(0);
      expect(live()).toBe(before); // the strong cycle remains
      setField(raw, 0, 0); // what `weak` would do
      expect(live()).toBe(before - 2);
      expect(finish([m])).toBe(true);
    }
  });

  it("frees a key mapped to itself", () => {
    const m = objMap();
    const k = plain();
    set(m, k, retain(k));
    release(k);
    expect(weakMapLen(m)).toBe(0);
    expect(finish([m])).toBe(true);
  });

  it("frees 10,000 entries", () => {
    const before = live();
    const m = objMap();
    const handler = plain();
    const raws: usize[] = [];
    const proxies: usize[] = [];
    for (let i = 0; i < 10_000; i++) {
      const raw = plain();
      raws.push(raw);
      proxies.push(proxyOf(m, raw, retain(handler)));
    }
    expect(weakMapLen(m)).toBe(10_000);
    for (let i = 0; i < 10_000; i++) {
      release(i % 2 === 0 ? raws[i] : proxies[i]);
      release(i % 2 === 0 ? proxies[i] : raws[i]);
    }
    expect(weakMapLen(m)).toBe(0);
    release(handler);
    expect(finish([m])).toBe(true);
    expect(live()).toBe(before);
  });

  it("keeps a pair whose value graph is past the limit", () => {
    // The documented gap: an insert that cannot see the value's whole graph records no cycle,
    // so the pair leaks (and is never freed early) until the entry is deleted.
    const m = objMap();
    const raw = plain();
    let tail = retain(raw);
    for (let i: usize = 0; i < LIMIT; i++) {
      tail = newObj(tail, 0, 0);
    }
    const p = newObj(tail, 0, 0);
    set(m, raw, retain(p));
    const before = live();
    release(raw);
    release(p);
    expect(live()).toBe(before); // kept: a leak, not a use-after-free
    expect(finish([m])).toBe(true);
  });

  it("finds a path added after the insert at the next trial", () => {
    // The proxy gains a second reference to its key after the insert. The release of the proxy
    // runs a trial (the key is still held outside), which records the key's new level.
    expect(inEveryOrder(2, (m) => {
      const raw = plain();
      const p = proxyOf(m, raw, 0);
      setField(p, 2, retain(raw));
      return [raw, p];
    })).toBe(true);
  });

  it("delays the free of a path added after the last trial", () => {
    // The gap: references to the key that a value gains after the last trial through it raise
    // the key's count above what the table knows, so dropping the outside reference runs no
    // trial and the pair is kept (a leak, never a use-after-free). It is freed once the extra
    // reference goes (that release runs the trial), or with the entry or the map.
    const m = objMap();
    const raw = plain();
    release(proxyOf(m, raw, 0));
    const p = get(m, raw);
    release(p); // the entry keeps it
    setField(p, 2, retain(raw));
    const before = live();
    release(raw);
    expect(live()).toBe(before); // kept while the extra path exists
    setField(p, 2, 0);
    expect(live()).toBe(before - 2);
    expect(finish([m])).toBe(true);
  });
});
