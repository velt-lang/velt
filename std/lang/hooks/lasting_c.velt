// velt/lang/hooks (internal): blocks as long-lived as a thread (mem_raw.velt `lastingZeroed`) and
// module state blocks (module_blocks.velt `blockZeroed`), from the C library, so outside the
// runtime's block counts, and whether the debug runtime's block counters are on, read from its
// environment: the `default` variant of `#mem-lasting` (std/imports.velt), every target with a C
// library's.

import { Ptr } from "velt/ffi";
import { addressLoad } from "velt/lang/intrinsics";

declare c("c") function calloc$sched(n: usize, size: usize): Ptr<u8> | null;
declare c("c") function free$sched(p: Ptr<u8> | null): void;

/**
 * `n` bytes set to 0, aligned to 16, from the C library: for a block that lives as long as the
 * worker (the executor, its I/O block, reactor and handle table), freed with `lastingRelease`.
 */
export function lastingZeroed(n: usize): usize {
  // SAFETY: calloc has no precondition; its result is checked.
  const p = Ptr.addressOf(unsafe { calloc$sched(1, n) });
  if (p === 0) {
    panic("out of memory");
  }
  return p;
}

/** Frees what `lastingZeroed` gave. */
export function lastingRelease(p: usize): void {
  // SAFETY: `p` came from calloc and is not used after.
  unsafe {
    free$sched(Ptr.orNull<u8>(p));
  }
}

// As sched_mem.velt declares them: one C symbol has one signature in a program.
declare c("c") function calloc$blocks(n: usize, size: usize): Ptr<u8> | null;
declare c("c") function free$blocks(p: Ptr<u8> | null): void;
// As std/process/env_posix.velt declares it.
declare c("c") function getenv$blocks(name: readonly u8[]): Ptr<u8> | null;

/** `n` bytes set to 0, aligned to 16; 0 when there is no memory. */
export function blockZeroed(n: usize): usize {
  // SAFETY: calloc has no precondition.
  return Ptr.addressOf(unsafe { calloc$blocks(1, n) });
}

/** Frees what `blockZeroed` gave. */
export function blockFree(p: usize): void {
  // SAFETY: `p` came from calloc and is not used after. `Ptr.orNull`, as `free` takes NULL:
  // `Ptr.at` stops on 0, so this would report its callers' locations (#3094).
  unsafe {
    free$blocks(Ptr.orNull<u8>(p));
  }
}

/**
 * Is `VELT_RC_STATS` exactly "1"? Read from the C library and not through velt/process, whose
 * lock around the environment is state a program shares (module_blocks.velt `counting`).
 */
export function statsAsked(): bool {
  // "VELT_RC_STATS" and a NUL.
  const name: u8[] = [86, 69, 76, 84, 95, 82, 67, 95, 83, 84, 65, 84, 83, 0];
  // SAFETY: `name` is NUL-terminated and alive during the call.
  const p = unsafe { getenv$blocks(name) };
  if (p === null) {
    return false;
  }
  const at = Ptr.addressOf(p);
  // "1" exactly.
  // SAFETY: a NUL-terminated text of the environment's, at least its NUL there.
  return unsafe { addressLoad<u8>(at) === 49 && addressLoad<u8>(at + 1) === 0 };
}
