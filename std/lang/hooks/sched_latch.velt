// velt/lang/hooks (internal): one-shot latches in the executor in Velt (sched.velt, #2649):
// `velt_rt_latch_new` / `_free` / `_open` / `_wait`'s jobs, the waking half of `new Promise`
// (std/lang/promise/settle.velt keeps the settled value). Opening queues a waiter of the task
// being polled in its microtask queue at once, with credit (sched_micro.velt), as Node queues a
// promise's reactions inside `resolve`; other waiters are woken.
//
// A latch: its reference count (the handle, each wait), whether it is open, and its waits (a
// list linked through them). A wait is a heap future (rt_abi_async.md §1): its header, then its
// latch, its waiter's waker (0 when none), its ticket once queued at the opening, and its link.
// Workers (#2649 step 3): the latch's reference count is atomic, and with more than one thread at
// the executor its state (open, the waits, a wait's waker and ticket) is guarded by a lock word
// of its own, taken for a few stores (a promise settled on one worker wakes its waiter on
// another; sched_lock.velt says when); wakes happen after the lock is given back.

import { inline, noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as lk from "./sched_lock";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

const L_REFS: usize = 0;
const L_OPEN: usize = 8;
const L_WAITS: usize = 16;
const L_LOCK: usize = 24;
const L_SIZE: usize = 32;

const W_LATCH: usize = 16;
const W_WAKER: usize = 24;
const W_TICKET: usize = 32;
const W_NEXT: usize = 40;
/** A wait that is not in its latch's list. */
const W_SIZE: usize = 48;

/** A closed latch, its handle's reference held. */
export function latchNew(): u64 {
  const l = m.alloc(L_SIZE);
  m.st(l + L_REFS, 1);
  m.st(l + L_OPEN, 0);
  m.st(l + L_WAITS, 0);
  m.st(l + L_LOCK, 0);
  return l as u64;
}

/** Takes latch `a`'s lock when other threads may reach it: the operation's kind (sched_lock). */
@inline
function lock(a: usize): u32 {
  const k = lk.kind();
  if ((k & lk.LK_ON) !== 0) {
    lk.take(a + L_LOCK);
  }
  return k;
}

/** Gives latch `a`'s lock back (`k`: `lock`'s result). */
@inline
function unlock(a: usize, k: u32): void {
  if ((k & lk.LK_ON) !== 0) {
    m.store32(a + L_LOCK, 0);
  } else {
    lk.done(k);
  }
}

/** Gives a reference to latch `l` back: the last frees it. */
export function latchFree(l: u64): void {
  const a = l as usize;
  if (lk.mode() === lk.LK_NONE) {
    // One thread at the executor: a plain count.
    const n = m.ld(a + L_REFS) - 1;
    m.st(a + L_REFS, n);
    if (n === 0) {
      m.release(a, L_SIZE);
    }
    return;
  }
  if (m.dec(a + L_REFS) === 1) {
    m.release(a, L_SIZE);
  }
}

/** A wait of latch `l`, with header entries `poll` and `drop`. */
export function latchWait(l: u64, poll: usize, drop: usize): usize {
  const a = l as usize;
  if (lk.mode() === lk.LK_NONE) {
    m.st(a + L_REFS, m.ld(a + L_REFS) + 1);
  } else {
    m.inc(a + L_REFS);
  }
  const w = m.alloc(W_SIZE);
  m.st(w, poll);
  m.st(w + 8, drop);
  m.st(w + W_LATCH, a);
  m.st(w + W_WAKER, 0);
  m.st(w + W_TICKET, 0);
  m.st(w + W_NEXT, 1);
  return w;
}

/** Opens latch `l` (once): each waiter queued on the task being polled, or woken. */
export function latchOpen(l: u64): void {
  const a = l as usize;
  const lkind = lock(a);
  if (m.ld(a + L_OPEN) !== 0) {
    unlock(a, lkind);
    return;
  }
  m.st(a + L_OPEN, 1);
  const e = t.here();
  const current = e === 0 ? 0 : m.ld(e + t.E_CURRENT);
  let w = m.ld(a + L_WAITS);
  m.st(a + L_WAITS, 0);
  // The wakers of waiters of other tasks, woken once the lock is given back (the first in a
  // word, any more in a raw buffer made on demand: most latches have one waiter, and an array
  // made at every opening cost an allocation each).
  const shared = (lkind & lk.LK_ON) !== 0;
  let first: usize = 0;
  let more: usize = 0;
  let n: usize = 0;
  let cap: usize = 0;
  while (w !== 0) {
    const next = m.ld(w + W_NEXT);
    m.st(w + W_NEXT, 1);
    const k = m.ld(w + W_WAKER);
    m.st(w + W_WAKER, 0);
    if (k !== 0) {
      if (current !== 0 && wk.taskOf(k) === current) {
        m.st(w + W_TICKET, micro.enqueue(current, k, true) as usize);
      } else if (!shared) {
        m.wakeOwned(k);
      } else if (first === 0) {
        first = k;
      } else {
        if (n === cap) {
          cap = cap === 0 ? 4 : 2 * cap;
          const grown = m.alloc(8 * cap);
          if (more !== 0) {
            m.copy(grown, more, 8 * n);
            m.release(more, 8 * n);
          }
          more = grown;
        }
        m.st(more + 8 * n, k);
        n++;
      }
    }
    w = next;
  }
  unlock(a, lkind);
  if (first !== 0) {
    wakeAfter(first, more, n, cap);
  }
}

/**
 * Wakes `first` and the `n` wakers in raw buffer `more` (room for `cap`, freed), after a locked
 * opening.
 */
@noInline
function wakeAfter(first: usize, more: usize, n: usize, cap: usize): void {
  m.wakeOwned(first);
  for (let i: usize = 0; i < n; i++) {
    m.wakeOwned(m.ld(more + 8 * i));
  }
  if (more !== 0) {
    m.release(more, 8 * cap);
  }
}

/** A wait's poll: ready once the latch is open (and its queued step reached). */
export function waitPoll(w: usize, cx: usize): u32 {
  const a = m.ld(w + W_LATCH);
  const waker = m.ld(cx + 8);
  const lkind = lock(a);
  if (m.ld(a + L_OPEN) !== 0) {
    const ticket = m.ld(w + W_TICKET) as u64;
    unlock(a, lkind);
    if (ticket === 0) {
      return 1;
    }
    const k = t.exec() === 0 ? 0 : wk.taskOf(waker);
    if (k === 0 || micro.reached(k, ticket, waker)) {
      m.st(w + W_TICKET, 0);
      return 1;
    }
    return 0;
  }
  const old = m.ld(w + W_WAKER);
  if (old !== waker) {
    m.st(w + W_WAKER, m.wakerClone(waker));
    if (old !== 0) {
      m.wakerDrop(old);
    }
  }
  if (m.ld(w + W_NEXT) === 1) {
    m.st(w + W_NEXT, m.ld(a + L_WAITS));
    m.st(a + L_WAITS, w);
  }
  unlock(a, lkind);
  return 0;
}

/** A wait's drop: out of its latch's list, its waker and its reference to the latch given back. */
export function waitDrop(w: usize): void {
  const a = m.ld(w + W_LATCH);
  const lkind = lock(a);
  if (m.ld(w + W_NEXT) !== 1) {
    let at = a + L_WAITS;
    while (m.ld(at) !== 0 && m.ld(at) !== w) {
      at = m.ld(at) + W_NEXT;
    }
    if (m.ld(at) === w) {
      m.st(at, m.ld(w + W_NEXT));
    }
  }
  const k = m.ld(w + W_WAKER);
  m.st(w + W_WAKER, 0);
  unlock(a, lkind);
  if (k !== 0) {
    m.wakerDrop(k);
  }
  latchFree(a as u64);
  m.release(w, W_SIZE);
}
