// velt/lang/hooks (internal): a task's turns that come one at a time in its poll under the
// executor in Velt (sched_run.velt `runWoken`): its due sleeps, in timer order (sched_sleep.velt),
// then its yields, in the order they were made (sched_yield.velt). Each resumes what waits for it,
// then, before the next, the task's microtasks run, the promises they woke and its root if it
// woke, as Node runs the microtasks between two timers' callbacks and between two immediates
// (#3241).

import { inline, noInline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as node from "./sched_node";
import * as wn from "./sched_node_woken";
import * as run from "./sched_run";
import * as sl from "./sched_sleep";
import * as t from "./sched_task";
import * as wk from "./sched_wake";
import * as ls from "./sched_yield_list";

/**
 * Fires task `k`'s due sleeps one at a time, in timer order: each resumes its waiter at once, and
 * the turn's reactions run before the next (`between`). A waiter that polls several sleeps
 * (`Promise.all`) finds only those fired so far ready. A waiter woken meanwhile (it yielded) is
 * not resumed again in this poll: that sleep and the ones after it fire in the next.
 */
export function fireDue(e: usize, k: usize): void {
  t.flags(k, 0, t.TIMED);
  // The root woke while it was polled here (or yielded earlier in this poll): it is not polled
  // again in this poll, which would take its wake.
  let woken = m.load32(k + t.T_STATE) === t.YIELDED;
  while (true) {
    const f = sl.firstDue(k);
    if (f === 0) {
      return;
    }
    const w0 = sl.waiter(f);
    const own = w0 !== k && node.ownNode(k, w0);
    if (w0 === k ? woken : own && node.queued(w0)) {
      t.flags(k, t.TIMED, 0);
      return;
    }
    woken = resume(e, k, sl.fire(k, f), false, own, woken, false);
  }
}

/**
 * Fires the yields task `k` made before this poll, one at a time in the order they were made:
 * each resumes what waits for it, and the turn's reactions run before the next (`between`).
 * Yields made meanwhile wait for the next poll, as Node's immediates set in its check phase. Its
 * sleeps due by now fire first, as Node's timers phase comes before its check phase: one that
 * came due while the task ran is on no due list yet (the worker moves due sleeps there when it
 * looks: sched_sleep.velt `expire`).
 */
export function fireYields(e: usize, k: usize): void {
  if (dueNow(e, k)) {
    fireDue(e, k);
  }
  let woken = m.load32(k + t.T_STATE) === t.YIELDED;
  let y = ls.take(k);
  while (y !== 0) {
    const nx = ls.next(y);
    let w = ls.fire(y);
    const lent = w === ls.ROOT;
    if (lent) {
      w = k;
    }
    if (w === k && nx === 0 && !t.has(k, t.POLLED)) {
      // The last turn, the root's: the poll polls the root next all the same (sched_run.velt
      // `runWoken`), then runs its microtasks.
      if (!lent) {
        wk.release(k);
      }
      return;
    }
    if (w !== 0) {
      if (w === k) {
        // A held record of the root's whose turn is next may go on in this poll (`ls.nextTurn`).
        ls.turnNext(k, nx);
      }
      woken = resume(e, k, w, lent, w !== k && node.ownNode(k, w), woken, true);
    }
    y = nx;
  }
}

/**
 * Task `k`'s sleeps pending on worker `e`'s timer block (which only `e` touches) whose deadline
 * passed join its due list, in timer order, and nobody is woken: they fire in this poll. Whether
 * any did.
 */
function dueNow(e: usize, k: usize): bool {
  const b = m.ld(e + t.E_TIMERS);
  if (b === 0 || !sl.pending(b)) {
    return false;
  }
  const now = sl.clock();
  let any = false;
  let f = m.ld(b + sl.TM_FIRST);
  while (f !== 0 && (m.ld(f + sl.S_DEADLINE) as u64) <= now) {
    const nx = m.ld(f + sl.S_NEXT);
    if (wk.taskOf(m.ld(f + sl.S_WAKER)) === k) {
      sl.unlinkPending(b, f);
      sl.pushDue(k, f);
      any = true;
    }
    f = nx;
  }
  return any;
}

/**
 * Resumes waiter `w` (a waker's clone it takes over, or `k` with no reference: `lent`) of a turn
 * of task `k`: its root, its own started promise (`own`), or anything else, woken. Then
 * `between`. Whether the root woke (from `woken` on). `yieldTurn`: a yield's turn (`fireYields`),
 * whose root is polled even when it yielded in this poll (#3687): each of its awaited yields
 * then holds a record of its own, so only the one whose turn this is goes on.
 */
function resume(
  e: usize,
  k: usize,
  w: usize,
  lent: bool,
  own: bool,
  woken: bool,
  yieldTurn: bool,
): bool {
  if (w === k) {
    // The turn's reference first (the executor's keeps `k`): an uncaught error in the poll ends
    // the program, which gives back the references the executor holds (sched_exit.velt).
    if (!lent) {
      wk.release(k);
    }
    if (!yieldTurn && m.load32(k + t.T_STATE) === t.YIELDED) {
      // It yielded in this poll (in a sleep's turn, behind yields still on the list, whose turn
      // this is): polled again now, it would stay suspended and spend the wake. Its next poll
      // resumes it (`YIELDED` queues the task again).
      return true;
    }
    run.pollRootAgain(e, k);
    if (yieldTurn) {
      ls.turnOver(k);
    }
    return between(e, k, m.load32(k + t.T_STATE) === t.NOTIFIED);
  }
  if (own) {
    node.run(k, w, false);
    node.release(w);
  } else {
    m.wakeOwned(w);
  }
  return between(e, k, woken);
}

/**
 * After a turn's waiter ran: the task's microtasks, then the started promises they woke (once:
 * those woken again wait for the next poll), then the root if it woke, unless it woke while it
 * was polled in this poll (`woken`), or it yielded in this poll (a microtask's entry may have
 * resumed it meanwhile): polled again, it would stay suspended and take its own wake. Whether the
 * root woke (from `woken` on). In line, a turn with no reaction is four loads; the reactions are
 * out of line.
 */
@inline("always")
function between(e: usize, k: usize, woken: bool): bool {
  if (reacts(k)) {
    run.drain(e, k);
  }
  // Mostly none: a load, not the exchange.
  if (m.load(k + t.T_WOKEN) !== 0) {
    runWoken(e, k);
  }
  const s = m.load32(k + t.T_STATE);
  if (s === t.YIELDED) {
    return true;
  }
  if (!woken && s === t.NOTIFIED && !t.has(k, t.ROOT_DONE)) {
    return rootWoke(e, k);
  }
  return woken;
}

/** Has task `k` microtasks to run or rejections to report (work for `run.drain`)? */
@inline("always")
function reacts(k: usize): bool {
  return micro.pending(k) || m.ld(k + t.T_UNHANDLED) !== 0;
}

/** The started promises of task `k` woken during a turn run, each followed by its microtasks. */
@noInline
function runWoken(e: usize, k: usize): void {
  let n = wn.takeWoken(k);
  while (n !== 0) {
    const nx = wn.nextWoken(n);
    node.run(k, n, true);
    node.release(n);
    run.drain(e, k);
    n = nx;
  }
}

/** Task `k`'s root, woken by a turn's reactions, goes on before the next: whether it woke again. */
@noInline
function rootWoke(e: usize, k: usize): bool {
  m.store32(k + t.T_STATE, t.RUNNING);
  run.pollRootAgain(e, k);
  if (reacts(k)) {
    run.drain(e, k);
  }
  return m.load32(k + t.T_STATE) === t.NOTIFIED;
}
