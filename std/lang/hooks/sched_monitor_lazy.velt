// velt/lang/hooks (internal): the stall monitor's watch over a lazy worker 0 (sched_monitor.velt,
// #2649 step 3): the only worker, which the monitor may rescue (`VELT_THREADS=1`, the rescue on),
// keeps its queue to itself and locks nothing (sched_task.velt `E_LAZY`, sched_lock.velt) until
// the monitor finds one of its polls stalled; then the monitor makes its queue shared, turns the
// locks on and moves tasks to a spare while that poll runs.

import * as lk from "./sched_lock";
import * as m from "./sched_mem";
import * as mon from "./sched_monitor";
import * as q from "./sched_queue";
import * as r from "#reactor";
import * as rx from "./sched_relax";
import * as st from "./sched_stats";
import * as tq from "./sched_take";
import * as t from "./sched_task";

/**
 * A lazy worker 0's poll that spawned more than `FAN_OUT` tasks and has nothing else waiting
 * behind it (`spawn` in a loop, then `Promise.all` of them: the tasks wait for it by design) is
 * stalled after `FAN_OUT_TICKS` ticks, not `STALL_TICKS`. The runtime's arrays (an array growing
 * past a power of two, the join of a million handles) took up to 25 ms of such a poll in
 * spawn_many, and a spare taking half of the tasks made the run 2.5 times as long; with one
 * worker the user asked for one thread. A few tasks spawned behind a poll that computes (what
 * it may wait for) move after `STALL_TICKS`. Of a poll's spawns the monitor may move only the
 * first `t.PEND_STACKED` (sched_task.velt `E_PLIST`): the poll links the rest without atomics, so
 * a poll that spawns more and then waits without a pause for all of them never ends, as on one
 * worker without the monitor (taking that list from a running poll would cost a fence per spawn).
 */
const FAN_OUT: usize = 64;
const FAN_OUT_TICKS: usize = 50;

/**
 * The tick `now` of a lazy worker 0 (`g`, sched_task.velt `E_LAZY`), which tells the monitor
 * nothing: stalled when one poll has run for `mon.STALL_TICKS` ticks (the same task running, its I/O
 * tick, looks and spawns unchanged). Then its queue becomes shared (`E_MODE`, which the worker takes on
 * once that poll returns: sched_loop.velt `alone`) and, while the poll runs, the monitor moves
 * its inbox and half of its queue to a spare, as it does for any stalled worker, and what the
 * poll queued. During a poll a lazy worker leaves its queues alone (what it queues goes on
 * stacks the monitor may take: sched_task.velt `pend`), and
 * its pop before the poll was published with the poll's start (`E_CURRENT`, a release). That
 * the poll still runs is read after the mode is stored, both ordered: the worker's look after
 * the poll, ordered after the poll's end (its task's state), then sees the mode, so it never
 * pops without the lock while tasks are taken.
 *
 * Whether the monitor watches closely (its next tick in `TICK`, not `LAZY_NAP`: sched_monitor.velt
 * `monitorMain`): the same poll still runs with work waiting behind it, a rescue may come.
 */
export function lazyDuties(g: usize, now: usize): bool {
  const cur = m.load(g + t.E_CURRENT);
  // A poll that keeps spawning (its spawn count, `E_RLEN`, grows) is busy, not stalled.
  const tick =
    m.loadRelaxed(g + t.E_TICK) |
    (m.loadRelaxed(g + t.E_LOOKS) << 8) |
    (m.loadRelaxed(g + t.E_RLEN) << 32);
  if (
    cur === 0 ||
    m.load32(g + t.E_PARK) === 1 ||
    cur !== m.ld(g + t.E_SEEN_CUR) ||
    tick !== m.ld(g + t.E_SEEN_TICK)
  ) {
    m.st(g + t.E_SEEN_CUR, cur);
    m.st(g + t.E_SEEN_TICK, tick);
    m.st(g + t.E_SEEN_AT, now);
    m.st(g + t.E_SEEN_CPU, 0);
    return false;
  }
  const seenAt = m.ld(g + t.E_SEEN_AT);
  if (m.ld(g + t.E_SEEN_CPU) === 0) {
    // The poll has run for a tick: its thread's CPU time from here (`computed`).
    m.st(g + t.E_SEEN_CPU, cpuOf(g) | 1);
  }
  if (now < seenAt + mon.STALL_TICKS) {
    return true;
  }
  const fanOut = fanOutOnly(g);
  if (fanOut && now < seenAt + FAN_OUT_TICKS) {
    return true;
  }
  if (nothingWaits(g)) {
    // Nothing to move: the poll may run on, the worker stays lazy.
    return false;
  }
  if (!computed(g, fanOut ? FAN_OUT_TICKS : mon.STALL_TICKS)) {
    // The OS kept the thread off its core: not stalled (a spare would wait for a core too).
    return true;
  }
  if (m.load(g + t.E_LAZY) === t.LAZY_WATCH) {
    m.swap(g + t.E_LAZY, t.LAZY_TAKING);
    m.store32(g + t.E_MODE, t.M_SHARED | t.M_MONITOR);
    // Latches and join slots locked from now on, before a task reaches a spare, which a
    // retirement may hold back (sched_relax.velt).
    lk.locksOn();
    rx.unretireAll(g);
  }
  if (m.load(g + t.E_CURRENT) === cur) {
    lazyRescue(g, now);
  }
  return true;
}

/** Worker `w`'s thread's CPU time (nanoseconds; 0: no clock). */
function cpuOf(w: usize): usize {
  const c = m.ld(w + t.E_CPU);
  return c === 0 ? 0 : r.threadCpu(c as u64) as usize;
}

/**
 * Has lazy worker 0's (`g`) poll computed for `ticks` ticks less one, since the monitor's reading
 * a tick into it (`E_SEEN_CPU`), by its thread's CPU time (three quarters of each tick: the
 * monitor's own ticks come late)? True without a clock.
 */
function computed(g: usize, ticks: usize): bool {
  const c = m.ld(g + t.E_CPU);
  if (c === 0) {
    return true;
  }
  return cpuOf(g) - m.ld(g + t.E_SEEN_CPU) >= (ticks - 1) * mon.STALL_CPU;
}

/**
 * Does nothing wait behind lazy worker 0's poll (`g`) that a spare could run: its inbox, queues,
 * and the stacks of what the poll woke (past its first, which stays) and spawned are empty?
 */
function nothingWaits(g: usize): bool {
  return (
    (
      m.load(g + t.E_INBOX) |
      m.loadRelaxed(g + t.E_IHEAD) |
      m.loadRelaxed(g + t.E_HEAD) |
      m.load(g + t.E_PIO) |
      m.load(g + t.E_PREST)
    ) ===
    0
  );
}

/**
 * Is all that waits behind lazy worker 0's poll (`g`) a fan-out of its own: more than `FAN_OUT`
 * tasks it spawned (its count, `E_PCOUNT`), and nothing else in its inbox or queues, nor tasks it
 * woke (`t.PANY_WOKE`; the first, which stays, aside)? The worker leaves its queues alone during the poll.
 */
function fanOutOnly(g: usize): bool {
  if (
    (
      m.load(g + t.E_INBOX) |
      m.loadRelaxed(g + t.E_IHEAD) |
      m.loadRelaxed(g + t.E_HEAD) |
      m.load(g + t.E_PIO)
    ) !==
    0
  ) {
    return false;
  }
  return (
    (m.loadRelaxed(g + t.E_PANY) & t.PANY_WOKE) === 0 && m.loadRelaxed(g + t.E_PCOUNT) > FAN_OUT
  );
}

/**
 * Moves the inbox, half of the queue and half of what the poll spawned of lazy worker 0 (`g`),
 * stalled in a poll at tick `now` (`lazyDuties`), to a sleeping or new spare worker; pinned and
 * anchored tasks stay.
 */
function lazyRescue(g: usize, now: usize): void {
  if (!q.tryLock(g)) {
    return;
  }
  // In no queue until they reach one again: counted, so the end of the program waits for them.
  m.inc(g + t.E_MOVING);
  let k = tq.takeLazy(g, t.E_IHEAD, t.E_ITAIL, 0);
  k = tq.takeLazy(g, t.E_HEAD, t.E_TAIL, k);
  m.store32(g + t.E_QLOCK, 0);
  // Oldest first: what woke from other threads, what the poll woke, the queues, what it spawned.
  k = q.reverse(k);
  k = before(q.reverse(m.takeStack(g + t.E_PIO)), k);
  k = before(q.reverse(m.takeStack(g + t.E_INBOX)), k);
  k = before(k, halfOfStack(g + t.E_PREST));
  if (m.load(g + t.E_LAZY) === 0) {
    // The worker took the shared mode on meanwhile (`adopt`) and may have joined its stack before
    // the newer half went back on it: those go to its inbox, which it reads in any mode. (It
    // clears `E_LAZY` before it takes the stack, both ordered with the push back above.)
    let late = q.reverse(m.takeStack(g + t.E_PREST));
    while (late !== 0) {
      const next = m.ld(late + t.T_NEXT);
      mon.sendBack(g, late);
      late = next;
    }
  }
  if (k === 0) {
    m.dec(g + t.E_MOVING);
    return;
  }
  let helper = mon.helperFor(g, g, now);
  if (helper === 0) {
    helper = mon.startSpare(g, now);
  }
  if (helper !== 0) {
    st.rescued();
  }
  while (k !== 0) {
    const next = m.ld(k + t.T_NEXT);
    if (helper !== 0 && t.movable(k)) {
      mon.handOver(helper, k);
    } else {
      mon.sendBack(g, k);
    }
    k = next;
  }
  m.dec(g + t.E_MOVING);
}

/**
 * The older half (rounded up) of the stack at `head` (what a lazy worker 0's poll spawned), oldest
 * first; the newer half goes back on the stack, under what the poll pushed meanwhile.
 */
function halfOfStack(head: usize): usize {
  const all = q.reverse(m.takeStack(head));
  let n: usize = 0;
  let k = all;
  while (k !== 0) {
    n++;
    k = m.ld(k + t.T_NEXT);
  }
  if (n < 2) {
    return all;
  }
  let last = all;
  for (let i: usize = 1; i < (n + 1) / 2; i++) {
    last = m.ld(last + t.T_NEXT);
  }
  k = m.ld(last + t.T_NEXT);
  m.st(last + t.T_NEXT, 0);
  while (k !== 0) {
    const next = m.ld(k + t.T_NEXT);
    m.pushStack(head, k, t.T_NEXT);
    k = next;
  }
  return all;
}

/** Chain `a` followed by chain `b` (both linked through `T_NEXT`). */
function before(a: usize, b: usize): usize {
  if (a === 0) {
    return b;
  }
  let last = a;
  while (m.ld(last + t.T_NEXT) !== 0) {
    last = m.ld(last + t.T_NEXT);
  }
  m.st(last + t.T_NEXT, b);
  return a;
}
