// velt/lang/hooks (internal): waking a task of the executor in Velt (sched.velt, #2649): a task's
// C waker table, which C calls from any thread, and queueing a woken or spawned task on its home
// worker (its queues, a lazy worker 0's pending stacks, or its inbox from another thread); the
// layouts are sched_task.velt's.

import { export as cExport } from "velt/ffi";
import { inline, noInline } from "velt/lang/intrinsics";
import * as io from "./sched_io";
import * as m from "./sched_mem";
import * as q from "./sched_queue";
import * as tk from "./sched_task";

declare function velt_rt_flush(): void;
declare c("c") function velt_rt_latch_open$rt(l: u64): void;

@cExport("std_sched_waker_clone")
export function wakerClone(w: usize): usize {
  m.inc(w + tk.T_REFS);
  return w;
}

@cExport("std_sched_waker_wake")
export function wakerWake(w: usize): void {
  wake(w);
  release(w);
}

@cExport("std_sched_waker_wake_by_ref")
export function wakerWakeByRef(w: usize): void {
  wake(w);
}

@cExport("std_sched_waker_drop")
export function wakerDrop(w: usize): void {
  release(w);
}

/** Wakes task `t`: queued once if idle, polled again if running. */
export function wake(t: usize): void {
  let s = m.load32(t + tk.T_STATE);
  while (true) {
    if (s === tk.IDLE) {
      const was = m.cas32(t + tk.T_STATE, tk.IDLE, tk.SCHEDULED);
      if (was === tk.IDLE) {
        schedule(t);
        return;
      }
      s = was;
    } else if (s === tk.RUNNING) {
      const was = m.cas32(t + tk.T_STATE, tk.RUNNING, tk.NOTIFIED);
      if (was === tk.RUNNING) {
        return;
      }
      s = was;
    } else {
      return;
    }
  }
}

/** Gives back one reference to task `t`: the last frees it. */
export function release(t: usize): void {
  if (m.dec(t + tk.T_REFS) === 1) {
    m.release(t, m.ld(t + tk.T_BYTES));
  }
}

/**
 * Queues scheduled task `t` (woken), as the runtime's (velt_rt task/runtime/velt/worker.rs
 * `queue`): from its home worker's thread, as input during a reactor turn or timers, as output
 * when room to write woke it, else in the slot for the task to run next (woken by the task
 * running; with one thread at the queues, at the end of the second queue instead); from another worker's thread running a task, in that worker's slot (it runs there
 * next and keeps its home) unless it may not move; else on its home's inbox, waking the home.
 */
@inline
export function schedule(t: usize): void {
  const w = tk.here();
  if (w !== 0 && m.ld32(w + tk.E_SOLO) !== 0) {
    // The only thread at the executor (its home): input during a reactor turn, else the second queue.
    if (m.ld32(w + tk.E_DISPATCH) === tk.D_INPUT) {
      q.pushIo(w, t);
    } else {
      q.pushRest(w, t, 0);
    }
    return;
  }
  let h = m.ld(t + tk.T_HOME);
  if (w !== h && w !== 0 && m.load32Relaxed(w + tk.E_MODE) === 0) {
    // Woken on a lazy worker 0, homed on a spare that retired (sched_relax.velt): homed here.
    m.st(t + tk.T_HOME, w);
    h = w;
  }
  if (w === h) {
    const d = m.ld32(w + tk.E_DISPATCH);
    // Relaxed: the monitor changes it (sched_monitor_lazy.velt `lazyDuties`).
    const mode = m.load32Relaxed(w + tk.E_MODE);
    if (mode === 0 && m.ld(w + tk.E_LAZY) !== 0 && m.ld(w + tk.E_CURRENT) !== 0) {
      if (d === 0 && m.ld(w + tk.E_PANY) === 0) {
        // The poll's first wake, its own: queued at the look after the poll (`E_PWAKE`).
        m.st(w + tk.E_PWAKE, t);
        m.st(w + tk.E_PANY, tk.PANY_FIRST);
        return;
      }
      pend(w, t, d);
      return;
    }
    if (d === 0 && mode !== 0) {
      q.pushNext(w, t, mode);
      return;
    }
    q.lock(w, mode);
    if (d === tk.D_INPUT) {
      q.pushIo(w, t);
    } else {
      q.pushRest(w, t, mode);
    }
    q.unlock(w, mode);
    return;
  }
  if (
    w !== 0 &&
    m.ld(w + tk.E_CURRENT) !== 0 &&
    m.ld32(w + tk.E_DISPATCH) === 0 &&
    tk.movable(t) &&
    m.ld(tk.main() + tk.E_STAY) === 0
  ) {
    q.pushNext(w, t, m.load32Relaxed(w + tk.E_MODE));
    return;
  }
  toInbox(h, t);
}

/**
 * Queues task `t`, just spawned on this thread (`w`: its worker block, `tk.here()`): behind the
 * input on its home, or on its home's inbox.
 */
@inline
export function scheduleNew(w: usize, t: usize): void {
  if (w !== 0 && m.ld32(w + tk.E_SOLO) !== 0) {
    // The only thread at the executor: no lock, its spawns counted (sched_loop.velt `interval`).
    q.pushRest(w, t, 0);
    tk.bump(w + tk.E_RLEN, 1);
    return;
  }
  const h = m.ld(t + tk.T_HOME);
  if (w === h) {
    const mode = m.load32Relaxed(h + tk.E_MODE);
    if (mode === 0 && m.ld(h + tk.E_LAZY) !== 0 && m.ld(h + tk.E_CURRENT) !== 0) {
      // The poll's first `PEND_STACKED` spawns on `E_PREST` (`pendStacked`), the rest on the plain
      // list (sched_task.velt `E_PLIST`), in line.
      m.st(h + tk.E_PANY, m.ld(h + tk.E_PANY) | tk.PANY_MORE);
      const n = m.ld(h + tk.E_PCOUNT);
      m.st(h + tk.E_PCOUNT, n + 1);
      if (n >= tk.PEND_STACKED) {
        m.st(t + tk.T_NEXT, 0);
        const tail = m.ld(h + tk.E_PLIST_TAIL);
        if (tail === 0) {
          m.st(h + tk.E_PLIST, t);
        } else {
          m.st(tail + tk.T_NEXT, t);
        }
        m.st(h + tk.E_PLIST_TAIL, t);
      } else {
        pendStacked(h, t, n);
      }
      tk.bump(h + tk.E_RLEN, 1);
      return;
    }
    if (mode !== 0) {
      // A fresh task may start on another worker at once: what this thread printed first.
      publishPrinted(h);
    }
    q.lock(h, mode);
    q.pushRest(h, t, mode);
    q.unlock(h, mode);
    if (mode === 0) {
      // One worker's count of tasks spawned not yet run (sched_loop.velt `interval`).
      tk.bump(h + tk.E_RLEN, 1);
    }
    return;
  }
  toInbox(h, t);
}

/**
 * Queues task `t`, woken, on lazy worker 0 `w` during a poll (on `E_PIO` or `E_PREST`): `d` as
 * `schedule`'s. (Its spawns are queued by `scheduleNew`.)
 */
@noInline
function pend(w: usize, t: usize, d: u32): void {
  if (d === 0 && m.ld(w + tk.E_PWAKE) === 0) {
    m.st(w + tk.E_PWAKE, t);
    m.st(w + tk.E_PANY, m.ld(w + tk.E_PANY) | tk.PANY_FIRST);
    return;
  }
  // Woken past the first: not part of a fan-out (sched_monitor_lazy.velt `fanOutOnly`).
  m.st(w + tk.E_PANY, m.ld(w + tk.E_PANY) | tk.PANY_MORE | tk.PANY_WOKE);
  pendOn(w, t, d === tk.D_INPUT ? tk.E_PIO : tk.E_PREST);
}

/**
 * Pushes task `t`, spawned by lazy worker 0 `w`'s poll, its `n`th spawn (under `PEND_STACKED`),
 * on `E_PREST`, which the monitor may take.
 */
@noInline
function pendStacked(w: usize, t: usize, n: usize): void {
  if (n === 0) {
    // The first task this poll spawns may start on a spare (the monitor's rescue): what this
    // thread printed first (the runtime publishes at each spawn; here at each poll's first).
    publishPrinted(w);
  }
  pendOn(w, t, tk.E_PREST);
}

/** Pushes task `k` on the stack of lazy worker 0 `w` at offset `at` (`E_PIO` or `E_PREST`). */
function pendOn(w: usize, k: usize, at: usize): void {
  m.pushStack(w + at, k, tk.T_NEXT);
}

/** Queues task `t` on worker `e`'s second queue (the end of a poll that woke it, a root's start). */
export function push(e: usize, t: usize): void {
  const mode = m.load32Relaxed(e + tk.E_MODE);
  q.lock(e, mode);
  q.pushRest(e, t, mode);
  q.unlock(e, mode);
}

/**
 * Pushes task `t` on worker `h`'s inbox and wakes `h` if it sleeps (from another thread). From
 * another worker, what this thread printed is published first, so it comes before anything the
 * woken task prints (the runtime's output buffers are per thread).
 */
export function toInbox(h: usize, t: usize): void {
  const w = tk.here();
  if (w !== 0) {
    publishPrinted(w);
  }
  m.pushStack(h + tk.E_INBOX, t, tk.T_NEXT);
  unpark(h);
}

/**
 * Publishes what this thread printed into the runtime's shared buffer, ahead of what any other
 * thread prints from now on (the runtime's `publish_before_handoff`, reached through the opening
 * of a latch that is open already); worker `w` is this thread's.
 */
@inline
export function publish(w: usize): void {
  // SAFETY: the worker's latch handle, open, never freed.
  unsafe {
    velt_rt_latch_open$rt(m.ld(w + tk.E_LATCH) as u64);
  }
}

/**
 * What the poll that just ran on shared worker `w` printed (its microtasks too), published before
 * the poll's end can be seen by another thread: before Node's timer order takes the task for not
 * busy, its state lets another worker poll it, or its end wakes a joiner (sched_run.velt `run`).
 * A task woken on another worker runs there next (`schedule`), so a line printed before an
 * `await` would otherwise reach the shared buffer after what the task prints next there,
 * whenever this thread was held up between the two (#2971). A lazy worker 0 publishes nothing
 * per poll: its output reaches the others when it adopts the shared mode (sched_loop.velt
 * `adopt`), so a task the rescue moved meanwhile may print there first (#2977).
 */
@inline
export function publishPolled(w: usize): void {
  publishPrinted(w);
}

/**
 * `publish` at the points where work this thread made may run on another worker next: after a
 * poll whose task may resume elsewhere (sched_loop.velt `after`), a spawn, a wake sent to
 * another worker's inbox. Each goes through the runtime (a call, a check of its thread's
 * buffer and a swap on the latch).
 *
 * Hook point (#2786, for #2780): once every stdout write sets this thread's stdout mark
 * (#2780's `stdoutWritten` hook, lowered before each `console.log`, which sets `STDOUT_WRITTEN` in
 * process.velt), this tests the mark and publishes, clearing it, only when it is set.
 */
@inline
export function publishPrinted(w: usize): void {
  publish(w);
}

/** Writes out what this thread printed (stdout is buffered per thread by the runtime). */
@noInline
export function handOffOutput(): void {
  velt_rt_flush();
}

/** Wakes worker `w` if it sleeps in its reactor (its park word is up). */
export function unpark(w: usize): void {
  if (m.load32(w + tk.E_PARK) !== 1) {
    return;
  }
  // Counted before the wake, so a scan that reads the count after it sees the wake.
  m.incOrdered(w + tk.E_UNPARKS);
  if (m.cas32(w + tk.E_PARK, 1, 0) === 1) {
    // Woken is not stalled: the monitor counts from now.
    m.st(w + tk.E_PROGRESS, m.load(tk.main() + tk.E_TICKS));
    io.wake(m.ld(w + tk.E_IO));
  }
}

/** The task a waker header belongs to (a task, or a promise one drives); 0 for another table. */
@inline
export function taskOf(w: usize): usize {
  const e = tk.main();
  const vt = m.ld(w);
  if (vt === e + tk.E_VT) {
    return w;
  }
  if (vt === e + tk.E_NODE_VT) {
    return m.ld(w + 48);
  }
  return 0;
}
