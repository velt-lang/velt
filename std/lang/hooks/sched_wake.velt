// velt/lang/hooks (internal): waking a task of the executor in Velt (sched.velt, #2649): a task's
// C waker table, which C calls from any thread, and queueing a woken or spawned task on its home
// worker (its queues, a lazy worker 0's pending stacks, or its inbox from another thread); the
// layouts are sched_task.velt's.

import { export as cExport } from "velt/ffi";
import { inline, noInline } from "velt/lang/intrinsics";
import { clearStdoutWritten, stdoutWrittenSince } from "./process";
import * as io from "./sched_io";
import * as lk from "./sched_lock";
import * as m from "./sched_mem";
import * as nc from "./sched_node_catch";
import * as q from "./sched_queue";
import * as tk from "./sched_task";
import * as wa from "./sched_wake_away";
import * as wp from "./sched_wake_pause";
import * as yl from "./sched_yield_list";

declare function velt_rt_flush(): void;
declare c("c") function velt_rt_latch_open$rt(l: u64): void;

@cExport("std_sched_waker_clone")
export function wakerClone(w: usize): usize {
  m.inc(w + tk.T_REFS);
  return w;
}

@cExport("std_sched_waker_wake")
export function wakerWake(w: usize): void {
  if (COUNTING.load("relaxed") !== 0) {
    countedWake(w);
    return;
  }
  wakeGiving(w);
}

/** `wakerWake` with the block counters on: counted until the reference is back. */
@noInline
function countedWake(w: usize): void {
  WAKING.add(1);
  wakeGiving(w);
  WAKING.sub(1);
}

/**
 * Wakes task `w` and gives back the waker's reference. With the locks on (several workers) the
 * woken task may run and park on another thread before a reference given back after the wake
 * goes, and that park counts it, so nothing polls the task again once it goes (#3487): the wake
 * hands the reference to the task's next poll instead (sched_wake_away.velt `wakeAway`). With the
 * locks off (one worker) the window stays: a thread of the runtime's or the blocking pool wakes
 * worker 0's task, as before.
 */
@inline("always")
function wakeGiving(w: usize): void {
  if (lk.mode() === lk.LK_ON) {
    wa.wakeAway(w);
    return;
  }
  wake(w);
  release(w);
}

@cExport("std_sched_waker_wake_by_ref")
export function wakerWakeByRef(w: usize): void {
  wake(w);
}

@cExport("std_sched_waker_drop")
export function wakerDrop(w: usize): void {
  release(w);
}

/**
 * The wakes by value under way (`wakerWake`, sched_node_wake.velt `nodeWake`), from any thread:
 * a timer or I/O thread of the runtime's, or another worker. Such a wake gives its reference back
 * after it woke the task, which may run, finish and end the program meanwhile: worker 0 waits
 * for them at the end (`settleWakes`), or what they free counts as leaked (#2966). Only the
 * debug runtime's block counters (`VELT_RC_STATS=1`) see that, so only then are they counted
 * (`COUNTING`): a program without them pays one load per wake.
 */
const WAKING = new Atomic<u64>(0);

/** Are wakes counted (`countWakes`)? Set once, before any worker or waker exists. */
const COUNTING = new Atomic<u64>(0);

/** The executor starts with the block counters on (sched_workers.velt): wakes are counted. */
export function countWakes(): void {
  wp.read();
  COUNTING.store(1, "relaxed");
}

/** Are wakes counted? */
@inline("always")
export function counting(): bool {
  return COUNTING.load("relaxed") !== 0;
}

/** A counted wake by value starts (sched_node_wake.velt `nodeWake`). */
export function wakingStarts(): void {
  WAKING.add(1);
}

/** A counted wake by value gave its reference back. */
export function wakingEnds(): void {
  WAKING.sub(1);
}

/**
 * The program ends (sched.velt `schedFinish`): once the wakes by value under way gave their
 * references back. Each is a few steps with no wait; the core is given away meanwhile, so a
 * waking thread the OS took off its core gets to finish.
 */
export function settleWakes(): void {
  while (WAKING.load() !== 0) {
    m.yieldCore();
  }
}

/** Wakes task `t`: queued once if idle, polled again if running. */
export function wake(t: usize): void {
  let s = m.load32(t + tk.T_STATE);
  while (true) {
    if (s === tk.IDLE) {
      const was = m.cas32(t + tk.T_STATE, tk.IDLE, tk.SCHEDULED);
      if (was === tk.IDLE) {
        schedule(t);
        return;
      }
      s = was;
    } else if (s === tk.RUNNING) {
      const was = m.cas32(t + tk.T_STATE, tk.RUNNING, tk.NOTIFIED);
      if (was === tk.RUNNING) {
        return;
      }
      s = was;
    } else {
      return;
    }
  }
}

/**
 * Gives back one reference to task `t`: the last frees it, and the exception of a root that
 * panicked under a catch with it (sched_join.velt `rootPanicked`).
 */
export function release(t: usize): void {
  releaseHere(t);
}

/** `release`, in line where it is called: a task's end (sched_run.velt `finish`), once per task. */
@inline("always")
export function releaseHere(t: usize): void {
  if (m.dec(t + tk.T_REFS) === 1) {
    if ((m.load32(t + tk.T_JOIN_STATE) & tk.J_LOCK) !== 0) {
      // Another thread gives a reference back with a wake (sched_task_lost.velt
      // `releaseAway`): it touches the task until it gives the lock back.
      awaitUnlocked(t);
    }
    freed(t);
  }
}

/**
 * Frees task `t`, whose last reference the caller gave back by its own count (`release`'s end,
 * and sched_task_lost.velt `releaseAway`'s): its root's exception, its yield block, the task.
 */
@inline("always")
export function freed(t: usize): void {
  if ((m.ld32(t + tk.T_FLAGS) & nc.T_PANICKED) !== 0) {
    freePanicked(t);
  }
  if (yl.hasBlock(t)) {
    yl.freeBlock(t);
  }
  m.release(t, m.ld(t + tk.T_BYTES));
}

/** Waits until the join slot's lock of task `t`, about to be freed, is given back. */
@noInline
function awaitUnlocked(t: usize): void {
  while ((m.load32(t + tk.T_JOIN_STATE) & tk.J_LOCK) !== 0) {
    m.yieldCore();
  }
}

/** The exception of task `t`, whose root panicked: out of line, so `release` stays small. */
@noInline
function freePanicked(t: usize): void {
  nc.freePanic(m.ld(t + tk.T_POLL));
}

/**
 * Queues scheduled task `t` (woken), as the runtime's executor did (its worker.rs `queue`, ported
 * in #2706, deleted in #2649 D1): from its home worker's thread, as input during a reactor turn or timers, as output
 * when room to write woke it, else in the slot for the task to run next (woken by the task
 * running; with one thread at the queues, at the end of the second queue instead); from another worker's thread running a task, in that worker's slot (it runs there
 * next and keeps its home) unless it may not move; else on its home's inbox, waking the home.
 */
@inline("always")
export function schedule(t: usize): void {
  const w = tk.here();
  if (w !== 0 && m.ld32(w + tk.E_SOLO) !== 0) {
    // The only thread at the executor (its home): input during a reactor turn, else the second queue.
    if (m.ld32(w + tk.E_DISPATCH) === tk.D_INPUT) {
      q.pushIo(w, t);
    } else {
      q.pushRest(w, t, 0);
    }
    return;
  }
  let h = m.ld(t + tk.T_HOME);
  if (w !== h && w !== 0 && m.load32Relaxed(w + tk.E_MODE) === 0) {
    // Woken on a lazy worker 0, homed on a spare that retired (sched_relax.velt): homed here.
    m.st(t + tk.T_HOME, w);
    h = w;
  }
  if (w === h) {
    const d = m.ld32(w + tk.E_DISPATCH);
    // Relaxed: the monitor changes it (sched_monitor_lazy.velt `lazyDuties`).
    const mode = m.load32Relaxed(w + tk.E_MODE);
    if (mode === 0 && m.ld(w + tk.E_LAZY) !== 0 && m.ld(w + tk.E_CURRENT) !== 0) {
      if (d === 0 && m.ld(w + tk.E_PANY) === 0) {
        // The poll's first wake, its own: queued at the look after the poll (`E_PWAKE`).
        m.st(w + tk.E_PWAKE, t);
        m.st(w + tk.E_PANY, tk.PANY_FIRST);
        return;
      }
      pend(w, t, d);
      return;
    }
    if (d === 0 && mode !== 0) {
      q.pushNext(w, t, mode);
      return;
    }
    q.lock(w, mode);
    if (d === tk.D_INPUT) {
      q.pushIo(w, t);
    } else {
      q.pushRest(w, t, mode);
    }
    q.unlock(w, mode);
    return;
  }
  const g = tk.main();
  if (
    w !== 0 &&
    m.ld(w + tk.E_CURRENT) !== 0 &&
    m.ld32(w + tk.E_DISPATCH) === 0 &&
    tk.movable(t) &&
    m.ld(g + tk.E_STAY) === 0 &&
    // Not onto a spare the rescue started (its index past the workers asked for): spares retire
    // once idle (sched_relax.velt), and a task run there makes its sleeps there, which keep it
    // from retiring (#3060).
    m.ld(w + tk.E_INDEX) < m.ld(g + tk.E_COUNT)
  ) {
    q.pushNext(w, t, m.load32Relaxed(w + tk.E_MODE));
    return;
  }
  toInbox(h, t);
}

/**
 * Queues task `t`, just spawned on this thread (`w`: its worker block, `tk.here()`): behind the
 * input on its home, or on its home's inbox.
 */
@inline("always")
export function scheduleNew(w: usize, t: usize): void {
  if (w !== 0 && m.ld32(w + tk.E_SOLO) !== 0) {
    // The only thread at the executor: no lock, its spawns counted (sched_tick.velt `interval`).
    q.pushRest(w, t, 0);
    tk.bump(w + tk.E_RLEN, 1);
    return;
  }
  const h = m.ld(t + tk.T_HOME);
  if (w === h) {
    const mode = m.load32Relaxed(h + tk.E_MODE);
    if (mode === 0 && m.ld(h + tk.E_LAZY) !== 0 && m.ld(h + tk.E_CURRENT) !== 0) {
      // The poll's first `PEND_STACKED` spawns on `E_PREST` (`pendStacked`), the rest on the plain
      // list (sched_task.velt `E_PLIST`), in line.
      m.st(h + tk.E_PANY, m.ld(h + tk.E_PANY) | tk.PANY_MORE);
      const n = m.ld(h + tk.E_PCOUNT);
      m.st(h + tk.E_PCOUNT, n + 1);
      if (n >= tk.PEND_STACKED) {
        m.st(t + tk.T_NEXT, 0);
        const tail = m.ld(h + tk.E_PLIST_TAIL);
        if (tail === 0) {
          m.st(h + tk.E_PLIST, t);
        } else {
          m.st(tail + tk.T_NEXT, t);
        }
        m.st(h + tk.E_PLIST_TAIL, t);
      } else {
        pendStacked(h, t);
      }
      tk.bump(h + tk.E_RLEN, 1);
      return;
    }
    if (mode !== 0) {
      // A fresh task may start on another worker at once: what this thread printed first.
      publishPrinted(h);
    }
    q.lock(h, mode);
    q.pushRest(h, t, mode);
    q.unlock(h, mode);
    if (mode === 0) {
      // One worker's count of tasks spawned not yet run (sched_tick.velt `interval`).
      tk.bump(h + tk.E_RLEN, 1);
    }
    return;
  }
  toInbox(h, t);
}

/**
 * Queues task `t`, woken, on lazy worker 0 `w` during a poll (on `E_PIO` or `E_PREST`): `d` as
 * `schedule`'s. (Its spawns are queued by `scheduleNew`.)
 */
@noInline
function pend(w: usize, t: usize, d: u32): void {
  if (d === 0 && m.ld(w + tk.E_PWAKE) === 0) {
    m.st(w + tk.E_PWAKE, t);
    m.st(w + tk.E_PANY, m.ld(w + tk.E_PANY) | tk.PANY_FIRST);
    return;
  }
  // Woken past the first: not part of a fan-out (sched_monitor_lazy.velt `fanOutOnly`).
  m.st(w + tk.E_PANY, m.ld(w + tk.E_PANY) | tk.PANY_MORE | tk.PANY_WOKE);
  pendOn(w, t, d === tk.D_INPUT ? tk.E_PIO : tk.E_PREST);
}

/**
 * Pushes task `t`, spawned by lazy worker 0 `w`'s poll (one of its first `PEND_STACKED`), on
 * `E_PREST`, which the monitor may take.
 */
@noInline
function pendStacked(w: usize, t: usize): void {
  pendOn(w, t, tk.E_PREST);
}

/**
 * Pushes task `k` on the stack of lazy worker 0 `w` at offset `at` (`E_PIO` or `E_PREST`), which
 * the monitor may take while the poll still runs and start on a spare: what this thread printed
 * is published first (#2977), at the cost of a thread-local load when it printed nothing.
 */
function pendOn(w: usize, k: usize, at: usize): void {
  publishPrinted(w);
  m.pushStack(w + at, k, tk.T_NEXT);
}

/** Queues task `t` on worker `e`'s second queue (the end of a poll that woke it, a root's start). */
export function push(e: usize, t: usize): void {
  const mode = m.load32Relaxed(e + tk.E_MODE);
  q.lock(e, mode);
  q.pushRest(e, t, mode);
  q.unlock(e, mode);
}

/**
 * Pushes task `t` on worker `h`'s inbox and wakes `h` if it sleeps (from another thread). From
 * another worker, what this thread printed is published first, so it comes before anything the
 * woken task prints (the runtime's output buffers are per thread).
 */
export function toInbox(h: usize, t: usize): void {
  const w = tk.here();
  if (w !== 0) {
    publishPrinted(w);
  }
  m.pushStack(h + tk.E_INBOX, t, tk.T_NEXT);
  unpark(h);
}

/**
 * Publishes what this thread printed into the runtime's shared buffer, ahead of what any other
 * thread prints from now on (the runtime's `publish_before_handoff`, reached through the opening
 * of a latch that is open already); worker `w` is this thread's.
 */
@inline("always")
export function publish(w: usize): void {
  // SAFETY: the worker's latch handle, open, never freed.
  unsafe {
    velt_rt_latch_open$rt(m.ld(w + tk.E_LATCH) as u64);
  }
}

/**
 * What the poll that just ran on shared worker `w` printed (its microtasks too), published before
 * the poll's end can be seen by another thread: before Node's timer order takes the task for not
 * busy, its state lets another worker poll it, or its end wakes a joiner (sched_run.velt `run`). A
 * task woken on another worker runs there next (`schedule`), so a line printed before an `await`
 * would otherwise reach the shared buffer after what the task prints next there, whenever this
 * thread was held up between the two (#2971). Every such poll, also one whose task runs again here
 * (`E_AGAIN`, the slot): other threads see its effects through module state, shared objects and the
 * process's end, not only when the task moves. Through the stdout mark (`publishPrinted`): a poll
 * that printed nothing costs a thread-local load. A lazy worker 0 publishes after a poll that
 * printed (sched_task.velt `PANY_PRINTED`, read by the look after it, sched_loop.velt `alone`) and
 * before it queues a task where the monitor may take it during the poll (`pendOn`), so no task the
 * rescue moves prints before what was printed ahead of it on worker 0 (#2977).
 */
@inline("always")
export function publishPolled(w: usize): void {
  publishPrinted(w);
}

/**
 * `publish` at the points where work this thread made may be seen by another worker next: a poll's
 * end (`publishPolled`), a spawn, a wake sent to another worker's inbox, a task's end on another
 * worker than worker 0. Only a thread that wrote to stdout since its last publish has anything to
 * publish: every write of stdout from compiled code sets this thread's mark first (process.velt
 * `stdoutWritten`), so a thread that wrote nothing pays one thread-local load and a branch, not the
 * runtime's call (#2786). A mark left set by a publish that did not clear it (the runtime's) costs
 * one publish of nothing.
 */
@inline("always")
export function publishPrinted(w: usize): void {
  if (stdoutWrittenSince()) {
    publishMarked(w);
  }
}

/** `publishPrinted` once the mark is seen set: cleared before the publish, which takes it all. */
@noInline
function publishMarked(w: usize): void {
  clearStdoutWritten();
  publish(w);
}

/** Writes out what this thread printed (stdout is buffered per thread by the runtime). */
@noInline
export function handOffOutput(): void {
  velt_rt_flush();
}

/**
 * Worker `e` (this thread's) is awake with no wake from another thread: its thread starts (its
 * park word is up until then), or its park finds work before it sleeps. The word goes down, then
 * its count of wakes goes up, as at the end of a sleep (sched_io.velt `wait`). Worker 0's end
 * scan (sched_end.velt `quiet`) takes a worker whose word it read up for asleep; what this worker
 * runs next (its inbox, tasks it steals or borrows from another worker) may be gone from where
 * the scan looks by the time it looks there, and the count read after the scan says the worker
 * woke. Without it, a worker whose thread started late took `main`'s root at its first turn and
 * ran it with its word still up, and the program ended with `main` running (#3076).
 */
export function awake(e: usize): void {
  m.store32(e + tk.E_PARK, 0);
  m.incOrdered(e + tk.E_UNPARKS);
}

/**
 * Wakes worker `w` if it sleeps in its reactor (its park word is up); one that spins before its
 * park (`PARK_SPIN`, sched_spin.velt) only has its word taken down, which ends the spin with no
 * system call: it looks again at whatever this wake is for (a task on its inbox, the last task's
 * end, an exit), as a parked worker does.
 */
export function unpark(w: usize): void {
  const p = m.load32(w + tk.E_PARK);
  if (p !== 1) {
    if (p === tk.PARK_SPIN) {
      m.cas32(w + tk.E_PARK, tk.PARK_SPIN, 0);
    }
    return;
  }
  // Counted before the wake, so a scan that reads the count after it sees the wake.
  m.incOrdered(w + tk.E_UNPARKS);
  if (m.cas32(w + tk.E_PARK, 1, 0) === 1) {
    // Woken is not stalled: the monitor counts from now.
    m.st(w + tk.E_PROGRESS, m.load(tk.main() + tk.E_TICKS));
    io.wake(m.ld(w + tk.E_IO));
  }
}

/** The task a waker header belongs to (a task, or a promise one drives); 0 for another table. */
@inline("always")
export function taskOf(w: usize): usize {
  const e = tk.main();
  const vt = m.ld(w);
  if (vt === e + tk.E_VT) {
    return w;
  }
  if (vt === e + tk.E_NODE_VT) {
    return m.ld(w + 48);
  }
  return 0;
}
