// velt/lang/hooks (internal): a holder of a shared promise of the executor in Velt handed to
// another task (sched_share.velt; the runtime's task/shared.rs `hand_over` for its executor).
//
// A shared promise stays on the task it is shared on: its node and settled result are that task's.
// The owner hands a holder over (`spawn(use(p))`, a channel, a captured closure): its role goes to
// a proxy, a node of this task holding a role of its own, which awaits the promise here and
// finishes with a share of the result; the proxy is handed over in turn, so its transfer glue
// (sched_node_transfer.velt) moves or copies that share for the other task as it finishes here
// (#160). The holder forwards to the proxy from then on: the other task awaits a copy made here
// and never uses the result object this task's holders see.

import { fnAddress, futDrop, futPoll, inline } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as nc from "./sched_node_catch";
import * as nd from "./sched_node";
import * as nw from "./sched_node_wake";
import * as sh from "./sched_share";
import * as sd from "./sched_share_drop";
import * as ss from "./sched_share_settle";
import * as t from "./sched_task";
import * as tr from "./sched_node_transfer";
import * as x from "./sched_node_ext";

/**
 * `velt_rt_fut_transfer` for holder `f` (its header's poll is `holderPoll`), with transfer glue
 * `glue` (0: nothing to transfer).
 */
export function handOver(f: usize, glue: usize): void {
  handOverWith(f, glue, 0);
}

/** `handOver`, the new proxy one of the holders of group `group` (0: a group of its own). */
function handOverWith(f: usize, glue: usize, group: usize): void {
  const fwd = sh.forwardOf(f);
  if (fwd !== 0) {
    if (m.ld(fwd) !== fnAddress(sh.holderPoll)) {
      // Handed on again: the proxy's result is this holder's own copy already.
      return;
    }
    // Shared again on this task (sched_share.velt `schedShare`): a proxy of this task takes the
    // role of `f`'s proxy here over in turn.
    const next = newProxy(m.ld(fwd - 8), glue, 0);
    setForward(f, next);
    // SAFETY: the old proxy, a holder this holder owned.
    unsafe {
      futDrop(fwd);
    }
    return;
  }
  const h = m.ld(f - 8);
  const proxy = newProxy(h, glue, group);
  if (sh.isOrig(h, f)) {
    // The original stays allocated for the holder there; the hub holds its forward.
    m.st(h + sh.H_ORIG_FWD, proxy);
    m.or32(h + sh.H_FLAGS, sh.ORIG_OUT);
  } else {
    m.st(f - sh.FRONT + 8, proxy);
    m.st(f - 8, 0);
  }
  // `f`'s own role ends here; the proxy's keeps the promise alive.
  sd.release(h, f);
}

/**
 * A copy, made on this task (`task`), of a holder handed over from it, whose proxy `fwd` has not
 * finished: a holder handed over the same way, a new handle of the hub the proxy awaits, handed
 * over with the proxy's transfer glue. Sharing the proxy instead would make a hub of this task,
 * and the copy, which goes where the holder went (a spawned call's argument: the callee keeps a
 * copy of it, #3424), would take a handle of that hub to the other task. 0 when `fwd` is not
 * such a proxy (it is another task's: the holder was handed to this one).
 */
export function copyHandedOver(fwd: usize, task: usize): usize {
  if (m.ld(fwd) !== fnAddress(nd.nodePoll)) {
    return 0;
  }
  const n = nd.nodeOf(fwd);
  const fl = m.load32(n + nd.N_FLAGS);
  if (
    m.ld(n + nd.N_TASK) !== task ||
    m.ld(n + nd.N_POLL) !== fnAddress(proxyPoll) ||
    (fl & (tr.HANDED_OVER | nd.FINISHED)) !== tr.HANDED_OVER
  ) {
    return 0;
  }
  // The proxy's role while it waits (`proxyPoll`), a handle of the hub on this task.
  const role = m.ld(n + nd.N_HEAD + 16);
  const g = sh.newHandle(m.ld(role - 8));
  // The copy goes where the holder went: its proxy joins the holder's group.
  handOverWith(g, m.ld(x.get(n) + x.X_TRANSFER), groupOf(fwd, m.ld(role - sh.FRONT + 16)));
  return g;
}

/** Holder `f` (handed over already) forwards to `proxy` from now on. */
function setForward(f: usize, proxy: usize): void {
  const h = m.ld(f - 8);
  if (h === 0) {
    m.st(f - sh.FRONT + 8, proxy);
  } else {
    m.st(h + sh.H_ORIG_FWD, proxy);
  }
}

/**
 * A started node of this task holding a role of its own in the promise of hub `h`: it awaits the
 * promise here and finishes with a share of the result, transferred with `glue` (0: a plain
 * result, copied as it is) for the task it goes to. It is one of the holders of `group` (0: a new
 * group, its own).
 */
function newProxy(h: usize, glue: usize, group: usize): usize {
  const role = sh.newHandle(h);
  const size = m.ld(h + sh.H_SIZE);
  // The proxy's state: the role while it waits, the result (at offset 0) once it settled, then
  // its group.
  const rs = resultBytes(size);
  const ss = rs + 16;
  const st = m.zeroed(ss);
  m.st(st, role);
  let g = group;
  if (g === 0) {
    g = m.zeroed(G_BYTES);
    // The promise's own result drop, which reports an error (the hub's drops it quietly).
    m.st(g + G_REPORT, m.ld(m.ld(h + sh.H_NODE) + nd.N_RESULT_DROP));
  }
  m.inc(g + G_LIVE);
  m.st(st + rs, g);
  const poll = fnAddress(nd.nodePoll);
  const p = nd.boxed(
    fnAddress(proxyPoll),
    fnAddress(proxyDrop),
    st,
    ss as u64,
    poll,
    fnAddress(nd.nodeDrop),
  );
  m.release(st, ss);
  const e = t.exec();
  const task = m.ld(e + t.E_CURRENT);
  if (task !== 0) {
    // Started, its first run left to its task's next poll (the woken nodes): run now, a settled
    // promise's proxy would finish at once, and a copy made right after the hand-over (a spawned
    // call's callee keeps one of its argument) would find no hub to take a role of
    // (`copyHandedOver`, #3424).
    const n = nd.nodeOf(p);
    const catching = m.ld(e + nc.E_CATCHING);
    if (catching !== 0) {
      nc.catchesFrom(n, catching);
    }
    nd.bind(task, n, m.ld(h + sh.H_RDROP), false);
    nw.nodeWakeByRef(n);
    // A promise that finished already settles now, as the proxy's first run would settle it: its
    // result is the hub's, so this task's check of rejections nobody handled, which runs before
    // the proxy (sched_node_report.velt `report`), leaves a rejection to the other task, whose
    // holders report it if none of them takes it (`dropping`).
    settleFinished(h, task);
  }
  tr.transfer(p, glue, poll);
  return p;
}

/**
 * Hub `h`'s promise, a node of this task (`task`) that finished before the hub heard, settles
 * (as sched_share.velt `peek` settles it). A hub whose node is another task's settles there.
 */
function settleFinished(h: usize, task: usize): void {
  if ((m.load32(h + sh.H_FLAGS) & (sh.DONE | sh.AWAY)) !== 0) {
    return;
  }
  const n = m.ld(h + sh.H_NODE);
  const fl = m.load32(n + nd.N_FLAGS);
  if (
    (fl & (nd.STARTED | nd.FINISHED)) === (nd.STARTED | nd.FINISHED) && m.ld(n + nd.N_TASK) === task
  ) {
    ss.settle(h, task, 0);
  }
}

// The holders a hand-over makes on the other task (the holder handed over, and the copies of it
// made here right after, `copyHandedOver`) are a group: their proxies drop a rejection quietly,
// as the hub does, but the last of them dropped there without anyone of the group having taken
// its result reports it, with the promise's own result drop. So the other task decides whether a
// rejection it was handed is handled (#3426): the hub here counts the hand-over as a taker.
// G_LIVE and G_CLAIMED are only changed on the other task once the hand-over is done; the copies
// join before the other task can run.

/** The proxies of the group not dropped yet. */
const G_LIVE: usize = 0;
/** 1 once a holder of the group took its result. */
const G_CLAIMED: usize = 8;
/** The promise's result drop that reports a rejection (0: none, the proxies stay quiet). */
const G_REPORT: usize = 16;
const G_BYTES: usize = 24;

/** The bytes of a proxy's state before its group: a result of `size` bytes (or its role). */
@inline("always")
function resultBytes(size: usize): usize {
  return ((size > 8 ? size : 8) + 15) & ~15;
}

/** Is `p` (a future header) a proxy? */
function isProxy(p: usize): bool {
  return m.ld(p) === fnAddress(nd.nodePoll) && m.ld(nd.nodeOf(p) + nd.N_POLL) === fnAddress(proxyPoll);
}

/** The group of proxy `p`, whose result has `size` bytes. */
function groupOf(p: usize, size: usize): usize {
  return m.ld(p + 16 + resultBytes(size));
}

/** Holder forward `p` (a proxy, or another holder) delivered its result of `size` bytes. */
export function taken(p: usize, size: usize): void {
  if (isProxy(p)) {
    m.storeRelease(groupOf(p, size) + G_CLAIMED, 1);
  }
}

/**
 * Holder forward `p` (a proxy, or another holder), its result of `size` bytes, is about to be
 * dropped by its holder: the last proxy of a group none of whose holders took the result drops a
 * rejection with the promise's own result drop, which reports it. Its node reads the drop only
 * after its holder's drop marked it DETACHED, or here.
 */
export function dropping(p: usize, size: usize): void {
  if (!isProxy(p)) {
    return;
  }
  const g = groupOf(p, size);
  if (m.dec(g + G_LIVE) !== 1) {
    return;
  }
  const report = m.ld(g + G_REPORT);
  if (m.load(g + G_CLAIMED) === 0 && report !== 0) {
    m.st(nd.nodeOf(p) + nd.N_RESULT_DROP, report);
  }
  m.release(g, G_BYTES);
}

/** A proxy's state poll: awaits its role, then moves the result into its state. */
export function proxyPoll(state: usize, cx: usize): u32 {
  const role = m.ld(state);
  // SAFETY: the role, a handle the proxy owns.
  if (unsafe { futPoll(role, cx) } !== 1) {
    return 0;
  }
  m.copy(state, role + 16, m.ld(role - sh.FRONT + 16));
  // SAFETY: as above; its result moved out.
  unsafe {
    futDrop(role);
  }
  return 1;
}

/** A proxy's state drop (it has not settled): its role goes away. */
export function proxyDrop(state: usize): void {
  // SAFETY: the role, a handle the proxy owns.
  unsafe {
    futDrop(m.ld(state));
  }
}
