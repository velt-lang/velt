// velt/lang/hooks (internal): what `console.log`'s layout asks of an entry's text (whether it is
// Node's `... n more items` or a number), and the byte writers it lays the text out with
// (inspect_layout_render.velt). Each reads the printed text through the address of its bytes.

import {
  addressArray,
  addressLoad,
  arrayMove,
  arraySetLen,
  strByteAt,
  strByteLen,
} from "velt/lang/intrinsics";

/** Byte `k` of the text at `data`. */
function at(data: usize, k: u64): u8 {
  // SAFETY: the callers pass the address of the printed text's bytes, alive while the layout
  // runs, and offsets inside it.
  return unsafe { addressLoad<u8>(data + (k as usize)) };
}

/** Are bytes `a..b` Node's `... n more items` (the printer's only unquoted text starting so)? */
export function isMoreAt(data: usize, a: u64, b: u64): bool {
  return (
    b >= a + 4 &&
    at(data, a) == 0x2e &&
    at(data, a + 1) == 0x2e &&
    at(data, a + 2) == 0x2e &&
    at(data, a + 3) == 0x20
  );
}

/** Are bytes `a..b` a number as the printer writes one (`-1.5`, `1e+21`, `NaN`, `-Infinity`, `3n`)? */
export function isNumberAt(data: usize, a0: u64, b0: u64): bool {
  let a = a0;
  let b = b0;
  if (a < b && at(data, a) == 0x2d) {
    a += 1;
  }
  if (a < b && at(data, b - 1) == 0x6e) {
    b -= 1;
  }
  if (a >= b) {
    return false;
  }
  const first = at(data, a);
  if (first == 0x4e || first == 0x49) {
    return isWordAt(data, a, b, "NaN") || isWordAt(data, a, b, "Infinity");
  }
  if (!isDigit(first)) {
    return false;
  }
  for (let j = a; j < b; j++) {
    const c = at(data, j);
    if (!isDigit(c) && c != 0x2e && c != 0x65 && c != 0x2b && c != 0x2d) {
      return false;
    }
  }
  return true;
}

/** Are bytes `a..b` the ASCII word `w`? */
function isWordAt(data: usize, a: u64, b: u64, w: string): bool {
  const n = strByteLen(w) as u64;
  if (b - a != n) {
    return false;
  }
  for (let j: u64 = 0; j < n; j++) {
    if (at(data, a + j) != strByteAt(w, j)) {
      return false;
    }
  }
  return true;
}

function isDigit(c: u8): bool {
  return c >= 0x30 && c <= 0x39;
}

/** Appends bytes `a..b` of the text at `data`: a short run byte by byte, a longer one in one copy. */
export function pushRange(out: u8[], data: usize, a: u64, b: u64): void {
  if (b <= a) {
    return;
  }
  const n = b - a;
  if (n < 16) {
    for (let j = a; j < b; j++) {
      out.push(at(data, j));
    }
    return;
  }
  const len = out.length as usize;
  out.reserve(n as usize);
  arraySetLen(out, len + (n as usize));
  // A view of the bytes, copied with the compiler's own copy rather than C's `memcpy`: the
  // JavaScript host's WebAssembly target has no C library, and every program that prints
  // reaches this.
  // SAFETY: the text holds bytes `a..b` at `data` while the layout runs, and the view is only
  // read, here.
  const src: u8[] = unsafe { addressArray<u8>(data + (a as usize), n as usize) };
  arrayMove(out, len, src, 0, n as usize);
}

/** Appends bytes `a..b` of the text at `data`, each line after the first indented by `indent`. */
export function pushTextAt(out: u8[], data: usize, a: u64, b: u64, indent: u64): void {
  for (let j = a; j < b; j++) {
    const c = at(data, j);
    out.push(c);
    if (c == 0x0a) {
      spaces(out, indent);
    }
  }
}

/** Appends `n` spaces. */
export function spaces(out: u8[], n: u64): void {
  for (let j: u64 = 0; j < n; j++) {
    out.push(0x20);
  }
}

/** Appends a line break and `n` spaces of indentation. */
export function newline(out: u8[], n: u64): void {
  out.push(0x0a);
  spaces(out, n);
}
