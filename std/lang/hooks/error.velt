// velt/lang/hooks (internal): the compiler's hooks for errors (std-layout.md §10b): the first
// line of Node's report of an error nothing catches (velt_vir `entry.rs`), the
// `Error.prototype.toString` text the prelude's `Error` shares with it, the key of the method
// std's error classes set their `name` with, and `message` as JavaScript reads it in a program
// whose class extending `Error` declares `get message()` (velt_sema `error_message.rs`).

import { ERROR_MESSAGE } from "velt/lang/hooks/keys";
import { strBorrowedWords, strDataAddress } from "velt/lang/intrinsics/string";
import { Symbol } from "velt/lang/symbol";

/** `Error.prototype.toString` of an error with `name` and `message`. */
export function errorText(name: string, message: string): string {
  if (name == "") {
    return message;
  }
  if (message == "") {
    return name;
  }
  return `${name}: ${message}`;
}

/**
 * The first line of Node's report of the error `e` when nothing catches it, for a value of class
 * `cls`: `toString()`'s text as `Error`'s writes it, with the class in front when its `name`
 * ends in `Error` and is not the class's own name (`E [TypeError]: m`; `MyTypeError: m` when the
 * class's name contains it).
 */
export function uncaughtHeader(e: Error, cls: string): string {
  const name = e.name;
  const text = errorText(name, e.message);
  if (!name.endsWith("Error") || name == cls) {
    return text;
  }
  const rest = text.slice(name.length as i64);
  if (cls.includes(name)) {
    return `${cls}${rest}`;
  }
  return `${cls} [${name}]${rest}`;
}

/**
 * The key of `Error`'s method that writes its name without the `name` accessor, which a
 * program's subclass may override: std's error classes (`TypeError`, `AggregateError`, …) set
 * their name with it in their constructors, as JavaScript has it on their prototypes (#3792).
 * Programs never see the symbol, so they cannot override the method.
 */
export const ERROR_NAME = Symbol("errorName");

// The bytes `noMessage()` points at: no program's string starts at them, so an empty string there
// is told from every other.
const NO_MESSAGE_ANCHOR = "velt: an error made without a message";

/**
 * The message `Error`'s constructor and the built-in error classes' (`TypeError`, …) default to,
 * in a program where a class extending `Error` declares `get message()`: an empty string at an
 * address of its own, which means "made without a message" (`errorMessage`). JavaScript's error
 * then has no own `message`, and reading it reaches the getter. Everywhere else the compiler
 * places `""` for the call instead, so other programs compile as if it were not there.
 */
export function noMessage(): string {
  const anchor = NO_MESSAGE_ANCHOR;
  return strBorrowedWords(strDataAddress(anchor) as u64, 0);
}

/**
 * `e.message` as JavaScript reads it in a program where a class extending `Error` declares
 * `get message()`: the error's own message when it was given one (`""` included), else
 * `Error.prototype.message` as the class has it (its `get message()`, or `""`). The compiler
 * reads every `message` of an error through this in such a program.
 */
export function errorMessage(e: Error): string {
  const own = e.message;
  const anchor = NO_MESSAGE_ANCHOR;
  if (own.length != 0 || strDataAddress(own) != strDataAddress(anchor)) {
    return own;
  }
  return e[ERROR_MESSAGE];
}
