// velt/lang/hooks (internal): what `console.log` and `util.inspect` write the same way for every
// type (docs/internals/design/inspect-shapes.md): the depth limit, objects that hold themselves
// (`<ref *1>`, `[Circular *1]`, through inspect_cycles.velt) and arrays. Lowering writes what differs per type
// around these (an object's fields, the member a union holds) and calls them with the line's own
// builder, so a value has no builder of its own. Sema checks them where live code may print one
// (velt_common `std_hooks.rs`), so a program without arrays or objects does not pay for them.

import { inspectNested } from "velt/lang/intrinsics";
import { inspectCircular, inspectEnter, inspectMore } from "velt/lang/hooks/inspect_cycles";

declare function velt_rt_strbuf_push_str(buf: string, s: string);

/**
 * Opens the object with identity `id` (0: its values never hold themselves): false past the depth
 * limit (after `cut`, `[Name]`, or `[Circular *N]` when it is being written) and when it is being
 * written already (after `[Circular *N]`, marking the object it refers back to with `<ref *N>`).
 * After a true with an identity, the caller ends the object with `inspectLeave`.
 */
export function openObject(buf: string, cut: string, id: u64, depth: u32): bool {
  if (depth > 2) {
    if (id == 0 || !inspectCircular(buf, id)) {
      velt_rt_strbuf_push_str(buf, cut);
    }
    return false;
  }
  return id == 0 || inspectEnter(buf, id);
}

/** An array: `[ a, b ]`, its first 100 elements, `[Array]` past the depth limit. */
export function inspectArray<E>(buf: string, a: E[], depth: u32): void {
  const n = a.length;
  if (n == 0) {
    velt_rt_strbuf_push_str(buf, "[]");
    return;
  }
  if (depth > 2) {
    velt_rt_strbuf_push_str(buf, "[Array]");
    return;
  }
  const c = depth + 1;
  const shown = n > 100 ? 100 : n;
  velt_rt_strbuf_push_str(buf, "[ ");
  for (let i: usize = 0; i < shown; i++) {
    if (i > 0) {
      velt_rt_strbuf_push_str(buf, ", ");
    }
    inspectNested(buf, a[i], c);
  }
  if (n > 100) {
    const more = (n - 100) as u64;
    inspectMore(buf, more);
  }
  velt_rt_strbuf_push_str(buf, " ]");
}
