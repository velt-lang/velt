// velt/lang/hooks (internal): what `console.log` and `util.inspect` write the same way for every
// type (docs/internals/design/inspect-shapes.md): the depth limit, arrays and `... n more items`,
// and strings and object keys quoted (objects that hold themselves are inspect_cycles.velt's). Lowering writes what differs per type
// around these (an object's fields, the member a union holds) and calls them with the line's own
// builder, so a value has no builder of its own. Sema checks them where live code may print one
// (velt_common `std_hooks.rs`), so a program without arrays or objects does not pay for them.

import { hookCall, inspectNested, noInline, strByteAt, strByteLen } from "velt/lang/intrinsics";

declare function velt_rt_strbuf_push_str(buf: string, s: string);
declare function velt_rt_strbuf_push_byte(buf: string, b: u8);

/**
 * Opens an object that cannot hold itself: false past the depth limit, after `cut` (`[Name]`).
 * An object that can is opened by inspect_cycles.velt's `openObject`.
 */
export function openPlain(buf: string, cut: string, depth: u32): bool {
  if (depth > 2) {
    velt_rt_strbuf_push_str(buf, cut);
    return false;
  }
  return true;
}

/** An array: `[ a, b ]`, its first 100 elements, `[Array]` past the depth limit. */
export function inspectArray<E>(buf: string, a: E[], depth: u32): void {
  const n = a.length;
  if (n == 0) {
    velt_rt_strbuf_push_str(buf, "[]");
    return;
  }
  if (depth > 2) {
    velt_rt_strbuf_push_str(buf, "[Array]");
    return;
  }
  const c = depth + 1;
  velt_rt_strbuf_push_str(buf, "[ ");
  inspectElements(buf, a, c);
  if (n > 100) {
    const more = (n - 100) as u64;
    inspectMore(buf, more);
  }
  velt_rt_strbuf_push_str(buf, " ]");
}

/** Node's `, ... n more items` (`, ... 1 more item`) after the first 100 entries of a container. */
export function inspectMore(buf: string, remaining: u64): void {
  velt_rt_strbuf_push_str(buf, ", ... ");
  // Its digits from the first, without compiling std's number printing into every program.
  let p: u64 = 1;
  while (remaining / p >= 10) {
    p = p * 10;
  }
  while (p > 0) {
    const digit = (48 + (remaining / p) % 10) as u8;
    velt_rt_strbuf_push_byte(buf, digit);
    p = p / 10;
  }
  if (remaining == 1) {
    velt_rt_strbuf_push_str(buf, " more item");
  } else {
    velt_rt_strbuf_push_str(buf, " more items");
  }
}

/**
 * The first 100 elements of `a`, at depth `c`, separated by `, `. `for…of` reads each element
 * without a bounds check, whose message a program would compile; not inlined, so the optimizer
 * goes over the loop once per element type, not at every place an array is printed.
 */
@noInline
function inspectElements<E>(buf: string, a: E[], c: u32): void {
  let i: usize = 0;
  for (const x of a) {
    if (i == 100) {
      break;
    }
    if (i > 0) {
      velt_rt_strbuf_push_str(buf, ", ");
    }
    inspectNested(buf, x, c);
    i++;
  }
}

/**
 * `s` as Node's `util.inspect` writes a string inside a container (`console.log([s])`): printable
 * ASCII without a quote or a backslash in single quotes here, anything else quoted and escaped by
 * inspect_quote.velt's `quotedText`. velt_vir's format glue quotes compile-time strings the same
 * way.
 */
export function inspectStr(buf: string, s: string): void {
  const n = strByteLen(s) as u64;
  for (let i: u64 = 0; i < n; i++) {
    const c = strByteAt(s, i);
    if (c < 0x20 || c >= 0x7f || c == 0x27 || c == 0x22 || c == 0x60 || c == 0x5c) {
      const q: string = hookCall("inspect_quote", s);
      velt_rt_strbuf_push_str(buf, q);
      return;
    }
  }
  velt_rt_strbuf_push_byte(buf, 0x27);
  velt_rt_strbuf_push_str(buf, s);
  velt_rt_strbuf_push_byte(buf, 0x27);
}

/**
 * An object key as `util.inspect` writes it: bare when it is an identifier of ASCII letters,
 * digits and `_` that doesn't start with a digit (`a`, `_x1`), else quoted as `inspectStr`
 * quotes a string (`'a b'`, `'1'`, `'$'`, `'é'`, `''`), as Node does.
 */
export function inspectKey(buf: string, s: string): void {
  const n = strByteLen(s) as u64;
  let bare = n > 0 && !isDigit(strByteAt(s, 0));
  for (let i: u64 = 0; bare && i < n; i++) {
    const c = strByteAt(s, i);
    bare = isDigit(c) || c == 0x5f || ((c | 0x20) >= 0x61 && (c | 0x20) <= 0x7a);
  }
  if (bare) {
    velt_rt_strbuf_push_str(buf, s);
  } else {
    inspectStr(buf, s);
  }
}

function isDigit(c: u8): bool {
  return c >= 0x30 && c <= 0x39;
}
