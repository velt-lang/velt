// velt/lang/hooks (internal): `velt_rt_fut_peek` under the executor in Velt (sched.velt
// `schedPeek`): whether a promise settled with its result still in its slot, which `console.log`
// then prints (`Promise { 42 }`) without claiming it.

import { fnAddress } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as node from "./sched_node";
import * as sh from "./sched_share";
import * as lf from "./sched_share_leaf";

/**
 * 1 when promise `f` settled with its result in its slot. A node of this executor's tells by its
 * flags, a holder of a shared one by its hub (sched_share.velt), a shared leaf by its role. Any
 * other promise prints as pending: a spawned task's handle, a join or a race until awaited, and
 * a runtime leaf or a promise boxed off the worker, which runs only when it is awaited and whose
 * result is then claimed (every share of one goes to this executor's hub, sched_share_leaf.velt,
 * so no holder of the runtime's is ever settled here; #2196 9f).
 */
export function peek(f: usize): u32 {
  if (m.ld(f) === fnAddress(node.nodePoll)) {
    return node.peek(f) ? 1 : 0;
  }
  if (m.ld(f) === fnAddress(sh.holderPoll)) {
    return sh.peek(f) ? 1 : 0;
  }
  if (lf.isLeaf(f)) {
    // A shared leaf's holder (sched_share_leaf.velt): what its role shows, copied to its slot.
    return lf.peek(f) ? 1 : 0;
  }
  return 0;
}
