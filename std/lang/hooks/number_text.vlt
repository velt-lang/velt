// velt/lang/hooks (internal): the compiler's hooks for a number in a template or `String()`
// (std-layout.md §10b), on std's number printing (velt/lang/number/integer and format). Loaded
// only by a program whose own code may convert a number to text (std/prelude/global/
// number_text.vlt, crates/veltc/src/loader/globals.rs), and checked only once it does (velt_common
// `std_hooks::ON_DEMAND_TEXT`, `ON_DEMAND_FLOAT`): other programs neither parse nor check the
// printers. Where lowering needs one of these and the program has none, it calls the runtime.

import { trunc } from "velt/lang/intrinsics";
import { f64Text, pushF64 } from "velt/lang/number/format";
import { i64Text, pushI64, pushU64, u64Text } from "velt/lang/number/integer";

/** `String(v)` of a signed integer (a template's `${v}`, `v.toString()`): lowering calls it. */
export function intText(v: i64): string {
  return i64Text(v);
}

/** `String(v)` of an unsigned integer. */
export function uintText(v: u64): string {
  return u64Text(v);
}

/** Appends `String(v)` of a signed integer to the builder `buf` (a template's `${v}`). */
export function intPush(buf: string, v: i64): void {
  pushI64(buf, v);
}

/** Appends `String(v)` of an unsigned integer to the builder `buf`. */
export function uintPush(buf: string, v: u64): void {
  pushU64(buf, v);
}

// Is `x` a whole number below 2^53 in magnitude (`-0` included)? Its text is the integer's.
function whole(x: f64): bool {
  return x == trunc(x) && x < 9007199254740992.0 && x > -9007199254740992.0;
}

/**
 * `String(x)` of a float (`${x}` alone, `x.toString()`). A whole number below 2^53 is its
 * integer's digits (`intText`, which `velt_opt` numrep calls directly when it knows `x` is one).
 */
export function numberText(x: f64): string {
  if (whole(x)) {
    return intText(x as i64);
  }
  return f64Text(x);
}

/** Appends `String(x)` of a float to the builder `buf` (a template's `${x}`), as `numberText`. */
export function numberPush(buf: string, x: f64): void {
  if (whole(x)) {
    intPush(buf, x as i64);
    return;
  }
  pushF64(buf, x);
}
