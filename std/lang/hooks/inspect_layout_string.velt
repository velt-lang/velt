// velt/lang/hooks (internal): a long quoted string inside a value `console.log` breaks across
// lines. Node's `formatPrimitive` splits a string longer than 16 UTF-16 units, and longer than
// the room left on its line, after each line break, each piece quoted on its own and joined by
// ` +` and a new line (lib/internal/util/inspect.js). The printer wrote the string quoted and
// escaped (velt_rt's `push_inspect_string`), so this reads it back first.

import { pushRange } from "velt/lang/hooks/inspect_layout_pieces";
import { hasByte, utf16Units, wordAt } from "velt/lang/hooks/inspect_layout_width";
import { strByteAt, strByteLen, strDataAddress } from "velt/lang/intrinsics";

declare function velt_rt_strbuf_push_byte(buf: string, b: u8);
declare function velt_rt_strbuf_push_inspect_str(buf: string, s: string);
declare function velt_rt_strbuf_push_u8s(buf: string, bytes: u8[], len: u64, units: u64);
declare function velt_rt_str_byte_slice(s: string, start: u64, end: u64, units: u64): string;

/** The piece's unit count, unknown: `velt_rt_str_byte_slice` counts it. */
const UNCOUNTED: u64 = 0xffffffffffffffff;

/** Node's `breakLength`. */
const BREAK_LENGTH: u64 = 80;

/**
 * The quoted string at bytes `a..b` of `src` (quotes included) as Node lays it out at
 * indentation `indent`: its pieces, one per line, or "" when it stays as it is (no line break in
 * it, 16 units or fewer, or it fits on the line).
 */
export function splitString(src: string, a: u64, b: u64, indent: u64): string {
  if (!hasEscapedBreak(src, a, b)) {
    return "";
  }
  const breaks: u64[] = [];
  const raw = unescapeString(src, a, b, breaks);
  const n = strByteLen(raw) as u64;
  const len = utf16Units(raw, 0, n);
  // Node's two rules. Within the depth limit (indentation at most 8) a string past the room on its
  // line is longer than 16 units anyway, so the first decides nothing; it stays as Node writes it.
  if (len <= 16 || len + indent + 4 <= BREAK_LENGTH || breaks.length == 0) {
    // No line break after all: each `\n` was an escaped backslash and an `n`.
    return "";
  }
  // A piece after each line break, and the rest.
  if (breaks[breaks.length - 1] + 1 < n) {
    breaks.push(n - 1);
  }
  let out: string = "";
  let from: u64 = 0;
  for (let k = 0; k < breaks.length; k++) {
    const to = breaks[k] + 1;
    const piece = velt_rt_str_byte_slice(raw, from, to, UNCOUNTED);
    if (from > 0) {
      velt_rt_strbuf_push_byte(out, 0x20);
      velt_rt_strbuf_push_byte(out, 0x2b);
      velt_rt_strbuf_push_byte(out, 0x0a);
      for (let j: u64 = 0; j < indent + 2; j++) {
        velt_rt_strbuf_push_byte(out, 0x20);
      }
    }
    velt_rt_strbuf_push_inspect_str(out, piece);
    from = to;
  }
  return out;
}

/** Is there a `\n` escape (a backslash, then `n`) in bytes `a..b` of `s`? */
function hasEscapedBreak(s: string, a: u64, b: u64): bool {
  const data = strDataAddress(s) as u64;
  let j = nextBackslash(s, data, a, b);
  while (j + 1 < b) {
    if (strByteAt(s, j + 1) == 0x6e) {
      return true;
    }
    j = nextBackslash(s, data, j + 2, b);
  }
  return false;
}

/** The offset of the first backslash in bytes `i..end` of `s` (its bytes at `data`), or `end`. */
function nextBackslash(s: string, data: u64, i: u64, end: u64): u64 {
  let j = i;
  while (j < end) {
    if (((data + j) & 7) == 0) {
      while (j + 8 <= end && !hasByte(wordAt(data, j), 0x5c)) {
        j += 8;
      }
      if (j >= end) {
        break;
      }
    }
    if (strByteAt(s, j) == 0x5c) {
      return j;
    }
    j += 1;
  }
  return end;
}

/**
 * The text of the quoted string at bytes `a..b` of `s` (quotes included), as velt_rt's
 * `push_inspect_string` escaped it: `\n`, `\t`, `\b`, `\f`, `\r`, `\xHH` (a control character),
 * `\uXXXX` (a lone surrogate, in WTF-8), and a backslash before any other byte, which stands for
 * that byte. `breaks` gets the offset of each line break in the text.
 */
function unescapeString(s: string, a: u64, b: u64, breaks: u64[]): string {
  // Built as bytes and made a string once: a character's bytes appended one by one would be
  // checked one by one, each a truncated character.
  const out: u8[] = [];
  // The text is at most as long as its escaped form.
  out.reserve((b - a) as usize);
  const data = strDataAddress(s);
  const end = b > a + 1 ? b - 1 : a + 1;
  let i = a + 1;
  while (i < end) {
    // The run up to the next backslash, in one copy.
    const j = nextBackslash(s, data as u64, i, end);
    pushRange(out, data, i, j);
    i = j;
    // A backslash escapes the byte after it, so none is the string's last (`skipQuoted`).
    if (i + 1 >= end) {
      break;
    }
    const next = strByteAt(s, i + 1);
    i += 2;
    if (next == 0x6e) {
      breaks.push(out.length as u64);
      out.push(0x0a);
    } else if (next == 0x74) {
      out.push(0x09);
    } else if (next == 0x62) {
      out.push(0x08);
    } else if (next == 0x66) {
      out.push(0x0c);
    } else if (next == 0x72) {
      out.push(0x0d);
    } else if (next == 0x78) {
      const hi = hexValue(i < end ? strByteAt(s, i) : 0);
      const lo = hexValue(i + 1 < end ? strByteAt(s, i + 1) : 0);
      if (hi >= 0 && lo >= 0) {
        const code = (hi * 16 + lo) as u64;
        if (code < 0x80) {
          out.push(code as u8);
        } else {
          out.push((0xc0 | (code >> 6)) as u8);
          out.push((0x80 | (code & 0x3f)) as u8);
        }
        i += 2;
      }
    } else if (next == 0x75 && i + 4 <= end) {
      // A lone surrogate, which the printer escapes: its three WTF-8 bytes.
      let code: i64 = 0;
      let ok = true;
      for (let k: u64 = 0; k < 4; k++) {
        const h = hexValue(strByteAt(s, i + k));
        ok = ok && h >= 0;
        code = code * 16 + h;
      }
      if (ok) {
        const c = code as u64;
        out.push((0xe0 | (c >> 12)) as u8);
        out.push((0x80 | ((c >> 6) & 0x3f)) as u8);
        out.push((0x80 | (c & 0x3f)) as u8);
        i += 4;
      } else {
        out.push(next);
      }
    } else {
      out.push(next);
    }
  }
  let text: string = "";
  velt_rt_strbuf_push_u8s(text, out, out.length as u64, 0xffffffffffffffff);
  return text;
}

/** The value of hex digit `c`, or -1. */
function hexValue(c: u8): i64 {
  if (c >= 0x30 && c <= 0x39) {
    return (c - 0x30) as i64;
  }
  if (c >= 0x61 && c <= 0x66) {
    return (c - 0x61 + 10) as i64;
  }
  if (c >= 0x41 && c <= 0x46) {
    return (c - 0x41 + 10) as i64;
  }
  return -1;
}
