// velt/lang/hooks (internal): the compiler's hooks for a number in a template or `String()`
// (std-layout.md §10b), on std's integer printing (velt/lang/number/integer). Loaded when the
// check finds one needed (velt_common `ON_DEMAND_MODULES`, docs/internals/design/lazy-std.md).
// Lowering converts and writes every number through these or std's float printing, with no
// runtime fallback (#2197, #2196): sema checks them where live code has a construct whose lowering
// calls them (velt_common `hook_demand.rs`). A float goes to std's float printing by role
// (`number_shortest`, prebuilt), so that a program whose own code converts no float doesn't check
// that printing; one that does loads velt/lang/hooks/number_float, which lowering prefers.
// `console.log`'s float writer is in velt/lang/hooks/number_write.

import { hookCall, trunc } from "velt/lang/intrinsics";
import { i64Text, pushI64, pushU64, u64Text } from "velt/lang/number/integer";
import { digitsWrite } from "velt/lang/number/integer_write";

declare function velt_rt_strbuf_push_str(buf: string, s: string);

/** `String(v)` of a signed integer (a template's `${v}`, `v.toString()`): lowering calls it. */
export function intText(v: i64): string {
  return i64Text(v);
}

/** `String(v)` of an unsigned integer. */
export function uintText(v: u64): string {
  return u64Text(v);
}

/** Appends `String(v)` of a signed integer to the builder `buf` (a template's `${v}`). */
export function intPush(buf: string, v: i64): void {
  pushI64(buf, v);
}

/** Appends `String(v)` of an unsigned integer to the builder `buf`. */
export function uintPush(buf: string, v: u64): void {
  pushU64(buf, v);
}

/**
 * Writes `String(v)` of a signed integer and the byte `end` (the space or newline after a
 * `console.log` argument) to standard output (`stream` 1) or standard error (2), in one write. The
 * text is at most 21 bytes (20 digits, or a minus and 19, then that byte), held inline: no
 * allocation.
 */
export function intWrite(stream: u32, v: i64, end: u8): void {
  const neg = v < 0;
  digitsWrite(stream, neg ? ~(v as u64) + 1 : v as u64, neg, end);
}

/** Writes `String(v)` of an unsigned integer and `end` to `stream`, as `intWrite`. */
export function uintWrite(stream: u32, v: u64, end: u8): void {
  digitsWrite(stream, v, false, end);
}

/** Is `x` a whole number below 2^53 in magnitude (`-0` included)? Its text is the integer's. */
export function whole(x: f64): bool {
  return x == trunc(x) && x < 9007199254740992.0 && x > -9007199254740992.0;
}

/**
 * `String(x)` of a float (`${x}` alone, `x.toString()`) where std's float printer is not loaded
 * inline: std's float printing by role (`number_shortest`), whole numbers included, so that this
 * reaches none of std's integer printing (`velt_opt` numrep calls `intText` instead where it knows
 * `x` is a whole number and the program has that).
 */
export function numberText(x: f64): string {
  return hookCall("number_shortest", x);
}

/** Appends `String(x)` of a float to the builder `buf` (a template's `${x}`), as `numberText`. */
export function numberPush(buf: string, x: f64): void {
  const text: string = hookCall("number_shortest", x);
  velt_rt_strbuf_push_str(buf, text);
}

/**
 * Appends a float to the builder `buf` as `console.log` prints it: `-0` is `-0`, anything else as
 * `numberPush` appends it (the formatting glue of a float).
 */
export function numberInspectPush(buf: string, x: f64): void {
  if (x == 0 && 1.0 / x < 0) {
    velt_rt_strbuf_push_str(buf, "-0");
    return;
  }
  numberPush(buf, x);
}
