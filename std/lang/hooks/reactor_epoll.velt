// velt/lang/hooks (internal): the executor's reactor on Linux (sched_io.velt, #2649 step 2):
// epoll. A socket is registered once, for reading and writing, edge-triggered (`EPOLLET`), with
// its source (sched_io.velt) as the event's data; the worker's idle wait is an `epoll_wait`, and a
// wake from another thread writes an eventfd registered with data 0.
//
// Also the few OS calls a non-blocking socket needs whose details differ per OS: `errno`, the
// socket flags (`SOCK_NONBLOCK | SOCK_CLOEXEC` at creation), `MSG_NOSIGNAL` on every send.
// `struct epoll_event` is packed on x86-64 (12 bytes, data at 4) and natural elsewhere (16, data
// at 8): the block records which at `open`.

import { Ptr } from "velt/ffi/ptr";
import { velt_rt_os_arch } from "velt/os/rt";
import * as m from "./sched_mem";

/** Does this OS have the reactor? (The default variant has not: sockets stay the runtime's.) */
export const SUPPORTED: bool = true;

export const EAGAIN: i32 = 11;
export const EINPROGRESS: i32 = 115;
export const EINTR: i32 = 4;
/** `CLOCK_MONOTONIC`. */
export const MONOTONIC: i32 = 1;
/** `send`'s flags: `MSG_NOSIGNAL` (a closed peer is EPIPE, not SIGPIPE). */
export const SEND_FLAGS: i32 = 0x4000;
/** `socket`'s extra type flags: `SOCK_NONBLOCK | SOCK_CLOEXEC`. */
export const SOCKET_FLAGS: i32 = 0x80800;
/** `sysconf`'s name of the online cores (`_SC_NPROCESSORS_ONLN`; 0: none). */
export const SC_NPROCESSORS_ONLN: i32 = 84;

// Readiness bits of an event (sched_io.velt).
const READ: u32 = 1;
const WRITE: u32 = 2;
const HUP: u32 = 4;
const ERR: u32 = 8;

const EPOLLIN: u32 = 0x1;
const EPOLLOUT: u32 = 0x4;
const EPOLLERR: u32 = 0x8;
const EPOLLHUP: u32 = 0x10;
const EPOLLRDHUP: u32 = 0x2000;
const EPOLLET: u32 = 0x80000000;
const EPOLL_CTL_ADD: i32 = 1;
const EPOLL_CTL_DEL: i32 = 2;
const EPOLL_CLOEXEC: i32 = 0x80000;
const EFD_NONBLOCK_CLOEXEC: i32 = 0x80800;

/** Events one wait takes at most. */
const MAX_EVENTS: usize = 64;

// The reactor's block: the epoll and event descriptors, an event's size and its data's offset,
// an event to register, a scratch word for the eventfd, the events of the last wait.
const R_EP: usize = 0;
const R_EVFD: usize = 8;
const R_STRIDE: usize = 16;
const R_DATA: usize = 24;
const R_CHANGE: usize = 32;
const R_WORD: usize = 48;
/** The eventfd's increment that `wake` writes (1), read only. */
const R_ONE: usize = 56;
const R_EVENTS: usize = 64;
const R_SIZE: usize = 64 + 64 * 16;

declare c("c") function epoll_create1(flags: i32): i32;
// Pointers are `Ptr`s and integers the C types', as in a program's own declarations of these
// symbols (`declare system function read(fd: i32, buf: u8[]): isize` passes a pointer and a
// `size_t`): one C symbol has one signature in a program. Addresses become `Ptr`s with `m.ptr`.
declare c("c") function epoll_ctl(ep: i32, op: i32, fd: i32, event: Ptr<u8>): i32;
declare c("c") function epoll_wait(ep: i32, events: Ptr<u8>, max: i32, timeout: i32): i32;
declare c("c") function eventfd(initval: u32, flags: i32): i32;
declare c("c") function read$io(fd: i32, buf: Ptr<u8>, n: usize): isize;
declare c("c") function write$io(fd: i32, buf: Ptr<u8>, n: usize): isize;
// The signature the compiler calls it with for `lastOsError()` (velt_vir system/posix.rs): one
// C symbol has one signature in a program.
declare c("c") function __errno_location(): Ptr<i32>;
declare c("c") function accept4(fd: i32, addr: Ptr<u8>, len: Ptr<u8>, flags: i32): i32;

/** The calling thread's `errno`. */
export function errno(): i32 {
  // SAFETY: `__errno_location` returns the thread's errno slot.
  return m.ld32(Ptr.addressOf(unsafe { __errno_location() })) as i32;
}

/** A new reactor: its block, or 0 when the OS refused an epoll or eventfd. */
export function open(): usize {
  // SAFETY: no precondition.
  const ep = unsafe { epoll_create1(EPOLL_CLOEXEC) };
  // SAFETY: no precondition.
  const evfd = unsafe { eventfd(0, EFD_NONBLOCK_CLOEXEC) };
  if (ep < 0 || evfd < 0) {
    return 0;
  }
  const r = m.lastingZeroed(R_SIZE);
  m.st(r + R_EP, ep as usize);
  m.st(r + R_EVFD, evfd as usize);
  m.st(r + R_ONE, 1);
  const packed = velt_rt_os_arch() === "x64";
  m.st(r + R_STRIDE, packed ? 12 : 16);
  m.st(r + R_DATA, packed ? 4 : 8);
  ctl(r, EPOLL_CTL_ADD, evfd, EPOLLIN | EPOLLET, 0);
  return r;
}

/**
 * `epoll_ctl` `op` of `fd` for `events` with data `data`, in a record of the caller's (from any
 * thread: a source follows its task to another worker's reactor); 0 or errno.
 */
function ctl(r: usize, op: i32, fd: i32, events: u32, data: usize): i32 {
  const c = m.zeroed(16);
  m.st32(c, events);
  // An unaligned word on x86-64 (data at 4): two halves.
  const at = c + m.ld(r + R_DATA);
  m.st32(at, (data & 0xffffffff) as u32);
  m.st32(at + 4, (data >> 32) as u32);
  // SAFETY: one event at `c`.
  const n = unsafe { epoll_ctl(m.ld(r + R_EP) as i32, op, fd, m.ptr(c)) };
  m.release(c, 16);
  return n < 0 ? errno() : 0;
}

/** Registers `fd` for both directions, edge-triggered, with `source` its events' tag; 0 or errno. */
export function add(r: usize, fd: i32, source: usize): i32 {
  return ctl(r, EPOLL_CTL_ADD, fd, EPOLLIN | EPOLLOUT | EPOLLRDHUP | EPOLLET, source);
}

/** Does `exitFd` give a descriptor to close? Yes: a pidfd. */
export const EXIT_FD_OWNED: bool = true;

/** `pidfd_open` on every architecture (the generic syscall table's number). */
const PIDFD_OPEN: i64 = 434;

/**
 * A pidfd of child `pid` (readable once it has exited), close-on-exec as every pidfd is; -1
 * with `errno` set when the kernel has none (before 5.3).
 */
export function exitFd(pid: i32): i32 {
  // SAFETY: pidfd_open takes a process id and flags 0; the result is checked.
  return unsafe { syscall(PIDFD_OPEN, pid as i64, 0, 0, 0, 0, 0) } as i32;
}

/** Watches pidfd `exit` (`exitFd`'s) in reactor `r`: readable once the child exited; 0 or errno. */
export function watchExit(r: usize, exit: i32, source: usize): i32 {
  return ctl(r, EPOLL_CTL_ADD, exit, EPOLLIN | EPOLLET, source);
}

/** `watchExit`'s answer for a child that has exited already (never: the pidfd says so). */
export const EXITED: i32 = -1;

/** `posix_spawnattr_setflags`' extra flags for a child process: none (pipes are `pipe2`'s). */
export const SPAWN_FLAGS: i16 = 0;

declare c("c") function pipe2(fds: Ptr<u8>, flags: i32): i32;

/** `O_CLOEXEC`. */
const O_CLOEXEC: i32 = 0x80000;

/**
 * A pipe at `fds` (read end, write end), both close-on-exec from the start, so a child another
 * thread spawns meanwhile gets neither; 0, or -1 with `errno` set.
 */
export function pipeCloexec(fds: usize): i32 {
  // SAFETY: room for two descriptors.
  return unsafe { pipe2(m.ptr(fds), O_CLOEXEC) };
}

declare c("c") function dlsym(handle: Ptr<u8>, name: readonly u8[]): Ptr<u8> | null;

/**
 * `"environ"` and its NUL, the name `environ()` asks `dlsym` for. Bytes, not a `CString`: velt/ffi/c_string
 * imports velt/encoding, whose error classes extend the prelude's `Error`, and this module is
 * loaded while sema checks (std/lang/hooks/sched.velt is demanded then, #2161 (a1)), where a
 * module that subclasses a class of another module cannot be served.
 */
const ENVIRON_NAME: readonly u8[] = [0x65, 0x6e, 0x76, 0x69, 0x72, 0x6f, 0x6e, 0];

/**
 * The process's environment as C has it (`char **environ`, NULL-terminated), for a child that
 * keeps it unchanged; 0 when it can't be found. `declare c` can't read a C variable, so its
 * address comes from `dlsym` (`RTLD_DEFAULT`, a null handle here).
 */
export function environ(): usize {
  // SAFETY: a NUL-terminated name; `dlsym` returns the variable's address or NULL.
  const at = m.addr(unsafe { dlsym(m.ptr(0), ENVIRON_NAME) });
  return at === 0 ? 0 : m.ld(at);
}

/** Keeps descriptor `fd` the child's: nothing to do here (no `SPAWN_FLAGS`). */
export function spawnInherit(fa: usize, fd: i32): void {}

/** Takes `fd` out of reactor `r` (from any thread): its events come to another reactor now. */
export function del(r: usize, fd: i32): void {
  ctl(r, EPOLL_CTL_DEL, fd, 0, 0);
}

/**
 * Waits for events, at most `timeoutMs` milliseconds (-1: until one comes, 0: only those ready):
 * how many the block holds now (`source`, `bits`). A wake's event resets the eventfd.
 */
export function wait(r: usize, timeoutMs: i64): usize {
  const t = timeoutMs < 0 ? -1 : timeoutMs > 0x7fffffff ? 0x7fffffff : timeoutMs;
  const ep = m.ld(r + R_EP) as i32;
  // SAFETY: the block has room for MAX_EVENTS events of the largest size.
  const n = unsafe { epoll_wait(ep, m.ptr(r + R_EVENTS), MAX_EVENTS as i32, t as i32) };
  if (n <= 0) {
    return 0;
  }
  for (let i: usize = 0; i < (n as usize); i++) {
    if (source(r, i) === 0) {
      // SAFETY: an 8-byte read of the eventfd's counter into the block.
      unsafe {
        read$io(m.ld(r + R_EVFD) as i32, m.ptr(r + R_WORD), 8);
      }
    }
  }
  return n as usize;
}

/** The source of event `i` of the last wait (0: the wake). */
export function source(r: usize, i: usize): usize {
  const at = r + R_EVENTS + i * m.ld(r + R_STRIDE) + m.ld(r + R_DATA);
  return (m.ld32(at) as usize) | ((m.ld32(at + 4) as usize) << 32);
}

/** The readiness bits of event `i` of the last wait. */
export function bits(r: usize, i: usize): u32 {
  const ev = m.ld32(r + R_EVENTS + i * m.ld(r + R_STRIDE));
  let b: u32 = 0;
  if ((ev & EPOLLIN) !== 0) {
    b = b | READ;
  }
  if ((ev & EPOLLOUT) !== 0) {
    b = b | WRITE;
  }
  if ((ev & (EPOLLHUP | EPOLLRDHUP)) !== 0) {
    b = b | HUP | READ;
  }
  if ((ev & EPOLLERR) !== 0) {
    b = b | ERR | READ | WRITE;
  }
  return b;
}

/** Wakes the worker waiting in `wait` (from any thread). */
export function wake(r: usize): void {
  // SAFETY: an 8-byte write of 1 to the eventfd, from the block (no allocation: a thread may
  // wake a worker while the process ends).
  unsafe {
    write$io(m.ld(r + R_EVFD) as i32, m.ptr(r + R_ONE), 8);
  }
}

/** Accepts a connection of listener `fd`, non-blocking and close-on-exec: its fd, or -1. */
export function accept(fd: i32, addr: usize, len: usize): i32 {
  // SAFETY: `addr` holds the `socklen_t` at `len` bytes.
  return unsafe { accept4(fd, m.ptr(addr), m.ptr(len), SOCKET_FLAGS) };
}

/** Nothing more to set on Linux (`SOCKET_FLAGS`, `SEND_FLAGS`); 0. */
export function prepare(fd: i32): i32 {
  return 0;
}

const FUTEX_WAIT_PRIVATE: i64 = 128;
const FUTEX_WAKE_PRIVATE: i64 = 129;

declare c("c") function syscall(n: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64): i64;

/** The futex call's number on this architecture. */
function futexNumber(): i64 {
  return velt_rt_os_arch() === "arm64" ? 98 : 202;
}

/**
 * Sleeps while the `u32` at `word` is `expected` (a lock's waiters: sched_module.velt); it may
 * return early, so the caller looks again.
 */
export function wordWait(word: usize, expected: u32): void {
  const n = futexNumber();
  // SAFETY: `word` is an aligned word that lives as long as the process; no timeout.
  unsafe {
    syscall(n, word as i64, FUTEX_WAIT_PRIVATE, expected as i64, 0, 0, 0);
  }
}

/**
 * `wordWait` for at most `us` microseconds (the stall monitor's nap, cut short by a wake).
 */
export function wordWaitFor(word: usize, expected: u32, us: u32): void {
  const n = futexNumber();
  // The thread's own buffer: the process may end during the nap.
  const ts = m.scratch();
  m.st(ts, (us / 1000000) as usize);
  m.st(ts + 8, ((us % 1000000) * 1000) as usize);
  // SAFETY: as `wordWait`; a relative timespec at `ts`.
  unsafe {
    syscall(n, word as i64, FUTEX_WAIT_PRIVATE, expected as i64, ts as i64, 0, 0);
  }
}

/** Wakes one thread sleeping on the `u32` at `word`, if any. */
export function wordWake(word: usize): void {
  const n = futexNumber();
  // SAFETY: as `wordWait`.
  unsafe {
    syscall(n, word as i64, FUTEX_WAKE_PRIVATE, 1, 0, 0, 0);
  }
}

declare c("c") function pthread_self(): usize;
declare c("c") function pthread_getcpuclockid(thread: usize, clock: Ptr<u8>): i32;
declare c("c") function clock_gettime$io(clock: i32, ts: Ptr<u8>): i32;

/**
 * This thread's CPU-time clock, which `threadCpu` reads from any thread (the stall monitor: a
 * worker the OS took off its core is not stalled in a poll); 0 when there is none.
 */
export function threadClock(): u64 {
  const a = m.scratch();
  m.st(a, 0);
  let c: u64 = 0;
  // SAFETY: `a` has room for a `clockid_t`.
  unsafe {
    if (pthread_getcpuclockid(pthread_self(), m.ptr(a)) === 0) {
      c = (m.ld32(a) as u64) | 0x100000000;
    }
  }
  return c;
}

/** The CPU time of the thread whose `threadClock` is `c` (nanoseconds; 0: unknown). */
export function threadCpu(c: u64): u64 {
  if (c === 0) {
    return 0;
  }
  // The monitor's own buffer (it reads the clock while the process may end).
  const ts = m.scratch();
  m.st(ts, 0);
  m.st(ts + 8, 0);
  // SAFETY: a timespec at `ts`; the clock is a live thread's (workers run until the end).
  unsafe {
    clock_gettime$io((c & 0xffffffff) as u32 as i32, m.ptr(ts));
  }
  return (m.ld(ts) * 1000000000 + m.ld(ts + 8)) as u64;
}
