// velt/lang/hooks (internal): the compiler's hooks for `JSON` (std-layout.md §10b), loaded with
// the global `JSON` (std/prelude/global/json.vlt), so a program that never names it loads none of
// the JSON engine.

import { jsonFlags, jsonMaxDepth } from "velt/encoding/json/options";
import { parseJsonTop } from "velt/encoding/json/generated";
import { FLAG_NULL_NOT_ABSENT } from "velt/encoding/json/reader";
import { JsonParseOptions } from "velt/prelude/json/json_error";

/**
 * `JSON.parse(text)` with its type from the context (`JSON.parse(text) as T`,
 * `const t: T = JSON.parse(text)`, TypeScript's forms; sema calls this for them): `JSON.parse<T>`,
 * except that a JSON `null` for an optional field whose type has no `null` (`a?: string`) fails
 * the decode, as a value of another type does (JavaScript would give the field a `null` its type
 * can't hold).
 */
export function jsonParseFromContext<T>(text: string, options: JsonParseOptions | null = null): T {
  return parseJsonTop<T>(
    text,
    jsonFlags(options, FLAG_NULL_NOT_ABSENT as i64),
    jsonMaxDepth(options),
  );
}
