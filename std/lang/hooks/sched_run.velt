// velt/lang/hooks (internal): a poll of a task of the executor in Velt (sched.velt, #2649):
// `run`, the started promises woken since its last poll, its sleeps due to fire, its root, its
// microtasks; each piece only when the task has them, so a task with no started promise, no due
// sleep and no queued microtask polls its root and nothing else; the end of its root and of the
// task, and its join handle. The worker loop around it is sched_loop.velt.

import { inline, noInline, statePoll, stdUsed } from "velt/lang/intrinsics";
import * as bd from "./sched_budget";
import * as fi from "./sched_fire";
import * as jn from "./sched_join";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as mod from "./sched_module";
import * as node from "./sched_node";
import * as wn from "./sched_node_woken";
import * as rp from "./sched_node_report";
import * as nc from "./sched_node_catch";
import * as order from "./sched_order";
import * as q from "./sched_queue";
import * as dn from "./sched_run_done";
import * as sl from "./sched_sleep";
import * as sc from "./sched_sleep_carry";
import * as t from "./sched_task";
import * as lt from "./sched_task_lost";
import * as wk from "./sched_wake";
import * as wa from "./sched_wake_away";
import * as yl from "./sched_yield";
import * as ls from "./sched_yield_list";
import * as tn from "./sched_yield_turn";

/**
 * Polls task `k` once: its woken started promises, its due sleeps, its root, its microtasks. A
 * task with no started promise, no due sleep, no queued microtask and a root still running takes
 * the straight path: its flags read once, the root polled, two words checked. A first poll in
 * shared mode marks the task started on its flags as they are then: `begin` may have changed them
 * since they were read (#3241).
 */
@inline("always")
export function run(e: usize, k: usize, mode: u32): void {
  if (stdUsed("nodeTimers") && mode !== 0) {
    // A new poll: no look found it busy yet (before the state's store, which publishes it).
    m.store32(k + t.T_SKIPPED, 0);
  }
  // A reference a wake handed this poll goes back before any park counts (sched_wake_away.velt).
  wa.polled(k, m.ld32(k + t.T_STATE));
  m.store32(k + t.T_STATE, t.RUNNING);
  // After the pop that took it (a release): the monitor reads a lazy worker 0's queue while the
  // poll runs (sched_monitor.velt `lazyDuties`). The only thread at the executor (mode 0, not
  // lazy) has no monitor: a plain store.
  if (mode === 0) {
    m.st(e + t.E_CURRENT, k);
  } else {
    m.storeRelease(e + t.E_CURRENT, k);
  }
  const fl = m.ld32(k + t.T_FLAGS);
  // Fresh tasks matter to other workers only (sched_monitor.velt).
  if (mode !== 0 && mode !== t.M_LAZY && (fl & t.STARTED) === 0) {
    t.flags(k, t.STARTED, 0);
  }
  // One test on the straight path: the root polled, nothing else (a task whose root catches
  // panics, sched_node_catch.velt `T_CATCHES`, that made stored yields, or whose root's turn was
  // placed in the last poll, `ROOT_ALONE`, polls it in `runOther`).
  if ((fl & (t.LOCALS | t.ROOT_DONE | t.TOUCHED | nc.T_CATCHES | t.FRESH | t.ROOT_ALONE)) === 0) {
    pollRunning(e, k);
  } else if (
    stdUsed("yields") &&
    (fl & TURNS) === (t.YIELDS | t.LOCALS | t.ROOT_ALONE) &&
    m.load(k + t.T_WOKEN) === 0
  ) {
    // Its whole poll, out of line: no other task pays for its end (`ended`).
    turnsPoll(e, k, mode);
    return;
  } else {
    runOther(e, k, fl);
  }
  ended(e, k, mode, false);
}

/**
 * The end of `run`'s poll of task `k`, once its root or its jobs ran: its microtasks, then the
 * task queued again, parked or finished. `yields`: tried first, the end of a task with yields
 * listed that holds neither the module lock nor a timer's turn (`runEnd`'s first case, in line).
 */
@inline("always")
function ended(e: usize, k: usize, mode: u32, yields: bool): void {
  if (m.ld(k + t.T_MICRO) !== 0 || m.ld(k + t.T_UNHANDLED) !== 0) {
    drain(e, k);
  }
  if (mode !== 0 && mode !== t.M_LAZY) {
    // Before anything below shows another thread that the poll ended (#2971).
    wk.publishPolled(e);
  }
  if (stdUsed("nodeTimers") && mode !== 0) {
    timersAfter(e, k);
  }
  if ((m.ld32(k + t.T_FLAGS) & (t.BATCHED | t.JOIN_DUE)) !== 0) {
    jn.polledFlags(e, k, mode);
  }
  m.st(e + t.E_CURRENT, 0);
  // A lazy worker 0's look after the poll (sched_loop.velt `alone`) reads `E_MODE` after this, and
  // the monitor stores `E_MODE`, then reads `E_CURRENT` (sched_monitor_lazy.velt `lazyDuties`):
  // each side must see the other's write. Every path from here to the look passes a
  // sequentially consistent store or read-modify-write (the state's `cas32` or `store32` here, in
  // `runEnd` and `finish`, a wake's state CAS), the fence that pair needs; a release store would
  // not do (a store then a load may pass each other on x86-64 and arm64).
  const end = m.ld32(k + t.T_FLAGS);
  if (yields && (end & (t.YIELDS | t.HOLDS | t.TOUCHED)) === t.YIELDS) {
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  } else if ((end & (t.LOCALS | t.ROOT_DONE | t.HOLDS | t.TOUCHED)) !== 0) {
    runEnd(e, k, mode);
  } else if (m.cas32(k + t.T_STATE, t.RUNNING, t.IDLE) !== t.RUNNING) {
    // Woken during its poll.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    if (again(e, mode)) {
      m.st(e + t.E_AGAIN, k);
    } else {
      q.lock(e, mode);
      q.pushRest(e, k, mode);
      q.unlock(e, mode);
    }
  }
}

/**
 * Does the task worker `e` polled, woken during its poll, wait in `E_AGAIN` rather than queue
 * (`mode` as `run`'s)? On a lazy worker 0, until the look after the poll; on a shared worker
 * with its queues empty, it runs next from there with no lock, a push or a pop (sched_loop.velt
 * `turnShared` queues it once anything else is queued first). What it printed was published at
 * its poll's end all the same (`run`).
 */
@inline("always")
function again(e: usize, mode: u32): bool {
  return mode === t.M_LAZY || (mode !== 0 && q.ownEmpty(e));
}

/**
 * `run`'s poll of task `k` (flags `fl`) off the straight path: its stored yields' generation
 * moves on (sched_yield.velt `begin`); a task touching the program's module state takes its lock
 * first; then its woken promises and sleeps, or its root unless it is done (through the catch
 * when it catches).
 */
@noInline
function runOther(e: usize, k: usize, fl: u32): void {
  // The stamp + 1 of the root's turn this poll has with no record (0: none).
  let rootTurn: usize = 0;
  if (stdUsed("yields")) {
    yl.begin(k, fl);
    if ((fl & t.ROOT_ALONE) !== 0) {
      // The root's turn placed in the last poll (kept while its block was parked) is this one's:
      // first, before the root's records listed after it (`ls.join` made none for it), or the
      // poll itself when none are.
      t.flags(k, 0, t.ROOT_ALONE);
      if ((fl & t.YIELDS) !== 0) {
        rootTurn = tn.rootTurn(k);
      } else {
        ls.park(k);
      }
    }
  }
  if ((fl & t.TOUCHED) !== 0) {
    mod.enter();
  }
  if ((fl & t.CANCEL) !== 0 && cancelled(k)) {
    // Nothing can wake it: its root is dropped, not polled (sched_task_lost.velt).
  } else if ((fl & t.LOCALS) !== 0) {
    runWoken(e, k, fl, rootTurn);
  } else if ((fl & (t.ROOT_DONE | nc.T_CATCHES)) === 0) {
    pollRunning(e, k);
  } else if ((fl & t.ROOT_DONE) === 0) {
    pollRootCaught(e, k);
  }
}

/**
 * The flags `turnsPoll` asks about: those that give a poll a job other than its yields' turns (a
 * new yield generation, a due or a carried sleep, the module lock, its root's drop). `CANCEL` never
 * comes with yields listed (`runEnd` looks for those first); it is here so that this does not rest
 * on that.
 */
const TURNS: u32 =
  t.YIELDS | t.LOCALS | t.ROOT_ALONE | t.FRESH | t.TIMED | t.CARRIED | t.TOUCHED | t.CANCEL;

/**
 * `run`'s poll, from its jobs to its end, of a task whose only jobs are its yields' turns, the
 * first its root's, placed in the last poll with no record (the children of an inline `Promise.all`
 * its root awaits, #3781): no stored yield, due sleep, carried sleep, woken promise or module lock
 * (`TURNS`, `run`). `runOther`'s steps that are left, then the poll's end, where yields are mostly
 * listed again.
 */
@noInline
function turnsPoll(e: usize, k: usize, mode: u32): void {
  rootTurns(e, k);
  ended(e, k, mode, true);
}

/** `turnsPoll`'s jobs: `runWoken`'s steps that are left for such a task. */
@inline("always")
function rootTurns(e: usize, k: usize): void {
  t.flags(k, 0, t.ROOT_ALONE | t.POLLED);
  fi.fireYields(e, k, tn.rootTurn(k));
  yieldsOver(k);
  if (!t.has(k, t.POLLED)) {
    bd.refill();
    pollRoot(e, k);
  }
}

/**
 * The last poll of task `k` (flag `CANCEL`), with the module lock held when it is touched: its
 * root is dropped if it is still parked for ever (sched_task_lost.velt `stillLost`). Otherwise its
 * park's verdict went stale meanwhile, and it is polled as any other (false).
 */
@noInline
function cancelled(k: usize): bool {
  if (lt.stillLost(k)) {
    lt.cancel(k);
    return true;
  }
  t.flags(k, 0, t.CANCEL);
  return false;
}

/**
 * The started promises of task `k` woken since its last poll, run in the order they were woken,
 * then its due sleeps and its yields (flags `TIMED` and `YIELDS`, which come with `LOCALS`: flags
 * `fl`; sched_fire.velt), then its root. A
 * microtask or a sleep that resumed the root meanwhile set flag `POLLED`: the root is not polled
 * again then, so a root that yielded there waits for the task's next poll.
 */
@inline("always")
function runWoken(e: usize, k: usize, fl: u32, rootTurn: usize): void {
  sc.adoptCarried(e, k, fl);
  t.flags(k, 0, t.POLLED);
  if ((fl & t.LOCALS) !== 0) {
    let n = wn.takeWoken(k);
    while (n !== 0) {
      const next = wn.nextWoken(n);
      node.run(k, n, true, 1);
      node.release(n);
      drain(e, k);
      n = next;
    }
  }
  if ((fl & t.TIMED) !== 0) {
    fi.fireDue(e, k);
  }
  if (stdUsed("yields") && (fl & t.YIELDS) !== 0) {
    fi.fireYields(e, k, rootTurn);
    yieldsOver(k);
  }
  if (!t.has(k, t.POLLED)) {
    // After its promises, the root's turn has a budget of its own (sched_budget.velt).
    bd.refill();
    pollRoot(e, k);
  }
}

/**
 * Task `k`'s yields had their turns. Unless yields made meanwhile are listed (one test then), its
 * block is parked (sched_yield_list.velt `park`) and its polls may be its root's alone again
 * (`leftLocals`).
 */
@inline("always")
function yieldsOver(k: usize): void {
  if (!t.has(k, t.YIELDS)) {
    ls.park(k);
    leftLocals(k);
  }
}

/**
 * After task `k`'s yields had their turns: with no started promise, no sleep and no yield left
 * (`T_LOCALS` 0, nothing woken, flags `YIELDS`, `TIMED` and `CARRIED` clear), nothing but its root is
 * left for its polls, and flag `LOCALS` goes, so they take the straight path again (#3687: a root
 * whose `Promise.all` children's yields took records). What makes another such job sets it again.
 */
@inline("always")
function leftLocals(k: usize): void {
  const other = t.YIELDS | t.TIMED | t.CARRIED;
  if (
    m.ld(k + t.T_LOCALS) === 0 &&
    (m.ld32(k + t.T_FLAGS) & other) === 0 &&
    m.load(k + t.T_WOKEN) === 0
  ) {
    t.flags(k, 0, t.LOCALS);
  }
}

/**
 * The end of a poll of task `k`, which drives promises, whose root is done, which took a Node
 * timer's turn (the loop moves on now: sched_order.velt), or which holds the module lock.
 */
@noInline
function runEnd(e: usize, k: usize, mode: u32): void {
  if (t.has(k, t.TOUCHED)) {
    mod.leave();
  }
  if (stdUsed("nodeTimers")) {
    if (t.has(k, t.HOLDS)) {
      order.released(e, k);
    }
  }
  if (ls.waiting(k)) {
    // Yields made during this poll have their turn in its next one (sched_fire.velt); the task
    // does not finish before.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  } else if (t.has(k, t.ROOT_DONE) && m.ld(k + t.T_LOCALS) === 0) {
    dn.finish(e, k);
  } else if (m.load(k + t.T_WOKEN) !== 0) {
    // Promises woken during this poll run in its next one.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  } else if (lt.parks(k)) {
    // Parked for ever: one more poll, which drops its root (sched_task_lost.velt `cancel`).
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  } else if (m.cas32(k + t.T_STATE, t.RUNNING, t.IDLE) !== t.RUNNING) {
    // Woken during its poll.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  }
}

/**
 * The poll of task `k` ends (its microtasks too), with other threads at the executor: from now on
 * a look at Node's timer order takes it as not busy (`SK_ENDING`). When a look passed over one of
 * its timers meanwhile (`SK_SKIPPED`), the order moves on now, unless its turn's end does that
 * (`HOLDS`, in `runEnd`): no other worker would look before its next park or I/O tick. One
 * read-modify-write on the word a look marks with another (sched_order_pass.velt `busy`): either
 * the look's mark comes first and is seen here, or the look sees the poll ending.
 */
@inline("always")
function timersAfter(e: usize, k: usize): void {
  if ((m.or32(k + t.T_SKIPPED, t.SK_ENDING) & t.SK_SKIPPED) !== 0 && !t.has(k, t.HOLDS)) {
    order.busyEnded(e, k);
  }
}

/** Queues task `k` again after its poll (`mode` as `run`'s), or leaves it in `E_AGAIN`. */
function requeue(e: usize, k: usize, mode: u32): void {
  if (again(e, mode)) {
    m.st(e + t.E_AGAIN, k);
  } else {
    wk.push(e, k);
  }
}

/** Polls task `k`'s root, unless it is done; through the catch when it catches. */
@inline("always")
function pollRoot(e: usize, k: usize): void {
  if ((m.ld32(k + t.T_FLAGS) & (t.ROOT_DONE | nc.T_CATCHES)) !== 0) {
    if (!t.has(k, t.ROOT_DONE)) {
      pollRootCaught(e, k);
    }
    return;
  }
  pollRunning(e, k);
}

/**
 * Polls the root of task `k`, spawned while a catching poll ran, through the catch
 * (std/task/catch_sched.velt `caughtPoll`, at worker 0's `E_CATCH_POLL`). A panic makes the root
 * done with no result (sched_join.velt `rootPanicked`).
 */
@noInline
function pollRootCaught(e: usize, k: usize): void {
  const r = nc.caughtPoll(e, m.ld(k + t.T_POLL), m.ld(k + t.T_ROOT), k + t.T_CX);
  if (r === 1) {
    dn.rootDone(e, k);
  } else if (r === 2) {
    jn.rootPanicked(e, k, nc.caughtPanic(e));
  }
}

/** Polls the root of task `k`, not done. */
@inline("always")
function pollRunning(e: usize, k: usize): void {
  // SAFETY: `k`'s root is the state of its poll function, not finished; `k + T_CX` is its cx.
  const ready = unsafe { statePoll(m.ld(k + t.T_POLL), m.ld(k + t.T_ROOT), k + t.T_CX) };
  if (ready === 1) {
    dn.rootDone(e, k);
  }
}

/** Runs task `k`'s microtasks, those queued meanwhile too: each resumes its waiter directly. */
@noInline
export function drain(e: usize, k: usize): void {
  if (m.ld(k + t.T_MICRO) === 0) {
    if (m.ld(k + t.T_UNHANDLED) !== 0) {
      rp.report(k);
    }
    return;
  }
  while (true) {
    const w = micro.pop(k);
    if (w === 0) {
      // Rejections nobody handled, reported now that the queue is empty.
      if (m.ld(k + t.T_UNHANDLED) !== 0) {
        rp.report(k);
      }
      return;
    }
    // A microtask's job runs: a due sleep it polls does not fire itself (sched_sleep.velt).
    m.st(e + t.E_JOB, m.ld(e + t.E_JOB) + 1);
    if (w === k) {
      // The queue's reference first, as `fireDue`'s.
      wk.release(k);
      pollRootAgain(e, k);
    } else if (node.ownNode(k, w)) {
      node.run(k, w, false, 1);
      node.release(w);
    } else {
      micro.forgetLast(k);
      m.wakeOwned(w);
    }
    m.st(e + t.E_JOB, m.ld(e + t.E_JOB) - 1);
    t.flags(k, 0, t.CREDIT);
  }
}

/** Polls task `k`'s root from a microtask or a due sleep, unless it is done; marks it polled. */
export function pollRootAgain(e: usize, k: usize): void {
  pollRoot(e, k);
  t.flags(k, t.POLLED, 0);
}
