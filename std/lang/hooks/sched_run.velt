// velt/lang/hooks (internal): a poll of a task of the executor in Velt (sched.velt, #2649):
// `run`, the started promises woken since its last poll, its sleeps due to fire, its root, its
// microtasks; each piece only when the task has them, so a task with no started promise, no due
// sleep and no queued microtask polls its root and nothing else; the end of its root and of the
// task, and its join handle. The worker loop around it is sched_loop.velt.

import { export as cExport } from "velt/ffi";
import {
  exportedAddress,
  futDrop,
  futPoll,
  inline,
  noInline,
  stateDrop,
  statePoll,
} from "velt/lang/intrinsics";
import * as lk from "./sched_lock";
import * as m from "./sched_mem";
import * as mk from "./sched_make";
import * as micro from "./sched_micro";
import * as mod from "./sched_module";
import * as node from "./sched_node";
import * as order from "./sched_order";
import * as q from "./sched_queue";
import * as sl from "./sched_sleep";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/**
 * Polls task `k` once: its woken started promises, its due sleeps, its root, its microtasks. A
 * task with no started promise, no due sleep, no queued microtask and a root still running takes
 * the straight path: its flags read once, the root polled, two words checked.
 */
@inline
export function run(e: usize, k: usize, mode: u32): void {
  m.store32(k + t.T_STATE, t.RUNNING);
  // After the pop that took it (a release): the monitor reads a lazy worker 0's queue while the
  // poll runs (sched_monitor.velt `lazyDuties`).
  m.storeRelease(e + t.E_CURRENT, k);
  const fl = m.ld32(k + t.T_FLAGS);
  // Fresh tasks matter to other workers only (sched_monitor.velt).
  if (mode !== 0 && mode !== t.M_LAZY && (fl & t.STARTED) === 0) {
    m.st32(k + t.T_FLAGS, fl | t.STARTED);
  }
  if ((fl & t.TOUCHED) !== 0) {
    mod.enter();
  }
  if ((fl & t.LOCALS) !== 0) {
    runWoken(e, k, fl);
  } else if ((fl & t.ROOT_DONE) === 0) {
    pollRoot(e, k);
  }
  if (m.ld(k + t.T_MICRO) !== 0 || m.ld(k + t.T_UNHANDLED) !== 0) {
    drain(e, k);
  }
  m.st(e + t.E_CURRENT, 0);
  // A lazy worker 0's look after the poll (sched_loop.velt `alone`) reads `E_MODE` after this, and
  // the monitor stores `E_MODE`, then reads `E_CURRENT` (sched_monitor_lazy.velt `lazyDuties`):
  // each side must see the other's write. Every path from here to the look passes a
  // sequentially consistent store or read-modify-write (the state's `cas32` or `store32` here, in
  // `runEnd` and `finish`, a wake's state CAS), the fence that pair needs; a release store would
  // not do (a store then a load may pass each other on x86-64 and arm64).
  if ((m.ld32(k + t.T_FLAGS) & (t.LOCALS | t.ROOT_DONE | t.HOLDS | t.TOUCHED)) !== 0) {
    runEnd(e, k, mode);
  } else if (m.cas32(k + t.T_STATE, t.RUNNING, t.IDLE) !== t.RUNNING) {
    // Woken during its poll.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    if (mode === t.M_LAZY) {
      m.st(e + t.E_AGAIN, k);
    } else {
      q.lock(e, mode);
      q.pushRest(e, k, mode);
      q.unlock(e, mode);
    }
  }
}

/**
 * The started promises of task `k` woken since its last poll, run in the order they were woken,
 * then its due sleeps (flag `TIMED`, which comes with `LOCALS`: flags `fl`), then its root. A
 * microtask or a sleep that resumed the root meanwhile set flag `POLLED`: the root is not polled
 * again then, so a root that yielded there waits for the task's next poll.
 */
@noInline
function runWoken(e: usize, k: usize, fl: u32): void {
  t.flags(k, 0, t.POLLED);
  if ((fl & t.LOCALS) !== 0) {
    let n = node.takeWoken(k);
    while (n !== 0) {
      const next = node.nextWoken(n);
      node.run(k, n, true);
      node.release(n);
      drain(e, k);
      n = next;
    }
  }
  if ((fl & t.TIMED) !== 0) {
    fireDue(e, k);
  }
  if (!t.has(k, t.POLLED)) {
    pollRoot(e, k);
  }
}

/**
 * Fires task `k`'s due sleeps one at a time, in timer order (sched_sleep.velt): each resumes its
 * waiter at once, and the task's microtasks run before the next, as in Node's timer phase. A
 * waiter that polls several sleeps (`Promise.all`) finds only those fired so far ready. A waiter
 * woken meanwhile (it yielded) is not resumed again in this poll: that sleep and the ones after
 * it fire in the next. A root woken during a step by something else (a combinator of the
 * runtime) resumes before the next sleep fires, as Node runs a settled promise's reaction before
 * the next timer.
 */
function fireDue(e: usize, k: usize): void {
  t.flags(k, 0, t.TIMED);
  // The root was woken while it was polled here: it is not polled again in this poll.
  let woken = false;
  while (true) {
    const f = sl.firstDue(k);
    if (f === 0) {
      return;
    }
    const w0 = sl.waiter(f);
    const own = w0 !== k && node.ownNode(k, w0);
    if (w0 === k ? woken : own && node.queued(w0)) {
      t.flags(k, t.TIMED, 0);
      return;
    }
    const w = sl.fire(k, f);
    if (w === k) {
      pollRootAgain(e, k);
      wk.release(k);
      drain(e, k);
      woken = m.load32(k + t.T_STATE) === t.NOTIFIED;
    } else {
      if (own) {
        node.run(k, w, false);
        node.release(w);
      } else {
        m.wakeOwned(w);
      }
      drain(e, k);
      if (!woken && !t.has(k, t.ROOT_DONE) && m.load32(k + t.T_STATE) === t.NOTIFIED) {
        m.store32(k + t.T_STATE, t.RUNNING);
        pollRootAgain(e, k);
        drain(e, k);
        woken = m.load32(k + t.T_STATE) === t.NOTIFIED;
      }
    }
  }
}

/**
 * The end of a poll of task `k`, which drives promises, whose root is done, which took a Node
 * timer's turn (the loop moves on now: sched_order.velt), or which holds the module lock.
 */
@noInline
function runEnd(e: usize, k: usize, mode: u32): void {
  if (t.has(k, t.TOUCHED)) {
    mod.leave();
  }
  if (t.has(k, t.HOLDS)) {
    order.released(e, k);
  }
  if (t.has(k, t.ROOT_DONE) && m.ld(k + t.T_LOCALS) === 0) {
    finish(e, k);
  } else if (m.load(k + t.T_WOKEN) !== 0) {
    // Promises woken during this poll run in its next one.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  } else if (m.cas32(k + t.T_STATE, t.RUNNING, t.IDLE) !== t.RUNNING) {
    // Woken during its poll.
    m.store32(k + t.T_STATE, t.SCHEDULED);
    requeue(e, k, mode);
  }
}

/** Queues task `k` again after its poll (`mode` as `run`'s: a lazy worker 0's after its look). */
function requeue(e: usize, k: usize, mode: u32): void {
  if (mode === t.M_LAZY) {
    m.st(e + t.E_AGAIN, k);
  } else {
    wk.push(e, k);
  }
}

/** Polls task `k`'s root, unless it is done. */
@inline
function pollRoot(e: usize, k: usize): void {
  if (t.has(k, t.ROOT_DONE)) {
    return;
  }
  // SAFETY: `k`'s root is the state of its poll function, not finished; `k + T_CX` is its cx.
  const ready = unsafe { statePoll(m.ld(k + t.T_POLL), m.ld(k + t.T_ROOT), k + t.T_CX) };
  if (ready === 1) {
    rootDone(e, k);
  }
}

/** Runs task `k`'s microtasks, those queued meanwhile too: each resumes its waiter directly. */
@noInline
function drain(e: usize, k: usize): void {
  if (m.ld(k + t.T_MICRO) === 0) {
    if (m.ld(k + t.T_UNHANDLED) !== 0) {
      node.report(k);
    }
    return;
  }
  while (true) {
    const w = micro.pop(k);
    if (w === 0) {
      // Rejections nobody handled, reported now that the queue is empty.
      if (m.ld(k + t.T_UNHANDLED) !== 0) {
        node.report(k);
      }
      return;
    }
    // A microtask's job runs: a due sleep it polls does not fire itself (sched_sleep.velt).
    m.st(e + t.E_JOB, m.ld(e + t.E_JOB) + 1);
    if (w === k) {
      pollRootAgain(e, k);
      wk.release(k);
    } else if (node.ownNode(k, w)) {
      node.run(k, w, false);
      node.release(w);
    } else {
      m.wakeOwned(w);
    }
    m.st(e + t.E_JOB, m.ld(e + t.E_JOB) - 1);
    t.flags(k, 0, t.CREDIT);
  }
}

/** Polls task `k`'s root from a microtask or a due sleep, unless it is done; marks it polled. */
function pollRootAgain(e: usize, k: usize): void {
  pollRoot(e, k);
  t.flags(k, t.POLLED, 0);
}

/** Task `k`'s root is done: its result to the join handle, its awaiter woken. */
function rootDone(e: usize, k: usize): void {
  const tr = m.ld(k + t.T_TRANSFER);
  if (tr !== 0) {
    // SAFETY: the finished root's result is at its state's offset 0; the glue transfers it in
    // place for the joining task (which may be on another worker), here, while promises the task
    // started (which may still use the result's objects) are on this thread.
    unsafe {
      stateDrop(tr, m.ld(k + t.T_ROOT));
    }
  }
  const rsize = m.ld(k + t.T_RESULT_SIZE);
  if (rsize !== 0) {
    m.copy(k + t.T_SLOT, m.ld(k + t.T_ROOT), rsize);
  }
  const g = m.ld(e + t.E_MAIN);
  if (e !== g && t.has(k, t.ROOT)) {
    // The root ran on another worker (the monitor moved it): what it printed reaches the OS
    // before worker 0 can see it done and end the process (stdout is buffered per thread).
    wk.handOffOutput();
  }
  t.flags(k, t.ROOT_DONE, 0);
  if (t.has(k, t.ROOT)) {
    if (m.ld(k + t.T_LOCALS) !== 0) {
      // Its started promises keep running after `main`.
      t.flags(k, t.COUNTED, 0);
      mk.liveUp(g, e);
    }
    if (e !== g) {
      // The root ran on another worker (the monitor moved it): worker 0 waits for it.
      wk.unpark(g);
    }
    return;
  }
  // The join handle may be polled or dropped on another thread meanwhile: the slot's lock (no
  // lock and one test with one thread at the executor: sched_lock.velt `LK_NONE`).
  let s: u32 = 0;
  let joiner: usize = 0;
  if (lk.mode() === lk.LK_NONE) {
    s = m.ld32(k + t.T_JOIN_STATE);
    joiner = m.ld(k + t.T_JOINER);
    m.st(k + t.T_JOINER, 0);
    m.st32(k + t.T_JOIN_STATE, s | t.J_DONE);
  } else {
    const kind = lk.kind();
    s = mk.lockJoin(k, kind);
    joiner = m.ld(k + t.T_JOINER);
    m.st(k + t.T_JOINER, 0);
    mk.unlockJoin(k, s | t.J_DONE, kind);
  }
  if (joiner !== 0) {
    // Behind the tasks queued already, not in the slot for the task to run next: a join of many
    // tasks (`Promise.all` of spawns) then polls once for the many that finished meanwhile.
    // A poll runs with no dispatch under way (a reactor turn's or timers' wakes poll nothing).
    m.st32(e + t.E_DISPATCH, t.D_OUTPUT);
    m.wakeOwned(joiner);
    m.st32(e + t.E_DISPATCH, 0);
  }
  if ((s & t.J_HANDLE) === 0) {
    dropResult(k);
  }
}

/** Task `k` is done: its root and the promises it drives. */
function finish(e: usize, k: usize): void {
  m.store32(k + t.T_STATE, t.DONE);
  micro.free(k);
  // Not the root of `main`, or that root counted as live.
  if ((m.ld32(k + t.T_FLAGS) & (t.ROOT | t.COUNTED)) !== t.ROOT) {
    const g = m.ld(e + t.E_MAIN);
    if (e !== g) {
      // What it printed reaches the OS before worker 0 can see it was the last live task and
      // end the process (stdout is buffered per thread), as for the root of `main` (`rootDone`).
      wk.handOffOutput();
    }
    if (mk.liveDown(g, e) === 1 && e !== g) {
      // The last live task: worker 0 may wait for that in `schedFinish`.
      wk.unpark(g);
    }
  }
  wk.release(k);
}

/** Drops task `k`'s result in its slot, which nobody claimed. */
function dropResult(k: usize): void {
  const rdrop = m.ld(k + t.T_RESULT_DROP);
  if (rdrop !== 0) {
    // SAFETY: the slot holds the result, which `rdrop` is the drop glue of.
    unsafe {
      stateDrop(rdrop, k + t.T_SLOT);
    }
  }
}

/**
 * The root of a task spawned from a heap future (sched.velt `schedSpawnFut`): polls it; once it
 * is ready, its result (the size 8 bytes before `root`) moves to `root` and it is freed.
 */
export function futRootPoll(root: usize, cx: usize): u32 {
  const f = m.ld(root - 16);
  // SAFETY: the task owns `f`, a live heap future until it is ready; `cx` is the task's.
  const ready = unsafe { futPoll(f, cx) };
  if (ready === 1) {
    const n = m.ld(root - 8);
    if (n !== 0) {
      m.copy(root, f + 16, n);
    }
    // SAFETY: done, its result moved out: freed, never polled again.
    unsafe {
      futDrop(f);
    }
  }
  return ready;
}

/**
 * A join handle's poll (C calls it through the handle's header, on any thread): ready once the
 * task's root is done, else its waker waits in the join slot.
 */
@cExport("std_sched_join_poll")
export function joinPoll(f: usize, cx: usize): u32 {
  if (lk.mode() === lk.LK_NONE) {
    return joinPollAs(f, cx, lk.LK_NONE);
  }
  return joinPollLocking(f, cx);
}

/** `joinPoll` while other threads may reach the slot (or a lazy worker 0 counts its operation). */
@noInline
function joinPollLocking(f: usize, cx: usize): u32 {
  return joinPollAs(f, cx, lk.kind());
}

/** `joinPoll`, the operation of kind `kind` (sched_lock.velt). */
@inline
function joinPollAs(f: usize, cx: usize, kind: u32): u32 {
  const k = f - t.T_JOIN;
  const s = mk.lockJoin(k, kind);
  if ((s & t.J_DONE) !== 0) {
    mk.unlockJoin(k, s | t.J_CLAIMED, kind);
    return 1;
  }
  const old = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, m.wakerClone(m.ld(cx + 8)));
  mk.unlockJoin(k, s, kind);
  if (old !== 0) {
    m.wakerDrop(old);
  }
  return 0;
}

/** A join handle's drop (on any thread): detaches the task; drops a result it never claimed. */
@cExport("std_sched_join_drop")
export function joinDrop(f: usize): void {
  if (lk.mode() === lk.LK_NONE) {
    joinDropAs(f, lk.LK_NONE);
  } else {
    joinDropLocking(f);
  }
}

/** `joinDrop` while other threads may reach the slot (or a lazy worker 0 counts its operation). */
@noInline
function joinDropLocking(f: usize): void {
  joinDropAs(f, lk.kind());
}

/** `joinDrop`, the operation of kind `kind` (sched_lock.velt). */
@inline
function joinDropAs(f: usize, kind: u32): void {
  const k = f - t.T_JOIN;
  const s = mk.lockJoin(k, kind);
  const joiner = m.ld(k + t.T_JOINER);
  m.st(k + t.T_JOINER, 0);
  mk.unlockJoin(k, s & ~t.J_HANDLE, kind);
  if (joiner !== 0) {
    m.wakerDrop(joiner);
  }
  if ((s & (t.J_DONE | t.J_CLAIMED)) === t.J_DONE) {
    dropResult(k);
  }
  wk.release(k);
}

/**
 * When `f` is a spawned task's join handle (its header is the task's `T_JOIN`): the task's
 * result nobody claims is dropped with `qdrop`, quietly (true).
 */
export function joinHandled(f: usize, qdrop: usize): bool {
  // SAFETY: `joinPoll` is `@export`ed (only its address is read).
  if (f === 0 || m.ld(f) !== unsafe { exportedAddress(joinPoll) }) {
    return false;
  }
  m.st(f - t.T_JOIN + t.T_RESULT_DROP, qdrop);
  return true;
}
