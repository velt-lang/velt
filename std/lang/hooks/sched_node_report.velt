// velt/lang/hooks (internal): the result of a started promise of the executor in Velt that nobody
// claims (sched_node.velt): dropped by its task, and a rejection reported as Node reports one
// nobody handled, once the task's microtasks are drained (`report`), or at once for an error a
// callback threw.

import { stateDrop } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as nd from "./sched_node";
import * as aw from "./sched_node_await";
import * as loc from "./sched_node_loc";
import * as t from "./sched_task";
import * as al from "./sched_share_alias";
import * as tr from "./sched_node_transfer";

/**
 * Drops node `n`'s result, which nobody claims. A promise that can reject is reported (by its
 * drop glue, when it holds an error) only once its task's microtasks are drained, as Node
 * reports a rejection nobody handled: until then a combinator may still take it (`handled`).
 */
export function dropResult(n: usize): void {
  const task = m.ld(n + nd.N_TASK);
  const e = t.exec();
  const rejecting = (m.load32(n + nd.N_FLAGS) & nd.REJECTING) !== 0;
  if (rejecting && m.ld(e + t.E_UNCAUGHT) !== 0) {
    // An error a callback threw (sched.velt `schedUncaughtNow`): reported now, as Node's
    // uncaught exception ends the process before the microtasks run.
    m.st(e + t.E_UNCAUGHT, 0);
    dropNow(n);
    return;
  }
  if ((m.load32(n + nd.N_FLAGS) & WATCHED) !== 0) {
    // Watched since it finished: already on the list, which drops it as its owner's gone (and
    // reports it unless someone handled it).
    m.or32(n + nd.N_FLAGS, nd.DETACHED);
    return;
  }
  if (rejecting && task !== 0 && m.ld(e + t.E_CURRENT) === task) {
    m.inc(n + nd.N_REFS);
    m.st(n + nd.N_UNHANDLED_NEXT, m.ld(task + t.T_UNHANDLED));
    m.st(task + t.T_UNHANDLED, n);
    return;
  }
  dropNow(n);
}

/** A node's flag: a combinator took it (`velt_rt_futs_handled`): its rejection is handled. */
export const HANDLED: u32 = 16384;
/** A node's flag: on its task's list since it finished with an error nobody awaited (`watch`). */
const WATCHED: u32 = 32768;

/**
 * Node `n` of task `task` finished and nobody awaits it, its owner still holding it: a rejection
 * is watched, as Node reports a rejection without a handler once the microtask queue is drained,
 * unless the owner awaits it, gives it up, or hands it to a combinator or another task by then
 * (`report`; the runtime's local/unhandled.rs `watch`).
 */
export function watch(n: usize, task: usize): void {
  const fl = m.load32(n + nd.N_FLAGS);
  if ((fl & (nd.REJECTING | tr.HANDED_OVER | nd.PANICKED | HANDLED)) !== nd.REJECTING) {
    return;
  }
  if ((m.ld32(n + nd.N_HEAD + 16) & 0xff) === 0) {
    // Fulfilled: the tag byte of its `Result` is 0.
    return;
  }
  m.or32(n + nd.N_FLAGS, WATCHED);
  m.inc(n + nd.N_REFS);
  m.st(n + nd.N_UNHANDLED_NEXT, m.ld(task + t.T_UNHANDLED));
  m.st(task + t.T_UNHANDLED, n);
}

/** Is watched node `n`'s rejection still nobody's at the checkpoint (or was it dropped since)? */
function unclaimed(n: usize): bool {
  const fl = m.load32(n + nd.N_FLAGS);
  if ((fl & nd.DETACHED) !== 0) {
    // Its owner dropped it without claiming it: reported as any such drop.
    return (fl & nd.DELIVERED) === 0;
  }
  return (fl & (nd.DELIVERED | HANDLED | tr.HANDED_OVER)) === 0 &&
    m.ld(n + aw.N_AWAITER) === 0 &&
    !al.handledElsewhere(n);
}

/** Runs the drop glue of node `n`'s result. */
function dropNow(n: usize): void {
  // A converted promise someone handled through the promise it stands for drops it quietly.
  const rdrop = al.resultDrop(n, m.ld(n + nd.N_RESULT_DROP));
  if (rdrop !== 0) {
    // An error in it is reported where it was thrown; this thread's own location stays.
    const fl = m.load32(n + nd.N_FLAGS);
    const own = (fl & loc.LOC) !== 0 ? loc.current() : 0;
    loc.claim(fl, n + nd.N_POLL);
    // SAFETY: the slot holds the finished result, `rdrop` its drop glue.
    unsafe {
      stateDrop(rdrop, n + nd.N_HEAD + 16);
    }
    if ((fl & loc.LOC) !== 0) {
      loc.restore(own);
    }
  }
}

/** Reports (drops) the rejected results task `task` kept, in the order they were kept. */
export function report(task: usize): void {
  let n = m.ld(task + t.T_UNHANDLED);
  m.st(task + t.T_UNHANDLED, 0);
  let rev: usize = 0;
  while (n !== 0) {
    const next = m.ld(n + nd.N_UNHANDLED_NEXT);
    m.st(n + nd.N_UNHANDLED_NEXT, rev);
    rev = n;
    n = next;
  }
  while (rev !== 0) {
    const next = m.ld(rev + nd.N_UNHANDLED_NEXT);
    m.st(rev + nd.N_UNHANDLED_NEXT, 0);
    const watched = (m.and32(rev + nd.N_FLAGS, ~WATCHED) & WATCHED) !== 0;
    if (!watched || unclaimed(rev)) {
      // A held rejection reported now is the owner's no more: its later drop leaves it.
      m.or32(rev + nd.N_FLAGS, nd.DELIVERED);
      dropNow(rev);
    }
    nd.release(rev);
    rev = next;
  }
}
