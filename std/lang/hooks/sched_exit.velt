// velt/lang/hooks (internal): uncaught errors under the executor in Velt (sched.velt, #2649,
// #2701): the error a timer or microtask callback threw, reported at once (`uncaughtNow`), and
// the end of the program after an uncaught error's report (`exitUncaught`). An unhandled
// rejection (a started promise's result or a spawned task's that nobody claims, dropped by the
// executor) and an error leaving a module state's initializer are reported by compiled code,
// which then ends the process with 1 here instead of calling the runtime's `velt_rt_exit`
// directly.
//
// Nothing runs at that exit, as in Node. The debug runtime's block counters (`VELT_RC_STATS=1`)
// are read there, though, while the executor still holds blocks of its own that the runtime's
// executor holds outside them (its tasks and sleeps are Rust allocations): the root task of
// `main`, its pending sleeps, and the task whose result is being dropped. With the counters on,
// those are given back first, so a program that frees what it allocates balances its counts at
// that exit as it does on the runtime's executor. Only what no other thread can reach any more
// is given back:
// - the task whose dropped result reported (`E_DROPPING`, sched_join.velt `dropWith`): the
//   reference the drop held (the join handle's, or the executor's while that task's root
//   finished on this thread), as every other holder counts one of its own;
// - the started promise's node whose dropped result reported (sched_node_report.velt
//   `REPORTING`): the reference its dropping code held (the unhandled list's, the handle's or the
//   task's), with its result marked taken, since the glue that reported dropped it;
// - on worker 0 (whose frame in `schedBlockOn` holds a reference to the root and never resumes),
//   the root of `main` homed there, when it is being polled on this thread (the error was
//   reported in its poll) or idle (taken out of the idle state, so a wake no longer queues it):
//   its sleeps pending on this worker leave the timer list and give back their wakers, then the
//   executor's reference and `schedBlockOn`'s go. An error reported on another worker hands the
//   exit to worker 0, which runs it at the end of its poll or after its park and gives the root
//   back there (`handToMain`, #3017, #3027). A root queued or polled on another worker is left
//   alone, and so is anything holding a waker of it (an I/O wait, a promise of the runtime's):
//   those keep their references, and the block stays counted.
//
// The hand-over costs two loads per park of worker 0 (`exitDue` before it sleeps, `takeExit`
// after it, sched_park.velt) and one per park of another worker; between two polls it shares the
// look at `E_RELAX` the loop makes anyway (sched_loop.velt `turnShared`). A worker on its way to
// park, past its last look and before its park word is up, misses neither: `handToMain` stores
// the request, then reads worker 0's park word; worker 0 stores its park word, then reads the
// request (sched_park.velt `parkable`), all sequentially consistent, so either the reporting
// worker wakes it or it sees the request and does not sleep, as with every other wake of a
// parking worker.
//
// A spawned task's result dropped unclaimed during the poll of another task is dropped once that
// poll's microtasks are drained (sched_join.velt `keepDrop`), with the rejections nobody handled:
// a rejection then reports, and ends the program, after the synchronous code of the poll, as
// Node reports one (#3027).

import { atomicAddress, inline, noInline } from "velt/lang/intrinsics";
import * as r from "#reactor";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as mod from "./sched_module";
import * as loc from "./sched_node_loc";
import * as nd from "./sched_node";
import * as rp from "./sched_node_report";
import * as wn from "./sched_node_woken";
import { processEnv } from "./process";
import * as sf from "./sched_sleep_forget";
import * as t from "./sched_task";
import * as wk from "./sched_wake";

/**
 * `velt_rt_uncaught_now` on executor `e` (sched.velt `schedUncaughtNow`): the next rejection
 * nobody handles is an error a timer or microtask callback threw, reported at once
 * (sched_node_report.velt `dropResult`), not after the task's microtasks. The word keeps where
 * the callback threw (1: nowhere recorded), which the report shows instead of where the prelude
 * throws the error again.
 */
export function uncaughtNow(e: usize): void {
  const at = loc.current();
  m.st(e + t.E_UNCAUGHT, at === 0 ? 1 : at);
}

/** 1 once an exit gave back the executor's blocks (an error in that is not given back twice). */
const GIVEN = new Atomic<u32>(0);

/**
 * The exit another worker hands to worker 0 (`handToMain`): its code + 1 (0: none), `TAKEN` once
 * worker 0 took it.
 */
const HANDED = new Atomic<i32>(0);
const TAKEN: i32 = -1;

/**
 * A bit of every worker's `E_RELAX` (sched_task.velt; sched_relax.velt keeps it): an exit is due
 * (`handToMain`). The look at the word between two polls (sched_loop.velt `turnShared`) then ends
 * the program on worker 0 and stops the others (`takeExit`).
 */
export const EXIT_DUE: u32 = 256;

/** The word a stopped worker waits on for ever (`halt`): never changes. */
const HALT = new Atomic<u32>(0);

/** Ends the program with `code` after an uncaught error was reported on this thread. */
export function exitUncaught(code: i32): never {
  const self = t.here();
  const g = t.main();
  if (self !== 0 && counting() && GIVEN.exchange(1, "acqrel") === 0) {
    giveBack(self);
  }
  if (self !== 0 && self !== g) {
    handToMain(g, code);
  }
  process.exit(code);
}

/**
 * The exit of an uncaught error reported on worker `self`, not worker 0 (`g`), handed to worker 0,
 * as Node orders it (#3027): there the error can be reported only once `main`'s synchronous code
 * yields, with everything it printed out by then. So the request is stored, every worker's
 * `E_RELAX` gets `EXIT_DUE`, and worker 0 is woken if its park word is up (one on its way to
 * park reads the request after its park word went up: module docs): it ends the program
 * at the end of the poll it runs (its output published then, sched_wake.velt `publishPolled`),
 * or once awake, giving back the root of `main` with the counters on (`root`, #3017). The other
 * workers stop between two polls, so nothing else prints after the report. This thread stops
 * here: the module lock it may hold goes first, so worker 0's poll can finish. A second error
 * meanwhile stops its thread too. A poll of worker 0 that never ends (an endless loop, a loop of
 * microtasks) would keep the program from ending after its report for good (#3888): when worker 0
 * has not taken the exit within `HAND_WAIT_MS`, this thread ends the program (`waitForMain`).
 */
function handToMain(g: usize, code: i32): void {
  // What this thread printed reaches the OS before worker 0 ends the program.
  wk.handOffOutput();
  mod.leave();
  mod.handOver();
  if (HANDED.compareExchange(0, code + 1, "seqcst", "seqcst") === 0) {
    const n = m.load(g + t.E_STARTED);
    for (let i: usize = 0; i < n; i++) {
      m.or32(t.worker(i) + t.E_RELAX, EXIT_DUE);
    }
    wk.unpark(g);
    waitForMain(code);
  }
  halt();
}

/**
 * How long the worker that handed an exit to worker 0 waits for worker 0 to take it, in
 * milliseconds. Longer than a poll of `main` that only computes for a while after the report, so
 * that what it prints still comes first (#3027); a poll that never ends no longer keeps the
 * program from ending.
 */
const HAND_WAIT_MS: f64 = 5000.0;

/**
 * The exit is handed to worker 0 (`handToMain`), with `code`: when worker 0 has not taken it within
 * `HAND_WAIT_MS` (its poll never ends), this thread takes it and ends the program, with what worker
 * 0 printed in that poll not written out. Worker 0 taking it meanwhile ends the program from there.
 */
function waitForMain(code: i32): void {
  const a = atomicAddress(HALT);
  const end = performance.now() + HAND_WAIT_MS;
  let left = HAND_WAIT_MS;
  while (left > 0.0) {
    // `HALT` never changes: the wait ends by its time (or early, which the loop covers).
    r.wordWaitFor(a, 0, (left * 1000.0) as u32);
    left = end - performance.now();
  }
  if (HANDED.compareExchange(code + 1, TAKEN, "seqcst", "seqcst") === code + 1) {
    process.exit(code);
  }
}

/** Is an exit due (`handToMain`)? */
export function exitDue(): bool {
  return HANDED.load("seqcst") !== 0;
}

/** This thread runs nothing any more: it waits until the process ends. */
function halt(): void {
  const a = atomicAddress(HALT);
  while (true) {
    r.wordWait(a, 0);
  }
}

/**
 * Worker `e` (this thread) between two polls, or awake after its park with its park word down:
 * when an exit is due (`handToMain`), worker 0 gives back the root of `main` (with the counters
 * on) and ends the program, and another worker stops. One load otherwise.
 */
@inline("always")
export function takeExit(e: usize): void {
  if (HANDED.load("seqcst") > 0) {
    takeExitNow(e);
  }
}

/** `takeExit` with an exit due: worker 0 claims it; another worker stops. */
@noInline
function takeExitNow(e: usize): void {
  const c = HANDED.load("seqcst");
  if (e !== t.main()) {
    halt();
    return;
  }
  if (c <= 0 || HANDED.compareExchange(c, TAKEN, "seqcst", "seqcst") !== c) {
    return;
  }
  if (counting()) {
    root(e);
  }
  process.exit(c - 1);
}

/** Are the debug runtime's block counters on (`VELT_RC_STATS=1`)? */
function counting(): bool {
  return processEnv("VELT_RC_STATS") === "1";
}

/** Gives back what the executor holds that no other thread reaches (module docs); `self` here. */
function giveBack(self: usize): void {
  const k = m.ld(self + t.E_DROPPING);
  if (k !== 0) {
    m.st(self + t.E_DROPPING, 0);
    if (m.ld(self + t.E_CURRENT) === k) {
      // Its root finished in this poll: `finish` never runs.
      ended(k);
    }
    wk.release(k);
  }
  const g = t.main();
  if (self === g) {
    root(g);
  }
  // Last: its reference to its task may be the one that frees the task.
  const n = rp.REPORTING.get() as usize;
  if (n !== 0) {
    rp.REPORTING.set(0);
    // The glue that reported dropped its result (the error, before the exit): no later drop of
    // the node may run it again, and the reference the dropping code held goes.
    m.or32(n + nd.N_FLAGS, nd.DELIVERED);
    nd.release(n);
  }
}

/** Worker 0 (`g`, this thread) gives back the root of `main` when it is this thread's to give. */
function root(g: usize): void {
  const k = m.ld(g + t.E_ROOT);
  if (k === 0 || m.ld(k + t.T_HOME) !== g) {
    return;
  }
  if (t.has(k, t.ROOT_DONE)) {
    // `main` returned, and the exit came from the reports after this poll's microtasks, before
    // `finish` (sched_main_end.velt `mainFinish`) gave the task's references back.
    if (m.ld(g + t.E_CURRENT) === k && m.load32(k + t.T_STATE) !== t.DONE) {
      wn.giveBackWoken(k);
      ended(k);
      wk.release(k);
      wk.release(k);
    }
    return;
  }
  if (m.ld(g + t.E_CURRENT) !== k && m.cas32(k + t.T_STATE, t.IDLE, t.DONE) !== t.IDLE) {
    // Queued, or polled on another worker: its references are not this thread's.
    return;
  }
  const tb = m.ld(g + t.E_TIMERS);
  if (tb !== 0) {
    sf.forget(tb, k);
  }
  ended(k);
  // The executor's reference, then `schedBlockOn`'s.
  wk.release(k);
  wk.release(k);
}

/**
 * Task `k` never runs again: its microtask queue goes, with the references its entries hold (to
 * `k`, whose reference the caller still holds, or to promises it drives).
 */
function ended(k: usize): void {
  let w = micro.pop(k);
  while (w !== 0) {
    m.wakerDrop(w);
    w = micro.pop(k);
  }
  micro.free(k);
  m.st(k + t.T_MICRO, 0);
}
