// velt/lang/hooks (internal): the executor's parking on macOS (sched.velt, #2649): the worker
// sleeps in `__ulock_wait` on its park word, and a wake from another thread `__ulock_wake`s it.

/** `UL_COMPARE_AND_WAIT | ULF_NO_ERRNO`: wait while the 32-bit word holds the value. */
const COMPARE_AND_WAIT: u32 = 0x01000001;

declare c("c") function __ulock_wait(op: u32, addr: usize, value: u64, timeoutUs: u32): i32;
declare c("c") function __ulock_wake(op: u32, addr: usize, wakeValue: u64): i32;

/** Sleeps while the `u32` at `word` is `expected` (it may return early: the caller checks). */
export function parkWait(word: usize, expected: u32): void {
  // SAFETY: `word` is the executor's park word, which lives as long as the process.
  unsafe {
    __ulock_wait(COMPARE_AND_WAIT, word, expected as u64, 0);
  }
}

/** Wakes the thread sleeping on the `u32` at `word`, if any. */
export function parkWake(word: usize): void {
  // SAFETY: as `parkWait`.
  unsafe {
    __ulock_wake(COMPARE_AND_WAIT, word, 0);
  }
}
