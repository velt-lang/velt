// velt/lang/hooks (internal): task ids of the executor in Velt (sched.velt, #2649 P2c, #2832).
// `velt_rt_task_id`'s job: the id of the task being polled, 0 outside a task. An id is given on
// first use from a process-wide counter, so it is never 0 for a task and never reused (the
// runtime executor's rule, velt_rt task/local/mod.rs). `new Promise` compares ids to decide
// whether a settled value stays on its task or is copied for another (std/lang/promise/
// settle.velt), and the debug cell check keys a captured variable's owner by it (#2832).
//
// Off the workers no task is polled. A C library's thread calling an exported function gets an id
// for the call (`enterForeignCall`): the outermost call's, given from the same counter, so code
// in it compares as a task of its own, and a promise it settles for another call or a task is
// transferred, as one settled by another task is (#2907). The program's thread before the start
// (a module's initializer outside `main`'s root task) gets 0. Ids have bit 63 set, so they never
// compare equal to the runtime's (which count from 1 and never get there).

import { stdUsed } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as t from "./sched_task";

/** The next id (`add` returns the one before, so the first is 1). */
const NEXT = new Atomic<u64>(1);

/** Bit 63: an id given by this executor, not the runtime. */
export const STD_ID: u64 = 0x8000_0000_0000_0000;

/**
 * The id of this thread's outermost exported function's call from C, while it is in one; 0 on
 * other threads and between calls. Only programs with an exported function have such calls.
 */
const CALL_ID = new ThreadLocal<u64>(0);

/** A C library's thread enters its outermost exported function's call (sched_foreign.velt). */
export function enterForeignCall(): void {
  CALL_ID.set(NEXT.add(1, "relaxed") | STD_ID);
}

/** That call returns. */
export function leaveForeignCall(): void {
  CALL_ID.set(0);
}

/**
 * The id of the task being polled, given now if it has none; off the workers, that of a C
 * library's thread's exported function's call (`CALL_ID`); 0 outside both.
 */
export function taskId(): u64 {
  const e = t.here();
  if (e === 0) {
    return stdUsed("foreignCalls") ? CALL_ID.get() : 0;
  }
  const k = m.ld(e + t.E_CURRENT);
  if (k === 0) {
    return 0;
  }
  let id = m.ld(k + t.T_ID) as u64;
  if (id === 0) {
    // Only the thread polling the task stores it.
    id = NEXT.add(1, "relaxed") | STD_ID;
    m.st(k + t.T_ID, id as usize);
  }
  return id;
}
