// velt/lang/hooks (internal): shared promises in the executor in Velt (`velt_rt_fut_share`'s job,
// #212, #2854; the runtime's task/shared.rs does it for the runtime's executor): a promise of
// this executor (a node, sched_node.velt) that several places hold, each of which may await it
// and gets the result, as in JS.
//
// The first share turns the node into a shared one in place: its header's poll and drop become
// the holder's (`holderPoll`, `holderDrop`), and the node's head points at its hub (`N_HUB`).
// The original pointer stays its first holder's; every other holder gets a handle of its own (a
// small block with a result slot), so each holder awaits, and is dropped, as one future. The hub
// counts the holder roles, keeps the settled result once the node finished (moved out of the
// node, which is then delivered), and lists the waiting holders in the order they started
// waiting. A holder that sees the promise settled gets a share of the result in its own slot.
//
// A started node is driven by its task; as it finishes there (sched_node.velt `run`), every
// waiting holder is queued in the task's microtask queue, in the order they started waiting, as
// Node queues a promise's reactions when it settles (`settle`). A lazy node is driven by its first
// waiter. Dropping a holder never cancels the promise; the last role drops the settled result,
// or gives the node back its entries and drops it, so it runs to completion and its own result
// drop reports an unhandled rejection, as for any dropped promise.
//
// A shared promise stays on the task it is shared on: a holder handed to another task
// (sched_share_hand.velt) forwards to a proxy, a node of this task that awaits a role of its own
// and is handed over in its place.
//
// The hub: the node, the result's size, its share glue (`(src, dst) -> u32`, null: copied as it
// is) and drop glue, the number of roles, its flags, the settled result, the waiters (a buffer of
// `(holder, waker, ticket)` entries, their count and capacity), and the proxy of the original
// when it was handed over. A handle: `[view][forward][size][hub][VeltFut header][result slot]`,
// so for every holder `f - 8` holds its hub (for the original, the node's `N_HUB` word); a handle
// handed to another task has a hub word of 0 and its proxy in its forward word.

import { fnAddress, futDrop, futPoll, inline, stateDrop, statePoll } from "velt/lang/intrinsics";
import * as m from "./sched_mem";
import * as micro from "./sched_micro";
import * as nc from "./sched_node_catch";
import * as nd from "./sched_node";
import * as loc from "./sched_node_loc";
import * as off from "./sched_off";
import * as t from "./sched_task";
import * as tr from "./sched_node_transfer";
import * as wt from "./sched_share_wait";
import * as al from "./sched_share_alias";
import * as wk from "./sched_wake";

/**
 * The node head's word with the hub of a shared node (sched_node.velt's layout); read only while
 * the node's header is the holder's.
 */
export const N_HUB: usize = 120;

export const H_NODE: usize = 0;
export const H_SIZE: usize = 8;
const H_SHARE: usize = 16;
export const H_RDROP: usize = 24;
const H_ROLES: usize = 32;
export const H_FLAGS: usize = 40;
const H_RESULT: usize = 48;
export const H_WAITERS: usize = 56;
export const H_WLEN: usize = 64;
export const H_WCAP: usize = 72;
export const H_ORIG_FWD: usize = 80;
/**
 * What keeps the hub's block: 1 for the promise (until its last role's cleanup) and 1 for each
 * converted promise standing for it (until its node is freed, sched_share_alias.velt), which
 * still reads `CLAIMED` after the promise went away.
 */
const H_WATCH: usize = 88;
const H_BYTES: usize = 96;

/** It settled: its result is in `H_RESULT`, or its node panicked (no result). */
const DONE: u32 = 1;
/** A holder took the settled result (promise identity, task/identity.rs, reads it). */
export const CLAIMED: u32 = 2;
/** The original was handed to another task: its proxy is in `H_ORIG_FWD`. */
export const ORIG_OUT: u32 = 4;
/** Every role went away (on the promise's task). */
export const ROLES_GONE: u32 = 8;
/** The original handed to another task was dropped there. */
export const ORIG_GONE: u32 = 16;

/** Bytes in front of a handle's header. */
export const FRONT: usize = 32;

/**
 * `velt_rt_fut_share` (the hook lowering calls under `VELT_SCHEDULER=std`): another holder of
 * promise `f` (0: none), a handle of its own. `size` is the result's size, `share` its
 * `SharePoll` glue (0: copied as it is), `rdrop` its drop glue (0: nothing to drop). Only a node
 * of this executor is shared here; the runtime's futures (a leaf, a join handle, a race) are
 * shared by the runtime's hub.
 */
export function schedShare(f: usize, size: u64, share: usize, rdrop: usize): usize {
  if (f === 0) {
    return 0;
  }
  if (m.ld(f) === fnAddress(holderPoll)) {
    const fwd = forwardOf(f);
    if (fwd !== 0) {
      // Handed to this task and shared again here: its proxy, which delivers this task's own
      // copy, becomes the promise shared on this task (`f` goes on forwarding to it).
      return schedShare(fwd, size, share, rdrop);
    }
    return newHandle(m.ld(f - 8));
  }
  if (m.ld(f) !== fnAddress(nd.nodePoll)) {
    return off.share(f, size, share, rdrop);
  }
  const n = nd.nodeOf(f);
  const h = m.zeroed(H_BYTES);
  m.st(h + H_NODE, n);
  m.st(h + H_SIZE, size as usize);
  m.st(h + H_SHARE, share);
  m.st(h + H_RDROP, rdrop);
  m.st(h + H_ROLES, 1);
  m.st(h + H_WATCH, 1);
  m.st(n + N_HUB, h);
  m.st(f, fnAddress(holderPoll));
  m.st(f + 8, fnAddress(holderDrop));
  return newHandle(h);
}

/**
 * `velt_rt_fut_id` (#1682): the identity of promise `f`. A holder's is its original's, or its
 * proxy's once it was handed to this task (that proxy is this task's own promise); the runtime
 * goes on from there (a converted promise stands for the one it converts, task/identity.rs).
 */
export function schedFutId(f: usize): u64 {
  let g = f;
  while (g !== 0) {
    let n: usize = 0;
    if (m.ld(g) === fnAddress(holderPoll)) {
      const fwd = forwardOf(g);
      if (fwd !== 0) {
        g = fwd;
        continue;
      }
      n = m.ld(m.ld(g - 8) + H_NODE);
      g = n + nd.N_HEAD;
    } else if (m.ld(g) === fnAddress(nd.nodePoll)) {
      n = nd.nodeOf(g);
    }
    // A converted promise (its original shared or not) stands for the promise it converts
    // (sched_share_alias.velt).
    const a = n !== 0 ? al.holder(n) : 0;
    if (a === 0) {
      break;
    }
    g = a;
  }
  return off.futId(g);
}

/**
 * `velt_rt_fut_peek` of holder `f` (what `console.log` prints): its settled result, copied into
 * its slot for the formatter to read, claiming nothing; false while pending or panicked.
 */
export function peek(f: usize): bool {
  const fwd = forwardOf(f);
  if (fwd !== 0) {
    const settled = m.ld(fwd) === fnAddress(holderPoll) ? peek(fwd) : nd.peek(fwd);
    if (settled) {
      m.copy(f + 16, fwd + 16, sizeOf(f));
    }
    return settled;
  }
  const h = m.ld(f - 8);
  const n = m.ld(h + H_NODE);
  const fl = m.load32(n + nd.N_FLAGS);
  if ((fl & (nd.STARTED | nd.FINISHED)) === (nd.STARTED | nd.FINISHED)) {
    // Finished with nobody waiting yet: it settles now.
    settle(h, m.ld(n + nd.N_TASK), 0);
  }
  if ((m.load32(h + H_FLAGS) & DONE) === 0 || (fl & nd.PANICKED) !== 0) {
    return false;
  }
  m.copy(f + 16, m.ld(h + H_RESULT), m.ld(h + H_SIZE));
  return true;
}

/** A converted promise standing for the promise of hub `h` keeps its block (`H_WATCH`). */
export function watch(h: usize): void {
  m.inc(h + H_WATCH);
}

/** Gives back one keep of hub `h`'s block (`H_WATCH`): the last frees it. */
export function unwatch(h: usize): void {
  if (m.dec(h + H_WATCH) === 1) {
    m.release(h, H_BYTES);
  }
}

/** A new holder of the promise of hub `h`: a handle of its own. */
export function newHandle(h: usize): usize {
  m.inc(h + H_ROLES);
  const size = m.ld(h + H_SIZE);
  const base = m.alloc(FRONT + 16 + size);
  // A view while converted promises are made (sched_share_alias.velt): its take claims nothing.
  const e = t.exec();
  m.st(base, e !== 0 ? m.ld(e + t.E_VIEWS) : 0);
  m.st(base + 8, 0);
  m.st(base + 16, size);
  m.st(base + 24, h);
  const g = base + FRONT;
  m.st(g, fnAddress(holderPoll));
  m.st(g + 8, fnAddress(holderDrop));
  return g;
}

/** Is holder `f` the original of hub `h` (else a handle)? */
export function isOrig(h: usize, f: usize): bool {
  return m.ld(h + H_NODE) + nd.N_HEAD === f;
}

/** The proxy holder `f` forwards to (handed to another task), or 0. */
export function forwardOf(f: usize): usize {
  const h = m.ld(f - 8);
  if (h === 0) {
    return m.ld(f - FRONT + 8);
  }
  return isOrig(h, f) ? m.ld(h + H_ORIG_FWD) : 0;
}

/** The size of holder `f`'s result. */
function sizeOf(f: usize): usize {
  const h = m.ld(f - 8);
  return h !== 0 && isOrig(h, f) ? m.ld(h + H_SIZE) : m.ld(f - FRONT + 16);
}

/** The poll of every holder, the original and the handles alike (C calls it through the header). */
export function holderPoll(f: usize, cx: usize): u32 {
  const fwd = forwardOf(f);
  if (fwd !== 0) {
    // SAFETY: the proxy, a heap future this holder owns; its result moves to this holder.
    if (unsafe { futPoll(fwd, cx) } !== 1) {
      return 0;
    }
    m.copy(f + 16, fwd + 16, sizeOf(f));
    return 1;
  }
  return pollHolder(m.ld(f - 8), f, cx);
}

/** The drop of every holder: a handle also frees its own block. */
export function holderDrop(f: usize): void {
  const h = m.ld(f - 8);
  if (h === 0) {
    // A handle handed to this task: its role went to the proxy on the promise's task.
    const size = m.ld(f - FRONT + 16);
    // SAFETY: the proxy, a heap future this holder owns.
    unsafe {
      futDrop(m.ld(f - FRONT + 8));
    }
    m.release(f - FRONT, FRONT + 16 + size);
    return;
  }
  if (!isOrig(h, f)) {
    const size = m.ld(f - FRONT + 16);
    release(h, f);
    m.release(f - FRONT, FRONT + 16 + size);
    return;
  }
  if ((m.load32(h + H_FLAGS) & ORIG_OUT) === 0) {
    release(h, f);
    return;
  }
  // The original, handed to this task: its proxy goes, and whichever of this and the last role
  // comes second frees the node and the hub.
  // SAFETY: the proxy, a heap future this holder owns.
  unsafe {
    futDrop(m.ld(h + H_ORIG_FWD));
  }
  if ((m.or32(h + H_FLAGS, ORIG_GONE) & ROLES_GONE) !== 0) {
    free(h);
  }
}

/** Polls holder `f` of the promise of hub `h` with `cx`. */
function pollHolder(h: usize, f: usize, cx: usize): u32 {
  const n = m.ld(h + H_NODE);
  const e = t.exec();
  const task = m.ld(e + t.E_CURRENT);
  if ((m.load32(h + H_FLAGS) & DONE) === 0) {
    const fl = m.load32(n + nd.N_FLAGS);
    if ((fl & nd.FINISHED) === 0) {
      if ((fl & nd.STARTED) !== 0 || !wt.firstWaiter(h, f)) {
        wt.wait(h, f, cx);
        return 0;
      }
      // A lazy node: its first waiter drives it with its own cx.
      // SAFETY: a lazy node's state, which has not finished, polled by its owner's holder.
      const r = unsafe { statePoll(m.ld(n + nd.N_POLL), n + nd.N_HEAD + 16, cx) };
      if (r !== 1) {
        wt.wait(h, f, cx);
        return 0;
      }
      tr.finished(n);
      nd.setFlags(n, nd.FINISHED);
    }
    // It finished before the hub heard (shared after it finished, or driven here): this holder
    // goes on now, the others are queued.
    settle(h, task, f);
  }
  const i = wt.waiterIndex(h, f);
  if (i < m.ld(h + H_WLEN)) {
    const at = wt.entry(h, i);
    const ticket = m.ld(at + 16) as u64;
    if (ticket !== 0 && !micro.reached(task, ticket, m.ld(cx + 8))) {
      return 0;
    }
    wt.removeWaiter(h, i);
  }
  if (isOrig(h, f) || m.ld(f - FRONT) === 0) {
    m.or32(h + H_FLAGS, CLAIMED);
  }
  const fl = m.load32(n + nd.N_FLAGS);
  if ((fl & nd.PANICKED) !== 0) {
    // It panicked (`catchPanic`): every holder's await raises it again.
    nc.again(m.ld(n + nd.N_POLL));
  }
  // Where it threw becomes this thread's, for an uncaught error the holder raises (#2861).
  loc.claim(fl, n + nd.N_POLL);
  const share = m.ld(h + H_SHARE);
  const src = m.ld(h + H_RESULT);
  if (share !== 0) {
    // SAFETY: a `SharePoll` glue of the result type: another reference to `src` into the slot.
    unsafe {
      statePoll(share, src, f + 16);
    }
  } else {
    m.copy(f + 16, src, m.ld(h + H_SIZE));
  }
  return 1;
}

/**
 * The node of hub `h` finished (on task `task`): its result moves into the hub, and every waiting
 * holder but `me` is queued in the task's microtask queue in the order they started waiting (a
 * waker of another task is woken). Each keeps its entry with its ticket until it takes the result.
 */
export function settle(h: usize, task: usize, me: usize): void {
  if ((m.load32(h + H_FLAGS) & DONE) !== 0) {
    return;
  }
  const n = m.ld(h + H_NODE);
  if ((m.load32(n + nd.N_FLAGS) & nd.PANICKED) === 0) {
    const size = m.ld(h + H_SIZE);
    const r = m.alloc(size > 0 ? size : 1);
    m.copy(r, n + nd.N_HEAD + 16, size);
    m.st(h + H_RESULT, r);
    nd.setFlags(n, nd.DELIVERED);
    // The hub took the node's result: a converted node's claim (the runtime's `deliver_unadopted`).
    al.claimed(n);
  }
  m.or32(h + H_FLAGS, DONE);
  const len = m.ld(h + H_WLEN);
  for (let i: usize = 0; i < len; i++) {
    const at = wt.entry(h, i);
    const w = m.ld(at + 8);
    let ticket: u64 = 0;
    if (m.ld(at) === me) {
      ticket = 0;
    } else if (task !== 0 && wk.taskOf(w) === task) {
      ticket = micro.enqueue(task, m.wakerClone(w), true);
    } else {
      m.wakeByRef(w);
    }
    m.st(at + 16, ticket as usize);
  }
}

/**
 * Node `n` of task `task` finished (sched_node.velt `run`): if it is shared, its hub settles (the
 * waiting holders are queued) and true; false for a node nobody shared, whose awaiter is woken.
 */
@inline
export function settled(n: usize, task: usize): bool {
  if (m.ld(n + nd.N_HEAD) !== fnAddress(holderPoll)) {
    return false;
  }
  settle(m.ld(n + N_HUB), task, 0);
  return true;
}

/** Holder `f` of the promise of hub `h` gives up its role (dropped, or handed over). */
export function release(h: usize, f: usize): void {
  const i = wt.waiterIndex(h, f);
  if (i < m.ld(h + H_WLEN)) {
    wt.removeWaiter(h, i);
  }
  if (m.dec(h + H_ROLES) !== 1) {
    return;
  }
  const r = m.ld(h + H_RESULT);
  if (r !== 0) {
    const rdrop = m.ld(h + H_RDROP);
    if (rdrop !== 0) {
      // SAFETY: the settled result nobody holds any more, `rdrop` its drop glue.
      unsafe {
        stateDrop(rdrop, r);
      }
    }
    const size = m.ld(h + H_SIZE);
    m.release(r, size > 0 ? size : 1);
    m.st(h + H_RESULT, 0);
  }
  const fl = m.load32(h + H_FLAGS);
  if ((fl & ORIG_OUT) !== 0 && (m.or32(h + H_FLAGS, ROLES_GONE) & ORIG_GONE) === 0) {
    // The original's holder on the other task frees the node and the hub as it goes.
    return;
  }
  free(h);
}

/**
 * Frees hub `h`: its node gets its entries back and is dropped as an owner drops it (a node that
 * has not finished keeps running, its result dropped when it does).
 */
function free(h: usize): void {
  const n = m.ld(h + H_NODE);
  const f = n + nd.N_HEAD;
  m.st(f, fnAddress(nd.nodePoll));
  m.st(f + 8, fnAddress(nd.nodeDrop));
  const len = m.ld(h + H_WLEN);
  for (let i: usize = 0; i < len; i++) {
    m.wakerDrop(m.ld(wt.entry(h, i) + 8));
  }
  const cap = m.ld(h + H_WCAP);
  if (cap !== 0) {
    m.release(m.ld(h + H_WAITERS), 24 * cap);
  }
  unwatch(h);
  nd.nodeDrop(f);
}
