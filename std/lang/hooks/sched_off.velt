// velt/lang/hooks (internal): the runtime's promise layer, still reached for the futures that
// aren't the executor in Velt's (sched.velt, #2649): sharing, converting and handing over a
// runtime leaf, and its identity (#2196, to move to Velt). Code off the workers no longer comes
// here (sched_foreign.velt). The runtime's entries are reached through their `declare c`
// (lowering routes only the runtime's own declarations to the executor).

declare c("c") function velt_rt_fut_transfer$rt(f: usize, glue: usize): void;
declare c("c") function velt_rt_fut_id$rt(f: usize): u64;
declare c("c") function velt_rt_fut_alias$rt(w: usize, inner: usize, quiet: usize): void;
declare c("c") function velt_rt_fut_share$rt(
  f: usize,
  size: u64,
  share: usize,
  rdrop: usize,
): usize;

/** `velt_rt_fut_transfer`, the runtime's: a holder of a shared promise or a runtime future. */
export function transfer(f: usize, glue: usize): void {
  // SAFETY: the caller owns `f`, a heap future of the runtime's; `glue` is null or its result's
  // transfer glue.
  unsafe {
    velt_rt_fut_transfer$rt(f, glue);
  }
}

/**
 * `velt_rt_fut_share`, the runtime's: another holder of `f`, a runtime future. `share` is a
 * `SharePoll` glue (sched_share.velt): `(src, dst) -> u32` is the runtime's `(src, dst)` share
 * glue but for its result, which the runtime does not read.
 */
export function share(f: usize, size: u64, share: usize, rdrop: usize): usize {
  // SAFETY: the caller holds `f`, a heap future of the runtime's; the glue matches its result.
  return unsafe { velt_rt_fut_share$rt(f, size, share, rdrop) };
}

/** `velt_rt_fut_id`, the runtime's: the identity of `f` (its holders, its converted promises). */
export function futId(f: usize): u64 {
  // SAFETY: `f` is null or a live heap future.
  return unsafe { velt_rt_fut_id$rt(f) };
}

/** `velt_rt_fut_alias`, the runtime's: converted promise `w`, a runtime future, wraps `inner`. */
export function alias(w: usize, inner: usize, quiet: usize): void {
  // SAFETY: `w` and `inner` are live heap futures, `w` owned by the caller; `quiet` matches `w`.
  unsafe {
    velt_rt_fut_alias$rt(w, inner, quiet);
  }
}
