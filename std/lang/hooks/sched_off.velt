// velt/lang/hooks (internal): the runtime's promise layer, still reached for promises that aren't
// the executor in Velt's (sched.velt, #2649): the identity of a future of the runtime's and handing
// over a runtime leaf (#2196, to move to Velt). A promise is no longer shared there: a share on a
// C library's thread is refused (sched_share.velt, #3782). Code off the workers no longer comes
// here otherwise (sched_foreign.velt). The runtime's entries are reached through their `declare c`
// (lowering routes only the runtime's own declarations to the executor).

declare c("c") function velt_rt_fut_transfer$rt(f: usize, glue: usize): void;
declare c("c") function velt_rt_fut_id$rt(f: usize): u64;

/** `velt_rt_fut_transfer`, the runtime's: a holder of a shared promise or a runtime future. */
export function transfer(f: usize, glue: usize): void {
  // SAFETY: the caller owns `f`, a heap future of the runtime's; `glue` is null or its result's
  // transfer glue.
  unsafe {
    velt_rt_fut_transfer$rt(f, glue);
  }
}

/**
 * `velt_rt_fut_id`, the runtime's: the identity of `f`, a future of the runtime's: a holder of its
 * hub (shared on a C library's thread) has its original's, anything else is its own.
 */
export function futId(f: usize): u64 {
  // SAFETY: `f` is a live heap future.
  return unsafe { velt_rt_fut_id$rt(f) };
}
