// velt/lang/hooks (tests): a std test file that imports the executor's modules by relative path
// (#3731). Each module gets its std name whatever spelling of the path reached this file (a link,
// or Windows' verbatim `\\?\C:\…`), so the check finds the executor's hooks by those names: the
// test runner's `Promise.all` needs `sched_all.velt`'s. Before, a release build of such a file
// on Windows stopped in lowering ("std without the hook").
import { describe, expect, it } from "velt/test";
import * as nd from "./sched_node";
import * as t from "./sched_task";

describe("hook modules imported by relative path", () => {
  it("are the executor's own", () => {
    expect(nd.N_TASK === 0 || nd.N_TASK > 0).toBe(true);
    expect(t.T_REFS === 0 || t.T_REFS > 0).toBe(true);
  });
});
