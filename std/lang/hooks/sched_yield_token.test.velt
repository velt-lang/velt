// velt/lang/hooks (tests): an awaited yield's token with no record (sched_yield_list.velt `POLL`,
// `pollReady`, #3687). It goes on once the poll its task's root yielded it in is over (`YIELDED`),
// whatever cx asks: asked with a started promise's waker in that poll (a child of an inline
// `Promise.all` detached to run on its own) it is not ready, and gets a turn of its own, so the cx
// it waits with is woken. And the root's turn placed before its block was parked keeps its place.
import { describe, expect, it } from "velt/test";
import * as m from "velt/lang/hooks/sched_mem";
import * as t from "velt/lang/hooks/sched_task";
import { schedYield, schedYieldReady } from "velt/lang/hooks/sched_yield";
import * as ls from "velt/lang/hooks/sched_yield_list";

/** The task polled on this thread. */
function task(): usize {
  return m.ld(t.here() + t.E_CURRENT);
}

/** Task `k`'s first listed yield (0: none). */
function first(k: usize): usize {
  const last = m.ld(ls.blockOf(k) + ls.B_LAST);
  return last === 0 ? 0 : m.ld(last + ls.Y_NEXT);
}

describe("a yield's token with no record", () => {
  it(
    "is 0, apart from off the workers, and is not ready while the poll it was made in runs",
    async () => {
      const k = task();
      expect(ls.POLL).toBe(0 as usize);
      expect(ls.OFF === ls.POLL).toBe(false);
      // The root yields in this poll, as an awaited yield with no record does.
      m.store32(k + t.T_STATE, t.YIELDED);
      expect(schedYieldReady(k + t.T_CX, ls.POLL)).toBe(0 as u32);
      expect(ls.pollReady(k, k, false)).toBe(0 as u32);
      // The task's next poll: that poll is over.
      await yieldNow();
      expect(schedYieldReady(k + t.T_CX, ls.POLL)).toBe(1 as u32);
      expect(ls.pollReady(k, k, false)).toBe(1 as u32);
    },
  );

  it("asked with another waker in its poll, puts a turn for that waker on the list", async () => {
    const k = task();
    m.store32(k + t.T_STATE, t.YIELDED);
    const before = m.ld(ls.block(k) + ls.B_STAMP);
    expect(ls.pollReady(k, k, false)).toBe(0 as u32);
    // A record joined the task's list (stamped after the yields made so far), whose turn wakes
    // the waker it was asked with (a clone of it), not the root.
    expect(m.ld(ls.blockOf(k) + ls.B_STAMP) > before).toBe(true);
    expect(t.has(k, t.YIELDS)).toBe(true);
    const r = first(k);
    expect(r !== 0 && m.ld(r + ls.Y_WAKER) !== ls.ROOT).toBe(true);
    await yieldNow();
  });

  it(
    "asked late, after its root yielded again in a later poll, waits one turn more and goes on",
    async () => {
      const k = task();
      // Its poll: made, and the root yielded.
      m.store32(k + t.T_STATE, t.YIELDED);
      // A later poll, in which the root yields again before the started promise asks.
      await yieldNow();
      m.store32(k + t.T_STATE, t.YIELDED);
      const before = m.ld(ls.block(k) + ls.B_STAMP);
      // One turn late: not ready, and a turn of its own joins the list.
      expect(ls.pollReady(k, k, false)).toBe(0 as u32);
      expect(m.ld(ls.blockOf(k) + ls.B_STAMP) > before).toBe(true);
      // At that turn, in the next poll, it goes on.
      await yieldNow();
      expect(ls.pollReady(k, k, false)).toBe(1 as u32);
    },
  );
});

describe("a parked yield block", () => {
  it("keeps the root's turn placed before it was parked ahead of yields made after", async () => {
    const k = task();
    ls.block(k);
    // The root yields with nothing listed: its turn is placed (`ROOT_ALONE`, `B_ROOT`), no record.
    expect(schedYield(k + t.T_CX)).toBe(ls.POLL);
    expect(t.has(k, t.ROOT_ALONE)).toBe(true);
    // A yield is made after it (its stamp), then the turns end and the block is parked.
    const after = ls.nextStamp(ls.block(k));
    ls.park(k);
    // It joins later in this poll: the block comes back, and the root's turn comes first.
    ls.join(k, ls.record(m.wakerClone(k), after));
    const r = first(k);
    expect(m.ld(r + ls.Y_WAKER)).toBe(ls.ROOT);
    expect(m.ld(m.ld(r + ls.Y_NEXT) + ls.Y_STAMP)).toBe(after);
    await yieldNow();
  });

  it("drops the root's placed turn of an earlier poll when the next one begins", async () => {
    const k = task();
    ls.block(k);
    expect(schedYield(k + t.T_CX)).toBe(ls.POLL);
    ls.park(k);
    expect(t.has(k, t.ROOT_ALONE)).toBe(true);
    // Its awaited yield below is then the first of this poll (so no record takes the mark).
    m.store32(k + t.T_STATE, t.RUNNING);
    // The next poll: the mark is gone, so a block that comes back places the root's turn anew.
    await yieldNow();
    expect(t.has(k, t.ROOT_ALONE)).toBe(false);
  });
});
