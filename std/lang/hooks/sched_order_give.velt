// velt/lang/hooks (internal): the Node timers a counted exit gives back (the debug runtime's block
// counters, `VELT_RC_STATS=1`: sched_wake.velt `counting`). A run ends when nothing keeps it alive,
// so a timer still in the order then keeps nothing alive either: an `unref()`'d `setTimeout` or
// `setInterval` (std/prelude/timers.velt, #3032), or an `AbortSignal.timeout`'s timer
// (std/task/signal_timeout.velt), which waits in a task of its own until its delay is up. Each
// still holds its task, its turn and what its task holds. When a counted run ends (sched_end.velt
// `mayPark`), the timers leave the order and their turns complete, so their tasks end and give
// back what they hold, and the end is looked for again. An `unref()`'d timer's task then asks
// whether the process is ending, and is told that it is (`end`): its callback does not run.
// Nothing changes without the counters: the program ends as soon as nothing keeps it alive, as
// Node's does.

import { noInline } from "velt/lang/intrinsics";
import * as l from "./sched_order_list";
import * as m from "./sched_mem";
import * as order from "./sched_order";

/** Whether a counted run reached its end (`end`). */
const ENDING = new Atomic<u64>(0);

/**
 * A counted run is ending: nothing keeps it alive. From now on a due `unref()`'d timer that asks
 * whether the process is ending (sched_end.velt `unrefPoll`) is told that it is, so its callback
 * does not run, as in a run without the counters, which has exited by now.
 */
export function end(): void {
  ENDING.store(1, "release");
}

/** Has a counted run reached its end? */
export function ending(): bool {
  return ENDING.load("acquire") !== 0;
}

/**
 * The timers still queued leave the order, their turns completing: true if there was one. Each
 * leaves under the lock the walk holds, and only its turn's waker is kept for after: once the
 * lock is given back a worker may grant a turn, and that timer's task may free its handle, so
 * no handle is touched then.
 */
@noInline
export function giveBackQueued(): bool {
  const b = l.order();
  if (b === 0) {
    return false;
  }
  const wakers: u64[] = [];
  let any = false;
  const k = l.lock(b);
  let list = m.ld(b + l.O_FIRST);
  while (list !== 0) {
    // Read first: a list left empty is freed (sched_order_list.velt `take`).
    const nextList = m.ld(list + l.L_NEXT);
    let h = m.ld(list + l.L_FIRST);
    while (h !== 0) {
      const next = m.ld(h + l.H_NEXT);
      any = true;
      const w = order.leaveHeld(b, h);
      if (w !== 0) {
        wakers.push(w as u64);
      }
      h = next;
    }
    list = nextList;
  }
  l.unlock(b, k);
  // Outside the lock: a wake may take other locks.
  for (const w of wakers) {
    m.wakeOwned(w as usize);
  }
  return any;
}
