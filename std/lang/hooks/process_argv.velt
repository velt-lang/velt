// velt/lang/hooks (internal): the command-line arguments, read once per process and kept, which
// std/lang/hooks/process.velt's `argList` (`process.argv`, velt/process's `argv` and `args`)
// reaches by role: `argCount` and `argAt` of `argv()`'s list (`list` 0) or of Node's
// `process.argv` (`list` 1). A module that sema loads on demand (velt_common
// `ON_DEMAND_MODULES`), so a program whose live code reads no arguments loads none of the
// readers (std/process/args_read.velt and the OS's under it).
//
// Prebuilt (velt_common `std_hooks/prebuilt.rs`): `velt cache warm` compiles this module once
// into an object of the build cache, and a native program calls its entry points
// (`velt_hook_argCount`, `velt_hook_argAt`, `velt_hook_argsReady`) without loading it, so the
// readers and the UTF-8 decoder are compiled once, not into every program that reads its
// arguments. Only numbers and strings cross, so a list goes one argument at a time. The kept
// lists and the state of the read (`STATE`, `ARGV`, `NODE_ARGV`) are this module's own (a private
// module: nothing imports it); the readers keep none.
//
// The first call reads both lists (`ready`), one thread at a time: another waits for it. The
// readers take velt's variables from the environment without the environment's lock, which a
// copy in the object could not share; std's changes of the environment call `argsReady` first
// (std/process/env_posix.velt), so none runs during the read, and none comes after it.
//
// Each list is one block of the C library's (`keepArgs`: std/process/args_keep.velt), its address
// in a static atomic; the browser's list, always `["", ""]`, needs none (std/process/args_none.velt).

import { keepArgs, keptArg, keptCount } from "#args-sys";
import { atomicSpinHint, noInline } from "velt/lang/intrinsics";
import { readArgv, readNodeArgv } from "velt/process/args_read";
import { outOfMemory } from "./heap";

/** `process.argv`'s list (`argCount`'s `list`); any other picks `argv()`'s. */
const NODE: u32 = 1;

/** 0: not read yet, 1: being read, 2: both lists kept. */
const STATE = new Atomic<u32>(0);

/** The address of `argv()`'s list (`keepArgs`), once `STATE` is 2. */
const ARGV = new Atomic<usize>(0);

/** The address of Node's `process.argv` list, once `STATE` is 2. */
const NODE_ARGV = new Atomic<usize>(0);

/** Both lists read and kept, by this call or another thread's (`STATE`). */
function ready() {
  if (STATE.load("acquire") !== 2) {
    readOnce();
  }
}

/** The first read: this thread's, or another's it waits for. */
@noInline
function readOnce() {
  if (STATE.compareExchange(0, 1, "acquire", "acquire") === 0) {
    const all = keepArgs(readArgv());
    const node = keepArgs(readNodeArgv());
    if (all === 0 || node === 0) {
      // The C library has no memory for them (or an argument is over 4 GiB: no OS passes one).
      outOfMemory(0);
    }
    ARGV.store(all, "relaxed");
    NODE_ARGV.store(node, "relaxed");
    STATE.store(2, "release");
    return;
  }
  while (STATE.load("acquire") !== 2) {
    atomicSpinHint();
  }
}

/** The kept list `list` picks. */
function kept(list: u32): usize {
  ready();
  return list === NODE ? NODE_ARGV.load("relaxed") : ARGV.load("relaxed");
}

/** The number of arguments in `argv()`'s list (`list` 0), or in Node's `process.argv` (1). */
export function argCount(list: u32): u64 {
  return keptCount(kept(list));
}

/** Argument `i` of the list `list` picks (`argCount`); "" past the last. */
export function argAt(list: u32, i: u64): string {
  return keptArg(kept(list), i);
}

/** Before the environment changes (std/process/env_posix.velt): the first read done. */
export function argsReady(): void {
  ready();
}
