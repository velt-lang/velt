// velt/lang/hooks (internal): the layout of `sigaction` for the executor in Velt's signals
// (sched_signal.velt, #2649 step 4) on an OS without the reactor: nothing is installed.

/** Can signals be watched here? */
export const SUPPORTED: bool = false;
/** The size of `struct sigaction` (with room to spare) and where `sa_flags` is. */
export const ACTION_SIZE: usize = 256;
export const FLAGS_AT: usize = 0;
/** `SA_RESTART`: a system call a handler interrupts goes on. */
export const SA_RESTART: i32 = 0;
/** `SIGUSR1` (the tests raise it). */
export const SIGUSR1: i32 = 0;
