// velt/lang/hooks (internal): Node timers' handles for the executor in Velt's hooks (sched.velt
// `schedTimer*`, #2649). A timer goes in the executor's order (sched_order.velt) and its handle
// has bit 0 set; on a C library's thread (sched_foreign.velt) it is a record that a worker puts in
// the order later (sched_foreign_timer.velt), its handle with bit 0 clear. The program's thread
// starts the executor first, as for its spawns. Each call goes where its handle came from.

import { stdUsed } from "velt/lang/intrinsics";
import * as fg from "./sched_foreign";
import * as ft from "./sched_foreign_timer";
import * as order from "./sched_order";
import * as give from "./sched_order_give";
import * as m from "./sched_mem";
import * as t from "./sched_task";
import * as workers from "./sched_workers";

/**
 * Timer `h` is given back at a counted exit (sched_order_give.velt): one of the order's (a
 * C library's thread's record is left alone).
 */
export function giveBackAtExit(h: u64): void {
  if ((h & 1) !== 0) {
    give.mark((h & ~1) as usize);
  }
}

/** A Node timer due `ms` milliseconds from now, queued: its handle. */
export function timerNew(ms: i64): u64 {
  if (stdUsed("foreignCalls") && !t.onWorker() && fg.foreign()) {
    return ft.timerNew(ms);
  }
  const e = workers.started();
  if (m.ld(e + t.E_CURRENT) === 0) {
    // A module's initializer: its timer names the initializers' task (sched_foreign.velt).
    fg.initTask(e);
  }
  // Not anchored: the order is the process's, and its task may run on any worker.
  return order.timerNew(e, ms) | 1;
}

/** A heap future that completes once timer `h`'s turn has come. */
export function turn(h: u64, gate: u64): usize {
  if (stdUsed("foreignCalls") && (h & 1) === 0) {
    return ft.turn(h as usize);
  }
  workers.started();
  return order.turn((h & ~1) as usize);
}

/** An interval's timer `h` queued again, `ms` after its last turn. */
export function again(h: u64, ms: i64): void {
  if (stdUsed("foreignCalls") && (h & 1) === 0) {
    ft.again(h as usize, ms);
    return;
  }
  order.timerAgain(workers.started(), (h & ~1) as usize, ms);
}

/** Timer `h` leaves the order (`clearTimeout`). */
export function clear(h: u64): void {
  if (stdUsed("foreignCalls") && (h & 1) === 0) {
    ft.clear(h as usize);
    return;
  }
  workers.started();
  order.timerClear((h & ~1) as usize);
}

/** Timer `h` leaves the order and its handle is freed. */
export function free(h: u64): void {
  if (stdUsed("foreignCalls") && (h & 1) === 0) {
    ft.free(h as usize);
    return;
  }
  workers.started();
  order.timerFree((h & ~1) as usize);
}
