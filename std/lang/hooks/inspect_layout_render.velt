// velt/lang/hooks (internal): writes a value as the scanner laid it out (inspect_layout_parse.velt,
// inspect_layout_container.velt): the printed text, copied, except that a container that breaks
// gets one entry per line, or its entries in columns, and a long string its pieces. A container on
// one line is its text as printed and is copied whole. The containers are met in preorder and the
// split strings in order, so the writer keeps a cursor into each.

import {
  ENT_WORDS,
  GROUPED,
  Layout,
  N_CLOSE_END,
  N_COLUMNS,
  N_COUNT,
  N_FIRST,
  N_FLAGS,
  N_MODE,
  N_OPEN,
  N_OPEN_END,
  N_SUBTREE_END,
  N_WIDEST,
  NODE_WORDS,
  ONE_LINE,
} from "velt/lang/hooks/inspect_layout_container";
import { newline, pushRange, pushTextAt, spaces } from "velt/lang/hooks/inspect_layout_pieces";
import { strByteLen, strDataAddress } from "velt/lang/intrinsics";

/** Writes `l`, read from `src`, into the bytes of `out`. */
export function renderLayout(l: Layout, src: string, out: u8[]): void {
  // The writer reads the text through one address: `src`, this function's parameter, keeps its
  // bytes there while it runs (the scanner's address was good while it ran).
  l.data = strDataAddress(src);
  l.wNodes = (l.node.length as u64) / NODE_WORDS;
  l.wNode = 0;
  l.wSplit = 0;
  range(l, l.topStart, l.topEnd, 0, out);
}

/** Writes bytes `a..b` of the text, an entry at indentation `indent`. */
function range(l: Layout, a: u64, b: u64, indent: u64, out: u8[]): void {
  const never: u64 = 0xffffffffffffffff;
  let pos = a;
  while (true) {
    const nodeAt = l.wNode < l.wNodes ? l.node[l.wNode * NODE_WORDS + N_OPEN] : never;
    const splitAt = l.wSplit < (l.splitText.length as u64) ? l.splitAt[l.wSplit * 2] : never;
    const next = nodeAt < splitAt ? nodeAt : splitAt;
    if (next >= b) {
      gap(l, pos, b, indent, out);
      return;
    }
    gap(l, pos, next, indent, out);
    if (next == nodeAt) {
      const n = l.wNode;
      container(l, n, indent, out);
      pos = l.node[n * NODE_WORDS + N_CLOSE_END];
    } else {
      const s = l.splitText[l.wSplit];
      const data = strDataAddress(s);
      pushRange(out, data, 0, strByteLen(s) as u64);
      pos = l.splitAt[l.wSplit * 2 + 1];
      l.wSplit += 1;
    }
  }
}

/** Writes entry record `p`, at indentation `indent`: copied when nothing in it is laid out. */
function entry(l: Layout, p: u64, indent: u64, out: u8[]): void {
  const a = l.ent[p];
  const b = l.ent[p + 1];
  const nodeAt = l.wNode < l.wNodes ? l.node[l.wNode * NODE_WORDS + N_OPEN] : b;
  const splitAt = l.wSplit < (l.splitText.length as u64) ? l.splitAt[l.wSplit * 2] : b;
  if (nodeAt >= b && splitAt >= b) {
    gap(l, a, b, indent, out);
  } else {
    range(l, a, b, indent, out);
  }
}

/** Text as printed, at indentation `indent`: a custom inspect's line breaks get indented. */
function gap(l: Layout, a: u64, b: u64, indent: u64, out: u8[]): void {
  if (l.exact && indent > 0) {
    pushTextAt(out, l.data, a, b, indent);
  } else {
    pushRange(out, l.data, a, b);
  }
}

/** Writes container `n`, in an entry at indentation `indent`. */
function container(l: Layout, n: u64, indent: u64, out: u8[]): void {
  const r = n * NODE_WORDS;
  const mode = l.node[r + N_MODE];
  if (mode == ONE_LINE) {
    pushRange(out, l.data, l.node[r + N_OPEN], l.node[r + N_CLOSE_END]);
    l.wNode = l.node[r + N_SUBTREE_END];
    return;
  }
  pushRange(out, l.data, l.node[r + N_OPEN], l.node[r + N_OPEN_END]);
  l.wNode = n + 1;
  const pad = indent + 2;
  const first = l.node[r + N_FIRST];
  const count = l.node[r + N_COUNT];
  newline(out, pad);
  if (mode == GROUPED) {
    rows(l, r, first, count, pad, out);
  } else {
    for (let e: u64 = 0; e < count; e++) {
      if (e > 0) {
        out.push(0x2c);
        newline(out, pad);
      }
      entry(l, (first + e) * ENT_WORDS, pad, out);
    }
  }
  newline(out, indent);
  // The closing brace, the container's last byte.
  pushRange(out, l.data, l.node[r + N_CLOSE_END] - 1, l.node[r + N_CLOSE_END]);
}

/** A grouped container's entries in rows (Node's `groupArrayElements`), at indentation `pad`. */
function rows(l: Layout, r: u64, first: u64, count: u64, pad: u64, out: u8[]): void {
  const flags = l.node[r + N_FLAGS];
  const numbers = (flags & 1) != 0;
  const more = (flags >> 1) & 1;
  const shown = count - more;
  const cols = l.node[r + N_COLUMNS];
  const at = l.node[r + N_WIDEST];
  let column: u64 = 0;
  for (let j: u64 = 0; j < shown; j++, column = column + 1 == cols ? 0 : column + 1) {
    const p = (first + j) * ENT_WORDS;
    const lastInRow = column + 1 == cols || j + 1 == shown;
    if (j > 0 && column == 0) {
      out.push(0x2c);
      newline(out, pad);
    }
    const fill = l.ent[at + column] - l.ent[p + 2];
    if (numbers) {
      spaces(out, fill);
    }
    entry(l, p, pad, out);
    if (!lastInRow) {
      out.push(0x2c);
      out.push(0x20);
      if (!numbers) {
        spaces(out, fill);
      }
    }
  }
  if (more == 1) {
    out.push(0x2c);
    newline(out, pad);
    entry(l, (first + shown) * ENT_WORDS, pad, out);
  }
}
