// velt/lang/hooks (internal): a `Mutex`'s lock (#2196), which lowering calls for `m.with(f)` on a
// native target (velt_vir `async_fn/sync.rs`). The lock is the first 32 bits of the `Mutex`'s
// 8-byte lock word, the runtime's (velt_rt `mutex.rs`): bit 0 held, bit 1 threads parked on it.
// An uncontended lock or unlock is one compare-and-swap here; the runtime's code runs only when
// the lock is held (it spins a little, then parks the thread) or when threads are parked (the
// unlock wakes one). `with` callbacks never await and are short, so a thread that holds the lock
// releases it soon on the thread that took it.
// The lock counts no `Mutex`es for the module lock (sched_module.velt never read the count); a
// wasm build keeps the runtime's lock, where lowering calls the runtime as before.

import { addressAtomicCas, inline } from "velt/lang/intrinsics";

declare c("c") function velt_rt_mutex_lock_slow$rt(p: usize): void;
declare c("c") function velt_rt_mutex_unlock_slow$rt(p: usize): void;

/** The lock word's held bit; the runtime sets bit 1 while threads are parked on it. */
const LOCKED: u32 = 1;

/** Locks the `Mutex` whose lock word is at `p`. */
@inline("always")
export function mutexLock(p: usize): void {
  // SAFETY: `p` is a `Mutex`'s lock word, changed only atomically (here and by the runtime).
  if (unsafe { addressAtomicCas<u32>(p, 0, LOCKED, "acquire", "relaxed") } !== 0) {
    // SAFETY: the runtime's slow path on the same lock word, which it changes only atomically.
    unsafe {
      velt_rt_mutex_lock_slow$rt(p);
    }
  }
}

/** Unlocks the `Mutex` whose lock word is at `p`, which this thread locked. */
@inline("always")
export function mutexUnlock(p: usize): void {
  // SAFETY: as `mutexLock`. A word that is not `LOCKED` alone has threads parked on it: the
  // runtime wakes one (or hands the lock to it).
  if (unsafe { addressAtomicCas<u32>(p, LOCKED, 0, "release", "relaxed") } !== LOCKED) {
    // SAFETY: as `mutexLock`'s; this thread holds the lock.
    unsafe {
      velt_rt_mutex_unlock_slow$rt(p);
    }
  }
}
