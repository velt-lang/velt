// velt/lang/number (internal): integers as text, in Velt (#1982). The digits are built in
// registers (one multiply per split over all lanes at once, `digits4` and `digits8`) and handed
// to the string as words (`strAsciiWords`, `strbufPushAsciiWords`), so `${n}` and `String(n)`
// make no runtime call: an integer's text is at most 20 digits and a sign, which a string holds
// inline. The leading zeros are counted from the digits (`leadingZeroBits`): no table is read,
// so no bounds check, whose message would bring in the unsigned printer. The entry points are
// out of line (`@noInline`): inlined at every `${n}`, they would take the program's inlining
// budget from hotter code.

import {
  inline,
  noInline,
  strAsciiWords,
  strbufPushAsciiWord,
  strbufPushAsciiWords,
  trunc,
} from "velt/lang/intrinsics";

// The byte `-`, as velt/lang/number/text has it: not imported from there, so that a program that
// prints only integers doesn't load the float printer's text helpers.
const MINUS: u64 = 0x2d;

declare function velt_rt_math_clz64(x: u64): u64;
declare function velt_rt_math_ctz64(x: u64): u64;

/**
 * Up to 24 ASCII bytes in three words, byte `i` in bits `8 * (i % 8)` of word `i / 8`, every
 * byte past `len` 0: what `strAsciiWords` and `strbufPushAsciiWords` take.
 */
export struct Words {
  w0: u64;
  w1: u64;
  w2: u64;
  len: usize;
}

// 0, then 10^1 to 10^19: where the digit count of `digitCount`'s estimate goes up by one.
const BOUNDS: u64[] = [
  0,
  10,
  100,
  1000,
  10000,
  100000,
  1000000,
  10000000,
  100000000,
  1000000000,
  10000000000,
  100000000000,
  1000000000000,
  10000000000000,
  100000000000000,
  1000000000000000,
  10000000000000000,
  100000000000000000,
  1000000000000000000,
  10000000000000000000,
];

/** The number of decimal digits of `v` (1 for 0). */
export function digitCount(v: u64): u64 {
  // floor(bits * log10(2)), from the bit length: the count, or one less.
  const t = ((64 - velt_rt_math_clz64(v | 1)) * 1233) >> 12;
  return v >= BOUNDS[t] ? t + 1 : t;
}

/**
 * The eight ASCII digits of `x` (below 10^8), leading zeros included, the first in the low byte:
 * `x` split into two halves of four digits, each half into two of two, each of those into two
 * digits, every split one multiply over all lanes at once (P. Khuong, D. Lemire).
 */
export function digits8(x: u64): u64 {
  const hundreds = ((x % 10000) << 32) | (x / 10000);
  const high = ((hundreds * 10486) >> 20) & 0x0000007f0000007f;
  const tens = ((hundreds - high * 100) << 16) | high;
  const tenHigh = ((tens * 103) >> 10) & 0x000f000f000f000f;
  const digits = ((tens - tenHigh * 10) << 8) | tenHigh;
  return digits | 0x3030303030303030;
}

/**
 * The four ASCII digits of `x` (below 10^4), leading zeros included, the first in the low byte:
 * `x` split into two halves of two digits, each into two digits, as `digits8` does.
 */
@inline
function digits4(x: u64): u64 {
  const hi = (x * 5243) >> 19;
  const tens = ((x - hi * 100) << 16) | hi;
  const tenHigh = ((tens * 103) >> 10) & 0x000f000f;
  return (((tens - tenHigh * 10) << 8) | tenHigh) | 0x30303030;
}

// The leading zeros of the ASCII digits `d` (first digit in the low byte) as bits: 8 for each
// byte before the first that isn't "0". `stop` is a bit in the byte of the last digit, which is
// never dropped: a zero keeps its last digit, and the count needs no test for no bits at all.
@inline
function leadingZeroBits(d: u64, stop: u64): u64 {
  return velt_rt_math_ctz64((d ^ 0x3030303030303030) | stop) & 56;
}

/** The decimal digits of `v`, after a `-` when `neg`. */
export function intWords(v: u64, neg: bool): Words {
  if (v < 100000000) {
    return shortWords(v, neg);
  }
  return neg ? longNegative(v) : longPositive(v);
}

/**
 * `intWords` of a `v` below 10^8: one group of digits, its leading zeros shifted out. Inlined
 * into every caller (`@inline`): the entry points' common case, whose three-word result would
 * otherwise go through memory.
 */
@inline
export function shortWords(v: u64, neg: bool): Words {
  if (v >= 10000) {
    return eightWords(v, neg);
  }
  // Up to four digits (counters, coordinates, indexes): four with their leading zeros, then the
  // zeros shifted out.
  const all = digits4(v);
  const z = leadingZeroBits(all, 0x01000000);
  const d = all >> z;
  const n = 4 - (z >> 3);
  if (!neg) {
    return Words { w0: d, w1: 0, w2: 0, len: n as usize };
  }
  return Words { w0: (d << 8) | MINUS, w1: 0, w2: 0, len: (n + 1) as usize };
}

/**
 * `shortWords` by eight digits alone, for any `v` below 10^8: their leading zeros shifted out.
 * Inlined (`@inline`): `console.log`'s writer (velt/lang/number/integer_write) uses it for every
 * number below 10^8, the others from 10^4 up.
 */
@inline
export function eightWords(v: u64, neg: bool): Words {
  const all = digits8(v);
  const z = leadingZeroBits(all, 0x0100000000000000);
  const d = all >> z;
  const n = 8 - (z >> 3);
  if (!neg) {
    return { w0: d, w1: 0, w2: 0, len: n as usize };
  }
  return { w0: (d << 8) | MINUS, w1: d >> 56, w2: 0, len: (n + 1) as usize };
}

/**
 * `intWords` of a `v` from 10^8 up: three groups of eight digits, 24 digits with leading zeros,
 * of which the first `24 - len` are dropped. At least four are (the text is at most 20 bytes):
 * with a minus, the last one dropped becomes it. The first group is below 1845, so at most four
 * digits (`digits4`), in the upper half of its word, and its lower half is never read. Inlined
 * (`@inline`) into `longPositive`, `longNegative` and `console.log`'s writer (velt/lang/number/integer_write),
 * each out of line, whose three-word result would otherwise come back through memory.
 */
@inline
export function longWords(v: u64, neg: bool): Words {
  const lo = v % 100000000;
  const rest = v / 100000000;
  let a0 = digits4(rest / 100000000) << 32;
  let a1 = digits8(rest % 100000000);
  let a2 = digits8(lo);
  // The leading zeros: in the first group, or, when it is 0, in the second, which isn't then (`v`
  // is at least 10^8). The first group's lower half is 0, not "0", and is dropped either way.
  const first = a0 ^ 0x3030303000000000;
  const z =
    first != 0 ? velt_rt_math_ctz64(first) & 56 : 64 + leadingZeroBits(a1, 0x0100000000000000);
  const n = 24 - (z >> 3);
  const len = neg ? n + 1 : n;
  const k = 24 - len;
  if (k >= 8) {
    a0 = a1;
    a1 = a2;
    a2 = 0;
  }
  // The remaining bytes to drop as bits (0 to 56); `(a << 1) << (63 - r)` is `a << (64 - r)`
  // without a shift by 64 when `r` is 0.
  const r = (k & 7) * 8;
  let w0 = (a0 >> r) | ((a1 << 1) << (63 - r));
  const w1 = (a1 >> r) | ((a2 << 1) << (63 - r));
  const w2 = a2 >> r;
  if (neg) {
    w0 = (w0 & ~(0xff as u64)) | MINUS;
  }
  return { w0, w1, w2, len: len as usize };
}

// `longWords` without a minus, and with one: out of their callers (rare, 10^8 and up, and each
// caller would otherwise get a copy), two functions so that neither tests the sign.
@noInline
function longPositive(v: u64): Words {
  return longWords(v, false);
}

@noInline
function longNegative(v: u64): Words {
  return longWords(v, true);
}

/**
 * `String(v)`. Each sign's short path is its own, so neither pays for the other's sign, and each
 * is one unsigned range test: no stack frame on either. The long text is out of line, one
 * function per sign. Out of its callers, as the other integer entry points: inlined at every
 * `${n}`, the formatter took the program-wide inlining budget from hotter code
 * (`bench/json/navigate`).
 */
@noInline
export function i64Text(v: i64): string {
  const u = v as u64;
  const a = ~u + 1;
  if (u + 9999999 < 9999999) {
    // -9999999 to -1: eight digits at a time, as negative numbers are rarely short.
    const w = eightWords(a, true);
    return strAsciiWords(w.w0, 0, 0, w.len);
  }
  if (u < 100000000) {
    const w = shortWords(u, false);
    return strAsciiWords(w.w0, 0, 0, w.len);
  }
  if (v < 0) {
    return longNegativeText(a);
  }
  return longText(u);
}

/** `String(v)`. */
@noInline
export function u64Text(v: u64): string {
  if (v < 100000000) {
    const w = shortWords(v, false);
    return strAsciiWords(w.w0, 0, 0, w.len);
  }
  return longText(v);
}

// The text of `a`, from 10^8 up: out of the entry points, so that their short path needs no
// stack frame.
@noInline
function longText(a: u64): string {
  const w = longPositive(a);
  return strAsciiWords(w.w0, w.w1, w.w2, w.len);
}

// The text of `-a`, past one word (`a` from 10^7 up).
@noInline
function longNegativeText(a: u64): string {
  const w = a < 100000000 ? eightWords(a, true) : longNegative(a);
  return strAsciiWords(w.w0, w.w1, w.w2, w.len);
}

/**
 * Appends `String(v)` to the builder `buf`. A number that isn't negative is `pushU64`'s path:
 * up to 8 digits are one word, appended with `strbufPushAsciiWord`; longer numbers are
 * `pushLong`'s. A negative number is `pushNegative`'s.
 */
@noInline
export function pushI64(buf: string, v: i64): void {
  if (v < 0) {
    const a = ~(v as u64) + 1;
    pushNegative(buf, a);
    return;
  }
  push(buf, v as u64);
}

/** Appends `String(v)` to the builder `buf`, as `pushI64`. */
@noInline
export function pushU64(buf: string, v: u64): void {
  push(buf, v);
}

// Appends the text of `a`, as `u64Text` makes it (inlined into each entry point). The builder
// is passed on with locals only after it (CLAUDE.md "the string builder passed as a `string`").
@inline
function push(buf: string, a: u64): void {
  if (a < 100000000) {
    const w = shortWords(a, false);
    const w0 = w.w0;
    const len = w.len;
    strbufPushAsciiWord(buf, w0, len);
    return;
  }
  pushLong(buf, a);
}

// Appends `-a`, as `push` appends `a`: up to 8 bytes as one word here.
@inline
function pushNegative(buf: string, a: u64): void {
  if (a < 10000000) {
    const w = eightWords(a, true);
    const w0 = w.w0;
    const len = w.len;
    strbufPushAsciiWord(buf, w0, len);
    return;
  }
  pushLongNegative(buf, a);
}

// Appends `a`, from 10^8 up: out of the entry points, so that their short path needs no stack
// frame.
@noInline
function pushLong(buf: string, a: u64): void {
  const w = longPositive(a);
  const w0 = w.w0;
  const w1 = w.w1;
  const w2 = w.w2;
  const len = w.len;
  strbufPushAsciiWords(buf, w0, w1, w2, len);
}

// Appends `-a`, past one word (`a` from 10^7 up).
@noInline
function pushLongNegative(buf: string, a: u64): void {
  const w = a < 100000000 ? eightWords(a, true) : longNegative(a);
  const w0 = w.w0;
  const w1 = w.w1;
  const w2 = w.w2;
  const len = w.len;
  strbufPushAsciiWords(buf, w0, w1, w2, len);
}

/** Is `x` a whole number below 2^53 in magnitude (`-0` included)? Its text is `x as i64`'s. */
export function isWhole(x: f64): bool {
  return x == trunc(x) && x < 9007199254740992.0 && x > -9007199254740992.0;
}
