// velt/lang/number (internal): powers of ten for the shortest digits of a double,
// generated by scripts/gen-pow10-table.py: do not edit.
//
// For k from -324 to 292, 10^-k as g = floor(beta) + 1, where 10^-k = beta * 2^r and
// 2^125 <= beta < 2^126: its high 63 bits, then its low 63 bits. `pow10` in
// std/lang/number/shortest.velt rebuilds each from `KEPT` (every 27th k, less 1), `FIVES`
// and `ADJUST` (two bits per k, 32 per word); the script checks every one.

export const G_K_MIN: i64 = -324;
export const G_STEP: i64 = 27;

