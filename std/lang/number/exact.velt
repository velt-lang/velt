// velt/lang/number (internal): the exact decimal expansion of a double, in Velt (#2196), for the
// printers that round it to a number of digits (velt/lang/hooks/number_digits): `toExponential(d)`,
// `toPrecision(p)` and the `toFixed` results that 64 bits don't hold. A positive double is
// `m * 2^q` with `m` below 2^53: from `q = 0` up it is the integer `m * 2^q`, below that
// `m * 5^-q / 10^-q`. Either integer is built in base 10^9 (at most 86 limbs: `m * 5^1074` has 767
// digits) by multiplying by powers of two or five that keep each step within 64 bits, and its
// digits are the expansion. JavaScript rounds these digits half up (ties away from zero), which
// needs the exact digit after the last one kept, not the shortest ones.

import { arraySetLen, arrayWithCapacity } from "velt/lang/intrinsics";
import { digitCount } from "velt/lang/number/integer";

const BASE: u64 = 1000000000;

// 5^0 to 5^13 (5^13 times a limb stays below 2^64).
const POW5: u64[] = [
  1,
  5,
  25,
  125,
  625,
  3125,
  15625,
  78125,
  390625,
  1953125,
  9765625,
  48828125,
  244140625,
  1220703125,
];

/** A positive double's exact decimal digits (ASCII, the first not `0`) and the power of ten of the first. */
export struct Exact {
  digits: u8[];
  e: i64;
}

// `limbs` (base 10^9, least significant first) times `f` (at most 2^32).
function mulSmall(limbs: u64[], f: u64): void {
  let carry: u64 = 0;
  const n = limbs.length;
  for (let i: usize = 0; i < n; i++) {
    const t = limbs[i] * f + carry;
    limbs[i] = t % BASE;
    carry = t / BASE;
  }
  while (carry != 0) {
    limbs.push(carry % BASE);
    carry = carry / BASE;
  }
}

/** The exact decimal digits of `a`, finite and above 0. */
export function exactDigits(a: f64): Exact {
  const bits = a.toBits();
  const be = ((bits >> 52) & 0x7ff) as i64;
  const frac = bits & 0xfffffffffffff;
  const m = be == 0 ? frac : frac | 0x10000000000000;
  const q: i64 = be == 0 ? -1074 : be - 1075;
  const limbs: u64[] = arrayWithCapacity(90);
  limbs.push(m % BASE);
  if (m >= BASE) {
    limbs.push(m / BASE);
  }
  if (q > 0) {
    let k = q;
    while (k > 0) {
      const s = k > 32 ? 32 : k;
      mulSmall(limbs, (1 as u64) << (s as u64));
      k -= s;
    }
  } else {
    let k = -q;
    while (k > 0) {
      const s = k > 13 ? 13 : k;
      mulSmall(limbs, POW5[s as usize]);
      k -= s;
    }
  }
  // The top limb without leading zeros, then nine digits for each of the others.
  const n = limbs.length;
  const top = limbs[n - 1];
  const head = digitCount(top) as usize;
  const len = head + 9 * (n - 1);
  const digits: u8[] = arrayWithCapacity(len);
  arraySetLen(digits, len);
  let v = top;
  for (let i: usize = 0; i < head; i++) {
    digits[head - 1 - i] = (48 + v % 10) as u8;
    v = v / 10;
  }
  let at = head;
  for (let l: usize = 1; l < n; l++) {
    let w = limbs[n - 1 - l];
    for (let i: usize = 0; i < 9; i++) {
      digits[at + 8 - i] = (48 + w % 10) as u8;
      w = w / 10;
    }
    at += 9;
  }
  return { digits, e: (len as i64) - 1 + (q < 0 ? q : 0) };
}

/**
 * The first `n` (0 or more) digits of `x` rounded half up, with zeros past its last digit: `n`
 * bytes, or `n + 1` (a `1` and `n` zeros) when they round up to the next power of ten.
 */
export function roundDigits(x: Exact, n: i64): u8[] {
  const d = x.digits;
  const len = d.length as i64;
  const out: u8[] = arrayWithCapacity((n + 1) as usize);
  for (let i: i64 = 0; i < n; i++) {
    out.push(i < len ? d[i as usize] : 48);
  }
  if (n < len && d[n as usize] >= 53) {
    let i = n - 1;
    while (i >= 0 && out[i as usize] == 57) {
      out[i as usize] = 48;
      i--;
    }
    if (i >= 0) {
      out[i as usize] = out[i as usize] + 1;
    } else if (n > 0) {
      // 99…9 became 00…0: 10…0, one digit longer.
      out[0] = 49;
      out.push(48);
    } else {
      out.push(49);
    }
  }
  return out;
}
