// velt/lang/number (internal): `x.toFixed(digits)` (#1982), in a module of its own so that a
// program loads it, and with it std's number formatter, only when it mentions `toFixed`
// (std/prelude/global/to_fixed.velt, a conditional global): the prelude is in every program, and
// hello world would otherwise lex, parse and check the formatter.

import { fixedText } from "velt/lang/number/fixed";

extend f64 {
  /**
   * `digits` (0 to 100) decimals, rounded like JS: to the nearest, and on an exact tie away from
   * zero (`(0.5).toFixed(0)` is "1", `(-1.25).toFixed(1)` is "-1.3"; `(1.005).toFixed(2)` is
   * "1.00" because 1.005 is really 1.00499…). From 1e21 up it is `String(x)`, as in JS.
   */
  toFixed(digits: i64 = 0): string {
    if (digits < 0 || digits > 100) {
      panic("RangeError: toFixed() digits argument must be between 0 and 100");
    }
    return fixedText(this, digits);
  }
}
