// velt/lang/number (internal): text of up to 32 ASCII bytes held in four words (#1982), the
// form numbers are laid out in before `strAsciiWords` / `strbufPushAsciiWords` store them:
// bytes placed, inserted and moved with shifts and masks, no memory.

/** The ASCII minus sign. */
export const MINUS: u64 = 0x2d;

/** Up to 32 ASCII bytes in four words, byte `i` in bits `8 * (i % 8)` of word `i / 8`. */
export struct Text {
  w0: u64;
  w1: u64;
  w2: u64;
  w3: u64;
}

export const ZEROS: u64 = 0x3030303030303030;
export const DOT: u64 = 0x2e;

/** A mask of the low `n` bytes of a word, `n` clamped to 0..8. */
export function lowBytes(n: i64): u64 {
  if (n <= 0) {
    return 0;
  }
  if (n >= 8) {
    return 0xffffffffffffffff;
  }
  return ((1 as u64) << ((n * 8) as u64)) - 1;
}

/**
 * The bytes of `t` from byte `lo` to byte `hi` (0 to 32), the others 0, OR'd with `fill`'s bytes
 * there.
 */
export function between(t: Text, lo: i64, hi: i64, fill: u64): Text {
  const m0 = lowBytes(hi) & ~lowBytes(lo);
  const m1 = lowBytes(hi - 8) & ~lowBytes(lo - 8);
  const m2 = lowBytes(hi - 16) & ~lowBytes(lo - 16);
  const m3 = lowBytes(hi - 24) & ~lowBytes(lo - 24);
  return {
    w0: (t.w0 | fill) & m0,
    w1: (t.w1 | fill) & m1,
    w2: (t.w2 | fill) & m2,
    w3: (t.w3 | fill) & m3,
  };
}

/** `t`'s bytes `p` (0 to 7) places later. */
export function shift(t: Text, p: i64): Text {
  const s = (p * 8) as u64;
  const r = 63 - s;
  return {
    w0: t.w0 << s,
    w1: (t.w1 << s) | ((t.w0 >> 1) >> r),
    w2: (t.w2 << s) | ((t.w1 >> 1) >> r),
    w3: (t.w3 << s) | ((t.w2 >> 1) >> r),
  };
}

/** The bytes of `word` placed from byte `at` (0 to 31; those past byte 31 are dropped). */
export function placed(word: u64, at: i64): Text {
  const s = ((at & 7) * 8) as u64;
  const lo = word << s;
  const hi = (word >> 1) >> (63 - s);
  const j = at >> 3;
  return {
    w0: j == 0 ? lo : 0,
    w1: j == 1 ? lo : j == 0 ? hi : 0,
    w2: j == 2 ? lo : j == 1 ? hi : 0,
    w3: j == 3 ? lo : j == 2 ? hi : 0,
  };
}

/** The bytes of `a` and of `b` together (each byte set in at most one of them). */
export function or(a: Text, b: Text): Text {
  return { w0: a.w0 | b.w0, w1: a.w1 | b.w1, w2: a.w2 | b.w2, w3: a.w3 | b.w3 };
}

/** `t` with byte `b` inserted at `at`: the bytes from `at` on move one place. */
export function insert(t: Text, at: i64, b: u64): Text {
  // The bytes before `at`, and the others (`t` without them), moved one place.
  const head = between(t, 0, at, 0);
  const rest: Text = {
    w0: t.w0 ^ head.w0,
    w1: t.w1 ^ head.w1,
    w2: t.w2 ^ head.w2,
    w3: t.w3 ^ head.w3,
  };
  return or(or(head, shift(rest, 1)), placed(b, at));
}

/** `t`'s bytes `p` (0 to 31) places later; those past byte 31 are dropped. */
export function moved(t: Text, p: i64): Text {
  let u = t;
  for (let w = p >> 3; w > 0; w--) {
    u = { w0: 0, w1: u.w0, w2: u.w1, w3: u.w2 };
  }
  return shift(u, p & 7);
}
