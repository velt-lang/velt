import { Event } from "velt/lang/event/event";
import {
  AddEventListenerOptions,
  EventListenerObject,
  EventListenerOptions,
} from "velt/lang/event/event_target";

export interface ARIAMixin {}

export interface Animatable {}

export interface CSSStyleDeclaration {
  backgroundColor: string;
  color: string;
  cssText: string;
  display: string;
  fontSize: string;
  getPropertyValue(property: string): string;
  padding: string;
  removeProperty(property: string): string;
  setProperty(property: string, value: string | null, priority?: string): void;
}

export interface ChildNode extends Node {
  remove(): void;
}

export type DOMStringMap = Record<string, string | undefined>;

export interface DocumentFragment extends Node, NonElementParentNode, ParentNode {}

export interface DocumentOrShadowRoot {
  readonly activeElement: Element | null;
}

export interface Element extends Node, ARIAMixin, Animatable, ChildNode, NonDocumentTypeChildNode, ParentNode, Slottable {
  readonly tagName: string;
  id: string;
  className: string;
  innerHTML: string;
  getAttribute(qualifiedName: string): string | null;
  setAttribute(qualifiedName: string, value: string): void;
  setAttributeNS(namespace: string | null, qualifiedName: string, value: string): void;
  removeAttribute(qualifiedName: string): void;
  removeAttributeNS(namespace: string | null, localName: string): void;
  hasAttribute(qualifiedName: string): boolean;
  matches(selectors: string): boolean;
  readonly namespaceURI: string | null;
  outerHTML: string;
  scrollIntoView(arg?: boolean | ScrollIntoViewOptions): void;
}

export interface ElementCSSInlineStyle {
  style: CSSStyleDeclaration;
}

export interface ElementContentEditable {
  readonly isContentEditable: boolean;
}

export interface EventTarget {
  addEventListener<E = never>(
    type: string,
    callback: ((evt: Event) => void throws E) | (() => void throws E) | EventListenerObject | null,
    options?: AddEventListenerOptions | boolean,
  ): void;
  removeEventListener<E = never>(
    type: string,
    callback: ((evt: Event) => void throws E) | (() => void throws E) | EventListenerObject | null,
    options?: EventListenerOptions | boolean,
  ): void;
  dispatchEvent(event: Event): boolean throws Error;
}

export interface FocusOptions {
  preventScroll?: boolean;
}

export interface GlobalEventHandlers {}

export type HTMLCollection = ReadonlyArray<Element>;
export type HTMLCollectionOf<T extends Element> = ReadonlyArray<T>;

export interface HTMLDivElement extends HTMLElement {}

export interface HTMLElement extends Element, ElementCSSInlineStyle, ElementContentEditable, GlobalEventHandlers, HTMLOrSVGElement {
  title: string;
  hidden: boolean;
  click(): void;
}

export interface HTMLInputElement extends HTMLElement, PopoverInvokerElement {
  type: string;
  value: string;
  checked: boolean;
  valueAsNumber: number;
}

export interface HTMLOptionElement extends HTMLElement {
  selected: boolean;
  value: string;
}

export type HTMLOptionsCollection = ReadonlyArray<HTMLOptionElement>;

export interface HTMLOrSVGElement {
  focus(options?: FocusOptions): void;
  blur(): void;
  readonly dataset: DOMStringMap;
}

export interface HTMLSelectElement extends HTMLElement {
  value: string;
  multiple: boolean;
  readonly options: HTMLOptionsCollection;
  readonly selectedOptions: HTMLCollectionOf<HTMLOptionElement>;
}

export interface HTMLTextAreaElement extends HTMLElement {
  value: string;
}

export interface Node extends EventTarget {
  readonly nodeType: number;
  readonly nodeName: string;
  readonly parentNode: ParentNode | null;
  readonly firstChild: ChildNode | null;
  readonly lastChild: ChildNode | null;
  readonly nextSibling: ChildNode | null;
  readonly previousSibling: ChildNode | null;
  readonly isConnected: boolean;
  nodeValue: string | null;
  textContent: string | null;
  appendChild<T extends Node>(node: T): T;
  insertBefore<T extends Node>(node: T, child: Node | null): T;
  removeChild<T extends Node>(child: T): T;
  replaceChild<T extends Node>(node: Node, child: T): T;
  cloneNode(subtree?: boolean): Node;
  contains(other: Node | null): boolean;
  readonly childNodes: NodeListOf<ChildNode>;
  compareDocumentPosition(other: Node): number;
  readonly parentElement: HTMLElement | null;
}

export type NodeListOf<TNode extends Node> = ReadonlyArray<TNode>;

export interface NonDocumentTypeChildNode {}

export interface NonElementParentNode {}

export interface ParentNode extends Node {
  querySelector(selectors: string): Element | null;
  querySelectorAll(selectors: string): NodeListOf<Element>;
  readonly children: HTMLCollection;
  readonly firstElementChild: Element | null;
  readonly lastElementChild: Element | null;
}

export interface PopoverInvokerElement {}

export interface SVGElement extends Element, ElementCSSInlineStyle, GlobalEventHandlers, HTMLOrSVGElement {}

export type ScrollBehavior = "auto" | "instant" | "smooth";

export interface ScrollIntoViewOptions extends ScrollOptions {
  block?: ScrollLogicalPosition;
  inline?: ScrollLogicalPosition;
}

export type ScrollLogicalPosition = "center" | "end" | "nearest" | "start";

export interface ScrollOptions {
  behavior?: ScrollBehavior;
}

export interface ShadowRoot extends DocumentFragment, DocumentOrShadowRoot {
  readonly host: Element;
  innerHTML: string;
}

export interface Slottable {}
