// velt/lang/proxy (internal): `includes`, `indexOf` and `lastIndexOf` called on a proxy of an
// array (array.vlt), in Node's order of trap calls.

import { Proxy } from "velt/lang/proxy";
import { arrayArg, arrayInt, arrayRel, trapGet, trapHas } from "velt/lang/proxy/array";

/**
 * `includes`, `indexOf` or `lastIndexOf` (`name`) of the proxy `p` (length `len`, receiver
 * `o`) with the arguments `args`.
 */
export function proxySearch(p: Proxy, name: string, args: any[], o: any, len: number): any {
  const a0 = arrayArg(args, 0);
  if (name === "lastIndexOf") {
    return proxyLastIndexOf(p, a0, args, o, len);
  }
  const none: any = name === "includes" ? false : -1;
  if (len == 0) {
    return none;
  }
  const from = arrayArg(args, 1);
  if (arrayInt(from) >= len) {
    return none;
  }
  for (let k = arrayRel(from, len, 0); k < len; k++) {
    const key = `${k}`;
    if (name === "includes") {
      // `SameValueZero`: `NaN` finds `NaN`.
      const v = trapGet(p, key, o);
      if (v === a0 || (v !== v && a0 !== a0)) {
        return true;
      }
    } else if (trapHas(p, key) && trapGet(p, key, o) === a0) {
      return k;
    }
  }
  return none;
}

/**
 * `lastIndexOf(a0, fromIndex)`: from `fromIndex` (default `len - 1`; negative counts from the
 * end) down to 0, the first element the proxy has (`has`, then `get`) that is `===` `a0`, else
 * -1.
 */
function proxyLastIndexOf(p: Proxy, a0: any, args: any[], o: any, len: number): number {
  if (len == 0) {
    return -1;
  }
  const n = (args.length as i64) > 1 ? arrayInt(args[1]) : len - 1;
  for (let k = n >= 0 ? Math.min(n, len - 1) : len + n; k >= 0; k--) {
    const key = `${k}`;
    if (trapHas(p, key) && trapGet(p, key, o) === a0) {
      return k;
    }
  }
  return -1;
}
