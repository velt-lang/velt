// velt/lang/random (internal): a generator's seed on WebAssembly, where the runtime has what the
// host offers (WASI's `random_get` under wasm32-wasip1, mixed with the clocks); no generator
// fit for secrets, so velt/crypto's externs stay undefined there.

declare function velt_rt_prng_seed(): u64;

/** 64 bits to seed a generator with. */
export function seedWord(): u64 {
  return velt_rt_prng_seed();
}
