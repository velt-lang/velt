// velt/lang/intrinsics (internal): the compile-time decorators the compiler acts on (#2203). The
// compiler finds each through its role in `velt_common::std_hooks` (`decorator_inline`, …), never by
// the name a use is written with, and records every use in `Program::decorators`: none of them
// compiles to code.

/**
 * On a function or method of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/package-machine-code.md §1): how its calls are inlined.
 *
 * - `@inline` (`"hint"`, the default): its body is offered to callers and the inliner should
 *   prefer it, as Rust's `#[inline]`. While a program is compiled as one unit every body is
 *   offered already, so the hint changes nothing yet; it starts to matter once packages are
 *   compiled once (#2943).
 * - `@inline("always")`: every call is inlined, whatever its size, in release builds (debug
 *   builds keep their calls; `vir::Function::inline` carries it to the optimizer and the
 *   backend). For a small entry point whose callers are hot, which the inliner's size limits would
 *   otherwise leave a call. Not on a recursive function, directly or through others: sema reports
 *   it. std writes this form; a bare `@inline` in std is an error.
 *
 * Neither form is allowed on a generator or an async function: sema reports them.
 */
export declare decorator function inline(
  how: "hint" | "always" = "hint",
): FunctionDecorator | MethodDecorator;

/**
 * On a function or method of std, a package or the program: calls of it stay calls. For a large
 * path that is rare or slow anyway (a fallback, a long form), whose copy in every caller would
 * only cost build time and code size: the optimizer and the backend never inline it. A release
 * build may link a std one from the std cache, compiled once without its callers' arguments; one
 * whose callers pass it constants worth folding is kept in the program by name instead (veltc's
 * std cache, `select::NEVER_SERVED`). Not on a generator or an async function: sema reports it.
 */
export declare decorator function noInline(): FunctionDecorator | MethodDecorator;

/**
 * On a function (not a method) of std, a package or the program (velt/compiler
 * re-exports it; docs/internals/design/package-machine-code.md §2): the function is compiled for
 * the CPU extension `target`, which backends may use anywhere in it. Every call of it must then
 * sit behind velt/simd's check of that extension (`if (u32x4.hasShaX86()) { … }`) or in a
 * function gated on the same one, and it can't be used as a value (stored, passed or returned).
 * A closure written inside it starts without the target. It can't gate the program's `main` or a
 * function C calls (`@export`), which nothing checks before they run, nor a nested, async,
 * generator or overloaded function, whose body the target wouldn't reach. An AES target includes
 * its architecture's carry-less multiplication (`u8x16.hasAesArm()` implies `u64x2.hasClmulArm()`).
 * In a debug (Cranelift) build every check is false, so a gated function never runs there.
 */
export declare decorator function targetFeature(
  target: "sha-arm" | "sha-x86" | "clmul-x86" | "clmul-arm" | "aes-x86" | "aes-arm" | "fma-x86" | "bf16-arm",
): FunctionDecorator;

/**
 * On a `declare function` of std/lang/intrinsics: an operation the compiler emits itself, which
 * no Velt code can express (std-layout.md §10). The declaration is the signature calls are checked
 * against (modes.velt says how arguments are passed); velt_sema's table (`intrinsic_decls.rs`)
 * maps its name to the operation. `@intrinsic export declare unsafe function` declares one whose
 * callers must be unsafe code.
 */
export declare decorator function intrinsic(): FunctionDecorator;
