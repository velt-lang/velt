// velt/lang/intrinsics (internal): the compile-time decorators the compiler acts on (#2203). The
// compiler finds each through its role in `velt_common::std_hooks` (`decorator_inline`, …), never by
// the name a use is written with, and records every use in `Program::decorators`: none of them
// compiles to code.

/**
 * On a function or method of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/package-machine-code.md §1): how its calls are inlined.
 *
 * - `@inline` (`"hint"`, the default): its body is offered to callers and the inliner should
 *   prefer it, as Rust's `#[inline]`. While a program is compiled as one unit every body is
 *   offered already, so the hint changes nothing yet; it starts to matter once packages are
 *   compiled once (#2943).
 * - `@inline("always")`: every call is inlined, whatever its size, in release builds (debug
 *   builds keep their calls; `vir::Function::inline` carries it to the optimizer and the
 *   backend). For a small entry point whose callers are hot, which the inliner's size limits would
 *   otherwise leave a call. Not on a recursive function, directly or through others: sema reports
 *   it. std writes this form; a bare `@inline` in std is an error.
 *
 * Neither form is allowed on a generator or an async function: sema reports them.
 */
export declare decorator function inline(
  how: "hint" | "always" = "hint",
): FunctionDecorator | MethodDecorator;

/**
 * On a function or method of std, a package or the program: calls of it stay calls. For a large
 * path that is rare or slow anyway (a fallback, a long form), whose copy in every caller would
 * only cost build time and code size: the optimizer and the backend never inline it. A release
 * build may link a std one from the std cache, compiled once without its callers' arguments; one
 * whose callers pass it constants worth folding is kept in the program by name instead (veltc's
 * std cache, `select::NEVER_SERVED`). Not on a generator or an async function: sema reports it.
 */
export declare decorator function noInline(): FunctionDecorator | MethodDecorator;

/**
 * On a function or method of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/package-machine-code.md §1): its calls are rare, as Rust's `#[cold]`. For
 * an error path, a slow fallback or a resize: release builds lay the branches that lead to its
 * calls out of the hot code, and the optimizer keeps all but a trivial body out of its callers.
 * Its calls return as any others do. Not with `@inline`, which asks the opposite, nor on a
 * generator, an async function or a `declare function`: sema reports them. With `@noInline`, no
 * call is inlined at all.
 */
export declare decorator function cold(): FunctionDecorator | MethodDecorator;

/**
 * On a function (not a method) of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/call-variants.md): a call whose arguments show at compile time that it
 * needs less calls `plain` instead, a function of the same module that takes the same arguments
 * and gives the same result for them. Every condition must hold; each names an argument (`arg`,
 * 0 for the first) and one test:
 *
 * - `startsWith: "http:"`: the argument is a string literal, or a template literal whose text
 *   before its first `${…}`, starting with that text (ASCII letters in either case);
 * - `lacks: "tls"`: the argument is an object literal without that property and without a
 *   spread, or it is left out;
 * - `field: "redirect", oneOf: ["manual", "error"]`: the argument is an object literal without a
 *   spread whose property is one of those string literals.
 *
 * Every other call, and the function used as a value, is the function itself. For an entry point
 * with a costly part only some arguments need (`fetch`'s TLS client for `https:`): a program whose
 * calls all take `plain` neither builds nor loads that part. Not on a method, a generator or an
 * overloaded function.
 */
export declare decorator function variant(
  plain: string,
  ...when: { arg: number; startsWith?: string; lacks?: string; field?: string; oneOf?: string[] }[],
): FunctionDecorator;

/**
 * On a function (not a method) of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/package-machine-code.md §2): the function is compiled for the CPU
 * features `targets` (one or more, `"avx2-x86"`, `"bmi2-x86"`, `"crc-arm"`, …) and everything they
 * imply (AVX2 implies AVX, SSE4.2 and down), which backends may use anywhere in it. Every call of
 * it must then sit behind checks of those features (velt/arch's `Avx2.isSupported()`, or
 * velt/simd's older `u32x4.hasShaX86()` and the like) or in a function gated on features that
 * cover them, and it can't be used as a value (stored, passed or returned). A closure written
 * inside it starts without the features. It can't gate the program's `main` or a function C calls
 * (`@export`), which nothing checks before they run, nor a nested, async, generator or overloaded
 * function, whose body the features wouldn't reach. In a debug (Cranelift) build every check is
 * false, so a gated function never runs there.
 */
export declare decorator function targetFeature(
  ...targets: ("sha-arm" | "sha-x86" | "clmul-x86" | "clmul-arm" | "aes-x86" | "aes-arm" | "fma-x86" | "bf16-arm" | "sse3-x86" | "ssse3-x86" | "sse4.1-x86" | "sse4.2-x86" | "popcnt-x86" | "cmpxchg16b-x86" | "avx-x86" | "avx2-x86" | "bmi1-x86" | "bmi2-x86" | "lzcnt-x86" | "movbe-x86" | "f16c-x86" | "avx512f-x86" | "avx512bw-x86" | "avx512cd-x86" | "avx512dq-x86" | "avx512vl-x86" | "avx512vbmi-x86" | "avx512bitalg-x86" | "dotprod-arm" | "crc-arm" | "sha3-arm" | "fp16-arm" | "i8mm-arm" | "adx-x86")[],
): FunctionDecorator;

/**
 * On a `struct` of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/package-machine-code.md §5): the struct is passed exactly as its one
 * field is, in registers between Velt functions and in each target's C calling convention, so a
 * C function declared with it (`declare c`, `@export`) takes and returns the field's C type: a
 * `struct Meters { readonly m: f64; }` crosses as C's `double`. The struct has exactly one field,
 * which is neither optional nor `void`, and is not a `declare c struct`: sema reports the rest.
 */
export declare decorator function repr(how: "transparent"): TypeDecorator;

/**
 * On a `struct` of std, a package or the program (velt/compiler re-exports it;
 * docs/internals/design/package-machine-code.md §5): its values are aligned to `bytes`, a power
 * of two from 1 to 4096, and its size is a multiple of it, so each element of an array starts on
 * such a boundary (`@align(64)` gives every element a cache line of its own). It never lowers the
 * natural alignment, which stays where it is larger. Not on a `declare c struct`, whose layout is
 * C's.
 */
export declare decorator function align(bytes: u32): TypeDecorator;

/**
 * On std's `declare generated` functions only: the parameters every instance the generator
 * writes modifies, its output or input stream (`writeJson`'s `w`). They take their final mode
 * where the function is declared, so a program's instances never raise them; a parameter it
 * does not list may still be modified by the program's own code an instance runs (a `toJSON`)
 * (docs/internals/design/build-architecture.md, "Units in sema").
 */
export declare decorator function modifies(...params: string[]): FunctionDecorator;

/**
 * On a `declare function` of std/lang/intrinsics: an operation the compiler emits itself, which
 * no Velt code can express (std-layout.md §10). The declaration is the signature calls are checked
 * against (modes.velt says how arguments are passed); velt_sema's table (`intrinsic_decls.rs`)
 * maps its name to the operation. `@intrinsic export declare unsafe function` declares one whose
 * callers must be unsafe code.
 */
export declare decorator function intrinsic(): FunctionDecorator;
