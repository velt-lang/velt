// velt/lang/intrinsics (internal): memory at an address, for velt/ffi's raw reads of C memory
// (docs/internals/design/c-ffi.md) and std's own runtime code (the async executor,
// docs/internals/design/intrinsics.md "Memory at an address"). The public surface is velt/ffi's
// unsafe functions.

import { intrinsic } from "./decorators";
import type { Copied } from "./modes";

/**
 * The `T` (a number type or `bool`) at `address`, unchecked. Unsafe: a `T` must be there.
 */
@intrinsic
export declare unsafe function addressLoad<T>(address: usize): T;

/**
 * Writes `value`, a `T` (a number type or `bool`), at `address`, unchecked. Unsafe: the memory
 * must be writable and hold a `T` nothing else reads or writes meanwhile.
 */
@intrinsic
export declare unsafe function addressStore<T>(address: usize, value: Copied<T>): void;

/**
 * The integer `T` at `address`, read atomically with ordering `order` (as `Atomic.load`). Unsafe:
 * an aligned `T` must be there, and every thread must change it atomically.
 */
@intrinsic
export declare unsafe function addressAtomicLoad<T>(
  address: usize,
  order: "relaxed" | "acquire" | "seqcst",
): T;

/**
 * Makes `value` the integer at `address` atomically (as `Atomic.store`). Unsafe: as
 * `addressAtomicLoad`.
 */
@intrinsic
export declare unsafe function addressAtomicStore<T>(
  address: usize,
  value: Copied<T>,
  order: "relaxed" | "release" | "seqcst",
): void;

/**
 * The read-modify-write `op` of the integer at `address` with `value` (as the `Atomic` method of
 * that name: add and sub wrap, max and min compare as `T` does); returns the previous value.
 * Unsafe: as `addressAtomicLoad`.
 */
@intrinsic
export declare unsafe function addressAtomicRmw<T>(
  address: usize,
  op: "exchange" | "add" | "sub" | "and" | "or" | "xor" | "max" | "min",
  value: Copied<T>,
  order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst",
): T;

/**
 * Makes `value` the integer at `address` if it is `expected`; returns the previous value (as
 * `Atomic.compareExchange`). Unsafe: as `addressAtomicLoad`.
 */
@intrinsic
export declare unsafe function addressAtomicCas<T>(
  address: usize,
  expected: Copied<T>,
  value: Copied<T>,
  order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst",
  failure: "relaxed" | "acquire" | "seqcst",
): T;

/**
 * As `addressAtomicCas`, whether it made the change, which may fail spuriously (as
 * `Atomic.compareExchangeWeak`). Unsafe: as `addressAtomicLoad`.
 */
@intrinsic
export declare unsafe function addressAtomicCasWeak<T>(
  address: usize,
  expected: Copied<T>,
  value: Copied<T>,
  order: "relaxed" | "acquire" | "release" | "acqrel" | "seqcst",
  failure: "relaxed" | "acquire" | "seqcst",
): bool;

/**
 * The address of the C function of `f`, a function decorated `@export("c_name")` (velt/ffi), for
 * a C API that takes a function pointer (`pthread_create`'s start routine, a callback). Unsafe:
 * C calls it with whatever arguments it has, which the exported function's C signature must
 * describe. Its argument names the function; anything else is an error.
 */
@intrinsic
export declare unsafe function exportedAddress<F>(f: F): usize;
