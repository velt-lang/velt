// velt/lang/intrinsics (internal): compile-time facts about a type. Each is a constant once the
// generic code that asks is instantiated, so a test of one costs nothing and the branch it
// rules out is not compiled; the value passed only names the type and is not evaluated.

import { intrinsic } from "./decorators";

/**
 * Whether `null` is a value of `T` (`T` an option, `X | null`, once substituted): then a generic
 * `T | null` is `T` itself and its `null` is a `T`.
 */
@intrinsic
export declare function holdsNull<T>(probe: T): bool;

/**
 * Whether `value`, of the class type `T`, is an object of `T` itself and not of a class that
 * extends it. A constant `true` when no class of the program extends `T`, and an `if` then lowers
 * only that branch: a built-in keeps its own code for its own objects, and calls the methods a
 * subclass may override, where JavaScript's specification does, only for a subclass's objects.
 */
@intrinsic
export declare function isExactClass<T>(value: T): bool;

/**
 * `speciesNew(receiver, args…)`: a new object of `receiver`'s own class, made by its constructor
 * with `args` (JavaScript's SpeciesConstructor, `new C(args…)`), as the class `T` of `receiver`
 * (a class std declares), or `null` where std makes the copy itself, as a `T`: for `T`'s own
 * objects, and for a subclass whose constructor can't take `args` (the compiler warns where it
 * is declared). `args` are what `T`'s constructor takes, plain local variables or literals. It
 * throws what a subclass's constructor throws. Sema writes it out as a test of the program's
 * classes that extend `T`, deepest first (`body::expr::species`): with none, it is `null`.
 */
@intrinsic
export declare function speciesNew<T>(receiver: T, ...args: any[]): T | null;

/**
 * `null` as a `T` that holds null (`holdsNull`). For any other `T` it stops the program with an
 * internal error: std reaches it only behind a `holdsNull` test.
 */
@intrinsic
export declare function nullAs<T>(): T;

/**
 * Whether a value of type `T` that a call borrows can be reached through another reference while
 * the call runs (lowering counts the type, or borrows values of it inside counted objects).
 * Only then can a callback change it.
 */
@intrinsic
export declare function mayAlias<T>(value: T): bool;

/** Whether a `T` can reach a counted object, so that `transfer` has work to do. */
@intrinsic
export declare function needsTransfer<T>(value: T): bool;

/**
 * Whether a `T` owns anything that dropping it releases (strings, arrays, objects, closures
 * with a heap environment). A bit copy of a `T` that does not is an independent value.
 */
@intrinsic
export declare function needsDrop<T>(value: T): bool;

/**
 * For a function value: whether its environment is null, which only closures without captures
 * and named functions have (a program that compares function values gives every closure an
 * environment, so it is false there). Such a function reaches no variable of its caller.
 * Lowered to `f.env == null`, which the optimizer folds where the function value is known.
 */
@intrinsic
export declare function fnCapturesNothing<F>(f: F): bool;
