// velt/lang/intrinsics (internal): tasks and promises below velt/task and the prelude's
// `Promise` statics.

import { intrinsic } from "./decorators";
import type { Owned } from "./modes";

/**
 * `spawn(p)` whose rejection the caller handles itself (a `taskScope` child): a dropped handle
 * never reports it.
 */
@intrinsic
export declare function spawnHandled<T, E>(p: Owned<Promise<T, E>>): Promise<T, E>;

/**
 * Whether the program has module state (module-level `let`s and stored constants, or functions
 * given properties through `any`), whose tasks take the process-wide module lock: a constant.
 */
@intrinsic
export declare function moduleStateUsed(): bool;

/**
 * The first of `ps` to fulfill, or the last rejection when all reject (the prelude's
 * `promiseAny`, behind `Promise.any`).
 */
@intrinsic
export declare function firstFulfilled<T, E>(ps: Owned<Promise<T, E>[]>): Promise<T, E>;
