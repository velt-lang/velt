// velt/lang/intrinsics (tests): white-box tests of the intrinsics on raw memory, run by
// `velt test std/` (docs/internals/design/intrinsics.md "Memory at an address"): writes and
// atomic operations at an address, and the address of an `Atomic` that cannot move.
import { describe, expect, it } from "velt/test";
import { Ptr } from "velt/ffi";
import {
  addressAtomicCas,
  addressAtomicCasWeak,
  addressAtomicLoad,
  addressAtomicRmw,
  addressAtomicStore,
  addressCall,
  addressCall3,
  addressCallWord,
  addressLoad,
  addressStore,
  atomicAddress,
  fnAddress,
  stateDrop,
  statePoll,
} from "velt/lang/intrinsics";

declare c("c") function malloc(n: usize): Ptr<u8> | null;
declare c("c") function free(p: Ptr<u8> | null): void;
// The OS's wait and wake calls (`__ulock_wait`, `futex`, `WaitOnAddress`) take the word's address
// as this C function does: through a `Ptr`, from `atomicAddress`.
declare c("c") function memset(p: Ptr<u8>, c: i32, n: usize): Ptr<u8>;

/** A static atomic: its word is in the program's data. */
const WORD = new Atomic<u32>(7);

/** What `bump` added, through its address. */
const BUMPED = new Atomic<u64>(0);

function double(x: usize): usize {
  return x * 2;
}

function bump(x: usize): void {
  BUMPED.add(x as u64);
}

/** What `wordBump` and `sum3` received. */
const WORDS = new Atomic<u64>(0);

function wordBump(x: u64): void {
  WORDS.add(x);
}

function sum3(a: usize, b: usize, c: usize): void {
  WORDS.add((a * 100 + b * 10 + c) as u64);
}

function fakePoll(state: usize, cx: usize): u32 {
  return (state * 10 + cx) as u32;
}

class Counters {
  state: Atomic<u64> = new Atomic<u64>(40);
  inner: Inner = new Inner();
}

class Inner {
  waiters: Atomic<i32> = new Atomic<i32>(-3);
}

describe("velt/lang/intrinsics memory at an address", () => {
  it("addressStore writes what addressLoad reads, at the width of T", () => {
    // SAFETY: malloc returns 16 bytes or NULL, freed once below.
    const p = unsafe { malloc(16) };
    expect(p !== null).toBe(true);
    if (p !== null) {
      const at = Ptr.addressOf(p);
      // SAFETY: `at` has 16 writable bytes nothing else uses.
      unsafe {
        addressStore<u64>(at, 0x1122334455667788);
        addressStore<u8>(at, 0xff);
        addressStore<i16>(at + 8, -2);
        addressStore<f32>(at + 12, 1.5);
        addressStore<bool>(at + 10, true);
      }
      // SAFETY: as above, now written.
      unsafe {
        expect(addressLoad<u64>(at)).toBe(0x11223344556677ff);
        expect(addressLoad<i16>(at + 8)).toBe(-2);
        expect(addressLoad<u16>(at + 8)).toBe(0xfffe);
        expect(addressLoad<f32>(at + 12)).toBe(1.5);
        expect(addressLoad<bool>(at + 10)).toBe(true);
      }
      // SAFETY: `p` came from malloc.
      unsafe {
        free(p);
      }
    }
  });

  it("the addressAtomic operations change the integer at an address", () => {
    // SAFETY: malloc returns 16 bytes or NULL (aligned for a u64), freed once below.
    const raw = unsafe { malloc(16) };
    expect(raw !== null).toBe(true);
    if (raw !== null) {
      const at = Ptr.addressOf(raw);
      // SAFETY: `at` has 16 bytes, aligned, that only this thread uses, changed atomically.
      unsafe {
        addressAtomicStore<u64>(at, 10, "release");
        expect(addressAtomicLoad<u64>(at, "acquire")).toBe(10);
        expect(addressAtomicRmw<u64>(at, "add", 5, "acqrel")).toBe(10);
        expect(addressAtomicRmw<u64>(at, "sub", 1, "relaxed")).toBe(15);
        expect(addressAtomicRmw<u64>(at, "exchange", 3, "seqcst")).toBe(14);
        expect(addressAtomicRmw<u64>(at, "or", 12, "seqcst")).toBe(3);
        expect(addressAtomicRmw<u64>(at, "and", 6, "seqcst")).toBe(15);
        expect(addressAtomicRmw<u64>(at, "xor", 5, "seqcst")).toBe(6);
        expect(addressAtomicLoad<u64>(at, "seqcst")).toBe(3);
        expect(addressAtomicCas<u64>(at, 3, 9, "acqrel", "acquire")).toBe(3);
        expect(addressAtomicCas<u64>(at, 3, 1, "seqcst", "relaxed")).toBe(9);
        let swapped = false;
        while (!swapped) {
          swapped = addressAtomicCasWeak<u64>(at, 9, 2, "seqcst", "seqcst");
        }
        expect(addressAtomicLoad<u64>(at, "relaxed")).toBe(2);
        // A signed `T` compares signed.
        addressAtomicStore<i32>(at + 8, -5, "seqcst");
        expect(addressAtomicRmw<i32>(at + 8, "max", -7, "seqcst")).toBe(-5);
        expect(addressAtomicRmw<i32>(at + 8, "min", -7, "seqcst")).toBe(-5);
        expect(addressAtomicLoad<i32>(at + 8, "seqcst")).toBe(-7);
        expect(addressAtomicRmw<i32>(at + 8, "max", 1, "seqcst")).toBe(-7);
        expect(addressLoad<i32>(at + 8)).toBe(1);
      }
      // SAFETY: `raw` came from malloc.
      unsafe {
        free(raw);
      }
    }
  });

  it("atomicAddress gives the word of a static atomic", () => {
    const at = atomicAddress(WORD);
    expect(at === atomicAddress(WORD)).toBe(true);
    // SAFETY: a static atomic's word lives as long as the program, a u32, changed atomically.
    unsafe {
      expect(addressAtomicLoad<u32>(at, "seqcst")).toBe(7);
      addressAtomicStore<u32>(at, 8, "seqcst");
    }
    expect(WORD.load()).toBe(8);
    WORD.add(2);
    // SAFETY: as above.
    expect(unsafe { addressAtomicRmw<u32>(at, "add", 1, "seqcst") }).toBe(10);
    expect(WORD.load()).toBe(11);
    // A C function writes the word through the address: every byte 1.
    // SAFETY: the word is 4 bytes, and nothing else changes it meanwhile.
    unsafe {
      memset(Ptr.at<u8>(at), 1, 4);
    }
    expect(WORD.load()).toBe(0x01010101);
  });

  it("atomicAddress gives the word of a field of a shared value", () => {
    const s = shared(new Counters());
    const at = atomicAddress(s.state);
    const inner = atomicAddress(s.inner.waiters);
    expect(at === atomicAddress(s.state)).toBe(true);
    expect(at !== inner).toBe(true);
    // SAFETY: `s` keeps the box alive; the word is a u64 changed atomically.
    unsafe {
      expect(addressAtomicRmw<u64>(at, "add", 2, "seqcst")).toBe(40);
      expect(addressAtomicCas<i32>(inner, -3, 4, "seqcst", "seqcst")).toBe(-3);
    }
    expect(s.state.load()).toBe(42);
    expect(s.inner.waiters.load()).toBe(4);
    // A C function writes a word of the box through its address.
    // SAFETY: `s` keeps the box alive; the word is 4 bytes nothing else changes meanwhile.
    unsafe {
      memset(Ptr.at<u8>(inner), 0xff, 4);
    }
    expect(s.inner.waiters.load()).toBe(-1);
  });

  it("fnAddress gives a function C calls, and the calls through an address reach it", () => {
    const f = fnAddress(double);
    expect(f !== 0).toBe(true);
    expect(f === fnAddress(double)).toBe(true);
    expect(f !== fnAddress(bump)).toBe(true);
    // SAFETY: each address is of a function taking and returning what the call passes.
    unsafe {
      expect(addressCall(f, 21)).toBe(42);
      stateDrop(fnAddress(bump), 5);
      stateDrop(fnAddress(bump), 2);
      expect(statePoll(fnAddress(fakePoll), 3, 4)).toBe(34);
    }
    expect(BUMPED.load()).toBe(7);
  });

  it("addressCallWord and addressCall3 call functions that return nothing", () => {
    // SAFETY: each address is of a function taking what the call passes and returning nothing.
    unsafe {
      addressCallWord(fnAddress(wordBump), 0x1_0000_0000);
      addressCall3(fnAddress(sum3), 1, 2, 3);
    }
    expect(WORDS.load()).toBe(0x1_0000_0000 + 123);
  });
});
