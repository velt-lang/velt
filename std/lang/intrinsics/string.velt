// velt/lang/intrinsics (internal): a string's UTF-8 bytes, read where the string keeps them.
// The public surface is velt/encoding's `utf8Length`, `utf8ByteAt` and `utf8Substring`.

import { intrinsic } from "./decorators";
import type { Mut } from "./modes";

/** The length of `s`'s UTF-8, which a string stores (no call). */
@intrinsic
export declare function strByteLen(s: string): usize;

/** `s.length`. */
@intrinsic
export declare function strLen(s: string): usize;

/**
 * Byte `i` of `s`'s UTF-8, unchecked: the caller checks `i` against `strByteLen(s)` first.
 */
@intrinsic
export declare function strByteAt(s: string, i: u64): u8;

/**
 * The three words of the string value `s` (rt_abi.md "Strings"): `w0`, a heap or static
 * string's data pointer; `w1`, its `units << 32 | len`; `w2`, its form (inline when the top bit
 * is set, the text then in the words themselves). What the runtime's position translation
 * (breadcrumbs, the recent-translation cache) reads from a string (#2778). No call.
 */
@intrinsic
export declare function strWord0(s: string): u64;

/** The second word of `s`'s value: see `strWord0`. */
@intrinsic
export declare function strWord1(s: string): u64;

/** The third word of `s`'s value: see `strWord0`. */
@intrinsic
export declare function strWord2(s: string): u64;

/**
 * The address of `s`'s UTF-8 bytes: inside the value for an inline string, the buffer
 * otherwise. Valid while `s` is alive and unchanged; read with `addressLoad`. One select, so a
 * loop reads its bytes through one pointer (#2778). No call.
 */
@intrinsic
export declare function strDataAddress(s: string): usize;

/** The byte at `i`, or -1 when `i` is out of range; inline code, no call. */
@intrinsic
export declare function strCharCodeAt(s: string, i: i64): i64;

/**
 * The ASCII string of `len` bytes (at most 23) held in three words, byte `i` in bits
 * `8 * (i % 8)` of word `i / 8`; every byte past `len` must be 0. No call and no allocation:
 * the string's inline form.
 */
@intrinsic
export declare function strAsciiWords(w0: u64, w1: u64, w2: u64, len: usize): string;

/**
 * Appends the first `len` bytes (at most 24, ASCII) of the three words, byte `i` in bits
 * `8 * (i % 8)` of word `i / 8`, to the builder `buf` (a string the runtime's builder functions
 * append to): inline stores when its buffer has room, a runtime call when it must grow. `buf`
 * is `Mut`: a function that passes its own parameter here modifies it (no `readonly`).
 */
@intrinsic
export declare function strbufPushAsciiWords(
  buf: Mut<string>,
  w0: u64,
  w1: u64,
  w2: u64,
  len: usize,
): void;

/**
 * Appends the first `len` bytes (at most 8, ASCII) of the word `w`, byte `i` in bits `8 * i`, to
 * the builder `buf`: as `strbufPushAsciiWords`, with less to do for a short text (a number below
 * 10^4).
 */
@intrinsic
export declare function strbufPushAsciiWord(buf: Mut<string>, w: u64, len: usize): void;
