// velt/lang/intrinsics (internal): compile-time facts about a type. Each is a constant once the
// generic code that asks is instantiated, so a test of one costs nothing and the branch it
// rules out is not compiled; the value passed only names the type and is not evaluated.

/**
 * Whether `null` is a value of `T` (`T` an option, `X | null`, once substituted): then a generic
 * `T | null` is `T` itself and its `null` is a `T`.
 */
export declare intrinsic function holdsNull<T>(probe: T): bool;

/**
 * `null` as a `T` that holds null (`holdsNull`). For any other `T` it stops the program with an
 * internal error: std reaches it only behind a `holdsNull` test.
 */
export declare intrinsic function nullAs<T>(): T;

/**
 * Whether a value of type `T` that a call borrows can be reached through another reference while
 * the call runs (lowering counts the type, or borrows values of it inside counted objects).
 * Only then can a callback change it.
 */
export declare intrinsic function mayAlias<T>(value: T): bool;

/** Whether a `T` can reach a counted object, so that `transfer` has work to do. */
export declare intrinsic function needsTransfer<T>(value: T): bool;

/**
 * Whether a `T` owns anything that dropping it releases (strings, arrays, objects, closures
 * with a heap environment). A bit copy of a `T` that does not is an independent value.
 */
export declare intrinsic function needsDrop<T>(value: T): bool;

/**
 * For a function value: whether its environment is null, which only closures without captures
 * and named functions have (a program that compares function values gives every closure an
 * environment, so it is false there). Such a function reaches no variable of its caller.
 * Lowered to `f.env == null`, which the optimizer folds where the function value is known.
 */
export declare intrinsic function fnCapturesNothing<F>(f: F): bool;
