// velt/lang/intrinsics (internal): JSON decoders the compiler generates per type
// (velt/encoding/json). They build classes without running their constructor, which no Velt
// code can do yet (docs/internals/design/std-layout.md §11). `JSON.stringify`'s writers are
// written by a source generator (velt/encoding/json/generate).

/**
 * Decodes `text` as a `T` with the reader options of `velt_rt_json_reader_new_with` (flag 1:
 * reject unknown keys; `maxDepth` 0: no limit): the body of `JSON.parse<T>(text, options)`.
 * Throws `JsonError`.
 */
export declare intrinsic function jsonParse<T>(text: string, flags: i64, maxDepth: i64): T;

/**
 * As `jsonParse`, over a native driver's live rows: the address of a
 * `velt_text::rows_cursor::RawCursor`, which the caller keeps and releases afterwards
 * (native_abi.md "Row cursors").
 */
export declare intrinsic function jsonParseCursor<T>(cursor: u64, flags: i64, maxDepth: i64): T;
