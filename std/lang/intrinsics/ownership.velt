// velt/lang/intrinsics (internal): references and moves the compiler otherwise inserts itself
// (docs/internals/contracts/hir_encodings.md "Sharing").

import { intrinsic } from "./decorators";
import type { Owned } from "./modes";

/**
 * Another reference to the same value (JavaScript's reference copy): a count increment for
 * counted objects, a copy for Copy types and strings, a field-wise share for immutable value
 * types.
 */
@intrinsic
export declare function share<T>(value: T): T;

/**
 * `value` made safe for another task, as a `spawn` argument is: moved where this task held the
 * only reference, deep-copied where it is still shared.
 */
@intrinsic
export declare function transfer<T>(value: Owned<T>): T;

/**
 * Whether `value`, an object, box or array, is reached by no other reference, so that changing it
 * in place shows nowhere else: what copy-on-write code asks before changing a node it may share
 * (velt/encoding/json's tree). A counted value's whole count word is compared with 1, so any flag
 * in it (a lock-set or cycle-collector bit, an immortal count) makes it false even when one
 * reference holds it: a false only costs a copy. A type the program never counts has one owner per
 * value, so always true; a lock-set type, and a value of any other kind (`shared<T>`, a string, a
 * function, a number), false. `o.f!` is read in place (a null is not unique).
 */
@intrinsic
export declare function isUnique<T>(value: T): bool;
