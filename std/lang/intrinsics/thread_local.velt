// velt/lang/intrinsics (internal): the operations of `ThreadLocal<T>` (std/prelude/sync.velt).
// The `ThreadLocal` is always the module `const` initialized with `new ThreadLocal<T>(literal)`
// (the compiler checks it): lowering never evaluates it, but names the value by that constant
// and reads the starting value from the literal.

import { intrinsic } from "./decorators";
import type { Copied } from "./modes";

/** This thread's value. */
@intrinsic
export declare function threadLocalGet<T>(tl: ThreadLocal<T>): T;

/** Makes `value` this thread's value. */
@intrinsic
export declare function threadLocalSet<T>(tl: ThreadLocal<T>, value: Copied<T>): void;
