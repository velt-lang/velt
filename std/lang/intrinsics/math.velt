// velt/lang/intrinsics (internal): `f64` operations that are one instruction. The public surface
// is `Math` (std/prelude/math.velt).

import { intrinsic } from "./decorators";

/** The square root. */
@intrinsic
export declare function sqrt(x: f64): f64;

/** The largest whole number not above `x`. */
@intrinsic
export declare function floor(x: f64): f64;

/** The smallest whole number not below `x`. */
@intrinsic
export declare function ceil(x: f64): f64;

/** The nearest whole number, halves rounded up (towards +Infinity), as JavaScript's. */
@intrinsic
export declare function round(x: f64): f64;

/** `x` without its fraction (rounded towards 0). */
@intrinsic
export declare function trunc(x: f64): f64;

/** The absolute value. */
@intrinsic
export declare function abs(x: f64): f64;
