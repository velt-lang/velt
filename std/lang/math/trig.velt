// velt/lang/math (internal): `Math.sin`, `cos` and `tan`, ported from fdlibm's s_sin.c,
// s_cos.c, s_tan.c and their kernels k_sin.c, k_cos.c and k_tan.c as V8 has them
// (src/base/ieee754.cc), so that results have the same bits as in JavaScript engines.
// Copyright (C) 1993 by Sun Microsystems, Inc.; see NOTICE.

import { abs } from "velt/lang/intrinsics";
import { remPio2 } from "velt/lang/math/rem_pio2";
import { clearLowWord, fromWords, highWord, lowWord } from "velt/lang/math/words";

const S1: f64 = -1.66666666666666324348e-01;
const S2: f64 = 8.33333333332248946124e-03;
const S3: f64 = -1.98412698298579493134e-04;
const S4: f64 = 2.75573137070700676789e-06;
const S5: f64 = -2.50507602534068634195e-08;
const S6: f64 = 1.58969099521155010221e-10;

const C1: f64 = 4.16666666666666019037e-02;
const C2: f64 = -1.38888888888741095749e-03;
const C3: f64 = 2.48015872894767294178e-05;
const C4: f64 = -2.75573143513906633035e-07;
const C5: f64 = 2.08757232129817482790e-09;
const C6: f64 = -1.13596475577881948265e-11;

const T0: f64 = 3.33333333333334091986e-01;
const T1: f64 = 1.33333333333201242699e-01;
const T2: f64 = 5.39682539762260521377e-02;
const T3: f64 = 2.18694882948595424599e-02;
const T4: f64 = 8.86323982359930005737e-03;
const T5: f64 = 3.59207910759131235356e-03;
const T6: f64 = 1.45620945432529025516e-03;
const T7: f64 = 5.88041240820264096874e-04;
const T8: f64 = 2.46463134818469906812e-04;
const T9: f64 = 7.81794442939557092300e-05;
const T10: f64 = 7.14072491382608190305e-05;
const T11: f64 = -1.85586374855275456654e-05;
const T12: f64 = 2.59073051863633712884e-05;
const PIO4: f64 = 7.85398163397448278999e-01;
const PIO4_LO: f64 = 3.06161699786838301793e-17;

// sin(x + y) for |x| <= pi/4, where y is the tail of x (not used when `tail` is false).
function kernelSin(x: f64, y: f64, tail: bool): f64 {
  const ix = highWord(x) & 0x7fffffff;
  if (ix < 0x3e400000) {
    // |x| < 2^-27
    return x;
  }
  const z = x * x;
  const v = z * x;
  const r = S2 + z * (S3 + z * (S4 + z * (S5 + z * S6)));
  if (!tail) {
    return x + v * (S1 + z * r);
  }
  return x - ((z * (0.5 * y - v * r) - y) - v * S1);
}

// cos(x + y) for |x| <= pi/4, where y is the tail of x.
function kernelCos(x: f64, y: f64): f64 {
  const ix = highWord(x) & 0x7fffffff;
  if (ix < 0x3e400000) {
    // |x| < 2^-27
    return 1.0;
  }
  const z = x * x;
  const r = z * (C1 + z * (C2 + z * (C3 + z * (C4 + z * (C5 + z * C6)))));
  if (ix < 0x3fd33333) {
    // |x| < 0.3
    return 1.0 - (0.5 * z - (z * r - x * y));
  }
  // qx is about x/4; 1 - qx is exact.
  const qx = ix > 0x3fe90000 ? 0.28125 : fromWords(ix - 0x00200000, 0);
  const iz = 0.5 * z - qx;
  const a = 1.0 - qx;
  return a - (iz - (z * r - x * y));
}

// tan(x + y) for |x| <= pi/4 when `iy` is 1, and -1/tan(x + y) when it is -1; y is the tail of x.
function kernelTan(x0: f64, y0: f64, iy: i32): f64 {
  let x = x0;
  let y = y0;
  const hx = highWord(x);
  const ix = hx & 0x7fffffff;
  if (ix < 0x3e300000) {
    // |x| < 2^-28
    if ((((ix as u32) | lowWord(x)) | ((iy + 1) as u32)) == 0) {
      return 1.0 / abs(x);
    }
    if (iy == 1) {
      return x;
    }
    // -1/(x + y), carefully.
    const w = x + y;
    const z = clearLowWord(w);
    const v = y - (z - x);
    const a = -1.0 / w;
    const t = clearLowWord(a);
    const s = 1.0 + t * z;
    return t + a * (s + t * v);
  }
  const big = ix >= 0x3fe59428;
  if (big) {
    // |x| >= 0.6744: tan(x) from tan(pi/4 - x).
    if (hx < 0) {
      x = -x;
      y = -y;
    }
    const z = PIO4 - x;
    const w = PIO4_LO - y;
    x = z + w;
    y = 0.0;
  }
  let z = x * x;
  let w = z * z;
  // The odd and even terms of the polynomial, apart.
  let r = T1 + w * (T3 + w * (T5 + w * (T7 + w * (T9 + w * T11))));
  let v = z * (T2 + w * (T4 + w * (T6 + w * (T8 + w * (T10 + w * T12)))));
  let s = z * x;
  r = y + z * (s * (r + v) + y);
  r += T0 * s;
  w = x + r;
  if (big) {
    v = iy as f64;
    return ((1 - ((hx >> 30) & 2)) as f64) * (v - 2.0 * (x - (w * w / (w + v) - r)));
  }
  if (iy == 1) {
    return w;
  }
  // -1/(x + r), carefully.
  z = clearLowWord(w);
  v = r - (z - x);
  const a = -1.0 / w;
  const t = clearLowWord(a);
  s = 1.0 + t * z;
  return t + a * (s + t * v);
}

/** The sine of `x` radians. The error is below 1 ulp. */
export function sin(x: f64): f64 {
  const ix = highWord(x) & 0x7fffffff;
  if (ix <= 0x3fe921fb) {
    // |x| <= pi/4
    return kernelSin(x, 0.0, false);
  }
  if (ix >= 0x7ff00000) {
    return x - x;
  }
  const r = remPio2(x);
  const n = r.n & 3;
  if (n == 0) {
    return kernelSin(r.hi, r.lo, true);
  }
  if (n == 1) {
    return kernelCos(r.hi, r.lo);
  }
  if (n == 2) {
    return -kernelSin(r.hi, r.lo, true);
  }
  return -kernelCos(r.hi, r.lo);
}

/** The cosine of `x` radians. The error is below 1 ulp. */
export function cos(x: f64): f64 {
  const ix = highWord(x) & 0x7fffffff;
  if (ix <= 0x3fe921fb) {
    // |x| <= pi/4
    return kernelCos(x, 0.0);
  }
  if (ix >= 0x7ff00000) {
    return x - x;
  }
  const r = remPio2(x);
  const n = r.n & 3;
  if (n == 0) {
    return kernelCos(r.hi, r.lo);
  }
  if (n == 1) {
    return -kernelSin(r.hi, r.lo, true);
  }
  if (n == 2) {
    return -kernelCos(r.hi, r.lo);
  }
  return kernelSin(r.hi, r.lo, true);
}

/** The tangent of `x` radians. The error is below 1 ulp. */
export function tan(x: f64): f64 {
  const ix = highWord(x) & 0x7fffffff;
  if (ix <= 0x3fe921fb) {
    // |x| <= pi/4
    return kernelTan(x, 0.0, 1);
  }
  if (ix >= 0x7ff00000) {
    return x - x;
  }
  const r = remPio2(x);
  return kernelTan(r.hi, r.lo, 1 - ((r.n & 1) << 1));
}
