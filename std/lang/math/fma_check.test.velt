// velt/lang/math (internal): white-box tests of the FMA check's reading of CPUID and XCR0, run by
// `velt test std/`. The end-to-end runs on CPUs with and without FMA are in
// crates/veltc/tests/pow_paths.rs, but a machine whose CPU has all of them cannot tell the bits
// apart there.
import { describe, expect, it } from "velt/test";
import { cpuidHasFma, xcr0HasAvx } from "velt/lang/math/fma_check";

describe("the FMA check", () => {
  it("needs ECX bits 12, 27 and 28 of CPUID leaf 1", () => {
    const all: u32 = (1 << 12) | (1 << 27) | (1 << 28);
    expect(cpuidHasFma(0)).toBe(false);
    expect(cpuidHasFma(0xffffffff)).toBe(true);
    expect(cpuidHasFma(all)).toBe(true);
    for (let bit: u32 = 0; bit < 32; bit++) {
      expect(cpuidHasFma(1 << bit)).toBe(false);
      const without = all & ~((1 as u32) << bit);
      expect(cpuidHasFma(without)).toBe(without == all);
    }
  });

  it("needs the SSE and AVX state in XCR0", () => {
    expect(xcr0HasAvx(0)).toBe(false);
    expect(xcr0HasAvx(7)).toBe(true);
    expect(xcr0HasAvx(6)).toBe(true);
    expect(xcr0HasAvx(3)).toBe(false);
    expect(xcr0HasAvx(5)).toBe(false);
    expect(xcr0HasAvx(0xe7)).toBe(true);
  });
});
