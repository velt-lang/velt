// velt/lang/math (internal): `Math.log1p`, `Math.log2` and `Math.log10`, as an extension of the
// prelude's class over fdlibm's routines (velt/lang/math/logs). In a module of its own so that a
// program loads these ports only when it calls one of these functions
// (std/prelude/global/math_logs.velt, a conditional global).

import { log10, log1p, log2 } from "velt/lang/math/logs";

// Doc comments adapted from TypeScript's lib.*.d.ts (Apache-2.0, © Microsoft); see NOTICE.

extend Math {
  /**
   * Returns the natural logarithm of 1 + x, accurate for an `x` near 0 too.
   * @param x - A numeric expression.
   */
  static log1p(x: f64): f64 {
    return log1p(x);
  }

  /**
   * Returns the base 2 logarithm of a number; exact for the powers of two.
   * @param x - A numeric expression.
   */
  static log2(x: f64): f64 {
    return log2(x);
  }

  /**
   * Returns the base 10 logarithm of a number.
   * @param x - A numeric expression.
   */
  static log10(x: f64): f64 {
    return log10(x);
  }
}
