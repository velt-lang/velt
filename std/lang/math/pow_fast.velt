// velt/lang/math (internal): `pow`'s copy for targets without an FMA instruction (x86-64 CPUs
// before 2013, WebAssembly, debug builds): the bits of the FMA build (std/lang/math/pow.velt)
// without its twenty `fma`s, each of which is a call of C's `fma` there.
//
// Some steps are exact without an `fma`: `z * invc - 1` (invc has at most 8 significant bits),
// `k * LN2_HI` and `k * NEG_LN2_HI_N` (few bits) and the product errors (Dekker). The others are
// computed unfused, with a bound on how far each result can be from the FMA build's: the tails of
// log(x) (`lo`, `elo`) and exp's polynomial (`pt`) carry it to a rounding they feed (`lhi = hi +
// lo`, `r = r1 + elo`, the final `scale + scale * tmp`), and `r1`'s product to its sum. Such a
// rounding is the FMA build's where the sums with both ends of the interval round to the same
// double: rounding is monotonic, so the FMA build's sum, inside the interval, rounds to it too.
// Where they differ, the steps are redone with each `fma` emulated (velt/lang/math/fma's
// `fmaSoft`): the last ones (`expPolyExact`, about 1 in 80 results), or all of them (`powFast`
// returns NaN, about 1 in 1,000, and for results near the overflow and underflow limits). The
// derivation of each bound is in the comments at it (u = 2^-53).

import { abs, inline, noInline } from "velt/lang/intrinsics";
import { fmaSoft, productError, splitHi } from "velt/lang/math/fma";
import { EXP_TAB } from "velt/lang/math/exp_table";
import { POW_LOG } from "velt/lang/math/pow_log_table";
import {
  A0,
  A1,
  A2,
  A3,
  A4,
  A5,
  A6,
  C2,
  C3,
  C4,
  C5,
  INV_LN2_N,
  LN2_HI,
  LN2_LO,
  NEG_LN2_HI_N,
  NEG_LN2_LO_N,
  OFF,
  SHIFT,
} from "velt/lang/math/pow_consts";

// The bounds' coefficients are 1.25 times a little more than the derivations' (5.1u for 5.04u and
// 5.05u, 1.6u for 1.53u, 2^-100 for 16.3u^2). The 1.25 covers the rounding of an interval's ends
// a ± b, at most u (|a| + b): u |a| is at most 0.16 b (|elo| and |pt| are at most b / 6.375u;
// |lo| is at most 0.673 |ar3| + |lo1| + 2.02u |hi|, which blo bounds with 6.375u, 12.75u and
// 80u^2), inside the 0.2 b the factor adds. A bound's own computation rounds it by a few u,
// inside the 1% the coefficients add.
// 6.375u (1.25 times 5.1u), 2u (1.25 times 1.6u), 1.25 2^-100.
const U6_375: f64 = 7.077671781985373e-16;
const U2: f64 = 2.220446049250313e-16;
const P100_125: f64 = 9.860761315262648e-31;
// 1 - 2^-52 and 1 + 2^-52.
const BELOW: f64 = 0.9999999999999998;
const ABOVE: f64 = 1.0000000000000002;

/**
 * `pow` of the positive normal double with bits `ix` (k, z as in pow.velt) and `y`, the FMA
 * build's bits with the sign of `signBias`, or NaN where a rounding is not certain.
 */
@inline
export function powFast(ix: u64, y: f64, signBias: u64): f64 {
  const tmp = ix - OFF;
  const i = (((tmp >> 45) & 127) * 3) as usize;
  const k = (tmp as i64) >> 52;
  const iz = ix - (tmp & 0xfff0000000000000);
  const z = f64.fromBits(iz);
  const kd = k as f64;
  const invc = f64.fromBits(POW_LOG[i]);
  // fma(z, invc, -1): z rounded to 21 bits times invc (8 bits) is exact, so is that minus 1
  // (Sterbenz) and the rest times invc; their sum is rounded once.
  const zhi = f64.fromBits((iz + 0x80000000) & 0xffffffff00000000);
  const r = zhi * invc - 1.0 + (z - zhi) * invc;
  // fma(kd, LN2_HI, logc): kd LN2_HI is exact.
  const t1 = kd * LN2_HI + f64.fromBits(POW_LOG[i + 1]);
  const t2 = t1 + r;
  // fma(kd, LN2_LO, logctail), unfused: within u |pl| + 2u |lo1| of it.
  const pl = kd * LN2_LO;
  const lo1 = pl + f64.fromBits(POW_LOG[i + 2]);
  const lo2 = t1 - t2 + r;
  const ar = A0 * r;
  const ar2 = r * ar;
  const ar3 = r * ar2;
  const hi = t2 + ar2;
  // fma(ar, r, -ar2) = -(r r - rr) / 2 with rr = r r rounded = -2 ar2: Dekker's product error,
  // exact. (Left out, its u |ar2| would reach r through y and leave 1 in 20 roundings uncertain.)
  const rh = splitHi(r);
  const rl = r - rh;
  const lo3 = -0.5 * (rh * rh + 2.0 * ar2 + rh * rl + rh * rl + rl * rl);
  const lo4 = t2 - hi + ar2;
  // The polynomial unfused (|r| < 0.0079): its five steps leave q1 within 3u of the FMA build's.
  const q2 = ar2 * (r * A6 + A5) + (r * A4 + A3);
  const q1 = ar2 * q2 + (r * A2 + A1);
  // lo is within 5.05u |ar3| + u |pl| + 10.1u |lo1| + 8.1u (|lo2| + |lo3| + |lo4|) of the FMA
  // build's: lo1's error, the sum's three roundings and the last step's, with |lo| at most
  // 0.673 |ar3| + |lo1| + |lo2| + |lo3| + |lo4|. lo2, lo3 and lo4 are the errors of t2, ar2 and
  // hi (|t1| >= |r| or t1 = 0: the table's nonzero |logc| are at least 0.0077 and |r| < 0.0058),
  // so their part is under 16.3u^2 |hi| (|t2| <= 1.01 |hi|, |ar2| <= 0.01 |hi|). blo is 1.25
  // times that bound with 5.1u for each of u, 5.05u and 10.1u / 2.
  const lo = ar3 * q1 + (lo1 + lo2 + lo3 + lo4);
  const alo1 = abs(lo1);
  const blo = U6_375 * (abs(ar3) + abs(pl) + alo1 + alo1) + P100_125 * abs(hi);
  // lhi = hi + lo, the FMA build's when hi plus each end of lo's interval rounds the same (with a
  // bound of 0 the steps were the FMA build's, and both ends are lo).
  const lhi = hi + (lo - blo);
  if (lhi != hi + (lo + blo)) {
    return NaN;
  }
  const llo = hi - lhi + lo;
  // y log(x) as ehi + elo: fma(y, lhi, -ehi) is the product's error, exact; the outer fma
  // unfused, within |y| (blo + 2.01u |llo|) + 3.03u |y llo| + 2.01u |elo| of it, which is at most
  // |y| blo + 5.04u |yllo| + 2.01u |elo| (blo already 1.25 times lo's bound).
  const ehi = y * lhi;
  const yllo = y * llo;
  const elo = yllo + productError(y, lhi, ehi);
  const belo = abs(y) * blo + U6_375 * (abs(yllo) + abs(elo));
  return expFast(ehi, elo, belo, signBias);
}

// ±exp(x + xtail) as the FMA build computes it (the sign from `signBias`), where the FMA build's
// tail is within `bound` / 1.25 of `xtail`; NaN where a rounding is not certain.
@inline
function expFast(x: f64, xtail: f64, bound: f64, signBias: u64): f64 {
  const abstop = (x.toBits() >> 52) & 0x7ff;
  if (abstop < 0x3c9 || abstop >= 0x408) {
    if (abstop < 0x3c9) {
      const one = 1.0 + x;
      return signBias != 0 ? -one : one;
    }
    if (abstop >= 0x409) {
      if ((x.toBits() >> 63) != 0) {
        return signBias != 0 ? -0.0 : 0.0;
      }
      return signBias != 0 ? -Infinity : Infinity;
    }
    // 512 <= |x| < 1024: an overflowing or subnormal result, left to the FMA build's steps.
    return NaN;
  }
  // fma(INV_LN2_N, x, SHIFT) rounds the exact product to an integer; the rounded product rounds
  // to the same one unless it is halfway between two (|p| < 2^17, so p - kd is exact; its square
  // rounds to 0.25 only for ±0.5: 0.5 - 2^-54, the next double below, squares to 0.25 - 2^-54 +
  // 2^-108, which rounds to 0.25 - 2^-54).
  const p = INV_LN2_N * x;
  const kdShifted = p + SHIFT;
  const kd = kdShifted - SHIFT;
  const half = p - kd;
  if (half * half == 0.25) {
    return NaN;
  }
  const ki = kdShifted.toBits();
  // fma(kd, NEG_LN2_HI_N, x) is exact (|kd| < 2^17; Sterbenz). fma(kd, NEG_LN2_LO_N, r0): the
  // exact product is within half a unit of pn (normal: |pn| >= 1.28e-14 unless kd = 0), and
  // pn (1 ± 2^-52) round to at least a unit beyond it, so r0 plus each rounds to the fused sum
  // where they agree, and so does r0 + pn, between them.
  const r0 = kd * NEG_LN2_HI_N + x;
  const pn = kd * NEG_LN2_LO_N;
  const r1 = r0 + pn;
  if (r0 + pn * BELOW != r0 + pn * ABOVE) {
    return NaN;
  }
  // r = r1 + xtail, the FMA build's when r1 plus each end of xtail's interval rounds the same.
  const r = r1 + (xtail - bound);
  if (r != r1 + (xtail + bound)) {
    return NaN;
  }
  const idx = ((ki & 127) * 2) as usize;
  const top = (ki + signBias) << 45;
  const tail = f64.fromBits(EXP_TAB[idx]);
  const sbits = EXP_TAB[idx + 1] + top;
  // The polynomial unfused (|r| < 0.00271): w within 1.51u r2 + 2.01u |w| of the FMA build's,
  // tmp within 1.52u r2 + 2.01u (|w| + |tmp|).
  const r2 = r * r;
  const w = r2 * (r * C3 + C2) + (tail + r);
  const tmp = r2 * r2 * (r * C5 + C4) + w;
  // scale + scale tmp: pt is within |scale| (1.52u r2 + 2.01u |w| + 3.02u |tmp|) of the FMA
  // build's exact product (tmp's bound, and pt's rounding), at most |scale| (1.53u r2 + 5.04u
  // |tmp|) as |w| <= |tmp| + 3.1e-7 r2; sb is 1.25 times that with 1.6u and 5.1u. Where the two
  // ends round apart, r is the FMA build's: only the last steps are redone, `fma` emulated.
  const scale = f64.fromBits(sbits);
  const pt = scale * tmp;
  const sb = abs(scale) * (U2 * r2 + U6_375 * abs(tmp));
  const s = scale + (pt - sb);
  if (s != scale + (pt + sb)) {
    return expPolyExact(r, tail, scale);
  }
  return s;
}

// The FMA build's last steps from its r, with each `fma` emulated (velt/lang/math/fma). Out of
// line: it runs for the few results the unfused steps leave uncertain.
@noInline
function expPolyExact(r: f64, tail: f64, scale: f64): f64 {
  const r2 = r * r;
  const tmp = fmaSoft(r2 * r2, fmaSoft(r, C5, C4), fmaSoft(r2, fmaSoft(r, C3, C2), tail + r));
  return fmaSoft(scale, tmp, scale);
}
