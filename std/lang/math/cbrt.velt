// velt/lang/math (internal): `Math.cbrt`, ported from FreeBSD's s_cbrt.c (a revision of
// fdlibm's) as V8 has it (src/base/ieee754.cc), so that results have the same bits as in
// JavaScript engines. Copyright (C) 1993 by Sun Microsystems, Inc.; see NOTICE.

import { fromWords, highWord, lowWord } from "velt/lang/math/words";

// B1 = (1023 - 1023/3 - 0.03306235651) * 2^20, B2 = (1023 - 1023/3 - 54/3 - 0.03306235651) * 2^20
const B1: i32 = 715094163;
const B2: i32 = 696219795;

// |1/cbrt(x) - p(x)| < 2^-23.5 (~[-7.93e-8, 7.929e-8])
const P0: f64 = 1.87595182427177009643;
const P1: f64 = -1.88497979543377169875;
const P2: f64 = 1.621429720105354466140;
const P3: f64 = -0.758397934778766047437;
const P4: f64 = 0.145996192886612446982;

/**
 * The cube root: a 5-bit estimate from the exponent, a polynomial step to 23 bits, rounding to
 * 23 bits away from zero and one Newton step to 53 bits. The error is below 0.667 ulp.
 */
export function cbrt(x: f64): f64 {
  const hw = highWord(x);
  const sign = hw & (0x80000000 as i32);
  const hx = hw ^ sign;
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  let t = 0.0;
  if (hx < 0x00100000) {
    if (((hx as u32) | lowWord(x)) == 0) {
      return x;
    }
    // A subnormal: scaled by 2^54.
    t = 18014398509481984.0 * x;
    const high = highWord(t);
    t = fromWords(sign | ((high & 0x7fffffff) / 3 + B2), 0);
  } else {
    t = fromWords(sign | (hx / 3 + B1), 0);
  }
  let r = (t * t) * (t / x);
  t = t * ((P0 + r * (P1 + r * P2)) + ((r * r) * r) * (P3 + r * P4));
  // Round t away from zero to 23 bits, so that t*t is exact and x/t^2 has a small error.
  t = f64.fromBits((t.toBits() + 0x80000000) & 0xffffffffc0000000);
  const s = t * t;
  r = x / s;
  const w = t + t;
  r = (r - t) / (w + r);
  return t + t * r;
}
