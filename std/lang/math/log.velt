// velt/lang/math (internal): `Math.log`, `log1p`, `log2` and `log10`, ported from fdlibm's
// e_log.c, s_log1p.c, e_log2.c and e_log10.c as V8 has them (src/base/ieee754.cc), so that
// results have the same bits as in JavaScript engines. Copyright (C) 1993 by Sun Microsystems,
// Inc.; see NOTICE.

import { clearLowWord, fromWords, highWord, lowWord, withHighWord } from "velt/lang/math/words";

const LN2_HI: f64 = 6.93147180369123816490e-01;
const LN2_LO: f64 = 1.90821492927058770002e-10;
const TWO54: f64 = 1.80143985094819840000e+16;
const LG1: f64 = 6.666666666666735130e-01;
const LG2: f64 = 3.999999999940941908e-01;
const LG3: f64 = 2.857142874366239149e-01;
const LG4: f64 = 2.222219843214978396e-01;
const LG5: f64 = 1.818357216161805012e-01;
const LG6: f64 = 1.531383769920937332e-01;
const LG7: f64 = 1.479819860511658591e-01;

const IVLN2_HI: f64 = 1.44269504072144627571e+00;
const IVLN2_LO: f64 = 1.67517131648865118353e-10;

const IVLN10: f64 = 4.34294481903251816668e-01;
const LOG10_2HI: f64 = 3.01029995663611771306e-01;
const LOG10_2LO: f64 = 3.69423907715893078616e-13;

/**
 * The natural logarithm. `x` is 2^k * (1 + f) with sqrt(2)/2 < 1 + f < sqrt(2); log(1 + f) comes
 * from a polynomial in s = f / (2 + f), and the result is k*ln2 + log(1 + f). The error is
 * below 1 ulp.
 */
export function log(x0: f64): f64 {
  let x = x0;
  let hx = highWord(x);
  let k: i32 = 0;
  if (hx < 0x00100000) {
    // x < 2^-1022
    if ((((hx & 0x7fffffff) as u32) | lowWord(x)) == 0) {
      return -Infinity;
    }
    if (hx < 0) {
      return NaN;
    }
    // A subnormal: scale it up.
    k -= 54;
    x *= TWO54;
    hx = highWord(x);
  }
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  k += (hx >> 20) - 1023;
  hx &= 0x000fffff;
  let i = (hx + 0x95f64) & 0x100000;
  // Normalize x or x/2.
  x = withHighWord(x, hx | (i ^ 0x3ff00000));
  k += i >> 20;
  const f = x - 1.0;
  if ((0x000fffff & (2 + hx)) < 3) {
    // |f| < 2^-20
    if (f == 0.0) {
      if (k == 0) {
        return 0.0;
      }
      const dk = k as f64;
      return dk * LN2_HI + dk * LN2_LO;
    }
    const r = f * f * (0.5 - 0.33333333333333333 * f);
    if (k == 0) {
      return f - r;
    }
    const dk = k as f64;
    return dk * LN2_HI - ((r - dk * LN2_LO) - f);
  }
  const s = f / (2.0 + f);
  const dk = k as f64;
  const z = s * s;
  i = hx - 0x6147a;
  const w = z * z;
  const j = 0x6b851 - hx;
  const t1 = w * (LG2 + w * (LG4 + w * LG6));
  const t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)));
  i |= j;
  const r = t2 + t1;
  if (i > 0) {
    const hfsq = 0.5 * f * f;
    if (k == 0) {
      return f - (hfsq - s * (hfsq + r));
    }
    return dk * LN2_HI - ((hfsq - (s * (hfsq + r) + dk * LN2_LO)) - f);
  }
  if (k == 0) {
    return f - s * (f - r);
  }
  return dk * LN2_HI - ((s * (f - r) - dk * LN2_LO) - f);
}

/**
 * log(1 + x), accurate for `x` near 0 too: 1 + x is 2^k * (1 + f) as in `log`, with a
 * correction term for the rounding of 1 + x. The error is below 1 ulp.
 */
export function log1p(x: f64): f64 {
  const hx = highWord(x);
  const ax = hx & 0x7fffffff;
  let k: i32 = 1;
  let f = 0.0;
  let hu: i32 = 0;
  let c = 0.0;
  if (hx < 0x3fda827a) {
    // 1 + x < sqrt(2)
    if (ax >= 0x3ff00000) {
      // x <= -1
      return x == -1.0 ? -Infinity : NaN;
    }
    if (ax < 0x3e200000) {
      // |x| < 2^-29
      if (ax < 0x3c900000) {
        // |x| < 2^-54
        return x;
      }
      return x - x * x * 0.5;
    }
    if (hx > 0 || hx <= (0xbfd2bec4 as i32)) {
      // sqrt(2)/2 < 1 + x < sqrt(2)
      k = 0;
      f = x;
      hu = 1;
    }
  }
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  if (k != 0) {
    let u = 0.0;
    if (hx < 0x43400000) {
      u = 1.0 + x;
      hu = highWord(u);
      k = (hu >> 20) - 1023;
      // The correction term.
      c = k > 0 ? 1.0 - (u - x) : x - (u - 1.0);
      c /= u;
    } else {
      u = x;
      hu = highWord(u);
      k = (hu >> 20) - 1023;
      c = 0.0;
    }
    hu &= 0x000fffff;
    if (hu < 0x6a09e) {
      // Normalize u.
      u = withHighWord(u, hu | 0x3ff00000);
    } else {
      k += 1;
      // Normalize u/2.
      u = withHighWord(u, hu | 0x3fe00000);
      hu = (0x00100000 - hu) >> 2;
    }
    f = u - 1.0;
  }
  const hfsq = 0.5 * f * f;
  const dk = k as f64;
  if (hu == 0) {
    // |f| < 2^-20
    if (f == 0.0) {
      if (k == 0) {
        return 0.0;
      }
      c += dk * LN2_LO;
      return dk * LN2_HI + c;
    }
    const r = hfsq * (1.0 - 0.66666666666666666 * f);
    if (k == 0) {
      return f - r;
    }
    return dk * LN2_HI - ((r - (dk * LN2_LO + c)) - f);
  }
  const s = f / (2.0 + f);
  const z = s * s;
  const r = z * (LG1 + z * (LG2 + z * (LG3 + z * (LG4 + z * (LG5 + z * (LG6 + z * LG7))))));
  if (k == 0) {
    return f - (hfsq - s * (hfsq + r));
  }
  return dk * LN2_HI - ((hfsq - (s * (hfsq + r) + (dk * LN2_LO + c))) - f);
}

/**
 * The base 2 logarithm: log(1 + f) as in `log`, multiplied by 1/ln2 in two parts so that the
 * product keeps its low bits, then added to k. Exact for powers of two.
 */
export function log2(x0: f64): f64 {
  let x = x0;
  let hx = highWord(x);
  const lx = lowWord(x);
  let k: i32 = 0;
  if (hx < 0x00100000) {
    // x < 2^-1022
    if ((((hx & 0x7fffffff) as u32) | lx) == 0) {
      return -Infinity;
    }
    if (hx < 0) {
      return NaN;
    }
    // A subnormal: scale it up.
    k -= 54;
    x *= TWO54;
    hx = highWord(x);
  }
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  if (hx == 0x3ff00000 && lx == 0) {
    return 0.0;
  }
  k += (hx >> 20) - 1023;
  hx &= 0x000fffff;
  const i = (hx + 0x95f64) & 0x100000;
  // Normalize x or x/2.
  x = withHighWord(x, hx | (i ^ 0x3ff00000));
  k += i >> 20;
  const y = k as f64;
  const f = x - 1.0;
  const hfsq = 0.5 * f * f;
  // log(1 + f) - f + f*f/2
  const s = f / (2.0 + f);
  const z = s * s;
  const w = z * z;
  const t1 = w * (LG2 + w * (LG4 + w * LG6));
  const t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)));
  const r = s * (hfsq + (t2 + t1));
  const hi = clearLowWord(f - hfsq);
  const lo = (f - hi) - hfsq + r;
  let valHi = hi * IVLN2_HI;
  let valLo = (lo + hi) * IVLN2_LO + lo * IVLN2_HI;
  const sum = y + valHi;
  valLo += (y - sum) + valHi;
  valHi = sum;
  return valLo + valHi;
}

/**
 * The base 10 logarithm: with x = 2^n * m and 1 <= m < 2 (or 0.5 <= m < 1 for a negative n),
 * n*log10(2) + log(m)/ln(10). The error is below 1 ulp; powers of ten are not always exact.
 */
export function log10(x0: f64): f64 {
  let x = x0;
  let hx = highWord(x);
  let lx = lowWord(x);
  let k: i32 = 0;
  if (hx < 0x00100000) {
    // x < 2^-1022
    if ((((hx & 0x7fffffff) as u32) | lx) == 0) {
      return -Infinity;
    }
    if (hx < 0) {
      return NaN;
    }
    // A subnormal: scale it up.
    k -= 54;
    x *= TWO54;
    hx = highWord(x);
    lx = lowWord(x);
  }
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  if (hx == 0x3ff00000 && lx == 0) {
    return 0.0;
  }
  k += (hx >> 20) - 1023;
  const i: i32 = k < 0 ? 1 : 0;
  hx = (hx & 0x000fffff) | ((0x3ff - i) << 20);
  const y = (k + i) as f64;
  x = fromWords(hx, lx);
  const z = y * LOG10_2LO + IVLN10 * log(x);
  return z + y * LOG10_2HI;
}
