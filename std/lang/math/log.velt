// velt/lang/math (internal): `Math.log`, ported from fdlibm's e_log.c as V8 has it
// (src/base/ieee754.cc), so that results have the same bits as in JavaScript engines. Alone in
// its file: the prelude loads it for every program (`Math.log` shares its name with
// `console.log`, so no mention of it can load it on demand), and the other logarithms are in
// logs.velt. Copyright (C) 1993 by Sun Microsystems, Inc.; see NOTICE.

import { highWord, lowWord, withHighWord } from "velt/lang/math/words";

const LN2_HI: f64 = 6.93147180369123816490e-01;
const LN2_LO: f64 = 1.90821492927058770002e-10;
const TWO54: f64 = 1.80143985094819840000e+16;
const LG1: f64 = 6.666666666666735130e-01;
const LG2: f64 = 3.999999999940941908e-01;
const LG3: f64 = 2.857142874366239149e-01;
const LG4: f64 = 2.222219843214978396e-01;
const LG5: f64 = 1.818357216161805012e-01;
const LG6: f64 = 1.531383769920937332e-01;
const LG7: f64 = 1.479819860511658591e-01;

/**
 * The natural logarithm. `x` is 2^k * (1 + f) with sqrt(2)/2 < 1 + f < sqrt(2); log(1 + f) comes
 * from a polynomial in s = f / (2 + f), and the result is k*ln2 + log(1 + f). The error is
 * below 1 ulp.
 */
export function log(x0: f64): f64 {
  let x = x0;
  let hx = highWord(x);
  let k: i32 = 0;
  if (hx < 0x00100000) {
    // x < 2^-1022
    if ((((hx & 0x7fffffff) as u32) | lowWord(x)) == 0) {
      return -Infinity;
    }
    if (hx < 0) {
      return NaN;
    }
    // A subnormal: scale it up.
    k -= 54;
    x *= TWO54;
    hx = highWord(x);
  }
  if (hx >= 0x7ff00000) {
    return x + x;
  }
  k += (hx >> 20) - 1023;
  hx &= 0x000fffff;
  let i = (hx + 0x95f64) & 0x100000;
  // Normalize x or x/2.
  x = withHighWord(x, hx | (i ^ 0x3ff00000));
  k += i >> 20;
  const f = x - 1.0;
  if ((0x000fffff & (2 + hx)) < 3) {
    // |f| < 2^-20
    if (f == 0.0) {
      if (k == 0) {
        return 0.0;
      }
      const dk = k as f64;
      return dk * LN2_HI + dk * LN2_LO;
    }
    const r = f * f * (0.5 - 0.33333333333333333 * f);
    if (k == 0) {
      return f - r;
    }
    const dk = k as f64;
    return dk * LN2_HI - ((r - dk * LN2_LO) - f);
  }
  const s = f / (2.0 + f);
  const dk = k as f64;
  const z = s * s;
  i = hx - 0x6147a;
  const w = z * z;
  const j = 0x6b851 - hx;
  const t1 = w * (LG2 + w * (LG4 + w * LG6));
  const t2 = z * (LG1 + w * (LG3 + w * (LG5 + w * LG7)));
  i |= j;
  const r = t2 + t1;
  if (i > 0) {
    const hfsq = 0.5 * f * f;
    if (k == 0) {
      return f - (hfsq - s * (hfsq + r));
    }
    return dk * LN2_HI - ((hfsq - (s * (hfsq + r) + dk * LN2_LO)) - f);
  }
  if (k == 0) {
    return f - s * (f - r);
  }
  return dk * LN2_HI - ((s * (f - r) - dk * LN2_LO) - f);
}
