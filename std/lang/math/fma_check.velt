// velt/lang/math (internal): whether the CPU has x86's fused multiply-add (FMA3), the check of
// `@targetFeature("fma-x86")` (#1676). std's `pow` (std/lang/math/pow.velt) runs a copy compiled
// for it where it is true: each of its `fma`s is then one `vfmadd`, where the default x86-64 build
// (x86-64-v2, no FMA) calls C's `fma`. arm64 always has FMA and needs no check.
//
// It is velt/arch/x86's `Fma.isSupported()`: FMA with AVX and the AVX state saved by the OS, the
// CPU's answer read once at start-up (std/lang/cpu), or constant where `--cpu` has it. False off
// x86-64, on WebAssembly and in debug (Cranelift) builds. It tests the word itself rather than
// call `Fma`: a module of a class is loaded with std up front, and the class would then get an
// `any` tag (and its name's static) in programs that never use `velt/arch`.

import { cpuHas } from "velt/lang/cpu/word";
import { FMA_X86 } from "velt/lang/cpu/masks";

// True only where the build guarantees FMA: code built for a CPU that has it (`--cpu`), or gated
// on `fma-x86` and what such code calls.
declare function velt_simd_has_fma_x86(): bool;
// Whether this build runs x86-64's checks: false on another architecture, on WebAssembly and
// in debug (Cranelift) builds.
declare function velt_simd_on_x86(): bool;

/**
 * Whether the CPU has x86's FMA3 with the AVX state enabled (false off x86-64 and in debug
 * builds): the check a call of a function gated on `fma-x86` must sit behind.
 */
export function hasFmaX86(): bool {
  return velt_simd_has_fma_x86() || (velt_simd_on_x86() && cpuHas(FMA_X86));
}
