// velt/lang/math (internal): whether the CPU has x86's fused multiply-add (FMA3), the check of
// `@targetFeature("fma-x86")` (#1676). std's `pow` (std/lang/math/pow.velt) runs a copy compiled
// for it where it is true: each of its `fma`s is then one `vfmadd`, where the default x86-64 build
// (x86-64-v2, no FMA) calls C's `fma`. arm64 always has FMA and needs no check.
//
// It is velt/arch/x86's `Fma.isSupported()`: FMA with AVX and the AVX state saved by the OS, the
// CPU's answer read once at start-up (std/lang/cpu), or constant where `--cpu` has it. False off
// x86-64, on WebAssembly and in debug (Cranelift) builds.

import { Fma } from "velt/arch/x86/fma";

/**
 * Whether the CPU has x86's FMA3 with the AVX state enabled (false off x86-64 and in debug
 * builds): the check a call of a function gated on `fma-x86` must sit behind.
 */
export function hasFmaX86(): bool {
  return Fma.isSupported();
}
