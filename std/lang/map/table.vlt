// velt/lang/map (internal): the prelude `Map`'s hash table as it changes size (std/prelude/map.vlt):
// removing a slot, resizing, compacting the entries, and dropping them all.

import {
  arraySwap,
  arrayTruncate,
  arrayWithCapacity,
  holdsNull,
  nullAs,
} from "velt/lang/intrinsics";
import { place, shiftIn } from "velt/lang/map/slots";
import { mapNextSeq, mapSeqTail } from "velt/lang/map/order";
import { INITIAL_SLOTS, MAX_ENTRIES, POS_MASK } from "velt/lang/map/layout";

/**
 * Backward-shift deletion: moves the rest of the probe cluster one slot left until an empty
 * slot or an entry already in its home slot.
 */
export function mapRemoveSlot<K, V>(m: Map<K, V>, hole: usize) {
  const mask = m.slots.length - 1;
  let next = (hole + 1) & mask;
  let w = m.slots[next];
  while (w != 0 && ((next - ((w >> m.shift) as usize)) & mask) != 0) {
    m.slots[hole] = w;
    hole = next;
    next = (next + 1) & mask;
    w = m.slots[next];
  }
  m.slots[hole] = 0;
}

/**
 * Rebuilds the index with `capacity` slots (a power of two), compacting tombstones first.
 * The old slot words are re-placed as they are: their tags hold the homes, so no key is
 * rehashed.
 */
export function mapResize<K, V>(m: Map<K, V>, capacity: usize) {
  if (m.dead > 0) {
    mapCompact(m);
  }
  const slots: u64[] = arrayWithCapacity(capacity);
  for (let s: usize = 0; s < capacity; s++) {
    slots.push(0);
  }
  let bits: u64 = 0;
  let c = capacity;
  while (c > 1) {
    c = c >> 1;
    bits++;
  }
  const shift = 64 - bits;
  for (let s: usize = 0; s < m.slots.length; s++) {
    const w = m.slots[s];
    if (w != 0) {
      place(slots, shift, w);
    }
  }
  m.slots = slots;
  m.shift = shift;
}

/**
 * Slides live entries to the front (preserving order) with swaps, truncates the dead tail
 * (dropping the dead keys), then renumbers the positions in the slot words in place.
 * The sequence-number breakpoints are rebuilt on the way: one where a run of removed entries
 * ends (or an old breakpoint starts), so each entry keeps its sequence number.
 * Where `V` includes null, a null value does not tell a live entry from a deleted one, so
 * `moved` first marks the positions the slot words point at (1), in one pass, and then is
 * filled in place instead of pushed.
 */
export function mapCompact<K, V>(m: Map<K, V>) {
  const next = mapNextSeq(m);
  const moved: u64[] = arrayWithCapacity(m.entryKeys.length);
  if (holdsNull(nullAs<V>())) {
    mapMarkLive(m, moved);
  }
  const oldPos = m.seqPos;
  const oldOff = m.seqOff;
  m.seqPos = [];
  m.seqOff = [];
  let k: usize = 0;
  let off: usize = 0;
  let nextBp = oldPos.length > 0 ? oldPos[0] : MAX_ENTRIES;
  let shifted = false;
  let w: usize = 0;
  for (let r: usize = 0; r < m.entryKeys.length; r++) {
    if (r == nextBp) {
      off = oldOff[k];
      k++;
      nextBp = k < oldPos.length ? oldPos[k] : MAX_ENTRIES;
      shifted = true;
    }
    if (m.entryValues[r] != null || (holdsNull(nullAs<V>()) && moved[r] != 0)) {
      if (w != r) {
        arraySwap(m.entryKeys, w, r);
        arraySwap(m.entryValues, w, r);
      }
      if (shifted) {
        // The first breakpoint is at position 0: the entries before m one kept their
        // positions, and with them offset 0.
        if (w > 0 && m.seqPos.length == 0) {
          m.seqPos.push(0);
          m.seqOff.push(0);
        }
        m.seqPos.push(w);
        m.seqOff.push(r + off - w);
        shifted = false;
      }
      w++;
      if (holdsNull(nullAs<V>())) {
        moved[r] = w as u64;
      } else {
        moved.push(w as u64);
      }
    } else {
      if (!holdsNull(nullAs<V>())) {
        moved.push(0);
      }
      shifted = true;
    }
  }
  arrayTruncate(m.entryKeys, w);
  arrayTruncate(m.entryValues, w);
  mapSeqTail(m, w, next);
  m.renumbers++;
  m.dead = 0;
  for (let s: usize = 0; s < m.slots.length; s++) {
    const word = m.slots[s];
    if (word != 0) {
      m.slots[s] = (word & ~POS_MASK) | moved[((word & POS_MASK) - 1) as usize];
    }
  }
}

/**
 * `compact`'s marks where `V` includes null: one word per entry, 1 where a slot word points at
 * the entry (it is live), else 0.
 */
export function mapMarkLive<K, V>(m: Map<K, V>, moved: u64[]) {
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    moved.push(0);
  }
  for (let s: usize = 0; s < m.slots.length; s++) {
    const w = m.slots[s];
    if (w != 0) {
      moved[((w & POS_MASK) - 1) as usize] = 1;
    }
  }
}

export function mapDropEntries<K, V>(m: Map<K, V>) {
  const next = mapNextSeq(m);
  arrayTruncate(m.entryKeys, 0);
  arrayTruncate(m.entryValues, 0);
  m._size = 0;
  m.dead = 0;
  mapSeqTail(m, 0, next);
  m.renumbers++;
}

/** Appends a new entry; `s` is `lookup`'s miss result for `key`. */
export function mapAppend<K, V>(m: Map<K, V>, key: K, value: V, p: u64, s: i64) {
  m.edits++;
  if ((m._size + 1) * 4 > m.slots.length * 3) {
    mapResize(m, m.slots.length == 0 ? INITIAL_SLOTS : m.slots.length * 2);
    s = m.lookup(key, p);
  }
  if (m.entryKeys.length >= MAX_ENTRIES) {
    panic("Map: too many entries");
  }
  const word = (p & ~POS_MASK) | (m.entryKeys.length as u64 + 1);
  m.entryKeys.push(key);
  m.entryValues.push(value);
  shiftIn(m.slots, (-s - 1) as usize, word);
  m._size++;
}
