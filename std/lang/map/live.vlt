// velt/lang/map (internal): the prelude `Map`'s live entries (std/prelude/map.vlt): which entries
// are live when a value may be null, its keys, values and entries in order, and deep equality.

import { arrayWithCapacity, hash, holdsNull, nullAs, share } from "velt/lang/intrinsics";
import { MAP_LIVE_AT, MAP_LIVE_POSITIONS } from "velt/lang/hooks/keys";
import { equalByContent, equalByFields } from "velt/lang/equal/generated";
import { bitAt, pushEntry, pushNullEntry, pushShared } from "velt/lang/map/slots";
import { FIB, POS_MASK } from "velt/lang/map/layout";

/**
 * Which entry positions are live, as a bitset read from the slot words in one pass: every live
 * entry has a slot and a deleted one has none (a delete removes the slot at once). For maps
 * whose `V` includes null that have tombstones, where a null value does not tell; an entry
 * holding a value is live anyway. No key is hashed, so an entry whose tuple key changed
 * since it was set is found too.
 */
export function mapLiveBits<K, V>(m: Map<K, V>): u64[] {
  const words = (m.entryKeys.length + 63) / 64;
  const bits: u64[] = arrayWithCapacity(words);
  for (let i: usize = 0; i < words; i++) {
    bits.push(0);
  }
  for (let s: usize = 0; s < m.slots.length; s++) {
    const w = m.slots[s];
    if (w != 0) {
      const e = (w & POS_MASK) - 1;
      bits[(e >> 6) as usize] = bits[(e >> 6) as usize] | ((1 as u64) << (e & 63));
    }
  }
  return bits;
}

/**
 * `[MAP_LIVE_POSITIONS]`, `keys()`, `values()`, `entries()` and `deepEquals` with `liveBits`.
 * They are methods of their own so that the code of maps whose `V` excludes null declares no
 * more locals.
 */
export function mapLivePositionsBits<K, V>(m: Map<K, V>): usize[] {
  const live = mapLiveBits(m);
  const out: usize[] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (m.entryValues[e] != null || bitAt(live, e)) {
      out.push(e);
    }
  }
  return out;
}

export function mapLiveKeys<K, V>(m: Map<K, V>): K[] {
  const live = mapLiveBits(m);
  const out: K[] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (m.entryValues[e] != null || bitAt(live, e)) {
      out.push(share(m.entryKeys[e]));
    }
  }
  return out;
}

export function mapLiveValues<K, V>(m: Map<K, V>): V[] {
  const live = mapLiveBits(m);
  const out: V[] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryValues.length; e++) {
    if (m.entryValues[e] != null) {
      pushShared(out, m.entryValues[e]);
    } else if (bitAt(live, e)) {
      out.push(nullAs<V>());
    }
  }
  return out;
}

export function mapLiveEntries<K, V>(m: Map<K, V>): [K, V][] {
  const live = mapLiveBits(m);
  const out: [K, V][] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (m.entryValues[e] != null) {
      pushEntry(out, m.entryKeys[e], m.entryValues[e]);
    } else if (bitAt(live, e)) {
      pushNullEntry(out, m.entryKeys[e]);
    }
  }
  return out;
}

export function mapLiveDeepEquals<K, V>(m: Map<K, V>, other: Map<K, V>, deep: bool): bool {
  const live = mapLiveBits(m);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (m.entryValues[e] != null || bitAt(live, e)) {
      const o = other.lookup(m.entryKeys[e], hash(m.entryKeys[e]) * FIB);
      if (o < 0) {
        return mapDeepEqualsByContent(m, other, deep);
      }
      if (!valuesEqual<V>(m.entryValues[e], other.entryValues[o as usize], deep)) {
        return false;
      }
    }
  }
  return true;
}

/**
 * Whether entry `e`, whose value is null and whose `V` includes null, is live (holds a null
 * value) rather than deleted: true when the map has no tombstones, else when a slot of the
 * index still points at it (a delete removes the entry's slot at once but leaves its key). It
 * probes from the home of the entry's key's current hash, so while the map has tombstones it
 * misses an entry whose tuple key changed since it was set (`forEach`, `for...of` and the
 * formatting and JSON glue then skip it; the bulk readers use `liveBits`).
 */
export function mapLiveNull<K, V>(m: Map<K, V>, e: usize): bool {
  if (m.dead == 0) {
    return true;
  }
  const mask = m.slots.length - 1;
  const want = e as u64 + 1;
  const p = hash(m.entryKeys[e]) * FIB;
  let s = (p >> m.shift) as usize;
  let dist: usize = 0;
  while (true) {
    const w = m.slots[s];
    if (w == 0) {
      return false;
    }
    if ((w & POS_MASK) == want) {
      return true;
    }
    if (((s - ((w >> m.shift) as usize)) & mask) < dist) {
      return false;
    }
    s = (s + 1) & mask;
    dist++;
  }
}

/**
 * `deepEquals` once a key of m map is not a key of `other`: an object key is matched by
 * identity, so, as in Node's `isDeepStrictEqual`, each such entry is paired with a distinct
 * entry of `other` whose key and value are deeply equal.
 */
export function mapDeepEqualsByContent<K, V>(m: Map<K, V>, other: Map<K, V>, deep: bool): bool {
  const used: bool[] = arrayWithCapacity(other.entryKeys.length);
  for (let o: usize = 0; o < other.entryKeys.length; o++) {
    used.push(false);
  }
  const misses: usize[] = [];
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (m[MAP_LIVE_AT](e)) {
      const o = other.lookup(m.entryKeys[e], hash(m.entryKeys[e]) * FIB);
      if (o < 0) {
        misses.push(e);
      } else if (valuesEqual<V>(m.entryValues[e], other.entryValues[o as usize], deep)) {
        used[o as usize] = true;
      } else {
        return false;
      }
    }
  }
  for (const e of misses) {
    let found = false;
    for (let o: usize = 0; o < other.entryKeys.length && !found; o++) {
      if (
        !used[o] &&
        other[MAP_LIVE_AT](o) &&
        entriesEqual(m.entryKeys[e], other.entryKeys[o], deep) &&
        valuesEqual<V>(m.entryValues[e], other.entryValues[o], deep)
      ) {
        used[o] = true;
        found = true;
      }
    }
    if (!found) {
      return false;
    }
  }
  return true;
}

/** `keys` of `m` (std/prelude/map.vlt). */
export function mapKeys<K, V>(m: Map<K, V>): K[] {
  if (holdsNull(nullAs<V>()) && m.dead > 0) {
    return mapLiveKeys(m);
  }
  const out: K[] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (holdsNull(nullAs<V>()) || m.entryValues[e] != null) {
      out.push(share(m.entryKeys[e]));
    }
  }
  return out;
}

/** `values` of `m` (std/prelude/map.vlt). */
export function mapValues<K, V>(m: Map<K, V>): V[] {
  if (holdsNull(nullAs<V>()) && m.dead > 0) {
    return mapLiveValues(m);
  }
  const out: V[] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryValues.length; e++) {
    if (holdsNull(nullAs<V>()) && m.entryValues[e] == null) {
      out.push(nullAs<V>());
    } else {
      pushShared(out, m.entryValues[e]);
    }
  }
  return out;
}

/** `entries` of `m` (std/prelude/map.vlt). */
export function mapEntries<K, V>(m: Map<K, V>): [K, V][] {
  if (holdsNull(nullAs<V>()) && m.dead > 0) {
    return mapLiveEntries(m);
  }
  const out: [K, V][] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (holdsNull(nullAs<V>()) && m.entryValues[e] == null) {
      pushNullEntry(out, m.entryKeys[e]);
    } else {
      pushEntry(out, m.entryKeys[e], m.entryValues[e]);
    }
  }
  return out;
}

/** `[MAP_LIVE_POSITIONS]` of `m` (std/prelude/map.vlt). */
export function mapLivePositions<K, V>(m: Map<K, V>): usize[] {
  if (holdsNull(nullAs<V>()) && m.dead > 0) {
    return mapLivePositionsBits(m);
  }
  const out: usize[] = arrayWithCapacity(m._size);
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (holdsNull(nullAs<V>()) || m.entryValues[e] != null) {
      out.push(e);
    }
  }
  return out;
}

/** `deepEquals` of `m` (std/prelude/map.vlt). */
export function mapDeepEquals<K, V>(m: Map<K, V>, other: Map<K, V>, deep: bool): bool {
  if (m._size != other._size) {
    return false;
  }
  if (holdsNull(nullAs<V>()) && m.dead > 0) {
    return mapLiveDeepEquals(m, other, deep);
  }
  for (let e: usize = 0; e < m.entryKeys.length; e++) {
    if (holdsNull(nullAs<V>()) || m.entryValues[e] != null) {
      const p = hash(m.entryKeys[e]) * FIB;
      const o = other.lookup(m.entryKeys[e], p);
      if (o < 0) {
        return mapDeepEqualsByContent(m, other, deep);
      }
      if (!valuesEqual<V>(m.entryValues[e], other.entryValues[o as usize], deep)) {
        return false;
      }
    }
  }
  return true;
}

/** Two keys or values, as `deepEqual` compares them, or (`deep`) as Vitest's `toEqual`. */
export function entriesEqual<T>(a: T, b: T, deep: bool): bool {
  return deep ? equalByFields(a, b) : equalByContent(a, b);
}

/**
 * Two entries' values as `entriesEqual` compares them, at `V` (not `V | null`): so the
 * generated comparisons it needs are at the map's own type arguments, which the generator
 * asks for with the map's (velt/lang/equal/generate `entryInstances`).
 */
export function valuesEqual<T>(a: T | null, b: T | null, deep: bool): bool {
  if (a != null && b != null) {
    return entriesEqual<T>(a, b, deep);
  }
  return a == null && b == null;
}
