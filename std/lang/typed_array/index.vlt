// velt/lang/typed_array: the ES typed arrays and their buffer (docs/std/prelude/typed_array.md):
// `ArrayBuffer`, `DataView`, `Uint8Array`, `Int8Array`, `Uint8ClampedArray`, `Int16Array`,
// `Uint16Array`, `Int32Array`, `Uint32Array`, `Float32Array` and `Float64Array`. Each is also a
// global of its own (std/prelude/global/), so a program loads only the classes it names.

export { ArrayBuffer } from "velt/lang/typed_array/core";
export { DataView } from "velt/lang/typed_array/data_view";
export { Int8Array } from "velt/lang/typed_array/int8_array";
export { Uint8Array } from "velt/lang/typed_array/uint8_array";
export { Uint8ClampedArray } from "velt/lang/typed_array/uint8_clamped_array";
export { Int16Array } from "velt/lang/typed_array/int16_array";
export { Uint16Array } from "velt/lang/typed_array/uint16_array";
export { Int32Array } from "velt/lang/typed_array/int32_array";
export { Uint32Array } from "velt/lang/typed_array/uint32_array";
export { Float32Array } from "velt/lang/typed_array/float32_array";
export { Float64Array } from "velt/lang/typed_array/float64_array";
