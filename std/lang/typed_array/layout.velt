// velt/lang/typed_array (internal): the layout of a new typed array (`new C(arg, byteOffset,
// length)`): its buffer, the range of it the elements take, and the values to write there.
//
// Generated by scripts/gen-typed-arrays.py: change the script, not this file.

import { ArrayBuffer, toIndex } from "velt/lang/typed_array/buffer";
import { elementsOf, TypedArray } from "velt/lang/typed_array/base";
import { TYPED_ARRAY_KIND } from "velt/lang/hooks/keys";

/** Where a new typed array's elements are, and the values to write there (null: none). */
export struct Layout {
  buf: ArrayBuffer;
  off: usize;
  len: usize;
  values: number[] | null;
}

/**
 * The layout of `new C(arg, byteOffset, length)` for kind `kind` of `size`-byte elements named
 * `name`: `RangeError`s as in JS (V8's messages).
 */
export function layout(
  arg: number | ArrayBuffer | number[] | TypedArray,
  byteOffset: number,
  length: number | null | undefined,
  size: usize,
  kind: u32,
  name: string,
): Layout {
  if (typeof arg == "number") {
    const n = toIndex(arg);
    // A byte length beyond 2^52 - 1 is an invalid length: the bytes are an array, which holds
    // at most that many (V8 stops far earlier); a smaller one that can't be allocated fails in
    // `ArrayBuffer`. A view of a buffer is shorter than the buffer, so every typed array's
    // length is below 2^52 too, which `count()` says to the compiler.
    if (n < 0 || (n as number) * (size as number) > 4503599627370495) {
      throw new RangeError(`Invalid typed array length: ${arg}`);
    }
    return {
      buf: new ArrayBuffer((n as number) * (size as number)),
      off: 0,
      len: n as usize,
      values: null,
    };
  }
  if (arg instanceof ArrayBuffer) {
    const off = toIndex(byteOffset);
    if (off < 0) {
      throw new RangeError(`Start offset ${byteOffset} is outside the bounds of the buffer`);
    }
    const start = off as usize;
    if (start % size != 0) {
      throw new RangeError(`start offset of ${name} should be a multiple of ${size}`);
    }
    const total = arg.bytes.length as usize;
    if (length == null) {
      if (total % size != 0) {
        throw new RangeError(`byte length of ${name} should be a multiple of ${size}`);
      }
      if (start > total) {
        throw new RangeError(`Start offset ${start} is outside the bounds of the buffer`);
      }
      return { buf: arg, off: start, len: (total - start) / size, values: null };
    }
    const n = toIndex(length);
    if (n < 0 || start + (n as usize) * size > total) {
      throw new RangeError(`Invalid typed array length: ${length}`);
    }
    return { buf: arg, off: start, len: n as usize, values: null };
  }
  if (arg instanceof TypedArray && arg[TYPED_ARRAY_KIND]() == kind) {
    // The same kind: the bytes, copied.
    const o = arg.off as i64;
    const bytes = arg.buf.bytes.slice(o, o + ((arg.len * size) as i64));
    // The length of what was copied, not `arg.len`: `[TYPED_ARRAY_KIND]` is a method a subclass may
    // override, and a view's elements must lie in its buffer (typed_array/buffer `element*`).
    return {
      buf: ArrayBuffer.adopt(bytes),
      off: 0,
      len: (bytes.length as usize) / size,
      values: null,
    };
  }
  const xs = elementsOf(arg);
  const n = xs.length as usize;
  return { buf: new ArrayBuffer((n * size) as number), off: 0, len: n, values: xs };
}
