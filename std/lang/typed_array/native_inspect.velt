// velt/lang/typed_array (internal): `NativeInspect`, what `[INSPECT]()` returns for a class that
// stands for one of Node's own objects.

/**
 * What an `[INSPECT]()` returns for a class that stands for one of Node's own objects (std only:
 * `ArrayBuffer`, `DataView`, `URL`): `console.log` prints `text`, and past Node's depth limit
 * `cut` (`URL {}`), or `[ArrayBuffer]` (the class's name) when `cut` is empty, as Node cuts its
 * objects, where a string `[INSPECT]()` is printed at any depth (`Date`).
 * crates/velt_vir/src/lower/glue/format.rs knows it by name.
 */
export struct NativeInspect {
  text: string;
  cut: string;
}
