// velt/lang/typed_array (internal): what the typed arrays share (ES2024 §23.2: `%TypedArray%`): the
// std-only base class `TypedArray`, and the default sort order. Programs use the globals
// (velt/lang/typed_array).
//
// Generated by scripts/gen-typed-arrays.py: change the script, not this file.

import { BufferView } from "velt/lang/typed_array/buffer_view";
import { TYPED_ARRAY_GET, TYPED_ARRAY_KIND, TYPED_ARRAY_PUT } from "velt/lang/hooks/keys";
import "velt/lang/number/to_fixed";

/**
 * What every typed array is (std only: JS's `%TypedArray%`): a view of a buffer
 * (`BufferView`: the buffer, the range of it the elements take) with element access by number
 * for copies between kinds.
 */
export class TypedArray extends BufferView {
  /** Element `i` (in range) as a number; each kind overrides it. */
  [TYPED_ARRAY_GET](i: usize): number {
    panic("ICE: TypedArray[TYPED_ARRAY_GET]");
  }

  /** Writes element `i` (in range); each kind overrides it. */
  [TYPED_ARRAY_PUT](i: usize, v: number) {
    panic("ICE: TypedArray[TYPED_ARRAY_PUT]");
  }

  /** Which of the nine kinds it is (its position in `KINDS` of the generator); each overrides it. */
  [TYPED_ARRAY_KIND](): u32 {
    panic("ICE: TypedArray[TYPED_ARRAY_KIND]");
  }
}

/** Any element, of any kind, as a number (std only). */
export function elementsOf(src: number[] | TypedArray): number[] {
  if (src instanceof TypedArray) {
    const out: number[] = [];
    for (let i: usize = 0; i < src.len; i++) {
      out.push(src[TYPED_ARRAY_GET](i));
    }
    return out;
  }
  return src;
}

/** The order of a typed array's default `sort()`: numeric, `-0` before `+0`, NaN last. */
export function ascending(a: number, b: number): number {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  if (a != a) {
    return b != b ? 0 : 1;
  }
  if (b != b) {
    return -1;
  }
  if (a == 0 && b == 0) {
    const na = 1 / a < 0;
    const nb = 1 / b < 0;
    return na == nb ? 0 : na ? -1 : 1;
  }
  return 0;
}

/** `x.toLocaleString()` in Node's default locale (en-US): grouped digits, at most 3 decimals. */
export function localeNumber(x: number): string {
  if (x != x) {
    return "NaN";
  }
  if (x == Infinity) {
    return "∞";
  }
  if (x == -Infinity) {
    return "-∞";
  }
  let s = x.toFixed(3);
  // Trailing zeros of the decimals, then the point, go.
  while (s.endsWith("0")) {
    s = s.slice(0, -1);
  }
  if (s.endsWith(".")) {
    s = s.slice(0, -1);
  }
  const neg = s.startsWith("-");
  if (neg) {
    s = s.slice(1);
  }
  const dot = s.indexOf(".");
  const int = dot < 0 ? s : s.slice(0, dot);
  const frac = dot < 0 ? "" : s.slice(dot);
  let grouped = "";
  const digits = int.length as i64;
  for (let i: i64 = 0; i < digits; i++) {
    if (i > 0 && (digits - i) % 3 == 0) {
      grouped += ",";
    }
    grouped += int[i];
  }
  const sign = neg || (x == 0 && 1 / x < 0) ? "-" : "";
  return `${sign}${grouped}${frac}`;
}
