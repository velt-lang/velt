// velt/lang/string (internal): the searches of a needle that can match half of a surrogate pair
// (std/lang/string/search.velt), on code units: a needle that starts with a lone low surrogate
// or ends with a lone high one also matches the half of a pair stored as one 4-byte sequence.
// Rare: lone surrogates come only from slicing between the halves of a pair,
// `String.fromCharCode` and JSON escapes.

import { arrayWithCapacity, noInline, strByteAt, strByteLen, strLen } from "velt/lang/intrinsics";

/** Does `needle` (`m` bytes) start with a lone low surrogate or end with a lone high one? Its
 * WTF-8 is then `ED B0..BF ..` at the start or `ED A0..AF ..` at the end. */
export function isHalfNeedle(needle: string, m: usize): bool {
  if (m < 3) {
    return false;
  }
  return (strByteAt(needle, 0) == 0xed && (strByteAt(needle, 1) & 0xf0) == 0xb0) ||
    endsWithHigh(needle, m);
}

/** Does `s` (`n` bytes, at least 3) end with a lone high surrogate? */
export function endsWithHigh(s: string, n: usize): bool {
  return strByteAt(s, (n - 3) as u64) == 0xed && (strByteAt(s, (n - 2) as u64) & 0xf0) == 0xa0;
}

/** The code point of the 4-byte sequence of `s` at `i`. */
export function codePoint4(s: string, i: usize): u32 {
  return ((strByteAt(s, i as u64) & 0x07) as u32) << 18 |
    ((strByteAt(s, (i + 1) as u64) & 0x3f) as u32) << 12 |
    ((strByteAt(s, (i + 2) as u64) & 0x3f) as u32) << 6 |
    ((strByteAt(s, (i + 3) as u64) & 0x3f) as u32);
}

/** The surrogate (or other BMP code point) of the 3-byte sequence of `s` at `i`. */
export function codePoint3(s: string, i: usize): u32 {
  return ((strByteAt(s, i as u64) & 0x0f) as u32) << 12 |
    ((strByteAt(s, (i + 1) as u64) & 0x3f) as u32) << 6 |
    ((strByteAt(s, (i + 2) as u64) & 0x3f) as u32);
}

/** The code units of `s` (canonical WTF-8: a pair is one 4-byte sequence). */
function codeUnits(s: string): u16[] {
  const n = strByteLen(s);
  const out: u16[] = arrayWithCapacity(strLen(s));
  let i: usize = 0;
  while (i < n) {
    const b = strByteAt(s, i as u64);
    if (b < 0x80) {
      out.push(b as u16);
      i += 1;
    } else if (b < 0xe0) {
      out.push(((b & 0x1f) as u16) << 6 | ((strByteAt(s, (i + 1) as u64) & 0x3f) as u16));
      i += 2;
    } else if (b < 0xf0) {
      out.push(codePoint3(s, i) as u16);
      i += 3;
    } else {
      const c = codePoint4(s, i) - 0x10000;
      out.push((0xd800 + (c >> 10)) as u16);
      out.push((0xdc00 + (c & 0x3ff)) as u16);
      i += 4;
    }
  }
  return out;
}

/** Do units `at..at + p.length` of `h` equal `p`? */
function unitsAt(h: u16[], p: u16[], at: usize): bool {
  for (let k: usize = 0; k < p.length; k++) {
    if (h[at + k] != p[k]) {
      return false;
    }
  }
  return true;
}

/** `indexOf` of a half needle: the first match at or after unit `from`. */
@noInline
export function unitsFind(s: string, needle: string, from: usize): i64 {
  const h = codeUnits(s);
  const p = codeUnits(needle);
  for (let i = from; i + p.length <= h.length; i++) {
    if (unitsAt(h, p, i)) {
      return i as i64;
    }
  }
  return -1;
}

/** `lastIndexOf` of a half needle: the last match starting at or before unit `last`. */
@noInline
export function unitsRfind(s: string, needle: string, last: usize): i64 {
  const h = codeUnits(s);
  const p = codeUnits(needle);
  let i = last + 1;
  while (i > 0) {
    i--;
    if (unitsAt(h, p, i)) {
      return i as i64;
    }
  }
  return -1;
}
