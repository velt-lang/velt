// velt/lang/string (internal): `s.localeCompare(t)` in the CLDR root collation, like
// `Intl.Collator("und")` (Node's own `localeCompare` uses the host's locale instead), in a module
// of its own so that a program loads it and its table only when it mentions `localeCompare`
// (std/prelude/global/locale_compare.velt, a conditional global).
//
// Three levels, as in the Unicode Collation Algorithm: base letters first (`"a" < "B"`), then
// accents (`"e" < "é"`), then case (`"a" < "A"`). The characters of the table
// (std/lang/string/collate_table.velt) order exactly like `Intl.Collator("und")`, except the few
// that expand to three or more collation elements (`¼`, `½`, `¾`, `ϗ`; the table holds two).
// Everything else is approximate: combining marks (U+0300..U+036F) weigh only as accents, so a
// decomposed `e` + U+0301 sorts next to `é` but not equal to it (ICU normalizes first); other
// letters and digits sort after the table's letters (Hangul, kana and Han last, in that order),
// and other symbols (emoji included) just before the digits, each group by code point. Controls
// are ignored, as in ICU. A lone surrogate weighs as U+FFFD.
//
// A character's *word* holds its collation elements: a table word (collate_table.velt), or for a
// character outside the table `OUTSIDE` and its primary weight. A weight here is a level's weight
// plus what keeps 0 free for "no element", which also sorts a string that ends before one that
// goes on.

import {
  ALNUM,
  BLOCK_AT,
  BLOCK_END,
  BLOCK_FIRST,
  LAST_PRIMARY,
  WEIGHTS,
  ZERO_PRIMARY,
} from "velt/lang/string/collate_table";
import { strByteAt, strByteLen } from "velt/lang/intrinsics";

/** The bit of a word for a character outside the table; the bits below it are its primary. */
const OUTSIDE: u64 = 0x8000000000000000;
/** A table's primary rank `p` weighs `p << 21`, leaving room for code points between ranks. */
const PRIMARY_SHIFT: u64 = 21;

/** Is `cp` a letter or digit outside the table? A binary search of the inversion list. */
function isAlnum(cp: u64): bool {
  let lo: usize = 0;
  let hi: usize = ALNUM.length;
  while (lo < hi) {
    const mid = (lo + hi) / 2;
    if ((ALNUM[mid] as u64) <= cp) {
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return lo % 2 == 1;
}

/**
 * The rank of a letter or digit outside the table among the scripts the root collation orders
 * last: 0 for most, then Hangul, kana, and Han ideographs after every other script.
 */
function scriptTier(cp: u64): u64 {
  if (
    (cp >= 0x1100 && cp <= 0x11ff) ||
    (cp >= 0x3130 && cp <= 0x318f) ||
    (cp >= 0xac00 && cp <= 0xd7af)
  ) {
    return 1;
  }
  if ((cp >= 0x3040 && cp <= 0x30ff) || (cp >= 0x31f0 && cp <= 0x31ff)) {
    return 2;
  }
  if (
    (cp >= 0x3400 && cp <= 0x4dbf) ||
    (cp >= 0x4e00 && cp <= 0x9fff) ||
    (cp >= 0xf900 && cp <= 0xfaff) ||
    (cp >= 0x20000 && cp <= 0x323af)
  ) {
    return 3;
  }
  return 0;
}

/** The word of a character outside the table. */
function outsideWord(cp: u64): u64 {
  if (cp < 0x20) {
    return 0;
  }
  if (cp >= 0x300 && cp <= 0x36f) {
    return (1 + cp - 0x300) << 24;
  }
  const tier = scriptTier(cp);
  // A symbol weighs just below the digits.
  const rank = tier > 0 || isAlnum(cp) ? LAST_PRIMARY + tier : ZERO_PRIMARY - 1;
  return OUTSIDE | (rank << PRIMARY_SHIFT) | cp;
}

/** The word of `cp`. */
function wordOf(cp: u64): u64 {
  for (let k: usize = 0; k < BLOCK_FIRST.length; k++) {
    if (cp < (BLOCK_END[k] as u64)) {
      const first = BLOCK_FIRST[k] as u64;
      if (cp >= first) {
        return WEIGHTS[(cp - first + (BLOCK_AT[k] as u64)) as usize];
      }
      break;
    }
  }
  return outsideWord(cp);
}

/** How many bytes the character with lead byte `lead` takes. */
function charBytes(lead: u64): usize {
  if (lead < 0x80) {
    return 1;
  }
  if (lead < 0xe0) {
    return 2;
  }
  return lead < 0xf0 ? 3 : 4;
}

/** The word of the character at byte `i` of `s`, whose lead byte is `lead`. */
function wordAt(s: string, i: u64, lead: u64): u64 {
  if (lead < 0x80) {
    return wordOf(lead);
  }
  const b1 = (strByteAt(s, i + 1) as u64) & 0x3f;
  if (lead < 0xe0) {
    return wordOf(((lead & 0x1f) << 6) | b1);
  }
  const b2 = (strByteAt(s, i + 2) as u64) & 0x3f;
  if (lead < 0xf0) {
    const cp = ((lead & 0x0f) << 12) | (b1 << 6) | b2;
    return wordOf(cp >= 0xd800 && cp <= 0xdfff ? 0xfffd : cp);
  }
  return wordOf(
    ((lead & 0x07) << 18) | (b1 << 12) | (b2 << 6) | ((strByteAt(s, i + 3) as u64) & 0x3f),
  );
}

/** The weight of the word's first element at `level`; 0 if it has none there. */
function firstWeight(w: u64, level: i64): u64 {
  if (level == 0) {
    return (w & OUTSIDE) != 0 ? w & ~OUTSIDE : (w & 0xfff) << PRIMARY_SHIFT;
  }
  if (w == 0) {
    return 0;
  }
  if ((w & OUTSIDE) != 0) {
    return 1;
  }
  return 1 + (level == 1 ? (w >> 24) & 0xff : (w >> 32) & 0xf);
}

/** The weight of the word's second element at `level`; 0 if it has none. */
function secondWeight(w: u64, level: i64): u64 {
  if ((w & OUTSIDE) != 0 || ((w >> 12) & 0xfff) == 0) {
    return 0;
  }
  return level == 0 ? ((w >> 12) & 0xfff) << PRIMARY_SHIFT : 1;
}

/** The order of `a` and `b` at `level`, both read from byte `from`. */
function orderAt(a: string, b: string, from: u64, level: i64): i64 {
  const aEnd = strByteLen(a) as u64;
  const bEnd = strByteLen(b) as u64;
  let i = from;
  let j = from;
  // The second elements of the characters just read.
  let aNext: u64 = 0;
  let bNext: u64 = 0;
  while (true) {
    let x = aNext;
    aNext = 0;
    while (x == 0 && i < aEnd) {
      const lead = strByteAt(a, i) as u64;
      const w = wordAt(a, i, lead);
      i += charBytes(lead) as u64;
      x = firstWeight(w, level);
      aNext = secondWeight(w, level);
      if (x == 0) {
        x = aNext;
        aNext = 0;
      }
    }
    let y = bNext;
    bNext = 0;
    while (y == 0 && j < bEnd) {
      const lead = strByteAt(b, j) as u64;
      const w = wordAt(b, j, lead);
      j += charBytes(lead) as u64;
      y = firstWeight(w, level);
      bNext = secondWeight(w, level);
      if (y == 0) {
        y = bNext;
        bNext = 0;
      }
    }
    if (x != y) {
      return x < y ? -1 : 1;
    }
    if (x == 0) {
      return 0;
    }
  }
}

/**
 * -1, 0 or 1: the order of `a` and `b` in the collation of this module. What the two strings
 * start with alike weighs alike at every level, so the levels read only what follows.
 */
export function localeOrder(a: string, b: string): i64 {
  const aEnd = strByteLen(a) as u64;
  const bEnd = strByteLen(b) as u64;
  const end = aEnd < bEnd ? aEnd : bEnd;
  let from: u64 = 0;
  while (from < end) {
    const c = strByteAt(a, from);
    if (c >= 0x80 || c != strByteAt(b, from)) {
      break;
    }
    from++;
  }
  if (from == aEnd && from == bEnd) {
    return 0;
  }
  for (let level: i64 = 0; level < 3; level++) {
    const order = orderAt(a, b, from, level);
    if (order != 0) {
      return order;
    }
  }
  return 0;
}

extend string {
  /**
   * -1, 0 or 1: the order of `this` and `that` in the CLDR root collation, like
   * `new Intl.Collator("und").compare` ("a" < "A" < "b", "e" < "é" < "f"). Node's own
   * `localeCompare` follows the host's locale instead. Exact for strings made of U+0020..U+024F,
   * U+0370..U+04FF, U+1E00..U+1EFF, U+2000..U+206F and U+20A0..U+20CF (Latin with Vietnamese,
   * Greek, Cyrillic, general punctuation, currency signs), except a few characters that stand
   * for three or more (`¼`, `½`, `¾`, `ϗ`); approximate for everything else. No locale or
   * options arguments.
   */
  localeCompare(that: string): i64 {
    return localeOrder(this, that);
  }
}
