// velt/lang/string (internal): `s.localeCompare(t)` in the CLDR root collation, like
// `Intl.Collator("und")` (Node's own `localeCompare` uses the host's locale instead), in a module
// of its own so that a program loads it and its table only when it mentions `localeCompare`
// (std/prelude/global/locale_compare.velt, a conditional global).
//
// Three levels, as in the Unicode Collation Algorithm: base letters first (`"a" < "B"`), then
// accents (`"e" < "é"`), then case (`"a" < "A"`). The characters of the table
// (std/lang/string/collate_table.velt) order exactly like `Intl.Collator("und")`, except the few
// that expand to three or more collation elements (`¼`, `½`, `¾`, `ϗ`; the table holds two), and
// `…` and the primes `″ ‴ ⁗ ‶ ‷`, which ICU reads as three `.` and as two to four `′` or `‵`, and
// the table as one character each: strings that go on past one of them can order differently
// (against `‥`, `′` or `‵`, for example).
// Everything else is approximate: combining marks (U+0300..U+036F) weigh only as accents, so a
// decomposed `e` + U+0301 sorts next to `é` but not equal to it (ICU normalizes first); other
// letters and digits sort after the table's letters (Hangul, kana and Han last, in that order),
// and other symbols (emoji included) just before the digits, each group by code point. Controls
// are ignored, as in ICU. A lone surrogate weighs as U+FFFD.
//
// Every program that mentions `localeCompare` compiles this code, so it is small: one function
// reads a character's collation elements at a level (`elementsAt`), out of line, and `orderAt`
// compares what it returns, also out of line, so that the three levels share one copy. A weight
// here is a level's weight plus what keeps 0 free for "no element", which also sorts a string
// that ends before one that goes on.

import {
  CLASS_RUNS,
  CLASSES,
  LAST_PRIMARY,
  PAGES,
  PAGES_END,
  WEIGHTS,
  ZERO_PRIMARY,
} from "velt/lang/string/collate_table";
import { noInline, strByteAt, strByteLen } from "velt/lang/intrinsics";

/** A table's primary rank `p` weighs `p << 21`, leaving room for code points between ranks. */
const PRIMARY_SHIFT: u64 = 21;
/** The bits of one weight in what `elementsAt` returns. */
const WEIGHT_MASK: u64 = 0x3fffffff;

/**
 * The class (`CLASSES`) of `cp`, a code point outside the table: that of the last run that starts
 * at or before it, by a binary search.
 */
function classOf(cp: u64): u64 {
  const t = CLASSES;
  let lo: u64 = 0;
  let hi: u64 = CLASS_RUNS;
  let found: u64 = 0;
  while (lo < hi) {
    const mid = (lo + hi) / 2;
    const at = mid * 3;
    const run =
      (strByteAt(t, at) as u64) |
      ((strByteAt(t, at + 1) as u64) << 7) |
      ((strByteAt(t, at + 2) as u64) << 14);
    if (run >> 3 <= cp) {
      found = run & 7;
      lo = mid + 1;
    } else {
      hi = mid;
    }
  }
  return found;
}

/**
 * The collation elements at `level` of the character at byte `i` of `s`: the first's weight in
 * bits 0..30 and the second's (of a character that stands for two, such as `æ`) in bits 30..60,
 * 0 for no element; and the character's length in bytes, less 1, in bits 62..64. One function
 * with no calls on the common paths, as a debug build calls each function it doesn't inline.
 */
@noInline
function elementsAt(s: string, i: u64, level: i64): u64 {
  const lead = strByteAt(s, i) as u64;
  let size: u64 = 0;
  let cp = lead;
  if (lead >= 0x80) {
    const b1 = (strByteAt(s, i + 1) as u64) & 0x3f;
    if (lead < 0xe0) {
      size = 1;
      cp = ((lead & 0x1f) << 6) | b1;
    } else {
      const b2 = (strByteAt(s, i + 2) as u64) & 0x3f;
      if (lead < 0xf0) {
        size = 2;
        cp = ((lead & 0x0f) << 12) | (b1 << 6) | b2;
        if (cp >= 0xd800 && cp <= 0xdfff) {
          // A lone surrogate weighs as U+FFFD.
          cp = 0xfffd;
        }
      } else {
        size = 3;
        cp = ((lead & 0x07) << 18) | (b1 << 12) | (b2 << 6) | ((strByteAt(s, i + 3) as u64) & 0x3f);
      }
    }
  }
  const page: u64 = cp < PAGES_END ? strByteAt(PAGES, cp >> 4) as u64 : 0;
  let w: u64 = 0;
  if (page != 0) {
    const t = WEIGHTS;
    const at = (((page - 1) << 4) | (cp & 15)) * 5;
    w =
      (strByteAt(t, at) as u64) |
      ((strByteAt(t, at + 1) as u64) << 7) |
      ((strByteAt(t, at + 2) as u64) << 14) |
      ((strByteAt(t, at + 3) as u64) << 21) |
      ((strByteAt(t, at + 4) as u64) << 28);
    if (w == 0) {
      // Ignorable.
      return size << 62;
    }
  } else if (cp >= 0x300 && cp <= 0x36f) {
    // A combining mark has an accent only, ranked by code point.
    w = (1 + cp - 0x300) << 24;
  } else if (cp < 0x20) {
    // A control is ignorable.
    return size << 62;
  } else {
    // Outside the table: one element, of weight 1 at the accent and case levels.
    if (level > 0) {
      return (size << 62) | 1;
    }
    // A symbol weighs just below the digits, the other classes after the table's letters.
    const c = classOf(cp);
    const rank = c == 0 ? ZERO_PRIMARY - 1 : LAST_PRIMARY + c - 1;
    return (size << 62) | (rank << PRIMARY_SHIFT) | cp;
  }
  // A table word packs primary 1 (bits 0..12), primary 2 (12..24), secondary (24..32) and
  // tertiary (32..36) ranks.
  const p2 = (w >> 12) & 0xfff;
  if (level == 0) {
    return (size << 62) | ((w & 0xfff) << PRIMARY_SHIFT) | (p2 << (PRIMARY_SHIFT + 30));
  }
  const first = 1 + (level == 1 ? (w >> 24) & 0xff : (w >> 32) & 0xf);
  return (size << 62) | first | (p2 == 0 ? 0 : 1 << 30);
}

/**
 * At the first level (`level` 0), the byte after the combining marks U+0300..U+033F (UTF-8 lead
 * byte 0xCC) that start at byte `i` of `s`, else `i`. Marks weigh nothing at the first level, so
 * after an ignorable character `orderAt` skips the marks that follow with this loop instead of a
 * call to `elementsAt` per mark. It tests `level` itself: a test in `orderAt`'s loop would have
 * LLVM copy that loop per level, which costs every release build that uses `localeCompare`.
 */
@noInline
function afterMarks(s: string, i: u64, end: u64, level: i64): u64 {
  if (level != 0) {
    return i;
  }
  let k = i;
  while (k < end && strByteAt(s, k) == 0xcc) {
    k += 2;
  }
  return k;
}

/** The order of `a` and `b` at `level`, both read from byte `from`. */
@noInline
function orderAt(a: string, b: string, from: u64, level: i64): i64 {
  const aEnd = strByteLen(a) as u64;
  const bEnd = strByteLen(b) as u64;
  let i = from;
  let j = from;
  // The second elements of the characters just read.
  let aNext: u64 = 0;
  let bNext: u64 = 0;
  while (true) {
    let x = aNext;
    aNext = 0;
    while (x == 0 && i < aEnd) {
      const e = elementsAt(a, i, level);
      i += (e >> 62) + 1;
      x = e & WEIGHT_MASK;
      aNext = (e >> 30) & WEIGHT_MASK;
      if (x == 0) {
        // Ignorable here, and so is its second element (the table has no character whose first
        // primary is 0 and second isn't; scripts/gen-collation-table.js checks).
        i = afterMarks(a, i, aEnd, level);
      }
    }
    let y = bNext;
    bNext = 0;
    while (y == 0 && j < bEnd) {
      const e = elementsAt(b, j, level);
      j += (e >> 62) + 1;
      y = e & WEIGHT_MASK;
      bNext = (e >> 30) & WEIGHT_MASK;
      if (y == 0) {
        j = afterMarks(b, j, bEnd, level);
      }
    }
    if (x != y) {
      return x < y ? -1 : 1;
    }
    if (x == 0) {
      return 0;
    }
  }
}

/**
 * -1, 0 or 1: the order of `a` and `b` in the collation of this module. What the two strings
 * start with alike weighs alike at every level, so the levels read only what follows. Out of
 * line, so that a caller such as a sort's comparator stays small.
 */
@noInline
export function localeOrder(a: string, b: string): i64 {
  const aEnd = strByteLen(a) as u64;
  const bEnd = strByteLen(b) as u64;
  const end = aEnd < bEnd ? aEnd : bEnd;
  let from: u64 = 0;
  while (from < end) {
    const c = strByteAt(a, from);
    if (c >= 0x80 || c != strByteAt(b, from)) {
      break;
    }
    from++;
  }
  if (from == aEnd && from == bEnd) {
    return 0;
  }
  const primary = orderAt(a, b, from, 0);
  if (primary != 0) {
    return primary;
  }
  const secondary = orderAt(a, b, from, 1);
  return secondary != 0 ? secondary : orderAt(a, b, from, 2);
}

extend string {
  /**
   * -1, 0 or 1: the order of `this` and `that` in the CLDR root collation, like
   * `new Intl.Collator("und").compare` ("a" < "A" < "b", "e" < "é" < "f"). Node's own
   * `localeCompare` follows the host's locale instead. Exact for strings made of U+0020..U+024F,
   * U+0370..U+04FF, U+1E00..U+1EFF, U+2000..U+206F and U+20A0..U+20CF (Latin with Vietnamese,
   * Greek, Cyrillic, general punctuation, currency signs), except a few characters that stand
   * for three or more (`¼`, `½`, `¾`, `ϗ`), and `…` and the primes `″ ‴ ⁗ ‶ ‷` (three `.`, two
   * to four `′` or `‵`) in strings that go on past them, which can order differently against
   * `‥`, `′`, `‵` and the like; approximate for everything else. No locale or options arguments.
   */
  localeCompare(that: string): i64 {
    return localeOrder(this, that);
  }
}
