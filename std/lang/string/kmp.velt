// velt/lang/string (internal): Knuth-Morris-Pratt, the linear fallback of a long needle whose
// candidates keep failing late (needle_scan.velt), forwards and backwards.

import { arrayWithCapacity, noInline, strByteAt } from "velt/lang/intrinsics";

/** Knuth-Morris-Pratt's table of `needle`'s `m` bytes, read forwards or (`back`) backwards:
 * entry `j` is the length of the longest proper prefix of the first `j + 1` bytes read that is
 * also their suffix. */
function kmpTable(needle: string, m: usize, back: bool): u32[] {
  const t: u32[] = arrayWithCapacity(m);
  t.push(0);
  let k: usize = 0;
  for (let j: usize = 1; j < m; j++) {
    const c = strByteAt(needle, (back ? m - 1 - j : j) as u64);
    while (k > 0 && strByteAt(needle, (back ? m - 1 - k : k) as u64) != c) {
      k = t[k - 1] as usize;
    }
    if (strByteAt(needle, (back ? m - 1 - k : k) as u64) == c) {
      k++;
    }
    t.push(k as u32);
  }
  return t;
}

/** The first match of `needle` (`m` bytes) in `s` that starts at `from` or later and ends by
 * `stop`, or -1: linear in `stop - from`. */
@noInline
export function findKmp(s: string, needle: string, m: usize, from: usize, stop: usize): i64 {
  const t = kmpTable(needle, m, false);
  let j: usize = 0;
  for (let i = from; i < stop; i++) {
    const c = strByteAt(s, i as u64);
    while (j > 0 && strByteAt(needle, j as u64) != c) {
      j = t[j - 1] as usize;
    }
    if (strByteAt(needle, j as u64) == c) {
      j++;
      if (j == m) {
        return (i + 1 - m) as i64;
      }
    }
  }
  return -1;
}

/** The last match of `needle` (`m` bytes) in `s` that starts before `top`, or -1: linear. */
@noInline
export function rfindKmp(s: string, needle: string, m: usize, top: usize): i64 {
  const t = kmpTable(needle, m, true);
  let j: usize = 0;
  // A match starting before `top` ends before `top + m - 1`; read from there down.
  let i = top + m - 1;
  while (i > 0) {
    i--;
    const c = strByteAt(s, i as u64);
    while (j > 0 && strByteAt(needle, (m - 1 - j) as u64) != c) {
      j = t[j - 1] as usize;
    }
    if (strByteAt(needle, (m - 1 - j) as u64) == c) {
      j++;
      if (j == m) {
        return i as i64;
      }
    }
  }
  return -1;
}
