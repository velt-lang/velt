// velt/lang/cpu (internal): white-box tests of how the CPU's answers become the feature word, run
// by `velt test std/`: a machine has one CPU, which cannot tell the bits apart.
import { describe, expect, it } from "velt/test";
import { x86Bits } from "velt/lang/cpu/detect_x86";
import { linuxArmBits } from "velt/lang/cpu/arm_linux_bits";
import { cpuDisabledBits, listOf, missingMessage, simdDisabledBits } from "velt/lang/cpu/check";

const OSXSAVE: u32 = 1 << 27;
const AVX_STATE: u64 = 6;
const AVX512_STATE: u64 = 0xe6;

describe("x86 detection", () => {
  it("reads leaf 1's ECX bits for the SSE family, POPCNT, PCLMULQDQ and AES", () => {
    expect(x86Bits(1 << 0, 0, 0, 0, 0)).toBe(1 << 0);
    expect(x86Bits(1 << 9, 0, 0, 0, 0)).toBe(1 << 1);
    expect(x86Bits(1 << 20, 0, 0, 0, 0)).toBe(1 << 3);
    expect(x86Bits(1 << 23, 0, 0, 0, 0)).toBe(1 << 4);
    expect(x86Bits(1 << 1, 0, 0, 0, 0)).toBe(1 << 22);
    expect(x86Bits(1 << 25, 0, 0, 0, 0)).toBe(1 << 23);
  });

  it("counts FMA and AVX only where the OS saves the AVX state", () => {
    const fma: u32 = (1 << 12) | (1 << 28);
    const both: u64 = (1 << 10) | (1 << 6);
    expect(x86Bits(fma | OSXSAVE, 0, 0, 0, AVX_STATE)).toBe(both);
    expect(x86Bits(fma, 0, 0, 0, AVX_STATE)).toBe(0);
    expect(x86Bits(fma | OSXSAVE, 0, 0, 0, 2)).toBe(0);
    expect(x86Bits(fma | OSXSAVE, 0, 0, 0, 4)).toBe(0);
  });

  it("reads leaf 7 for AVX2, BMI and SHA, and AVX-512 only with its state", () => {
    expect(x86Bits(OSXSAVE, 1 << 5, 0, 0, AVX_STATE)).toBe(1 << 7);
    expect(x86Bits(OSXSAVE, 1 << 5, 0, 0, 0)).toBe(0);
    expect(x86Bits(0, (1 << 3) | (1 << 8), 0, 0, 0)).toBe((1 << 8) | (1 << 9));
    expect(x86Bits(0, 1 << 29, 0, 0, 0)).toBe(1 << 21);
    expect(x86Bits(OSXSAVE, 1 << 16, 0, 0, AVX512_STATE)).toBe(1 << 14);
    expect(x86Bits(OSXSAVE, 1 << 16, 0, 0, AVX_STATE)).toBe(0);
    expect(x86Bits(OSXSAVE, 0, (1 << 1) | (1 << 12), 0, AVX512_STATE)).toBe((1 << 19) | (1 << 20));
  });

  it("reads LZCNT from the extended leaf", () => {
    expect(x86Bits(0, 0, 0, 1 << 5, 0)).toBe(1 << 11);
  });
});

describe("arm64 detection on Linux", () => {
  it("maps the capability words to the word's bits from 32", () => {
    const one: u64 = 1;
    expect(linuxArmBits(one << 20, 0)).toBe(one << 32);
    expect(linuxArmBits(one << 6, 0)).toBe(one << 33);
    expect(linuxArmBits(one << 4, 0)).toBe(one << 34);
    expect(linuxArmBits(one << 7, 0)).toBe(one << 35);
    expect(linuxArmBits(one << 17, 0)).toBe(0);
    expect(linuxArmBits((one << 17) | (one << 21), 0)).toBe(one << 36);
    expect(linuxArmBits(one << 9, 0)).toBe(0);
    expect(linuxArmBits((one << 9) | (one << 10), 0)).toBe(one << 37);
    expect(linuxArmBits(0, one << 13)).toBe(one << 38);
    expect(linuxArmBits(0, one << 14)).toBe(one << 39);
    expect(linuxArmBits(one << 3, 0)).toBe(one << 40);
  });
});

describe("the start-up check", () => {
  it("names the level and what is missing", () => {
    const v2: u64 = 0x3f;
    expect(missingMessage(v2, v2, false)).toBe("");
    expect(missingMessage(v2, v2 & ~(1 << 4), false)).toBe(
      "this program was built for x86-64-v2 (SSE3, SSSE3, SSE4.1, SSE4.2, POPCNT, CMPXCHG16B); this CPU lacks POPCNT; rebuild it with `--cpu baseline`",
    );
    expect(missingMessage(0x3fff, v2, false)).toBe(
      "this program was built for x86-64-v3 (SSE3, SSSE3, SSE4.1, SSE4.2, POPCNT, CMPXCHG16B, AVX, AVX2, BMI1, BMI2, FMA, LZCNT, MOVBE, F16C); this CPU lacks AVX, AVX2, BMI1, BMI2, FMA, LZCNT, MOVBE, F16C; rebuild it with `--cpu x86-64-v2`",
    );
    const one: u64 = 1;
    expect(missingMessage(one << 32, 0, true)).toBe(
      "this program was built for an arm64 CPU with DOTPROD; this CPU lacks DOTPROD; rebuild it with `--cpu baseline`",
    );
  });

  it("turns off what the variables name", () => {
    expect(cpuDisabledBits(listOf(" sse4.2 ,avx2"), false)).toBe((1 << 3) | (1 << 7));
    expect(cpuDisabledBits(listOf("dotprod"), true)).toBe((1 as u64) << 32);
    expect(cpuDisabledBits(listOf("sse4"), false)).toBe(0);
    expect(cpuDisabledBits(listOf("AVX512F"), false)).toBe(1 << 14);
    expect(simdDisabledBits(listOf("clmul"))).toBe(((1 as u64) << 22) | ((1 as u64) << 34));
    expect(simdDisabledBits(listOf("sha,aes"))).toBe(
      ((1 as u64) << 21) | ((1 as u64) << 33) | ((1 as u64) << 23) | ((1 as u64) << 40),
    );
    expect(simdDisabledBits(listOf("nothing"))).toBe(0);
    expect(simdDisabledBits(listOf(""))).toBe(0);
  });
});
