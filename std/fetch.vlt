// std/fetch: the WHATWG `fetch` API (docs/std/fetch.md), global like in Node: `fetch`,
// `Request`, `Response` and `Headers` need no import (std/prelude/global/fetch.vlt).
//
// `fetch` resolves once the response's status and headers have arrived; the body is received
// when it is read. Connections are pooled per origin (HTTP/1.1 keep-alive; HTTP/2 when an
// `https://` server offers it), redirects are followed as the Fetch standard says, and an
// `AbortSignal` cancels the request in the runtime: it is dropped, not just abandoned
// (crates/velt_rt/src/http/client).

import { IoError, IoResult, unwrapIo } from "velt:io";
import { AbortError, AbortSignal } from "velt:task";
import { URL } from "velt:url";
import { BodyParts, bodyParts } from "velt:fetch/body";
import { Headers } from "velt:fetch/headers";
import { normalizeMethod, Request, RequestInit, RequestRedirect } from "velt:fetch/request";
import { Response } from "velt:fetch/response";

export { BodyInit } from "velt:fetch/body";
export { Headers, HeadersInit } from "velt:fetch/headers";
export { Request, RequestInit, RequestRedirect } from "velt:fetch/request";
export { BodyStream, Response, ResponseInit } from "velt:fetch/response";

// The runtime takes `text` / `bytes` (moved: left empty) and copies the rest; `headers` is the
// flat list `[name, value, …]`.
declare async function velt_rt_http_fetch_send(
  method: string,
  url: string,
  headers: string[],
  kind: u32,
  text: string,
  bytes: u8[],
  redirect: u32,
  signal: u64,
  ca: string,
): Promise<IoResult<u64>>;

function redirectMode(r: RequestRedirect): u32 {
  if (r == "error") {
    return 1;
  }
  if (r == "manual") {
    return 2;
  }
  return 0;
}

// Sends a request. Rejects with `IoError` when there is no response (`ECONNREFUSED`,
// `ETIMEDOUT`, a TLS failure, an invalid URL or header: `EINVAL`), and with the signal's
// `AbortError` (`TimeoutError` for `AbortSignal.timeout`) when it is aborted. An HTTP error
// status is a response, not an error: check `res.ok`.
export async function fetch(
  input: string | URL | Request,
  init: RequestInit = {},
): Promise<Response, IoError | AbortError> {
  const o = outgoing(input, init);
  let text = o.body.text;
  let bytes = o.body.bytes;
  const signal = o.signal;
  const r = await velt_rt_http_fetch_send(
    o.method,
    o.url,
    o.headers,
    o.body.kind,
    text,
    bytes,
    redirectMode(o.redirect),
    signal == null ? 0 : signal.handle(),
    o.ca,
  );
  if (r.code != 0 && signal != null) {
    signal.throwIfAborted();
  }
  return Response.adopt(unwrapIo(r), signal, o.method == "HEAD");
}

// What `fetch` sends.
struct Outgoing {
  method: string;
  url: string;
  // `[name, value, …]`
  headers: string[];
  body: BodyParts;
  redirect: RequestRedirect;
  signal: AbortSignal | null;
  ca: string;
}

// What `fetch(input, init)` sends; throws the signal's `AbortError` if it is already aborted.
// For a URL, that is what `new Request(url, init)` would hold (the same checks and defaults),
// without making one.
function outgoing(
  input: string | URL | Request,
  init: RequestInit,
): Outgoing throws IoError | AbortError {
  let url = "";
  if (typeof input == "string") {
    url = input;
  } else if (input instanceof URL) {
    url = input.href;
  } else {
    const req = new Request(input, init);
    const signal = req.signal;
    if (signal != null) {
      signal.throwIfAborted();
    }
    return {
      body: req.parts(),
      method: req.method,
      url: req.url,
      headers: req.headers.raw(),
      redirect: req.redirect,
      signal: signal,
      ca: req.ca(),
    };
  }
  const m = init.method;
  const method = m == null ? "GET" : normalizeMethod(m);
  const body = bodyParts(init.body);
  if (body.kind != 0 && (method == "GET" || method == "HEAD")) {
    throw new IoError("EINVAL", "Request with GET/HEAD method cannot have body.");
  }
  let headers: string[] = [];
  const given = init.headers;
  const ct = body.contentType;
  if (given != null) {
    const h = new Headers(given);
    if (ct != null && !h.has("content-type")) {
      h.set("content-type", ct);
    }
    headers = h.raw();
  } else if (ct != null) {
    headers = ["content-type", ct];
  }
  const signal = init.signal;
  if (signal != null) {
    signal.throwIfAborted();
  }
  return {
    method: method,
    url: url,
    headers: headers,
    body: body,
    redirect: init.redirect ?? "follow",
    signal: signal,
    ca: init.ca ?? "",
  };
}
