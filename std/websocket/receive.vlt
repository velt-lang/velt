// std/websocket/receive (std-internal): receiving a message, the steps of a connection's
// `Reader` (std/websocket/reader) driven by the task that asked: it reads from the stream when
// the reader needs bytes, answers pings and the peer's close frame through the send queue, and
// fails the connection on a protocol error. Not part of the public API.

import { IoError } from "velt:io";
import { TcpStream } from "velt:net";
import { OP_CLOSE, OP_PONG, closePayload } from "velt:websocket/frame";
import { BINARY, CLOSE, CLOSED, FAIL, PING, READ, Rx, Step, WAIT } from "velt:websocket/reader";
import { Tx, closedHandle, settleQuietly } from "velt:websocket/writer";

/** Bytes read at a time. */
const READ_CHUNK: u64 = 16384;

// Held by the task that reads from the stream: if it is dropped before it handed over what it
// read, the next task may read.
class ReadTurn {
  rx: Rx | null;

  constructor(rx: Rx) {
    this.rx = rx;
  }

  done() {
    this.rx = null;
  }

  [Symbol.dispose]() {
    const rx = this.rx;
    if (rx != null) {
      rx.with((r) => r.abandon());
    }
  }
}

// Reads more bytes into the reader (the caller got `READ`).
async function fill(stream: TcpStream, rx: Rx): Promise<void> {
  const turn = new ReadTurn(rx.clone());
  const chunk = await stream.read(READ_CHUNK);
  turn.done();
  rx.with((r) => r.feed(chunk));
}

// Waits until the task that is reading from the stream is done.
async function turn(rx: Rx): Promise<void> {
  const reading = rx.with((r) => r.awaitTurn());
  if (reading != null) {
    await reading.receive();
  }
}

// What a step that is neither a message nor a wait asks for: a ping is answered, the peer's
// close frame is replied to (the connection is then closed: true), a protocol error fails the
// connection with its close code and throws.
function answer(stream: TcpStream, tx: Tx, step: Step): bool {
  if (step.kind == PING) {
    // A pong for a connection that is closing is not needed.
    const payload = step.data;
    settleQuietly(stream, tx, tx.with((q) => q.pushBytes(OP_PONG, payload)));
    return false;
  }
  if (step.kind != CLOSE && step.kind != FAIL) {
    throw closedHandle();
  }
  // Fails harmlessly if we closed first.
  const reply = closePayload(step.code);
  settleQuietly(stream, tx, tx.with((q) => q.pushBytes(OP_CLOSE, reply)));
  if (step.kind == FAIL) {
    throw new IoError("EILSEQ", `WebSocket protocol error: ${step.text}`);
  }
  return true;
}

/**
 * The next text or binary message (`TEXT`, `BINARY`), or `CLOSED` once the peer has closed the
 * connection, given `first`, what the reader's `next` said when the caller looked (callers
 * return a message that is already there themselves, so this runs only when there is something
 * to wait for or to answer). Pings are answered and the peer's close frame is replied to
 * through `tx`; a protocol error fails the connection (a close frame with the matching code)
 * and throws. What is rare is kept out of this function's own state: one is allocated per
 * waiting `receive`, so its size is memory per idle connection.
 */
export async function receive(stream: TcpStream, tx: Tx, rx: Rx, first: Step): Promise<Step> {
  let step = first;
  while (step.kind > BINARY) {
    if (step.kind == READ) {
      await fill(stream, rx);
    } else if (step.kind == WAIT) {
      const waiting = turn(rx);
      await waiting;
    } else if (answer(stream, tx, step)) {
      return new Step(CLOSED);
    }
    step = rx.with((r) => r.next(false));
  }
  return step;
}
