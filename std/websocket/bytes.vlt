// std/websocket/bytes (std-internal): the byte-level pieces of the WebSocket codec: masking
// keys, text in and out of buffers, the UTF-8 check of text that arrives in pieces
// (std/encoding/utf8), and `ByteBuf`, a byte array that grows by doubling. Public APIs only, as a
// package would write them. Not part of the public API.

import { randomBytes } from "velt:crypto";
import { validPrefix } from "velt:encoding/utf8";

/** A fresh masking key (RFC 6455 §5.3: from the OS random source), drawn on its own. */
export function maskKey(): u32 {
  return keyAt(randomBytes(4), 0);
}

// The key in the four bytes of `p` from `i` (most significant first).
function keyAt(p: u8[], i: usize): u32 {
  return ((p[i] as u32) << 24) |
    ((p[i + 1] as u32) << 16) |
    ((p[i + 2] as u32) << 8) |
    (p[i + 3] as u32);
}

/** Keys taken from one draw of the OS random source. */
const KEYS_PER_DRAW: usize = 64;

/**
 * Masking keys for a client connection (RFC 6455 §5.3, §10.3: unpredictable, from the OS random
 * source): drawn 64 at a time with `randomBytes`, so a frame costs no system call.
 */
export class MaskKeys {
  private pool: u8[] = [];
  private at: usize = 0;

  /** The next key. */
  next(): u32 {
    if (this.at == this.pool.length) {
      this.pool = randomBytes(KEYS_PER_DRAW * 4);
      this.at = 0;
    }
    const p = this.pool;
    const i = this.at;
    this.at = i + 4;
    return ((p[i] as u32) << 24) |
      ((p[i + 1] as u32) << 16) |
      ((p[i + 2] as u32) << 8) |
      (p[i + 3] as u32);
  }
}

/**
 * How many of the bytes in [start, end) are well-formed UTF-8: all of them, fewer when they end
 * inside a character (more bytes may complete it), or -1 when no continuation can make them
 * valid.
 */
export function utf8Prefix(b: u8[], start: i64, end: i64): i64 {
  return validPrefix(b, start as usize, end as usize);
}

/**
 * The bytes in [start, end) (relative positions, as `slice` takes them) as a string (one copy),
 * or null if they are not valid UTF-8.
 */
export function textOf(b: u8[], start: i64, end: i64): string | null {
  const from = relative(start, b.length);
  const to = relative(end, b.length);
  const len = to > from ? to - from : 0;
  if (validPrefix(b, from, from + len) != (len as i64)) {
    return null;
  }
  return b.utf8Slice(from as i64, (from + len) as i64);
}

// Position `i` in `n` bytes as JS reads it: negative counts from the end; clamped to `0..=n`.
function relative(i: i64, n: usize): usize {
  if (i < 0) {
    const fromEnd = (n as i64) + i;
    return fromEnd < 0 ? 0 : fromEnd as usize;
  }
  return (i as usize) < n ? i as usize : n;
}

/** Copies the UTF-8 bytes of `s` to `dst[offset..]` (they must fit). */
export function setText(dst: u8[], s: string, offset: i64) {
  if (dst.write(s, offset as usize) != Buffer.byteLength(s)) {
    panic("internal error: a WebSocket frame was sized wrong");
  }
}

/** Bytes that are appended to and taken whole: `data` holds them, with room for `cap`. */
export class ByteBuf {
  data: u8[] = [];
  cap: i64 = 0;

  /**
   * Makes the buffer `extra` bytes longer and returns where those bytes start. Private: the new
   * bytes hold whatever the memory held until the caller writes them.
   */
  private grow(extra: i64): i64 {
    const at = this.data.length as i64;
    const need = at + extra;
    if (need > this.cap) {
      let cap = this.cap * 2;
      if (cap < need) {
        cap = need;
      }
      if (cap < 256) {
        cap = 256;
      }
      const next: u8[] = __intrinsic_array_with_capacity(cap as usize);
      __intrinsic_array_set_len(next, at as usize);
      if (at > 0) {
        next.set(this.data, 0);
      }
      this.data = next;
      this.cap = cap;
    }
    __intrinsic_array_set_len(this.data, need as usize);
    return at;
  }

  append(src: u8[]) {
    const at = this.grow(src.length as i64);
    this.data.set(src, at as usize);
  }

  /** Drops the first `n` bytes (0 <= n <= length). */
  dropFront(n: i64) {
    const rest = (this.data.length as i64) - n;
    if (n < 0 || rest < 0) {
      panic(`ByteBuf.dropFront(${n}) on ${this.data.length} bytes`);
    }
    this.data.copyWithin(0, n);
    __intrinsic_array_set_len(this.data, rest as usize);
  }

  /** Replaces the contents with `bytes`. */
  adopt(bytes: u8[]) {
    this.cap = bytes.length as i64;
    this.data = bytes;
  }

  /** The contents, moved out; the buffer is empty and holds no memory afterwards. */
  take(): u8[] {
    const out = this.data;
    this.data = [];
    this.cap = 0;
    return out;
  }
}
