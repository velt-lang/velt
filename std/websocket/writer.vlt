// std/websocket/writer (std-internal): the flusher that writes a connection's `SendQueue`, and
// what a send or a close waits for. Not part of the public API.

import { IoError } from "velt:io";
import { TcpStream } from "velt:net";
import { timeout } from "velt:task";
import {
  SendQueue,
  HIGH_WATER,
  OVER,
  CLOSED,
  FAILED,
  RELEASED,
  STATUS,
  START,
} from "velt:websocket/queue";

export type Tx = shared<Mutex<SendQueue>>;

/**
 * How long a closing connection's flusher gets to write what is queued (a peer that stopped
 * reading must not keep the socket and its queue alive): 30 s, as the `ws` package.
 */
export const CLOSE_FLUSH_MS: i64 = 30000;

function quietShutdown(stream: TcpStream) {
  try {
    stream.shutdown();
  } catch (e) {
    return;
  }
}

/**
 * Writes what is queued, one write per batch, until nothing is: frames queued together (the
 * replies to messages that arrived together, a broadcast) cost one write. Started by whoever
 * queued into an idle connection (`START`). On a server-side connection the first write waits
 * for the upgrade. After the close frame, or a failed write, the socket is shut down and the
 * queue is stopped.
 */
export async function flush(stream: TcpStream, tx: Tx): Promise<void> {
  while (true) {
    const batch = tx.with((q) => q.take());
    if (batch == null) {
      quietShutdown(stream);
      tx.with((q) => q.stop("EPIPE"));
      return;
    }
    if (batch.length == 0) {
      return;
    }
    try {
      await stream.writeBytes(batch);
    } catch (e) {
      quietShutdown(stream);
      tx.with((q) => q.stop(e.code));
      return;
    }
  }
}

export function closedHandle(): IoError {
  return new IoError("EBADF", "handle is closed");
}

// Why a frame was not queued.
function refused(tx: Tx, status: i64): IoError {
  if (status == RELEASED) {
    return closedHandle();
  }
  if (status == CLOSED) {
    return new IoError("EPIPE", "the WebSocket is closed");
  }
  return new IoError(tx.with((q) => q.stopped), "the WebSocket connection failed");
}

// Waits until at most `HIGH_WATER` bytes are queued.
async function room(tx: Tx): Promise<void> {
  while (true) {
    const status = tx.with((q) => {
      if (q.released) {
        return RELEASED;
      }
      if (q.stopped != "") {
        return q.stopped == "EPIPE" ? CLOSED : FAILED;
      }
      return (q.out.data.length as i64) > HIGH_WATER ? OVER : 0;
    });
    if (status == 0) {
      return;
    }
    if (status != OVER) {
      throw refused(tx, status);
    }
    const drained = tx.with((q) => (q.out.data.length as i64) > HIGH_WATER ? q.wait() : null);
    if (drained != null) {
      await drained.receive();
    }
  }
}

/**
 * Finishes a send whose frame got `r` from the queue: starts the flusher if the connection was
 * idle, waits for room past the high-water mark, throws if the frame was not queued.
 */
export async function settle(stream: TcpStream, tx: Tx, r: i64): Promise<void> {
  if ((r & START) != 0) {
    spawn(flush(stream, tx.clone()));
  }
  const status = r & STATUS;
  if (status == OVER) {
    await room(tx);
  } else if (status != 0) {
    throw refused(tx, status);
  }
}

/** `settle` for frames the connection sends by itself (pongs, close replies): never throws. */
export function settleQuietly(stream: TcpStream, tx: Tx, r: i64) {
  if ((r & START) != 0) {
    spawn(flush(stream, tx.clone()));
  }
}

async function untilStopped(tx: Tx): Promise<void> {
  while (true) {
    const drained = tx.with((q) => q.stopped != "" || q.released ? null : q.wait());
    if (drained == null) {
      return;
    }
    await drained.receive();
  }
}

/**
 * Waits until the flusher has written the close frame (queued by the caller, or earlier) and
 * stopped; a peer that does not take it within `flushMs` is cut off.
 */
export async function finish(stream: TcpStream, tx: Tx, flushMs: i64): Promise<void> {
  if (tx.with((q) => q.stopped != "")) {
    return;
  }
  try {
    await timeout(untilStopped(tx.clone()), flushMs);
  } catch (e) {
    stream.abort();
    await untilStopped(tx);
  }
}
