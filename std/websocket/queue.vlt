// std/websocket/queue (std-internal): the sending side of a connection. Not part of the public
// API.
//
// A send encodes its frame into the connection's `SendQueue` at the call, under the queue's
// lock, so frames go out in call order from any task, also before a server-side upgrade has
// completed. Whoever queues into an idle connection starts its flusher (std/websocket/writer),
// which writes everything queued in one write; an idle connection has no task and no buffer.

import { Channel, channel } from "velt:channel";
import { MaskKeys, setText } from "velt:websocket/bytes";
import { OP_CLOSE, OP_PONG, headSize, writeHead } from "velt:websocket/frame";
import { BINARY, Reader, Step, TEXT } from "velt:websocket/reader";

/** Queued bytes past which a `send` completes only once the flusher has caught up. */
export const HIGH_WATER: i64 = 1048576;
/** Queued bytes past which a subscriber misses published messages. */
export const PUBLISH_LIMIT: i64 = 16777216;

// What queueing a frame gives (`& STATUS`), plus `START` when the caller must start the flusher.
/** Queued. */
export const QUEUED: i64 = 0;
/** Queued, and more than `HIGH_WATER` bytes are waiting. */
export const OVER: i64 = 1;
/** Not queued: a close frame is queued or was sent. */
export const CLOSED: i64 = 2;
/** Not queued: a write failed (`failure` has the error code). */
export const FAILED: i64 = 3;
/** Not queued: the handle was released. */
export const RELEASED: i64 = 4;
export const STATUS: i64 = 7;
/** The connection was idle: the caller starts its flusher. */
export const START: i64 = 8;
/**
 * The connection was idle and its reading task has a message in hand with no more input
 * waiting, so this is most likely its reply in a request/reply exchange: the caller writes the
 * queue to the socket itself (`writeDirect`), since there is nothing a flusher could batch it
 * with. (A frame another task sends in that moment is written at once too; only batching is
 * lost.)
 */
export const DIRECT: i64 = 16;

export class SendQueue {
  /**
   * The encoded frames waiting to be written, and the room `out` has (kept here, not in a
   * `ByteBuf` of its own: a send from another thread touches one object less).
   */
  out: u8[] = [];
  cap: i64 = 0;
  /** A client masks what it sends, with keys from `keys` (made on its first frame). */
  client: bool;
  keys: MaskKeys | null = null;
  /** A close frame is queued: nothing may follow it, and the flusher shuts down after it. */
  closing: bool = false;
  /** Why the flusher stopped for good ("": it has not): "EPIPE" after closing, else a failed write's code. */
  stopped: string = "";
  /** `close()` released the handle. */
  released: bool = false;
  /** A flusher is running (or about to). */
  flushing: bool = false;
  /** Tasks waiting on `drained`, which exists once one did. */
  waiters: i64 = 0;
  /**
   * Bytes of pongs in `out` (none once the flusher takes it): past `HIGH_WATER` of them, a peer
   * that sends pings and reads nothing is not read from until it takes them.
   */
  pongs: i64 = 0;
  drained: Channel<bool> | null = null;
  /** The topics this connection is subscribed to (std/websocket/topics). */
  topics: string[] = [];
  /**
   * The connection's receiving side, under the same lock as the queue: a message costs fewer
   * lock round trips, and a `WebSocket` is one shared value. (A frame is unmasked and copied
   * out under the lock, so a very large incoming message holds up sends to its connection for
   * as long as that takes.)
   */
  rx: Reader;
  /**
   * The task that reads this connection has a message in hand and no more input waiting: what
   * is sent now is most likely its reply (set and cleared by the reader's steps below).
   */
  replying: bool = false;

  constructor(client: bool, rx: Reader) {
    this.client = client;
    this.rx = rx;
  }

  // Why nothing more can be queued, or -1.
  private refusal(): i64 {
    if (this.released) {
      return RELEASED;
    }
    if (this.stopped != "") {
      return this.stopped == "EPIPE" ? CLOSED : FAILED;
    }
    return this.closing ? CLOSED : -1;
  }

  // `first`: nothing was queued before this frame.
  private queued(first: bool): i64 {
    const r = (this.out.length as i64) > HIGH_WATER ? OVER : QUEUED;
    if (this.flushing) {
      return r;
    }
    this.flushing = true;
    if (first && this.replying) {
      return r | DIRECT;
    }
    return r | START;
  }

  /** The reader's next step (`first`: the first step of a `receive`). */
  next(first: bool): Step {
    const step = this.rx.next(first);
    this.replying = (step.kind == TEXT || step.kind == BINARY) && this.rx.drained();
    return step;
  }

  /** What the reading task read (nothing: the stream ended), and the reader's next step. */
  fed(chunk: u8[]): Step {
    this.rx.feed(chunk);
    return this.next(false);
  }

  /**
   * After the caller wrote a `DIRECT` batch: whether a flusher must be started (more was queued
   * meanwhile, or that was the close frame); else the connection is idle again.
   */
  directDone(): bool {
    if (this.out.length == 0 && !this.closing) {
      this.flushing = false;
      return false;
    }
    return true;
  }

  // Makes `out` `extra` bytes longer and returns where those bytes start.
  private grow(extra: i64): i64 {
    const at = this.out.length as i64;
    const need = at + extra;
    if (need > this.cap) {
      let cap = this.cap * 2;
      if (cap < need) {
        cap = need;
      }
      if (cap < 256) {
        cap = 256;
      }
      const next: u8[] = __intrinsic_array_with_capacity(cap as usize);
      __intrinsic_array_set_len(next, at as usize);
      if (at > 0) {
        next.set(this.out, 0);
      }
      this.out = next;
      this.cap = cap;
    }
    __intrinsic_array_set_len(this.out, need as usize);
    return at;
  }

  private takeOut(): u8[] {
    const out = this.out;
    this.out = [];
    this.cap = 0;
    this.pongs = 0;
    return out;
  }

  // Room for a frame with `len` payload bytes, its header written; where the payload goes.
  private frame(op: i64, len: i64, mask: u32): i64 {
    const at = this.grow(headSize(len, this.client) + len);
    return writeHead(this.out, at, op, len, this.client, mask);
  }

  /** Queues a text frame. */
  pushText(op: i64, text: string): i64 {
    const no = this.refusal();
    if (no >= 0) {
      return no;
    }
    const first = this.out.length == 0;
    const len = Buffer.byteLength(text) as i64;
    const mask = this.client ? this.maskKey() : 0u32;
    const p = this.frame(op, len, mask);
    setText(this.out, text, p);
    if (this.client) {
      this.out.xorMask(mask, p, p + len);
    }
    return this.queued(first);
  }

  // A client's next masking key.
  private maskKey(): u32 {
    if (this.keys == null) {
      this.keys = new MaskKeys();
    }
    return this.keys!.next();
  }

  /** Queues the answer to a ping (`pushBytes`); counted in `pongs` if it was queued. */
  pushPong(payload: u8[]): i64 {
    const r = this.pushBytes(OP_PONG, payload);
    const status = r & STATUS;
    if (status == QUEUED || status == OVER) {
      const len = payload.length as i64;
      this.pongs += headSize(len, this.client) + len;
    }
    return r;
  }

  /** Queues a frame carrying `payload`; a close frame is the last one. */

  pushBytes(op: i64, payload: u8[]): i64 {
    const no = this.refusal();
    if (no >= 0) {
      return no;
    }
    const first = this.out.length == 0;
    const len = payload.length as i64;
    const mask = this.client ? this.maskKey() : 0u32;
    const p = this.frame(op, len, mask);
    this.out.set(payload, p as usize);
    if (this.client) {
      this.out.xorMask(mask, p, p + len);
    }
    if (op == OP_CLOSE) {
      this.closing = true;
    }
    return this.queued(first);
  }

  /**
   * Queues a published frame (`frame`: whole and unmasked, its payload from `payloadAt`) unless
   * the connection is closing, stopped or has more than `PUBLISH_LIMIT` bytes waiting: `QUEUED`
   * (with `START`, never `DIRECT`: a publish is no reply, and `publish` starts flushers only),
   * or -1. A client masks every frame with a key of its own.
   */
  appendFrame(frame: u8[], payloadAt: i64): i64 {
    if (this.refusal() >= 0 || (this.out.length as i64) > PUBLISH_LIMIT) {
      return -1;
    }
    if (this.client) {
      const r = this.pushBytes((frame[0] as i64) & 0x0f, frame.slice(payloadAt));
      return (r & DIRECT) != 0 ? (r & ~(DIRECT | OVER)) | START : r & ~OVER;
    }
    const at = this.grow(frame.length as i64);
    this.out.set(frame, at as usize);
    return this.queued(false) & ~OVER;
  }

  /**
   * Everything queued, for the flusher to write (the tasks waiting for room are woken). Empty:
   * nothing is queued and the flusher ends. Null: the close frame was written, so the flusher
   * shuts the socket down and stops the queue.
   */
  take(): u8[] | null {
    if (this.out.length == 0) {
      if (this.closing) {
        return null;
      }
      this.flushing = false;
      return [];
    }
    this.wake();
    return this.takeOut();
  }

  /** The flusher stopped for good; what is queued will never go out. */
  stop(code: string) {
    if (this.stopped == "") {
      this.stopped = code;
    }
    this.flushing = false;
    this.takeOut();
    this.wake();
  }

  /** The channel that gets a value when the flusher takes the queue or stops (wait on it once). */
  wait(): Channel<bool> {
    this.waiters++;
    const ch = this.drained ?? channel<bool>();
    this.drained = ch;
    return ch;
  }

  private wake() {
    const ch = this.drained;
    if (ch != null) {
      for (let i: i64 = 0; i < this.waiters; i++) {
        ch.trySend(true);
      }
    }
    this.waiters = 0;
  }

  /** `close()` is done with the connection: its topics, to leave. */
  release(): string[] {
    this.released = true;
    this.wake();
    const ch = this.drained;
    if (ch != null) {
      ch.close();
      while (ch.tryReceive() != null) {}
      this.drained = null;
    }
    this.rx.release();
    const topics = this.topics;
    this.topics = [];
    return topics;
  }
}
