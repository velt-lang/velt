// std/websocket/topics (std-internal): publish/subscribe. Not part of the public API.
//
// A publish encodes the frame once and appends the same bytes to every subscriber's queue, so a
// message to many sockets costs one encode and one queue append per socket. An idle
// subscriber's queue is then written from the publishing task (`writeDirect`): a socket nearly
// always takes a frame at once, and a task per subscriber would cost more than the write (on
// several threads each one wakes another worker). Only a socket that does not take it all gets
// a flusher. A subscriber with more than `PUBLISH_LIMIT` bytes
// already queued is skipped for that message, so one slow reader cannot grow the server's
// memory without bound (a direct `send` waits instead). Topics are process-wide (one registry,
// a runtime slot, rt_abi_async.md §2.2); a connection leaves all of them when it is closed.
//
// Locks, always in this order: the registry, a topic, a connection's queue.

import { Channel } from "velt:channel";
import { TcpStream } from "velt:net";
import { START } from "velt:websocket/queue";
import { Tx, writeDirect } from "velt:websocket/writer";

class Sub {
  /** The connection's stream, which the publishing task may write to. */
  stream: TcpStream;
  /** The connection's queue: also what tells connections apart (`===`). */
  tx: Tx;

  constructor(stream: TcpStream, tx: Tx) {
    this.stream = stream;
    this.tx = tx;
  }
}

class Topic {
  subs: Sub[] = [];

  // Adds the connection (again is a no-op).
  join(stream: TcpStream, tx: Tx) {
    for (let i = 0; i < this.subs.length; i++) {
      if (this.subs[i].tx === tx) {
        return;
      }
    }
    this.subs.push(new Sub(stream, tx));
  }

  // Removes the connection; whether the topic is empty now.
  leave(tx: Tx): bool {
    for (let i = 0; i < this.subs.length; i++) {
      if (this.subs[i].tx === tx) {
        __intrinsic_array_remove(this.subs, i);
        break;
      }
    }
    return this.subs.length == 0;
  }
}

type TopicRef = shared<Mutex<Topic>>;
type Registry = Mutex<Map<string, TopicRef>>;

declare function velt_rt_global_lock(slot: u32);
declare function velt_rt_global_unlock(slot: u32);
declare function velt_rt_global_chan(slot: u32): u64;

// The topics' runtime slot (rt_abi_async.md §2.2). The slot is read only here, with its one
// type: a generic accessor would let any importer read it as another type.
const SLOT: u32 = 0;

// The process's registry, made on first use: taken out of the slot and a reference put back.
function registry(): shared<Registry> {
  velt_rt_global_lock(SLOT);
  const ch: Channel<shared<Registry>> = Channel { handle: velt_rt_global_chan(SLOT) };
  const found = ch.tryReceive();
  const value =
    found == null ? shared(new Mutex<Map<string, TopicRef>>(new Map<string, TopicRef>())) : found;
  ch.trySend(value.clone());
  velt_rt_global_unlock(SLOT);
  return value;
}

/** Subscribes the connection (`stream`, queue `tx`) to `topic`; false if its handle was released. */
export function subscribe(stream: TcpStream, tx: Tx, topic: string): bool {
  const open = tx.with((q) => {
    if (q.released) {
      return false;
    }
    if (!q.topics.includes(topic)) {
      q.topics.push(topic);
    }
    return true;
  });
  if (!open) {
    return false;
  }
  // The registry stays locked while joining: a `leave` that empties the topic removes it under
  // the same lock, so it cannot remove the list this connection is joining.
  registry().with((all) => {
    const found = all.get(topic);
    if (found != null) {
      found.with((t) => t.join(stream, tx.clone()));
      return;
    }
    const made = shared(new Mutex<Topic>(new Topic()));
    made.with((t) => t.join(stream, tx.clone()));
    all.set(topic, made);
  });
  // Closed meanwhile: `close()` may have left the topics before this joined.
  if (tx.with((q) => q.released)) {
    leave(tx, topic);
    return false;
  }
  return true;
}

/** Removes the connection with queue `tx` from `topic`; an emptied topic goes away. */
export function leave(tx: Tx, topic: string) {
  const all = registry();
  const t = all.with((m) => m.get(topic));
  if (t == null) {
    return;
  }
  if (!t.with((s) => s.leave(tx))) {
    return;
  }
  // Someone may have subscribed in between: only remove the topic if it is still empty.
  all.with((m) => {
    const now = m.get(topic);
    if (now != null && now.with((s) => s.subs.length == 0)) {
      m.delete(topic);
    }
  });
}

/** `leave`, also taking `topic` off the connection's own list. */
export function unsubscribe(tx: Tx, topic: string) {
  tx.with((q) => {
    const at = q.topics.indexOf(topic);
    if (at >= 0) {
      __intrinsic_array_remove(q.topics, at as usize);
    }
  });
  leave(tx, topic);
}

/**
 * Queues `frame` (a whole unmasked frame whose payload starts at `payloadAt`) for every
 * subscriber of `topic` except the connection with queue `except` (null: none); the number of
 * connections.
 */
export function publish(topic: string, frame: u8[], payloadAt: i64, except: Tx | null): i64 {
  const t = registry().with((m) => m.get(topic));
  if (t == null) {
    return 0;
  }
  // The idle connections it was queued for: written outside the locks.
  const streams: TcpStream[] = [];
  const queues: Tx[] = [];
  const sent = t.with((s) => {
    let n: i64 = 0;
    for (let i = 0; i < s.subs.length; i++) {
      const sub = s.subs[i];
      if (except != null && sub.tx === except) {
        continue;
      }
      const r = sub.tx.with((q) => q.appendFrame(frame, payloadAt));
      if (r < 0) {
        continue;
      }
      n++;
      if ((r & START) != 0) {
        streams.push(sub.stream);
        queues.push(sub.tx.clone());
      }
    }
    return n;
  });
  for (let i = 0; i < streams.length; i++) {
    writeDirect(streams[i], queues[i]);
  }
  return sent;
}
