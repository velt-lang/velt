// velt/ffi (internal): Windows' wide strings (UTF-16, NUL-terminated, `WCHAR *`), which the
// Win32 `…W` functions read and write: the text of a buffer of them, and a string as one. Only
// the prelude's string functions: the environment's variables are read through here, on the
// executor's path, which must not bring velt/encoding's error classes in.

/**
 * The text of the UTF-16 in `units`, up to its first NUL (or its end); a lone surrogate reads as
 * U+FFFD.
 */
export function wideText(units: u16[]): string {
  let s = "";
  const n = units.length;
  let i: usize = 0;
  while (i < n) {
    const u = units[i] as u32;
    if (u === 0) {
      break;
    }
    i++;
    if (u >= 0xd800 && u < 0xdc00 && i < n) {
      const low = units[i] as u32;
      if (low >= 0xdc00 && low < 0xe000) {
        i++;
        // The pair's halves join into one character.
        s += String.fromCharCode(u as f64, low as f64);
        continue;
      }
    }
    s += String.fromCharCode((u >= 0xd800 && u < 0xe000 ? 0xfffd : u) as f64);
  }
  return s;
}

/**
 * `s` as a NUL-terminated wide string, its UTF-16 code units as JavaScript counts them (a lone
 * surrogate stays one); null when `s` holds a NUL, which would end the string where Win32 reads it.
 */
export function wideOf(s: string): u16[] | null {
  const units: u16[] = [];
  const n = s.length as i64;
  for (let i: i64 = 0; i < n; i++) {
    const u = s.charCodeAt(i);
    if (u === 0) {
      return null;
    }
    units.push(u as u16);
  }
  units.push(0);
  return units;
}
