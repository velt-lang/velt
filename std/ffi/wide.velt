// velt/ffi (internal): Windows' wide strings (UTF-16, NUL-terminated, `WCHAR *`), which the
// Win32 `…W` functions read and write: the text of a buffer of them.

import { utf8DecodeLossy } from "velt/encoding/utf8";

/** Appends code point `c`'s UTF-8 to `out`. */
function pushUtf8(out: u8[], c: u32) {
  if (c < 0x80) {
    out.push(c as u8);
  } else if (c < 0x800) {
    out.push((0xc0 | (c >> 6)) as u8);
    out.push((0x80 | (c & 0x3f)) as u8);
  } else if (c < 0x10000) {
    out.push((0xe0 | (c >> 12)) as u8);
    out.push((0x80 | ((c >> 6) & 0x3f)) as u8);
    out.push((0x80 | (c & 0x3f)) as u8);
  } else {
    out.push((0xf0 | (c >> 18)) as u8);
    out.push((0x80 | ((c >> 12) & 0x3f)) as u8);
    out.push((0x80 | ((c >> 6) & 0x3f)) as u8);
    out.push((0x80 | (c & 0x3f)) as u8);
  }
}

/**
 * The text of the UTF-16 in `units`, up to its first NUL (or its end); a lone surrogate reads as
 * U+FFFD.
 */
export function wideText(units: u16[]): string {
  const out: u8[] = [];
  const n = units.length;
  let i: usize = 0;
  while (i < n) {
    const u = units[i] as u32;
    if (u === 0) {
      break;
    }
    i++;
    if (u >= 0xd800 && u < 0xdc00 && i < n) {
      const low = units[i] as u32;
      if (low >= 0xdc00 && low < 0xe000) {
        i++;
        pushUtf8(out, 0x10000 + ((u - 0xd800) << 10) + (low - 0xdc00));
        continue;
      }
    }
    pushUtf8(out, u >= 0xd800 && u < 0xe000 ? 0xfffd : u);
  }
  return utf8DecodeLossy(out);
}
