// velt/ffi (internal): where the calling thread's `errno` is with the Universal CRT:
// `_errno()` (`#errno-location`, errno.velt).

import { Ptr } from "velt/ffi/ptr";

declare c("c") function _errno(): Ptr<i32>;

/** The address of the calling thread's `errno`. */
export function errnoLocation(): Ptr<i32> | null {
  // SAFETY: `_errno` takes nothing and returns the address of this thread's `errno`.
  return unsafe { _errno() };
}
