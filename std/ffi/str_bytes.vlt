// velt/ffi (internal): `StrBytes`, a string a C function takes as its UTF-8 bytes, and the
// function lowering calls for each such argument (crates/velt_vir/src/lower/c_call.rs).

import { strByteLen } from "velt/lang/intrinsics";

declare function velt_rt_str_is_well_formed(s: string): bool;

/**
 * A `string` passed to a C function as its UTF-8 bytes, borrowed for the call and without a
 * NUL: the declaration of a parameter says so (`text: StrBytes`), and the binding passes the
 * length (`byteLength(s)`). A string holding a lone surrogate passes a copy with U+FFFD for it,
 * which has the same byte length.
 */
export type StrBytes = string;

/**
 * The number of UTF-8 bytes a `StrBytes` argument passes for `s`: what C's length parameter
 * takes next to it. O(1).
 */
export function byteLength(s: string): usize {
  return strByteLen(s);
}

/**
 * The string whose bytes a `StrBytes` argument passes: `s` itself when it is well-formed, as
 * nearly every string is (an O(1) check for ASCII), else a copy with U+FFFD for each lone
 * surrogate (std only: lowering calls it).
 */
export function strBytesOf(s: string): string {
  if (velt_rt_str_is_well_formed(s)) {
    return s;
  }
  let out = "";
  const n = s.length as i64;
  let i: i64 = 0;
  while (i < n) {
    const c = s.charCodeAt(i);
    const next = i + 1 < n ? s.charCodeAt(i + 1) : 0;
    if (c >= 0xd800 && c <= 0xdbff && next >= 0xdc00 && next <= 0xdfff) {
      out += s.slice(i, i + 2);
      i += 2;
    } else {
      out += c >= 0xd800 && c <= 0xdfff ? "\u{fffd}" : s.slice(i, i + 1);
      i += 1;
    }
  }
  return out;
}
