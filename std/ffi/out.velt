// velt/ffi (internal): `Out<T>`, a value a C function writes through a pointer (`int *out`,
// `sqlite3 **db`): the C function gets the address of its `value`.

/**
 * A value a C function writes through a pointer parameter declared `Out<T>`: a number or `bool`
 * (`int *out`, `size_t *len`), or a pointer that may be `NULL` (`Out<Ptr<sqlite3> | null>` for
 * `sqlite3 **db`). C gets the address of `value`, and `value` holds what it wrote once the call
 * returned.
 */
export class Out<T> {
  value: T;

  constructor(value: T) {
    this.value = value;
  }
}
