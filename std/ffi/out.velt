// velt/ffi (internal): `Out<T>`, a value a C function writes through a pointer (`int *out`,
// `sqlite3 **db`, `struct stat *st`): the C function gets the address of its value.

import { INSPECT } from "velt/lang/hooks/keys";
import { cArrived } from "velt/lang/intrinsics/address";

/**
 * A value a C function writes through a pointer parameter declared `Out<T>`: a number or `bool`
 * (`int *out`, `size_t *len`), a pointer that may be `NULL` (`Out<Ptr<sqlite3> | null>` for
 * `sqlite3 **db`), or a C struct (`Out<Stat>` for `struct stat *st`). C gets the address of the
 * value, and `value` holds what it wrote once the call returned.
 *
 * A C struct's fields declared `Ptr<T>` are checked where `value` is read, not when C returns: a
 * C function that fails often leaves its out-struct untouched, and a caller that tests the result
 * first never reads it. One that C left `NULL` stops the program, naming the field; declare the
 * fields C may leave `NULL` as `Ptr<T> | null`. A `bool` C wrote is its byte's truth, 0 or not.
 *
 * `value` is an accessor, so `console.log` shows `Out { value: … }` and `JSON.stringify` writes
 * `{"value":…}` (both read it, checked); a spread (`{ ...out }`) copies no accessor, as in JS.
 */
export class Out<T> {
  // What C writes: the call passes its address (velt_vir `c_call.rs`).
  private held: T;

  constructor(value: T) {
    this.held = value;
  }

  get value(): T {
    return cArrived(this.held);
  }

  set value(value: T) {
    this.held = value;
  }

  /** How `console.log` shows it: `Out { value: 3 }`, `value` read (and checked). */
  [INSPECT]() {
    return { value: this.value };
  }

  /** How `JSON.stringify` writes it: `{"value":3}`. */
  toJSON(): { value: T } {
    return { value: this.value };
  }
}
