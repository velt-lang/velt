// velt/ffi (tests): white-box tests, run by `velt test std/`.
//
// What lowering calls for C functions' pointers and strings, and std's own C declarations of
// the C library through them (std may declare C functions).
import { describe, expect, it } from "velt/test";
import {
  CString,
  Out,
  Ptr,
  StrBytes,
  byteLength,
  readBytes,
  readCString,
  readUtf8,
} from "velt/ffi";
import { ptrAddress, ptrAddressOrZero, ptrOf, ptrOrNull } from "velt/ffi/ptr";
import { strBytesOf } from "velt/ffi/str_bytes";
import * as ffi from "velt/ffi";
import { StrBytes as Text } from "velt/ffi";

declare c type FILE;

declare c("c") function memcmp(a: StrBytes, b: StrBytes, n: usize): i32;
// The same C function through a namespace and a renamed import of `StrBytes`.
declare c("c") function memcmp$ns(a: ffi.StrBytes, b: Text, n: usize): i32;
declare c("c") function malloc(n: usize): Ptr<u8> | null;
declare c("c") function free(p: Ptr<u8> | null): void;
declare c("c") function memcpy(dst: Ptr<u8>, src: CString, n: usize): Ptr<u8>;
declare c("c") function memset(p: Ptr<u8>, c: i32, n: usize): Ptr<u8>;
declare c("c") function frexp(x: f64, exp: Out<i32>): f64;

describe("velt/ffi pointers", () => {
  it("a pointer holds its address, and NULL is null", () => {
    expect(ptrAddress(ptrOf<FILE>(48))).toBe(48);
    expect(ptrOrNull<FILE>(0) === null).toBe(true);
    expect(ptrAddressOrZero<FILE>(null)).toBe(0);
    expect(ptrAddressOrZero(ptrOrNull<FILE>(64))).toBe(64);
  });

  it("a C function returns one and takes it back", () => {
    // SAFETY: malloc returns memory or NULL, freed once.
    const p = unsafe { malloc(32) };
    expect(p !== null).toBe(true);
    // SAFETY: `p` came from malloc (or is NULL, which free ignores).
    unsafe {
      free(p);
    }
  });
});

describe("velt/ffi strings", () => {
  it("byteLength counts UTF-8 bytes", () => {
    expect(byteLength("abc")).toBe(3);
    expect(byteLength("héllo")).toBe(6);
    expect(byteLength("")).toBe(0);
  });

  it("a well-formed string passes its own bytes; a lone surrogate passes U+FFFD", () => {
    expect(strBytesOf("héllo")).toBe("héllo");
    const lone = "a" + String.fromCharCode(0xd800) + "b";
    expect(strBytesOf(lone)).toBe("a\u{fffd}b");
    expect(byteLength(strBytesOf(lone))).toBe(byteLength(lone));
    // SAFETY: both strings have `byteLength` bytes.
    expect(unsafe { memcmp(lone, "a\u{fffd}b", byteLength(lone)) }).toBe(0);
    // SAFETY: both strings have 3 bytes.
    expect(unsafe { memcmp$ns("abc", "abd", 3) } < 0).toBe(true);
  });
});

describe("velt/ffi C strings and reads", () => {
  it("a CString crosses NUL-terminated and reads back", () => {
    const c = new CString("héllo");
    expect(c.toString()).toBe("héllo");
    // SAFETY: malloc returns 7 bytes or NULL, which the copy fills (the 6 bytes and the NUL;
    // `strdup` is `_strdup` on Windows); freed once.
    const p = unsafe { malloc(7) };
    expect(p !== null).toBe(true);
    if (p !== null) {
      // SAFETY: `p` has 7 bytes, `c` 6 and its NUL.
      unsafe {
        memcpy(p, c, 7);
      }
      // SAFETY: `p` holds the copy, NUL-terminated.
      expect(unsafe { readCString(p) }).toBe("héllo");
      // SAFETY: the copy has 7 bytes.
      expect(unsafe { readBytes(p, 3) }.join(",")).toBe("104,195,169");
      // SAFETY: `p` came from malloc and is freed once.
      unsafe {
        free(p);
      }
    }
  });

  it("reads text and bytes of any length, an invalid sequence as U+FFFD", () => {
    const n: usize = 1000;
    // SAFETY: malloc returns `n` bytes or NULL; they are written before they are read, and freed
    // once.
    const p = unsafe { malloc(n) };
    expect(p !== null).toBe(true);
    if (p !== null) {
      const text = "é".repeat(500);
      const c = new CString(text);
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      unsafe {
        memcpy(p, c, n);
      }
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      expect(unsafe { readUtf8(p, n) }).toBe(text);
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      const bytes = unsafe { readBytes(p, n) };
      expect(bytes.length).toBe(n);
      expect(bytes[n - 1]).toBe(169);
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      expect(unsafe { readBytes(p, 0) }.length).toBe(0);
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      expect(unsafe { readUtf8(p, 0) }).toBe("");
      // The second byte of "é" on its own is no UTF-8.
      const bad = new CString("ab");
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      unsafe {
        memcpy(p, bad, 2);
        memset(p, 0xff, 1);
      }
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      expect(unsafe { readUtf8(p, 2) }).toBe("\u{fffd}b");
      // SAFETY: `p` holds `n` bytes from `malloc`, written above, and is freed once, at the end.
      unsafe {
        free(p);
      }
    }
  });

  it("an Out<T> holds what C wrote", () => {
    const e = new Out<i32>(0);
    // SAFETY: frexp writes the exponent.
    expect(unsafe { frexp(10, e) }).toBe(0.625);
    expect(e.value).toBe(4);
  });
});
