// velt/ffi (internal): `Ref<S>`, a C struct a C function reads through a `const S *`: the call
// passes the address of a copy, borrowed for the call (crates/velt_vir/src/lower/c_call.rs).

/**
 * A C struct a C function reads through a pointer parameter (`const S *`): the declaration of a
 * parameter says so (`r: Ref<Rect>`), and the call passes the struct itself (`drawRect(r)`).
 * The call copies it, and C gets the copy's address, borrowed for the call: C must not keep the
 * pointer, and what C does to the copy never reaches the caller's value. `Ref<S> | null` is a
 * `const S *` that may be `NULL`: the call passes the struct or `null`.
 */
export type Ref<S> = S;
