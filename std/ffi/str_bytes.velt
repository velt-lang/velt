// velt/ffi (internal): `StrBytes`, a string a C function takes as its UTF-8 bytes, and the
// function lowering calls for each such argument (crates/velt_vir/src/lower/c_call.rs).

import { noInline, strByteAt, strByteLen, strLen } from "velt/lang/intrinsics";

declare function velt_rt_str_is_well_formed(s: string): bool;
declare function velt_rt_str_byte_slice(s: string, start: u64, end: u64, units: u64): string;

/** The piece's unit count, unknown: `velt_rt_str_byte_slice` counts it. */
const UNCOUNTED: u64 = 0xffffffffffffffff;

/**
 * A `string` passed to a C function as its UTF-8 bytes, borrowed for the call and without a
 * NUL: the declaration of a parameter says so (`text: StrBytes`), and the binding passes the
 * length (`byteLength(s)`). A string holding a lone surrogate passes a copy with U+FFFD for it,
 * which has the same byte length.
 */
export type StrBytes = string;

/**
 * The number of UTF-8 bytes a `StrBytes` argument passes for `s`: what C's length parameter
 * takes next to it. O(1).
 */
export function byteLength(s: string): usize {
  return strByteLen(s);
}

/**
 * The string whose bytes a `StrBytes` argument passes: `s` itself when it is well-formed, as
 * nearly every string is, else a copy with U+FFFD for each lone surrogate (std only: lowering
 * calls it). Small, so LLVM inlines it at each argument: ASCII text (as many UTF-16 units as
 * bytes) is checked inline, other text by the runtime's O(1) check, and the copy is a function
 * of its own.
 */
export function strBytesOf(s: string): string {
  if (strLen(s) == strByteLen(s) || velt_rt_str_is_well_formed(s)) {
    return s;
  }
  return wellFormedCopy(s);
}

/**
 * `s` with U+FFFD for each lone surrogate (the same byte length). On bytes, with no position to
 * translate (#2816): in canonical WTF-8 a lone surrogate is `ED A0..BF xx` (a pair is one 4-byte
 * sequence), and `ED` is never a continuation byte.
 */
@noInline
function wellFormedCopy(s: string): string {
  let out = "";
  const n = strByteLen(s);
  let from: usize = 0;
  let i: usize = 0;
  while (i < n) {
    if (strByteAt(s, i as u64) == 0xed && strByteAt(s, (i + 1) as u64) >= 0xa0) {
      const kept = velt_rt_str_byte_slice(s, from as u64, i as u64, UNCOUNTED);
      out += kept;
      out += "\u{fffd}";
      i += 3;
      from = i;
    } else {
      i++;
    }
  }
  const rest = velt_rt_str_byte_slice(s, from as u64, n as u64, UNCOUNTED);
  out += rest;
  return out;
}
