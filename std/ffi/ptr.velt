// velt/ffi (internal): `Ptr<T>`, an address of C memory (docs/internals/design/c-ffi.md, #3094).
// The compiler's own type kind (`hir::TyKind::Ptr`): this declaration gives it its name, its
// documentation and its statics (`velt_common` `std_hooks`, `ffi_ptr_type`), never a type of its
// own. One machine word: `Ptr<T> | null` is the same word, with 0 as `null`.

import { ptrFromAddress, ptrRead, ptrToAddress, ptrWrite } from "velt/lang/intrinsics/address";

declare function velt_rt_strbuf_push_str(buf: string, s: string);

/**
 * The address of a `T` in C memory (docs/internals/design/c-ffi.md): what a C function declared
 * with `declare c` returns as `Ptr<T>`, and passes to C when given as an argument. `T` is a type
 * declared with `declare c type` or `declare c struct`, a number type, `bool`, `void` or another
 * pointer; `Ptr<T> | null` is a pointer that may be `NULL`. Nothing in Velt reads or writes
 * through one without `unsafe` code (`Ptr.read`, `Ptr.write`). A pointer is compared by its address, prints as
 * `Ptr(0x7ffd5e8c1a30)`, and is never `NULL`.
 */
export struct Ptr<T> {
  /**
   * A pointer to `address`, which is not 0 (the program stops on 0: a pointer that may be `NULL`
   * is `Ptr.orNull`'s). Unsafe: nothing checks that a `T` is there, and C will read or write it.
   */
  static unsafe at<T>(address: usize): Ptr<T> {
    if (address == 0) {
      panic("Ptr.at(0): a C pointer is never NULL; use Ptr.orNull for one that may be");
    }
    // SAFETY: not 0, so a `Ptr<T>` holds it; what is at it is the caller's promise.
    return unsafe { ptrFromAddress<T>(address) };
  }

  /**
   * A pointer to `address`, or `null` for 0. Unsafe: as `at`.
   */
  static unsafe orNull<T>(address: usize): Ptr<T> | null {
    if (address == 0) {
      return null;
    }
    // SAFETY: as in `at`.
    return unsafe { ptrFromAddress<T>(address) };
  }

  /** The address `p` holds, or 0 for `null`. */
  static addressOf<T>(p: Ptr<T> | null): usize {
    return ptrToAddress<T>(p);
  }

  /**
   * A copy of the `T` at element `index` of the array of `T`s at `p` (`p[index]` in C): a number,
   * `bool`, a C struct or a C pointer. A non-null pointer in it, a C struct's field or a nested
   * struct's, that C left `NULL` stops the program, naming the field: declare such a field
   * `Ptr<U> | null`. Unsafe: `index + 1` `T`s must be readable at `p`, which C doesn't change
   * during the read. Not on wasm32 for a `T` whose layout differs from C's there (one with a
   * pointer, `usize` or `isize` in it).
   */
  static unsafe read<T>(p: Ptr<T>, index: usize): T {
    // SAFETY: the caller's statement about `p` and `index`.
    return unsafe { ptrRead<T>(p, index) };
  }

  /**
   * Writes `value` at element `index` of the array of `T`s at `p` (`p[index] = value` in C), `T`
   * as for `read`: how a binding fills a struct C keeps (a listener it is given the address of).
   * Unsafe: `index + 1` `T`s must be writable at `p`, and nothing else reads or writes that
   * element meanwhile. Not on wasm32 for the types `read` isn't.
   */
  static unsafe write<T>(p: Ptr<T>, index: usize, value: T): void {
    // SAFETY: the caller's statement about `p` and `index`.
    unsafe {
      ptrWrite<T>(p, index, value);
    }
    ;
  }
}

/** The hexadecimal digits of `ptrPush`. */
const HEX_DIGITS: string = "0123456789abcdef";

/**
 * Appends `Ptr(0x…)` of a pointer at `address` to the builder `buf`: how `console.log` and
 * `inspect` show one (lowering calls it, velt_vir `glue/format.rs`). The address in lowercase
 * hexadecimal, without leading zeros.
 */
export function ptrPush(buf: string, address: u64): void {
  // The digits after the builder are locals (CLAUDE.md "the string builder passed as a
  // `string`").
  let text = "Ptr(0x";
  let shift: u64 = 60;
  while (shift > 0 && (address >> shift) == 0) {
    shift -= 4;
  }
  while (true) {
    const digit = ((address >> shift) & 15) as i64;
    text += HEX_DIGITS[digit];
    if (shift == 0) {
      break;
    }
    shift -= 4;
  }
  text += ")";
  velt_rt_strbuf_push_str(buf, text);
}
