// velt/ffi (internal): a target without a C library's `errno` (WebAssembly, JS hosts;
// `#errno-location`, errno.velt).

import { Ptr } from "velt/ffi/ptr";
import { inline } from "velt/lang/intrinsics";

/** No `errno` here. */
export function errnoLocation(): Ptr<i32> | null {
  return null;
}

/** The value of `errno` as std reads it: this C library's own number, unchanged. */
@inline("always")
export function fromCErrno(e: i32): i32 {
  return e;
}

/** The C library's number for an `errno()` value: the same. */
@inline("always")
export function toCErrno(e: i32): i32 {
  return e;
}
